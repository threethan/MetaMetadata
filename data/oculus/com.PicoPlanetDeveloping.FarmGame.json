3896124280411693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJGZzwQCkPgQ7kNvwGXMXz2&_nc_oc=AdqgcX6ai8fP7em-qB3bY15JMHx1U0SuhE9kLNxN-lMv1tPRpkegYsyDKEtm2Bt1Bj8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1voBY4vegsAvFAp76Ls1zMNNsjDPrFMI3imWUPYsfDpw&oe=69D3B353"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcmdk7vWosUQ7kNvwG5HhaR&_nc_oc=AdpLcFDFCnWAyvOUjzRBKobZ0vkwazCJQELYi4Z_gMO3mt25QVHaQ1NE06pXMjflsRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35QJISRq3aFpxpMKqucKTMOd5qrK3C_hlwevQuFs4dnQ&oe=69D3BF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mp6H-Dmw34Q7kNvwHW_g7k&_nc_oc=AdoR-8yL6M18RPoTkgK69-X3t8TYUhh1JYI6YJT6dQGz9WAOi-Xw6mvIaekdxLqBEks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Uu36I8QW3kOoUa33PH125SsAx4oKCyauBv-erqhSNKA&oe=69D3C0B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
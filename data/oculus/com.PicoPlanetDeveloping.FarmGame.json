83745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB1mJwh6KrQQ7kNvwHIM8x6&_nc_oc=AdlVxIWKGog663eIIz4kkYNhoXbZRRY86JNUrulOwmQFCcSmicLira55bxYO7oX-fF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1AwYXuOG4CFe4V8ZNk0xDDh_JJEtIKpW7ty78elFQ3g&oe=69B6B253"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUihQNUvDQkQ7kNvwEh8Occ&_nc_oc=Adkm7l4ye3FkeiKemijtvMLfhFbAVQlDl77hi1lqywIA5I52hWPNNoibfdoMxjMoWbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw02dyfxYCnD4hCBx2h2Fm_TGB-8HSXhg3pYqMnJ3zuwg&oe=69B6BE22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00Q0dgze654Q7kNvwFpx3BP&_nc_oc=Adl-mj-pRt2WFUdJw4AmttD7YDrwiaBhRHLEe51BGxd5Lvx9MxrRbkQZuZKKW23M1AU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH1hmFD9Xvgm1Rh2mqLXi5GF3YpEBkUXdawp5NsLi-Xg&oe=69B6BFB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "support_website_url": "https://picoplanetdev.tk/contact.html", "website_url": "https://picoplanetdev.tk/farm-game.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SIMULATION", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4906721466051315"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6026891034003340", "version": "1.3.2"}, "id": "274330704036389", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5617270104965437", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6026891034003340"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "274330704036389"}]}, "change_log": null, "created_date": 1619134389, "id": "6026891034003340", "version": "1.3.2", "version_code": 132, "release_status": "REL
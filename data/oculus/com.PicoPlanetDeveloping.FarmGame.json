3896124280411693", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlCVQX9sCu8Q7kNvwFn3OwM&_nc_oc=AdrXZh48pkWRWI-pjPILH-MsyJ858ssErg6wreQBp0AvYtc4nvhQoi1t6PQhtlHIVio&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvZAXIBmzJKyTMdf4sig2jusCe2etrhCzs14tq1YAV3Q&oe=6AB67553"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcpLYlJtYBwQ7kNvwFft8Lw&_nc_oc=AdqpG7KB1ZPIx3KxjyCJ7ILUb8fw39LR5cDgMvdh2_TRSpY5MaKHTNFlARP8Et3fIcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaYhh2aNCJzVSqJha7gaGCxcmqZYniZpHlxV3OcYfX3Q&oe=6AB68122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReQ7w1IXZ6kQ7kNvwE0sZVA&_nc_oc=Adpczi7gWs0-f2sctX6Y338Oqlg3gSS-tKxaZ678XszICqbFkILFBhEEmNOJYsxGPAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4o4ICyOCHm6lXuc10JGNY0fEKndrs-0-sMAz5CfPCQ&oe=6AB682B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC0PJP0-FcEQ7kNvwFPY65S&_nc_oc=AdpUlWNDpK12xzRgpL08_fPjAeqcaoblDIZJxmOlKTfDkxdT8JH5w5iGdatCDX7-uyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrOlaEj6LcomzgtKtwJjV07kSjuHFN2fWifSwLzmXKrQ&oe=6AB91853"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K3JWvpmc0oQ7kNvwGz2Ggr&_nc_oc=AdpWc1PQ0uUEU2SHCuVjuqJwsH1j_wbSPPvN3SmvLSmbua6fhpoimfYpD5g0OJakK_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQA6hQaEo-QHxyeMVBhmM9_kB4WrsmkrzuupQZCCX4qw&oe=6AB92422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I-Uxjc9ztcQ7kNvwGE4WHG&_nc_oc=AdpjGCmwLp7sUi0CM37CbWuPwnTHd0BTwbZB4-qAWruXWzH7RuJJZuC5hz0RXo9gXnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcCdAjaQDyjVf5BN2jXajrVgDN3OTJL6GtmWtlmo_k9A&oe=6AB925B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdLmF4fZNs8Q7kNvwGEhEpw&_nc_oc=Adq44TZlXJLheE7dvXBzpzyNbnEOEvRLAgsPHrQtn_OXofHNG4ELs4AczLdk6cYbleI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtfVWWSQBP6okgxEy1bmpZh9Rdd6DdQnZs8qwmGiN99A&oe=6AA6A353"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoYZ9lWg__IQ7kNvwG4gEtv&_nc_oc=AdrYUeaVpxix0HB9vWrOhASbPAH7-lgieRHnvJqSnWkGkMmI0ddgQJ9Y8gXWE7J-D64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9auEJ8F19Maw6R35Ot8B2ViQSKpjFexQKC0noqPHVug&oe=6AA6AF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m4nTdN2-3sQ7kNvwEdvewW&_nc_oc=AdpoZQwre-YEZvQPVP555dZsGbBMEKEsKEwduWCo1Fguc3l4RDj-k21jMbVULu5J4Dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQboblbsfNKZeMVdAaVALq5zwGGK0EgKlDWtY3hWgeZQ&oe=6AA6B0B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
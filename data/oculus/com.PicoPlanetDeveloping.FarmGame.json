3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkPayeV4KdsQ7kNvwER4M8L&_nc_oc=AdpzshbEcuORBw9vHFI8uXaS4_KhDutd-qr5U4NlIy7Z4Xo7bNXyV9m50oF3UPxuCL4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uo3GC8OIO3oO14Ccz-E_84DjfhbZuI84_8nHQXFHLTQ&oe=6A16EFD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ_zz6lnKpgQ7kNvwFALPLI&_nc_oc=AdqfqTnL-LxDToS0-SN7BqJHMwDDqmnO4O8LhQdBj6RmmZwcgmSDfdjJ2hSkLci-MlY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af727BkbvBMTcHBAYpi7_18hQtvy9mAZdZ-u320NVL-2gQ&oe=6A16FBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnm4xOs_M1oQ7kNvwGk3OMq&_nc_oc=AdpwxdQwrfTEPrQOwX_0gf3NoPagrIxvzotAxmCCIieyJ2Aewoj5fdy3ILBIbCnXXzo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nj_T7aneOvqBsXq9Cgq9t17ZOPTCBisdkctfb3KF3wQ&oe=6A16FD33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
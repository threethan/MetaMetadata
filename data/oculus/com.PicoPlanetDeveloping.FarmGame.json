3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ell1hxq4GwQ7kNvwFkr5bn&_nc_oc=Adok77JZD3Vcb3HLcZsuo8Ur9rfrrJ5ranQakqRkIwAjNACIkVlTQUGQMf8tP4k6bGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0ZfuphzAtihna0UJK0zZcDae-a2adfy2BM1vbXYJgpw&oe=69CD1BD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGD7Vhegia4Q7kNvwFBhR_8&_nc_oc=AdpQ8dNFdAmCXo5OB6y3SHoMAi1xliBD4KgPj1pg4ayOU6tQsRGDe0thfp2lUzfUObI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxjgepfxt1BZpZSDkH9nyb_VkehAZxeSUbzMGj_0djnmA&oe=69CD27A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4sa7DmaypoQ7kNvwFrPlLs&_nc_oc=Adojm7XUlc5sAjqcmfl2aiXbijy_Z58x_jeL6PBepC2UWabhVuNNGufJjlcZfIqSl0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzwqw0vejfGZ4lzA2RYQw5RkPyNB-iPSDYJDwyJDwmpyg&oe=69CD2933"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
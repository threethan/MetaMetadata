3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOcaE3qeTVsQ7kNvwGB1O6b&_nc_oc=Ado1fi0-ZSF-GbSblWbo69-894z5OCCmYOoNh4ihe7SwX-lmMN7v8LthgqiIo9asAP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9gvXRKiT2EH2b_GWm0uJi5u1p2CZlRbjZ11Xkgb3Olw&oe=6A9C1753"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsfRUyGu4LMQ7kNvwFo4Fs1&_nc_oc=Adpbt4AIQCDHwG-Pw3h6hEOMRfNsZd2AdWJ-NVEEfBUPjZg694ZiYsrVECdsr-13nHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4rLMc820SeoDRYdsynh2SBf1X9J5cSaepVtakgUDNIg&oe=6A9C2322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z66Z33hYAIQ7kNvwGIezfC&_nc_oc=AdoEl25m3C3bf372I6wASS8utd2c3qpsU11NccbHqJ__kShtdDogSnA3vuUlAUNCp2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhzn7VfxFGekIr_4x-Vs2aCQDO0TYvKFcNf9ZI_ZI_Dw&oe=6A9C24B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
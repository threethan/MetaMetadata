3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2xTAwdC9IAQ7kNvwFAZ6vQ&_nc_oc=AdqX2nVmuUmBc3bn-gVChNB_A7wI1XWMdfVotTj_Fu5NHVCRhfF3LhJqC9csuSFUPS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZApRRehbdzgBTsRwxiT_jNpbH8EQgSrOBekEvg29jMA&oe=69C92753"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXst5A1VGm4Q7kNvwHh_NZC&_nc_oc=AdrMvdL0rc-FddBWe8kOVZBbqRRTgEq_QTQyBCX71yNmH8jFdYYezD_EOWstPEHTe1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCVAcVckwOZnx2wozTnGiwjCqi_csEQXhj30Mj9JoDlQ&oe=69C93322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PphLLPpRdLUQ7kNvwEuGb_I&_nc_oc=Ado_ZebxcFRDgva68dlkrkLOERyYbqZwbFhMSvgNr5pXgobiuNWsqi8eHTG875ryHKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOtyPr7viQmz0uAAU_V84_8rUcLg0Mhw9XhrBPrSJ3fg&oe=69C934B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
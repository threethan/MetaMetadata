dn.com&oh=00_AfvvhbS9zmhghVjtAqQppdcb-Ad8j4Ta9X-wsx9GSa3g5Q&oe=699EF753"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzw38Td3kR8Q7kNvwHpKdao&_nc_oc=AdkRQzAaUc1GyhqEcwjhwi1uzmyB-HnwrATAkkx55wwfzhA-VIX7NgINUp16cmFLQ7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsACp0VMtV9vjBUBEI2UwzvXCjQh2pQgGYVcIngQyFhng&oe=699F0322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0C5s_i3DikQ7kNvwHZ5Uoa&_nc_oc=AdmT9-3UfglK5NpTLZ-OZMVSyLwTJvv10SXCaTqFeK1OVsgfcQ-eNOX1Wm7dN_YtdD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afveus9sB-daejuc0zDzBfmghie4Taf1nrPelGvQCEH5rA&oe=699F04B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
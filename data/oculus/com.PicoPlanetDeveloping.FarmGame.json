3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI1zxTnFsAcQ7kNvwEcnLiM&_nc_oc=Adp9hpyoF_iTjhewn5rR4pjpN3h7KLqX3ng0k3cFGv_u69pZMlBJl6amoY-FZCXduBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53CwizQcdbv8OkNrzNHFuylhGAEavm-8dTR0BYo1HKxw&oe=6A1992D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ_zz6lnKpgQ7kNvwEkzG2s&_nc_oc=Adqon6TvUeHKSzJsslTqWtVNCnEPI69GSiTjZmWNYQZy_G-0h7bJevSYO9uJL8vEf9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_PMBmOCaVGZ6MG3UaQle7iHWpe43ko_LAiXWd8bWDlw&oe=6A199EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukudyDYMMskQ7kNvwG1_cFI&_nc_oc=AdpXb_hu6PPz_4crBXYuiFM26gz0ED67VznAaE0wl20sxARqXDKqLYr3KIOyb0DUHgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72PIbjIU-cn96hXOi_9zTQLIb-MNtGqY2cX9Zah6NtoA&oe=6A19A033"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRAfFmeB6icQ7kNvwE5riqR&_nc_oc=AdpDKATycVuIZmqFqcOlm1RLmpLzGL4gfESBdmO3fIDDrJXG0Jw2CgjMC1_GmzS-C7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxrsVQYlMVC14URZ1H7PNFDpEcB5cLobC-d59QTuZwcQ&oe=6ABBBB53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K3JWvpmc0oQ7kNvwH6RnHO&_nc_oc=AdpSeY9FX8XbYw-_UCuWMhKVDJcL43J_lv-ENimY8265rx5dsmhIu2wxPaXzXOmfPsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNOukm4aoinkKLowAObdvR-DWbtX5Fp3Y0O1S0X4WF7w&oe=6ABBC722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkU57dpDvCYQ7kNvwHLtefy&_nc_oc=AdoAgnMnzvEtjZALIBqXtmq-KQK1EqbOoXXap6kggN5hfmrq4S56q66PD3cx53ezbi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkPLDe7zgqD7sKQoMwEMgRjQal08bVf4Ih4-jgFDZlig&oe=6ABBC8B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
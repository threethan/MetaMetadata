3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJ_8UtTebx8Q7kNvwHBSRVr&_nc_oc=AdryznbasLdNbM6T6Vy96Q_G2x48fbqv6EJMLC6He83hivss46kczemk_f1lzvIGB-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDuxA_QJOxCwJoXk9GDv-6k0Fm-mXQ4AFQOYltrjWUgQ&oe=6A75DBD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln2wyqlGY9sQ7kNvwHIUU4x&_nc_oc=AdoOW6URJtheabCiA0R4qr53RjFePJIauxxuvPEZZCvxQ1jK1oy-qIYsZaP6paF4rNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsoXOY3LAGSnHBKkelsaMCkvAYAHwmUYTPz0o3kSU7lw&oe=6A75E7A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkGWSk2AdewQ7kNvwH6BRVQ&_nc_oc=Adq3hMa3h1qnQy_bPzwvnBMM4ZOfMrh1kJdM3LzEEEbXQll5cVLZZBJPRflHmYbl1og&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhZ44mfjyTXaz3goXdEcB6Kwq2XQRR6mziHBxzDirU9g&oe=6A75E933"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
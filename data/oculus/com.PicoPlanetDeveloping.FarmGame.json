3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdpEV5x76HIQ7kNvwEJFMro&_nc_oc=AdqlNCE_T9w0Og620VLoJuTYlVy1mlMup13F6jifgWSEApUiicIFAZddkiLjZTQar7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr-MRQfO_kamiszNZUNKlQoc6brBPTk11ZR52Jl5chdg&oe=6A787ED3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln2wyqlGY9sQ7kNvwH88dRH&_nc_oc=AdqVCQV4jHuSew2_Gzrsq2h22UIPQaSMLV62GI7_UtE-ouhHF9HGkUMM4N6unlAH8lQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF_DTt6CGI7G4CZ8GZ3ASsbFlAQyv4p62ogIA9oI1hCQ&oe=6A788AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqkPnl8BobIQ7kNvwFpGVsu&_nc_oc=AdoPNZoddXc3ncpRSvy0jtzmfSjStUzzNbtDEfcyZrmd2WpjFz1GN2AMWM5F3MxAKZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAGGebtBqzr7QqFjFuCLADiq8IT-5Xj2Zx2ODrKlCtcw&oe=6A788C33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ell1hxq4GwQ7kNvwF2Ep-h&_nc_oc=Adq1fKp3X-MI1p21c1i4H97Bx6MC9v7Vn-PQxOuGqYslxCMmyCX2PXygeEeeN2OrW-A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAeWNab_GodIQj0NNGAkUupZQwNuU0ih8dH_dtxOyFOw&oe=69CBCA53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGD7Vhegia4Q7kNvwH-AU_X&_nc_oc=AdqYemoemWw1AnQhMDtRXM0jeQy114sVStwAG7JSJ27wWjMMZ8eEs2LRTu9gEcDwwsk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzedVLfNSSBKVnJi_vP7RRVZT44wGsN8gGJLjwDJKUKQg&oe=69CBD622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4sa7DmaypoQ7kNvwGrHSMY&_nc_oc=AdpUX23pGGwSMtp8R5IZgyXTPybmFigKIBi245SLp5ETHVa2m9_ctkjeJPGMMYvdujM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVZLjhDSxROEA4BcimOyfkpD-V2VNbyb1eqUqAB44Dmg&oe=69CBD7B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
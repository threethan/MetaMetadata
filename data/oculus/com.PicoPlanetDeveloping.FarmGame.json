3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MufrN0v5MIUQ7kNvwFFQ_nT&_nc_oc=AdrZud5Ae_gHe8HTEvb2u_QhF3wBWIf9Ixs3oNRPTl793pPMbux-fN-BXpQMZ6neRRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxM33ne7h2XFPKzJdTKkyZhQOP20lQpuIyam-agbo8dg&oe=6AAFDDD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLYHypiwTGIQ7kNvwHAS09S&_nc_oc=AdpwBhnqXxyjhqAiW93CZ-dmSD0RlLivLi9vYlqfRgWuxj4lKk_MAIxR64eKVAmzutk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCCmV8CBNDFTivUtn9UqDy2D6hkzfKiMnkVuOctOn8aQ&oe=6AAFE9A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi4fFqFQJpIQ7kNvwHPslZi&_nc_oc=Adq7fySYKcHj5NWDxwoFpStaV1HY1MWxQI5LB6rTUF-fRxzNdOFthPRexAD4CaCPD6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJXYJHpxJ3SVmgthLrH5NbL9FJD4vp4HUI8Mv1naalqQ&oe=6AAFEB33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
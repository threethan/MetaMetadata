3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imc-ZRObVIAQ7kNvwHbGFSB&_nc_oc=Adr-XD27hTlAH9jR8YTs5fwiHTx6dPHc73-p9_s2g_5pBQ96QNKMM0zIw7KgxUQlR1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYkwurLb9t8Lublz4DX5JhI9Qp1GvE_Mf3THTaEk5vIQ&oe=6A5E20D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bi-BfmjZBkQ7kNvwEozvnq&_nc_oc=AdrV3HYbwyKuZDU1QBkP8vRNg_x1UG592giOOQZzIkV4iblKGqAcVb_CwseHowvHFQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNSerdbFg4pcSnGTCeG-vF0KMIgbgtAhThVGD7ixz_dA&oe=6A5E2CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jALGJKnC9gcQ7kNvwF0NHim&_nc_oc=AdoSgqR5NbMqls-fwjp5fDO16am2g5sBcJsik94yqRU1Y5MEVqZEmISAfRNSY0wbusA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvMzb26mI-bMMvffPVuL-sTuk1T7QUI3a_yRgSjRvI1A&oe=6A5E2E33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
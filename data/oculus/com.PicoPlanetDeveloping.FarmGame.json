3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wxXsqvoG38Q7kNvwHiW_K_&_nc_oc=AdoAHErJJrAsCaNwNzugCZzR3pMNqWoeImG5fJsmh-llO1SyuS9ysLpgHO1MleNoTIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIniGdhdS3P8I4s34WjaQI0E9scwnUH5afberm1JA9sQ&oe=6AC64753"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LSUKa6SW3EQ7kNvwExDVnb&_nc_oc=Adq_MorDZaahvlDsp3k-tlmwBB6eda2RegMOMJ6nyqbhpjjqfmO3lP_-vCV-CH-Wh2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV-CgEdmF6-2NVIceiERPdBRn4sKWowJdyRtfU-73SOQ&oe=6AC65322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWMvaNrXKYMQ7kNvwGDkLu5&_nc_oc=AdoeG8KQ0lbM6OX0b8zfslCzJHwwNI_RfBTYbJshMq_9HNn4QroTmUeOJg0L-0L409Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvDOKm-1qTSbqWyWEEaC4cCraZWQkTMgvYsSxtG6NM5w&oe=6AC654B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW3mnczHrB0Q7kNvwE0UFkm&_nc_oc=AdrVLpUj_kIH5aLrXHcSepVIH2hT7TVvU1RYNEaNAHcyQDECpI6LUoU8xqVOqG_Kowo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mRwDPlza3HbvFPuWIXBY2454AeNkCr5MFvo8SQxn-LA&oe=6A241ED3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPjH0OO0WJYQ7kNvwE7FK6J&_nc_oc=Adog13St7ksJxTeeaEw__J_y3F94grIJFMx1If-dC-CBAf5VQ_-LNlDD8bYY4aQhSjI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xrA1QhrpFNNkolyWbKBGLUizmIy_IyXvjx0hLrSmTTA&oe=6A242AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRAk8ea3DAEQ7kNvwG6TDpt&_nc_oc=Adoe4ePYp-URjsinmP-ok_sTp_tBpCf706VY4T9Ix9YZRHc4DwdpKxh-gf27juG7WNM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Btj9utE_OOJfAlbBl7lGseW0nh6u-sDY4Oh2WpB21_Q&oe=6A242C33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
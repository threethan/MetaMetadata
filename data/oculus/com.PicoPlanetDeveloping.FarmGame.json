3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcW9cTJXHDkQ7kNvwHGfOB-&_nc_oc=AdrvOdHKZi8h2JwmSMUrzXldaJpUeeNZXAVck6AGMWjOFbEUPkDaN1gyh_ZSdW-4_mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HmI8ij7QM7QBf7OixpozU1UMkarNTxzbWJRjcpkpDng&oe=6A144CD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcfiMlCgOXkQ7kNvwHY022I&_nc_oc=Adrfog3PScAgHlpfcwYwwJTd9konpC2PK_fDFdxcO5Ki28sif45JWVxKGAnoeT_K_MQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ek573mqnjwpWY9RsgeeVzL0d7p676OBnwZOd1V2YKCA&oe=6A1458A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oN_n6hXYhM4Q7kNvwEks5lZ&_nc_oc=Adqe7_BrSd6PHfrl3Mu8ZmI1SSocSCbWTn8wyXLNp4dwfBEc7wQg2CN9cQnBiyukh3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5exLIFb1b2KyHfwTfcfq4Qmiug2p7U3lPFC4tlSeSUUw&oe=6A145A33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
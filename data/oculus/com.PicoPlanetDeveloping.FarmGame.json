3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5NtIhd3WPAQ7kNvwH9NGm5&_nc_oc=AdoRjGC6p8YDYzTRSe2W53BfivR_TnbB-i7mFIJh3JH06cTiJajl7Dh13orAgKiqRM0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG61UNpcJpZDDCfojJmpKhvQ2yo8kQ0KXqgPXwmLwqsRQ&oe=6A86FF53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMfngspbELgQ7kNvwHJEr4W&_nc_oc=Ado-sdM43fj2nMlWx2Pk0yPJkezMci8_DyhNecc9Lk_A2enB2CNsbcBme7IMfwAL6sI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSR0OcwSMG3-5V5HV3HNICZuhsmReBYY26BUYMx9dPjg&oe=6A86D2E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GqsSyJ8yxQQ7kNvwFzw30B&_nc_oc=AdqvfwIoks57qyiTGox7OSinqx31NsDDzIGyd32DRfVxmlZ8FRzeZamheh7rMsWlpVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpU2tgd9KBznjrrh3EO5n820k7JEkpRbTGHw5LzziMMQ&oe=6A86D473"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
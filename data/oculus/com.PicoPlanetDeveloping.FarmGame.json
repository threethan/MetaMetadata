dn.com&oh=00_Afsj-4Hfwn0xoW1mzSkTQ1kN8-vdq72_yIR9NyG4tfBX_w&oe=699C5453"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzw38Td3kR8Q7kNvwHTIHlj&_nc_oc=AdnkjrZuXJ8bU10FbjUwbEjBoJs-JhaDjrSvbbgAvQ2TxMizVgFAq8AgkMx-7sYUTGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5RvVmrkO6vxDQX5-qwYwdoa4GhafTopS5xzjrnsPrzQ&oe=699C6022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgb3LUzgbqAQ7kNvwGhwxY1&_nc_oc=AdlyNi9e7krHzMXfPBw-h5Rx5N1uQi07MVVy-eJYc3JHLukPPko5aEzAoWcAGVBAmyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfugWxidTVLSpMyuQoqTxdW8AHV9qsFPVIlxGKYk56sr_Q&oe=699C61B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
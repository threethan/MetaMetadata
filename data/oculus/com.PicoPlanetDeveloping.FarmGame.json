3896124280411693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2GAzNJZDf0Q7kNvwFA_5O4&_nc_oc=Adp6FW73giIRGsI1evzswONHiZC-T2taFOfqW36Ao_2JDNxdahkB16cvUY2Aneut5WM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SQaJrG-f03y--Qg7fiKj-evFAPq14p7O-d_kVWFv-aQ&oe=69DF90D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjVvszp7Y_MQ7kNvwGz8uIr&_nc_oc=Ado6cXHIg_ig3y40KArCDn8nbrsL_D8gbQiWGINN1eKB0ypArNWeYh1kPoe1YpzD-hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08_WEeUw-BmBQiemLtVNAoWQHEhPtvLOcFl45nhH86VQ&oe=69DF9CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qfOb-6UDjMQ7kNvwEtrrbZ&_nc_oc=AdpL6MWmicxaG-GNACG0nP6-g6JMsQ8PHlvvcDOSqaBdxsfOV9AOxVeBHEQqn1_x-qM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZUbe62GuRDYWNPxnr2ErnG9W9tilHHlVQ3HZ5FyVFJg&oe=69DF9E33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
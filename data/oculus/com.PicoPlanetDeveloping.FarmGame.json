/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW4Fg9v8wcIQ7kNvwGutpmW&_nc_oc=AdqsSVE8vXywrZMHLCKrWhHUZeshUoR0vRYsoJZTNMnnfrtdu7MlljY0WaD8oJ0o-u0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af151i9JSl-onYk-nhKY5qgVnUV0UBN6aVk3zhG5j7yLQA&oe=69F205D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEz3ZmnfQOAQ7kNvwEm-mgf&_nc_oc=AdpUGeZMHb2Wi6YH36kj6UGCrDCG9AkTDTq72z8qlpYNOdU7lqDsECmW6SNXayyewKQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d1Ooff7_8tI7FcimPG89VI8sVfCi3BRB8dk36Az7NIw&oe=69F211A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU8Z06dmWG0Q7kNvwH334B4&_nc_oc=Ado751EaiBah4CNlgJDMtKydC4bMXt5DOVVKoaUhwudEHjbpXRAFLdu0B7XL6V1RJqE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0H5NLSFZowcHxYW4cklNxD1Ksoj9PRDvoikqoQau8xPA&oe=69F21333"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simula
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLNWK-_XVhEQ7kNvwFuCzSi&_nc_oc=AdqAxQxKP_FE-DIVDSML2HYzQAVEV_cKfNYNz-ekmDm-mjaOSO-rwLZfraYMnr8OOFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wOxvSAFVxz6NhjtMCwRuZxipmoVLAkPfFC2kspjmUGA&oe=69F9EED3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlsc1JxF84AQ7kNvwHkFsgX&_nc_oc=Adq--z4hfgi6NKuO_1Hj4a-YzG-sVVbo2TN1O7FtsdVTwQUQiVnK8LNUhahPAyt4Et0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E-3CYRTN_3Rh_trMWNDpHtq-cCugkmRdRSLOiZFTnmA&oe=69F9FAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wppobWgoX-kQ7kNvwHLuNbf&_nc_oc=Adows4sf3LUGYxptld00MRsqxqwCrlA28QloDJPwkg0fhmWUXCco1D_5rqzdkFXXStI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d6xtEBUkixU6mJAZCWw1SmADoepf8klQ0O1KZTA1P7g&oe=69F9FC33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
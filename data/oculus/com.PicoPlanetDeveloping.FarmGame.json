3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR7LNuGRn1UQ7kNvwEhW48j&_nc_oc=AdrxRTDzBOvCAa1SiO37GxI-T2uDkEygc9nZVpzMfHyU95xaemKgaB8jvK7S7esXEM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bAXjERsiKcN1GM8sFI3JX9-nTHZqFKNzmaRPgYxwv9A&oe=69DA4AD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slhCCl4d3_MQ7kNvwEzBgee&_nc_oc=AdrdQJ0ppJ61xtG-IuyXtY23o2zLMt55aUjMU2wzLZEgvPhxQlxH9nTdsommAQ6Ya4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zK7iaNvXQmjuK8mVZTe4xQvX5poZaYKrUVwBl0Ktj3w&oe=69DA56A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of0qIka4YCIQ7kNvwF64x_Y&_nc_oc=Adpp7Rrz_P7HDYgYFynAz6A7VFsfZ70PdaZz778hohwWNz42HFKcfoXKbxReyJj8md4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JQLSjTIIrHTkmQ-d3UIMLbfwiUGDIZI5EaCjzt7UqBA&oe=69DA5833"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
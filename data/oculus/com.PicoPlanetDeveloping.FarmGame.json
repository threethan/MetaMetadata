3896124280411693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFj1LA4jSScQ7kNvwFpxJTA&_nc_oc=AdrLC_bbVd5XYAOFuHHRMQ3bonS-dYC9uORFirDMNjAhe6cSU-3vg1Euna4rhQwK74A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jqrQyPvfcQF2_618w92nZaRHHCZLR-8UCQBhE9Km44A&oe=6A26C1D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWH0Cf-t9J0Q7kNvwEuXHzg&_nc_oc=AdqpMu25MTHOndK0elVqkkX5FYdCjfAcc89c6cZlrOHfFlWnEteXLx0xgmQo7EZorng&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F9qvJgGILzivcjru_EUtiu_WjAx13DosZUJ4ojdsl8A&oe=6A26CDA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJQjLP9q_jYQ7kNvwHkjgj-&_nc_oc=AdoCX2_Dw7C9WG7IUvqOo50FH5BiRhIYZTPruSl95BILK0KemAJWfNUt8PsbKlOQp7w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UfDapJw2JhcQ7dwv_wkJVLDbQ2TieoE8Ps8crzKTrAA&oe=6A26CF33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
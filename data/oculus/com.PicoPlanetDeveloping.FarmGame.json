3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKx-ZHFqvgwQ7kNvwH5hp0t&_nc_oc=AdobsR8MHro1NKfjNTMcR2ypvCen4KSdiB4FE-KT54pUVbHhwpmMHLiCsXukt8btCa0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jEfodA5O3_HFjmtPGi0E2rNS1ei8qu8kn1j-WLI-ujA&oe=69F5FA53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNlhMIPimG8Q7kNvwGPDe3t&_nc_oc=AdqDMxk9brr2ijGKWjeUv04hdcD8Q3eGWRgnd8eVtF5YqOU1nUG9rUJ4Qt7kFdqnkeU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lQuRgoCBagtbHtyQqVwIPiICurRHTByeB8GuuF5ANOg&oe=69F60622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRwhqwgG4EIQ7kNvwFhFpIm&_nc_oc=AdrZH91bqMpZlKFTOaMi87AiwZrsjYA31y8U37IHmXHF6W0iydQByU9hkIu5gUj5gvo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2QSe2BQO0PQmnb5PoNGIKLfTIcrAxZoCPL9YFk8ojAzQ&oe=69F607B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
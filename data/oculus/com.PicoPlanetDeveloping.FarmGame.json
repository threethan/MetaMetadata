3896124280411693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXTvrQOy_jgQ7kNvwGvP5nn&_nc_oc=AdoUiCjvxU6ygc5VRWYLB4HN8ox9qzCELIYUyu_PtupkACRpSBJX4vu5szcDYLZfFw8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR01EksiKtDe46H34aknP2V8VcZ9N0ClDfFchOqqfy1g&oe=69C532D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUTcDfe9IF8Q7kNvwErocwh&_nc_oc=AdrnlLNdS_B5TuPXDHanlgkEkTRdtwZ738czFZAzOmd0qOtWIwvWpwU_edyX51I_FeI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZiX1CSECLEzHPwgKOgj0G7iYoVGauQE6gCCgZ_ATsqQ&oe=69C53EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgoL73tDlTIQ7kNvwHdryVq&_nc_oc=AdpEhy9B7LXNY0YUxlkM4BuKPeUqMzrvU_yD9syJCPxERZa0p4dariksEV1gNz7ofPs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbmB3vLGAQh0dQOjivtSNhGDnoZB_4z2CXtN7PxcfWiw&oe=69C54033"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
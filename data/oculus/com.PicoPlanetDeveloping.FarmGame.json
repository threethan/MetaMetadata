3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXHlkq68HJsQ7kNvwHt84B2&_nc_oc=AdpW9KNNK4QLItBcM9gwnbajmOxCV4sMpFqnCLGlQ0cvtNTiixT9Eh9Dju21m1eKbA0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEy62Rn2YeH4lkNsesKbKrjX59XHIJDOjh9GEi0R6gfg&oe=6A5637D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwcjKHTE7T4Q7kNvwHQspxh&_nc_oc=AdqgutgwGrtn0wMRqtXkuYXlk3xY81TEJaYH0ZuA2hseU2yOGzSlP7ln2RtuMmabj18&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdKUqy1aZJgjNoY1g1acLRLO3-3opbtNpIk3saVSWAIQ&oe=6A5643A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AboITeUwCgQ7kNvwEgvjOt&_nc_oc=AdpOUf4V4zY8wDn9YTt2TkaJtr1M6zwiq4ltgpFM6X69XhZMwMbcaScRBph5DfytsXE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI2a-u3f-IVwAezl8VdEjhUuftJEMYeXrw4eu4ZaCX-g&oe=6A564533"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
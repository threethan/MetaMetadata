3896124280411693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1GwUst87-8Q7kNvwGcAHXG&_nc_oc=AdqvcKr6q84bXgfmO89X15r0srL6lW1ZbLo9Ib2m-4s62Kwgdn4lE2OSkn3ZsOElWO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN1lsRnw4rdn5S-5y4dLf26OYZiN7lRk3GBld3mx5MQw&oe=6AE1F6D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLsfIHeTQ2kQ7kNvwGdYkaM&_nc_oc=AdqDZhjP8McxVrDubNsCMIEyznJH6BhhuLrKyfVnwP1LtoZ5TNb-CmDUPLKxcKTIb4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDeadyahAcRqarbqGwunnz6kaQK6aEwnHj7NpZdUMATw&oe=6AE202A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrBFOSVMP7MQ7kNvwHoROa4&_nc_oc=Ado112TsruaaypGQd-s5iqZS7rVP4nltdQcqliwxMtAChQy9PfWzkKwyDj9PpXbb4rE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4S0i2QJtyER38KZSAVKUD-qfhDij7ChtVjWzmiWui4g&oe=6AE20433"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
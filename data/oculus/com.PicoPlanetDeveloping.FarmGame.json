3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5AmowR9Y68Q7kNvwHBHS1w&_nc_oc=AdrnXgLcw7s1qrTatlhdBiyz3LpHcC9gpK3e4WsLrDy5qTlnMAM7NOjgq5gvvy9nsrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2127Rn_uwBX5Mgsp-fn0AOvJGdhM2hxDGnUDqjtrbuQ&oe=6A3FCE53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlogogRrZs4Q7kNvwHLEi9A&_nc_oc=AdpQvJyB9dcLir4FqmS_hygkkkWmY7_eNY8R63jJkgxWwN6gSn8zzw7iOwkAyHWHor8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NF_WLegSgz0XVz305YFXeEvjrOG2cUBIMaEUUYG1VdA&oe=6A3FDA22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j0LuABh264Q7kNvwGjtKbH&_nc_oc=AdppCSJ5NvqaDfEMvblRtuDCwfOXaygLGFumccGRa82GO1EJVQMhAj4dG2PraiPYbc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a8bw3QqSgU_U30NAgqu05ExrdmoNJtW7RbCEzbM6Eug&oe=6A3FDBB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAQk087n7goQ7kNvwFwB3vx&_nc_oc=AdrzolcqAIQiciKXT2g-LZT_YLGyrBXCCoEq7Prx1lCpqKZdBErXkBvp9piEwApXqn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jqe0hzb684OOWPei_Ai5x6RDtJMlcwLZv5mZkhPhXMw&oe=6A0B1253"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m01Mf7hH8ooQ7kNvwF1ze0k&_nc_oc=Adp8NpwqgZ6Hdr9dbRnCv6JVWkg0dXTO9pALv-d-mMsUMZDGEHYSDNDXGbYZt3i_ljQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49XV9zHul7Jb99bCk1Umh0OCofq0PEUMsVThrtJg9r_A&oe=6A0B1E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R5LpG0AapUQ7kNvwGY_iEu&_nc_oc=Adoz36BHfZpmTloa2Rt5M9EJfgzwxtORx3biaXJWU-KjGLWUdZQDYTLjo3dfuHSVZSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jrfiE1JPiVZwcmHdF3LL0l_vizDN1mRInn_EK4IJPzQ&oe=6A0B1FB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
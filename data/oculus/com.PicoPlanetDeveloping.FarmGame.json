3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aKzEUjXQNoQ7kNvwHoP_2q&_nc_oc=AdpaM4Gwo4cOrJgERuAsuqWB4ubk7ppSPOvnqmVg8Sy4MAqu6r7n7F2OeKJ6d9I523Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0zAMKgO8303FBAJOfJt1pcU44DvrncE4l50dHRn8b4A&oe=6A997453"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsfRUyGu4LMQ7kNvwH_MAEo&_nc_oc=AdqAYqyngXYrYdarVgBtFxOT3ZZ0PQnALzeZnT9HhZISCd-aEpDyA2BMTjTsFgPQfac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdrinj8lBBF4Tsta7ZenRD9T-S3MES0h-s-LlwC-gHaA&oe=6A998022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ahFUDCGwcQ7kNvwFknSmj&_nc_oc=AdoR5MvASgyYkldXGjf4f0nvSH42qAivzYzndnNyd7Ry9hnstlRJGJbn66F_GmRG8qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx-yibSYL2HuFtFbABt9pojfUuqRW6s7wsTQAlB0Hb8w&oe=6A9981B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
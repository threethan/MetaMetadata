3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpydavQyxhoQ7kNvwF0qQY6&_nc_oc=Adozfy5_xbwwxvpFOxhE1aTaOMNuLKrUC09wepnk7dcEyBtFHPIG09AK717C8YbXqjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ppapWFroM50x14FLK5zzRz0yNVFcbh_vVfd2kPNP7VA&oe=69EB6E53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbmzmrZ51CkQ7kNvwEaduzJ&_nc_oc=AdrhMsPHaeJlICkM9uu1bMPUblWGAfF9c09CnCsNdXCNF8oeZ5qArLHmGutFibRp56c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GRKlj7Vx2KcrHzPE2RtY0PitsBxpjAjrYFzlgmqb7cg&oe=69EB7A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3kCvMVU7hQQ7kNvwF-hfMe&_nc_oc=AdoRsVFIhIYDGBpXY6eugIJiPR8WcUrNXuQkIfaKuMk2g_LfJsRvmFlmz7FtGN0HuNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a-TfBxHAVIbX8Qz2anjN6fzBWYZsxuatjHLAd0DsSAA&oe=69EB7BB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
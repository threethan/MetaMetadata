3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhFkmCD3UJgQ7kNvwFc18PB&_nc_oc=AdoHpHp5uWHlIBYaLmUfs0KEdmrrlAnjud2Lyl0tcT-sh_G9XryJxrlNPbCqEahJEYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJh_2IOt-iGgyl2w7LEyeqbKWK2sp_nCRn6juQlOc8FA&oe=6AA7F4D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoYZ9lWg__IQ7kNvwFotK5U&_nc_oc=Ado6CnlqVTy0PEPoKTyYLJveXxqEuGnMsaWO3vdVm_eCu75ZurlGIwLtrNqJC0S12uY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ4g-bXhZUl5rgMcWkgw_imZAd4VVahPqSYzA0x2poFQ&oe=6AA800A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5-kdWnETwwQ7kNvwFkqIX2&_nc_oc=AdrvHI1IGIw7rtSDmv8G3gHRc8FGRo9ecQgAGn6VsZbuTLbxPzFmiL1ikXVJPhEfDK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEoC4whG7bjSqvB63U7EjXL2wNKiMZ1eVaDelVBN3HCA&oe=6AA80233"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
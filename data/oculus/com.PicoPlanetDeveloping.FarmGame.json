3896124280411693", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1IwNvx47FgQ7kNvwHohYDv&_nc_oc=AdqaJcK31EP0QzM9Ih8scHJP16fAaX0yS_y35mI2b9NUZLmLwiNkIbGcQYNXD4q7asM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjWPdM_op9V96wr97B2mmGf6ELmOmo5AAbiu0MsuHIoQ&oe=6AE73CD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Qq-V9DjgMQ7kNvwFjIgTo&_nc_oc=Adq4Taag7K4m4lL1GT8Jgp_2sBFh85KTBf1-WsIG6x1eK06Vel7iw47p7zztZkwKJXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREIMp5iwYkOB69SmyIc8vTiCJzoqARqtWLETZWbvkWyw&oe=6AE748A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et7TRcbvDrEQ7kNvwGNnfCM&_nc_oc=AdoUYdF_oAabDMTLoDTJiuoqfrSky-Fki2JhxQzCaFgyBz2qNsx-sgj2SRcRUmEUkYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStCZAEg2EIqkUf5-d5uhElg5aOFLchyDundcTCmMy5DQ&oe=6AE74A33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
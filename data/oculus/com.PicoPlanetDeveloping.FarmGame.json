3896124280411693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lVdXFDBpVgQ7kNvwF9dgwQ&_nc_oc=AdpIIT1Y1yl6DzQXpiQwZMtuwTCgEHu92Sa8rjYmJP4vdiN9Kg69AEzRw20CkrK4NaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi7AzYdA04XKMm9YR1X6Y1Jna5lpxveOQWIJ8ePNEDpw&oe=6ACD1713"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TytlLWhIXAEQ7kNvwF4nDiQ&_nc_oc=AdrDBsZcRamVhT3Xa0Q1Ko-L8iC5yjIVQD0p9LiQh_tqKkSbFwaWk3b3fBJfYF3zpB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyxo8F7hmwRQql4HQ14tQ_7mZKJeZZgcVjsLETx-woQw&oe=6ACCEAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MNzmj0C3doQ7kNvwHP_zeJ&_nc_oc=AdruyNHti_Xgp4uDUT2VWRQAQXiZ5O6ieUel8tMxSAAN9jrkYNzWYe5_TFbt0-ZC17s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6kaYWbZhPoH_6gjLwI3FW6cRAnZYg7w6cgBNzaQZ3Ig&oe=6ACCEC33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_co6uzpTm4Q7kNvwE_L1mz&_nc_oc=Adp6sE6uHOLWUUjCFCdabooWWbTDek1Ol2kIUcbRsBTaeCJZRfXpcBOysMxJQxo35CI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o2a07i9RZdTPdC95GEOc29fr69xx7C6vx72qTDss-LQ&oe=6A086F53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxIOtVexP3UQ7kNvwGouCAD&_nc_oc=Adpn_fxtoqcxv0waAtili0RFAqm77L74oUycCo8S7YkyWmPc5DzgkljPkCus7difKPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BsbjXx10Z4KfmRwddsQgnk_HD5beY4coX5e5mSsdECw&oe=6A087B22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x10VICzpV5YQ7kNvwEYbjbE&_nc_oc=AdpeocS1Zop0UUcoSnUViGuvQO5IIAhdFahzeDgOv8t016EtK-j_jjfAlovdcQrhsJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hRijrjoJWhEeh0A97cGBJhQ_AP05OsNOLjm7KFce3bg&oe=6A087CB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
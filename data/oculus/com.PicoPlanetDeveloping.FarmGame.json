3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz0Vw2tTAkIQ7kNvwHZ9vTk&_nc_oc=AdqshFxMFrK34qf8n5wu_vrF9TRWVsyBG25KOlX_dooAeJG5RyQgtFM6okmoUhcmaSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsU_xpl6GiM7s2YW7S6w9KU5Jsg_03Oo7VbpM2AQT8Mg&oe=6AC10153"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMaYAhEJRIQQ7kNvwGiHebZ&_nc_oc=AdpFCN4_Fg_V_2dr4XynDVX-gI0lGbhgRqn2HUd3dbgqLNLGQjIBn0jYywyD_aqUmJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSMJYkukzgKwbwy4Z9vcrBjviuV_mWbWsmOAo0JgBu6Q&oe=6AC10D22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eyfRoXUXL0Q7kNvwHrZ9ec&_nc_oc=AdrfamvF1vRhhVhBchhj5YmvVjBgMuLAELNnQvsceQifBgroqsSnxk1Vaj8IJZ1pJes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFtJuoO-rzkJKAM5NXaTpQEi_Y0UDNESSGOPcMaAxbxQ&oe=6AC10EB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
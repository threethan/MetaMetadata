dn.com&oh=00_AfuHJkEJNvuZ9-T49Z2McvqMIRFRdb9k59GghRFGSiKn-w&oe=69A6E053"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDtq6ug-EgkQ7kNvwHzZiaU&_nc_oc=Adlg8VfFIGqRI2b4niEn0fZe-5h0wsbwd0_gjbk95dJ6RWDXqmLHKBh5vwCBB2U6cEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsbs_UCvK3ByQ753dV7XnpbxdtXSNgAxO3wn-aZTkHhNQ&oe=69A6EC22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6uvgMZ4v5sQ7kNvwEkWuZk&_nc_oc=AdmPQ54S6BCN13LjL5EOAYy5-QD0Dj-52ykp7ZDa5WK2AXVQOotwZf7w9Lkl-SVYw2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXLTNeeSAtVkq6TGTIe0vkstwI_tWecPlQqO6vQqK3wg&oe=69A6EDB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
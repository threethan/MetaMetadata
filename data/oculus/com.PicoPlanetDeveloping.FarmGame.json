3896124280411693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqg4vIBKuNgQ7kNvwHIwVK4&_nc_oc=Adoyr4P5t9q4ernTReu1RPKCe-dugksTnLF6lxVkUU1Q8vPltOFmF8f8ASSvisLkwyk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsBcPLkudTRiI1kb-BYzVl4HEGz4FbHnhtRRyPJ_3ZTA&oe=6AD3AE93"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HOjxYykYMMQ7kNvwE72PKk&_nc_oc=AdpMr5akkfbLZIC8CwDabO2XxRHk8ZdxGqC9zoTkwNivLrqaFYqwQwA2gM3s_9bdYV0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNyd-btW24ls2Tx0FxJgF8QiaoOfVv8iCPnod1mp3Keg&oe=6AD3BA62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLhnIK4YVl4Q7kNvwGsgC1K&_nc_oc=AdpQVmbStRbfaJ1c2vAo0VzOlcqiNat1x62rr7MbSmED6bFP0qKJmQrVmv3C5aYljuQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOjt3MdkhvUpwqPoH2jm73tzpBvDldPQcUVZ3jHm2zPw&oe=6AD3BBF3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
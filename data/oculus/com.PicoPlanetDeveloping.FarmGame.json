3896124280411693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJGZzwQCkPgQ7kNvwHohCQ1&_nc_oc=Adq7zhX8hj91mOi_H5DxXjsAWALCjDAOgdzH3wjrNdFR7h4VvalWwWtdFvpmZRZprjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ThLwIN_7Tos7ID6LrpDepdmXhgpShlDZvypvYbyoVmg&oe=69D504D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcmdk7vWosUQ7kNvwFT_TQi&_nc_oc=AdoeP7Qi035hOxdI-e5zqO7BETssMpqYYpeRqQpGT_nyDR6OdQRK2tMIh9BdebV34s0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06I_scGYvjsKAtEZJVT1dGHq-OWnohtxNf_w08V7YH-w&oe=69D510A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mp6H-Dmw34Q7kNvwEXSVVe&_nc_oc=AdphcR7Xk4DRxZ2A8HNev-AEMoQMpW-fKllQ583CFSr5zUVrhVBe1Y2phu8rkAIAs3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0krcUbBZF-hzrkTxzCI8TzEn5KZdxj0AsGRTK2FfrIIQ&oe=69D51233"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
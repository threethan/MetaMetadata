3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8LRp8Ms0wMQ7kNvwEweLEq&_nc_oc=AdqP7L-nFDFf-HzRosqzz_Y1Cy10A41uIaHVrYY3N8LAufcMfwG4WUj84PzwltRvLrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96NRrt8Cg_FPgDc_c_d4qSNsBGGsnMkkBEGyt50VBEtw&oe=6A43C2D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJyUXNP2SuUQ7kNvwF0K5GL&_nc_oc=Adpfjtnqgx1YQbbcAQc7Ac2kguJ0UYzyJKEjVkHeOKqcQR_SI3McAQpUzI9jaELFvBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EvhrOgloC0Z_zwN7OHI1eRbVFU2atQYO7Q_vH_LQFZg&oe=6A43CEA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhcHj4TL6HsQ7kNvwHOcb_V&_nc_oc=Adoj1XrbjA3oWYp_Xr7fX5KGsSt69zQ13ss_I4B3mZkWXkbCCIrQhkwGX7hmxT3qbgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UeLfEMyac_imx1enzfQ66YRlM4Zmp3KC5SfpHrkcplw&oe=6A43D033"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
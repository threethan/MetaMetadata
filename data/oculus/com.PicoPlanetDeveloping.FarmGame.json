3896124280411693", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQCfWZMwBgcQ7kNvwFamxtN&_nc_oc=AdoCXSxWT2-k8iQrGcBdrX8U2I-M3t1LdGHLf3YnIBGzFzDHXqON8rAW6KcPYHEuvJA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPtpiKPb19yLMua5410HG8zNk2V-jNlUR8LzRS9fU2dw&oe=6A9039D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s57k3f53cjwQ7kNvwGQYNm4&_nc_oc=AdoNK9vnI44NTiUD4oxathudwUhQ3MvyvPnb-nJW4RgBCTeRSD-JxEUEOelHdXmcuH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7PY59wDxJBVmIhD1PaJSdOOCL_Fj9TxgrsrcCPaI-gA&oe=6A900D62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwgpN7zQV70Q7kNvwFXMMwO&_nc_oc=Adovzh6tM-uOBbBUPOy58CsDV56kIALd23kkmKkWXxBhxWTDHmbY7QhZhmbKEuU3iPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-rntPZgJQPT8T33dONmyWnDao4_bzvns451NSpAkhIw&oe=6A900EF3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nitahiFcIocQ7kNvwFxifBC&_nc_oc=AdpIM3E2ZhfBNhU8UAfWBpQ49C7DHq6MBg9buyoXLFSA7WBZPp5hu4SSIZjGiJrbeDw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZnXmVTFgM2EApK35HG7Xy9FT2gG351RHxp5TWLGJSgg&oe=6A2C07D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slIzyU9aZKIQ7kNvwHNIt66&_nc_oc=Adryw4QzHSfVfo9iuFH4Y_ZLDxafquz92-WqkaX0j0tsyni_oifdiqG-s3qGTiPy6Fk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lu0HyVaBx4r9BzalxM1mNV-NT9MHiQ-6jIzoNAnZQvw&oe=6A2C13A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbY9klQlj5MQ7kNvwH4mchM&_nc_oc=AdooMwSOFDR2jklNdD6mf6V-B4TtHe7bcxFsBhGn8fgQkNWTeuYijUihBKqQONIlgFY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vs9o91dDJ1tbY7yQD0Va5eAmj7tB2mwjHs9riCiv0YA&oe=6A2C1533"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
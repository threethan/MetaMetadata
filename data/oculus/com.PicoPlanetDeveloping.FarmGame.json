3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz0Vw2tTAkIQ7kNvwGC4nm-&_nc_oc=AdpBTqot2MZEUDspC4fIIXs3dXVvsaRuFlSdxg59MBJhoCQpV_P1DmsJVBd0WWNIEN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5i0ty4IzcDv2nnlK5T3GX3WfBitRdy8PI0WIZ-_ARPQ&oe=6AC252D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMaYAhEJRIQQ7kNvwGDqYzQ&_nc_oc=Adr1rYoYjvsdDK0XR507QX442RXJLnyqNILCANDHjxLS-AarschGqMWCJ60A6RXp6MM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGQeFUtra5CP2JNtu5Ds3s2wx1CXijsDSLWizwLLfUSg&oe=6AC25EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWMvaNrXKYMQ7kNvwH2loUJ&_nc_oc=Adqrqb-zHMUGENblGU-AZ0Fqk9H3lZG3d0s8X9nT6o77j3AbE8Qal4QajNNkmzikzkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkdk-2CCbBX0h_5KECYICiOZj0JAPDP5qA57_lPrGJew&oe=6AC26033"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC0PJP0-FcEQ7kNvwFs8Rzq&_nc_oc=AdrbXyJdSGb-CCHyy7Otq6PR6LugsjNuyWKkZQEEYTw39iOxgENllu3u4E0M8iPuP4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-POOmDaDL-4eiaqIC64z4g120mwRFaN4_adGg02Ne7g&oe=6ABA69D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K3JWvpmc0oQ7kNvwGr5zVu&_nc_oc=Adp9U2TS599W2bN2Ge6EfcrP1VTVzlm-ZCFDnIu7GLVhw_dipib1SmPwjTIK0qTjlcs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKautnbtAojTpkH7pJtS_oTN6ab-5rw-ppZ3PQxD-5Arg&oe=6ABA75A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I-Uxjc9ztcQ7kNvwHtVYMP&_nc_oc=Ado5AbZYWAkZmhFNc078405ZtsB7w44KY-h5XaUrjSB47S5ZkWMYuvOh6dNJdZlgQvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbdXnNDjeQFX2qlLLWaHXgDIWSkGXHVgvlZXCioqmffg&oe=6ABA7733"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
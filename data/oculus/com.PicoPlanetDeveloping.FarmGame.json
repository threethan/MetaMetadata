3896124280411693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imc-ZRObVIAQ7kNvwGB3nLu&_nc_oc=AdoYxAMXNeoMgWx4uREcEGFu758GfPsgxDJF73J7O0UtdPpiEsW6LcwbnRsnGzrYel4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFXFJ1VZ0RcWqxZV_MFUgypBxO8hzV_88n4MmaNNutDw&oe=6A5CCF53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRe1bI24hoEQ7kNvwFgkXVg&_nc_oc=AdoBP5vD3pJWdaD_-RCWztu_90l7twTsWxAfy1vDBCnHnQIaTXvzxXN54Y3rw04DlAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAghJ1TLBUArv7E2oUO4DaxoVFMVDJ06MScJyRM9bbqyQ&oe=6A5CDB22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jALGJKnC9gcQ7kNvwEhSFln&_nc_oc=AdoR03Xs7UPDbhE7KhCCzaB61fgxNGAwRF2vsN1BJv1KxJcqBmbWGQBcXlxrWFMCnOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkRHMNviTg0xSzJBDYvVC5gWrSnF2WMdFNPBABAvIgSw&oe=6A5CDCB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkPayeV4KdsQ7kNvwHRytHd&_nc_oc=Adop6xZIT8ZODxwqVSVOntoM5RydCoDmvFr2cxMCia3SbxTxJt4uLIsux8p5-iu-BNc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79G3tMBjhf9Zh10aEpOR6T6J8aoPOT-1LAwgk_U4dh8A&oe=6A159E53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcfiMlCgOXkQ7kNvwG-DEo_&_nc_oc=AdoeMaZ1GQfV9jHPq_NToPw6yCXzvQKP-igAYoL_NbSYAL87hTicYDogF6LQEnIMQDM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42HHjvG2jbqi7MpX6sasSUn5lmeRO2lF93T_MqCuFVng&oe=6A15AA22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnm4xOs_M1oQ7kNvwEObF0J&_nc_oc=Adr9lIA_hZDfB65y_-MK96nmZlAJv2m47X8-phv0mSXYxemOBoCeZYpPnnIYOEclInc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72AYpZ3mjZjSOAey6JY2XYp_hnKCMAnK1r5RDPjt69rw&oe=6A15ABB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge2pC9_w2Q4Q7kNvwHLmdmb&_nc_oc=Adr2SNkUCTiDHWHApejvuPrNw-8VSfeCFMuBTvV63O8FZUNetJGw2jNkApOTs6hiiUA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFevf8Vx_FGrRaCIfvMVQNzIhHhNVPU8TjmVCY2q54GpQ&oe=6A8850D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMfngspbELgQ7kNvwEjq6C7&_nc_oc=Adpa7Y6Fm3VpPz_WZJfOaexrcnDuLuGLAMwjxZYnOoTgeZHJjJbb2tsGWTD0KszUf3Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCStLRz_-0CnLJ2DpHkbKgVeMfMgRJGsdGL7EujIGJ8g&oe=6A882462"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3olKycMelcQ7kNvwEy9_dd&_nc_oc=AdqWp9CsZBR_Yp35MsiK7I2ZZy6LPiIzRXQ-18J3T1f40IgyhEmGp9ug94Y_CWgkWMY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk9YMl8jpRQDJr3rkhO6cqrMHbi4HBKAxN78Dm3AhDew&oe=6A8825F3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
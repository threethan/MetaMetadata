3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3OhizyFRvEQ7kNvwFVfPhC&_nc_oc=AdriQYL_EQPeC4zD1OOqVqoHKfQEN9ufsGJfzRNEVlbwKiAz8R_wMwRzCE3VYGi5_yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy9dut276kG0xw2rkDmk-w17-9piRVFH9gzWaDWHO3Ew&oe=6A4908D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDv75nDpH1QQ7kNvwF8ULgo&_nc_oc=Adrif9M-PDiafYg0AzlVdPGrNr3ZqRTzUp4eLZt8UAzietxkaC4kz85Dvgud4rpbt2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvlamswZi8UCzsPXyb12KPBXMwRlZcMxPn01_j5z57yg&oe=6A4914A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLqZw8SNfbYQ7kNvwE6oRft&_nc_oc=AdoEeYaQ7wmWzV8wbrvvjEs4xRBwSmlUqHzIJaVmy4zmAzk1eAcf-_duTq-pbAhVIu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAokMxWVBK-cb77g0KP6Mr6FiTBd5Wl8U97vI75miAG4w&oe=6A491633"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
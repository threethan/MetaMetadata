3896124280411693", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_VQHEzGNmgQ7kNvwEicoDY&_nc_oc=AdqeqCHOiuxZT9qHHthmImfl14GSnvved9nV5k_toTlHFtKyvP6hAJICHpsNCvanIJQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxC5TOKf84srppkzlEIOBJE1OvWeixXPU5sEZElpA2dw&oe=6AA00BD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qdHWjU-KXgQ7kNvwGdeZwj&_nc_oc=AdrWN_KN-icIf0AzyzfNa3VmrDVKqvn_14aYQUuUAh3xOTTlNXHoRjNGAGaug8ocQ8k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD1VvA7w0Yf0CBkeB3Pcz_Ns_H_NgfqDkXbrfZ75AK-w&oe=6AA017A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmF8dte6Y20Q7kNvwE-bC1c&_nc_oc=Adpz5w93j3-OqgCE13ynA0XvoO1HZ2lAPr6f1oMEJR8anFBHSBWUBmRfR4RFOA1XjwM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIJyTgZPglYe3BuerjupUk0yw8hYomGJg1wmkJjSFLKQ&oe=6AA01933"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJhGjZpPAFQQ7kNvwG567_n&_nc_oc=AdpQLqNyWgj8LP-GiuKbwrLUlzLh_5Ui9GSsbYXFjcSUwmhGiF12xOUevp-CeW9QppQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZqafIdco4GVwcUAkTm_tuAxq5dEbcaK3bVLJNKQ-jog&oe=6ADCB0D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8GMp-hn63kQ7kNvwGAIVhE&_nc_oc=AdrDd5_U1Se3S3nGfMXLFTz-o70wZMKdOZoezaQn7Q-lGv4bq7T1UTPIVCkWcr4bd84&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_nTn1xqVKAwCH-YkRGCnnDiKMNTfWINC2WAptMkxukg&oe=6ADCBCA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61svoZSA0C4Q7kNvwFowmHS&_nc_oc=AdoqOyuhEx34p6O__PDHAkvW138IKEE3aVq5iBoEqqgRDVG--q2rAJS-oiAiFrriEZQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiBDK2-tvlNojdqdl0fVKtGXKbNdmMlTH5p410ER4Tmw&oe=6ADCBE33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
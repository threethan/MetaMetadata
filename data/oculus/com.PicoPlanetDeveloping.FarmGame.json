ng", "id": "3896124280411693", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhFkmCD3UJgQ7kNvwFm0aae&_nc_oc=AdpawtEey7G5naE2Gf6LygB-Da410JPqQXhWp1wMuRtUrEuF9L87fYNJkd8XJZmgFn4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb6iqPPuxa2TZz5w-FOFB6b3G5Egi_TXJLdlVZUL43DQ&oe=6AA94653"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD6030K-H8YQ7kNvwHs3mJb&_nc_oc=AdqJunymRwlWIZ_N_y5Qa71tAnO-ErzgKFN7HpjhN33E-D1eyDaSoNNcXmPHALIL_-U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsQJ0l6aRsXmFig1LEpTJ43hEfFgS5m9bfmtL_8g63sQ&oe=6AA95222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5-kdWnETwwQ7kNvwHQCmmp&_nc_oc=Adr6eSkQtxfLLt1teYAkM4bEQupgX5biFMEbdNWElUuHgw15lg8yBYS62iNfrq8mv7M&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ZqTDnxLorgxnV8nVw9sNyhxmGwI6sdH8ZvYdqDAgkQ&oe=6AA953B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", 
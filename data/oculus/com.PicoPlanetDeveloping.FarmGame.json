3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3ihfqjBsncQ7kNvwHeMpzF&_nc_oc=Adpx-BxHzhxYGgQo30C0BItLOvoFTVprD1sqOlKOAOHy9yeAV4fJMu3S_8MYhGzqF10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5akOrvzPu37w3lZajDtjD5C7t6JTlDci92yUgZsgUz5g&oe=6A032953"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo-GZo_uRRcQ7kNvwHJyuty&_nc_oc=AdowcV2-JXS4PwwiJCoPUmuVnaWc-skV3piAi2knqBYT4XNUdVTn38K5Pt4xFLD8Fuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bfi5pKLsHysfYxmeZyH-GuFvkw_FKk6tOJ21IlMDWEA&oe=6A033522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flStsHNugUgQ7kNvwHl7vTy&_nc_oc=AdrWxSjdIHpVFx6skS63MDE_Gu-Leji4E0wxXImCXncEag4ueRjGD7L8xyNOLUHn1e4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bIpb6h_r6DGy4UOIx9rZw91emzu4qdw_ZlS1TCSSlVQ&oe=6A0336B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpydavQyxhoQ7kNvwFD_MYR&_nc_oc=AdrAfILfc2oNsg_69ZEYL6s_cQ6Yr2kNhIbjqdl5mUytM64Z2PeToBTy_W8rijg8_F8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fqz5FCOZS0XQRCpI0JFIbuPDEj88lJr1DuQLVvTrNyg&oe=69ECBFD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbmzmrZ51CkQ7kNvwF-Wwa2&_nc_oc=AdovDFpoN5rZGl9WwHXYt12eBkH46XYxmtj9KQS5JwYsbmPVUnZSvJLvmIOV_eyWhYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PE4-PIjwC8_6lOlrr9jillgHPjQvrULA4fXHtJZU4YA&oe=69ECCBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3kCvMVU7hQQ7kNvwHnN-2X&_nc_oc=Adopp-3pmtFYN2npm6XTU-Ughhk5LSacPLJSETcQ08rVCwdcVs1NVcFnZ3sNklLG0LU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25zUMNr_czPhfAVJV8mBUkrZ3-C7lqXEuPDMua__Fx0Q&oe=69ECCD33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
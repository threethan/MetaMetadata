3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXHlkq68HJsQ7kNvwF_DOAj&_nc_oc=AdprJJHeQiCT58BUIt2cYIkk9yw38Fqu-vr5bjCiejz2qaTQzAXgQLZlrAHgSMN82XU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALfRbkpDDFCWAHu9oI5jlIiiSR7ZUrsG7en_INltlh5g&oe=6A578953"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwcjKHTE7T4Q7kNvwHdKouv&_nc_oc=AdpmdVmbr4Wa1es4wqYKduhQfOZL8W6kifUAfHId_6eWSMfBIBVza9g1AWWtf0nxVUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMQSOyRQoVHFZw4soWav-S4483-Kxw8eokharzFUQcxw&oe=6A579522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AboITeUwCgQ7kNvwGtY2cs&_nc_oc=AdpzpzBDQ-gNRenRJBSeUPUnrpRtip5h6Po1r8mjfJriC5Wqg95tfUO_VYOvWED5N28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo3hG7472eeFQm6YWJJ0Dz1vJXAb9s2t_jGDhIF87BaQ&oe=6A5796B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
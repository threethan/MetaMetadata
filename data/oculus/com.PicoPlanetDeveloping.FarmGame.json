3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQOfsf2LxOsQ7kNvwFWCAV2&_nc_oc=Adqyz68s5W4li4m5fp4yBl3ZGj06HtDZ6Fpo9Xl5OULh3jy9WvM2IwpHp4JouMHAl5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Yp1c08KQB1wYPheP-l0XezG-p9vGl1kpKRlYG-IQSw&oe=6A314DD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n0y6DUyb0QQ7kNvwHok-JC&_nc_oc=AdoGKquiSodwGG3rDLZIv9CjUX2jVhex_LyNzxLHdAIqQwzWiReoW3VAhyvV0-oHRpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88M3L_gP_QlRNT--wEeMx9rLMyjC95ZMO2_1JiFjjvLA&oe=6A3159A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6ISHkquzQQQ7kNvwGZVvSa&_nc_oc=AdrjzPcDe_6GheF1UKCS6qFLmwGxugsHAznLI87U4RTppKqB6cFUhS780OwAkajN0p8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WpJdU8s2QPFlGt8UKZEueQPpbZMEO7YmUNeDniPxPQw&oe=6A315B33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
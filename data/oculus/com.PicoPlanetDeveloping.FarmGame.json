dn.com&oh=00_AfsJ1EVTMwgMZNRIsqVprGToqlPg1fgnZxB9m_Hk8a4TeQ&oe=69A048D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7wpw0zHXQ8Q7kNvwH4Mp7N&_nc_oc=AdklGnJySqcFj48FAjiHgcpdtylwdWhS1yHi4nQOdCqyy5Gfe_BCAfvfTGdpdAqDIL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGu30Ca_9q6_Yvqd--7_nO-GyisZrdUPxSih4UAx242w&oe=69A054A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0C5s_i3DikQ7kNvwF6slXa&_nc_oc=AdmJ6W3CkFPnAo7gFDzREg2HeoKBTvsIjO_W3At-hPC0MXGyeERf8uk-xcU_bpCbNls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLll9kM5JbotkYGmlhCDZnteCXop8xdTnYjkVKj_vQSQ&oe=69A05633"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
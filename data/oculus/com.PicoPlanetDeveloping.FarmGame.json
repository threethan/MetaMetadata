3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKx-ZHFqvgwQ7kNvwG8fypt&_nc_oc=AdoiIT2bPnQf1PWSsb2iJ2zAuOP-2APbcZHWyRFiskKEiCdz5lJr_ppUi2QsvgkWt-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1y3zQUvDh_B2O0B9udieihcPCw-D3fuJu6NFes0kTSIA&oe=69F74BD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlsc1JxF84AQ7kNvwF-Ps4u&_nc_oc=Adp9JTk-hKdQBwsT_GoYWpW1GiY4bpvonU15gPcU3bqZbUCjYSEMr1VuhcEyq0D497k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3snmkhiO-i8A8hbvtTJYvYFQPQRsGfGyxrt1ji6XiO7w&oe=69F757A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRwhqwgG4EIQ7kNvwGRFAWu&_nc_oc=AdpJ8MK1b3m7yaVoqWkPVeXbwvljHxOHr8mPWljlbBLnqjVxiv7Ig1_LkehS8_KGYPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af240jkMZp-kzmTGSVpIkn5vSSMcVehJVq6EhevIyiw4jg&oe=69F75933"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBHssSU4QckQ7kNvwHTNlAl&_nc_oc=AdrLdNr0x0QhcCNKIwnXiB5aXJ25Q8cK7LgNu6U7334dyO_teycyqAIJAEd9e3-cayE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s9BBSVFlhlS_-Tg4W7qSAgYjejGKqym6miZxrlXdv6Q&oe=6A2D5953"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slIzyU9aZKIQ7kNvwGf-GQ3&_nc_oc=AdpdCkp9B3KCXKkvIP6zO6p2adPbTuh3cLbknOa5CzXAca_1UMHF0vAF2knwoUmCRlc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1tLLhBd-97GE8s4wFM2qkL9q_W-7QM2xd4JwS6d9YzQ&oe=6A2D6522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAF-un1QcMEQ7kNvwGgPane&_nc_oc=AdrkBFI1HYwTShA6xCTWiHghe2skkC9y6D9vVF4m2d-npjpG-trcMRaFwj97ATBDeig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-geCuAhV8PeSy8tEydjBfaw5zdDKuzAz3dupRsDbdnDg&oe=6A2D66B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTGn1YBb5DQQ7kNvwF-jwy2&_nc_oc=AdqyYuBjB5lRoxFMW2nZfSKRaoqMySmUqS_8d5vbU2M3HW5qqm0Evwu-hAXOoAivJo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxK6wM89Xpf1mLTuSHitHXELH-wKdfPuaEPArgX3NgvxA&oe=69D11053"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u8o1hhRdSAQ7kNvwH52Z5-&_nc_oc=Adoxd2Nv68v4G2xAYi0S_XurulIdv_Z80Kq_8yUSzL_w3MOjVks6H1-fT2rDQOFCVSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKvtoyUM2P-ZJQ7eyqY72RvOyPGNZBgQxsXvW36e-Wmw&oe=69D11C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2ndF2kyKzEQ7kNvwGYu6z6&_nc_oc=AdoOtjaDx9Nkh5hhsEeWHkX7hTwM80kr_YfZ49SIENoGFpmAujLOYnGMoivCxVvZwME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxb9SCXogvakEV6LyQ0JnU2509L3dWFHJso5NTNMzyLkw&oe=69D11DB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
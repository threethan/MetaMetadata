3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WjKQks3e7cQ7kNvwHXfo14&_nc_oc=Adqp2AVRcIjVbDjll2N3VLRwNCrsG0yG49SNgwHZzU0gT32Qhm8CRJ-IOqEshPuPOcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVZV8bz9hyr9xVh2nH2fjnY0w7LKBQwK9MQ92Io5Xilw&oe=6A8C4553"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7pC7OEXbNAQ7kNvwE45dM4&_nc_oc=Adpxp5kYwvP_NEfQ-hPb-Hmt0bkKj5UvW_42YysXdu_AyZmb2T_gI7QFhdh31f1Hz-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK-NW_EkLtE-iHWkh4oRrpNDX3bLu3aMJvClFcQPIMdA&oe=6A8C18E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqKkfX5x6OcQ7kNvwEiTAnY&_nc_oc=Ado4SLIlQDvZZO7PSgvGr6zqygv98KGC5b6xIR0GHQ2g--pAtIWzgbq15ItxGCHB-_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc2YtR7lzKeALgJof4xZcVWrDXB0jJD-Bo8ivTnu7IkA&oe=6A8C1A73"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqpXOqg8HHMQ7kNvwG1rzMI&_nc_oc=Ado4yv5KSm1795GVQvL0ByvbXv-WIgi3toiySplpf_1ZCfWZZbjsUJeOf2lG9oaXi8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh2c9LPt4EBN9GKnZcSD_w9iqoOFDP15yxPj0TrzCEOg&oe=6A60C3D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bi-BfmjZBkQ7kNvwGjC_5Y&_nc_oc=AdolJBbx0mHYFmvJ_kPp2EX-8ZI2ozoXVcDou4ghdY_J6wfUgDQJv2wjXS6zEBSiXPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZBnWGiPbQdvvTTzA-bB5JeOBpK8SC9MeRHgeVE-gX8Q&oe=6A60CFA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdlzTlVbKkcQ7kNvwEScxbf&_nc_oc=AdpLLdD5w9QzLgRODTmLJEoZZ2i1EwhrBIddLEdAt7Y5NV9Xo1albo1LzEC7IRF8yDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrX8WdRro7R9Sh6KV9YYy5yoKrqIpJ6ffyb5BG4YfLFw&oe=6A60D133"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
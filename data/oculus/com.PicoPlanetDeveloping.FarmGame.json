3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR7LNuGRn1UQ7kNvwHDB6bT&_nc_oc=Adr5At9N3QfXSCjkteQ6M5KcuJPRL48AAorg5sSEDVCkxF61E53kVspUVq73jUtUgr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O6ZqBehlzC_L--owhg-SRI9lQrWk65qRwmx3cR81i0A&oe=69DB9C53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbzmiAnHRLIQ7kNvwF78d0u&_nc_oc=Adoyp4ikvupEvWgD19E5xTSucf9Oqpd7S_y9QA1aA_Hu40crx0IdGjoulNC6d0b0-O4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ILB136ZSLHbn5FpuCRPFXic-9GuuKbZUw3nMXhkoguA&oe=69DBA822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of0qIka4YCIQ7kNvwHBqi2x&_nc_oc=Adr70fo-zmYN6Ej1ctkq4DQv_fUj862bpo4-iIRdlLmlheh9rb4sVivYMaFVvdbjKBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wJ_RWD-fd-cdiYde8aU4L-1yTvawCBwpPruwBd0Yb0w&oe=69DBA9B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
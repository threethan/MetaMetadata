3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aKzEUjXQNoQ7kNvwFs1tS7&_nc_oc=Adrq9nsX8iqPEbMD_hozgm5aGnzwaZ-89kU25UPX2ttgFlSaTOAnqBHiomAZjp46M0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQzBooq76Sa_GBd6_jEXwsbrbPKAs02NlGC5x_C52qFQ&oe=6A985B13"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBa6KJ-q0hIQ7kNvwHuo38m&_nc_oc=Adp1KktFU_S5D4XxHlZgKh_B2kOZuAFCSbppryycYgL2Sot14q_VlZKA-jrpH02vkw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTKZdy30ZH80KLF06Zsa2KLbuznv8HjIufH9pew5_wYA&oe=6A9866E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ahFUDCGwcQ7kNvwFmb77A&_nc_oc=AdoB1S1HAGdegE4T1RBqWbeIo0jmHYujPRs3shCrzMAygQODODWcTo7dLN676W44mto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkNmy99PwUiQ4vmaCU4KkUtBiSKn8c1V4nxwMI2hKhMA&oe=6A986873"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
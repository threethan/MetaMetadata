3896124280411693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csyJPeAtqN0Q7kNvwFmi_ky&_nc_oc=AdpVpxQzqLS_Gg4Y0AlAIyCyLjQDGAA0cmLBcHPPG8uE5jjqLEtJtPgadTPrHZeLwZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D6moyUAyrWJGB2VCX7VTu0tECTavhB5SjdekAE7AQHA&oe=69D8F953"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slhCCl4d3_MQ7kNvwH8opWG&_nc_oc=Adolrm3YgyugMd_Wwr5w7E129mpG-T5i8fhYW7F6YCYlTteWsQo6AHwzL04_dC_7hzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pAqo4RZBpkk7TsL86kVt3AAXlR9pdF5a4YsK5rr1p3Q&oe=69D90522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8EA8gcGsnEQ7kNvwForIDh&_nc_oc=Adr8zrsL-ov40Rx8zInZ8YcjzZ5wwgBWm9ZlywuN2CcoY3YAyIgJj0OSZyCJSgejj2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25cSvaECRWhS4ZOEZv80hsSBHbKVNJiVQ-EpcCnPqbVw&oe=69D906B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt-LKV-XfxoQ7kNvwEb6DK1&_nc_oc=AdpJBXXEUBpcT81OfeLIaBPAdq99PPVRbpZzx-I1FWEfhE7LRlN1t2lym7jaC8zLZlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCBdvyxDh-hNCT0NQe5TMqrDIcqyf_S5oX5MecsqtdoQ&oe=6A50F1D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHtFrsxq430Q7kNvwGUxHYP&_nc_oc=Ado8e4vc22FL4efqo8UEHCOeoXDfaaPNwlKkJJG8M9eERNGhKOhLlxY3ant8shYUdLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkk9LTV6ZYaVwlTvADFL0fCl0NPjM5aMJa8aL_DrhBCg&oe=6A50FDA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnDnRxpO_AEQ7kNvwHpa_xb&_nc_oc=AdoVl5aeYhfPh_slYCXzFuJWKSjl6B0zlqZBefDK-YRhF10klXpp5L0a9K_37kH07dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA325zvE1dPDLF-j04WiIgVW5Z26OHymN5iz9daIMsB9g&oe=6A50FF33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
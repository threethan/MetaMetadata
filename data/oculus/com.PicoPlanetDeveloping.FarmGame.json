3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2GAzNJZDf0Q7kNvwGn7Erm&_nc_oc=AdpVaIqpXY6cEjSkJIpV5ExrwaERf31tqHcjSaAS1xVXfgguUKZkLA1ucIalL_6HzUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UMe-nDfY0TTkye5umx_j7Ez-pMvCOOdQJqibqSO9cqA&oe=69E0E253"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjVvszp7Y_MQ7kNvwGoFbgk&_nc_oc=AdpNpBwZsrHyFOjxSlHIZGZttWL3xMIyLbelPcjWlcBI-775BzhFhKltIqA30j3eldI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14KeOp8uZxdoXCcAepWVba6P3tM0rNou7ZAyiRLQbEgA&oe=69E0EE22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qfOb-6UDjMQ7kNvwHjDNrj&_nc_oc=AdoPj2HMTSjj58tUSkcDmweFgvET2fZkOj9SqqxS-b7v3TXpAU0ytzbBqlerYBjVY4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jZfJKa7zsG90TdwlbMHGIOaE8jh9dcUGSeQYVtpmzQw&oe=69E0EFB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
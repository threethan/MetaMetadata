3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqpXOqg8HHMQ7kNvwG61enI&_nc_oc=AdoamWkmJNIvoPVF6cjGKzplbT6HesxgIfkZt8CXKKfXVpFgVOuC4KqdOVv-2zuAkNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtl_EIhowBV6oKCEd-y5T9N2wHrDdOjgXC4Ym1jzvapw&oe=6A6366D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC5_72G2N90Q7kNvwHYPDKk&_nc_oc=AdppaQXiQ_32RFSkCUVIfbylf8uOBHq-yDKPk_Qb9IifGeuN0SbyvW54XYgPvU5C7Ro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1llajW9lUkj68aCndz1fgj691wMVaLJDeNzeOfd2S6g&oe=6A6372A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdlzTlVbKkcQ7kNvwEvMSLc&_nc_oc=Adp4DGvNh7mEPaizeh_1p0kfklFN56IuNmLaA-8W9wWlo9c-D98EsukqMHCsrF5X-gs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL3h9Y78DmYN-6RP8ThhPfitO4t_PCmQxfSAHiVSYJ5w&oe=6A637433"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
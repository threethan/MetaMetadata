3896124280411693", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbAFYyJ9KScQ7kNvwHWKirE&_nc_oc=Adqy4Wn6vdclWZoWV-XfnBn5iQE9iTlqrE71LTsLIn12_Cs8L_0cByfWY1j0sfnPUTg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHWt1EENCKl8kWOd8hAod_-sEoZccEqfVMPBeeFYQ6Qw&oe=6A9741D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBa6KJ-q0hIQ7kNvwGodNkr&_nc_oc=Adot-Kseka1Pjn5uPTLLvO2xi_njPGGM11D7QcIHA4u7eAycQr1oTaQaxsQ71QaIJkg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7ti60YE5NbKMyKCO9K_ItFW3Q3vi7HaLbbnJNYXKmSw&oe=6A974DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ahFUDCGwcQ7kNvwEFRjAI&_nc_oc=AdpbP77zYgHU2vzvhsE8ZkfBMBW9D8q4hTBEb21-LsgHiFfzxmi26pUZB3iWIoyaeQY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLIh8ObsrRTclfWuUVcv6OG_kRPOfUjmtpCzn84Dirbw&oe=6A974F33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
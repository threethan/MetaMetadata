3896124280411693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLapvF3c42YQ7kNvwHZSKA-&_nc_oc=AdpmJc7tJkjKxr-Of8m7AR3DD8NkygxIU0XrSTvVhwlgUBVNs1e_hFhPiQ83aErjKjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IhR6wjGjLgyH1dJjDUiQVo8bqpso-iRKdQe8gl7FGzg&oe=6A354253"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1AhXzwlCW0Q7kNvwFHmpcQ&_nc_oc=Adp72Y2T1GY-PcNyN1odm9IYH4tDtmIDrtA2YSb5A-wQ2WQpHFZ4i6ZBcdoIfXMOxbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iSxj-5PNFjTaIypspMyFGtIRNO2CC37jeesrDD9YZcQ&oe=6A354E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC5jROhTkMgQ7kNvwEChwLj&_nc_oc=AdqOxdshhyW4s75nwwMMKKKczdLF2HDyjS0MEnVl0eQtiv6T1rePBS8bbhcy5_7xRsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qdjp0RDd9HLAkq2JEwbHaGRmOMVVxddZ0wgXoqJH6YQ&oe=6A354FB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
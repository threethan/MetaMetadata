3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aKzEUjXQNoQ7kNvwHYml1A&_nc_oc=Adr_MTw4urUGE0EQmntJfiO5Z-6o9NsoDeUtEsGhNqtg5BICJpBSdXvwaxsXHgRQz_U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl-geoyc1eNDsB5ub2du7zJm7zD_VMeDivFEODPxo_rQ&oe=6A9AC5D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsfRUyGu4LMQ7kNvwFbusT4&_nc_oc=AdrbsY7BETcFUjouL9F_h6b_JqX2toz80eZHEskgF5aOo7anklfTxo1mXsnPn2tRHXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2RJn89_hfjRmUGqxUyuwgtrlXfPvyF57ofvcZ5IJobg&oe=6A9AD1A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ahFUDCGwcQ7kNvwHWB9ZS&_nc_oc=AdpEsMojd-_We82noQVJ9K-2G2tehb64epsRmbumCEHhUuKlWARKE0YEaKgpBanqUDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDHzPyzeoKAeYJ2q7ANCsxxsQDz_dOfDVHm6MpNp9ULA&oe=6A9AD333"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
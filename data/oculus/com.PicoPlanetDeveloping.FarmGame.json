3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1IwNvx47FgQ7kNvwF_ed8N&_nc_oc=Adrlp35ApOKoSgqQz0XJETp6WZrI7PLF_d4K4_tNYrIe2eprzSbeuYdekhE9AISZhac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEpbvMt_sYKcPCP3PYCZDkF93016bRgjJGzeJOcH2PdA&oe=6AE9DFD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RHeI4PDx28Q7kNvwF1z8gi&_nc_oc=AdrPpsHs3q9y1dsaKG3c7Zfd6BhW5L0F8vdCQpqh7zuycjkSYjnMvpPhwN03l6tNNaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBV8jIVQ70BmqiX2VwNrOK0VYxdb957_gJxdwiAYkvcA&oe=6AE9EBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RhqmpFoWD4Q7kNvwFVwWh_&_nc_oc=Adq5XlzjT0WxdOvJBIYtr8XWCnKAgUHYMPSQE0q7-rh8naLfFb-RcIG53VJsaZhwA4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg_2X-H0rfkq48sdxEmzNl_VfCdBb2Zt2rpuGKtw6xlA&oe=6AE9ED33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhFkmCD3UJgQ7kNvwH3aF9D&_nc_oc=AdpRofPceCYUuLd8QtsyqypbQcBcIJmdEoo9NjVZCYJ26EMSsx_PDL5W3BckzjiB8kA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMbeVozYDXiW3EWfmmUJ3FzjNerBdsidmE3RdygRhlGA&oe=6AAA97D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD6030K-H8YQ7kNvwHnDcZE&_nc_oc=AdqPIROcFJJS8cfS0Td957VPjPUbOBc6hxqrKtBg8H8tmshMYSThWDuoBNFjSlsZucI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWWAUSsmOayqqbteoUSon75hbqVs4-8MDxt2AaLbIf5Q&oe=6AAAA3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5-kdWnETwwQ7kNvwFy9wII&_nc_oc=AdqF-3mJdSAHERhhVuMhcMs56fOyAL7KruWiEZkpvwSe2g592B4fvWgE9GXGej4d760&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2TbgBhhxDKScvqMqavo8CGo6yzYB0KXI4Tv13OdcGmw&oe=6AAAA533"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lVdXFDBpVgQ7kNvwFuvJIu&_nc_oc=AdrKloj4TCpFczbwKOuqk4VWF9pGlWHHbb2IxAnwl7zoVHz6wnsW6BfW-Itm0EDVZZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyV491wvc-VBgElWoxJcm8tTpXjah_Li4At1VSylsILg&oe=6ACB8D53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSw8Kr8oiNcQ7kNvwEyZFtb&_nc_oc=AdquItlYvj4_qSGqNca_HRbSyslilZ30fCvEcPZu_uyxPKay9ijbknKqvzjp61f6W1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFDkcVnYkwrKOCsLG5qylXZ4sbm9sB2vBjIphFquJ5yQ&oe=6ACB9922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MNzmj0C3doQ7kNvwHNmlZi&_nc_oc=AdoSPG7cjXP6BUDbRcAv_N5Vg1r2qs-q-fT1KIWOT6j4lI9bnIdSlSABe7VxdJuBg4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0QiKSl6NeGF0DlKeGgGi1KwQIVJzGhHEe-Fholk_W5A&oe=6ACB9AB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
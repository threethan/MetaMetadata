3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQOfsf2LxOsQ7kNvwGWGpLN&_nc_oc=AdpKONrA_iz0gaUwN15SLcryVe4j8nKZIUOZHcHcC8L75solKRxclfyL6afujAjSk2o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pvqhcr5XPYpyMKCechj-QPAFHRP1_zhpihEL3-3BEPQ&oe=6A329F53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1AhXzwlCW0Q7kNvwGveuPZ&_nc_oc=AdoD_KA6gdZA7o8aaFUnlg50OmmBFoyjNOTVLsrmn31-AKAXN4xeF49_WBrrkB_L78U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YfIy6p04CBRRCz2xZ8eR-2nAM82G_8z0c317P5xezkA&oe=6A32AB22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6ISHkquzQQQ7kNvwFr-iK4&_nc_oc=AdooqB6mLKCrTfLslMM2APMN8fY6JDJH41ZaEmuQvDRsQdCzSMkwLE-aSE1dGHZ5loA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Qmg_gBtivampNF6oKuA_EPdg_Kjh2GQo9pWcC329eQ&oe=6A32ACB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
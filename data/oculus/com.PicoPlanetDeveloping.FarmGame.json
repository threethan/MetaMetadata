3896124280411693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJGZzwQCkPgQ7kNvwF1nrEJ&_nc_oc=AdqOm--Q8u2qZvF_3hbGOUT99_PDUvPPKjuIaHGMmzHcXOHqjakrhyCUPGrlScElRrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01kohVZb_8bFQl4GbDYwd3ZS61CTCu1F1rbjymX8fjPw&oe=69D261D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u8o1hhRdSAQ7kNvwEJ--Y5&_nc_oc=AdqnHrI1p_UqaEdpQm3zpYs5BTsiNoX1kQDgEoAnkpZDq2EB6WpV1Kx0h2Tb-amTTsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34SyETqU_bvBv2lhLpX8NMe8bpb4uBMog0nVuSoFqnSQ&oe=69D26DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mp6H-Dmw34Q7kNvwFgnzbg&_nc_oc=AdqVVMdm0EZdOxpwns8ZPN_P5ZFTtlPxu0EVeJJzLBsWvptB0ZtQ5xHYjn-n_SsF8zE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P0m0kElRMl9fzX8616TWt5ydFf0wPx_AVvhvfF5Gb5w&oe=69D26F33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
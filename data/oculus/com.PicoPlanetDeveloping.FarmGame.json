3896124280411693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTGn1YBb5DQQ7kNvwHO8_jT&_nc_oc=AdoJX6bnh3oS-AHgwMuPsd-LYZV3jtSNFpYAYEJ9Rv1rDCwlptOTYQxu48lZL3uZFug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWuuiAtoPZUdBtM6quHkws-Vw6SNx1MdzWWTv-uiGLJw&oe=69CE6D53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGD7Vhegia4Q7kNvwGmhxJX&_nc_oc=AdrYrLTk_vCIE_3UGlrvUSvjL8ggoTmSv1-f0sz-EaseRhxMuT8-a823BEPKQdv-huA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy92VohrX6TX1mfMnKRkudM9OxeQEz4a08ibdiyGz_2Kw&oe=69CE7922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2ndF2kyKzEQ7kNvwHRGJBR&_nc_oc=AdprSQ5nPiL0WUThrHkrMbo5Uf07LPcKjzK0Z9alZ9wuOnrdUDBhzK3j5YHVoGoyboA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjGfiM8PtHvb9B18_D1o_Nusjq_TCV22-CsWeBPR6A6g&oe=69CE7AB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
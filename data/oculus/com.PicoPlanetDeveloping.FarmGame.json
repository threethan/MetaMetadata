3896124280411693", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_VQHEzGNmgQ7kNvwEOnkMa&_nc_oc=Adp19gWcEtMClZFTK_G-QIKbckWwSc4UHoCF_tnu81MiMtLJfs_7QgirvGQLvCaNYyQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMRiYsYHPTDXHMSEqSyAlBx-MiFUnmWxR3SQmR1yaPRw&oe=6AA15D53"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA0pLnZjVBsQ7kNvwHW-b5k&_nc_oc=Adqq8TIiOmb4g0i6_o3FVCu2SGZ4yEkWyqYLJ1tVC2zw79FQcHIkmeLobqFEtVkjThY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiWkmSBcRZiIIkDg7EoWuoqehBask8GSX2c2bVoAq-xA&oe=6AA16922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmF8dte6Y20Q7kNvwHiS8rM&_nc_oc=AdpcXuniFc4Rk6h4j23lHHZ8n-EPcm_tYHvWBjbMRDXzguk2xrZxfzP765kjaqnBi0U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlWMBYEroYjttiVENX_z_Kv6Jlonc-998pDq_3iqB4eA&oe=6AA16AB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
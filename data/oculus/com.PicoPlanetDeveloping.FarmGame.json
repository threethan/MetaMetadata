3896124280411693", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXHlkq68HJsQ7kNvwEQpsSi&_nc_oc=AdphD8_Zm4V1ab3_AIr0lARY5_JPnJGNZOzPo01VkNmKRC29w2_8oRYxzZe4kL9AYj8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg7liRi5QjciHYK-8B0wsm92w7gTbN487F9KBIQ_49UQ&oe=6A54E653"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ja-JVe4WwMQ7kNvwE1lx-U&_nc_oc=Adp64aiD9ATzq9by0mvcTyJaOio7Qr-X2usR-TmK8GIkchwI82oe8ytS86eHJAyq0QE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWvp_CuLT3vGnFcuQgSzdLc0Cj3vt1kgTILaacIO7RHQ&oe=6A54F222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AboITeUwCgQ7kNvwHmDpMN&_nc_oc=Adqid9KqECYbU3fq5WaL5iw3M7bCIul_1nQ848PX-_sccfOInuigrbG6s0ljaljWiRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoufnsVMrVGlUubzJtBtHYmoss68HDQAeIpcHAlUEK3Q&oe=6A54F3B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
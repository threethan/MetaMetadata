3896124280411693", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQCfWZMwBgcQ7kNvwGPbI9j&_nc_oc=AdpS1gH9zhRcXOsNE17JCfLbrWDcPy5pyaCmX1nxoJ30_1mrfwjHCuiRIzt2M9I-kQc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpVs2LCc0FF9IvzFWdSosBSBUuYxXDYGUFmXJNv7_gBw&oe=6A92DCD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SYXNnj6yZcQ7kNvwGeYj0P&_nc_oc=AdqRFn4n62sU-CwE8BO8iUL9dS-OaGUcTegySmq9uv4G0nMdW7IU6GON2IhOZTnKnqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLoyv_l_QTfk18ymIX3peKTGfjn72sgRQnBfPHbyJkdA&oe=6A92B062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwgpN7zQV70Q7kNvwEdccuN&_nc_oc=AdqjxcMEi61IFBfIUOP6AYZvWM1eczCs0xvn0YJidXQfFJ9Mab7a4EJtZyTROd3yrk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0oppNaugyeQi6DPW42A5uQLFbpJbqlv_akikUt8kXyQ&oe=6A92B1F3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
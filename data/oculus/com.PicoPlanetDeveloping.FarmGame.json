3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpydavQyxhoQ7kNvwFKfHW3&_nc_oc=Adp9dkEH2LZ1fOpWfGrFek0vY5g8uoWdMvtD4Gx0asz0JSfUHCvhyS1_7gh8D1bx-Hc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b4e3LwlA7Yr7BAIxO0GBPzavI2Nn5St3fwQjfTsPKmg&oe=69EA1CD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RutcjZiA1IQ7kNvwHcWulg&_nc_oc=AdrM9iwawMgZAAK4ZW7iD_y66OPyyr5OMWOYKYvTLg8HC6lWhhz7vIt2uLWs-eQwu-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SjTiNXHlnSBjlVu95XeKueIm-qdc7ui4-2yuL-Azuew&oe=69EA28A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3kCvMVU7hQQ7kNvwHrrTdi&_nc_oc=AdqUdOu79tHmQtZ5pLGQjoO0OqdGPt-E4JSGB3UleJxKIQQ4XccGcS_5u4ka9GXxzkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kU23CGcQ480wwZW1B6zkRHKl9h0m1bNZCDc-7cme-Bw&oe=69EA2A33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
ng", "id": "3896124280411693", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLapvF3c42YQ7kNvwHRXe9C&_nc_oc=Adp2G2fVaDyqoBc5WK5vke72BEYVb9GNjCUGWoHqq4F2uupQng8CngR1kr2OJWkxYU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VgL2y6NL1hSqGJcmkkzfxsi9mndJ9ceQ4Kfm_pbxe_Q&oe=6A3693D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozxGdWJvm48Q7kNvwH5w2ZP&_nc_oc=AdoJWrFOrAuucqozB2azorSK2YPbjwGmo-IcHMZNpMbp_Lvpm8aXSQv5fjd38vE34HU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OaCpxt2Vu_l856UbfFQrg5_T2t6fnTY_oSJ_UuijMmA&oe=6A369FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC5jROhTkMgQ7kNvwFpQ01V&_nc_oc=AdrbclJ12M7lJCDxf5tECfKDb-jYRU63ZTRjZscSY9J8mjLUwVn44aozbyDQOT-S7Yk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w8DojiF6kjMifEyyeUu6PpKAlqbbJ0rQKVZyZ_wGsMw&oe=6A36A133"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", 
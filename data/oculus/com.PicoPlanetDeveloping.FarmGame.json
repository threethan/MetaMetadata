3896124280411693", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_LjhwNkCrcQ7kNvwHiEB6h&_nc_oc=AdqG_5lvkYedVcwDQC2Pu0Ru9gFdnC4_tgtqddGzOwjlXJtMmBMAeYc-hggeRPENjsA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqpJf7K9e4_6-OExqifzrPM6aIXUEG6a13C-3Bt3pdmw&oe=6A81B953"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El2NQpaaMnAQ7kNvwEIjhPb&_nc_oc=AdqCuy9zqKUmG3FDkKsg9CpWCUCHi9lmE9nWch4NTSKO3-u7NND1EVU5-6B1m-xf13k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPNCwJzFK2D9NOOQwedSabpl5NslUCUO8rvvR24txJ6w&oe=6A81C522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t4Wy_k7wgYQ7kNvwGzqUmK&_nc_oc=AdqIqenUFio68lV7tctPKGvcOEu3HqqTBhaxtQnFsXLq_yaVrwJuevCmXzIkDSoevFU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLksXqLr0p81WF0Ja6Mth7RfnF7GzxIUzAtjYqTNK1qA&oe=6A818E73"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
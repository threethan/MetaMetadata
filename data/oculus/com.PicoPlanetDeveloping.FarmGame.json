3896124280411693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WXQftDX0noQ7kNvwFiQMNc&_nc_oc=AdqBjoUCS0ceCXSkwEj_QjmYpAUQBCB-6f4lRUouVViBtdQOufciN5wh6Inl8FMoAO8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF8g-WhkE90P3rOLcNctJn_MN-h6qjyLl4mycDRpvmJg&oe=6AF0AF93"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yoc_i3tbvqMQ7kNvwFQr3p-&_nc_oc=AdqBHKYS1ntNafre8EaOclN5g0tLgfwk-vMBqkeE_y7k3Qn6QPbpthCakjNu8w7X6_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRblNVH1yg_4HRM2ZBVZVCJTgSFtQFO8rrIbqHE2sv8BA&oe=6AF08322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9H_N0B05sgQ7kNvwFDiUw-&_nc_oc=AdqBiSDokcebarxOsp9hBp4tYMCb6t9NKus-MNAUa4g2XvlBWkJQ7gM-hqUa2Met5hs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpci7l1P2mpEI2jLJz5mBhXp8N0WmJa8xjFR1I8UWbCg&oe=6AF084B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
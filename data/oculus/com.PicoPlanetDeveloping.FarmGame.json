3896124280411693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR6pKYMTDxIQ7kNvwEpgCds&_nc_oc=AdpDfcKhccdTpwFJ5Njo4usxynpp3SoKYv0G0m9EUf_-hHcnemzjpzPlDASQXtgIhAc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8t7904z8_8k8RAl9tnknOs6-5Uo8SK7QBj9C6lXt6Wg&oe=6A6609D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLqLF-k8rs8Q7kNvwGnCsay&_nc_oc=AdqLfKwZpJG0Ph-IsqzHwjLg4PYHywp-Adf_sQ8AAaV0yY1gA0ivJBgaexzBl8YSdWw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2glFva9c2k5zrSm-DhoLu_pW4MSM7YCWRwO9_bPUAWQ&oe=6A6615A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAN8xmSply8Q7kNvwEZz7yO&_nc_oc=Adr1YUzl3T2nlrOuIFciCpFElLZwkgGnAGNx2qZ2y5bRswdmnlRoCv_r3k4bewu2oOo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwektwtnRCioqilq6Lw7y_3epRipN630DYWcBfkear7g&oe=6A661733"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
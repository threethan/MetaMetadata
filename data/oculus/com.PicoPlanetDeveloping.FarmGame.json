3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3ihfqjBsncQ7kNvwHdMAjP&_nc_oc=Adoy_pLuuSs0i9EIE4e4KpwCO5SZ_DeOzhHKbVvJEUj8ZrukMwzIPUoe_H_X3DRkKMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y_8w5U7PtKmY7V_YTRTYRpeF-0yU-ka8925Jg_8JXUw&oe=6A047AD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo-GZo_uRRcQ7kNvwFH8rTc&_nc_oc=Adoa8qxYdCA1auKI3UrJ4VEPnaJHQff0Gxf3NkhC-uQmITa-RsNb-fY-Bp0EtEqLLfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P1xqQojvgvbx0b2tplTUgPj3VjuOC_xOxp8Ev403BBQ&oe=6A0486A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flStsHNugUgQ7kNvwEqtOaO&_nc_oc=AdqKOE2t4Jm-rk0ntazBJKgcGxg9SCJ2rjA8BGyw2j-Sgw1t-nkHczu0sRbDiICYe18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UffbV0X0gjjetTqkrUUtEWbJvkh7nwdjtKwpHqm2bwQ&oe=6A048833"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
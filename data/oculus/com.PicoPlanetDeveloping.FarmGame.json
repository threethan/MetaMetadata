3896124280411693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imc-ZRObVIAQ7kNvwGtQCXI&_nc_oc=AdpvDJ8X923yjiMsj4sZfONl7bTrHhhbtmpRisYbxT0C8kjHZQMb4qW2Orohn2Ph_UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMD-f8dfLxYbyk7nuVGAwfL2MeFk06Y70VfleV_OxCXQ&oe=6A5F7253"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bi-BfmjZBkQ7kNvwExYZq5&_nc_oc=Adp82WMIR4s3GiXpc0LmqPZtvjINFJUCqyCDIZrjrLw_nO_FXCgmXg3fuGq6KY4yDek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNh32nzvONxDNyJ4rp1HCy9gt5B613fWvnRQCn-TthDA&oe=6A5F7E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jALGJKnC9gcQ7kNvwH3jxoR&_nc_oc=AdrSahRkmMhECNxXrt9JZ13AFoYHjeHN7OWfdmHy9EY83HI5njtxWq-LGxXjJksizYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6GjwuYHX6hUKP2TYgHc_XWfL1CEepCP-ZTEJByb548A&oe=6A5F7FB3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
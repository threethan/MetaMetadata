3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTGn1YBb5DQQ7kNvwH60_-i&_nc_oc=AdoSK8vy0Vqzk_DaQ9-mgP6yKToM7JsP7TlRF1Qec9GTRrLhZ-RSAe-BvX8lW6U2lkQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAoGwUr5iaGDhzXou4_aEFxAO2f8TL4S05qxmmEg7YuQ&oe=69CFBED3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u8o1hhRdSAQ7kNvwG9wHMh&_nc_oc=AdroaSCDxgcLVJI7nxyxUhQtk9jtwPtAXWP5exz7gbre_ng7LWfTixtbDRKSdQBRX8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi0XH9ECQvU8AwQfgO6IXPSjkvY1vXB7km-W2yEX_rBQ&oe=69CFCAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2ndF2kyKzEQ7kNvwGqiPh9&_nc_oc=Adr9gkII2wAX87nmrgQnXDdReyHiCjQzOF5TpvTvLfAbOtEFpEFtyR2YdaCZf3Rq0bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnQRnFR2BJNphBhY7GtqA4pk1eTyrCUY3-dKiLtDCm4A&oe=69CFCC33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
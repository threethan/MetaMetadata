file_name": "CoverImageSafeAreaTemplateLandscape-Trademark.png", "id": "1465782734237201", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75395588_1465782737570534_1852866444084030374_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWSBaIodmsEQ7kNvwFpH7Qx&_nc_oc=Adr-NsIJKCdRpzvLoDf896uqndSBzV14sVs8GDT3o881GkKMzOnvJu-NLFIbkgi0CL4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO2rJK2z1QGWAhPsW2AsSZXrRxtXy3kDFmP36haYKNxQ&oe=6AFC7896"}, "display_name": "Crop Craze", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farm simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farm simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "support_website_url": "https://picoplanetdev.tk/contact.html", "website_url": "https://picoplanetdev.tk/farm-game.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FOOD", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nu
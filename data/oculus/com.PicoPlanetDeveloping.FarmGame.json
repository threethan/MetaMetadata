3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AKckMjP17QQ7kNvwF09aTj&_nc_oc=AdrsDfbcomX9qFl-P0xGjF9tDYfQ5vrYLKct6u2W_sXyyHlE-vZS4nPlOb_jaRIPyWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjVQd0DkU5yQzCifuUND3QUad30-GyzSjRjl-1pE5a-w&oe=6A6F4453"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9ecco1Uq-sQ7kNvwGCsMSM&_nc_oc=Adr6R-kt32RSNeIt6sE6IY2Yz0lEky78bjX4CfdI8xVSAwew-ycwLgACQV9Bql0Q7E8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMtU6mX8rKEXU_IzwByq5_pqxMP68SnyKrnhLVZ2z_8A&oe=6A6F5022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSFUzuIRj_8Q7kNvwEltBeT&_nc_oc=Adr2pI5J_qllpT-pcNZN-bvHFtE9qM4PeyTB5Njoo0BIsSoURjZcN4KJM4ZrVi97L4g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq6ws0lukCv8CeZh1VmgBB1c4X00xcl8xxcMt1tQXkbA&oe=6A6F51B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
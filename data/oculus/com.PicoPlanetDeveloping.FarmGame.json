dn.com&oh=00_AfvNMdq6KmfQKOFmH9X1mFSWjRY6wH7WIpJL_dQkez4pDA&oe=69A2EBD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7wpw0zHXQ8Q7kNvwExJ3as&_nc_oc=AdlW9zGAyoAO8IqCck098hkfq12OnjZj3dsszhnYUELFPMS8gHFz3OE0T_cittqD8JU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftTZpnP8Xi-nWrwIHvdgY7F5v5bYCA_7-dVXRCXhAL8hA&oe=69A2F7A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sJQgDGwPBoQ7kNvwFpVpxb&_nc_oc=Adn3O2owZZoivd6qyd3Z6jse1qqbYpetw0wvlxwd4PAaqP4GYbALU2QJSj4pMt3OYPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpaOOjXkS60Eqf9PNlbw2D11CSA1xDDjz3QHlB69vSdA&oe=69A2F933"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
3896124280411693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-uGvfa7mAIQ7kNvwFBjtr6&_nc_oc=AdoLzogxU_dy1uT1FC4MFsOag34_bSTUeRkpszxIE68S9jB6BITjbnflApQS2jNiuzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr1VjOPuQQ4LVbhYtiqMbupAYgYM6FNX8w1-uXD8ihFw&oe=6AE499D3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Qq-V9DjgMQ7kNvwEkOoaw&_nc_oc=AdouiITGc0BhCnCAyEADqlvBrBIGYrGmjcVPnqmqT5aFXx27ta4UalXosfPWrOEDuc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_bTMMFojI7c2I0l3FR4iYqMNLji5diE-vrRD3zsgBHg&oe=6AE4A5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPuCi5jKrPQQ7kNvwFyz6__&_nc_oc=AdphLu4EOz6zMqktjbbhHFMPw6ap9bskZSWRNAZ692TTfAyE6KyNHaqr_RmTToH5tYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLCZWbR6K1I46UtwZtDZcI9jL2QryQnz7KI9g0iXNtEA&oe=6AE4A733"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
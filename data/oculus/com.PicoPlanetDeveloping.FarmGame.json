3896124280411693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8LRp8Ms0wMQ7kNvwGH1vRX&_nc_oc=AdopKAkxDB5WQhaUz2b1oHWjnkWVgChCftoXs9RtaD1jD176vv1qcUPPsv7w0WtgoTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B53EsCPBymAoIXuvUEiEv7CFW0PkLmmNJo5NtPDZYVg&oe=6A411FD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlogogRrZs4Q7kNvwHkMIvd&_nc_oc=AdrP4EalhlCWnHHPeO47PKI77fcr0bDf2PgqhiWETwLENgnkkhzaLGbeHLGgUuSqJwU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GmyF4X15_JTDFvcg4_y9OZDli8FYBgpfmACnXcUh7yA&oe=6A412BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhcHj4TL6HsQ7kNvwH0CFl_&_nc_oc=AdrlZ1FAqBf7APKD8XrEhfB2KzPjRTxDVixABWUy8lS8Y8F0QCMcqjqQBnBYClOlddQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89j5KG95IqTvKjAF7ctD9FL9RETi8yGFPhjSQNXDDujg&oe=6A412D33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
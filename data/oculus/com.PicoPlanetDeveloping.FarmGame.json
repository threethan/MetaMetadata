3896124280411693", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRZ_Un3uBJ4Q7kNvwH-Fag6&_nc_oc=AdpUB4PMQ7vIT_AjEOP7CE54Gr8YQa9YLAz__uHPQ6Hc3dygalxdarYe-MDG7J3GlhE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDBZXJQOvKdYe8f-2kCr6aSUuEEtAjUluxyIVFuR9Z0Q&oe=6AD0D353"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HOjxYykYMMQ7kNvwErOaT3&_nc_oc=AdoRFDGuCZuP7KPDayA8nZc4XndO0CZ0ht55v4UO6ADgxoZZCpnHlWeD7IaJSgPFjG0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLZ0lFk4O92CbuKMslBej9jSXJhdzcYLljayNB3df22g&oe=6AD0DF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK3wKEwhYfMQ7kNvwH9Ci_2&_nc_oc=Adoiy6xEe4BQIe3dFU4TTv1QPxFWW0npAc755gTby1163Op3wUXOa59S0DjAhmiJOZM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmWtg_dZjKG9dnuI1ZTdoeAG2FIV6GFcEaePvI4iYJkw&oe=6AD0E0B3"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
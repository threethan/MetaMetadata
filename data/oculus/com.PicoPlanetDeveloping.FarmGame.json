dn.com&oh=00_AfsmCaLIC_6n6V5slLKizi8UTlG3m0MaSgpXuzgCPcY6Sw&oe=69985FD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLuN_UkM17cQ7kNvwE4_mnp&_nc_oc=AdmMZ_ujidykaGk0hb-J496ptBfNSNB77O6LJpdDVeJmfOY4TWCj66E9uQJ_cxWE2Ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuBf9PF2OPR06UjZU2-fMIqSUccr_zQO0ZORyZvXqeW3Q&oe=69986BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCbiWNbAJDQQ7kNvwEv6sZ5&_nc_oc=AdmYOx-hY2YzXyONhX6g5D9pHko-_aUtRq00Tgyi3jmd7XCnMnPsa-kGbhhdXU0RexI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvhbDdocW-bUr35AR22L97pN2aj8xn_3LuIO41aeAwHlw&oe=69986D33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_description": "Crop Craze is the first fully immersive Virtual Reality farming simulator. Plant crops, feed animals, complete upgrades, and more in this brand-new game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://picoplanetdev.tk/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PicoPlanet Developing", "sup
3896124280411693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_3896124283745026_3558838336997043691_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRAfFmeB6icQ7kNvwFEFL7E&_nc_oc=AdrulRrCVFzYWRdf9RE6AhimQdcZkY_rTFCl8uxNtgxGIW7EcUf-kRG-emqamsh5ZEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI08IrrsHCwLsl2NyaJfMpF5GViZ3G4v0pUhtVTGQxyIg&oe=6ABD0CD3"}, {"file_name": "Pond.png", "id": "193987019092818", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974750_193987022426151_7281453274839913205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TovUP_fiNUwQ7kNvwGv6DQt&_nc_oc=Adr7obb_SQbY84pEkM059599ZjRNzp7pYbZ1ie9Fccw32I0BfdHpr6OZwS1Bt3ltA7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhhVBVS0mNPhrBIgYKE98cZ01AYQjWzBhvpf_GGdFthQ&oe=6ABD18A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "321548425962373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_321548429295706_5617240590477412159_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkU57dpDvCYQ7kNvwEdeCcR&_nc_oc=AdpCeJMDjTIYuPhj-dwi697ysQkouEVOA1TUSiJE-Il51R56De5FYwTCkZ7c2yUyfog&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSSF49cVRZzJgrh0d6pqq_BFC7QNxtygR-ueFu5C5ERQ&oe=6ABD1A33"}, "display_name": "Crop Craze: Farming Simulator", "keywords": [], "long_description": "In Crop Craze, PicoPlanetDev's new VR farming simulator, you can buy seeds, grow crops, and sell them. Experience a serene view of the countryside and take a break from farming to roast marshmallows by the fire pit. Upgrade your farm to boost profit, buy animals for a bonus, and add a greenhouse. Purchase more land and expand your farm, while managing your money and having fun!\n\nAvailable now on Oculus Quest. Get Crop Craze and enjoy the excitement today!\n\nCrop Craze is developed and supported by PicoPlanet Developing, an indie game developer.", "short_descrip
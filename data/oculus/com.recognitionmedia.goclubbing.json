3uUgkg&oe=6AB541CF"}, {"file_name": "38982497_3847798535298384_4559142637877279468_n.png", "id": "1403010671091804", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031626_1403010674425137_5147234237095436509_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57CybTcIV4oQ7kNvwEbh7Lt&_nc_oc=Adoike2h9WSqOf8FmNLTbJwoAcFNRIlthTnBA3i53VI9yXxx6T_RQnTrM7419glPYrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuWzNR1ATq2SEhbWXhnygilBfv0xicbO5_LM-L7H_Nag&oe=6AB52F4B"}, {"file_name": "GoClubbing_Pool2_2560x1440U.png", "id": "290684437443646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982550_290684440776979_7447466224003630796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV7wrdMc-9EQ7kNvwHTTa4K&_nc_oc=AdoUpZ5pzS3Br40sj8oyTjAyQsLKkP4gSmOUlws5HCEajQialy0ik0iC4jwkPgV1p-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITq-wqJiqtNYOgtp50VHXWWNJMo5Wxmc6zNqzIiDNbVQ&oe=6AB53A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GoClubbing_Underground2_2560x1440U.png", "id": "1549897762254075", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395600_1549897765587408_5289793892733910403_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hly-HDE6XSgQ7kNvwGLRXER&_nc_oc=AdofptW0gzLxnErt937KnQKj07s3IqHC-ji3vQSqMBIDIIzHcP1K3NHqXNjkR9nKgBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjGMHecu_8vJi9HpVzuMaCJelXjZkd7XkqnV6tVx04zQ&oe=6AB52232"}, "display_name": "Welcome to GO CLUBBING", "keywords": ["livedjs", "vrclubbing", "virtualconcert", "dance"], "long_description": " GO CLUBBING VR\n\nExperience the future of live music and nightlife on Meta Quest.\n\nGO CLUBBING VR is an immersive social music platform where you can dance with friends, discover DJs, attend live events and explore unique virtual venues from anywhere in the world.\n\nPowered by ClubMixed Live, DJs and performers can stream directly into GO CLUBBING VR, bringing live performances into immersive virtual environments.\n\nExplore exciting venues including:\n\n\u2022 The Underground \u2013 live DJ streams, dual video screens, reactive lighting, lasers, smoke effects and avatar crowds.\n\n\u2022 Mars Party Dome \u2013 a futuristic venue being upgraded with reactive visuals and immersive music experiences.\n\n\u2022 Moon Party \u2013 dance inside an industrial moon base surrounded by stunning space views.\n\n\u2022 Infinite Stage \u2013 a spectacular 360-degree venue designed for concerts, festivals and visual shows.\n\n\u2022 Pool Party \u2013 socialise, dance and enjoy music in a vibrant poolside environment.\n\n\u2022 Sunset Bar \u2013 relax with friends, discover music and visit our AI Bartender.\n\n\u2022 Time Machine \u2013 themed environments inspired by legendary moments in dance music history.\n\nFeatures include:\n\n\u2022 Live DJ performances\n\n\u2022 Social VR experiences\n\n\u2022 Multiplayer avatars\n\n\u2022 Music discovery\n\n\u2022 Twin Venue technology\n\n\u2022 Community events\n\n\u2022 ClubMixed Live integration\n\n\u2022 Future ticketed experiences\n\nNew venues, events and features are added regularly.\n\nDownload GO CLUBBING VR today and join the next generation of live music, social entertainment and immersive virtual venues.\n", "short_description": "A Future of Live Music, Social Entertainment and Virtual Venues\n\nGO CLUBBING VR is an immersive XR entertainment platform that brings together music lovers, DJs, artists, venues and events inside virtual reality.\n\nStep beyond traditional social VR and enter a world of live music, interactive experiences and immersive venue environments built specifically for Meta Quest.\n\nDance with friends, discover new artists, attend live events and experience the next generation of club culture from anywhere "}, {"images": {"nodes": [{"file_name": "ChatGPT Image Jul 29, 2025, 05_12_43 PM.png", "id": "4019540754954542", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.
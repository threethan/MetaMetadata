5/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH0-W9dqmQEQ7kNvwHRDTDD&_nc_oc=Ado108d9_VmI6AV-Ou9J3WKv8RKEQnO15o8By5S41PCRxxNVYIqalTd5F54dO4v__gk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGd1HU32drFqzSZW6De_fDnmY22gjQuMdbwHWsoZ81cQ&oe=6B099B59"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (9).png", "id": "1311282677849393", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618442_1311282681182726_1110469159317116403_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZruoWjiuWkQ7kNvwHEQF02&_nc_oc=AdrKH81_Nf3HiwX1TgykgesoBaF3v95H6TgtFr2AqAJZvBL3-yMbCMNkRt0fzjwU59w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVGwWoJ92AATohPbWyMPO2JkqjS57ssOlMscKgaXREZw&oe=6B09B123"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (10).png", "id": "1716847996411728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499626172_1716847999745061_578053030789274776_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-84DSZx9-jEQ7kNvwF1kJ6V&_nc_oc=Adrn1Ytm30VKk3eCR-fFeR25C7ouMUThl6WRpOwaXGvqWoJl4LzFHxv9_JU2OUyefsU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5CbJyfn5SVLmxLwjFSWd_sIvoBWO1FNYOTEYRWKSxdw&oe=6B09A2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "2188384618598603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618938_2188384621931936_2227680298010489705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnAxOkkjF1MQ7kNvwFuAgWr&_nc_oc=Adq2LiUOJnHfz6NTwDtrHZXssCDsv5wRRoWg7-5cu1vjPAc359Pqq86rJPayHgsDuGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgzWiObAEHL4MyYRyrCZRx8KBjVxm_yPC5z3DofFUu7Q&oe=6B09C6C9"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great. \n\n# \ud83d\udd25Key Features:\n* **\ud83e\udd4a Timed Boxing Rounds** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding. \n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning, and feeling like a pro.\n\n**Ready to get started? Lace up your gloves and join the fun today! \ud83c\udfc6**", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
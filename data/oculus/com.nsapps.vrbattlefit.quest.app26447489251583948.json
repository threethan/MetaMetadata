dEOzoQf6UfG0oqsw&oe=6AF0B353"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyeljtzIDRkQ7kNvwHXKA8i&_nc_oc=AdpqxxLJgKANfcJgNbTXc8EgWRn5tECdMkKBHuZ1x7OcC_8TRjhh7-xJMYEA3bpUGA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJIdlTaDz3671KNkJHxMRmLjU10Bqvf0iJKb-sPZq_ZA&oe=6AF08ED9"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZXByCSN0hUQ7kNvwHhbW-8&_nc_oc=AdqNajxLdo0USXahi7A52MH8lJv27zUrO6uwknQZ9jZhyUZPLlvl7jK2HS_hnJmd21Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo1hJ2o5tJLyls5OvTxQS-7cwP6S3tkv8b89a-IgGYzQ&oe=6AF08850"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8rTUbM-8EkQ7kNvwHxity-&_nc_oc=Adp3n39r3-gVh5Ft93cTZ06P0zF9SBqmQo-Sy1J1boDshxA-V_uC3HvzrxnTHTzYAv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSETA207tsaXL8MI7e4Os5juO8_ZqmldrbXSX6eusuECA&oe=6AF0ABEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "2579541512555196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623551_2579541515888529_4533666767519437535_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TVSJU5DZV4Q7kNvwErMKfB&_nc_oc=AdpCc971aZn1myYDK1g5AooAUTH9gCBAnMwd1lyk9BrWGkJJRBvNHQIdnzpm_PWTj80&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8BkRmVvPdWqDT58d14rrNDBZBY1Hp-RoRjlpu8jQ8jQ&oe=6AF08411"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\u3000\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.  \n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
hv&_nc_oc=AdpiD-hui_XhPTuvMFqadxtPjaHbQ_qjNO1rTMoeBzeY42y8i8chif5tE1LPyr0_m7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7S7yCCl5s10Q1kVKVxYi_69FBwx2COy3HAaWwXo-U2g&oe=6A64C950"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyREjdkogKsQ7kNvwG9bwFY&_nc_oc=Adpk3bQmjUIqLpvkbqzOyGWZdv4xAwpO1rjdLHA9Q7jFQJkizdcteUCSr_LjcrLV_8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV2iPWzC1duq_T-Aqx0jkxpNbOh0qhHalSRiQ71RWTHA&oe=6A64B4AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png", "id": "2424356471402155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623882_2424356474735488_1823877963648694554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBfGGyFV7tEQ7kNvwG0qNVf&_nc_oc=AdpOrvxJxaMoLTpoBNPyxyzfrEqO6yyBOP-Fou4qe0_cjJolzYQk9ix2rXN8kbObNWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuTD3OgCUyxs-s-QNfPwJwalG76r8C1ec0m7lwpTMP7A&oe=6A64B03B"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.\n\u3000\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27652975671035294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1
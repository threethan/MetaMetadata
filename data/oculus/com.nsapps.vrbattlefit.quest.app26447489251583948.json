gXD&_nc_oc=AdrYyUQGXZQvonYmC8Hm9-gEPfqlJfW6VwbLA5LRs5BekuUgAnTSLnTnIacsDsaf_Vs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_6HD6gzD2epJHG9h2fHCtXOM1UlBYFUHlF_RPY2m76w&oe=6B086078"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuM8IcfCJs8Q7kNvwHxnWSI&_nc_oc=AdojLG1wG5MqLhDJ5MUaHna2cZvQU3n3uXATSRKLSeUDJjK7aJm5Lw3QZMEP_YWHXds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT730WP7JXm13e6pVKdz4u9Z81XtYhb99Dxv0yXVk6a2Q&oe=6B0846DB"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn0Vw3o5u14Q7kNvwEhH5sN&_nc_oc=AdqQmeMmqhTlFdvWt1H3y5KNIYPI_vlCr92SMlYQvL2ahYhfU7xjG4Gx-C2h6efZPI8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2UOe7BfUP-4h99FqcjE_oQgDaDi8m2kIxbB9y9EYeNg&oe=6B085A3D"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Jqbsd3720Q7kNvwGLPS41&_nc_oc=AdpFfhiyfY2HghOJEqQk6ec_ZjHiI8rLzYV2Pj-GCCkyGwaRfVRh4u0Fhp6n0OE_FIQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEGhOkR_eeiP_7J5o8ASQnSu7kKqrwGWvsT297kW5q5g&oe=6B084D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V27.png", "id": "1165138732737026", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623534_1165138736070359_2316957186516106961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TewTR_B3HcIQ7kNvwEMXri_&_nc_oc=AdpeR2USNFxKnEMZq319z6tWUkzStkQ8kzou40KAmAptioq6YTV7UwWq4VigVYnxgZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFLyyj29eetytkaFM0HaCB9_nNA-Hi6aXngrBPYW1TsQ&oe=6B0846B4"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
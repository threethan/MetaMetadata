_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7scA0Juyc7UQ7kNvwE137-U&_nc_oc=Adp5_ZY6vIu-L6IY94R50cJuCS3UeQhOCo0COddXFI_comeKqmWlEImgfI3T8baTrTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYm8JXHQfCFTLxtgBywht5fsgwMf1dHqJ42f3cyIIOng&oe=6A92BC19"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggBdZ3PtO2IQ7kNvwG4gW-Q&_nc_oc=AdqJPKm7bCcMUxPn377x7DoQC8ulopU74_sfqzq5VCwJYYQO5a3O1feMaatr3SVXGa0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5-N2NrvYVPRoSLNpPOjjm1TahQV8JINgq_JBA78w1Qg&oe=6A92B590"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caUfyqnBJ4sQ7kNvwH_-fr-&_nc_oc=Adrcc4bMi79YCmu9cFCe_h9yzSsL20rJWelutKbjeCzYaJ7cUplh_c0C5dDl1V-t-Y0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6vJcpmlDgnvaq459jSv3JnkTe4WxZ3dor1QH-QKtoAg&oe=6A92D92C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png", "id": "2424356471402155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623882_2424356474735488_1823877963648694554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhecKPOwzYYQ7kNvwHq6Dk0&_nc_oc=Adpr1BUS0Eb8YCKyRs0ETwjzIxHjEGv9qJHExdskvXIMXmnOVjBxvC0qYvalB_hKrBg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESOlxH83QFEpY2pfuBmQlyy0cYjMx2OKUSCzCqyc754g&oe=6A92D4BB"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\u3000\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.\n\u3000\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "ge
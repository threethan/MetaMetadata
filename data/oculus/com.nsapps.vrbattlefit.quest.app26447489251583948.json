/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pVahcxnFboQ7kNvwHFRd1m&_nc_oc=Adp3MqcoceBf5Oe96wWKDc7JYuHGUjPW5tnroN-2WW2avzwRvL-f16tupDC46eiS_DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWLfk-dXuvK0WVRDr90-pOE4hmlkoksqiNUIZNG3ur0g&oe=6B01EA99"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (9).png", "id": "1311282677849393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1311282681182726_1110469159317116403_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saN_qW4ku20Q7kNvwGh4rBU&_nc_oc=AdrqwOfvY-e09aQSeOujQ8lv4_j94erVVGuZ0uf9kQaNyPPmUP0BtoCeLeeA7vF72vg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2LJa1labeQut552Uaxz6PKCxhqWNi37calbesd0ZQQg&oe=6B01C823"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (10).png", "id": "1716847996411728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626172_1716847999745061_578053030789274776_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE-2Tdm3RyYQ7kNvwG6qA1W&_nc_oc=AdqhJ7zlm8fBtNWbYWIvNufCS8a9o5hVcwKWbO58Q4oPH2MyASB4jqicb1p5SAg9jQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyDRFhfLlFDrjQdTz6928HKStV8eklT7kuYNFJstJ9DA&oe=6B01B9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "2188384618598603", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618938_2188384621931936_2227680298010489705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKKPkJdcrXsQ7kNvwGSctvh&_nc_oc=Adpx5iQ8cIF2-H6nHQ6VZcHsTKft9q42vOFNjmKK36HQHf3bv1vCAT8RsUDkaWOAvMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTOxHWLnb4J1OgzDdbw-IX54UdVO_nts5JfoPhXkDLxg&oe=6B01DDC9"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great. \n\n# \ud83d\udd25Key Features:\n* **\ud83e\udd4a Timed Boxing Rounds** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding. \n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning, and feeling like a pro.\n\n**Ready to get started? Lace up your gloves and join the fun today! \ud83c\udfc6**", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
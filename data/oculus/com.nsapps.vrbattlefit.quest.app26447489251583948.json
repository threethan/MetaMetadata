2314655672400_6032789160806688828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoLItRCxhjwQ7kNvwFGEtcH&_nc_oc=AdqE1On-sPXgrSo7-t2Cy1eJvK2e-OA0IdyDgFuh6onEScCH_ywxH_wmSG3xQIwWkU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmVTI4RjmGlt0rQMr-fpZXsarTwG1AASr-quuUHZOp2A&oe=6A636A93"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZFzCHevwOEQ7kNvwFLZDQn&_nc_oc=AdqacTWTyfTMY0y7yMTABBbfG9cQ5gbMwWhCcvRvE97JKBIA4gfomShLFXlVA0mH-eg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANe5IVmH95nQKIc4lsXZnIFGEKnjFEuqEkMtPIDdgJjg&oe=6A637E59"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (9).png", "id": "1311282677849393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_1311282681182726_1110469159317116403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-iwrj-1wsQ7kNvwFRMVWE&_nc_oc=AdqT4iJ1tPEK6uuJWnR39A_GyPbC4aW6CAbzFs2tUqbXsIBkN8I_2H1vnYTfq4qYnHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSXK8242oLTSdluCABj1rIUYLibgt9w9ZEIi0Bx2Vkyg&oe=6A635BE3"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (10).png", "id": "1716847996411728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626172_1716847999745061_578053030789274776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k7msAnkdZAQ7kNvwGw2bP0&_nc_oc=AdofMGdRjh6sfQkkWdb-MmhSnwPKyrr7Qo1xTaJL1qC58JILmK49vJ1njA4bEp-jUAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjNNPzV7JN3bjeDkX49ZpSThccMMZHsbCZJMTO508Vvg&oe=6A6385D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "2188384618598603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618938_2188384621931936_2227680298010489705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Og4M33tttSgQ7kNvwHoO0Dh&_nc_oc=Ado9sqk_4vmZmD02XHZ6kLFtqnm1tantWQzKSok9kLQ95aXGH1zyRVMuSbWkiynQc4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyw8-2WGGPzGa-SRN1qphRW9SG2ar5qXS3x4EFdcanmA&oe=6A637189"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great. \n\n# \ud83d\udd25Key Features:\n* **\ud83e\udd4a Timed Boxing Rounds** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding. \n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning, and feeling like a pro.\n\n**Ready to get started? Lace up your gloves and join the fun today! \ud83c\udfc6**", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_
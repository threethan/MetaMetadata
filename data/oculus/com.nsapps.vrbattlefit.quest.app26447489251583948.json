qGnSnpebtVaQ&oe=6AE74093"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi8_d7Og5w4Q7kNvwFHH91h&_nc_oc=AdohuZ60d3gglVG82UGJTFqFy2FH82ocyDtRrNKkIlHMAv9CK6aAwfBTiQ8quq_-OH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRfsJn6Coj2eq5oLKn_Pn7uCTOxI5nUII4T_zvdSQdnA&oe=6AE75459"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp-FpPGz5FkQ7kNvwHaeG9m&_nc_oc=AdpiFQq0Qc_T8vCQ29fEXlVjMm5nntqfb9c_6lUqfo-SUZoE-eGxVWbe5vFOr_2XIFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0zbnejnFvef0DIH6OOyUFcLf236Y7w38DInNWp4fLZQ&oe=6AE74DD0"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzMhiMvGawQ7kNvwFDm1tr&_nc_oc=AdqJY0rAN76EcAIpcQU872k3OPPXMvl-TtVnVcd4PKtJUPh2_dnxQfSBqt3eEizB3ig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSmirD3LNYSHoatpltgp4-yKipchOw6xJqWt8-zgiGLQ&oe=6AE7392C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "2579541512555196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623551_2579541515888529_4533666767519437535_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ1hjpasioAQ7kNvwGQyn1S&_nc_oc=AdoIqQZWrstFZTgAGHVJgxDOY19zO-ni4YtvXk-2RL2k8GSCsuA0YDWGk9SOIAtsYcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfQWheoOa2cwD5PEKXTPFrIUVISLm-TGxpuo7-PtEWKQ&oe=6AE74991"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.  \n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_cat
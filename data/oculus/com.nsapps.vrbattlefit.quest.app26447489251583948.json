xT&_nc_oc=AdovTextP6TFgLHvnBfwY_A09zENGfocQwnf-YJBYj-bmcYNLTd4VXREYGDVjJEmTTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8qmgLa-UBP7U2x2pHR2n7JjE_IUiI6ieFaxZYx8Gn6A&oe=6B007778"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh-BZB5bxzMQ7kNvwFaulqC&_nc_oc=Adrywlk_2UqX1c9MTFjWmAIc37SOzq5ZwF6KEFf8lshdNy7_nVtdvv_x6Gr5Fsf7ubQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkhd-odWUrmhyqE-dAeM0ges1ylsyJLA57VZ_Uu4ENXA&oe=6B005DDB"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZMLApS8s-EQ7kNvwFvAmBY&_nc_oc=AdrW4QGb7wV4c9tIXn1ND1j-lmTJtRACrbyn20UIIg96uRQaSnDxcDWBDDCC3PpNtOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEaO8uqwzkSL0fucqY9k5mAcQSBodXAmEsJ8Y78QNpTg&oe=6B00713D"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQPQtr0LcbAQ7kNvwGbfrA0&_nc_oc=Adpcbagvh8Pdm-MRgLjfpBrYFSMoNZSg_TYx7bv4OglZgaQQZT-Bz1KXlVqZTgPze3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH8wT97MS7_WueX2Iooro55rFNKFkJZzKBnZ64WOtdVw&oe=6B00645B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V25.png", "id": "2222807525248596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628893_2222807528581929_1609083659885532996_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN4ecFg9EVYQ7kNvwF6mjUL&_nc_oc=Adp_g4MO7ZMsAN5PaKjhrTR5jPyncIGu1U7I7HjF9F2zu9_uL9om0RMkptLg_AwH_iY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsfut-ouKVh4ikv3hoBQCplQaSmKp6KlxgLSZtRIREpA&oe=6B005ACC"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
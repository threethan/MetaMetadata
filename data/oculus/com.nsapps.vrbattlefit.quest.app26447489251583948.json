VmGTXWrbVUuQ&oe=6AD3B253"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a6BatQBH5YQ7kNvwGRblgM&_nc_oc=AdryVOEgyQrtc9d1yMx0g6m4SMeN1AynZMcJiA5ktEcbPcTop0Oz3VRKEk4zzpwcYqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7eCP8DkgcD-Ag0lt371CwITM8uAkIFS5aaYsqvVKxqQ&oe=6AD38DD9"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oK3utLjXzQQ7kNvwFNdYR1&_nc_oc=AdryFlpOW5YrpU8J1M6ybS6fFg7NnRt4i_-AKH6GPDaf42JufaYrIEZ0sUEMSMp0oqM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0sRi6xzxdazc_QF9jR5TMvEvcIw3bxqfJy-B5uK6MhQ&oe=6AD38750"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6941jDzLI0oQ7kNvwEJzRPW&_nc_oc=AdoKO7FB71cLR96aywNsXekJeQ1B2yA4P4J1MN45p_6F-qC5bk3vjINKQZ7mrqv-KsE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb-mSHBaT7ZXcfPhcPS8WMvVhGfwT-wkmS2b28T0grFA&oe=6AD3AAEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png", "id": "2424356471402155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623882_2424356474735488_1823877963648694554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNjagS0x7ncQ7kNvwH0D8I-&_nc_oc=Adrx_6elndnifLiBCFHcyrtGkzArIxwHtCs0G29OWlPA4pJvV8qcSRptGNc30a9xntc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyJWUk_FWCMxK9-JV59qXi5Xtb7NvXGfM7UkX9xR1WfA&oe=6AD3A67B"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.  \n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114428
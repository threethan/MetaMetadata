90_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2b2Drl9NBkQ7kNvwFr0rJf&_nc_oc=Adrm9HOlPOUP03NnbSc_zHiplM0ClUGuFrw1UE6hFz2RAwS0hhGUqZc1JBZk2bE0vQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUw4pRIjmKytLtiUi9Gz7AskaLRok8QNMBQK6FMlSmTNQ&oe=6B0EF7F8"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD9iMJ-K2ZAQ7kNvwHFl9kJ&_nc_oc=AdqujhFtkctRSmTXG0ZflhAmd31ktZNnIqpO12KtiSXdwXNkLptGdwLZ85IbrsrLtFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBWrNtr4_eAdKuwLI6GqXETjyy9E84D2oxKFJ5sh69dg&oe=6B0F169B"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmSCEivrXMgQ7kNvwFswvhS&_nc_oc=AdqYU0CNEeVhFKUNRCRmxCmIqtkUUcYxSu6haaSf52gmVAnTO-NqpiseEriD1lR_Sz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsIrugwjZzkUIpNJPrpFV1T0o74cyEKCVBzkyZ2TDPuw&oe=6B0EF1BD"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0i8uC1dIJsQ7kNvwEFQSf6&_nc_oc=AdoQwpQePdPq2Qw5DXeseKV6nBwMAI6Yn02NEW7hb2pNxVCHe_99AKbBKKqgghj_s8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJmBT5pVW6Pe5v3xeecZfl9-7VsL64IEV7N2sYesZWxQ&oe=6B0F1D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V27.png", "id": "1165138732737026", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623534_1165138736070359_2316957186516106961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-5Ba4lCn8QQ7kNvwG_LNom&_nc_oc=AdoAdID5-GGVNB9pyqgBgVYLpt1l1E-V4WfjuymzaMwVT8-7yL7e571wvynT4miJ5Ag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXoueCUMqPR-mAhQm1MT1ERAHoRqwenblgRKSjzADYvgw&oe=6B0F1674"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29262585716740940"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628067_1780369569739792_733449655514263621_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRekllcaTbsQ7kNvwEeJPPI&_nc_oc=AdpvoLnQsg64UPc9W6uciKUZg90nAib7KaiWwTsicovdNJmR17pbaWRSS3dkPTeatfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOzMsWxNok63XJbpzkdAq0PH8N0UlBcsGvU3r6onroKg&oe=6B0EFFC4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle Fit: VR Cardio Boxing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1777598400, "lastRevision": {"nodes": [{"id": "26447489414917265", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26447489251583948", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1547844837051093"}, "iarc_email": null, "msrp": null, "translations": {"nodes": 
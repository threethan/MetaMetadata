wS&_nc_oc=AdofZUHcXidC2Y6TEOsjeibBpE9MXrbPtZpF3eAijbNiDLDMcAB3GOX7PVCkjFEgS7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZr-6XgjUk630fVUT4XzqRsbZAf5LJkslGmChAiOJZ_A&oe=6B031A78"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh6qmLuenBEQ7kNvwFO134I&_nc_oc=AdoXQcPeA223k9NuCczgqYurzy3a44PTYuKHK1fwLiUQD0ZdkgysTv46wi_QTMF09ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXtz4Y1XkoqpIASP79r_hIzJpaIxFxNkxfp3YNzxxItg&oe=6B03391B"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2CP60GHBroQ7kNvwGqkkeV&_nc_oc=AdpIDSUHjNZYLVmxX8IxxntBbvepuSYqJAskNr4NikdpWUAF_X_aLIp532RUZ9OpgNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Qf1UWqUJQaGVI6ABGvXwxXAIUn0YptUmL7lSvusRwA&oe=6B03143D"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQPQtr0LcbAQ7kNvwHjGoaE&_nc_oc=AdoJjUoALe8cnjFb5Dqr005whrPalw7fF5o518GFz1Og-tSveNPEz3G6fqnOe9a8dW4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnVGHw1E3U8FMxs-iTYEifI7zKLwhLvUG3lYaqIlGBkw&oe=6B03075B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V25.png", "id": "2222807525248596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628893_2222807528581929_1609083659885532996_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8jh2p7K0McQ7kNvwHQiK15&_nc_oc=AdpBzknUV5OuxQvK9aMDoPI8EXvutaaPefMO9sI9vXH7URg5c8H93joJ99zjVv4vHrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHaa7zMSCWl2jcvttvi6RUk686k060Jd0ge2abC8MQ4Q&oe=6B03360C"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
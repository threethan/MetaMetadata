E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VMX_IgLNKWhhC7r2KlqufsHIz7WwvxlH6qLSPSG2POA&oe=6A3A84AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V4.png", "id": "1993001681584770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646413489_1993001684918103_3296821172074958377_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BopW4WjuHwQ7kNvwEu5hYn&_nc_oc=Ado7Qu38QYXrUnyUPx9HFwxUfIt1FKLdHqrbJmKvWUIW3S2M8GN8RYSlHuCXIy0aSH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zrz8dzSmCkJZDSzQfTrD6806z6-LDMiTvqcJuFcgBJw&oe=6A3ABB35"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.\n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27339821885684009"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593990472_1731366564562769_1231509692783469894_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip-DbwtCEpcQ7kNvwF-9HgB&_nc_oc=AdrM8uDFdLwpn3wY7BnnBzlQWpsX52a6ftGQIRGcFXBDNTNa5eZ2OMnzxMb8UvTqSNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S52DFMY0ZA3QOGo3nDKaMNtLfCP3GIOBl5j6OjNbJuw&oe=6A3AB47D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle Fit: VR Cardio Boxing", "platform": "ANDROID_6
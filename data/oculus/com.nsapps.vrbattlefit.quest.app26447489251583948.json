YZB&_nc_oc=AdrPwlqxTXSDaH0r2xzHl3X-GMTs6OxhgkJK2ianZBd_4bqgxNSl85n1bOV2BDoUg6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQza2g0Xq4lJfCp5kUrH0hfNVerGmSrVAZv-rqD5Mw-Ew&oe=6B0B3BB8"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha8hoEiwyfwQ7kNvwESokuz&_nc_oc=Adqiw6KbT95fod9y5EJk6124Kw9PXgmHa3idqaGFFeIx9zc-As4LDIElMGKp0fGvlKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSz0ot8Ts0sbsn0fRnNt0O5LelU-Fu25-IZLSes2Uh10g&oe=6B0B221B"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtJcHATXxSgQ7kNvwHD17jb&_nc_oc=AdqP6Erl4StRYBitUil93WNgsNKm7dzpjOAeAAqqcB5xzzPMkvLiC-p35MJNOZzlazI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZC_Z3-MoqxcEnXFRw3WCnqIQ9q4hnzCaUIfp0VSffjA&oe=6B0B357D"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Jqbsd3720Q7kNvwGtuUaA&_nc_oc=AdrbSEqKR8BvYmdHUhQsrBZChfZ102qKk_nFxJ73XCskeakV-Lswsi9RaAavPSFP4hg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJeVjOsCibsUpzgQfok3s-bISzSr3eMBeDCubCppZsUA&oe=6B0B289B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V27.png", "id": "1165138732737026", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623534_1165138736070359_2316957186516106961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_vt3JR5aZMQ7kNvwECSQ2k&_nc_oc=AdrpGcUk57C2ajaFmRR4iMiCWuiYVoJDxt8VeZcajEmNfu_uzSSTXq9AXnQM4MMI4cE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpT3IGLB0s93AEJrdG-Zjb4deKHIG-ieAA2GPiJ_368g&oe=6B0B21F4"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
IpT&_nc_oc=AdpdjwTk_DDqdZ3SAYMh3Spqx8U9MbzoYCTc7gIs1T9ntyY4LwOJLcrukbquCA1VTT4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR8SlnnnlOwuAHt9nV0WfBElarg-perDFfV6qZmBYwpQ&oe=6B09B1F8"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha8hoEiwyfwQ7kNvwHeucu2&_nc_oc=AdpFeD9bejcjcXzY5bhEX6qsE834qb-QPoSdleijSrc3aS-d2awvJh74rA68h85KroA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRViE5AUGoRvyICo44T9-kJMV4u7iRv3zEeXJvYJxtXmw&oe=6B09D09B"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn0Vw3o5u14Q7kNvwGoynBt&_nc_oc=Adq1Tp_VbRPzpBQ3NjHhuz9tgbkHdrHJhNt5luT0liSq6J_SE5QmNrlx34JKiwrjwKc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJB7Ffa-EBS1NEeSX_-hbJvO-CZZJi5vIzONBQ9KezBg&oe=6B09ABBD"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Jqbsd3720Q7kNvwEbj5F5&_nc_oc=AdqAyf7I3SHe4VNr7ZPdP1sK4JLM1hX6QhYnRA23Yn8MP86CCjujLkJVCKwu4z4CKjo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYmNEm1SeRBUVnf6pnhC2HdPCiKzuA8KZlzqpVSVfW8w&oe=6B099EDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V27.png", "id": "1165138732737026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623534_1165138736070359_2316957186516106961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_vt3JR5aZMQ7kNvwH3Ldkk&_nc_oc=AdqT1aRsYQinlJ3WM7XciIfX_Ffg8mSSb8YuUMtLet61M6DD-JaHlj830NFojKSd7jE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQcRTYgodKyxVG3hpJypTYeCHCh740ba5MzgA3C63dQQ&oe=6B09D074"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
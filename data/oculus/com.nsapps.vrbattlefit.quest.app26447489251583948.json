/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08cZuY4DFNgQ7kNvwEuXJo0&_nc_oc=AdolEhfx5Kw9GpNyUr-Q5C67e0pPlQLFApjjEfI3Ht2WmOG6F90pmAqfY0toPkAFNyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL8Vk4Utz7wnzw2wL7YWVeuBcHDG-5Cjjbpp5YC6LgNQ&oe=6B045559"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (9).png", "id": "1311282677849393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1311282681182726_1110469159317116403_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uaLZNjAs2EQ7kNvwGmhfam&_nc_oc=AdrG41ZSdEU3l3uJZBgbOQC2nh8x0ccVmJ_wQf_0k-w3ZWb8Taox5kGSBPdbkruzVwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKs0gNn-RDmoKtHkdUrPn1zL0VZA7AqftHAmeZEgtKIQ&oe=6B046B23"}, {"file_name": "Battle Fit\u30b5\u30e0\u30cd (10).png", "id": "1716847996411728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626172_1716847999745061_578053030789274776_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE-2Tdm3RyYQ7kNvwEWumhp&_nc_oc=Adp60w_lExfBGL73-XPm6tOVGOsXWO9y4hphZHNh2cOrqmyuFVLbnS13F2y5eDL-Am8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkl9UqsFszwi7SBYqcFEqLgSrX4S9ITtrBaoLA-kp-eg&oe=6B045CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "2188384618598603", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618938_2188384621931936_2227680298010489705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7pf2u-6Z14Q7kNvwGz8K9o&_nc_oc=Adr101jAzhz2Nxo0CkQglG003HQkN9av6yttNCYlH5vohMbfLcjVnshLgddWzQ8nt3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMUvsMZIupxJaejClaIOqcU1AxIit4dIvhF-BlK8PCbg&oe=6B0480C9"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great. \n\n# \ud83d\udd25Key Features:\n* **\ud83e\udd4a Timed Boxing Rounds** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding. \n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning, and feeling like a pro.\n\n**Ready to get started? Lace up your gloves and join the fun today! \ud83c\udfc6**", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
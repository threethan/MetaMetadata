zA&_nc_oc=Adoqi97r6irAn2fyVpQcFLxtzOzGOFKJdZRwYXgPfa3ljiQ3hJudgRA-lrolRGuFAyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_3puTUmqsjjBNVuospHcEN_QKjhomWot8JBOAzkIEnQ&oe=6B01C8F8"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh6qmLuenBEQ7kNvwG2s_1X&_nc_oc=AdogavV10IpS0eBPwR4vByu22TkZGUqf_j0eXgvt89O2EkQuBNtiigd2BuyPn85HLRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEEQvsvy_lg8kxmER2MPH0rSPcHWnzfa2nTX4yB_spSw&oe=6B01E79B"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZMLApS8s-EQ7kNvwG8spcp&_nc_oc=AdoLgOoXH-QVHzhrtACT6601T7j_WSEbgj2ZUYTyXxxS-m1Am0M_UmY8SLLyTqmAdwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoOM3D9sYtENTfO5UaFH7vNlFuyal1KTLMSjAvyv75Sg&oe=6B01C2BD"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQPQtr0LcbAQ7kNvwGregLc&_nc_oc=AdqtIZkEydrpHNaSog4umeyfWbv8EHXTxQbURRG4geBpe9xrMfnGkFzGA-knHMQX-lU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr1yc8NHCIse0-I2KKflSwuUg9mywTskbyBbrgy9DMDw&oe=6B01EE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V25.png", "id": "2222807525248596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628893_2222807528581929_1609083659885532996_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN4ecFg9EVYQ7kNvwH0ARGx&_nc_oc=AdqJx0eA7r_901n8uLA6QgN-MmTyYUnktwTxfWXv6YLMctGnEy8lVSuD0r4l1FRbA5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTggkxfq6dO5SC4yWXxGnp_hhsXExqjknBmgdn2cHeyQA&oe=6B01E48C"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
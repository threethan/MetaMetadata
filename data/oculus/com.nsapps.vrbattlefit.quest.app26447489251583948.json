fE4ytugtpFzA&oe=6ADE0613"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpcdl2KAChwQ7kNvwETkjni&_nc_oc=Adpm3T9uZgx3N1yQcjAGb6CPsVRL3BeSnutrNnHOrVzQTkagGualxFkjBwMyrRYnhDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuUt1l3nGjv98r_MLOGjMn2y1G5XnY_n1BnoLuBxtNIg&oe=6ADE19D9"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRm-GDQlMkAQ7kNvwHy65z_&_nc_oc=Adq9l_dcOOrRukmEX4T9AcW2Bqo5DZzw6n1HJweZEz7jO_bvj5XKsUOgw_GHi-87llI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIQ3-5hEYtjx0q52YYd5w4E27HHTUvLXD6pVV06U-AIA&oe=6ADE1350"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbTHKCUz6_0Q7kNvwHrHJfk&_nc_oc=AdqjH0Fi0t65jti1vzet-5gVtZIffY3KzyvbPR27IL3WaXK_kOuS0Qg4ASofraRlKPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY2ZxsPANbp5TKgRZ4CEn2nLo2OCC-njZBtfCfNpcgxw&oe=6ADDFEAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png", "id": "2424356471402155", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623882_2424356474735488_1823877963648694554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2cN48EkEWoQ7kNvwFtQcAH&_nc_oc=AdoNqk8lZqDSVU3OzJr7hKwP56ashvTadJja01Z3pCk8GqA0aFKmw8wvt1_ZF4w4yVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6MgxQGkaBpqI0KMMpiePR4iLBNjwYA98BeO-KIb5HaQ&oe=6ADDFA3B"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.  \n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114428
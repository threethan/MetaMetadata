4eK&_nc_oc=AdorL2HeqfvCQfbD7n4z6LVGP4pZtfH51AvfT-LfnILVyIVHzQy5lpQOd0WldkDBAoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGHaciGMprIdUpp6-kc9UWGrmGXc-28NawUuRjo2HWeA&oe=6B0DA678"}, {"file_name": "3.png", "id": "1607909381351398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624606_1607909384684731_6748165868174886047_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD9iMJ-K2ZAQ7kNvwHWRpSG&_nc_oc=AdqU_SQ7G1ZYsmvxDeGvTUQlAuxcHteeqoRZeCCMPMYNtBZfDiH2DWN8r7D1YkStRAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSLAf653qd9gQfe8D75OW2a5GnO2wNaQxCbun8ydbDqw&oe=6B0DC51B"}, {"file_name": "4.png", "id": "4597459643872366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593716858_4597459647205699_8087605880822819835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtJcHATXxSgQ7kNvwEh4lQe&_nc_oc=AdrdUbv8-Hm9bo8r3dT4GZcs74hmmRgC9vD8Hka2phje-KhCkX8j2b4QD5JEfWPT-Zo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsfSnpWFUbDRi4E1dWsoakMxZctHxDi-wOhH4gtgQiyg&oe=6B0DA03D"}, {"file_name": "5.png", "id": "1098908856474704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628108_1098908859808037_8744330236818973899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0i8uC1dIJsQ7kNvwHNdlt8&_nc_oc=AdrQbkRqOhYKflHJhqFfuXm0PQtidVB8QqP4xzQsvBNUVonu6gsYahptD4RFlyXtnzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRocDTth9Jam8bMdae1DVNbwxifj-Dk7cBQmytrWKCrCw&oe=6B0DCB9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V27.png", "id": "1165138732737026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623534_1165138736070359_2316957186516106961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-5Ba4lCn8QQ7kNvwEwQkTT&_nc_oc=AdrU5HfxV31T7WQS-L5NhNHM7j_k1Gz44Anj9nsV9uRFq1tfKhN9-BkPfYl7WQQRG4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-f2iiS1NxSgRRbUwkCQJvHnjrBMCpTpw2QcN2_wpDfg&oe=6B0DC4F4"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# \ud83e\udd4a Hands up. Time to hit back.\nSlip a punch, spot an opening, and fire back. Before you know it, you\u2019re drenched in sweat and thinking, \u201cOne more round.\u201d That\u2019s Battle Fit: VR Cardio Boxing.         \n{1146172117796556}\n\n# Who\u2019s up next?\nEvery rival fights a little differently. What worked in your last match might get you in trouble in the next. Watch how they move, then pick your moment to strike. Score a knockout in the arena and the spotlight is yours. Cue the confetti.\n{1853661862301084}\n\n# Got time for a quick round?\nPick a match length that fits your day. Throw punches, keep your guard up, and move your whole body to dodge incoming shots. After the fight, check your results to see how many calories you burned, based on an in-game estimate.\n{1132248732840254}\n\n# Your room. Your ring.\nSwitch on Mixed Reality and face your rival right where you are. With hand tracking, you can put the controllers down and use your own hands to punch and block.\n\n{1082645834769243}\n\nSee you in the ring. \ud83e\udd4a", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
UaJpBeoew6t0wfyg&oe=6AE89213"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_vdDe_TxZEQ7kNvwFWTFXA&_nc_oc=AdqZ7En6vEoscBoStsPyMsxHbn3CJvM2co-I_OaJWabP7n6WscpRebUZhXyAOnkLgYg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzZFUbe4S1rk4DRDNB0hxYgmQ6V-w0McGDtHHIHGjR0g&oe=6AE8A5D9"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKAKmb7vZd8Q7kNvwEc5B_5&_nc_oc=AdqomlaeTV5PFdFKNeufAs9REwNIndi86oCIAL5MrlNeloNhiUdgwq6JEez3avJa114&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu6sDN7uTGqOCz-D9WVLS6H_OadU1y1JAxKUpNvGxRYQ&oe=6AE89F50"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzMhiMvGawQ7kNvwF0FyoE&_nc_oc=Ador9FSTZrGH770G0cngimtRyRfKNa2X08wWg8bTQFOi_Z1IBtvrWdg2ELp8mMv2LPM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1t-oPp92aMecggvLowQgmRQK_G4Q9r_II5C5sYS0t2A&oe=6AE8C2EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "2579541512555196", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623551_2579541515888529_4533666767519437535_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ1hjpasioAQ7kNvwFccEGT&_nc_oc=AdqSfKrhIM_NeljXuQHi65tvxqNMP9TZeeDGgGRVOf5wo-tYwod9bP1UEyolym0TYhc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCs_tBPuIK8QMSvrG8Hu9o7A8nvdRbjnF9f5bDB2hnsw&oe=6AE89B11"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.  \n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
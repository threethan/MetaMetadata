7fQ_kwJcDuMGZZrA&oe=6AEC8693"}, {"file_name": "3.png", "id": "998129892680591", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827033_998129896013924_7181366647587401992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23VfYdGcryoQ7kNvwEqOj1c&_nc_oc=Adrku93yKqLPOCd7s7yCp8E1MFBBfHbScCSE0OchyqW95W2xGF5XKMhfYTBKB3oKAZE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuD2Jwrx2U7T6oEn4BUsPqfQll21nNJfhffPEIst_Iyw&oe=6AEC9A59"}, {"file_name": "4.png", "id": "27015722708052134", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619518_27015722714718800_1983406739632374478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eGqGM_a-agQ7kNvwEZSRDD&_nc_oc=AdoHgVgIIGu50aN9T1gJ18RipE_m56Hok6M54bWnVltVSyoFKsTv-m1qkPJ07mkXq7U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDQYCvTPxfPUJ1NgWAdjVV5l9e-Y2qHX0ByoX2EBRIWw&oe=6AEC93D0"}, {"file_name": "5.png", "id": "1575524430214272", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617729_1575524433547605_1446060249126963679_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhDvrL9ic2wQ7kNvwHwzzTH&_nc_oc=AdpnSnff4EHjMSpnv1uLZB-JAVaMT0d-u8P2KYc_Pnfrho_QmKv3_kTwmPdriZrckaY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQnUOhuSb9GzzpoV6p9shTFmuyz8zw1CPqWDom_6sHzA&oe=6AECB76C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "2579541512555196", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623551_2579541515888529_4533666767519437535_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-Jmd70E_CUQ7kNvwHEybql&_nc_oc=AdrTk12eEP5H5vk5Htew6gkEaNrnGPivEUaQyEWsSbshzTdbvnou8KWG-r5ZrxTh6Fg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwWme3l94rYF57Z1XruR3Y2w22gqo7spbxRR5lTsSFLg&oe=6AEC8F91"}, "display_name": "Battle Fit: VR Cardio Boxing", "keywords": ["Boxing", "Cardio", "Fitness", "Workout", "Exercise"], "long_description": "# Turn Combat into Your Personal Workout Routine! \u26a1\n\u3000\nReady to turn your screen time into movement? **Battle Fit** is designed to make fitness fun and accessible. Step into the ring for a quick, high-energy session that leaves you feeling great.  \n\n### \ud83d\udd25 Key Features:\n\n* **\ud83e\udd4a Timed Boxing Rounds:** Flexible match lengths to fit your daily routine.\n* **\ud83e\udd16 Varied Opponent Roster:** Multiple CPU fighters with distinct challenges to keep training fresh.\n* **\ud83d\udcc8 Calorie-conscious:** Check your session summary after the fight to see how much energy you\u2019ve burned. Your progress is personal and rewarding.\n* **\ud83d\udca6 Full-Body Workout:** Designed to get you sweating, burning calories, and feeling like a pro.\n* **\ud83d\ude4c Controller-Free Combat:** Experience the freedom of Hand Tracking. Your hands are your weapons\u2014punch and block intuitively for a truly immersive boxing experience.\n* **\ud83c\udfe0 Your Room is the Arena (MR Mode):** With Mixed Reality, your rival steps directly into your living space! Your opponent and the match timer blend seamlessly into your real room. Go all out with your punches safely, without worrying about hitting the furniture.\n---\n\nReady to get started? Lace up your gloves and join the fun today! \ud83c\udfc6", "short_description": "Punch, sweat, and conquer! \ud83e\udd4a\n Battle Fit is your ultimate VR boxing arena where combat meets intense cardio. Face diverse CPU challengers with unique patterns that keep your workout fresh and exciting. Even when your health bar hits zero, the fight continues\u2014keep moving to reach your peak fitness! \ud83c\udfc6 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
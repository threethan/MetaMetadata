37595728069763_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWpLLBI1s0cQ7kNvwGH0U1s&_nc_oc=AdqCTX7ArUof2cMjgem4Z0S0YeZj4-7oWGqr30p-mjocFGnlaUDcls_N7fJp_cKLirA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2BrGokRk0eIHGqt0O_lnR3aUDi_NLRsHprc3gZDJNXvw&oe=69F2106A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "591932547092751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393887_591932550426084_2175011779045680710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ul85O2Pd6zsQ7kNvwE28g6f&_nc_oc=AdpUW0y0xsmr8U0RSYvMXUCxFZEXRbffFEdLawIC2ld1nt05b06xz2ZqlaxABE3k0XQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2gjYePe9Y5VoE7Crjn1c3ptjDu3scnsaYcY2riEwIkHA&oe=69F20C13"}, "display_name": "Deliver That Pizza - Puzzle Game", "keywords": ["Puzzle", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nFree demo available!\n", "short_description": "Deliver That Pizza is an escape room style puzzle game. Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
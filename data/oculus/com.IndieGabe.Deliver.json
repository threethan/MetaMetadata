398936766", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393887_9044739402270099_5876537595728069763_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGm-MO-bXhMQ7kNvwGzpBkr&_nc_oc=AdrWBGcVqa4pbNPuvGw-EcQG_ICOaj1oQAdU16YcLMAhQ_oIgc4nin69HIG0NfcKFIE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-QpSv1sHZLJgcxLekDKIfuSLV08XTmQh0CC7ET5gGqg&oe=6AA167EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "591932547092751", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393887_591932550426084_2175011779045680710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWJhKuXDE0kQ7kNvwHNpGDD&_nc_oc=Adq8g1GkM5Ri42OHXhuPPSmjtfNEvsEsGCRN_lxrtg9UA1HigeS0bVXBM92fZakNYjc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXU978hoyrSBXD7a29Eia5FPKpauaMVYpIJj0RYpQqEg&oe=6AA16393"}, "display_name": "Deliver That Pizza - Puzzle Game", "keywords": ["Puzzle", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nFree demo available!\n", "short_description": "Deliver That Pizza is an escape room style puzzle game. Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category":
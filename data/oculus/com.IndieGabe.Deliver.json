7&_nc_sid=6e7a0a&_nc_ohc=SSecxOuuHfIQ7kNvwHJtFsv&_nc_oc=AdnuyMcWt7B1854s_h8Ff455YiQyLhDe_DWkBymMruXMUapxZFECqatJkvTeakccsjw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfspQgGs7kebXnVm1a68ZjuQf-llEc3h-tZpuooZUyzp1w&oe=69A5996A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "591932547092751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393887_591932550426084_2175011779045680710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkONVnAiN2IQ7kNvwG51WZo&_nc_oc=Adkv2glxzMLytnf0H6mew33I21IAC-TrLXCFTtdH1YfIn1u7EPyEoDqIe4V6dU8Xroo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftz4pYfgqFUvdoBB4o4kRPfr8MQxISODOb6wvBfBswXTA&oe=69A59513"}, "display_name": "Deliver That Pizza - Puzzle Game", "keywords": ["Puzzle", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nFree demo available!\n", "short_description": "Deliver That Pizza is an escape room style puzzle game. Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
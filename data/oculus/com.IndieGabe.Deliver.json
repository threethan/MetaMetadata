&_nc_sid=6e7a0a&_nc_ohc=MM_IPXoLcjUQ7kNvwFCanAQ&_nc_oc=Adnb-_3Z2bnK_ex901JekCEGjjeKKH0sMzSKvnm1KSkOXx7S3XeK2BLAuWDRPW5vd9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2nF-Ffe5r2xv_f05963lPuWGejtcBj5AeaYPXkDDQeQ&oe=6999BBEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "591932547092751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_591932550426084_2175011779045680710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCbHf4ygTIAQ7kNvwEOLNRo&_nc_oc=AdkOl9XRi3hdKc73kHrxATvkK-GPPNqPcDQ7Fo30XoZrF7aV99URMuGqXVYC4DVdqcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftyDN4gppLNo480fVnYlgULU7WLqb9c_n-ZFcLUov6e-g&oe=6999B793"}, "display_name": "Deliver That Pizza - Puzzle Game", "keywords": ["Puzzle", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nFree demo available!\n", "short_description": "Deliver That Pizza is an escape room style puzzle game. Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
398936766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393887_9044739402270099_5876537595728069763_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKZiaeCJ59YQ7kNvwFECA0C&_nc_oc=Ado6Z8KICzIxYfP7RgsA8g7fiuuXRGVBzL3Y6ZrCC9YejhaJWk7hGc8lu6CLwBuHmVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg34Gmr0KBebjh0Rk1XQJgW56R6-uMwSdET7M2DTahMw&oe=6AD22F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "591932547092751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393887_591932550426084_2175011779045680710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKZmmwqezBwQ7kNvwHF11NF&_nc_oc=Adp8j2yj8iBONkGeA_d_Mh6UCUI07R-Ofx41tLomsdl8oLSJP3NcvEqLVPGQa5qR-OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6B7LtILb6Jq5VFIy3cjk6eMRkLorrPH7MYHnNNh45YQ&oe=6AD22B13"}, "display_name": "Deliver That Pizza - Puzzle Game", "keywords": ["Puzzle", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nFree demo available!\n", "short_description": "Deliver That Pizza is an escape room style puzzle game. Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category":
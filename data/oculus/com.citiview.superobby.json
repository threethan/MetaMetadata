dn.com/v/t64.5771-25/596168449_29175631315353623_7538738116944685487_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctikN_vyuX4Q7kNvwH5WG_6&_nc_oc=Adprs0ijzdqotatVs8FQBXTVidPrJ70QtLUJYkAOhLqCouJfs63B6Xq_2AFby9C2Aoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQWF5DCQTXUbvoZJzL3sw9Km0rYyAEofJq0PrJR5fYEw&oe=6AFC66DE"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1770483677485386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1770483680818719_1389445968580786359_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRkx3pBTdooQ7kNvwETFMxL&_nc_oc=Ado7lnrBIQd6ksFaE2D4zYqhU54YE7vZpcFNTymo7UF9ZbrZyRhw4A4HvG6VCqw8P34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCx8LweMjGtsbL6TiqDvw9Ssp5QEV1zm6xCvopXRhkFA&oe=6AFC94A3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1589198929565333", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1589198932898666_1984595539413991741_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOBsFl7-GPcQ7kNvwHSbK10&_nc_oc=AdoLWZ0Df9CfLxzfIBe9DK2REphMvghNhnotfLd4u7-183q-AoDNBe38FMHwPzw7WHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr2UM_Y46EuGAPVSFBEaOxyBxnT_bn7ZXxjEQQY8ruLA&oe=6AFC76D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28535792406032584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_28535792412699250_4642572641019449210_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFboSyFOQ04Q7kNvwHM5gEK&_nc_oc=AdpbpKTMcvQ_BziimWjwI1BS_1t4zB31opRC1iP02ox9uO3CVfyod6Lb4oezh47dO2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAij3Id493QOVuNJ8-JH8Wm23lgQA0bfYhB8maZBfEJw&oe=6AFC73A0"}, "display_name": "Super Obby", "keywords": ["platformer", "obby", "jumping", "parkour", "coins"], "long_description": "SUPER OBBY is a bright, bouncy first-person platformer built for VR.\n\nTWENTY LEVELS, TEN WORLDS. Green meadows, autumn, snow, desert, a city skyline far below your feet, candy, volcano over a sea of lava, ocean, sunrise and a rainbow finale with a crate castle. Every level opens with a card that names the world and the new thing to look for.\n\nMOVES THAT FEEL GOOD IN VR. Walk with the left stick, snap-turn with the right, and jump on A with one long, floaty arc tuned for comfort. Hold A for a higher jump. Punch a ? box to pop a coin, or head-bump it from below to shatter it with a thump in both controllers. Land on a walking bomb to squash it.\n\nNEW THINGS AS YOU GO. Forked paths with a high road and a low road that rejoin, bouncy mushrooms, crumbling crate bridges, elevators, launch pads that fling you across the gaps, warp pipes to bonus rooms in the sky, three-way forks, fast bombs, and a hidden star worth ten coins in every later level.\n\nNOTHING EVER KILLS YOU. Fall into a gap or touch the spikes and you hop straight back to the last checkpoint. Best coins and best times are saved for every level so there is always a reason to run it again.\n\nSingle player, standing or seated, no internet needed.", "short_description": "A bright, bouncy first-person VR platformer. Run and jump through 20 hand-built levels across 10 worlds: punch the ? boxes, stomp the bombs, ride moving platforms, elevators and launch pads, pick a road at the forks and find the hidden stars. A smooth, comfortable jump and no game over: a fall just hops you back to the last checkpoint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-superobby.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-superobby.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "con
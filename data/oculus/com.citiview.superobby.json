dn.com/v/t64.5771-25/596168449_29175631315353623_7538738116944685487_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKXV1Js4gJoQ7kNvwHg6diO&_nc_oc=AdpNOKi5dW5Ot3TWJ8-4wDXsRI45gjGGSH32Yp65-EeciZGNrRbTu_r_GuM0pAYPM60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdgAn76-9aLRJMs9OYF1TMVM7F-5oPdDjljHT3PXt8AA&oe=6B01E51E"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1770483677485386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_1770483680818719_1389445968580786359_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMZVvJPELdwQ7kNvwGdItsd&_nc_oc=Ado1enUA3W9jE-XftXuP9__xfY6D9kxo67-m4xSolVoRVe1Se7CM65BDhjR36iLufWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7tku_EYJm8IoIo-bjn1mcvI-yeQT_uR-zVIdxJCU59g&oe=6B01DAA3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1589198929565333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_1589198932898666_1984595539413991741_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utNkqEekFh8Q7kNvwES1OrV&_nc_oc=Adp-1UWEP1Xh7Xlq0NkXR4zrGC9TveJR7ggCghIAhQlKXjLIJpNNRQUsK_467ZWMT_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT4-cDtkSql7nOolGJxeZp8X9g_elLsQ7G0pIYwTDVrg&oe=6B01BCD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28535792406032584", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604360590_28535792412699250_4642572641019449210_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUBLWSHi27oQ7kNvwH3T9O8&_nc_oc=AdpnTKJ3MzVgVHCDRXFS3A3xEgcIITBdz0VQ0gh7FZLV8rrXjlBMGZZG8U3sGHPlu58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2L648u17KFaJEXuVwI57yqKsl4JY9A_i-0Z6FyIW7WQ&oe=6B01B9A0"}, "display_name": "Super Obby", "keywords": ["platformer", "obby", "jumping", "parkour", "coins"], "long_description": "SUPER OBBY is a bright, bouncy first-person platformer built for VR.\n\nTWENTY LEVELS, TEN WORLDS. Green meadows, autumn, snow, desert, a city skyline far below your feet, candy, volcano over a sea of lava, ocean, sunrise and a rainbow finale with a crate castle. Every level opens with a card that names the world and the new thing to look for.\n\nMOVES THAT FEEL GOOD IN VR. Walk with the left stick, snap-turn with the right, and jump on A with one long, floaty arc tuned for comfort. Hold A for a higher jump. Punch a ? box to pop a coin, or head-bump it from below to shatter it with a thump in both controllers. Land on a walking bomb to squash it.\n\nNEW THINGS AS YOU GO. Forked paths with a high road and a low road that rejoin, bouncy mushrooms, crumbling crate bridges, elevators, launch pads that fling you across the gaps, warp pipes to bonus rooms in the sky, three-way forks, fast bombs, and a hidden star worth ten coins in every later level.\n\nNOTHING EVER KILLS YOU. Fall into a gap or touch the spikes and you hop straight back to the last checkpoint. Best coins and best times are saved for every level so there is always a reason to run it again.\n\nSingle player, standing or seated, no internet needed.", "short_description": "A bright, bouncy first-person VR platformer. Run and jump through 20 hand-built levels across 10 worlds: punch the ? boxes, stomp the bombs, ride moving platforms, elevators and launch pads, pick a road at the forks and find the hidden stars. A smooth, comfortable jump and no game over: a fall just hops you back to the last checkpoint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-superobby.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-superobby.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "con
44685487_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0fy41od8woQ7kNvwHRXVlR&_nc_oc=AdrFPfrVH0HBWIRG7PtR14JXRjAAL3h5f682FSFN5scdSHt8oacY_S7vF6ocEwKEsuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJtuUW9GEBe8nyWZVgGX43365AbJNce7HdGg6S4FMYRw&oe=6AF5CF5E"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1770483677485386", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595129854_1770483680818719_1389445968580786359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h4ZNhE-EKcQ7kNvwFvAlNM&_nc_oc=AdoxZ78-_f3dnuBmFGeXYOyqp5RyMuy7FVbjjGy1-RdJDcFS4G0RgvylZsmmfQSw904&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7UW42oAZRETRNo_8zToJ__ngshiLTaHaWIsZhKnAd6Q&oe=6AF5C4E3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1589198929565333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_1589198932898666_1984595539413991741_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WpQE6V1Nx8Q7kNvwF1eBk4&_nc_oc=Adr1dxEZND2QsCKqFO0JV_NCegtryMEHEwYfBPADMGi1rXsAZFpXve3PVb0L7xXIhnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLijrI5LLWbp6uZViDAogcUArBi31-upx2kSRAaIMK5g&oe=6AF5DF55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28535792406032584", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_28535792412699250_4642572641019449210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8RgRIoOvy8Q7kNvwHqHKmu&_nc_oc=AdqRSLMv0uh7j_gLFojQK-rne9PFvkqpY9Kl8Wx0Bn8ILqrVZL07NgkzOWVCyx6trs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH6ZUXP-J7j8gFFaLT4b-i7HQTrpMywYX1iuZM2L-LfQ&oe=6AF5DC20"}, "display_name": "Super Obby", "keywords": ["platformer", "obby", "jumping", "parkour", "coins"], "long_description": "SUPER OBBY is a bright, bouncy first-person platformer built for VR.\n\nTWENTY LEVELS, TEN WORLDS. Green meadows, autumn, snow, desert, a city skyline far below your feet, candy, volcano over a sea of lava, ocean, sunrise and a rainbow finale with a crate castle. Every level opens with a card that names the world and the new thing to look for.\n\nMOVES THAT FEEL GOOD IN VR. Walk with the left stick, snap-turn with the right, and jump on A with one long, floaty arc tuned for comfort. Hold A for a higher jump. Punch a ? box to pop a coin, or head-bump it from below to shatter it with a thump in both controllers. Land on a walking bomb to squash it.\n\nNEW THINGS AS YOU GO. Forked paths with a high road and a low road that rejoin, bouncy mushrooms, crumbling crate bridges, elevators, launch pads that fling you across the gaps, warp pipes to bonus rooms in the sky, three-way forks, fast bombs, and a hidden star worth ten coins in every later level.\n\nNOTHING EVER KILLS YOU. Fall into a gap or touch the spikes and you hop straight back to the last checkpoint. Best coins and best times are saved for every level so there is always a reason to run it again.\n\nSingle player, standing or seated, no internet needed.", "short_description": "A bright, bouncy first-person VR platformer. Run and jump through 20 hand-built levels across 10 worlds: punch the ? boxes, stomp the bombs, ride moving platforms, elevators and launch pads, pick a road at the forks and find the hidden stars. A smooth, comfortable jump and no game over: a fall just hops you back to the last checkpoint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-superobby.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-superobby.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
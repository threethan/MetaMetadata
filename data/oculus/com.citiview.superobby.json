5771-25/604360590_28535792412699250_4642572641019449210_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUBLWSHi27oQ7kNvwH3T9O8&_nc_oc=AdpnTKJ3MzVgVHCDRXFS3A3xEgcIITBdz0VQ0gh7FZLV8rrXjlBMGZZG8U3sGHPlu58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2L648u17KFaJEXuVwI57yqKsl4JY9A_i-0Z6FyIW7WQ&oe=6B01B9A0"}, "display_name": "Super Obby", "keywords": ["platformer", "obby", "jumping", "parkour", "coins"], "long_description": "SUPER OBBY is a bright, bouncy first-person platformer built for VR.\n\nTWENTY LEVELS, TEN WORLDS. Green meadows, autumn, snow, desert, a city skyline far below your feet, candy, volcano over a sea of lava, ocean, sunrise and a rainbow finale with a crate castle. Every level opens with a card that names the world and the new thing to look for.\n\nMOVES THAT FEEL GOOD IN VR. Walk with the left stick, snap-turn with the right, and jump on A with one long, floaty arc tuned for comfort. Hold A for a higher jump. Punch a ? box to pop a coin, or head-bump it from below to shatter it with a thump in both controllers. Land on a walking bomb to squash it.\n\nNEW THINGS AS YOU GO. Forked paths with a high road and a low road that rejoin, bouncy mushrooms, crumbling crate bridges, elevators, launch pads that fling you across the gaps, warp pipes to bonus rooms in the sky, three-way forks, fast bombs, and a hidden star worth ten coins in every later level.\n\nNOTHING EVER KILLS YOU. Fall into a gap or touch the spikes and you hop straight back to the last checkpoint. Best coins and best times are saved for every level so there is always a reason to run it again.\n\nSingle player, standing or seated, no internet needed.", "short_description": "A bright, bouncy first-person VR platformer. Run and jump through 20 hand-built levels across 10 worlds: punch the ? boxes, stomp the bombs, ride moving platforms, elevators and launch pads, pick a road at the forks and find the hidden stars. A smooth, comfortable jump and no game over: a fall just hops you back to the last checkpoint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-superobby.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-superobby.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1240597015812938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/753032404_1654348723064580_6307735482715865980_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmmcF7ibL_IQ7kNvwGLaXFn&_nc_oc=Adr2sggijFYyaQI1kqrbSx1cvc2lkv1K2IJA15Thc9fhKwDqQqnrGxSskztF4vjwaVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLOwGpc_c3JKzWCcwJ-Uxx09SHGT5fNzpsR6mvNQG2WQ&oe=6B01CA6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Super Obby", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1789591080, "lastRevision": {"nodes": [{"id": "1240597022479604", "release_type": "SCHEDULED", "administration_status": "APPROVED
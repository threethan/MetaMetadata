_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ys0LJLsciUQ7kNvwFZgaUR&_nc_oc=AdqZB98ccDD07gkZC7-03fdRmzgqoZ6ZX5NevRwSqlbdfy_4kV4ZrY1C-Tf3Kl46thM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rxxy_-i9GQBYglTKB93Cb0MtseNJZCYkIwlTBSPooiA&oe=6A11AF7B"}, "display_name": "SIMVANA Anesthesia", "keywords": ["Anesthesia", "CRNA", "Healthcare", "Intubation", "Patient"], "long_description": "# The Future Of Anesthesia Education\n\nPerfect your skills and build the confidence required to be successful in a real operating room. SIMVANA's Simulations offer instant access to a variety of real-world situations.\n\nPractice basic intubations or handle rare complications, all in the comfort of your own home, at your own pace. Each simulation is randomized to provide a fresh challenge on every run through.\n\n{500322199006494}\n\n# Learn in your own virtual operating room\n\nSIMVANA's library of learning content puts learners on the fast track of anesthesia education. Our mix of multimedia content, contextual quizzes and interactive objectives maximize retention and engagement of learning material.\n\nMaster the fundamentals of the anesthesia machine, pharmacology, airway management and more with our growing library of learning content.\n\n{1117964722642601}\n\n# Explore in a safe virtual environment\n\nSIMVANA's open world design empowers the user with the freedom to make their own decisions. Explore and experiment in way that would be impossible in a real world environment. Our powerful physiology simulation engine running underneath it all ensures that the simulation will respond quickly and accurately.\n\n{1200863874425088}", "short_description": "The future of anesthesia education!"}]}, "developer_name": "SIMVANA, LLC", "developer_privacy_policy_url": "https://simvana.com/privacy", "developer_terms_of_service_url": "https://simvana.com/tc", "publisher_name": "SIMVANA, LLC", "support_website_url": "https://simvana.com/support", "website_url": "https://simvana.com/anesthesia", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26369914059359757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031348_1646954766090307_837711596190975534_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSPPhsATZTUQ7kNvwEbp9mt&_nc_oc=AdpJrYwZXl6ooIjRH3WHkU8VpY7Qc7kbG3tSG79M1YtZ5JguUKoYt3EAMAehlz--ldI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m7KqSmUohPjAiR_lP3KGnl9SsfW2lHxgCiL_pXZTSHg&oe=6A11D11A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SIMVANA Anesthesia", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1701722100, "lastRevision": {"nodes": [{"id": "6241063209338139", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6241063199338140", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7198113903541004"}, "ia
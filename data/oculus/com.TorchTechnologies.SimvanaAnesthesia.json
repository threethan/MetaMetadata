le_name": "Screenshot_5.png", "id": "1121547192292086", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1121547195625419_5960515379690531724_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhjM8ZqocNEQ7kNvwHDIp91&_nc_oc=AdrAJdP-m_X9hIQNs9VihsAyAsj7uoNDLwbcD6aBV7EIuqaaWItWA2XyMKsFwCX3ACI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0SujiE3YLM36y9PArkrqW5Kl9BSe2Zg__O-7Pvbk4_qQ&oe=69F214A0"}, {"file_name": "4.png", "id": "802227501588727", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86627655_802227504922060_8466065162829481049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHSgjkWby3IQ7kNvwErSg5n&_nc_oc=AdrxCqcHh-tD6bHXJfrouzC0FZ-5jNEuX7O3CnlwxiOBWplXjlsZaNGGWrhxHoMORMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dnFL81Lp5hYX1UXR5ap4aZkOjX2kGlgaoJbMrW2P0IA&oe=69F1F76C"}, {"file_name": "3.png", "id": "24137796642502996", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031574_24137796645836329_8617910779297621821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMlxBfDiJTUQ7kNvwEC4zst&_nc_oc=Adrn0Az1ZNJcbPxKgQ9txcP-dr1xMI94D2sOjwEBOzEuIMBYfdqKw5K1qA7f_WFL2vs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1ZRg3WKqsqflXodTrHKdpMiuwDoH6xd6xp_1oePQ4MXQ&oe=69F1F570"}, {"file_name": "2.png", "id": "1521154105363681", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75330714_1521154108697014_2843890797038691914_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdvNXZWKacQQ7kNvwHjUMfB&_nc_oc=AdqilXbgkPT609ObQxRkMy2XFIsiJgVMNU2TQ63_URkOVncM7GSmEp1XiDuds5Llx4M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1NDzyne1vDo4X0JGbrjzC2yCBhHHbt5jN-j4_PW5xchA&oe=69F1FEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "9808191959251577", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221317_9808191969251576_8282968296216516429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljCalu1KaZIQ7kNvwHTQu4U&_nc_oc=Adr-8B6NiukMQ8bv2csc8VuewKDudSK-aWMPVj1-TYNmEW8-EqWfelLe3C1LeEDC94w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1E-s6zzzvemTQlW1ppYiUK27eTJgBy4b8nWEv49_-nZA&oe=69F20B7B"}, "display_name": "SIMVANA Anesthesia", "keywords": ["Anesthesia", "CRNA", "Healthcare", "Intubation", "Patient"], "long_description": "# The Future Of Anesthesia Education\n\nPerfect your skills and build the confidence required to be successful in a real operating room. SIMVANA's Simulations offer instant access to a variety of real-world situations.\n\nPractice basic intubations or handle rare complications, all in the comfort of your own home, at your own pace. Each simulation is randomized to provide a fresh challenge on every run through.\n\n{500322199006494}\n\n# Learn in your own virtual operating room\n\nSIMVANA's library of learning content puts learners on the fast track of anesthesia education. Our mix of multimedia content, contextual quizzes and interactive objectives maximize retention and engagement of learning material.\n\nMaster the fundamentals of the anesthesia machine, pharmacology, airway management and more with our growing library of learning content.\n\n{1117964722642601}\n\n# Explore in a safe virtual environment\n\nSIMVANA's open world design empowers the user with the freedom to make their own decisions. Explore and experiment in way that would be impossible in a real world environment. Our powerful physiology simulation engine running underneath it all ensures that the simulation will respond quickly and accurately.\n\n{1200863874425088}", "short_description": "The future of anesthesia education!"}]}, "developer_name": "SIMVANA, LLC", "developer_privacy_policy_url": "https://simvana.com/privacy", "developer_terms_of_service_url": "https://simvana.com/tc", "publisher_name": "SIMVANA, LLC", "support_website_url": "https://simvana.com/support", "website_url": "https://simvana.com/anesthesia", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": 
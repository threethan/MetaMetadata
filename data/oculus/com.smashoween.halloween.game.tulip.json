0a&_nc_ohc=uXnBHXfL9YYQ7kNvwEGqBkF&_nc_oc=Adq9iuPcrT-aacCgm1tWlN_Z1s7QuZZ4MHHL_FfWoJV7tTN-XbFYW_gF5oYnrUPGADk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW9w-06LUAzDESSBH-Oo2hCdRgH96IgCZACHd60WnDog&oe=6B01C22E"}, {"file_name": "5.png", "id": "782313131373978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_782313134707311_5774409320645889586_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiiY1_scmtcQ7kNvwHQpsVD&_nc_oc=Adpasv8caJbZ9p99-ex99RmQU5cEi3Bjzg2dbXG8tdoXU56XReTsE5GoU54XBSpUfs4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf3r5hdopRpYCy7waSjHg_mFCAqPA4Oo2AgSV7wES0Rw&oe=6B01B7A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Smash-o-Ween VR - Halloween Game", "keywords": ["PartyGame", "FunGame", "HalloweenGame", "SmashGame", "ActionGame"], "long_description": "Step into the ultimate Halloween playground with Smash-o-Ween VR \u2013 Halloween Game! Armed with your favorite smashing tools, you\u2019ll unleash chaos across haunted worlds filled with pumpkins, ghosts, bats, and other spooky surprises. Every swing, hit, and smash brings you closer to becoming the ultimate Halloween smasher!\n\nWith fun physics-based gameplay, interactive Halloween environments, and immersive VR controls, Smash-o-Ween VR delivers a perfect mix of action, fun, and spooky vibes. From creepy graveyards to pumpkin-filled fields, every environment is packed with surprises waiting to be smashed.\n\nWhether you\u2019re in it for laughs, high scores, or Halloween spirit, Smash-o-Ween VR is your ticket to a frightfully fun virtual reality experience. Smash, swing, and celebrate the spooky season like never before!", "short_description": "Get ready to smash, bash, and laugh this Halloween in Smash-o-Ween VR! Break pumpkins, crush spooky creatures, and dive into a world full of Halloween fun and surprises all in immersive virtual reality!"}]}, "developer_name": "Abstron
-7&_nc_sid=6e7a0a&_nc_ohc=oUzmPeuxkNUQ7kNvwEn2Gj2&_nc_oc=Adr6RVrBv7x2SCzks2F5Gz3llGsqDNSxuvY6I5ssM0pQdtbdUTY9So8fd5ygjnszdjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEkS50-s5KqvS00aXJpkGJ1RdLHWj3THwaLPtHTPngUg&oe=6AA7F57B"}, {"file_name": "screen (5).png", "id": "1060800449926711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310720_1060800453260044_5880987406020177604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Uah1FhegUQ7kNvwHtrse2&_nc_oc=AdoJ39wW6GLkntkR58bXms4epG9TaMXTSfaLqrG5622MLGQbdOKHLpIUn2GeNzWJm-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoU3r4eZAEAyRvK94zssoeLx08D3yaJD21iU3w5h0axA&oe=6AA7FEA2"}, {"file_name": "screen (4).png", "id": "1433826548514287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596106838_1433826551847620_8947953290719489292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjG9_YgHausQ7kNvwHAzHMH&_nc_oc=AdpMF4bxjU9tcrbpeSK04u0V1d5vxVkfLc5t2KNd0xqSw--YFeZ68oMhoEaaV7y0zig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ25EtVxK92_d6xPhi_pSfwpcDKFeDEuykaJQcfcmOKTg&oe=6AA80EE0"}, {"file_name": "screen (7).png", "id": "1326932499652149", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1326932502985482_707641238438884191_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3-rTe5IJBAQ7kNvwGioLSX&_nc_oc=AdqNT-JPilkpVYrqY1oVpCz_jtDGR_Tm2wmIYk8nzPEb1Lm5qNn27kGtqNBl2j9hc2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7B15RacrTrA26igitDqPWX-QwalX3OnhyHDscEmZUDw&oe=6AA81103"}, {"file_name": "screen (8).png", "id": "905901231854366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_905901235187699_5748266271793251964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0VYMn4mvgAQ7kNvwHyK3iz&_nc_oc=AdqbklktAvB4rlzlyHM_5K6-j7HeQncegJmrw__2XfpDNonnV3Jd507XPoaRwlhkemo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD4nEESWZkZ89D_7GvtM80DPsqtXxsAWCNj7oKRqwS7A&oe=6AA7E9D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Between Floors - Find Anomaly", "keywords": ["anomaly", "exit8", "elevator", "floors", "wheelchair"], "long_description": "Between Floors \u2013 Find Anomaly is a psychological VR observation game where every elevator stop could be your last correct choice.\n\nYou are trapped in a wheelchair inside an elevator with only one task: make the right decision.\n\nEach time the elevator doors open, carefully inspect the corridor in front of you. If you notice an anomaly, go down. If everything looks normal, continue up. A single mistake resets your progress.\n\nAs you climb through the building, mysterious passengers begin entering the elevator. Study the information displayed on your monitor and compare it with the person standing before you. Are they human... or something pretending to be one?\n\nWith only your eyes, memory, and attention to detail, you'll need to detect subtle environmental changes, identify suspicious behavior, and trust your instincts.\n\nFeatures\n\ud83d\udc41\ufe0f Find hidden environmental anomalies.\n\ud83d\udc64 Identify human passengers and dangerous impostors.\n\ud83d\uded7 Unique elevator-based gameplay designed exclusively for VR.\n\u267f Experience the entire game from a fixed wheelchair perspective for maximum immersion and comfort.\n\ud83e\udde0 Increasing difficulty with dozens of carefully crafted anomalies.\n\ud83c\udfa7 Atmospheric psychological horror with no reliance on cheap jump scares.\n\ud83d\udd04 Highly replayable with randomized events and anomaly placement.\n\nCan you reach the top floor... or will the building keep pulling you back down?\n\nLook carefully. Remember everything. Trust nothing.", "short_description": "Inspect every floor, spot anomalies, identify impostors, and survive the endless elevator. One wrong decision sends you deeper into the unknown."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1027973496280733"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1410131461079628"}, {"status": "PUBLISHED", "id": "987038467727210"}]}, "baseline_offer": {"id": "987038467727210"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1410131461079628"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1057599736651442", "version": "1.0.8"}, "id": "918200571295649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1027973489614067", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1057599736651442"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "918200571295649"}]}, "change_log": null, "created_date": 1786904035, "id": "1057599736651442", "version": "1.0.8", "version_code": 8, "release_status": "
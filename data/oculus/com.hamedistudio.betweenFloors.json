nt-sjc3-1.oculuscdn.com/v/t64.5771-25/507843239_1045461297932016_8903495018754964058_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urJikCPCdOMQ7kNvwGeiLrt&_nc_oc=Adov97r5CXSgV--8TSrPxQLRyytcOOPk9fzYXCuOM9jw_EqG-OFMGQSjwSxyksgWdOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICtB9M5J1TR5wtAHGvqK5WHWzpf2jPokszCkYAMI8SDA&oe=6AB2817B"}, {"file_name": "screen (5).png", "id": "1060800449926711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310720_1060800453260044_5880987406020177604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Qa-joDdmoQ7kNvwGqYoxC&_nc_oc=AdoDlz-oXGVp9RIxIu12CrLKooTH0umyFL7H8xXSk2W4dCUCsDvHUoy3E2Yp8hI0Dyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZPK-xnFS7iR5_VrndJJGUpjYpjPhaTVbZHoFMkBfaxQ&oe=6AB28AA2"}, {"file_name": "screen (4).png", "id": "1433826548514287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596106838_1433826551847620_8947953290719489292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHVLAaxvTXUQ7kNvwF0YjY7&_nc_oc=AdrP8iKdWT7JYZO3B7krrR91NmmHQpQF55KRSuHNBJen0WhSx9Mv58DORAOs_qFZLN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItlUdaIIyvltoRNX2ud2JLhWoDPkND8KcA6j3AuhMY0w&oe=6AB29AE0"}, {"file_name": "screen (7).png", "id": "1326932499652149", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1326932502985482_707641238438884191_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3LbcL9wCH4Q7kNvwF4eQnt&_nc_oc=AdpbQHIus6JedvKVmo8ttI8UypeXb29z3un_gkUdrCQDCoaMXT0feqBVicQN_sWHQRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiAUZcTSagtmyoNPV-KBS5TEJ4gvKQHXT7lqZV53wAtg&oe=6AB29D03"}, {"file_name": "screen (8).png", "id": "905901231854366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_905901235187699_5748266271793251964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5nt4JqW12wQ7kNvwHnt-wT&_nc_oc=AdrCIguwCiSifNSmK8_dviPbn1V1NE4WiiqKHFPVTGtfBOSmph9mNqrcKXjfFrc2xB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHMVMDvgCB6uqUhOtW1U86fONeGZnTKMZ48NC8BgY_kw&oe=6AB275D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Between Floors - Find Anomaly", "keywords": ["anomaly", "exit8", "elevator", "floors", "wheelchair"], "long_description": "Between Floors \u2013 Find Anomaly is a psychological VR observation game where every elevator stop could be your last correct choice.\n\nYou are trapped in a wheelchair inside an elevator with only one task: make the right decision.\n\nEach time the elevator doors open, carefully inspect the corridor in front of you. If you notice an anomaly, go down. If everything looks normal, continue up. A single mistake resets your progress.\n\nAs you climb through the building, mysterious passengers begin entering the elevator. Study the information displayed on your monitor and compare it with the person standing before you. Are they human... or something pretending to be one?\n\nWith only your eyes, memory, and attention to detail, you'll need to detect subtle environmental changes, identify suspicious behavior, and trust your instincts.\n\nFeatures\n\ud83d\udc41\ufe0f Find hidden environmental anomalies.\n\ud83d\udc64 Identify human passengers and dangerous impostors.\n\ud83d\uded7 Unique elevator-based gameplay designed exclusively for VR.\n\u267f Experience the entire game from a fixed wheelchair perspective for maximum immersion and comfort.\n\ud83e\udde0 Increasing difficulty with dozens of carefully crafted anomalies.\n\ud83c\udfa7 Atmospheric psychological horror with no reliance on cheap jump scares.\n\ud83d\udd04 Highly replayable with randomized events and anomaly placement.\n\nCan you reach the top floor... or will the building keep pulling you back down?\n\nLook carefully. Remember everything. Trust nothing.", "short_description": "Inspect every floor, spot anomalies, identify impostors, and survive the endless elevator. One wrong decision sends you deeper into the unknown."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1027973496280733"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1148126640873786"}, {"status": "PUBLISHED", "id": "1410131461079628"}, {"status": "PUBLISHED", "id": "987038467727210"}]}, "baseline_offer": {"id": "1148126640873786"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789374420, "status": "PUBLISHED", "id": "1148126640873786"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1057599736651442", "version": "1.0.8"}, "id": "918200571295649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1027973489614067", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1057599736651442"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", 
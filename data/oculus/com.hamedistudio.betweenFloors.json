]}, "id": "834683416241985", "locale": "en_US", "screenshots": [{"file_name": "screen (6).png", "id": "1045461294598683", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/507843239_1045461297932016_8903495018754964058_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUzmPeuxkNUQ7kNvwGwhjK-&_nc_oc=Adp2Sf0uKpXCNBgOd1mxrKjvM3Yycfty4jpIJ_UKQArxv33wMM5G96RUUIG6QfnmwM8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_Iuczs1j-tDp_JcXwZOFqZhIhDUfN0Gi6K1Mif5Z4xQ&oe=6AA946FB"}, {"file_name": "screen (5).png", "id": "1060800449926711", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499310720_1060800453260044_5880987406020177604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Uah1FhegUQ7kNvwHSOzes&_nc_oc=AdrdZjiz2MKR0OCcdCXbF-BU_HtgUpjEkkWB_IPQaPaEz_Va_Jw8YiyQxUFuUnzr-aU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA0DKR_35CUUoOmlcKGWbI1h32RI5sJ2StKCC0dUQTcg&oe=6AA95022"}, {"file_name": "screen (4).png", "id": "1433826548514287", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/596106838_1433826551847620_8947953290719489292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJl8d90ebQMQ7kNvwExgt_-&_nc_oc=AdrTNNGgLHMLUxWHqKY96QmR76fOzFaGy18cFb1IfFo57Wi0jHwEslq_UcG7q0Tued8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBaZTyO1ipmIYERMmyoAUnTYKerL2XfNDxS1IzotSJaw&oe=6AA96060"}, {"file_name": "screen (7).png", "id": "1326932499652149", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499314657_1326932502985482_707641238438884191_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viuhhZGUpMYQ7kNvwEoz3pp&_nc_oc=AdrduNvSS4XywwQNDlq1zrPsDYlrrb-1Ssu5AcoGN3tpBwKUh56814popZXeWmUHUbg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6GreBO9I9TXGujBWFib5sZ9osistirrfxprW3bF85WA&oe=6AA96283"}, {"file_name": "screen (8).png", "id": "905901231854366", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312236_905901235187699_5748266271793251964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5IGMzwLZCEQ7kNvwGU7dhN&_nc_oc=AdpkcF_bPP_4Ia4DQKKcnSKyQnLddoPLXYQkYZQ57H1uQo9Izdwje8TkOdxerAyu7LE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZT2wz6TKmRKaXxnamoVM_9gkR0CVPN4kbA4ksnONajg&oe=6AA93B52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Between Floors - Find Anomaly", "keywords": ["anomaly", "exit8", "elevator", "floors", "wheelchair"], "long_description": "Between Floors \u2013 Find Anomaly is a psychological VR observation game where every elevator stop could be your last correct choice.\n\nYou are trapped in a wheelchair inside an elevator with only one task: make the right decision.\n\nEach time the elevator doors open, carefully inspect the corridor in front of you. If you notice an anomaly, go down. If everything looks normal, continue up. A single mistake resets your progress.\n\nAs you climb through the building, mysterious passengers begin entering the elevator. Study the information displayed on your monitor and compare it with the person standing before you. Are they human... or something pretending to be one?\n\nWith only your eyes, memory, and attention to detail, you'll need to detect subtle environmental changes, identify suspicious behavior, and trust your instincts.\n\nFeatures\n\ud83d\udc41\ufe0f Find hidden environmental anomalies.\n\ud83d\udc64 Identify human passengers and dangerous impostors.\n\ud83d\uded7 Unique elevator-based gameplay designed exclusively for VR.\n\u267f Experience the entire game from a fixed wheelchair perspective for maximum immersion and comfort.\n\ud83e\udde0 Increasing difficulty with dozens of carefully crafted anomalies.\n\ud83c\udfa7 Atmospheric psychological horror with no reliance on cheap jump scares.\n\ud83d\udd04 Highly replayable with randomized events and anomaly placement.\n\nCan you reach the top floor... or will the building keep pulling you back down?\n\nLook carefully. Remember everything. Trust nothing.", "short_description": "Inspect every floor, spot anomalies, identify impostors, and survive the endless elevator. One wrong decision sends you deeper into the unknown."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1027973496280733"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1410131461079628"}, {"status": "PUBLISHED", "id": "987038467727210"}]}, "baseline_offer": {"id": "987038467727210"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1410131461079628"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1057599736651442", "version": "1.0.8"}, "id": "918200571295649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1027973489614067", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1057599736651442"}
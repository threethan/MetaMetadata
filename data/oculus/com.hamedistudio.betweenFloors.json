cB9-USx4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgxmdB3TAidgucJUbUfljlDwIcojvI6FxqqG-pS4I1gQ&oe=6A8EE8FB"}, {"file_name": "screen (5).png", "id": "1060800449926711", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310720_1060800453260044_5880987406020177604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfgmJd924EUQ7kNvwG4aT20&_nc_oc=AdroXct0FFqzsQRbNgnsmuGhPQctJohJNbiwHIGoZaUI7pXpV04er9VSV_fvgtjHHWQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT7Xkyt9HR8KUMiS-CxFT-4b1quVB_TprDphc1-l0nBQ&oe=6A8EF222"}, {"file_name": "screen (4).png", "id": "1433826548514287", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/596106838_1433826551847620_8947953290719489292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCXmbdf-p0EQ7kNvwF3H0q3&_nc_oc=AdoWBSbrDdFVLoumIOeGuWuvnYgPU8k95oCtIOOI6Q9yNzvX8vXFKUIGkD2MBi5dA5g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTbxr9d-f0AyF_z_1nuNX2SHH2jEVc_wrrNPDkHagdIQ&oe=6A8ECA20"}, {"file_name": "screen (7).png", "id": "1326932499652149", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499314657_1326932502985482_707641238438884191_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GT1TjBhgBMUQ7kNvwFbmvWM&_nc_oc=AdrrdEp9Oqv9mFW2laiy7bTfiIWExQsVSSqOLdaVWhfHma5LHC-kFL5YrWBYDLdZFyE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEesaBcxP32YX4dDLd_DssWcQTGssTdziTUv1-x8l3Ntg&oe=6A8ECC43"}, {"file_name": "screen (8).png", "id": "905901231854366", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499312236_905901235187699_5748266271793251964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN4n0pkKqtcQ7kNvwEHnuwp&_nc_oc=AdpfJOBi7MUWe5VpuNjJHjD2CnCHCVOPIaPsJl65jpf0V0G9Bf_Rm8zGnq6oX332m80&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE80Mhyw9sw-eO2Tcux00VN0NhdgASxpNjzPCar6N9yZQ&oe=6A8EDD52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Between Floors - Find Anomaly", "keywords": ["anomaly", "exit8", "elevator", "floors", "wheelchair"], "long_description": "Between Floors \u2013 Find Anomaly is a psychological VR observation game where every elevator stop could be your last correct choice.\n\nYou are trapped in a wheelchair inside an elevator with only one task: make the right decision.\n\nEach time the elevator doors open, carefully inspect the corridor in front of you. If you notice an anomaly, go down. If everything looks normal, continue up. A single mistake resets your progress.\n\nAs you climb through the building, mysterious passengers begin entering the elevator. Study the information displayed on your monitor and compare it with the person standing before you. Are they human... or something pretending to be one?\n\nWith only your eyes, memory, and attention to detail, you'll need to detect subtle environmental changes, identify suspicious behavior, and trust your instincts.\n\nFeatures\n\ud83d\udc41\ufe0f Find hidden environmental anomalies.\n\ud83d\udc64 Identify human passengers and dangerous impostors.\n\ud83d\uded7 Unique elevator-based gameplay designed exclusively for VR.\n\u267f Experience the entire game from a fixed wheelchair perspective for maximum immersion and comfort.\n\ud83e\udde0 Increasing difficulty with dozens of carefully crafted anomalies.\n\ud83c\udfa7 Atmospheric psychological horror with no reliance on cheap jump scares.\n\ud83d\udd04 Highly replayable with randomized events and anomaly placement.\n\nCan you reach the top floor... or will the building keep pulling you back down?\n\nLook carefully. Remember everything. Trust nothing.", "short_description": "Inspect every floor, spot anomalies, identify impostors, and survive the endless elevator. One wrong decision sends you deeper into the unknown."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_webs
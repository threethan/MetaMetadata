i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499621314_1430020785965416_3824977578209285651_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J54uJrKwF_cQ7kNvwH6Doh4&_nc_oc=AdoiIxDWxl0Bl5nSn4E3p23oP-3mSWtOpKXEaJ-IHJqeJ4VLrW9trdGnRr1r3vNOzow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTALk2sRPe93N34ZVhf4NfcHPrMrwTFmqv6hczRQOJYfQ&oe=6AFDB39C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12 trailer cover.png", "id": "1541469424472901", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593734382_1541469427806234_6148521398722453493_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwk3VpEKs4cQ7kNvwGaMwdX&_nc_oc=AdrdwNMHJfbFkOvSdFRD5SmCV-oZ5sik-Nqzd0j5UV3gOTU0oz8LHDsyYlrtmEjc8KI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpcmdXiWfxrsCJiuf95ouiTax0ERtnl7ZZg6gD7olIrA&oe=6AFDD866"}, "display_name": "Primal Apes", "keywords": ["survival", "gorilla", "crafting", "monkey", "building"], "long_description": "Primal Apes is a survival game where you move like an ape. Put your hands on the ground and push: run, leap and climb rocks and trees with nothing but your arms.\n\nYou wash up on a wild island with nothing. Punch trees and rocks for wood and stone, pick hemp and berries, hunt boar, fend off wolves, and craft your way from stone tools to metal. Cook meat on a campfire, smelt ore in a furnace, and keep your health, food and water up.\n\nThen build. Lay foundations, walls, doorways, floors and ramps, upgrade your base from twigs to wood, stone and metal, and claim it with a tool cupboard. Place a sleeping bag to respawn at home.\n\nEverything you craft shows on your gorilla: head wraps, masks, shirts, arm guards, capes and chest plates. Your stuff lives in a survival-style inventory with a six-slot belt wheel on your hip.\n\nFeatures\n- Arm-swing movement: run, jump and climb with your hands\n- Gather, craft, cook and smelt\n- Base building with four upgrade tiers and tool cupboards\n- Wearable armour you can see on your gorilla\n- Two solo worlds, Normal and Fast (2x gathering), saved on your headsesurvival\nt\n- Day and night cycle\n- Comfort settings for floor height and hand angle", "short_description": "Survive a wild island as a gorilla. There's no thumbstick walking: push off the ground with your hands to run, leap and climb. Gather wood and stone, craft tools and armour, and build a base you can upgrade from twigs to metal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://telegra.ph/Primal-Apes-Privacy-Policy-10-26", "developer_terms_of_service_url": null, "publisher_name": "Big Bounce Games", "support_website_url": null, "website_url": "https://telegra.ph/Primal-Apes-10-27", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142112751687092"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4408299636053271"}]}, "baseline_offer": {"id": "4408299636053271"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793375820, "status": "PUBLISHED", "id": "4408299636053271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1150955457469488", "version": "0.1.5"}, "id": "2309816559796940
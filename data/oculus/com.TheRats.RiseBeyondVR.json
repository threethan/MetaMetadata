dn.com/v/t64.5771-25/499618440_672530012444839_3076779478403728306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHYW3_0Glw0Q7kNvwGwM-zr&_nc_oc=AdlfiqWGYmZ0xqq_ZkfPRra3uz1t60-DMD5T0bkImDZZS2FOSkEY-faydpS2JCR8DsI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFOQQhFJadV-9-OKCtpAhbBsGMMjf-QnSv0LW0TQkGcw&oe=69AADFC5"}, {"file_name": "38982547_668633431404869_6728926.png", "id": "574903638713371", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620513_574903642046704_1083900641620007958_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijLvQkkBgB4Q7kNvwGu_FLv&_nc_oc=AdmTB-W-KY5Z-oZQ8UJyfQFkvYsBcB5MF5C5a6ndzF3K3BA_tTyB2C7Ac-h8TeBGwS8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYz3cyE-TGUaLOIABUGvv4IDvks90_JX01wKM_VJIXEQ&oe=69AADDFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate GloveBall", "keywords": ["free", "esports", "ball", "ultimate", "multiplayer"], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode", "short_description": "Ultimate Glove Ball is a fast-paced 3v3 multiplayer dodgeball game where players race to grab power orbs, dodge incoming attacks, and blast opponents in quick 3-minute matches. With five unique ball types and skill-based action, it\u2019s easy to jump in but tough to master. Game on!"}]}, "developer_name": "TheRats", "developer_privacy_policy_url": "https://ratcatchervryt.github.io/web/", "developer_terms_of_service_url": null, "publisher_name": "RatCatcherVr", "support_website_url": 
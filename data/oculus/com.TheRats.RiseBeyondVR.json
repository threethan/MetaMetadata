.5771-25/499618440_672530012444839_3076779478403728306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpCUw4BBCbMQ7kNvwEDQq7X&_nc_oc=AdlrZ3HC2hp9zYKwUCWVE4GX3qHxXIPuwouhc4dCE-v38T9oCy8oOTR8SpiQW25e-dM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmyFq-9p5XhCXIQg4Zsz40tNOOwDaPgzx2-NoOlb-MnA&oe=69BAB1C5"}, {"file_name": "38982547_668633431404869_6728926.png", "id": "574903638713371", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620513_574903642046704_1083900641620007958_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elnXSzdEG7YQ7kNvwFrFSsK&_nc_oc=AdlSNUWXvDVJ0QoOdNuEaze5-5Xm343QJB_ppsKr7DJhb4Oquspgl2Hy5TjnJRN8x78&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOWtZkV7Ln-1SFxDO05mCVP_mtUeRjLV82fKUgkDlVlQ&oe=69BAAFFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate GloveBall", "keywords": ["free", "esports", "ball", "ultimate", "multiplayer"], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode", "short_description": "Ultimate Glove Ball is a fast-paced 3v3 multiplayer dodgeball game where players race to grab power orbs, dodge incoming attacks, and blast opponents in quick 3-minute matches. With five unique ball types and skill-based action, it\u2019s easy to jump in but tough to master. Game on!"}]}, "developer_name": "TheRats", "developer_privacy_policy_url": "https://ratcatchervryt.github.io/web/", "developer_terms_of_service_url": null, "publisher_name": "RatCatcherVr", "support_website_url": null, "website
n.png", "id": "672530009111506", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618440_672530012444839_3076779478403728306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVRxUmMOc-sQ7kNvwHVUczb&_nc_oc=Adoi_CDZBKnBMyygj35exuAXJ6RMYNBO4G5WvCYIczAeXstcWUnqHKcQrKpoNVHzzOA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIqPQIE6NAf_q4XW-9voioRcGR1C9cTQyN75PLC9_13A&oe=6A8D6985"}, {"file_name": "38982547_668633431404869_6728926.png", "id": "574903638713371", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620513_574903642046704_1083900641620007958_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ3rcDC5VOwQ7kNvwEnCV-E&_nc_oc=Adq6XCJkYVpGnvhyIdyBQoYHHPAPN_Y3d5SyPnPymFgDPn6C3JoRPME1Y0qqv60Hrkc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6LlfGovSQnbnLjEwmn0bz4Izyfdyom0mEYJewtKbSpQ&oe=6A8D67BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate GloveBall", "keywords": ["free", "esports", "ball", "ultimate", "multiplayer"], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode", "short_description": "Ultimate Glove Ball is a fast-paced 3v3 multiplayer dodgeball game where players race to grab power orbs, dodge incoming attacks, and blast opponents in quick 3-minute matches. With five unique ball types and skill-based action, it\u2019s easy to jump in but tough to master. Game on!"}]}, "developer_name": "TheRats", "developer_privacy_policy_url": "https://ratcatchervryt.github.io/web/", "developer_term
GwOSG1Jv3zp-7M42ThA9BJLJJCXNDPypZpeQHdq2AhBx7yz05UOXDKEe78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiCx7ift_kXHLT4dZf3reZImiOFz5O4tSV0DH_7Av2nA&oe=69A6EB45"}, {"file_name": "38982547_668633431404869_6728926.png", "id": "574903638713371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620513_574903642046704_1083900641620007958_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEv9gTDj2gwQ7kNvwH8YAs8&_nc_oc=AdlZsdt5RhcF51b6BoVybDkO76QAabSWHBvxwuSB56ol487C0bxPaB30AcQolsCJgz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs55knkboVRf75DE1ET-eLszRVAeE9qxgwkVGcg50RB8A&oe=69A6E97A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate GloveBall", "keywords": ["free", "esports", "ball", "ultimate", "multiplayer"], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode", "short_description": "Ultimate Glove Ball is a fast-paced 3v3 multiplayer dodgeball game where players race to grab power orbs, dodge incoming attacks, and blast opponents in quick 3-minute matches. With five unique ball types and skill-based action, it\u2019s easy to jump in but tough to master. Game on!"}]}, "developer_name": "TheRats", "developer_privacy_policy_url": "https://ratcatchervryt.github.io/web/", "developer_terms_of_service_url": null, "publisher_name": "RatCatcherVr", "support_website_url": null, "website_url": "https://ratcatchervryt.github.io/web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332
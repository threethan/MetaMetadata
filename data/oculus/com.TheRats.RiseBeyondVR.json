.5771-25/499618440_672530012444839_3076779478403728306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTlp0vbIg9IQ7kNvwHQ2VZT&_nc_oc=Adkykq6xulBpBkDaZG0spf5e-wybGFUOmqWQFh-d9BUZFkTuyVVaowyizdyMOJ6zVNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5gjfm2ViDWpNPD6iUY6MvHPenelroErtL0Dj8kpa35w&oe=69B2C8C5"}, {"file_name": "38982547_668633431404869_6728926.png", "id": "574903638713371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620513_574903642046704_1083900641620007958_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw9xGK_DRR0Q7kNvwGW7Q-0&_nc_oc=AdlwTfCBf7q25qJFhfl1eg_Oq57wAKl1H24_bpidkZW-D6KjZ8e1BBPgSTzBC6cMJuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNmFuTh7xambLWeKReaPiCoi0hLcRgiweaao_M4C41Hw&oe=69B2C6FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate GloveBall", "keywords": ["free", "esports", "ball", "ultimate", "multiplayer"], "long_description": "Charge in and knock 'em out! Party up and hit the court for a three minute match of manic multiplayer dodgeball. You'll be racing to snag ammo, dodge incoming fire, and blast your opponents into the digital afterlife with a well timed orb of electric doom.\n\nEasy to pick up but challenging to master, Ultimate Glove Ball will test your timing, tactics, and tenacity.\n\n- Up to 3v3 Multiplayer\n- Quick 3 minute matches\n- 5 Ball types with unique abilities\n- Furious tactical gameplay\n- Spectator mode", "short_description": "Ultimate Glove Ball is a fast-paced 3v3 multiplayer dodgeball game where players race to grab power orbs, dodge incoming attacks, and blast opponents in quick 3-minute matches. With five unique ball types and skill-based action, it\u2019s easy to jump in but tough to master. Game on!"}]}, "developer_name": "TheRats", "developer_privacy_policy_url": "https://ratcatchervryt.github.io/web/", "developer_terms_of_service_url": null, "publisher_name": "RatCatcherVr", "support_website_url": null, "website
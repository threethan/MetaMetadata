: "Rise Beyond Vr", "keywords": ["onlyup", "only", "up", "vr", "free"], "long_description": "Climb, Ascend, Together!\n\nWelcome to Only Up VR Multiplayer \u2013 a physics-based virtual reality adventure that challenges you to reach new heights\u2014literally. Inspired by the chaotic realism of BoneWorks movement and the addictive verticality of \"Only Up,\" this game throws you and your friends into a towering world full of floating platforms, intense parkour, and unpredictable physics so do you have what it takes to go Up!", "short_description": "Climb your way to the top in this chaotic VR multiplayer experience! Featuring Boneworks-style physics, full-body movement, and endless vertical challenges\u2014Only Up VR tests your skill, balance, and patience. Race your friends or fall trying!"}]}, "developer_name": "TheRats", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-man-vr/home", "developer_terms_of_service_url": null, "publisher_name": "RatCatcherVr", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-man-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9289259217851458"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1039565564940059"}, {"status": "PUBLISHED", "id": "666886212960743"}]}, "baseline
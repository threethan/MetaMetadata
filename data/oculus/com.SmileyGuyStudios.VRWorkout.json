BA"}, {"file_name": "DYF-Screenshot-4.png", "id": "762083711824148", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_762083715157481_1179884207095251185_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV5F3eAt5ugQ7kNvwHSq0z9&_nc_oc=AdrMS2xL8XTPw98T1idiQR4kWXqixYQ7BPBLDN9iEy-N7yDetfNgMrkWV_fo2LC4N7k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpzh-TGCQ8VDvNVf8rQAsvGbdk2hNR06_COgs35ph_GA&oe=6AFB48C7"}, {"file_name": "DYF-Screenshot-5.png", "id": "925138472137154", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222937_925138475470487_5743533730862637072_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoU9iZFsACEQ7kNvwGk6iVt&_nc_oc=AdpAG45hnERMUb01K7krBQrXcvk-zOjNISH1IIDxVmSK5lL0kf_SBztn5Yhiwkr0c9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOfT8ujFHunFtizrXiUhxg2p-WMpzLYPT_8I6ndn3mBQ&oe=6AFB40BB"}, {"file_name": "DYF-Screenshot-6.png", "id": "1094274533433940", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623558_1094274540100606_2095518904498562392_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QoGFXrEu60Q7kNvwG9XLGd&_nc_oc=AdrCb_fqY8_X5kbCp-0g_dw6UYx93IEgpjs8a-K6Q2r447BnwTJAcB4Y76sPg04HCUo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0e1zqmGh15okBbtawiaMs6es1VlLNrhTnlt0ENwOflg&oe=6AFB2E18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Do You Fitness", "keywords": [], "long_description": "Do You Fitness is a new type of fitness game where scored exercises and drive the outcome of dramatic situations.  Exercise reps propel various scenes where you may: aid an alchemist during a resurrection, survive a standoff with police, negotiate with a crime boss, resist the probing of an alien, find oneness in the desert, seek decontamination in the wasteland, and more.  \n\nDo You Fitness is designed to disguise a workout as an exciting adventure with dramatic virtual scenes and engaging dialogue driven stories.  Our environments react to every rep you complete, making it easy to forget that you're even working out!\n\nWith workouts that are scored and tracked over time, you'll be able to monitor your progress and see just how far you've come. Our characters guide you through each scene and exercise, helping you improve your performance.\n\nTry Do You Fitness today and discover the thrill of a whole new kind of workout! Whether you're a seasoned athlete or just starting out it's the perfect way to stay motivated and achieve your fitness goals. So what are you waiting for?  Do You Fitness", "short_description": "Get fit while having fun with Do You Fitness! Jump into 13 character filled levels and perform push-ups, sit-ups, jumping jacks, lunges, planks, and squats. Each rep is scored to help you track your progress and improve your performance. No need for coaches or trainers, our dramatic scenes will guide you through each workout. With responsive environments and a story that reacts to exercises, you won\u2019t feel the burn as you reach new fitness levels. Don't just exercise, experience fitness!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://smileyguystudios.com/wp-content/uploads/2023/03/DYF-Privacy-Policy-1a.pdf", "developer_terms_of_service_url": "http://smileyguystudios.com/wp-content/uploads/2023/03/DYF-TOS-1a.pdf", "publisher_name": "Smiley Guy Studios", "support_website_url": "http://smileyguystudios.com/doyoufitness/", "website_url": "http://smileyguystudios.com/doyoufitness/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null
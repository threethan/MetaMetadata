o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuwA1fvcRwOowIZ5TT4i4FIREe_cMCyZYo2bH_jfWzT1w&oe=69A17CFF"}, {"file_name": "Frame 4.png", "id": "1691163371737513", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75572751_1691163378404179_7640095952276930352_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkzcHK8klgEQ7kNvwG5LryS&_nc_oc=AdmtUdRKDn1emF2N8bMJhlbcs7y2A2NP5rsupQ1KuBtBBQX0m3W7eE4CXEJUPEKjNCU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftng0kuBmeSpa1K9gaLIl1LkcKWVbjYD0hQu51vicDGcQ&oe=69A18CF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Table Space", "keywords": [], "long_description": "# Table Space: The Ultimate Mixed-Reality Tabletop Games Sandbox\n\nWelcome to Table Space, a new sandbox where your favorite tabletop games come to life! Play classic games like poker, hanafuda, or any card game imaginable with friends in a fully immersive environment.\n\nCustomize your gaming space with various themes and settings to create the perfect atmosphere. Connect with friends through integrated voice chat, join public lobbies, and personalize your experience. With a growing library of game modes and regular updates, there's always something new to discover.\n\n### Features:\n- **Versatile Gameplay:** Enjoy a wide range of games including poker, hanafuda, and more to come.\n- **Customizable Environments:** Tailor your gaming space with various themes and settings.\n- **Social Integration:** Connect with friends, join public lobbies, and enjoy seamless voice chat.\n- **Constant Updates:** Benefit from regular updates and new game modes.\n- **Mixed-Reality Innovation:** Interact with the game using your hands just like in a real-life card game, enhanced by our custom-designed interactions for an even better experience.\n\nJoin the Table Space community and redefine your tabletop gaming experience. Every game is a new adventure in this vibrant and ever-evolving platform. Discover the future of tabletop gaming with Table Space!\n", "short_description": "Mixed-reality tabletop games sandbox: play poker, hanafuda, or anything you can imagine with a standard deck of cards with friends. More game modes are being added constantly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.boxtree.gg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Boxtree Inc", "support_website_url": null, "website_url": "https://www.boxtree.gg/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7704631699594522"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "535690312452451"}]}, "baseline_offer": {"id": "535690312452451"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1724185920, "status": "PUBLISHED", "id": "535690312452451"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26140183972279348", "version": "0.55"}, "id": "3303216509972681", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7704631686261190", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26140183972279348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3303216509972681"}]}, "change_log": "Trading Card Games Improvements:\nAdded a new card binder primitive with support for spawning token cards in TCG matches and viewing your collectible shiny playing card collection from daily rewards packs in the lobby.\n\nMajor performance improvements for TCG decklist loading.\nRendering improvements for Scramble Words tiles.\n\nChess improvements:\n1. You can now see valid moves for a selected piece.\n2. Automatic rollback of move if it is invalid.\n3. Automatic castling to either side if valid.\n4. Automatic check, checkmate, and draw detection for stalemate or insufficient material.\n5. New round cleanup button to reset the game.\n6. Black and White turns indicator.\n7. Added a captured pieces zone where pieces will go to automatically after a capture.", "created_date": 1771281761, "id": "26140183972279348", "version": "0.55", "version_code": 150, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7704631686261190", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26140183972279348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771264253, "id": "26138356892462056", "version": "0.56", "version_code": 149, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
hYQ7kNvwFYq1Fx&_nc_oc=AdruRnO4AXpV-j-gKDKWNKXSN9MdtQa6u-oUoqTwPwlnA37gkGV7Wth4udfbm0hrBCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DNgwRXRC6KGDzpJ5LsDtCTZQ0CnkogCfVGiCM-8bCRQ&oe=69D8EEB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FPR_Quest_PreviewImage_v01.png", "id": "789138165374804", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974631_789138168708137_2509886806746700569_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr96-WyFvjcQ7kNvwEiif-j&_nc_oc=Adp9XX2a3WKMTG5tVFoh4fuwTrzGfu1c4qHKa6GjtyzZBUZFreKs4beI7UI4gGr0N8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i1XK8srM8KE1vs2S1DiEV83aVQ4gQiZnmshyRt18wxg&oe=69D8E313"}, "display_name": "Feeder Protection Relay Training", "keywords": [], "long_description": "Feeder Protection Relay VR Training is an interactive step-by-step introduction into the modern feeder protection relay systems. The training presents a general overview of the feeder protection relay as well as the description of the user interface, inputs and outputs, monitoring and control features.\n\nTraining outcomes\nTraining provides a basic understanding of the feeder protection relay devices and describes their purpose and features, as well as the user interface, and audio and visual tips help to memorize information much more efficiently.", "short_description": "The science and skill of protective relaying is fundamental to ensuring high reliability in the operation of the distribution, transmission, and generation systems. This protective relay training will cover relay theory and operation of modern digital types of feeder protection relays, followed by hands-on step-by-step exercise. The experience is aimed at people interested in understanding the purpose of protection systems and their basic operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalengineeringmagic.com/privacy-policy/", "developer_terms_of_service_url": "https
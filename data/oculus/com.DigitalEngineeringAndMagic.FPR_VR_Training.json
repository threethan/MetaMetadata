0f&oh=00_AQTD97yiqMKaa7wBQp9FESCHgHIBs058EOac6Nh_QBGtyQ&oe=6AFB29E2"}, {"file_name": "FRP 05.png", "id": "446658046690772", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75392879_446658050024105_264671583290885153_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ggIXHCjnBUQ7kNvwHcQ0Pu&_nc_oc=AdrfYqqcddMiNKKkQEfz1qviFvhb85cN-JglEX_cis8WqQOX_lso2Wpf2TLCKJS_nVw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrPOfV1LG4TiyRGwqDuGhCVhE2pT1NzXLPoDQnLaK2VQ&oe=6AFB30F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FPR_Quest_PreviewImage_v01.png", "id": "789138165374804", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_789138168708137_2509886806746700569_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwj3RDsrGUIQ7kNvwFz7qQW&_nc_oc=AdqNWHYy_TaG6O0q-zTKX2PNofrAbrVM8xm1YlK0Dp_TKgUwTDlNyyoUt0sauZr_i6Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo1-i9la0DDYtcfFpf5TP-j8Xrf8UbCl-Pwe7t4chepw&oe=6AFB2553"}, "display_name": "Feeder Protection Relay Training", "keywords": [], "long_description": "Feeder Protection Relay VR Training is an interactive step-by-step introduction into the modern feeder protection relay systems. The training presents a general overview of the feeder protection relay as well as the description of the user interface, inputs and outputs, monitoring and control features.\n\nTraining outcomes\nTraining provides a basic understanding of the feeder protection relay devices and describes their purpose and features, as well as the user interface, and audio and visual tips help to memorize information much more efficiently.", "short_description": "The science and skill of protective relaying is fundamental to ensuring high reliability in the operation of the distribution, transmission, and generation systems. This protective relay training will cover relay theory and operation of modern digital types of feeder protection relays, followed by hands-on step-by-step exercise. The experience is aimed at people interested in understanding the purpose of protection systems and their basic operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalengineeringmagic.com/privacy-policy/", "developer_terms_of_service_url": "https://digitalengineeringmagic.com/terms-of-service/", "publisher_name": "Digital Engineering and Magic", "support_website_url": null, "website_url": "https://digitalengineeringmagic.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "960273447944829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982454_524689498510800_1602727542952551959_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDArYGR_yJIQ7kNvwE05pIn&_nc_oc=Adr_A0rULFvgLl50hxCBuX5r3cEscHb-AoWL7E1ZRvJBuUlRcm7LbzCiqtwDNFmFrbs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR97GHxhRLytIzMNzfaLubhjuG4we2vZRAU_Py_ytzJvA&oe=6AFB3BD4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Feeder Protection Relay Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_n
g0Q7kNvwFIpdcN&_nc_oc=AdrMhvm7UUqokWKE8WDcgS8DMXOp2ZkOa3uYsvjAk_zUfSE16BgRvXrlFJJpvS47bJI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gbCqfBsV178ZTkegNMWjXCRNP4cT3CW6DVQ9swGQBgA&oe=6A3294B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FPR_Quest_PreviewImage_v01.png", "id": "789138165374804", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974631_789138168708137_2509886806746700569_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84eaRV8OP0oQ7kNvwGPbs0K&_nc_oc=AdqvQpbBzeRB6ltaLm4gZTTA49u0omSD4OIEANt45MCbPwQgfqtSHfO6gVNm7InuCQY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VDMrNkS4pq9ozLa1sshpf81bJHlKTqJuE436HN0rc9g&oe=6A32C153"}, "display_name": "Feeder Protection Relay Training", "keywords": [], "long_description": "Feeder Protection Relay VR Training is an interactive step-by-step introduction into the modern feeder protection relay systems. The training presents a general overview of the feeder protection relay as well as the description of the user interface, inputs and outputs, monitoring and control features.\n\nTraining outcomes\nTraining provides a basic understanding of the feeder protection relay devices and describes their purpose and features, as well as the user interface, and audio and visual tips help to memorize information much more efficiently.", "short_description": "The science and skill of protective relaying is fundamental to ensuring high reliability in the operation of the distribution, transmission, and generation systems. This protective relay training will cover relay theory and operation of modern digital types of feeder protection relays, followed by hands-on step-by-step exercise. The experience is aimed at people interested in understanding the purpose of protection systems and their basic operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalengineeringmagic.com/privacy-policy/", "developer_terms_of_service_url": "https
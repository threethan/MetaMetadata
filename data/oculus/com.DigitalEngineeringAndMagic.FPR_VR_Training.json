5QQ7kNvwE5JDsP&_nc_oc=Adp87m0UgkmMIB-Bsmt4N8vf6DwW2YK9GSDh6tvE_-RrLG-RwAar3eee8UCATfa_zhU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH82KK0XRnkAItgMer6weg8lOFIn2AP-k4V9uW1M93Kdw&oe=6A884630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FPR_Quest_PreviewImage_v01.png", "id": "789138165374804", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974631_789138168708137_2509886806746700569_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q9lH0lqrDAQ7kNvwEOAoGH&_nc_oc=Adp9cp6iEl-tS8QZAUlXoC8r4PQy8Y7FXzt_F-xfyAGKanPfYE9WFZjCTHLJzDLIs3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbl24-8ZGb_pfCaPzyh3P5_ONcjiA_Pc4KTMlbWkOMVg&oe=6A883A93"}, "display_name": "Feeder Protection Relay Training", "keywords": [], "long_description": "Feeder Protection Relay VR Training is an interactive step-by-step introduction into the modern feeder protection relay systems. The training presents a general overview of the feeder protection relay as well as the description of the user interface, inputs and outputs, monitoring and control features.\n\nTraining outcomes\nTraining provides a basic understanding of the feeder protection relay devices and describes their purpose and features, as well as the user interface, and audio and visual tips help to memorize information much more efficiently.", "short_description": "The science and skill of protective relaying is fundamental to ensuring high reliability in the operation of the distribution, transmission, and generation systems. This protective relay training will cover relay theory and operation of modern digital types of feeder protection relays, followed by hands-on step-by-step exercise. The experience is aimed at people interested in understanding the purpose of protection systems and their basic operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalengineeringmagic.com/privacy-policy/", "developer_terms_of_service_url": "https
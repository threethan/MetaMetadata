culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4GgpOypdsoQ7kNvwGdcNCa&_nc_oc=AdpY0fAYIx64GuPS2l2ulXS0pNgtrklQWBMmH5LGuQkagKZ2VoJZUuzYpNWibXtcvOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56gOjnFabE0lUHGCH2Slbqc8elYOdR2N_ecqwUFuGCyQ&oe=6A1EEA2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c16hIuvPAGUQ7kNvwEbH6Bn&_nc_oc=AdpppeeI1xZlrJXoGgNv_1CRHtdDPoZSn0obK5PtUa5_9f0W8pGLuFLqWT20CAXmFVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zuBVDRUH1-rtFnTycQO2UY6Gw8URmPttrPXGtTOPCXA&oe=6A1EE99D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPDdtFXJ4P0Q7kNvwFRmHQR&_nc_oc=Adr1752QdnmWgKxti6jRdnEWGu0OuM8HaKDsGj-hVRPQFsh6nfPuB2O6yKirN7jEEJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u13Oo1FZIPdFcfbfWBacQKwRKqks0XC700ZdV56u50A&oe=6A1ECAAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZFbOOnJU5gQ7kNvwEHjMI7&_nc_oc=AdrctBM1EZSmqpft-rD1KlxiqBrgVHjPRQsQKm_At5Qk52dw8ZpGcrO2niWsPKZ0nMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n6wfMk41gcXsIPnuO4eGhE5iuPQP680R07u9HuMKwMQ&oe=6A1EF0DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uinoi632HgUQ7kNvwE-BDNc&_nc_oc=Ador_FKqss_eU4bn2-MJfIsoYPO7rkPxXSQJcqLMOxC6TkZzL01XAZP1BVpGXv4saL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VACBJ7MxAOaNDIvyCXXJG1FrFsZr5wxJw5qf2GWnJvg&oe=6A1ECF52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
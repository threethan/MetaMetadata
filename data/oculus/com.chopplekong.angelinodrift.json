culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPwgs536e1MQ7kNvwHPhwp7&_nc_oc=AdqNtbOogPS6CplbdF_Wnqc7Hg5Yh-KXpVSeowRMUEP2joZf2qCJ8Eu5_FJZyoaZ1Cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUYMEwT0bATLm7PA8K1yvD9KW7DSA83ZUOeHXg2wv9Ig&oe=6A4D0EAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocxCiOW6uBIQ7kNvwEpIRe3&_nc_oc=Adr9TTP0BQJfyLZZYMKgNuWLE2pltE9F-ec1z5dEU0a42dh15Gb095TW1zyZqBGpjw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkYz1z_lD6Q1i7degf6pYVWKC96uMjXynr_7PNjCUD_Q&oe=6A4D0E1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6NS1Cl5Hd8Q7kNvwEnwDSh&_nc_oc=Adr6xDLjUzsv7RSKIW5Lr9VwDkfZbUaw9mNRRr1CM4VyGGSlXUzhVK3VAXHmqHvrf8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMA25bvfOUnMcA3e7Uh5WRVCHYO1fIkYWEQEZHXnvVsw&oe=6A4CEF2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeCTsvS_ojcQ7kNvwG98J11&_nc_oc=Adr4qAAgVByL_KCFV2MJMCLqhVf9Ms3JT2EBiQDBy8EVAjJfWXkxr_cVIBRZVrtJsbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW-RGEy0KA4VVsMndqY463EQrGdLYZSMFEgkawox5iOg&oe=6A4D155D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP6Sa7T92IgQ7kNvwF-oXt5&_nc_oc=AdqGRMlj4K9M0sJZDQ8IaDJ6F0K-uTNBxRdu1vfpG1oXUE3p5m4wRNSp5A8V6-wNXnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAXC0B7DZ_P_AvMVqlhh84A3zEBjdjkTktJ0yXtKineQ&oe=6A4CF3D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
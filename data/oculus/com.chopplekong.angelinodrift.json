culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29uCVb153BMQ7kNvwFzKhK7&_nc_oc=AdqUoT2bQ6kdda9eilE2xlSHSZMFXiU8Wxu0PDsZjTYnXmWRov3QX_-4a6UPPzARWgQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ7a-MT5oBKkRW5kkI6GqBGkc2ggYfRmHSaybT2mh03A&oe=6A4A6BAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D4YMkWdO3EQ7kNvwGPUgPZ&_nc_oc=Adq24ijX4oEE737Xg31nlGmu0nHGJho9w9xqLO1xMp-kC5wfeKLCjkYbdtFccvuDBDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfvMmBIs6VeHVjqVvBo3RXaCmcmcqX76EkpUuId6tDog&oe=6A4A6B1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6NS1Cl5Hd8Q7kNvwE_jKB9&_nc_oc=AdpoK1agUzmcAnZ8C6PhlhDE2uSAga5EmnohowF4-0IhIsbjiY29W1pNtlDWNiNFVzg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjLFq4q_RVy9pE6paqTSvKuNwdXYUPlGRxGcETREWqjA&oe=6A4A846A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWT7M98pzCUQ7kNvwEwIUjL&_nc_oc=Adp4eQSdapho_jdR7JOhlUVdpxITAIjlaC7C5tRxSL6-RwHfNQHPCSadVqpGValMvaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLFSR7yM_MB_rIuaFa_w_f1k5Vh9GC58gkxw59qLgowQ&oe=6A4A725D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP6Sa7T92IgQ7kNvwGysC0j&_nc_oc=Adq2qDSKsk8rA1FQqgSY6q825sQTwMxQXsNwRaDnRHHx2hXHOwv7DyjQLmrzTzzzg8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp4PwbK8-MCsE29fDtiyQ7J8pqasIE4uUxCkpGZmNVsw&oe=6A4A50D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
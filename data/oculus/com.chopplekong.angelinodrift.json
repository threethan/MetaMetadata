culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8qzpRHuLjQQ7kNvwHyDCDF&_nc_oc=AdofI-aBvksNwAK0qc4FgGfagpdo09Pxc1-vxvl6z6Y__oHVB7zHXP9l0QH4_86Fqz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGRYniwy-Ny6Y1nak6lS5j19Ux3UY_VoFn1ehuTNv2BQ&oe=6AE5FCAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc7zsfYD9-UQ7kNvwH4PyoY&_nc_oc=AdpKcSpwrfjAeP-4BGHjsiFywMoVT0V0QhVI7W-NHUl54GuG5GryDklMzpNLGxpMb28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNieBKQWfcP5TqDqfh6EFiUXelDZTytI31VjiKYYVGVjA&oe=6AE5FC1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRgHjBm2oTwQ7kNvwHHfSDV&_nc_oc=Adqe-F-7iAwnN7LvjA73Rm9qagdWFFaOD-_uoIrbDRy20Od6k8zUB49vPw9y4kfewNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq15HGmt31XBtiFg0HmibyUqRYq2mHDcynYrp0H5n9lA&oe=6AE6156A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVHjFbtq_1IQ7kNvwFij6u8&_nc_oc=Adp-do_iFO3Dk2V1kuwrvex9wqAPWFCeW1KzmLEPGDYmdmXAnxeuA5jFDsNdYCctRT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzCJaYG3zCsS6Kz-41apuwTEVbhCQBC2dE9tjafc4qpg&oe=6AE6035D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfj2gUtrzl4Q7kNvwFA3tv7&_nc_oc=Adr8HscP3UtLcX7hl3KvYy08J2iPTLRcVxyJjJpUZ8MEngFdaPMKf2CHKT7uubSWmec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC-qBXScq81rwkzYRVXqGIJ4u9kxNkU3xYb3c-2zRkvg&oe=6AE5E1D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
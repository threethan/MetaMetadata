culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQlCbpaJJQkQ7kNvwHuGtzG&_nc_oc=AdpKbn_SHJMA6G-WS8Bow8Y02Hr9EION6UK1MW5lS2BG9jtHAqeWo4FA2u_anWkqYFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmJCRcLVSS27Jm8mGjBlfcgNYCVQ9nwDNE8Akc2Sqvfg&oe=6A773EAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vv3Q21VPJwwQ7kNvwE-ezvD&_nc_oc=AdoX4lKlO4FOmgdiepA-O1odOr-1ePX6rm21Nf7U6fnip82o4-ZqrmkRFTMT9HyNNiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZvtqtk-25Gci6Dx9kO5VHwUlcmW71GNzakyvuGuh6-Q&oe=6A773E1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUc4WD_J4k4Q7kNvwEeznWf&_nc_oc=AdpjggPyZdjXsDNgRrO1jLk9wCGbQ6keRp1s2r2NH4oBuLsXegLojKcDJETO5kxoctk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZqTuhf1DZI-aBfx09gRlH5ihe0eo-n5qU8uYkgL7StA&oe=6A771F2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD0kop1Weh4Q7kNvwGVlSxa&_nc_oc=Ado2u2Mur8IZbvtkXkPZq97LwPLrBp9QU5G81o3p-8VhbVJ4euuqMH-qy25GqDAQFMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRwUCjLj0tulsEHtdZIz1z54dgfcOBQr0dZaR8a1-SMQ&oe=6A77455D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMr2eRgiRQYQ7kNvwH_lGu6&_nc_oc=AdpA2wfU4igX-ld_GMPHnFXWKzcZMTLfCeFOUfIgap2JCJVTYwQuTUxDNUe9Pbf3Y_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCCfp0_IBCNPOoBMNCdA9LhhHwVpERr6YGtYXVqPoe7A&oe=6A7723D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6F6anc3K80Q7kNvwFTgt9W&_nc_oc=AdpV0JALEYNtT6Gyj_3HEZRRxO9XRVsHDClxJZ8sGcJ4y84KxLYv9TEgVR-paMnh48w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdtkPACETcbENYgbmSKpma6qV4Ck07WnjCsCsM32_eIQ&oe=6A9985AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgVP7Fl34yUQ7kNvwHgmiZZ&_nc_oc=Adqtwo5hWh17xR2mBKaM4YxjuYzIRufQt5BzvzP9tJMtL0_fywMQcadK3dgVCvKcHA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNhZtkUc5EdqbUHr0R1YXeOnnBUex69xZtoNecuw9sFg&oe=6A99851D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkiMKd5GXwgQ7kNvwFiRCVj&_nc_oc=Adr28wgKGSp0eLUOFevlX1qwf9V10Qx1pYigKO_zk1uSP1JHujaPuX2MKst-Cukqnxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHonUDQKWKeiI61y5d20qcc5czb_ml_Wbz6cdvtBXkWA&oe=6A999E6A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLYlerqRR5kQ7kNvwFnvnQO&_nc_oc=AdoPWkJ95KMj5x-7L89MQi1R7uFDQZ7-38H2XZ2M4dKjrYIbBxVLOJopI0vlGEPnaIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvvBQDHUBZAqhR0HmZlnlMol7ayuCtqS1ZoiMdNfaOvg&oe=6A998C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyfPydmuCNUQ7kNvwEa9Anh&_nc_oc=AdoxWZuHkCGFN5TbjJ_seG_LwwJAU_2nCR4YTjZY2dvFCnG8L7TByv5svvL3QqURDIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILE33jKvN7bF7h_jL3l9zlENO3_UBytU0_gQRhJ5vwZg&oe=6A99A312"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
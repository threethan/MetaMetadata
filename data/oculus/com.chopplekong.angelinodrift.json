culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDbgS5O7yXAQ7kNvwG7kbU0&_nc_oc=AdqQhf-dSopDbO79bURdS3DRgiX8mLgLXfTJ80F2Ur1Jdp5n8ptKP004nileMhc9rxg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFRQzkLs_UMzI7skWUkyzVsBAMu1vCfiJ2q0mCSna0JQ&oe=6A8040EB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp4S9mCFytMQ7kNvwFydqNI&_nc_oc=Adq5U-WmYdbbfmT1vD4dijOrLOqZgC6to-fD2rdnt13to-qKs_8nu_d4x6cTgk4Wg-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWOXwHpKYEAeWzjMSB0vW84zt5XkGhVMtbV5B2Rqeqvg&oe=6A80405D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6wpjj7fJpEQ7kNvwEPYj9I&_nc_oc=AdpmHdE-GaPy68GEXANY0N3AQYh1Y8ZdC2phuPb8q6XhmJOz4d_FRQlIxF1KhMzXoT8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF86DXf_UxM824SGCuUojDL7Sta2S24Cmn6CX0MbWV7uA&oe=6A8059AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRP-Ytsh4ZEQ7kNvwFePRec&_nc_oc=AdpWPFvwMlSJr9_uve82_ZDHAMYV_tgOsFUtQ2t8s7zrPbMYwD5tZfG5S8SurYso6O4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbZeNgL5coUEKEScHeQgafazpVCGxu97XCYWdldE5xgQ&oe=6A80479D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPHIRltjt7MQ7kNvwHDZ1tJ&_nc_oc=Ado8PNf43Z5rkFXBw2gzMHeFdSHb9n9n337TiLxsmg3lTwwYq1I7AVhZI6X14f9G-oc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECwHCs2Ifu2teL09bLWpw9h6mIBgIUEZH17FIwtMD2hw&oe=6A805E52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAPx2nblaiUQ7kNvwGsEGFT&_nc_oc=AdpxEeGnOrkRvb5htuxH6dHOEF5HRyyjzw9gCMjSlGS4Anv72qPxZPcTd1Qq-tNi0bI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLH_j3anWqVQzeDxgu5UDqnkB7iCZBh21nvNdb9uEgnQ&oe=6AAFEF2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg_IaV86Lw4Q7kNvwFidITe&_nc_oc=AdrIPOayNWcIBJSUKSEn5pLiUe8wQWlOZ066Zg0pFW8IXyAHWs9VScPChY03dGPwT8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAacbbeg96X9_fvGNAMuAKCaCvuCMSD1pIiIvKLuBUsg&oe=6AAFEE9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnOuV-1qK1oQ7kNvwFj1Nqf&_nc_oc=Adp01iAc0Slo7I_k_sk8R46dceegnS_6vWHpRvzupyw7oj2GdR2M2_7ffCzN-G0e5Mk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqnmBwD2Ss6sPdX_Ijopr3hrnZQoY-liCSCYyoibMxCg&oe=6AAFCFAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItCwkquIFaQQ7kNvwHxVen4&_nc_oc=AdqzKNca-G-qpi0YVcMF5jTs17WKwAol93U9H7UtZbevJGhxZZJXNhQF-whgDvtpcvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUARC8H7KUR2QmqHDT9GW3K1XqGe-mkb4Os6jAq6a3KQ&oe=6AAFF5DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhdOg9vei2wQ7kNvwGkhui2&_nc_oc=AdoFtmbZ1B_qnRFeTzePuvYqZXHrULsEhI-YrnwO5XGOx3lquMYsSv1Kz3vgcWx9cow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxVOStTRBb8G3fZdSN1y6jq1IIaLAbvnnn4m3U5YXJtQ&oe=6AAFD452"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
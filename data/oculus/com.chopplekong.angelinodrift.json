hdsgKBtLBdAQj6d_6ZgnvhGmByJs77Zsnai27mas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pvxZKiRo2VoxOELsZfHLnjADhJfhqja5bIqY07VQgrg&oe=6A3A9FDA"}, {"file_name": "2560-1440-ScreenShot_04.png", "id": "1201085911759139", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620429_1201085918425805_2507035246306087337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60weAMbEnRgQ7kNvwH1Xw5B&_nc_oc=AdqyFLpJ7uTt6nSnYXs2MxjucviUZXLjIjMwbNhi3Y0E95pgd7ug4JvCl8l-6a-Bqsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5oAWReDlQrKsAxYlWJMVR5DW5EHjlGDqYNRaetfmg1w&oe=6A3AB403"}, {"file_name": "2560-1440-ScreenShot_02.png", "id": "1335542147907684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618948_1335542151241017_2689273503911203399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtOCR4R0ryYQ7kNvwGPB-qd&_nc_oc=AdqHnjDO2BTQJJ2d2g1_c8uN4FjddOFBbfRUuLSoK5rZQob8hNwuZD1FGCrA4_3aHdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v5WdpCtWII0NCYWbBS3krM41iijILEFR5tsv0xkoklA&oe=6A3AB8B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440f.png", "id": "1183001563885963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823876_1183001567219296_4562539802302143254_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM6IYhgaynUQ7kNvwHnvNeA&_nc_oc=AdpbmeUmNBz7vBFEPJ4aYsthAfRTUPRVifYoT7Yn1vgUA6GaTqe_VwYTn8SGEMqhIWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MSSB3M068cYLJatXLslKrFih_1-1MSRbsCwjl1XVplg&oe=6A3AA9B5"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "Angelino Drift is a pulse-pounding driving adventure set in the dark streets of Angelino City. You play as sharp-tongued Marie and her new driver. A mysterious threat plants a live bomb somewhere in the city every day, and it\u2019s always a race against the clock to find  and defuse it\u2014before the whole city goes up!\n\nPerform stylish drift spins around corners to maintain speed and momentum. How you drive is the difference between chaos and control. Can you keep your cool when the city\u2019s on the line? Time's ticking.\n\nAngelino Drift is currently in early access and is being updated often. The city is constantly growing as the experimental project aims to showcase what's possible in the Quest 3 and Quest 3S. We would truly appreciate your feedback. Come for a drive!", "short_description": "Angelino Drift is a high-stakes driving thriller. Race through downtown Angelino City with bomb technician Marie, to search, locate, and defuse a ticking bomb before time runs out. Speed, precision, and nerves of steel are your only allies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chopplekong.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://www.chopplekong.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25272718619001874"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1356272535719574"}, {"status": "CANCELLED", "id": "858884099959902"}, {"status": "PUBLISHED", "id": "724064786851915"}]}, "baseline_offer": {"id": "1356272535719574"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766606520, "status": "PUBLISHED
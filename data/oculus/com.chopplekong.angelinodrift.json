culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EilRpwUA_Y4Q7kNvwH8UKmo&_nc_oc=AdoxSMfJ4GPSSHdf3lZ4hRFdCxCeiPZPwbwR6TQxEtfM9vL_6BW4H0hLWIp_0vl7vww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yhr3Ie0JG-H-s6k8xScsnRKtdJ16psVzLkSoT8HJ1mg&oe=69F8AEAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4ojpebjfogQ7kNvwEOii9x&_nc_oc=Adpa28jRnfi1TmS6hfYm3nCcnGzPhf_iQsr31a4lAy_M9k6OMwC0-1cgxQ5M_ek5REk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qPundmy69K6Pl8MzLWjXPemmCl1KshPNIdEnveX-4Sw&oe=69F8AE1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hd6YCd0mL2kQ7kNvwHE9_ce&_nc_oc=Adraw264gm6TqUSh_N70prngzVQJFj-Hwrz5k2uWFNekUt23R2RNOZMFlCtCl0VkvB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cKCQb_Q1jqUZWpgzkjRvkjdyRQGwhY-PbpCA8-zkOgw&oe=69F88F2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3yMGJ3ynycQ7kNvwF41hT2&_nc_oc=AdrFkUic8hDjFKxRUXogsC7pZK9sSOpiLN91C8eLwUE3ZRXnhoKGmruxVZS0Mk8P3d4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_xs4EHccpMR284bvtBToZaiEYRsXlWIL1QjXywdzyZw&oe=69F8B55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQXbdf7WBlcQ7kNvwEG0REM&_nc_oc=Adr2EtGJQAAN9tGvYmJfZ8OP5T8Pb1fwqo0S3mBl7xeg6j75C2iXMZxTgr9AwubIPqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lLc4WCa95B5k7TqDhhDrl050q7AcT-l_4wyQTuyCFTA&oe=69F893D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfWj958j0u0Q7kNvwFXuQzk&_nc_oc=AdpfFDMpIkiso7Fw4Wt8tt40Kgflwi-rvIA3zXjVlbgRn2n661ywhFwwSDZihQe4e9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8g13CtgyFqo1QjyVeSdjrdufbv02KXPiWRjny18BVqQ&oe=6AF088AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upB6-k5t3tMQ7kNvwEVmzpz&_nc_oc=Adoc6JTwuRkem9LWRdmGxHZ4EScP2Qg_kBtQ3ZvDTNYKqSRyO6n7Kn5166Efow3Vroo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZE-TfS6TX8EUO6lmZSLxgHLTwwSAjH5Oa0QDK05Cdcg&oe=6AF0881D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6o7WpTeAQMQ7kNvwG7DnZ2&_nc_oc=Adr2dhaiC8s4oEvRPH9gml2Blq0IZNHL5xTCQcbFqM1RIf3jjpVUyzZu20M2YRfFcSw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4SAeQ3xkh-7WMsPuZVW4WctofOcmLywasQqpCVnI6g&oe=6AF0A16A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja2lmNu-l8UQ7kNvwFfMQvO&_nc_oc=Adr-QwgVK66EKslcIJqCrPqngn38j64OzR-xFW6IpN3KcogmkCRm6OIdHKoPNWmmuPM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoVKZHSjNMYcSj-T43EuZuNaKjZrJl8IPrtSu3Z72ffg&oe=6AF08F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oJ6S8OaQu8Q7kNvwH-YGXD&_nc_oc=Ado819tQlMrk5oNiAAt-XwJGrWf4l_gQVtH_wXGvtr9WH-Q3vIdv0C28uvzpN7MW3Mw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAf8m5Ms5zkEgxrSBQQWX6KXtnGICFybyHdgnRf4ZmiA&oe=6AF0A612"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
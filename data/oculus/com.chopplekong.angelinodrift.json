culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPwgs536e1MQ7kNvwHfl4Pc&_nc_oc=Adoab9MkUdo0SNQpedEmNp1VdV3rXDeLmlHhYsQScUjt8MLZrv_zg7no-xdIVneIuU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYOGsDWPhAYfKXPUGHWoCgcZL42gNwQNKJwVI0nsMkjw&oe=6A4FB1AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf61IyPA_1YQ7kNvwG0gT-q&_nc_oc=Adoyn5E40r-TPrfhrY5cLIRk6sN2PPio5v6UREmE7glzmgw7o-C5BUodIhzAsyKDfGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDN40FlKwr_KakDilzSaIwUnBmyqtKyxw2I1oQ0MEABg&oe=6A4FB11D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz1wo2_8yKgQ7kNvwFHB0GD&_nc_oc=AdoiX-_5VNP-0H2ffwZRvuDpVdStLkM49JOBirq_eBmJenAfjOvkTvxIHS7UaUmYTR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2UpDhVeQ2S1jWkWRill6cqEPF33F_QbPvh5iKkxH4XA&oe=6A4F922A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeCTsvS_ojcQ7kNvwH_9D4o&_nc_oc=AdpfeToMuM6th3teBK6WzFGqcqt9AgFbWfkTHp-NHFVu5cQHQbN5Ts8JAa7VVEXuqyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7h_lFh1tKyeYPH_HrttR0P-3h1VJM7awGAPn8DDFRjA&oe=6A4FB85D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJGJ87SH5YQ7kNvwG7upWP&_nc_oc=AdpYyx6DuCxHEWJXIyC7fZk8_2--4dbixouf9SmA6uO7pBGs9q5HoeAxqhyGC7-JM4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvY9rZjdCMMnoFUuZOj06xarZ_tUGRLml9rlJ2tgCDEA&oe=6A4F96D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF2dnPAiJLsQ7kNvwH-Mc6r&_nc_oc=AdqBQSvox_Ske_Z8-OF_M1Q2IBJjP6ETEd61l0P5SFO16bdjusMi7RvIagmK_99qP_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-5Trf75WGrRiGfMviSdhpwCFd4e2aJ2ZB9uakPnTm8g&oe=6A734A2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv-nGkTLSHoQ7kNvwHQskvo&_nc_oc=Adq_kj_CNoRk5566q9Vjc40eO-sapsJ3Srr9eBriMggOkCqT5kLvB94IPTFe96HtwXM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0juNdxJnU-7zbIF59Fd37j4zYC4NA2U5qdzWxSiOE8A&oe=6A73499D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWLYn71rXDUQ7kNvwHtRjFx&_nc_oc=AdrTo7yYJUIeecNx4B5sxnPVLh5vg1zFtiqm8X4LkkGvwL8AERBSth78Lk3Bz4u8aho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Sj8c9cC8qL0VTiJ3KG0gxLxDOOxfai5xaHvzHJW36w&oe=6A732AAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XQSu_FCcoMQ7kNvwHTRLth&_nc_oc=AdrtttzgvOexQSAAxkpMhWVBRKAz3Tr31gBnpg5QijRB9MJvfgGFOfHCzzIk6a3Lgak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgy1TqQCvLLzzKP-tAQHN4haZqWOrAeLBnqF_eHJ051w&oe=6A7350DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doCdLdB7ZW0Q7kNvwHY6DmM&_nc_oc=AdpyUBWnWZ4EyfsjWiyevmozULXBjjrPI-n3hXj4XD_LYWNWkSyDA458zAG0_YElpsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBeM8DuxjccOwnYWbGE8A8EuLGJMXj5CPot-s_gy7saQ&oe=6A732F52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
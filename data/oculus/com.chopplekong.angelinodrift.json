culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ_hE6KVOJQQ7kNvwHmyUwz&_nc_oc=AdqGel8jFlPSBK3jTIXdf6LmdJyQ7SCgD4eREoLkjG-f4V3o_Es3rkD_czh6wBZZhfY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UcGIGE86LCpQqKGaMv-7dU-nLJn9jtSqzdAQBJ8DP5w&oe=6A32B0AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn7kPenAD3cQ7kNvwHmX1or&_nc_oc=AdrtxCWvdQLHKLLRzNLPrRq-3zQqRSvAvwyjet_WZ2e9RLI6oGqDz7-01f05orfYdhM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ajuv25iFQqr8Hc458bChqB_l-uFZZvBUn1TeurbJhNQ&oe=6A32B01D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbY74NKPM98Q7kNvwGGzDgc&_nc_oc=AdrAoWmHnOHsztb__60uIPahD78krqvrpbHPzS1TgaO9HjS2dhkzO7wkCNT3YG4YYq4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sHVLeRG9BcNjZ0ORCKDRhIMnBBvlFm7f6bzecPksO9g&oe=6A32C96A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmtXWrFVuUkQ7kNvwF1YxZs&_nc_oc=AdoTAzVZzg2wE7-BvTvsIj1w6AedGmnV82EpBji3EfmEq_M_ugq7Yzb-19g3xsD9FcY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95ikYLrbCAFL7DhJQp3HeMSFOiAJh_XVFpH82GCofdog&oe=6A32B75D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7078qOu-txMQ7kNvwHHW_IX&_nc_oc=AdocmLKGFxNzcyfjIGjqXaBjyO5P5JjEbkL4lhe4kuqsbUMvuWyloDcT3uFcKg2riMc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PgqlQw7O0s1l0yq6oEdA42PKjx8VUruJbp1u9osGMXQ&oe=6A3295D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
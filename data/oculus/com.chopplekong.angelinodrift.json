culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hyjy_rQ4VsoQ7kNvwGzpiAj&_nc_oc=Adp68CkqYVtfeunhlftiSJOupgrViJC5L6FYPp2jIi49w3Ts1zeboRvAVgGWbByZy6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8OWAAYaRCDJ2syg72xorpoHvn_Vh1AZ_1rutZ36Y6rA&oe=6AB3E3AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUnIvD-eTRcQ7kNvwFiUQDG&_nc_oc=AdrC9yBuqpeTBz8unaXuBAFN69IqE0R4CI4uwhDFqbHvHMQGOQBorBoh-HfLR4AiQfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuFAiPcyGGVAYIiSBEaX_-X2GoBw5I-TkhQ8WlJ4ZMSA&oe=6AB3E31D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHSfUlPAT4gQ7kNvwFZUBK-&_nc_oc=AdoLwWm0VHwicGYuiH0DyZey086vG7S6-Q3sJ7FPidMaGGcjUtaSLWmaTAJngIU1RZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU3cKToL_dOT9sQxBqGLGcpSVBzHSlw2V5rdNnl7D-iw&oe=6AB3C42A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ssy3R2dr_ecQ7kNvwEwKTbb&_nc_oc=AdqBbr3U0yUYUcebF8mW8EHZNFAvZsB1p3ygsQ4aKywmzFyhhgGaZqdKY5p6u5vDma4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjRQynM0Gf2TmSmCNC0hP4Sz0uUYJ3wxfowjAFGBM0Ww&oe=6AB3EA5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE0xbH20rCEQ7kNvwF14ssD&_nc_oc=Adpz_YYDFjvY_4_laeicAkPIPa_Bwd5HioMMFyRbjFTkIQ_39RgoXwRzxuPUIpi9LI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcGRT0S0Sq0cPBvLQxh_15k8eQ89RCxSSv3WkrVX8c1g&oe=6AB3C8D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
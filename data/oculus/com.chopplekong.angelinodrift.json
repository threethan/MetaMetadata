culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbkylqc42KcQ7kNvwHczV4s&_nc_oc=AdqCZzmUxDAmSUUaaTRJzVnyD4qJYQpi52x3IqeA5yvHiui4hAVg-n5UiaIho4fLHuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEu8DI5LHP4lK8BnJ4q_OLfKAdnUgUwyTnIF9m94bWzQ&oe=6AF7202B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICzC9QPQ0FoQ7kNvwHBgdXg&_nc_oc=Adqqe3FGIlv8Rm0S8l5tUbqn4_szzhgNo_ylbvCdrAMH4NpyhcaBG5s6S_d9DUWADko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTedF1st0dKiS9frmsv0gglvmfqIibYdczcJpUzsk8U0w&oe=6AF71F9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOWhFGFtDl8Q7kNvwE3dtRH&_nc_oc=AdrLyhQL6LrhnS6rsyffvBPjFMC0HVUKmyCzGw8yB1FQ9IAfw_9-mo9jysvDd4ake3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwL5HAQ7_eRqCEU1uKn_jYRmLLHYBEAwB4kgN7azYavQ&oe=6AF738EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kkmi1LqEfEQ7kNvwF3LKFW&_nc_oc=Adq-VTHOvrNRM8ndGk3dsOrGEwM1oZPHsl5qVeAjf0kSlgbdlyI6iK159ct93EOrguE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkzLzwbWq0dRnzmKMygwz64M7M-wHVumy_sdDhN380mA&oe=6AF726DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fg0ow3ddUQQ7kNvwEbaXv2&_nc_oc=AdrpRY0lqKJdc_pqzgVOupqPRPyyVRwpBFKTjelNNLgEre3vkOGkVS2dVPRlSg0mru8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMEA-it3lx2Bvi3hfY1gTGUobqdDJei928u7FiYwFg4g&oe=6AF73D92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
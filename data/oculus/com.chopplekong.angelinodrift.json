culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lhPAnSbnAwQ7kNvwFIHsLX&_nc_oc=AdqZaWs8zIcrxXGFDXlwyxnfg7BYuOkddzN0vLsADp_j9_9ad6vtABNPO-SgLiuKncI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2onafJcT0ZkjlsLYpRvokhxsfnGevsiA2XIK-GkVR-Q&oe=6A7B332B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TemaaYwozBcQ7kNvwFmJE4-&_nc_oc=Adpgx1pCK_zRtdaQ-LsyQL8YKWfJZwCJqG-CocNS6bZ9P1GK57MvFU39yZ4My_2yETI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6heXiI8krNQwIAbh5umCc45o6uPpQm1YiFiyjf6-Fjw&oe=6A7B329D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1xHRc2H6dUQ7kNvwFI89dj&_nc_oc=AdpbkD4xT39mGEWDsyD2IYMazuQWQ7VoZrmUDuTEB6-H3gRp3pn-SeGNqKHXrY3H1sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBMw18dAp1NtlM8bcZS33LFX_Q3HeujYOkzGuWst8WGQ&oe=6A7B13AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpLJCtKSUE4Q7kNvwGxVVoX&_nc_oc=AdoaaEDzRWsrurhSi5bI29-Z91pOJe6DHAuynBsOU09JKmUnIS9tXdOPj-LFaLzo60g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB4DilAqH2vM5_f00BZgcyDkHU-kjZgr4H73zPKlycfw&oe=6A7B39DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07UoYW1qOgcQ7kNvwE2draT&_nc_oc=AdoJ0vMcbKMMdFQQTZ8vCQF7G3IkF8hmSdlRDdUxny9qZbzRCgFPJs0fXJ6PWia13Mc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHhoxf6cF53tPn2XgHscx-2m9wayecvd1E0khpxUBcww&oe=6A7B1852"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
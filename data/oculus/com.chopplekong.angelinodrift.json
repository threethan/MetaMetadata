culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCw6qxvlW50Q7kNvwEZuNNJ&_nc_oc=AdqRaXwMDB5tqQvdrn_nnP6sc-Z8__YEjLom5O3FDgPiEXTmHTSCmJnKs7vfkbCY1Xk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvLWLSjHa0ARQNuZtSjbKe4_2VaRKHmqtw6i_IB5YQJg&oe=6A5F83AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Wb2CRCQ_qEQ7kNvwHeDWZd&_nc_oc=AdqIQJAcvsDTKn8J6nD4ZfCO60gDxST-7ryJoUHZyT9hqlqVqWQKfAtpL0mHY2_-FeY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYT2J82C5WeXnoVoCcSNY8U80FAyB89xyaG5lCnRiPfA&oe=6A5F831D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTZtpCOv60sQ7kNvwE7yPVp&_nc_oc=AdpeqTTEPwwBfLpI7hURtfXKmHvYtECML6Wi-XniISZjXAUrIAZX8mr9qLORyi5OHLE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBmF9KfX8wM3D-qEg7HfYW71rcNpom-U-qVsjF1yZArA&oe=6A5F642A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IrVPELjdjAQ7kNvwEgc-kv&_nc_oc=AdrXj_d17cL-9KGAB680GHI5ADSQUpAIJrHNk36cvilqIbqlwnxFZBeJ6Fb-oMqrkpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPMG4srQ-xHKJNJhIG8JQEP2PwtYD9mrvdiV2t1ExwUA&oe=6A5F8A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybAxq51784EQ7kNvwEagXKB&_nc_oc=Adr7EEqSZD0EnW9PtaPQV1tcZSfyIawbSVO5vVT1Mf0Ua1tfrf8GgYiB_ontLcuwYio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaLZhPmbPRj1NVAvpot8t5yhXgy0WyXYUckvP-00buRw&oe=6A5F68D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiwW4k-wYW4Q7kNvwFwMbJU&_nc_oc=AdpsNpuZjL2fXSnLEP25xj_cw0jln8xX7PIpLJA8W_arxk2lJ2Xivcq_BLKDbnbgZWg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO2GP0Z9FTgC2_3vEjic9UrTafLCwztPPTJ7NA3zlLoA&oe=6AA411AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I89oJTTfNIQ7kNvwH05kju&_nc_oc=AdpZF_DcxLLBv_ZXqm1FJhx1GbJBpR1LrTt0zCqDWFoTKCE5T_fEW_uYpC-bgPuAVuA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg6kbuGiDYk2_R39w-1aky88_6fT-_4KJkYtpAB_9AxQ&oe=6AA4111D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeX8E0jHP50Q7kNvwGLIyte&_nc_oc=AdqOHCBGcIzlEI5DmpUrNSZ4vG4kX79tUwVtWBA6NXSmHdNxMUxyY9_H06HkmMD7Ses&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIliQIdcekdA9rpcVlxO0uHFp5q5Yh0ZkcyrKH722GEhQ&oe=6AA3F22A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_r52zZVvUQQ7kNvwFNaGom&_nc_oc=Adprb8Hus3UYKhkkhsnu8xq5jczTQOFWYqSqPP-sOI0D_SsZH4CoaxR9W_Ez_cr-t34&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaZpl3MryNPs7kzzrypicn2C5yvdRyh9ujZEOK4zTNsQ&oe=6AA4185D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nj2JpZUJ1wQ7kNvwHuYJbQ&_nc_oc=AdoV1SERCv8rXUXrvj4JsaWQGfruk-3hHQBN67NIREX1R9L2VkjcGq1Yz5zl66ixeQM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTF7AJzU7ZiK0ThPyYUIvYNaBrrkqZmlKs6lRWbhFhCA&oe=6AA3F6D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
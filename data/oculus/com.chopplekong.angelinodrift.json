culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWu-iP0PWnYQ7kNvwHoGL7G&_nc_oc=AdqHOshl1DQboEwx-_i-UVzhbhAn8UvuJjW-konl9L5wSGREuAz1KCimGHy4eWVhX2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIizSmKhNcID3XVL6xq86xLCT0qh-HnvfccPydi4OMtNQ&oe=6AA16EAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-PbsyeC5AIQ7kNvwEvCnwn&_nc_oc=AdpvCzK05mVbBsYtdh-B6-teDgzUgfFLkUWhTm7spmyz7FWhIURVIuYGuJj5AFWtPDI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCmxXOO6MUhD8wn720gHum031fVeG7Z2vxtPBfti8dRA&oe=6AA16E1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeX8E0jHP50Q7kNvwHEW1Mz&_nc_oc=Ado3sVujj3UPkDgQkNzn8dI6SeaqmHVXWt8njXMI7zUjGKj4A1BYS4zAhXIIVxS4ROc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp9VEphdlXmnkqnDeAUCti06H-otCQC0jSa0EYtgOM0A&oe=6AA14F2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuncJwYAZFgQ7kNvwFO1YMr&_nc_oc=AdrKo-s4x2p_s_QpGycz4mzJ3ZEopYF2yBxt-2kMMifkMrMG4weH33SW3Lviz5vq8M4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDjrD_yaQ_Kct7e2t19bn5O8z3ZQ2cSUm3jSrZVmhKVg&oe=6AA1755D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nj2JpZUJ1wQ7kNvwGeBAzE&_nc_oc=AdpSmyyb8eEAc9cFRF44kqlYSEXGdPdoq3bRf0InQWf6AnQ19CZ0GpaWU_M5srvmnak&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPs_hbmECUx55DG98c_nT5uH_i_kdecYZjip5c3fq-UA&oe=6AA153D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
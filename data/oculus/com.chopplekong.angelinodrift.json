culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DYiGShTblIQ7kNvwEvguUP&_nc_oc=Adp4RxCedY6d6jEeZ7wzoY9Fgu6jlF27RIzfMaMDzvYmUtWE9VDIIpTr7gftWrdCir0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIzV490u3C44EqOZRRN7-WnqWcuBsoMkT4y4cvTNrh_Q&oe=6AAAA92B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLhFIThGsDcQ7kNvwFbGZpa&_nc_oc=AdoQLfJ5xmVIrSuM7CCDstwDGnJa6kn8xVT2sygC_Hjx1dMhkQZVYyiNtYGQ6c4BWwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImGOANR5PzaU9-x30HXPYFYGU5905MspztCTze3YFgxg&oe=6AAAA89D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ecXpfXYO8UQ7kNvwG7fq0O&_nc_oc=AdoyiskraP4RRhlPz3blnWmcuC1bSfeaEeER8jEw8mOnRCG9BAjPazhqHIwwqriwn7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAV1JmCgcHy8eJIWZyvzT5Ayls7XD9qlHvideYZAX7Ng&oe=6AAA89AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzUhxxUdft8Q7kNvwGZiKcP&_nc_oc=Adr7W_HJnELq7h97A_xxcQIx_H8al0O9dbrLIBTm1TzvuS-zIxDJIaSpn1Z6imYN7vM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2J1ONhStCY3qDflRmhLAXWz_FZnudzH-DmN60mZA52w&oe=6AAAAFDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wrYlUvf7o8Q7kNvwGc0_Lv&_nc_oc=AdqWR83dIOUty7-NhH7YQLP0FP6QI_ZIMNGbh6xwJmNJCPDr_ZUCDHVF7g7Sura3DZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXz9_ROvdDb01QP_SKwX6Gqgpmw-XeOD-aXIiGMGDhDw&oe=6AAA8E52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaj-sOsb5DkQ7kNvwGb1jzo&_nc_oc=AdoogzWQRQQ77M22LizAvE1Gw-Oc3DiDfmHCLAWLeiDFQG8C_yNcSn11N9jWlUH0RxU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70kV7CgiMJKP_BmOCQ3wq-QP5SPoIClLTzygR6q6LZHQ&oe=6A1069AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9otJX12MgcQ7kNvwHdic0G&_nc_oc=AdpRzAEX216AsqhDEC4Rtj6nATWJrz-fIRBG6Xm9O-5kT-LDqgk0FbSgphQkug-5mq0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uaxamzt2DBYHwcjK5-dzwCRHeqXp4ku1GlZRtq41xLQ&oe=6A10691D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pIZvU5OrCMQ7kNvwH0RD_R&_nc_oc=AdqL0gyDfNkcfSV5QxJqemsdKCpmPFBB5-ZMXzbhiBt9vV1svFVIBaiSgrbKodHsAOg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KSLZGoTDTFIWYX9Cgj9Xvms6IluzUE_B633Lqx7Pg0g&oe=6A104A2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2M_l7pFkxYQ7kNvwGaetZ4&_nc_oc=AdpezAaDm28WLogyQRtfOu3oNvBSCvvlDQkh2cZ26bzAeFlR0XfVKqeBPVUGVDmBU2k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_leMm47_5UmLkJn-eqHUFnyg-yWnhLIlVoX-SdjNuqQ&oe=6A10705D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIiT9tfX8mkQ7kNvwF59g4_&_nc_oc=AdpqeRD9Kq_hWRYv9lXczU26e3VZg5Tl3nC8nEJiF6vaDpq2hafjoYK6Oe3gN6Fz4lE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RtgJVyrsHymVYBKHaTK0H4CE7Z8k_5tizd_6ILzFk-g&oe=6A104ED2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
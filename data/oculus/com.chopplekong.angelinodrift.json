culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVkM6kPCP0UQ7kNvwG0ArqO&_nc_oc=AdoMd5gmLSpI87GjvjPvC6qLFx_TAuVzao6pqkiJEHI3UqjMWc-HAkzIvJViRbMNhyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEjeQl-XMsaQvHmlsvPskRXMAfhGvaFVWpqAr32aV4AA&oe=6AF32BAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atf2gGxamk8Q7kNvwGnqMq_&_nc_oc=AdoH1MEx0kKuKt0YCB4DobNBTA_YyNh2gqy0CkbHyNx7L7r-QDTrDXWpta9vmzbzF-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXQXQZWA1Mv2d5YcXX_ewYQrVVRFYhhRTlfMtJSXDn0w&oe=6AF32B1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6o7WpTeAQMQ7kNvwGMaNJ7&_nc_oc=Adqerzq-PsFx1lSN4VVD1FXu0i7AxEkht6rFkXOd24Ca7A6r8zjBxZPF3DZrzmBpYPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoXGSlYmJvWf0MbeCiByMh1lkfTHIDSDZRY_-tPHaOlQ&oe=6AF3446A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_FHr2NXs30Q7kNvwEOCn6h&_nc_oc=AdqZ-v3IMlIAPLzit4jwHALE_n-sdem8rQ94XKGqAotVn7_ZYCuge6WpQmRmzcMTB24&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcrKm9imIu0OYVV93IeJcvNu2syvxBdxhRW36Dxn5F8A&oe=6AF3325D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oJ6S8OaQu8Q7kNvwG27UAw&_nc_oc=Adp03_vVKTG4YRykPbtgqPEGU8CIGirHCsH1kitaYI9PnCakI49m1rryxJ75YB0bUeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa_NwXSpxxZ1EYKApaT1nTEkIAQBOTdEqW_YK30gCOVw&oe=6AF34912"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
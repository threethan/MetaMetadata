culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVkM6kPCP0UQ7kNvwFd5nNd&_nc_oc=AdojMMAcBe6tK4bxzZgJZgthcctd6kjx9WZJ2VZ-U8jO2UgK4l2-Fh-fVcrpXrsPV6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRUeMfYb6tokSqUYez0yGK8GqUbeUKbu6uPdAe9-jtsA&oe=6AF47D2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atf2gGxamk8Q7kNvwFbLuvt&_nc_oc=AdqnE5zHW5EBt6E2aPwvYhOtP0dLWnh1lDr1YD4wQqT6oo1V8UWTXUnkTptGxqRK0BY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3mR-c26ZKhSBkdsBqLvsqKKDs-3NKMh4mB8IAlCmiSQ&oe=6AF47C9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOWhFGFtDl8Q7kNvwGCGPLo&_nc_oc=Adp9yXkHYBmeC0F3UD1MXUUKIpTupN__mHa0Zun4lJJtr_aWMfB3gMxreT_Rc5oiQvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVg7nZKOWD00_yGeqbqucIHaad-GatvbmQoXWnTxx_rQ&oe=6AF495EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_FHr2NXs30Q7kNvwHxhgTC&_nc_oc=Adp5wvtICrV2Zj448jN1kjl2ZhESTbWX0XnZboQz0g5Lv_X2m_gEyCmzQFuV7oCVhoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDCkNYsWcFVE7jJ8Pnuw48zqOj6ooOFZjl7EaC0fXAAw&oe=6AF483DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fg0ow3ddUQQ7kNvwFuPbNp&_nc_oc=AdrC2ZIvCWoE2WzoDZU6Lp1PLam3cboCAWvOtHwDzwuC-MKd2bC19iDpxgfMc2BaMGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqmtYosvrAQx8X6ugDmKjeMqk72Xr5UR8slcruo0o21g&oe=6AF49A92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
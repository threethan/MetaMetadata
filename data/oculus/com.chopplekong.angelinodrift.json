culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjUSDjPxW7YQ7kNvwF1blu4&_nc_oc=AdqqyUleXy_0jSXmTk1G-prEg-nslLeXX3ouxqlzdAyX7KXd2t1pNiCxxsFopMI4N7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6jE6SD4M43QkFG-7Q-4COzMPj8-5f3uXWgYwF2Ow9BA&oe=6A6F55AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt06bQbzyIoQ7kNvwEkMXHM&_nc_oc=AdomxB_dhZ3TiuuWmcWI1zVllya_3KKskyI_ZdTtwE3htoGf5i7jaweioO9ssublJPA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXewtJJW08Vy9rA_26o2oNyDH9ngb5SPoy2EloFQ_R7w&oe=6A6F551D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSvafr64JdgQ7kNvwGxCOCf&_nc_oc=AdqvCLWhhVpMzBlSiZZgb_8wRGRBRwJ3Ys9V7jXxzTHwTibc1BNvNuu3AdFawwFPL7A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWflo26UKvyD4aN0-8N1CEQ4GZY6dCtDlgb9QG8AOeBw&oe=6A6F362A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCIP9N4E0CMQ7kNvwFy9SmH&_nc_oc=Ado6iEfw7aetyx0oT77V3npkwsg1xVE5D8eG8GzKe9ImBZWby_YiAnXybuAv5-SfAyk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbG9c3rP3kSJxFFv3_tPLMw-eEGqAWcZ4dFaRsAoAWwQ&oe=6A6F5C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNvCJ3bbyugQ7kNvwGLp4Uf&_nc_oc=AdoaCWyFzc9QMZ-xbQlyaqjwvJUEOkOIpHBqb9KmHsSZwKRgeWJXtETzK297yIlber0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnUD94JyTHIgqJvNFU5EBvrjKmvsby1kZuAx79invsZw&oe=6A6F3AD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
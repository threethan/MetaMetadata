culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwFDXCNGg70Q7kNvwFDkldZ&_nc_oc=AdrMt6yRJZ9PSY24Lleti1mYCvoT2bxNnv6u863yz98pTks4JwZp-I8jExKvnSJpB04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lhMnvb6R_vBE_cBxflwZvxQbCiTTHKGYBoh_CXLrKWA&oe=6A0C752B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IooNjtQ-iRcQ7kNvwEIIUxK&_nc_oc=AdrDlxezS7NBgHo_QMW3_HwEPGrgipO2aoQOO6O9zWiKNNQqtfra_AV-Vh7_SDTlM4I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aqdy94FmRZ53nMYPJnbHJrToowx3FvnbxV7SdC4J6bw&oe=6A0C749D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMUh2lSwCkIQ7kNvwGnN9KC&_nc_oc=AdpyBnFgojxA_Y1kGlqWxDJXIumEkhKv4SaRK3hDuAE8NynScbWZ7NAEu7vC9OPddWQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tqETtPeclTQ2UP6vnUjoEK5yJFdmWl_pkFPnKtzRc0w&oe=6A0C55AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGCjkqaBdSIQ7kNvwHPSxz6&_nc_oc=Adr4hcOVoDSbZeQxunq5wnKO1kpGasqZKQsPD0y4WbEt7_GIGP2HTSbmoM69AHkZ7_E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CgilhDfCSr6_Y8ggtox7k2p2vORGY5b_OL0lF4eqhNA&oe=6A0C7BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-N9lJwq2Z4Q7kNvwGHo_iH&_nc_oc=AdqvKhF_HyN-WnY--WOF2bRKgNCiSJUn1_iko90pWUbTaV6szgIw5tWq6KpLX96CToo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t7df7cJYaAEqRAwF95yhjqB0Tk7MrvrSlvjt3iVwXPQ&oe=6A0C5A52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMZOYvzKkgsQ7kNvwFbycz6&_nc_oc=AdrvNhV1Yc2ofSwdtE3DFC0o6f1i3iORdip9hLBMEX_BBALvNBZ5hFjlMHxUL5vdb04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8X2wN1DQhB4qXflxhXRSzXaB2MhKHSeX7a0nzAc12YQ&oe=6A8C1E6B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6BfWTsggN0Q7kNvwHzp-kp&_nc_oc=AdrRmqwGdu5vaRqe-4yj6u36meBBbukWuhhoTSya0GrRWGRUkORYldhPy07AQPLjBbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkcNKa5kaIPWJyDZ2zevWYnrXtkLQZziLhzGgGaTwCJQ&oe=6A8C1DDD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlkvYU5SWjQQ7kNvwF0l1kx&_nc_oc=AdqU2SqVYwZJKhhqEuHyUoXJVDua41eQhRwQzKQ9jgs28SeIMN9eTJcNeaHvPqDullk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhQ68GA25TF9O7Oi5S23VxCAei3idHsQk7mgcKJC3WjQ&oe=6A8C372A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbOSVEMmbxMQ7kNvwFWbwMq&_nc_oc=AdoGwflv09EK6B225SbFMNo6QG92GmK5o0ObKmXW7bMqK9dAS6W48oETSNGftVILCV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLRxOsXzzzUpxPrFDTgNE0aq6N6Shl6oF1uquDrSsz2A&oe=6A8C251D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bz3G7A0FWc4Q7kNvwEY0MNB&_nc_oc=AdrNadjSu6m77cGNK1KjOU-dnGwq6N5wKRRolysxs19KG72gJxnjyYSUTdxVJCpZJu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4oJRlmh0Kel9o_4Dyet93NljLP7QSNcHSrvn73s02EA&oe=6A8C3BD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
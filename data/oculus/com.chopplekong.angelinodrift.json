culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lUuEEihCRwQ7kNvwGoGqtp&_nc_oc=AdroWGpO7KFVB1hJtl3CaT6Zk8QHCGwUuV12Z34RppiqF5QRu5o1crPxa_g2yBoHRgo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmLwyh0PVGCfuBm8B2YbONUg-eY2111S8m87p9AX7_3A&oe=6AC5072B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwG0vGEsCtEQ7kNvwEZrI4_&_nc_oc=AdpLai7QFXlHaw39K4yf3JHjSsb3H3E0lmtZ33Cb9riOb4m_YotRPn7vrBSai03u2oc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBJB3F30XUoyhrEG2opgVpoobXJNZytWcARyIH2skUIg&oe=6AC5069D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MoTtqMawYcQ7kNvwEmatKZ&_nc_oc=Adp6YKSiOXyWisaQ0TuOE-KC-bAyFmmqU889sONKBKT-QK8Hh72F1YWCdr3IfnDy094&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcjqOE00jKAmAH3JtOiNQ_2MsmZaJt1x4FJl7LjFhADQ&oe=6AC51FEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuxCMj12agwQ7kNvwFdqsmc&_nc_oc=AdoukIhZuhtwUm7tI3ly1msBenJx-9AQsR2POn3YKOsWIZnDZMSefSrXg7UWI4Ev68I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWq_iG95nGqHP3V8TWdrpiLgECxJlmMwp2UApNOqwSRw&oe=6AC50DDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMouL3XhcxAQ7kNvwE3y8oa&_nc_oc=AdqgKIeNLPIq8Vghgo0VGV_NZXL7mM-5_o-bVLpotuBicjQJwT7T37XVc5xF2ko_PnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd-bV8LjjnVaKUnyOBFnywsI2Nxn27Z-u-fwbONP6Gqg&oe=6AC52492"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lhPAnSbnAwQ7kNvwF68YEv&_nc_oc=Adp0QiOlW6pkxQDY4b-t6iJ9D7Kl-zvNnSz86WJpkX-KEYYID2BFzVsXBWHnbCfJ9P0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0j_Xx1wYe0gqc-PCKIPzZimIc-TSyRuO8iz17TNlvJw&oe=6A78902B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vv3Q21VPJwwQ7kNvwEWNB64&_nc_oc=AdqYVGdNzlk4WSAdydCR_62sPAzTuSgfPzsuECfiCizVRra7z8v-PyPRNBjSUk5f1PU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH67mBnKwrBFPQazizC0q5CcJ-0b_rAzVeTZ30IRlv6Lw&oe=6A788F9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUc4WD_J4k4Q7kNvwFYy3va&_nc_oc=AdpHV27dfLnYrzwhnvbUFuBTKesOe39AbKn6KvIOARxSKWR4rJZTO86UeEFvDBHd2vQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE078XhayKhbjBpepx-CfhVEmDov7gVgz7VRPWBjiyn0g&oe=6A7870AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpLJCtKSUE4Q7kNvwHa4e_P&_nc_oc=AdoK8cT8h0KzCv4fw21PljdfshwjCaePv47kmsC3aOlNZutkvqadAUNmfqfzAcjFCPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2_aBQJtJWyUAl2f8iBtPER2kaEcIoEeVqX9Y6hyYBew&oe=6A785E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMr2eRgiRQYQ7kNvwFe_SSa&_nc_oc=Adq1e1yy2tdKmYcYq0xSNOIy50Fl4J_Leo0P2THLU3bkB5U4AriCyUcE-Yxzk5nDi9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI4JfWDvAUjgE5-_Ez5NFtWYIMH7RwYIW4lDWNGcB43w&oe=6A787552"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnAGpmAs938Q7kNvwH1kt4I&_nc_oc=AdoXZ2axEPCBWLXfBXYUhni_PHWot-4LTyLQvZA0iIP6eJCp8up26I7nVKh69YPeuzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8raYXPc-Qn9IdA7RcothbZHczUvhXdyqulMPpMFV_9Q&oe=6ABBCCAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LSyFmL3RZ4Q7kNvwGmtTCb&_nc_oc=AdqFLhsX5EFbXHOLg_TCEv1jWVXq1kMxSTwIXgvTZuHwVY7Z4MRZ67UjRyHIcu6HEnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS68K1G473M6cQL6tU6zkrhQ9PBEsrFR3OPrbs6rxrzg&oe=6ABBCC1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buhIeMYm1nYQ7kNvwGUM8cC&_nc_oc=AdqfZU5ilKZjPNvpYR_aUMT_wmvTHknZiKIkoO5ISbTwqVC2s1yIWoH1w4gvtBWKW84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRs8oGHYNqotXPEsOmiXTxQNLyG4HZ8wpPiHLkJccNGg&oe=6ABBAD2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFNNpCDDKHIQ7kNvwGGaVv-&_nc_oc=AdobJLqnVp8bt59qKPiuTQA7sX9HbaB_kOvbD5QxFaSf9vP24CMRZH9-rBQWKM20Ru4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUvc5wxg12gS1JUsDK6RIPWYtoqN5ia6hxxU3fANoP_A&oe=6ABBD35D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfoKOZE4zhEQ7kNvwE0Dp2o&_nc_oc=AdqXBAqhArlXg9DvfFoGiDr-vZy8yIL1XOoGHY4mKyW3WyRH93y4SMxcGFLFzIHjKdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoOgZ0Marv4pZcPaBNSn-3pfrwPaUOotdyJ87svqxJVA&oe=6ABBB1D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ_hE6KVOJQQ7kNvwG6bX6q&_nc_oc=AdoAZ9C2kf_4Q5CR5vv5G3jD5uu5x52DzMV37GbKoNRMxLheamJHuy56Ceyq5mx01jQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MzVpsLV5ZKho62NdYYIHb5HMNiXB6S7Q_C6tkjsUElg&oe=6A315F2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn7kPenAD3cQ7kNvwEEGtui&_nc_oc=AdrPRoZ6mSUBUjFNg4A2NcpcRh6XXpftFgi9lr2Lg5GLZUeEWCxt8bL6_bcBOpxo9uk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W3RqOY0-Adx0tvXXDWu9YmF-eFmv49M_ClQzDhSWVtA&oe=6A315E9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCEiemkRxo4Q7kNvwEnq-Hq&_nc_oc=AdoK4zw1Gs020LiGe7gM9q-bRxzaRsiqxrdkdLVnk0Nh5rrxtfm5clmUcCntQi1TC1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SX2kelzEwEOVXL9nAevE3JdM-455Du4q6o4SkCc9qKQ&oe=6A3177EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmtXWrFVuUkQ7kNvwE65L_v&_nc_oc=AdrOzT9UzOobTsWxRXZNYb74BPiw3JIngjvNdUC4SkcRxBEeFGJowE93HCGvePD0Uds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ucfopGdoPyLCPdBGJQq8XMU9JP42JBq67a34BNADrZw&oe=6A3165DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItcdOOrfuEcQ7kNvwFCgjLY&_nc_oc=AdrfEPRjD7ts-P3F-vE8qMxGAq1KXp7JSMpM1c5AxdZpKnc1AHgl68YsB1eHOxzIwt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mqh4Fd3lLhAlRNX44V9aOS4T5bQVG9Cvz-Pym3l7jqQ&oe=6A314452"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
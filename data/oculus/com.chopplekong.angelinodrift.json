culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiVKInRPqv0Q7kNvwHAI27s&_nc_oc=AdpV4u7ZzbUQ8D9eFjL9hE320tmL-wXt0moxCgDRxw1TIQCe-3zY0lhs28w6DBvfejE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3XIBZdu30kOdluh9HblH_JQfHk7kpqeXKI8LK7b5VJQ&oe=6A51032B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf61IyPA_1YQ7kNvwGyzXVz&_nc_oc=AdoO3nk4Bm5b_Rq95tJZwGLrTbLM2GxH8HDZfKWQdwFujhLq9bWoSDyOpRAObjdiv1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvNW8jhMir0Znd4ytxKZtJFxxkrQ40NY9mXTSDngTkPw&oe=6A51029D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz1wo2_8yKgQ7kNvwF7vWVM&_nc_oc=AdpQQSiQH_KE88CnWjudeAuoRxefsD7YRN7KOUKgzituaV3Nj78sZZed9U8jbIkrZPM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBinnS1mSljtfdeB9egM0ew81l-dPbghYZyKrWPsMUB2g&oe=6A50E3AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty-0vp5ta68Q7kNvwEyflxK&_nc_oc=AdpADFbI_Sss5nI8eckMLv2Sj8wFsOtIu_PpVvCuaDUUwBEEkAMr0t-8NGh0y26k7yw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdVGlcvVC8wWRGwl0jKuMt9KHoyRdiXO_L0NFnb0srow&oe=6A5109DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsJGJ87SH5YQ7kNvwHQg3My&_nc_oc=AdoBy_u_fJTdL3mNOzHRGQamTze4l8NfKBqkonxG6Z-70BO9CncxVueYUDEH8HWekbg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBp1mlJpIoW4Oh6P40l7T_CLPN47T-IEQJvCBaYdxbSw&oe=6A50E852"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
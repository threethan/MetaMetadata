culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29uCVb153BMQ7kNvwEQpZm1&_nc_oc=AdoT1f5x8bZZirWEDFhmOWN8PNTrZ_9vzFzwvoqyCfkvMa6dZHHcFLlV31Eaun-II48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB0zZc4mecdrq6Pe5RIIPaGM67bwT1BAx7gtt5ZjjsMQ&oe=6A491A2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D4YMkWdO3EQ7kNvwG-s-E8&_nc_oc=Adr_EZmzbjr8nRerzp9IN3TJdKSfR_zG1slnykV9QryKjGj5M3NskVT2WU9GWUtxir4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe_xyIeW7CTdCLDKe5Ms-cH458cYWsXV6zIQsb5B17LA&oe=6A49199D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgfTY94xBpwQ7kNvwFmckTK&_nc_oc=Adr0KfZKfEfGSPfdSDHJLfodDpYsZpsvbLdzJlf3A0J3y_t92DoqnqewRxWPyrhBfvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_BTRkqVwjwyrr2mJ4y10mJi2HcqfCX9INWo8qEtF9LA&oe=6A4932EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWT7M98pzCUQ7kNvwEleORE&_nc_oc=AdphGEThg5tz7jPrAbctI96nAC2cnm98ntzB2HVey7PyHJJbxFJdBbq7Ovo9RI21ifg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHaMIkNOzzS8gdxA1ijST6su5nveGDQ9Kbm6zRDiOhWQ&oe=6A4920DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqeYTcTSJ58Q7kNvwE6lAXJ&_nc_oc=Ado3IDL5h-N_YJHasn506UEUXn7LnelCOsVnEuIAUv3LAGiFXZD-SJxugXNHIIxOv3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYa0p4j3T8g497HUEOyhYJGGXtmLIWTeft3FL-e1JuIA&oe=6A48FF52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
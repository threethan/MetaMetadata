culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOYLIzzc1pIQ7kNvwFTpMOm&_nc_oc=AdprZkV6kO7lkAsADlL5EOcl5haUv1KDV_S6a3Ee3iEphF29CNDGzDZoLSBnCApKF5M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ktXkVGTlipDy4HepYPEchuu8IhitMVQXLd32J0CRrbg&oe=6A3D3CAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT5Uvntkuf4Q7kNvwFlK8RI&_nc_oc=AdrrjUUqXnKPNrWKCptbD6H98h_YnsDwxYf2E9buc-G8ZUvY0noTHVZu9rwwgn19Obs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kSTxUlN6T1TDoo_bUIWtE40eaITA781S4IAJQMs-o6g&oe=6A3D3C1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEe9-jKdtTcQ7kNvwEIpUuF&_nc_oc=AdpL5UhXQ4wiVvh7XieVIbDZPsO2GuKdGJnX-Smj_tErMLjB9qqvtZHE1TmN1LwXaJw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X2ZpYFFhIGJxkvL1jWdrdgIGtOjB4d9LGa5xjwSgoEQ&oe=6A3D556A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_5LTD7ySp8Q7kNvwGwmaWd&_nc_oc=AdqAu5AWMxAe21XHYFmMSnspHzveYJm18H3_U-_1nYvI18gyHI1Vy0WKVluSFSqDwUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__z4wOT2ECl6BfoaT7ISTHhQXlwKEQEbabPtPzgCVbLA&oe=6A3D435D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMa-F654M6sQ7kNvwEarfr7&_nc_oc=AdqCXwM32u4MHNtnPGpkbB4krHkjzP4Dqu0W_8ONOodlAV10j3wAvjzJQwsmbDEl6JE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__d5EsW6RV_dd-wD-KciRy5R21qGsSlyri1X58p0M9Rg&oe=6A3D5A12"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
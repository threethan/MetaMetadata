culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fMojb-8yAEQ7kNvwFc6t7v&_nc_oc=AdrxUSoC2TgN7dVGtqAaGtvnsiKsNRxK6KF2DEFzXTNSH_1CyWQDpcrdJfuTpYwLPlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8KB5785fxSwPbI9dp_lT4onsLdqCXd8roolqlWrYKww&oe=6A4282AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKx67QxSomEQ7kNvwHBo6k7&_nc_oc=AdpB1a652Kxu-ki5cJ7IJg5QwX6yXC3TzFJfJDn0NTcUKwhvGWHJNRDpsw4J3UZ9NWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jsz8ScNKfIGMGxvftehB9sMG9IhTn1g6wwXT5chcbeg&oe=6A42821D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyvSo7jNaCgQ7kNvwGYV9nN&_nc_oc=AdonUw27Wq-550pDhANPJ9Vfs8aw4MBAN4PamG89Bz2QY7aTS3r6okSvREwOYjozbiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BJrj3ok9G4xP5YiRxoV6Oh5tCtZhNr1_BBzdAJ_1dIw&oe=6A42632A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S0Gl-mf1TgQ7kNvwHVIQxU&_nc_oc=Adq3lwOKGXHLipSlvAcbBuzgtQjCjjl02OxBVlzWamOXoyCZpnvPjo4IbwE_O71puVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5WOXiTU1x5PnDBmXRFBZ0Hn1yxM39UQ7hN8ZnECJ6eA&oe=6A42895D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXev-WQBfG4Q7kNvwEKPAuy&_nc_oc=Adp9IhlTC-AqtX_yOLqQ2sr4ufPmsZwE5L3PdcJtw0FiElpy8TstiO8MABeNCvomvC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nftky2gUCWLU-h6H6ekZ-u8rSVD1A7TAqkuhEmjcoxA&oe=6A4267D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF2dnPAiJLsQ7kNvwGmdNNx&_nc_oc=AdrfnYi9u1JrzKa_vfkvPw3uaY_8gQOQmg_It-ay6n123Yy4Y0ZZi-m8ahNQlapKjHI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyh2XkVztBeY0VGah4B4JwHAEwAk-cApD7hJdt7HuugA&oe=6A71F8AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt06bQbzyIoQ7kNvwHPLddT&_nc_oc=AdoFnk87Ease3Pxfwz3-F4BRUMJn6Z7GTWUYmQMVEqVxcP7gPl9oX_LaYNAEwn92tws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA62Lf4qnQq3IVWn9I3S0T1fOMLtf3pjGEn-Johwlwnw&oe=6A71F81D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWLYn71rXDUQ7kNvwFLpl0y&_nc_oc=AdrBZOyLpDqEcSEfRDK_CfLOoXU_4ScB140yjI6MOJ1xoHfDOOHDm8xI4hpID2urAVQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxgCmbijclSmnoqCyNQErtdHEW5QsIEzo-O0o3HUdR7w&oe=6A71D92A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XQSu_FCcoMQ7kNvwEprncn&_nc_oc=Ado7X5KnCYj4K4rF9WR5Hvm4ezQMeraYgRRAZ-vMIQTQiOtU6x2HBQJqJyHrYbRSSQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjWulsj-Bwu5vxRI86yn5Kcj9k0-EiNU_CgLnzTFQoWg&oe=6A71FF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doCdLdB7ZW0Q7kNvwFr6_iE&_nc_oc=AdoTUaaxSu128hwnnbGgdAy3Wue1QQsJrH5Zg9cGW0aOCwsWEH6Tp0d31kY5VpGo9kI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVLZ78CRpX0ErlVOp7Lb1bPX2-ZY2-zxjeVO5TS09teg&oe=6A71DDD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
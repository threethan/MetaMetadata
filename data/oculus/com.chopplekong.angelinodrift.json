culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt1E0EuAuzEQ7kNvwHPdkSZ&_nc_oc=Adpq9KJgCBQfBq2OcPtMOue9a_7el0wRfjRxwwUJd3k6BbK5b8vMraNN1LT3EY_mwVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDmgRAUmyeGbhiMNmokLp7ck5mRQhMBMEbWh5V0L4DWA&oe=6A60D52B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Wb2CRCQ_qEQ7kNvwHxNhSc&_nc_oc=Adr54-6Wgnl57rHvydTTF1q7LT2fQ9EViX88ZhtpgAK3pMaOybKXo9x6qlVcxHLBXpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLXQGAi3uCcvwU8DJ2RQqZMLwcQINwQhrOlV0Ncci7WQ&oe=6A60D49D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTZtpCOv60sQ7kNvwGhcXhS&_nc_oc=Adpk11jCiJ9ol7JeUzqRqrrJEeqAhVvhd6sNBhGmp4cH2arey5mz2FHlKdU3JrKvt64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh2CUQ4BQjWGAzRLJYTrWPQI6f-G32iMu2oQOwge7u2A&oe=6A60B5AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCcC1ClQa_AQ7kNvwHziM2G&_nc_oc=AdoKHh_LEA_OFuYpxLj3KStAlvSPznnbi37SUc0cCJYm7OSXOv2f7tgn9RHvx1OI0tY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5X-2mbTdZqqa_xyqj16TdtXMSs5e6mgqKNRJ_TifE7Q&oe=6A60A39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybAxq51784EQ7kNvwHM9ZrC&_nc_oc=AdrW3wDqL-jTLbI1ivQahDxA20QVIDlRvqaKNAeIp8Hi-dMN18DSPvChfZYya_B4Wy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwN-lDfOIzBWDPWGiXwVylpmaio9c7v57WPAuNP82PfQ&oe=6A60BA52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
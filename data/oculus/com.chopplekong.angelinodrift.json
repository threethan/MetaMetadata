culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQlCbpaJJQkQ7kNvwGFTyKY&_nc_oc=AdqZqa4ECeWTddkvVmZvGQxtufGUm3mLSpy5-VIAQDS5oliGHOXmQaaVWDuQ8mkBixc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM8e9NcnCE8dFrcw_4UUHuxjG8-xrE_ZxfUpkpDyqwZw&oe=6A75ED2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv-nGkTLSHoQ7kNvwF6jZD0&_nc_oc=Adq43hNWjGQ8oDS0CEKw2UyCER7huVCoOe0oUdXvBRyHQBaAT-JP183_n2gqx7ePKCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeM-7zEsM0hXztxkUXM_X2p-E8WBixduWa857FQ3rtRQ&oe=6A75EC9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUc4WD_J4k4Q7kNvwFe5JUT&_nc_oc=Adr7GtWkJ9UDG38GIDXnn0qMRf8OtDmD6SUGilwlygkvmCsNVbTXhx78UIJcaX2Y3Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSwkRbBG92qy4lpfO0bljy6AAOQivu7u5MKLK6eyxgrw&oe=6A75CDAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD0kop1Weh4Q7kNvwEYRBa3&_nc_oc=AdpWeXuG8rgMK5kfoAikgVWQek8JDjyx9gt1fl5fPg2dmqvqEguZCtiqMCUmlrioUYc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoS8JeCbaOAu4yzEzY5IPFpt32ZY-qdEt3xazSq4J4dw&oe=6A75F3DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMr2eRgiRQYQ7kNvwGi6_2K&_nc_oc=Adp-O18SK3h0KkBnyAtZG--bUD6CGoIBfwTv7cDUpzMG-zroOfPsGOWCTaLmKPa_yRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwdRqohQ36i7w-lRk6SXUl7YvgVAq2Ji2pmCyi3HRgMQ&oe=6A75D252"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
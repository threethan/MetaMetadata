culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR4tHmG-q_kQ7kNvwGyGzhu&_nc_oc=Adr10ZTrwFvCpbCOb88zlsGYmEWY5atX4fiY_1XkSOrNot9yz46f4SGapXPujyTLjQI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X7090xiPZsjLvJEXcc9hjxBXwoBsMwo91_DMYMlIDQQ&oe=6A1AF5AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ3kcVI2fooQ7kNvwHuMNZV&_nc_oc=AdpEGsrbj4cQvF9wEw8sn8mQKBRbgJLJGBOQUpmtLM80yydIefqfrqbx1R6mOL1tbwg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VWmJMElZYlfGuuIlKd3aTu_mMG8RQtszKcQKU8ZK0dQ&oe=6A1AF51D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xl9Oh1c0Q-YQ7kNvwG5o-5n&_nc_oc=AdoP1SzwCUXNcrP2N5r7rnpN-LnKv1tUxkd8A6LKpFUZBNpEc-jll5FJsfiMljt9iaA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4giZtV4-Vj-vzXdybGUwoGl8dm56_kb0nLoqYkmEihjg&oe=6A1AD62A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM4QHD12DzwQ7kNvwGgBESM&_nc_oc=AdqJb33U_ToLdO9X4DZI3IbmJt5yxUJtBK5ORc2PuKILesid37yVTgKMuDq_ClSo3Go&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RZDK4z7uK2nSegKO3VpU_39JFOvYg3cYINW3mnVqtLQ&oe=6A1AFC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxUVsg9feuAQ7kNvwEDzNj1&_nc_oc=AdrkN0Ssq81tcepQndmtZzd2PIe2okyxhys-3JHBGK_0ncQAukiCL8RqCmDwMMcyyEM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o_PdJS8WRI9N_lo4nYq3w0pCbz_k08gp_FZFDSBfpDg&oe=6A1ADAD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
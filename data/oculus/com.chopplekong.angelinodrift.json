culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teJV2Ey13y4Q7kNvwGuYR1q&_nc_oc=Adq41FZxTxGF3TMZTeoN1-nmZCvdKn_g3i5X6SfZ8Ymt3gUv_P2f8i6R5OzIkx1rLcY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MV5iJSO_yF7sVxZ-ta5G3_b-eXfCXVRzqBQtdqz7Opg&oe=6A01E92B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgoDeMaB-jEQ7kNvwFIgOMX&_nc_oc=AdoGVxvxrMytgKIEW3pQvQpZqowiRXqWOOQhUeBD5bC8cK3XIbYMWblBdHUZeHBYSDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BCDEoqneqQ1Xq1U2FO3CJ3XvWVK-CD2W4oPNblW0TkQ&oe=6A01E89D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzg1gKVS6zQQ7kNvwF0TY7c&_nc_oc=AdrH8LCCfLh-FTSYBhVj3brMz4uwF7ztV1YFkI5vJUjpexGeCvKt05vEq4uR1jQTYzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MHpP5aN6quA-EI3f59Z_aOrY7EBkICJVxUS1h4Hsblg&oe=6A01C9AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cm1YCeNCqQQ7kNvwG_WHta&_nc_oc=AdrtZbf2T5pvbtRpir_v_PKS8k9PE378FqJ3w7fI4hMwaCDVxpDQKzzYODFgjVuECOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af570HopOIMcjZqTXFmLSZfHtVZ35qiE3Y37fpw00LY5aQ&oe=6A01EFDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Apa1SoyXsQ7kNvwFHRcNh&_nc_oc=Adrh74IbMlNvQd8yn0tV3T6qjrzy2Fb5OeLNwR7raDhAOjNpX60Jw3mJs3d1HGlDFsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qImJ6dcc3uUFh5skjMwVTveEER6f4p0_8ro1jKxWqAQ&oe=6A01CE52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
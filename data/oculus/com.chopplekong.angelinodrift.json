culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8qzpRHuLjQQ7kNvwGudG5f&_nc_oc=Adq2F0x0E5zVeJfeZeUD1xXcUl2gYFP_gGFkN3wkEhQ93VnyOCK0S8-299FgPSFOy3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNem67yujQ_3iJHyyOM25LYJw5AaVueNTeEN0owGr_V-Q&oe=6AE4AB2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2WAZm_nUU8Q7kNvwGWwD8d&_nc_oc=Adp5sNTU6XsMY1C9MmENHz_ng-GHwL0wa__2429wpzKYlF3PMNJxmZjxTD7ZbQafo14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHUztHx6IhGO8eQhYAx7lwRwK5_lNQVOqgAj2jsAcZjA&oe=6AE4AA9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRgHjBm2oTwQ7kNvwG4qYlB&_nc_oc=AdrXMiOuE42Xe_OgEkRStaPMxhqImjI5llTsml3bMHK4EAfHwjtnONwo_HfAL1A5yb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq2JRb2uAoaw637ws54dSzF_FHOD2BH_yoxMlwftzf-g&oe=6AE48BAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVHjFbtq_1IQ7kNvwFrHENd&_nc_oc=AdrEhQ_K0X0mupzsqM-Kcgog5WET2fmfZWxJG1b5NFwXBbRTbkkF3fHplKjqLjN1QuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1SH0hsuqb4NJXgSMoeSJg8RMbmv5ZuzPVQfahRwVkmg&oe=6AE4B1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfj2gUtrzl4Q7kNvwGJXc8g&_nc_oc=AdovJwx05hm_7ynACw8CNBAdiy2AQ3DC51mL8xWKyQfx6Rk9DqrNamCJdYTGJ-KcfyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhqfbpvCrrbEyDjbZk9YuaqK3ZciIeLjW3EsIuJ9olVQ&oe=6AE49052"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
ent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMZOYvzKkgsQ7kNvwGbCt1g&_nc_oc=AdqnkE3KBN_TEKwe3a6tZ1wEijdvTxf4Taeg3iH2ETllXC-L3iWTkAgHN7WFSEQ2W6c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3OFzGXJGGiPwOEP_gEyPRayumS31F1GXhkx-miuOfrg&oe=6A8D6FEB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6BfWTsggN0Q7kNvwGhpFod&_nc_oc=AdqjjTJgDuLlYFfoh4WLDFYPjISoO4LFUCqyYgEabCwEwfmfRd9v8Dm0GiJk_dkeU10&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETZusBh0E76_ikx7FAaAj_vdkTkQz8bu2-zuGvEQgYwA&oe=6A8D6F5D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we7j0-GODzMQ7kNvwG76Gfn&_nc_oc=AdqYjmNYkSssFFrDrDjQ_KjGYurc6tOx2UBC2BJ1yqVdERrNADPyx8BMKoZi-G0Xp5g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn2tuu2n29D30GrCE8iIqL1lvLzZmiW-6hAyE0GWY_vA&oe=6A8D88AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbOSVEMmbxMQ7kNvwHlikHB&_nc_oc=Ado17k7qfE7a8TMRSj-9vzIild9BrNpQS5vcTFKzK2qK53icPI74Sk8fxUzOlhezDP8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1eQ-CHmpsGy-CCdNiCFldQnc7JOCiOtjaNhOqiqQ0cA&oe=6A8D769D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vLyyev5HtgQ7kNvwGrhCt7&_nc_oc=AdrrMVlEPqY57sVuqHwFCPExpOJ73rw05nrxhWGMSNhwn3RYpYw5RD1v0959E0L7lTo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrsOWNr0BsvOwUTYUyltxNOMc9n2vNWME2_6WUlD5jsg&oe=6A8D8D52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}
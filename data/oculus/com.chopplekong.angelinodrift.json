culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiwW4k-wYW4Q7kNvwG7WokC&_nc_oc=AdrSPfoH8iVVwponDPj3Ard4mi3SfXcIP4XWpXXASvZ32WOwRBeV1BRycP0fEAPnOVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJucRcBM8W7mmlGk6goah51PNXSzObGMQmmO-jvNS7uyA&oe=6AA6B4AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu9Qm-gLCZYQ7kNvwFBPFj-&_nc_oc=AdoxkYx7CJyxlgs72NDfPg3bxrrQ6RMTnQZkS049i5Wt9EAbOu_rugfjMdyCjp5qWmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR8IBOgp4o52_EWEE1NI9_FbfYUollihcZJzsS3H1Z1g&oe=6AA6B41D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Qta2M9njxAQ7kNvwEUws5D&_nc_oc=AdrciTJY6Gmjwv8UsMkS4j7xo8yKpLDWvdg2IW9YAGnWhTbfFoKj7eRNUSVNUYGrdvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0RRr8oUCxKlslZwUyB0RuOtm7mS-2MXHvfWDhbXQUTA&oe=6AA6952A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_r52zZVvUQQ7kNvwF5wRuV&_nc_oc=AdrN9XxIXLqjyr6oSdYCE_DNdwBhQbtpTqMfNDfpn_UJfB05zhm2qK7tAgX3hT9VC68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMBoCgPGssZ4avyHfyyhR2hXsMntcFofC0tqBCWmvyBQ&oe=6AA6BB5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYdaJMkG4GAQ7kNvwEhwqhJ&_nc_oc=Ado1kIWPRGYb2ICPF2zVwGkvnMHKkBTpkOPbvuO09I7IoVfGVL9MSM1U-ZxFjxI88pc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFocnCUrh-MCLcqI4I6dnLaiK6WbmprgP-mls86hIgBw&oe=6AA699D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCvrsPrLM9QQ7kNvwEtv9rw&_nc_oc=Ado7cQC-nV7RFNUiqnaAaLYZu-Qd_fkXQNmiAsixUJmrOVcQYk-8qe-XUs6VoJjZG1s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8377rh0F1loZdM6ILq6IOkVZDo9_DgixmunvlrmBSDOw&oe=6A300DAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn7kPenAD3cQ7kNvwFNzc5n&_nc_oc=AdrmdQG9ptHFNJH24S8JKVJ7SNxxH1UT439RA0LZ8WFZ1p2Gd521OP1JN3X8TZIjiQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xFIiXtFqgUkF4Vm8Xla9OS87qbWq7c5_MOdtl8CYtcA&oe=6A300D1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCEiemkRxo4Q7kNvwGnSzO2&_nc_oc=AdqD7FZrHWfvJeRI7Tqo_ofk02t8mlzQaBEMurPJOwfIrWdxz6EMFNenbJmASyLnrBQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8ZBaCmjP0eddttOpqsilXIIzhbx5StSFelGg3TSCTlQ&oe=6A30266A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipJrZAmHsaUQ7kNvwH7yb1i&_nc_oc=AdomI5m0lULweRoTg6qtLN6j7Uadu2nOv9YLsGaCpF0CGAtiMUFC-_RkCAcnUSVnZlc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J4MS0hg27Q22vA7Fb3mcjVdShh2q9UIk5IeWwxYd0aQ&oe=6A30145D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItcdOOrfuEcQ7kNvwGrZ_at&_nc_oc=Adp-l0k2v13AwNaxxlAibPBX878zYEeRLbBqjXdZGggoFyzKXRC3aLjJhwqLA46pvyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_06Tqi6idYkLPaMn-D707lUxzS-UvfX5V1BNExSNBO8Q&oe=6A2FF2D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
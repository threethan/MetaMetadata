culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwFDXCNGg70Q7kNvwFZCDww&_nc_oc=AdrefO0cZDoi1c8bNXgrwXUKfcyDJ-Gu0SrbQBtgF3wRMVKaPyOyKc51wNXDxFj4gNE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s4oSxY29TVOjYk1KkU133viC9Z-YkUnXI8T-Dq31r3A&oe=6A09D22B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDApmnIJWK8Q7kNvwGVkAGJ&_nc_oc=AdpxD3iK8_zLVb5rjFzR-qb0esfrkqCCScZdUA_8kORdjAVTs9vGlY55OkSbhUdKM1M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KKF7V4Fp0va-QdiJj8m1Isv31j2ftNBZYCBfILQWOZg&oe=6A09D19D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUy7YTPBcIsQ7kNvwG0gn48&_nc_oc=Adr_hoRTwoIcGVmqD6IjRJY5c2KE2NfyhDG6C_9k_iHKwzadJJyEK32LGGm5eeU6pVE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IpnqoX__jiuFgOKpfLze52GYA7kQ_Ii39sl1V9cs7hw&oe=6A09B2AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGCjkqaBdSIQ7kNvwHJ6u4w&_nc_oc=Adq1Xjmt1EX6GTPGaWFQdjzPsYpHcwDpOA5fj6n1fUG-1AbDcHIrQErM6IbPd1tKUoM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G_ptpBYh93prJjLle8O9q6M2hoDProrSo36jluUdCmQ&oe=6A09D8DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNtI3mFQviIQ7kNvwFq3IYv&_nc_oc=AdomvBZTwOeiVWiYDXM0erVHWQXnEc7GZlcAmzZeYu0lO7sB18wvHO6YdIYNVniduLY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SaRH8-CTY03hcgaxyH7kUDTDP70E3jtdBqEVl2vCjNw&oe=6A09B752"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
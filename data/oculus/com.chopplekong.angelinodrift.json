.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxxP4Y0ifUoQ7kNvwHWaJXx&_nc_oc=AdrHijNmmj_mHqdoW_Sx2V7QV5pEor4YNl8Z7cpikcMzZNr_i3h8Foc3dSayqbPnigU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sKKp3zrApL2cDr6-5aaIyLDT93r-AB4K3zDcD8CxAuQ&oe=6A46772B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Pjf4x8-ukUQ7kNvwGT_hnD&_nc_oc=AdqL-CkAZQglYihdG-ynrEDCMS-ty82YJzNR9fSH6rO6nG4PYgEg2vwz00oAXuKh5FI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xumatba_QOcP6UGn8S3i2MjUFNvuLG4LCW_SdgAlZEQ&oe=6A46769D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgfTY94xBpwQ7kNvwFVHVyn&_nc_oc=AdrJGmTCOiVC4ZhXt-PZISFleiIbTpaRjhtuqEkrRAPlCzZlLFJymKx0L5_qKtvTcPA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fOLH5yhNmtXKCqQqoMGDuOulyUFLHkmbXSxWwlqUxmA&oe=6A468FEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3Fxy2wsk_sQ7kNvwFsg-N0&_nc_oc=Adpw__MUYZjMT9744IquQKxAwZNszbNywHAZ9z1O4FVfffq6gm4fD_C-TKg2DB2z4-s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9usnz8Wa2QPsWQHeSvxT2PMj7ttmr1g1BGGI5DJAD7Yw&oe=6A467DDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqeYTcTSJ58Q7kNvwFbCTii&_nc_oc=AdpSjYK4Dyg4PF89lTIpf6XYuck3kBmAUEfFV92H40ZTsERs-EZjRxTOfDT-T4dJKJ8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bf-LLaryOEzVpRjXj3JESiTy4b8vCEBltvChVJmhfyQ&oe=6A465C52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyxxtq9aOAAQ7kNvwHLAXVF&_nc_oc=Adq_jttjvEP0BMjvJxd1f7bbXp6iZIeov0N3siPfJ3AFkYSHIRfi2GgETVsg8i5Bae0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtvo7cll0IfCisteLHrLC1fZ0dz1uWxYt_NVjm_Liang&oe=6A68BE2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsEBbTO4RVMQ7kNvwGR1Kaz&_nc_oc=AdpXaYscZR8bM_xSdUZkPzm9FY12rssR4GkHBAV7FmQZtF7Qhyh0_0NT7djlb5ZYQd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCWVelv_wr_44K6VzxHm0lGyBi2DiVEZ2mwjAC33NTQQ&oe=6A68BD9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFHgo5hjAPgQ7kNvwFkcjr7&_nc_oc=Adquga5oEwEXleZxVtKB9aisEXb1jqZRidUaMMjZ9gxzVL26RXIfjmqYgdMJrFUKSBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj-99zIjvsXM5tSMSc7P9lsrBUjNh5vlcBouYBx_I-xw&oe=6A689EAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZpVxbpocvgQ7kNvwGvfDtG&_nc_oc=AdqkaNGi-yq0pclu_fP2wJxlL1sPPTKGThooeTnCNa7QWNJ5za--3JJF9fh2BZSzIrg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXw45vmVT6qLKQ_E-ZkrjA_cHN1aF9a-OkvD4vkyhERQ&oe=6A68C4DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SC5K0pTPTsQ7kNvwHAugnI&_nc_oc=AdqvoOlAhfzzzdkRLt9Ya1dR32k-0cZ_AFIVsxlYLKi82wPexYKNRzctf-stMH91vJk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd--W36YevQgVKsPUQxpWza0XsoYYW4vKg_XeuX64Fmw&oe=6A68A352"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxxP4Y0ifUoQ7kNvwH2_E69&_nc_oc=AdphJN_4k_eqtabLdy11hskOmuabcNma5iOw-VrTrU7mhaxwS_2KGMPgEAoE9Mozr2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RDI1ABcH8LPUJg6kGIK1G-ovk-ZqlmRL_VKla0Gb9WA&oe=6A47C8AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D4YMkWdO3EQ7kNvwGnL4AM&_nc_oc=AdqS6jahA9fGlKDcQqQgeEySbiOBiWM4S_z3Z42dhPQ8IDVK5hhy1uwGjsHLMSucr4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lF7BsSAuGEofqCF4AswzpXHpW5QA7Bvlxqr7fp7uvvg&oe=6A47C81D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgfTY94xBpwQ7kNvwFEqilK&_nc_oc=AdpupYI5PhhEIFUXXKE1oeXbKsUDP92a9tn_7qbGP2y2BFPskJfJbNVuCTKJIx8bW8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jF9doF9rvFC9CRJETyGVQ0UtLKBvB615hGRSwBIJ1xA&oe=6A47E16A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3Fxy2wsk_sQ7kNvwHmhd9S&_nc_oc=Adr4e7T9Mxhv3UQh4TUHtp74nKOHtRf8EqT683DSTxQU653aVHasRh8WBk7LwYjYP9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ux80AyNSYFP5ZpbkYa7TKy_7i9A8zZvVcLn1LVNes7w&oe=6A47CF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqeYTcTSJ58Q7kNvwH_Dvxd&_nc_oc=Adqc2rZQxUTZjRknjX1n6jec3-J18Ag1Y4ynUvzjupOcqrJ7PzmlD1rGBt2-S3R2gZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99_F_6VCQ0MfeIes02WJReXb4GwFtIQdiD9CL1qo6hZg&oe=6A47ADD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o7pX7iIN7IQ7kNvwFuLJae&_nc_oc=AdpuTVt2tvcQbVY99F4Q7UHEYQWskE8nlhUlC49QXfoxsSPFd7Xwu6B6vrOLcW7FYX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oFQUNWp8yPn2eqGGqbmpglKDhHjUTx329HkQs0ixhbg&oe=69FCA32B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei6ZuZpuTcYQ7kNvwHymSdK&_nc_oc=AdqNJ4_TtS2CZERkobFAoPPMQm0kkYIsYkMcG2Yf9nuntL0R7jo7fVi47Kj9ZuMMkp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bkgb8sTi_sEsOnx_1PpxzQEM_DCZClFGGtKC7dvNx-A&oe=69FCA29D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhynyULbie4Q7kNvwEOZwlz&_nc_oc=AdoEtH71Yy46bIN6Vqi_7NZnlZAdXoq-GvISRzLWtAbOL-egGe3U-u7XernJvBquQEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50fmRgywhTW8tRDVfHfZdcwP46OAGbZJBFo4hgbBb_Zw&oe=69FC83AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uIjG8-eywYQ7kNvwFKfQe_&_nc_oc=Adp2Etd-YvCmQf7lLKp2cI3tOgp_cWHcmK3G4CZwSzMk7dyt6l5YlP0zm1IZRztKH44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C7vs3g9JB1DjpPl2uOCPSE4MkCCVqx7qRmi7KhY82Lg&oe=69FCA9DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OtV9nQXyccQ7kNvwHL6W-6&_nc_oc=Adon5gG9U3sFS_UeVJUFB2m0uq6dpMLCXSUBNPDttq0mXRKYFOutqcUht0UyOnjfAcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BSvOyxeGWBZHhJ8GnYEY2t7nMRJTGxn9bL0kp3IhCuA&oe=69FC8852"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
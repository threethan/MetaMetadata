culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Spc2QuZKNdUQ7kNvwFjmYiv&_nc_oc=AdoBzg2aHMNUNvcmjKTWxL4JI2JpSCH-7tcyjYZ3-tJN0uu3ZMcPXOOI1pOtimzxDY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w4uGvqdSiOV7PD0KltpYCIvZrTGNsukn72oiq5wEn_A&oe=6A2824AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjeSllnf9ccQ7kNvwE4Wq1i&_nc_oc=AdoAo1UZJPbeCyLfdBIYUR3qI5EEGVVhTN6GCgE0rH5aRUsJBt4U4TdskBbp9tKQUGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NsjBehJQTk3LdjJ0i40M6jOUEMozpEyQErImFHAxy7w&oe=6A28241D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpWBsd4KtMYQ7kNvwEO_a3H&_nc_oc=AdqF-h5pew6yGtG6h_wGEWSStZtbmJEfSsZv4zhsUpqFUmtPhzyPYFVK1cw3iwJ9U5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ElZI0yzy3ODVCNPBPEbpyEM122I64qXEDluHJ_jAf3g&oe=6A283D6A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAFq4t-qDx0Q7kNvwEvGF-z&_nc_oc=AdrZ2VQZgS0pZ2Grb5d4D6nGvqeF3AT-s_WDQ93_wlvwm4877sQlpN4Cpyw9FFnU2pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hMds2GyIggxIZpdMYnc3lAxwjcIK9rItY50ipxtpBWQ&oe=6A282B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7ol5qzOI6QQ7kNvwEb5N-b&_nc_oc=Adr1miAeBqkHSf_hbVhUNCaKxKR5s-W6NZoHKwdnT-CryVC8hwK7N-09W-kG0x2yxbY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LYwBRq5A7-nMu4-hfIGptOd_N79TaRYzmnfwmkXNhIA&oe=6A2809D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
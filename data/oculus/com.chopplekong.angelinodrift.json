culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3qPQALpa6kQ7kNvwFHtdlM&_nc_oc=AdrL-7larEPBd0xyDKtpY11ZdMPRzAlUfkjSY9Dum07d-LZCZmBpWpQiSEU_H-6vnSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMZCAepkms_IKJb-ZdQBGqFZpmzkJBkE33u_KQDzZZMQ&oe=6ACA4D2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6pg9-WVz7MQ7kNvwFkCeYt&_nc_oc=Adq4S5Ox6idcQyylsPewEsKzIt8c5xphoDSKQICAE4oGp5mM1EGgt38C5mvZ0uYJjSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkFAN7JmJ8EhD07qssGYA9mJzJL3BHAbRFvHlE31tanA&oe=6ACA4C9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuaB0aNfLmIQ7kNvwEMYyrH&_nc_oc=Adof2wlrWqhJUiPOXZGJvZ6YH_xplqn3YdD9ZaHbFBR8Bg6L3yXh1sVd-P97-ITKet4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbiuwzfkBCEdA5R8swv7s-5DmghpJPGjAd32rWf0--mw&oe=6ACA65EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9iXBgxo3WoQ7kNvwF8ecmJ&_nc_oc=Adp4BDmlsIAV-FN7MuTD-uP-WsgTOsWntKZju0OmCkyjSBnceNxhrKVu1AcaA3YTnGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUY4TfxaO64YmNJauj7Qqzpxbf1fuddsiKNnzPDe2eaw&oe=6ACA53DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csNcIBfepc8Q7kNvwE8Kr6P&_nc_oc=AdrTVqeHlEGvivkGZ-ZUnuUoHpddN20KiMR6uljlGjeCmkSKZQ-v3hH4SWxjMybW2m8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLgN7NjVAJwdSUubtUDSTwViO6Mh-0PjLTZERgnco3AA&oe=6ACA6A92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIXpHR63R6sQ7kNvwHRQf4Z&_nc_oc=AdrLPFp87ZTBpQJR_exf617nLHIxWxRIJbOOqsJfe_btYhBfM7yqQ2xN-VSA0BI-VyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiBtFEsZHzQ0vPVEtkXZNUgX6b3lFkgaKuRcb1KaF9kA&oe=6AE74E2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc7zsfYD9-UQ7kNvwH9NMbL&_nc_oc=AdrxJi4OEVYuzil2nMPioVWw2DFfXmGt57oYhD2yYIMWJqZ-9MDmPjyRldgvIyFibmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDz7X10z-HajWAAcKDmNvCrEX9PRh7X7zlE4NxGIJkEQ&oe=6AE74D9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRgHjBm2oTwQ7kNvwFSO8Vt&_nc_oc=AdqI1LsH8xYhUM8DJCtqxZswUt4VSWk1Uam_eSM1Q56f28fKuPT6ubH2_5cZdl11YyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAWBRCU-LebzhXOTbvQ6H1iJMi0ttDo5xjewZvl8U6sA&oe=6AE766EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiUNBlheUm8Q7kNvwFwsyll&_nc_oc=AdppbFeIOgwke1rNJYz8Os0bSF9zFrEqoxwUM4crHrwU3fLSd618X_3qtHEapSfpUTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZJ1-egoRLHyrOrMmZKOMMwL4-2Uh4WnGyc2bM-3eX9w&oe=6AE754DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfj2gUtrzl4Q7kNvwEQh4Cx&_nc_oc=Adoa8hixEEceu62i-BIEQmnNC0woIey76WjeSPv-rL8GgbXdi_4jtKU5eU4j8of8vAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqY-0OD0FzcKdIdtyEGMzXnPIU5ZcFP9l6jvzRRL0GOA&oe=6AE76B92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
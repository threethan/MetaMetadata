culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfndV3dYxt4Q7kNvwGNF4Ti&_nc_oc=AdrsJs45cfPnBp-fibSGaH7k5fJwOd5f6TJniTe3Vvk0SuFuGVqSqQclUw7r_UO4p4s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xusKoYT1JJggjFwCGOGUKCsDOyKvGiRm07ExEH5iMWw&oe=6A218D2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7XpNz4mXvgQ7kNvwHUV4QF&_nc_oc=AdrvHaolR-iyHQjwRprJV0sX3Xy51iJq1wyzh71n76afJZwZOWZqdS4viW1Tu-RzKjU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qf16EryzAIWQRgFy8XxRCz95gZDygD3jpfQt8JNzv3A&oe=6A218C9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPDdtFXJ4P0Q7kNvwESTZCB&_nc_oc=AdrDBH2r6qjZK_5x2S_IBnxxebwxjVWqL058t9TiL4dUoBzYOYmxz2x81kVWademPCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D7xx0JBQ36J2J9v0ZNe9oYNo939jHwKLmOuKzYUcFYg&oe=6A21A5EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NbET1r1absQ7kNvwGicsDT&_nc_oc=AdrXirgzWilOsCkmJW3Dq8IsZ-iqY1oeQmsES6zJ23nBrIIKJMDZT4FN1Kk5iSehJGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XLmm4uRmzN-5KI0yRizvGa38aY1C4WYVLsxp4wWmFPA&oe=6A2193DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uinoi632HgUQ7kNvwFYdPqt&_nc_oc=Adr1gTNk5FzK1BPiBb1RqWwyjKxiZdzOBV9ZXt_WQcxs22fhGrIvmux8Ct1KAyrGYiM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81yqcnAqMSgjwUZwKv0ke1zkfPwty5dlF7UMEYtAGIlQ&oe=6A217252"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
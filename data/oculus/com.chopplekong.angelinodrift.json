culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1qIaEu6a_0Q7kNvwEHLvEY&_nc_oc=Ado61mcpqC2VQ0CLN38Qxnzbri-P9CWnyI13AH1rw4b2olXRyFyxRyAS49O7sK1es2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxFjmPGd5l1Se9A_xWqRFuI6hnCagF8ogiuuzES5bESw&oe=6AC2642B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwG0vGEsCtEQ7kNvwG0NRO5&_nc_oc=Adqmz08ENt6NQwSySePLaRBu3qMDTFZvG2dZActz1OpTNNwb4REad5xFwd2IYVLvmY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHF5sNXpuUQ4hd6nvr9Xb6pykdE9wQzvgUBScU-4dIEA&oe=6AC2639D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8zDxyxh0zYQ7kNvwE70k_T&_nc_oc=AdpFT0c3gT1OMIDdfwmG7uB7oPOPCiNcVuXh32LyE0qSChFmJLnEWtISh2X4sZzO1Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOsTVRQK7Z2FS82_hUdCFmaPSAGEnGiBdc1lZ7er6L5Q&oe=6AC27CEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OmWW7JNcqwQ7kNvwGJ1C49&_nc_oc=Ado7ej6ixxgaBl9FsyVu8hHnj1bZMk4e3jDa0VUzU0nYi-VCoJa4M5UDJpKX_c3H2lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPpzRj8iisSY2OK_Nk3fZ3QOq8hHnDT8Kre6QHHxxcWg&oe=6AC26ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft6x_RYb_ycQ7kNvwGPqp9U&_nc_oc=AdrArp5hMHmiFaVA7jcpMFxadfaOT8PfPcW7BmdBv3AYIxYzMom3v5nTWKw8IiLaBJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd3_vKzIQKUbuHzp-W7Rkxlj76AgXTH8N5gJ4wZI7LUQ&oe=6AC28192"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
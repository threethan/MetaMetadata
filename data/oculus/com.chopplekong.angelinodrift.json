culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiVKInRPqv0Q7kNvwHgME02&_nc_oc=AdoNdPt47vmsJdKBr-GKHnQT-SV4G76ZQZ_TvgVse1iHdOHv6iVrbrmWf-JL4tgIcjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqNqrT9wbQU5aQrhNC3oXJkghzm0uWDUXTDoW3GzqOQg&oe=6A53A62B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wPOIYWxpDEQ7kNvwFGJaEi&_nc_oc=Adp9lMJb0785yDMYSzKmVu9IXMp2sWqbetgEH1wQ4HLFraqX9dQG-XsXJjgOKNSHZkk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDAlEjRy0tOwkoRbmgioGQBXVZJnCqsddpos5PeEXpKw&oe=6A53A59D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on5dqIH9Ov4Q7kNvwE1UYpp&_nc_oc=Adq5Oe9XZBdfeMgkfe3pdjS72d6uoEwcvSCkU_MkSbBssv9GHKyJfaSLlNgSfIfNLIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUQxbghqjouEEAmrsoTX458a9_QMnuHkK1FwtM_QAvRA&oe=6A5386AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty-0vp5ta68Q7kNvwEnws4b&_nc_oc=Adopw5GcSvQG2gmZgR4j5nqzJymIKrqCY7UCKg40wh_0wKmor48pm_VK43cGuuYtO60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzRz7NDsGY22LaJgMXEV0VwRI2cj8TCbCgLi7VveswiQ&oe=6A53ACDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gNgEvgfOiIQ7kNvwEFuHBO&_nc_oc=Adp8xnQ7hU5bdgsK6qeXSa7c_xlWWBpQvNaG5qU5xBss86aK5Gw-CS8HUcPWcNJsWic&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsZChj0BJOThhjLKhleqa6q0CKaGePYNqbQjPVgF56sg&oe=6A538B52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
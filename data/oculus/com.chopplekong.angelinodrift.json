culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRxJzAwoCCUQ7kNvwFuIHi9&_nc_oc=AdqFFjalS7KXDQSob8mgPv3Xxlln1hHW5ZCAHRrzjv8Uv5t5xIVCygETVQNVzC7PE6o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLTTHeovdujp8oz_vkm18e8i2D7889c8TVa991kTgj0w&oe=6A58EC2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjljEN4lLlkQ7kNvwGg28bf&_nc_oc=Ado1rqrFV1gJmy2gUO3-ZSnOF2xSuRlmC_jSIzmjQrw2zATQbvTOVjEkmG2k7I0qgTE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFJlhAICbmlOMqGTwm5Ow9pPaF_CSxJfsjJCXOaGG_RA&oe=6A58EB9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94v_HY-1vzcQ7kNvwFo4RdO&_nc_oc=AdpF_l0KrxMYgaPkgfDKYWbhGnWuAhbrtDUlT88AtRHjhPoGsiNIejt1a15c0_KxiIs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_xndP4SXkdkGyl8UZ-lzcVgBW5Gf-y0bClKm23CY__A&oe=6A58CCAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cqspZnlpjMQ7kNvwGrJ_3-&_nc_oc=Ado6YCzCK9p9M0EX8Lu7EE2OjuuA5cLdxBR32ekdo6e5HcVKey4lSfA_sYNaWQDRoow&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClOWk12iaiveA-ou3-OxI1KMIJZ_tXSEe2yu43DoyVug&oe=6A58F2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFny1xn6iLUQ7kNvwHchrx7&_nc_oc=AdpZh7ZTkUf1aIJjKKJbNBn4bdZySt69xLFE6dYiGBhcrDa3gjlMdFGXRNDcF-SMSgY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuau9WPl-vjOlutIfB6PGGs2hRYfvJ2I0V3jZ_sxadiw&oe=6A58D152"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
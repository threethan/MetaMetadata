culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDbgS5O7yXAQ7kNvwG9kvB5&_nc_oc=AdryIpF8Y6qVzZMoYLFJzMeMXXpCiMbYpeNNtWZvXBGcnxZOlaOD2RzKp_8_WrtJ0XQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4vVL4SUSa3OXZY8xTNZwx8JoMEsKKLrWzm4sKTgZndQ&oe=6A81926B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp4S9mCFytMQ7kNvwEZ47J3&_nc_oc=AdqQE7tQeSR4HZYoJrgOfjg2ENcQaHkgP80jfVdfclKpskNBsIfEXzywRNQblEytXo0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxDjoFQ7nJPmd-WsUnOi3Lnl5iwt_oyBNgSgDQiY8s0Q&oe=6A8191DD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNweTfy8qtcQ7kNvwHKhutf&_nc_oc=Adr_i7a_SXecTllFJ8BheGCLY5AGQJIGsEVClMxgfvjywDBOURmfjlJKLTosMG-u0XA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM8NkpK_rZ60PhcOpmIKkjUZyb2DD7UjP-wX6-M8F7XA&oe=6A81AB2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRP-Ytsh4ZEQ7kNvwE8lU_A&_nc_oc=AdpOg9YXxdrljjwF3pPyxp-tiNV39ZVDV-B4ghPtduhNE19kIHE06SoiN6zSzEgxPQc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGR4ZvQQb_Afn2r9BSC5F_EdCtNW6L-BRy7AiIBr7rHA&oe=6A81991D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6uYCTcBHJQQ7kNvwEtXfVx&_nc_oc=Adp0dl5HG0C1fl102sPSBNSDknho25k-ZEA8ttFVdr1GwF8d3dgY9GeK_s1iNQfOMgY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL4lbobF7Cf1mcEbjIrc2qEAeCi6Kp5mrObnjd5LX7lA&oe=6A81AFD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
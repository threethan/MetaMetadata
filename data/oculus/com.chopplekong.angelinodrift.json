culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjUSDjPxW7YQ7kNvwEHfvpU&_nc_oc=Ado3YfyK3FM63eiiB7bJ74V0OXhzIVaKru88Vh1EvIblg6TSTF1ViXZhtl6vYjPDZEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBckdX_x2WAs6oqk0Yt_3JCEGFzovID6ycr8xTUQK8i2Q&oe=6A6E042B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KctmxuB86TEQ7kNvwG5y7wO&_nc_oc=Adpovm-rePrvbHE3z1CUW3uCadyl_7ZSJlzuIAJMUCcLyZNIxNTeW1dzcH9o9OeixkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZCnYwNXmf3MWUNguDwhtUP9D1rLIbQRqRcqaXGX6G5Q&oe=6A6E039D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSvafr64JdgQ7kNvwG3CcST&_nc_oc=AdpFdluPl8HibjjnvqxczNAL8Hc08yXqb6Jb1kuMWarrr8sCfjQOOVOO6MpfyNyyvvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-V42mSed_mvZXdrJbpGN8pgs5o9YJ5OUkvqaJJVcdmg&oe=6A6DE4AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCIP9N4E0CMQ7kNvwEVSaJ0&_nc_oc=AdoX6HWfKsRcohvivGgNVLHCD4Vn5YPKJjjbSONB2LI8lP_M6j1hZfe3ch_LGfR4G5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhJgfmI21duWM9krvzG8MyTKYnVC1hVkx8lHEAMt4ZtA&oe=6A6DD29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNvCJ3bbyugQ7kNvwHXZj8-&_nc_oc=AdrDI6dirGr-4VL9sUdVHjRWeNsYqA-U1baPenIGmMGXQ03Wuk3LLg1eYiuXAIJV-1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeaugzy11Ed7lZMAzeG4LqqH17Oz2KkfMgtkHqaH3AQw&oe=6A6DE952"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6F6anc3K80Q7kNvwE-G9pD&_nc_oc=Adp5odZYMHfbJkMt7v0eLfrcB8KpSUj2rJC-Hr5Sb_q_IIde9oqHMAwuNeEStY_Uh2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsHwDK6lFQeFOb57-0IvmZRjYLGow6Tx5aRuZDaJmISA&oe=6A98342B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgVP7Fl34yUQ7kNvwFMCVp1&_nc_oc=Adp9_jW4pwcPcvhSRM8yt6suegXyBK0Ji8hMPfc5KHhnibzIoUM3gqaqy_rxYEkgo34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJteLc5MxrORMsUlDQAmKC2dNpK0UnIgch8WCRF-txMng&oe=6A986BDD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfPoKQIN-MEQ7kNvwHdUYJk&_nc_oc=AdpXC-2C3H2-SzIX-HswwsfXyPtHLTEYgHiqw9VmUCS82MkOEXVwUwdw7ZzOVyP-RPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXMqq0aC-Ho3Nzt0LQjwxKNNbYJDvicJkewAMnUplcjg&oe=6A984CEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLYlerqRR5kQ7kNvwGsPPer&_nc_oc=AdqL25kKDg9TWbEbHpSY0D_sTpc1vnZDR9VeqStDUIbh149NJeWTFOEMCPSeM0DZEnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAQhbgrBmvHtNdO9aMXRrM9tRZRHzLO41hswQHW9mw_w&oe=6A983ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ewqk7PsKewQ7kNvwGfMOoC&_nc_oc=Ado-lHCmLTGbHAgPK1LFsHyRsagbi1x0yMOMZFLJ9zYi8u1-HuxkmvL0aajXxOV2kJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsqFXXc_j92FdIv3Nsvelcrzu0gBo5sFAZ1ppUJ16qYA&oe=6A985192"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
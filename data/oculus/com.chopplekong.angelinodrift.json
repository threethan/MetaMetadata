_ohc=lFOm1VW9HvwQ7kNvwGic1Sn&_nc_oc=Ado4C2EDJ-St_JfGbOBl6qNm9IW2eYZN3nasHG9UjEYCNb-PzRqGzKICQVZ89GNwWLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1LWPV1gMKlje7FwcvS86z3uhE3rczvRizvrHVhXocX2Q&oe=69F0C5AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09T7uX0AkbcQ7kNvwGqBHq1&_nc_oc=Adrb0g63fmXIn8MIGnkq0L1Bky71fx4hZkwa_NSaZoN9_DpxiVxOd0P47tX4YpL1w3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2EYiPLTAOTTFuepJCnM1vMRPPovThMZlV7K8OpsFY4Lw&oe=69F0C51D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyaMM2m_eewQ7kNvwED-TwX&_nc_oc=AdrsST15tGfyEOeSMBE12PGjDO2gqe2F5pEbn1_jx1rUDSBsep8IqIKUrmZjZTi_tBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Gjq2hdDTGMnxySuh0AQeRu-zaAknufFXkg9v0kZJRQA&oe=69F0A62A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrJhSuyBmmgQ7kNvwGYLKA1&_nc_oc=AdreUj2chOPFmwuHPcn20KARQZrFT1DxWOmCaxeckrSVs2zNb8A82mOM6_5DPkxz6PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1jnPvL2VgpN3zq9ZEC77gxnlis2HdzRaCfZaxsgKok-A&oe=69F0CC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCbnxnpGgfoQ7kNvwGkSFkB&_nc_oc=AdqtdSYWKnrYafK-ZP25euklo38tR-kTPA91g3LB9YKE2jnUeX_K-PKe9cSte6bhQhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af27lFQIBRWRh5dr6NqMMoQnlePdO-ULx9htkhaNWGrd4Q&oe=69F0AAD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED"
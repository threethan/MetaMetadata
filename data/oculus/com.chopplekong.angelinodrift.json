culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaj-sOsb5DkQ7kNvwGtf-n9&_nc_oc=Adr1r84KHW4rjjfbGyki7--E079G54XbjZFn8lSyegKDbSq2DXhl3Sl0kBKYxQUXPzY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nFoBPqlGrjgRSRdwUxMuKY1hSFWkZ2BHQQ8uJ0ZIiQg&oe=6A0F182B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IooNjtQ-iRcQ7kNvwG5hfrx&_nc_oc=AdrVW8ac9sEj0n35-F-WlTiL9P1ydvmdX-qH63a2h9YkeEup1Vs4Ay6v9G6DF3Ba9Ds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CWYh1etjabHfGhvWgiLpxusZ0XEwStQgxLTZ7Fr7Gbw&oe=6A0F179D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pIZvU5OrCMQ7kNvwHUNgBZ&_nc_oc=AdrLWxElXUiy-fOxxeRtMZaZT7bgMInilJgeDlBl80Ze1wV1CXFwfRZPM1bsivgUQQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c6PgP9qhwdb7CHHCqD-GG2TZ8roKiRuOeqhza0pLOFw&oe=6A0EF8AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2M_l7pFkxYQ7kNvwF5tWbW&_nc_oc=AdqYroOgD6_jdRo3tJJ3I7JdE54Xrz2hKplqkfWRXWXslSkHVFMEtGj_vLjLUX1t2Ds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qk4ZoqMvDx4vx-7gR3G0LJtCaS8yUIdsm4o8U4EYs_Q&oe=6A0F1EDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIiT9tfX8mkQ7kNvwEmt7-F&_nc_oc=AdpCgByHvrtQjLgrxTciZJ1OIGHgDA69QvUWhynPcWmRDxiyahw2-kfJ1ISB_B0-Pn8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZDhPhcA0kcnEbCAjvmBcddJLy46IE6t56GoJI49zN3w&oe=6A0EFD52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fMojb-8yAEQ7kNvwFO_o0d&_nc_oc=AdrdSQ-AbQaMWAIxwVtlEpTBQ9wOiFn7jdCCHrOtmCZUhwT5iF5nIbc-5XuaTZy175w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U18IhWfKIk5oeVETzJWuo1-whKMmlXes_LBUCIw_zSQ&oe=6A41312B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKx67QxSomEQ7kNvwGOFLTi&_nc_oc=Ado91aZYCrYy-MDg5K_-Xar8VtEPsUfkXlUaTc8LaURE4VseL4t_SS-mxVTkdVd0zQU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_8_55ocmVqp9pSR1Pj6Lb_sUB5Q-MM5XFRg8nTjZxpA&oe=6A41309D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PuGrbcAFIMQ7kNvwFyicRc&_nc_oc=AdoFZgav3srwQ7wlDCHBpqL7vUR2k-WIa_xsg0mYBFyKkQ3cuKZ2k8JuqVuV9I3rUCs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vtHPTWnOpJqa4Ki_cr6UGT_MqUdwmREzb9aq3e4E85w&oe=6A4111AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S0Gl-mf1TgQ7kNvwF40zmJ&_nc_oc=Adqg4pgdW7vOyt-PVA7nDaSZoKDzwsy6QL1_vG0VhKPsQi-SClJpsxPqG86ESzMaxjk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8qbWvpdByBIelyAizvLjp4zl0f2FCgzvImUhpzPwYPw&oe=6A4137DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdn2W1-AHogQ7kNvwG3rmRv&_nc_oc=AdoRjgUmH4BFAUHJgoMFcTlcreTJkQ6DlOeNQ7LFh9gVXmskhP1aizy0LsB7sUN4MUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5WlVwVsxG_7O668kkSrKq3Dp918yHgFZ5951bvt_HHg&oe=6A411652"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
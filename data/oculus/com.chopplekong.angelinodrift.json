.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ouv7OpGjhvsQ7kNvwGqfc4k&_nc_oc=AdpRQNFmooJTckdkVHspsB3_MGAu-sGBPTjPaEhGI0gdPU1i-K_golyue1CFs8gVKzE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e7wQJqaUTXg2M3Ob9rCCYAe1w0kD2bdbYcTlsdgy3eA&oe=6A36A52B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_VrXBfn4YQQ7kNvwFhkXj7&_nc_oc=AdpSSItxECY0gV9aIp0G3p3m8Wms8uAnBaNzu2WoAdLxlWDT4okh6mtD5VlxXR7l35Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_no4SGe9JPNPkcoWEIXbJTpOxkIk57XVB0IDgNmZVscA&oe=6A36A49D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jygNNrt-sNoQ7kNvwHQGSGD&_nc_oc=AdpHiO4YMn_vTVD_qZ7KFqLm4S935y_QWCpD6PWqEW5IfEEYY1TODjL-KO1IE3vezEo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4ccUfBRL_9qkRNIG85Y4oIoiNEwDL6lCT_nVWONLR_g&oe=6A36BDEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8wokepdbzcQ7kNvwEmWW9B&_nc_oc=Adpe81AkPkHT-aSKgZn48bfGteKXF7FDPEVwgb2EiINNFwuIfdryZjDxPmf1Gdx7x7o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jsfblCD0L7ZJLiGTmK-NfEJwH-Xr-bB1RpHpepesbYw&oe=6A36ABDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ7EBnywzfEQ7kNvwGw60zB&_nc_oc=AdqSSi3hQdm-Sshx4qoFW4GlbBP9yoCUyX6LLnhBxZqkARTC9W5V4Kxy2iHzaeGAmaw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UkfmaUCEh2jcGyuYoFJ5XyYcUKN1TuNRGu2koMl8SBA&oe=6A36C292"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
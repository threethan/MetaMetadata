culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDbgS5O7yXAQ7kNvwEYyApk&_nc_oc=AdpixW22lTTgNKNx9QwhoS1uM07KCe2tn-0iYaha4WEw6_CgRcm620Dfb7zn6NPhY5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc4XOjiEZkHSxDOk_7Ua2eHDt32b6l5DCm4TGzUEH1Sg&oe=6A831C2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLL2I-orT3QQ7kNvwEuchhE&_nc_oc=AdqXrpjkT3jMliHzen8YOyUZEXr2StB8F6ioXurx1GTaNO_OsnWhZ8c16ysc75Lt4lI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuXC4LyA1QlNbS9d3acB5FMsIBOO9ArEm8pQSn_9T6eQ&oe=6A831B9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNweTfy8qtcQ7kNvwEbTkXb&_nc_oc=Adq4DnXoIq1KDhAiUO6MD78KiUv7SdNkrmWEIRy6KWizkw92jd5Tjb3GvkJW3uKsWQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_BrLclCS1jDx4xXZn6-fHKZI1ldRyZSPhhOeGDU7q1g&oe=6A82FCAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRP-Ytsh4ZEQ7kNvwEVUeWE&_nc_oc=Adqt4jDqMDyF6iJWGEOuWzHjv5z_S1KPzWPn88k_FehfTXO_L4ZDy_Exyj_QnChpLNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESAVDsi-6dnpoUIQ3b-TiUZbrcoBXEZMjZpZ7M3a4stA&oe=6A82EA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6uYCTcBHJQQ7kNvwEXGRtV&_nc_oc=AdqWgWFCUtQxsUz6UYm6ehZmGvbXUp0ABdl9gOiTjS0YDJEoc7B-06s1PXCdk3MRThM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4MPNg7mPxxHPFlFGmc9Dj4gDa1_V6dwmbML5rHuY24A&oe=6A830152"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8qzpRHuLjQQ7kNvwEs01FC&_nc_oc=AdrFk9ZgMV1jKAlXkBNeylcnEftxh-CGdYH73FoWFOAVtWOXwU_G2vDCUsjou-Tx3OI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE4xtKp9jxznMbWkhrAwua3fpim_Eha2TFD__rdvQggg&oe=6AE359AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2WAZm_nUU8Q7kNvwHf3f-x&_nc_oc=AdqZH2Dp0ErTONIH5KitCp3dSv-_4e7xLvdCnP8wJ-WYMa3JRNKDdZXxO3H2zjK86kQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZlrCpXLo_lwJ9mW9E8ot4J6F3qLuoEv6g6r4zdQXByw&oe=6AE3591D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1a1lgsejg4Q7kNvwF31d-Q&_nc_oc=AdoGaWnS2aUlikzTrMcYW94zuarPNsixAbjQ5S1JoWf2AvCfwcUpmjc9MUto8ClseLs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTnlqR7AOYxoC-URgENckcJBS63bA0Qs_mqzqiGunAEg&oe=6AE33A2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVHjFbtq_1IQ7kNvwEdy8mK&_nc_oc=AdppfmGDA4f_scnazPnB8_23GGckcZmM0gc5B7XBfmaeP-6Nm9LJGsWMqHaSpTbcgyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCUAR65LOTuG2nARuHvsHB5ZUdig7natfrknAWsP3kzQ&oe=6AE3605D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2lzerDLhSoQ7kNvwG_P3-U&_nc_oc=AdpREvUuFr-lpq9Z9G-lxtPPZb1AtOWMC95y5sCk9ky7e2Hn2DMixWeKKdQAHJrj41o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnguyKxAl375Ye0pSovnA8pVStGFR-vwTs14K6iv-e1A&oe=6AE33ED2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
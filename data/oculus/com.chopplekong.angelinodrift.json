culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioXvEaGwFZ0Q7kNvwENlSH4&_nc_oc=AdqCpFQq1JLZXnGg7ceS_W-jMI4cM1Vck5FfFur-YLAFFfztnbmnG2izSJdilJdn4lA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7LVqaGnppTUOl1rirYD_WT_t50jpqn5GALGMR1Cjvvw&oe=6A91646B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkodfSKUA9kQ7kNvwHJrxrZ&_nc_oc=AdpDDbGFFAn_hFd84lwgKKbIjL6O-Mi7D5XdGbFwcMwq6Vj7d55XHh922-9uLfMnCkY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF53e2MVISxSMzBvVfKT4kd_lhT9JPAmScM1kYTMk0vfg&oe=6A9163DD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNWM0rENLZMQ7kNvwEPU6iL&_nc_oc=AdowmfbW6mL4wD_3sIqRPv-o_WkCHC9MF7hqiAf5IimKkLvI4nxb4wgVeFm_7GgL15w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlHWAxTzcYI2A5M-tV4Z7f2lNVBRel8a0dRuRFXlvoMA&oe=6A917D2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhrTzwNto6kQ7kNvwH3oZc8&_nc_oc=AdrTgCqTWG4zQg7W48ZHcRCw6ULv3QGAD_jGsqg5SBLkI9CWcg116aApBR_lMwmIHHQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjuPAEu6_2W7dY5XySoupXvGG5caVdlHT6RT5OjsrRmQ&oe=6A916B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUy6hgf3DMIQ7kNvwEPayZR&_nc_oc=AdpcoJysy7fXzAD4dqgbm16xNC0S7NRMs0j8PgC2NgwaFr7HFhRvLXAoEjLrzcD8MY0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHnyZynqY4s3hTvyPp7WCCtPuWTtnFrqtt2ZgG6v09BQ&oe=6A9181D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
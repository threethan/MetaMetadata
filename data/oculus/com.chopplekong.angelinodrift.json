culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yl18rhpOIAQ7kNvwHbjDzy&_nc_oc=AdrW2MTBmL-bxhjV4zHOxKJBIG3OFKoiy0bU5u2S9vkZiFGyNVq3_IZjF5qqfHrEMDM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI76sIyNcgXB8h9X590FnLeOPxK7rKRpyRS8uP3xN0Vg&oe=6AD387AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGlm7KbiQ2wQ7kNvwFXLkVF&_nc_oc=Adrj118H36KE54SkmPDfMKnRhEjoVMjilQmIcnEGH3GZNdByfs0wdKl90mmHTbchRQM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-jxazV9X879fhu4ehhLUJElAhHJN50xdEC9xhEx31IA&oe=6AD3871D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_Tpg7gHh04Q7kNvwHrPpe9&_nc_oc=AdoV9QIYV0zU2M19-kfhtKU_koVwXmGUipJ-SuVkWsiCWk1d9F-zMkDUlJhP91kzbPM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-2whJKjxyGo9USB6A2xpIjVy3_IdIChTnpgKoeexWMQ&oe=6AD3A06A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmLlBjy-PwIQ7kNvwE7M4rO&_nc_oc=AdpyR0Fd2K2xUaxNRGTDHK95WEwItThcvmomFJPtlNdith3u1l_VGv6ZrCiIKU0cahc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqVMM6SLX0VNPaevbx2AygOLqhHevfmSNTvHNQrb760g&oe=6AD38E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iz-AenD0yAQ7kNvwFBDfmt&_nc_oc=Adrp8qiiyCfbu_64f46CgQsdUHbKDZf8g6aQPoh7PdNFj_G7ajzYCmgX5WoXWiqwITI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuqU7R6o-Hp1a5XFhxPRx0Uo5zZ07kNQ64RrooMemNRw&oe=6AD3A512"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCgUkXEFHCIQ7kNvwFBJG6l&_nc_oc=Adqfj1upqyw5yrPlLMkvTBHADouTfC-beDQVSnxaMuFQDzcxlj2uQ5jQ2ZcdFhP-IWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r0H0RhBwHpX9LooJUVKe060nsGJROvXjspSpAqrCf0Q&oe=69FF462B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei6ZuZpuTcYQ7kNvwHju-8r&_nc_oc=AdpzpUdi8gQ_KvIiG6cW1SLc3mq7h4viXvkKjjP5uak3nkZwuvQUuTgfoUNjiSs90o8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73GXNjdJoIf-Un_jPCnHx6nI28CMY-MtO9rOhCxJ0fuQ&oe=69FF459D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzg1gKVS6zQQ7kNvwED-Vil&_nc_oc=AdrmoxQfM_GettzaEvT9ohaHfK5ZLUqsaQWOSWHtAtlMRJJyooozRJm0wd_Xu3s0YgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iA96lJnguuyF-gu96EYpOgUw8cXKWzwXMtxVQl4rQLg&oe=69FF26AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abyYJAhHgNEQ7kNvwF9CcM-&_nc_oc=AdpnyjtwAP-0wdIj1YNNZs6uqGhK-yfRDo-SdXF6PrEMHdqmQUaJv63asaSegxCvXA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79iK5cNxS7AUpnYhSLBZ4T-Pu8GewFKWpV_DkuRkhJUA&oe=69FF4CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Apa1SoyXsQ7kNvwEIzNrF&_nc_oc=AdoMhmNwQbUbGYgona73NDi7xjtaMkQrFU6XGZ_NwtAKeSRbFt3u2nqYpMgpeRBFe1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48o7mAGH9lOxlOeZjCeRxA94H49UIEOV8hoowUgMOLpA&oe=69FF2B52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
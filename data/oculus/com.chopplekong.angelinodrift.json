.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfndV3dYxt4Q7kNvwHlRs8Q&_nc_oc=AdqTdQnroryBQ87BHzu6Ng9xe20aCvsT-dW-1fR3usnGwAmgGr_5xBjBxjiYqQcPYp4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yYQklF9TjXKpO39fNxZZ_3X0x9260Fx8EZy_mgC5SPg&oe=6A22DEAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7XpNz4mXvgQ7kNvwGKx9DF&_nc_oc=Adog7B4Jfwx32-2L3Qtxe6PnjvrexXP3yoNXGfpIgGAtbMqOW9MhpJLgUspAoGeuToM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XuGQyZkFvsIqOEUCd8bpN753OuNweKKxemmZqMoYQXw&oe=6A22DE1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq6AbwmtmjYQ7kNvwGkgmlC&_nc_oc=Ado7iAquO6i18XbzdijDAQXOibVrnp9vp9prfmW4OhPgVcprg5s8M0dXiSCtBUdtIaA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PkvVgpxwqF2oNg6-orrRBHE1ALMdkKm-7AtTKm5fCfg&oe=6A22F76A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NbET1r1absQ7kNvwGqVJcU&_nc_oc=AdpBJkiwLChVd7Zpanhl6bvyniYB8-X9ey0Lo90Zll5f6W6XOuGW4mrNchakBuBjbdo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B1j7vyHuoxQR3t56BBP96tN6t2YvLmxJuGfr58RX4xw&oe=6A22E55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5I7IsaD-CwQ7kNvwHyf1Ds&_nc_oc=AdrH6KrAvcIUx2TaTF-QjwPFf0ZTuuwFLr3eGpuYmNIdZw6m_nmOTqlb7lEAzeik2ow&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Baznqu4Klf1SW9GhFhHALs3mi85zG1yW5cmjX3fFqA&oe=6A22FC12"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
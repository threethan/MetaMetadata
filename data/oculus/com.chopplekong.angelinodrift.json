culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97RlbZWUkVkQ7kNvwGZa0Sd&_nc_oc=Adq31-7r4MUJD6JQeQGAIq2ce0GUXSN2oTraGYwHr2i0E5ZW5kkwodjyKpZ1SYC355M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HBC9I9Rh8-8sdxttcCjUTpHErwTvRNuIpvRJ6PZel-Q&oe=6A3BEB2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT5Uvntkuf4Q7kNvwEeIbN2&_nc_oc=Adqd720wGkSjUxIDMRbscin2SWvffOX1EL91aJs6qSf06dul2aoHL6HnfRCu3YNbJ68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pc4PlJ_Os3Kg3u0oLmB692wkxSuW5BBzFo4MgRqA_Vw&oe=6A3BEA9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEe9-jKdtTcQ7kNvwFxt2rc&_nc_oc=AdoFKqr_v7DXYA0uKVMg00WfuznQceWqvHcXDuiiK9Hi6Z4de-4x9B_dLFzlihaZEjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Eks5NwqeepV2t1Mr4YnnQOWqy-VIVgu84e0a0hi_jJg&oe=6A3BCBAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNoO2jWxRvYQ7kNvwFDyQQ7&_nc_oc=AdrL9gfzUG89qB2Wezf10q_jf-aBz8ZtfDlbalWwCHMTDaBDAGUS-KvewGRvxAKwckE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0ZezN_HCzUSjpy2oOO4Ue5z4cSlMoAUlU3i3v8AbMYA&oe=6A3BF1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMa-F654M6sQ7kNvwHya8gI&_nc_oc=AdrVL8pWkemND5yPzTOPGBc9WuNhdWuMo7r7mWLrsWaWwleKyh6paTzggUXBMvydemU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B4Olnwc53_A8jNs-APQpfiJIweT4DTqOe-E5-wrVZsg&oe=6A3BD052"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
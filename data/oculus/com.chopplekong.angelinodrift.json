.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5MeRyJZyIgQ7kNvwEZ8lTP&_nc_oc=Adpc4HCrR78FCB6DZLS9lhol1qxXZffFbsGMnMzUWRHene_fs9T5tQtXaS9hzgiiilc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6BBYt2vcfg4rZiV662yJq8uujgXdwXIGQon3nCUSM3g&oe=6A7D9DEB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TemaaYwozBcQ7kNvwFiGElN&_nc_oc=AdqZ-klomNKKfpZZ_ZDOgyx7EolbnOktXySqzFuUcDFuBEQwyir0sLJvUhF4YJuyLe0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJIlpro4rCKkr0X6vdgrWK95UoR9K4fWW7zDiqFHgDKg&oe=6A7D9D5D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6wpjj7fJpEQ7kNvwEyCcZB&_nc_oc=AdouT1Utje4I5LNgat-RLZf1-jC6iG_wGQI3PpTDOvz1QYR_rzCRnBfbspdrtegFIc4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9dy2vCCrvRYRQLh45WQaFGmLhgUnKVvxwQB1c-xLygw&oe=6A7DB6AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6XqXiubgaIQ7kNvwFACx7H&_nc_oc=Ado_VH7Q_H2fVFxVvcVzZWKzfmUs3L4uZn3PJQhMeIxC7S06YKloh-PD18aqAOOSrrk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2OwHq-uWenWCMDud3xwnDfWoIxp1I64QONnazj6GJBA&oe=6A7DA49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPHIRltjt7MQ7kNvwHTgbsu&_nc_oc=Adq3sxbYG4FXl2jSriiwgSCneU_0lGDivCJdZ0DIKkTGQqo5WbEug0C9pZ3RphosDnw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZQAfXJeezQRqCkJc_RRSYN3LIXdVFAQAEd8DRYKzEhg&oe=6A7DBB52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
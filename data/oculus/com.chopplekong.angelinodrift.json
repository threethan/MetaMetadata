culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxxP4Y0ifUoQ7kNvwHtW4Ti&_nc_oc=Adp2m1-EM1yqrqhvDSofxQNrpf3N8jy0G37ahKblKas486gAJV-dpmrgJVWpBMoTQ1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IEYC3K21w6nQjIop1PP0nNm0igN_x63YjybLXsu9eKQ&oe=6A4525AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Pjf4x8-ukUQ7kNvwF95LVX&_nc_oc=AdrGHWV-ggRx18yRrv_Bg0CTNn94D-s1DsJvp6z9wcuYHGMPmHt876nQeEk0-Szc8jA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V4FgSjI4F9s6_hc4wplHMn9wGOmJLcM7lyKKjv8K68w&oe=6A45251D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyvSo7jNaCgQ7kNvwHdhUdG&_nc_oc=AdpxKGgsgW4BzjSUnEdGvsSl_o6yu4c59n7LQCmty8d9B6aARnO86nYKlF7_wDTIDWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zs2lftb04Wo82c0-FypXXz3I0Wg0Ccrcy95rRaqQu7A&oe=6A45062A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3Fxy2wsk_sQ7kNvwE0QV4P&_nc_oc=AdpCy5__YfMWeQZpdzIu5aoAOO5CQZaSF2tggjyHJUUqt-y006t1TnIWNWFzQfeg0X4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qNamkfFwv71wCQB2rKFd7sUtyE291Jl0oXAwmReI7IQ&oe=6A452C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXev-WQBfG4Q7kNvwHUjH58&_nc_oc=AdoRqtU4Cy01v3xUBzdBkNB7T77x2EWSQWrvnc5pRHtG7R7r77ifXTZxrq1bL09IHKg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af822gQFVBRbG0uXbvbp8CWFUvks8iLmpe5QxcLeQozcaA&oe=6A450AD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
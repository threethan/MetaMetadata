culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnAGpmAs938Q7kNvwF1KoRQ&_nc_oc=AdoWYXmRVT2CZEp4LkyEngMSXIEDQBQwlG92tMNd4rdN4zuA4oNy67wxccRJ9yFLmHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjpacr1Ub2mHMaWO47Cu6rn0JFqKn9CXOJ2McKuAAVMg&oe=6ABD1E2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LSyFmL3RZ4Q7kNvwFLrh9s&_nc_oc=AdoJv6NnylR0yAb3gaJi20J1aE8W8KP5NI9EsjwpglM-gWB84tLcumxE3mAEGEfQpJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF99gdHWTdIBJRAyva6hN0kxKxSYSUH1rNnalWqhAT3Q&oe=6ABD1D9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTcZcpeA50cQ7kNvwEmSTG7&_nc_oc=AdpidcPyY_bQoNUg8bjTMkNYvpcBHQmmd6lIVCxNpeAqLTOH60f0Xoc-kyFjc0Tdgco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILXgHAUEm21PHJOFj8nw4WKKcvLWED4N3KUEqyXBc5LA&oe=6ABD36EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFNNpCDDKHIQ7kNvwFtsn4Q&_nc_oc=AdrmpQpJ199Ct91AI1f0HahKwdgAEuJ_3PlBvV5ACZ77y28My42quzdX3ur-ZdODoBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINtsY-JukBTyLTHQqAzd345Z81Ri1xT-WmxdF3CFY11A&oe=6ABD24DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMtGO2A4lDAQ7kNvwGgaQF7&_nc_oc=AdrcBKU11zXUGAVV539YuhqTKYrCU-rRiFZYo2ZA1lsjA4X_pTxszaNYWh3q-Rn6MRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt71tkmL4DwIKoamZqi82fPHEzLvG20EV3YMJx3f1Zdg&oe=6ABD0352"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
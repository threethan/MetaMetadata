.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DYiGShTblIQ7kNvwGPbY32&_nc_oc=AdqPBGTtmPuavZAIHmhQiP5ZhMm-iBzi1bsJ2UNvutTH4UopWFek1TyaD5w4oT8C9Y4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmM51soiWx7VlRpd1RYdL2Zsz0VyMxmtBtmtKy9_yw7Q&oe=6AA957AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu9Qm-gLCZYQ7kNvwEd08i7&_nc_oc=AdpuEn-RczvSdmjWnZ4z68bUEbj6MAf4LdMr_tJmN4mPTXq4DojQRrcLc8nVbHP0pgY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI2lTA-dAzaPSPz303QYwT1WNgT2c5VcZjSDhQzhHa0w&oe=6AA9571D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ecXpfXYO8UQ7kNvwEkTUsf&_nc_oc=Adrr7DoiLH5ZMqbeoupMoMRVVqqbEubm3pM6t0JrpT02ks5_D3JEBQentSsBEpPhKfM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3z5wcQN3V6zkP6QGGCvJPMDr1LmRMSTPhTs3eGivGww&oe=6AA9382A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzUhxxUdft8Q7kNvwHRDQUK&_nc_oc=AdoBlwt9N7k2VxLzkGYeb5m2m5S_XHgCHmV3Nh486NSx-_JrTYBAc64SA9KU7kOI61U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDVscxDP5gMtY3VHnOWash4W9c0uCP7oUJmM_A-hOSOA&oe=6AA95E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wrYlUvf7o8Q7kNvwHofO1g&_nc_oc=Adp6JbHqzj72yHmqf75XZ1rBJi8frDSrz-VrGIQfXEHQnflgQxtU8mpsKfdgvZl3bU0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHqx7gKwKFBMMuqWrnLXfyI4YcKb5stz9-gL8KIF3Qxw&oe=6AA93CD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
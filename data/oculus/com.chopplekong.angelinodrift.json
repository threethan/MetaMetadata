culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74HeocXKReMQ7kNvwGg-VG3&_nc_oc=AdoKtku2dkGt-Cn-7nZbVRaaI_O24CNirfnPfLZKyRgPBLSPxAeImGvgAE8aHFrbzL4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClxPiowqWMAhqcS-1fsTEGUPjk1Ix7Im4VyDsUJbgVxA&oe=6A661B2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH-1WsPceWQQ7kNvwHpvn9J&_nc_oc=AdqCRy-lVW_5q8b6nRErab5_WQLRRpMRFTBd22IZBq5ljS-fxHYbT5F-yUdFgXajyYU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-xgxqnjg3CtM5yDfOxt7DQQtuH01whn3zse2nTKXmZg&oe=6A661A9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFHgo5hjAPgQ7kNvwGvbTke&_nc_oc=AdqEMhhVxQIBsAnm4j00pYlsGvTN-oQfS8i0xUwId6LI7-zQuDGeEgnPHK9MbZq8kXc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5PTynOUxKOV7MkCa1C6vfJgdRjTaVdm4nDLjULiGH8Q&oe=6A65FBAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40OAhY9amo0Q7kNvwHsQBSC&_nc_oc=AdpArbAlasCjB7g5bo5Ns9ekpHmu4h86lTIAkPrFOwRJI2KbRYlC8KK2nYaz4DpQ1Ns&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnzGWeDMZ0TBmWU_47feAX_r0rdb_NFNB6t-3iR36nNg&oe=6A6621DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SC5K0pTPTsQ7kNvwE93NzS&_nc_oc=AdrvyiP3RT3L0Ko3m1z7A0JZ3O8JaRdh4gxdnzDm_IQVhIFkoxOMPIVzyEkuWN8fv8U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB657Idcz0nv08DsypcI3zzOQ1I_PjcXM5v6xFX6wJKqg&oe=6A660052"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
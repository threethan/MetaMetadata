culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVkM6kPCP0UQ7kNvwFHX-k5&_nc_oc=AdoXNxodvqIzl5aw6gqcJXEpa8m1I_J7TydElLjn-LQY7tiZW_6QADQ8PSSLmrFA6Ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQh267rvZY9Mcw8Y8G4Q6uDGXgzJ6a-F2uX0Ai-nmlig&oe=6AF5CEAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICzC9QPQ0FoQ7kNvwGFm05g&_nc_oc=AdqTBzl7UzfbKoRcIC0E-0OlvIy1GiIvKZkJpcmWtjbYVHVLeBitZzqyrFKUypRvuC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGZlpIVXT2RxnZK8aX1OHBHcAdb1eeVHLZPzsa_jmPMA&oe=6AF5CE1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOWhFGFtDl8Q7kNvwFUDDWV&_nc_oc=AdoV0NVkcjMXbfPayVmScD3mHF1nzP1xluyuJMH8cqX2nP6HuBG7EGP8FxAlJGzSdEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1b6aE67jxN2fkjyeB2V1VGRVO_DsjA583xFjObjDo9A&oe=6AF5E76A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_FHr2NXs30Q7kNvwGtbBnh&_nc_oc=AdqXexqE8w7gc0s8-MExPVRrdX_-eQPAOWLPHuL7hMwJBERiNVZFkPTXfOpnWlyDZ6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLb1Xk9a-RwrTLeLKvb90LLf0L-NP9YWNsFQfP-dGQTA&oe=6AF5D55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fg0ow3ddUQQ7kNvwGTzQ7w&_nc_oc=Adoivjb4ZZcO4iOMD8JSkpowUETe4-1EBuSSfpMD6H77JGtaV3VmA-1HYOfZlkv3EEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbrzwAkLTfzGzlAAe2ZoTRfCMHhNvdxo-FOqJX9tcR5w&oe=6AF5EC12"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29uCVb153BMQ7kNvwEK7-AQ&_nc_oc=AdqVyPgnC-rgdBt9Kgq2goTaijan_ZUtLDMB8cAPs71gfCxHTfol9nwbPn_SdYKwFYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaK4n_4ML_tSJ7VwouIGJxS9Dn88IG0RcgGY43Zgh-Bg&oe=6A4BBD2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocxCiOW6uBIQ7kNvwGpFzRO&_nc_oc=AdoYl0C_aKD8Z2fi6lvvvBcqE8iswmKdn822qQDNnLrCrzEBE5kyD2kNkCQH8aS-o0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX_Wmm36hzLKQSu0w1m2D4V9vCgg5hQDgLfqqJF2IErg&oe=6A4BBC9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6NS1Cl5Hd8Q7kNvwE_GUnf&_nc_oc=AdquW_xReLz6AHBg2wMZFl-F09-AV35k1C9MBMrEdBw-F5Br29mvqAzVeC9EZbjAcck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6FMlPaOuJBljBqpsm1i8pGvP19x0QqwwTm0WJxSzNAA&oe=6A4B9DAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWT7M98pzCUQ7kNvwEuUVSh&_nc_oc=AdrDi1ab2x0ZENhtGzSWO5WYCfhp_G_Bazgcevpb_ItEW502DbzXeE6iv_hf0XcRIFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh4jf-prGUEai89SijwgQt6DO2FbtbW70edpma-0p0iw&oe=6A4BC3DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP6Sa7T92IgQ7kNvwFLea6Z&_nc_oc=AdrM5gpyMhSA4Ac73K2w8NvSNVQCROqrLbjt3y6pJyzHgPEuDwY3xx1PqT7ln3-Ac8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE26Ar0VCEfxet7fy6YabzYee7J3vDV9sZuFkJGzNRhA&oe=6A4BA252"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
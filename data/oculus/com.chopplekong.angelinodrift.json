ent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMZOYvzKkgsQ7kNvwG9-HHn&_nc_oc=Adpuqyca5jAA1jwhgg3jQfuZXFLP3VVBcn-q6lWoGZFBuS9PzB3NNKInfCesGNsW59I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMIdLMeZ97hL_OVmOiXCUV1_hWfD7TS2msHi9cPfdYcA&oe=6A8EC16B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkodfSKUA9kQ7kNvwEfmJJY&_nc_oc=AdqMCDPGK_vRR-uQMeVoONXAFg__7K3MeF7nQWz1lIh88YSB7MWUdAoxZBIwZGg5E1M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_Iti22Cc1c-COamsVO_FacUYMMmj82sdhuovmU3z-Ww&oe=6A8EF91D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we7j0-GODzMQ7kNvwHlbDkt&_nc_oc=Adqn4BOzV3iHwtRMPLE_OM2nH8OR-fbUk2lfvXSzT4_dFzE-VSZ3KI4HykeAjaUKCkk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUAZxAsjvh-BWHkGnntZ49yVR_7Nc1cdtEz4Xbivj8ZQ&oe=6A8EDA2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbOSVEMmbxMQ7kNvwFHTVZi&_nc_oc=AdrWvPIEKri9L42l46AtGlvjoBbKIchT9IEzwHLMoalgwBnT4ja_TOhEDFylbrFmPio&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeAD9wowiLpZe3bHrN7LNI4-3R81ct36P6TDQdCfOyWw&oe=6A8EC81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vLyyev5HtgQ7kNvwGxPD-s&_nc_oc=AdqqKmr_afm9BLMCB-yHSPmkFQ_6K7Q_ebGJiWi7UNolPlYBxMIEPNwNVmiC1wmTPXE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHoi3Jwt4nrubeM4eSW796I5b6P8PEuSdGkIjvIFjb-Q&oe=6A8EDED2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}
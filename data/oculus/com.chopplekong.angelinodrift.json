culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9-aRygUKMsQ7kNvwHzLzOW&_nc_oc=AdrasvV-y00cCHw_Kl59IQNZWs-4WBqIUuymaNpiBNQ5W1yC_Q4rD7PTyK07QpwZlFU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPY1FV7nYELTNrRFvrASztN1rzuPYH70Xl1uYpMcGJdg&oe=6AD0E4AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwnsRuDozqQQ7kNvwESjz-P&_nc_oc=Adp8mJqZLTSo9EnExnpVv7slULAAgZY0J-mGnCY0Yny8ddaKqGbn_Nuvexj1EDJBF94&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMD67LM6GoHjjCAUis9jmLUQjlz1nwo2T4TR85YetRAw&oe=6AD0E41D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_Tpg7gHh04Q7kNvwGdsNaj&_nc_oc=AdpJTsT2cyJ3BWXR6iPRd7cEmtEmPXRVPhQdcYS1XWgZnwNhnyp7f4ky31YGdtaRzT4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfUNS9V4FTCPWGm59DEx-FETJfKXYZVpPzNFfXN3EkkA&oe=6AD0FD6A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp4ScPXdUwEQ7kNvwF-zAxc&_nc_oc=AdqSGxR1MWkHjI1PV_BA5gcgjEOB8dkUrlpeXurroM_0gKKQQlhY2UQXmbXNxFlGr2U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW9XyLP_UgEK0gzNUigsaViNgXin7NE3R5BRKwmFzimg&oe=6AD0EB5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iz-AenD0yAQ7kNvwExhBHA&_nc_oc=AdpuqKWVy2g1Z0Ju5s8nSjrbQR_FddCouburngiuQXlC7DtjYW52LMEwOHejN0jIwyU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFYuIaT3ZqI0x6D5tdSJiDgPjZcEk8URH3qKOTo7qPFA&oe=6AD10212"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1icCgIgJ-OkQ7kNvwGVBm1o&_nc_oc=AdrexKmkUGiC03HZF58p2d1kpFhcAXFerFQYgz_sIqxVjOpSoaY3HP4AOYM2wuCje_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXmO65Nd_3HzMGq6H_c7jui4Ha-i8-E_hrJpi6qAcqlA&oe=6A9C28AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq-XV5hyWmUQ7kNvwF_C-n_&_nc_oc=AdqU9qbtUJahUHsf43W3mSgmeqmuGDd0Go8pl88XbffzFEJkMKlodnMWsIPLKO73Idg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzihfBkaxPi8_dgHDpZQc0SaaPRTitGX2dMMgdE-Sy5w&oe=6A9C281D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkiMKd5GXwgQ7kNvwFKVjH5&_nc_oc=AdqRqBmExBj6QKSZEoJkTpiyDOGj2W74-LbJO-WbYz5fAZPiCJ5oRkbVTohw5l2Ifl4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcRoU-feogTy91TlAlhaRDSfLVzGuWCiWIiW14RIPLbQ&oe=6A9C416A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ictq8Bkt7RIQ7kNvwHJ3kvV&_nc_oc=AdriUGe_YoqCjVi_vs8bBh1aGssXgdk_PQjyk_NsBw7RL4SRYj2o-jPBxxdhHhP7mJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP-0yy8xoBzM1Gx1HCi1u8KTwS4mi6VAZfTqKkheAMqA&oe=6A9C2F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyfPydmuCNUQ7kNvwH8JeKJ&_nc_oc=Ado3iJob-jRbI1F68bmsJSV7x35L6NFJENrHgF0dYktynnaLiveX3LPWFUtdA0fZgww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqxijjhc7sZDUgE-x-70Z3_6nSgaqs478ook3AyA5ubg&oe=6A9C0DD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
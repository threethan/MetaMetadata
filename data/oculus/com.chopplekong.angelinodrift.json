culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EilRpwUA_Y4Q7kNvwFybWRP&_nc_oc=AdpfQR_Xc5yFwt3wWHmdqN30QYG0KvrLX621tKrk3bnXJsBjZGG0N3E66dgyAMaDG7c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af311U0Q6PDtoiU7_AXiTGVaVtGSmHoUoDBOwennXO5V6w&oe=69F60BAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj3bb89GHiYQ7kNvwFo5Ygo&_nc_oc=AdqU2PNDtIdhoJDwvjtv-y7YSHCUOD5i0pHGWHgukBG6OrF8rtzqHypCg-5mTrFYFwk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gZdpLJJEXi6AHxaTvjbCyoww4_CNsrploxvbinpEGeQ&oe=69F60B1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Mx5UCRbg58Q7kNvwHKiFHw&_nc_oc=Ado5Nu1dVka8IWIWyWJmNypAYp10VYz5s9VeSR38BX0YMmwmrW_6MIOKZs0co_J0VGA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nWvhKdfi_cNjJFjfrYuzn-iXobYLDn5ojyaGDHycWJQ&oe=69F5EC2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3yMGJ3ynycQ7kNvwHGezDj&_nc_oc=AdqZZ3gOZxLyhJQHCU15jIJ1eBh-KxGGyDrwYaTGdaTCB3a3eKOZB6ryEgZpTmKs58Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mLvpVaqUXkN4sKyRli8t-mrgtRY3-sU5tobgejuvqsg&oe=69F6125D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvJ73jOyrsMQ7kNvwHvAnxK&_nc_oc=AdoHp94-1QUN2nGyF2pphtGsDEnoaVpl4ZDCpM2Opzs7Cy61C-6nuV_hiqec3yAip94&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ip3h2DyK3kaklPDKSt6t2eHGab2z-fcd9K4Pn-T5zog&oe=69F5F0D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
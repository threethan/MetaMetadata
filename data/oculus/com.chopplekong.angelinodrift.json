culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRxJzAwoCCUQ7kNvwHhlSJC&_nc_oc=AdrSbNMuA25EuixHE8rK-FQUKjHZ7yb5GQqhbgnDpDX-IV9QL1xK2Pp94xoAnuucCHQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMurPdO6-XaZPv4KPL9b9_dWsED2qY-lDK0j10t8-VIA&oe=6A5A3DAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjljEN4lLlkQ7kNvwGgSZks&_nc_oc=Adrt48MghPazrjG1I4QolaKFzihc4eMimOBIZFO5pUFsKXuxV0NHlXKpVbznOro1iK8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPSrqkP07RWGpF9lFtnx-uRfdIr_6ySbvY2g6tfWQcsQ&oe=6A5A3D1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0l9KuxjEG0Q7kNvwFzNE_k&_nc_oc=Adq-gv-THpG_LTH6Vc27WnzH6j2T6VS6XuS_I7nn0PSCSFW7dKbD5PHuzaItNl7pJlA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDUlErIAd1T18EsPTB5VD7B9m28gwOWegGKYUbfSiXKQ&oe=6A5A1E2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cqspZnlpjMQ7kNvwFMO0JH&_nc_oc=AdruTygbPF_ZiWEIPhbpjVs0YfJ-pX1QhqB-wxb7NAjsTbxybVKviYnI30byeeedn-E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxGJ4USfHR0ZDGvufN_Fj8wP9i8cSyLy_KAlhcJJOpkA&oe=6A5A445D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8CXkgmyozoQ7kNvwFUlpl9&_nc_oc=AdpEOULixrczSQPYRNvM9D7S1zH1zMQnIwSVjuszWvBr0TBzpZkXsG63mBoHifGWLWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgtxG9UrVdHtIX4GC84ePNKLmQfOf6G8uuJsZbDdl1_Q&oe=6A5A22D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
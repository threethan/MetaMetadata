.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97RlbZWUkVkQ7kNvwHN416I&_nc_oc=Adq1CQQMaAM7Em2t5JOEE3dH3uFIBcgb3bL6JbCFxqKvJVR0wRZ5ki0bGkFeEn7Tv00&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BivDctLLLGNcmfWwIM4rhfUngheVyvavQctcwX28hUg&oe=6A39482B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-ao75k7sPYQ7kNvwGYsHBB&_nc_oc=AdpJ5G8Rhjx4HL8s1I2hCW-EZtcGIu2kk8mOdI9-afsqt7gKsjpNmxwzgpSh-M8RpwA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FE2m7Ium72t99Kw4QWpbxBRsR-FE8fmwUReSpAD-0-Q&oe=6A39479D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jygNNrt-sNoQ7kNvwFmrLLL&_nc_oc=Adr00vrZ7HyEjDpk5lw1xV4AugWBognKsA_15OBfIp0pBkQIsrwh68KjWrp1g0Nst0g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4LwOYIXcbbI0TG-8ZhnuXvLBamNGcw-U6qJQ_GZ0GzQ&oe=6A3960EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNoO2jWxRvYQ7kNvwFTF4PP&_nc_oc=Adro3FFqaAkU_8asHhxYddbHnx6OdVlgvOC8YCWeuVB6pxrheydxQpPwTQxVZW55yHE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86lmqTQIO21RBjwgzg-ARTCoaeSxp7O4RHbQpTVtmwFw&oe=6A394EDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ7EBnywzfEQ7kNvwEZFbZD&_nc_oc=AdqUqTgRsiPbq2_N7ypyTEhFb-vBn10wpEp6nWxLc11aFA6pGcjI2xbBxe7RfmAkhaE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nXLbd8iueRhnl_POChqVbPtjV-HD57vunBZMFQPMIWw&oe=6A392D52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
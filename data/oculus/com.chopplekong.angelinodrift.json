culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOYLIzzc1pIQ7kNvwHUnPWx&_nc_oc=AdrMbLUp0tfRHPKTCVE0j-nhrhUkkGlZz0CgQ2HHdjhyzSiafHfZllKoteOABg_Q_Iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KqzRf4_-GHa19uEtWymUT7BS2cBgBF-Gn0oExiVtaZA&oe=6A3E8E2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT5Uvntkuf4Q7kNvwFbZLcE&_nc_oc=AdpyQlXTyL4TYcnw5nSFklqGgTzGuC9va39X5lH6PhfMsb71JSJpGtWxyhtmIPXAquQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UIGXMLBjaFD-fEy2e7EyQq08MvD63yeLUUg4j9d_qrw&oe=6A3E8D9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PuGrbcAFIMQ7kNvwFWFAZR&_nc_oc=Adosgw10oO1XT_7tDuhCOJIsnxeMxnzzTQVRhd0zTBkskQUNJ4fAKLnskT6QqJZRIN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p2UCYySdxuMwZn9Eu92TkoZZeJ1OapfvoKb440MkmXA&oe=6A3EA6EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_5LTD7ySp8Q7kNvwH9RIOt&_nc_oc=Adqkbu0-PEII7w2LUNthZ4cSawju9DNpwEY4xSMpFk8VHX0DZjL6PwMCRmk_r9gCBdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9USbZ0bSoKp6YRViXuX_hh39mWsF4NNnq4bc_jvidkHA&oe=6A3E94DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdn2W1-AHogQ7kNvwGASFhT&_nc_oc=AdqBqIKm1S5OMQPDRBJQgfTX-ZnVlQ5wluY8LCf-EkGtkH8Ge_q-ZB1StZDwGpBx25g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bFMzXN_Tzf6Q9-W6p7kyMH13O-dn9lLAy3R0A2N0nXg&oe=6A3EAB92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
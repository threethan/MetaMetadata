.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5h0JBYdugYQ7kNvwF7MIHe&_nc_oc=AdpCEVZsSJT7sIEowsXd_pQpbm30Ytc8ZKASrdAF9jJ1ZFaJQRkPtRsm4N286an-Dco&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77aj9GU2Kx162qeqmxN03sym4yaS27wRCEr90qe70Zqg&oe=6A11BB2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9otJX12MgcQ7kNvwEdm9kc&_nc_oc=AdoetTFAq5VoYjF0IEzhC0zGDPKOIjP7zWgrfLH9LVeupKiHu3hWwEiFdI6zAvqJZSk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vAar0oA5kZwnlcXMKLctkap6-KrpmBF3COX-Md95B_A&oe=6A11BA9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pIZvU5OrCMQ7kNvwEKwLb5&_nc_oc=Adq80yaxIQYIwaOvAcq5Kx8sFK3-BsLc9m6NgxUg1TdeDdKlt6GzMUxw5JlIVJiEuc0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44P7u7vqwOcJ6IYJwzoKuS_O5BAJGVvWuCyD-j4ghvJg&oe=6A119BAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mfXBH0FeVUQ7kNvwF3zMAm&_nc_oc=Adpm2S6PrL3Mnb3yiBjAqg6F13sqItPrlHJ_SXh99vSiXJdILrhkFY6uyDYPpvfFg7o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-0K-UX_Ah02pMaAgHal8AJ51TYjENLH9TBo0kpuB0Ag&oe=6A11C1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIiT9tfX8mkQ7kNvwFn0S86&_nc_oc=Ador3USPYAhQqseREWBsoVwxf-0lxAtszMuCE_rN4mPz_ZHilR_-L77i_KEB70w6D_s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ydBkMhr2PAkw-DYnZRZ9cMIhJMImOB1q4YiHXpJ2ygA&oe=6A11A052"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF2dnPAiJLsQ7kNvwFzXPdn&_nc_oc=Adpgs_4KAWCHEzLVh1c0zhPdcoUUGYSu9VInpS2d2TP89sLRWIrBPNmeMIXT-30tWg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWlAJCsyeCTypJSSXxIgXs-4_fG_a8WLdPveLQ6ZdlEg&oe=6A70A72B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt06bQbzyIoQ7kNvwH6hW4q&_nc_oc=AdrBalLihtDyQQA3K8gL2DHUHB6L0ZVTEvz9L3eOvs0j9soUUZ5W0utV_9xi33J4gTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHef-7c3lmNGApLn640rZxCwqwXK8Bbnotd_BYUCipfdw&oe=6A70A69D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSvafr64JdgQ7kNvwEeqLQ2&_nc_oc=AdqE4vU6ZchhYR39EYtT_M3_vMGxeiKUZQD3XTHIXz314Zn2d74QPsgxO19Htbs8fi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT_rIwanPn6nUFp8G8x9QB3MbMAbqq7aPIZycUGqaEqg&oe=6A7087AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XQSu_FCcoMQ7kNvwEQ6Mvz&_nc_oc=AdqD3U-PGhRKCVhkqSOH6DIbGzkysq7DG7-vm-UPlDDCeAHsWymCB2yRZOZD0kPIV90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNxVkWTfzg1NGMbzV4yF2-fyu76WIqKLaSE25Y2XlPHQ&oe=6A70759D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNvCJ3bbyugQ7kNvwGyDy0Z&_nc_oc=Adq1pBxThkTeiGGmu7FKG1PlGuh84OXGD3H0uH-GcebVTSU96pJ2DYv_Uw8-nG1a5jI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA6XNzK2E7PVVgVpqu3I39nGJkrZc2lPS4skNn8X3y4g&oe=6A708C52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
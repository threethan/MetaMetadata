25231529697_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2rIETQLQ5IQ7kNvwHGTbpc&_nc_oc=AdpUoHPwzGFeWAsxCiPHC3ll3AaHphu6sTVjUDsriTgabK4r-9oCVyu-kuwtSVBYGp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLTJjx9IpU5gIiaQ-z862YW5bLeW2IhBdLFnlYFQ804g&oe=6B0DAF6D"}, {"file_name": "2560-1440-ScreenShot_05.png", "id": "2451847275207818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620429_2451847278541151_1085205529500886098_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KyFgHcpN-YQ7kNvwHTYRG5&_nc_oc=AdpvBhbG-wmWPxF8l9sFWXIDLj7HrazODxlLmji-sowsN8qWgdHna5f6tZKr32XiUf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRe2xMgxsXAwLPRDf4nVuluknUe1SpJacbnHltJ4Q2hvQ&oe=6B0DC81A"}, {"file_name": "2560-1440-ScreenShot_04.png", "id": "1201085911759139", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620429_1201085918425805_2507035246306087337_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlDBRUSofcsQ7kNvwGG4QgC&_nc_oc=Adp35jUHMSxcPekeWHXws89fJds1GAOc3Bc7XkxoA2saxru4pSYNbyU_bxRgKbcKADg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0n_AL1OVBFG4jzH_B5zVXbt-IHNhF_eCSsiOmm6JA6Q&oe=6B0DA403"}, {"file_name": "2560-1440-ScreenShot_02.png", "id": "1335542147907684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618948_1335542151241017_2689273503911203399_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6kXaFeVsu8Q7kNvwFVdpFq&_nc_oc=Adp6wZXYDxdCm2Njsm5APNZRNAx96g_XtXE9fotCaexOVpr2Nx5BAL2AZOmd5IynAAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlIzJ9BcwRGe_g_wlT1TORtAI8X_QyPv0opx70bItQtA&oe=6B0DA8B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440f.png", "id": "1183001563885963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823876_1183001567219296_4562539802302143254_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHpFkdxU63UQ7kNvwHTNvWI&_nc_oc=Adq9t0XnljKNIbhO4It9jtTQJMtniLBnWejSBW7om71URcrNvPJmW8Z0A280nXsGaak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAEGjVqYExpgFHEPxL8-UEIba_R-jJM_QYyfuLUgh4nA&oe=6B0DD1F5"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "Angelino Drift is a pulse-pounding driving adventure set in the dark streets of Angelino City. You play as sharp-tongued Marie and her new driver. A mysterious threat plants a live bomb somewhere in the city every day, and it\u2019s always a race against the clock to find  and defuse it\u2014before the whole city goes up!\n\nPerform stylish drift spins around corners to maintain speed and momentum. How you drive is the difference between chaos and control. Can you keep your cool when the city\u2019s on the line? Time's ticking.\n\nAngelino Drift is currently in early access and is being updated often. The city is constantly growing as the experimental project aims to showcase what's possible in the Quest 3 and Quest 3S. We would truly appreciate your feedback. Come for a drive!", "short_description": "Angelino Drift is a high-stakes driving thriller. Race through downtown Angelino City with bomb technician Marie, to search, locate, and defuse a ticking bomb before time runs out. Speed, precision, and nerves of steel are your only allies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chopplekong.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://www.chopplekong.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
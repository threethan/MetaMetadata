culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNZs0rXIa3oQ7kNvwGIZaNa&_nc_oc=AdrjzlabixFzspm99PsXKMJ_DfavKYtryIgMZ5zZOaSrP3SSUUU_rxXGDKa8P0l274g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtV53iWlcCEOjRXCBg_NfKaSpolMGMe5kOC9YBmbM0yw&oe=6A8ACCEB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6BfWTsggN0Q7kNvwFrHhTG&_nc_oc=Adr_DG50hsrcqI7rLdGev52Yvw6kGDufYUXoHOv-PWBT5wkPc8765mpYP6Iv6xnfbmk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdQgq4ShNXjwrPQXCLr9lLDKzd1J9K25c-e0n4f_qXXA&oe=6A8ACC5D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlkvYU5SWjQQ7kNvwEp_nF5&_nc_oc=AdqFZy6i9Ks-MNW2BKq3H-4k3NY_aA5HwT84XUi6YmZggfVpTqCZIKVZmunQqh13adA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ0XJTK0Ni57o19pNGpYgTU9Y7Yuf2_n-tmWeNHvftVw&oe=6A8AE5AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tR9xsyYjLAQ7kNvwErZf1T&_nc_oc=AdpMwy15r2Zab408Q6kiOkP6Jcwxwxmcwvh-lCe2YoS0O1Obk4az-Y698gL7_H5X_XM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfwFbi32PJJCf22KNkBJ0TyVO4k_lHni-qvylNRP1wAg&oe=6A8AD39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bz3G7A0FWc4Q7kNvwH_pH1t&_nc_oc=AdqxoBxQm1NYqHrCqydERhnFIyanRj-t8_hxQFCIeyxaPHhy5edeLSwGuvUlpRzy2Tg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlpJKonHRH3PX1LhvBIfyP-3SCUn0SiFNLm_6gmPcDqA&oe=6A8AEA52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
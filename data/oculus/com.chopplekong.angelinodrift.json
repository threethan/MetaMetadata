culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkh2H9fTOuoQ7kNvwHzvMEM&_nc_oc=AdoRhadXzTV24VZSSVITTzOA0XRml_CTfUEpg6-BoqbctK6J3sgFatNRX1E5nZLHEsA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53jV34LNzRt4T40Of8KctXNaWWtpyEZ3Q6fTffTTZOXA&oe=6A15AFAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x45pL7i1LGsQ7kNvwEHBX1y&_nc_oc=Adp_nzfvWoaWFEIrka85j2BD9qILCKPKaEmc-ZkMJW1xsNs-spB_hhC9w9feKP2guYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hQvSAEVMPzk6xDgKHdGcw331ZR2UnRA6qUAIfajhSJg&oe=6A15AF1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1yAtUr4v3IQ7kNvwHfgdPC&_nc_oc=Ado2f0sLN6fYOfMf93hQi6spof2BVCOygE-HJhw1BUcyonQH3ccW7wF6jiD5mrmIFkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wk5sUcAzGhUmDYJY8mORn5-PcCzD4R8pvf-4AxkYJCQ&oe=6A15902A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UoE7qcJMVYQ7kNvwG8Vrg6&_nc_oc=AdqbJTVg0Sh80S1T3UI1SX-vMMKNCo8iToQ6tUj2SoyRujdcq-gSJPJCIiquOV1HBhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TMEmd5lIiEe8Nqefl78oHhtzXpI2tHQtB4RQWs1zVHA&oe=6A15B65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7iRjx1ESaMQ7kNvwEHrx-P&_nc_oc=AdqV2t7_4BnXHReVbpgph5Iy0hMIeZbxefcZsMHDVNMGsL91rj1U34ZaiEeFrHepBn0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P3adeyHuxDLnxiX3i-xXgSxC6dFMR6BvCPs3WDhubbQ&oe=6A1594D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
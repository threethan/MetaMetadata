culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SIMZFcA9JEQ7kNvwGITVR2&_nc_oc=Adql3K1i5b81-hozlIsMqbb-jnRrzG7R06Ct3j_dPX_B8MKOAKg7jXKCIVnZnIMLATg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNnSWUzXX7zxBFxFbJACu6t9Nxtrud-rQM6bejq8R5-g&oe=6AEC942B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scmCJWtMxkUQ7kNvwGAr57O&_nc_oc=Ado7LeZUA3mTFYdPxw3rUfHgh4IdzALXYJRuJv1JcRpzA2KjuGDAsJQXVKVh1W3sJtI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmzc48J3En9kNZjJdSkcXYQWbF0-HuZIn0BnZGGVUc5g&oe=6AEC939D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEvZ0U4Lk-sQ7kNvwEhmk2E&_nc_oc=AdrtHvOAQXggVGCfD1OaW-PfKI--txrpyuP-oSU2Vv0vPkR8vpUlszlK7W8T6XaOZTM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm2aGEznbfcSW9a0I1BWNtblkl_wNib5mUaO1zVPaw5g&oe=6AECACEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFAwgWfmQBcQ7kNvwFH9lVB&_nc_oc=Ado6mJPNYT1FpRypmNtwPhULhRUF-cx8CExS65R6VOGtpCO14gqZGmvAkAB3Wp9Dr2E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVJQgPAdihqx4dKDaxrr7xsd68qQQJogd_EfhFu1wsjA&oe=6AEC9ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diWXjoJDfqoQ7kNvwFFoUO1&_nc_oc=AdoGHo0tgsE_-RhL4cWoWYFVtC3SyiPC_ikBINoOKQjpcRWFtGzG0FzlY9K2nHbyB-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVWPi29FkGQIgDLC2uqEjq4j5ACelQtObCYKVEKd2EQw&oe=6AECB192"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
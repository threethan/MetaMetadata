culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hyjy_rQ4VsoQ7kNvwFYCXC9&_nc_oc=AdqaBD5-ed4G_39Mn0yT76p4F4gcw86CcX338vGiDoKUELJ1E7Uu5xGSP8yQZGyrv2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh5rMn9a5Gctjbjy-7THiNQCIrluzNtpcQpB6OehuJwQ&oe=6AB5352B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUnIvD-eTRcQ7kNvwFsKoeT&_nc_oc=Adq7pDSwkrwe9Ih15BcGj8CcTLT9SHgoJ2OruhLYfjmqlpXG2a_odZiHB4qeoVHNKek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbH6kClnaov4hgzJPUs30I66gV4X4V2V_wuMKmjT9DvQ&oe=6AB5349D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-eYGOl4KU0Q7kNvwFPNpN_&_nc_oc=Ado1ZpEIkdc56jhvpOJs5fCiit8aqUU7agWvZ5viwAUAR3eVbdE9sSO_D8b1K8yK9ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCg0ZlswVY3ohtrR9xsLsSFDi7lyqakjyFAvxmC0qjmg&oe=6AB515AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ssy3R2dr_ecQ7kNvwHZbdUB&_nc_oc=Adp7qdWIEwyuRHYe6VJEfkoOUcU6Ayc9eQaqOTw2RLuA7mcOzLVxrxvSJrcmoAV0cPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV7M1mVurpfrclXJXTrDF-Zo_6ZsNhdUMdTxO45aYM_g&oe=6AB53BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym7MRGgeuYYQ7kNvwFgPFTF&_nc_oc=AdoVlh_pMm43QRMjXmuB5U-Z0l-E9-q542a0VSQP5DxxUSGaUanEiqnIZlSpeofI5rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmLH0mTb4cVrNsK2G07O0zPShB97ekcabVJ2r0pW-SuQ&oe=6AB51A52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
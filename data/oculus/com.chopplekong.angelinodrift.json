culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFrnji8aiBwQ7kNvwGm5ZKl&_nc_oc=AdpTJBYoy10tuBg7dakqUR1-zADufhlyNekKQY4nsHzkpViFI9dtPlaK8VLlyEq3hcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENmJsN-I73Oh1XBCU4p9pW2D9lRbxcVTWtLAf08UySjQ&oe=6A95C96B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4yvHEmHHVkQ7kNvwHZ_-SP&_nc_oc=Adpv70ZPSy9mBBQ2Q5HLT0CsdA_CfgAJWGFLj5o72_LBQ1SZEgJwq5qeJQu9GSb77BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRt3rXCHduB_XfgZQGaybNwNlcdHqtBZUozXHzaCQx-A&oe=6A95C8DD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfPoKQIN-MEQ7kNvwERoVVq&_nc_oc=AdrFUicpxDt28kJRdV5AUg9OgcNGXALp5bayaSWZqRYBzGOJFMeAMsSe_s4WeN_DZsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcxJctxTKUN5OB4xeafRyavIThSmZIWJCZtenZOlz9SA&oe=6A95E22A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGxSW1LzOncQ7kNvwHeCiK-&_nc_oc=AdpHdu76jKPHzIxjjrFzlTYZ7hTkdLo9jyVYlIxRIJqSZrd3PIAqmk6Bvfpvpaqxv7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeJm_pUX1US04FcYNtLOdDcV7L7nWN71ShtCAgKSB9AA&oe=6A95D01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ewqk7PsKewQ7kNvwHq6pEa&_nc_oc=Adqe-HbkM5jRstL7C75mke32h90H3IZbzPFFYvbPFlNRSwmaEMJyW01HoGAal3ZUahg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh7PbMz6hlr1bkiIYs-TU-upg7t6iT9icE45g21Npnlw&oe=6A95AE92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
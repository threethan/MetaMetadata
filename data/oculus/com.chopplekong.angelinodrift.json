culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3qPQALpa6kQ7kNvwEgNRu2&_nc_oc=AdrIslKOrN1RDWrgPr2BXlBwTgbpk9tMXOzA0hKSL2qiiBlFuGVgZ97qgHw766m00qk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRwKrs0UaKKJrKqGt0QV--G05auReeI7516GkvsNG87g&oe=6AC8FBAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFKTA6P9XwUQ7kNvwGYhV5K&_nc_oc=Adpzm5jIsSOB5Ro1W7j4JtGNfgkq2TUU0xoD4DEss4Ae4OMffXfirlYc8pCzQdYHQlc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD3HwCNgRSWKCUZgr7GYoy6B4sD1dnvGAPiKr2nj-xgg&oe=6AC8FB1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuaB0aNfLmIQ7kNvwHEnMmi&_nc_oc=AdoHi2SP1ET3lFTwSi1iYkVo0Gdg8eESBK1pCnYagM7j7NOIeSIgHgvKFql93r4apl0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMawxo_CZnhgTs0IoqLJcP1jWaA-3DtK96p1cvpTsiTyQ&oe=6AC9146A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9iXBgxo3WoQ7kNvwEWVUoF&_nc_oc=AdpfX0VqlgvSlcMpy3mH8m0yysAQ0OQa5lhti3WVsswIMKP9mAvG07xb85usjQtjMJo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQg0Y2qiP6BRZyzYikz43SEeJMrCLjdQAFI4OYW0EsGw&oe=6AC9025D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csNcIBfepc8Q7kNvwHNTHba&_nc_oc=Adr6JkzHMwOmjMfuFgK9_q92SQUkYPdjBFMZ2QSTOOg8yENRffKNh5XmvTmavH8va5U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9hWcvUAtbERjh0VBRciV5VVh_ayRJOEUCcUP5FD0kVA&oe=6AC91912"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
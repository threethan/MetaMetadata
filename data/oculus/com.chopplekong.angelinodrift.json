culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1st4Mzi6yckQ7kNvwFJ3J3k&_nc_oc=Adpcs5eqdoIXHcDIO-w8CX4EdPioPtJ7Ch3jCqRrEbaVPPZ6VdU4ToTqIr3pwWxdks8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wx4gIfp5sFk5SQWFRfqMOttQudWrCzutbVvCMJktQJA&oe=6A0880AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDApmnIJWK8Q7kNvwFlZOHF&_nc_oc=AdrYGIY3kz-PDE_vXfqKHSwrNmatE59QpNMexlgjFMoVfGKBxuw4Ib59REofmBGFjB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TlH514Vc7j8-Pnw7wmerre_hOHqBaw3Rf3IVs9UBUeg&oe=6A08801D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUy7YTPBcIsQ7kNvwFygG4d&_nc_oc=Adq5b0Bg7UsB2YbEGbkfYNIGQxaXNAJHrI-LFd-xhC2FDPXlyQzsVe7cgUuXVDlZcFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WpITEYiM4qMN_efhoKaJA-_C44Rn9qEch_0P_fKkr1A&oe=6A08612A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KijalmyIfDgQ7kNvwEztSyl&_nc_oc=Adrgt6zqpUftR9KsKsgv_tyC0my2hLpphNujNJ1r0DjZMcx3PY255-prTk4ABmMJDv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KX5oC06wW6JBUDFG48-4dwiMjNNIwNAy6HhWxCEiFYg&oe=6A08875D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNtI3mFQviIQ7kNvwFjDOpP&_nc_oc=Ado-CFl4WZg8r8v7Z9TS-tPQIvAXrp0NCHEOrrbfqm-P2iOMPVDvvUrR6AhzbLwYtcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af556K1hxB0g7O7ayjhsoOPUlMHX0QEFKKVWtauLaVfKUw&oe=6A0865D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTseeV5Jn2wQ7kNvwFQFVEM&_nc_oc=AdqOSUNvLlephAjrtn-pCtgwc8UvRMsuaK8hSsIQMOJ5FZ1vAHHiGIymUyjmU1lqYKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcUSdWFzdu4rKH08GUtGDhiP72B9DiCZ-5qGSqqWG2nw&oe=6A84356B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLL2I-orT3QQ7kNvwGRYG0x&_nc_oc=AdqhxoPp6GsStNT2E6jKgJEsMNUZW2NR7GTXCmlfgD5DTOXANgaK0jgL8mVkUlLhR1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwScyDFrQ-9btcu1efMRQ6fGM3nNZC9dzud6IBhfSLOQ&oe=6A8434DD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNweTfy8qtcQ7kNvwGMcawG&_nc_oc=Adqd4FxQBj_x238lPHNpxDbrUMDpY--ICC6HzPer7UlP7W4NJ4fhXqWZoVqiCSFDdOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBZqwS_vx_qmPm4PG3iQ-LMkhHa9z6eSVfoKSsVncU7g&oe=6A844E2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5jD-OlIhJ4Q7kNvwGEHuKA&_nc_oc=Adp3zhhyNsHMuGajxk0JMcwopZCDcXPXD8Ho3Gt4MhD66ZVbpseRO4dJ4Eh-zwYlAuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi-gI79u9bYeol8sfFm_TXZzuuNG1PFLXeOsN0HvFlfQ&oe=6A843C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6uYCTcBHJQQ7kNvwFL1ELV&_nc_oc=Adpl7nMhp9_JInXoUO_-kmU86pGUIbhdOWh0Sb7VskhADj9OErbl_YSo_11SHQHDHUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe0NLpQJK79IcAG-npYp62M7fVox9xEMU26M-EQE7RfQ&oe=6A8452D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
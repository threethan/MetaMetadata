culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF2RPs2rE8QQ7kNvwEUSIzy&_nc_oc=AdopOlfzSaQu3eDQ84iK5ggx4a9B5pgOnPu5V_b4xzRrjXsRqeoKa9MeYojD7TuUHI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwWaZ7EWeJFW1Yvh3uLpug2QkNMF0pmG1-89KS1qvlmA&oe=6AABFAAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLhFIThGsDcQ7kNvwFmROKW&_nc_oc=AdrOXReOVpWVdIACmwU_zw3jLsS6WSpMpA0vzIx_SHB3Y0b7u7ejRmSbLdvBYee66BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFXS4NVEzgu3KEEdgVAmGZd-RPDeS26uTj4Ox72wEu9A&oe=6AABFA1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ecXpfXYO8UQ7kNvwHdKM__&_nc_oc=Adpf7a8nOCbI5fQ8v5UrXIQXzQUX0poI_Dy_F1zE7hekJyQdDjYz5SAmFYFh9pajorE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh7ET_sEZwlOv5ZGsEz1xcDQ6gdV-GI5zBs_ZWjf12uw&oe=6AABDB2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PEcr7qO9hUQ7kNvwEgh8Ew&_nc_oc=AdqgbUJ7AnlY1LR2VYcJRYdh5Hp2S1w6LYsJNFWY05m7lIszpRF0hYoORfurRGfQRZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXSgDsyY_DgHW2wj31xZlKY1RCykDaBhLPEC7K1qiX_w&oe=6AAC015D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wrYlUvf7o8Q7kNvwGA2WJq&_nc_oc=Adrh-IuFDloKdPGXxkLxBQwQcH-ROwtU6tR-DBc_V5vg8Ih9gMQshUE5BPHvssFJpzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB31uoBQ38a1p3NxSoz0DmExGI5XLZmSMZZNVYEcQEsQ&oe=6AABDFD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
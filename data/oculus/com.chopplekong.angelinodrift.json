culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLjDBah9CXgQ7kNvwG5-64r&_nc_oc=AdoV0aQ55lLZkaO_gBtQob_KhkhHs9alsmA73XKzQhj_DWmGnGkGUbVUxc7bmWXcIuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH-ycV19PW2JE8YmpFBRlguaWWFa9NlQFhAYp1FbeRpg&oe=6ACE41AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwnsRuDozqQQ7kNvwHScgFf&_nc_oc=Ado31KVtthSs2gXB0sgjahevxHs0sLQpajraqvkBRWbI1aTT0ErrRg0YmstQmKUVu08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyM2RHjWOsiKCwPbHH4a0H-vMCvqIovAFRxqRLV9yllg&oe=6ACE411D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-LtkO0DZeMQ7kNvwHwnrB4&_nc_oc=Ado-zXIJJjosHwxBbNBAHJ5H8Fh_NUt2aYDRS24UsEqUiZimj4OW6hBxpwaHS4Wm_KM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK58YCYT6AKSqKvKkusrX-4ngFiBj_H4fwYp_sEJU0MA&oe=6ACE5A6A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTilnFJpDWIQ7kNvwEl3CoL&_nc_oc=AdrSPs8bnpW0PM2kn--L8qwPAGWpmqMb5ehiwXOwPxKjDlt_0kzIc2z_IJ29sofo2cE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIvkCoqhnUkn3rjkd2A8Ih0_39ixTZJyYwRz6jqUDO3w&oe=6ACE485D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soMMNZopEUoQ7kNvwF1eQeT&_nc_oc=AdqSmOl3gkJpPKszo1a4BAvx51kRpOlGRPwGxGqJI96sALfKcdAp8er7TdeUQBsiwgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkuNV69CyDWd3Uwdc4Jnq_iokFMbh7-Kmmd-P5np7MiQ&oe=6ACE5F12"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
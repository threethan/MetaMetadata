culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGqzMRlbs5oQ7kNvwGgzLxq&_nc_oc=AdprF1rvxWeQebpTub2nLNMN0N2rBCWqsMmUw2i_j2iMkzR507NQ8QxzcLnPszZvG18&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wBMohaiSetUSuOpo4oumjwy1btCjBR-rBAPQNgw09fQ&oe=69F4BA2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj3bb89GHiYQ7kNvwGr0Ilv&_nc_oc=Adpt9yYYgw1myxKBhwHbBpeUxR33CCqeB5ELKaFU7r2pQ3P5YLL4MXdRJHFcEXLzqrU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oK9dQ-G9O5fsp6q-e9Or3HT8OWkZ3ildIv71FJX3R2A&oe=69F4B99D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Mx5UCRbg58Q7kNvwEy9byi&_nc_oc=AdpO9p9OwOo8mL_7ua8ZoILHD_57ZG9wh_yZYeAPPEveHnwHs2VQA51c2mZiZfjFiwU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ycTpHJruu5Vg6PuTlyuJvyJ1NIFvRSVnbsh_rZqCFNA&oe=69F49AAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI-4rN4G6qcQ7kNvwE89RRQ&_nc_oc=AdqLT4gfuiYpzbcQQ-iCZSp9SWnZj-5VXBvZ_8f6Q2aKgN_FnoTMbh04InTeAp48x4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2I0zXIUvDQ5gCJtATiZ1ULGPnK4DVMyMzuFyF3UA2SqQ&oe=69F4C0DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvJ73jOyrsMQ7kNvwEYkPzE&_nc_oc=AdqBenSpX3ez2rE9rS5l5OJXNEkASkaKHmk_I9DLc09Namach_rD8UAopvLbJsizzF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZVNsObVfyc13VsPg5vnnfKVAOKUwSGtG52Kc0hELWuA&oe=69F49F52"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hyjy_rQ4VsoQ7kNvwGdSvxg&_nc_oc=AdpN9Fcfaxqcav1n1LFMHWYM_yng5zrPct9VyG7AzLpdhMlKPiQldFa2COI33GI_Z-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXnivvAu_QXZ4TkYCqO7OtX9-GFYl1E8q9bheHvDP7_g&oe=6AB686AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rj44H2IaDgQ7kNvwH6S3Tp&_nc_oc=AdpyRfEZIgWRGFXF6QuGcNZDQp6ZJ-cEb0p5JnZmsqXIamGldCi-cRBXAxKflHrjWhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ4FTc04vesLP-Tsmk306yK0yzPo9B6LPVyh1R_xKD9w&oe=6AB6861D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-eYGOl4KU0Q7kNvwEKznBY&_nc_oc=Adp9TJ63Yx7uzszv_hK2krCK0L8SfOBKaS5URFB1jDWje4HBDkeimLhOAMGqRWUyRY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5mc07xA4bGUnmkSMPmMw9VDMhSXlbz5Y60C1bTb8lpg&oe=6AB6672A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ssy3R2dr_ecQ7kNvwFHYNEK&_nc_oc=Adq-j3YEXQsb6hmie13v4JzCg9V9K9tA-kjvi3ot8mKhqGGqoFiylTnWi5nP-5oFrUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYzdhpLK_wUrEGpOhCveRJR121S96YRQUV7F4Sab6KQg&oe=6AB68D5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym7MRGgeuYYQ7kNvwHBowTk&_nc_oc=AdqyxcEvcpv6-afnHSbWKct5pjEAHT9K-aWCzTUBZkBcIoi8UnASSeqNZ18uBuTdA5I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjsORpEQu6KbLhzWwOQEu4w3X02FJFydJxsalQtBJQGA&oe=6AB66BD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97RlbZWUkVkQ7kNvwEX7MiD&_nc_oc=Adrhp-oCKvt2UHAnPopc1HH-fI_An1m1bHsECwXz66Fi6yMoHzt4yqpILfn3RKInmkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vg9wupaLY-VaU-vjkVDcfdOVbw3zfhOgjzJtFpfvRVw&oe=6A3A99AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-ao75k7sPYQ7kNvwEO8Bar&_nc_oc=AdqDwfxCEGi7EZQBTeT4Z7ZmG4B7t8p535HZQ5WBWidnea1AIW1NFWCjPcvAo_todz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SgVlThEZ-mZ1f4dzCNlomMhkuE-5w4BVpziyZ5UbW6w&oe=6A3A991D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEe9-jKdtTcQ7kNvwH4WoEW&_nc_oc=AdoaerzLPzDQwZbW_oB8eX9xoLG5ZWUzF9aoTfI4_G5NeCuCmf4k4nix84d6ddG3WKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pPFHddhVUmq1_phEuFu0vlIgmCU1WgbaIXA7MP_LnvA&oe=6A3AB26A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNoO2jWxRvYQ7kNvwHJYCKe&_nc_oc=AdpmN-DwAN4Dz9u_Nrnef_H2b26qNaRXq1pUAsXwHUDlM6KTjrhePDaF-pjxrBx4H-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B_A83vxwIj30yoBr0OaJQuy6L5j-2mJb0X1YdnkudQQ&oe=6A3AA05D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMa-F654M6sQ7kNvwGRPNKj&_nc_oc=Adpw-5_g_omNQu0Z3uAWRF7F-vrbsnyaqsmiqFVavPyhuuumPc9KiA4hCKCKj6P8Hm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_08BqTRRE9a4qkUfUh-RqaBTaFkPxvnQXHoQern-aNcA&oe=6A3AB712"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkfisv79COQQ7kNvwEc5o2v&_nc_oc=AdpMR9TTt7aZyk5aFyQE1s1Sslh_bClQw_xqvt-DM2Tz1aGZYXOprmU773o38Cyzu4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsgEnpENCLbN0vEkT_7JCIY-Jlp0H6SBYMgRyef_jMwA&oe=6ABA7B2B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LSyFmL3RZ4Q7kNvwGNsbtn&_nc_oc=Adp4F0xmEPw26rcUBnuWW7Lwfgon8Bif6s0ABjlJv6DZvhqkbEJe58WpW8R739lzrUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-JQQpns0E1-vlg9FUUz1hWL5z3qOpAdLJqh4i57xvhQ&oe=6ABA7A9D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buhIeMYm1nYQ7kNvwG_BTdA&_nc_oc=AdokzGFGwhIVDJUClYd5-Ty6zOr8dnGXQvewfYBQlnVFozBheFXM1f3kOh_3JzcyRwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8PGJ-kVk-lpnA3jJMfz27JI0fwieU7mjsBYdm31pFng&oe=6ABA5BAA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-gbuLAWSlwQ7kNvwGTCSkg&_nc_oc=AdoXBzJItMyn6D9EBuwigDm4sQIMb5JKSNRWn5dtG9uvfX6pPFTK9LtSJD5SCMWoWZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqL7QiSxjhH1jAbS8-VEODC9GEgU0a02ErR9hYaoGwaw&oe=6ABA81DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfoKOZE4zhEQ7kNvwEKR7Iy&_nc_oc=Adqr4ZfngmeTm17w8eDZ-A1YzHK6-dLagpqwaatBeI-m4L3Rdq29OFlQAZhtfUfmJX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb1ILv7uwk925GTX_u6Fj5aq2rTMrihEqBhkUTIjjcBg&oe=6ABA6052"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
gFbU5L2T138HU34vHs-2inKQ9XDShsLL2xXCJ4C8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1x6IC-VdCI4z2lO2GZLLKYcAQgvsbJE3PkFEm-U9W-g&oe=6ADF6B5A"}, {"file_name": "2560-1440-ScreenShot_04.png", "id": "1201085911759139", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620429_1201085918425805_2507035246306087337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zZCj3QkijoQ7kNvwGZvoW_&_nc_oc=AdoHTpNII2flmxedi79oSqdCEtnUW4fBWH-dnb2wEqiBGRKSYskWCB7OOkmcHUlVKaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn4GpeJZg0GvUeiDX9XSDT_z0YaZQ521n8NJv2sOipIw&oe=6ADF4743"}, {"file_name": "2560-1440-ScreenShot_02.png", "id": "1335542147907684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618948_1335542151241017_2689273503911203399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K_R8egmKcMQ7kNvwHTQ1SN&_nc_oc=Adpt46XXOE8Sh8jJxOhlDUqS1pFBh0i5yFFMY3zO6yIbCYleQs2UudA29zGgWCQDv_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB4Q8GKjslA8nZ0uy2AIbGOObXDcS2IQdPuj-mdQvCJQ&oe=6ADF4BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440f.png", "id": "1183001563885963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823876_1183001567219296_4562539802302143254_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXMfCAeAmswQ7kNvwHCcdw3&_nc_oc=AdrZTwQNjHBisX5wOKXQefAJnR36le0RfGhdvKSF1jOk2NBiC14kYLWRxD0NHntbDeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkaoAqTwVaxZtNPP9MqHZtTjko-RGYAmVK4niiPpXlPw&oe=6ADF7535"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "Angelino Drift is a pulse-pounding driving adventure set in the dark streets of Angelino City. You play as sharp-tongued Marie and her new driver. A mysterious threat plants a live bomb somewhere in the city every day, and it\u2019s always a race against the clock to find  and defuse it\u2014before the whole city goes up!\n\nPerform stylish drift spins around corners to maintain speed and momentum. How you drive is the difference between chaos and control. Can you keep your cool when the city\u2019s on the line? Time's ticking.\n\nAngelino Drift is currently in early access and is being updated often. The city is constantly growing as the experimental project aims to showcase what's possible in the Quest 3 and Quest 3S. We would truly appreciate your feedback. Come for a drive!", "short_description": "Angelino Drift is a high-stakes driving thriller. Race through downtown Angelino City with bomb technician Marie, to search, locate, and defuse a ticking bomb before time runs out. Speed, precision, and nerves of steel are your only allies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chopplekong.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://www.chopplekong.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25272718619001874"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1356272535719574"}, {"status": "CANCELLED", "id": "858884099959902"}, {"status": "PUBLISHED", "id": "724064786851915"}]}, "baseline_offer": {"id": "1356272535719574"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766606520, "status": "PUBLISHED
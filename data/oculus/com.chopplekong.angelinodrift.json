culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTseeV5Jn2wQ7kNvwGCyisk&_nc_oc=AdqB-QOjA0Q4KTV8kLY05sCH-inr308MtUMeLXcACdaQtTH4usxiGYWCSJ6TPj16Reg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwy0KDn17hphgoQEIPCz1af6E0YEuJuvZomXMhAbrGyQ&oe=6A86D86B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh8MzpKWD8gQ7kNvwH2wloa&_nc_oc=AdrjR-GEYlE7WbigruHb2E2LZriXWUUcIMvMOCe1bsuqd08GWcdkpwJWohC4OjoMqTM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPiIpvt0rYz1Z-0GBZLnD8tKqbhCcIPJNBcCc3gUfhLQ&oe=6A86D7DD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpeQ_U-l1ScQ7kNvwHJvIoi&_nc_oc=AdpTV_2sl327LxJbsIIwawQSLghSveQ-ddNqmUKmw5OLr9sY84yZ5LjcSJgh2z5pCnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5RzkESov9puY9DusnoAXhKA1e612AlvY8v2YHIxnVAQ&oe=6A86F12A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5jD-OlIhJ4Q7kNvwFHHfO3&_nc_oc=Ado2ndtxn3nEHKg9alOT2xp4KyoPYtTQVbqSPhJqJkr85nZj9-4BKrDmy2xnSVyMymk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5cxllhqwfFcLRj6PmRTcVZHa49DyIeRb8frigif5MbQ&oe=6A86DF1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE5ZCK9QdQcQ7kNvwHpJaSN&_nc_oc=AdqvxcfTQjSgv3wrnfzyx6h9-oZ831X2xYzhP6TEhMS9mJFhlXqm-BT9tX8tQEEkKrs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk4sFvth_zouKb-J8kGDclDdP6j03cWI9buViSreeozg&oe=6A86F5D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
.oculuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF2RPs2rE8QQ7kNvwGiLANt&_nc_oc=AdpcmCJ-482j_xNvPy0z2hsJ9pIQvr2D_vt9vi7D8SVYnWP_HwoFPz2gMMTmGLWcAnI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUn5wPPG_Maf9hMK0dSgw2PHnmct4TkUNdSuE10tgecA&oe=6AAE9DAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg_IaV86Lw4Q7kNvwGK012m&_nc_oc=Adq8359W_pYiawwCD-6jxuUmrEBoA59sz5aye1RCVQwD7ghJlBMlmag0M5IruEN_W0c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITLAdsMyOb1p7kRFk7oMN7kbqEtbXz4e-gbRnUGabUCA&oe=6AAE9D1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnOuV-1qK1oQ7kNvwHaDAuy&_nc_oc=Adpq_4IuKi5kD-AFZ0d8PCrKVgnGA5mlpOSwHNjBLpONEA1d18x9SQ80sb3OqSPr4D0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtRrVIE3TC296L0qXvaU4d6K4VWur4cnanqXhMooTkeg&oe=6AAE7E2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PEcr7qO9hUQ7kNvwE4Hy5Y&_nc_oc=AdoWcl5e4Pnr8sNHVCWdctCsyrmiCY8EwLbWnOtHyE9Jta_QYutO18KcQb7EnCwqDks&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPStgYtOvr_Yq_BvAd9O7cnyIlzCISuzRnSbIf1nctkQ&oe=6AAEA45D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhdOg9vei2wQ7kNvwFCiAXr&_nc_oc=AdqyQA0cUHeMRoW9kdidOjNemq1cLlzwc2yha1rj-5LFmYItStRcjSW-xyvx0cblhlI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1FwOD2CMlKhH4RrAEerkHgme6F_AdnUeL2nIPdIgp9g&oe=6AAE82D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIXpHR63R6sQ7kNvwGQ4qdg&_nc_oc=AdoJ7Zqoj5o385eEdQ7dMIc4a2616iDCxjnD8ydSYPsb3RvZ9VQvNq_HJogg88wJTlg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGmp5SAFItEZ5FlOGFGD50GgS9qexEszgWFWgsbqlsQA&oe=6AE89FAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc7zsfYD9-UQ7kNvwH-IRBk&_nc_oc=AdqkRI2sWWHRxLoo9Cos-26cw3cqPOUPBaleIab47xe7o8y0I1JlEueSmcsmVG3hnwI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNgWnWbYMj_Zm-hUt5c-RcP9NQKeUbngYEvJ1sSTAvSg&oe=6AE89F1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9G2-pAjbhjYQ7kNvwH29qhq&_nc_oc=AdoRU8L2OpHJDIzRqLAkh3Mfyx54r-qn5m5EC9pCndfeuuXIxSNetqyep7_ZCCN9z3o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfrbM77xYZVXNQdLGGI8giZOA9rDHjQQDqrwPNEfPKfw&oe=6AE8B86A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiUNBlheUm8Q7kNvwFGTfRd&_nc_oc=Ado_goiCXQ6uak--hYYhSzQ_KA6JYxSJcTVNLAQkBqNFvLFl0dNgVX99XdXicIDkXjI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgIzra1PQxuSunHEuMCAbeliyKwrWMpnXOEBZzuO3LxQ&oe=6AE8A65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zNf1c8XtK0Q7kNvwF4brY7&_nc_oc=AdqAQcwbC9x12HAvxYnm2sEbqQcKljx0p2vkxQkINdtNPFjHzQ7j-aqkP2htu6XUERs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgE972FRJAalagaTd1ViFfwIN94vIVeF-sFB5yk4h7eg&oe=6AE8BD12"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
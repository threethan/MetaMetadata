culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNZs0rXIa3oQ7kNvwELbAYP&_nc_oc=AdpO2bzq_npfh7MXs8-onCEMtw3PY11W8K9G8D1lIp_unPmmnLJxXyjMX8ev8oe5r9k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLcO-HAe0WmBwBA2m8ghTM3q1A3FJeBrEr_Fx0ra_uiw&oe=6A8829EB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh8MzpKWD8gQ7kNvwEIf5nx&_nc_oc=Adq4m-vsaRuNld8uwNsgQGXKWJ_cX7Tiz_Jy34wqIWeB4ryxRJE4EXi7xOcgJshmN8c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7PcnNJcN-v5yukS9rpM5IBx8aaT-ZdRxdkUvX_mxRwg&oe=6A88295D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpeQ_U-l1ScQ7kNvwH5dOeT&_nc_oc=AdrcRMTMBTpxs0AAJL0FXv8yRn78ZqB35oSWpdzyEZdJ_wNMqHt0pP7PoNA7PUQrD9w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIiSLR9mfXxbOJMtDvZHafKZF3vVnmNZEJanxOyQmAfQ&oe=6A8842AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tR9xsyYjLAQ7kNvwE9dSk0&_nc_oc=AdqmcZ2ljuGPngzOUZuVz2LvjwwIAyW2hs7Gn3Cae75aod6MUK8_9GTP-yIpwfa2WYs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-FvrItzGJAzDpT4An7uSbwKO2SDsHcQJX4kTrb-YrNg&oe=6A88309D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE5ZCK9QdQcQ7kNvwGdwUJl&_nc_oc=Adq495gsj6_LSRZLhlTiG9yMh2TslE-DIEJIcRH7MP_2o8Q8MyyXOowf4XpLbn0Hh84&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJLxX_lVzY37bj5O5kJ0Pc2LWvlU3dRqbrxg-KIeoiUA&oe=6A884752"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
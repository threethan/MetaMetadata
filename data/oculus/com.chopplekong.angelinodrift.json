culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvcvuTExO_gQ7kNvwFs10EM&_nc_oc=AdoW4pAtNX5tSOWqygwFcDJmMsG0d8JbWMOhdhk2VdR-7D3PTun7U3uQw1iFU1SXTyQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_ecoij5jr98N7yCKl0Og22MTx83oV1YNg97TbYcfY0g&oe=6ADCC22B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9eiLytlwuAQ7kNvwH_sits&_nc_oc=Adp9Gqo0fgRoeib16udsQT2eRuUUZddiHHTfxWbW9TZFdAuLlNl0NjIyUieAUpZFs7k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXcaaVmoOGgXxF6m3gERTZITQsKXOsLdrXxMaIL8JdZg&oe=6ADCC19D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0boZWi9EZlYQ7kNvwH8plRc&_nc_oc=Adre5X7uOS_6dUWkLNJ1zLpUxsaSK5bS1fu2K2vff-c3Tge_IhF1ZeI2_Cn6FyPu0To&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs1_CVGogxTxXeFLajroeleHuoHzxUFNKvVyptDuqjtw&oe=6ADCDAEA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYqthBL0jp0Q7kNvwHDdeV-&_nc_oc=Adrc0D3_cmpOjNp-LfAI7nmA_XGEFSi3HPmm18nsIICiS2-xmlHLkLyQ5c1Z8RMjSEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb5ACgtIFQJez5tqkUvspJHVj25VUp91bVlYQTISAZlg&oe=6ADCC8DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EoQ7UW5AX4Q7kNvwFf8HVe&_nc_oc=AdqZIEgws7wzalTPhhuR0leUg8kSu0JpbNwpmHD2XBMkOkVohYzIPd3YGIsX1XCkx7w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdyl3a_FkZlYssi7Rf0Kdc_nMhpqEZERwjwDzvOftdTg&oe=6ADCA752"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
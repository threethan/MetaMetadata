culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1icCgIgJ-OkQ7kNvwEBZH91&_nc_oc=Adr-Q9ksMjri7pCnS92icdafol0xpuhY0w26w9-kvhZ9i1W9NjJR0_s0Yq7LuP2332M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBQZYQqeuyn-LupCEpBnHzxcD_sMAAYA1axMR1TDphXg&oe=6A9ECBAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-PbsyeC5AIQ7kNvwEc4M-P&_nc_oc=AdrxZeUKEqSSXwWvtYMlQfotiIS1EXT1Evd19TsrNueApGm4yo9hM0wKNDzJcdNz-O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQgJGyocya6wnf6V3t8Y_zvZWzmIGbHVEmm0W7fMt3bg&oe=6A9ECB1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxPezexmx4sQ7kNvwFmi84T&_nc_oc=Adq1y9hM1hi1DQy8cMdLAjJ60EdMOsvjjd96VU983OZd3VbQlw5sCjUpzEI95mS5t4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3BNY3xeIUJ2IjDjRetspQ34fV_VOSuHnp51_Br2xuDg&oe=6A9EAC2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ictq8Bkt7RIQ7kNvwGvIVQ2&_nc_oc=AdoijEH6JjlHkSYDPM74gBZGNfOnuk_RiZ7Fhpmb7g8ScLOwdSqvymo3xg76ev-KnYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDsVTeHJ46hRme6ReIrj95bJagHTrDTY-YRjShNSvDvQ&oe=6A9ED25D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqkgJj3cYOUQ7kNvwFtdued&_nc_oc=Adpa6QKBftZ6kXtklb397-pU94Gn6x_rWDwBOmYt6FSG8Y2AwqQ5Rj9Vf4JHARzO3l8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk7Bzlr9hMZ4ebb7zPJqfwata39MKkIG8TVFV3lu-rKg&oe=6A9EB0D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MrQjVOI1mIQ7kNvwEJUZoU&_nc_oc=AdpKBtxQAnTRGtNie5ANLsHMceLroOxtT_N5OKBxrbXt4067iJ1-jBJGERYp-y3_6bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y9D7teEoXdq40J5pYjz6Fao2k5wY9zBW4CiTnACMG-A&oe=6A2AC7AB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjeSllnf9ccQ7kNvwHuXJq_&_nc_oc=AdqqGG7qiHxJoSJyYyZHLRxgLXWDMQNwjyTphd34BmfbJdXZ0g154VgGMYPFu5sm2QE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UZBmnjyklRdxtFBj91yJ4Mx24MkIp3fcJx7TU2R4AMg&oe=6A2AC71D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6Y5c24V86MQ7kNvwHgYs5f&_nc_oc=AdpHk-hkhY7tW7FREACgf5LsN32getWBtKgsjRHr-877agp7Rycnpk8N4s7LGeM1zwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6TtOaMAomfz84I1Y1IeAa-IU3wYMTJD1Y1B75cu4XXw&oe=6A2AE06A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4b2WaNLa9AQ7kNvwGI8NYX&_nc_oc=AdrC4-ghgu_yyL6DwXNRT3oTZkUcI7NZTeW-mv_DEHRSfnFCBWhxAV1dgpY8XlcBm8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ifvsxOGYA5FCRGitQIUxtx63TNNGQiEH0WDT9hbzmVA&oe=6A2ACE5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQXpceBglskQ7kNvwG0ZkJx&_nc_oc=AdqsnYutvTf9Aek0YboY2QswGlbv7E5AOLffpKoZC1YnhKwrCmtEXtMrOeP9EQRxH1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vHOyjq52owROqpdol0ehUiMLfpKo1F7m8IRaO_ai50g&oe=6A2AACD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
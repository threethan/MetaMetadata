culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFrnji8aiBwQ7kNvwFk-X9M&_nc_oc=AdreY4Gl57NMMKdx2Xr8V5C9xknbS9OxEOTzOperEnEHiYnk1pD0hNgHQos1rdv7kTU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF22OaQ2r3VtHSSZIYEtTKX4iA6SFYyGceVD5-csA5b8A&oe=6A94076B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4yvHEmHHVkQ7kNvwEUt7V6&_nc_oc=Adq4w2fmZgFG11XY-i_yZWKHxyKTcJlf3D_gCIWikpvyAeZmdDGxe3NX6UyMHpAaPK0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHniNxTQzSbT6nxKMep_1JHynzPEohix7Z0bFoVqQYSlw&oe=6A9406DD"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNWM0rENLZMQ7kNvwEQhrfy&_nc_oc=AdrN8bFJtlQk-FO-PyNlbIaVHm6ysAYIfY4avtshNY5dXw91WwAHgM33TgpQhgMcaso&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-QroIxHOVqItfaGHQsn1hllXZHfWrAQJ4yIYosVNBlQ&oe=6A94202A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGxSW1LzOncQ7kNvwFzzQ0H&_nc_oc=AdrdorIG4PJCLuJT2WojukJYKnGwEiVox7xMDyF69FlZ-KzL4WEQQFXdF-lLydCUSvY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhKJsiyhC6Z0leDeD-GVvDw5Ow-E39K_4sSsHpVNjt6Q&oe=6A940E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUy6hgf3DMIQ7kNvwGicqHD&_nc_oc=AdqV7kFEq-sTYCvua766E3rQ5BA1PSf0mzWbmQVEVv4z9tgkJkL3h8PS7z_KcYb1avc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAW1yLx_DW4YrfsPf3LV5Vj18YjyJYv5zt7gnaxAmmaw&oe=6A9424D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
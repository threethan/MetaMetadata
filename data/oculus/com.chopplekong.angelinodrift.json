culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOYLIzzc1pIQ7kNvwGHXZ7w&_nc_oc=AdqOdGTet9S9tZq3lhOXhRZBgJHZg8gyCF7rkzrMv9Dl7faYEEiX6y_Byy6iCr2jN-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uVCB24LYPcRbi-iajCet48PbPF4Ynj3rRMsIjD6k-2w&oe=6A3FDFAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKx67QxSomEQ7kNvwHCR84S&_nc_oc=AdpvfgSHQUFxn9VI19m9_0UJrl9fwC88sLlHVQCRsJill38XXt0M16lGsD8Lkixj0h4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F1uUh_IhwOeLOJnxq4wq3RmDqnurJlU9CEnEeI5SzNQ&oe=6A3FDF1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PuGrbcAFIMQ7kNvwFDz0OX&_nc_oc=Adq9B4SAErIzMEZmktoFx3uJfhMrsY1Xcbmke4oJqBAlFNwtU6cftaVO5N_vYwoC1u4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vrQsgv_WC3eMkz057uf2QmuBeDuAOaHpGEcA4HBo1cQ&oe=6A3FC02A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_5LTD7ySp8Q7kNvwE5GOyu&_nc_oc=Adpidq0PQQbHMqZzAQKl6zuUuCK2C8Z28tzfwT59Nw8RFlmrRJcLttSJ_3ZqZvFFY1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qxloY-GwoVcUt5J9GYuXcLtQBJaPHKsaTUssPlj-PmQ&oe=6A3FE65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdn2W1-AHogQ7kNvwHdA7YZ&_nc_oc=AdrlwptdU47w3KDPbnR21GqEhht9zN8nYmshpjUskus-tVmiKafSkHZhvYlifZ4m9R4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I42ZCgLjWZeEnyDLvMmzbmtMLMyO-fH-hEd3LmWdRMw&oe=6A3FC4D2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
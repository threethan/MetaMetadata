culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teJV2Ey13y4Q7kNvwFr3o7H&_nc_oc=AdpCCH2ksrGXdA2QiU5MCfAFF6i15nRgU_IG-zI4-hCr0UHpX9cL1ZKI0XMbmeWNYeY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64i3yam3NlRY2ft18Cu9RoSDPZCRZ9lf1mjletHx35Zw&oe=6A033AAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgoDeMaB-jEQ7kNvwHkPQvW&_nc_oc=Adqy8-GM2cxwRlh5S-tS31k2-Jqb4ytoOWmn7XoB01jmMYX8jS2-vtPHQMpbX9QBH9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pap2bG2N0diVe0a6JN35LbsmrsGC1sTgQcmUL3lPxvg&oe=6A033A1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K27D7xqncbMQ7kNvwEO0DhM&_nc_oc=AdoyvnFuaT894-tFr-CNP8cjybWunJZ1DACzq52bkyXJrCKiXAaA6glTQ4-od-oZyh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WKmTujuLjn5XfF94wk_T3bMB3zyKvHKFceXlzyzoG7Q&oe=6A031B2A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cm1YCeNCqQQ7kNvwEVkIVn&_nc_oc=AdoyH4-MQUTJStTpkVhVao8B8dhaxXkoMau_xhKB32Xq4PDZlsiwF2YhFZd20QbAQYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bh-uDxCgH6gzllxBpGaX5ciU8-Ezjcx1unhSnRDkbeQ&oe=6A03415D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLnP7pCSV5IQ7kNvwGW3s8I&_nc_oc=AdpB5qicS8N6p7QhcJsKxIe1GFumpqumgnTOFUAfRvgQxFiQ3BNVAnk3yAKyXO5C4Nc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EsHl3ZQmjlhCKOTbfowupxHNQx-TbGb-MIJPcUwI4qg&oe=6A031FD2"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
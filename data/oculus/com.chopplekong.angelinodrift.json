culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIXpHR63R6sQ7kNvwGuWKol&_nc_oc=AdpoUbvo3zxwJ5U0ji1Rm-knhjzLOLVwCo30IkF3J9ScYI1RJNNN4iWoV-JFYmLDTZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqw3e0_fGHfrctOfx2YI00ucf2iv_vW6ABrCWdLpcgrA&oe=6AE9F12B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scmCJWtMxkUQ7kNvwFOUVS1&_nc_oc=AdoxOvwwxU2JgUYxqowtpv6i6ObxCewaUxezeM_9aAnJ9if0imqqiKqz6-hjHDjvjFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjjuGFdS_F1a1IoAvBbbS8X1B0bEStjBbtS_mQEXzMGg&oe=6AE9F09D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9G2-pAjbhjYQ7kNvwF43p-F&_nc_oc=AdrOIlPaTgATffZvvyBodpOpWMrpLPe53dMoWWdvqHnZfPGQ3kSvu-CEsMdq67tm5og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlUwbyUM5tlxYp9jFgJd8emY8YALD5-6e_f24VsiSLyQ&oe=6AEA09EA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiUNBlheUm8Q7kNvwFbs72x&_nc_oc=AdoTD8X0DRy7fNEiZKgY9tVmcHAxpegYiJ2A21dHVlLqmUuE6cbmIauOGNNR7ENi33g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSftpQj8992-pf4rFbt5q0bEnWGARrZMUZfCCy8g2Dblw&oe=6AE9F7DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zNf1c8XtK0Q7kNvwFA5fO4&_nc_oc=Adr8VbwxTb6AJJtaevbexs9OXetUIm_Jwl15dVQYvp9yzTlEYV-LYrg9h96XLj24x8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOOk6o2bY_rOrhmzoPyY2LZ2NVUi5uvSgZk8fM_5Lo8w&oe=6AEA0E92"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnAGpmAs938Q7kNvwEYSiVN&_nc_oc=AdrhsKhkmiGqRrTP2_jeG4p57FuODAruFACXr6Ac2-xdGbBYG7d2QQcr5-cw212rIxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPUAkdNVRDdQdj-oJDv4z5dx6v-ndmz4hhMwxIv1J96g&oe=6ABE6FAB"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOBxdhqYi3oQ7kNvwG3Fz3l&_nc_oc=AdrWp8jg3uv7eJXWRjbbavFLEXilo1LJGGGo9cLeQbnWvLf0fYeulZr521MsB_dn9c8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6VSlRpBFKjxq_K6Z1RgIKkmkNrrezUEeI2wtWescktg&oe=6ABE6F1D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTcZcpeA50cQ7kNvwGW5hVX&_nc_oc=AdpYysXCUZJmBmZHmG8n0fj5A6SfYfsHQghiDOyHwx5Fedf1LK2J9DjZNkBvJsg_HWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzqgeEHQh_92iAGuWbdb8FwNAyq38WCnEZDzzsiR-6ww&oe=6ABE886A"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFNNpCDDKHIQ7kNvwGHgh6b&_nc_oc=AdplnUtUL54WIsxTjp5v9cF8RoEymzPojwU3_U8Pso-LDCMdP5AXn1qGN_jLk81Q2fI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhLYFgecQDLV3eB1TO45BeZ4WkXtPrjgmu7dAelrNZfg&oe=6ABE765D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMtGO2A4lDAQ7kNvwFcVapm&_nc_oc=AdorjbNntwzq99O7if04k-NqfrAjVSwGo_qyq6spVAXmkksDNLNytDmygigBK1eUp-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_kMJlQTA3T3r_XOVHq0HAbu8BmmNHkCAl5BK8w71_WQ&oe=6ABE8D12"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
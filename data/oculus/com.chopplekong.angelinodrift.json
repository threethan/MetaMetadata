culuscdn.com/v/t64.5771-25/499619098_738650735274742_1191260511804303558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCw6qxvlW50Q7kNvwEKoyeE&_nc_oc=AdrbEoI17ei73fNlls5IUHqvSUxQELoAYH6ngMfG9qAIjheq59C5WFTA_GBmM0n_95s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-qc9f6Tt4zu09GnSUhzG-95b8wsu3je6uFhkhroG7wA&oe=6A5E322B"}, {"file_name": "2560-1440-ScreenShot_06c.png", "id": "658444330213869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296543_658444333547202_6509501290004932661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJABbOxQfTYQ7kNvwHipGlH&_nc_oc=AdqQyWxmMBQreltEGA9FIxY_IX9nJN6CISW7m3q0ib56h1U5JXxBjvkk_89VILO1vCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOVpzNO7F_Ugsps4qhHyyrVPMP_izX5qIVcNwL1sCRuA&oe=6A5E319D"}, {"file_name": "2560-1440-ScreenShot_01b.png", "id": "887122793968419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_887122797301752_4885082875316535478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTZtpCOv60sQ7kNvwHBLTfv&_nc_oc=AdrlSh_ehiFQu62GuSCubfGBqOBwuQL6SfCg8yQKMfL390fAR4GI1TwtJ5dWAi50X0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU3rduk2Xs6zt60HYxZjjwKcUn3kukL27Kl2KxOE9hnA&oe=6A5E12AA"}, {"file_name": "2560-1440-ScreenShot_01a.png", "id": "1112963063772783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1112963070439449_2989880015578724071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IrVPELjdjAQ7kNvwER7nF4&_nc_oc=AdoW9Vr-XsNvo-7aSP7FAD0F8TsGE7VIWzUGIB0uGo0EM-nyD14IBf60koEFqsOpGGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9zXw4kpdDg852-_wYmx9ZBy93N6llLFSWtvjR5s5ZUA&oe=6A5E38DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440i.png", "id": "1356757789265914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831778_1356757792599247_4587322783342260855_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybAxq51784EQ7kNvwH6FL9t&_nc_oc=AdrG0TmEenCMU_2CFNP3K5WdDYJH9nlDzQoBUUYL8YFst4o5FTHmGowhSUJ3vj2Qmos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVWMA3J9LZfbjAQDxGyIZdjIgFT7v9fznHxxLhUCeReg&oe=6A5E1752"}, "display_name": "Angelino Drift", "keywords": [], "long_description": "**Angelino Drift** is an open-world driving sandbox set in the dark, neon-lit streets of Angelino City. \n\nEvery day, a live bomb is hidden somewhere in the city, and **it\u2019s up to you to find it before time runs out.**\n\nYou play as sharp-tongued Marie and her new driver, tearing through the city at full speed. \n\n# \"Drifting is the core of everything you do!\"\n\n{2241587696326965}\n\nSlide through corners to maintain momentum, shoot enemy vehicles, and smash through traffic and obstacles without taking damage. \n\n**While drifting, your car becomes unstoppable, turning the city itself into a weapon.**\n\nThis is a game about control versus chaos. Drive clean to stay alive, or embrace destruction to clear your path. **Every second counts**, every corner matters, and hesitation is the fastest way to fail.\n\nIf you love open-world driving, stylish drifting, explosive shooting, and sandbox freedom, **Angelino Drift** delivers a tight, adrenaline-charged experience where momentum is survival.\n\n{1373788140951519}", "short_description": "An open-world driving sandbox where drifting turns you into a high-speed weapon. Race against time, shoot rival cars, smash through the city, and keep the bomb from detonating."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support2358.wixsite.com/chopple/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chopplekong", "support_website_url": null, "website_url": "https://support2358.wixsite.com/chopple", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597815049
5/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i-NkbdGk7QQ7kNvwF4Lm8Z&_nc_oc=AdoY1hiYcQXESbL8yURaNt_qKYIDM4y8d59D7riUjLgSBbz0PqHRWI3b_tUvYGy9krw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvLLIEUO7kOwk0b6gR6jk9vZC2V3RXlPsRLGzJdC14Bg&oe=6AF34551"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVqUHEDYm_MQ7kNvwHOwQ6m&_nc_oc=AdrWXWi3CTy7897qa0Qc17kXPBfXKfhDME_Srm5YQlgc8BynYsIaRZS99_AjI6J4pSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAUsiMnYaJi7G3YZjunKbFAorEXU1En1sPkZykqNSCbQ&oe=6AF35908"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPbn0BMQJ8oQ7kNvwEbous-&_nc_oc=Adp6g_6UlokzwhQyGBAcTNAfsujbDZ5dMbnf5vCQ-pasQSMuymUNW6Jw1zobqQx98jg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqesqLGOR_Nc_pfzft6dSJuZ-yL_uWci6Jq3ZJUh0pbQ&oe=6AF33273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kSsXYUigUUQ7kNvwH2Gd5x&_nc_oc=AdrslGRGY-MNqti31PXF4HsLOCcsjAZmsH9uh9jCULxRp-uHYpBAorRaPglQxqGYyuQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Pk2LyD5Y3uHOjgn7OiPkSevEwyR514LkpzgOaP5GOw&oe=6AF3254D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png
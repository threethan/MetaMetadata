kNvwEQe4Ij&_nc_oc=AdoJolsfz8vU6_LhqrAtL46Ich8_uLupJ12wU3j81XD3KvAQbxQNZ1KZHn1MhDvwz1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0NZICuejwSOwNIFLNHHvty7aF0Cu6-CDp5zmV7shZdGg&oe=69F0B712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djqJJp35BKYQ7kNvwEWxLff&_nc_oc=Adqy54ZaZ4Fm4vSh202hSB4cWUAgRTVdeY4Tvvjhb_krEpU6mwaNxZkgBLSynsBFoVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af07maEmIpipyCVOmTE6DE2iPlOs_A89TQjHh_LhkCw5NA&oe=69F0BF4D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience! Explore every intricate detail of your dream car in stunning photorealism. From the sleek curves to the powerful engine, you can zoom in and inspect every angle as if it were right in front of you. But that's not all\u2014take full control by customizing the car\u2019s color to your heart's desire. Whether you're an enthusiast or simply looking for an unforgettable VR adventure, this app lets you bring your automotive vision to life in a way that's never been done before. Download now and transform your dream car today!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. Change colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/"
_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_KaSRLJvAx9PeGz2lFKbJLGPPcsgIge49RxQmTApytA&oe=6B031B8D"}, {"file_name": "vr2_e.png", "id": "567231339741027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCkafIWTuBQQ7kNvwG_AINE&_nc_oc=AdrpB_d5sbtVJDvYHgXRvS0ArApUk5AKb4lhOMrGSJGOi2CBmhFJ1rKEo9PAEiITfxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklNyzNUrHOP4-SuRUd40g2tJJ7cENROyhagYLU402xw&oe=6B031751"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EDDfZ955X4Q7kNvwHitpLl&_nc_oc=AdpzXjlf5Pkj7EZ1FCMh8EX-RWU3i-bP1yR2hv6pqXWKcFu9cpEVXYOEu6ZTiPuw76k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRN-BzDJTI_RTmW2BD3ZkpoiSnqvFp7rYOMA3qRUw6zQ&oe=6B032B08"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_YsQwV7cTIQ7kNvwHG18Mu&_nc_oc=AdqB7pWrvMhclF2qXPWFimwWcofKhYDBDdbwN4jlSU5xJaTQxolmkOHiXziCa2aM4sA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmRXrXc7sfeHSD_hJZ2cXj8Go4RjaahdsXviy2F4i94A&oe=6B030473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSBqaI-P_kYQ7kNvwF4kUh4&_nc_oc=AdoDQ9ZK9HVmiMC3GWG8GQdoviiB1FXOzQx-N6DWp517tMYYpPHElNlSuJWHkbWbifw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt6ynBt78PoiT8L1NBFmaLwx0x_kLizWcIddlcgg5eBA&oe=6B032F8D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlNUC5gu7SqaP32pEUyrV9RX_Fo_rAktpVIjr9324Usg&oe=6B09B30D"}, {"file_name": "vr2_e.png", "id": "567231339741027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HavEQjkmyx4Q7kNvwF1DN_n&_nc_oc=AdoeBBmPru2Fcx5f38bm3nNizKouQMk_n4EFyIo9IDOTTLUWkgQbZ3Crj0uiT8sUCgk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFxV2uyZwjTVwbQP_Wu2-OYCJQkDY9Jpv3ioEx25l0uw&oe=6B09AED1"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeqkZBKYEr4Q7kNvwGqvE3Q&_nc_oc=Adq2zVGm83wep0fK-vaYu6QmyYTB_GnKqPP708SIJUpxTP0IbhP_D5LZYpe8PHOIyFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ZfssAWvm5z9A_y5diDQjqreQ-KNQzjR1UCXvNZUMbw&oe=6B09C288"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlduOeoGmUgQ7kNvwEAambr&_nc_oc=AdrVGg35iaIrXHPjyBpsFkXrTfh6bnwM_F4CEMc-dp4Y__mtpnJCXWypPQXxvaMRWZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwyGO-zlg4xaLaMkfIr46yDZFNDe9GOGF7p5oYLTN8Zg&oe=6B099BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chPAlMzgf-4Q7kNvwG7vLNw&_nc_oc=AdrnT2Z-7pwZMur4zP8cCfUC-ClLg6oeRIR4Rx5TvCLQGnU2bzrRMmI9tsR3Fqzsgho&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Ru9o2pr2HiFwh8jlE9ftrOwDXIXJygPwA-xxMa13YA&oe=6B09C70D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
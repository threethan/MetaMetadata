5/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrtPkTPXkNIQ7kNvwHYJ4T4&_nc_oc=AdoWlNBuM33a-weBY7zvakQs3YvTXJWp20Eyp9Z2KKH4TTgs-9HhQr0RYwTP3Dw-cVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fwvizxynpnJ3G3zB3yQCcPH-bwnY0JvfgSAKQXJNUxA&oe=69D8EC11"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIw9TbWYpgEQ7kNvwFFGkKO&_nc_oc=Adp752Hvc-ZtOYqKuTqGmmNp-Sd0yOXNu9eO4njTR4x8OTMEymaf-vMkBqknHcxK6PE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rd6t68BR_gFN4SFEsybFsAigVxhq8DIP10bkkiLtaVg&oe=69D8FFC8"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_W8txRC-vQQ7kNvwHken2w&_nc_oc=AdoDhL7EbyT_gE-eOJhKAhPu1pYnUSbpgsfS6SQEAHGUM_uG7MOWLXuN9LeHTFPvNGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bBo6DqifY7amqFbKTSkKv87QFXegweoe3BQ4YeuSg1w&oe=69D8D933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTM_IEzYefIQ7kNvwEh-MJq&_nc_oc=Ado28QYrp720CShRCzh3FW-LedTih4jYg-k8Xh-erLyAOtqV6ie7r6MRpQBB1swPuIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1a182plQgVboq_MIb1g1WCCeOAG6ibqKObGAsJ34tWSw&oe=69D9044D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png
5/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVoVNpsZivcQ7kNvwH08ACZ&_nc_oc=Adr39ZkbBYPnkj34wQDbfQQJwOEUu0zHM_klMjAR8ZU94Kb1Ro2vOUSzpEbuOJRELkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNVFjUFris2TrBe1GMyEKEfzwKDOKrNHu0YCywMQagew&oe=6A5B7091"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOAgq_tFGT0Q7kNvwGoW6Lf&_nc_oc=AdpzwC4ri_Z_LrUSgOGyHn0cVlBqKKsaL78Wu3zziiJlFPgLXsf5GJdh_t8L2hvl0lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZz4qMlEd2IzORo5Spdzhnm7BeSvvhPO9G9lyLc-oEXw&oe=6A5B8448"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUZ4OLkRYEEQ7kNvwGA0Ufl&_nc_oc=AdqykVtXjeWyYYGNys5H21nN6IL_jPfuL-LVPEReQeGf1_eSl4H-Cfm91LKTJD020Xo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhQ-bI9IYLZAouF8_xhkV2aD4rl3zJRvJPDs9FBi9lzg&oe=6A5B95F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-cxpfLdaJAQ7kNvwFmcm41&_nc_oc=AdqL1p27wGq_CS00dfuWyvIeXJAvTMuhpU2jc5M1SvE9rDkXl5rjCYCS7eCdQkWJiJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFFePV604TdGph3_bYWnNx5ZmfWa0asJfHPLMMeWOGzA&oe=6A5B88CD"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png
XH_&_nc_oc=AdoGnqsQwTCNm4PUbM53pwvguLvDQYArks0wPuIsfu-8r7VbVtDD4HndQNO2psdF48s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af03C8lkV72CXrB22dEiMrctNJHKaZlkwlMJn5JvM-8qBQ&oe=69F0A711"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyhYViNbaWUQ7kNvwEoDsPR&_nc_oc=AdrGLfsT3pBWbGAOg8yf69z46YvkskSm3W-R7VbBU2I0_AG5m5HhmuNyop2mlYPgPtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0u3s_HZcxDvIYSNjdgq1MVYGORHhgBPMKGgd6xiNHZ4Q&oe=69F0BAC8"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtfsR9G5PKAQ7kNvwEyHzxo&_nc_oc=AdpdA9ox55Ufiy7at7zDQewr-b-s5OXL0LYlmkt4FEM8RrRCp6HcUQcWh1meb_Gxypk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3JHF7Sn6J5ccxuqJ8c9uRSFlAvoVywu1BZsKbNcNxy8A&oe=69F0CC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djqJJp35BKYQ7kNvwEWxLff&_nc_oc=Adqy54ZaZ4Fm4vSh202hSB4cWUAgRTVdeY4Tvvjhb_krEpU6mwaNxZkgBLSynsBFoVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af07maEmIpipyCVOmTE6DE2iPlOs_A89TQjHh_LhkCw5NA&oe=69F0BF4D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO_4M0_b2jIQ7kNvwEDqzjV&_nc_oc=AdpgDsBxx_Dz69_1_bDZgcVLrY8gy72n47G_eWkreE35ZBgDmUFa7EQF55jBVMLPpRI&_nc_z
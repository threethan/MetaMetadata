6D"}, {"file_name": "s5.png", "id": "1250179323384252", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391911_1250179326717585_8197893802591054754_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PE0MmwL6HEQ7kNvwE0QqRO&_nc_oc=AdpMEHHqm36W-HaL_v_-TrPneAqnMuxqh_ek18NqOUtk82qkejRAdGPhS6r7P9kBMZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8vdGPJp-v6RX9vyjTH7rTpNqxx7L5KnFyd1YUzYAxiQ&oe=69C14112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6kMjjSU6-sQ7kNvwEK4kvM&_nc_oc=Ado_kln8a2tix_8M0kVV05QLnDIQM7UxxRRRTEoEWbtBeiwY9Tj85QgQOx1wByBdWE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOpcOuEzm7V2znmOJUIyPYJ7DviCRFqU-K2Yl6HMR4oA&oe=69C1494D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience! Explore every intricate detail of your dream car in stunning photorealism. From the sleek curves to the powerful engine, you can zoom in and inspect every angle as if it were right in front of you. But that's not all\u2014take full control by customizing the car\u2019s color to your heart's desire. Whether you're an enthusiast or simply looking for an unforgettable VR adventure, this app lets you bring your automotive vision to life in a way that's never been done before. Download now and transform your dream car today!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. Change colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_na
5/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB_xsEHxmo0Q7kNvwHXlXsg&_nc_oc=AdqQ6SFYo62rBAenOMzAn_ea-iDPccJ8JKzPwHLnKTNF4TPEJGpsgCNjnusbT4XCm3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3U8Q_xbW_CZb8AaTkcNpB0tVynXwV_fGnf3piYCbGvg&oe=6A747D11"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFSkpnfCllAQ7kNvwHYTvfr&_nc_oc=Ados6-2PnxVx2Z-Pu_JjB8Ww6MODlX9YTVAm6TMdu2_Oj0zqrSTJTfW6va3aqtqStyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcjc_pXnt7kpK3hIHJEXxJapupvEBPmMzJOvXecfmMgQ&oe=6A7490C8"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2N7iLlyBJAQ7kNvwFW0PeP&_nc_oc=Adq6FxdgTLU9MhyG7eRBBSFGDGxwgi-syZ7pyfF0dyWRublhRdzn-1irQWqgvLVlnXk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPEbOGlCfJvcdeJ5erfvOaSHP1kUBzqv7ihgzEAkhkAg&oe=6A74A273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7ZLiRvSpCAQ7kNvwHRcOM_&_nc_oc=AdohwhsVVRs9HIQTLhMcNvOqsYgIkSzjII_j5b6o8dCEhZiXsAoWBnx69HyferRg9y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNnZf-u_BvOTl5jVCbJJsg9Bq0afaOxrNtlPtbkG_Olg&oe=6A74954D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png
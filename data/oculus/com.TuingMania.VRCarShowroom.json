xqKHLq0TX013ZOFkws87e6RLC0fg3ITfS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdkZpduTM3azoIfa6qGikaFl460gzJ96wRq8_N04JFJA&oe=69B15F11"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B0PNL3NYAgQ7kNvwHJFtp6&_nc_oc=Adncm5WSMoCAvzHw1o95uAbuVAy0crEGemNiichYw8qevOzCwNKirGvXHKDWp_72s84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLp1kLePsK7fiffvLMdVBTnhovq53pQrDXSuNTfElziw&oe=69B172C8"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTd7TLKu44YQ7kNvwHjK7NL&_nc_oc=Adl-1l_sOidZzuJeo-BYDM1MjTMyFqVd1835LxLq8ouccdQm6ydRwwoDnfSYJAnkrXE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0Q9_942Jt5wi21AReFQEqT73oPPMbZscEGmUBh9RTLQ&oe=69B14C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjJjJOdyk-kQ7kNvwE67hKL&_nc_oc=Adlc9PX22eOAR_hkI7vdeLi2T7mRd3acMnR4QYuiDe1MU49kaWxa0jOaA_JaQ-wyBLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNU_dg63PGfZ_X9SytUN-I46BnnFc94-hOWPGwPOP5fg&oe=69B1774D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJmLiFiANEsQ7kNvwFH1OnZ&_nc_oc=AdkyeMHO1KV0jcmlu_7qtEhvhHv5mHk-3JSJnhVGkqot8iLwpMowPbL4T_wHU1cI1I4&_nc_zt=3&_nc_
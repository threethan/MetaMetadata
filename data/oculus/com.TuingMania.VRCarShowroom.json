ent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cZnidKiScm0zf05g8MA8ACz05AHoIzpAqM8MZul9Asw&oe=69DE476D"}, {"file_name": "s5.png", "id": "1250179323384252", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1250179326717585_8197893802591054754_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5li6lht3EEQ7kNvwHYyPKm&_nc_oc=AdqYI8V1PF0acZ8Er_NN4NJoBMip7XJQVNZwBkte-vcaTuOJLL0e2qOw1lAIlSRMsAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af263aZUez0Pz49P0T8yrjvq0J2AvH0mrSIWljodz4KiWA&oe=69DE4212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnuTVQ3E2IMQ7kNvwFm91yR&_nc_oc=AdrDN1ntzdrHn7Ti8SrSZZ6T_RTmLMoZI-m2CfOohhGWkODiwEzBRTi-DiQFO2kfmbQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Jqp0FiV1LBlNzpHb7KJK5C5EPecbwWEdFCx51kjnusA&oe=69DE4A4D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience! Explore every intricate detail of your dream car in stunning photorealism. From the sleek curves to the powerful engine, you can zoom in and inspect every angle as if it were right in front of you. But that's not all\u2014take full control by customizing the car\u2019s color to your heart's desire. Whether you're an enthusiast or simply looking for an unforgettable VR adventure, this app lets you bring your automotive vision to life in a way that's never been done before. Download now and transform your dream car today!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. Change colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29304280395885161"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1682827562644112"}]}, "baseline_offer": {"id": "1682827562644112"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746559140, "status": "PUBLISHED", "id": "1682827562644112"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29412379341741932", "version": "3"}, "id": "9011123705652828", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28420702017576341", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29412379341741932"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9011123705652828"}]}, "change_log": null
_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUnv78RYf0UtvmEFPDW7zA9OoZIIogBgZYu9B9sMpDpw&oe=6AFF270D"}, {"file_name": "vr2_e.png", "id": "567231339741027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk2DW1Ls8xcQ7kNvwFRI_xW&_nc_oc=Adoss7Itdqzb2wc8VAvPZah2c7nJhatDyF4VeJQoQYeiWFuc2PNLE5TOgUPIcLH5UQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSepjhXpAeogSDeAeBeiI2ieHOyl32gtRz78WF2Qj0s5Q&oe=6AFF22D1"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbpH9HNKvDAQ7kNvwFDQZgj&_nc_oc=AdprVfckR_c-q1dVHiUOJDxauMkKvcTNZfMDPwENoR26LBxPCmdiIydNbZwvV83ltxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNNTHq1Ts6tu1IQbnQKDt2tvE2EAq1N_fJLTG30aPxqQ&oe=6AFF3688"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et6XuCvgH1cQ7kNvwFguywF&_nc_oc=Adr6uOIljIfQ5zoym2MS25MIjWn0Hs_-x2gf2xmKWVW7A4BURge7UUDvbHsHGVKYEWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvVSmDArdqszyuzu04cL6LAcO4VJOxIOWvE6uE4SzClQ&oe=6AFF0FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-31k6ZpDE0Q7kNvwH_09D4&_nc_oc=Adp0zE6nMJQjbHpzYX6U7yzp0SgOUFXwLZF4SdeY7kH99NONYk1Oo4epvm0PrqFcR-4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8TNby-Bvog7Jht3IjByRGe3Gjf5IV1x_Eq6kDDkWhdQ&oe=6AFF02CD"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
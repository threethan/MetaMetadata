6D"}, {"file_name": "s5.png", "id": "1250179323384252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_1250179326717585_8197893802591054754_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2PwwkvQyAAQ7kNvwFCh36D&_nc_oc=AdmcsAUoV7aaS5y0hmN4biLjrZ6JxKaHs2PGdwwBeZAh8Nha69TbREsRtW2MNud7Q9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4on7hp0tl-NxMpAfF_bK_OFmunu2PSoXFdyomS2n2Fw&oe=69B6B512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=773HtwSRWCwQ7kNvwHf12AH&_nc_oc=Adl2X_dBXz0iwp0v0KAmp-TakF-TDDgyQFVfFi9hn77US6X8188V8snCxMXj8BZGeRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiFEUMQWN5qlnCNlERjM8-mFwe4SChcluIQaXpgfiwPA&oe=69B6BD4D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience! Explore every intricate detail of your dream car in stunning photorealism. From the sleek curves to the powerful engine, you can zoom in and inspect every angle as if it were right in front of you. But that's not all\u2014take full control by customizing the car\u2019s color to your heart's desire. Whether you're an enthusiast or simply looking for an unforgettable VR adventure, this app lets you bring your automotive vision to life in a way that's never been done before. Download now and transform your dream car today!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. Change colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_na
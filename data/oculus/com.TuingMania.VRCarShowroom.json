_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI88aGAkTJY6ZqKGPWdZK_8Bz-pDxqMmf55ZR1LkDQVA&oe=6AFC840D"}, {"file_name": "vr2_e.png", "id": "567231339741027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk2DW1Ls8xcQ7kNvwFAm_x2&_nc_oc=AdqbgEFwqi8QYJnxclrGtap5KsEpMQqwpU78gjrsnA2mrLpOlg_EvfHX70IBHzDT_5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuSz65gcbsZHmteUGgzZgvJlgNhc7M5LwILGxez6frbA&oe=6AFC7FD1"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2dvtfYylRMQ7kNvwEy8C_T&_nc_oc=Adq32ECEf5sG27k7a-02JHKcdFKk8jTwXy7zPP3Yp0sbFXiLdGGxtrSJeB_Q1LxVJ2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnr3xMfMit4nGKqd_9q0N-1fhpIt9JLHi7ZHiPhwRaXg&oe=6AFC9388"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R5QCZTeEyYQ7kNvwHhnqyZ&_nc_oc=AdqEU_SvPDps6Eunblo9uPyXa2DoidOSqrlDlgU_DOlt2H3XfpLq-lLXin5dSSao25c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjlOKT80zIu9ACxdaULqy-k_mNC-cLQq6Co6GMwT_VIg&oe=6AFC6CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK40x_eWj0YQ7kNvwHp2e1q&_nc_oc=AdqaYAR6qqVaoi12dPlgd1WHopkxFH_6dbAtA6ri1V4i4yZHbTc9HTMhoMiSDMDeXI8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ4VUuTSpZz8Z-F87MBabHKuS1MZv95wT3RiuYCHsm_g&oe=6AFC5FCD"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK2PBdQJM1DZXXl5s76y4CJvOe5ushWP7dfGoi2qGRUg&oe=6AFB328D"}, {"file_name": "vr2_e.png", "id": "567231339741027", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BXhR3By1GgQ7kNvwEXEBkk&_nc_oc=AdqcSaGnUSS4Up9635TF2tSxHs16OF0XjIka45iPABJA82q8efTxa977LaXhQg06l18&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgLmyb93VbIndM_io3bL6vpvVsh90bAdoZ7q1a4gBlfg&oe=6AFB2E51"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2dvtfYylRMQ7kNvwHsWAB4&_nc_oc=AdonP8feCNq7ykF0VBDYSwF7nd7svRFORd3FQ3mHLeRjaecq5iIefRQT-kiM7G3Mt8k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTETCmEVttfqmPMkaxa8fPYZJ1Y3d9CePMoQYwH7EwiHA&oe=6AFB4208"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R5QCZTeEyYQ7kNvwFnHI9y&_nc_oc=AdrA_9mEMnRi9YR6QZdtp223n3Xhsf4dwMypnyNSUHhxMc5PR15VUKvIXb0HOp0oIhk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNWVeZ4c7baV1wImwlRDXIP_AviFqrSRntTS1QIZlFEA&oe=6AFB1B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK40x_eWj0YQ7kNvwGOO2ox&_nc_oc=AdrYEwAZE3jHLod6k-ziwfMZtPKsGUztPf0sbuo07kaSv0JnaGTlPSRhzy-igR1MY7Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrU4fOFllSa7vpPng-dRYhZDPSmYMoRyM2RMVJuYFdtg&oe=6AFB468D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_HcRLq7LsIQ7kNvwESYpIZ&_nc_oc=AdojOEGS3R1BU45r-5g8vS-_8TjFy1ksSAM-btmqkDpEFJBE6SLKjCsNZlWuQXe77oA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ5tpT7laXkD3mzHx71t-gaHfMOO5ay4JjuO0jIr5WIw&oe=6A8EDB11"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYPIlEwWpskQ7kNvwFY8vVd&_nc_oc=Adp1gfjWWy6PG_uto2xZgASK4hgG8ixyfDnd7XTfDh3pPiK0hp8PxOPN-QXgiIwl0D0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH37zqGEGDIhkvWQGuMt6xyLR6BGYa0OLtJaeuxMvJMWA&oe=6A8EEEC8"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUi0fyOY7OwQ7kNvwG0AA54&_nc_oc=AdrTMQ1fTi5iMBTHhE1bw28vquzh7iXSxYegIDRF9SA-l3EMUNc5mDF4AJG_9kaYso0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGERbHE40QOPrH_hK22khfBZpuY_EINxEWljWq3z1XcTA&oe=6A8EC833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQTosoazdEcQ7kNvwGNOGD3&_nc_oc=AdpveGMyBCzhgJF9pK8laXsWkQnXxEjrzIalgDsGuplikCTX50ETF_zsaRl2wr5FBE0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqt0c2tGUYhElvUTAxG0CR1p8UmXM8Hj5C9DcGZUBLIQ&oe=6A8EF34D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_32230378
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNV9cyCyvPRhicxR8JDSMJS4xox9dt1PmSD9ErBn-OTQ&oe=6B0C560D"}, {"file_name": "vr2_e.png", "id": "567231339741027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ_B5MC1nxwQ7kNvwH9UNUl&_nc_oc=AdqWDx_jvHMCVz6bM4mcKxgUhRcgEz137mJe7ikB5F-6qKTHLfVxAlmBiW1w-28eo1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaREbTlb1e4Kr7gYoFfdR4HTRzEFksaxLNnlBBe58x1g&oe=6B0C51D1"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeqkZBKYEr4Q7kNvwEiIZeW&_nc_oc=AdpMJ7ByeXNF4fS7VZbUsPlKObRCnIN3PezYwxGFgroIHePRiWYyk2HrzX8QLmDrnLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyEPwbdS5F594SnGQuXqCXi6A_itcphPfQka62dELf-A&oe=6B0C6588"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlduOeoGmUgQ7kNvwEOQx0X&_nc_oc=AdrxQH-pxu1Ui6SH-bu_v4itYlH27cdG6gZBj5h8AqKUntOR6S0x3PtMoPZt82yY0IQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRB0KeMmoFDhHIMpZN8v8Dcem1Kjoaxk8jccgl40d1IPg&oe=6B0C7733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chPAlMzgf-4Q7kNvwGhiYcq&_nc_oc=AdpdcsFWmT3tc39935gnojUHe6Rf5IC143VM618KrIZeFrAjdpvjyi0KKsXDl9mYphM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9Dw66bBxKBHlRoKL-nCnIupV-fcLvIpdOPOUlrAQPyQ&oe=6B0C6A0D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
5/491819980_567231343074360_1696347605845477691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK5lrAxIU0QQ7kNvwEVkYGj&_nc_oc=AdoyjVsUkoXlIdo37lydKWPLEFy3C1QKOofaXSh4PlHJifwbAPKlhUGPpPi_-QMo8gU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1wJz6OLDYPQTiidZqAWA-Nu4QhZwg4S-azsjULkiK1Q&oe=6A3D5651"}, {"file_name": "vr2_d.png", "id": "9769025159853529", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825091_9769025183186860_1848919590604600206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Td9qkL6iMIQ7kNvwEEjJJg&_nc_oc=Adoa-xRI1c9vbupY46Z8t2A9uC3UKqTKsILt6uoc5-kC3zooJeqqwmmGGbjF6r2OKG0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hpp8MPlW6lofkyMNtCxwekETWj_i0PPW07vIuzmdIOg&oe=6A3D31C8"}, {"file_name": "vr2_a.png", "id": "1333875074578157", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820382_1333875077911490_8128054501248404022_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnJlgXvllKAQ7kNvwGjfyB-&_nc_oc=Adrdk-aMqmd5ruW9HT2HzLrpxLNI_7lViDnPp_CwrD5kv3HkAORv9WlS3NCLqERsulo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GxdmdSe6DqKKmX1QiP-hZY-ZhTH58YhXxl2qTpFs2zQ&oe=6A3D4373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "g.png", "id": "1344057310186602", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_1344057313519935_3684391243550076527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13BA_-fCUSsQ7kNvwHqxTp1&_nc_oc=Adri1pvRT2IN4hCAGdeMOopG-xAlDqwLJxVGkNQUDXQF2fBWtOXDoBg3ZZKGrlIKAIQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VM_dw4r_DcwE5JaGNJAr7fUdgJalVBQgSmEhgCsOdNg&oe=6A3D364D"}, "display_name": "VR Car Showroom", "keywords": ["car", "vehicle", "showroom", "vr"], "long_description": "Step into the future of automotive design with our immersive VR experience!\n\nChoose from over 50 vehicles of various types and sizes \u2014 from classic icons to futuristic concepts. Explore every intricate detail in stunning photorealism: from sleek curves to powerful engines, it's like standing right in front of them. Zoom in, rotate, and inspect each vehicle from any angle.\n\nBut that's not all \u2014 customize the car\u2019s color exactly the way you want and bring your vision to life. Whether you're a car enthusiast or simply seeking an unforgettable VR adventure, this app offers a hyper-realistic journey through the world of automotive excellence.\n\nDownload now and transform your dream car into virtual reality!", "short_description": "Step into the ultimate VR car experience! Explore every inch of stunningly detailed vehicles in a breathtakingly realistic environment. \n\nChange colors on the fly, admire the sleek design from every angle, and dive into an immersive world where you control the details. Customize, explore, and live your automotive dream like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Default", "support_website_url": null, "website_url": "https://vrshowroom2.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29412899008356632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393425_683830391059418_3223037885410860006_n.png
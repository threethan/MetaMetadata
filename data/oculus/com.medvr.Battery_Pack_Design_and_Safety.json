XQjitGWs2I0d6aC1FamXGLKjO-JpSyYOI67F-_kT4adiakPigsjG17yR5tEkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjrtDUnbZgiHGUULgrsq7x7rXUUmq9qxEyleNNXkMMrg&oe=6A5784B8"}, {"file_name": "HighresScreenshot00001.1.png", "id": "1298842972413903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619113_1298842979080569_4849254911492641280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wwp74u1GYEQ7kNvwHgKrTa&_nc_oc=Adr4SGx56CG29ehRjTg90-RoTcD5kMFbjlYMizGxos-O8xqrshrCESpJPciia0plDQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdiuDAELsE5LYaOJ7i7IxfjgV0FsIonptzp5HWkpd4wA&oe=6A5790CA"}, {"file_name": "HighresScreenshot00003.png", "id": "1539847657767253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_1539847661100586_1802844813999930088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgPHF1sO7tsQ7kNvwFQ5UcG&_nc_oc=AdqmqQyuLWr9ugqRlYWFDBB9sC5rRyG2eP6vKJkrai854lWRg5q9Eg2V1c5kyUFZZow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRIyNHE8-99WC4M4z17Ayb-5RrjpCmoDeGa1e-ug7VMQ&oe=6A577990"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battery Pack Design and Safety", "keywords": [], "long_description": "Battery Pack Design and Safety is a specialized VR training application designed to provide hands-on learning experiences for individuals enrolled in the Immerse Learn Battery Pack Design and Safety Micro-Credential Program.\n\nThrough immersive, interactive simulations, learners explore key concepts and procedures related to battery pack design, component integration, assembly techniques, safety protocols, hazard identification, thermal management, testing procedures, and industry best practices. The VR environment enables users to practice critical tasks in a safe, controlled setting while building confidence and technical competency.\n\nThis application is intended solely for educational and training purposes and serves as a required practical component of the micro-credential program. Access is limited to learners who have officially enrolled in the Immerse Learn Battery Pack Design and Safety Micro-Credential Program. Unauthorized users will not be able to access the training content.", "short_description": "Battery Pack Design and Safety is an immersive VR training application developed exclusively for learners enrolled in the Immerse Learn Battery Pack Design and Safety Micro-Credential Program. Through realistic, hands-on simulations, learners gain practical experience in battery pack design, assembly, safety procedures, and risk mitigation. Access is restricted to authorized participants enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1598250475635091"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1729206938330169"}]}, "baseline_offer": {"id": "1729206938330169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782112920, "status": "PUBLISHED", "id": "1729206938330169"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nod
": [{"file_name": "Glitch_Screen_01.png", "id": "3429339137327272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984463_3429339140660605_2024868346763634072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwlAduVmJuMQ7kNvwE9pH8O&_nc_oc=Adp-Tyr26aH-a3_yBUuCTNBRnVEgLmglyp7if_MsGa1CoqX9fsl5L66NGKh6DWOZKmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEeodNUpX_wMAV54_hcTca7F6fD4TruSbZS6_b_9wUZw&oe=6A5CBCDB"}, {"file_name": "Glitch_Screen_02.png", "id": "1210481446322879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031310_1210481449656212_2597715643950446237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I3TrcCMb1gQ7kNvwEwQ1py&_nc_oc=AdpP7ghBVjtRvEkjzsf-bq7iNnu1cKP4yyAGmEZZ8NgpBjngWlkYSfe8FRZNT3bpCfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE4gvR9IuFPU7RVT4Yv6x_xd5n1bw7AYglA-NnjVDTaQ&oe=6A5CDC47"}, {"file_name": "Glitch_Screen_03.png", "id": "969119757401688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982585_969119760735021_5974992275693101456_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdYjRYAbemAQ7kNvwHQhDq1&_nc_oc=Adr21UOhLSkTR-wWN57aBpKrLNNmVT6RPyh3DreahuBrJrFcGW0PAnihRZkzFP6n76w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWuHX4V1EppYW5Rq9TKcaSR30Zfx4a1e-WjGsfBXR3gQ&oe=6A5CB679"}, {"file_name": "Glitch_Screen_04.png", "id": "900310361069511", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031594_900310364402844_4762867149900547984_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbhO-7M_qMUQ7kNvwErIfbL&_nc_oc=AdoueuJrV8Df-mlul0Os-mvcDwGsTHFWchpUYsV4OT_j9FFa8hB-Tiz5DHPnT2fkwE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcHCLdEzntWo0L0EseJPkDRoz77VZs-xgh8nFJ5nawlw&oe=6A5CD4D9"}, {"file_name": "Glitch_Screen_05.png", "id": "287924536904722", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43931333_287924540238055_3983448721471694475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA2CU05YxwEQ7kNvwG8N3M4&_nc_oc=AdpZBgKwv4DIm7YNvAjiju7-RWejVl2OpCRGS6KFXMBrOe8Zpvt52DtbYchZJGwF8Ck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH7WUgf4BtcMgUVnTM3bBirfTEO9SVbTSyA5x1gvavhQ&oe=6A5CD0E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569446_8289298184443855_7078290401953413423_n_hdr.png", "id": "635852425067938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340709_635852428401271_9131587383912358370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIQO4-c5_r4Q7kNvwEUgBDv&_nc_oc=Adrji4h6inE9mPQCpB14BKA2eNlhrnWWTJYXJiWy1-MSIFyo1CTcBbErGbx77fheTrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCByNPiHW6oA59AASe9l7khWeqhh0A7ZWUtsKg2AXTMtw&oe=6A5CDBA5"}, "display_name": "Glitch Moba", "keywords": [], "long_description": "Welcome to Glitch, the next frontier in Virtual Reality gaming! Prepare to immerse yourself in a pulsating sci-fi universe, where the line between reality and the digital realm blurs. Designed as a MOBA game, Glitch offers you adrenaline-charged 5v5 battles that test your strategy, teamwork, and skill.\n\nIn the world of Glitch, you're not just a player, but a virtual hacker. You have the freedom to select from a pool of abilities, enabling you to customize your avatar to match your gaming style. Each match is a sprint, lasting no more than 15 minutes of heart-racing, strategic combat. Outmaneuver opponents, bring down their defensive firewalls, and ultimately seize control of their database to claim victory.\n\nBut Glitch is more than just a game; it's a community. Level up, participate in tournaments, and grow alongside a vibrant, engaged player base. Plus, with the promise of account progression and a robust meta-game, every match brings you closer to becoming a legend in the Glitch universe.\n\nSo, if you're up for the challenge and ready to make your mark on a game that's redefining the VR landscape, Glitch awaits. Strap on your headset, step into the arena, and get ready to experience gaming like never before. Welcome to Glitch, champion!", "short_description": "Welcome to Glitch, the cosmic realm of virtual warfare! Suit up for explosive 5v5 MOBA battles, customize your avatar with unique abilities, and dive into fast-paced, strategic skirmishes. Set in a vibrant sci-fi universe, Glitch takes VR gaming to a whole new level. Your mission, if you dare to accept, is to outwit opponents, demolish enemy firewalls, and capture their database. Are you ready to become a Glitch champion? Gear up, it's game time!"}]}, "developer_name": "Glitcher", "developer_privacy_policy_url": "https://sites.google.com/view/glitchmoba/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/glitchmoba/terms-of-service", "publisher_name": "Glitcher", "support_website_url": null, "website_url": "https://sites.google.com/view/glitchmoba/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "786161799787420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "278817387927518"}]}, "baseline_offer": {"id": "278817387927518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690224964, "status": "PUBLISHED", "id": "278817387927518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "96970173837
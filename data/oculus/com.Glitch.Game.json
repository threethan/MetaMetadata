": [{"file_name": "Glitch_Screen_01.png", "id": "3429339137327272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984463_3429339140660605_2024868346763634072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9RLu6eddgUQ7kNvwHkBcpp&_nc_oc=AdpSgU10iaDPdkBRVXETUT7l4NZiyASZ5o-P4j_vFKCUN_Sh5-uAaOo1mIk92X1a19Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsBzN_gsR26zEO017-GcpI-TcLTCIrO-snOMmobFvsYg&oe=6A8C32DB"}, {"file_name": "Glitch_Screen_02.png", "id": "1210481446322879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031310_1210481449656212_2597715643950446237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NptKU7lc4GcQ7kNvwFdCsUn&_nc_oc=AdoZLPv6pP4LBsxN_wZy0DV2J11cWTS5wuE8C1hoeKD-xsV2i1woPb0GFM7kCmAdnCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYYIq6zPDL4OFO-If6A-888oiIz2fRYEdkJkoDz7g4Qw&oe=6A8C1A07"}, {"file_name": "Glitch_Screen_03.png", "id": "969119757401688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982585_969119760735021_5974992275693101456_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ielTCuaoA4cQ7kNvwHgws9-&_nc_oc=AdptEmuMMIH6mME56nsut9bV4WZ1Bha2uWchhWuQ4cDmpDOadH1CciHP3p8sEVbcbko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErBQBgEUAzcQzABm3YppuDJLaDZqBBRDcQxwy9Vw3jRw&oe=6A8C2C79"}, {"file_name": "Glitch_Screen_04.png", "id": "900310361069511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031594_900310364402844_4762867149900547984_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhBVGlhHIjcQ7kNvwFf7lqS&_nc_oc=AdrRRmSX6smP7fXmrqfhYKBr2g-UC2nC-XQ1x2A7xySsr4nvbGQ7MEqA0-LrIal4HkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBL3EYn45bgiCwLmZzrVMyw7jeypvuMLIINusbfq_nQQ&oe=6A8C1299"}, {"file_name": "Glitch_Screen_05.png", "id": "287924536904722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931333_287924540238055_3983448721471694475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mdl4EeTBTAEQ7kNvwE9qo0a&_nc_oc=AdrenPwxl4IBtW1UlacetOsb2_iQsp5wbOVR_Uv7d4v2jcW5c5ExhoZEilcftom8Zyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcpqBlFmMRw1iWZ12q4xgeQhtG8EsZ6UzqtFG7btFGIA&oe=6A8C46E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569446_8289298184443855_7078290401953413423_n_hdr.png", "id": "635852425067938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340709_635852428401271_9131587383912358370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-_kAU1Z0CAQ7kNvwEEPbXN&_nc_oc=AdpEsuXJUJhctTbm9e1PkwuJ_56i_WnQvznJVlSdyC3jVB7r-Qoqy0P6TT4ESdrA97Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPh9w4naUV8f9BCSkkZP3FofqtGDNEoVTKoVYzlKlHCg&oe=6A8C1965"}, "display_name": "Glitch Moba", "keywords": [], "long_description": "Welcome to Glitch, the next frontier in Virtual Reality gaming! Prepare to immerse yourself in a pulsating sci-fi universe, where the line between reality and the digital realm blurs. Designed as a MOBA game, Glitch offers you adrenaline-charged 5v5 battles that test your strategy, teamwork, and skill.\n\nIn the world of Glitch, you're not just a player, but a virtual hacker. You have the freedom to select from a pool of abilities, enabling you to customize your avatar to match your gaming style. Each match is a sprint, lasting no more than 15 minutes of heart-racing, strategic combat. Outmaneuver opponents, bring down their defensive firewalls, and ultimately seize control of their database to claim victory.\n\nBut Glitch is more than just a game; it's a community. Level up, participate in tournaments, and grow alongside a vibrant, engaged player base. Plus, with the promise of account progression and a robust meta-game, every match brings you closer to becoming a legend in the Glitch universe.\n\nSo, if you're up for the challenge and ready to make your mark on a game that's redefining the VR landscape, Glitch awaits. Strap on your headset, step into the arena, and get ready to experience gaming like never before. Welcome to Glitch, champion!", "short_description": "Welcome to Glitch, the cosmic realm of virtual warfare! Suit up for explosive 5v5 MOBA battles, customize your avatar with unique abilities, and dive into fast-paced, strategic skirmishes. Set in a vibrant sci-fi universe, Glitch takes VR gaming to a whole new level. Your mission, if you dare to accept, is to outwit opponents, demolish enemy firewalls, and capture their database. Are you ready to become a Glitch champion? Gear up, it's game time!"}]}, "developer_name": "Glitcher", "developer_privacy_policy_url": "https://sites.google.com/view/glitchmoba/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/glitchmoba/terms-of-service", "publisher_name": "Glitcher", "support_website_url": null, "website_url": "https://sites.google.com/view/glitchmoba/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "786161799787420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "278817387927518"}]}, "baseline_offer": {"id": "278817387927518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690224964, "status": "PUBLISHED", "id": "278817387927518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "96970173837
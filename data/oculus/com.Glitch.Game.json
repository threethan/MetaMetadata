": [{"file_name": "Glitch_Screen_01.png", "id": "3429339137327272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984463_3429339140660605_2024868346763634072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Itsb4WDKZsQ7kNvwES-j2Z&_nc_oc=Adq948P0Zr14ie184-uKKktuLPqllPQmOOODTSrIkV4-ylxSeFYd-8_9NEm2--kwR3k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8pZQ5enK8bnZjkIvKFfwac_lcpzu1RfnUhLtPNw3PVA&oe=6A24449B"}, {"file_name": "Glitch_Screen_02.png", "id": "1210481446322879", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031310_1210481449656212_2597715643950446237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KblyAXYJP-sQ7kNvwGTfc-f&_nc_oc=AdquTBEufptDj0zOh7qTefwoMLhQWVN043pRRlm9D23Tzc7k6IiRmZUnrqQhElDPoMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fu2Oc7UPau9AUIDkVrK_U8FdZxTT1nMYoopIC3Gnw0g&oe=6A242BC7"}, {"file_name": "Glitch_Screen_03.png", "id": "969119757401688", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982585_969119760735021_5974992275693101456_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzSD59mw7VkQ7kNvwERL0lG&_nc_oc=Adp7nzYHjYZm0KwoIG4gzjZCjHFbI7cf2FN--jLNSD7QD4rabRIID3s-b_dI6Mqhd10&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CY9f6vdKCFI3YS6CUvbkfM8H2uDXmHv87kdS-MMjhJA&oe=6A243E39"}, {"file_name": "Glitch_Screen_04.png", "id": "900310361069511", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031594_900310364402844_4762867149900547984_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbhMD2ceRWIQ7kNvwEJwbj0&_nc_oc=AdrJ2H2cbFs6CUFtqpnqWbgO8u6-CcyT7-57YtFxcP2iGru9SzZ2g-Zn5bLBBz_Fo78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Iy1KWgUoR_JCmWjuWXFqOQ5KuYS9QjKVVDD8DKjxRzg&oe=6A242459"}, {"file_name": "Glitch_Screen_05.png", "id": "287924536904722", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43931333_287924540238055_3983448721471694475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwIihDCSzZ4Q7kNvwE07fUM&_nc_oc=Adr6XX1b4RYgx_bFx76s_9gu1eXriV78_xF78-206vO4w1UQaHmmb3r4mP7ALHV9RsI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fwfO8QHT2i3kk2S6F-51TJWU16zTneMaNKGLGXJphJQ&oe=6A242069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569446_8289298184443855_7078290401953413423_n_hdr.png", "id": "635852425067938", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75340709_635852428401271_9131587383912358370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YCTbGFIB8kQ7kNvwFl8ZFq&_nc_oc=AdqA-4KRa-H9MuoLda4Tn22lrCAPD0PxU17WpnnClXFbTZmqGx6t1fZaa8zuy6ZSUZU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af924-4Do4DUJ4W-9EIhKKRgQ4326f9tX_m5hPjAhI-JUg&oe=6A242B25"}, "display_name": "Glitch Moba", "keywords": [], "long_description": "Welcome to Glitch, the next frontier in Virtual Reality gaming! Prepare to immerse yourself in a pulsating sci-fi universe, where the line between reality and the digital realm blurs. Designed as a MOBA game, Glitch offers you adrenaline-charged 5v5 battles that test your strategy, teamwork, and skill.\n\nIn the world of Glitch, you're not just a player, but a virtual hacker. You have the freedom to select from a pool of abilities, enabling you to customize your avatar to match your gaming style. Each match is a sprint, lasting no more than 15 minutes of heart-racing, strategic combat. Outmaneuver opponents, bring down their defensive firewalls, and ultimately seize control of their database to claim victory.\n\nBut Glitch is more than just a game; it's a community. Level up, participate in tournaments, and grow alongside a vibrant, engaged player base. Plus, with the promise of account progression and a robust meta-game, every match brings you closer to becoming a legend in the Glitch universe.\n\nSo, if you're up for the challenge and ready to make your mark on a game that's redefining the VR landscape, Glitch awaits. Strap on your headset, step into the arena, and get ready to experience gaming like never before. Welcome to Glitch, champion!", "short_description": "Welcome to Glitch, the cosmic realm of virtual warfare! Suit up for explosive 5v5 MOBA battles, customize your avatar with unique abilities, and dive into fast-paced, strategic skirmishes. Set in a vibrant sci-fi universe, Glitch takes VR gaming to a whole new level. Your mission, if you dare to accept, is to outwit opponents, demolish enemy firewalls, and capture their database. Are you ready to become a Glitch champion? Gear up, it's game time!"}]}, "developer_name": "Glitcher", "developer_privacy_policy_url": "https://sites.google.com/view/glitchmoba/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/glitchmoba/terms-of-service", "publisher_name": "Glitcher", "support_website_url": null, "website_url": "https://sites.google.com/view/glitchmoba/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "786161799787420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "278817387927518"}]}, "baseline_offer": {"id": "278817387927518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690224964, "status": "PUBLISHED", "id": "278817387927518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "96970173837
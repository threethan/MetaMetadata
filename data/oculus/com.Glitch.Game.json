": [{"file_name": "Glitch_Screen_01.png", "id": "3429339137327272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984463_3429339140660605_2024868346763634072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmtPL3nNLtwQ7kNvwGPGkUl&_nc_oc=Adrho3mTCwDWKgzwJA1z-Y8Z9ZnxXkcjrSZJBimO5kDmZC45dtyXEYZZFRYNKLpYLFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i1GdwiaO1pOXCboGCWOOC_hx965BYhc9w7GyIr-jvKw&oe=6A3BFF9B"}, {"file_name": "Glitch_Screen_02.png", "id": "1210481446322879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031310_1210481449656212_2597715643950446237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J76AXNgtO_IQ7kNvwFU4rNv&_nc_oc=Adq3yRssK88NH1lxVHXS8LdtSg0SWDdZJsn0L5IRpNf0HAzU7Ga6Cfcm7ReKquCh0Ps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zzWvfn35adLjPX_hfz3KgQobAY-TXZ3x3s6CPOhTLFw&oe=6A3BE6C7"}, {"file_name": "Glitch_Screen_03.png", "id": "969119757401688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982585_969119760735021_5974992275693101456_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_3LO3pJwKUQ7kNvwF3n1Ay&_nc_oc=AdrjxZSqmfGf3Mvb4b-D8EwxYNzMj2rAiETwR9p1IcmnfPl-EFBmBzV6iUXGf9Nuagk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93l7qVlqoIV_oM4Az6w8xX2ZQ2ty-OAmH6_uZ4AMsHPg&oe=6A3BF939"}, {"file_name": "Glitch_Screen_04.png", "id": "900310361069511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031594_900310364402844_4762867149900547984_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLmEg0OEtpEQ7kNvwEPWlN0&_nc_oc=AdqZfwtGD-E0oJ1RLMq6wiAtcuJd1lwq87OREDZs8SFSoEOua7PzX4j_AdyV72PGigQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zxLtdrMWTFr_JhHVBUymXAE5Y788GdAZ7hbIaP98pmQ&oe=6A3BDF59"}, {"file_name": "Glitch_Screen_05.png", "id": "287924536904722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931333_287924540238055_3983448721471694475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK3BpXsCVd4Q7kNvwF0smJt&_nc_oc=Adp31g1cIYbPDcEreNV3fJBHs_jxlpE3-NgFUv_0oHZbPRsTdr0J6_ESl_yeKNYhOZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M-IJT7-rX-wS_SoxOfNR8FMzUGRj9LHTCkNT7vYbvyg&oe=6A3BDB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "57569446_8289298184443855_7078290401953413423_n_hdr.png", "id": "635852425067938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340709_635852428401271_9131587383912358370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkILyoK0Nt0Q7kNvwH5UTRm&_nc_oc=AdoYPTPWvydnp-Gpm5bWD7iImg5T7w977Nuziqc0V7NHm_DN_OgZtlNj5fpubMQvF_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NuXs4X0khJTMvTaz1np_Z-ZjCHt1e3KURZa1euzxINQ&oe=6A3BE625"}, "display_name": "Glitch Moba", "keywords": [], "long_description": "Welcome to Glitch, the next frontier in Virtual Reality gaming! Prepare to immerse yourself in a pulsating sci-fi universe, where the line between reality and the digital realm blurs. Designed as a MOBA game, Glitch offers you adrenaline-charged 5v5 battles that test your strategy, teamwork, and skill.\n\nIn the world of Glitch, you're not just a player, but a virtual hacker. You have the freedom to select from a pool of abilities, enabling you to customize your avatar to match your gaming style. Each match is a sprint, lasting no more than 15 minutes of heart-racing, strategic combat. Outmaneuver opponents, bring down their defensive firewalls, and ultimately seize control of their database to claim victory.\n\nBut Glitch is more than just a game; it's a community. Level up, participate in tournaments, and grow alongside a vibrant, engaged player base. Plus, with the promise of account progression and a robust meta-game, every match brings you closer to becoming a legend in the Glitch universe.\n\nSo, if you're up for the challenge and ready to make your mark on a game that's redefining the VR landscape, Glitch awaits. Strap on your headset, step into the arena, and get ready to experience gaming like never before. Welcome to Glitch, champion!", "short_description": "Welcome to Glitch, the cosmic realm of virtual warfare! Suit up for explosive 5v5 MOBA battles, customize your avatar with unique abilities, and dive into fast-paced, strategic skirmishes. Set in a vibrant sci-fi universe, Glitch takes VR gaming to a whole new level. Your mission, if you dare to accept, is to outwit opponents, demolish enemy firewalls, and capture their database. Are you ready to become a Glitch champion? Gear up, it's game time!"}]}, "developer_name": "Glitcher", "developer_privacy_policy_url": "https://sites.google.com/view/glitchmoba/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/glitchmoba/terms-of-service", "publisher_name": "Glitcher", "support_website_url": null, "website_url": "https://sites.google.com/view/glitchmoba/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "786161799787420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "278817387927518"}]}, "baseline_offer": {"id": "278817387927518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690224964, "status": "PUBLISHED", "id": "278817387927518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "96970173837
scdn.com/v/t64.5771-25/491824318_2504652159936295_4351949504519385588_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzBt1Qi0Yj8Q7kNvwGaR-cQ&_nc_oc=AdrJSWtHdbtPqRM6H7JUJSqlkrv14SaherUxN38IWVAgQ3br6Thux5ln2i6EzXFa63c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOuoKo4k6whu7A9378Mj0K5g5fnP-FFg_rDxQyhIKszw&oe=6AF9DA43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Deluxe OG", "keywords": ["Lethal", "Ape", "Deluxe", "Primal", "Scary"], "long_description": "Lethal Ape Deluxe OG is a pulse-pounding horror game set in a twisted underground facility overrun by terrifying monsters. As chaos unfolds, you must navigate through blood-soaked corridors, avoid deadly creatures, and uncover dark secrets hidden within the shadows. Every step could be your last as you fight to survive and make your escape. Will you reach the end\u2014or become just another victim of the nightmare? Experience fear like never before in Lethal Ape Deluxe OG.", "short_description": "Lethal Ape Deluxe OG is a pulse-pounding horror game set in a twisted underground facility overrun by terrifying monsters. As chaos unfolds, you must navigate through blood-soaked corridors, avoid deadly creatures, and uncover dark secrets hidden within the shadows. Every step could be your last as you fight to survive and make your escape. Will you reach the end\u2014or become just another victim of the nightmare? Experience fear like never before in Lethal Ape Deluxe OG."}]}, "developer_name": "Universal", "developer_privacy_policy_url": "https://universal790132.wixsite.com/my-site-5", "developer_terms_of_service_url": null, "publisher_name": "Universal", "support_website_url": null, "website_url": "https://universal790132.wixsite.com/my-site-5", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "26918
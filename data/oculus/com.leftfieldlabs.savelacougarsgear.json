UQ7kNvwFKpQ1P&_nc_oc=AdqfuaJZ7unQh1GukLnbxakyMODmQbqXKtBoc-87uO45gZPt9KIzmuimjzQv3yoHYN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCyk6Reh1xJrLTW3O5IiB1CRzbBi8jDPSEhaVQvuGe_g&oe=6A82E9D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWhg_d0z7uQQ7kNvwF2sVb7&_nc_oc=AdomIgFL5UlGWLn7tSVeTSEELzZqda7LYFXYIbJlPr8niOg22uFzlgiXm4IczB4cUk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF12K8XojEgL_cYbgd0fuZNLoJKD3gXf6qWN-C9G_VMaQ&oe=6A830078"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe0L8_NkfwAQ7kNvwHggDnQ&_nc_oc=AdpP6vY60VAf2hp5KSNZ4nToWWlmw2gMstSQnh15SjaxzIAvH2-KuSJ7ynyftfMA86I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHahrPlpuviV35owMGtw6K9lbkrC-ISz7RMyCMTa7NJ9A&oe=6A82F3DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHnr6YdwSkUQ7kNvwGxc0P6&_nc_oc=AdpD5DzjSuqhgPH4aTPcu6la7DKJmE1FSODLvXwYnnfA0pDFEyDtOwlllhP7Qfqf5Ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE08GsqZGQGqD_MBpVhAxkCvZhM6oIun6GdI5_ydPUtPw&oe=6A82FF7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1GFwFzZ0okQ7kNvwHzuQAs&_nc_oc=AdqOtJTcF87_sWyqnOovGU6IBOw65b_bHlzVg7HE4JDOQ6F8Q5K5w0-qQSTdq9dxHJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAGuJG6KlFjILFGuetLS
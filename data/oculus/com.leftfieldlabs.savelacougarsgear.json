4Q7kNvwGpj9xh&_nc_oc=Adrp2b2VqKOtvGgqGUSSE8DwvDB0CEMk_kvUI6MMVuFgifEZdTtTfZlATdnrzNITw2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeHGVCGGxqAIGFj02LLYxxhPX2kxX1ixlFWLLWgc2Lrg&oe=6A92BBD6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YlcY0VbXboQ7kNvwEwd1Fz&_nc_oc=AdpdmUZT03fUH0yl3q7jMgohGdyJNnMi7tBQ9WxneiFo9xPj4xXLbRDOgc38ckAkF7A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPM515yVOWSOwtlyEkvHfXyNf5Dgxzs0DJz8IpaRnY3g&oe=6A92D278"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42o1CgKHrc8Q7kNvwHr1ENG&_nc_oc=AdofUWYquKubIcm4Ohpes1Tnqg60jtvv6tOktlNqwlii5skoo1f2Wn7bEEU7VLfmxtY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnij6MCTXsRE3MnKuWWL0xA0jgIwU2QN-dzUTcAPDiYw&oe=6A92C5DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwUPJCjoIKkQ7kNvwEXLZho&_nc_oc=AdpdbHEXVfQIVYnpdB7-qky0lbizcn70S1eaH5APhKLbexEkISsFD1QeyPO3e0lmFtY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMXsVg8hYWI8M0yjIA1u2tAyWyufXT0AKKO5XUpJApOw&oe=6A92D17E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOSUgV9e4FQQ7kNvwEjrf9n&_nc_oc=AdrOrWvuJDtKFUevmoeX01JJ-77uZsY5aQsgM6Lu0qd3fV97l1ypPQTdraOlAhP3RTw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhUtqChc06s_HqfLtbyK
YQ7kNvwGQKTRF&_nc_oc=AdqSZsXCXbIuQALbrH-vW4NZZX9yrYQYrAMmnaDeHcryVmbuqhk509VXlQafnjxZHB8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uNtBCGdaCt5VTacHCAkKpPYXzYo1If0Gap7-xmPHxqw&oe=6A413716"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O29d3Qg190kQ7kNvwGpZjOB&_nc_oc=AdowAKl1ou9_GvzzdYiyH2kgAIOXR0lF_PKT7qYyOZDdOrHdzztkMHv4DhKeb4VNZPA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af920IIHcI_V3nyFbq2KcDw8n2tA4lKRlxhK4di-aaozPw&oe=6A411578"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqLFf2pFk_EQ7kNvwEndL4E&_nc_oc=Adrg8Qtv9YIQjLCMJTDTW7_s_FU0Y806iY-WxAKNZ1r-Ai5dLMjsuK8A_Hyl8Do2MMw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S_8DCxP-Rq6nL_siyE5G3J7oFxq9H-KITtLCgKs5pKQ&oe=6A41411F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUT_5okN7V4Q7kNvwGF2n1i&_nc_oc=AdpGSySb2wQ9kByNUF47-tQLZ5lK_gi3QX5QUS77_MOD7q2BHhcdFvxdvlnzWeq4ogE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ioW2NM9fs_C_WxqVd9zbFG1nXwwXiXYLot1QkPhCIzg&oe=6A41147E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMkjO2bhVa4Q7kNvwFFAyKK&_nc_oc=AdrxWXFMxH0K3tJIcgkWfVxfOxZrWGSe8fZf6J5Dts8rhmSoXDd72tSGVzZSVwYI0Z0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wVIcbWYFvU933OjUw8L
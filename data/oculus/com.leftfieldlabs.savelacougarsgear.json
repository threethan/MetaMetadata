gQ7kNvwHAdwta&_nc_oc=Adr2JwiX_DOa-Ehzxd1BxrF5zvxLNsx12-YbQp0fR-qriouFgHrzjViatTQNii5273g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-DwQ-PTb2PaFVfAj8YqPc7gTq_GXO7jn4TAxA0bTuMQ&oe=69DA6216"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmgWqZNDc-0Q7kNvwGKbojn&_nc_oc=Adq_Ei0XB50TBIXIRNGk0tYfxMqXFJH41_HDsKZhekvOw-M-ysSzPFgwRDW3syHJuCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FAwAmjGcemOINkV-K6Mny2vgOltRoEHMW-XFSvwYt3A&oe=69DA4078"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0yi4k818Q4Q7kNvwGuZYjR&_nc_oc=AdrOn3wwx_04R77bsQfhxKDtxJ8k8lbnH9grOwxxTWtuvd45JAC4mDaa7zRSvCIvZxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yOP6lp8yO6_zk73pu10-xZ7KsRK2xJNjrgRjWO4eD3g&oe=69DA33DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftr66t1xM6IQ7kNvwHDJ4J5&_nc_oc=Adqsu4pyDxgBreMDRl-Oii405j4Bklow_JqecmOh4VbCQlPmW12xEr5BjM_MCaUjcew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q9IJccyBKD5FGne1f6u_PVhszcPOri2_TEsy16k-Tkg&oe=69DA3F7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCgAICbArk8Q7kNvwH-Ecvm&_nc_oc=Adq8FNDSNzQRy2ZyzbxIiE4Ea2SpKpsevARUZECdQXK8GxXk53QPQF2erkxwA6Ebiyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LxofcJxxDx_InDt-8Sn
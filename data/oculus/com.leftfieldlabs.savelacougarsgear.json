UQ7kNvwGH3h-8&_nc_oc=AdqAbNxHdspLNhenmB1MbShwsJ6cRpvKO3RtyoV9HL3qJHP91yxi78lZfx9Kj2KYL0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HkW1UP4ygmKNSoD_QnvJIoQl0JkyJcrQDJmbjAivEWg&oe=69FF4C16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSlejl86aRYQ7kNvwFagZ5Z&_nc_oc=Adp5ZLwcC2wch-wUtZkz9h4VetpLaE4D1ak5pNWTsd8OXeK-f6OcC1vIRFzP-sKQuYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RSkn5LPonPM3E450HfsoR_qVpzsTxkmKE8y63zssn0Q&oe=69FF2A78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JUsIu6PpjMQ7kNvwHls7pf&_nc_oc=Ado4yrE1z1n9S2N2153Jr45sLqvqYUbssaC6x_xFLW7DzlHB_LseaYxrHBrJxJBGUng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AGDZPmUM7L1a_0-TxD1NqvPTTjJY5kUQZROc6d7DVsg&oe=69FF1DDF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDo_tGtQTVcQ7kNvwGzJXBL&_nc_oc=AdoYupdYccuhHolSMiZnXnfHikCzDeDU6IvtXCktd2aTFLYHmhkLeSopcVJRa9di6nY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ok0HF2f4gB9YH15aD2i47CF60Skp2QW5-gAK9Y_jWRg&oe=69FF297E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsRZ8kanT6UQ7kNvwHuU-it&_nc_oc=AdqZnjHJGuGDjwfwZV9fPuzPjZL39e9eDL8mia5-1GZ5XTbflLjmHX2apIsVCGq6gOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M6p7MUIXA7Aer3J2jGH
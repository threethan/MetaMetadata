kQ7kNvwFdxEIM&_nc_oc=AdoS4SjQ5upggxG4JvwJ0PyLkwSSQaPsKMEZ-vz1bChnBaI9NWHBz_hVW8X-oLa4Qxk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqgRhj9y-GdG2um-bSuboXiIlGfE-a_sUww7S4hRYUaQ&oe=6AAD5216"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8571dtVQxFEQ7kNvwGEDh2J&_nc_oc=Adqc7WXIJslnBrhzT7nbEfUN_OdKQCF2X1Dzg1s-sJCasod2DTsx9sNJq9s_IjKRny0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZUVxjMDDRRRRYEvsst8xlCmfYGOzySiQXsx4Uu22ToA&oe=6AAD3078"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBH4vRo6mhcQ7kNvwE--ZoP&_nc_oc=AdqX79oOdS6xXb1nrL5pfQ8vh1em2qu2b4Bt_uEGjgyI-NmYPd9vGvHfL1RhPalsd8U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEF1BMFBxbdf9TcqcyfCt81OEkeI1ocDuE9N5u_hSN7A&oe=6AAD5C1F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN6B38UDbcoQ7kNvwFyj2Bj&_nc_oc=AdqVUWFMvL9hPnlSQTW2KlP9orlhZ2G3jvHIxK2ddbQunKFs88rRJ7mnsK9XHzI25W8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK17UiwI9ZLkF2UnATlWKyxlqiI17JveEfd5Jtt2HUipA&oe=6AAD2F7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDmNIYvNaPQQ7kNvwEdl0r_&_nc_oc=AdraqZ4vfX8--YB7JB44k7wUJCrJlXnzAX5gf0UU9Fq2q2KP0KMAPx_08aJsh2BQV0A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9qT44RcC5Lim_wSViQR
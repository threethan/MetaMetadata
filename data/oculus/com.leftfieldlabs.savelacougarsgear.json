lMAKzSL2CTlQl7IVUgXoTYSdneYsSPXLiQ6xV3UPd3BJsLkXXR8QUWi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzT0LWg3TQsCJbPaIT5NBNbFpz7N-iA_E-0mIpDajVfHQ&oe=69B29CD6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4kBtGXoC10Q7kNvwEq-s-G&_nc_oc=AdlE49pshOfBRLJTR2YX9rgjszeTGuZsbEvnTYLg9f8gwe7iD0-eGbdPZIMm7e5GX3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjVtCORjiQtN3Xq_E2EKgubWV56UPCmc5jpgR5vJNJ9Q&oe=69B2B378"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxm8sChwadwQ7kNvwHYC9_p&_nc_oc=Adm_pRHy9UcxjpuIXU7mGiP7ijiJlrVqFH4ZvPZ9biKNmanmdc6P90XHh4DXNg0iQy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzY2jlNavgr8k3BC7RYUiHOZbSswLDzXOBO-TqfSzK5Pg&oe=69B2A6DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rb8TuzYvZEQ7kNvwEpBW_O&_nc_oc=AdlRNlvfMzmroLyyIDVwUDz-t97yARWSalIeZoAuSIvrreesHfLOYqaS1E5PkGanYBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxokJKQdr0VXldGoQ7PNV5MWox8U638uzAEAlxIwUbaoQ&oe=69B2B27E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNVT_Uftvu4Q7kNvwENxXgG&_nc_oc=AdlcOT4Vqrkrb3L1ghtvL8_PACpxN-FCaJyzyb9wPtQXRl4YrtluiO974nxEX41hblI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydQiUQmEeDUWny7vjGPvtiaPZd_XmS1UpeBamVUs1RdA&oe=69B2D26A"}, "is_concept"
8Q7kNvwGG9vX_&_nc_oc=Adqd6byC1kQkj-rSGf-uI8GRWahvB8Pvm4zWsZgnEGm2biF3HrKHTfje30ZCExwhi60&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsapgbSMUG6ouSPSoHf_0N6lvr6uPxCSFnLzUDMz5Naw&oe=6A8AD2D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_V92zk5ZPgQ7kNvwF-cuxb&_nc_oc=Adq6XqSWDpl5rHRh6erx0TKB8Tbv3tqPiPxQNmSNg3tkkbCMV3MgracAcRfUjbI_KLg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoQrv-8XAAt0KoesZtbdrJsvX0JNhrgANZyak_1AJivQ&oe=6A8AE978"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iicgmG7LzLEQ7kNvwHbZaLp&_nc_oc=Ado66Vso77UzXkfY8MeQ1rx7V7f0vByQWDl5Zp7ztFNz2RD9I8jR3TK0-ou2RnpJjHo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx6oUdKxSsh1132t-ViyAXxD3AAKuhA5DNKgqfiACDEA&oe=6A8ADCDF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25bLhTVWQHgQ7kNvwFmjDqa&_nc_oc=AdpyOITc12_BswgAheYfSvNzF5rIQq6GPlYHBFV2VvTfCxSiTn4KYWUeNnDmomCHhxg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqTUSo1rOn549OEGBsaETH0V4MLo2WinPhqPGTfQJUPQ&oe=6A8AE87E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHYP0YiZodoQ7kNvwGz4YPK&_nc_oc=AdqKFpFQmJOOt-3cf0pMxlTX8lNA09hpv2GgvJ4szDePyOpyFQq9_fl7kwzgPn9C0p4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdoUBO9ugnBKTglwx0xB
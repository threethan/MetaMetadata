=scontent-iad3-1.oculuscdn.com&oh=00_Aft6-ns-vpbR3MGPUzMRhEBa6sknrcYAmwlFGpiyo2BF6g&oe=699D84D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3Oa7FcLisoQ7kNvwH935H-&_nc_oc=AdkUMhINvrZ22hemr9CBA2oy9JCYzBL15As28HqZW6i8U04VVqdezFAZuMtwRKFDmfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKUV9J6738g_9Ba1u2kYAjrDhfdKza9V5U0D7D6GuViA&oe=699D9B78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTVFZcF033cQ7kNvwFVH1cw&_nc_oc=Adnd0m5iaq-Q82n-vx4P0NjNweN_ky8Ljc4hjkKzDjnU5T3FIPVE9RAhqkE8DyzNANM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyjjylVlJ0PzIYMQu5tM8PhhRKELirzoV-2fw3Ci0oqQ&oe=699D8EDF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kibkGgHefxwQ7kNvwFU7SpD&_nc_oc=AdnLXN1KNAcwADwEMq-BcxROshRCiKtiTK3zL2wYphFCPTOlUgtrJiNv_i6pywJzcKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP1twCHhgR4zwOKK20NR-pKjOw5RMa50qvvPVUUA0fXw&oe=699D9A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnC4q29_Qx0Q7kNvwFFIkwb&_nc_oc=Adn_GBCFqBzymVeHf-U7ZX7bIL2y27M7tDeHo2s67PAvoetovwFAVu2p6lAqaxuNL3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFsMBNXZYPfx4DQ7LYPPrlG9EpLBUWxzBJaLC6BZX9Dg&oe=699D822A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Save LA Cougars VR", "platform": "ANDROID"
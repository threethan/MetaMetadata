4Q7kNvwEx03T7&_nc_oc=Adr23Ks2wAya0D2J0ncx0VxVgLqNgTQpx57l7SnOA-7-84f0DIjJ68yfiF4A462iRO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESQt9EVNu4vFK5X1VlL3FBz36r5YBcJXlIwGjPTzjqQQ&oe=6A75F316"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwM9GaYwNikQ7kNvwGMOfxh&_nc_oc=AdobJzaTr37U5qH3KuIeKOohjdhSDgEfcIAa3uz1Uuz-Ra1jTIy0nzIbpX2hqRTE-lQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-cUX1HiqleC-BU1KHA5xTrOrpp7jNmLE6bCqoGl7cPQ&oe=6A75D178"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxSfloLlUA8Q7kNvwFCTYIz&_nc_oc=AdrVI-MWkzBy1Sgus2RuY-KMGr8wbOYSZ8PSbm7Mui4-6QrAieBvXKr8vGRrkBzZiQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpltfBNlTZHZjHkz724kpx289cBKxB2aQBlcgSoxg0LQ&oe=6A75C4DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxaBCoV7D_EQ7kNvwFEetDj&_nc_oc=AdqbhXP6FRT0ybgcqs0pmSeB0JGs05hALU7X2-FJOMvGu1kSft0WvnmBKTKeBTrBI3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk5kRDrXVwvLFH1MWyYjd8_cnB-f1jk26w6PmyWnEdMg&oe=6A75D07E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyNGPI58gN0Q7kNvwG2b3-W&_nc_oc=Adq8vInOQwcruVitsRlf4Xx8BcoJdtn_noiwzKzVmPKRf_odm99WqcDyxMH7ZZCkys4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ08jjZSS5e0kqjJlqj2
YQ7kNvwFYYFzS&_nc_oc=AdpdvUSvdYcqYbSZK_AFpxD6tReM9hJck5nLF8Ia781pV0ZHklHhnrLQpwgGziCL3GA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0PYBEWnMSH50m2f9w1qwG2auqSRz4EjT-L57Ss1c8Rg&oe=6AE0BC96"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_eRg3gKN3UQ7kNvwFFxYp9&_nc_oc=AdqgMpRz8iN1dp-Z4TDw0qqKQr25cuNIgZtQVrVc4Sc9E70byWN8FgYL7MupS29w7MQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxFTdWvPRLV1yHFAwBTTtkg0H2B6pIXy8NCXKaCN0eyQ&oe=6AE09AF8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSqesk7A75YQ7kNvwE1bILb&_nc_oc=Adqrwyt8Aatte4vgi0EAGgfQ97S5WFr0qT7fdjf5V9NEHcNARwBgkGC5SqpuqhFc3Pk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvTFd3pjJe3dKG1FVMh7qoJw22K9HCvcrU_0Sa1GadHw&oe=6AE0C69F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wievq5nKxEQ7kNvwEFrTHE&_nc_oc=AdpfTJDsDFU_U5lNi7TD04waykQZeTIe1fEs6wYkkjYM0TXil6gFHYDcFgmX5gbxPEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_gquAoSp3F1qwoVXlsi9HdiyIERP4S_Lr6JEIsFoVmA&oe=6AE099FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tA34T3-5psQ7kNvwFvRbCJ&_nc_oc=AdpC3WzdUyb2D0AfcFhZIUMEdyj0cbklTZ_JvSXE25WBVQ7R7GuyX4YhI8_HespLK2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNscnfRMdMF7v3HcLP1lP
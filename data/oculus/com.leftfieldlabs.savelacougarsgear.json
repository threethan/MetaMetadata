grated_image.png", "id": "210333443405794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_700072713531646_3428268205909475328_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m7VlVHc2K4Q7kNvwFaWG6f&_nc_oc=AdqFlSJnJSb4yvZjdi5j9NFtHA1vuQzmcUxf4GrBX7L-h3OkqfzEnhwXMBeJa9Ste20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNYcWo2qb8xxzXkySW4kFxSY_K_5U5h3rx77bh3zEnBQ&oe=6B030396"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQZG8TSnh2gQ7kNvwFUyJaS&_nc_oc=AdoB7FQD3DSolM_lqDa379DEqbTmmu0Qyvd0DXBtRf76jGR-ZFiLcg_316CMuI637yQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQioNNLBq1wGor5xWUB_Vc0vXkVSchUsvmgwuWaM1guIQ&oe=6B031A38"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jND3BJtKXw8Q7kNvwEvrup4&_nc_oc=AdrQDO02gYBKNSFI1BCvdAZEwH69NPmG0jzL6m_qJmw4bLqy57-sX8FBLTNkINzxPyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD3rgJp1VUSJEsGzgN-9WyQWyuhCgI00XLOYIK-EfWrQ&oe=6B030D9F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXfjIWHAVAsQ7kNvwGqwb8W&_nc_oc=AdpuXsqPQG-7VgMDkr5YcyZNZ54LjAFpOULvd4c1ivUjT3afA42FaVt3eYh6ciKTnfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbO463vu19vX88icKZalKhqK3jsadFwknUWmkZD2es6w&oe=6B03193E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t
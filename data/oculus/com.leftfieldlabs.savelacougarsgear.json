gQ7kNvwG1w4Q3&_nc_oc=Adr-UR5TTpy1IRkTgl91cisiR3HEg6yxTKk3nWj9eYTV8NpyR8oGQ1qGtyds6PVte9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCrR6Bby5KNiXFgrQPuGm0vRiSbNwcy-GdjCX64BVEfg&oe=6AF1E016"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6XA_I4FtZsQ7kNvwH2srMV&_nc_oc=AdqVga5a_vD_FOQ-RJc_6-1gN-_Ix6NbAe0ZenPzcMp3VREJOVvfXo82i4FNU0MgqJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5shml4uDBlpVhqwgQ6jyyAFJiZQ2fYNHqqQj7XochRw&oe=6AF1F6B8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI90RV91QOQQ7kNvwFwLeo7&_nc_oc=AdoAdR4VujZ1gYAYzFw-7i0IHWabH8Ip4CdeBRN10990W4epG2zJNGI4J3wngkFuYxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvaNASyC7nFISqlX4wLeObqsNbITprW1M45abYFfFceg&oe=6AF1EA1F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPqDn-AfSBsQ7kNvwEYY253&_nc_oc=AdpL9iAngJz4zbF9jgRt5vkCYfi3ra5HCm6_oGDY8kE8b90lNlMrf9OCfDQJqHbkT2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT63c_0JJ_CjVFMBR3AcZ2BXU3ywvz8cYQN3eK1987U6g&oe=6AF1F5BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEOxUjKzxzUQ7kNvwHZ5e5r&_nc_oc=AdozF-EzchRPB2vOi-X2VjyXZ1-D4H6lGXG-guYVbUoUylWWCeUOypTeqzMKe6ErY5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdydrZIZSpatnre7mMKi
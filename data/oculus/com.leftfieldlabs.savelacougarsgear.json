YQ7kNvwHxMGiv&_nc_oc=AdpnwCYgVbe2JtwmBx0WkLQQTJLS9wVqUEtRj8F6qIBGFwtm7cwcSeEb7G7VDbOsFPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVKYrDZ-3PVATojgrKr3DX85Uyekras_IKcjCzDnsYnQ&oe=6ACBA496"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-xog9HSK6kQ7kNvwHti2Rj&_nc_oc=Ado01I73ciBBkHgnYBrq5ntFjd0bPZzNtm6645iPCfDAuzkw8D9L1tbWlw7cRdgW8_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHej8KMTkuUCx7RQL5bt1mGluh2mG-7mjatnylT-9yjg&oe=6ACBBB38"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCrND3AoMMwQ7kNvwGEBR7m&_nc_oc=AdqsaBNw1DHw3yKWtUOmaoftE3l5KqeR3lQ_RWgzD0R3XBWz2aSh9bAaC1y-UqwJjT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSKCMiKyTq66UvbmEc4IwVSBb08bBCrw5h4gmW6mmqFA&oe=6ACBAE9F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGkhNEWRiBgQ7kNvwFFAvO6&_nc_oc=Ado8W8uUTJgH4icivztbTRLN7sbsb_lfHowO08VaiC0BIB5to76uv9RDFlFyHK7LXd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8BuiMWGQ9GqYJZVL8c-EMd_zJi6V2hj7p5pDH0K2zow&oe=6ACBBA3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyEqEoslCm8Q7kNvwEIjxAh&_nc_oc=AdrlFiOHIP7UkzphFcqVqHVMZrGfJHF5u6sc6hKbwuGNp1AUYUYcH6b61kGBlsdrcv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObHlcMc2R5NU4q7W5k19
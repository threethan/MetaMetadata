gQ7kNvwGKZXld&_nc_oc=Adq1z7kmt4dwM56veSl__ehFo3bn2sJstKGmeHyrcZm-_002luCCvNEQHgvM9uLt3aA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe-7VAS_1bbLmxgcmsvMngslmD6bivJ7IM5mzT-NUuBw&oe=6AB3E996"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsYl61d9MVQQ7kNvwEdHlb8&_nc_oc=AdoTeo_U5pOo3MdPKnZ8CtpuIohq-F21GLfOXz-JnOviC5eD3SAbgdaBvfaJtLMm-kY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZRJgO8sKRS6Ksg2OyrlZIdg72RM0RRx8k9higKRrPSg&oe=6AB3C7F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIn1KhX8CDMQ7kNvwGHjonA&_nc_oc=AdpwspADTYS4A29JAT6I1AGrvmhI3FLDMYuOeTIbw87t15fuLknZLOi2bUMuZ3riqOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO_42IU8KIDnvnJZL4LuIp3gb_HnkPtdbzkxdpN6G36w&oe=6AB3F39F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjVccEuu3VsQ7kNvwGdAXVn&_nc_oc=Adotvy_pBNBoCd2nOqtYbYwvq202fTD9jt9n0x0xEuOz2qfH_rxORBInsfsd63SmuZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7qO8XELlP8kKdTygAyi-fL-dZQPPa3Gph_ALXwLhXWQ&oe=6AB3C6FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk1bNKB_ZIwQ7kNvwHL4Pcp&_nc_oc=Adpf2MUeWUChdtSIV4OyGUdlLX4e0rUu2AzGvpaFy0oE0-i1INBi0bDAHZH0hswbRHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2w1bH7_cVhl2DaYcsZA
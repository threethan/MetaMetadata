oQ7kNvwHMZRmG&_nc_oc=AdpqwTh2xb9ZAB5vL2gd4Q9e4idVIDaP4qSY47ylIwM2Cb6RZjfZR1TLhO5yEgNBm60&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCK4E702zqmeokXiy1h8Bgkab42yaeyB0zUylwDjZXRw&oe=6AEC9A16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXNekJ777H8Q7kNvwGHaWjm&_nc_oc=AdoIbShrYi2iTb26tRf2MtyNoZ-o_gcN34saj6jMRYngr5-dkf74cZczkrSJcZnG_7g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7PixjI28xFvIf1eUvkvKKgJEOOzVqZ5f4cVYQTZxM2A&oe=6AECB0B8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqrmfqUkHpwQ7kNvwE-RmJe&_nc_oc=Adq6_FD5N2GFxplhmrbmEAWcmRh9kfD5KsUifCxEBNkk_QFHm2yQJkFQSneSvrwjgkQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3yEntwr7kvh64_fPqA20kndUtuE4XKWTiBeBOTM1q8g&oe=6AECA41F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAj9U30PgEwQ7kNvwFCj9kL&_nc_oc=AdrFrI5AYR5KrfHCiTAzpa0k9sm47pBpHITU_qQtc4oFDqH0ZdJz1FFS7pZMInQjhb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT79xgcz1bNxch2KLlPN20Gu8lUQIKDROJohp4-_RhR_w&oe=6AECAFBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju-1k-UZphoQ7kNvwHCFkOe&_nc_oc=Adq4COQl7bbm7dDMjTNa3tRY5fUorYVqXZjEgQ0QpxJzGDZQTRVPBDsnBLhAEou0qps&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToX8Lfnljlh1HpITM3D-
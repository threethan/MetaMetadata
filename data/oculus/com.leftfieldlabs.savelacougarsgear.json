MQ7kNvwEN75Ny&_nc_oc=AdqG6LdlNkyCJQTW9ai4iBuoURCrAfRuah0h3EyQX8KkHzAU2qPZZzcgsDsZZc2IXxw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hma2zNsK8l6n3Ht2aLRHbDcwYK0XhQxh-xr6dGrxT1Q&oe=69F4C016"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBTgMuv9GbQQ7kNvwHK2_Wd&_nc_oc=Adpro69cp6xNPj8iDUpraXAhtcivv4mEVWyz7UAv5EdHgcLFQ3EWlFuEVtcCIyHtqtA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Fv1WYbPpUZ13xzDb_GKga_Tnueih30rkgtsaNEaqlcA&oe=69F49E78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HECNU9T7mZwQ7kNvwHLn-IY&_nc_oc=Adov9rEjkv3ys50yxgiNJI9fQsffKjyDL2oK9RAHx-7rw_IcAQWd8YDo8wv9c9nUsks&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SC0ymjSMJ6FMVsl7waCNmHXsZltWYYNZrbHPYMjxfdA&oe=69F491DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqGiRIvVmMYQ7kNvwHmrQaP&_nc_oc=Adqmca2AXV6rma9mxRMeI8Rf1xGBajgb8IvIAMv0VoVHj0Es6mbnhjm9vlj0C1VHwMc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ItD7lqtEPOFgVLj-hmmPuAxP_FQqCg-7POs8ckmHGQQ&oe=69F49D7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKfcfbSL8G0Q7kNvwH3FtGT&_nc_oc=AdpoDuravh17WVe_m3tndjno91PrRTrHxy_F2xUjbV6MY3VrYR-dfqsbn8dgJ_0bQPE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Z79-ngmbK8rEhaHi-zT
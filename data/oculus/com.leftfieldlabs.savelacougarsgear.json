cQ7kNvwGfoBPP&_nc_oc=AdqXzyZ-plripmWOu4kq_JyT_Q0OWal20mTYwxXsKFi24oPPFO6BUkcMIsq91q6tNWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWi5BxLkOsLsBqN9aMV0GAXox1ZeX4Z_p3xxgbU3AdtQ&oe=6A7074D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmgU-3ofBA0Q7kNvwGQG-xY&_nc_oc=AdqeW10W-UNf8hrOWnaJ_u4_KZE1LcrGAc1W1kJ-MS0rXw_Ppqwk1rMx674YukCdYdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTgI_oGSI4Vb01xwqi-Pnpmw_fzecVX5MqqGjYgsAeKQ&oe=6A708B78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfSzhhpu2NEQ7kNvwGvM8ta&_nc_oc=AdqvDT3t4MlOA05JncWKWO3gEfyFxhP5XCEPacbB7v86JggGfd4mooaeW-NXimxT5PM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbqEehr0XWQ6rO_gfZkNtDElyR44JCXrT1DUt0Bq-s3Q&oe=6A707EDF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdMOp004pHEQ7kNvwGcAYNd&_nc_oc=Adp8EC3bflv2w40XVQNEaU5XyLhZ-L6bnklxF8AqsBAnkv9xpLhGGmTeul48uIkxcwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhUX7OIzQnFbtDVJE-9ccZoerl0TAWcefgk5E_lP5rWg&oe=6A708A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsZdbq1zFrEQ7kNvwElUxr0&_nc_oc=AdqsPOyiSwT6sfws4p4J9r_5YZWEln72RQb6CGpHHM85Ew18rrGys1Ksz38i6RF1ELw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDt74f_0bLCz3Xn5eqvE
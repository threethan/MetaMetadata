UQ7kNvwFfTpSz&_nc_oc=AdrqInu4EN4cdgOCg3ChzHwz9PZeF7y_Z2-H3atiTPsSkgXrsVehHGqEMxd77YnS3Ow&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2tnuV4hxReXksQ0EK-8VXXBfIphB1LDGAm956XeoyIg&oe=6A819856"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQmuqcmndR8Q7kNvwFdaGjB&_nc_oc=AdpDz_ng4ab6i8i9IHm-hlQ30l9WpWPi31ED1Nsp6TEi_YSmRtLivTy3KMelRKJ8eng&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGNIB3sLCUA6pnCDtQsr1sXZzZJV1gEWYLc7DNG-fruA&oe=6A81AEF8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy1KZPtHi0EQ7kNvwGroK4n&_nc_oc=Adp5B_0xsu7ZUn9-7YsFqFmNpF5b2EfXm1KCHvV6ZRrqiXUzXZWuDil3PLvthevLgoc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSMdVUcxOQ2cxzPPVl9gZ5vz9CzwqqJ5ME4tRx61YeMw&oe=6A81A25F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHnr6YdwSkUQ7kNvwFhWmsM&_nc_oc=AdoSeN3cmsAQlmRtHwHoR5sajn7ccx7XQgaui935frXg8fC5hztjUAlTCtu0ry3LxUs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeLiCyX7W9EY5TWUNXgiu8JvpGauS0u-E07NFliLuD3w&oe=6A81ADFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1GFwFzZ0okQ7kNvwELXnpI&_nc_oc=AdqF_v4pnGOHeZaST7ul0OmTw3On6hqKjkOecq1qIfrGvTN9w7SZX7Lhx41O_-Pp5nQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLBL5JYMc1YLnHof3kas
YQ7kNvwGNve5t&_nc_oc=AdrA8jbistdd_SLzw6iAU8Btl1tPVCBWjFSb2VX88ZoFXjd4wby5FEh5u30piFo5LKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM28fsLD498sgwyFaVmku0HTVvTeKXuv0kBTdpFDq_arw&oe=6AE20E16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOKvMwCrl6UQ7kNvwFtNxEE&_nc_oc=Adr30iq5Rw6wb9hp3L7W0T3GFqfXyWJKIim1GkppYfrtQrH1Q_jg9qwGh93UU3P2Mls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcHVi601nb5cP8WK4DWdZZ9vVbCOnHrVGYoPijBstXpQ&oe=6AE1EC78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AagRc7B66dQQ7kNvwF5B1iu&_nc_oc=AdoeMKtuJRpUgTJTF5XxyGFcVC2XOVtVjrqMWtV2Qcp-KFVb2p6jh3MQKyfZcx3_Jpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwPFPemL6VWGZqbj_j0oq0gjhGS6e4vdFYfEzN7V1RKw&oe=6AE2181F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wievq5nKxEQ7kNvwHn-v93&_nc_oc=Adq6QYYzfrltBDhAbUWDWe4Toq-jML8YqYYxJMICAZ8srs8vy1r8TVhUVkIrZ-PL8Vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLgIZxC_GX8u3nyDYzf1c30XmC_9lJ716QlTVyKUukHA&oe=6AE1EB7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tA34T3-5psQ7kNvwGCbuYn&_nc_oc=AdoTurxtguSvgs7hIA5gpSYeo_jYKM8DaEhRetfZbg7aipoVWOgpNqWhk4n7x7C5Cqk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPZnfZNAmdJAwpb89iMx
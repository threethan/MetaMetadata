gzrTUQ7kNvwHu8PKN&_nc_oc=AdoPev0fQzCvioT5_OQKIK8xNtVtAy3_S82duj2Z1R-fjAwkKBoLv0wNjxL7GvbyZKg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JuJ7jOPRsqJ4DtnExHpdmTv1y20g1w4IrDMmvyB1jWw&oe=6A36AB16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbVe37DmvwwQ7kNvwFVoDtc&_nc_oc=AdpFu6Mp4khHKbvf9lST1nyfZqBLw2xOuCK_5s1v0UBcifEcOmKuTUWapZMXz4z-ipw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iDR_LXoEynCQOkOpMUmAMWQ519hXiww0oytR2xOhcGA&oe=6A36C1B8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdEdCR6yPu0Q7kNvwE1vBJa&_nc_oc=Ado0YzPkaBKjJYThD-leQYzduFcFABbEHg9_s6sc4d_mxg4HRk3mdVlpo13xU0UoCU8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nvo_QXCbu7NJjuEHlf6rA0Gn6Ue8xWkP7ejFXASifEw&oe=6A36B51F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYuFaR9gP9sQ7kNvwFXtsc3&_nc_oc=AdqyPNHiwUvxa1mtsA8GjkTL6aM1JPkX3yx8bfEw1M86O3mVETUCJtFh8briSHQFTEo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jxg-qAFxjlu0d5lK7n6k0R7sCGMofI4YU6b_t1Mcp7Q&oe=6A36C0BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZxF6MoocuEQ7kNvwFF8g9O&_nc_oc=Ado0rlEVCYmBDh4W_IIsEBqe7XeBQE11CzMb6K1kXNDBtD6Y6k-d4zEKUVKjJruvOE8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94zA8uLXO5IkeX
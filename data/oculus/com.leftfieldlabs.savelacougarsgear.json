0Q7kNvwHUrsHt&_nc_oc=AdpqrwQ46_Op6V1I_Rxtv0llm69Ga1E5l4toki-09XTCSYAUZp8t6-DSfqEQFOlGN-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYbbdO4bT4a7P9dBZ5002xFdOWG0Oow7pMPcCGqA72ew&oe=6AAAAF16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8571dtVQxFEQ7kNvwHxdSk4&_nc_oc=AdqtsD8OsYQKx6kwpoJKIqFjTsx6xL0A4uOqw8QnBZgGbLkx13qDqKXYPHLx-V14ml4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIHFdwGD-J5MHDtip8vPbnD5denQitStWE1xTh-UILNg&oe=6AAA8D78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBH4vRo6mhcQ7kNvwGLSU-0&_nc_oc=AdoauIwFT6_E4T3ufiXFZKDAHYc1QaOFC5pb2zDkYwMrPLTC4D7jJeaWYaFzWc86-vU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlZoA3E6rNj_-O_Cm3dqWhP1My7KiutPosUhy8wSQ6ew&oe=6AAAB91F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNrDpPwh44wQ7kNvwFw3JmS&_nc_oc=AdpnhVqnOoe6hzyd39Gv9J2qtLo23p2taWHI3X7z7mtbtV59Ieo67OCfXlNgkyja1nw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLafYNV9YO_9qF1avvM-d_ZWUK91iv11PSw5NXu8ur6TQ&oe=6AAA8C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fcwB1_EFkQQ7kNvwFtbulJ&_nc_oc=AdoZWfX8TzSHUG0DMEE1mmSUr3roNWEIz_6JI2AAjA72ButYui0F_PnlESVlS5MCl3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh3LghUJfjh1VOWTwZcj
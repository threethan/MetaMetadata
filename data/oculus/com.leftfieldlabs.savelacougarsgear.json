kQ7kNvwF4jcex&_nc_oc=Adphq5r8ISKx6i91Zcfxcf5YKSnZTkCMJxhNHroqjRhckVvwLf9wlBYlT-9nMgcTomM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGOMZNY-9RK4NncF6_TYRa9mh0GquoFL5VfnFVONKrbg&oe=6AF33196"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6XA_I4FtZsQ7kNvwEK1Ga1&_nc_oc=AdpzKmGiblDN9WeTAgt1D4VFWWlIEeOsFeGXev9qGIQsoezu0_-U4HtYWvgik7dacOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqsVDza_zMOxE1-yMPY5Z1K7C-ZQTxikogiVlV6WEa3A&oe=6AF34838"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI90RV91QOQQ7kNvwEfrl9-&_nc_oc=AdrqbLVoHBszoODJkvJNds20wYFzL39Ld-QY5VkAOU7Pa25Y_CjwayvyY9Qj5OSOmyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNogzJWqwKNdcPJLIwEDE1focOd5l1vgWoPZvuwRfm6w&oe=6AF33B9F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0Tvu8Jr8CsQ7kNvwFBpaMi&_nc_oc=AdrlD4HVEIVpjf82qpKB4QoqkQU19Ut4zY52QR2RixOIQqaL1fH_0WWNCJFvdBrJr_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK1866eUl_7ffESMNzye6fkGyEPuJj6k6LG2aYXyvfMQ&oe=6AF3473E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEOxUjKzxzUQ7kNvwGk58qF&_nc_oc=AdqTmpmxgEW47n1XYBbG21VoPm0z1UeWzvTAFTASdFpN5zY8A_KkBShzeBYGsXLyfUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5HXlNKp11LIYfsIGORF
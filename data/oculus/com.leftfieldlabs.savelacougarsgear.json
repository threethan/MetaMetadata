W5u2QQ7kNvwFYgvxV&_nc_oc=AdoTp8l-JsLXXcCHV86YNFzeLNTgbZyb06rIQoe10roGYfib2vPhHOJtbUNk2EOsdT0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt8L0-EOraR97Jg0GzipWgGXSklNpBq1sVGdT8Eqrg6g&oe=6A7DA3D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHw-JkZGOPYQ7kNvwEHuANi&_nc_oc=AdqeXTkFJ8WqDyNUNLSPmLH1wvsROOCAAgHUElic6kexN1-HjY1wDKd1dPIMfQ1dhVY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA6D075bG3Usbkj3jvCOB5jnR5T2qT8b5e5BE3sw2c2g&oe=6A7DBA78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ_x5IDM9jAQ7kNvwE1ksy1&_nc_oc=AdolL5YVPne7YaKYjYXLyVVulQk1iQGvLyCwjrO3bzRttGEHzwDGVYPB7OtYrNURktU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtInmaNJYhn9Wk3k6Djxc-2AllRrO7s9L-2-RZDiv6Qg&oe=6A7DADDF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unKdf32xA1cQ7kNvwEE37nj&_nc_oc=AdrZEtnK3km-B9b1cp78GRsdUAcWlj5ZFzin2fCQJEsWhHuqQtRgqv0GgVjjxKD60BM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB2-q8y_MGAUcPvrt2Oh9XHH7IdnSfxN6nf_hrR2oMKQ&oe=6A7DB97E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z3DWwlYHIAQ7kNvwH59iuf&_nc_oc=Adr0_diEA27X5ToENaV7rRvfNmwXL7FgZL19TMHrQlTqIPxbuRk4dGwQF3xS0cxxb1E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEdI-aAM_COMGm
kQ7kNvwHIBQup&_nc_oc=AdqP0uwzLtWzb4VEZvcF7WHQDIEq9J8id2Ud_7e-sS7e1uPD7lmQTjQfPg_5Kc3ZMQU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_5DLqScNCKEEox8EnAOWrjAsE5i_5hTehN5AzCxrDYw&oe=69CF9DD6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH2YC3tnm-4Q7kNvwHjV49C&_nc_oc=AdqLMqNzN-8ldE7CLwwkSCFXsI1vHvLkUwwUQUmAE8d5EjclXZ3ztcDaAa1Ha4brGg4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykfUz51tZPwzE6sfeOVlaxE9bKcittrHG2eV2c0ANbtw&oe=69CFB478"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCPOchAmBAAQ7kNvwHIjsaX&_nc_oc=AdqD8SnprE0Ohdg9g94QVSxt3bMt6XKqtaPNGLKgPp-PHn4LFSvNW2hxMn5mKmLOX5U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3XgbxZrhGDOqNjDjhaF0bFIdqNnOIEcstifMwACD62g&oe=69CFA7DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoRpKpdbhR8Q7kNvwEW8m75&_nc_oc=AdpM9ham5t9VKoQ5n0gBZQYC5St6qNfed5P26DqRZa0C708B4mJtuO9Ot33413PXZ4w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxw7gBgXt5Y_rkakgUd0EN8ykAYlWvLkfsnsynmOjuXsA&oe=69CFB37E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4LCi5EhUsEQ7kNvwH7q8GD&_nc_oc=Adqw2dEpO0hJyAxAuKVsqd2iZ85fQv-rudNUTaOEYaec4yzPO2t2GDD-mOCFCCoaW2A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnDjZ6J0ZfIq5tyTQU_Y
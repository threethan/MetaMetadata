=scontent-iad6-1.oculuscdn.com&oh=00_Af00paWEakDLkqSj2cBFPep3paBr-VozpysLWA2rhFHGQA&oe=69F0CB96"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqb7D5omWOcQ7kNvwEKvfj1&_nc_oc=Adr9yw1qUDW0siOdtv8sp_PZ4ePA9SXV25l6vqzVTC4RsQ3225qNEDbGed8wD3suTCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0LgphCRxhaJpvBRByPHbTyV91lBANeSsMgyPo97pTRZA&oe=69F0A9F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXN02e99VgYQ7kNvwFkIv6V&_nc_oc=AdoK7MfI0GRWqbrEtkl-u_WJGYQf67RKBuICqYtEiWoRsObnwIAK9hTnynt9Se8ugJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1_BmEjsX34O7W1F6geh9Ohi45THoZSPFRtJ4uKs2UzoQ&oe=69F09D5F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UISTxT3dqAQ7kNvwFy1_Ps&_nc_oc=AdpOQbl9g3-giD74_A0Hg1WagaFvqEWZi0-XMx6MjaS6Q1e8qZ96cfk_CAmfQ33kj5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af22lpAHib6ocOh_6GGj7Jw2DS-9B3oQDJOi1Liq77xvtQ&oe=69F0A8FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLeiOmrHjWQQ7kNvwES-Oa4&_nc_oc=Adpx3qM3xNz4Du8wMNjp3bTvNpf0EUrMYDkvRbX58dM02-Bs_a33ToE2RZNXK9hl-R0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0Lr3RWPXciBMAeYDMQPXMKY_xCQ2v-bZTyzYY1obRGBg&oe=69F0C8EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Save LA Cougars VR", "platform": "ANDROID"
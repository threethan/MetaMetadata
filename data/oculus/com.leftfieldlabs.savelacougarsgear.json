cQ7kNvwFr-XRQ&_nc_oc=Adp2jZcZFXJdQSk-20ra8d6DWZedXNWQfSMgIgOoLpIvfmpuWeyaXFvahsrZp2AOk3I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GCMdD8ihaD_4SEZTUCilmH5m6P4Xgiy-2t28lOV9rhA&oe=6A0F1E16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OMohvNJV7gQ7kNvwGdI6-S&_nc_oc=AdpKUFC06lGO6MlBySdt4t2ZusZevtSLa1mAxOYhLNCJ5hTQ4M_AjdDRt-43J-_QCFc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N6POJkAASAODxxwuWsV0aMT-Rs8q3-HxxLoCDvVOjbw&oe=6A0EFC78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hS5yq93SmMQ7kNvwH4qY1G&_nc_oc=Adr2h0HdzaxpJBtRMlkwdnXutky5jCQ7QMOKXes_4qL7qRgL8i4mzLrUjwiIlQ6T6VU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N4wf1Kcf4iJ9ADJcpbIkdJnmZbLZcfrgc1GE52stJ3g&oe=6A0F281F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cptrdqnMa7EQ7kNvwFOJVR6&_nc_oc=AdpnnOamaw80grs6u9jG8R5b_5yk1D1vGDITUMPnUOTnFwrZrMzMvLU9WrCkSkrvW3E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q3dMbmeZr8q0hH5dsd8P_WDoOymW98YwojkmV3pop_Q&oe=6A0EFB7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmU53djhUSoQ7kNvwFegqRZ&_nc_oc=Adqv1W_CQDgY2F0nRhruiqcEpnYZW6dmT481Psx3HfOc9BD2n-2AtkZCoqShs6i7VwM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O8SeeXh3wSZXauDaUHE
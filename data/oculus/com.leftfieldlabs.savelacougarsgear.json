QQ7kNvwFufcH6&_nc_oc=AdpxOR5YUhaBIfM-RT0LYq4Fj2hy3V4YOQab7toZPEJekw18XyHNgL0mY_lnJmWbZCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PEEwv-63c5uh7a32L6eWRSuh5PdpEoY0JBgS-lrw1fQ&oe=6A3E9416"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSW5SsJmvJMQ7kNvwGoM_z4&_nc_oc=AdoLMzOf13KAKV5daR6-ZJQVOxzgTHzo3fhVJ9JDi6mHYZC0WpogFLwks99SQE4JTkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pbFBEEPi9tMUddEBalVQRv0nKRUltubw2y8xtED98WA&oe=6A3EAAB8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddg3Vsjq7jgQ7kNvwFRQC2-&_nc_oc=AdqsGxnkPZtpq7dgTOpPx7Q5WhmLkooQy3D9m_y1pPngEV6FPkAOtA--kV5YzPhaAgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ZcSNlPu0WtXc7gxn1uh52TrtEXcIv_kMdh4mHqYGxA&oe=6A3E9E1F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzqpLiLH7vUQ7kNvwGrh9KE&_nc_oc=AdpKjF3hahXlO6j_PGGVXL7S0g0kfQnaZzlzq5zm2UxHuCX4hm1xvt_J61RaCZIPi-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EwmI39QXh2_dqgl-SMtCdHTqvQVCwH1DAO1YQbIcwXA&oe=6A3EA9BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMkjO2bhVa4Q7kNvwHsJ3vk&_nc_oc=Adryu8jrLQygLdXCPMUctqRCUPzfnabifKaGfwIGAJZKd0LcdDNTet63WgkhWz2JaS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3L8Pr42P_zqIsa7uzz6
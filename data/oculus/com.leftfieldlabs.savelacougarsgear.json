IQ7kNvwF7AVp3&_nc_oc=AdoRqgQSyRjpOHK5JwJyP8CCVcM2Ekt0fcYY98eWbEX7Jrw-WyoxX447a8JChIm03Qk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi--KFvegShVvpyeAiRr9eOSywwOnVO4C3biAwP8AFkA&oe=6AE35F96"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOKvMwCrl6UQ7kNvwF5GZe2&_nc_oc=AdpqoHI4ZFdVKviETCnAD7Y3_gw4UhEN2ic-qeElLJ3M7YN4MXsZgZQU2DksnnLvFuY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtXFjXSN8ChWBEYpQkyMT5Dc8UnAJeE3eZGRGZbQpC2w&oe=6AE33DF8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AagRc7B66dQQ7kNvwEqX4pe&_nc_oc=Adql9Jl_uJ8HaFPgk6Yw2xMZJYw2IrcFOcuBNnW3INR34u4aJbonceDsMFXa0n2CEjw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhju-6EKvw_z8JWVB7KUFxVLVdEsiN26SHKKlCV4wlGw&oe=6AE3699F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uijydsGfpDcQ7kNvwHSF0z-&_nc_oc=AdrV41_nDgqaFIzTz1LsK9wNWfiGM5TZahci-WhkAOxBmMVLj0MrLuo2WkS9UB4mvrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDDdP8HRdzjo45yo8OkMKtOY1ukIzbP0bucekoL05MEQ&oe=6AE33CFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tA34T3-5psQ7kNvwHXiHUE&_nc_oc=AdpZu5x5p4JmDIHCAJPPmQZZPjLC4MXrvlKB1H2vz_Tn9yskAHo85aqVhDV_5evrjlo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYYaRqh3TrR9BkfPTVQT
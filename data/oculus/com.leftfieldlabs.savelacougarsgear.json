MQ7kNvwHEf6KY&_nc_oc=AdoO5rk_NC3_68QW0zRE00mWACcKIHEqMZ-73pA4wDNAK5F1aicKgLkN9xXJwFX-P24&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELgzdE10muDPLs0BxAE11Dvy3P0CW_jPJ5aLBxr92jEA&oe=6A940D56"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YlcY0VbXboQ7kNvwFSNoZs&_nc_oc=AdojbOL6hwZz_Z2yMCnuyNRTJzAiXVL-zjp8QG-pzoDHrEdc1zcZflqH-8sydZP5stA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJC0BKscOG-201K62IN0haces7Z4tBM47gHMqfvbxBRw&oe=6A9423F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42o1CgKHrc8Q7kNvwFSGel3&_nc_oc=Adouhw9KWnVdvpjPRoRDEYlSXv-zsS8oPTc8IeLwPKyeMWgaP0h_BDF_QNlkBEYzPMI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNgtsQE2MehU0Z7nitFgsIARx3eMqHGTkG9cMWYZpoSA&oe=6A94175F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5drynJnBZgQ7kNvwFmmiPM&_nc_oc=AdqFT3Fx3_uWdpqBU1QxdX-LaByCZMxM9OpagEsz_IQtVL13piBNDU7LcfqeoWGG0ns&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhnFZK69tMr8DP8YbUyyzqsigh-muYV41zK8iCG1IxdQ&oe=6A9422FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOSUgV9e4FQQ7kNvwHDWHKC&_nc_oc=AdpmrQaewqQOyxXpdBU41XCbGOm_jo9P-BU72umj1NpyGd0LVTD9ZngL0hi-D3UwXCg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzYem-fBxuQfZK4snvoQ
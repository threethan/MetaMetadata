cQ7kNvwHBEJh9&_nc_oc=Ado-ZzRzQtUlE0anBkO-duuccCDw_1T7H98EyL2-zmKWwvaCJiDGpZ9EZoNFqaU4E-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSKXphMxt0QNNA2xBJ4Dd42U3Ts3nMtbehXTk4tbxF2A&oe=6A54FD96"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08nmEqLlvgMQ7kNvwFf3W3r&_nc_oc=Adqc_XDEPy4EOSBJUx6byf9rbQ54SnulMnwgp3BU2hAVhvo2IhAt0189wZXIZ5iOojI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1sdgvHS4QAd6-JRA6BT-kFoR72vnC0mVrqfjtB4A01A&oe=6A54DBF8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKe8UJnaU_IQ7kNvwG3ucQ-&_nc_oc=AdqcpuoEYZUar8fyumpRj-Rb2TpKN2QTSjvqDE1iPKxYHFiRG9G9XoO-f3SAoNkAkaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7cPYp_8t1MoqkAEvzIZx6IxA6YSleftsoV8y87WihjQ&oe=6A55079F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD05MCKjNxcQ7kNvwFmBjgw&_nc_oc=AdoNAB-fuVlJP0e4tU2AIw2MJDYhAZQdxPgq7nsYJ3qpVkYr9-nfS4aH-sXDczMbCXs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyhOJ6HxXO_F-DkClG0tqE66M4SWrM941sE3YIliDwSQ&oe=6A54DAFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDEbVRzNaOsQ7kNvwFF9m3H&_nc_oc=Adp22AmG1ldO1oc7FdccPuT-5hph6ejzDNgr5Tau94ob1eXA6PTyJG2DScfp2lpgoI8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtLDkJGMCyKZ-KWSVgox
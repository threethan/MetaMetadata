=scontent-ord5-3.oculuscdn.com&oh=00_AftHlOit6msd100nPKa2WrW91G6QQ8eLhg8weJ4HYF6_kA&oe=69A41C56"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5BJReu70woQ7kNvwGI5lhQ&_nc_oc=AdmNbjf9CfvUxKEzRq-N9belUo4pfSP7-yL8WwCjJyxOyqmOv1MLMsLk2_G_u0j8pvQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsl4vQkCNG8a1lhU_MRHys_xI8aNsitC6ipu6O-Ip0yng&oe=69A432F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrieHAPHJS0Q7kNvwE3WhAJ&_nc_oc=Adl2pcHqo0CEsSvHWZJ9xvLqn4Z_v3cteUutkKRDMeRbjR1HlRddChz2C8jbCRVNxDs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsYZjF6NonJ4jLoJqv7xIX6W62ymCud117x8Jt6SnFnbA&oe=69A4265F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PH96HAHj2sQ7kNvwE6PZ09&_nc_oc=Adk26CbvTfNVihXRiu-_3-V6PuyDj1o1m3o-5bdM5BTISYqvyjq0gti2L7cKc_4hHHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afum3lB2fCbHCl85WltOwVBXidKIuIA_0BHEnyxgCKuFqQ&oe=69A431FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW-8OuVxWegQ7kNvwH2ZucE&_nc_oc=Adm3aL5LEV3rHXy05pIndx29QukvSNRxOsvUnNyArY_ZhLJCDbyPsQ7jd8ZXUgttkTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvqUrNfveK0Q6bruEFyi3H21wB7FqaXa3Pr_iWZK1IlPw&oe=69A451EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Save LA Cougars VR", "platform": "ANDROID"
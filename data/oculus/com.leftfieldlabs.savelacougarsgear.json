AQ7kNvwE9vckT&_nc_oc=AdroCFnS-bNKmLisT4q6bnEgQhLofL01ETNrHNJq06C10BsQWhcI3BSpNcaMPdG8VJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MB5kjY0O55YV7PdLTIzZMOxtKZuoVg8yDh9HOocZb1A&oe=6A15B596"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri62oYDCnycQ7kNvwETHZE2&_nc_oc=AdrsoV_3vPPMxaoeM0eprQMHDshRJ_fMuE9gf7yuzTuzuezNg3fGfy04sxk2o7GZeB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cAqf1xQaW2M_aH7ofQ_9-uIL3YMDQHWe3G0T_RE29dQ&oe=6A1593F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff_f-wpEr9YQ7kNvwEZXQTl&_nc_oc=AdqPI4dmZRdzjH5YSAuz_kTlUJrJbcLikcXG5IeD8G6zhUNMo7i7g3LLN5WmFOFcxAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59L2JzUqx9ATyjhrJRn7hdJVBvhG_nrA0ozSu6ewkp2w&oe=6A15BF9F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4WgBWoVk5oQ7kNvwHzD8gV&_nc_oc=AdrISGY8Fd1tfqsYg-mJ3jQchgMXBVtyypn9AqpPTB4gswMSeWn00Ccomh48rD6ZaQ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_ynASvHIpFTawMqzZ0iWQJgMjRallEvmwA2D5ncCtYA&oe=6A1592FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk8PLopP6RUQ7kNvwFOoJ0Z&_nc_oc=Adoh_G6QE1BYILVaAB4AJvlGkDyCkcElLK_PWMWa-hYKeHsLh0L4T_Fv46r2gsNrwRQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7awmBL8U3sNo0XE7_Y--
wQ7kNvwGBXGia&_nc_oc=AdrME_6EjIat-B6WEi-edRuJm4NvlVILDzTKzUkZ8C5OtCDYezbw0jilIRkbUDAdb3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJzUDSsy3XjxApQEveDW0pJJyJ9KF4lUz-z35AEgxAcg&oe=6A58F216"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07sZ5fd4WKUQ7kNvwGIKy0v&_nc_oc=Adpx9BsE2n0WEvO86_zDxp5hbwlCpm5dEY4FCAzueDpudJeeRrZvEXMdc4zc77kV43c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEiS6dmM2VBJWbmoviagiHGy_j_fHDVRr3wabGRMbuog&oe=6A58D078"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bv9JVwM0vMQ7kNvwHjHbYj&_nc_oc=Ado0-FLoEER2WUhXCS094ICRAUB6LDZn5LEWAznW0wRTxxISdiUu_KSAMz8wetSr5iI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYQfmmNgEbFhmbJrZ0MurOED1S2pDCUu9IBLjj54AbhA&oe=6A58C3DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_zfD7fFINkQ7kNvwF01QTD&_nc_oc=AdoaXfdxMrRnrEuplEihxA-i3NEUtKGVOX0Gli2aMBtkGxVM6X6hpIKmyWD7WbHPzmo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQMAxA7YPewlZRoueHFDV5VNnhr96iwiMEv1DPeeRBjA&oe=6A58CF7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlSmshtntKIQ7kNvwHI0lCh&_nc_oc=AdpOt0VUUFXDpus1NlSefSLHdmIXtd9xkUGCcEtM_iRaXb2jlTovX752Vm60UeC82TE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7_45zr4hLBZhdmNvy4M
JiIWldXHsZ5p1McYCFPNsgVbc7IDvTVi7Hr72gSDuCUgRAf1r4ipZVBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt94iXwSzF_fDc_U-tfaIMpbF7541fXlTlX2kTtIo0og&oe=69B14B56"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4kBtGXoC10Q7kNvwG-pTyZ&_nc_oc=Adk278QEiRfs8-g-yXfBRISEoeLt6wNvnM0XN1UL-TvdKRPwgWx_-pmoM9w3Zkcp4Cw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0qhkfR7W02ZigqFZlVKTtf08I7tgn5E_ww_rnba5J-A&oe=69B161F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxm8sChwadwQ7kNvwEuAWLf&_nc_oc=Adl9JvtLKpBJXgw6IYFWwK3MKcp8LmhPBee6UaguEfoFFoc2Qj3NFB1Mlj1DhBZQ9aQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_u3BIMN3jgDTkRU-QV1pJqx3V9PZJrcJjX6QEA3nm8A&oe=69B1555F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBaCbPygEPoQ7kNvwGOi1gO&_nc_oc=Admo3VtIM3iBNbZcXJFmRwFlmDiK8UAD_x9El11BUirN7imRdL2S_VWkm0hXAJYVmpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxd_GBL_FNLvYYoZ7wqIjHIxLghK2MqCWloPwDc1TR-ng&oe=69B160FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNVT_Uftvu4Q7kNvwEWU4C4&_nc_oc=AdkHWzE5kgG2ViXUgmCNhU2gQdfUlFACWtvArH8roXGSsqfs0oFrhhzNIWIbvJ03OME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuQ3iVQeT94nioqlFmHeR_TVVuYdkmvvtWm0A5FwWIIg&oe=69B148AA"}, "is_concept"
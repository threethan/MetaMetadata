kQ7kNvwHyLO4c&_nc_oc=AdoqIEv_0WfkIovO9VHipHfOGNGkz-LAtC6gbHqB5W2PNi_APOtBDLuH9fHQWwKo8-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdZv_w0w1J_gZgG6pVlojVT4XfkDoCLKiS7Y0YD1TtuQ&oe=6AF48316"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6XA_I4FtZsQ7kNvwGqW5rJ&_nc_oc=AdptjO8vA0LMk2EP8WeyIiX8knAButYBE_5E4YCb5gBBjfDBbgTRkVclO9AB99jrrYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW6tuhcINYWu-bRoar7HtkVuQdZCA3rGQstKtTZGgirw&oe=6AF499B8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI90RV91QOQQ7kNvwH_-aqG&_nc_oc=Adqgy5w9RBSaDitdxppdOiIQJEsJ0r_jxB6Ei3DlmYn14MKBF-SSuRyBDcM9GvEKhZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhPi4sCjQIgeqb2RybFrfgkWX3Q-XhLw36oawCSJkSSg&oe=6AF48D1F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0Tvu8Jr8CsQ7kNvwHENOzP&_nc_oc=AdqIPsz3BJ_RtRW10vKEyUnsitY1583C9RNAXhyU5t_xzEv2YMibHDWGtptIy9ByCUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWQRNnCP2ixHaVJojXE5kv0JcxkQgaTIzeV9_6ciMmyA&oe=6AF498BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9ox1UTEA6UQ7kNvwGPuhky&_nc_oc=Adr4AdXR262piYjALROap6JZ15qJku50WAB_-NkWY1hlbWhkDGIGrfFDjIuhTJ6HVHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNKnUIDuigOV9p_h8fyL
6C6T-wP928yPN9B5VEp-a9hN26SImNcuRk7U6NhOsay9sSAn3yHDR7L4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDjn_HhshrxtwY8PCFSUL-6f6CVDaqN_mXE90nHMlndw&oe=69BD28D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS1hzopAclYQ7kNvwG99COy&_nc_oc=AdkSbs5EMMAArzM5m0N7pfCvTjks_hZsnlcT1QAMOgrsSJc1WRtTJhPlnzaDnkXSl14&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8o7DQXyhmdcjiM1ESjJOCRFORx7gJgcfEJeHzMExbDg&oe=69BD3F78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHhyqZALTl0Q7kNvwHBo0Rv&_nc_oc=AdlxnTo6Fd7h-lLxkt-_AYR5ABfPax7gDICHmPoucaWY5nckHOjf-iQ7YksqjHZgSg8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLsM-DN1j1CMvrA85IncoYiEwolnWvpdPH8UqwgiaSvw&oe=69BD32DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb2OH3rxl68Q7kNvwG3zg2d&_nc_oc=Adm6PvbtGS7Apc1qiFfljcJAbV2bZCLFGTNmRL-4cmc3eQzAtHX9q26APRkKxWW4oUE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8KQcMsiC92GHfu4u8uZbv8CkgeBXYNdpJZs7w36wv1w&oe=69BD3E7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjCIpm1MLhMQ7kNvwHfI3Lx&_nc_oc=Adk6YiUdxSZT0utA2_Qrhpn24nggMTiBWKP4-aXCrLgQ0m1j8-6q2Z3APLuC1Xdw8qw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAScDWb6AuE4cK8KSWJArpC1PrTnm8ZBEA6U-88l0-GQ&oe=69BD5E6A"}, "is_concept"
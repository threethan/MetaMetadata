8Q7kNvwE-LLiW&_nc_oc=AdqbTS3JYO6oc37M8mjbmy5Kc3-v3r6uXCBZXylHyyqozE2iXxidbMya4M4PqxICz9Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_6WqAV6JY8fHvx9oKFpjN9RFQgYWocCcJngs1u1-adQ&oe=6A882FD6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHchTscgpmoQ7kNvwGKzziQ&_nc_oc=AdqssIA2vGSACdTWy0UKEd9dyEjD7FU54jImDosqFU3WLRXX5ly-Bbnt_JVeTWaJryw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuuXrm9_sT4rs1gkFjtnIuUb_svrag7r2GDzUmXDfqQA&oe=6A884678"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MDzGLhjsTgQ7kNvwFrcfYy&_nc_oc=Adp_gz6P-y4e5lY5h2P9CbsA1NvkCCr5rkdWA3hu3nVA0k8hpb1dlI2U_jfErqPpazk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgzgg8KQgiO5ucnQzv_UFoLnxkMuqJ32kmYEKHhw2hRw&oe=6A8839DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25bLhTVWQHgQ7kNvwEKhMhI&_nc_oc=AdrA_Oeyunl2EU-WBKS_vSm3WZeR6jzxKj0QklFsadKkP4EkbHazpLhCqm4oziCIH9w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKzUtpo_YDDfmi02BhuEozjAT6VeuN0btMVtf0uYGUdg&oe=6A88457E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l5Y_qGLYWAQ7kNvwETyeOl&_nc_oc=AdqKdNw1IcBdCjQyonpEdIg2jeNv-qqg_-QiI-dj0gFAqbbegeNo6zl_W5oOXt9qdgE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy7o19obFwpJaUZRpWJ5
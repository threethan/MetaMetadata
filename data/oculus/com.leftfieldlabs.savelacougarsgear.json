8Q7kNvwHS2jbr&_nc_oc=AdqBfwgFmA5O8SO0l6m9ZLiWFWHdhSLK0iECe0I0ZRkd1WfaU1XrT2ofnuejyzVGhjc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KUsQVLzKQG-EkKnPdBKbRXcR3eCamZH4ssRDGOs8v-Q&oe=69D7BF16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz54xVimaR0Q7kNvwE0TELA&_nc_oc=Adp8dOSLd21l4se45kdiEI54oJvaVqTIyGBOtXvmoWFfWXvMLKYwXPpbu4kEl8q0Bk4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17smJHMurDanE6a3yHetcnHhI6UW-aWhnSQrr-av8fxw&oe=69D79D78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY6EFEdcQ2cQ7kNvwEx5kIn&_nc_oc=Adq-z_AgoypL_tUgzhnP_ubBxilO3CgKDDVNNy0Bl7E96hIERTKiMCn27L7UUnMqqMY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mmKnat0w2ldQgINe9-bbLbORRIL37Iki7gDqx8lNf7A&oe=69D790DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q5bpLNjiIEQ7kNvwG9LwYU&_nc_oc=Adrozhqo6WmOs2tx2app_eElfSTj6QsQO9PaW9MXqiVtvLyi0k-YZS6AkLZDlBabYdU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RF9uLgC9_CXjXOQG1HjnoyQhMCDrOHJ1Cxv6C5MO6Ng&oe=69D79C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCgAICbArk8Q7kNvwFrg99V&_nc_oc=AdrXOINrxQ-fcySmdA5Y-mr0au3y1pZmYN9kuVPFqF-B_Zh9T4D2OKBoSogNYI4lZ_o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wkWrClpBt1WKnpNLwN5
8Q7kNvwELTR92&_nc_oc=AdoGZAnjAONfS4yn0LIg7gRH_5XG9yJBFFZVKKz7f45sykEc2RRh0UASKHgvSL17pJA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZkrGXZzwcdCqfZ0_n1wRWth7OgYs_qFCs2hfKh1TceA&oe=6AF9C916"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X86rnJm2dzMQ7kNvwHMD0XO&_nc_oc=AdpdF7poOYAmwaapEAjG4cMUMvHoOYgJvtdAvAqBsCOiSL-oEcGpeNAazAT5-a3mKf4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUCE2_s3yVWy4oc9lAr4Hu8UB8PNmU5RQAO9MLAES6zQ&oe=6AF9DFB8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9Gk7IRz_JMQ7kNvwEbYt2d&_nc_oc=Adr67Yk1vIOSJ2rgcLllcUyJic0YCKHDkkyDmQlLuvMqMnifz_wkkShwVAT8QZj4XLE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD9rb0Om0ROZ_w1QAj7z-PiwvnkSznQk3HZlRkgd1xyA&oe=6AF9D31F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDlvoK9MmcQQ7kNvwFg0qIf&_nc_oc=AdoVS5gmbk7QOew_hqIxokt9VgooljeNueufIZd-SLwfNbQsz225uvO8qnQaM7FiG9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_7PbT_svYfADyBAaa21Ju2t6qIlD8iO5buuO0iim6lg&oe=6AF9DEBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWbJ0gyBCgoQ7kNvwE9QE57&_nc_oc=Adqmevz1kf7B9l_3n7k5FYMm31fGJ9tszablw5X_qq9QUiIEqoAtKRek7DXmFOMIOuQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKgXf2ltqg6kZPKj6dFc
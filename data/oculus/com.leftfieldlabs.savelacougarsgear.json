IQ7kNvwH3cinX&_nc_oc=Adri3kAB61VfM6pOuMZyLWzGuv7dDt4iN4uJH9Vb6VKxoHK-E_c0UQay1gLjDgI6TK0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkVCLmJRXAfLeo4fmxAYGFf0Oc4aI6tGFljgesdnXzjA&oe=6A662116"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3otVe8AyUocQ7kNvwF5hdmJ&_nc_oc=AdquM6nftoYp5Rj90aO1bxAb_HiRhZoyxx2gg0dBUlEus5J4jpTrs_r_U_Ah2Czxp3o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN2dH4Ff0ry00YaejwhL31S4K_WKJcob3h_rl3E22hzg&oe=6A65FF78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POsqEeTPEl4Q7kNvwEDjznz&_nc_oc=AdrOuiyNTYcco1wrzPcCRVFR-eONOgzJo7FduKV9E5naHheGkGzRyCoWhDNvwPvIzg8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2_QZOC9IImv3y-hMLU3ofG4E9hLcAW2hUEb8WxBgFFw&oe=6A65F2DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNWRfD0kS-cQ7kNvwF55ZYa&_nc_oc=AdpY_KHxRVdXWEoLk7el27igyW_mLdVMJneXesVIgYhP5lMApG7R7M3Lz2PrYK8lzlA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv_PGaDa2bMxZerCaml_IWd7qdcMa2fHBeyzMsBmnX3Q&oe=6A65FE7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFrQ1znwoEcQ7kNvwESyJGg&_nc_oc=AdocCR0jR02wF5HiHajtrtjlWRlO0pw6AeRdoccJhBi85IKW5XMEhvE-NbzrUxEWhTU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQYvfZbaLUZT_HjbRz_v
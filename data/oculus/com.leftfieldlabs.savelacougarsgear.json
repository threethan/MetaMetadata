UQ7kNvwExEuoc&_nc_oc=AdrdDnFHt2JkpN5RwiKm9X-Rk4nnP_txMRtbWS7HmwE9dHqU0eTbwTdQ6FLvOCPGqqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBrll448hsoDtMSIZiYHn5sPpIKtIkQ5MboPfj6x2kEQ&oe=6A8046D6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQmuqcmndR8Q7kNvwHRWxwA&_nc_oc=AdoaN-isnvl7bWMtrVx7rT-hl4-vAFoC9E_jcA6WAb3P7AosVBtxcSNVrrovDuqJDTs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELw4O-V0cXCpJJfu9f72DPP4mFgB8mHLuB44AA7-09xQ&oe=6A805D78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy1KZPtHi0EQ7kNvwGMAv0S&_nc_oc=Ado_D7fXr9Kg2rL6lS0paCW1kWl1uWr6ej67nqME4z_J5sU6Jgq71RRGxNGoF1dpKPY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFWZ3D9QnBAJDrAyNd-HnouN04XmMV6pDyjHb0MTSFdg&oe=6A8050DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHnr6YdwSkUQ7kNvwEmL7jB&_nc_oc=AdphlmbzIU81gK3R4so4pAYJTzuQ3pwPiXNKlEcngRG26H2QfvJsQ0WyM7kYrAbyvRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3pCOH_TheAaA4qy8i5uKSSMjFMz9eTWZooJtcfGsksA&oe=6A805C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z3DWwlYHIAQ7kNvwHdgwR3&_nc_oc=Adrjg951jUjK6wVnfh4lnegxgxLDrjg0rM9LHtA_PEi00ERBbxdsA2OD2YQbzER-PGA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETtZGkiKE4EGjYf0pYOq
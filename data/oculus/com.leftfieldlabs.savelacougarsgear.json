IQ7kNvwHlay-x&_nc_oc=AdpMQbnfCF0Pz84qGtKHh4Gqfmk3VIyR_0x1KS2sBpgXP-EoFtsKvfIKOeELgiTrS_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TQdjmsAUmz-_cYFQ91ZWFxnOpOzaceC37gHhIFVXn5A&oe=69D27916"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwsAPPsLrNQQ7kNvwG5foRd&_nc_oc=Adq1YRKUl1tXWSP9TTB1ojQsc32ZIKyx-VtIfTDVbHfPOawyUGg8prT7eHLZ1olU1CU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mbw7vNN7zjIYmXh-ZbA698WE349fgcrzCh-wbpvtNhg&oe=69D25778"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAz_xFCimY4Q7kNvwGQUVsy&_nc_oc=AdoJS7gKRRM9WNrYQgwJRP_TiDX0ysslUjXXz20MH5n5C3wItBBBvyxdwzial__fiyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28u2KTxcPeGNR7yUtNNdd0P_ENNevFYJHkVrzW_LdBfA&oe=69D24ADF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EioYCYLm5jkQ7kNvwFVoM0c&_nc_oc=Adpkevggvikj38l_RqDQwv3NVogzYtKqAIjYova3iQhSQcoX4BL_yIB0pRix7Pz_RZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22BcwXHIhP-O2mpN5O8W6_IpF5dB4PmVKDlhkTpUwkkQ&oe=69D2567E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4LCi5EhUsEQ7kNvwFnBU2_&_nc_oc=AdrRp8-vJ0rHN3PgOjMjo169sOpFSIRAgFtLzWM6YL2kQlFIG3Kz8m2K1MnX3XALOgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gLqdV2TiIG0_gH6X50n
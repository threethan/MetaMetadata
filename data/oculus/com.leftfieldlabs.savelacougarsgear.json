=scontent-iad3-1.oculuscdn.com&oh=00_AfvVxPzkiaVlK7lCIDxemAsmBEBwNfNeYhb6lDNDoibV-g&oe=69A2CAD6"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5BJReu70woQ7kNvwGm9yQ_&_nc_oc=AdkOIn5MFpJXYmNXVApalBILgqJ8HIy0cpW_IPYta_Bf3IB9_3-3gnv7Eqln_qyL0TM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuI_UBjQ0ZeAL9pMxIlomAgnHTTX0hlabsZkiX9-pRCA&oe=69A2E178"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrieHAPHJS0Q7kNvwHCH3s1&_nc_oc=Adk7AF_OAd8Y74iNlDPBMc3HsvxrIxigYXnvkjPJLjeEXmAA_PADm1VWpzHy09kNZvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsO3ZFRLBRWvj8dGipEK4hbxj9E4JJdLzmKgVLvE8ogpw&oe=69A2D4DF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PH96HAHj2sQ7kNvwFgptVW&_nc_oc=Adk3sV3vzdGbNm3Ns_IomMEjidRwjHc25Lk1weUyLUZoqqTy-r1TEUV2711S1JHy278&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvqT38LtG0o7r_u08sC9XFCsIYVWuInEOBMQknkziHrQ&oe=69A2E07E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChwB56ftWvAQ7kNvwGkExvM&_nc_oc=Adk8WI6SOMk37kGLxHgF5mKgZKJ0XarWMKMyuoUq1lMXk-jwfu0ZOQ1eEmhEWquoHFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYnGCbZgxVwAK3oZlxCAVaPMLZPDEFp-3MDEjgJyHdKQ&oe=69A2C82A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Save LA Cougars VR", "platform": "ANDROID"
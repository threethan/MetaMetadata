vMq4cQ7kNvwE00-Pp&_nc_oc=AdppOydwOeVnqdt8J8MzrwQLr_xenrgb9U5Dlkx3ITzLalOTQKj2wJGDofCijFm2Nkc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z7agoLmYVGD2Zi7rT4PU-hB4YjQNVrvxmsyPyYpK1cA&oe=6A394E16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzIcUNybuQoQ7kNvwHFRJ7V&_nc_oc=AdqXjWYygcGg3gZTBlBGUOf8o3nQurodW9UAOAbsj4mMcfmjWBgKwh_fCjMVWFITZpQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eG0uOkQwAiRLKk5Oz1Kjb6yGC_Ry5j1MeQj_4veeiaA&oe=6A392C78"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXN6XXNX3GEQ7kNvwFZDi4-&_nc_oc=Adr6bKinneDDqHQzVHCuxIbhcqVn9wmrrscPgSINIZdOIfAJ1ELhd2tbSRPWaxLIow8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sKN_LC6EKLVaoxaVZeT0750CF4CK13ii2r_HSnHloJg&oe=6A39581F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KldcWMUsCh0Q7kNvwFMJMCu&_nc_oc=AdrsKbxijO_gDkzScKOS81iUYLVAbsU7AnICs5G6COKfzdn0SXDVG3qW-5_BBuV2B2U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oilWs0wJPlb_5cWn7sJ_zIu56K2XK5ICy37PlSDt7Pw&oe=6A392B7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZxF6MoocuEQ7kNvwFx7ihZ&_nc_oc=Adr-DWt85AUwKdAMC6zwrESLw7rqEv6ICQE3LXXOJPj0r-V8v91UaDPEc5HeCL2yt4k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R1vYFeWyMmx79
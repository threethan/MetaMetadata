=scontent-hkg1-1.oculuscdn.com&oh=00_Afu7DgG61qjQco_4bjLWdzKYXoRY4BKesAsYe6WFhuhBoA&oe=69A17956"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5BJReu70woQ7kNvwFAC1Or&_nc_oc=AdnwNAApksFWDtWhyepGCDalzu-4c7Bd-ovzlWPYeEldjNTNGNZAr9Uq5CdSluqH30U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft0T6EQIDWRmmk3POhp8dijGxwiMt2kIPGMKrvd7W4QqA&oe=69A18FF8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrieHAPHJS0Q7kNvwFzEatP&_nc_oc=AdmIl2yd3V00WVAiFti88zDgaFX545sCXHMhSRC1Qn9sDAR2IYaXgevh8hzoj5G8Aa8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuAB74EbMjVDvS4jP-K5wG44s0YhBb5yHoqz45uOtbBYg&oe=69A1835F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLG3qWnnpo0Q7kNvwGNNAM4&_nc_oc=AdnFoK0Xe9lNAyjLvW6KmA8ql7NCtK9qgWq-KcI-J-y6RKyNP9LkZo5NvBZuD1J0QbY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afuy87mzg6G1Kfk2C-MnYZSxJ8d1IizkhHm2_yOg7i6OXA&oe=69A18EFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChwB56ftWvAQ7kNvwEMmYYe&_nc_oc=AdnokqjRRNQLJZ-y5Ho7W5v5am0C_tRd_360Tc8vIPzSkqcxYZx7gl7lnElXy7PMdY0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftSXg3Vzj96lslAPM1znXDR7n9yETTznRAe-K68y2Zi8w&oe=69A176AA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Save LA Cougars VR", "platform": "ANDROID"
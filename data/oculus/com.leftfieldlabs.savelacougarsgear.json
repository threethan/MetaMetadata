W7zO7J6gPJm47AKSYb32N0nuBoSBsSBl1WdwMGjvsI9UgXU5dP18H_Ak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyefRXl3y3zdBqYRVZeHFFzwz6o0je4ZkLWXlp3JOG_ew&oe=69C11D56"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgGe-wHB6HIQ7kNvwGQqltd&_nc_oc=AdqlfSv9A5o_kljSse0td2OrC5qH4ejXWeE0mcBTj04d-YM5IK_D6mV7jRKxXuMx9tw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyP3ZJBfzyZuSinuwErOQXwq7msx0_aIeOrcjp4HqzYFw&oe=69C133F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fN2tgWMMboQ7kNvwHPCL2a&_nc_oc=AdqW3F8nzJkBjeK-j_MXxL2ylSBkhPPlvg0lQD9qb9u4lMiPmrVSt7SEd81D5FHCKns&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8GA33P4E-MGSRZMxQeajWqTngR1ahWUHer3MhD3fmzQ&oe=69C1275F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fyo3b8xVSUQ7kNvwEiCIna&_nc_oc=AdqOZSvXSVZ2Lb1FfkiXqGgSKdI60HC9jY8iI79AWyyQ2_4kDuvwMydeiAIFwd_EYaE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1UY2Kl2-Q3AazjWArInJpIAyJU222WoedlU0GaFwWDg&oe=69C132FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q95zrep2IN8Q7kNvwE5zzIt&_nc_oc=Adq1Lv29R_OHoERlQwXMkvD0sPUy8x3sCBF4MKsXRSpBvkW5xA3WCOtSWO7jJ5EAMBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfywWPFGSBlR-zFWCX-7b0GusBKwjQTz4hDkE5l7-5A6Iw&oe=69C11AAA"}, "is_concept"
IQ7kNvwF5pp_o&_nc_oc=Adq5WV9UDeTtxca1bDlj7EYes4mv0i8_x5CvJJkmjci3LEWskomSZ99m1L4uD2X8c-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84sGzL3MWXVciWKCNh3PpsWf3_aSC7rMQ92pdz-I01iA&oe=6A452B96"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAe3-JTlAvQQ7kNvwHVQEXG&_nc_oc=AdrILut_OM2mbHLZDUagCpjWz0bZ-nmKQB7tiiDwuGjvHmJoR1BeTIb2o0pz0hgrxYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7_NPA1bENbuE40l1So05j2Hk97CVY46RZfBcUg9ljIQ&oe=6A4509F8"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDvRKpAnmekQ7kNvwEaCQvq&_nc_oc=Adqpfm-1zkroDBRAWhUAjb3YXXRkMUzEZp_jTg_q3yIJqTjJWQsCzNNWlEeM4mpYzAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84g2zBvArUGcGW87--m4ObLgeVfICH7P9amienlUgKxA&oe=6A45359F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX056ENMAQwQ7kNvwHcEoUB&_nc_oc=AdotVthFdl-vLToUVuEby6NgLWUaIiTjh3s9oQ8fjvKBcugw_f9Q67Gc-GyutVBjVFE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u7WHGyJ97EmSELL9jcgS9UJX7KMl08k4gx2qMdFWZ3w&oe=6A4508FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLdYWWKMTSoQ7kNvwHFA10D&_nc_oc=AdqlZrkPd5KGUAJmVj_ToPkRV2sqhIXkTzYkmhTiukC_8VrnMawYJNuSwXD3ovuWhrQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-10710pfsZhUI0Mv0iJu
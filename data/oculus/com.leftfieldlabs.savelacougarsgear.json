EQ7kNvwFGS1o_&_nc_oc=AdpJp0gMRS4gMRkcFSGdLL2ri8XsNMUu0upWqWUVQONKrXaZeG9VV0_fqKye5vpKjlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoz6AWdBIGcK2H3CTLDwflJv-lBCjPc3jD_nBy52in_A&oe=6AB29816"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsYl61d9MVQQ7kNvwHX2CHM&_nc_oc=Ado8iJtkBanj8-L2ZMG3qHfdOcV09vMfAVT3Bb5Cv79Bgxzv5ebm_Lde7g70DV_P56c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4n-YrmRD6HZI6hM54MY3DENUB4TldrhvEyet9uHCSCQ&oe=6AB27678"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIn1KhX8CDMQ7kNvwFE6Gag&_nc_oc=AdrDqJCmcpLfct9QIlnHKbuqLK22Zp6Ms7iQNjdHaOouFFiTFN-q3i9dvRxRZIBO1qA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkrdk-KL469PwzmCRPq-1aazAAGkwl8mPeaqnyWWh3Hw&oe=6AB2A21F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZloP44H9ulkQ7kNvwGnNpbX&_nc_oc=AdpkepxhJ750_UDAXPPXKTnnS-DUwsTFv_dH6rLvL2UDUD6ifq9wo1lwc58_5D4cgdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjqINZKp7WZQkhgB3d4RWAq9iufUYhl-W0BLAlAGvtjw&oe=6AB2757E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk1bNKB_ZIwQ7kNvwGmGx2i&_nc_oc=AdqqHYvKOf_XX7wNr_86hJXRpzaOcbo6m5S50ENQvfvjOp1Yl-lt3bKm69LJbfC63cQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInd0GpR7h5Y553ya3uao
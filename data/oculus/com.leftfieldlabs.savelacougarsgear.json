AQ7kNvwFIf7T_&_nc_oc=Adq-nKFD9ZXd7veFa_JPcKdIKSdCJucHChSpo4DGwj7hsiNLrdYML2bFvbfGLuAb1hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDsaXG_t4TBV4pj8y43dJMGMB2BkZkmZ4JuskASpQWnA&oe=6AC11896"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0IPxjd6IYQQ7kNvwHZVg9t&_nc_oc=AdoCUaz8DliiPrc_yl0EeU_TGeVoKMWJzyFPcp3-OE_NbXGhfP9BXWRFfjbq9FftRR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_In3gi9_R2DprxiSKW7wTdoEYZtPmZGCriJt3UJLuWg&oe=6AC12F38"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lYPbNLd2NEQ7kNvwEpaLbP&_nc_oc=AdqBD9GqPCsg7ha-08sVvzCBGwFIF_Crbyfom8IUNPdhfCNy-R9BLs47AgRMWeazM8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO48ButPRDRY87ObYuKpjVE3kkMjlbM6GsGFpxBS2AcTA&oe=6AC1229F"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9HlKefj9MsQ7kNvwGMGlGc&_nc_oc=Adp2rIKDVLVAHYGZj95Y0GTwmYV0jVBiOqQrHePKS35n-Ow_Qr58k6n0Sz_DkEQPCds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa4L9ScKSCLmrM4xHxmP2LjHHA-FaTd0gRoZFS24y0Mw&oe=6AC12E3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6lMCmWUM_gQ7kNvwGHGueV&_nc_oc=AdoP8GUuwq0u2Xv0pZ2mltc9eQS3-Wj_8ll7VJH7C6GJ0c4VO9yWtzx-XQSsbtxIDZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcZRyohTyXTMOMU3U3io
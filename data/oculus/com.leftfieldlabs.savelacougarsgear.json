wQ7kNvwH846a3&_nc_oc=AdoQy5XwA7g-ym6h9XOQrE6bywFIXRFqylD8zcYKank9dusdFLnxmSYzmsjIMpQXyOU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ISLdgWv6Z2B9Pfo4SU_nO6GdFZAoVTqnjuD-3bsNbuw&oe=69E24B16"}, {"file_name": "migrated_image.png", "id": "2649129511973580", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162701_2008984182716244_4584623614178885632_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsIe8eoY_ukQ7kNvwEkAB0J&_nc_oc=AdrUV0qtUPX2tGnqp2JQn_0Oymm0BGKGoBxzjcqGXSs4AUagkFZwxn7W0L3ACP--me8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vuzKBJo4mZukkL3S3cd0BtkLpPjgKtOm5CptQ_0PR0Q&oe=69E22978"}, {"file_name": "migrated_image.png", "id": "2633003066971125", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12533831_1622356804551808_3085787230258593792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_L1p-hNTL0Q7kNvwHinC50&_nc_oc=AdpiH0IBgZjgehzvIVUiKLg4vzOzS2j9AL0ckszUqiglRZ-dRdLhXGuHEZmqC44E8ZY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_PQeg8pLNnyWYAyp7DhBfP7NHiyTdsA3kB-6XJdMERw&oe=69E21CDF"}, {"file_name": "migrated_image.png", "id": "233542874704281", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12138787_214465339093990_224169126455672832_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ozo4a1UE1cQ7kNvwEwDsbI&_nc_oc=AdofZ18GKAzZvB8virxA7TlU_EGeCykjydsxbGuup1xdRAm60fZQdYsISFdUmrJ1jFA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10GE9nPIIRSiGjzJ_YBbttKFno_jHmtPBjB361jWjuWQ&oe=69E2287E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Save LA Cougars VR", "keywords": ["savelacougars", "cougars", "VR", "save", "angeles"], "long_description": "Did you know there is a mountain lion living in the middle of Los Angeles? In this VR experience you\u2019ll meet P-22, the most famous cougar in the world.\n\nP-22 crossed two of LA\u2019s infamous freeways to find a new home, and is now trapped by traffic and separated from others of his kind. His plight as a lonely bachelor has inspired people all over the world to help all the mountain lions living in the Los Angeles area, who are facing extinction, by building the largest wildlife crossing in the world over one of the busiest freeways in the country.\n\nIn this VR app, you\u2019ll see LA through a mountain lion\u2019s eyes, and also get a glimpse of what the proposed wildlife crossing will look like.\n \nProduced by Pacific Virtual Reality for the National Wildlife Federation\u2019s #SaveLACougars campaign - learn more and get involved at www.savelacougars.org", "short_description": "A virtual reality experience for Gear VR"}]}, "developer_name": "Left Field Labs", "developer_privacy_policy_url": "https://www.leftfieldlabs.com/privacy", "developer_terms_of_service_url": "https://www.leftfieldlabs.com/privacy", "publisher_name": "National Wildlife Federation", "support_website_url": null, "website_url": "https://savelacougars.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514246819993162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162698_301295383706571_1884084822838607872_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9jnH8TrQLQQ7kNvwFRmjaP&_nc_oc=Adq8xhUVRKrdzPnPhi2yBKwm5EDCvipUy6N8V0voXgrkizb1SRY29LdQnqUqELoQAAE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ifPgZtmja2SP7fmoNzY
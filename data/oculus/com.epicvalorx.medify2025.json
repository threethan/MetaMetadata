534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuSOsIYo1AoQ7kNvwE4Xtg-&_nc_oc=AdqXKYbvRnRLMduTkLvUQxFzGBBwgHb5-sP3y5yrmOC5HEFPKba3fMGXAwYWw_rE_gU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4BiqHkGFG9neRVWroSquY5KU1jV5ALNeDxHYfGuveDg&oe=69C12B95"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHzGMmoFZKAQ7kNvwHacpxI&_nc_oc=Adq3188MuOOl5i_ZorAEcW_SJwSDEWAjLJWg8fDnJjQWw0A0dbX5LtCFp7hpmRSxdaY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQwgupnRT6YvhUGm8-4rZ38ijTT7dx5egv4-6nDFTcHw&oe=69C11AC4"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQc12OcwnBYQ7kNvwGeFt3V&_nc_oc=AdqxSmxP8yaGnKaND5OMMV4XwwMPZW0H4YzeaKdkEB20GpBu-Kj1NzOxT-i-LNT-aHE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy95dT6gbNQI8rCCpkURZG52uYIzrKoML_-b6sbSafkIQ&oe=69C15051"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvylhu6snAQQ7kNvwFiDZRL&_nc_oc=Ado_9Uf8KcvrUANECn5jE2JbZ65K9CwGchHt7-DIsyeXGP7rr_L32-0QIlwXd6KtqcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvE4S6Qu6VZL8uBzwvXP6ugv_ID6x8BQbRv6hMomJrYg&oe=69C12D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj7wCfnb6_kQ7kNvwFsc_xt&_nc_oc=Adr0abGzu_TREzRKGwbV-fjl2QYPPKxJc_Dr84UDfMmkxGZtUcuT4Ylt-3eihPfWNlQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBQWpTuSAoQ4CcTKDVtdbwb8yTlS6Nq91taWYTHZC3WQ&oe=69C13284"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
e_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ql6WDVukHEQ7kNvwFNbc3T&_nc_oc=Adkl6Vlz4IUcDqkOr9zHTnbSZkChYfn8OkKufQth0vB5oSJkBrAZjDAVO75LlnDHC-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvh3ZWdQ7t5_dwHNedRnUWNyfZUYeOTmvLyxwDOUdGfeQ&oe=699ADF44"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_nPdHtd-EcQ7kNvwHBE8ne&_nc_oc=AdlSRWne9J16A74hwknYIKrho4_6Fv_ChUuit2YfqXTsDUQQwt9YkZ9Wm0_iNpxSqF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuCy0pDfEflErB7tJQ6cyLTJWKh4Abfeu9pFDV1U1kURw&oe=699B14D1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlIVG6kdWOgQ7kNvwF-5Tji&_nc_oc=AdltKJucFjhpoBAS_QxzINeiuqOSQLJJM8xs94olE4O6uOtaoslyJdywSsyZBg_o_2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuae2kg3lgtTvhrieV8MT88B9rEK9fMheTqbwHY3Mc0xg&oe=699AF21D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD2GUUjzH3sQ7kNvwG2ZCxs&_nc_oc=AdmOZv7hxuJveavim3R_4m_5qKRexTGqDXvax9164QIlAtj2UcPxv8--GG6NmVJywLE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0xe_2orLijNYpyAuyflyCycsxCOEwTcRZff_iJFTgiA&oe=699AF704"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
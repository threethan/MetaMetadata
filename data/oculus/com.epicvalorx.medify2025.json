0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_430LVQ9WBQQ7kNvwHflC_e&_nc_oc=AdocnAtr7bMmuUN2lFS_7RMk5h8ef7y4CT5hBPK1g2uDJHh_9wm9hGVJxNZK_EiDdPQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2vD3o1dghIJ7bHj_AKT4xxubdWTM4WjJjjTNO_xaFagg&oe=69F1F315"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qIA6cap9NsQ7kNvwFWgVVw&_nc_oc=AdqDC-ZNAVZeHaId0Yc-DbfRM70fdSy-ZqBDLEj1T69BGieLF3v-vO14z1A865O-NOw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3rLgHajUWZgzRSwh6-jrmITOoFtSEznn3OuDNH0SSslw&oe=69F21A84"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bVIXYdIxkYQ7kNvwHMs-LS&_nc_oc=AdoS7pMue41Ysom5Gbq3QI493wsdTx2ncbbInyE5eThfR1o835wS2CS_7x4Vsq8euLA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3SQJkVoCXTLf169_biRTvW5OAueswizxR5l3Dv1F6f5g&oe=69F217D1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDUL-eVqjTIQ7kNvwEvCjiV&_nc_oc=Adq4c3fFm_V3Qt8Xw7S_HtfWBpJ07-thm7E1g8n8nsKk_9gczxjOa780OETWH8W-rxs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3tyocZw7BK_thjOSOBemlvqpdyFZemVKgCF0TcNQSi_w&oe=69F1F51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Atn1OgW_SwgQ7kNvwHk3E5O&_nc_oc=AdpfwlDq8GKNCjiRJlwzkBM3to1siZwf0VSVlsv3K7sy9Jr_QRhwJsSguQK8iAZ7tKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2r9XLoTMrCCzVNtE6tlY8SNSHy-tRe4CqfMQ5rF5kZRA&oe=69F1FA04"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
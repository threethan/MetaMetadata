534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuSOsIYo1AoQ7kNvwHJM6vK&_nc_oc=Adl097YoVZqvlNE9d5M49h2-U0jtxCSUB1JF_W-Fe0VZALJiX1iGdHtebZXLQvgYDR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3iS-R4OWi-FeBj_Y7He8ryslawNA_MRSE9HGeU8XaRw&oe=69BFDA15"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHzGMmoFZKAQ7kNvwFd-1oF&_nc_oc=Adma2tdR4j-P76rkpznSemE4TIE-OIs6utEwLQoCHwJMAAnDmBEFQKcEGneSsmk65Wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz04RkN0yy3LGUJRpM0PGH0aTrE0Ano-6xiAGDbYpQNMA&oe=69BFC944"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1AK5UDvrMAQ7kNvwG9GxN8&_nc_oc=AdmoLdNyHFF2TtFC6BnxagycogrqvWYsmVztLdSCMlEv_FDPeAIt5oDN0uN5kNvHDsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQ66gf9b2kErMgtgKv35nGt9vdWPAS7qvN0lnpK-31qA&oe=69BFFED1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvylhu6snAQQ7kNvwH9MCSJ&_nc_oc=AdkyMD8xMMCvUW8OxY1-eEtbdsLKjxknA7hEkqFZ7Lb-fLDkKPVA5GBO8VX4hzcUxA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8M_5zo41Ma4TerbBtnHPzEPkGkCs_ACsoP4Guazxl1A&oe=69BFDC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj7wCfnb6_kQ7kNvwGIAi_L&_nc_oc=Adm0cV7vmoqtY9OXfzK6YbbHQAARrQkbWA8oIUpSJYG0E9RgvrG1bMeiW3uYcxXUvjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWVzyuA0u43tFLOo4Js5uRS83orOOogEKxBpYuMXz4pw&oe=69BFE104"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
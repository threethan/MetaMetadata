534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ivtpigQLAgQ7kNvwHUYoXD&_nc_oc=AdkOuvAwG7QdRUxHDpzHn_h_cvGY1KCC_kC0HAA4WOnRkxr3qLSrNyg5aXox30iRZXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0hNaeIuUSOLkZhoIPtadxxfEfJRkJA2YmD6UwI4BZ9Q&oe=69BBE595"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVAUzDmy960Q7kNvwFKpC3H&_nc_oc=Adn5SXUxmzcpPrDVBeehO8FtCI_JmVkCx_md24T3IU56vvlQglnCV0tQeLkSOJ2CBrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSV8Ka_tRspCMX8ljRpOCE3JaUb7Ayo9EHNvzL2KELog&oe=69BC0D04"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1AK5UDvrMAQ7kNvwGZkb36&_nc_oc=Adl-6a8RbIRLR3bu4CNVIumWvqUtSxj1rkQVdJeGsByWL68YlTcRqguVrXmZLtVGvbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5DlLWnfj0-FnESmrH1ZjmObQq1M53nu08lHofJy_L2Q&oe=69BC0A51"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYtoyval-84Q7kNvwEUpYq_&_nc_oc=Adm4oY0ZH4MbZj4cU7c3xB5EPQSO-WEFPkx02Hz9pgTwpBeO0CHuEjXCwLqNMxbTY4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYr9d22xeWfxORMMLTgBLg1eYFgJxfDlt3QUjOCR9dOQ&oe=69BBE79D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P09mrMYtvUAQ7kNvwHmg0To&_nc_oc=AdnWG7lIZpsXRqKMmSHIKoK1mFaPOB15y7cq-gpTjGYEOqNHbcPQYlk_VqeaCHsXuYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwWj8i-y-uaOVMtQi87RX1023qRwYgxyfCstQSJ4ZzTMA&oe=69BBEC84"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
nt-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1260496339534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh94acKAvhkQ7kNvwH1TEwn&_nc_oc=Ado34zXodAn7HWC7IsZOQvI4DeH05dQgmJOeJqdt0QNh3CTdLyvojje_pEfEcbxVgKM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ARQtS93JFY1Um2RlA5qJ7EjI8zKvVXJ2Epn-ioSaM0w&oe=6A22F2D5"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq62sxDjWaAQ7kNvwHA0EJB&_nc_oc=AdrGDN4D_MsTzhY_ZnVrfeOI-jv1JRw7kpwALhD2zuK4N2Cb1XXCnITHOZxl-hAWpf8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jqoy8GXdcRu97Ab47Hz-RoVNHVU8GcQgQBfidq1eMUg&oe=6A22E204"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhgJaUaY5f4Q7kNvwG4g6X5&_nc_oc=AdrCoiFK915ERpRZoE9q-JlwLAO796ReYPaZJza6jd2a3AQJs3snKTnH7ezt3s3kAa4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e20kXT9YN7eZBvnyNxt_lDv8V-uG64UvRalzuy-G17A&oe=6A22DF51"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Hub5RVkSFMQ7kNvwG0FEl_&_nc_oc=Adq2T6Oc-0e-LyAzc-QQfVL8zM3aWoKWTY2hGCyx6vwpRzIjcTdSfVy3emdw79-vw4U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2qtU89wmOcHhhvxneuo1Omf7J-BVt8MncGpplXhTZcQ&oe=6A22F4DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXqaLInBDB8Q7kNvwEOAkYa&_nc_oc=AdqM71JqN3AceRlIYSAx6gqsnqMwQMhMCxuPu2XS_-Yc3vj2LYL06jh5G1ufqUBw_NM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wNE_h7cjhgewuc9E_ZCSjivJeeNHdYCJPWsAkBN9dfA&oe=6A22F9C4"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_web
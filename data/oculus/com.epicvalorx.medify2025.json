534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClpQPS_2nVEQ7kNvwHYIW_U&_nc_oc=Adk9AmalQS2e9vy5z00YZ3XYmN7FPDemc6Af1gMj9ijjXpqiIlJbMS0ORuSaakK2SsE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYTN3d_gc-d-eXElTNioKQ0kuD0RCnKiOZs72giYAPEA&oe=69B3FC95"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slumjHtNyPkQ7kNvwHFqe7c&_nc_oc=Adkj5baPIQjM7dmTjrjKYP0ls25k1-x0U2mi5aJkyT4RmqD_AC44E08hs2dyW7B0M2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQK8czI9lwAmVgMdpV71p3Au4XQmc2yh9GHCGQiWiOGA&oe=69B3EBC4"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ADDIdBFZsQ7kNvwEjYJWt&_nc_oc=Adm_q650OWSZspEJvabD2OFsX5Te_dhMIv4xh8v19z88iHYCMR8L8P2wpEoDtDtEskE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzn5NkMjlxLb2BRD2O1QJDyHiVCFLI3_dYLJEr-GZyVdA&oe=69B42151"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYjeagCx-wAQ7kNvwEcO6MK&_nc_oc=Adlx9D3uplFSqpS3tTJIl2o0HSWm7F3onU9_pI6IpKohxClzBJmKDmtjEyTS9I8w86g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHoDEmSApQnoJFjCDru-pYf8Mg-gLU94zBr45w6a7eEQ&oe=69B3FE9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iXG4oL8gKQQ7kNvwH_xlK9&_nc_oc=AdlCfimQrmD7fgdZG1D6abaXuHyDClVm8dmuLkQ8i9TXS56SQP95whttjrDzmMf4HTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwU9jU_R1wi1u30kOnIs6gg12xp0zgkX6OtYOkrV8QDdg&oe=69B40384"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
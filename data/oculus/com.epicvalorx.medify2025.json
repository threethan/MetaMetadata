534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qbLDeQEJ8QQ7kNvwERhG66&_nc_oc=Adla8YTX1mEkAsV7YYIA52wjudcrHg9n3AjCmPCTtp1bh6TK-83nJkpHO94sbnIObCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRpRjOEYbYdN3iHLfy8Z8s8AwiyNMh0qNTNNLMjdkB2Q&oe=69AD6515"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ivZyHKuXtQQ7kNvwHBGXmh&_nc_oc=Adn1598QmwVcsQCUEPh3Avxx3mkQpZWi4eYIqjzJ_mGR0-Tmv5HL1Z8owV7WocCarOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUzyAz1r28-vMPD40pXocWeiZxkS9gXO2BZE1ZX_H21w&oe=69AD5444"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJypY80nWfkQ7kNvwG-t2KL&_nc_oc=AdmmcIymGo-pGZx9-chOlROk6hxIVN3M381mdp-5DiYwG6U02haSCpPHjk0QDCRgVfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVFvg3rUiOVlc9o9PkNcTFQEOr90o-M1fsN2yLzZR6aQ&oe=69AD89D1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieed4TIWLjgQ7kNvwFq2Whe&_nc_oc=AdlFrpPlHxRnKOaSoMs7v1mUO_Hmv3oqku_hi08YwYFDy6TB7WWI1kHaEaPrtaIs7G8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDgjN7mIJC4oFrZbEAsSZrB4uVVwuJrCGJhl8JWW3NUQ&oe=69AD671D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omezg4C3fagQ7kNvwFp18U7&_nc_oc=AdlfiMYM2BOHw5JZEzm-GLPH8U1uTGytjqtYuFfGxDRA96l-nklAgtkDvBZq7IteS0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxss001gNFrChrhg53ILrdolMwmUkRE34pLFPH9IwzLBg&oe=69AD6C04"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
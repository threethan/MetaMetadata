e_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-XjMllc670Q7kNvwHMGjRG&_nc_oc=Adl8WKNI4_8l5xH8TFjszK2BWRBlttbQ4rS3yp48Cy1X9ZpRiTvQW0zWzHpLUZE5ic0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfusJKigWMhNuU3TLWNSfyD611dzg7I55ts3bBSiOEGKGA&oe=699ED3C4"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0ibax1M5W8Q7kNvwEIOhmf&_nc_oc=AdmMf9-_dd5RrG3LicDlt-7d6nyRJuoGJ0fvnn-js1JOkeMgEluT-k8OybeIUrCz2S0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8y8jGRmAAECW7yaO5Fc8wmsA8s_vB2GSHQ53JpAMwTA&oe=699F0951"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVnl6L5QMJkQ7kNvwGbX3pp&_nc_oc=AdkN38ERwOL1Sh21CWJfRcVAca6psyPwfnjblmMaQumh_9ppQCxkWsG8ePppYC4LE7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuVcgMiJw3YmCVXfJc2JlgE5u3Io-N2MM6maQZSlaxqHQ&oe=699EE69D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrqOoSPILxgQ7kNvwFSkSXR&_nc_oc=AdkB6YiT2fRK91iZoayXl9NXyagzxKzhCtpPW1lQrAgOhcIiI8aoKA7mr9XgmMkzDkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAo9cQhAVvXMGdWxthYIo7Mroxf4pWWMAx8OTmyXS4hg&oe=699EEB84"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9P0XPTSEvcQ7kNvwEYdIup&_nc_oc=AdlMG6noSVkSF1bZWzMImlwj_doc0wZdjk4rVGA8iH9gL2-eYp22gSC8Z3ExrKgDJVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwznhr_zFkmGXd2kGu6aR8a5GnL-Q8nsp_fZiJ4DxX3Qw&oe=69B7F115"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPNkzsEmWCMQ7kNvwGTBPRD&_nc_oc=Adn9pcymcRCnizl8rzSVyUn9_c2Jlu8LGR26ZTNuMvsC8GeAXt9FM8r7WhughY5IZQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyewvFdT_h0wKD6ZpsDnxEQJj1wcb2K19jLTuv4hwQ3OA&oe=69B7E044"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=421Q9i8mPxkQ7kNvwH-lHKg&_nc_oc=AdkCtCEfhXowAKv4xecxtkrrJEzQiIuaRH1TadHmEumN_cejdsvGFXqB1kavi2UkEzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSV38GerYqvWIbADIMjyoDNFR_ZO6bjTbSQEkpvwZ6sw&oe=69B7DD91"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RVHNDTTNskQ7kNvwEB2IoA&_nc_oc=AdkyuNROv20xx5LYvoKeFn70qmWLbzaMoz1eFJ-T03tzKFkf_40G-fCpG688uKT0R-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afydf0Mgx0x815f40oFrN2xZVfeswSrTd-KOh9zvc1dmyw&oe=69B7F31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4ernlw1qYMQ7kNvwH1l9z8&_nc_oc=Adl1688eE-_dS35SQCbctMOu3L8Zo45Vr02jI5eOAIyTq4sB_2IWmmzoA1JxqhlYMGM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1jmdTg1x3NObw-YHdgApbnJq4cXX4m3T9jGikaBAYJg&oe=69B7F804"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
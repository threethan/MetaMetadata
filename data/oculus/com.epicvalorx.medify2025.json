e_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-XjMllc670Q7kNvwEGL9kc&_nc_oc=AdkV-MUqs8p3S67N2_OZ49zkSXIiI9Ohh3j2vHW-gNnAA4M3_8cm4rDb0-aXZMVZ1fY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuoiKl7M-09fpqiJvgWtqz30W9wNvC1J93LL5qMCXfErg&oe=69A176C4"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfZFt1NvAPoQ7kNvwGS1_gy&_nc_oc=AdnHhPUg0Y2XOlLL_oi0frRas_t24-n6oNu1x4T77FgdzVgIeLNJkTCg5Q9rGKrshCg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvmxTy_smEYenzNvp5v6WFrlA1btexpMbfGHghupO2Y2Q&oe=69A1AC51"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzH5UeFDcDcQ7kNvwFpKlDh&_nc_oc=AdlIADg-EjOd-jJvfH-tcIecTYHn91POcMMp7nCQh83wY3Mzrr-PhMpgl8g9Iwg9HNs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv_n0GzxVUKG3pesrj1ZEdCpUNAi5HRJq-YPiBR818KFA&oe=69A1899D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vjNs8pJ-k0Q7kNvwHRdhpO&_nc_oc=AdkQGnc5MHRnMtxQcl1kPEUCemKYcKpeELn0qke1Nf_e-0XdY_Jovy6xHmTkoTSMfe8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsPN3Dtcps-rCEmmx2i7K4hAQQu3WNiZpmS5oBv1_he5Q&oe=69A18E84"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
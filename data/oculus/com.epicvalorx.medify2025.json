Ms7hbl8ogMCNvV-2QNc4S1G9o8S7qJwDL5LlDTprZkR1uNh4ZVRNaD8FwMtWF6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWmHN6c7I3WgJe3EO1oKTbyF0fk6W-r3OKh2n_5RHb8Q&oe=6B0D9FDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmjGfwVF7pcQ7kNvwGTh3cD&_nc_oc=Adrn45OEUILTut8eBqxWj-uXQq234vHtK1YxoLieXEmCZ4inxS9-b8yqYhENcI51_1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnsJzlDWT8-62r7XOgveBRwFH2edK0OVaXvumDweOxVg&oe=6B0DA4C4"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25346339295039920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_1464533908721444_4880539624855088770_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1BSCv6TJD0Q7kNvwGcwC1z&_nc_oc=Adrp0_VWZ79FCm5eVF1k66TbV_HwwencWpSTkCvGTf3XjYa8mSvFow1mcc8A4Phk0so&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjXuAcpOdGs3JLXaj3nmEikIvGrGXgdM7pfDr2cnfJIg&oe=6B0DBCA2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medify VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}]
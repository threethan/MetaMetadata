338 (2).png", "id": "1260496336201666", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1260496339534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxGIshTU900Q7kNvwHJRBL2&_nc_oc=Adr-ojpTJfhi5JpO4IiRiES33R9ZLhrYZ6dzexMfUxnwVgmMuUxlSV60jqQI5SPdbGE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7YK34yRNeH2PgFCCjFoyBv5gXQRmfGfxKateSgO4g6A&oe=6A468B55"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYAjpBKhm58Q7kNvwFAysUc&_nc_oc=AdpVCWnQz0AvkdcRY6rCl0AXc0TlT-PuRddqQYs-Ryo8PExjOOkOb95oB0Sk38_q4_Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mVQoUyQVsCEyuIIWDhsqvvHDRzbquYZWCV_dR_7NqQg&oe=6A467A84"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU7Yqp4kAmYQ7kNvwGCqpri&_nc_oc=AdrGVMSKfeixtvHi3aq010ycecZgDDogcFx0RR85o2c0ktJW59Ve0Tf3zS5vfL78gG4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99kt_P0MYhfbAzKzMkhtIvRBXj74_raVqnlvlR0IWzAg&oe=6A4677D1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0I44T_igCoQ7kNvwGXK05h&_nc_oc=AdoSoOtocluNPO2HBe33-dSmPvviTRxAZWppKG3Kv_JWmQpKX3IvbfQROMlffdKc7xM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dKq6Z6dBrVm1jgkqzVN5nfuMbh7Qd_DkYCP_MRrszuw&oe=6A468D5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTjdQBKj8vEQ7kNvwEl49NC&_nc_oc=Ado729d7RhBmAXow_kzhPfqtSXwGB0WJsppDnAWoUEjgXzV5QspegGevMple4cSe-6o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lvaQc3gY7EfqVPUZp18NGaGIbcVMvSwXraer38jWnnw&oe=6A465A04"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_serv
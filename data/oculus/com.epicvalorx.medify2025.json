dmjhQz3XqiRVTKN98MMqlKFVhXXp1kpccA5QO_sNsgqTbGKWu2aLpYD5IwpfHkXu-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftatomSCXruiqfzQguBczn-d5M9z_QUKIiOkefg8rV3bg&oe=69984D15"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AePDRyrteTYQ7kNvwEdb-_t&_nc_oc=AdkWdOYd-uuEgaUhhvIr1uHRUDlJtQ5bD_8vh1DrQ6-MVCb0gUKTUJXA4hksXVuZm7Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsxdXAGOTtVb5_5PdRV3tXXWNvIopjLhm0wAyE6ACs3gw&oe=69983C44"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqPq9pAOsq8Q7kNvwERPIbu&_nc_oc=AdkVtLAISP9kQnlKyH_C8CLcvfm613q2gfj_q3hng3ifW3nvaOZ8MCe4kFJM6Lb35ZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsQ5B2TFtXu-G3pERc1mYdWxYOEszVc4t08ChkN0sIbtg&oe=699871D1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlIVG6kdWOgQ7kNvwHogsOw&_nc_oc=AdnaKVe6NdBA7Piu4axJ97JWWNwH_nTgvSy_wwxBxu7FWDsf99v8SE2myzKHUCxh5GE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft0mJu0sk-sQ7UAWbPgzp88aNBI6PAWPy9UParwz_vLzg&oe=69984F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD2GUUjzH3sQ7kNvwHVG1rB&_nc_oc=AdldgdeBPSOVnkvdS85dQvZ6UWmCQDeY2031oStmubsleTk028jXfOFugoVk3kgn1LQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv1xe6Bwh-65pZBYaweCKIjUkcdLh_RqC0KWsAHPTGPxQ&oe=69985404"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
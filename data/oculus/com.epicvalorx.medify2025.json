nt-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1260496339534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDllKZV8dLUQ7kNvwF474MO&_nc_oc=Adrb9SOs2vJ3rS0XT5-aISnaNEZ7qoPfzlywF3l9OV9FKOCZMUKJC5WRO8YlkS-lxtI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFAj0QXVzMWu52viWui9dqTyrHBh9SXsLWOattKd1SAg&oe=6AAEB1D5"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YUMppC7wRkQ7kNvwFTc4Ll&_nc_oc=AdoffIvW2zVGchUOpEuget32ni_DOhTz9ZtR4mMd1aFsSUOdk4syXoYDhxIK9agRWok&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO0O4qFET6DYtIcoOPL1pBnLhMmOSVsoHxAMB844f73w&oe=6AAEA104"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jmv7EdKUZSkQ7kNvwEMcKqf&_nc_oc=AdpRg9184KiaCXm8uLHjFKX5bBXQ4Xr1BR6mjGneB54LG9Ka6gQVVFrY8Hs65CCwgsU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvvlqXI-P6Oy-iWRS3-0ojSn1Kz8aIn-4C5YtAUQ4Q4A&oe=6AAE9E51"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGhLKnQDKAAQ7kNvwFCAicl&_nc_oc=AdpH94ZU6vL327nPCp2mOxeiP8IOYm6S5woODl1CdEBjdez1KCHjk6ncjRPIqjayfxc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCfoPZtA-JiZ2AwmT8RayzvkkKYpH5Oecl-Xr1QHI9DA&oe=6AAEB3DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Z8Nha74UcQ7kNvwFBviq8&_nc_oc=AdrE9hj03Rtdt8GlXm5n4N_FLFTSNPWQrD0Ce1XHqOr8oGbICAQFIW_tuH36cCGN6FA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz1y3t3iG1-Imon5FgE000SvVgaCm0ZQd01GzX3gAMrg&oe=6AAE8084"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_web
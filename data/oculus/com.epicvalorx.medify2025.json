338 (2).png", "id": "1260496336201666", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1260496339534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co9jgBiehEMQ7kNvwGnVoWN&_nc_oc=AdoneOIYkAcaQVRaSt8fpt8oLmgdgebaEmkU5j0XGs-H5KML-bnTavShbck9mnM_kys&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjwsu6T4QVLSFskXCWplOpZFpObpZr0Px1ZVMo9TYfAQ&oe=6AA96BD5"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LHWGERbC5gQ7kNvwHKktKm&_nc_oc=Adqe6SradYgLoIdX_7qlSUW1TAFNF_0t9e1EtiF-0xERj-lDnAJ97fVqj0d1x1kFrGs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmOeiVorZSutu4Xd4b_PLpewWyCyo936MB04KgKswv7g&oe=6AA95B04"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71Nzrl_Ms4AQ7kNvwG-a4oY&_nc_oc=AdoaWLKZjbNiRg_KJphqLeUG10Gs_RTO3qbyiCdm-24NdlaClmjOvaq32EED3VrBwzY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUmwpt58puFire2yFBA0uNZMFz2ZfzhwyfumCnvbu-_Q&oe=6AA95851"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTvignXA3B8Q7kNvwHjAi3d&_nc_oc=Adql-Vi0Pwpd1C1FDhpEmDMEaEOKasI_cPk6HVtojOUj0h5sdrTKSxM7K2MgauryAuw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVDKKYSg7lgQm8VxulsWruKq_zBxtCx7ewQhAsTku2wg&oe=6AA9359D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=237zCD02TaMQ7kNvwF1jh-J&_nc_oc=Adp-CgnPWySDY0C8f92Ef_kg7PYkByi1HKrfnH1Ipxe2573TjRosMEiW9AZXXeMzmEY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcdW1o9kDBwxT-5urPKOplfxCBO7Cw2ClhT26N_dnUEA&oe=6AA93A84"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_serv
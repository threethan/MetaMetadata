534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClpQPS_2nVEQ7kNvwFK4PWn&_nc_oc=Admi9BIioz7D9_WMAAQs4-7w2Vezkcb1YtxdCdkPuACXeUBdUoDnGLBoS8dONSiTGqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3jie78o_J8wQsftj62xIFjBiDczNDF966D6Ehp9TNHA&oe=69B2AB15"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slumjHtNyPkQ7kNvwEjOPdg&_nc_oc=AdnppMauIfMYpHFTNDN6z8SoiF-Gyo9J_yea8ON5smw7XB6mKyuYvu5gu3eodcGM1WQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyN-xm-mZjGdp-_dfeKlaYReI1vRL09xmXxmL8_XDAn4Q&oe=69B29A44"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ADDIdBFZsQ7kNvwGBjgyd&_nc_oc=AdnRXSTRgJTVhPESQtREO-8jn30oVLfoUbmwlITZ4KFkVjQruHW_U-YbupYVBs_9p_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLPoHq8GCR-cD_T6Mu8_Tp5OHmj8NFIKaVqAVyDZevFg&oe=69B2CFD1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOjyAtevcBcQ7kNvwFX41-H&_nc_oc=AdmRDmo0URRcp-rzyaexUE1wRfea7CeXcchCaL9TsJx2DQ7h_j-HwemE6beAuMGE_Vg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAgd2gJtsvKk5OSEgzvdo0RPxAnDGOLGo8weUVgEBi2w&oe=69B2AD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atWgCrMdf1UQ7kNvwFvO1Vi&_nc_oc=AdmOCFPCTMM5FxTGgCoMy4BhuIQ8qrkSNHh7ZI_F9dPYQfk8IFh7DBQqJWGyouPcuQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6Zql_m5DGn2TbnWvKLHSp6lXt4gtOHoN9W1RXhrlfgQ&oe=69B2B204"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
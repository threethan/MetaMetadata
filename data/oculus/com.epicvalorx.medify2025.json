nt-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1260496339534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDAsdY3y8YUQ7kNvwFxlHga&_nc_oc=AdodBMgXGNShw3willKtwDqW-R8KYIF3XGlZ9eAYPeyx_G3zav6SJWAmh3G7Zc2We4k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MNM-u73ruhUs6QDzn8AI-e7P9Wl7lQCWZnBZDutQs1A&oe=6A395C55"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6aQhUO0wSMQ7kNvwE1vGIS&_nc_oc=Adq2UYcdSnJuZAHMJaariKIXqMk6tcPJ0nhjbK7D8GJNEspphWi0qSLibdMQXgCCSog&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98_cmSM5kjBr7ZPYxuoIClHuDTlLUyUM0vEQdJEQ0yKQ&oe=6A394B84"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvTrlF5WgO0Q7kNvwFCdzv9&_nc_oc=Adq4pCznpsCKPLUempWTWnPtUDriiWhyMgOwd7gpkhI28JhLae9Ac6nYG1a0JPNc51A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kZcwac_SFoFq8o4fmCGYXtEG0ptGEXPk-pt_FGAPz7Q&oe=6A3948D1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Jlk4lU-6AQ7kNvwEGW3X_&_nc_oc=AdpmSBHf-glsDVK3pdoSaDqHIpIefiam0hA-FOcqgBtyJJHP5SVflWzd08RoJ9MG4l8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nKLcY19eM_76xW7YUrFoWp9gcg4ZG0k2RQqWL6zaXxQ&oe=6A395E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glJrnlA4Hu4Q7kNvwEgnv8u&_nc_oc=AdpxBzP30H-vlBm5ssR4ifs-3azBAGNeMHvIuQHR6lxgpYUsQRCIzJInugjtriy5kaI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93DWH7-8vEKakEEM7fqYsenAFlcz8HbJUqVa3oDOO6Xg&oe=6A392B04"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_web
534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paukl-T3zvoQ7kNvwECqLrO&_nc_oc=AdnpFcIl8GeJfvKOVbSloOSxfvfUjKRGWTA3TsO6ICAIxmcUlBkM32-jXh4qGxN8BE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxy3dz_2tDcIqw0iEt_K89OkHfDFZVqauDatFiu67KmoA&oe=69AEB695"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dWHOFxHrTwQ7kNvwHibXmc&_nc_oc=AdlHOW5xvkwlOzjqyp2Fsjht4MHO4-on3KRHzqn131OtxbKbLRJpBIEMrdIx8B66bSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2z7iD4SjZTtKGYgZLxG6_pMZPWh3g62z2VTkEcRwxjg&oe=69AEA5C4"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJypY80nWfkQ7kNvwEbIeee&_nc_oc=AdlQXI1VU6qp8rOwiOgyAMq1Nw6tgKIWHyB3NUSRELyengx7Sg0gpitbGREWtrmh8OU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd0egfhHq1d37YGchLlCqWvJ9Ho-KtnzMa6oXdwpmq9g&oe=69AEA311"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieed4TIWLjgQ7kNvwH-Rz3t&_nc_oc=AdljQvkhOEVlf-8fTTG8SmrlfB_a_cHFIohyYeXW74xpQZaBBridGqoDOukIggm9HhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBdZDGDnzDpzl0UkJQZQWEgM-KfuPJr0qzGNvYDe6Jsg&oe=69AEB89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omezg4C3fagQ7kNvwFQjzh5&_nc_oc=AdkQolviNnoP3NkyQukKq6CbM9jcuh6RnMhl3aU7fs6kLoQ3XtDd0QMq9JajjFWW8nM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxTozPT0AdtpjUTnE2r1UK60O0ppOhlxE09Ah7Nv883w&oe=69AEBD84"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
338 (2).png", "id": "1260496336201666", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1260496339534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PfiFWi7gGIQ7kNvwH0ZLjw&_nc_oc=AdojbJ6KNq2mNaWkGO9BEPA-T1APWxSCYFt9tQR-nWXwbmcGynVUMRb5fdJqeEHFAKs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKa6TxJAsMiixrs30Om4Mu8HkaNLt8LNPM8KBxc-xaPQ&oe=6A7DB215"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDB0HtIZmfUQ7kNvwFD7m5t&_nc_oc=AdrR9D7jeI--wSHqYQGPZSnDcDgcD_JqIW3LinZfi3EL8i6NlU2f-GmBo7cvoC-0zg0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQGLUYWjQDd4rU4KYs98YsSSE5ZFHMiz8NIF4iOmbYvw&oe=6A7DA144"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v5ewPnSQFwQ7kNvwHoZ4dr&_nc_oc=Adr4QFEAqXF6rORh7NKH6-uej0xHx2SyZVtHlLI9JZahSuUTAtbtrZ0QBi0R2W4VS38&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlIo_24L-QI-UaYhEwUcPKahQloSSz71EiLNIU6tAv_Q&oe=6A7D9E91"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsB4nqDvjQAQ7kNvwEUf-JW&_nc_oc=AdplAvHBBmnbM0svLuRVKBECdr9eylZNIqiOLnvrdW5NG9Xv7e3HHm-DE-6jkdQ-Ygc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY-xTvggeNoFUPgGnLeNceTFx0JZC7sJs5smQpqpuLxQ&oe=6A7DB41D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEvaJmpBCmgQ7kNvwFFzz-7&_nc_oc=AdoM04H9K2jdLWyHB5m2OlNZY0zd9LI__D0OF5xRwWzl5KhsA8MPk8aPG0tXaoawZdk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Z74rnE_WrJk6TxMgtf5xgdA91gvEeX9l1pSsAC2UDw&oe=6A7DB904"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_serv
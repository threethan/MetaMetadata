e_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ql6WDVukHEQ7kNvwEc0Gsk&_nc_oc=Adlhbz3wRRdjuXmNbXcSItkGtzZXehA-il_tecFqy5IgxjQcquutMlJV_cbnWzUsABU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJ3T_PyZ6BE_Scx3iFf8E4uKtIrdtH1opammoadAbl4A&oe=699C30C4"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_nPdHtd-EcQ7kNvwGK3IDm&_nc_oc=AdnPh3UOO8Mz_lRB511t5QHwG9Mzx0M2z7M8Xw6gVukpqpGSulbkrVJZQAy-io7w4RA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftLjNGwHD4tFPcu9LT0ChxNfzQZMhRLW44lqcQULL29uQ&oe=699C6651"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVnl6L5QMJkQ7kNvwHXC3VT&_nc_oc=AdkKw8k0ZDw3KK4axeLzKrHKg9djG53syRn6WIYzJA818Jam0eZNxa2KQcFky3HCHSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvEez3eWTTwTyOWR1LivmD23QVIIjfw5BRATuAzYLxWA&oe=699C439D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrqOoSPILxgQ7kNvwEehmXr&_nc_oc=AdnTAUF2-b3PoRdaPObtyfETqdSysMB48h4SJ8dK4gp8XGd5Jz_asO1LXNtYx_TtZHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvt0EUtm0uK0buUZQuyCfFrzg3wYm5Bq5ZRcFwSygUk9Q&oe=699C4884"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
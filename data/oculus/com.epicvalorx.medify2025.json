dnsctR0O7NVAKC1E6I3rdgzBTEGLWTdAuAFeBgXkmW-jf-Za2qByDFa9XjdZ2hphbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulC3MvHbETFbZCI_E3qpPPubvCIIFjeyeepgqNdUHTAg&oe=69A2D915"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjJsrT8eOZwQ7kNvwG-vCg9&_nc_oc=AdlWOS39jSCr5R2OIugOTEEX9V9qI66NaiXoix3q5cYURTRyNqlntiCW2PBRTHlmGws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuidqh0ZcUrJ6V3bgzDPxfNAt1vrIrpohOQ0V01T3eQAA&oe=69A2C844"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfZFt1NvAPoQ7kNvwFqjmrj&_nc_oc=AdkObWagMuXgV27sjuoWpfYSg6CA8iCVObNLK2cSEiEZJ62E0ycFpB5YZKQoBfqHJXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvistRlB74nZnrTmGUrNVhoDq8bb-ObKu_17vRWQt5bSg&oe=69A2FDD1"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzH5UeFDcDcQ7kNvwEpUgIJ&_nc_oc=Adk7UQ51NsLZLRasL3-1LoGjzswor9VnBaOkMmjaX3qKFeS5cXiwnuVNUPmhKkZFCCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftpw-0oKslXbyWAmAwd1gcHOadju8Y1VHWoM7A7yeFg1w&oe=69A2DB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vjNs8pJ-k0Q7kNvwFnXs2-&_nc_oc=Adn-V46vUkEe4OYHU5XnFBRBPpUkHTIFuPVmKgu4OhzY0za9bDhVdEEeq_hgQnfuSbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGglTPQurXF0yDkArKKjnbj_pEvllSu-KGu6Yjc_JIuA&oe=69A2E004"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
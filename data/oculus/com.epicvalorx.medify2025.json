534999_7813779562978181759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ9APTB9YXQQ7kNvwHsZJEi&_nc_oc=Adm4LQqjR10PNVIixm_LKqQroveNUQVN_6WcoTSo_z60qAfYnr5yEHQADy1Eov4WwlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afucst3gzpksT0x23SkGo-VvSmky04HoWJcgH_23Qouv2w&oe=69A81F15"}, {"file_name": "com.epicvalorx.medify2025-20260203-110154 (1).png", "id": "1976089433308107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1976089436641440_4147665186843696527_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2szL5x2UKpMQ7kNvwHbrqg-&_nc_oc=AdnS9oc4Dd4s-KYNTBvxc7mu-a7wFZAgGXWwZcMODNk9VeV50Mi-a0X27fHYHkyXTUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4-vAPGDorehP7xQyRmQLapINULlC5w8YpZtGc9q09Uw&oe=69A80E44"}, {"file_name": "com.epicvalorx.medify2025-20260203-110359 (1).png", "id": "1437336524778503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1437336528111836_5206171615767912963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4leFJf5-YqAQ7kNvwHvb_1a&_nc_oc=Adlt9de4oVxWGpW1nqWYUirOOPbWxCheFl0T8OwzezHr7llBp4GZropES0GKtiR-fqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfszL98XKdJOqALiN45SljVJMNu87W8OMpkRwILrFEJTGg&oe=69A80B91"}, {"file_name": "com.epicvalorx.medify2025-20260203-111124 (1).png", "id": "1574051250730530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1574051254063863_4261258576469770372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwxzDJJScbMQ7kNvwHLkQhg&_nc_oc=AdlPvyNdljq3EGBn461BmIhNtQXf_GSN2Vw_XMlYQVJib64LgOvm_aQOGhbNGIeGMtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvp6HL3kJMKWcZi17jttC2H-kxO8yyiYxoY_Y6EyiCFiQ&oe=69A8211D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imklm (1).png", "id": "1258716002819609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1258716006152942_4608700291512735721_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwQujCwOO_cQ7kNvwFzLkBE&_nc_oc=Adnh4SKCtBIbT9SqZqXAA2pcBZ1YeqDnyq2LE6ovUKbGlpe0y9AZVX_-BRdV2RNI5VA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfscTMEVVz5VZQDEHTNSQ8Wa0X8Ipf9bbssCRsT9bSEOqg&oe=69A82604"}, "display_name": "Medify VR", "keywords": ["OrthopedicSurgery", "MedicalTraining", "VirtualReality", "SurgicalSimulation", "IALearning"], "long_description": "Medify VR \u2013 Immersive Orthopedic Surgery Training\n\nMedify VR is an immersive virtual reality simulation that revolutionizes the way orthopedic surgery is learned. Combining AI-driven guidance with realistic interactive scenarios, Medify VR allows medical students and professionals to practice surgical procedures safely and gain hands-on experience without risk to patients.\n\nKey Features\n\n\ud83d\udd79\ufe0f Hands-on Practice: Master surgical tools\u2014from clamps to saws\u2014in a high-fidelity environment.\n\n\ud83e\udde0 Deep Immersion: Navigate realistic patient journeys where every diagnostic choice matters.\n\n\ud83d\udde3\ufe0f Meet Your AI Guide: Train alongside Al-Zahrawi. Whether you need a quick tip or a deep dive into a procedure, our AI persona provides expert guidance at every turn.\n\n\ud83d\udcc8 Performance Analytics: Get instant feedback on your accuracy, speed, and technique with our intelligent grading system.\n\nMedify VR transforms theoretical knowledge into practical expertise, bridging the gap between classroom learning and real-life surgery.\n\n\ud83d\udca1 Experience the future of medical training \u2013 anytime, anywhere, in VR.", "short_description": "Medify VR is an immersive virtual reality simulation that transforms orthopedic surgery training through AI-driven, realistic interactive scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/faouez12/policies/blob/main/policies", "developer_terms_of_service_url": null, "publisher_name": "Epic Valor X", "support_website_url": null, "website_url": "https://epicvalorx.vercel.app/", "category": null
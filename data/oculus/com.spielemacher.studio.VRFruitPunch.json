content-lga3-3.oculuscdn.com/v/t64.5771-25/38982678_2066528020200322_6190109533936443714_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QemiL4Ym0acQ7kNvwHTXM9c&_nc_oc=Adq_KVVxNzJH3aTewZ35kKJku1BHbwshCwdIw6XLWMV5hKxlwIQvWKLkDR-DT65rcAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRHToJCCBy5brJTajDjuyUQBcwLzTokLLcOLu5za-vRQ&oe=6AFB41A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0.png", "id": "871221630964752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75203627_871221634298085_8689019615045089889_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUUEgMUXKkgQ7kNvwG67wDj&_nc_oc=AdqxyWfopFRvNyHfJH1_k0lD3nhsLUExgWq-1RT9DpsPyY1bRXjtDEMEwIZKP9wEhQc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIx8TSD3PWtLDURDbvepJOhxoFfB5EmFKQqiIqfxwJbA&oe=6AFB2B31"}, "display_name": "Frupu VR Fruit Punch", "keywords": [], "long_description": "Monster Mu throws one fruit after the other to your head and wants to hit you. Monster Mu throws faster and  faster and will sometimes  throw several fruits at once. Punch the fruit at the right time and finish your fruit cocktail otherwise the fruit will explode in your face. Attention: Don't let the toaster hit you. \n\nstay tuned for more updates coming soon!\n\n\n1. Update October 31st:\n\n- Points feedback more immersive user Interface\n- Combo system & points multiplier\n- More animations for body hits & fruits\n- New monster hands\n- Point balancing\n- HUD changes\n- Bonus time function\n- More dangerous objects\n", "short_description": "Monster Mu throws one fruit after the other to your head and wants to hit you. Monster Mu throws faster and  faster and will sometimes  throw several fruits at once. Punch the fruit at the right time and finish your fruit cocktail otherwise the fruit will explode in your face. Attention: Don't let the toaster hit you. \n\nstay tuned for more updates coming soon!"}]}, "deve
vO1CEWUU_v_mu-7NXXYRTQHIqvZmlvkzAWFvrJT1JUpxJfYWEqk_ysEoeiQr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuEgygNZKcDh2N3IP67JHilnk53CN_Y_qqogztqxKlcnw&oe=69A44CE2"}, {"file_name": "Screenshot1-1.png", "id": "2066528016866989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_2066528020200322_6190109533936443714_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ucy4E6csFoAQ7kNvwGX7RS2&_nc_oc=AdnFpcMsCldCM-dMITWsbgOecpi68yXhev8ug_15hrABphX5zDDqpXPQNuON-7Ka9Jw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvaJrAXROUEDI7jhe941lBYt2XwPW1YJ6uAIpB-4jDi-Q&oe=69A44368"}, {"file_name": "Frupu Pictures.png", "id": "3575992065972346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003225_3575992072639012_781522504001907014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXx7pG7ATeoQ7kNvwH2MD8G&_nc_oc=AdknYTvaG0M0TuOOBUYqOyH1ZwVYR-qhPONmwWu8GA_bR667sCKiZaIZnQERcWIfa9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsETj2L4Wbr81cD1Uq7T5id39VnJKCT0BvUWxo9nxxJCw&oe=69A43257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0.png", "id": "871221630964752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203627_871221634298085_8689019615045089889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTA8nIhDqHIQ7kNvwF8pRnE&_nc_oc=AdlobL_wzkXTdSfUOxeh2GvZ6RcwDAXX9ktymAxM9Uvimqns2ngBVCDR1EZhBa-SULc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu5_HRBdZcahwjHn6WLY9UnPIKJ_RHBiqcz9iF8err0wQ&oe=69A42CF1"}, "display_name": "Frupu VR Fruit Punch", "keywords": [], "long_description": "Get ready to dive into the ultimate action-packed VR adventure with Frupu VR Fruit Punch! Battle against the monstrous Mu and his army of fruits, as you mix and match to create delicious fruit cocktails that pack a punch. But be warned, these fruits are not your average ones. They're explosive and ready to knock you off your game. It's up to you to stay on your toes and use your lightning-fast reflexes to dodge and strike back.\n\nWith Frupu VR Fruit Punch, you'll have access to an array of combat moves, from left and right jabs to swift dodges, all designed to help you fight off Mu's minions and become the ultimate fruit punch master. As you progress, the challenges get tougher and the stakes higher, but don't worry, the rewards are even sweeter!\n\nSo, if you're ready to put your VR skills to the test, head to the SideQuest Store and download Frupu VR Fruit Punch now. It's time to mix, match, and punch your way to the top!", "short_description": "Monster Mu throws one fruit after the other to your head and wants to hit you. Monster Mu throws faster and  faster and will sometimes  throw several fruits at once. Punch the fruit at the right time and finish your fruit cocktail otherwise the fruit will explode in your face. Attention: Don't let the toaster hit you. \n\nstay tuned for more updates coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.frupumakesmehigh.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "spielemacher.studio", "support_website_url": null, "website_url": "http://www.frupumakesmehigh.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "806757774179869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771
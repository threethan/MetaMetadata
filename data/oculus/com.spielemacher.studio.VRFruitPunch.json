ontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203627_871221634298085_8689019615045089889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6YbMlz7w18Q7kNvwEcMmPL&_nc_oc=AdnmXBv7DqHk-CckenF1iT8i9o1V50dd3iFhFJXt8CGZy6cix-985IHP9XVPQZ9ANCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvVp08GF8opEDWEEoDkvfIZ_rabQHWpA3pbJc8_g0KJVw&oe=699AF271"}, "display_name": "Frupu VR Fruit Punch", "keywords": [], "long_description": "Monster Mu throws one fruit after the other to your head and wants to hit you. Monster Mu throws faster and  faster and will sometimes  throw several fruits at once. Punch the fruit at the right time and finish your fruit cocktail otherwise the fruit will explode in your face. Attention: Don't let the toaster hit you. \n\nstay tuned for more updates coming soon!\n\n\n1. Update October 31st:\n\n- Points feedback more immersive user Interface\n- Combo system & points multiplier\n- More animations for body hits & fruits\n- New monster hands\n- Point balancing\n- HUD changes\n- Bonus time function\n- More dangerous objects\n", "short_description": "Monster Mu throws one fruit after the other to your head and wants to hit you. Monster Mu throws faster and  faster and will sometimes  throw several fruits at once. Punch the fruit at the right time and finish your fruit cocktail otherwise the fruit will explode in your face. Attention: Don't let the toaster hit you. \n\nstay tuned for more updates coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.frupumakesmehigh.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "spielemacher.studio", "support_website_url": null, "website_url": "http://www.frupu.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_a
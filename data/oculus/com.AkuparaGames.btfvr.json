id=6e7a0a&_nc_ohc=HBqT6v0NAk0Q7kNvwHf9_tX&_nc_oc=Adokp2Sdhmk9L5UmHXXpUfeS0a3WCC1FenJJ5qlqa2jZ2ixzltGo01Hq6nv0fdSkz8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2tMyS7p5Uc0g8VW5REwC78S2PW3_gFmfSz2EZdCPr8g&oe=6A747F01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbcfFXb0sRkQ7kNvwGC5nrZ&_nc_oc=AdrZ4VQK2td9pbGZ2Y37LTgX3Dy_9oZ0wzlLXpTVxn4I-msm3QnxmnnPJWh039yZijw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc1RWHr71O1RWByAscmKKOChLX3Rb-HsdFKqK2AeaH2A&oe=6A747256"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-8Q3NajC_AQ7kNvwHQiXb7&_nc_oc=AdoNR6ZzR1QKZI-zxyCA7arCZVjZR0vHdhe-wJvPSDE-2gdhvNpe5-xKXqdEVyD_f_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDQi1U_eA2UIB2Y-mHPyOg6HuvUvMcJPc-nocaYBKNMA&oe=6A747FD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKDxY_h7tOEQ7kNvwHgtgyB&_nc_oc=AdoMK_asf2mYRZ4ElM1fGDUF28INYyec18Aj5DjKixSIJLxrtK0KKLKwFK4NuBwuJRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuMw20KEywqcdJeP7uvpi0kDVj5-grECpnFTlpvBB7cA&oe=6A749A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2rKdFantK8Q7kNvwEBAe5p&_nc_oc=Ado0FLOXlFfkxrmS5pYE3czU6qN3i3L89fwkpsMZMb9OrBYXQMGApvnIXuO0LhU3DUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE248knUKSGOLUuxgrxaFTEkxLe6uxbteDldPQ2xSGyCg&oe=6A747BD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
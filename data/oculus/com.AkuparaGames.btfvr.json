id=6e7a0a&_nc_ohc=RfUqfNimrU4Q7kNvwEjuo9H&_nc_oc=AdqnjBFDtX-XQbUWN1HE7KWa9luTNYL9MAauC8d_ZsnmP1k1f7Skn3Cd27dHVlsa67M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1l8GvWokok11YtSMX_MrLiVNq4yFdT1xYKrnXECrJ1XQ&oe=69F74081"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahKc2ZRT7BkQ7kNvwECqrdE&_nc_oc=AdrzTyjKc4TlxXbtFzim5nBcEHrJMUhZBjElMdg38yvfP7--TWGcUEpArT_tAGVyRCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eIxM8mGmOhpW86ovuIYtywhTZH9c4aoIU8PT49t7EiA&oe=69F76C16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnmuywHYIaIQ7kNvwFjE9Aa&_nc_oc=AdqwDFMV9CN4LYh2jxMJ-YMct2ZLTI34Nw0snOVwefGQ9llEutEN6Q5NR3afuqFKLS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0m9HyfqOO_jcg2uwyWIJjSGeOrItWpJmTMeBVB_4fSSg&oe=69F74158"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0IGFH9Iz7kQ7kNvwGoIHFu&_nc_oc=Adpv43WCWBQl59qkaYvTkKAGVFDJlzRSpeuBtHM83r3jUnDd074_qXdxPmtw6BPmUGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0idaUAyfPGLMbFOVD46WrVYVDAwGqWnEqxLHADvj4FOw&oe=69F75BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtSHhKfKVPMQ7kNvwFKh7pA&_nc_oc=AdqWj9oqVCViaFVJfWRYBPPJFl-bruoQfCHycg0-p7A7jEsyRFkIz0jdhZ7OhLI3Xn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tcbACNUKTqRr3Oy9utDYMHB-enINh2atu4HPK126e2g&oe=69F73D59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
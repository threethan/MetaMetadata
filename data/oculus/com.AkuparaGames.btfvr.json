id=6e7a0a&_nc_ohc=bZ532BzGcjQQ7kNvwH8WDqp&_nc_oc=AdoPPiRimDP4NM3s3gOmEY27_jZdYDonxDGPRu2sGt70Gjj1ZzD7VlQmrBHCN_kvl3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xOjsV1HvME_rzoC3lEwl9DFOpmQaTBWkdITdLGJfPQQ&oe=6A01CC81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eZGY4FtF0gQ7kNvwHqAOtA&_nc_oc=AdpG6qSf82PmmM9e248PuenQsxdNHej-8GtSn6aw7ZiXw_i7vjQkROHxUSNnmRHTUVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qfvuYDzo4QPvvA2-mikHxm5NrEtA4oBSeobfQI7nHJg&oe=6A01F816"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzOUAEIFPS0Q7kNvwFImEak&_nc_oc=Adq77ksEg-_RHu5y8d3r_nMaqp6Z8DTpoXyKHqY8K8IBYOPSjx6Z2QYgnw3m47R2EnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tQ38VQxass1Sf14ZDuYyeP2grodPloyqFih72lRtoDQ&oe=6A01CD58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOEJCdxEnZkQ7kNvwF8nIy0&_nc_oc=AdoxlemektyNSrZHXgjGzJc0qtuPiCalR2Q-9QKNd2xLPVB4rQYsngD0cm4r__2MGCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T9l_-MBWo0Vl9M-Yf_L9wmkS5e3Q00_ehYH6cze2xTg&oe=6A01E7F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JmHxsfCkHwQ7kNvwEvYlCQ&_nc_oc=Adri0yudSPW5yTLgc6lopJLfU8TZfApn7pavybXLD-STJmum-S2JwA0Ew_zSNJRIhrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42PlHwl4uevOA8k040SI7ybG3SYf1P9SM3of3NODXjNQ&oe=6A01C959"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=ZjuAjOYuL2AQ7kNvwHlGnHl&_nc_oc=AdqTCwZ9OZnd9cijNEkx2hsDjq_9WIb9rnY2jPPuU92c_ngBH_qHCy9gXkCGGSW2GMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvzGWXfxmFSbLG8fQxxB1GIXT6jcVlgJhN32w1fcVl5A&oe=6A845101"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm37UAExZs8Q7kNvwH3q080&_nc_oc=AdoP3gjQY-wqwYxHrJWVmJXjv7VFKUKbVMYkScLOXfNiZvPT6RElrV_Dy8mrQxS6eis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3AjN3IdSdxxZLseYAsqZO-Blk2cEcO2L8uTSdl8TOwQ&oe=6A844456"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyB4uX-MqWUQ7kNvwGkA9ji&_nc_oc=Adq46hGe7hw_VoOKYRcUG4o2IrmrA_eWkUEcMmwa9QcSU73bR1RudCSrt3ugmqP-WtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZT8K3YkZbT-by99_5n80nmSw84YuXkU2tBhthR8-7OA&oe=6A8451D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7kxfJZZ6Q0Q7kNvwEPLuzP&_nc_oc=AdpGKNYwRsIgP2K7UgsX5nqoceVdi8X8XVVpNnKdmukgjDaDffWQv5FT3zVIPul_TMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFawyCtRTx1qvBoZ0hM3DAITNIgK-Qy0_5SdPtnOiKJ6Q&oe=6A843438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74RcfLN0StIQ7kNvwGDsn5G&_nc_oc=Adq9QHJzgwnhanXh7PHkx_zUAH5aOeCBB3-oZmNWmdsCRB0eYxiD5o5vO8qlJIRfjMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtaOPM0hUVUewqd3aZ6idKfptuDeCKZ0u1iL6RArR8hg&oe=6A844DD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=RzHlemoNSfAQ7kNvwHOy1AF&_nc_oc=Adrj14LoyuYRcFhksTPowBhc64axCuWzFF6HOF1G_jbnimfnVew8EqGQDFOnNJnLqMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoh11BMnXqaDEvwpGd617CZvZXtBk6IRanxSntA3XhKQ&oe=6ADDF701"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8HvwqM6trAQ7kNvwEU4tCv&_nc_oc=Adr_1tdAWoMAhsd-i0Q2B-JJ8gCnmFJgr0D_tx9gtGs9qSSJlUCj0S4Nm-_UusQX6N0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtFGLJ1vhtK-Gb4JmazaSxKrrdemDr3aFDiTe-iqk8QQ&oe=6ADE2296"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xylmbJmTUa4Q7kNvwGXCg7C&_nc_oc=AdqnOfsrCg33Z-DA_puiIrOgcmMopHlgIfyAyaQbq68P1DBQZT3XPAXfFx3weuGmGfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkwxOwYA4SHrEn35QuvUxUjjaQIwQJsuwBxEauIaoJeg&oe=6ADDF7D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs3D7-IKL90Q7kNvwGVUoT1&_nc_oc=AdqgVbla_rqnrbhS6zQWyZ1MAKU50cNcPfgRVLnVtz5iOLSGaAFy3a0HAv87ElL_nCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLNDlPdC4SbSYnxoZgcge5yR7thYYJeN3JG25vNqihXw&oe=6ADE1278"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NVamSEyytoQ7kNvwFJZq1y&_nc_oc=AdrqWfnp2YZR3H12VpgpGpIaAhskq8ohkPWcAN5IGVLN0rVl7FnEak6QGLCMM2fa-Vw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPwJkD8S5x6VF0u1y-OXJBATADc4IBdigamYS9GOej9Q&oe=6ADDF3D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
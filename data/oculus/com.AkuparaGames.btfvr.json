id=6e7a0a&_nc_ohc=66EfZFha_KUQ7kNvwH8m8zW&_nc_oc=AdoCkQH4iDaq3rFjpm3pJg8hQLLsWKI6N0AQOr9D-XXXvxePHDrub0hBnAmOVcs3G1Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFdnW5lL5fKPzKEtkOZRNV2sSclwBY9BL5Q_3JhEDQTA&oe=6AECAFC1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqRpsyvM0ScQ7kNvwEcOJ80&_nc_oc=Adq0C_j8EBpAyO7OInTbvPvM37U9TNjZ3wkFnASHUw-M7SVdoL4vs92inZC9PxgSrHs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Caf22XwdBXKLvY1xQtAhlGIowljaWTwEY3zmWS4AVw&oe=6AECA316"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFmnWulsxcQ7kNvwHxAMYf&_nc_oc=AdpADL9uEQonrDYCdciGfsXi6iycdoICT7x8708h-ku1z5bPyDuRrOPDXVvWD0o2WoQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOUkU3Yc53mF0LZCXA2mht53O8CcyDPs8ixVDUXUej9g&oe=6AECB098"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu8sp8mJHigQ7kNvwFGlapG&_nc_oc=Adop3yRbZR0ewuUO606mybjUD_f8CO_xNEoD6cOY8NvgBwx3oT2QySXZ9NVDikP-Bqw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI7QDx_za4E5W_rrmsyk9BS1EoNezjDLQ6v7fmk3IaBg&oe=6AEC92F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soxFj7u6rg4Q7kNvwFREMgm&_nc_oc=AdrXnofMeU3FLEzFwhvTyisVXuxGKC5UhVngOtUi5bv6BxBDDfKAzwVPdPY2A1yR3Zw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWkTvHiagK9t3_uFrk2u5Lobhh1X6IniyvtI2Dbd8pdQ&oe=6AECAC99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
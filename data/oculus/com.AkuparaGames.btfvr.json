&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAwrWjbUlUQQ7kNvwH-c7Cs&_nc_oc=Adqu8YWbHui-9thcq1wjQaASmUcMllE0u6UTXgruMRtdvXewUiyzqpJ-BSR2-_NKYmk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Qcous89WJwAEG2o2HYnMecFfTNKTO9fPqqZCt0h1Cw&oe=6A85A281"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zdkVja5nRIQ7kNvwE6_cLg&_nc_oc=Adoe09_s_uFkmTo3oDMTMVj3Tp2aZ7c6tbJv9JPVAXZaBRJe1DcLYS8-zEQNw1i1VzU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPg9YGRfdHrtSpJN-Y8cDkTVnN4L3Gjlyn-31ICBalwA&oe=6A8595D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjhBFwHphRQQ7kNvwE0rqZQ&_nc_oc=AdrpvtwzgKcsWbMNCz6x-GlY3yeeLCsCkBCVOXETxJHRDxm5f-cTVbLNcgEsObn7fyk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC8NcXir75zcWQ0su9rEvDTsmZOSmvtkiECraxaXTshA&oe=6A85A358"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Al20PIFDuAQ7kNvwGZ6BPu&_nc_oc=AdpXMkSnvKzoyElZYbRl9axj1FY4sLJuiPuQH6pETsXTMSva0Q1wYjWqB4iHra9pLK0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCF7_rxgEgEB1BuislS9dFG7UJWj7hikNJlTG5LEytKg&oe=6A8585B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74RcfLN0StIQ7kNvwEqwt7g&_nc_oc=AdoWvTkiSZdqXkgr8U0dDQTzNpKBAYxenJffpZWBYqLNqSsRNmqgmnAxU7EkVAHQGE4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGLq3NeTAHhdN2p5anx0wcQs5RzVnH5DrOSHu6WIJrZw&oe=6A859F59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_top
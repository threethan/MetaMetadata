id=6e7a0a&_nc_ohc=WT_bmhIzotwQ7kNvwEdwxkt&_nc_oc=AdqHC_Bn_OPPxCETKg37pkOqOP9O09hJBmFWOwUr3hg0gtW-9QlBWrbmm8DMxplYnfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXTJsJfsaeViQCe_XKR11EyTojW5ESGQ-rlhvu-w9o8Q&oe=6AAFD281"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adSBIrPotc8Q7kNvwEWzRJp&_nc_oc=AdryPqeXqOsSgrgX432wCFJ_kwhftJSLSPBX1QEesXe6ptO_iFUCtRt4gB_40psuKrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxICJzIGIqUuUpxwZBqCyzzLlzcW5w1OwmWjnEPaAaiw&oe=6AAFFE16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnOHSVVXqK4Q7kNvwGYsQbX&_nc_oc=AdrEkU6OhTHXhRTJ5xUVg7mAEjLCgkuP3uoFcGjIChYj710ca7aOCTrppF0vTsU12_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1nZVK_fNrxqwNvsJFr4glq46UxQEgsJjaJq_59jImfQ&oe=6AAFD358"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TtLALIdVEQ7kNvwEfql1P&_nc_oc=AdrfFTxAv8uoOXScEeuQ7EAg3dtsmLiO7NHKBkHFVpqPU5udkZcr9uovIKciiq7WBfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp8WYV4OhASf9RVuSmt8BncRKj4qTrx1YZDU08Tj9ztg&oe=6AAFEDF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXpBI8oCoRwQ7kNvwEK6L4P&_nc_oc=Adrab70clWMBMUcojuOZ9KHvcHuyX556OyKsumas9TJbjSRlcbOJ7-W0WJpWpJm2Pio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUKDa1CO8nbcXrWgV-1aPRoikw-wSJht2QYDOVb-3r-A&oe=6AAFCF59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWWhs0mfI7QQ7kNvwE7hLeQ&_nc_oc=AdqorTuXAA1gIOYjIhUA3GumTheB2ua64yvLGdtPx9aaN0AuY5DMVu1O3ptO4RIj90c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZTe5VXSYo_b5AwXbjqeNXHKHDZhe6XN56pE6nEnl8iw&oe=6AA3F501"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVVsAb-SmDsQ7kNvwEGbB5f&_nc_oc=AdpHrVrvUcQNtZKbKr7cXWSZOvG2EA68-9PWqQ8G2Xf6pb9Db6dId872XktXAMKc34o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDPxxiQ6FA-IpuB4OkWRzVy0kKoXlh1irJTjF-QVxRZA&oe=6AA42096"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbwKYy1js8QQ7kNvwEI2ske&_nc_oc=AdqfMgZ3JT0CDPEJ9X_aZVe-7iWrPcOXdSRgV8yeCdbeEd1kQY-7GASA9mxruNmTS_E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8CriT6Un2ErfCEKm4UN0rd9jVL-LECKlbY7OxQzOysA&oe=6AA3F5D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALFA0vazOTEQ7kNvwG0O11G&_nc_oc=AdoiKK5mS2XbnF0rmxQJ1MJ6UValua8eVbGEv5ZzoV1dITZ9bafbfccwNeAH1KuO5jE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi33p8aZFAG1Kv9i1nvzn4Ba1tmWdazgmezTL4ObkrYA&oe=6AA41078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d78HWwJG57wQ7kNvwH-7tnG&_nc_oc=AdpLo6u2HfesXWGJ8xAGyQDRd0hqzkK5Vhz7GxPEKYqEPoEYoBvysB-mTgOK7oFxtjA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWV9LViQIfhmpuZdAtNCKLbuOVcKEM1KKPaCbC9zU53A&oe=6AA3F1D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
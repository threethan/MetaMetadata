id=6e7a0a&_nc_ohc=65zJA0OUJZQQ7kNvwFCHvq6&_nc_oc=AdqSKUbBsDV06W7qGUO6SqFdWGvtqdPlo_VLz5iXS8VTFyKavWlLw7dwUH4BtKK6Tdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cxGQl60v-pVmUSBNX60votBqp6xYST3ZCCdEw_StbNw&oe=69E0D701"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4bMkkwHiwkQ7kNvwFPPxSQ&_nc_oc=Adoa6aeCrO0i45HLj_ytJ69WLpZo9h2fEANq_tBn47Wwa3TBdDhn3Ckq7iDThYl-O8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-0iDdMzoMmcqki2jiiJ4u0YCdzujjla6xelz89b8jdg&oe=69E0CA56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgssNCZeJpwQ7kNvwGsGHQ8&_nc_oc=Adq09WWPPCv2XCM2TYYfboJw34diqFGpc04MggHomGxmPSxI9lRi3tjOvKr2oyUiVYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YELaZ4p-1Ycjmq8y8H6y29UeTgbGFe0IuwGWRpsWlZA&oe=69E0D7D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcWYoJsASoUQ7kNvwHc5d2Y&_nc_oc=AdrBNvI46YRjltGQJ1lziIMiakdNXNsH9jX-SLSLZZco_j6ffF-XTY-XlFbY3J6wJCw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_X-auDabYMaSjTl7J2NO68tvkje_BeauetZ_RrqGJBw&oe=69E0F278"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUh6fKoo50wQ7kNvwG3kHcV&_nc_oc=AdpPZEFj4mwsu5Qh6gINbBB0DXcRppUOsmDDJKwBwADVd1JIGWmGFgjYOmyiJox4LZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cnHoFBRyWxbt5xxTU321ZymaIfvun_oPO8RGbSNgEag&oe=69E0D3D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=3gBhdAQFyuIQ7kNvwEXFzcY&_nc_oc=AdqSO0sE6Maf_ZOPbdkz_IvJEyNkgFdUMUHXd2iubRFEYDY-VbSvBfvKNsOTP1fIMWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTjW5uWpi81oW4mCg2uRkAAXTi-N5OCMdt52q9ZiGb5g&oe=6A4A8741"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHRBKr-E_6AQ7kNvwE1vKvm&_nc_oc=AdpRoVZUjNSB5EP8gpKJTuVFraC1Yemr2IqDGBeL91G7vHWAJGGL0wPGJt9xr3p6qlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxHR83uqNqPECy6HK_b6fqWiJsciJxIguGaFJPbZ2ylg&oe=6A4A7A96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1FAiJZvk7YQ7kNvwFyRyj8&_nc_oc=AdqXAFCgixwJjqE-9reqBJMMwS7avpqQXysZ8avf1G_8XXNzfhE8HrGlAI7pLD6xb9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHJOGGZfhhUZHweR4V1GGSn_KRDJNlA3f-zi_KZQ6juA&oe=6A4A4FD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOpD4qf2G9wQ7kNvwFXJNAW&_nc_oc=Adrci2QZAwnBRRUcxayHgx3fVIMxVoBPn_o95yMsjBZrdn5BJ0IOpbONeSSHWyd2Nhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjBc7p-F45KzxLax55LDNBmuzySwufs5sAeF6KusIgGg&oe=6A4A6A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsYniY2wgqcQ7kNvwHDDKez&_nc_oc=Adq0Cxn4Ixq-JywMK4fHK-q8h0LDf8MqwC2b8yCJ8lIe_CpamNGPbnUNYWakuYrTKys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDskJC-X6Se40OnJs-J2QdkTCHJAO_wu45FRBZZhKxZzA&oe=6A4A8419"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
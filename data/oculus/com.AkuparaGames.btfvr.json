&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8hDAchopAEQ7kNvwHsH1Pb&_nc_oc=AdrLIgYzEj8WrGEr5f0rpuCAJnSmY37s6eM1mnIq5rEJCd3jXBTZaypK7auasNIM2Y0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEnm7mQFmk9NYGT-spfZQ7EdeKP21Of28FJWsJ9v0oBA&oe=6A8D8B81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXfI5ifYBiMQ7kNvwE-0psq&_nc_oc=AdqhxAUKMOz59_Jy2JhGyrNa2utSHwrVYAy6oOKushstTCcUWQlM1Rtqg8yRCAm6xCM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwBNstp6kfz69NKCA_XlCWQFKvIgTHuzqzORyJdJ09-Q&oe=6A8D7ED6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CKOcYnshoMQ7kNvwHf7Ena&_nc_oc=AdqbYmSKrdcgYlqz99ua8SbrTuTkHo4sA8YIY-IVYWrFpbuyQojXmFcyCqEOQMkjIQ8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0OBapsJVAPipUs9AKbo2amITj-1khiIJGo_rJFx5dZQ&oe=6A8D8C58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkyHDY5-TJIQ7kNvwG2usIc&_nc_oc=AdphDR6WeH9YAUvnp-o_TqG_GJxiCN697MJ1QWsriek4YJ87cc0_bVbCUEpXhxhD6jw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcmPJVs86GpZIFM7loh9mfYibYJT6b8AwDobO4juJ-kQ&oe=6A8D6EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncfECmk_3RYQ7kNvwFdFo3y&_nc_oc=AdpztA-2dMr4NQY5wNV8LSylwrqDP8kdoyzJOmaPU9oS-BhOda4JMski-nHLFsZftas&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE84tGmJ_I63lqqSPF93ie8AXBYJcIyr9E59WZfVuYDHQ&oe=6A8D8859"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_top
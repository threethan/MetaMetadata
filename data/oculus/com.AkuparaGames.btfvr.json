id=6e7a0a&_nc_ohc=_RtHXPd_o7AQ7kNvwFauhr8&_nc_oc=AdqM6JQtF9K7EKZ4QHSyChQoGRgJVFcn0HEWgK2bsNWLoDrMNHVw3P5pP2G_dDiPuwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KPzb4BbZ25jwya2V7dIzLI9M5ztw-mC99o6v1ZuXrzQ&oe=6A3FC301"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdlpP_6FTCYQ7kNvwE4tale&_nc_oc=AdrzSosFm1wkrM8CkHbhrgXeXzU1qgeg4OK8NF8fyXqTQmhuoVJZXuz4ACCi8pM4gqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KcylxoFUgr9FYu-KUkcZd9ZtVtSPJShJuMPBCKZBQRA&oe=6A3FEE96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyqhuPEsjR8Q7kNvwExMkQ3&_nc_oc=Adrbfa2NhLy23MlY2-g-f21ueGlx5nFFCXyk2L71oDWbnLl5ABvJ2BcgoTYbpjOx4Us&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cFMtglJK3l4SoRPTZJU0E48yKgAHTvVSiVWIlO22p4w&oe=6A3FC3D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu7UfyTSn-0Q7kNvwFw7pZ1&_nc_oc=Ado5_PtbjvYigDyydVFqjXCUZvTrlBxLdoOUz-lBSjrgO9y3FRAosmHQ96yMOCyxHGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fzr06xAmCVOkQup_VWqNP4YwSoL3H4qgN_za3OulSpQ&oe=6A3FDE78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaZI2lntycIQ7kNvwFEENil&_nc_oc=AdokZPduy4d_QPBMitHcEz03nua97pbgeIc21Yzq1V5YLsaAwigEyuHxseAJT0omOac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UFPjBTE6FQaMyIqgSKg-Zpci0BtzfE53vg42vSnoFpg&oe=6A3FBFD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
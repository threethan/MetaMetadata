id=6e7a0a&_nc_ohc=LFXTpDjsG3sQ7kNvwEQ-OG8&_nc_oc=Adps3_k4lRqyKq9ia5zOAKcjiLIdBzD297mBqmycZlh8xdlQYkquHtkihXXWugE5Slg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrY0qrudoQwVVxs0TBUob8ALvIatRAfwAkiEKltbpK2w&oe=6ACD0BC1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r9LNliT81wQ7kNvwF7l6eU&_nc_oc=Ado5VC3v--sF_ipSu1Ba5MNAj3H0cjBcNXrIzpA0euRUFwGVLq8FS66bU2rJYFQxncc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf3HF5ho0jT1QOwYQgfAXVLoxWnZWfZE0ubvJWwXOJFw&oe=6ACCFF16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STZO3lUTL5MQ7kNvwFr1TjF&_nc_oc=AdqHMQM4jNQ1iql-UTzbOhiICY1xW27uGd4-JR7AXEOaMy2tyVveKFVCm1k3eKgn0G0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1KkBK5IeLt5No3IbK7B41bI4zWUDk5mzYkfjVHZ6Mxw&oe=6ACD0C98"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HvZxtPNR_EQ7kNvwGzD1tf&_nc_oc=AdqmuLVEJKWbCqgQQqGwd3lhAsy1ATqC6EWHgo3SEKCtrLKK5ZdUyCMwhJ59VRlwG0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG1QcecwH1Bplp2fqd_qLpbYf1seJvTIKO7qasMDMZQg&oe=6ACCEEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA41jrrzvUkQ7kNvwEdCG-8&_nc_oc=AdqwA-xGoa4Y2iz3VsMSlRZgi5gg6Qtc-OoZyScf1dNdQqLfEliKrjZkb1YA6z4tmBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCVNS04E58YGFWaK75RFQL5FXdp60eK36UheWL0S9AOg&oe=6ACD0899"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
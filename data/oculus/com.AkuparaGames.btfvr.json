id=6e7a0a&_nc_ohc=2asPcz6BjOUQ7kNvwHZnlL4&_nc_oc=AdqtEX-vmm6fmFqhkvIWJb_X5CxM0ls7qO4WW7FOTgIDVaT8EAQVmzVmTk6ml5lFzIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51bD2XUHUAew5wsf4AqEVWnR3EbZXUGTWaH1HE_eXmPQ&oe=6A144181"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MySrtQDg_9cQ7kNvwHwozlC&_nc_oc=Adp-z202aHtNm5FapYDVkEN4NlgK0qMUu1cyG4fGR-MS3xr_wV6SDccyRuKygTfZquk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CeYxVRvEwhrui7zb-f_8g4WCUNVlgpmqxUbdOJPdtHw&oe=6A146D16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVgHsg9mfPsQ7kNvwF0Dait&_nc_oc=AdrOrQv0aJvXSdiCuGYM3NTGf__-IJRUVh2zhRcSxyjGQKJEL83oJ1nycZVKlMoji6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J-Xs_WahK-YZGZcSsZI6G-a9OBgLhlejBYobav-8KhA&oe=6A144258"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WRy9TFpMAgQ7kNvwGjoYaB&_nc_oc=AdpIYtdjHRVH6Vl0YAufT3gWjFxIaa_H0DeyAgd0kcwYRTOkm8LaH-uX6-J-LLCWPEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XsvB53vwsH-4QudTStEDoRV84Rc_szqV-fqXwIIn78A&oe=6A145CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEsBuJrKzeEQ7kNvwFjctgJ&_nc_oc=AdraDW3O7stXmCMR_euMo0KyvHGY14XXYASLUQ-uLyi3Gnbdi39wMdsTI8Qc3MJ4nPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XdZEinQ_vPW3m0yEGi4e7uzHiQeyFQ4vsHhAvGXwFBA&oe=6A143E59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
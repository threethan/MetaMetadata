cb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uomhFEKzhcQ7kNvwFwMVbO&_nc_oc=Adp29B5a_PtewYBrnOTr5ntxDxJwYrTI_49TUQjD2gqae2UH8mAKBi7tTBQx8BVYlOk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rd9D0Ew0uPSaOXOQUPB5MKRfd3n1lJKElwi3kQkZy0g&oe=6A4692C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlRTyvcnuJMQ7kNvwFqc1wh&_nc_oc=AdrBIpcz8vCpZar4DcJzdaZeXc9vLQiEWjwtQqp5cv3yIbRuC27mt7mz7vsp7IR7lTw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97bWD52GEzDVIQO5CKBzd7o-bMpptKevlHKOROG8CxmQ&oe=6A468616"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8W5mvKZyeQQ7kNvwHtaYT8&_nc_oc=AdqlTvudO2hcocKn1C_-K4C4oEswUCOI64MAVeE_IKFjeWh-UDr9kF1zLrN_0ltMEpI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_taoGakebWItm0KQ_ZaMbjnVDzCrQSqU_GjMO71m3i5g&oe=6A465B58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGerX4oPflAQ7kNvwHRff4C&_nc_oc=Adpoj_vv1TAaOliK2GKmCibbI_jIMDyayU910rtqEc_b5DgphuKNgAWz8dlb9ez4UXU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9exHQa0ibh_txMmFI_3PaOXwfiA_G8mihrgDKo9lcpbg&oe=6A4675F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hbt9zJO5EdoQ7kNvwH8o4da&_nc_oc=AdraLo6NuUR4TgqaBs5aETsM4NVnbxni5S8P2o5WP30zjg5hGq7mZ_1ZWVdNEv-iwOI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m668pqCud1CYzwo-HEJ9DxBZ69lT_jmZv2IL_txiNwQ&oe=6A468F99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
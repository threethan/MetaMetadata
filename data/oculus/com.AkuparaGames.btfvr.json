id=6e7a0a&_nc_ohc=IaW-DWiemqwQ7kNvwE97WCn&_nc_oc=AdpX8DdYuCoDMSPr5Msi0_4XLOCkvY2kOZ1OjgWMqisvKaKZPEIibnhmH6uzCHVK9Wg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl2E7tHTvfWMsdTTohLP3bmp8tVOfMR_mQZGSLoxWBpw&oe=6AF9DEC1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRBR9ON_1dUQ7kNvwHgRTDb&_nc_oc=AdqlcPeKS4YGkZ2jFiEAZnpk12Yy7S3KTlfHyucb_OHwiV_b3b-r_ibBRg1I_omyLOA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRafwMjdaV_1zbbU1m7HtG5iF2nSHOW9UZ464QGQGwv4A&oe=6AF9D216"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY_XPc6asf8Q7kNvwF0sB1a&_nc_oc=AdpaU15-THETp-dRz1RiK-bMlK6yyejkm1uaLAKT9_-PFz51nAQQybS4wH2syospXM0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQMbd_0YqoqB1YOsOxC1ivYjl5C8TLKXq0nrhJqD6NwA&oe=6AF9DF98"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGcjDUUF7DYQ7kNvwF4Qa1_&_nc_oc=AdpT4kKhpXjfYqz9lOkwn7bFo51-mdqL1xP6FoyHGeu9CdOO_aHZaMXeN4E2Koa3g98&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU297mxQBkrU6I7PoOJ2s9N_LyNKq35cVv6jv_lL8pxg&oe=6AF9C1F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXV4j_-JaAgQ7kNvwHTSN1K&_nc_oc=Adpg1qGqvlJe8Rsl6ObO2ZlU3GJktXIRdusjuEv1gYBjAVFnry1YLxMR8WWh4eNoYAQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzGZHLL-5KHilML1y4h9eu_T4xwTO0uKVaza_b4shgTg&oe=6AF9DB99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkmZrJsgm1YQ7kNvwGWrCGj&_nc_oc=Adokak23i_TNx-apvVbsdG_JjGU6rin5XZxVp714qUTT-w3ZgQnDG1zaiRLo0--x5-I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN-lzUGwZRBv9x0BQi5_R8fn02P-yKN2J0da-ZVImVQg&oe=6A7DB981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wwZFmbcgTUQ7kNvwFb30P5&_nc_oc=AdrEuqSARKyP-Wq4Uge7EX4LZ0kPR3zYb8EMlBgFVlvRXcgLvunDM5qu-IY_xRODl2k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEped5qtY1Oy1kxNqQe7HMvorybEuHqDd8zKhGDG_toww&oe=6A7DACD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPu3cQeXRB8Q7kNvwHh4Nzb&_nc_oc=AdrqMXVdp_6hjvkZ5gGcE_Hv8Z4xX0JNC1ttedWIDst-YBvMDnoCSK4dMFlpif86Xc8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe9TnEoqy2FvUqtIrJMvnnivTvNB1e2TwNfJUTXhWsUA&oe=6A7DBA58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOx1AnFOieEQ7kNvwHuObtL&_nc_oc=AdrIi4w_YGAbGGy_yk1coBMkwG1fAwGVGB4NBHoqrbq61vcDwOPC_jUwfBFSCpnRLgQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIAcx7ci78HbVCX-8JovQ1lW1jM4utKsgpDS3xiI8R2g&oe=6A7D9CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-rlGyXpt0EQ7kNvwFLc_-l&_nc_oc=AdphiS8OJAFFGlb0FtxKRHmFynEFMCGVQnF_jPvcSLD4XROfv1hl70YQhtypq5zXouY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwDePdeDwWE005kXfM-5lQ2VA-NJYhrKzNMiz7pFtaXA&oe=6A7DB659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
id=6e7a0a&_nc_ohc=82bq9623f_YQ7kNvwHp_bxL&_nc_oc=Ado45-IQsOryKn1lUW3ndffMoCxgzGnJL-EbOCnBgxU2GGDEYHnm38FCD_-ACCsoLRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JYa3iXOmoqIT5gy5V5GtmL2bEvkk1OcOMTxvxEBzMVA&oe=69F49D81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XC34BxfZIYQ7kNvwGzXEn6&_nc_oc=AdrcXhEEwonTJi4m-m78jvMn20f0Io3yziumim1XC0Mx_YKFvUUdACJAeclyfcaBg0Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2db6ifmKfR3Kkgyc_VUXLVuX3BuIXhdAEyydjWYjpOXg&oe=69F4C916"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE3I7iwqflMQ7kNvwGlJU1c&_nc_oc=AdqQOQy5kdrXwpoOHi_2kCk6bjJRd_FvgIdzp5L9JkgvZnK0YvPB_B0LmfZpj-nnitc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fKq-EjonzuKQ361sTZ6kKUVZDX9tSgGb2C78fk3TrTw&oe=69F49E58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5os9qeIH6IQ7kNvwHrhrWV&_nc_oc=AdqMA4_XkxXkG4Wd0w6HcdIRmSQXN_xKfR3XBQDUDx6XZOUAT2_XHVn3dIu10yA28aA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oDimr_NpCvENS2gDnewxjPN1H3xnZzL-cUDUfsPY-Jw&oe=69F4B8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtSHhKfKVPMQ7kNvwEuUfdl&_nc_oc=AdqElwKPrl-2-Kto53auxmPmVCjtKHAxDy95pWOC9GnQGYk8hZ9KRSFi7nl6WhqRJAM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OhOGNP9tEVRMcgEiMkxjsF1kkxQfJ1a4rCtB-RDWiHg&oe=69F49A59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
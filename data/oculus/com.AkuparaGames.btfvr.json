&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8hDAchopAEQ7kNvwFFRQEY&_nc_oc=Adou6bC0l6EyPOiCzyVQ8pmj1lEVpZC833rA74yWe3fflbDEijuMx10D9hmUVL4Lh28&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWd39UmLfR2lOIcX5F0fnanImgZk8-UHlNyiq4RhN6vA&oe=6A8EDD01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXfI5ifYBiMQ7kNvwE9ujJg&_nc_oc=Ado6SGGVhlCphGNYtZkdC1lYmwZE82f1kYgNMn8fmF6eoMLi0R-Ruo5Qg2GfGPmqooE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8kce0eUXI-XBpTctqRKUzPqjxj462wHCUPJWUr3d98w&oe=6A8ED056"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CKOcYnshoMQ7kNvwEck0n5&_nc_oc=AdpqmU_vigFyNFpIDruKYKUlExcrvZ3bRCRqSXWq70xqazrPZtQodlo5Ap8iLe3lico&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV8bun4cTWDqTwKb5LNmnzgD5fNXciwyzi4lDreKhVQA&oe=6A8EDDD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkyHDY5-TJIQ7kNvwGLXzBe&_nc_oc=AdqCmzfNf_4_gxWEcnGr_lTDeiLe0wVWAuQJI-O3h_rY1bxwmzzHGox2u1Qf5ykMOUw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHa0lRhFLAF1HpFRJuo0CbOib4M9vnvoI9aY2GJwJK_A&oe=6A8EF878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jMCKUGanIcQ7kNvwGhCMAN&_nc_oc=AdqTeCzBlCaA5gferv0vjBTT__66LpJGNJgB_EflXR3wLy-B7KYMuJGbhtBybKHukeo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcuGi0j8D5C6S8QWyewgZ2OMr_tyRQAAQF52oMS7h1eA&oe=6A8ED9D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_top
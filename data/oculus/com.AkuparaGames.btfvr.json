id=6e7a0a&_nc_ohc=-h8Pz7LG2IIQ7kNvwF4IgMF&_nc_oc=AdpmR5Uw7jlmi-0bpYoSMffZibzHR0icx2MeQ7c7L9hLPBBLpJysPp1eZnIKz9klzBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjtFXU9BbTLp96Ugm4gThbySJ01ABRmTyfV6jjV2PBgQ&oe=6A75D081"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRCSq64M7m4Q7kNvwFp7e2E&_nc_oc=AdpFmuJ12VxamIam3wCx_k3xMZpZGhv7ewHumPS0j9bCXEPhuv9168y_MaS8Zf5RoGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCkQGXAvTM20ejkABe7TIgoLKxMeB2Mf7Jd1ti6A2oUQ&oe=6A75C3D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59M9zg8DmuEQ7kNvwH7wvqx&_nc_oc=Adq9I4tgyh2c2aR6Snl68fDQAkLXVOANBP3N7116O3yWe0Z1ZRwYcZNMU9KoaLBsG7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_k3cemv5WDSh6vF3RY0CZg0DcNK00mTceFcDhNQNfeA&oe=6A75D158"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XcU36rFSpIQ7kNvwHorV19&_nc_oc=AdoUlfA17mcxTtll3Sa9by0Fnw7QCYFIww1JLeprXrhi4inV2cEwmxaeldlybGbki9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh4P1lXzfauA3J5kSNiki53u2xFVOqVwossZrP6MX5fA&oe=6A75EBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2rKdFantK8Q7kNvwHAfO9D&_nc_oc=AdrATSE4F-ipZPBp9qI5xQFVf0dWkb8VRZFJfUyMwTFXAOnAWRPRO2xq1MMUYEKb8PA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuG1TxwhbYwAzMABQRowVWrl_Iftm_Fx385xKhi3Mxhg&oe=6A75CD59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
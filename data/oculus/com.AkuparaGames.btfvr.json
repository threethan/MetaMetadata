cb=1-7&_nc_sid=6e7a0a&_nc_ohc=EORDGK268O4Q7kNvwGH3tO9&_nc_oc=AdoQkwhduVikpHWuknCRfu2MGgkXvsS1twsFy7je7AkjryXDcm18jyx2h_o1_oGPch0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bWDusJcU5oKKOptv_d9AXcEVZxaLR-3EUjI5er2QBMg&oe=6A119E81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcM8D2TR9uIQ7kNvwFhjxkG&_nc_oc=AdqUZ9he0xBLHKbrjj9GTd3QUBF-MkjK9O52W9Fe1nRVGbpBHADTpqy0XXm9tRqf6u8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TeCg2KlqwlJ4lXVIdwObi_Bp2hrVZTQwTO0h7ef8GUg&oe=6A11CA16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcecRkM4SxoQ7kNvwFQM4Dy&_nc_oc=AdpNbE2IYLLYedp7iiuptHY40aDJt6cyJtb6Z2LCFSUyiscFK7FvlG7XY_P6OyowNj4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I8v_q39gNyGwNGmvFL6XWT80jZSmUg3d0uU2OUn83XQ&oe=6A119F58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gyZBOzm230Q7kNvwF-AQD_&_nc_oc=Adp2DGv9GAEYTLgXGXj5VQCs6bTTivriEObTBuHWeaaqXEIl8mPp8iN4fzmzNBFtNRY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5awTUQbeUCKX5S2_vQaRym6WxuJ74g1ksn4qhHj3tzow&oe=6A11B9F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcgowtDOnTAQ7kNvwGMK-qM&_nc_oc=AdrPj2466sEise14SF--xoWPUNae0r9tWpMPmUNK2g5YhO3iKCnhRvNBFM391jWoh0c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YWl2sFogOh7DfH72SIdrKntA6lZZaGYsNar5Hu8O0ig&oe=6A119B59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
id=6e7a0a&_nc_ohc=w4UeaOvva9UQ7kNvwG3Nkvb&_nc_oc=AdolnUjTdBNfwayj7b-fQFNgxUpEfPn-xfP7dDPRTt2TmwZNGK9L-_haqTOv3JOMWow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRuKuhTkhkfCjKC4HNRwAP1HsP9752vO96Y6DbC3R4aw&oe=6AA7E981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U2FG_LXoSQQ7kNvwFZWnJE&_nc_oc=Ado4gyhzu2e_oEWFrnIuXVswjoD9RQEd5FImYdC3wOvbJ6-TXFwupkZmiX9mgb3k-Y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrVJ0wBqz7JN0eBNCTDuZdLIY7wsGg1vyqhAD8pSOalA&oe=6AA81516"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q98_holF8qMQ7kNvwEusXqR&_nc_oc=AdrncqTSxVv2fjKAvgrerNx7DJ-DC31101cr62O4sfWHDrZHttXlOSijTqRtNLHxfiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiUaPAWT7pQZtqrJkj2nA16x5eucKRzq7vBrDPK_i8SA&oe=6AA7EA58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3dWhh2VELcQ7kNvwFCR0jZ&_nc_oc=Adopv0TDmWD1S_xAHRcrxah0y590HQIgaxjmKwvCJ--RcEUY2ZN9TOALQo1g7I24s0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3Ef3u8VRXwUW40o70UjGGLaUYikBEFXhwZpo-J91NPw&oe=6AA804F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZpBx0DwE3IQ7kNvwFmerfq&_nc_oc=AdqhVW2X8pJyaPOU1_ahn4XBgRhGm3C-YVVVzgg30skjZyVOU8PHyRXG7mi7xe_-2Yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfLtFSP_8rXp2T1U7qg3liaBxw8Qvil5SsMuXGhb61kw&oe=6AA7E659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
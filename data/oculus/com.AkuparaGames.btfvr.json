id=6e7a0a&_nc_ohc=liXye9659KIQ7kNvwFsLzqN&_nc_oc=AdpXh02Gn_kcZytXIghQhvxc8FQFOSGID-MLjw-xeCZx6weDVnJThDkCMpoZoT493Z4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_HryXc9RySFOjaceZnCwI_7f6VDZe8OLq5ApNwM7mzw&oe=6A244BC1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9rgogAdLsMQ7kNvwEi1kyD&_nc_oc=AdoBgp41w61BLWN3444-hx8mmETi0x0x91UIlDGGmkfS4MVSLwg5gJvBNobJdSJp05Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90kZQSc1VomZhwPR4QG--NZUyUpfJpcObrbcb5LlNX8w&oe=6A243F16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0jZ3q_-QP8Q7kNvwF8l0Ia&_nc_oc=AdqgR5jMbb2E2f2Io_si6QSjwBuGFDM8r93ynyCqk3oC8v4nM3-HZQNAbHjIo7m_mmY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5AQfyKUS_BtFZ__pvSI1glsQoDwO0VMH50CfDoIBPSA&oe=6A244C98"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8bsSVsMWfQQ7kNvwGb7ERy&_nc_oc=AdrqY1feAWYUUqet8vTq-yMUXYu9n36Oxy_UCF8si3-XdvC-v9rEtNSaW_90ATBW7g0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vl48_vn2qvxkCKrjoWnPgbSWeJ2kKYJSj54EJEFVoVA&oe=6A242EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh583lBAh44Q7kNvwGk0xAf&_nc_oc=Ados6c9zim6veKX2aZ6Ni7hLa2eCZTEZ3Wywdm6fqqD56ET5XXBrwvDDL9n06f5_R2w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zauq7Ml7LcL7yD5KL1LO1vZYzWLG4HKGJhmqQUBkEjQ&oe=6A244899"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
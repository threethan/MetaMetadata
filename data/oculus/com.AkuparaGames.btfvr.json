id=6e7a0a&_nc_ohc=NmwyCE-tFQwQ7kNvwFHMz5x&_nc_oc=Adqbq78uTGDcRJeT1dM1fuA-cWM0RbpNXPWeCOCAK8f0zba95PIugvHcdwZyhiuUeNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52K_IDXVicl_rzToTyqUSDhCDIFVuwbwV4grM478-LOw&oe=6A183601"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeyncmhKZzcQ7kNvwG6Xmfm&_nc_oc=AdouuPM6Su803PFUEHIwEfv44Zm_kUKRYk8DzU7_LwoSkCPzyXrHjIBCVbnxOhnnGtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jm8Qh6hr9r2B6R1x72Yfzf5DklrIYB7WyLvQg1WiMeA&oe=6A186196"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqZRsRwHMWUQ7kNvwG_-d5E&_nc_oc=AdrUILh_bQCjEH72IlOuvaERRzgoCZM7iNfjEDRlYFikpuTlicDGf3XYJd33DlvW7uY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IXJb6Q1wcfrPhi1WICvFWvsmdjinPlGQjoqqyVAKK4w&oe=6A1836D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPEZYNwtIRAQ7kNvwHtpGDx&_nc_oc=AdooLF7Aph40l9qkFU-x4cws4iiMSZyZve1FFsYiQ9PSrDlxDX7NC65XhwYCghaViTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xSU6D3b9SS8en6q-MjNxNPKZ1d8RsWajoKADggZba6Q&oe=6A185178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXCCmlS6oeIQ7kNvwEgx7v3&_nc_oc=AdpWoKckSvSA-KsoQa5_4zNbZ8KBEoMeWoKotgnDMKxI5BLsHa6HBWnVfvB0qnAfISA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UOnAGw2irxdMj2RLH1GO0tggWjBcP0l6TINeS-yVOSA&oe=6A1832D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
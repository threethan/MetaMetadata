id=6e7a0a&_nc_ohc=28ukOV7aX6MQ7kNvwGAs9KW&_nc_oc=AdpmoOIHEh0oHqXwIZKNvZCB47dUeCuvz_ZxL5DsKIXi8okHo5kAS4AMlzqcWmRtNPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPOi94vUwTt828sBCfJ_ZGARHgNvujS5p0EXTiBC-4lg&oe=6A708A81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTHIP6N_hkQQ7kNvwGsxOw1&_nc_oc=AdrAAxr2pZgyVr4BVdGl455xgTWN-7YVrvGbAc62VQXGH4-sX442lq4hc152AbaHqi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDEcs1r4pbmnERcvgbtxYedkzvPX7fiwfHbG_JhNrR7Q&oe=6A707DD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejRUfiOA2GQQ7kNvwEGprva&_nc_oc=Adrmm810AQC_m3ofnQMXBfmTuocqLZcpD1oOS9sjs2xQahy0SNnwqfO0AVIBlfkBWMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgCwA2rlKqJOp4q-_10QKROicD9m_yCVK34OlaxDaQIw&oe=6A708B58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aVtjH4xnmsQ7kNvwEDL4_q&_nc_oc=AdpHwD0OkEC7B7eY5QC1vRAiPE7p3B-24--3QCplc3uVyr2iysmom7n3Lmzyy6WEtBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERgSWhIWLyKHuxPXMr_ZUedd54xItjkcRzuFW6aA8Sqg&oe=6A70A5F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns4BoSCXWQwQ7kNvwHdM0qf&_nc_oc=AdqpvJ0zytt-e0y_5PHccSkLswNB758-RT0d-lhNCoEty8qjjR0HYBvegRTwltX0blE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl61UA5dQCjCGriij8m6eUnTD6lcTqu4vuihHyKMd-aw&oe=6A708759"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
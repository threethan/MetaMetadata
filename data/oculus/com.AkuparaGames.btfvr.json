id=6e7a0a&_nc_ohc=qtXYO00FXrcQ7kNvwHcnryw&_nc_oc=AdpUaH6DZ-KbELC8fHmhkDYeZvSvrCVgtpzvXMAW1Xfhn0RFWhb1D8ciL7KDgjF0suE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKcPQ1oSfiRFFgj26qkWnmeAFErDQZNLrBuyO6hq0P0g&oe=6A6B4481"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffx3_Y1e334Q7kNvwEMc2HV&_nc_oc=AdrZdtuTk0Sheng4ebFC5qGX2SQcfFNygXUxXlHs_6WXHRAIHN0BE6gojVC60zqgbLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa6rVsmuypwN90dMYIHl89JlCKZOhBNKNWa7mnxQ5dhA&oe=6A6B37D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6gXqmIIpTcQ7kNvwGo6C9u&_nc_oc=AdrtD0ILPee_e67t_SxEiuxSWFVgWacpPW6MHiLrojdCiTQbG1w9O7QUpVX2ztVZRcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLzPlAb68QqSgSoTd5ZVZ9z719Ik_dAu3_hNyqxEWdgw&oe=6A6B4558"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbexTd83538Q7kNvwGHr4fs&_nc_oc=Adofr-HP8-KwG8Un4SFn89ZHqhK7V_Ux04JrQVYzwgnz0nyHKZcGpP5OipZ8JIfbG9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9RXWXKvKqOqGA4bFm8ilzpm0ZK1FRAhyuipr3TNdZSw&oe=6A6B5FF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCfe4bo7n7wQ7kNvwHF2R3a&_nc_oc=AdqsU3_wbbmuxY_yMPvEJ59QeiO9LSqNxmUBe1cKv8HkKVkeZobXacHv5oSuCT3WMkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASRlil_wOZTVxsJuRh6Nab7nXEd0b7CcpTw2UJ5FIShw&oe=6A6B4159"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
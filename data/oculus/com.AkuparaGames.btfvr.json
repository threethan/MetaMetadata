id=6e7a0a&_nc_ohc=vQutrTzTNXQQ7kNvwEd5kev&_nc_oc=Ado1cjuswGs8fVyoZmPUK8g8MGOtAQWe52WBK3g7i2spAjedpnZ8nuwWxaF-CvNwepI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HUmKkRTsy0JxKOFd6jGv6Ej2wF9ha9Dg4wW_T8IyZCA&oe=6A0C5881"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laP2l1vzADsQ7kNvwEO-Ohq&_nc_oc=Adrnf3xUF41ZmIr2mdjA4buXWqXtPOFdmahxrFtJYNIb6n-SpNSA7OveUInvW_b5hPk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48dyHoCWc7XldfB_WRTs2EuIK-ZxV9NPucmSLuo6hykQ&oe=6A0C8416"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTJG_ixj4OMQ7kNvwHBbG6j&_nc_oc=AdoC_1cYtrHKUJTk26lMiFyFF77YUSzQqWwZ1m3dL44oue18yTWNdJEnNUbNen_Vuko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69C0bqQxPCxp5DA_r9MmHwG0aKGhrwrXar625YtG_QFA&oe=6A0C5958"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pf5LD5X4JUQ7kNvwHkXimS&_nc_oc=AdrZm4md83xF7z8iKHKkWb2xd25l5ukAeHqEtalnCDphlGcfvgFOoS8XnFTQRgMjtv0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4APNd6MBrmSzKhPIbrqwVClqyO2VO7zfg-86snPgA5fQ&oe=6A0C73F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q7KrByMwIgQ7kNvwGgF1qC&_nc_oc=AdqnBSahWWydXdUq5woEkCbx9U5mdD5GzxvplNBoGuFxL7o3VMP4ftCVO4Vu5AJmK_s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kQACjfPIGRLQ0f1htCULXBM8H_iWTTQiUYXscNo2SQw&oe=6A0C5559"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=fS1cW7iUtLsQ7kNvwEHAoS9&_nc_oc=AdpzTnOhChPhUq5sX_C2ifhHozcl4wTsOskBmkU953Nt2L6w0q3t5VgEVtf2EWR4GgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYVG0PYsxSyUgthd8uhgADl8nz5QGx05wZl632wvCzag&oe=69C91C01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZhbykfnxugQ7kNvwFGa9zi&_nc_oc=AdrrxQCYGJl-SAnQnVe7rLIr3GjVDFcwUQvMCP0AI1i1__NleycbqfKa-uqdxhkcU0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVv4Z6st_W-12NzV-JtV4_H_gl6oBvz47Cjoo19JPX2A&oe=69C90F56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRcLtk2nsNwQ7kNvwHPVxLB&_nc_oc=AdqRarvn9bYn3nE-bjE501CiDBorgkvRk5SylhW4UtKkXwv5GSvqu1S89uJ634ysN0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJBLxJcsYi3pHUZ0CKq7be3wEmwKrpua1zhE0kUNCEhQ&oe=69C91CD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcGpWeR14bMQ7kNvwHB8twv&_nc_oc=AdoUSQIOlLn1D8WMdxckzMZaA8HaoFscNjXj7N5E4GVLEEeOzl2KmyMfrTLKyhMOg8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywzggYjPp1s1m-7lQet99pcbKnRR8H-qgxi9Q81tOrXg&oe=69C93778"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7oa3pm1CsgQ7kNvwGdshq5&_nc_oc=AdoDaI-2NLIhWIM0f-u9FmOSXbFVmSK2dvCFaoh9E03anucYASOA3ZN5SBFk70MnaGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBGRk4I9nf9ig_FAHbbE72_2gIXBTL0-erLvdXTI0Yow&oe=69C918D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=-b-xJ98qdY0Q7kNvwEP0R6R&_nc_oc=AdoOeUBPKuE1_Cj4a2LUuHJHfNFs_96SldvBApdv4FssHhqDuxpYKqg8mNK8AJUGQjY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WQX-mqAus-i6TzOdIiGPrpNWDsNRxPm5-9fUbzE-VBQ&oe=69EF5781"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0kwPcf5nEYQ7kNvwEqOctF&_nc_oc=Adrt5cDfM-mG_dAhbE80kQEI7IloeK-FIFr46NQpvtyHnCQIjI7KJjDs4-hSWZfrfaE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3a3C12PO3WDBktJ2lLxLXcr60uCbheZhg80Bh1TxFU3w&oe=69EF8316"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks-qpy-IkrcQ7kNvwGZZ1Kb&_nc_oc=Adp6I4c1VlP-SKTFuGVSPLD4QlUNdbfVnQzA8jfY4Jzgzg7zSLLMxLfke-Vs4FTX5l0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08dFblODKTg7rUYOQCTXlDxhHVAsyVouOg2BIgP-8ZOg&oe=69EF5858"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcEYOMq89oIQ7kNvwGLH5Bv&_nc_oc=AdqBd75QVohyYTCc963zu5GqpRwa5pUfe7tQowpBUQ0zK81zKU52LwNAaAMHS7H86uw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jeC6BkGU151Lack9ZTp-9z7Bbk07csGF96c0JNTEOFQ&oe=69EF72F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HD1hMUCkcgQ7kNvwEBiOTh&_nc_oc=AdqOIR76rksTv-krJKw1SWdcozfSYRZ4Bxl6tJcSixEoexVo0SPITDFgxClIx7RDCBo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31H4sGWWtqxavtryiRskJUJwPtUKCtPhTzfqjb-hbw3g&oe=69EF5459"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=UgAJprUGxy4Q7kNvwHULEhN&_nc_oc=Adq5npxR1AQ4E3kie1UESo7iBt3q-tAgjxyIoigtZhacT-MWrKzlSQCpGoo_x0Z-hVM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71HuW-HthG1WiSfPGEdG3Tv5V67PdUB7v0wBYd9RwXcw&oe=6A1C2A81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drzKB2JzhbkQ7kNvwGta1Vs&_nc_oc=AdrZmgpwwBg_hF9zB5y6E1oGWCJAcWArjqBnPr_T7Rl8kIQAtvcH2BZs20Fa7PUTERQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MA6vQN0cgA-7JrHAcjPGy6DVTgNIvgHZd_8PHwlY-iw&oe=6A1C5616"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vxzLruIWDYQ7kNvwHG2fon&_nc_oc=AdoV77GJ9Ogf0QjNnlqe37Pwg0IF_233HlAtJdmuMlN3fVmD_trK9f4Z19DMDGgVdj8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UO623xNQPiTtKAKifQB6rLQTS2iCNLji2BeUVLXsCGg&oe=6A1C2B58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y-bwO8fvLoQ7kNvwE7P91I&_nc_oc=AdqENhvcnBUrVAqQIT6Slq1McKsJU_Svm3M0zN4hkKmGmBWtJz-cw1TUcrxihmmK60I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oyVTUhyuzk1boBEtQEfw6I2ClhnWthvax8nA2Ce8gNg&oe=6A1C45F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOODjcmcjtgQ7kNvwE4I5Mr&_nc_oc=Adp5MnfaPqhhlWryv2cwLxjhOp-sJDegOSOr9e4gDm1wY8wSNMEj8pvtwXv_BXQAWw8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G9IMNiKzG98UE51HpcuQaQnYiNkZsaj9Wk3lE2nI61A&oe=6A1C2759"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
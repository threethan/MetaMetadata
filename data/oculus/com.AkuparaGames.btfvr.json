cb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpbMWaMETIoQ7kNvwEUFQ55&_nc_oc=Adq-YzH1vjfsScHt7GN3tsgY3uhr5wgUU511jkja4bcSpIGVGUmgvnaQoeNFSu_Hl3E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wqb91N_73ab-mtPPCZo0rvHgA5lzG2GnhPkuBkmanoQ&oe=6A36C0C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkvUx06CL4AQ7kNvwFHrbLK&_nc_oc=AdpWYWSwpy_zSwTKvbWAA0JiMAncAUAv9XMTqUVQo9y3Z4wUiibr6ZlvcgE9RDwSSNg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--i2WOgYDzrUsIi77V0A2U49voWQbuA-lYB_bZqomtsw&oe=6A36B416"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=480frY517p0Q7kNvwF6qWjj&_nc_oc=Adp73qAphiTProPcvoUTZXZVXvO-tYfqeCXRHKgnyNLUXkXPYL11nvIPj3fqvYbbOec&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EQ8VIkQ7AYWHJFAxua_5IEwLcEZ0lnyjVgxmgtFRJ2Q&oe=6A36C198"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slu4f5IU5mcQ7kNvwEHmulA&_nc_oc=Adqx6_o3CegtCuRQUBq1ThnfQkl3YOP77_ceMGqErS0_hZWSzsA4sh2cvGOrPlW40vs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FuuVNyFC2pNUuMAv6_1-hYPvXyomTZAJfNbFoys8PtA&oe=6A36A3F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1mIUIhtBJsQ7kNvwHQ8AR3&_nc_oc=AdrAn5ZX4IHBMbO-CgpQthhW1hCV9mZMaDCSq4I1AWD8WDdEnwEzvwf9u9W0KbVKUIg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t9YxE9iCDvwOJLfyrc-6nXuvDxaoWUtsXQe0_JazfYg&oe=6A36BD99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
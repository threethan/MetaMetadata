id=6e7a0a&_nc_ohc=q5yGgi-sWmQQ7kNvwFST3Ts&_nc_oc=Adpi8OQunlwU3JVzrpvrXpSNynwc2zh8WYKsTBOfC_rltwafyw8JBt0j8DXexo_jlaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdA0l0qG3AwSVV89wmU15hfrrbpKS_VN2c2v-rNS3eFQ&oe=6ACA68C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKzlYyzVLtYQ7kNvwH3P-wJ&_nc_oc=Adq6KiH82mN1sGWKGduFAyYNCIb5Y8eduafM2oba_v91FpGtOYkDRVffev324QQdZpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBjC6a84fM4ro0ysjx6nQbSruzqlc17vdGIWMIvumBTQ&oe=6ACA5C16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kmTyxT92IUQ7kNvwGJSH0s&_nc_oc=Adop7MS-RRo_ELRy16Dd3YcSoKY_uDT_Kt_JChogDQ9A26Ksi3TSMGTm2K15y8E5Zxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNon7e4znHpggrYup5y8wDrsEUFUGC19B7plnO2si9d2g&oe=6ACA6998"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q28pdGXWvmYQ7kNvwF5D5NJ&_nc_oc=AdrIDC9xtpbF_EeHJQttyQhy-x8dTJle9G4VRfJLRiiyjQ74_kzjBYRGFemS9C8RdH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy8FvlsmVQmLRF9AlYSVLf2fPKLyX5JK2IraoweB1stA&oe=6ACA4BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA41jrrzvUkQ7kNvwG5deLT&_nc_oc=AdrVglQuTyf2L6nIYlIHAxjOFZYaPF7H8ZN3r3PyyBbnEFUfkXx6Xg20gY9HgXQgX8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJMtqFFZr6vNzhEeFQ5yHvqJ5RIJE8zyp5L_fkdTOP5w&oe=6ACA6599"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
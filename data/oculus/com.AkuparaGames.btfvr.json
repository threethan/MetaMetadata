id=6e7a0a&_nc_ohc=82bq9623f_YQ7kNvwGqHJ20&_nc_oc=Adr9xTMV7SqT7E9uK2grXMG9uWbQeFkErZjcXZMrZ-HKWAL3CGYLgqZGW9P8AOAuJ1I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o0XEkVC7R6ipoNYEhhDiomlVg2SU1UgkuXXd3ODY8nA&oe=69F5EF01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XC34BxfZIYQ7kNvwHPUtPB&_nc_oc=AdqAQLE0Xz4Hl49hkk1O8foIpfOSVrPwRaulKPBgaLpoFMqKH8WgfVhd8wUUkRsIMls&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CghnpDUEopGjzmqk72421t_6qEA_YsR4_Xry78yK7oA&oe=69F61A96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE3I7iwqflMQ7kNvwGtnQwj&_nc_oc=Adr5PfXNLDwpS6w_oygSCSaDoOELlTeaKPjfTKcZB9ehc3V4LV3yUasO103iH-w0wBI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1biURzIN9w8mogaIWz-QwfkFb_ITYSS6YaH9OQ13pdkQ&oe=69F5EFD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5os9qeIH6IQ7kNvwFt8ulZ&_nc_oc=AdpaqnUqCp03Kc3IQeLAg09zaCXTDT948kPtl_yayUJC5ZRwGlSsIHXKdf5c_NM6_ag&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dk1kAE44hQz9s09ijGTRcPE0UGwXH3FwaUuc5tDuMhg&oe=69F60A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtSHhKfKVPMQ7kNvwFMzzZL&_nc_oc=Adqpo4yqyfyjc88g7lYUnSA3cM-sCHay_eUU1SRikGo3Mdh23qeVJ9cLsPOjcZixK7Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SbwI5BzETFKaPX2bZolOmlojFPRv3DyIKW3VNQcom1Q&oe=69F5EBD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
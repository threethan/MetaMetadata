id=6e7a0a&_nc_ohc=28ukOV7aX6MQ7kNvwFQgDa0&_nc_oc=Adr1Msvrr49vcUJZQ2umm5tziFUeK1jUB5BZX9ZiGgujjql0YznCB8PLg9inzQvErvA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFXNkCZoqsOF51kfeghmb873awxQP_WXo_yZwqlcUd6w&oe=6A6F3901"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTHIP6N_hkQQ7kNvwEbZVL8&_nc_oc=AdprpOysPkLnd00MiAlntrvAH5RoUOkNqTwYiPaMgePj-bqG020Kd6F_lAYc57Ric3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIk2iXPGxwSsJrc8KFLgRctX7sleIYhM4yNr1Wufu8jw&oe=6A6F2C56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejRUfiOA2GQQ7kNvwFCS04z&_nc_oc=Adptr8kJLxSn5vnNybkR7zgwBwK6jriGJp1-VL3YWeDc1FEa28-k-UHRppYhx8Hi_QE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSsRCJa7ZiDXXUQwzQalXiPJz7WleqfH9G6xfpJA535g&oe=6A6F39D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aVtjH4xnmsQ7kNvwFnFBcX&_nc_oc=AdqmRw4Zzai4XCwKscN3j9rmHYRoKAXT3daLJuJzoXW-Xzmo5JT6AQICNwyltPR-q7M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH0qxmvsSom0uEeCjZ-jZ5urgDoymKfGKpCWYw6YWj2Q&oe=6A6F5478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns4BoSCXWQwQ7kNvwG04frW&_nc_oc=AdpfgxoG5cYw8qmu_C59tC00XmUAjysl5Jj6PhTS5W_-Vk3oFZsNBygam-fKs4AOwLc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc_cuGqbhCEv99dX8hS5HIog0iQU1KfnoO1KP8Ejj2kg&oe=6A6F35D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
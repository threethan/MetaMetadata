id=6e7a0a&_nc_ohc=DZ8AstocQwkQ7kNvwHInq5m&_nc_oc=Adp5ddgg-D4eGn1RaqJR89B80JJFE5rEc99GL9-5vxEtZa1VTwssFX4MhegoKQ26C4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYHdj-67K93D6m_eBKbaAu3V3yZBijtu677TdNtOFvdA&oe=6A5F6701"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V00XNQtZeSsQ7kNvwGjijxX&_nc_oc=AdoqqpGhwu4LNOBB7vdMg82UUEYDczJ-kAuPABP7G5EuefLJwDIFmba1FdXO28XZlqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKjh4pw9ENf96RS2kdDSYZ4Zu8B87pxvSUIO8nc-TAkQ&oe=6A5F5A56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf01i3qdSQgQ7kNvwHLAcI1&_nc_oc=AdqPN0BS31cZZeBzMLAn1fiW6ORicJ5Hauorr-0XI0sDQyBtLgooWoyjhKjJQfe32Ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2LIz3KGUyhXdrrNCuutpUoZC08Hvu6HezcUtgwncmsQ&oe=6A5F67D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeZu38X2IPMQ7kNvwHmMVUY&_nc_oc=AdrBkhwIPzPC0ewq_iei-VnAmHjdWGutu5WOWORnweWsKtkNdb7C1QIv2hXe6KvJYOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGr6K_WzUtQv-XCsz_fJH6goN0RnzDU3TxBPAjNtsjPw&oe=6A5F8278"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buV7m5Ul0iwQ7kNvwFgMa7l&_nc_oc=Adp7QdEjcOpUOuiQNO73THuweZ8uM7PL0byz2nSp519zPQ85GsUviJKtlGNglGoOQgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv03h8AEGmCX4aBgKKA6OPaFT1F12Gxjl_DNuwqyO_Gw&oe=6A5F63D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
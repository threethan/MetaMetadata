id=6e7a0a&_nc_ohc=g1SaqJcjF_YQ7kNvwE5Fj35&_nc_oc=Adqv7erTwRfEY9rarhYzKO1yxXfCkP67ntCrxvU9CfoUY_h6xhz8nDqnRLXwMkQvlkw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_NwGPeC-llpwVd8I_xioatYQuQSKEsfNQSw8AC8JD2w&oe=6A426601"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjA9D_idWacQ7kNvwGnbQFz&_nc_oc=AdoIQvwKSUWhPu7gI72LWEEynMalx3h0nuk_kD6_kjN8VOX6tXAqzcSzDVhadrSqmUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G--TMF-_dT13riHqZY5HVYz-W6qwBX4dNhT8ekQfDmg&oe=6A429196"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo8FoLUuDEYQ7kNvwHaaFkt&_nc_oc=AdrIuL9qpn6mK3nNEFs8P4oPmnZ-vBfPQAa_fNWJOwiEd8wGxhgdOc9nTZNDXCwGHM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zPZEG9QzpZjc13GkIQ2F-Jb6_T7Uk6yA4DKPFJkPVYw&oe=6A4266D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S5_vZKyEfkQ7kNvwE7rhDZ&_nc_oc=AdoyO0_RHu-fOWUGTp3Zy60qyV6hNyXuGK_hhWNj87GdmdRvPaooT63t4RwfI51hjww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ahtJYaXaVH6EMYLJ2Br9Db6zVsHkWrKbE1upYM2fO0Q&oe=6A428178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaZI2lntycIQ7kNvwEFLs_4&_nc_oc=AdrxRR6yIdiagx2NWCSbvoJ0TDtklUa73rRhA6YYvW5y6VWg3SYV81UzQfE9mEvyvNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W-6RpM19Rc4CwSZl07WpAgVV80gnyGbKlq-mgHDY6kw&oe=6A4262D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
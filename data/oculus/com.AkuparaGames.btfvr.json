id=6e7a0a&_nc_ohc=FNPmb1RYAgEQ7kNvwEvHlW7&_nc_oc=AdorbeBB9h7-rKFzahIhD6B9Kd_bTgg7wzldgfOqRpoY2cIvr5OyLgdJCytvKD-HCOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O6mL3nUhF39klPDBLuhZT08lZYPPpxLShuMHMViFy3A&oe=6A329401"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKnwTnrvtmsQ7kNvwGce8bt&_nc_oc=AdojAUHQhWrocDIQarNoztMHx9Umzo9fm4xkrV-w438e68_OxavwHkEuQ9FWCJ-R3fU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KmTY90OIelYeMI0D5t8YyBWVSHPOBf7678ZosyNkrlw&oe=6A32BF96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6KqlzRJASYQ7kNvwFHY6EJ&_nc_oc=AdoZS747ix9T_SYK6aO0kDn41_bQjIPNfIhCFGEGPXFm_PDse2vbPDUD6SGEL_Q_1xQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IfoZwvnUAPR5JKtRxdALscclG_NDEbi0JTbUf06211Q&oe=6A3294D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRguV-zsb8wQ7kNvwGEO9tV&_nc_oc=AdqAup8VQJ2QByPq-_1BLm-pquqARnnlQ2txjJNGUi0LmGDo_--l_2N0MnaVzt7Xr24&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sB7pG7PBIuu9EDIEMKnR24hArSefSIyClU16mgxJWRg&oe=6A32AF78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79oUXZGHoMYQ7kNvwEVg-yA&_nc_oc=AdoaUT0Koy1ym7lnhqi5EebYnbVXLzrcRBdCGjAo1OKv4UJNtFXUaqWfNz4effsvUf4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_onfumIT6-txFDsLf-Npj2DXR96KtWxNP2xd6QFRSbWg&oe=6A32C919"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=a5YHxuQ1jDAQ7kNvwHlXCSE&_nc_oc=AdoWJ5yVBpzjsyxM2DRm1EEbWHlAkWZSuckkbvq0SgotRIIqX1xsgMl25r0gdRUB5oc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--ZWCJpoelmZAG8SurcsC1ctGPRF20JbXN1svK0XkXtQ&oe=6A2C34C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnqMzVnoI9wQ7kNvwHSrU4D&_nc_oc=AdqmokAiAviTf7oCpSqcTF7LgBp1qVpj3ePQVJtz-AlTFauawJmv6IlY8LNntPa6Ccw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a9B4Yw38VY4WlpVbUhwP6OTAMC_1N9SnkGUklajC8Hw&oe=6A2C2816"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ysZt_ztEc0Q7kNvwHLamlf&_nc_oc=AdoAB8JxDjzZDgshsnCIN1tnj44w4SQtql9laBgD9SGiml0Ryw1SIjv1TYrosC55JEI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RKd8hhvgs_3r5gG0_zmUQ3blJfegx4ktU2f6L5gnmIw&oe=6A2C3598"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2W_1JsKr1EQ7kNvwFWRKWp&_nc_oc=AdofsWvNOgoNrxcIxpLIySD-PFGmNGzfhZmeveeXgO3LVrZxjH8iMIRUW5y2sGbNQjs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M4l84sSyf-6tij53QL66otgyuWMBckqWLZ5T83OkY8g&oe=6A2C17F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jcdsMtkrU0Q7kNvwHvLV__&_nc_oc=Adpp8mtv_acy1uMQfekbftr3IAtMDXlhXQjxCXPE_8iVT7LGgXci4XThX7Xt0mMlFuA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dEXJ_FO8haYaa3nZ-6vraMNfhV2ng_dHDJH_F065vSQ&oe=6A2C3199"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
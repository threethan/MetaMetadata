id=6e7a0a&_nc_ohc=uurwqClxdAkQ7kNvwFWBn-e&_nc_oc=Adoo5XPGIVyHknCfuXlrQvY4w9PDBJhca4Gep5Cl8W9qfp3150bcQYkjo8g6mA_WFeg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHwx3HjKaya60ZH04pw3RSWfPLOoDnBFq1SJcu6zNmKg&oe=6AEB5E41"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy11GXEzciIQ7kNvwEyPRNh&_nc_oc=AdpQkwIdNmuahAc4Eve_MEZYiHV0__Wr4K-si10Z9kPY--ITpl15Mb7Hg_hBybEiw60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKnvWLQBnQ5si45mgkQMSWzWolZyS7EhlKkMCXuQdH-w&oe=6AEB5196"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lo-kO3VDB2MQ7kNvwEWAk1d&_nc_oc=AdrHTFWL62wb3x_8Lpl5wlTMO-tQ4hfGgWZpwwFSxHfmDxY6CUaCcQAhm8-mOB0pj-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg4OQ4MAVVRlUHGp9AL1wIaGfLg0U8TfXNQJms5l6O2g&oe=6AEB5F18"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z98vi6WlrpsQ7kNvwFu4iz0&_nc_oc=AdpDzib-oHD3tJQ24hFx_qJliKW7GHbecIkPD3I47GO1XrP4QTrrzNc2sdIG3v1Aacc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCSYRLI5Xgrgs3oeGyQpgtbKbZAPjmC2oqqhjNwqT1Ag&oe=6AEB4178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soxFj7u6rg4Q7kNvwEpyrC0&_nc_oc=AdrS7iTAaVhf4Ipz4hm8UZUnZj_TbdcHm75JKcakmEBMLzHOwiaCOKIjU1qBQLxGBas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8cGMoZqrLYeouBoIeXLJSvLIcpwFinjjpvtX_SNMv1Q&oe=6AEB5B19"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=e3XCAXcYRRoQ7kNvwHZRGPQ&_nc_oc=AdqO-Hwm_JnidNoQ7FLvelst8BWNZiKh1I0WWn9hZ8hNFW4FiMk2W98sBl5NtruurLw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYMj7quo8cEFP8lU-S7q43dF_8LIY0b1oNlfV-GItKCg&oe=69C3D601"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L24oHMYqzsQ7kNvwHnPL7c&_nc_oc=Adon7bS8ap4IMs63A4econIjAPx6PCqXBCbXqusopF7LYVJoeicm0qEwtEAH_-yO1jQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIla93mcO-qilHOI7_f3CS5COH2WbgBWxSAuXqIK2d4Q&oe=69C3C956"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDkWkPPECjUQ7kNvwFaVToo&_nc_oc=AdqpT3FlTTFWiiWfhy9q_tP-IpFMq96hRd9Gi5YGKC70To4njoLP5YgUTJtewLKz8zM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHOnVD2N0VxA7lTdf46fJeSTiXiTKdAvHewYxBXJKITQ&oe=69C3D6D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92wktgmCYBkQ7kNvwHgWoJo&_nc_oc=AdpPsXMtYlFa6Be0ofTIh2pv3pKTLtNb0FsGpCAfkFa2EAtTdUrCQs6k2VlN_Dkm6IA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoKQg1SLQkrk7KIyCTd6VfssK2IRR4y44LPsKHF7fOpg&oe=69C3B938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r2_N9zVk7QQ7kNvwHD0uK_&_nc_oc=AdoTNDvS86htcxTGoVYAArot-sYv5dUNM1xUGW0yAs7V0klQOkSu07kP2Xvb43vIFWU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwURFgrdyloHkzwxOz90L4BX2vHidoWvq40drTeCI9i-g&oe=69C3D2D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
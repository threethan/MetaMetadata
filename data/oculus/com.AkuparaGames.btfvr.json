id=6e7a0a&_nc_ohc=RjzKOGo0TbAQ7kNvwHWoJDr&_nc_oc=AdqVQAwQiOET0sRXvLn6WkNuowAwHdBCqL5nSn5cFfbnnZTYmQNISU_dOOtDUCKtTmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1autDKPaoKHPnmI1YtG2ZwVv15n0k81mTVjfyoonxk8w&oe=69D64B01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq8t6OupYjMQ7kNvwEn7HQn&_nc_oc=AdqH-9ijlGbJM_pdoccAMMQt5M6ZdNNOJprRz8oDNbQFbGA4xG_X5g-zoPQ-8iPVG7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TgIVHIofE6u9cAedUeNQt7hDYzL9V5Pp-yT-aXpuR2g&oe=69D63E56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWmox3nrTykQ7kNvwG_4el2&_nc_oc=Adovcq2B20naqkRArKUKEG_NzxiKBJ9g2gJkR2HroXGHsJWFVQ06f0dk3hwNjRF7tEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dZiP1NefrMaVf0jkJx9TzrsPX8XMtm7VlZRHepYF_hA&oe=69D64BD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FGdTzncxgYQ7kNvwEPJ8dT&_nc_oc=AdpzZn1eCOo4mu_dEjqb9fs8IPhh5BneZtE2C44dPLKmn-g8pg528fged0BqizuUE5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ProofJYxPuG7a5SnOH_3jE5RahRltgNtgCcvcPGzclQ&oe=69D66678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad3lyVHmnu0Q7kNvwELUpiN&_nc_oc=AdrUWXg_ZqEw-sT2Dl-dmjuqLkjt7mhSmIPM4YjNiHvRl4W0pDJcjPGRIGVAhajyjvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kASt4luhLwepJNslm1gv1uurx2jvujADFH_zfojvfMQ&oe=69D647D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
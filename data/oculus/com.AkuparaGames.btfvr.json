id=6e7a0a&_nc_ohc=GVZbUIm-HjIQ7kNvwEqugY6&_nc_oc=Ado-0g8nh0ArgdhesQsCkaQMQJr108HM5OzvyjmDc8gVNB3Wn2z2qrxMWsWCR_RRK_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv20-z4Cmw9cruhOBANrGEV7PPI49ynKyguNj0eagdHg&oe=6AE5E001"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfgB1_dwsGYQ7kNvwFKUvCc&_nc_oc=AdrTMGLPXoflAfJq7aLJLKe-HqqqhinNjoxogMjYR8N7A9zspndT30Y1QK7Tca-0iqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRPzK9NXxPxyJZZ1he9-b2iamsT3lby1xa8WeqbJ2FAw&oe=6AE60B96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uc-R5eWc3sQ7kNvwGg8WJS&_nc_oc=AdowPryj6lsUfpJ5Mcg-pKJbUgYNV4h3aZ09oTnU3KBuFrommxS292RBsr40Z5nKF9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVztooNnmWAeQh3Q6k7VXjTryRcT3vyW7B2uI7EY_b0A&oe=6AE5E0D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAWH4ARzWb0Q7kNvwGWsLFW&_nc_oc=Adp-3ycVRua3H9y81hJKngRILlBy8Gq7UIrT2A4B6B1TDM_kH1ntGuDrloXUSmK1xD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrFZgVrkuwd_GCO_RvWBsCuGLuzQiHiBXtOpcWSlz-ww&oe=6AE5FB78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho7QMu_Iy64Q7kNvwHXJuMW&_nc_oc=Adruz10rLK8_1eWvKfxCU955ns9gMEBVtjnXS04IIK7C2fN1hlSLF5sAygtmQwYM72A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWnvelCbBDaOn_dip4fzzRC83_3Lk5QjhVsqkcQAU-AQ&oe=6AE61519"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=DFDtvhRvYikQ7kNvwESRxU0&_nc_oc=AdqQfom_BmhgwmrnS2BpRon0ENaSBcVdpAHVSnJZX7mBeAz8OJKxMcOjBfpNStOisJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QX2OCVFfzsW1VyrcCtaxkXqCjY4jfRHmCWIlQcCvf2g&oe=6A2E9F81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWibbgxhLdMQ7kNvwFBaaY5&_nc_oc=AdoKGci05zuoR7rPfEa4HDYv6uu9ADe-Rpt0h6qR1kQCT0jCEJ23vVH0EhtoZAVtKME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r9GYuxY2sNlaRGKSpTKROEKoTIEyMG6IXqIsIpm8uEA&oe=6A2ECB16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaD5lnaz5Q4Q7kNvwHXBzah&_nc_oc=AdrVyHFw3Uj3LEdpaGiWrI7UyE5gtbD382qlfH3Gxq2gZUuhmoAvx-TmRRb1IPLKv8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oGRw0Njewf-TXWWGSO9X61IY2jJGBMqmV3HgmsJ1wPw&oe=6A2EA058"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFLNtXvgpvsQ7kNvwEWRiSn&_nc_oc=AdpgecvNM0aVP7SfWvlikQv2X0Q9Ip7CVi3Ka21B5wZboPkysXXdJ2Qz7CYFZzM0u64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y5kmNmE7jvdfqZqQv_-SWMcukv_TmCAUYuBICMZv2Xw&oe=6A2EBAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jcdsMtkrU0Q7kNvwFSCI7O&_nc_oc=AdqczkEln0d2KaIG2NpHBu445vXMndQtkqhZwsBBrvcHoLX_ojygNV9g9GNX0AMNQ2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FVWAvcjZpPciLbb7xpLDoX7Y0SopGMBWFK_muFlIs7g&oe=6A2E9C59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
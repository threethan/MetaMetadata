id=6e7a0a&_nc_ohc=HBQAmlowoFMQ7kNvwGgoHX5&_nc_oc=AdptyWFnejCNy5Z-p-lhpVHQlfwGVMxmQrmMD74e8I3jq5Eobgc-hcUloXv2Ke4tMAM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiEaUxemREhrJNnPGxMFqV-kX9otvcZSayfyq_jGI1tQ&oe=6AC3D141"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WxDZrQBoBkQ7kNvwH0eA4l&_nc_oc=AdpuGt7kaPYwcqQWv5VYutVBzDzX0fztWueYu_NrW1EKh8fXWViFM2akXlBR1KmtFEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK6tuSBCmqPCE-HM-6Epg4o-fshTOgqn4yhU9Glz2sAA&oe=6AC3C496"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq9Z2FNtIxoQ7kNvwG3kqIw&_nc_oc=AdoBVq8DaYUV83XzuTM8Am1AE2ZvK19qXZSFIIEzfCOGRYH_ZTKVXOIDDTL39-h4CZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHEPC2Jl7qMLg5XBvNN48eKtCBgFvIq5iAL2UyxqVVUg&oe=6AC3D218"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE7M3_6FCGYQ7kNvwEXVHW9&_nc_oc=Ado9fqg_WnF4kqAaTX1VPGZikClh8dMVgo5l565wbN65c3W4HEjPE2QU95QCjMbILY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOepRZOfTdLY4lGs-WjBM8rTsGl9P38g83IU0z9DSqlYw&oe=6AC3B478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPKYvecJATkQ7kNvwHWbT_j&_nc_oc=Adps5I_AvfNJ_1I2rUB32thttzaeF3CwUVqtoB78zNNY_N7sLUGo3flUbovJfRvfW4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrbVwtejnK6LynnoGQGot2UStiToKWU1DfpbixW8VouQ&oe=6AC3CE19"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
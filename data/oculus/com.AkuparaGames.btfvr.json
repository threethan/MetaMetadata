id=6e7a0a&_nc_ohc=1YjRtj8xMikQ7kNvwFyeQMx&_nc_oc=Adqyv_qxKAD5YGu8YetOuoO_dl_yH9hfgD38DnqcY96glpKsnYIHAa7QHxZ8Bln_T_Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3n31duMUm7KcSeneHMurPDXaLKWMpOr4a7ZvgI8YxgQ&oe=6A65FE81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuQg4-YxBe8Q7kNvwEmQMpU&_nc_oc=AdqxSlDxCNkoPxfLPWJm0G76F2pM7kQN9ujCtVQQ6RKCMwCLbEQQOTHHXHgPFzM9-sA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpF1HBtUi3sKQLcUuqtoOw_f8FFkhXVltaM3pFsvOziA&oe=6A65F1D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wox-FoUZx24Q7kNvwHUuGqf&_nc_oc=Adq7-IGwPZsSkB1rNFRvzswm6YI7mm9fnoQ7MVdPzibIvGxvtwrVkr1R1CkscpvmduA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn7sBEABMibBIZBYsg5tT44nk42l2Q1WStFo_GlQamdw&oe=6A65FF58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5s3RzefYt0Q7kNvwG2YybM&_nc_oc=AdpVL312MxDWr2Wc-DannyIcU5vOG2DvAlzd6FVJkgZeA8AtEVzDH967bKchNOcdORI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkrk96qhb9tfoGgWm4VPEG-BVnYlOL2qbY5NNt_x98-g&oe=6A6619F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0b1bCkAfxgQ7kNvwGcKLGA&_nc_oc=AdqAHr_wkBetevZ6xggRqob7kjEPfKbLPd-xhrjQQM6rYD5xUtPMcGwFNSw3HLyCb9I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEqeKoSQjviBvYW4i92Zsw_Iek--xwvdiZs08Ghw8DVA&oe=6A65FB59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
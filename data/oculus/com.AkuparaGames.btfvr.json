id=6e7a0a&_nc_ohc=oxX3huAy7uEQ7kNvwEEnMhz&_nc_oc=AdrsOwo_lXriDUN5zB1ySxgBMJAHiNigpZ6FXsODuKsAK2mM4GyF5jZrLx_0KrmEpkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2SPeQfpgt4ONG6GBZjua0v7rWmVFGTC_pMvApd0HG6g&oe=6AE1EB81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1dIa2MQypsQ7kNvwFxPIH7&_nc_oc=AdpsqiIAPTFsJdnHoNxovpt4zjYIj8U5Hz8FioJ6ZbXkM3L09Brvbd5JD6KSCGRmyJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLPkYk_aw8WeSL_nhi5j5u4p_a-6780yUPEI2jZs5owQ&oe=6AE21716"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aZqKgNyt0kQ7kNvwG14woW&_nc_oc=AdrVpaKaZAPUid6xAp0Q3kto5KUfYDyJv99mTv8MySrclYu-T_JNewT2vKL4R_WPmYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhdhshuOHrPDrMDw_4hIyNARVp9ZtEV9I4NXbiC9sbmQ&oe=6AE1EC58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaJNwhywil8Q7kNvwFDQziJ&_nc_oc=AdrPSGnIl1E3SSFWETkMAVoN3IVk8mgtPR6CHR83Wwl2eoFb-_qUDRugMUsHd8_q2v0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhCh22WTen2DtW6koxTqY5CpZ7oxz2fxEJtQpkuRSYbA&oe=6AE206F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPvyisQn1wEQ7kNvwH2ME_h&_nc_oc=AdpO8PjeUcg9zIeeR-f6HIBJroFCBkrAatyKABK2qo6Fgb-8wXnR1wjihrnxlfXIbJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNfV2j0FBOXuQGos7aDFB-zGZeZPgwCdBYkh8dI2XaPQ&oe=6AE1E859"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
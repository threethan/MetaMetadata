id=6e7a0a&_nc_ohc=8coW2Ph9FGgQ7kNvwGJHQus&_nc_oc=Adp9J37WBzqRRpO43NKSGSGcDsjf7-8_R6EnnwI-6kvbc7yWbpB2aG3gGoorq6D4xCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6em0U4XI9VhIu_wXpwlCLpNv3Bf_gLMYl8gsDA4HRwog&oe=6A046F81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3rkpuZBIq4Q7kNvwFcU4pP&_nc_oc=AdoJeDdJDr4usn89QL5-Mq3xLaJgmY3fWeNOHHL0VnKep3RwYZ5mTJAb6BHn-AJK1z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wrajDQT4gdqEPlhRHVf6IrxT6lP_msegYJCX68EMmbA&oe=6A049B16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTp75GAHVXcQ7kNvwFQcsFO&_nc_oc=AdpOpVIgDck8eLfF9TF9ZdHwkpOGllYIW8iemPK0YfyRl-DGoaj5xD5bPkB_9xZckwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H-NOUpqUlJv8QO3CdHt2_1Tk4leWdS31oQ_ZTrc0EfQ&oe=6A047058"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VKYNfNF9GsQ7kNvwFpFCbt&_nc_oc=AdrDpYZ3iRgdSyKzTgqYbZLVVJDUw-Vr1NBI_sUXxC5U6Hcbwq67sI3iVMWjiII4t-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K2HhiOnkncZ9ew97QewuiU5rnieqh78SwMs4hBzifYg&oe=6A048AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhgME0TXp-4Q7kNvwG7s-RG&_nc_oc=AdotmHqJFj8I-CSL9o7SiWfRv7KhSfvOndhAIYMyqF-kHq4fupNwDvvlh_sMWgn_pAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wsHzacUgD0Ynd3fbK7BcBlMZKfBJ5pJoU_pPnQYZwgQ&oe=6A046C59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=2asPcz6BjOUQ7kNvwG0qoEv&_nc_oc=AdogVAx2Cljm4fPF-UR3Qytc_SzjkySHXtZPUO4CoWe3ZCnwZosu_CQ4E4qO_gvnMNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72q0fAhpvBblDbU8x_pzKtNv4f7poxB1YsqKYupClQmg&oe=6A12F001"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MySrtQDg_9cQ7kNvwFN5y5q&_nc_oc=AdrIATaz8akU4-79VJIUtkDwqfWweiHxoV0fLr_UTfbJpu2ttStY1nU8eNBShO-EnGU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6euqmn10e99Z7RTwsU5U0iqkDwhsWnosB5kvxZ3eVQ6A&oe=6A131B96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVgHsg9mfPsQ7kNvwEnCOJk&_nc_oc=AdrD6xeUEWO_TkblQMb3qMTZLN34-VB3DEoNvuuzNrd4TjbrXv3Xn5oXFDyJ5_bwmc0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5thUSPWqMdzBtaILfS6XaO5e7lpsE_MsFqut4cqxSIXg&oe=6A12F0D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WRy9TFpMAgQ7kNvwEkDrHg&_nc_oc=AdoW_qxnzDnSbVkily2gMcgvhk2lEsWZsm2_7f57S9U-I47sk1FJ3y9zSVN9UE2-8jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PKGOOOOo0cIetjhJSJhnZ4_R-_Q0vJecdZRHv_-V1CQ&oe=6A130B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcgowtDOnTAQ7kNvwF4pQby&_nc_oc=AdoWNI6Aeet04qBeCPUptZ4exN-pSUFWByuGR2tFYuKSA1SJjG5fIXFglD23XE2qwGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uYLLlC4InhaG2OlSzmnNaZQGpmD39F6YJ4umWvoeGgg&oe=6A12ECD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=wS-kMYHof8cQ7kNvwFwxL7G&_nc_oc=Ado_ObgkO35ElaLXNs-cmic6yV286CQ2ITg2gU6UvgpIRtBaZ_2REsRn2jU7rCUeKxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iCxio8vGWIcG58Qq-DyFvQJsNhDwYrKeAAXnVJcz5VA&oe=6A086401"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5cUBy82DmsQ7kNvwFhBKbL&_nc_oc=AdotETjnQarWOZak8DzAbhztKOjup6izO7F7JBmWiTHAkmWGqtvbuyOjCnpiMpkAAqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qnrOkgJD9zQbshv2ys1UHrl-IqToCbrCI73M-h524pQ&oe=6A088F96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8QIW2HiqOIQ7kNvwHBr23v&_nc_oc=AdoZd2-39wXKR3_XKtJp7C0Fv208RPFzyoYNuxP1XQqEpHs9j5scFXfzhj6l4MQmSFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78F4Xt9l09oSww_6dpsZdLijp9C-hRTD-UIqxDQ777MA&oe=6A0864D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez8gBSZJVTQQ7kNvwEI2zhy&_nc_oc=AdqF73bC2KuVoVhGmLZ_-jYDYf0TxpM7rSehQ-_hDZWF1HYjHzEZ8DbYVz7XwTwSTDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uwgow2BVo6ovmldfQtuwJnXdKl5u-I2X_c5UnCaqxjw&oe=6A087F78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHTBFQo27ocQ7kNvwGnAERX&_nc_oc=AdokjCRuXlNzGHgALG-Ub1z3LNZhbMejn3Hfb1EFqWNKl07HxWVmhetWsperyyeximM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G4izpsyfYwb2caB_EnUOhKg9PXkaXINTaRRV5nCmDPQ&oe=6A0860D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=xOA3MDviGXIQ7kNvwG6whGy&_nc_oc=AdriwzrkQ3suuJSTkLxlkwua4sxXrW5XfP9XsFAyo8joH7gqnHDV_d6KbtZkhtyDbsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO0HhpYJZQFtnrXzxSsM0cfzLvE-E_jiA2K8o3LBQlnw&oe=69CE6201"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeTgreU0Ww8Q7kNvwHCJi1m&_nc_oc=Adq16YOSCodlN3yFZUTzNlUQNMW-lN09gpxkx_a87aUxe4IQWWYX-eVTPqa_O-Wev1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYi2R-cQX3wWYzke36oWMAhwKG8gNKosIrOl2cDFxh8g&oe=69CE5556"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABAbYdDO4x8Q7kNvwFWDjiE&_nc_oc=AdpQrXeOLq0-fMDqV1c3UYmhKICyn_3E1cp9ycFtc7xYXZFjK6UuTb82UCSq6kO1Wh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJx44U0PJXfBqZGM3B69-IcO-V2_VBYhF99LrckBGpXA&oe=69CE62D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGorC9RIeQoQ7kNvwHfjSay&_nc_oc=AdolXPOpA-pk7CjjfQOBdoBzz-C8ONKbk7VCMfX4ySRVshGK-D9Rugl-62O-kvk-m6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM8p63YjeKybtWWAiy6pD8Maq_c0SvJ1dM4kRJWh9mXg&oe=69CE7D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR7V2Wl8TfEQ7kNvwFSbqwU&_nc_oc=Ado9gyyuFqND1c5w2em0mX_AnlUJygDTiP0sXTrBZ4z-4bOiFkbBxE7adInkpq5Fy-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyS_XBhxA0FWVKmP-_-6YH8NXo8_JpKrFmC1_3-wKAjUg&oe=69CE5ED9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=SkmZrJsgm1YQ7kNvwHXzDVp&_nc_oc=Adp7Myv_eyiTrtpysJOPelUg_pribAdsfzrWvry5lXvsr5cZAWtHRtq5sQsde849g10&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnomVdic1UDAl8u_4YMASO0pv2aTiu2JjWnqCG6_EDrg&oe=6A805C81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wwZFmbcgTUQ7kNvwH4qDJj&_nc_oc=AdrxiigYyMCixEcPFqTPF1S9hX8sHtu-Pzoc9dZ6nMS2wqcgIRPXBNaTfnukPs9O6-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG45vzpY8y2ruBIsV_G-6nnOAqZokGlIIuRr7ycIpdtOg&oe=6A804FD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPu3cQeXRB8Q7kNvwHcqlrO&_nc_oc=AdpT7QQ_w8pgIEVo6lm-wZA3lRor-RBBiyAGApCm-kbeDaAtF8quuJRfvF6iDi7X3dw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHcgojrorKR1-HA0oPCp66Np3BVQu-91Odnyu-zi5Aew&oe=6A805D58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOx1AnFOieEQ7kNvwE2XAK9&_nc_oc=AdqCBn7_juNuHFrrWfbqrib9w_i3R_7Dp4oxOU-8leZ257fMW1UVPz0U5LPUWHmPjlA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuNUqlWQUQDFmdDk1TZL5d5451mZu4lwgNFKqyqgQcCg&oe=6A803FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gBdXn1U7HMQ7kNvwEnIEL4&_nc_oc=Adqso21RnX1WpJA1TEHnoBVNRZ5BVrOheQ8_Zne7NZj_ZJBnjpdR2ikoHu-idYoP5pc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqajHvzBWwqYk054MDGwAhWJXVCG03gEBvFMow4jj_8Q&oe=6A805959"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
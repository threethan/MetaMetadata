=Admq7wUfIRb-ysBMkXojiyFxVDbLkE68VCFp0HSApehHNkPpdPT6eUFQRrkjPUm99Rk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsDA_nz-PVqun2JvRsWL9OJOxbyYdUDsIC0joCWdurxWQ&oe=69A97801"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-t5dcekowQQ7kNvwEKcmiR&_nc_oc=AdlII5GD2M20TyrzmYCdl1XcAz68C6rReRfq29V-uoM8ROGLKinVyBExIgPwquyBF68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvUCq54ec_oE5VDzJiFXNglxK5KJwP-x0eZCPHAClVDPQ&oe=69A96B56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojam7Dm6YIsQ7kNvwHPVTtR&_nc_oc=AdkJzSr1aTvNnbb72gtj65nAtT3Lm9wTkyuhzQq15C_2BNKHLfIchSsxh1EuP6m96gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftHkIh0HjSLj8wqiWqsggXz8O8AY1v6pfRhTS3Y0l0K6A&oe=69A978D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMIK1rKMDRUQ7kNvwG7KoDj&_nc_oc=Adn1QbLlit5uP8hfxjuxebb7MMW_Kt-78ip4GRkayZH-JnRCoBjp_s8B8sppF2yaOuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvfr386I_kGmWI72OXpTXuaf94nDT0Xp4M64KGY5bRgLw&oe=69A99378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AGBFArYiw0Q7kNvwEBGLz3&_nc_oc=AdkrewKTeELInjxH696MtX9pvw3SA6X07xp8gTc5MCVqs1-IKPet7wY-if11W5hC8ps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvC5eMaACuh8V82Ien1ic8QeEQInPZAT6HiCHqnXe6FNA&oe=69A974D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"
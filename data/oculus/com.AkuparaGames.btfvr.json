id=6e7a0a&_nc_ohc=n1L0MxnPeZkQ7kNvwF98hk9&_nc_oc=Ado_2eYk-WP5-7l1XXEBJKcykZ47LfWoJRKly7vNg0D51e0EwKXebQvpFBNWjVFkh1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN-42T1qubMNRASixd-QNsi2V6Jwbqd-BO61TPZ0VbvQ&oe=6AB7BB81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZC9DeunUrUQ7kNvwGbs0ur&_nc_oc=AdpGaMuBXOP2cL08J9bn6Bacp3p_KNq5S1pGiDdTGWo6UiH6VL_nR-hn_U1cO5ZGAB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgDYUMIGOQ5Ajz0b9-clvAM9uJ1LSrKTopZnJvZ_IxAw&oe=6AB7E716"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXG6LMyrWRkQ7kNvwECbcJ6&_nc_oc=AdqsB4ddAK9LD7D8PfEf_kyBVbTTHjM3R9dAgpU3IQa9j4QLVooInLtyqXA_CosYJfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ib4NwNDR8nJT_fEuGhqJLNYsCYHtjOlmj5wVi61sDQ&oe=6AB7BC58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJYWTXUTSLMQ7kNvwETSCG6&_nc_oc=Adqr6rTsga9phLi8Dzw6LYzf7kaUM-mpXv9aWjVzGK1GdR4hbBGs_SCn0mPOAKX_37M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtgwYnHKZCQ7i9ygQm6JPPGMfEgT5LIEjjB776JtpR9Q&oe=6AB7D6F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBeZ3dfm2usQ7kNvwF0tKq3&_nc_oc=AdqIUnNPqKxmXIpBsbdSo885WxccQTRLgDoVDU4N--g3AAAUDM8oz_zCce_upfxQTeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRDh8bzairdE-61XVF5okFnI5AnlMxfRaLyri0FroOWw&oe=6AB7F099"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
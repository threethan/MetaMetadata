id=6e7a0a&_nc_ohc=QdFfOgW-32sQ7kNvwEFd6yL&_nc_oc=Adq669c3LDCbztmFPzBDtScKwGPezkN7vkwjg12GIq8cpvBSG3QAKNSbmPQnGJgRxro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxFahJKRP1Hoy18ZkGuyHdzyz0LkZmt5xwOmBrx7xKww&oe=6A54DB01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atC04lAy1OoQ7kNvwHIsLHx&_nc_oc=AdoQwFLEHCUZRINTD7LjDglRUvQlXtpSQkDaF6I-AKw40LuqhnwPUlvIqZ_tY8EsaeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANtv76gsfNM6FybxsTxSSmGZ7WHU1oSuGa1TGEXOH_xw&oe=6A550696"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Cvq1rrrHp0Q7kNvwG3jXS3&_nc_oc=AdpuzN-j_UWtQ5r7MBzd7gU4qG8cat9B-haaAUM9PF10OQn3hc8cDzszh85KbL9HrVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM8yOANfue7UVXE8qkvrRjTOaCvV1nciDOhyfgSomX_w&oe=6A54DBD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIhQoVrJ4XUQ7kNvwHQUvSk&_nc_oc=AdqNTDVwHVQWaEf-QVmWa4AGiWr3sJGPcjL_0y9jd8EyTVgUoUa-_GB5kBPl_TpiL7k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiwwpMH0hmW9IP6M_c1zdWnbYJFGrJiuo2obYdMKUTyQ&oe=6A54F678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0H4NMU5500Q7kNvwGY0udo&_nc_oc=Adqw-9163AOpILlstN2zKTsVp9I9ekz_XIcx7ka2XeFf9QnxD1ySQ93mI3QTlc337SU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmZnDFqxFCQHZKQx7hZxNDl8BYcWAYmis2A68P6saHcA&oe=6A54D7D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
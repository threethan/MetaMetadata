id=6e7a0a&_nc_ohc=lVC1-W9B9nAQ7kNvwE3ar8Z&_nc_oc=AdpdLTrrz4DW-gxCF-y5nZy1qkq7bRWJINpNAJ2ObvMcfoRzX5TZymq9oKdYk4NFjcY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Tx0ulOdUlT8Qysm7RbRlyKdR1ruwZUZegUgkbOomUmQ&oe=6A3D5841"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeVrqK8k1GsQ7kNvwHL0te1&_nc_oc=AdqZ6VToyQp_5ZmQTLdDbZbz6gPjEwSykyu5rZIKEsWgbG4WhNMgO1W5LOwBBdGhChs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__m4VE_0dtndY3wfk8hmHur0bg9806kvax4tyMDHyeSw&oe=6A3D4B96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIok0gHmyikQ7kNvwEndlPx&_nc_oc=AdpgOON1PEONp0pmeRBCko7rxDnTVL4LZQ6QG9ytDOnAEJ8jIzpDQgGfhKoyhdKU72M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RlhyV9yXALq8PdbKtsQhUJQBbUb2tmCpn_2yKx27WJg&oe=6A3D5918"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnDbsZ0msvkQ7kNvwEBm4fT&_nc_oc=Adqg9gJRJmABnT6nNHvCCtRBjm1wGgtncjh3OtqvvzfM0WhaGi5WyLOLL5cXj1aaskY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F6jCE8EH8W_I-f768AXp0cRxnO-TlCIi7pW7hL7z1oA&oe=6A3D3B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzyhdnJaBjgQ7kNvwHhwWFv&_nc_oc=AdpSyrAi7Z9A54DBtuSV6H4OGtyut5fdhzCAFvS5S2sjKZ9c2HFhrL-6g4jU99X9Pm8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UbZcVkCWRJqe4gtAYHCqDCu0AowfiileEG1U9TGvn1A&oe=6A3D5519"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
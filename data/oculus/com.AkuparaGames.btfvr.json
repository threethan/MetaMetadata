id=6e7a0a&_nc_ohc=0thzhPPtktIQ7kNvwEsp4Aa&_nc_oc=AdrWKdqA_E3OnWxd5nlq2ZbCOOaus0NUTbcP2QPmq4M3sP4NFShZkqX1qwSJ6oaEaY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92JkhJiyCjVERNoVnbOXxpQVWB_ZV0UlorvJ_s4dZFCA&oe=6A295981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpX8wKJWVoYQ7kNvwGFmwPj&_nc_oc=AdpByjoMex1lL3zzMDi4iPftEKgTxvs7NmoppMbP-lCowrrVfLHr8qltzZao9sFUPR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jFu3kIWvT5-wNPFWZwgHqiNSjN8NuBv4XKhW2BauJ0A&oe=6A298516"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e52Ntqp_4zkQ7kNvwENtDa2&_nc_oc=AdrCnjBZwSqotxTMiMYmo-efgZNLciux_yCNUClRMlL3mEp9tkzqTko_8XfjkufW-PQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83hRDXp6kyHh9kzC63iwvhu0uBke8sHqWU1YVCYDcvUw&oe=6A295A58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCAHSAjOH4kQ7kNvwFuDqlN&_nc_oc=AdodRgc_ltrigFycEdcM0PPWUH1Hw0AqwdhhDC_WtFlrHDL6YLzT8NZTqcSPGiByosI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ECL1AfpR5OX8dKSO6h3okEgBYKGSVKOI48VQHzQN2_A&oe=6A2974F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEMBTgtDG7QQ7kNvwFnf_bv&_nc_oc=Adp9FFL6LRyPivEC0mmreMs_MwFHw8S7-aI-k-LMuMvOyiX_tjz_rd29ApxauWNadG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KJWYcoisNi-K9XyCy1DIrxT4mnO_pBSD2lzxMrfMXEg&oe=6A295659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
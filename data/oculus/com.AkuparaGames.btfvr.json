id=6e7a0a&_nc_ohc=66EfZFha_KUQ7kNvwGsJZqw&_nc_oc=AdrgWzrdc0GAR6ZA1rG-RFaQJGK8NwCsqylDde4Tp26dqr_iOtlLM6yoeau0k1PfOks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHOMTw-xEtqyG23zMMyUTjXK188NzjM2LzGrczaysuIg&oe=6AEF52C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqRpsyvM0ScQ7kNvwHq2DqH&_nc_oc=AdqDe0ll5tbmzv0P17LZpKoR3rgtr6jPF3BzLrDyQ1iKkG-KOJnIjzZzy5NFKnPgzdM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThSdbp_UegZiWm3FN4h9HvY9Tdixec5qovOQy-TaKMFA&oe=6AEF4616"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFmnWulsxcQ7kNvwF2VBz5&_nc_oc=AdprktM6jNoIvSOk3ltgXvZTQvCztbCiuSjN0VB9yom_iQfwPt9gE9YRaGxwdPMx2ic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsvgQ4ohF6SJz4cVclFjbSO5PsK5d8X9PmGm1NSMwwgA&oe=6AEF5398"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu8sp8mJHigQ7kNvwH6eAPk&_nc_oc=Adp0LPqcTF21cxP_rNS9P-LJcdRTpvTdkRfgLkvOlk3fZlT4Hw1GF3a13Il_xjvCNLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE_Iksj7bq2o4L8aUTD2-5sPhl7te1nykg86RbCdBymw&oe=6AEF35F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1AH8z1wd7sQ7kNvwFc6FcU&_nc_oc=AdqWq5Tam-OaEZjE-eLPDHY4H27wxfgeX6CqIu62mLMcPjaXwmxcqv3-lqAMtByHmDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEQxx9aAoJtk-4JL8usa-FN5AC1sG47nyrOpdkbgS5Xw&oe=6AEF4F99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=fS1cW7iUtLsQ7kNvwFedEND&_nc_oc=AdqZ4VKwW_SVNHWiI_Cn9M8-oxYgNzXm38CLsAt4cP3lvDKqygrX4sf5Rqu8XNZ7EYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxZXGrOIuxwqTvLjt1TWFRHL6hd-AS3vzBAyl4vx8Cjg&oe=69CA6D81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZhbykfnxugQ7kNvwHn35L9&_nc_oc=Ado1NDFQEnCStp37y39dS-SX6BqnjeqW_iOJGaohWm0_xAsMwzH8KuRsECUCnUf4VQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjEX94lyuLihl6RsvQWNJMl0ccccS_yKf0w3NNttt6mw&oe=69CA60D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRcLtk2nsNwQ7kNvwEEIRCs&_nc_oc=Adpcj3T1flTjoh_u5PndVz4HuWe6L7P8Lhcya3nyjFIa6bns6sqlhp462XAG38zzV4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSYNbhV53RWMeaZgfcdbTGobkF2amXkn129p82Jva14w&oe=69CA6E58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcGpWeR14bMQ7kNvwFJVJVM&_nc_oc=AdrmSUndNIPVpZA9uxLTvvvqRQBsHZ8winm2KbZV86AdD6hO0H0PndSYQe3t_oTvofM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKE6aPxQdhGSWsd1aioe_YYyfnYu1f0guQG3H9YnqQGg&oe=69CA88F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7oa3pm1CsgQ7kNvwHguJRW&_nc_oc=Adr2RFsk_mj2EaL9feLYeQow9ZaoOyFD8oNof67ubevTsN5-_P9ULLjcua6vSjnq5F0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqiXkp90leiU4R0v2v-KfYfjwtVUkmHKWTCHoeExGVgQ&oe=69CA6A59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
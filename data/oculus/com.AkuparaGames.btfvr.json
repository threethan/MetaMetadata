id=6e7a0a&_nc_ohc=MoyLr7f5XuoQ7kNvwGde2ti&_nc_oc=Adrwfgme2bjRDLJDyAsZM6RoLlkt12xUFHc3V2iUyd1WlKvK43pTZZRvdkxXOSgxL30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9lxEFMfCdCwP5aW5V11ZtKdW_GAe4KtXs5TJ-LSY5EA&oe=69D10501"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGxQciC9z-QQ7kNvwE7NUf4&_nc_oc=AdpPBFH5j9ddIulrx6mkYy0KzeT0YT2eKq8dTS06BkUxfrtDrFbcjEyN0hKoYs1LuOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMNcVG6lAt86CClGArA0r6d16ebvyAHKUyIUMzO6GLKA&oe=69D0F856"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvNXop9EEv0Q7kNvwG19cpM&_nc_oc=AdptNKEqhhSgrn6BATJFVjcDoyz4NM0AbE9AHQB0lK-sv6l0coYMpDFkRwH4Afcyfq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyq4IGCoYyQ7CYsRFInZxBIg_qpuIAN80DUSRuEX6jVcg&oe=69D105D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwO_js5MpAsQ7kNvwGstEY4&_nc_oc=AdqmPlfAMTqA1IfWRwNHs6iAr7eRKWtqhIENfb4G8ccikk1tdYe7_s_yrVRVh1mZXVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMcMNo9fyPn36gWBahBftok3ecQ1Kakubvar3BiPYMqA&oe=69D12078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bERp2O9yxBAQ7kNvwGg15jh&_nc_oc=Adq7pAMHuZXkuG3VidVx4xLYh77nUUmLKzHjlTLhYQluSVnpvPyVhdUqXWr5wj19qV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU3OlwkhlCdD-L5WTHtaSTo8nzgeFsO1L1ekPXYdQtBg&oe=69D101D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
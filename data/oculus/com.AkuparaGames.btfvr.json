id=6e7a0a&_nc_ohc=TbOAHRLaou8Q7kNvwESy8Hj&_nc_oc=AdocieCP2RDKDLsitRWJgpCVsy9dpXSYJBLMhV4O0hWR8u7AZ4K_4WLHRyro8bJ57KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VptbIpa3pvNDI1j1RGuGaa9oVc1PZ_Lv8k8jmpuxFoA&oe=69DCE281"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8XRrDKTEXwQ7kNvwEV8FNl&_nc_oc=Adq0d4GAT6ObkyUwZ6FdxGBBVJTbgQYuDaHsgzV4cJeSEd37GzNVIVjT7g4MEMNxjJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f5TfSsx9oNlagWKEhRyrXQmBZ1er0jpCyJskB-ZVggQ&oe=69DCD5D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMmpm3LZMdAQ7kNvwGLWYBn&_nc_oc=AdpaRzKUJJPPuTL_nbJmOsG5brdXaetRzrVPeHZymKqcIknQmmDkJxLKR_EEnumx6dM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2znm167yglbouJthg7nkhhu4j9VMxRalUAzl3qeR1Z-g&oe=69DCE358"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1N5TFEZVV0Q7kNvwE6iFV1&_nc_oc=AdrkyNwAieZXPGjelnocHykc2w-jz92lBmo5cpTdW2YThlrzjkvQKIluj83VAoCPBLw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SZz59D9Dab_l7YB0hi_4_enPMKDBpvB8kKhh5jm7sfw&oe=69DCFDF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiVnYssJzdAQ7kNvwEYi_dB&_nc_oc=Ado4F7_hQCfR1qjPA_iChIUUtQ_hAOtfPl0HphEViLKiy23wfrVzBPZEIUBjV7UaIE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oJR-bIwMnTz8-FmWUOfrXNATFeR3L6tM0Xxd4TFqitA&oe=69DCDF59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
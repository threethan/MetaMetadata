id=6e7a0a&_nc_ohc=Or-VNCloQXIQ7kNvwG7Thbf&_nc_oc=AdpQAFqy9JR9hq2nSOU-quiqu1oAo-kmopdophkmwehB7Iozs6rgAo-o9fvaQVy5Gxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqulxjFHqtLLDtd_JZP4-5_69HQ5lU_mlkS8Oyzhi0rA&oe=6A9EAF01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NisxZ7PALAQ7kNvwFI67qg&_nc_oc=AdpcrIKcJz40GJd8lk8jE1a3YjOmApKU6Z3pa0QclAbnxcwEyqxFXLFdUc-ai8QLWSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbQdkH6kbxsHaav7fhL59oxVTu-Q_yx9Py59l4R6xcKA&oe=6A9EDA96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeCdnF_AXtQQ7kNvwFcHMwA&_nc_oc=AdqDwXW-pFlGTymjTKjWq5-BMXezp1PH0NWJ_LUOAuVvHaIyjEPEQhjaWgpQsZAGZik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIygcvgfTYRnqGIYcr7tl_dmHRYI_QlBuoKs02hAk-f-Q&oe=6A9EAFD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3cVMWW5IJYQ7kNvwG8C4kT&_nc_oc=Adp0-bu4QYAgV8y0Xiyf1Q2z9SrJbLoFHCgkijmYDP_X8FkY_ku74lAMeFkJmewTT4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQLHwMaZTYfeUxX6vYRyeN19o7s39-RcgV6V0s-uEi5A&oe=6A9ECA78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-e0-vigY8wQ7kNvwGG8LEa&_nc_oc=AdrUQa2GdsDt3fK2AV3l1BZD15qFuRv0MHsXSe5BEe_EXBPyW_gmYhixwrYqAxuLio0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkQ1zNOJGsEj8CszCwhp-FkCZFoWSlrk1C0g5exyQOGg&oe=6A9EABD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
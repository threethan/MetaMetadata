cb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpbMWaMETIoQ7kNvwFeigr4&_nc_oc=AdrjN8NgUoZJepTKqOKak3STXcVWlTw6aGJZYD8rK5Q7eBCe1QipKAfUpzcWXH2lDsQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9da1qc8NVcuB260NuJ-9bLgNqmdspjIvjzLktDrzkWNg&oe=6A392B81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkvUx06CL4AQ7kNvwFhRIL6&_nc_oc=Adob6OJPytFucGQ438lMB8LgE-Cv3b96jU4MKZeEZaeRq_VrvUh4WnYOS7m_qgbuFTM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EFq9TaNm84rPQ9YDnRJM-tGVbRrn4JWhyoSUPokN7lQ&oe=6A395716"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=480frY517p0Q7kNvwErtjQN&_nc_oc=Adp4HoIMYeWulMd0Z41qbHe9xB-qzN_ReCoMmf9TpAQn8COFDuHssFispSg8UhMK2Pc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g_NL-4Emlpl8y3GAQsLkdEZg7-Co4Z4ZG86ih-EF2Ww&oe=6A392C58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slu4f5IU5mcQ7kNvwED3vdu&_nc_oc=AdprJ8Cp4FAx8cZMEsIUPtnI29licgkLHLkNmzPLnkVqW41SIBjloTbQ7NOIS2XKabE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2SUkIel3R6BKs-qfiSUm90LtNWvChHC51q9tJEThKfg&oe=6A3946F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIeFrj5qhM0Q7kNvwHTlOOH&_nc_oc=Adp4DlQJ16pMAgxRJPnHsoaJTrGpEhm_G6rCyBeWbgdrZqqBjCoERGEQytCpytGD-14&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-afHjr8bKGnuOpwT3QzmLQVg-jL7DVv7EADPMvTbaLcg&oe=6A396099"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
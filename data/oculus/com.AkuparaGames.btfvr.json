id=6e7a0a&_nc_ohc=E0J5EeeuKw8Q7kNvwFuGS7l&_nc_oc=AdrtPKmkMwfke5J7zPI2SaVs6ac6nA3tkAMgaun5_8Bx_w7sM90h-tn2cTFTUX1gIU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQLGgZ4GK9pze44r4G5S-6bFUpdpjNK-ZDE8I4zK3rSA&oe=69C28481"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNSnB5Y51woQ7kNvwGbwKS9&_nc_oc=AdrzbFWUSMKhwB8TpYij6tC1VbYA_a4LChqjkBCSiWeZW012Lc7qhjRF0bNy5KyOOIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv-tSg6b6KEZaULYp6gsiud5qZyBNaQmmpdy-w7Ud7ew&oe=69C277D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmSlzvfOf7UQ7kNvwE5XjIQ&_nc_oc=Adoi1A1KyE5tLqwCof20bSMSoVwWDhOPDQQfCuG8hV8oEitHbf92e4FfISl5zcYHlZA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwH1chqHQJw3eoCYx97diSayo782YvACaNf2G2tIvqPWA&oe=69C28558"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI_IjSiTBIcQ7kNvwH5TI0Q&_nc_oc=AdqKX3WEPAhlgXNcdTKOFmfwNqYCOkCKEfqVfBdF-DXh0Nori9unIpqUH07Sx6Ht6gU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwckLoDO6QLGOf6ODhh1Q06qDuh7rZUj9Grfai1x6yoNQ&oe=69C29FF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r2_N9zVk7QQ7kNvwE1VlR5&_nc_oc=AdrGWMsF3lEv5ixh_nJV4ErsE2JCOXV_j3meYtJri0UmI59dGAy2r_SumSqdzmQY92A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5muGG4P_ZCsDq-rIPQ_saFL-M426vq86C9GvGy0npRA&oe=69C28159"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
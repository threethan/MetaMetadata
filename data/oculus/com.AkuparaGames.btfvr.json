id=6e7a0a&_nc_ohc=Lz7cTtyEoSQQ7kNvwFtdE-J&_nc_oc=Adp-Q58aeg-N8GDAmigdXHyFuwetOntyKtNYeWYiBbspdNfwZ5xcXq8MYycvwy_joWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b4TzGC4k_Rg8tyxs7SHlQ3ITFLbAnznk6t-0INQblaw&oe=69EA1181"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMZFKd2bIwQ7kNvwHmyoYh&_nc_oc=AdpMzecJNL_h2SL6MgBFiCxIUJfc_5oVfhAuNx9-kdIRatguZjvqmXplWMJNtk81m70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sHYFApSKLREz_Rfdg41UUnpK5gYUjFRDx4Eg0Q4fhmw&oe=69EA04D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDXJBZVy03kQ7kNvwGrMTQh&_nc_oc=AdolwqPzML79gfPwsSsXztNXv6BBco5-6c3al4MAePOa4_ZsFpRA2WtlrYBoKPYHozY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cr8xUyxGblLX1R8m2dXjfPw4hK_y5DoCmNWKjQH0cqw&oe=69EA1258"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ja9FXEHgIcQ7kNvwGwLGkL&_nc_oc=Adq6-Cd85Zw4LA5IWJC4Q8_74UXnwqY8-qaEcdhi8BUPY8IUMbX6_BuadOyX3vEYRTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21t0JyE0pvJvmLfeGcJ6LVlDY-K11V48Wey0kbt0iYJg&oe=69EA2CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6dvGaxs918Q7kNvwFXTayA&_nc_oc=AdoWkqNNE3ijGjHmkjD6mHmKUsml3sv84fTg7oPFLpEmbMilyYq6-GfUcvgAFs8QkO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vIKwdDvdH06m_FT0XAtbJFpLZVpWpVlyMOweHn_wqNw&oe=69EA0E59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
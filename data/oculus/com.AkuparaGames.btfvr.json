id=6e7a0a&_nc_ohc=SwFQJD88znUQ7kNvwHSfhPn&_nc_oc=AdpdHm-35tKhE88-m2pYEi51p1YtxkGnv7lxiNKO5J5QWGeV_dTnpmVc74RDtK55TKA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPcuz4KkIyJ4omuw7Pql43wXHbVKAr4HiT4QoHm4QTrg&oe=6AC7C5C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRaT1xIGSAsQ7kNvwGQkxpc&_nc_oc=AdqJ-lMo_0P7l2241FkNqRIHqIsgY7CgDQG2c04xCW_QFLWmNgmM8bIA3dE4gAf3EcA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNczobqMZ1pjIzdcjlnDqIw0JZmtXesJSJFbSdTCc82CQ&oe=6AC7B916"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqJju67ImcwQ7kNvwEG0oQw&_nc_oc=Adqciq_5bcsVxQPBLhODj8_HHuc25UW1ZYqBAyWV3nCDpzqIJ-Si73PbY5NHDrWIXPE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGbCk0idgKNyRsKvr1iS_R7V7_3rn54u9mh1HEV8i-tQ&oe=6AC7C698"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JomPzdggD0QQ7kNvwGBPmzb&_nc_oc=AdoE2sXo3tJ-cpexQFan8lN4usBeteZSPe48HM0_PKTVp3oz80AVa1qTKKRSIeQOSyQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBqz0ESzHNFOi2lFWms0aC5ASTWOoSAd1dyJt567b_oQ&oe=6AC7A8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dAGM1syvlAQ7kNvwHEWAnI&_nc_oc=AdouPCpa65vN1dAsNEK0N989h1MMwbuoPHTYCBKGTkrgl7bUEzZAMItjOTEEGOBICaw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMunoImQZso9Ht4czuUgppAanXb7D7YfNf2RA5bgBMnEA&oe=6AC7C299"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=fS1cW7iUtLsQ7kNvwEg3hn2&_nc_oc=Adr0r_yM0DENwoUyivDiK9RRMEpweNg4WhKlh6vRjBIRdoHV6qn8DEMsx5BELjVtDrU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh_aarGjKypC5v83qkWlbsio1Vg4gov22m14MJGYBGow&oe=69C7CA81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZhbykfnxugQ7kNvwGFGDcS&_nc_oc=AdqmAVgg--Su9lW9Zo2S6WYV8RU9pUy-Oe0map233ZeSNwmNGcfKBXMLcGhSLjDRS_E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwtEXR2xI92gBJfgqsRUJ2odR98n-16ra4jtREqhrxQw&oe=69C7BDD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRcLtk2nsNwQ7kNvwH-p9bX&_nc_oc=AdqntLWVMalC8QIDgJmXjBeutRXzq4qwLHCM3E97Brph5f8Y484mYhHfHSkQJGk8xfQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTsD6ZfJTfv2v4NtmGlTZAp2hqC6oGQWaYIDINAmi7mw&oe=69C7CB58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcGpWeR14bMQ7kNvwEoagmW&_nc_oc=AdpcWJG8ufqpRGTJVIvjtJkZjfUDOows7MH5WUrMiVW6vGWWRprsUaXpnqiQ3TKBVI0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOLc4a5iNy6Hp3SQewK8PIyXajv8bx_tfmu4jP15GgWw&oe=69C7E5F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyc12_CUuS4Q7kNvwEoupeS&_nc_oc=AdrTEcHESz7GhDwc8PVNBtucSqM6QtyW-zGQE9UInWMt4FlMVOsOHx6OdX4EA5z7euA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgsG-R4RN3DnY1__IemRX9i-unuL0gHUyVnnBlfXThTA&oe=69C7C759"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=ylQwHB1JMggQ7kNvwEQqMLV&_nc_oc=AdpcwJ6m-5LKJUHlJI6fgK3nFrhFdxbwAMtwBZE3PEMsdcxHSihReNk-IjbPBNdN8N8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI6KGuOJV3w3s4RJLsK8vwsmZEB7kqOR6U1S8CgdY6Kg&oe=6A8AE881"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pea6KKvmHycQ7kNvwG5sdMh&_nc_oc=Adoe4QDU3_lDoisF7yLvEwiaXhJCTqF82smoQD3yRB1aLo4pHq3LxVw9OPLy1Bjk_fQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj1hEXjJa1pIn8remtYQNzD7Nbw1t4mFU9Ah-3aeigGQ&oe=6A8ADBD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdz4_v3JVZ4Q7kNvwFe9T8E&_nc_oc=AdpXi1eXQ3ksfHM85GusGQs7X8XMoUbDgSM7-_IvpdHoqzD6iU1AvKq9PG4Bxf49OqU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqObzcsx64_JXy1OFly8xGIigBN7JJ0RXddC_hJWMDWg&oe=6A8AE958"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzuSveQYu4UQ7kNvwGTaF2L&_nc_oc=Adru0yzbz22kfEhaRLj06bLhp8kDNM4DuEV7TMvS3wjO4I9T5M0PaKMYzEfAY5sILvg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtBHAvmXHkse6JnUIWbtjIA9c3TGy-4IFN0GOfpJYwxQ&oe=6A8ACBB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncfECmk_3RYQ7kNvwHxlhUs&_nc_oc=AdqimD8PEQgug0qdW4ZnkwdPlloi1wKHpp9x1sRpoXNxqhbtrYZG9DKkCdAy9Lo6JFE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyBaSHsCLfwkl7IhTRUw9RGYor8ALu6-HpXfkKXNA63A&oe=6A8AE559"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
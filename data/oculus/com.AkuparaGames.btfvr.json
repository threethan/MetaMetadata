id=6e7a0a&_nc_ohc=NAwrWjbUlUQQ7kNvwFwiK09&_nc_oc=AdoxxpcvTA06P60VdlvW4lkFLOBM2XqT_WdeBVrZuRrCXstQdCBHUyyG_UiSMU8ErFE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBV9YDrCFdlvocdtGWI7fosCF7Mh7PZBiRosPcojNdsw&oe=6A884581"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zdkVja5nRIQ7kNvwGsF_6v&_nc_oc=AdqydL3eptmyYwSsvnHky2ikHj-s9CE9Zytyc_gRSaYUNNAZzS41WWAfGlEUOBZBrMM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxlxRZM2ldJYmxc5e7dyg5k9Z-XBbjxm0A7rMa9mo2aw&oe=6A8838D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjhBFwHphRQQ7kNvwH3fIv2&_nc_oc=AdqjtL7kje0DsvK-NkB8GeziOYL-A8E2sqHuBQbTA2y8RaqzRzCJhXwb3U83uxNS0-0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_7S6-riZBxwTCz3pltTo45u0sOSXuSyeY95D_Yoz0RA&oe=6A884658"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Al20PIFDuAQ7kNvwEKl2v_&_nc_oc=AdoprWnGLRD0GsQq8f_sUuJbIDbzGoa0jTCNCx5_yxHJUoIbojfaW5e2bHYgKR1CS1I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU4FhjvUWLAKaVmz4xPbTvgCL8T1A_9KPwluwpuCgzBw&oe=6A8828B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEwAvpWWC84Q7kNvwG0tSQF&_nc_oc=Adp_rGeQjoTEVSwhWq6ZFtgqUS3HkPhKgB-NffEszmL-9AMTmk7cie0IKUn-pZZQTNk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtrWqlHvYEcXbiCgzOf5G8L0BfyPzpnZy1vsf4nIFJbQ&oe=6A884259"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=RjzKOGo0TbAQ7kNvwGy7_8t&_nc_oc=AdrTJ3JD9GHxH4IWKWOhkMkYpIokvT9khQRRfJCsSJw5d8VnoOd9lXKbZZaTnYDCTtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z2oUgnU0vaiwO-xBN5OGnHDt_mLsN6W-7VmPVxycOFw&oe=69D4F981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq8t6OupYjMQ7kNvwH-U9Kf&_nc_oc=Adr7R0a5PGhrqEJVhfihkc8yGjoyHsgHCQvdzavaCT-46UgthjMTBylkUF2sF6Iaa7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AhtegUMseB8ieFp1d8EPUCOkLa6Fsa89ILRvEP7PNkQ&oe=69D4ECD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWmox3nrTykQ7kNvwGB8qaO&_nc_oc=AdpaZAGCT-0GtQmtE70OED_XHj58Ty7g0OUBSGklLLPL4B2GDcwNgboyMjL6ZKIVEiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00RIt3Bn_9O4bX56VwTloEEGYpCYN_awUTEH_Y4x4rbQ&oe=69D4FA58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FGdTzncxgYQ7kNvwE8LkDd&_nc_oc=Adqyk4DWvTqptK3_sd-IHUzzERWquH45lOZGcnZpfl6bk7vLpkLCV-tRKeNupIdy6CY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tt3kOKkTczBn2k4Bu9rSEmb842M2pwkwvI1c67JibPQ&oe=69D514F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad3lyVHmnu0Q7kNvwEFQ0SB&_nc_oc=Adr67V78kBIi_tl4dMUQIbZEtmXpGqB53-tRn60QwGxgdH3DUhvu1KspTuE5fI3uYvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07Z0rA8bOuD5tqHO4aPvFzQUJnLPtC23I761M15TBN9Q&oe=69D4F659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
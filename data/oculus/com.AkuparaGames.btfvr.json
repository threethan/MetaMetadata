=AdmvMRPnOeng23nFp0wYIMgdDSVuaaFIE8iCxIuCKIDJ_NuGZ-bvKJVmaBKl-paNkdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZuYfTS07EOpjZfcS1x5zy8T6TKKxX9IzGScPaz1L3LQ&oe=69AEBE01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op6C1O2b4uoQ7kNvwFlKJyB&_nc_oc=AdnaH_CJi0vVT_ly4iw9Hy_fvNf4KfaQfPLrBD0oAB7__FkLHL5XDnv1lsKHooi6DKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyA__KlDYK_GNYaCm3bqGfGAVxOqKo535_R_tmLgB0Dw&oe=69AEB156"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1mvRujwH28Q7kNvwFZg4-k&_nc_oc=AdnlaJ5I8xT_UPICqSnjG4AwhjxaCUUQGRhGhXDga6znbFKmOOxRvv0E5jHUiM3keHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMqOk3QCleleKufGbxSw--KC9h9OA8GMvOTc144dt9fA&oe=69AEBED8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9v_o0yxc-UQ7kNvwEsW5Bq&_nc_oc=AdnkXtUnlKLjbX7wNNbEzLVJ1NXlkt3uo6aVaG5n02quP0OKMgaINca3l4WH_vuAgpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyKryhi2FeuHS4606W5a2o7je61VcLfIt-RL8yJTbw5A&oe=69AED978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz1qudP0_bgQ7kNvwGTyVuT&_nc_oc=AdlPb9KCiYN506me54Sn__cfBmVVN_EO_VllSPvDX5I8RxqHYSoip5hoMTp2SYI-tbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzptlhrn8GooYM6ckzifLJZjkCX4f_4ZX4Wa1JajTBA0g&oe=69AEBAD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"
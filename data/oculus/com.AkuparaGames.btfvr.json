=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft6jem93xOmNdL4Ud6VqjQFt6ej0BqDQXuSxzCdXVuJRg&oe=69A58381"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c4YPV-jllEQ7kNvwF5Q95J&_nc_oc=AdnfK30uttxYC323W-yOazyI3z9PLIDi29hBC7-IGibdX07vEYxaT1rTML3_bXxG-PU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afswt3Pn-9ZbJc0OB3wIHLWilNnkzRsMDU4Cb8dS1l285w&oe=69A576D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1q1OtMzeToQ7kNvwHcB2n0&_nc_oc=Adm16yZplALpfQNmbwSddA8iyr5-wQ8TzYLxE6jXqhDdGosXQa3Byg9rJvLkvue228E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsmziDJlaRHPh7U0IQdfuWk-9asV2JB4NTIf05mjSvI2Q&oe=69A58458"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeDweJAHl9QQ7kNvwHUH1Dl&_nc_oc=AdmQ4i1EnMURiTBOzQdMZqd-00k0nXlOkTVapX3lxFWomuud5gSRsfv15au1WNtrRlM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsKGUri59qzKhWNv_p7jtfsVztVKj4Q2lM-4QpcgOJmcA&oe=69A59EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp1A-Ydx5-wQ7kNvwFHEVnl&_nc_oc=AdniztwYOLykctw8KnQITnR7Xwi6xCwH7b9oTPKJEwFs3TlVr6JMjjuOz4M40BIAtto&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsaKesbaVbyxMA7g9TrcPjoi3x04wQH8lhXlt61r9h8QQ&oe=69A58059"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUI
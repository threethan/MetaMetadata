id=6e7a0a&_nc_ohc=WT_bmhIzotwQ7kNvwGG-aNe&_nc_oc=AdpsgQf3X7lI4IdqBwOwIt9RZMQMebtRhftXXCNLSv3Rc1NXqzJN_-gDsbJxLCZOAL4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwrIuH9e-QrJjzz9udcJK0yW0XTcySksvrraZZ1w1xEA&oe=6AAD2F81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adSBIrPotc8Q7kNvwE3EIeH&_nc_oc=AdpB79TosEikmvRIZfcUAvYPhDxj9v_0JXponIfWUE1nDdvi0ZLsVw_6vW_6AFK0Nnc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1aHnfakqIy_Lv2a2VujQeOQrxqZZ1mBEsFV_kI6GRWw&oe=6AAD5B16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnOHSVVXqK4Q7kNvwFYhDgf&_nc_oc=Adp33-E4ZbtGrxB1mJLhjazCGiFaJW46au7LeAQQ2wVuYzSUEG1xsrTdQ80XlyzYgR8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7WmgrNMmktAP9zpHgXCBB6bZk6vloK9GZwnkOa-F4hw&oe=6AAD3058"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TtLALIdVEQ7kNvwHY_KzC&_nc_oc=AdqOQOydMAiF7LAUaKQepPkntOCNnLpJ_unJB8Tg4TZK6oPppS4-rL-j4FGSubunTJM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqZo2tbxBIvKCUNuIxou3HzOnqYIsb8aUua7zj0yHVtg&oe=6AAD4AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3f6QWPE4V4Q7kNvwFrKjuU&_nc_oc=Adr8pKLKkVeqE7uBLvnrt1FxbL-ox-Mb8r883gXKHWblh4RSzwzk5Ec5HcNKB3oo8Eo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6oed1900791CPhiQtDS8eK5bqgLYTl7JS-mEsZVehqQ&oe=6AAD2C59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
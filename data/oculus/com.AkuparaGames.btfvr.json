id=6e7a0a&_nc_ohc=liXye9659KIQ7kNvwGr_jPq&_nc_oc=AdrYZzD1DzBun6v8Bsdl5MGb1TxGbKrhM0tCWpp4DM_QiXxmmgWgZ962lKYTnnddwOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_x84ciKwsa9UE4alZtKIRDoP7FX4VsTwsRZtA22BAqQ&oe=6A259D41"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9rgogAdLsMQ7kNvwHUcXv3&_nc_oc=AdoizCxp6xngYUl0MW754VcxoZWJ7wWy6bT8Lgx9vFlquyzZxXEx6bFE8OUuEr0ABk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QAzALTG__IjdJBBr6d2AYPzT1yXMLPxEWfjym5t5OvA&oe=6A259096"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0jZ3q_-QP8Q7kNvwHzra9v&_nc_oc=Adq0LefCh4nuWYUUPvyFntZEaHCS4rff99ifOuIceDCyYKf7KYOHwnwi1K5_ASbH6UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q4aw0po72tuiC0Efe1ZFhZmV7Noi1nLQZW8JJd8O2wA&oe=6A259E18"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8bsSVsMWfQQ7kNvwGAaTvf&_nc_oc=AdpD5L-z5GyAJDSgY7RDRXpneZnX5xjDeVHeU5dm3GA0NNmCRptrLm5sfdb99uurfVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SjKjPd4wjUkwWQaqkz95l9BUk_fTxlJEEZK9gu4JSag&oe=6A258078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh583lBAh44Q7kNvwHudbE6&_nc_oc=AdqyfN6KLaY6wNy3281E2irU4hM7XoP8h-a6ei3Hawcv9306nharLdj0VAetwBzi0TE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wZnF-u1F3E98Xoqzw08MfPIEVZOxirVDg8yA8kixp9A&oe=6A259A19"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
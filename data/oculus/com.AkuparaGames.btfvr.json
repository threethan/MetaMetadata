id=6e7a0a&_nc_ohc=bZ532BzGcjQQ7kNvwE6ejP7&_nc_oc=AdrG8E4EcFnnjYj4hUoaZ02C70ThnSpeeTsolYmIkeSukI4t37ghvlR6HhcHLQghc-4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4La22RDxVhB5aR0Iys-RDENAnUTNq0kUqfHwbVyIKNfg&oe=69FF2981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eZGY4FtF0gQ7kNvwEytnwk&_nc_oc=AdofIYdNkRTB5z30vFQLZmY_i7GZoMIy1If1FeZln1lRp2l0VOt-lUzM1S5vZyjY3qc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t2sK3HQgMIa3y6ddEJgOmGN88dEPAq5LmEZlF3LllOA&oe=69FF1CD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzOUAEIFPS0Q7kNvwGyBbXp&_nc_oc=AdrrdXz4YvlgV6uV0pGdh8ldfH-Fp8VSnwUTUYk-dS9oQox_NtTqV1fV1r2FAWna7Pg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LNJjuHfM3bY8tLCce4IAEfO3TufFK3OMz9TMBDh7GPg&oe=69FF2A58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOEJCdxEnZkQ7kNvwEEwfrO&_nc_oc=Adp1m8SSOFr3Dxye5qgnymmYgg6ytd3w5JxUxBfpASYdI_zcy6g9N-KwD24bQqtYzLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c15eFySxZapSIVU28oZ_-i27RagKUphINuPAvkR_1lA&oe=69FF44F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PcugwBZlRwQ7kNvwGQGD0k&_nc_oc=Adq3cNeY3AE8NlMVlZNOGrYHjTDYp7JG0C8oZyQEgKjVcYuUaRT--bgGzaKb_ryO_Rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4El5ovYpTMX04zLl-WOkgKl4_XAr-cCBKa7etmz-YouQ&oe=69FF2659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
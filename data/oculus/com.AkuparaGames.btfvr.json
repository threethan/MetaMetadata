id=6e7a0a&_nc_ohc=8coW2Ph9FGgQ7kNvwFTzSy1&_nc_oc=Adp3RNKltZ-R9UUcB1NuTjOTtUPjKnVZfgjPVgfSJ9SxHi4CADcd2MWVlRi_KhgDTI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gknon43YXZzHyAaN01EV9U9aovs7XbpfMzkcBFB_s-g&oe=6A031E01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3rkpuZBIq4Q7kNvwFau7bc&_nc_oc=Adr8vi4RMZGb7kT_eZbssGgDiXOOMFlR5oI2cwhDd6vGiBOQ2kHHDEZqObBRyiJUJqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YOKhEDhst-9PZLynK6GcIjggW7U0MYeQLPeH0gSvdBQ&oe=6A034996"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTp75GAHVXcQ7kNvwE_vHVb&_nc_oc=AdoinygTWja5YqFKnJrt5hEF4EQMcFy1f312xgtvY_bB9AwZT9_lXGpzC6yZ1uhAaEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lG7uy_X73fQFLR-kNEWxgn0bDD1hfH6IIfBwISTxESg&oe=6A031ED8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VKYNfNF9GsQ7kNvwEI_ot5&_nc_oc=AdqzmbjdX9aTCg75RV8Qg2zvqusdQU2dYMzGJvHvyVLNnO5dBpytEcAPD6pSVW7ZoD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55432X6wcytAZnllDc5d-nYH8k8xWUJtmBJOpStLomPQ&oe=6A033978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JmHxsfCkHwQ7kNvwHYHGkK&_nc_oc=AdrrM4uBENHw_UnpFlq7-X2M7x0n4hqM4fbcoY-V-SkINQFam4Ch7jYvjkbsuuiO1EA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t4aq0oc_zMrfqHySd2GB8yX3Km6ucyxsD8zA1Q0g1Ew&oe=6A031AD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
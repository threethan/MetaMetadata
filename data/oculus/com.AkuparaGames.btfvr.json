id=6e7a0a&_nc_ohc=RzHlemoNSfAQ7kNvwGLRDt-&_nc_oc=AdpYFvVj7ZX5MDvz_XcyH4kgVCnYlNUN4s0NQGKbB8hcGkfyPEst6uIuVSItxfMYjpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3vGZTkLEBY2UnghZwncCulrWSOXx6AwRz_b6XPN5iNg&oe=6ADF4881"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8HvwqM6trAQ7kNvwGAn9kG&_nc_oc=Adq0Ph2D6kPvY6b2ZPFN0hg0IQkXa888Iy9fgGwLaM0TKdq8AXjO4c7HsD-gVTsu6H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTmEbyCcfCLvMsU2S4seX1ygY0jTU-Kq5SWTm5gK9mwg&oe=6ADF7416"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xylmbJmTUa4Q7kNvwFsyy3t&_nc_oc=Adr7gxvK6LiFX0X9x_ejkxA-hE-xjjJnf-PpYEDD97OkNlnWUFKkaGpT08QPPuLZ-nM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPznt3zFquOgVs8Kae6nFCC0jeUtUHusDfwUZaUu8_1og&oe=6ADF4958"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs3D7-IKL90Q7kNvwHBGi98&_nc_oc=AdrjEHwWifhqQF3pdtXa9r6BAo2oJ6TQmqfeWbdQ0W7JyvbEePiD3pEgHQopOHjZZm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV8FAfbR2pl1YMyzfge_OrkCpypRuCwpzjwabvOZLsiw&oe=6ADF63F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NVamSEyytoQ7kNvwHtNTKI&_nc_oc=Adoyv8jYgmHjDi23rE3mI8JpJg-zVqgnG8TruaPttjnX0nhtWnePCxdrMMb8taHutN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNglO5Ody3OBhxBbOPePvBhk02ajaE-4I2HWRcpDX_4Eg&oe=6ADF4559"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=imhKQcl8_OsQ7kNvwHIc9dP&_nc_oc=AdrdVMoj9QzoettutspPhXRQ2ykVRp-mjuZ7tY4Q0xDD2ilO6fvZEj0XoE37dlXosNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dXUkVsR64BB8dLAugQvFzOJ-vn_rdMX-xfs5TEjiUtA&oe=6A217081"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lqp5BL95vwQ7kNvwHNx1UQ&_nc_oc=AdqIkvcwM4H2AM9K83zYz33J0hlafmwo0K1HlHCNPhpAIj4z-VxxuOqO7qMra6cez6M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RMSv8_8-CQN5UTRHDPZi6Upr0z0HzX6sdgzRruCVGCg&oe=6A219C16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkMLa509CdMQ7kNvwEIV0dl&_nc_oc=AdqWnU3EZFOxoh8Bm4XgbZtU4X4xyfHhQIMNB7IP6tpJjXSn5ww1K_RIlfrRYbwTUww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iuszji6fJ6rfTj-dX3VxJ7A1aJcZd7HMJxz09zTidaw&oe=6A217158"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rim-HJjevQQ7kNvwHU0D7F&_nc_oc=AdrD4vOddOQbQzY1WQpgYW8ETVXGCMskFZT4R4dYpBI0Yf4K6sBbebQ9dZx7xDGAE5g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YOl6yjJAg034RRn-pgNhxfumjumGIhuTvbs7Z5Y5QJA&oe=6A218BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf2g-mnFrZIQ7kNvwEdOifv&_nc_oc=AdrwP85vdZs3Hzs0vgaw79FQ7XSll_3ChLlY6E9qme9xDgTstMjsOBpDHDTFSMvhj8c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z7Yy120khH725MPDFXdmj6CWcSk2AO-DocAK0yL445w&oe=6A21A599"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
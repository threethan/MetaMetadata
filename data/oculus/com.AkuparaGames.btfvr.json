id=6e7a0a&_nc_ohc=Lz7cTtyEoSQQ7kNvwFAdeq3&_nc_oc=Adpilhpt6Ls9Ymy9LN5YKC351ImFjcD5qsX8U3MnI862HeHVLJUE9c0p-cc65ZjhSlA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-BOFsWH8RuIVtOfaN6VceSLJON_Dl449bVu-QQzx1FQ&oe=69E76E81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMZFKd2bIwQ7kNvwE1N6ph&_nc_oc=AdoaP9UasjF7PcyaNwB_8UfZNVxA9impFEAPxIFYWagq7MIDlCV5Y472EwCV35et6m4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tb-b5V-OiGt7FYvimJQ3mKaumCKqgFYpup5EqDTOmiw&oe=69E761D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDXJBZVy03kQ7kNvwHjfJPy&_nc_oc=AdowFrNhAWO6fLTLastFouKxqQ3hMuDu8fUHRiLWHoA4bxg5Aj5wXGSCGRgSuQ9c2lg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hqN256agNwom52Z-f_BRr3Oi_4yuRYv2KyDlXmTRgEw&oe=69E76F58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ja9FXEHgIcQ7kNvwG_63j8&_nc_oc=AdqMRaIsh36_ja1GCxt2clStRpvwmVlr95-xDJ4CGMRM1K1q19ja54atqPXi7BOQKaQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02aU9JYQZnbF8HoJY6ZDid53RMMU3MoLYDgwcXliucOw&oe=69E789F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mskbEe4XW7QQ7kNvwGCg0ug&_nc_oc=AdplFXP9cWGjzset0h2Lgq77eHPnL6b1zDgdCbCY0BWoiluF839kfAvGh-_wsz0Iwew&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SKm1r2vf4rsqMuEarpabbIY3wPbvNlAFpc_GujW3vmA&oe=69E76B59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
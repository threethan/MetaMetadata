id=6e7a0a&_nc_ohc=2asPcz6BjOUQ7kNvwGRPnnB&_nc_oc=AdrYo9C2nuq99276oNLjM4qPSC2hE8cxh-UAF95CO3qmCR_ZujLfk4bN7QLxt9r1-iA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75bXLHeZ-dt4eFGfSyTxsub-2rUl4SXV17OOuiH9JlWg&oe=6A159301"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MySrtQDg_9cQ7kNvwH4FxN4&_nc_oc=AdoFMQ-mMOrJfxM2Krvhvp6YG5yzhudS2XW33sPyMSyfuQ1Z2angRBoR17DenbNJqTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y_hBsvTWMlIJZQnJGTMLtFBCjnEHzk7z_IHXkIVvh-A&oe=6A15BE96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVgHsg9mfPsQ7kNvwETyUQl&_nc_oc=AdpdosKfX0D8xcI1ct7KCCgA1aWh0Z-9d9iIe42v2y0CeUwBmaBys7R-TEYjiH8D27w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P5yNQ3QGHzhF1_Un3mpR1xcQx-2vX-N7Y5mJtWe-zhw&oe=6A1593D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WRy9TFpMAgQ7kNvwHmD4r1&_nc_oc=AdpMxbJS2d7BVkd-_yXqQBJzuk1ODR-be-kH_ktC1Whu_mseQrWLwZtZaw97Hck1Awc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CALvXl7PbabF7BGS7vNZdSEjJjyVAFj2M3OuyOyrQWA&oe=6A15AE78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEsBuJrKzeEQ7kNvwFBpgLU&_nc_oc=AdrzbSsDfX2GAiMDKecyz598HSn176Rco8zgU2xLJHrqXBkVwY985-0dsiJkqVM_0Bo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5grQ3Ju_-eR72ww6CsMZlrDAV3cAHq-IBOjzVZIbI9ug&oe=6A15C819"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
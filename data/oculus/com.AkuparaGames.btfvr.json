id=6e7a0a&_nc_ohc=3nIuaM3pJSMQ7kNvwFJwWpO&_nc_oc=AdqBFVejxQ7-m2kxzNnkZXalUOvs608S3lDke0V2OCMXOVqIYniDqS-hlpFPvcfje2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5coaLIOtMsjf-uK6SjWDlOts86lnRwkfXblkHKL-H-NA&oe=69FC8681"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw5_tNmyLjEQ7kNvwG-g6hu&_nc_oc=Adq2JsVHOoLoziryUSW-Eyqr-5SztPIsbFw1wDTSZsFjujpiRahffSVIUQwWieQaAeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i_D9pA8tg2uEeVellwC8UaQcA3Xtq1H1_FQ5sewpi2Q&oe=69FCB216"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzi-chgvey8Q7kNvwELtxYZ&_nc_oc=AdrcSupqx84A-FO2ajpnAU8E-T2WlJ51wEp1v-80JsX4iUPZnxgX9_8jidlSeYSzeYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LxTxkmlzFfp17-JkA1bA5j59vc_PEJIEJ3Vt2IpOUhw&oe=69FC8758"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9B6YkU5YbwQ7kNvwH24R_e&_nc_oc=AdqfdPCql9jIAsR1YRDX8CGV_D0QZnzOQuf3rWfHGN7BiK0PuL9lYdZmABgUHPLRjuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FDu5zKJZSjH2u2hvjVRVDuWFqsbRJeJn4zSlz7gv8hg&oe=69FCA1F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PcugwBZlRwQ7kNvwEynTAB&_nc_oc=AdpcRbDxxMmHKroOKw-tkB3XSp8pAna30zgCu8MDECW0untBpmp8u_9o7QzbD4voFHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gxr-aVzQ04tqjlpIRpvJP4CYFWlrhdKcBm8eBj4GJNA&oe=69FC8359"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
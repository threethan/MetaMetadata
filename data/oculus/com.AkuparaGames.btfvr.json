id=6e7a0a&_nc_ohc=RjzKOGo0TbAQ7kNvwHgNAHh&_nc_oc=AdpJ_SsVoSqtyqao3t_i7pl5OzaIZwyrijw0et4V85-2zztlIKlQ5vb6QDW38xH9QPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33CyknO4uTfOROc85-nIu06Cxy6vP1IbJsXeLeLnSA-g&oe=69D3A801"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq8t6OupYjMQ7kNvwFBCdBH&_nc_oc=AdpatXmuy9RH9iOHtRhH-VbIwhn6tlnZGyGhRu569AC55IdsRaSk_IwZQ9m8qEFC6-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sriIQAdSSdFmeG2hw-MajHLMqBE2o1ZO_b4cfqQnrtA&oe=69D39B56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWmox3nrTykQ7kNvwF7wZjl&_nc_oc=Adq0hh4Hi0m_AI6P2xYwtqIGFlm3zmfR5l86IL3I4O4nWm0vQYB1m33QLk_IaX-fjvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sYKBqgqD8ATonQEfT5JK2YRCa5nKYgUkcq-Q75xmUMQ&oe=69D3A8D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FGdTzncxgYQ7kNvwFGGK3r&_nc_oc=AdpwyBKvCw9G4_CQqwRscOxfb2c4bHk4QzgiyzkF_-2wbca-goFcx8oQXRuVQgKelsc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PwE3jxV6rAsmQdVYtCP6gL8NgpEGGsP4_HLEekfas_A&oe=69D3C378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bERp2O9yxBAQ7kNvwFhSWcU&_nc_oc=Adp4LJKOvyIIvjZ1RuVtu4oy6Q0TzSsTMBQPBvUCKr2pwZOKKhV9DaliUdITxbeEoyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YCfaysqzGb4PPE7pTM2muBhdFw2iUIGrBQqEoeIp5Rg&oe=69D3A4D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
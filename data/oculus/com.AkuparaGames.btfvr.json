id=6e7a0a&_nc_ohc=QdFfOgW-32sQ7kNvwFuCXmx&_nc_oc=AdrxNY6T9moJaVszg7q4vXOrhS2VfDcH3hQzTpfgFod5mKH2d8fJDhADFl-XPAmS1K0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTnLMhwuYdFSaugYIK5l9I7FBWlG8sCDsQu8G69sOAfA&oe=6A538981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atC04lAy1OoQ7kNvwFx1--V&_nc_oc=AdrrUxWweDoL7F2IQcVC9H8LLXStBnQjjcPcQmfJ17QyWG3k_diEPu57NzH1zxtRUXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIrudA4_mqc6JbVl10Jtv3wNlcHBxsaGiE4mc2pkNs7w&oe=6A537CD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Cvq1rrrHp0Q7kNvwEYOiGs&_nc_oc=AdoqsjjUpBFcatN8kmlBfreFX-YG_1GAuVLB2fo2SUvcL9_iHEja41o02N2_OAvTyFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnVDz8fHnXIw-nRKaf0vQPDxKWLBa2SfkX327tCfE1cg&oe=6A538A58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIhQoVrJ4XUQ7kNvwFEv7mK&_nc_oc=AdqBtkSokQOpmU93uqkqJlRkL_hHHNTiEVZaiCOYHE7ePh2o0e8jCOIVIRGvS6w0d98&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7QvA9HKImFIxtBbmOZQoio8lCalqRfjHARHRpXD0Rtw&oe=6A53A4F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0H4NMU5500Q7kNvwFvISXF&_nc_oc=AdoyTef32ss57wjmEpW1kV3nspz-4BEnXNMAjDasdhzyirK451s60VwiSmIab6i9W3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqGVWZvXbyQ8jl0RoQD2dn0YeDdEM4tNmtJh89p9bdRQ&oe=6A538659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
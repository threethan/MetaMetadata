id=6e7a0a&_nc_ohc=HBQAmlowoFMQ7kNvwEL_UwT&_nc_oc=AdpRNiulFcgBCPlY7gx1spfSZGtx6DxVD-JOSBnNtKMN9TwIhHRENV3gsJL8MGRYWqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZN6GZeOEvONtKQSlDEPSOTrbYK-PdY-9dLXTw-HFYng&oe=6AC12E41"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WxDZrQBoBkQ7kNvwHx6Bf6&_nc_oc=Adqfj4Cqcg-ykJUpL11uKkOvCiffR0nFmdqoWnmuCb07Cjkr68TuACx3toSpIHKkon0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkWBcefTDY03tvwxPVsLGnn5W1lewghGGDLUCknuGNIw&oe=6AC12196"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq9Z2FNtIxoQ7kNvwGYdb-7&_nc_oc=AdoNEldC3yygtr9GP9Y3k0aLS0mh3KlzZfNSN64IdAvrhQFbb2RnDl2saOX1G-xSlCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfO8VaryLpCrTNJolVKmZQEbYpw2EnmigWEslavkYTww&oe=6AC12F18"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE7M3_6FCGYQ7kNvwGKitO9&_nc_oc=AdrMnjGrPgYXnSMFlxOlzMnW10o8YC1PXHZ2WyyZ5tv6Qxn2WLKBG8bidysS-kaGv80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn7GCv5y-qImO0lx6RabLNi_9ZAmm4ax6XCEO2_Ilq1Q&oe=6AC11178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8-u6HlZc0cQ7kNvwGK_-Q3&_nc_oc=AdoVgO-w-iRTC2a5kSNQwk7TIWVqamYBrC7ZAoURYYxMtAtIhwVZMMZ_27jA8H-3mH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMmT_KOpg4dzYpH94KZ0x-HOVMFKiqKFHAregND6Q3TQ&oe=6AC12B19"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
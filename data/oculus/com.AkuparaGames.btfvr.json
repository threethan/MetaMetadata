id=6e7a0a&_nc_ohc=6_dch8wtsN4Q7kNvwHTt8_M&_nc_oc=AdqrPb-jxgnnFaiwCEnvTZG5SLcQWEz4z7IHHznGcU9Jo7jvcpP_3HgMrAubB5xsswk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUCjGMKuq24-tFmt2S7KUkYN9E3Q4-n4_SKw_Qrirq0g&oe=6A92D181"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPs0yven83UQ7kNvwFs7r56&_nc_oc=Adoud07TPqbonyyEWlKrhe4Tp7rIC49-xd319HolunZQQJpsfFgje5b85Khrkts1u1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcSBgZ7bZ2b6UC7R1SHYRbVmQInILDoeJJaDw6WOwgOA&oe=6A92C4D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=276AiwEmv_4Q7kNvwFbEATc&_nc_oc=Adqb9SWs8XGNwOCNkdjkrmWteTvz92l65FQVi3EEb-qgmPkYagioZdlm6rJcEM50Hw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9w-bqnslsCKO7zfXNUAUf9bAK_MHWZ5u8hErjo-snkw&oe=6A92D258"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGnqFe9E7lkQ7kNvwG9PKyN&_nc_oc=Adr7xtySxASwR4ikM2eDYuIiciw5IDgOJJOA_X1lBRU2tfzpFvpFTQm-es1YRWdJslc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQAaJzItsXDCTIHxIDFbWHRCJj9NIXRoimcPApKITDzA&oe=6A92B4B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uULuojnQyHwQ7kNvwHky18D&_nc_oc=AdqnFohTbQ24x14MuR3yn7gHN-3h8UO2t82UIyv2q25VbP5fci5hq-3qUFidrAsxs0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFibLqvF1SPtJ43LtSTECp-e6dviUA333C_5ouXE5gPjA&oe=6A92CE59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
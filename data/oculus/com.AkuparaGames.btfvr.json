id=6e7a0a&_nc_ohc=NmwyCE-tFQwQ7kNvwG21Rlr&_nc_oc=AdpflGyNmRMIRwFX3YU6u4KCsuHqnFjQJFX5HKcB5jWHhtImXVntSMYdBdGzrGq5GC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MS73-xgDZAX0RazCRUI2oTJop0r3ngoR3Uh6vwnAIeQ&oe=6A19BFC1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeyncmhKZzcQ7kNvwEQNeIG&_nc_oc=AdqHm9N_uipmViQ8DCtCZ8Y_nrRXsWIHHh_jpbZGIkFPq3V_cnzjnysqSqnV8VvOqtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nyrdXWZ6XkribyDTbQfquPNeIyZvj7bPY5tSzaMaK0g&oe=6A19B316"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqZRsRwHMWUQ7kNvwGT_X2F&_nc_oc=AdoWg24BzCQrvduRpQWlClKjkmiis1ym3ZERxIlZhA82NTxTfpK6c7JypmfrNh5VjOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dELFdFpA6B0Be_iA5jMgeedlMtMzPLQGuaxxia-9U_g&oe=6A19C098"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPEZYNwtIRAQ7kNvwHuJyTO&_nc_oc=Adry-cFIwmvOlLRTUCUJaem_MoSGXv75zavoABuMtnUwTOc3VRukzMwfJftPTihITBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68IJ46dCSFyqQJmlrsXx9JsrQcYoQBnbypolufH0bfRA&oe=6A19A2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXCCmlS6oeIQ7kNvwGxkMjY&_nc_oc=AdpntkED-MTLm510i1wIN4OcExgJF4wHrKgwDYHKyr77QCkDDWZjDmVwZnzTShle7Lg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53VzM395enKzL_7ucV3snC-7GHYctn22bz_pPmFwanDg&oe=6A19BC99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
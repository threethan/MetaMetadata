id=6e7a0a&_nc_ohc=GVZbUIm-HjIQ7kNvwF7__JS&_nc_oc=AdpvZM3SH7P6UKn78GP9eqxnRIoJBv17mVnLcFkskBCaiw2VsTkAACx_AsvaUYo8Vi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6aJdfSoVDlvS_K47xx4xBTC4FsIZlnibii6OlExay4g&oe=6AE48E81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfgB1_dwsGYQ7kNvwFQE0Kr&_nc_oc=AdoU74PotEe5f9J-NX9j506Sq_dPE-2hVyOyuMozVMIKYqVUlkrqW_O_JDU2s0Mv298&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB8uDejUuxaH_EOQXY-A6BZ7LOetP6USfrJnghmbDc0w&oe=6AE4BA16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uc-R5eWc3sQ7kNvwEkibSU&_nc_oc=AdqfIQMo9Px2JFajhjylnJMwSQyh33jgnwdEzNS4YXb1O5Ray5VCr7HJazi6UPYcdJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPNMpu60cEM3NJACPZOMagLlwqtHeKWbxtDEhQZMus3w&oe=6AE48F58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAWH4ARzWb0Q7kNvwFOYvPt&_nc_oc=AdqipIf61ZbhkZgfux83aRFkzqQca6xtij5sxDId-lTEnwLngWpeiCKRP3iLbOtQtUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ3icMJ9xkbeX7FS8tWRDTzVH2ls_U2vRIS-OBw12VGQ&oe=6AE4A9F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPvyisQn1wEQ7kNvwG9GIBt&_nc_oc=AdpMvKIW2lNY4ObfLwFEhc1blLgKdImZLpuOV9MWf5anV5ev5MX5rhuRJV_yRssV2Z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqPyUbVQA1IYIQSx7v6XDRD81vw8G8i_cAZRxK_O89jg&oe=6AE48B59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
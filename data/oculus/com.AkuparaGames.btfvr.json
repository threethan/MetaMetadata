id=6e7a0a&_nc_ohc=w4UeaOvva9UQ7kNvwGDdm3V&_nc_oc=AdoJzM4HKqGgQhZWXTUncW2pehxY9iazPuzXfJc98vcfJOBTD1rc228ajQVUDhoK4pw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3vocLpWgGtRiuS-2uiPqJJuwTIit7iAdrQxr4-B-isg&oe=6AA54681"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U2FG_LXoSQQ7kNvwF3dA8T&_nc_oc=AdqJwlsRgVkAlpoo9xswGNNPbCZmu5o5rAT28vZs4w4iBL4HZwOEMqHHKtkNsbSLtVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4QtUnUsh8btGipTOFhhreprWXbVgFPRMQ41DpKNxOxg&oe=6AA57216"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q98_holF8qMQ7kNvwEHOyBm&_nc_oc=AdqCWXG2S5fnVsrXkuIggf9cXSn5gRpkwQikxSQBK8_r-oavCLz9-UUmgFI0ORh6CoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb9Oky0VSK1R7kTa2kQebg0QsOGI15RBC454RRibXxWw&oe=6AA54758"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3dWhh2VELcQ7kNvwEw0pRC&_nc_oc=AdqJ5xfItO9zooZVcLd5wv56SdEfBDuPwLm3q1H7T2GQ7tTHxqk5QGqat37p3pdDkvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK6W0ab4wsgWxIVDzSCKrX0OXUTze3967dp3goRt4zMw&oe=6AA561F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d78HWwJG57wQ7kNvwHjeFII&_nc_oc=Adpl_WEw_NFcyeWUe8mPYVhLE3IyL2Yps7oUpFEX6M7o8ct_qRum8Jcs2H9m2bNwe9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhaceX8N4FseQb_wuPPRFl0B4Nw8r4pTEme9O4JakIWw&oe=6AA54359"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
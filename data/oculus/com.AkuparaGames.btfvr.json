id=6e7a0a&_nc_ohc=g1SaqJcjF_YQ7kNvwHkKs_-&_nc_oc=Adon9NuP1tDln_eq1fdd5uXZsvUnxxfgwTzsWAZl-3sRVvlw2sRFpRw1fv2xKl_xKow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E7bgv4BL4qyXmhRjzf5H51JnnXqgdOfRtdtzMtiBL6A&oe=6A43B781"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjA9D_idWacQ7kNvwGyHYB5&_nc_oc=Adoj2DWwoQV2j1GKZQ3FFxE87uBcO3vMbmnuf_B-o4AmGhp0meul8OCnd6Xpvih0spg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3mEWjiZaNlq1w4r2kRhvN9vocq1Phu_oW2BWzCd-WAg&oe=6A43E316"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo8FoLUuDEYQ7kNvwGx01bO&_nc_oc=AdqnOi95IEx7ItvzHc-KgEpGjDVnN_5_M9fpHcYPgDFTajWOYMsiqu8ZjCAJJ0Slcc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eoxRmfvSxP6-KhZ3nDWT8qdDWqUa9k72u08IlbLsyXQ&oe=6A43B858"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S5_vZKyEfkQ7kNvwFTMt_5&_nc_oc=AdqC7LDsGHjiMFZhp3u_s_xK6H1z8CYUCccyIZgPo159gLpYrejl8_8vjbnowP-3vR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GRX11l-4bpHGigggbteYZNvZXolPc8JXAu-UuVPk3oQ&oe=6A43D2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hbt9zJO5EdoQ7kNvwEYR8ai&_nc_oc=Adp_wnbQJZF4MPqdK-JwfswGWZ-oAYQWPU9jMIghJXp4dZZeFHNA7_Ai3WZlqHPpDXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NOoSYZPwO36cHya0JvPLd46UJsCVBqnZ1RcXEM0pnPQ&oe=6A43EC99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
dn.com&oh=00_AfvSRO4WEfODf7EYNKXHg12RlC3QqFarV2myk3z0z1WX8g&oe=69A2E081"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88GTWZhA_kgQ7kNvwHtxGPj&_nc_oc=AdmLn7NtfAtHtiV4r31_EfOPoROdHmM-chdAu3B4l9v3rkJs3052VM3rH_5O-t0o2l4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftncCMScCUFInTi7tXqmfUoz3d-Jt9yVUkadnLidGiF7g&oe=69A2D3D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw4s82ikX6QQ7kNvwEtKvf3&_nc_oc=AdmNO0eofv6dcG5wlnalbuWF9cxng1TVa6U7ELfECg2ZpEWVceS4DUxJe-0Kclrjjss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDFYrEnGKYQ5EhIt2RrZQ9BHVYaovNNScgp7JhgYsn6w&oe=69A2E158"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM2avogreFoQ7kNvwGCmVM5&_nc_oc=Adk7AuAbDjMUHcCRf_dKw3XsO-JChdLE3zqC1efgy4Bx55C86TiWgv_240SBB_O8NE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft998Gm-rz2OvPDDzWSFQ6dJiUwbtZybBJ5i7VqkfCFBg&oe=69A2FBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQkYlv_P65QQ7kNvwFiF73d&_nc_oc=Adn6Vi2oBSbh4iePP0LGsPXPeFkb0CZJZbgxtzHRnIisA80navZ2Olu81l4a_RZgdDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmuHmu1PhYnrttwzpt6WuXlrziHkUb2gYIf9py9VdMKw&oe=69A2DD59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT"
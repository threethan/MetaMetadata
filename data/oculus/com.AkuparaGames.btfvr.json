id=6e7a0a&_nc_ohc=ZjuAjOYuL2AQ7kNvwEx93ys&_nc_oc=Ado4LIWj-FinLOrCRqCDnpaWLpgB09JP7usang4b-4JJxFcQPjI9cdCmZP83GXpQp2M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfRU3I6n2YWGeGNo-66aEr5_zvGK2KGzHJTlkqpin1ww&oe=6A81AE01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm37UAExZs8Q7kNvwFWrPk4&_nc_oc=Adp5rVGmkJkZTWFqDK_pFZDCcv1_EXBkgLCTAhSU6UCHhC_QOtR3qMpr7lLBR9kQ6ww&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQgNWHahhkRSFYe6n52TQnu6Pzq2McPeaV1VzGaMsQZw&oe=6A81A156"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyB4uX-MqWUQ7kNvwGx7U1k&_nc_oc=AdoO5oDYPYC-8TN-XEvrPQ_h-5OotFUGnQFZSf3EUIS83Nuyk5MtVQDMtKc35trW_z0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrs45bWQi1t8dqAbokUABKIF_gMM-uAc7WDxvs2P7e5Q&oe=6A81AED8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7kxfJZZ6Q0Q7kNvwE1F-V1&_nc_oc=AdpduMiofCpU1n-lJHvFbk17gR6CYoroIdrhBweHZ-PJjmKIK547UpcB-4sfalzK5ek&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtOkOp1aiEzuLFv9YRCDaS_sZsuCZeVq13kSKqvN4VYA&oe=6A819138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gBdXn1U7HMQ7kNvwElSE81&_nc_oc=AdqT4GEvBGUjM6WlRBXBcUe9a35lKKychYf5Js6BAx1vtZuW97rPyrZ9k0eB-xt6VBg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSo-fNfinkt2InJ2uPF9Z5oU1Fmf0U8cTmH2CwOZ3IaQ&oe=6A81AAD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
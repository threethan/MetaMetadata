id=6e7a0a&_nc_ohc=RzHlemoNSfAQ7kNvwE7YwQl&_nc_oc=AdpGjPAYTlIl92tLEYxXxe3BLHcy6R4IET9SHzvrn0z9qYxci_hP-oBSv7dcEkwpaDQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNqCgtG4plqyQoPYSMCq0lu12cVBrxhCF-lefVfon-NQ&oe=6ADCA581"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8HvwqM6trAQ7kNvwGViLns&_nc_oc=AdqfrOekVFUJcpPhBLlXLSG4baM8Eaw3bB-g6vQEGL8VTSwJ1iR2dSXJu4gMckyaUWc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXUaRcggGgK0TFHUrGSg2fNJ2t2Y7T36Fy7d5cFeSeBw&oe=6ADCD116"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xylmbJmTUa4Q7kNvwG7Vz4P&_nc_oc=AdrwoYXLw4-GVIeaMUV_Q1NpHpjdkdNBIKHOkEHt9NcveqKeEKyMIIk1rPty55tcGrs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjjUGYkDL1qwI0RHdnsFSYu9K5XKTUw6FQWjm1ExaRUA&oe=6ADCA658"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs3D7-IKL90Q7kNvwGLSfVg&_nc_oc=Adr0GHtNkuZ86Vc-QbTDILoEosKZum5y-Yr2imojDcqpxeOHvvq8VymAsDRzf4z_Ims&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdyJs4jvMEJcNbwChmuHT6zwSpQYiL_Sn4vc8IVEktTA&oe=6ADCC0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L8MR3MW9KgQ7kNvwGv24tk&_nc_oc=Adpj26pdNiz6rxyivYrRp6ESRJJvGN5LugSQ90WDHpGKV5Nr_exZ50hLwRUumKXa1zU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO2EI4r2a0w3dvPceiRqFTd4eN78nHsqWM4rKocZR9hw&oe=6ADCA259"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
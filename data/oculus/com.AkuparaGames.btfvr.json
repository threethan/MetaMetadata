=AdnjUSPYaHMw1JReVvqprgcww3UXF3ZBh2VP5ZpI9aD5QkJjnRQMxAz9Yv6nKrNG6B8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKvs7GCJLT7D8oy-2bnvHHgoZxA8LvtwsAyKdhBnl1MQ&oe=69BA9B81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8ofiOaBSVgQ7kNvwF2cqWL&_nc_oc=AdkcCywJLWWVeqhiAwYtmgqc8k2znLawMZjX6ALl1NmgCkpOv7wuXUYY3MbhJr4Yq3k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfrrV569m8Zt3URxEcSuXJTvZQzL7LR1z4DCldoa2G_A&oe=69BA8ED6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztA7ZOYNhqcQ7kNvwG9QlEn&_nc_oc=Adljphwp8IE2G8g3xu657Tj-CfF9qcvkRRC_P7lYonqn-nB5wbF_qmiweX6gDBESP1Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwl0_5M6J-TLdBaOFcFHMy3AJO_F5nIL-sxGvmyiDTtYw&oe=69BA9C58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_dSzXjxbq4Q7kNvwHl-7AF&_nc_oc=AdkS6jmsT9dbrRX7P7qGBY6LiI3qmGwWhdhffae0UNlOEyI3ycsaQd6eBRx-MeBDBWw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDlFHr-dul2ptZ6Ri1vKNqIkXHXrj72lvMWjO_tXye2w&oe=69BAB6F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3CWf6zYNsMQ7kNvwHt3Ad1&_nc_oc=Adk1yyO3vtaEt3TDuMycpSCmxf-ge2rEoFyd2LzX1-5OmcwZMLyKZBSOUNVvxtqy5h8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoSKaopPgQu50QxANgfHldWf2NToO49Ml0q1rgGNDSlw&oe=69BA9859"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"
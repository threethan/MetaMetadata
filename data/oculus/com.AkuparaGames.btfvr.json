id=6e7a0a&_nc_ohc=5T4I76L-ZS0Q7kNvwFyZ70a&_nc_oc=Ado3nEswkfekX5G-sAtUk7raZjpGLKffYT6btxzDTp4vbO31ubwpXcqFX3QuflBMsb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjj4Nb61ryR4C7Cwp_I3O4zvmPPbfy9KP6PWdLxiEJZA&oe=6AB12401"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV-ha0qRdOUQ7kNvwErAfsA&_nc_oc=Adox8ZKZKsFsDCetgfvNjBpRgbJRQe5Jd6KmeAPTuVBwhRjgBuE5YhdEqC6T_adl8Ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJDx_SS95gk8NlIhbM1SRLUX4XV7jmlCgGci-lI2O4hg&oe=6AB14F96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMUdsmR_GrQQ7kNvwH-oN3k&_nc_oc=AdqXK_KCezcXKIiIzPGmZj0POZD6ucF_KqjHUAHcQ9dml5VWto7dPvRokphGVtfD8vI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9jBYTbhu1Bv_QNFIgXWAhgETtI8TYc7WrX9UUzpc9OA&oe=6AB124D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcP49pYhq8cQ7kNvwGHI4sZ&_nc_oc=Adr204R0gfnnItdfPKttfuF5Gi5S6TLJeSkER5VdWSlKf7QtTzMLFEWYyEm9oL1XhPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYIoRpfmwYmKYFddRUXqCINw_fTMFL4cnowjUtYxhT1w&oe=6AB13F78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXpBI8oCoRwQ7kNvwF9JgQl&_nc_oc=AdqtwiQwX497u05nE-rtqK_PQirSACyelV8EF7j_l76t9JkXLibX77TAij9Kcaw6ojc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ISrqLfVCcCeer2QwMq-lFZMGtEoIGbdV3_8Bcbb9qQ&oe=6AB15919"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=9UlcuaE9qVIQ7kNvwGmsNRs&_nc_oc=AdoMrSvSKlv3VOhmXqfGbeOsBTQWT8ar8g_n3NNXpiV21kUZjtQHuBAYV5Fqz5tQuuc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA50xRGsqs_UwbW3w8bWKOBgfR8enlzUj2q43e1IOlPYA&oe=6A5B7281"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBphiFrGOewQ7kNvwFVwEry&_nc_oc=AdrXdDVs5bN8YpByh-ZYfk_K_8Vc1ohCag0dPrYtXEpSte9grjGWy9DjeUd2slCxvvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfLy5aoNMQhbqxZBuFjNIEUDlFxJVG32jtd73XwirOxg&oe=6A5B65D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8rDO7-WPAMQ7kNvwEz8VO7&_nc_oc=Adp-Jj0Zn5DN8Hod3Z3b-LmtRCxM0jcvKizaa-_Qm1YhUsiAzOLrGJYyXq0MsNqyYJU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9tnGHJpBamZuw32y1Cx01qAcfJDE5dDQhVizR8tO5TQ&oe=6A5B7358"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aE_pYbn9O2MQ7kNvwHykT4x&_nc_oc=AdqxlyVTQ9YNwr8O-UUauuGjK0pDdjxbWbXe2ugJa8wKvvaxvq_94dBJ4tzZ0LzlzhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs0I_0F7ivDyxTwDoRXhcrB29o5q6cRbnnEOicNN2nzQ&oe=6A5B8DF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLiBfMUV2K4Q7kNvwHYDzHH&_nc_oc=AdqfRdJBBD49J9DVGmjqUBqH6hpX0nkf1GXItpy8c_lF8BlXnhV3HeyMgqZ_LO-4-Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD-3y8pfDAqgSwVXw3vBCtpVshna-usTCMcJd1Y_cKoA&oe=6A5B6F59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
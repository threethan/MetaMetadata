id=6e7a0a&_nc_ohc=DFDtvhRvYikQ7kNvwGD0XTv&_nc_oc=AdqwbK1Fm85pIO2E3bxWpK_SFoz8bivJJP6njJ9h1gUtNAugfStcZ2-R4ys5cbBNdkE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jW4kuZlLTOcmjS0x6iW7ekmK85CSn35lT4pmPrVegHw&oe=6A2FF101"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWibbgxhLdMQ7kNvwGb-yuA&_nc_oc=AdqWbrHf9mCdSkGlqMz-qhN4G6Dd2yuEeshWXyTYwDXIg2IgJuKbVD5-xplc7kUpF2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KL_UHToib0itwcHEMPjJ5GxnQBM5vs1ExcmsMgWEn6A&oe=6A301C96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaD5lnaz5Q4Q7kNvwHhwnO6&_nc_oc=AdoYF2t0RFRSBg-BKdQCNN6EWtyc7TFu17S4NiT1E4oFa03GIZOpTdwC3i_rbk-7nW4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NRr3zeVuAYIbRyxHGjbTqI_cKSr1gJVyI-KVzJUt9xg&oe=6A2FF1D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFLNtXvgpvsQ7kNvwGoUQuq&_nc_oc=Adp3bm7vaKAWqBeeBBwwv-gONd3eGo5Bsk06ih4t3I5gNHKxdz-1NftCdumfXnni4Qw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FupkxJX9KZZobEUmxE0txbVYdQfehu1aJj03T9bKA2A&oe=6A300C78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79oUXZGHoMYQ7kNvwHbYla0&_nc_oc=Adq7-pgKb2d5dmsl1JLhInc6X40KgIKimu2PKm5ccbZ_Gy_bSrRYVTawkew2AjwVfoI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TJW0Gqw1OY5Iqu3IUWjfoI8CYdNkxraNhcWQ7kwPOow&oe=6A302619"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
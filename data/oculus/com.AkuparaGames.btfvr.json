id=6e7a0a&_nc_ohc=1YjRtj8xMikQ7kNvwGRFcPI&_nc_oc=AdoIfs0FmwhLd_KF4JN86Qjj2Ale62yDv-vy3sAjb91cU_GvfT5tBf_tBGHK2_f9f4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlVgLXga-dglx2-8FeIZNH5DK-q7PBo1k9QUQsbdewXA&oe=6A68A181"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuQg4-YxBe8Q7kNvwEAh561&_nc_oc=AdoTuigh52NbrSe4LWtZsa5GENqhp9Sm_TrOJDruxjnQ0ms1T86TsELtS1pAquNlBNM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmJMG1Yu9XWf_AKUN6pmyeO5Z-YbZ0AbyZhRd2CMUGCw&oe=6A6894D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wox-FoUZx24Q7kNvwHBbscy&_nc_oc=AdoFsN1VcndiiHTrw27dfo60vtWzSHbeKN7VaC52Iu-MTVCPqRfWnvSzWK8BEARBdEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjD5v10PqlQtSTIkOso58NZ6gV8zSW467XsnN7dinNkQ&oe=6A68A258"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5s3RzefYt0Q7kNvwHxKskR&_nc_oc=AdqaMNNQnweXpGsrGxI9KbY9cQr5UsJ8X6ozD0qAR6Jm97C5lrwVFLp6cwWt3GLN79Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGFJ11OMvMJV_PB7IHXVgb7A4bItW1rabngPBR-51-3w&oe=6A68BCF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wih1oBZcKfQQ7kNvwGm7qpt&_nc_oc=AdrgZJSPaZ9a6NdSyAcON48BdiUVyEZ6pZz2AXQ8NvGYQLxrFw26OeDXhRUFme96fvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBriTA1kttfb9oNg9P_BS2aqQ0D4DvpD5Op1Xmo_nuHvA&oe=6A689E59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
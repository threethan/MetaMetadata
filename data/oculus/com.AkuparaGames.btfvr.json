id=6e7a0a&_nc_ohc=n1L0MxnPeZkQ7kNvwEfX7Vh&_nc_oc=AdqMC7Tn03SKug13hJ6uwrOak9PLqHbhUuJXY1N7h6WfUzg9oXFse49ngLW7UTkGhE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKneFuaqNMxZvH9oTaYmBma6aft22j4H6V4kXAYlnAeAw&oe=6AB66A01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZC9DeunUrUQ7kNvwEqArD8&_nc_oc=Ado_MyDc4mBcPYdIxfJw8zxn7i48dkMah8DwaTrpV7W013b1mAg3Omz8v3b1Sh2Y8DI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbKkFxNZr2Zf9uKtuTvjEdOy3E-rluQCC4IcflIdY53g&oe=6AB69596"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXG6LMyrWRkQ7kNvwE_9v98&_nc_oc=AdpG0rWS5GGPegCIKnj0nWPXCMq6HOEgpJq9EGDkFFtauYvNrLOGWf0XmwkPBT0bw5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJro0bqhkNCIIS7_Yoc0gap7uX-0TA-fAohA0ZPb5Jo2w&oe=6AB66AD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJYWTXUTSLMQ7kNvwESZiMJ&_nc_oc=AdoYLm5pxJ_XWHamJ0EO3kK9fkxEc2TKp4VF7MExzPz9KVmU_m3prkCm_G6uObw4Zcs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1lwb_W_dgu_75j9h8NFPz9zI4_Mf8wnM3E6T6BATa6g&oe=6AB68578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBeZ3dfm2usQ7kNvwH05hJD&_nc_oc=Adr3gRpklJQZ4szB1gqsRmT91JcUGztEAaSebdwOqQzQrtk_BS-WSEnokn6Br_toAvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1J4akISqF9pTJWdG9YgZD_b67tmhc6i6PADDxMouELg&oe=6AB666D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=qtXYO00FXrcQ7kNvwGhehY0&_nc_oc=Adrv1Yn3jYgOs5LkJLbN2yr1oHRnug1D4TQFVgLbsr7aZCRpnHUlKVXPm83gypr2-YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1j90Upeegi5shmmqqisqyONKlXKCaIBR2OUca7GW16w&oe=6A69F301"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffx3_Y1e334Q7kNvwHV65Ki&_nc_oc=Ado4uaeBKhqbHrM8KS6j3EuzIiz1fsQqdLj26Cae8olWgP3er1q20UlksZgpnsX9g5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMTvkZ99hwEUa2UoZp4aXZ7PwAZ7JXI9iBGRIdQIMj4g&oe=6A69E656"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6gXqmIIpTcQ7kNvwEX9ghk&_nc_oc=AdosY3d0pI1fVGkbdh7K8nfjW-tfaQZRdkuJGXHwEPLy7pFcN2EtBUtjQdH9JVgZvxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgoEFsG-EyXiBuI_nnde7zFbqjDTKAZKbm3GN1KtNSRA&oe=6A69F3D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbexTd83538Q7kNvwEpwS-M&_nc_oc=AdqQC4KI5go-rph2HYwSWSjd-k6kyYSPU5cdG8GP_isyHD1YDNFDnAys4i8qYCN7uLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAMEE26HezT2df353ORYnIy_e-VVItMGVYyXYi4ZUwbQ&oe=6A6A0E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wih1oBZcKfQQ7kNvwEEAlOT&_nc_oc=AdotQw2KG8fwr44430RBR7QF374OahPJL4-N8h-8_1EqY4vRvetAkMv3YCZMdNTD62Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3V_97Xu44inE9--kHYRpfJH-U8JeqlZ79L7O1-J7D7A&oe=6A69EFD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=w4UeaOvva9UQ7kNvwEoi1g0&_nc_oc=Adr7DJV2UT4ZI2qQUY0-TveX5aic8-rL8tc12lOIrM2Gow5qOAxjrT6gD7LqKvqaYcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbVrY5lDjms0MrqRpOGb_lNLYbs9_rYcG2dVHzvrJiSQ&oe=6AA69801"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U2FG_LXoSQQ7kNvwHBrJxj&_nc_oc=AdorkjM9TYztvOGX4N5Y6UMH0jd1pt3FvFG3s8PP13x0D2ft_nxVb2C7aFesNzHJxEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9-Wfo9X5PBivl3B--he-mzD0YOm6wRO7KvDyx4R5zyw&oe=6AA6C396"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q98_holF8qMQ7kNvwHjJNtL&_nc_oc=AdoUgWHp_D8jpDdHEbS8QIwIYfEgJSAyY9GC7T4iYkkUJQr8LP_SMhQC13bNxJD695g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhZgL_zhVA_ej1gdWzrOsFOkP9-3qdvvndImJ8o3Htgw&oe=6AA698D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3dWhh2VELcQ7kNvwHD_fti&_nc_oc=Adqnl_bveHiVCURmZlPl8p2l3_WlbToU-_hGDXFrJyKJfZzmXSqH2OFRvwL6sx_dxCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1UpwjTVmjv-R6UFAp9pO9z_pMSTJ5Ho3JUIjnqOb7Aw&oe=6AA6B378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZpBx0DwE3IQ7kNvwGdstqU&_nc_oc=AdpNkb9lnxmis8DW0W8zb544FbIhgMPinoGpAccBM05qDwbA7HHYIjPkYY-2ELPDOuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJigHPZWZj2ZjVI5DzbnZsaMBFrI7NVq4AatjQz-4N1Jw&oe=6AA694D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=RfUqfNimrU4Q7kNvwHYliV5&_nc_oc=AdqBZLrErRMAGOU7FQjz2rbn3Gof0Hhi9o1KYbYsr9bCIYKhdibxZQCH4_fi-EcNuIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YJszF2T7HZH7kb8MJqTKRNW5AuVhWDWqLYjm7X_eNmA&oe=69F9E381"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahKc2ZRT7BkQ7kNvwHxCfKf&_nc_oc=AdpP8DwRjKRCBL7YpYNR1_VZaCQmjhSRqGlQa87DD-FnbBMXjYiUrvFDsnV2ptd7HQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xe4Yme2_EJ9_YFZyR238tI2TVnL2Euc_jCElMQgyTFA&oe=69FA0F16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnmuywHYIaIQ7kNvwHLWBhh&_nc_oc=AdqANpKX_lXuz_AzlrWCjM4LP-uLZTuXdfSdW284rko80a09689QK94E6tlPoEreGww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54e683yh1li_3ttF_uP0GgfYmjSX355nI0NtODqWwTpw&oe=69F9E458"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0IGFH9Iz7kQ7kNvwFaK3Sr&_nc_oc=Adop2HtOX_yFKALKkfowfgqwG900FhciqnMWmW4p4PS7EC0HrBz81TFJbuSF49f1Dx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mbIz1XMOBVYZEyzQaEaao5LpvHB8LYETAtwWSr5W0iA&oe=69F9FEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcJL3aVH5p0Q7kNvwFliIkc&_nc_oc=Adq76lH-6KdDbbXuC0sckXMSyrD4jkVtKWTlfqqTl2TZsuVE_XY9bosbxcrHUdL1b2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IAcxQEoBKjXpT6G8eg6TLH1cDsu4W_O-BJ87J6mzLfg&oe=69F9E059"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
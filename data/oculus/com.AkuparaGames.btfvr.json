id=6e7a0a&_nc_ohc=6_dch8wtsN4Q7kNvwGHsOMt&_nc_oc=AdriX4L9uciu_SGCkLizHdYu_Ve8EAPYuZhHPy-bXlrPyFuHm7xbO2DQnjk1WLu9yKI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxwMRCrp-_R6036E6chpqR0bBlNWBz8tOc10Dy7j5t_g&oe=6A918001"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPs0yven83UQ7kNvwF1jX8T&_nc_oc=Ado4Rt2JFX7xgiQLGRHti7bCnbGEp6owEcEu0143xwbRBDucCythSDFy60Fm7-wghkE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3iGYgPpPsgLJxumaVkEhRlkiOhQB4Fu-A1F0WKbL4Qw&oe=6A917356"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=276AiwEmv_4Q7kNvwFv7Iie&_nc_oc=Adp0_xKHTXa6g1QnLWU4Mn-LvXTpIfs_FMn4yZAJNWsScfWiBnmDWlorVvd5MCDNgS0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAUbGEnhuPGEndvXVCXLyoE3lzWYkES-pjvoGjIPgLkA&oe=6A9180D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGnqFe9E7lkQ7kNvwFblOdC&_nc_oc=AdrhrdKq77XfvzJRrwZ572s5rn7fwYA5TESv04SXyl2T4uMVO-Jrt9oVMQicaJkFwOg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHutqDqS8kjC7eFWoFePewmoMSdjgD1bVvpLxthFtNGFg&oe=6A916338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jMCKUGanIcQ7kNvwF2Nied&_nc_oc=AdpM_YSlZJaim_CxJi6c8E3YEa0jyubwk7PpML3g5fdJcu95YGHtRf40mQeb9S-bG_U&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW6WD0STGHIZRNC8Ld_sE1X6pbgSHs6hsZmyXnQEhIYg&oe=6A917CD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=MoyLr7f5XuoQ7kNvwHvuOM9&_nc_oc=AdoE8SaUaIpnmLeyoxRqIFECAu9LekEJafphD1jHGTEFb4kUGDBRUVTRgmsGMw33zVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1vhLOTDEv2yGcduhchwlm3eMbFaMWyQq4uEdhpjzpNw&oe=69CFB381"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGxQciC9z-QQ7kNvwHic913&_nc_oc=AdrfTYtdgOF9HJWIx_1IOXzPPHkZ4rI1Ykc5AuBy7alIBASXVc7GSZMqf8Neuw2ulHY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeidZO_gvZdm4xX1XB_uYU7trDPq7h8DybLA5AQmyMQA&oe=69CFA6D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvNXop9EEv0Q7kNvwFbh0zs&_nc_oc=Ado85ouTn0yK2NHWv2ibsNCBrUsHah88b5f04l2FKAVBaIHz7wpXAT2sDrUDOaiI4bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoeF7UoECVUhGt6WvHIwe4NDc-CocI-c6jKElzZ2V7PQ&oe=69CFB458"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwO_js5MpAsQ7kNvwEMtjF3&_nc_oc=Adrex5sOAzsxUdY3fMSfQe7AlhV8LMSp0EegY36kJNctlqwkW9w_WO54_DPg652vyus&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLF5YqIetUoG4ScO6u2vRvoa_D_GVqKFHcSPEhPg8XVw&oe=69CFCEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR7V2Wl8TfEQ7kNvwFzNdrk&_nc_oc=Adp66e0ECpk2C_WFnGuzV7yLSOn9y6XCupLwrjJ2QZZIuygKHLUAUaBS3WjuCTpm8P0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHohf74s8UW40r0Lj6Gf2f8dCQoclqq5eUx27iBGLHLA&oe=69CFB059"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
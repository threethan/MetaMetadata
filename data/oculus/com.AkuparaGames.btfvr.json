id=6e7a0a&_nc_ohc=9UlcuaE9qVIQ7kNvwHb_0bu&_nc_oc=AdrPqnulyn_E-qdPIrFq1CWniVeh6nQ6K1Y3CdhPUG0WCEHT1p2QkW-z3JbQ5Y5jrOk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC97gnOfjoLlhQe-x7CCTLBq4yFVGTiC9YPgUj9UoqIDA&oe=6A5A2101"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBphiFrGOewQ7kNvwF0lj26&_nc_oc=AdoQI_Yx_LJnjLYJQRRhLb72FvrmyuN5lMNq8OLiqt1uSW2aV_YAkSthYgXTN43sAK0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYKI39TI1-FPnKyFe1b-nV3iz47G6l3p2JHpmealXy4Q&oe=6A5A1456"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8rDO7-WPAMQ7kNvwG67aKm&_nc_oc=AdoUh2OeG97Vm9OQzy-ag8X1kVpp5_EHX62NFa8sRbqeRhhRYDt_TSMR4yjqRAMkuF0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN29UlhrHDPtIzWmYQGcnQgWVhnHnAyM_ChQh9W8hY0w&oe=6A5A21D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aE_pYbn9O2MQ7kNvwGunChI&_nc_oc=Adrgxt2wmSs2PEgU1Shi_Umju043RTW_y8qNS_27ehWWv4JbzwI6JiundnVZg1M5OrA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYxMihKr1QchpqoTJThA1NghoRMyqJCmlFntwqUjBvUQ&oe=6A5A3C78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M_3LFTOS0kQ7kNvwHEzzfV&_nc_oc=Adq1OUH1Qfjd52juBLIHn_3yB08QEhNIFFt4jXe0JSQC8L9EVLuKxJl5-B3yHvOolSU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkEwu7phkXbo-ChhD3b_8jDNST0ph_p2UVKZlNI4VtRQ&oe=6A5A1DD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
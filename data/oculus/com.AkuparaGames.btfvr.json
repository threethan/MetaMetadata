id=6e7a0a&_nc_ohc=HBqT6v0NAk0Q7kNvwF7pAc9&_nc_oc=AdpYFzJRL4eV92f2HEH4Opdl-P6uWd-3B7GxN8JfEzz3qjSD8DJrtO_hbtQ559PwQiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGq8xfvT0C3e7cISMVl5SPnFhrEJO-DB27e9gEAQUHpw&oe=6A71DC01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbcfFXb0sRkQ7kNvwFgksC8&_nc_oc=Adr2dswHxm0tnjDKBgZZskEyQ0G9hfM0yMuNHbHUgMwMDK3pKWU2V8wM8ghJKgwV9J8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvIYTAoiBDcH6alKLc7_AvjPQjCgYOnp36SUub4hTSOA&oe=6A71CF56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-8Q3NajC_AQ7kNvwFOAysy&_nc_oc=AdomMhNT7KFtc3QvrtWp0MZgTwrYOaXSbhqxGUM7ziWIBYB8_t_fMlETTaI5ZRXhvtM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6DenQXiapP8ie-2G3Ol3ttfOpLBnddSKu3_2vuCgtgA&oe=6A71DCD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKDxY_h7tOEQ7kNvwFrs6uh&_nc_oc=AdqFeqiELa7jsns4is7Tc_Tpc6Y7T8eN0QwkhavzxPcCImmxBaogTGf_41FDGzVFeW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvt4wCrsG3vieGdqjtPp1MaJIVuvZQYj4u_pFC0yR4JA&oe=6A71F778"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns4BoSCXWQwQ7kNvwF-YHBl&_nc_oc=AdosoZ8VYHXEfwM8UDqU0ILMjDIQz7ncIsifzXfCal98xji-Wj0wukGwgSTv0E9zKSM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElBUK4rX9xEtKwXEDTBw6_Srf9hLNfarO4nkX_-1nzzQ&oe=6A71D8D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
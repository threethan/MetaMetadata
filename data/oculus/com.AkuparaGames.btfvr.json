id=6e7a0a&_nc_ohc=jGYFDPOPZGkQ7kNvwGDiC26&_nc_oc=AdqLd325hwm6qOKvTzL1UwwBZCUNmOrb_B_UN_IhtOGaUDrMMrX3RU14lW13SJngm4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf9ND-7xSb9fESj5DSqVE2iH3TfuAjreeZprxjApxQEA&oe=6A95E501"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgvvYsPxBl8Q7kNvwHfUeqO&_nc_oc=Adr8gAO7TK5PZCXScy7X2NyG7xJhAtzEvqQkc4XmZ1pD8_d-qRJgs_LmcHP6wNZqQ00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmD1B4OVQCCpPmtIVQqmdClOjU4q7-16f61gJmQUn0CA&oe=6A95D856"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzmir8tgHqIQ7kNvwF5-IS8&_nc_oc=AdrKEai1KU6V5cfkLjlLFhbPYMS60si1z7ep9FKzEWPyP-5A8V-J1OvqSkth71d9QW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkoYqY7fmWzCVUsybIv0QhA2AgXr3Cik_WSSh5DLjlpQ&oe=6A95E5D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfcauDCSlH8Q7kNvwEmDGPz&_nc_oc=AdrABlOvUSufnYieNWwSbXcQLpzM3O8aG3Cn4jbATMOoCdLj4WrkvDYmMzvw-qCB-9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPls7Oi4qwz-Zr0Ztn4MOaR_F9fr5w0Tq4QmvafSfW7w&oe=6A95C838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uULuojnQyHwQ7kNvwEE4uwV&_nc_oc=AdqbXoyx1v_zlhzeY8i7I54FN4OOXwBSQ5R-WYa256bgB_ByfqFIf9kBV7h4d_H8yYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfLY3CXHacuYaIVZNnRuH-t8K76lY_yY0aSjd6qUih_g&oe=6A95E1D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
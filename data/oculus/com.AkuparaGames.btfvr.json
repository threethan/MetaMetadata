id=6e7a0a&_nc_ohc=qv-0SC7vAAAQ7kNvwHYC2HW&_nc_oc=AdoP9D40zt12bgWGs53hsDgUT75rf-2cmw56OgUorql-QN6ayrsJ3YWlaj9Xwm8qDWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZmvP2T2T98x9e6y1qzYCpCSHU8kvbAv-MIf5kv5NusQ&oe=6A99A141"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kAHDTwnbj4Q7kNvwHU8O0M&_nc_oc=AdrIM1qI07OTd_idKXUU95xIxmmAUdhN2rSIiGPJdp8oibbfiNaOjZyk_A3qVTuuxBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqI2QcvkGt_KG-wHPcgkeLoa68mmP_mWBJev29oHK1Qg&oe=6A999496"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXM2i-UM5fUQ7kNvwG4vnmH&_nc_oc=AdoAVdCazlfj5KRpaxloW_YV33ZOuiZHN7GsdhA_874KSc36GAl1jR05-x3hnkaPejc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbqHZkSGd93j0R9hx-zclo2Nhn99EPayuKGft8tmdXfQ&oe=6A99A218"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDBh2NOp-iUQ7kNvwFh_JS8&_nc_oc=AdrHvG_zXzM8yW-wGSqpqjiOzqH0h0VvqxE1okIuZ8yD2KfDze5FeK7D-QzaLUcuWxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8iuT6MPFJg6AM7-NeeM4sOvAXOZPmZtUAq6PzJf-3Kw&oe=6A998478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NITJS9AU0N8Q7kNvwEOHykE&_nc_oc=Adr14vUQOXdMxAW1sQ4Wy_bEoN-0nerxHz_ubsQzWT_t3EeZmA0MxBp4ENSN8Wqh6YQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzEiZwKgr4-_KzXIpsuzzZcG7NrrfHPqTCFtEGekdwKg&oe=6A999E19"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
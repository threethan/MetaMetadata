id=6e7a0a&_nc_ohc=yAaZoKJpN6AQ7kNvwFQhCj1&_nc_oc=AdrypaZ1NfvMrTUAKOGsqYQ7yElDnxy7-dKhWbNjNhi7mEswMnXXboLpGmWELmjE7HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbMjZDlLpMXOt3zEOzRx8gmSjkN5SAAeG8AvDoRTVd2Q&oe=6AF73BC1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruTa1EmiZbYQ7kNvwHevQAC&_nc_oc=Ado_j1zSsOhwjR0hs0VslNgogT7640kvcD-i0q9IhfMZOZ5uR5oWOZBbXy8SxKY0FPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAL-uLDbWfUv4XyQ_jv4ua4rAvY0T7Q69GbFiS_OPV2Q&oe=6AF72F16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcszuBgfAh4Q7kNvwHj_K9W&_nc_oc=AdoGsK1cYchldSLVXTKsk1tPt4Voc59OD3ep1ulm5l_JRSrGV90tsizwMzOSdduoV5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRibwMuBvwBNaRF1MHEGiC3BOx1e5ddR7hjtQA4v5t2Tg&oe=6AF73C98"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNfN6gV7YhsQ7kNvwFh4hVC&_nc_oc=AdoMvcvZybRIckF8mTN6A5Wqu4-3hKokombwrMRmGsQqJuMKH5pBixcCpWdGFx9MoYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA1yqxf68CWvrBmaAF82TpwuX8t_iW8fq_fFatL58MKA&oe=6AF71EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpzUsrQ06s0Q7kNvwGHv--W&_nc_oc=Adq3jLmB-ph0-Lus22Cia2No_UelfgGeWHqF9Kxk7szuJuXuObk_5N6CuZ_GcvgqDPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvaQA-pQFsI_aYUDt8PuBddgZ-hBD7XIx9M8k0ZtCqdw&oe=6AF73899"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=CWWhs0mfI7QQ7kNvwEr8keE&_nc_oc=Adrj2HlzThHuH-w-inC671HVCgby3ZGcdokv1seNkCq_LJd3mqhPKJBHmziFLu_9fD8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsn-uZODrDMNpLAunDr4E0ry3AxHRyeyddU3_JPWqh4g&oe=6AA15201"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVVsAb-SmDsQ7kNvwEEYdDj&_nc_oc=Adpojom1MH8IfhN-6i11Td2ckP1jZyaWzaBp_R3Ku9YjnTlorvDlESSldZd0oWkIrKc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7DRfVllCZaCRX5CdVXZHIQDklRAwNU8MEHWI7tuu1Sw&oe=6AA17D96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbwKYy1js8QQ7kNvwGjUO7W&_nc_oc=AdoVF7zEFvDwG5shVDYu2uMWPIvvggLfL7SUJ7ojn1BbGayXg83Nc5eCIVzxg3olshU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2NOOjkgHOdFoo0-hP-F1dSCdb1yiD8wBoOyUv543Cng&oe=6AA152D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALFA0vazOTEQ7kNvwFO6MTU&_nc_oc=Adrun1VzHrfUnFbbyq7Ocj4xaXnwf5ALTM0gRwwYllGzFON24VPyJCMekTG7NNEPCwY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj9-a1v7B4XimuUWWJ4bkNTRppBhelEQwnp7A5UzQ_RA&oe=6AA16D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-e0-vigY8wQ7kNvwEx6nGw&_nc_oc=AdqgEnjO50-jKZXOFQxtbiLe4U0UsfgGRQL1nS4kY3EAZnPN9rrRdvVGQGI7Pjxj0uQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz5tI_ayLXA_wkWbSoYYmrtEEqcSlRkkrFMDtCYiTe9g&oe=6AA14ED9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=z5EWrDpaYNQQ7kNvwGWdNbK&_nc_oc=Adob0pZmaXpQf406ZZ9TkEXafSBa4AmH3APtGK21n99ELK_ZejPorJqu8x6c_qiOGIw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhS66pp1d6vtRHWDEckaK5jlxNtQtNFnaGXVi7yCc3NQ&oe=6A58CF81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZD40aUaMDMQ7kNvwEbYGuD&_nc_oc=AdpDvX2L7RLVf6k8VnIhompYgfkSL1ylgLFpnasDaQZPLddNR_nOjNWFpiZpPSzZH38&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3J7AsyjiJYQ2K1AWzyLrAbUtjaX07yFgzqMH62SHoOA&oe=6A58C2D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyIPoX_7rlsQ7kNvwEjo7Vv&_nc_oc=AdruFAYhE9_IeNjGUbRMdU5Kohn5KC0qJchrNcNShuuLdnI20j_0J_omqUCF1dirwDQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG8yplnwGK1J7tdyZDLKT5BXh5WbA8j0li0mU08b_y_Q&oe=6A58D058"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPah5WYM0PAQ7kNvwHrvcSC&_nc_oc=AdqxUfZuaHkQL7vMEnwNylaRVhFMN1ZxiLN4hvETcOBf7fsVmoERCccU6STu7ToFyco&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFeYkOo1EQGzI-TFtv1L4AC_XG37UYiEoEKzARuxoKVw&oe=6A58EAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M_3LFTOS0kQ7kNvwHNnR_r&_nc_oc=Adr2zAnsjEy0wup084umy3HaID6MCzxi0Vvoxb2e-FPKgNQN41IFLVDMr1x8uhcUV8w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt-A5qBpijFtAI7VclHZsUXlPtfKR2Mzair6VzZYD0HQ&oe=6A58CC59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=q5yGgi-sWmQQ7kNvwGgwTTR&_nc_oc=AdoeAy6c2-8nvTrlLQCRMp1s1Hhc_Ce-Xq6mwd-YiIe6mYKk0YrkmnXtF_o6vTfJGLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiQgx6EmzXfd8wUhDjk4IO1qBlamG80fahdNfPnUUhRg&oe=6ACBBA41"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKzlYyzVLtYQ7kNvwETp5_U&_nc_oc=AdoyhNX6LdY9Wg9YFAjQNOhBQI3Ee6bcVaAK6EIskgHvrpHCQc_xgFieLTiiDst22lM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG_-VGT5TpngL9CeKzCG49pUqJCgivkPBM03736RJgsw&oe=6ACBAD96"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kmTyxT92IUQ7kNvwFpdyt-&_nc_oc=AdrrtyrfprttOFdXKxLeBjMeoYZKQZM6Qk1VzyDh3fE9vhP8vDobvXbR5Qnl9YcwBwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvnl_F1EdK_9nIokBvOSurPDGQT7ZRO0qM0HQmIcdfVA&oe=6ACBBB18"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q28pdGXWvmYQ7kNvwHltVKC&_nc_oc=AdoAC7qxcZKsppFEy3Z3UlVBgMGc0fT4GDZgVdhcB_NptxKieSpWp53jgWPYPNJxVvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRrWZL_Md64sIjUoMjPnWlSzJXRVAOtwoNODAXepDmjQ&oe=6ACB9D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA41jrrzvUkQ7kNvwHPRhTX&_nc_oc=AdohAOeZQNa5prUoi5ele6xutxo0M12CCqMhW7zvzPyrbckca7bkuAOCT6pZT-xX1wo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvAlQLoCa4_fc3TgYyIfq2TAqinO4ytymDkd5X3cVEMA&oe=6ACBB719"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
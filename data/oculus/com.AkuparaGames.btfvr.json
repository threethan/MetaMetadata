id=6e7a0a&_nc_ohc=qv-0SC7vAAAQ7kNvwEDL3Z2&_nc_oc=AdrmAIwf43wQ2WCijhYLMokFaBUKY9OPdTbz8UBjt5rHEsaXn8kLC3V1t643vNcKCIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsXZGPHsgwr7EjnoXGMz890GXrY69zNMpOdBmygNExWQ&oe=6A9AF2C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kAHDTwnbj4Q7kNvwHUwEHU&_nc_oc=AdoWoZB6mNqo-h_myaxAwz0au6Io1AFM_JaKXfUQJLBqRI2uTr3Ghg8ii6wSB1SMDNs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbKY2sHYuCKWrbnrYKscu3w3kBFXCPgb9yzPhp68ZKhQ&oe=6A9AE616"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXM2i-UM5fUQ7kNvwErXt-G&_nc_oc=Ado1-XwjL8GArz-18Y-I7e-qbulbySjAjGtCD_a5Us2yMYzIfnea9dMAvRpnaCM-b0w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITioqulEGQ_tpBZEytVlEaB-TsjZzom6NHNMFDip7ywQ&oe=6A9AF398"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDBh2NOp-iUQ7kNvwG-Clwg&_nc_oc=AdpheZgSkdD2vdbWuKar4MyI5Y4_g3qq3xVh1XzwdICu20yjJSWQraEQNRL-agjHMMg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-Qi7C-LX57Om-RtfOwRSkMHyB6-hV6IENXmpeKKVJjQ&oe=6A9AD5F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MrPmOT4PG4Q7kNvwHVRBYK&_nc_oc=Adozdh9T6wRXP9LpFBNLViw2VrohL0abVrIsth327Jbn7XIftNEII0GTiFnS0EdDeys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtFX8gA1aulOQstYYAq5wHHFs9cz251vVGU39fm5S7uQ&oe=6A9AEF99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
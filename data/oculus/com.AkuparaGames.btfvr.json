id=6e7a0a&_nc_ohc=5T4I76L-ZS0Q7kNvwGfyjBS&_nc_oc=AdpJTfyOjd8PnYVc0M6RmU1b-DJsCiefOU8zqtxW_uyDN-Oz9v6uS02_WvgviabrpH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI96GVWKN1L50ISPHGZlAVus_OzuNyS4SDf_S5nMPrN3w&oe=6AB3C701"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV-ha0qRdOUQ7kNvwEZvebE&_nc_oc=AdrJd-ewkmeRlNBFVb-T7QsYrERB-VyItpjtexb5vuTdxVBqphnwafQng6u2Kv71jtQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkm3tyy1Hytz4Bx6xHKNoZ8ux4PMGSjB-wZptBYtSbLQ&oe=6AB3F296"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMUdsmR_GrQQ7kNvwFGCPB6&_nc_oc=Adrh0QFgVHYS-7_YfW-5DhpSI2gdbGESJFf1hV2IH5jkqCTs0GT5vtv83SUMG6aWebI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcklkK-MYFkAdPa--64m5Q-Gj3qemGPnxXuounXTQD-g&oe=6AB3C7D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcP49pYhq8cQ7kNvwGkPXwm&_nc_oc=AdpU8j9qEFZnUiYFqIvlrnOFqWXNahLllgDxD1HXs_2r592EWmPM0ug9OdTkWIoaN7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK0x9odn1S0vb8QzUBubbRqLBggQbqPRy7t3uyhaB_nw&oe=6AB3E278"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RQS6xryYusQ7kNvwHVGbSo&_nc_oc=Adqbgr7ebOAGninQQZdfj9m2Zh72ZQ-xK-XpBdIuTXo8269TEzqCJurliMkQHPr23y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJd12QGzU7VTpEo8WDjGR1XvAf9kWALiDDHdvJqRlmVQ&oe=6AB3C3D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
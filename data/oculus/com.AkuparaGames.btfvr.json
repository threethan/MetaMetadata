id=6e7a0a&_nc_ohc=imhKQcl8_OsQ7kNvwE02AbJ&_nc_oc=Ados15ugrAladyPmzigRjuaRxGiP6OIZsDFffRtoFna9o8WjBhbOXhDWkW4Yv5SP3wQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QY6ovPKJBXsmC6VTgSC02_3Syr63pyiA3u6fWkZehSg&oe=6A1ECD81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lqp5BL95vwQ7kNvwHmXLDj&_nc_oc=AdoTK-HnDMjcWFYCguzSwVz3utveJp4vHytcfZkp3-T3cdFbTEyG6L6yAuEHvuzqOpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zkxjXOe7B8n2VaDIgOztTuS7wLJx1QwZ_cMBJvfM_Ug&oe=6A1EF916"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkMLa509CdMQ7kNvwF8pZAm&_nc_oc=AdqRIumh4z6Xx54P64ZsEu0LbhPSs0x14R_iohKTLiCG3DeJWfaKG9A5f9_6KlZ8oa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tmdHvimbv_vw_IvMq00qWuO3rSIKomDXWGCHH0KgTcg&oe=6A1ECE58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rim-HJjevQQ7kNvwH2gM4e&_nc_oc=AdoF-B0fu8Y3FYYzc7ffHlVTNw7bG1sy8uKPGIahhM0eurZR0WIwADsodJeyWuV1utI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L4GqdjS9iDZJkF24QBzmbsk2ayjc7qL3pPu3mgNY5Jg&oe=6A1EE8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOODjcmcjtgQ7kNvwGGlNCB&_nc_oc=AdoG4cKyuRZB8CCL7NU2dGsBSKOqIIXnYSo2B9tDc2K-eoBOphfqlEqyfGuBuQScTt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LVKXJ_R1VefbqjPXQ3pOlerFtavJrp5HIeA7CcVj7OQ&oe=6A1ECA59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
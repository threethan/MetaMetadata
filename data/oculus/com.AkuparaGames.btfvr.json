id=6e7a0a&_nc_ohc=0thzhPPtktIQ7kNvwH9XDm7&_nc_oc=AdoXxRTfVctHO5l0K7zr3C4IoHH3z7gMGV-bCmznHk7emptM6jK3Haga8TPk0rdpohc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8txIOAXynokOyLboTMccCobOmuqK9R2XkrqGpPxgt39g&oe=6A26B681"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpX8wKJWVoYQ7kNvwE-zMEb&_nc_oc=AdruLdqGMmQRFeC6nxEVP8inENhik6ljkyOQ7FNrL53MeQ-Gda-K8TVnV-rA0S-A8v4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oOiw0z4aGiZ-QCN9808W9FM-SswUFG47hJa0Gt5I5tQ&oe=6A26E216"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e52Ntqp_4zkQ7kNvwF-iY9q&_nc_oc=AdqJNNar1mYZJQ5YVFEteJA_B-NXrwgF5lrUixTRgKr53wgk7eM1U1klxO6caWvynHk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ysSBYW9CWoYx2BC0D71oZbZHmIYRfTJbmxetfXoaeXQ&oe=6A26B758"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCAHSAjOH4kQ7kNvwHsQGkc&_nc_oc=AdqHq1OEVhEFvB9hHiwzUWjtPCiSbVz0Qn5WHcyyedKHVXlHPPalsdPi_gr70s4Oazg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j6kLsyYMAY3I6zt_86nWrMF22QdpTLcCy0W7OwA9jDg&oe=6A26D1F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh583lBAh44Q7kNvwGX6VBZ&_nc_oc=Adpx0QXBe116yKZURQNS6rHxs2fkNh75xpiZe1jA6bIwR3sh2CtGJ5PJ8dTFpdJX8pA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AkJcz3VeRpocm06HGWWrMsnjzAQTuBO3YyaAQTJl3-A&oe=6A26EB99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
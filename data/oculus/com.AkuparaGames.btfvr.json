id=6e7a0a&_nc_ohc=U8hDAchopAEQ7kNvwHDbp-c&_nc_oc=AdqBSL_jsIFk5nbufucdQZkgyl8WjWp4Mt3FCpIZUavSH0GTctAXj_venqcLCjZINvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb-jT2SzQcwfeJEKZwGfyfrnkjC4-QCfwr5pe6THcpmA&oe=6A902E81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXfI5ifYBiMQ7kNvwFX3yO9&_nc_oc=Adopl-_9Z3KxBSfBQZB0iQ-9FCz2mzKH0t_cVfZQMA7FGRSdIk1FOl-760pmf7Fhr6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESWrpawPHSGBmD2GmYtUQ8r7oYZKeta9mvkLr3gNPnEg&oe=6A9021D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CKOcYnshoMQ7kNvwFRI0aL&_nc_oc=AdpgteZOpr5OBIiB8gxlCikTrVakQ2_odDnBmitryzxFgL-k_IAiP28Tb2xYt9j7Xto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5YfJEqJ5AdjvXtxS9VUiF8AaPcVP-chPMtQ3UON-CmA&oe=6A902F58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkyHDY5-TJIQ7kNvwFIJUCb&_nc_oc=AdobaEnal3cRJuKCMfD3megy1H9BxXdvlm3hYtEFmX4J7vndb73yT_6hij5FxEDLAis&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbOVbvQP_kd8nQjBzw0bXXf4vpC5nRG39j18VrGi8t7Q&oe=6A9011B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jMCKUGanIcQ7kNvwFIJfH1&_nc_oc=Adr8k4As2Z1f-UR9uaCfNEBqGm0QN2HDxVgHXb6tF7D0A6UZjvtkBlg8pImKVu0KC2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMA5XncHUM2s9aSume1LS5SpU0vErZF07zWuVhqxCtwQ&oe=6A902B59"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
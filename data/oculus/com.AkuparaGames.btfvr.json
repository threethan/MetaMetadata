id=6e7a0a&_nc_ohc=8_AP_QCY1c4Q7kNvwF07lF0&_nc_oc=Adr39G6YoEUUcECd_qsWA2KGE6dbRrwonb89S6TS4MY7Tie2Cxuhg8_eUmLYUBLz7Aw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb7ef2HvXiPkveLijyMnF-UhGPL8YLg-RpukM1hS5rHw&oe=6AD3A341"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY_qGoX0Ow4Q7kNvwFy4JTx&_nc_oc=Adp12zzvKoTbLP14jEeZrepW9bufiQQ6_woZigQeSv_otdjcUAd8ir1bbBEd0_mE-tE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUPSOXtvqp9s3GerSYjed7r8CWAx6Df-pUdPXSsP0GiA&oe=6AD39696"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q_2RN9a6YoQ7kNvwEpjwM0&_nc_oc=Adp_g69qqFJxUCdDR8JIiaalx0MkT3ni0MomyXwTSHAE5eF51byTjk1uvqs6Gy3dMoM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhBGJY0KcCMxGS8xOi2jEAV1r6YeU0fnI1HbZdONDWVw&oe=6AD3A418"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxQlvqyhfKYQ7kNvwGisFRr&_nc_oc=AdrFeYvBRQ7t8sSq1niYAcjimtargc6ApDp4FQO9aeZDVmSMgcN4QtTC35oZNLBtg6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRjYGrvcLtg5F4HHj8jSL1SM_4rL5yldw8qnfcJqA8AA&oe=6AD38678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq1a4nT31wwQ7kNvwG9-pgs&_nc_oc=AdoZ3uyochtmEDSVPAJvQbK3OlKPUifLkeQ_9gfE3Ta9tqC7UANc9_Mso4hFuEVnFVM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjN1phQ4N2Jdyr3QSM28NlJCUnv6UrtPz3ZVLfbPMDQg&oe=6AD3A019"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
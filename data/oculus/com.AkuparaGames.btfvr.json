id=6e7a0a&_nc_ohc=LFXTpDjsG3sQ7kNvwGdlkz-&_nc_oc=Adqqo0rsUhAx6BgskqCshuY7IOyULHtRAQWluWRwyaDqW0x6PeadthvpyY8SITnPkaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl-Aw3i12HTpr8sYz-6z3XoFKh1NTJCfvfVmwzFePOGg&oe=6ACE5D41"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r9LNliT81wQ7kNvwEqXIQM&_nc_oc=AdoKWwc7b5EZKdHQ2YSSfB4avURQxBN2DZ9Da2iQVDwBvJucNTfklb5d5WPo_ziBcf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8xVOasFTqTkA7dVxAMk6ex1Z5x0btIC111j2Xu6FO0g&oe=6ACE5096"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STZO3lUTL5MQ7kNvwGkeThb&_nc_oc=Adr28uEAPX9i_oAEfUuKOUV46WbxueVAj4o0VqKo73vQ2a6oGoMxL40tuPw-1ZErz60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvmno0PNrxlRJg5Je84dCuQEbimo95qr6vqwTQS5Sjfw&oe=6ACE5E18"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HvZxtPNR_EQ7kNvwEpxIa4&_nc_oc=AdpFeH-MDxshHd2JqVHkXR125ZSD3zDJteQjY1HIY-PRYGDVST5OLEZffVjR2_mWsZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP97wUVBOO9NcTxM7Xe1vVmzgBaaTuAC41lYoYPgzpFJA&oe=6ACE4078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RkT1G4Yvs0Q7kNvwECYeK3&_nc_oc=AdqYSSqHoueSvmoDsTO_3Edg47k6ODDYhtcjeR4CxruBBpzXUjFRbEA_tijpXO2MH-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0ZiURbQgiHPC-Mt04gknGdEeV8EgrUXsCyFbkebsX6g&oe=6ACE5A19"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
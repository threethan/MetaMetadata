id=6e7a0a&_nc_ohc=_RtHXPd_o7AQ7kNvwHmHmss&_nc_oc=AdreSS96yd8svjB4GO62BzSkIJ_DWRrQQIFy8jvQLCo0YMOGv9IDmp3IdUONtPVxk9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sA7cDApLNvLJ3lgPjZDaokMLBbytfpqipwyULK6rD1g&oe=6A3EA9C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdlpP_6FTCYQ7kNvwFJDOQI&_nc_oc=AdpC511kPGQ1PWVsKulEKyRqF981wXktQ2rpCm2mR8lpVqBVMCx3bMWSyaBgU5kb9gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-quHUiWIbWEV9Z0nUMSPYrzoRPiBsmd1RY12GFjeF0cw&oe=6A3E9D16"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyqhuPEsjR8Q7kNvwG0Vqr3&_nc_oc=AdrLRtvMM1SF6OCzUM6sLqEd_i1qPKj34_3hnJuSn-z0dE7Nf4w_YZCxOUk-q43M5WQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M_B8F3peL8GOXL_hECJEbIFTEbKtP8PnOMIfmpKkgcg&oe=6A3EAA98"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu7UfyTSn-0Q7kNvwHkdIA5&_nc_oc=AdqSXdzQ8KflzaG3rOtONxkw9yQgClBr8I7LhNK0dR0Yx4FzBBs-h9LTb5AnMBZWR-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F9CceU77P0d1AtePVTtQmFKxVR17biYFnY2dSyFZ61A&oe=6A3E8CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzyhdnJaBjgQ7kNvwGbfTY5&_nc_oc=AdoQNnSYqgpw5iRV6CxkcD5tbZLimLY7_GWBvq9HgDg_EPEaLMnbHbSqIE_xRUB58Pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-PSCs54j5Tt0wDZuQvf_jOe5Wc5kNq2AKTZ15WneAZA&oe=6A3EA699"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
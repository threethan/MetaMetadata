id=6e7a0a&_nc_ohc=w4be1kAtzoUQ7kNvwEMQe6g&_nc_oc=Adp0Selge_KgIo2qmOYYRp9hyfQ1azVISiYQFrAiEyN7DifcW1N0UMlQUN5HRt4kQLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8P4DhSXSnQ3rX9MioCk040cIgiunnTIsne6bOsMJNjw&oe=6A7B1681"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klBDQmmIbdcQ7kNvwEPfNWZ&_nc_oc=Adq4FmqkYWoX43KK47sf5rP2A4lgnqETNc5ptdDN2BUFnfXORn5NqUFENUcJvQ4mWfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFQII5UxaPun7QH9iKwoBfDwEq3-R1FrMnEN9EWGGdoQ&oe=6A7B09D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EKdyh8Bn3kQ7kNvwFlU-zO&_nc_oc=AdrnUQGtS7VmruITN_QzaPqI0lbznM4psbtckZWsw6iDaCNl4jpSKP1doxHDwEppDJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGP-0a6DFU28B2PkkgBNJmzFN-528p_2DFCZk09cSA6Q&oe=6A7B1758"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU3csOQvmyoQ7kNvwGU2bgv&_nc_oc=Adp5kNv81eqbJmZRW6P15ZQbSTeCrNoqw9wrZRhJjZ_KwmLaLCWo8yuNfJWgwcPJm8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpoS4cqRaT8Gj5mHkNEccMWQTLchSJTupQO5nV08fZRQ&oe=6A7B31F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-rlGyXpt0EQ7kNvwHGo3jA&_nc_oc=AdosN2vt2NMNhKhJ7l7R4ktdFncEtg8zTN6lWYRJt2oQmv6EvlysGa76GNDI4B8kh8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVxUer0jPWeJ0bqZU_zhIvcMyCNqIw8iaT8nxhlEXhQg&oe=6A7B1359"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
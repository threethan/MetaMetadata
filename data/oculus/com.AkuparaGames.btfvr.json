id=6e7a0a&_nc_ohc=z5EWrDpaYNQQ7kNvwF5S5E1&_nc_oc=AdqNF-6v_7jqjA_ayuhR-UuIsG-WCpdMlGjau8jvB8jpDYwQl_1Tcyaxc424ZlVqDgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR3OLENvbu4N1QZWlBhHaeEUHih1gWMb3Xi-amKIGsKQ&oe=6A577E01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZD40aUaMDMQ7kNvwHwaGAT&_nc_oc=AdqF54JNYoeAmUkz542O7pknFuH46bu6ynzxbPBWqQ_9qNyCQCm_l1uBCLBxRlmJRbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnrJDuD3mj3pgnb9SLG9jdUqLdU7-3zIJEQvgXPZrapA&oe=6A577156"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyIPoX_7rlsQ7kNvwGv51XR&_nc_oc=AdoJvdXNaO9ah1UKBjquY2UUEt-fp_-47DqmAvkocLS5AacnXy1TCfQTf4a48WYWzn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtbbqxKt3J1rsIse0-3356bK2b2_RDCermYKZFpJV8WQ&oe=6A577ED8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPah5WYM0PAQ7kNvwFDlB6C&_nc_oc=Adqk8vzLFdI-o2U8SHlLCmTgwI0WAv-rcEzzB9ne1kA33m5YLQO-hYZYJ4SpJnl7EOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKeKw2vyS0hgz8dqc_zhdqmHarZC_0k9S9za0dpiGB5w&oe=6A579978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M_3LFTOS0kQ7kNvwHj7_He&_nc_oc=AdpT0197av8t77Jyjaia0YEGcHkM3o8rdPWue4o3KOp-s5rPomd-g-k87l7zHfxFVnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKcyv-elmJhhMfdxP3JQvF1LbvCq_oVEaBRTofjJq-Wg&oe=6A577AD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=qv-0SC7vAAAQ7kNvwGTCWXd&_nc_oc=AdpoL3C1DpXqFCA-aIvje6h2kaQhyTDq15i4C1j7g2ZgzDAkYiZZKZ0Gbcr2sihoau0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_5TxkTrKCLo38FuEfjDHYWo7AsQLYmCbx5ypyNQBJPQ&oe=6A9C0C01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kAHDTwnbj4Q7kNvwHhS6vL&_nc_oc=AdrkqdoqWt3wmki7eXu6_eqmk__iveiAcZfZRxvmZB94Aa83wpzD8XeHoep8EPrUjSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOqnV65AOC4Aq-K2pjIaktIDTz-Uk8TRIEWjrvKq0zhQ&oe=6A9C3796"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXM2i-UM5fUQ7kNvwFBqVxI&_nc_oc=Adq3J_PTjmPRXPepY0UR7uUk9e2SG6JU2RJNo3rUUxT_Jyyri-G-hp3sttDHgTylhVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHZBDokysJDFsDeFVSskxIMEwvpD3rt9mXSPokC2oqnA&oe=6A9C0CD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDBh2NOp-iUQ7kNvwEkTjnb&_nc_oc=AdppWdDNUI1bbdNMfqg8HcchIQq9e7ea9vVwpdZlP9QPTBmLyLGevq1VjXEZ_p4_0Rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpXV4ZuYXGm9fl-7pp0NpldcHLWCXkbBb28kF0FOvraQ&oe=6A9C2778"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MrPmOT4PG4Q7kNvwGBObab&_nc_oc=AdoecmtNykwIdBIunyEpjNhxG3VzOeuCcfQMIKPLU2GI1OEd4fzjOsUQlSiARSswSXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy264uXXhMckJ4gBPvM73FZFfCm6NWvo_xGz5RGXr2sA&oe=6A9C4119"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
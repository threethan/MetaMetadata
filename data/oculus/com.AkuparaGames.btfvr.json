XP0DAPIJs5RIWJEt9V9_ZK56CzoB3zEuAY0uEDIUNKJD4m9Qd6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2YDGfOrNrhkQEitZzxdhZsrKwyablCuu3R-6Hk9W2WIg&oe=69F1FA81"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0kwPcf5nEYQ7kNvwGCVgyB&_nc_oc=Ado81Qs7Jsn_QnbX6vf4WdhV4Bzdd_uEKY-xzVlZsLHLQgxfcGdWq7Sf5DOo_1oItAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1PTXNNM0-yc8RmasyK7360fHsnqrsdTINB6p6ykLqr2g&oe=69F1EDD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks-qpy-IkrcQ7kNvwFZ_ABb&_nc_oc=Ado8x6CmkTQxZRcg98Q-LR6_jT0498b3HdNAUB9JxVBQlrmW6L19RK3w_IZDjlq_GRE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2Masa5dgxdy9SLsw1ONMj3YbNqNNNo9dpPbwhLQNOgqg&oe=69F1FB58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcEYOMq89oIQ7kNvwEYrqEZ&_nc_oc=Adq9LnrZS7QTFWC8d_bAnhD0DRVcaLsN9D73KnDMXj-IA6pbRLG5AXqkp3uolQqVIPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2L8lzp8k3zJwwVpvm85rvLuoUi2aYklix_CJOQ7wFyyA&oe=69F215F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl4uKsptqHgQ7kNvwFSr80C&_nc_oc=Adr0nsqbgRdL1nwREdpXREZ1P2VGTn0-4e3UIUIApiawHDF8acRMIghdtpKjTPuwSes&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1aAoHCiEQ439jilR6bfOecfwVI-q3QQjrwWBU20nIxQg&oe=69F1F759"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
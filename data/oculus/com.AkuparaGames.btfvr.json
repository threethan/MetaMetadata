id=6e7a0a&_nc_ohc=MrKnI8o5YbQQ7kNvwGjizgm&_nc_oc=Adp1bPbdKw7WqsIRmsuQ9gCiZye2JD5nTNnVpRnCyVfjrnEcdr-2xi5mvTOqNVCOpEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs9x5-7hkPq-cLRzZJ_k4l_7xRDubcFTNOamjyEcpYHg&oe=6AF1F5C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itJYSFFIRZAQ7kNvwHi-P0q&_nc_oc=AdqLJRhSeCZ5fzdN8vKfkrgnCssvG80uX3Y8Zn2sokRLWLJnrca7CRnOm0D8r1awC88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI5Fg6E5o1krMyjnrGrGBZsemeDZc6ols_K3bTUvqLMg&oe=6AF1E916"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJUX3WLsQeEQ7kNvwEjNlkr&_nc_oc=Adp7MQ4OuFXr-tpuHhMMUT2z-UzorB0xqKQo6OS4Ct6ndfy9DStdOIfmllfMyzbMxkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2VPxCzrh_RG0sdUEl0tWsQVEJxioSfkVj_K6zB4RN6A&oe=6AF1F698"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJKEQ7SFcrAQ7kNvwEA9nV8&_nc_oc=AdoIHvltiSGp7vFTSF_f9SF2GSULSTetCp96kSPCb1kBAkaut0-PupsLjrIlCI1hPh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaWp3WSS_8JLqZcZ1rCPqKt_pVR4WYZFdrGNYoLaE3pg&oe=6AF1D8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQn1mSO9Z8cQ7kNvwFkPEw3&_nc_oc=AdrGMkvAvtpt05hBp7Q-k1YFywRMz1y6HFe3dhZCPg7G2YI5NSe_EIz9QZulL4TgA7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnqLpmgW3HV_ZFDgpuLReuf9Pt5N3f1wVRLXWaPaFqjQ&oe=6AF1F299"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
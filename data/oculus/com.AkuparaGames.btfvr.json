id=6e7a0a&_nc_ohc=28ukOV7aX6MQ7kNvwHZgon2&_nc_oc=AdpHz3IAbJfUXeDutbOhBaHQtG9KNLrva-mOjwFIlR5g2C1zb44r2YBqZJYqc79FTOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBenxPFldS69gUAUA4m9sLWwgWgNszstv-2_ulC8-trrw&oe=6A6DE781"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTHIP6N_hkQQ7kNvwELDfD-&_nc_oc=AdrH44k15MXlSvyWFm3VwaSw5RPnEGW1_2ALqLmxV78jlPLRCd0wsebUs6FMgf9bsXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9DkMVx7Ovq0bOWZFKR4msHbVSMFuaeh7sUa570eGw2w&oe=6A6DDAD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejRUfiOA2GQQ7kNvwGoexKv&_nc_oc=AdrB4c8hquqvXzB9ygQlvTP52qYvxUq6p4xqEn6ZFMtxnrXuErXWa1syI5zyZj8iu00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoJpwF1d3eos2_isjLqpoLnwBkb8Jo6oQSiwoMUbbL_A&oe=6A6DE858"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aVtjH4xnmsQ7kNvwElNNog&_nc_oc=AdoDarRySWGU4Evdy2wsDowuZbPjWOHkyF-z37_POUnZvyC64IHul39yJjnak4U9dZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhmawokW3sRrBtCLrUVSbHzgDvKmaPV5fqLlEkc4Qb9w&oe=6A6E02F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCfe4bo7n7wQ7kNvwET3Vi1&_nc_oc=Adq0Vj08M8ByKprUaicEYwThHqlefBN35n62MG3_7ewD67KDm0DUMXW8hWAbJyxcDe0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlpHnRzrjYSpD1JAjtRpFMMboytQr8QefdiPMvumKmqQ&oe=6A6DE459"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
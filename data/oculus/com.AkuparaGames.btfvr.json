id=6e7a0a&_nc_ohc=-h8Pz7LG2IIQ7kNvwFHLMEO&_nc_oc=AdqL_SyQbXwW5Kl50NCY08awxo-g_ErDdFuOYsOPW2ecWZYhHe1-EGmWWWmCpToKkZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtqzYdYhwe-eAlWad3a5D7_5-LzSq71s9uxHy3DVXWTA&oe=6A772201"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRCSq64M7m4Q7kNvwHdK-KK&_nc_oc=AdpDotg2tk4ev-UP7t8om8SkRqxqL7aTHraQt0l9e9TQmewHL7bEfRE6S2YNpoLzd-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEnHlDaNmIuBIcg7RXlnXMdV-iBHUUaRZDu9XdNxryLQ&oe=6A771556"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59M9zg8DmuEQ7kNvwGhBoJD&_nc_oc=Adr5ce3ysuqTskq1Zyxy_9Z44QCJYcJPfGnoT1aOKwId0TKwiOwhz2G4WZwG4VR6T68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF5K_Ooeb8fzPZdIrGDjexv7-GTG-K4uuGsZaJnZvNAQ&oe=6A7722D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XcU36rFSpIQ7kNvwGlEoTg&_nc_oc=AdrdX0_K9OFRqKmlrRZ-WSict0be5cOsx9dH8GgXyOJ8JRSETI40MCTipUMt6u_xQ5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpJ2W9Z3pPBGUzuwQL8i1r1varkRXpZ96BbDqPeBxDqA&oe=6A773D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZXy3ZPVyfAQ7kNvwG3WeL9&_nc_oc=AdqIWukmd5jpy3ESpSbykIHT8PDdYc7ZlOK_xzZMWlsu9c6ufgdBBcSL0lNOHiRU3aY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg1He_6HYPZk-ui9DZCv9IbNNs9czVWjuLLlb2Ysb5Yg&oe=6A771ED9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
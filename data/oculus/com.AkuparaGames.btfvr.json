id=6e7a0a&_nc_ohc=xOA3MDviGXIQ7kNvwGHSjgP&_nc_oc=AdpxeaI5HzLLq6qCvX_qj0DaT3S0yJhf2RR2SPSG88fqc16rl46xpurjhokUA7DGkkc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCAndvosxtxQjwWOnIDZaPSMVidH-UYvLJtBguPf1p_A&oe=69CBBF01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeTgreU0Ww8Q7kNvwErHT5v&_nc_oc=Adr22ilv1zZWa34h8v_0E_jH5-jwDLXpyIzSSb6q4xX87Wtms6-wROkWsxRYPw9cyKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQerrwu-NaQnCqQdi_n2yRMkh838DYvOxeIn4LFZfXKA&oe=69CBB256"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABAbYdDO4x8Q7kNvwHcJ1hx&_nc_oc=AdrwiTIPZ92nynpQkJCFoVqWIG7YWD_uxLYIdBtYJoJjPFj6VAHq3soXiTYHSV_oKcM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTbkldnfNH-5oG6W-4A92lxri5gIS1YIB-8xwH8Ln5cg&oe=69CBBFD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGorC9RIeQoQ7kNvwF_mHJx&_nc_oc=AdpBPvMYb5CwTuo89nJceynzoQYyRGwhgvAUp8IMC0qQv0_ROprqnRmCXbDUdVo1pTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9lc2Tbn8x_MCg0bSa-c82iwdggu-u6Wf3t5JsW2i68w&oe=69CBDA78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7oa3pm1CsgQ7kNvwE7xrzx&_nc_oc=AdpHR3Xvg3ExMcbs3cekhXygLYVlTXrv2WMOH_JnLstjApcjIHSAYcIQBajGoRJ0lLA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzW63ZGtQL7umJMR0J1Q3AKr8aqEATTVrae7_3TULYobg&oe=69CBBBD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
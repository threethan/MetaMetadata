id=6e7a0a&_nc_ohc=l54f0qBCyAIQ7kNvwHX-hgO&_nc_oc=Adpjr8DjklpD-r-1hLZEQfHoLAr5kdRUvreXM9hXwY7LfPe2jKet5By_DeLXeh2UxaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vS2hLUqb5nl8vVRyCrMJ4bXniBS8QLKUCainKryvGbw&oe=69E37A01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hre-tVeER7MQ7kNvwGqJT7e&_nc_oc=AdroJpBCDpB5_pfFfsTaNntsl8XPNpwvVOd0WKY9xCDHxHB_bWjokLSYx4dV37CQapQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N0MKku9XbnUzyZW6d89VeeyZi6iqZSZktBuNBTVFiXg&oe=69E36D56"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqQFXUUSvYgQ7kNvwGSrx2N&_nc_oc=AdofbE2m59w1VYrhyQqVC5yN_002cELEd6lBAc5M5xqDUosL2eoNfsa46Fv-vSF3CkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FQGke2OTe3NrGUpRMvj2rivm5VQsQc4ugyuum5Skfdg&oe=69E37AD8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3epe-gePA_IQ7kNvwHuDj5j&_nc_oc=AdqNNCX5uk6krrStS-iDcrQrjJ7OTCbCofMGO6IIgXmJBuybrVAfEYO1SMzPCYwHdR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yiZmy2KkQ3ebTBmAra6otkvU5YsE-cVmw_DnaXoJ05w&oe=69E39578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUh6fKoo50wQ7kNvwGG2GYd&_nc_oc=AdoqRxOZ8XOn4lC_BcOvWabid6dNHQqlixTCrNv9kcuuW38lmSJ7YNUPxgU1e_IC0t4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19HA7vKQoNSkeDZK6pgjC2IJmAPAjj0cSVoI4-4eyZhg&oe=69E376D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=OPCMWB8EcF0Q7kNvwHxhzLj&_nc_oc=AdqLedjwG9ysM9iCOf9dOqSGEQoVyn0FlOlKiFFk88N5hhCRUHqX0QsXk6HNB9TV34Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV_xrY1mWx4oNIfBpkr72QFADwvswsAZncM28i_M74TA&oe=6AABDE01"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyHrSPfrM8YQ7kNvwGcZLPW&_nc_oc=Ado35KwV1YJWFwUD_W3lFRin4ykadWdtPO15Itcix_k5C9TeR64uswy4vyWMJANiY0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEyxx8tk5ax5OXj1lm0iOsY2CjK9534ODaKspBApbKdw&oe=6AAC0996"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ysutCXXSxwQ7kNvwFPj_Z_&_nc_oc=AdqNGgafeAJCpLyA7_a5urXvzR4lcg70AVaVfbDIA3DcZWjP5WnB3jDN5HkdqeU4O_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP0oXRyXCtGkRM2BD_8VVIgpaVinuxyiKG5S4c85ZOaw&oe=6AABDED8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cU5MD1RfpQQ7kNvwHdGqbv&_nc_oc=AdqLB80sT1vdvUt2gNCb7-LRft39ZK4mNoY8BMN9Jmb5uGLuitZQXAmH5JWpjiaxBKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIee6bvawyE-kJZ43kn4UcvO-ncuAlwrZcih-AljPBseg&oe=6AABF978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3f6QWPE4V4Q7kNvwGADSY8&_nc_oc=Ado8qXnv2tOcigIE44CLv5WaxaGdikTtu7-Vr732yoAp8UyDTOhvBnFeT_OwvtEPZZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnhfX_wNubuuCoogXtVlp3eVk9X9fGV-r8jfuG0RoVhQ&oe=6AABDAD9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
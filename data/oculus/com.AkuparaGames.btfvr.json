id=6e7a0a&_nc_ohc=8_AP_QCY1c4Q7kNvwGG-2uk&_nc_oc=AdoGo1z4VuONL3_2jLZ65CeTu8Ix2jfJOhEhSjtKGFM9h-WBmBYsPrHm1quSoVMTy3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPblMYrenhKAzkJ9PO9MpA-s1_8fpBLhM9FYQbh9BpLIQ&oe=6AD251C1"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY_qGoX0Ow4Q7kNvwFb-hcD&_nc_oc=Adq9jPkXY_f7wSmZyBLvRLeLO3xdCfJXNXKhqIGmB4_lC4lfmOIme9O_l7yhN6EbOkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN95Eaoj1RtOd-f75f627fSCLuqA5E8yncvdOmq0eHDrw&oe=6AD24516"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q_2RN9a6YoQ7kNvwHs8uWi&_nc_oc=AdpS3ypLgP3g2-PDOEvl_ezw8eZteq6WbGSbwnID0qCLiG-D3captpGfugTrsoSg5j8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpKSVqKWRPi3fE-3uQgYJ9i2rbHpq1ebAiHcUQfyfutg&oe=6AD25298"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxQlvqyhfKYQ7kNvwEOuTO9&_nc_oc=AdpgqWbFCIibNWRaY8FTnnXrrSbcJf3CoHY1MWmw_tETpMKMkyy8VMznnAMTk2I93_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp9H0pt4wpDH1E051KdsqQE19HtlUjORzEO2CfVArU8A&oe=6AD234F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq1a4nT31wwQ7kNvwHhmpuL&_nc_oc=AdrHPH_H0uWtS-hF0iW7NJZxz_SYWdfh1mtvx0ydHrjBiXlt0xMDWdyjdvCzxsShvBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSDPltSTy--PjfSblU_9rP8sTE5BafEiCdmbh4HSGhAg&oe=6AD24E99"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
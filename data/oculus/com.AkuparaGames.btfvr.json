id=6e7a0a&_nc_ohc=QdFfOgW-32sQ7kNvwFKLJYn&_nc_oc=AdrXTAheZIIn8XGlQo41x5bSg4pyOK63HvQ97WQB9L7xn0Bft6XIFtXGAa2SwWpCZa4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4BN-w1lvNq7gTLC3XQccGT3vf7wnwIXO3goFN2hpHoA&oe=6A523801"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atC04lAy1OoQ7kNvwGPoe5y&_nc_oc=Adom7DCa-HWe62COBVcIicYOI9a3zKJkNaj8C1q1X-znRyuXLHjLlVr_tUgkaPJEDAU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRXhtIdawWHL1OY0J7NthsmoVsUJyr7cF_u-TUTm9OiA&oe=6A526396"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Cvq1rrrHp0Q7kNvwE-RqN4&_nc_oc=AdquxVZ6NfEUNQlLLy9KTL4XEXsEsow-sm1aY-EWyZ6vuh3tuRYlHj-egcQi3ZLUznk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdnRCoAifvDLjY7Ln2QCQg_kWLfYS9irmaOfm0Zgov6Q&oe=6A5238D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIhQoVrJ4XUQ7kNvwErinft&_nc_oc=AdrDC6wn9k88BEbu5jw5ReaBaDj9wD3T8RIm5j39y95dyIoDgqlNlqV3leiAb1L5ZXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6KKC1kVBFb_-HV4XWGLWFHjn81z6XSv0MIQPtszPIfg&oe=6A525378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvGJeA7_dYAQ7kNvwEgloWZ&_nc_oc=Adp2jf01Zaqh1bNZYYRdXi13RPawx8d7wAknrFP4rGCywrWNr72IsMrkMvIUDWpnu3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC0-rQsMNnECLbpKyy_nGKf8nKbU7Gx5v4T6OJgHB4zA&oe=6A5234D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
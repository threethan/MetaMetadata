id=6e7a0a&_nc_ohc=g1SaqJcjF_YQ7kNvwEeQR_s&_nc_oc=AdqHclQGTzonNvmj5JlfSXbqUZHRYZOojHCySUUCFuw5WGs9fkMmWKLaxrj4ciRow_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uu66J1-hcCIznXEQE1C99n6ZOlLvq2ORFFBemoOFGVg&oe=6A450901"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjA9D_idWacQ7kNvwFmsbCX&_nc_oc=AdqKcbd2RX85ivTBvjFqA3eoPFYwDTP3LCTiKcNksTzwUVsVW1DEgl_nKfMPcY2v6OY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QwAmxs9Vo3jZmj09fiYnxpggYQ6CO0iuKG9MOWXDZCA&oe=6A453496"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo8FoLUuDEYQ7kNvwGT00JO&_nc_oc=AdpD5G9KMym93ackm4yz-ArnBUmOjzyxEsv1uaCPoVnb65stDYIOswXsrYgGjZR6NHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PZCotarAABfSB0VlQoH2oywjBD7aZGbtM1e6e7b6RVA&oe=6A4509D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S5_vZKyEfkQ7kNvwHCjshH&_nc_oc=AdqSjYIypWaZCyght5qaVEqrHQWMJ4DVgXboJVczaOz-A3yglnp4IGWH81kmbNtWs1U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BOEPeOi4wvw4BalnL7BfRzuflN4tq6YmPYVYuKw9q-A&oe=6A452478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hbt9zJO5EdoQ7kNvwE-kPfS&_nc_oc=AdoIdNc_ZsjYqX5Nn3s23QOR5EJ9aIkVIOurEQOV1LpC4y09FwzHCXzgeVZsiC8bdzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8642Cxf3QEVSHMDOYtBuoSKu3fdtgS0lOSSIgo9gGsww&oe=6A4505D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=3nIuaM3pJSMQ7kNvwEXz4rY&_nc_oc=AdpcJe-SJFHPAuQiD65GvYRhQXXCX81BOqIOfypSPFgB7Tljl26gBz2wUhEEchdstSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fws5DrGwd7AJ0od-2WMI0XQiHH4OR7sCP4IKQlpNBgA&oe=69FB3501"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw5_tNmyLjEQ7kNvwHwi9TS&_nc_oc=Adp2a5k6xDeLrMCskLniSzExDgB_wMyce2XnkNAkM0UCAWX5R3sZETsUzKhzUJuz2pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I3qFIi6mDQ-B14m4F-f8pX_a6Fdnj7kW1zwTrX2C-nw&oe=69FB2856"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzi-chgvey8Q7kNvwEdIY22&_nc_oc=Adq5TXYlxdxsWN8NxHxoHL24fnwUw0igzfIwbYviSS3utgacSX8JJmB38l9VIHnKCrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ijil2eT3Rgvzjsu4wM_xjJnnpU9JmsQiQkL_SJKgjQA&oe=69FB35D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9B6YkU5YbwQ7kNvwH9pBVR&_nc_oc=AdqEh8wGJL-vsyLZ3MyKYAJb1phWVRieaHPOZWW0eS6dF9M8ynUwAoCV4j86SltTy0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kOOXvMV4vWnIu75PumeL-WfQ5pgpTscq_5-3gJZOJDw&oe=69FB5078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcJL3aVH5p0Q7kNvwHp1qFd&_nc_oc=AdppOzgjA29yBZw1HTQplm4w5h7RMdwh_x3pQYMa-8ARKLvOlPRvhWYffAITtcOWLdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hzVV8BvubTYZMCYJWaWVNSp8NqWG8mDV15-d-ODsq5Q&oe=69FB31D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
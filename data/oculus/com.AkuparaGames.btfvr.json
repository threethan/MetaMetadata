hDx_0&_nc_oc=AdnqtRqelbnnY5uyxZmb2OEztzLY4BrEXb4LKwl5w7LMh9pTDgqbL5i3Dj8FcWwWl-g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afy213z_1u0keyjUYKkQ_aPr7Nr4M7J_VTRIOB5pCWAPIA&oe=69AAC981"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-t5dcekowQQ7kNvwGlCDbB&_nc_oc=AdnhfUMfnyFw8uAaIaYvHcEIVr62zfCJ7gO2Z9MozSCaVhl8oU_JOM_GvAZvIJPztuc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afzsi1zSnE4xk6zvSrgl7hVuPxWzucWAMDyG1vSiO1hPyg&oe=69AABCD6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojam7Dm6YIsQ7kNvwEEBv0o&_nc_oc=AdnhGJOv4brvcg3RHvhC5shYW4hNBcG7YxM1ReY_B7uAQ9xjPREoycGVIkXjTkjf2g4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoVHOhDrE5f1gtK1W6iwQZieXeT2ITxHQf7FKrtTnXnw&oe=69AACA58"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMIK1rKMDRUQ7kNvwG0fKRv&_nc_oc=Adl7eEsHWIIWaLF21eWjHNAfPJ-3fXijaqXktItU5UaILJdKberF_soouAev5-n9uBI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhJ6ywbWKx_nJw_0cMTri-sxZl74gb9WXBmkCr5EwfEA&oe=69AAE4F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AGBFArYiw0Q7kNvwEIG7wM&_nc_oc=AdkFIWqnnbUiYcnMGDcdIKfWjBxJT40WcCSopWlnouBXGmtqlNCHUgUo5KQE7u0FdXo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7U4YG174-QxBFLPal4zHJQV-lJ8VxKKjjpyrOfPXl2Q&oe=69AAC659"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "
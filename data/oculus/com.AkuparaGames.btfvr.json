id=6e7a0a&_nc_ohc=65zJA0OUJZQQ7kNvwGKchBH&_nc_oc=AdrdB6XIXhSlGQBbfL4i-FSdExsdKQ667wWpObDY1hdWWn_TcCwqcICGzvGAWXkZkeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_Iab-QneBTm-PKh12ZAj-kblLmLKmVzcKmJJkqGZuHg&oe=69DF8581"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4bMkkwHiwkQ7kNvwFDXqDu&_nc_oc=AdrXYeLx_hTGR0882ejHWGewUB4kbWy0XHrVDKxrv5lhluovywHCYctO-iCxfl-rXZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QvXoMM8odRq9PzlXyPW4FUbM2lvhz_qfapydOc-6TvQ&oe=69DF78D6"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgssNCZeJpwQ7kNvwF5QdYA&_nc_oc=AdoM0wIFS_jzQQ0RyPfUbjP2oPkBvUeq2U9N5lZpSa41JcBTkWgyW_Fxi4VsyrNOIPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ccbmRC1FrPIfwHBshdWzbzc5IjmYZg9LaP1OD8DuZ1w&oe=69DF8658"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcWYoJsASoUQ7kNvwGCljf5&_nc_oc=AdpkMmOFa0mBzWmxs_jTJCuMUiQnmlsb_G9_z-tLRSQiiH-EIK1VlZNGDZ9LdwMy3uk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HjYzpkv1nAujWjXEHsu5sNZuCc2rf8Ll8HsqKijOI8w&oe=69DFA0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiVnYssJzdAQ7kNvwEWM7je&_nc_oc=Adp4MQ2ZtMyxm9H8tk4O1dk31bYhC_oPHI8zt4QRbViEd9kNkGB2Fq0o-t6FUWX1nEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gcaxq_gY-TWTivUJYldTlRYkG8wCjYOBiPj823goozQ&oe=69DF8259"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
id=6e7a0a&_nc_ohc=5KiH0iRBpB8Q7kNvwHsCgMa&_nc_oc=AdqiDrWjQUrpkQlu0O9JZp51-5AA0xnmqZdba5cOZiYGREJvBXEsSdrEsMOF3c52JCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSzynHuCduKXZ_MDFpu83nkZ-rtNjZKfyUaQGlO4qrhA&oe=6A4F9501"}, {"file_name": "BTFVR_SS_3.png", "id": "652769516358118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_652769523024784_4349598323571350812_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itiHRvq908gQ7kNvwEG5Yn9&_nc_oc=AdqZMLawQIZkyRnuzIO1EL6AefcBk6CUGcqoNvwZ3rmhIxrpQbbjsAe6cgPywt4FeG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhd1h-Ta8PMBscJNJec6YmV1IzrXY4_QoW5wqWArVCKw&oe=6A4FC096"}, {"file_name": "BTFVR_SS_4.png", "id": "168096126127236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_168096129460569_3374638376020859990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsi-RxSvctcQ7kNvwHThbqQ&_nc_oc=AdruYgx96hTQFzpxY_Stj4zDKdrs2Fe2xr22KE3moBSWMSQigWOn3afpy3RbnId2QUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD21uD0YBJbXJJqBXc3xck6DVMKwX1jYjKqM3qZMdG_ow&oe=6A4F95D8"}, {"file_name": "BTFVR_SS_5.png", "id": "789704402858787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031603_789704406192120_2582869331303730724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DkzFUv1W28Q7kNvwEIHS4V&_nc_oc=AdpeD15UHQ-Q2kIdkkF-IL1FJfvFgx-LYw7wd03ygn0i0SNVsafbj3rlEvA_Dya7xv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt2wtfTgvkKdH7_RfZxefhkhETUXscvAwEYB-31XCtag&oe=6A4FB078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BTF_Graphic_Meta_TrailerThumbnail_2560x1440_V1.png", "id": "1004833247378719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1004833250712052_8179189765754741748_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvGJeA7_dYAQ7kNvwHvfpT0&_nc_oc=AdoGyFfVbJzM8HEjkgb0PQ0Zpcv_cpiwZm_UvyXtOQ-Y8cxZQivsL5IUx-HBndcyls8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6N0B2mw4zEQIneeivRAQg85IwotFks2MDUbR0c7aY9g&oe=6A4F91D9"}, "display_name": "Behind The Frame: The Finest Scenery VR", "keywords": ["btf", "painting", "paint", "anime", "casual"], "long_description": "Behind the Frame is a vivid, interactive fiction about an aspiring artist on the cusp of finishing the final piece of her gallery submission.\n\nA relaxing, eloquent experience that can be played at any pace. Become immersed in a panoramic world filled with resplendent colors, beautiful hand-animated visuals, and a smooth, easy-listening soundtrack.\n\nAs a passionate artist, seek the missing colors that will bring your paintings to life - all while remembering to take the occasional coffee and breakfast breaks that keep you going. There is more than what meets the eye, for every painting has a story to tell.\n\nFeature List\n\u2022 Making Masterpieces: Paint, sketch, and retouch your artwork to complete your masterpiece and your memories\n\u2022 Intricate Immersion: Dive into and explore panoramic, VR worlds inspired by Miyazaki/Studio Ghibli visuals\n\u2022 Submerge in the Memory: Experience an evocative story, through the eyes of a passionate artist", "short_description": "Guide brush strokes and solve a variety of puzzles to help an aspiring artist complete her masterpiece amid her brusque neighbor\u2019s gaze and his pesky cat. As her painting starts to take shape, uncover an emotional tale of chance and artistry revealed behind unrelated yet familiar moments. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-behind-the-frame-the-finest-scenery-vr", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269
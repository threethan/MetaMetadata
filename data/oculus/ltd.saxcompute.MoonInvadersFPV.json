04194891017_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEnCzKb823MQ7kNvwF0L1Ju&_nc_oc=Adq2858VcP_XOAxmbI1kBV5iff5lTBxfyAvfbPzn7PTSrvkKYMl4dq0ao6Tv34w-hDg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaFsCxmT6KOBiDChDNhdvLyD-sKZtWbRPLCKTy1ZIQXQ&oe=6A8EC040"}, {"file_name": "bad30977e1774602a765b4097ef1e6b0_resize.png", "id": "897375172892529", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823296_897375176225862_117699820603898225_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNIJogI1FYcQ7kNvwGeBz6X&_nc_oc=Ado6uABEUVvZaAOKRmiFqVE73kGU_7Ig9kCatkcznR0DNHubAGZq7KNYK6p4rFFq_pQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiaTItXDF5MO8-fS99iXqTW6RWG6UUnkS5oNVc2yFdzg&oe=6A8EEFB1"}, {"file_name": "ec01a9ba79bc42c5a791faeffd951962_resize.png", "id": "1393223382666050", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823259_1393223385999383_1316162272540162672_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3pXqpJl_zgQ7kNvwHZ0IGI&_nc_oc=AdpaJ8zc8bQE9cW1lBxsNZ__dY5_IR4bXvNx2sfjLmh55HTh97tJbHtOPE8qDqMjgWI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiCBL_jRDEMsVEP-DhyuOegR5hJ1TVaig3yEYq5g-Mbw&oe=6A8ED225"}, {"file_name": "a3b785f994d24530b38266765446efe4_resize.png", "id": "1358605802306457", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823940_1358605805639790_7874766647138728701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkTkjQWEhVEQ7kNvwGGR66z&_nc_oc=AdpMG-SznlsDgs_bD2ovCxGkQSRa8JfvQNSaplHvwI1_JJ0WdWGu0vhe2vl7nwBXZwg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-UgHW4tWmO8eRiRIlbKSn2EefKPdMM7q_nsBtAFjEZw&oe=6A8EE07E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Invaders FPV", "keywords": ["Moon", "Invaders", "Retro", "FPV", "Space"], "long_description": "The Moon has been occupied, fortified and turned into a launch point for invasion. Your mission is simple: enter the enemy complex and clear it out.\n\nPilot a fast, heavily armed spacecraft across cratered lunar terrain, attacking surface defences and searching for entrances into the underground network. Descend into twisting tunnels, enormous caverns, mining facilities and hostile bases packed with gun emplacements, missile batteries, drones and enemy fighters.\n\nFly freely in every direction as you navigate tight passages, hidden chambers and branching routes. Destroy generators, reactors, communications arrays and command centres to disable each sector. Collect fuel, shields, ammunition and weapon upgrades to survive increasingly powerful defences.\n\nEvery installation is a combat puzzle. Some targets protect sealed routes, power defensive barriers or reinforce nearby enemies. Choose your path, manage your resources and decide whether to press deeper or search for valuable hidden areas.\n\nComplete the primary objective and the battle is not over. Reactors overload, caverns begin to collapse and damaged tunnels become deadly obstacles as you race back towards the surface.\n\nEnter the complex. Destroy everything. Get out alive.", "short_description": "Pilot a combat ship across the Moon\u2019s surface and descend into vast tunnels, caverns and enemy installations. Destroy gun emplacements, fighters, reactors and command systems, collect upgrades, uncover hidden routes and escape before the underground complex collapses. Descend. Destroy. Escape.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": null, "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": 
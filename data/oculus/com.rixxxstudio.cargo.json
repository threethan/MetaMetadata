=AdrmAeloHXipc7xoetCa3AyiW13bOBT6YBFeg6vLNj5WZiuxb6RoYIYmPB5yhl3T6xI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPoQHiTj3Lz5_NpcNHYvtFEXrU005YW-qkjv6umi4iEA&oe=6A661ECB"}, {"file_name": "2.png", "id": "1638459123501077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301429_1638459126834410_7843657768751048047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iBXIkSLgqEQ7kNvwF1IKvL&_nc_oc=Adok8Qy_yeWBH2b4Cc31CiZo8rVQAoGYTCZ37gyplNMY_2sxKyuy9FcA_fijpKtgd00&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe3hHv5sqkebGkTpCP-rPBfSczoOShFZ2xzlTErQG7TA&oe=6A661B6C"}, {"file_name": "5.png", "id": "2877793802410877", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499305027_2877793805744210_2066364993188004051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR2KbQM3ZYMQ7kNvwFXbZea&_nc_oc=AdoiAJr38QnAmmfsNa-6M1p_lvYnG19a2gvoFtdMM1Cab9S6at3f2HbtYyjrLOwl7ic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYOc085ar9Hj4t8FQfLDs6_E3SMhexr4Ms2eo31Yjaag&oe=6A661A8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cargo Truck VR-Car Transports", "keywords": ["Cargotruck", "trucksimulation", "Towingcars", "CarsTransporter", "TransportSimulation"], "long_description": "Get ready for a fun and exciting adventure as a Car Transport Truck Driver! In this game, you drive a big cargo truck VR that works just like a tow truck, built to carry cars safely across the city.\n\nYour job is to pick up broken-down vehicles, brand-new cars, or even race cars and transport them to the right places. Use ramps, secure the cars, and drive carefully through traffic, bumps, and turns. Every level brings a new challenge!\n\nWhether you're a kid who loves big trucks or a simulation fan who enjoys realistic driving\u2014this game is made for you. Easy controls, colorful graphics, and fun missions make it a perfect mix of learning and play.\n\nKey Features:\n\nRealistic truck driving with smooth controls\n\nLoad and unload different types of cars\n\nFun levels with exciting challenges\n\nKid-friendly visuals and gameplay\n\nPerfect for car lovers and sim game fans\n\nHop into the driver\u2019s seat and become the hero of the highway!  ", "short_description": "Drive a powerful cargo truck VR built to transport cars just like a real tow truck! Load up broken-down vehicles, new rides, or emergency cars and deliver them safely across the city. Experience realistic truck controls, smooth loading mechanics, and exciting transport missions. It\u2019s time to become the ultimate car transporter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Rexxxstudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30817919061126696"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1153097086284787"}, {"status": "PUBLISHED", "id": "1746420965990572"}]}, "baseline_offer": {"id": "1153097086284787"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761056280, "status": "PUBLISHED", "id": "1153097086284787"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_te
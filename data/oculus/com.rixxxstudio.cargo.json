lLnjE_8LvrsXM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCepdW-D-RCPrwP40udnQe89uzPy9c30kQdjx4WKgISA&oe=6AF9E09E"}, {"file_name": "6.png", "id": "1470084710941151", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823431_1470084714274484_3627703250566269846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuRcET-A_3UQ7kNvwF0I_vj&_nc_oc=AdpuTo_jAtvSkpBbkqJOO91pBimWITePgXgshv4k7GdFyt3irl5gTR2aTHdwf8QGmeA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQeZsD4nWJ_T5Gullcc8NOvuUJe54NlW3ecGIvXZ07PA&oe=6AF9C6CB"}, {"file_name": "2.png", "id": "1638459123501077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301429_1638459126834410_7843657768751048047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLc6vNWIcrUQ7kNvwHaKK_f&_nc_oc=AdpZRiHb0D3LOxv8Gk83ysdQ8MSrRKssMO_NI35n0i7Lp5ZkkXx2zedLCFxrjRMW1mM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWIaCKdAO92iu3UYQpQMZn7T0nvHSx6G2Huo3HdiTsRQ&oe=6AF9C36C"}, {"file_name": "5.png", "id": "2877793802410877", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499305027_2877793805744210_2066364993188004051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvBoQ2V41ncQ7kNvwEDIxpZ&_nc_oc=AdpRZd7tmk6F_N4bOcv0iAJarR889dz-U7F_mu2CL3f6BcQseAkG8HTqX1E61fAGsg4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLCmtM7ehsrtWqiPmWNH4VZgBABFttzagS4QWjUdvWig&oe=6AF9C28B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cargo Truck VR-Car Transports", "keywords": ["Cargotruck", "trucksimulation", "Towingcars", "CarsTransporter", "TransportSimulation"], "long_description": "Get ready for a fun and exciting adventure as a Car Transport Truck Driver! In this game, you drive a big cargo truck VR that works just like a tow truck, built to carry cars safely across the city.\n\nYour job is to pick up broken-down vehicles, brand-new cars, or even race cars and transport them to the right places. Use ramps, secure the cars, and drive carefully through traffic, bumps, and turns. Every level brings a new challenge!\n\nWhether you're a kid who loves big trucks or a simulation fan who enjoys realistic driving\u2014this game is made for you. Easy controls, colorful graphics, and fun missions make it a perfect mix of learning and play.\n\nKey Features:\n\nRealistic truck driving with smooth controls\n\nLoad and unload different types of cars\n\nFun levels with exciting challenges\n\nKid-friendly visuals and gameplay\n\nPerfect for car lovers and sim game fans\n\nHop into the driver\u2019s seat and become the hero of the highway!  ", "short_description": "Drive a powerful cargo truck VR built to transport cars just like a real tow truck! Load up broken-down vehicles, new rides, or emergency cars and deliver them safely across the city. Experience realistic truck controls, smooth loading mechanics, and exciting transport missions. It\u2019s time to become the ultimate car transporter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Rexxxstudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30817919061126696"}}]}, "scheduled_offers": {"count": 3, "node
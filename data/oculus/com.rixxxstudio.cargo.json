ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301429_1638459126834410_7843657768751048047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_YoJQVmbxwQ7kNvwEfZzMn&_nc_oc=AdnVeJ3k73IigWer4nnpUs9BVv2s366K5q-DW8W9OFcsdmKeC4FB7VKMhpNm_2MdNXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8nIM0XjZfpKLK-yb8mhA6KKnt5MtmvjYdCbSHZUluCg&oe=699DB76C"}, {"file_name": "5.png", "id": "2877793802410877", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305027_2877793805744210_2066364993188004051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ2egD4GAeYQ7kNvwFGj7Ma&_nc_oc=Admkl9kLs7ldfxURmo2zX6F4NAeU2l4rAAebLvQuBVhnZAd4WCybMw581EEveH3Y1io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu65FrHynaPE474MGSk471yUIn1so9yC2TeSuoDY3jMMg&oe=699DB68B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cargo Truck VR-Car Transports", "keywords": ["Cargotruck", "trucksimulation", "Towingcars", "CarsTransporter", "TransportSimulation"], "long_description": "Get ready for a fun and exciting adventure as a Car Transport Truck Driver! In this game, you drive a big cargo truck VR that works just like a tow truck, built to carry cars safely across the city.\n\nYour job is to pick up broken-down vehicles, brand-new cars, or even race cars and transport them to the right places. Use ramps, secure the cars, and drive carefully through traffic, bumps, and turns. Every level brings a new challenge!\n\nWhether you're a kid who loves big trucks or a simulation fan who enjoys realistic driving\u2014this game is made for you. Easy controls, colorful graphics, and fun missions make it a perfect mix of learning and play.\n\nKey Features:\n\nRealistic truck driving with smooth controls\n\nLoad and unload different types of cars\n\nFun levels with exciting challenges\n\nKid-friendly visuals and gameplay\n\nPerfect for car lovers and sim game fans\n\nHop into the driver\u2019s seat and become the hero of the highway!  ", "short_description": "Drive a powerful cargo truck VR built to transport cars just like a real tow truck! Load up broken-down vehicles, new rides, or emergency cars and deliver them safely across the city. Experience realistic truck controls, smooth loading mechanics, and exciting transport missions. It\u2019s time to become the ultimate car transporter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Rexxxstudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30817919061126696"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1153097086284787"}, {"status": "PUBLISHED", "id": "1746420965990572"}]}, "baseline_offer": {"id": "1153097086284787"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761056280, "status": "PUBLISHED", "id": "1153097086284787"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33475792452005997", "version": "2.0.1"}, "id": "1819861602068008", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
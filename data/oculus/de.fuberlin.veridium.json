8043989", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974891_1428429331377322_1446745358009095750_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dQXQAs8NXwQ7kNvwE6YvS-&_nc_oc=Adpubp9M2agAVSGLtsRtxUaX-rPW-nKTBmfQpruhvt7MG2bwrI7Qv-mM4ZLS3L4NYwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0bkvY83su_ppvub_RlM2OufPFbwpgQ7zaJ3ikpsaIiw&oe=6AFDCA35"}, "display_name": "VeRidium", "keywords": [], "long_description": "VeRidium is a virtual reality science education platform that currently runs on the Meta Quest 2 and Meta Quest 3. Within the virtual environments, various modules from the science curricula can be chosen to augment high school and university teaching. VeRidium is free, will (soon) be made open source to evolve to a community driven project. All modules are peer reviewed to ensure scientific exactness. ", "short_description": "VeRidium - a virtual reality science education platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bcp.fu-berlin.de/en/chemie/chemie/forschung/InorgChem/agthiele/Veridium/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Dr. G\u00fcnther Thiele", "support_website_url": null, "website_url": "https://www.bcp.fu-berlin.de/veridium", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7441691575921884"}, "review_messages": []}]}, "cover_squar
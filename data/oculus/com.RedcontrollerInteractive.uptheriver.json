heriver2.png", "id": "684966564263197", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618432_684966567596530_4161334623786933165_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6pDffKMm50Q7kNvwELX6Jg&_nc_oc=AdrnIpCwLpVQtkTR7aoxL9HzMAcCMxDok6sTfyZ1iufojzdxULdjCQUg_6D0BBGniBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTd_hjJItRkDkTJWTD14BXQivVKJgVmugpa4sANmmKZg&oe=6AD0F574"}]}, "id": "1880325479262637", "locale": "en_US", "screenshots": [{"file_name": "ss (10).png", "id": "1772285600096063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618103_1772285603429396_3593731239688445886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad8mTYUh7fgQ7kNvwGLMQDF&_nc_oc=AdpoNuQoYZNcUpeMuB8m7KGje--M2a3B57C2C8AuJWJLl8Gmd-GKwo_V4-zrW3BgTDo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_iDJOg1vq11AVkamD6uJ2fUcTVYy9-E6IMuaxQisHUw&oe=6AD0F48E"}, {"file_name": "ss (11).png", "id": "1965889793983705", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTlvK1HX3gMQ7kNvwE57EW4&_nc_oc=AdpLD0T6YS9KEo9inPGLJMGxQSITBddUss0_RuLDO34SiZJec9E_mjIoUoFmjBgkH_Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH-vEWSlvrAgxUeiEmxSwVfi0IKkkvz9uzd8HIM52G3g&oe=6AD0D8C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV5NAHpzyeQQ7kNvwEjIaSl&_nc_oc=AdocoZOAX36J2xvEWXUgWh6qprt8QX1Re0EkVJ6RvV_7xR3JVCTBcl1Qm1anhIvrkU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZwWJqzmdNU3I36WhwZyP_A8vdLY8Go_R8NOE509td-A&oe=6AD0F734"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aylO9OamVYQ7kNvwHUZe6B&_nc_oc=AdqB3DUfAz81sfLjtLYAk44ddxk03lN-_hdqzbhNhHDrzJ-IBO5i9iRLqBeZIWgTtpQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8kXrf1WpeTCT8FSA3nzUN1OtBh73LWjNcdMo1dFnz6A&oe=6AD0FEA6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh9W7ITa2W8Q7kNvwHfjBhx&_nc_oc=AdoFdFJJFjfqTRH0bmQmbBjViHzZSEMt2UTMcEKABlDWqVApaHnqv9e3ceow09xKQ1w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPMvbl6XRyyahGKEuGcUWY3S0SjzR7R9ssHeVmYJMP9A&oe=6AD0E7EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uptoriver.png", "id": "24565991306405263", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620940_24565991309738596_4708001806714553413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV7Wyi0ezFEQ7kNvwHtPYGd&_nc_oc=AdpkkQvVtQ-O92XNDw_shXyIoKLE5_7hze1KWGHRmJv8Q7jhVUXZv6ky1yFDAL-F4RI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQp2kzmNPqTttd12W0zMFYmsRh2nTpCpjGscQFVzUNGA&oe=6AD0EA69"}, "display_name": "Up the River", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25144035441882671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1539647743717537"}]}, "baseline_offer": {"id": "1539647743717537"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762266180, "status": "PUBLISHED", "id": "1539647743717537"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25598734013079476", "version": "0.1"}, "id": "1994277408038121", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25115144208105128", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBi
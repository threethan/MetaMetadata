cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78RejigyrjwQ7kNvwEQJxHk&_nc_oc=AdqYIh71J6d4O16bOSPkijmrf5s1psFk7cOTFMi_Vshl0AC4b_rxVfFPUTGWfix9_8c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZrkvCzeN4jaPZES6kJBJ8JGbNgEtN6cu_jeebQfaMxg&oe=6A9ACB42"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVX3rPErdL0Q7kNvwFatw3H&_nc_oc=Adpc7KWMEYCzPUEWsW44ITWe2A0LowH1JY9yWCwjShnMUyOsrfKGwpC_WiTjY0Nb-3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9jDq74Cr9c1NwsO_So_r9qw3RsslrUtsMcnc3LUqngA&oe=6A9AE9B4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6yYtP_XdYwQ7kNvwFrVxiH&_nc_oc=Adrb5iSuWkFsbv8Qi2iUlJ4SqmpTfVFQvgtkf0R5j33tIfhNUR1VWNzk0HZUZGReRAc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcbBmjPANUAqVLn9_kjYEdWDwe-fhHOLFgQfOThhCfNQ&oe=6A9AF126"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3TgtHwrvNkQ7kNvwHUpQVU&_nc_oc=AdrRXDQuj_njCgn0qyo6r20HoSlrjteqwuAQDxytMP20-X85gAJHxZVDF9p3waUVfYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuVCMGZpgyWFoU8ELJgptUHDvDftpU0nXDHOdL3eyscg&oe=6A9ADA6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uk0aIQX82wQ7kNvwGH20ZA&_nc_oc=Adp7N-dafMpG5VOUhcAX62Qdt2lEheu6B78y7715koDJkEQUWtKB6Gx6lCeQJBXslRI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOl7WQSfSw303IyxbadtyC-RU6-DPENdCEzG4IQxovcg&oe=6A9AC60C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
=0cEnaUI7-_EQ7kNvwH-ZO0_&_nc_oc=Adr9N15jKjaOOSM-UkSou0KjUUBBAvR6xoMQwK64uZ2U08OQW1Lb8ODETCLyKW81vJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbmaCyBYINpGf63wZ_8nuQL23IEB30R9FHtzyN7bUF7w&oe=6B070C26"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fTE7sbatCwQ7kNvwHCQTi4&_nc_oc=AdrbstjRvYU0mFj3q4iIjePpbGFHjZUC3S6dslriHcx1HoD9d1EIfXmSqnyS7FrEYkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu8dfSkcJNdwEgzadgTbb8nZJlEnEux9RMcYC7Vg7FHg&oe=6B06F56A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qleFoai7AgEQ7kNvwEgiEYx&_nc_oc=Adpz2D8WmiH5zCK9zOWiNfJL-Ga163nm5vw2zHKZwhr34La976V2fUFvGoKfoA3YEoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4crJR5y_S1Fd-a-DbnCKmP0fxK5oxWVUt6khP6HEJkA&oe=6B07194C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oReW_mGVgLQQ7kNvwEn9mxH&_nc_oc=AdoMo2N99lSnvypB5yEiqfjh2dpmxgSY8e6gwFjgXMnEAvEpu9VcggH-rC_IDCeDTHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnYxh9Lxf9LJhcbrmzX802bsobOauhPeNuEBo4EQOhNA&oe=6B07104D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Up the River - Climb VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "
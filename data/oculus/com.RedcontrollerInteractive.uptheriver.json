cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzpkYNSwAXUQ7kNvwGMY26f&_nc_oc=Adot7jFjsWKHPH2ZKgiH8rKysCdBH2tSi-LQxxbxpJNBmXY8poRhyjzXzo4o8CY-Anw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmvDqw9t3Pp62L_foUEw4SF8Au6CVJQlnHs60YvDnDAw&oe=6AC3A9C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWgGRSffSgYQ7kNvwFk7djx&_nc_oc=AdqFnbFqnbQsP_VGFo-hFwAOdKr9k7sRt-IDSJNnTotEnIxbAvOs3F0ZBcUgWgUCQKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDhG1V2XV5lKBIizIF45sLRNOCaeaJU6V6gkL7rGB5Ag&oe=6AC3C834"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJcm1rdIc2AQ7kNvwGTBdVu&_nc_oc=Adr_1jttfRIdlIgtEqhuqM71qZ1HTyMm9tqtREDTBCUrVzX6bCiw4ULrTFWpdezTuP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnoDiN2k2L8UoFjcVk6FaRVOtU619tUB2LB1OU4j9QBQ&oe=6AC3CFA6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3MoktJLfF4Q7kNvwHDH6f7&_nc_oc=AdrJVsMGfxhDCVxWV7BpG1p8h9lRxO4UyHRBsbOirjKAf6Gx6ixS5s6dOAUZf-roKR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF63FjD1oehJvOP2uMJ2k0rWTTl_zOWcog6dCovmYAbQ&oe=6AC3B8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGvTYK_TbicQ7kNvwE-ImNR&_nc_oc=AdrKZvVeWhMfhJE2V8-9PctDeoMYNyaRcHtnujhTqkt_SOfWihWRdqt-rbBBG6a0SdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA-d3kD7aiGre_B2neVBMQrp82KQ3sGigAACQAEV84BQ&oe=6AC3A48C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
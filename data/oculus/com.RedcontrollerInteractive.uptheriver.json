42156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCGRN6nmnX8Q7kNvwE31BQS&_nc_oc=AdpVAW2A61RPsTBlmhp45oNC7760vyf8nU2mabQXd7wiZnNRBWTN3hyKtSbCMEkt3wE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FzmemiF9knvCICecNNfBkS0Fh6gTjeijwyzKbHj208w&oe=6A1C59B4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=any-SwDO86MQ7kNvwHQBm0E&_nc_oc=AdpnUVU3CIUN5Z3cJLjzDrQHgmT7KYfhs2dBRx7JGpCM_dwe0TUYgjx0Q9xuVOpamOo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ylCbVW7fmmV2y38WZJFLpFs9s0rNiqnbOFeUXfTxo4A&oe=6A1C6126"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNd-MLk7itQQ7kNvwEzL339&_nc_oc=Adry73m6Xd9eUHNecXdyRciH2EfyM6Ruttt_wNctGLCr1lJ_U0D6jD_Y2OEee7i2mBw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_6hWKV0B2THZaEI3iGtL7PEgxxTBAhgKDcknXVvCe2Q&oe=6A1C4A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKafA7HsxBkQ7kNvwFQyb86&_nc_oc=AdrMkgbWx_ual9Zq5WHRcj67C1oAR_6bCtGsYnN2pd4ctRJeBTIo7S8Opz9nZQAJSaw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_8SMZZcn1JOCxF44hPHMgo7mbav_B-jX9rfSvgBZPSA&oe=6A1C360C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CAblA53ySAQ7kNvwHemsST&_nc_oc=AdruDenTa-Q6Zx5BFtzc6hoc9ksJVvX6ZIv
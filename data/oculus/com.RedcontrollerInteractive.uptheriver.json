-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4ybM0q1c_7lJBeAcALixavTWjCqpj0GN_SVS4J39UZA&oe=6A22E1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uptoriver.png", "id": "24565991306405263", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499620940_24565991309738596_4708001806714553413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRKkhA0I9SgQ7kNvwH_rSnf&_nc_oc=AdrkM3quqPvTQFTKFn7fxmpnBfsGItmm0iJeIQZ3CU7CBQE3OPTMB5kE-_O_5AFsJoE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tZ3aHtx5OJ3f0r2RK47emrSpwGDMv_J9xNX6_JjSnxA&oe=6A22E469"}, "display_name": "Up the River", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
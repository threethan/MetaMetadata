cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feUEGnVpglEQ7kNvwH67CBz&_nc_oc=AdryckZAK62SN4koyrAlxqJHosmbfLbC4VVaUX5nm-vwoucmL80nDjYzMWj5JUZYowc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG__wPjbM-KS6OGlUt01VJ3VK9cJ8pyITLMtaZdUSh6w&oe=6AAA9D42"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN4dZImbOXcQ7kNvwF3UfUf&_nc_oc=Ado4EjIli3ZPPKwguRaqS37dIvBUS2xr0axilZG4spKOUUKQKOuTeV-sM_rBVnvnUAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC5esRLOG38hY-p7mWu1uSXBmroh5C-j4VByORqFYCmQ&oe=6AAABBB4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14ty72sEGO8Q7kNvwFCB6a3&_nc_oc=AdoNx6zM_6nrzDyTE5lp7qcyqxhXXmlAEa1oHPAhdogL5tgaOfm1wE7MrPGytE4QztE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7PTPYggXn-zap97O6ZftvhGv71G5lO7MTzeBHpwJ_Ag&oe=6AAA8AE6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6HAAJV5JSAQ7kNvwH7TU1Z&_nc_oc=Adq18va6WweNd6y2UPMrYu1-XzFYeu2De4YwR7rywqOEAC9xnhttxrwT7_F0f6gcL7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgW7esiowfhlqO8O4OptoI-SsIpdsx4cZK3SrFeGNNkw&oe=6AAAAC6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtxD7skTVYUQ7kNvwFaaUZS&_nc_oc=Adpc2sCISeb5fbhFWdRVTpXFZLUfM816fSVIJuX_XTwQs6mmYHyM_ChbZ27jHFuJ1b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTwHBQZZIzgS3evQY6nRIFcGhw2bKBPh1nEFa256_rxg&oe=6AAA980C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
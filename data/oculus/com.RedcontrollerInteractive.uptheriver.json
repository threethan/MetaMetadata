": "1494041728780239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0QpQr0hwj0Q7kNvwEiRsrO&_nc_oc=AdpB1FP0F0BPD-xxmSPPaDeGuoajvS742pn28X6iOqqKHWQMTa0rfo95i2VJ1yw1Yq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nhTxc2U9woBs7p5QkkjZrm7rmxA06xVcmTL1Zzeo9_A&oe=6A3AAC34"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piQcS17YCVIQ7kNvwFYDJXf&_nc_oc=AdoSDEe9LKrLHhXj9FKL3CmWKcXcRDiHjog2rdhI1ntgs4EkJEHxtFuuzdSeI5ubXFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9ilfHKN1z0FgCbjnKf8Jwcq4g5Yq5FzaZGRwbyahuOw&oe=6A3AB3A6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFBA7gsnB3kQ7kNvwH2x9QM&_nc_oc=Adok_b3cEfGT4zXzCJaC33Z2PthVld3MR9xvQ8C5-MwVB_qgF8l3TThyGqkqqDRGRak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-941fkGPLv6UdqY-1WjKPs6098b6wxJkIu_qn85Chx9g&oe=6A3A9CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8KLGBGyQYQQ7kNvwEDxw61&_nc_oc=AdqQLOEFUCMIaPRxmyfAgGCGfdJQ1ouGSYr6zM85mSCMANufCT0GgZXlaZodzEdXuxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CSMBLlohyiprc2n1kYbEygZ1fw8quS_BBZ_01ZFC_aQ&oe=6A3A888C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=ds
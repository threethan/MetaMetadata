cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYrYY6VqfRgQ7kNvwHNylGy&_nc_oc=Ado2grZIULoxA06IczXXwUUoWnxY2Qe2V7fDzXBj7jK_U58De5GhmeJXWT-UQAQjD8Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcZA5hwxfBltCJsX7Zlq8wfC1UM5avRkHI5NkItz07lQ&oe=6AB67AC2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41YOeOb7oYEQ7kNvwEC7NXX&_nc_oc=AdqDBp_YYV278QJdlPUP4Q8OcBXO3F0_XkNBiRy8peSNvLAGYcSvc5yoWmnPvW9T0PM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd9C6ozq0O_nZsUOETJiGDKKD0-dM5id9Ll62ik39FRw&oe=6AB69934"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXEIzubvKXwQ7kNvwF3eATV&_nc_oc=AdqLH9EslcHNyo7VhVfHAuC01u0OHeF56TfmHWOhWZCWb9lMl2A7VOdLqxIEdLPmZ6E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgfKdA3G7x9pm-loTVk-hOw4U3Uel8zEZd0QiFEJMc5g&oe=6AB66866"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On7h25s8oB4Q7kNvwH4Fzfk&_nc_oc=Adoqmf_KSKYN8VXTvXn6x_ifXxA_VDcX5BPcau2qrVvo6x0NK7YVwqlJ2_2bsf4jdB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4dGxkVV2RAt7khSSMNMIWJsQuK1l35FUis2ehhpdKsA&oe=6AB689EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqp6QzlQ3kAQ7kNvwGgTb6a&_nc_oc=AdpJOyMofH7okx5BSFAWvzxko-GFe-GE8351yyg3UJdT_dYAdcKJRETjX_ZzbDvsUC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmfy6jXhK1Bh2rcLehI4Hg4Wij6gVZoe7bPPXY-SbbTw&oe=6AB6758C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
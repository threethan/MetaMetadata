cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK3d8EHb7EYQ7kNvwHjuPkO&_nc_oc=AdqEZIVnaDm1NZMRv6ENORFoBZAQPu4tMAQlxGy8WL8PEK2IVPzUWR7a8Cw0FfXoNDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZZNYZ6Af2td80rYAENZSf6HIPu3GacZk3rYja-CBNaQ&oe=6A903F42"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq4NkcIsAQkQ7kNvwFjDirL&_nc_oc=AdocW1aAHnWQe_TPhS3UCvQCdqqHlEy--tFVQQPXTucqJVVd-Y_AnXI7NCiSNGtX86I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEvtzhPa2A9a9oXJ8YOvgFifpSZ0nj8_fTSj3XUkXDOA&oe=6A902574"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpJJMzJK_n0Q7kNvwEW5nj-&_nc_oc=Adqzzn2qxWwzoEzEKODXaPIkdjrkt1A1LmitwbSG5OrisK-l5CyFZkOhmOgAbikzj_4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQg_E755MV40o1fFoT_d_2Ftf_G-0fJZFGDW7NWiNSIA&oe=6A902CE6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Khic5-P4q2IQ7kNvwHIQDXY&_nc_oc=AdosWjJe-9JM2brwZGiNQMl8AKShWtW73JDrD3IVzrldMDZpaDfY0wy3Uf-FNBhdefg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcSRj09fxS-Zzs4fNDmf-NSq9D8AFNwmzBoEd14Jl9tw&oe=6A90162A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bB-uUrDNS8Q7kNvwGBw6Yw&_nc_oc=AdpikwJHDGSQaxWRJi6Z9z-ZFzQinIXWnBAOcEJ27iM6r20InrZaLuFODbcWpnue87o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEo4UIiH0SyVPYWux0UI2q2NxnPFz3sVnhHPrB8gt9wg&oe=6A903A0C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
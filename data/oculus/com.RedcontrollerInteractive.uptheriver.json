023772944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5j7F_NDibAQ7kNvwFdQ2Wv&_nc_oc=Adplo37WpQ9DQKi_Wf7xui46Pqe8XBoAU0J_F3Ql8b2C2U2Zv4RT3WjjbX_GFsVletM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnDPn5UI3n95C-Vhgebn-U3dhFSQUNjU4ojly2ZPUrTg&oe=6AEA0B26"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrlTVUJZowYQ7kNvwG756qG&_nc_oc=AdrMAVBVVAOJEWqF5PQqZOfw8QYJG8GqbmVtfwaHhbWuUJcGE0pEI6hq9oXELZFx1ZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0_IjHtWHtKzidsW_E4NwbhM4PvcII58FoEONkUjWkqQ&oe=6AE9F46A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uptoriver.png", "id": "24565991306405263", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620940_24565991309738596_4708001806714553413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHkuwYlfY_8Q7kNvwEm3b8S&_nc_oc=AdoRN4j67rGKFgIAWy6TwZR-3zmAZdYk3X3nmIoe5gf0dNTf9Sj-c1onuZr8i_u_HwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYC0dZ_bl7Rch86ca-EYSyHPFF-zIBY386y-SflN123A&oe=6AE9F6E9"}, "display_name": "Up the River", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25144035441882671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1539647743717537"}]}, "baseline_offer": {"id": "1539647743717537"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762266180, "status": "PUBLISHED", "id": "1539647743717537"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25598734013079476", "version": "0.1"}, "id": "1994277408038121", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__
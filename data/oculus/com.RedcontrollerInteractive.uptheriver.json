=dP_Gz6OisxEQ7kNvwFWp-Qs&_nc_oc=AdpcpDoqz7ale1guywE2wKrUMm9CVWgzZNuFEGXXsg94ABNTJiWnM7moBauCd6gSQaM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuLD_Ro7LjWd-MS0_E52_tmQOwT6ck-hQOjSOLyX49kw&oe=6B0B38E6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxhmWlu7NKcQ7kNvwHRpzxU&_nc_oc=AdrQhHzHwwvB0j1jXDUsiOaMUZR85TiBljElr_UPDPbgUFUiAIkqW3xAaF-1zMiC15U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPpSPbL1u24S8h08396KLVpGJA-gCwGdse_ZnTBOMSAQ&oe=6B0B222A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TLXlLPHugYQ7kNvwFUrjZ2&_nc_oc=Adp3RNJ9rPgnL8NEr1ttuA4PUDGwN3UgsZ0QFhD_AjWtCswEmeTGK4gpZfTyZEPi0cw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjsIXCjWL0bCCXegm9zQbsTrR4KfDV-8rynNdvm0XoDw&oe=6B0B0DCC"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nqqT-85Kn0Q7kNvwHLf_2A&_nc_oc=AdoOM6yLxx37jxvM9lZgPZ0-q0JpL1vhGSMb0x1gNZqn1p5vOCJYkps14AHrU0AXHMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfNtK-I4MZkZRMVpo6-cnOWUulvOV8HqJjXCRNiRJ1LQ&oe=6B0B3D0D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Up the River - Climb VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "
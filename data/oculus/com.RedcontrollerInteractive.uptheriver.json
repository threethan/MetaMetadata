cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0Nm7Sx33qMQ7kNvwGUP_bc&_nc_oc=AdqZCtD9nZqjopruCKgyJ7e7cziQ7wrFyO7nJQUG1hATGmeOOfqAAudy_YOwfkapRJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhk2im4eEoC1DXP6_sHDb0TU8L-wGWmuXn5Td1n6Vipg&oe=6AC25842"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpyNMNXP57cQ7kNvwEl8XeW&_nc_oc=Adov5Br_cqxHbbbu5ufW3gKFHVuiU8_RobD63A6KDUr8MU8sOGG286t9GZgdaNAIhFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA5EpLxBj6k8YcCIZJAfijvOnk5KAeY0YBJVTxJ5UN3g&oe=6AC276B4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJcm1rdIc2AQ7kNvwEi4TNX&_nc_oc=AdqHJ3PD8UqQPz7Kra9Abbk9tkEh6Dzo0pORoL-JDynwxpdN6IkCwGs9o9nw_Ovk_Wk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM96decHToR1yzMKFwddySgHxXqEl7QDx9ECkhBDTycow&oe=6AC27E26"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3MoktJLfF4Q7kNvwHbSref&_nc_oc=AdrS4lvxoeoCdpGklk0mQklFnysXc0JoiZJgL9vMN1XI-AziqNPsCqL0JDJrrXEZ0wU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlvJRWXUlcEilInQ_8GsZENeCBU6-6vaOWZQMqK-LyfA&oe=6AC2676A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya5gQ-NXVZ0Q7kNvwHRR5MD&_nc_oc=AdofpeP_gkJDmHP30iYfTeOqgxiFe3n5Qsy2-QcflTJ0xVsUmAof6OOAZFRvO8kwNwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuPCTwm99SBkEZsZYFOzY0DqKKI6ri5AYSHas8o1bHLA&oe=6AC2530C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
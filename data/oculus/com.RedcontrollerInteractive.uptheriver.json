uscdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7T7pBHcPKkQ7kNvwEz6q9W&_nc_oc=Adr0Y9l6wMIaEIG7FxCDX5w8FS8mfhVr1YvxWxpjnZk8u77Uf1z2klqQAHWsKFO8Hgc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ59utdoz12US6tfijCJNrSYgeDaIvOHWstXrYaS124w&oe=6AAE91C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4NIEIcG0aoQ7kNvwHamLfx&_nc_oc=Adru0FIgUxRK165AUyBQdiUBleE52jOedkN-3JLFGq8ATp69nPRe5_FsjJVmwq6iCHo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb0LPYZtIEw5Dwxi2HClPwMdFKVpsS-arGdpj0ScCeUw&oe=6AAEB034"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yahYGFwjlgoQ7kNvwEUJn1y&_nc_oc=Adr6M7Ni31wyhNxrvSXrGgb1ujrZ7ENfyNAqq2M4xWXFM-LUUv9gSIt5Kew8ONZ0g6w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm6Fmo2dq8BrLp1m4LbSL6fEO4ZPspsnK4wsmowBT9DQ&oe=6AAE7F66"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xAStfvyxXcQ7kNvwG78AmG&_nc_oc=AdoHruSX8mu6jYMAEjSv3Mo_xDczZ2Bcha1WJvgqhl7RGVvt0642isxj4lrc4fz10uo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINKtIx91ukN7k-x2HfcRbUAbc_P335AQiCisw1GuzR8w&oe=6AAEA0EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IYkwcsLVzIQ7kNvwE1vL8Z&_nc_oc=AdqxyXgdPnsbnl-m8jVErG-dRP6RAYZcY5hDf5HySztbG3ztFcCxMyvnNbbypFS4sRU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyrgHDusYyk-6dBdMzWGOoCJ08iaOGeqh6CJP7SouIdQ&oe=6AAE8C8C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaSL2Kg4WJsQ7kNvwEMMFJf&_nc_oc=AdoTdxE5bPJlb7rBmLL0pBIqBNqIzg0IgsEpLlQf_uV85urPVW7mhhyqQEvZR8meR7U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQARP0thWpBambg6lCS2hQPOExBigPX3ghoytx998eYQ&oe=6A6F49C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNvWOsmZw2IQ7kNvwFWjxqE&_nc_oc=AdrCyKpPwUbZcbl_A_Q1QrIUKCuzY-cwWyB3IsZW6856xWSHj7ldvkOPHG5A7QK_odc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWOAlqoCWLpqcJVTdFeXUgtfWeDTkgCWV6H6rf2WZyHg&oe=6A6F2FF4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqE4JN0pn6wQ7kNvwE4C-sL&_nc_oc=Adrz38PbnAo4jl5xY3imtcl5lIXXK59uFAVaRVl7pkP206P0LflqMaclJiwB-yg82dk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqxk_sttRoPcpVvodadHvb7YKG1Z1x_fIUUOOBYPg3lg&oe=6A6F3766"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d1_XmtmKG8Q7kNvwF2bw39&_nc_oc=AdrnIi43KVBS2SMI63I5FN2RKyDWHpUfVaGdNRPJIeolGB4hfkfoxE1euPRIe_NcjZo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpSXyS3fs_Qw-NawKprnpGiK42RA_TEwxawKoYt5b9Gw&oe=6A6F58EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obOnnEj0XvQQ7kNvwGYIHE3&_nc_oc=AdpBa_lSLBRvAj3Gw443P82fuhN5FtB4xmIxzSxEyXKL-xJuDR-_7hSuEruBp1833VM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZdcckqRjzcINKJO7WQ7tueGJXsROD9-rM7QYoE5iKnw&oe=6A6F448C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
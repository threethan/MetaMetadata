cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUUpOTHtZR8Q7kNvwFWpz1x&_nc_oc=AdqAZuErls4kKtnC6uL6HsTB_6GzVBLwmcATPIwHAdRoVlXXf-_agchFwdQceAOoXa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzk8m4DA6i1i3PN9Q5svDQFwH2Qcp45iyEWS7U5eUyjQ&oe=6A9EBFC2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWY2DJLQtloQ7kNvwG9NrTh&_nc_oc=AdrqOENFf_7sW9cYU28jyFKxEmyYSeVUO1MYV9CIcsorBXyn3GddaiqNHc-Z846j8iA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrcbyQOHoZPL83AML6LW_On9fKF4ezHyTHjHGHHxJywA&oe=6A9EDE34"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csm-cVb84coQ7kNvwEhLuYv&_nc_oc=Adqq3hNEPm6_psMe6Bg2QOwzLj_G-RRkajfcvlULnFqZQR9LVy_9WOqPacI1Qcxdolk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuNJiiVdCntAD6Bzf6pqSk-5I__nkFO_oyiPVc3n5lFA&oe=6A9EAD66"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L_PkCKD-S4Q7kNvwGx2yDd&_nc_oc=Adp-TgW7E63UHSCyXiYFZf2NVbNSR7d85q63_5v_LD-OJ6_v2IQyzZ1ayyK7yVktyzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtSLm425EapmrjXobDRAqcJyNVG4y45zJwgERDwxgm5A&oe=6A9ECEEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfWzgpexfJ8Q7kNvwG4y9hd&_nc_oc=Adow1O1PpcAG3LEFLLK6GIXl4BvWw0wn9VGoN6JKr3Mjkt6GG9QSCwelQ4_GUMtYuv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC03p1lgEqI-u4eqI_uYQLzqbd_ilKTcpv9yRmHfMiCg&oe=6A9EBA8C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZTfKwx0KrIQ7kNvwGRfl8Q&_nc_oc=AdrLl59KnKN46SB2EF7YMXZJ68sb-j-RtSBZ0IA1Gz9KkBzuZoINtZuHkkcy8qYlK2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgKX02DO4Mqnnivd0B-O601CcMME8mh6N2EwoR8yGaEQ&oe=6A75E142"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2VPA8pJ9LEQ7kNvwGYy_zF&_nc_oc=AdpiomLuwy5CD9o2gakKg6pQ5Q6juKVMbio7I2a3PcLCgLYUn27PKoEsbF5TZqyJ1Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGso9910aLf7BPsW7JEGiYcpSFZXSHfP2Km464bQuAhlQ&oe=6A75C774"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHSHE8D6wywQ7kNvwFIHSDT&_nc_oc=AdqyP0vIWUmiy51OnlGzOudKIPEl-z7XtvWt5tN3oHDEPuebYmJxE6YhRXegEiVwvQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7cI0Yqa2S_4tTuLVIUIBKnUz3AdkroAj2wkO5b7fG1w&oe=6A75CEE6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUgl2FZ742cQ7kNvwEwKJAx&_nc_oc=AdoizDY_bpQ7ZCOL17c_QJfYGJAzjbEw0WNUgOdphG5zKBwTVM8kMACYMT583VmXi3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3aaeU7fFL-bIa7_gfhxj6-Nh109pTKvEsYBGAA8c1DA&oe=6A75F06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV0Kb1EMpA0Q7kNvwFGHNKr&_nc_oc=AdpcgSXkGHuRwYzukMdaAltJwa5jXYtGCEWJ4xMBJUWZx69yBrTixgD_zdyG9EDrjrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKre9iEtmFgtHOrRlJ0Ku5GmP8cspNut0arkfiUjcivg&oe=6A75DC0C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
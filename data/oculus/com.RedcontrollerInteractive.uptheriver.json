cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btDfohcYdWYQ7kNvwG2H1uX&_nc_oc=AdqFWgE85SQPffKmE6FoY4OuHmLltQoHCtLaQhS5o73iKs_budkYYvGnBxHG1JB1UZs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDdcuvN6QXpt6dWfn31J2GP9tf8j5uxq70ECunhv33Sw&oe=6AC8EFC2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIpp9Chjv9gQ7kNvwHFM5qB&_nc_oc=Adq07LvvauACj-usmJ-Fx-MkW6Gi1NkC5QQkeVZcpBF_f0H4RP0RP_frnhHZpoE8LSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1Fdh1fTH09hZ55Hrk7p1QI9PRKrnidFgcMMiNaef84w&oe=6AC90E34"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0sb2UiQ3NQQ7kNvwHCPywL&_nc_oc=AdodgeFFYaNss2Q9DPudmfBi37113WMKv-kItua4oqNQTqmYse5kXi2qzNCrzD5tfgA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9NuNXxhEuV3FcY2-AoPUXQIyjrH_RHdmM3UO653q5Dw&oe=6AC915A6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GId8U3OES_oQ7kNvwE91x47&_nc_oc=AdrKRH0DC-ryBzeF9VGIQp5__g7D8kVKCjedXBsCvCDlXikrsKo0w8T0wZXxAO-84EA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbixmvltHczljMfzFHzURDg0JjlVbI7ZFYwQH9Hxfv4A&oe=6AC8FEEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqTeoBFR9q4Q7kNvwEj_0dG&_nc_oc=AdrD2VO-bZYNl45e7zwr3EhJNa3K3NLg4LkUY_wnlRFURXw8xrw0l0gUP5RQtW8NHUM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3CWyVRAF2kcpi3effYCh7AWS9zqZWvxv0w721Mu8YTA&oe=6AC8EA8C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
heriver2.png", "id": "684966564263197", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618432_684966567596530_4161334623786933165_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFSnML_6PtUQ7kNvwEDzmQG&_nc_oc=AdoG1dh-UrEV24AZkbYwxWWbwCKqPGRG1h8XKHsZ_psXJXdwe7-mR_r8-X4Ir5gp6Dw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJknx13UUWj6LHlVevSf_w8uSHPG_zJnezCoO0bNpa5A&oe=6AD39874"}]}, "id": "1880325479262637", "locale": "en_US", "screenshots": [{"file_name": "ss (10).png", "id": "1772285600096063", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618103_1772285603429396_3593731239688445886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z8sUZ4HVkQQ7kNvwEM5H3L&_nc_oc=Ado4fD_yLq3AdfC-qNFM8oMjEP9FQpEap2X53HE_ornczmULgzi8vIK0eQupNAUTR10&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_owTl533E_kzJfafAPWLjpuru14xSUccbGSuCjnBcSA&oe=6AD3978E"}, {"file_name": "ss (11).png", "id": "1965889793983705", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUa7uCAMq_wQ7kNvwHS5zmT&_nc_oc=AdoKh1i9Vvp7IvgyKXyzLv84Pq5IbZ03s_d9yEisf-SdDqK0aFRrWd0-a-w9GSodPrE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLWriQbAEWU5KkgRiQGLLh20Bo6EWfpesGi8lRRaKRIg&oe=6AD3B402"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlH1eHCdk-MQ7kNvwF5QN_s&_nc_oc=AdqZHmCTt_m3Z7DONnBF6vJCimld0nIh7ELi-Hy5cOvgxD4Md0pFsilItnH4btt5mi4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpB3fcJ94slLrXoKmukBkbf83hThTf-_mhcFfvBjYAxg&oe=6AD39A34"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aylO9OamVYQ7kNvwGHRo-R&_nc_oc=Adp_4IQFhIscs_6Nn8iJAnula22MgG2fxyg6Meg7WSEiU-O3rzBcjR8-OFoDmSNr7r4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcgr97hyxObwdqfT5IskmPK0d7PRlMe72VtbNkwOqofg&oe=6AD3A1A6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh9W7ITa2W8Q7kNvwG4XPGZ&_nc_oc=Adolf3hnnexCT1w1GHUqE_o7IGwNuwlNuYPiqFk7ZZgo1KW54oINw_3bwrxeAa2ZBQg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfLhBfKCyvyfGGgrQ-CfCdVC_i33UV4270lNsK_mgy-A&oe=6AD38AEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uptoriver.png", "id": "24565991306405263", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620940_24565991309738596_4708001806714553413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV7Wyi0ezFEQ7kNvwFmv6u0&_nc_oc=AdpbDRgJSogc25AXtj-cnjH-opmelkMPAVWu27h14h6PAIus_rV6U_1BsF_-TA7Qy7c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObN1Tpyl75ygqpM7vsCMOmcARFMtAPzSQAZ7JxxgNcHQ&oe=6AD38D69"}, "display_name": "Up the River", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25144035441882671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1539647743717537"}]}, "baseline_offer": {"id": "1539647743717537"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762266180, "status": "PUBLISHED", "id": "1539647743717537"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25598734013079476", "version": "0.1"}, "id": "1994277408038121", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25115144208105128", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBi
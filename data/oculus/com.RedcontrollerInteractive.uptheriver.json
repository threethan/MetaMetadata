cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0Nm7Sx33qMQ7kNvwFMuiM1&_nc_oc=Adpel6TXtyVaaNVGHTKhHFCa1h2iPHndkjdzhYmObPkqmfLwXyspfpwtISdTLM2pHdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_05tHH2vQj1uNroBQCTeeBmfWn6V5Qzkivo5dS6zH4w&oe=6AC106C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpyNMNXP57cQ7kNvwHUfzGq&_nc_oc=AdoBFQT1N5ESnKhq2A2UvdJ3O1ttD--v37SfQ6AYEVDvXugYlTCNVNY8zRqxcpoC8Zk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo0PDaFb8T8zHR0Z07ngGj4KCiWqm4EYXyKEwGR4IKCw&oe=6AC12534"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJcm1rdIc2AQ7kNvwEAnvlL&_nc_oc=Adq5B7WJ8W-_0fRjgRxK8WnGDY5Ktkuka7oCQTHlJoExqIahgx69Clo7YENAMxUfSQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmCSWdsmtp4hV5fR5kZp8plsZSZLNCDAH8OTmikjT00A&oe=6AC12CA6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3MoktJLfF4Q7kNvwEfos6C&_nc_oc=AdpECZqE2T8kYBe2NhAhE0BjY_vfZPV7pzPs0r9uCUzwoedgRPs1H1y1gt0GgJoDTz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1rJHJ6kimaIoxDTiAXHb9d9CsF1ELPvYSAbksNMUElQ&oe=6AC115EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya5gQ-NXVZ0Q7kNvwENWM-9&_nc_oc=AdrenxO8TUFOhfQSYKd-NTFlQ1KvPraJwaZJXg_olN7TRVebvsswLoe-tT48v_nr_9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3oSOf-0Kg2l4enxHurO3N9SGSRuoQGzgA56GrLpb90A&oe=6AC1018C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
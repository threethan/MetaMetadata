&_nc_ss=7f20f&oh=00_AQSCOwO7elXMfOoi8NYkEH0jv6oqsRub-3_O_laLCw3t2g&oe=6AEDF834"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yMAmizBe7YQ7kNvwGWcphE&_nc_oc=AdqhvWMIRjv4uW3OHILw9IAYc35eN-WHfoWGvnx_mjMzS-NZUS7xuYyD6YB1H_RrnfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCHpsqK2R2lQddnlhKN3F0FdNBDGUUFpQUyQ4_zuDzQA&oe=6AEDFFA6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEXcVD5sI2kQ7kNvwFICjwy&_nc_oc=AdrimMLLx5Pp1smKqsHBUz4e7dF0JUTzqCubRZ0t_LSCbnxt1Ob5NTZLaiwiLdCFTfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAxNyB6MTDMBK21vniGZraTxSwJl_6pkFahCH3bkGmFg&oe=6AEDE8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uptoriver.png", "id": "24565991306405263", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620940_24565991309738596_4708001806714553413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unaXoH6N53cQ7kNvwHHQILd&_nc_oc=Adpma-YZOJmuIXEyyrxo_GSdm9BRk-DYUBCC3ZhBjtln0pTCPzpay6YZrXyuRRtr6zg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmUo7dQ8Xx_iSDSpzUBk_5DlgZrYDPJDCS5jy44iGsHg&oe=6AEDEB69"}, "display_name": "Up the River", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25144035441882671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1539647743717537"}]}, "baseline_offer": {"id": "1539647743717537"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762266180, "status": "PUBLISHED", "id": "1539647743717537"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25598734013079476", "version": "0.1"}, "id": "1994277408038121", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
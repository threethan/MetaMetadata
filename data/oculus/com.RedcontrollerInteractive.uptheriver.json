cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaSL2Kg4WJsQ7kNvwH8a03V&_nc_oc=Adrr5LLmny8vNY9GDgDj-PkUN3MqNXSZpcuL5lzqGjgTIHKxSxOoXsdl07lkgF40ECE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDru_eXyxCpLVSVfOpQp3DORTFRzAReSHB43GyFJ8nqIA&oe=6A6DF842"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNvWOsmZw2IQ7kNvwHlDYPu&_nc_oc=AdosxkRshBGIT7YNpZMcEZbL62KCm8RMG4UPRNInlP9kq0O1ErI7Qe5uAQEpZs5fWi0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJv3JxRsd9M7C0mU1QkWaJ_M2aW-00PxYBaBhmS_HElQ&oe=6A6DDE74"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqE4JN0pn6wQ7kNvwFEMJzY&_nc_oc=Adoyo_dQHVkcAgWzuGOS8CZQ5yF7lGWGxS8eFgHE1l-s3wbDSFFqLcBjaLFnl-3oiW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7ZwKWeSzfv1Ys7Mz7Q-ZaGQhuLctAFBbvU7iEh89fvA&oe=6A6DE5E6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d1_XmtmKG8Q7kNvwHdWNro&_nc_oc=AdrxBEMtCmDX_fJBW87UJBcbPDg64hiQGhe81g4do3ohinReymRbfGLNRPJ588iYiq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_ZViLaDSXt7xsAvFiVsZshOAZhws5iWexkeXl3v_gWA&oe=6A6E076A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obOnnEj0XvQQ7kNvwEjaYiE&_nc_oc=Adq69gXGnbYI7rrSEotjCE6QhNY2p89shEP3JT4jDicnLc8PoXHdq1sqEJaP7yo1Ejk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjTqXuJruARi7pHfA4bkCY6gFA_O6yFzWvB41mLXIAng&oe=6A6DF30C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
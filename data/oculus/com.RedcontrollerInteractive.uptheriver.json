cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyEAN9AO6oIQ7kNvwGTTEzm&_nc_oc=Adqddc8x6SROLrov8qq-muO9XgCnTyw7IZ804zqcAH18PdguFPhZnnBVWnizQlj2Rto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaLoEyU9scS11MBRsnV1Dn5O5EXH4kZ5q3D_ZF0dt8UA&oe=6A79D5C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDuL9AD1Q8cQ7kNvwH6Y-ke&_nc_oc=Adq7uCloLM8BebKWBDUajPX_eraimiLApHWXDSmybEkdwfO_gnED5KIcWxPk-VxKh9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7_Xe_bT37VykLxMmadygFtYmatU9y3d3_M6iXLO8NtQ&oe=6A79BBF4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kq7KtIP5TUQ7kNvwHSWqr7&_nc_oc=AdpWMKSqiMf6PxkU2ZvNSx8zubrgfXPJ5FdDMCnLXkBQAxcXGIHLBT5yXMsmmBzsvn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQardnIqvNVKhK784Tw95Uxl5JaWqD7T6reP1sk1fapw&oe=6A79C366"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbL_2b7Um_kQ7kNvwHzJMjE&_nc_oc=Ado9RH1MQTIWsih0g_9SEaTIqAUOMOV9B5n1-h0z2b13YZwvhRP990RZ8qs1FwcDsOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7uF-7L20KrHTy7X_wLlK-dLvG9RS6RAFs7WQ6XGkhwQ&oe=6A79E4EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZBlMV14GFkQ7kNvwFwKBqt&_nc_oc=Adq_YghFUmeqMX72FqHAUCwVbyuzkumliVdLG_PaAKeNzZMdROSmpwh5FatIYbZglw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVTb9YEiailCkMEWOzuIZGZ9-366HvNyDOHV48ZJJI4Q&oe=6A79D08C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
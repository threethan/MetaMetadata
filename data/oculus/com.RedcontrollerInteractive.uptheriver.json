uluscdn.com&_nc_ss=7f20f&oh=00_AQC9oGbB5b9E1a0QPmd_YDrSndj2mA-fpBeZAi7gBPBQjg&oe=6A5CD4C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6ajZfu7Kl0Q7kNvwEcmtSU&_nc_oc=AdpshoxlH2NaHw2M0ufCdHzGzesQBiUJTeE-VIEb3oCJK689n0kx_zecx3_znnknXoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKmao7t4VAjTMpaHJaD-AFkC_zZoJbVJOHKeldOGjkmg&oe=6A5CBAF4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jEHIC14WR8Q7kNvwHoDlIL&_nc_oc=AdrGpSI3RLkqvGUk4kth7tK7wdX4YWCS3otsqncic1Wwq_8Q24lqp4Lrre30kLD0q7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRxfm7Nw9i6WyRgqDxqXynL6ClJNJ3KfYYyNeGIdWHMg&oe=6A5CC266"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aFDE6LHuhEQ7kNvwHSkaJs&_nc_oc=Adqe2gQI8fqQZM9nBudwLCBo51EWp6r0JSTIXU_T33CoQ92XbA3x1LVivVA1p8PuDa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6QRHf8Tj1jBTaBWqd6gsAVPZ9JFVcU4W3qJNsys-YEA&oe=6A5CE3EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTP5I7F_6XMQ7kNvwGtvr9r&_nc_oc=AdoVuOFsYzLIJaHEcXWuELosJ5o4PbUi_mW1mm1T7_Y6Fo1Crej88db6gNkukIyvibc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyHobVgNc_1oYP0ri4ZBhB3uHab35Z8hUHmo7cpms7_Q&oe=6A5CCF8C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_ima
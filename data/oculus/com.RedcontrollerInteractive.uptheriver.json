cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btDfohcYdWYQ7kNvwG27iKd&_nc_oc=AdqSgXjP7MhRGylOBP20N-W_HCxEsB_CWUNGP0FeF0j8b9B7FBYmwKQ7-JDPEsH9yxo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlAQqKsyZczo5HeExnGQMF2AYA7Y3yWseb2miONzAsPQ&oe=6AC79E42"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIpp9Chjv9gQ7kNvwGNX1JK&_nc_oc=Adp5QvVDRL8rUchAJTekZq1Do6WoCHmm-27FNgOW1RyelwStM0TJLve9mGMhI9ZYq_U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAPMVLIGkOOApH_Nh8ARkTI7aMBBuza0Gy8Dem53zaOg&oe=6AC7BCB4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wStJMXzLoz0Q7kNvwGoEE_X&_nc_oc=AdpVDyg7t2pUIq3SH7C0LfTlYzy12aelE7S4wOKbZ_6o5NhCSvjyIC0a5AIoNQhpPLY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO32Dc3z2abc9A9X-_HlYg3Aea5XtafW0Vig7Q0xFKDEw&oe=6AC7C426"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1Yav0SPwjoQ7kNvwEekL7v&_nc_oc=Adq9CmZ2Q_8WcnawUjEWNTRRmN3s9sRcaX6K5uA5pyBJbX8yBDKtyvsWhWUgEL7u5pU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOuwvLy-G2Akq96eIRaBWg8MgHRrE5oDXC_fs3aCfUXw&oe=6AC7AD6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqTeoBFR9q4Q7kNvwFGKJg8&_nc_oc=AdrU201HVyBtoPxnrl0LEG4PiMH16ofjqRkkiSh8aol4NA2Ei1J1nsVzvgDfv2gyULc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDvxeJ7vMq7fj2XR40IirZ5hHBT9PteMDsczO6tl5A2g&oe=6AC7990C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
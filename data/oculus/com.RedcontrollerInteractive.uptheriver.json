cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6Ycq8oRMisQ7kNvwED7ybx&_nc_oc=Adr1_umTwNclwvn7BKAg6gbRWF9NwSYTDKLiOsnFMeqLSLHV7KTlrK__jWK0jxbYdOY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4znx_31t1M6Qv3vkqzTbunkUKQBAVsNuT6ua6FBHaLg&oe=6A881E02"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBJK44ReZ0cQ7kNvwGD4KKz&_nc_oc=Adrl6QDC5YZL83QAx_eEpydytf1FTm0NQZprjUT8lJ80A8RPy_n9V5PVCDsxEAC3jOM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlgJ2HD1yspn9t5Fd02oGXmN3VWXLMQo4gUYJLbdz0QQ&oe=6A883C74"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARD288SSs5AQ7kNvwGGvkWw&_nc_oc=Adoy20uG-DMwFmo0Gd9AJxDUJiGqNONWsB8WTia2qzmt1mBfsCDcqbGJtSlp60wU1l4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFLA_HtylvRwDaiKrw85ZdcEX_GVAm92ctTcd2xVLbpw&oe=6A8843E6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buVKILpGrGAQ7kNvwFqaeET&_nc_oc=AdrDKL3LXQhRQOYUmyktOTbhosT3Njw-tI0wFrhln4G7hrx_sExY5LcHnd0Wu-64gqI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqvt3wJqJbOyfzORPfvL61ne9HlKhOxMhsyDaEtc0FEA&oe=6A882D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3Gm4WckdVYQ7kNvwH2loOS&_nc_oc=AdpQgyJ0XWqaSCjzOwyylyzOKMbFxppKKFw0YUj83LjX_0ZbHGiqqw3eM-q9KDiQVpM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG24NSymD0sXlzCDkenJcHbJdo7ufEAWyL1X9Km5ULI-g&oe=6A88510C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
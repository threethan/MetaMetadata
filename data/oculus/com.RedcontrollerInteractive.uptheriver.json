cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bJ-Ibt34-cQ7kNvwHNWSke&_nc_oc=AdomRtz8e4bxreYB9RLFtMq1pxJ51PMuzaj_sGwIR0uTZiqcVtK85Ob_VG_8Hv2v4Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaRf5ajdoQhbRZpqqV1tguAiXr9m_wJESSg0Lzp2Th-w&oe=6A733E42"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAxzT1TvC8wQ7kNvwGOsnkz&_nc_oc=AdpksAmTQva943jS8mm_KTeMpWos264bF0-RefBaOC9H_1ZakboUnynDdSFDFr0Zt3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn4vBV1o5AoZ5J4Dk2CIFci8eaQ2Vnv0Ga8926J4G5hw&oe=6A732474"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VavJt8YyGREQ7kNvwEcA5Ur&_nc_oc=AdqhqbmQezxIMv6ZDaVZLlubDDx6Of40v0iQccF9Awe2jeO0kO3_eCkph5S_puDSYzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAOTeaPyEleDbB7BbXkZIhocYg29uk32f9Ti1_0L84Cg&oe=6A732BE6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ho_ooTwRx0Q7kNvwEXKHWT&_nc_oc=AdqbPxtjkKBnHBK1DB3QymOGZtaJXXKYPZI34PpEa9tX7Rv0PRcpCwI-zx1-eBNtvRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4IXjAJW943QSKBpluZ4YeBWbMjgC9zvgILp4_HIdMqg&oe=6A734D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG34x8WOAboQ7kNvwF3zFhn&_nc_oc=AdrI0dGClJ3z5tVQEzCVxG10aLt7kwCeW24VqSZHTFZCssifoQSL4LCwbA-OWcXkeec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsBo6phK93ZqJml2-il9OMT084872k1y-hpIbVA63YZw&oe=6A73390C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
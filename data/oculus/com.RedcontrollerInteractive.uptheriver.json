.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8XJwlOqmY0Q7kNvwEojDjD&_nc_oc=Adp-FX6BGIJDPXgqxIxgvGAi94_9raeCrZs8w1f0Q2EHrhhBvieHXWNK8vTWTboR8C4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACBGReHJmRE-pGevTuHvWoap_KVts1giQ4TRFn0PtKcA&oe=6A6B646A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uptoriver.png", "id": "24565991306405263", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620940_24565991309738596_4708001806714553413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAIVXFaR350Q7kNvwHc8zKB&_nc_oc=AdrMbwGaJ5-LFmTtw2HnTtIk00dJxcHsYESarMUyZcfjphP9M4J4mOiG1mf1ki8Oexc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABCsCk3tF55zvMx_S1Gy42gcRzyTJ_unOpUDhG4PQVOQ&oe=6A6B66E9"}, "display_name": "Up the River", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url":
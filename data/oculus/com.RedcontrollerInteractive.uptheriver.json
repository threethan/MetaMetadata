": "1494041728780239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABLejLBUzxIQ7kNvwFgFdoM&_nc_oc=Adq0gBAXUTHAsOk8HNcU2sAtIbfHgFZo7KP6qGxu_PvHy0KJTBVpZOMCeDKYvgZpW20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_d2Ha6P0Gz56ZO9ktHoGfV3PJ5YEdm8ou_qbes2ggKQ&oe=6A3D4F34"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piQcS17YCVIQ7kNvwG5-jCz&_nc_oc=AdqSGclWtMDAqmW38TAzwPGCW14H9GBZf9rjdy4hWufaPL2396OJxWULPEQKmr74LeE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2zDJnn8Wcqgmetc4vH9UkMi67ODzGoWcCLQpGnTTI0Q&oe=6A3D56A6"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFBA7gsnB3kQ7kNvwHZzfjg&_nc_oc=AdqhT0k4-_UWKWFSFC0WLrKsonTxg9eoGgpPbc0N85v0DBsHPKMnmsnkLknF3tNQEsI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PyS6mpL54sWhSkGNE8SLdbBkJ9LHHgjnnBQ_ilet8rA&oe=6A3D3FEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM3pPJKGfq4Q7kNvwFPAucH&_nc_oc=Adoc2yrxpyHYqsw-kkijsXwbsQAlM3L5aGg4uG8wUPENu1cwsU07OGEh25gtjqsuoR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RSyIozAw5TwwHm5W8lHjfyOiffKr7nsC6-ICzUc7WoQ&oe=6A3D2B8C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=ds
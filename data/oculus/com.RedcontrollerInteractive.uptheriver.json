": "1494041728780239", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1B6sVa4S5gQ7kNvwGfHyU0&_nc_oc=AdqNgGU9p-nAkEcNA2i6HhWyGInu6mNpqzhfhy1qolfQd-ms4Onbq_S6sDOk0qNojqY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LIND26bAzEF8D2Z_07mjwd04Dab2RiQ3XX1JMUXVRfQ&oe=6A2C2BB4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWBc7W-TfHkQ7kNvwHDwmXb&_nc_oc=Adq6TgrDOAJLszyqan125MO3n1EGoqVSaipTGy2CP3UoGKZLEz9nu5V_b8xl2kKNRXc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GAsLE4S9r-xldCaxRes6iASXarhK-9GEOroC5xQz-9Q&oe=6A2C3326"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QogxuNBGH6UQ7kNvwGia1Rj&_nc_oc=AdrjulOtK8lYVATTAg-Yz8O3t0Lc0XTNcq9J6eE-u7nNoG4eJiBBA_LDopVmoZz8qeE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FyT1o8-0JEFcAA46nP15VCkVbssOs0vdDUYkUtYHG8w&oe=6A2C1C6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OaMQAHOlRUQ7kNvwG8ECxC&_nc_oc=AdocpU-Xy-gFK1zF_51vV_LsuXL3DLMnSshaPjWKEDHEzI255ZUYXeYs6ba4TcthMhY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SMAQg9P6n4F-IGoMUcPJoe0GwINmS2bTuvKkx4ziSig&oe=6A2C080C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=ds
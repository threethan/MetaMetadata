cdn.com/v/t64.5771-25/499618274_1965889797317038_930641213888339833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZTfKwx0KrIQ7kNvwFY9rCb&_nc_oc=AdpNVAg73jKtqFiDrnJXGrtGGgSR9oLv1q0u0fsSH_CQzTM02qd6TcBUtKvg_pBz5xg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt2BvkO3anef49Qp3OG92BdzjIx2hrSf5j9D8s4JHDtA&oe=6A7732C2"}, {"file_name": "ss (12).png", "id": "1494041728780239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2VPA8pJ9LEQ7kNvwHphOtj&_nc_oc=Adpx08lpd3vY3C2GlljiQJ3aIyoJWA7W6AGFcPKlzPTvCFAEn0tQtiCuZz1TLq59Ddo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRNBqjvYIKxYKzI9HLw1hzRaOhkg7I8Ce6m-Y3OiqzfA&oe=6A7718F4"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHSHE8D6wywQ7kNvwEWr2lR&_nc_oc=AdqXeAKl7tk4ezvRYSEPOAvSPZBfR0qi-RH_iJhCTWRyn99pESLq7-_HOiRTKjZs2Cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9OU6Xl8ULe35VWmd_kMtXREPdeqjgFIsYgR7HJ9CqIQ&oe=6A772066"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUgl2FZ742cQ7kNvwGaQ1QQ&_nc_oc=AdpK7yg-ep1Y45wTJOAhXde2UaKqK-u8ZKqkqsz1O6WNFu08Ye6_LDHinMKLpaniscE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExbwk5ulC6o35iangyLmF5ydzU0clPnXlEQqulggv8RA&oe=6A7741EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV0Kb1EMpA0Q7kNvwHKjaAx&_nc_oc=AdqBegUbpzyScwnDA1DFS8JsbR4iG1BCWYsosZq1iSdgonsMNAS6ljgQEYPvouLzAGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9k3JJ2jZ9FYDhZmV6n3feLUVV5mt71zhYDV3ea8I4Mw&oe=6A772D8C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
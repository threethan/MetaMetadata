": "1494041728780239", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618440_1494041732113572_7239053540931442156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUpR_7NnQn4Q7kNvwGNtbfF&_nc_oc=AdoDl6mscDo3Di7KOeTdCyWH3aFpZ0SzTokI--1_TrbrRJnv7_4yjRunTQBaUg5g6DM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sMYyXK32uBpoOl7P1l5VQDJTODuWg3V1_wcKf0lckQQ&oe=6A453834"}, {"file_name": "ss (13).png", "id": "1538985023772944", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622919_1538985027106277_7887351854097612426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRRON4btlgUQ7kNvwGI20jK&_nc_oc=AdqQujS9fP_ZU_rw9ZiykGU9nPhc5OIZykuUF1QN838JJKbUvaGY3_usaj0ktGBAeao&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hQ_Zca2sR82IcN1XeD3YHhNYOSelKipV_l7Rn8sD-Eg&oe=6A450766"}, {"file_name": "ss (14).png", "id": "1170990821676935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_1170990825010268_9097760497334214895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWE-v56LFuwQ7kNvwEtA5SL&_nc_oc=AdrRyS-5hExfQ3X3xOEZy3E2URRV6m5sQ_nOn4ZhHQf7e4ty_nJLYeMBLDZiaZ4MZeI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Y1Dif74SaM99cQLJmFhb9p4TDBakIPUtAF3VDtP5_A&oe=6A4528EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2026-05-05T231709.078.png", "id": "1551703339651949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593790560_1551703342985282_971376329918037262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmTD1dRcGwsQ7kNvwGp1Lz-&_nc_oc=AdrvAQvI2UPg8LwAZFKBV0Qle2YKWb0HbnKvP-liaAz-UCFZxPfH5AMB_n0TyJ2B2_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8darehp0gcwDpe_OgHxeVwPvgQtnUPmbruLqxqVLp6hg&oe=6A45148C"}, "display_name": "Up the River - Climb VR", "keywords": ["climbup", "up", "climb", "riverclimb", "salmon"], "long_description": "Up the River is a thrilling VR adventure that challenges your balance, strength, and skill as you paddle against nature itself. Armed with only an oar, you must climb, push, and row your way upstream through powerful currents and treacherous obstacles.\n\nEach stretch of the river brings new challenges \u2014 from rocky cliffs and tumbling logs to rushing waterfalls and tight canyons. Use realistic motion controls to paddle, pull, and maneuver with precision as you fight the current and find your path forward.\n\nBut be careful \u2014 one wrong move and the river will drag you back downstream. Master your oar, learn the flow, and prove that you have what it takes to rise Up to the River.", "short_description": "Paddle your way upstream through challenging rapids and obstacles. Master your oar, fight the current, and climb the river to victory in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0b3569e7-d97c-4eca-bcf5-d418adbb7ff0", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26854590964160435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619465_1676959176639130_6061145726741354518_n.png?stp=ds
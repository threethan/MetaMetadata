q8d7k11a07vVB-F1FRkurThkk418OJ1iLBV-Lg&oe=69FC8796"}, {"file_name": "8.png", "id": "1613286756622633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_1613286763289299_6982107423274897735_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTfqcTo2G7kQ7kNvwFhDKr_&_nc_oc=AdrZFrxb9iNBnQbokXiTrJibsuNu7Ip8zVSYM6bCtJB6pOpRHFqZkkt-qhBgvWcaB24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M7nlbbHtzx8pkq_u3NcC1JrmUOYNN-L2B62pvvD6vGA&oe=69FC9E90"}, {"file_name": "3.png", "id": "1283608487043358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1283608490376691_8040307159065983373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdRMWoMTBFkQ7kNvwHSbfhH&_nc_oc=AdqNg2U2pZ9OkeBqL7BHHiXRmGm-qyDg1LSwcNXY22Nr_6BavOiW2c1miyXMGZugbs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yPqIJGW2LsOSrH0jApGdGcSdLAtrojcZ_Oh0NmbzrXg&oe=69FC8DB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Apocalypse: Zombie Shooter VR", "keywords": ["zombie", "shooter", "horror", "war", "apocalypse"], "long_description": "Step into a terrifying world overrun by the undead in Zombie Apocalypse: Zombie Shooter VR. Trapped inside a deadly building, your mission is simple\u2014eliminate zombies before they eliminate you. Every room is filled with danger, and only your shooting skills can keep you alive.\n\nEngage in fast-paced VR combat where precision, timing, and awareness are key. Complete challenging objectives, hunt down targets, and survive relentless zombie waves. Feel the intensity with immersive controls and realistic weapon handling designed for VR players.\n\nExplore dark corridors, face unexpected threats, and push your limits as the difficulty increases. Each mission tests your reflexes and strategy, making every moment thrilling and unpredictable.\n\n**Features:**\n- Immersive VR combat\n- Realistic gun mechanics\n- Intense zombie waves\n- Challenging missions\n- Dark horror setting\n- Smooth controls\n\nWhether you're a casual player or a hardcore VR gamer, Zombie Apocalypse: Zombie Shooter VR delivers non-stop action and survival excitement. Get ready to aim, shoot, and survive the apocalypse!", "short_description": "Survive the ultimate zombie apocalypse in this intense VR shooter! Fight waves of undead inside a haunted building, complete missions, and test your aim in action-packed zombie combat. Experience immersive gameplay, realistic shooting mechanics, and thrilling survival challenges in one of the best zombie shooter VR games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26131362636472312"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1318018080244211"}, {"status": "PUBLISHED", "id": "4516500755251580"}]}, "baseline_offer": {"id": "4516500755251580"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1318018080244211"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []},
3362975465268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVWsYIHV-_MQ7kNvwHNdRN9&_nc_oc=AdrbdvFS5WJhYw90Su6M3dbJGqeYH3mX0YIF7G2ZV5SSbPNKnmxw85SqwtNoeE7Faz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af327uxfSW0IZsvLDnw1ZWfgwdiLw67lFAKa4Vx1p-1DpQ&oe=69F1EA68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Tower", "keywords": [], "long_description": "Monkey needs your help! The world is crumbling. Solve puzzles, find upgrades, and dodge enemies as you race against time to get to the top of the mysterious Monkey Tower. Every level brings new challenges - from collapsing platforms to pirate penguins and lava-filled gauntlets.\n\nPlay solo to master the tower, or compete with friends in fast-paced multiplayer races where every second counts. Upgrade your cards, unlock new abilities, and prove you\u2019ve got what it takes to become the ultimate climber.\n\nMonkey Tower is a thrilling VR platformer packed with strategy, speed, and surprises - built for players who love to explore, optimize, and push their skills to the limit.", "short_description": "Monkey needs your help! The world is crumbling. Solve puzzles, find upgrades, and dodge enemies as you race against time to get to the top of the mysterious Monkey Tower. Play solo or race your friends in this thrilling VR platformer that\u2019s equal parts strategy and adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://parkerhowell.com/monkey-tower-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Howell XR", "support_website_url": null, "website_url": "https://parkerhowell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
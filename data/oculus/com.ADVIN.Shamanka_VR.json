25/499620965_1261686146032413_5237095379855020090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZDrhPauw_EQ7kNvwF62-pc&_nc_oc=AdrU_qr4QMg8vaCVwVbo7JajNVCMMYnEJOb-AJEZvSogYKTzWBIOaMikiM9oFYOfKqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjh9dQcXSr-qETzm0IK_7jWKbmYWPtS4KT88IjP34pxA&oe=6A675E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_2560x1440.png", "id": "4344863835801230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_4344863842467896_8113959459503352496_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deYoS3qd3KMQ7kNvwGgIMOD&_nc_oc=AdpdEAqXTiXEApehi2IqOP-9sRA_7wFkX5WJOrPzu6tm5uYoikGvGevOlv6l6-ImXEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6wvarpSeBTHNnSDROkGlVdTEgRbofn4Idd9nasbOJXg&oe=6A67761F"}, "display_name": "Shaman\u2019s Burial: A Bronze Age VR Quest", "keywords": [], "long_description": "**This VR interactive is created on the basis of a real archaeological discovery \u2014 the burial of a woman from the Early Bronze Age (3rd millennium BC), discovered in Ukraine.**  \nBased on the structure of the burial, the catacomb construction, and the set of ritual artefacts, researchers interpret her as a shaman \u2014 a person with a special ritual status who could perform the functions of a healer, ritual leader, keeper of traditions, and mediator between worlds.\n\n**The application transports the user directly into the space of the archaeological object, recreated as an immersive 3D 360\u00b0 environment.**  \nYou can freely navigate the burial, explore authentic artefacts, approach and interact with them, discovering their meaning in the context of ancient rituals, as well as read descriptions and follow audio guidance.\n\n**The VR experience is built as a quest:**  \n- the user performs actions based on scientific interpretations  \n- opens the burial  \n- interacts with ritual objects  \n- explores their possible purpose and symbolism  \n- in the process, you can reproduce certain practices, such as applying a ritual tattoo, throwing dice, playing a drum, and interacting with objects connected to shamanic actions  \n\n**The full experience takes about 10 minutes and is free, making it accessible for us.**\n\nAt the end of the journey, you encounter a 3D reconstruction of this woman as she may have appeared in life.\n\n**All elements are based on real archaeological materials, documented research, and scientific analysis.**\n\n{822709076931237}\n{2083418282202594}\n{2148368159284733}\n{1457672279393134}\n{1462124532073536}", "short_description": "Step into a world that no longer exists and witness the story of a Bronze Age shamannes. Explore a real archaeological burial site in Ukraine, examine authentic artefacts \u2014 including objects linked to shamanic practices, interpreted through scientific research\u2014and immerse yourself in ancient rituals. Step by step, you approach a reconstructed woman based on verified archaeological and anthropological data. An immersive VR experience that brings the past to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.codpa.org.ua/privacy-policy/", "developer_terms_of_service_url": "https://www.codpa.org.ua/user-agreement/", "publisher_name": "Centre of Preservation and Investigation of Archaeological Sites", "support_website_url": "https://www.codpa.org.ua/contact/", "website_url": "https://www.codpa.org.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["uk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26516391407993722"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1532039408922805_8252535218221721440_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUMciILr4ysQ7kNvwF-d_Cb&_nc_oc=AdpyAH1FhjMgpqKuJQgjSqRf7OwTE9utPK4g_23E9WUh5J0pN2JVaz64CyvevWGI_bA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXbcVnn6VyWAAGRoQ1iCivJR-d6KmFs1m6LWiaTaBSpA&oe=6A676C70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shaman\u2019s Burial: A Bronze Age VR Quest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1776160500, "lastRevision": {"nodes": [{"id": "26516391474660382", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26516391377993725", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "939712035318994"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "meta_ready_extra_2.png", "id": "4404314303183770", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_4404314306517103_3804225354786041658_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypL_hiqv0fkQ7kNvwFnI5NE&_nc_oc=Adr5pU0nFTdGYi9Adu0pDLVRd_VP8Xr4SQOhWoNwBumbr4VryOm3cKETgrHYqz20FVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcaQPFB5RJhJGY2ATX9fqJOShFCm4uVhFkGzfDkQyzYg&oe=6A6773A4"}, {"file_name": "\u041e\u0431\u043a\u04
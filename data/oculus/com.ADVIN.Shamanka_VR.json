content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVTSyUV91zOKdpOjV8b7wSt27Wa8btmYxr3vs5_lMKCA&oe=6A674527"}, {"file_name": "Image1.png", "id": "932167639740599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619832_932167643073932_6368970338701906966_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKMrYcSCUR8Q7kNvwEW8tQz&_nc_oc=Adqw5vzULhsh2Jp3ED09z7DxJn8JjtRiPgPuMA-_shqTYOl31o0ffW0uD0oS20f8lM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaml_bs-e4mkwH1i8DGrcsKjkqbFcBgV0jIIE9kinVLQ&oe=6A677985"}, {"file_name": "Image4.png", "id": "1487472119569118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604282317_1487472122902451_1732481345637461045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0rRSU2tyNAQ7kNvwHep5oB&_nc_oc=Adry3xE5jHwrdR-p-FhDXFkBLkmZv_if6GHjjxdaOFyLl9JeJvem0mY7nfNf-rUbWnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCstnMubtGXIRJGJvGQ5DcM0yznrQRxhI7C4173QMnjWA&oe=6A676A31"}, {"file_name": "Image3.png", "id": "1486916526360760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1486916529694093_4125340194893187166_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfqKIqdi-rQQ7kNvwFIRJeM&_nc_oc=AdrOosn3QA0wJOuprP5ZTKyMLt2xPAUjuZ1899z5x0nGaFQQVUZvdmoKdo1cOPkkTuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2CfHn0O_BDv_UPkIoExmgFmbDAZmXGcshrRbaD-YExQ&oe=6A674957"}, {"file_name": "Image5.png", "id": "1261686139365747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620965_1261686146032413_5237095379855020090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZDrhPauw_EQ7kNvwF62-pc&_nc_oc=AdrU_qr4QMg8vaCVwVbo7JajNVCMMYnEJOb-AJEZvSogYKTzWBIOaMikiM9oFYOfKqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjh9dQcXSr-qETzm0IK_7jWKbmYWPtS4KT88IjP34pxA&oe=6A675E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_2560x1440.png", "id": "4344863835801230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_4344863842467896_8113959459503352496_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deYoS3qd3KMQ7kNvwGgIMOD&_nc_oc=AdpdEAqXTiXEApehi2IqOP-9sRA_7wFkX5WJOrPzu6tm5uYoikGvGevOlv6l6-ImXEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6wvarpSeBTHNnSDROkGlVdTEgRbofn4Idd9nasbOJXg&oe=6A67761F"}, "display_name": "Shaman\u2019s Burial: A Bronze Age VR Quest", "keywords": [], "long_description": "**This VR interactive is created on the basis of a real archaeological discovery \u2014 the burial of a woman from the Early Bronze Age (3rd millennium BC), discovered in Ukraine.**  \nBased on the structure of the burial, the catacomb construction, and the set of ritual artefacts, researchers interpret her as a shaman \u2014 a person with a special ritual status who could perform the functions of a healer, ritual leader, keeper of traditions, and mediator between worlds.\n\n**The application transports the user directly into the space of the archaeological object, recreated as an immersive 3D 360\u00b0 environment.**  \nYou can freely navigate the burial, explore authentic artefacts, approach and interact with them, discovering their meaning in the context of ancient rituals, as well as read descriptions and follow audio guidance.\n\n**The VR experience is built as a quest:**  \n- the user performs actions based on scientific interpretations  \n- opens the burial  \n- interacts with ritual objects  \n- explores their possible purpose and symbolism  \n- in the process, you can reproduce certain practices, such as applying a ritual tattoo, throwing dice, playing a drum, and interacting with objects connected to shamanic actions  \n\n**The full experience takes about 10 minutes and is free, making it accessible for us.**\n\nAt the end of the journey, you encounter a 3D reconstruction of this woman as she may have appeared in life.\n\n**All elements are based on real archaeological materials, documented research, and scientific analysis.**\n\n{822709076931237}\n{2083418282202594}\n{2148368159284733}\n{1457672279393134}\n{1462124532073536}", "short_description": "Step into a world that no longer exists and witness the story of a Bronze Age shamannes. Explore a real archaeological burial site in Ukraine, examine authentic artefacts \u2014 including objects linked to shamanic practices, interpreted through scientific research\u2014and immerse yourself in ancient rituals. Step by step, you approach a reconstructed woman based on verified archaeological and anthropological data. An immersive VR experience that brings the past to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.codpa.org.ua/privacy-policy/", "developer_terms_of_service_url": "https://www.codpa.org.ua/user-agreement/", "publisher_name": "Centre of Preservation and Investigation of Archaeological Sites", "support_website_url": "https://www.codpa.org.ua/contact/", "website_url": "https://www.codpa.org.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["uk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26516391407993722"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "26204764809226610"}]}, "baseline_offer": {"id": "26204764809226610"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776160500, "status": "PUBLISHED", "id": "26204764809226610"}]}, "liveChannel": {
Jn-ZZg_Sam-XFoXATQCTBTbn3ITuaPs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKElVuz1dnfMuyWI5bYWAIno-3OZX5L7Z2FvDyLlTOBfg&oe=6AA9550D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_trailerPrev.png", "id": "733479117040150", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12448944_733479120373483_6634804833922580480_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pljXnyHG9oQ7kNvwHVIWnc&_nc_oc=AdprDgYOYi-tTFP1hAUaYHOAG0i1dspR3qOoUD6K3er8kxi2JA5vGwr0J2Me0H-NvFk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6v1CXt1NRtgWHaN8teThCRClMXmM-kw_7edItCenamw&oe=6AA94682"}, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "jigsaw", "vr"], "long_description": "Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name":
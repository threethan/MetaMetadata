1812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mc8mF3mNaYQ7kNvwE9ac5e&_nc_oc=AdkgzCf1nS19VUNztN9Jj2OuEy1PSuBQo60a8ErJwe_quluqpZHbAKlcgmc_Eqqvp8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJBKSCzXWKrqcd5Q5AdMc6XU48aYmg_IFvwvzrjbsoVg&oe=699AF60B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEDKNGBExN4Q7kNvwHjZ3UJ&_nc_oc=AdkW7BkPqRrh_iwCNfXlxjJE7yQIHFKDk71DZ9wnCcrv2H59X1R7OJfpNygyRFhr0uA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftnTazYkFnyDVpjVdmn6Atb_TPxghvrtTkZj1vYOO93Uw&oe=699B096C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPdwKpG_EEgQ7kNvwEg_-vx&_nc_oc=AdnuobdZlF67-i2dwsFAvdUsmFLnOUM1mCPDOsaOJgP7pBVCaEjwdk5f85qyxZIT1Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfszpOBfA8aunL26AzvhhfXuRdY2JUg8TY8pLMgZj-D8XQ&oe=699AED21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7m4FrbqwW0Q7kNvwHREvx8&_nc_oc=AdlGekwrEiQJpbqFsjkf1sNPqSFopZRFZePXM7aZ-tOagWyGNXAMFegL8zkXs3hDga4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuyN7av2x4ev1v8AYgfCH8-pVavJECx7tPoMgkC19R4UQ&oe=699B00F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1525122224, "lastRevision": {"nodes": [{"id": "1951753658172869", "release_type": "SCHEDULED", "admin
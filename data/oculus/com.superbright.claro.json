d": "521565508759573", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ldJQ8RLr1wQ7kNvwHEpNQ9&_nc_oc=AdqXHXNGKUnmZ2laouVggXl_-dfaDJ5bALFV8XLQ3qcAS9mkvvCC4TbTmrju--hdloI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OzcXMT5dgGihZP6oPUhYwEp2b3VLGHQ_0y8Vx6GCLjQ&oe=6A41130B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-l2k1ZzWtgsQ7kNvwE2j2Ja&_nc_oc=Adrh_lDSm53y2XLSVufy17lN_QTiNweS_9d1ehWzyH8vCQ_KtEiVtYiuPBg4a9OOIbs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GNyOb0Oji1QVfLo-ICCFtYsrqC2V0btWu_lVSBTugGQ&oe=6A41266C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pztK35GhdLMQ7kNvwFe6X0N&_nc_oc=AdpPlX4s8OatnjK_LXRWk5Jw5Dkkngnn9Hw3gqXzN2dStLT5CeX1PyuZsaut9FJWaEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y_PESGXE-CQRnC85HeJ2ED0R0XcIs_H8px6t9yrPmog&oe=6A414261"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jnz7ZhyxFP4Q7kNvwFMdAuC&_nc_oc=AdrfRNG7qU0rg9-HVsxoOKq9jpKsgXPiHw9GwBFlUOsdzenlzHNxCkuuy8HpvbtNV6U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JQ0T81q2aca74P3lYvWJtukfyWIDqBZU6i91uKU-xhw&oe=6A411DF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROI
d": "521565508759573", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64m6Cbzz384Q7kNvwEKsOjp&_nc_oc=AdpcvO3kd9acfV2RjXUe_HR7HJ01SOC3NQeuuigVwLneF0yul92dtCdI-ibOfdDPb7w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdvO4hRLzFARNNGUrHqqsibo_238RlvwxVgslqMAp4tQ&oe=6A58CE0B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QKZ25zeBwYQ7kNvwHM_JyN&_nc_oc=AdoWZVQjqAOFyIOq4sX85oQE1Y9aK-E76kiwCdXUU5GZx2JJyyXkE5-cAQGzdq7sVD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsdYxHGijhLaZQJDB_3LgK39WXxB_FDktW8yfZO2UQiA&oe=6A58E16C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tffvRGK8erAQ7kNvwEbkrkk&_nc_oc=AdpyF9EtX575JO5nhtk-rnb5vosJwUnFkHLIxcy_Rtovlt4g9gjnWwzx5x_bHVVPLZs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAruDgqTZW3EMU5Uz5BYIoKfJpbqJJyJplRx_qQo0jEwA&oe=6A58C521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsZ1aNqnl-0Q7kNvwHGNWZS&_nc_oc=AdopOZ3TCewvHbI1UTHq2OkXMthkzaNxxwN82l-GCUKGx1MLhlddeCrZG8tddF3efe0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5jdHXe31jMy7q_fFuONe6_MdzP2JoCdt04XF0FvOwrg&oe=6A58D8F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROI
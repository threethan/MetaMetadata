1812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpV0Yk2UkMEQ7kNvwHmiZLX&_nc_oc=AdnL4fsVIHwWk_uAPUTr21C6wbJ4yvmvDJJ0SmkvnlHwvWZLwHAIN9Pyfl32Mykn2FM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuQvgNspuNksOQOIGGzubeP2PPsmFPlH3zDPDY5tvcNnQ&oe=69A5820B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rBOCzWrV7wQ7kNvwEldFbo&_nc_oc=Adm-DZtIiRSVChCY-DEZIwtd2t5QCYk-30oW3nURGkCuMuvZc-FVD1848beQ6wQhrpU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft_TCiV6FwN1MaGYyB_qtPHFgbvsiEDzId2jNCy9deh2w&oe=69A5956C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaxX1gYolp8Q7kNvwFupU-c&_nc_oc=AdkUTjUJYA-IBkEhxJ78pA0ssxPjFzfEt3B9oMkl7ndqUEfS3R_l0NYdu7L0uEih6eg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuVg01OXMNNgULr1SbyLT-CXsvc3FoA9MWeJweOStvKbg&oe=69A57921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBobbyLmDRUQ7kNvwEJX53r&_nc_oc=Admz9G9Z8BBRgCCOhlhbrpYtR6BgP8k78QPDozZ_xjB8_IibflbwObqzZMsfoXGHlYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsil8zJhCEixz-x-WoJB3wQjToRzLFlrZ4ibxMHeGXwwQ&oe=69A58CF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1525122224, "lastRevision": {"nodes": [{"id": "1951753658172869", "release_type": "SCHEDULED", "admin
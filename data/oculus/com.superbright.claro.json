_7708561857811841024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msQ4XYQgdSoQ7kNvwHskdpj&_nc_oc=AdoeF_T_n1AzR8qroXpHOcuwCgqs0prYvytvC8DpddNMnb0Vf9VoW0woF8HpaQhF2jk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1UY_WnRhFnbIRTmauUp690aLZ8ohu3cdNOvm86glTjw&oe=6AFF068D"}, {"file_name": "migrated_image.png", "id": "521565508759573", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8DF8TXtEuMQ7kNvwHlD6HZ&_nc_oc=AdrkpEzHhkQiGK0x6siZID6a9PaQMLgvPTdDnS9Yb2yBM2Q2J2SA3HlLsJa3gPxOrPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPak_MwNEmPs3Kk1i7VFtuxF7DJrbpW6JX2mnvGqSGmQ&oe=6AFF234B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riLonpFZPuwQ7kNvwGN0Gf8&_nc_oc=Adp1jvSOcbfx23-Gaby8okl6KjpefdP-qgWLEcOt25tt7CvRtzLPagr7Sm0skTPkwmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5wgcjI7VdNUjiUJQisjQcAsLbkZsNuzCpC7bFFHKSeQ&oe=6AFEFE6C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvKqjjOEJosQ7kNvwGiwKQY&_nc_oc=AdoMrImcYGCfS2hou2ToANhfH9g1ctbho6Ohy9iVpeVff-MgOlQMJh-K6g9QR4S9Oj8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWI6_oLBtSOFamKeMczPwHB1_ChUvuXuvcuHOVQlrSLQ&oe=6AFF1A61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410440_16215778
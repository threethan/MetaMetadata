d": "521565508759573", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMPcT7ZKO-kQ7kNvwHqc1Bc&_nc_oc=Ado2ErfRD4vRqTei1pk9U_neDmpZt25XFzJLOwaJNTEwqlQMSt0-QiQ6Fm3gaWAmZbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jMoBC6D3qim7ycRyDp9fNg9mTdR9m4NQegFw8DGKP9w&oe=69EA100B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLzS1oCeBZsQ7kNvwFGElQO&_nc_oc=Adq6GB6kMd1UKGoAnr32SYR6A5g10SPK-IxH6xuPbbLSobsMnnALVFlGwOLanfW90jM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c02f7NUiYf5Yj7iNzg_IMnyhG8tn1GHanItJhf3bA6w&oe=69EA236C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81OSd5uGlDMQ7kNvwH1I_Ji&_nc_oc=AdpTAnzs3fjIFy1ntzC7s_nWL-5ctpxA3Rd3RTPlzzcQCNh-gzwXSgPL0q1fI-bgKZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u45MgXQH50Zt4dLXfvsVkWq40EEUdnyl4VGH0AcAWtA&oe=69EA0721"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ujqMxLADCQQ7kNvwEmlFRQ&_nc_oc=Adq7QGr2_tvoSeT-QoV5vq-HE2H3iF8BeQHxK_RXwIUkBqP18ocyHMYJLfMvq0wW_HQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZiiiTO1TMrF5gTooOnkvVWyu_4cbxb-NfQnyaHxVSGw&oe=69EA1AF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROI
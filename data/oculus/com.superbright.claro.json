mage.png", "id": "255342582149214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8DF8TXtEuMQ7kNvwHlD6HZ&_nc_oc=AdrkpEzHhkQiGK0x6siZID6a9PaQMLgvPTdDnS9Yb2yBM2Q2J2SA3HlLsJa3gPxOrPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPak_MwNEmPs3Kk1i7VFtuxF7DJrbpW6JX2mnvGqSGmQ&oe=6AFF234B"}, {"file_name": "migrated_image.png", "id": "212132333198657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331069_423345031430291_7708561857811841024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msQ4XYQgdSoQ7kNvwHskdpj&_nc_oc=AdoeF_T_n1AzR8qroXpHOcuwCgqs0prYvytvC8DpddNMnb0Vf9VoW0woF8HpaQhF2jk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1UY_WnRhFnbIRTmauUp690aLZ8ohu3cdNOvm86glTjw&oe=6AFF068D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_trailerPrev.png", "id": "733479117040150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448944_733479120373483_6634804833922580480_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hqBr9XMlDkQ7kNvwEuxS0i&_nc_oc=AdrjIGwkt8-3VoS1j2tgGZsTiHj59Vl6VbzcUIB02boZae1-gb3zy-Y65-0ncxtYTKQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxF41-bQHW1M2LfOgGrz2kY3dZdcxL5PO4LOW7hMh1MQ&oe=6AFF3042"}, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "jigsaw", "vr"], "long_description": "Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617793819524152"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "355388515555911"}, {"status": "PUBLISHED", "id": "363026931097667"}, {"status": "PUBLISHED", "id": "351889022224690"}, {"status": "PUBLISHED", "id": "2049937375026496"}, {"status": "PUBLISHED", "id": "1780022412116693"}, {"status": "PUBLISHED", "id": "675471252927198"}, {"status": "PUBLISHED", "id": "580403982387377"}, {"status": "PUBLISHED", "id": "265629647548410"}, {"status": "PUBLISHED", "id": "407955669770398"}, {"status": "PUBLISHED", "id": "2250668991815611
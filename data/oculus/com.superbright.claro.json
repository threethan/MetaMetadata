1-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAW2884TfkkQ7kNvwHuHGP8&_nc_oc=AdrydnMlVihvIrxtG_d2ODo9Qz0zI08UYQIYCq8X26kg_hz0DwZ0-Q9vOV2SdQ_CXfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1CQBynkAdvg-IE34KJ2Z3-OrHoa2UQ7dSAkTS4hoT4iA&oe=69F1F90B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIl4uxGGIz4Q7kNvwFQF6B4&_nc_oc=AdrGn6mShrC04rPO1rnaVz1IUhHWGCJmBXxD0PFnwM4vEiIMhnpNt-aEApYPhAhJsDg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af39z21PMGkT878z8GcJOUGypk1ihHEhdMMCd1eHgiAG-A&oe=69F20C6C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrUe2Uvq_4QQ7kNvwHvJUzs&_nc_oc=AdoyZMHB8dY78V0uL-HJ02LZxQkpFL2VYCC6vhZMXbl5q98WCTiLGtjLny1RP8fiksk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Fv3oC05UM5zX2eMK0QRWbJh1gt4fHs1XL6udC4RB9VA&oe=69F1F021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHB-g2m2N-0Q7kNvwHa1UOT&_nc_oc=AdpMNXIBXBtM3dpO7Mg_u2Tq7pt-94GjLUROMLofD_PtOK9nEAvTH2ZNI4p09_u8Prs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0XEfhwd1NDqQPT-aTclQo3tjJ8qHmB0eAJfQZ5YD_vJQ&oe=69F203F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1525122224, "lastRevision": {"nodes": [{"id": "19
_7708561857811841024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwcLKLJRoJ8Q7kNvwGBTTyB&_nc_oc=Ado4U2txn1MNNxbV9cesZS8UdJf9tARxXXZNzMZZWfmWGNyc3pP0MuupvjdYlCXwREs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZ6f6cNbNpL3iwzm4ZVIz_zRcEhX10ru1cGb8E2QnKtw&oe=6B0F10CD"}, {"file_name": "migrated_image.png", "id": "521565508759573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jeXs9i05VAQ7kNvwF_nBUL&_nc_oc=Adq-IVUOFdQrsuCUcvEz5n9WomHVAL8UO1_URaZ_8TUFOfvpFYoBJExYhX_5rB8Vd8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtIsiRFmyQBT704OabwBhCpM0FDeOCOGjF4zeJ6fJlwQ&oe=6B0EF54B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8ybndFLCnMQ7kNvwH51K3W&_nc_oc=Adq_e8MB8g6-uFE_L6quMnc5RBkPOOy3Hq7lPxvWwq6hYJ8warJP4AFX2QCtxvmblgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAd9lZZH3k-E47b2W-phJvwbzfFnHA_ONnChXO1dMcHg&oe=6B0F08AC"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QcdOV33At8Q7kNvwGwLa9O&_nc_oc=Adpa1ghk5LBziyfxtoz2UbAY4MtLPQZ0kQvj6YIE_hcglfKlXKVfmxxRm8cYbqLonwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwNjZgdgpCe9YfASuPULbUPDEas_YHxUhNChVfM4yz8g&oe=6B0EEC61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410440_16215778
i": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E3l3degL6AQ7kNvwF-Gicc&_nc_oc=AdnWcA1PzU2Wq3FhKc19joldwn5SoEeUn9hHBAwitBqH1cz65enFE1PiUjVgffUEdFU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzL6d0iCWB0HnB6LIcfhYFPu_R8sL2ELktAFUMHb0Satg&oe=69AAC80B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWfRawVyh8cQ7kNvwEpWXIH&_nc_oc=AdnXofAjw6PuUU3igROhrqEJ82VpYrWCJVy5VbHbPHF28dpMrZ_WsrLc4TVT41jcUm8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3IC2zHCUGw6XacqKYhpEY2ao3K82ai0bRAFXl1Nu9uA&oe=69AADB6C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvqfz0qAHN4Q7kNvwH73SSJ&_nc_oc=AdnwL46SjnA-7PxRyrSU6WZEB3ZS_GnUOiWZ9KTnLWkF6Ig-DCUSrH1Fmbs3w0oOR6k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyu6Pf9vUg1LiFf8dWEDMasyfRIQA95dinxc4jq_DNPPw&oe=69AABF21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3wxCfNn114Q7kNvwHeCc_g&_nc_oc=AdlQxCcvC4zWa7AbqDJw6ygm8Unr4Gq04wF49hz3av5dq_J9BebEHXu6q7VcjtmE8K0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3cZGnodwgr8y-IASbPTCqZRIjqomdfsu1Kr-3BxsRag&oe=69AAD2F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROID", "context_category": null, "context
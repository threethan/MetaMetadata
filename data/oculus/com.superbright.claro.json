_7708561857811841024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3ZRdHx4DAUQ7kNvwEuLHbH&_nc_oc=AdpBVKPoraOo_QmHnxstXJRJIlJ32_LaHmuMp4G-SlunILj2cYDGwkdCJAtZg8YLN50&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPWE-o9_FmAMaapF8N_IOddxVPe0uKvJdTjzrwkWkqzA&oe=6B08410D"}, {"file_name": "migrated_image.png", "id": "521565508759573", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12504730_335651020262668_2372026861812187136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzyP4bIS7-YQ7kNvwFsTuf_&_nc_oc=AdqHG1B3dthC2fkOpJmYFzxufhUXVV05feNIg-Qlamo49H9fFTiLZ3tYTVtuyx4xNBE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHUGhQsbWxOwvRGjkGy18RwljGNabg2I3lxKH7qoIx3g&oe=6B085DCB"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttllOhOZhakQ7kNvwE4LRnk&_nc_oc=AdqA00gKptyooiwxRF3wJMvFH44xe4pT_w4CvefSfrKowkeKB9imXTslJUw81bARO44&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYM96UXwP192YclSExYvWOX3BoaOxsMkVhDtUbKP5ehg&oe=6B08712C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyfWDWCP1lYQ7kNvwHhCsKy&_nc_oc=AdoyIVWnKfVyHqKo1y-ynr6ZML3In8x6Glp-f_xjFAL8o-_BOB_UU6Xovkq1QUtWxGU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHmIFNTfjzY5FFwaIJCeOOaXS1YDFNMxA1fYVT_hys-A&oe=6B0854E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410440_16215778
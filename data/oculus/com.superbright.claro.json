1812187136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj4quBMe8CIQ7kNvwGPv4US&_nc_oc=Adnt8iDov2xbiyr_JpTYz07jJNFByXtWjg6Tr0NUBWVe2XdsGFxaIpcsbLzXxhHsxkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMliwUyc_lJK6GT9EOMPiv6-hNJqL2lAxJGaQNjTNK0Q&oe=699D990B"}, {"file_name": "migrated_image.png", "id": "227164821768326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_1573050232813204_7449018581842395136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEDKNGBExN4Q7kNvwEc1hjS&_nc_oc=Adl4HVZ0qx_m-DY3eILEKI9Qx8DMojDj0bRdTl5gn3vuQK-GwgMvNlr0jEhBU-Efk0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNhL7aPNVnYLuTDVnM43UEm6cUDbYliypnokAw-oqP5g&oe=699DAC6C"}, {"file_name": "migrated_image.png", "id": "208030090412160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482392_1768029899915234_6359863692175081472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51VgjRKc_lIQ7kNvwFwC1zf&_nc_oc=AdkxowUFlwkwZaDtbXDtvlgyVHsPiw4X0ojR_u24TE5jFWcvoG_z9xi28R8G2zF6GU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZHEy6Oq5omy3YTak-vTCHTSdhu_hKo7S7D617FCCaFA&oe=699D9021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claro", "keywords": ["puzzle", "relaxing", "zen", "best", "great"], "long_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone.\n\nHAND CRAFTED\n\nEvery puzzle feels like a unique, hand-crafted tiny world floating in the sky. Making excellent use of VR, you are put right into a responsive, tangible, elegant place.\n\nEASY TO USE\n\nUsing the Oculus Go controller, intuitive controls allow you to manipulate the position of the Light and rotate objects. It has been designed to be easy for everyone to pick up, enjoy and complete.\n\nATMOSPHERIC\n\nAudio provides a rich backdrop, highlighting every action and creating a soothing experience.\n\nGREAT EVOLVING VR EXPERIENCE\n\nClaro is a perfect introduction to VR for anyone! Frequent updates ensure the title continues to improve and take advantage of the latest VR has to offer.", "short_description": "Oculus Go Only! Play through beautiful, zen-like miniature worlds where you manipulate the sun to grow a tree in each of the 38 puzzles - it's a perfect VR game for everyone."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": null, "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928045301184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410440_162157787782508_1432769809698783232_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7m4FrbqwW0Q7kNvwFLx5iR&_nc_oc=AdkDlVDIvDoZ6WbyIax_WQRBcwhZDT_NBE2Q_Yb8ckf8qYVlxREFy4p95Rr3RZYGs2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-Y2bfitvDY04UovEHXP7CGvApKvu49IUzmU-adwNNtg&oe=699DA3F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claro", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1525122224, "lastRevision": {"nodes": [{"id": "1951753658172869", "release_type": "SCHEDULED", "admin
3sliNL4A&oe=69EA0F6C"}, {"file_name": "4.png", "id": "1353136783287675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1353136786621008_7052937903676663304_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmVtiI5S1HMQ7kNvwH4hwFP&_nc_oc=AdrYFUv6KI9WYTAWBRP9A8DEkMJYvRBkLyXnSDOibmE6xcCMGt9sSFXdNym4Sl9otVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pwd-fjbDf5-PZyN7oCyBN8fD63xLQlpGlPL9OwKK70A&oe=69EA2B55"}, {"file_name": "5.png", "id": "962594523184847", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_962594526518180_7910449889851491339_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOhenNejleQQ7kNvwEsD0_Y&_nc_oc=AdqslevBKUkgr8JvmwXlHzL1hN1QXOQQGFpUKoZvkiGhttXyTQmmZg2ICWESB-PWrIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af301cMAPz-9Ijdkm4-YqJ2RFWgcjuLWtnU_4Dr9GCp9AQ&oe=69EA23BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "954321790486520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_954321793819853_8816488500208354490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Abfnoa2obzAQ7kNvwFRhOj9&_nc_oc=AdpqZurO2ouxw5jBKfdQamiJ2S4w8Vu-FnmUPUoPMfjBjKKitxJRb8A4sp3DLSqlyGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WIOUn33iGc9uD4tQMOaQ2Q2mJP4gW-AiKSUQIkZaGLQ&oe=69EA0428"}, "display_name": "Mission Control MRI Simulation", "keywords": ["MRIPreparation", "VirtualRealityTraining", "ImmersiveSimulation", "VR"], "long_description": "You will embark on an immersive, story-driven VR adventure set around the MRI procedure. Discover the different stages of the MRI journey in a playful, interactive way.\nYou will step into the shoes of a special astronaut with one mission: to reach the Moon. To succeed, you must board your spaceship and stay on course at all times. Our Mission Control center will be watching over you! We will send real-time feedback if you move and your ship drifts off its path.\n\n**Are you ready, astronaut?**\n\n--\n\nAdditional Information:\n\nYou can begin the experience sitting on your bed, until the moment comes to lie down as your virtual bed glides into the MRI machine.\n\nThe simulation can also be used by caregivers as an informational tool. It was designed so that the participant can use one controller while the accompanying person uses the other. We encourage you to consult the in-game menu to discover the special controller inputs available to the accompanying person.\n\nCredits:\nVR Development: Caroline Dakoure; Content Development: Caroline Dakoure, Ana Elisa Sousa, Justin Sung, Liana Sanchez; Voice Over: Justin Sung, Caroline Dakoure; Project Coordination: Vanessa Valiquette, Martin Lepage\n\nDisclaimer:\nWE DO NOT WARRANT THAT YOUR USE OF THE APPLICATION WILL BE ERROR-FREE OR UNINTERRUPTED. THE APPLICATION IS NOT DESIGNED FOR DIAGNOSTIC, THERAPEUTIC, OR OTHER MEDICAL PURPOSES.THE APPLICATION IS PROVIDED \u2018AS IS\u2019. \n\nUse is at your own risk. The developers and collaborators assume no responsibility for", "short_description": "Become an astronaut on a mission to the Moon: stay still, stay focused, and get ready for your MRI adventure."}, {"images": {"nodes": []}, "id": "1211952291152760", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mission Control MRI Simulation", "keywords": ["Pr\u00e9parationIRM", "Entra\u00eenement", "R\u00e9alit\u00e9Virtuelle", "SimulationImmersive"], "long_description": "Viens vivre une aventure VR immersive autour de la proc\u00e9dure d\u2019IRM. D\u00e9couvre les diff\u00e9rentes \u00e9tapes du parcours IRM de mani\u00e8re ludique et interactive.\nDeviens un astronaute avec une mission sp\u00e9ciale : atteindre la Lune !\nPour y arriver, monte \u00e0 bord de ton vaisseau spatial et garde le cap sans bouger.\nNotre centre de contr\u00f4le t\u2019accompagnera lors de la mission et te signalera si ton vaisseau d\u00e9vie de sa trajectoire.\n\n**Es-tu pr\u00eat astronaute ?**\n\n--\n\nTu peux commencer l\u2019exp\u00e9rience assis, puis tu seras invit\u00e9 \u00e0 t\u2019allonger pendant que le lit virtuel glisse dans l'IRM.\n\nLa simulation peut aussi \u00eatre utilis\u00e9e avec un accompagnateur. Des commandes sp\u00e9ciales pour l\u2019accompagnateur sont indiqu\u00e9es dans le menu.\n\nCr\u00e9dits:\nDev. VR: Caroline Dakoure (CD); Dev. du Contenu: CD, Ana Elisa Sousa, Justin Sung (JS), Liana Sanchez; Narration Audio: JS, CD; Coordination: Vanessa Valiquette, Martin Lepage\n\nAvis de non-responsabilit\u00e9:\nCette application n\u2019est pas con\u00e7ue \u00e0 des fins diagnostiques, th\u00e9rapeutiques ou m\u00e9dicales. Elle est fournie \u00ab telle quelle \u00bb, sans garantie d\u2019utilisation sans erreur ou interruption. L\u2019utilisation se fait \u00e0 vos propres risques. Les d\u00e9veloppeurs et collaborateurs ne peuvent \u00eatre tenus responsables de tout type de dommage li\u00e9 \u00e0 son utilisation ou \u00e0 l\u2019impossibilit\u00e9 de l\u2019utiliser, y compris, sans s\u2019y limiter, les pertes de donn\u00e9es, interruptions de service ou probl\u00e8mes mat\u00e9riels. Le contenu est fourni \u00e0 titre informatif uniquement, sans garantie d\u2019exactitude, d\u2019exhaustivit\u00e9 ou de fiabilit\u00e9.", "short_description": "Deviens un astronaute en mission vers la Lune : reste immobile, reste concentr\u00e9 et pr\u00e9pare-toi pour ton aventure IRM."}]}, "developer_name": null, "developer_privacy_policy_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/privacy-en.html", "developer_terms_of_service_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/terms-en.html", "publisher_name": "Caroline DAKOURE", "support_website_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/#contact", "website_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "c
_nc_sid=6e7a0a&_nc_ohc=ELcH1QD0vJEQ7kNvwEu4SNX&_nc_oc=Adow28izObFOoI6N6RyCrcsqF0-0UFzellOK4ReICfW7TiwvID07JxD9Q2oV72xPmh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21ndNObssEXBzW1sjAJMqtzVMc9nomu-IJuX3sliNL4A&oe=69EA0F6C"}, {"file_name": "4.png", "id": "1353136783287675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1353136786621008_7052937903676663304_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmVtiI5S1HMQ7kNvwH4hwFP&_nc_oc=AdrYFUv6KI9WYTAWBRP9A8DEkMJYvRBkLyXnSDOibmE6xcCMGt9sSFXdNym4Sl9otVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pwd-fjbDf5-PZyN7oCyBN8fD63xLQlpGlPL9OwKK70A&oe=69EA2B55"}, {"file_name": "5.png", "id": "962594523184847", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_962594526518180_7910449889851491339_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOhenNejleQQ7kNvwEsD0_Y&_nc_oc=AdqslevBKUkgr8JvmwXlHzL1hN1QXOQQGFpUKoZvkiGhttXyTQmmZg2ICWESB-PWrIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af301cMAPz-9Ijdkm4-YqJ2RFWgcjuLWtnU_4Dr9GCp9AQ&oe=69EA23BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "954321790486520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_954321793819853_8816488500208354490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Abfnoa2obzAQ7kNvwFRhOj9&_nc_oc=AdpqZurO2ouxw5jBKfdQamiJ2S4w8Vu-FnmUPUoPMfjBjKKitxJRb8A4sp3DLSqlyGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WIOUn33iGc9uD4tQMOaQ2Q2mJP4gW-AiKSUQIkZaGLQ&oe=69EA0428"}, "display_name": "Mission Control MRI Simulation", "keywords": ["MRIPreparation", "VirtualRealityTraining", "ImmersiveSimulation", "VR"], "long_description": "You will embark on an immersive VR adventure set around the MRI procedure. Step into the shoes of a special astronaut with one mission: to reach the Moon. To succeed, you must board your spaceship and stay on course. We will send real-time feedback if you move and drift off path. **Are you ready, astronaut?**\n\nCredits: C. Dakoure (Dev., Content, Voice), A.E. Sousa (Content), L. Sanchez (Content), J. Sung (Content, Voice), V. Valiquette (Coord.), M. Lepage (Coord.). Thanks to N. Catwell (Dev, Content) & A. Shruti (Content) for their work on the initial prototype.\n\n--Additional Information--\n\nYou can begin the experience sitting on your bed, until the moment comes to lie down into the virtual MRI machine.\n\nThe simulation can also be used by caregivers as an informational tool. It was designed so that the participant can use one controller while the accompanying person uses the other. We encourage you to consult the in-game menu to discover the special controller inputs available to the accompanying person.\n\nDisclaimer:\nWE DO NOT WARRANT THAT YOUR USE OF THE APPLICATION WILL BE ERROR-FREE OR UNINTERRUPTED. THE APPLICATION IS NOT DESIGNED FOR DIAGNOSTIC, THERAPEUTIC, OR OTHER MEDICAL PURPOSES.THE APPLICATION IS PROVIDED \u2018AS IS\u2019. \n\nUse is at your own risk. The developers and collaborators assume no responsibility for any form of damages. \nThe content provided is for informational purposes only. ", "short_description": "Become an astronaut on a mission to the Moon: stay still, stay focused, and get ready for your MRI adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/privacy-en.html", "developer_terms_of_service_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/terms-en.html", "publisher_name": "Caroline DAKOURE", "support_website_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/#contact", "website_url": "https://carodak.github.io/Mission-Control-MRI-Simulation-Info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1
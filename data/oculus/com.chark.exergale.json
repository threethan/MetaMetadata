dn.com&_nc_ss=7f20f&oh=00_AQITJbys0ODDTo5NSEyMK3SU6jbeI4i8VXMM3avowj-NAA&oe=6A9854E5"}, "display_name": "Exer Gale", "keywords": ["flying", "arcade", "racing", "speedrun", "casual"], "long_description": "# \u2705 Unique FLYING and GLIDING Mechanic\n\nFlap your hands like a bird to sweep across the skies in **the best flying game in VR**!\n\n**Race together** in exciting environments with your **hands as wings**\n\n{1952440278833779}\n\n**Hang out** and **compete** against other players **online**\n\n{717838547659719}\n\n**Glide** at your own pace or **race against time** in single-player\n\n{1484861152888342}\n\n**Collect points** and **unlock new levels**\n\n{1130771229068737}\n\nConquer **leaderboards**, get new **tattoos and wings**\n\n{1544702783634013}\n\nLet\u2019s meet up in the land of **Exer**!\n\n\n**Exer Gale Community** Discord https://discord.gg/hNVMRYdBNd", "short_description": "Exer Gale is a game for those who want to fly like a bird. You are free to glide and dive in the skies, explore and advance through magnificent islands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exergale.com/privacy-policy/", "developer_terms_of_service_url": "https://exergale.com/terms-of-service/", "publisher_name": "CHARK Studio", "support_website_url": null, "website_url": "https://exergale.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
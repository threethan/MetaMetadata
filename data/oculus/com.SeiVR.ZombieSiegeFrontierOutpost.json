1-7&_nc_sid=6e7a0a&_nc_ohc=4IbfmmKn2DcQ7kNvwGkfFqs&_nc_oc=AdqVSOJCBui411H3fJCkSPELdWtqM_6Y7sjWcU5fBNhXB0Cmn555LN5-j0MrJvXv_JQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVr6EV4JN1wQumcuhIDUfCNPzBXBCd91vQQL25EPIM8A&oe=6AAFD5CA"}, {"file_name": "1.png", "id": "1850676048894974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_1850676052228307_973769633470129491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExOTREsGgO8Q7kNvwHyCN-i&_nc_oc=AdqLF0OqtFlqmnP9QnLVi-HpS8U6TjWoeI1R-2MM58NmObF7xzurN5mjrUlzuK5vylo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY4Y2355zdyS249-KjL8efLw7IUPtZLnVeTIiOadziXQ&oe=6AAFD03F"}, {"file_name": "2.png", "id": "1369721661528227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618432_1369721664861560_3826965205669018755_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAVBWmC6GgQQ7kNvwHTScVp&_nc_oc=Adq3FPvXxZYMLnauBcEKU4wGmUvNWgi8dMYGmXSBzQ6D6JU2x3ahvc8y1k1SvFPsclI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK202IDAnnzXJqmrp8MxLcOA4U2m8bw-1o0o4lTB98-Uw&oe=6AAFF0D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "1448670393097335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1448670399764001_7527925408024294310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEgUx-xQKmwQ7kNvwGT-W0G&_nc_oc=AdpY54GQ3PTmuKEFXiOQzMUOXDVDkuBpvKjAtZ-xkjWI7RrAYFms7YEJmHwCvk6JrpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvUQjDLGvAHKKtV2MyudPg-rl91u6gRwhNmE5tsDplew&oe=6AAFEC6F"}, "display_name": "Zombie Siege: Frontier Outpost", "keywords": ["VRZombieShooter", "ZombieSurvival", "WaveShooterVR", "OutpostDefense", "MetaQuestZombie"], "long_description": "Step into \u201cZombie Siege: Frontier Outpost\u201d, a heart-pounding VR zombie shooter set in a remote military base under siege. The border has fallen, and waves of zombies are breaking through the fences. Only your aim, reflexes, and survival instincts can hold the line.\n\n\ud83c\udfaf Authentic VR Zombie Shooting\nFeel every trigger pull as you battle relentless undead hordes in immersive first-person view. Built for players who crave realistic gun handling, fast reloads, and intense VR combat.\n\n\ud83d\udd2b Master Your Weapons\nSwitch between pistols, rifles, shotguns, and grenades \u2014 each demands precision aim and quick reloading to stop zombies before they close in. Headshots keep you alive.\n\n\ud83e\udddf Wave-Based Survival\nSurvive escalating zombie attacks. Each wave grows faster and deadlier. Use bullets wisely, upgrade your gear, and never let your guard down.\n\n\ud83d\udea8 Mission-Driven Action\nDefend convoys, clear infected zones, rescue survivors, and secure checkpoints. Every mission tests your shooting accuracy and nerves under pressure.\n\n\ud83c\udf0c Immersive Frontier Outpost\nExplore eerie bunkers and dark watchtowers surrounded by groans of the undead \u2014 perfect for fans of VR zombie horror shooters.\n\n\u2699\ufe0f Features:\n\nRealistic VR gunplay with manual reloads\n\nPistols, rifles, grenades, and shotguns\n\nMission-based progression & endless survival\n\nIntense zombie attack waves\n\n360\u00b0 VR environment built for Meta Quest\n\nLock, load, and fight to survive the zombie apocalypse at the frontier.", "short_description": "Defend the border outpost in an intense VR zombie shooter.\nMaster pistols, rifles and grenades to survive endless zombie attacks. Precision shooting and fast reloading are the only way to stay alive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
 sound design\nResponsive controls for pistols, shotguns, rifles, and grenades\nArsenal of deadly weapons and tactical upgrades\nDiverse missions with increasing challenges\nAre you ready to fight for survival?", "short_description": "Survive the zombie apocalypse in VR! Defend bases, escort convoys, and blast zombies with pistols, shotguns, and grenades in Zombie Siege VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25234053522954429"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1552245182445594_2594377585894470028_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS4A5UZH9IQQ7kNvwHBYWp9&_nc_oc=AdotZjZu_zkRU4j_JMoNWqv_wrT62xxF-vEzyzBqquUAJRPup1lkLIXiGuxkvGIIMdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_b-aCDHmghU6EodVHW89ZuY70UfdeW7ax44fG1FMR1g&oe=6B0C6398"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zombie Siege VR", "platform": "ANDROID_6DOF", "conte
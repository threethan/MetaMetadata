1-7&_nc_sid=6e7a0a&_nc_ohc=HZFT5ocyZJkQ7kNvwEzPDpw&_nc_oc=AdqLDlUYyh0a8Dblh4AHHGxo2WTz5DxhRrN1irfdqL92P4ttycbaPPF9JRIQCJs4QOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6tcnmi44fv7hpIK5ORVRfFvwYp47xlzC-E9KeqxmzNg&oe=6AC2830A"}, {"file_name": "1.png", "id": "1850676048894974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820987_1850676052228307_973769633470129491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EYpprlHvM0Q7kNvwF8HJR0&_nc_oc=AdqX5AVxRRVlfVtilxIxycGRH1-pKT0XG7LFwGNEIQl5fia7gGonDk8gWiBAHDUJ6wI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO76Z7MrRfgIzRxFv2rvBhXg5gdxzUV6sy0mTNxTuHE2A&oe=6AC27D7F"}, {"file_name": "2.png", "id": "1369721661528227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_1369721664861560_3826965205669018755_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otUfUTyfTtMQ7kNvwHOzJVD&_nc_oc=Adqntj83mI8-KSk4phCmqH7OZseFyf8OUHj5oK9onmDV1IbTuLGDYU3wABFlfh-5JtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_3VLm6XoOAMe-HononKCyfwTrzsNwMYsX5j2Fel3qJg&oe=6AC265D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "1448670393097335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_1448670399764001_7527925408024294310_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53NrUHUcEBIQ7kNvwGEEN9X&_nc_oc=AdqEUBtheGGNkSdn8zhvvCc5VF2Iqb3Wn2QBeJDYV_OcItDi76QjjCmIEmLdI0QKQQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlPVVSnoVMlLWrpXgQ2jyX4VMk4s2gTGvW2PCvZWoheQ&oe=6AC2616F"}, "display_name": "Zombie Siege: Frontier Outpost", "keywords": ["VRZombieShooter", "ZombieSurvival", "WaveShooterVR", "OutpostDefense", "MetaQuestZombie"], "long_description": "Step into \u201cZombie Siege: Frontier Outpost\u201d, a heart-pounding VR zombie shooter set in a remote military base under siege. The border has fallen, and waves of zombies are breaking through the fences. Only your aim, reflexes, and survival instincts can hold the line.\n\n\ud83c\udfaf Authentic VR Zombie Shooting\nFeel every trigger pull as you battle relentless undead hordes in immersive first-person view. Built for players who crave realistic gun handling, fast reloads, and intense VR combat.\n\n\ud83d\udd2b Master Your Weapons\nSwitch between pistols, rifles, shotguns, and grenades \u2014 each demands precision aim and quick reloading to stop zombies before they close in. Headshots keep you alive.\n\n\ud83e\udddf Wave-Based Survival\nSurvive escalating zombie attacks. Each wave grows faster and deadlier. Use bullets wisely, upgrade your gear, and never let your guard down.\n\n\ud83d\udea8 Mission-Driven Action\nDefend convoys, clear infected zones, rescue survivors, and secure checkpoints. Every mission tests your shooting accuracy and nerves under pressure.\n\n\ud83c\udf0c Immersive Frontier Outpost\nExplore eerie bunkers and dark watchtowers surrounded by groans of the undead \u2014 perfect for fans of VR zombie horror shooters.\n\n\u2699\ufe0f Features:\n\nRealistic VR gunplay with manual reloads\n\nPistols, rifles, grenades, and shotguns\n\nMission-based progression & endless survival\n\nIntense zombie attack waves\n\n360\u00b0 VR environment built for Meta Quest\n\nLock, load, and fight to survive the zombie apocalypse at the frontier.", "short_description": "Defend the border outpost in an intense VR zombie shooter.\nMaster pistols, rifles and grenades to survive endless zombie attacks. Precision shooting and fast reloading are the only way to stay alive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
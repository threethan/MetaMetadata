_ohc=KAURPM15DjMQ7kNvwE2gr_d&_nc_oc=AdrtiYDezrlrw11WRAs72rXRE3xOho9xC-_T9H1orbGLfhiQVtGt7ektb2lggzu-yzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSfVuvs8PUPtyl4itWbEf8Mm7OJ-dfDzNuwayclEB27w&oe=6B0C7BF0"}, {"file_name": "Screenshot 2025-10-23 001821.png", "id": "2190236958132983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619715_2190236961466316_4116686085041195950_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvkLJx72_nIQ7kNvwEhocbI&_nc_oc=Adowd_IGQHwq2H6A--rKIAdNkvdcGcMzoxnjEi__Sdlz17R4psZUIP_xuZomc5zRNUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTX45emQvVRu4nDLGBS2cW9EuN5vaXzgnx55E6K46Ouug&oe=6B0C71F5"}, {"file_name": "Screenshot 2025-10-23 001141.png", "id": "1340375880774038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_1340375884107371_7282257053848138096_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZqOofiJAAoQ7kNvwFCuQGb&_nc_oc=AdpitwQv2RvJMdfttIsAWNEpvABynVoIs_dRbj1AbusTH9MUDJN0yMipIxdaD2ClH4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBrsEw9eGp6FuVQW_9fYU5PMl5pR2UnggEL5wf3vn9VA&oe=6B0C570A"}, {"file_name": "1.png", "id": "1850676048894974", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820987_1850676052228307_973769633470129491_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZTejHVJR-oQ7kNvwE4VJBH&_nc_oc=AdqeGj5uuhiPW_WJeOKGqQMVsJuB6S5bG0NRDcmftz4brMyDKILKqIf-2tABSYBeSyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpFUaBnnv1_uj1iyqf5QQNXOwJ3we41fcPznBVO_z8Mg&oe=6B0C517F"}, {"file_name": "2.png", "id": "1369721661528227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618432_1369721664861560_3826965205669018755_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-8Pv38JaUYQ7kNvwHaiIRh&_nc_oc=Adqjf2uF11kwG3qbzNF1aZYvTl0j7uw_h_uXFVdceUZI-ix5UhGHNt3rBUS82vGHKNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvBekkLHK_2W_rljTfOA7XSHWY2qhAUCEiv_oTKTXefg&oe=6B0C7211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "1448670393097335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_1448670399764001_7527925408024294310_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFBzeXT2DX0Q7kNvwEyhWST&_nc_oc=AdpKC8OD7iljSEfIqA2DPyFda2dzt4eksZevv9Y0vhbyvdMLtDw6OZidDTc3Bt54XaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTk_yjmde1NWbFoXzIyMoe6mQmfPSaBZWiogGfutLylIQ&oe=6B0C6DAF"}, "display_name": "Zombie Siege: Frontier Outpost", "keywords": ["VRZombieShooter", "ZombieSurvival", "WaveShooterVR", "OutpostDefense", "MetaQuestZombie"], "long_description": "Step into \u201cZombie Siege: Frontier Outpost\u201d, a heart-pounding VR zombie shooter set in a remote military base under siege. The border has fallen, and waves of zombies are breaking through the fences. Only your aim, reflexes, and survival instincts can hold the line.\n\n\ud83c\udfaf Authentic VR Zombie Shooting\nFeel every trigger pull as you battle relentless undead hordes in immersive first-person view. Built for players who crave realistic gun handling, fast reloads, and intense VR combat.\n\n\ud83d\udd2b Master Your Weapons\nSwitch between pistols, rifles, shotguns, and grenades \u2014 each demands precision aim and quick reloading to stop zombies before they close in. Headshots keep you alive.\n\n\ud83e\udddf Wave-Based Survival\nSurvive escalating zombie attacks. Each wave grows faster and deadlier. Use bullets wisely, upgrade your gear, and never let your guard down.\n\n\ud83d\udea8 Mission-Driven Action\nDefend convoys, clear infected zones, rescue survivors, and secure checkpoints. Every mission tests your shooting accuracy and nerves under pressure.\n\n\ud83c\udf0c Immersive Frontier Outpost\nExplore eerie bunkers and dark watchtowers surrounded by groans of the undead \u2014 perfect for fans of VR zombie horror shooters.\n\n\u2699\ufe0f Features:\n\nRealistic VR gunplay with manual reloads\n\nPistols, rifles, grenades, and shotguns\n\nMission-based progression & endless survival\n\nIntense zombie attack waves\n\n360\u00b0 VR environment built for Meta Quest\n\nLock, load, and fight to survive the zombie apocalypse at the frontier.", "short_description": "Defend the border outpost in an intense VR zombie shooter.\nMaster pistols, rifles and grenades to survive endless zombie attacks. Precision shooting and fast reloading are the only way to stay alive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25056783850681398"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "948897524127582"}, {"status": "PUBLISHED", "id": "2861569057515219"}, {"status": "PUBLISHED", "id": "1544482353959335"}, {"status": "PUBLISHED", "id": "1830700460903472"}, {"status": "PUBLISHED", "id": "900062862820668"}, {"status": "PUBLISHED", "id": "2203703460159521"}, {"status": "PUB
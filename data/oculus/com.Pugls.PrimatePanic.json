cdn.com/v/t64.5771-25/57572927_336182456005065_4969091488537524774_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpjXjMgsk_UQ7kNvwHR84UU&_nc_oc=AdouQsmRGc5tVx14ErocCAE1ARH4OdLDHYWMtmBR4UQ8qlj5f-jO34F14xZbTZTVI8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSzkSmKHtbyIzuQwxdDV3nmU79LzC7Y4I0YL5lTgKA8g&oe=6B005E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-14_103350609_2560x1440.png", "id": "355199840797276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223476_355199844130609_5518611787303143220_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gePImBsoVQAQ7kNvwFS_zQi&_nc_oc=AdoA3hWTOkF_iY-ytEjAvme67Pkc1ZKYf0-OJik9pL3tAOY5EHABBG8sM4SWaBxgeYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2oxuowuxSCzHBrkNXdBp0zdtd7UxMbhoPwR-xIF1vkg&oe=6B005661"}, "display_name": "Primate Panic!", "keywords": [], "long_description": "Embark on a chilling journey into the heart of darkness with \"Primate Panic,\" a spine-tingling horror game that explores the eerie mysteries of a long-forgotten research facility. Unravel the secrets hidden within the shadows as you navigate the twisted corridors, plagued by the echoes of haunting experiments gone awry.\n\n\"Primate Panic\" delivers a unique horror experience, combining psychological terror with the macabre consequences of unethical experimentation. Face your fears, survive the relentless onslaught of mutated primates, and uncover the horrifying truth that lies beneath the surface of this forsaken research facility. Can you escape the clutches of your primate pursuers, or will you succumb to the madness that awaits in the heart of the Primate Panic?", "short_description": "Embark on a chilling journey into the heart of darkness with \"Primate Panic,\" a spine-tingling horror game that explores the eerie mysteries of a long-forgotten research facility. Unravel the secrets hidden within th
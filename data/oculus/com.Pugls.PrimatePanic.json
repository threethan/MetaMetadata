4LjE_TpFOt3qfDmWUJ5GCX4CTJp-mJpfB8t1qyAbcWLtVDYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zhx4G98ExqnRNNLogYqO10081xgtr5N9NQDR2DEmMEw&oe=6A2D6661"}, "display_name": "Primate Panic!", "keywords": [], "long_description": "Embark on a chilling journey into the heart of darkness with \"Primate Panic,\" a spine-tingling horror game that explores the eerie mysteries of a long-forgotten research facility. Unravel the secrets hidden within the shadows as you navigate the twisted corridors, plagued by the echoes of haunting experiments gone awry.\n\n\"Primate Panic\" delivers a unique horror experience, combining psychological terror with the macabre consequences of unethical experimentation. Face your fears, survive the relentless onslaught of mutated primates, and uncover the horrifying truth that lies beneath the surface of this forsaken research facility. Can you escape the clutches of your primate pursuers, or will you succumb to the madness that awaits in the heart of the Primate Panic?", "short_description": "Embark on a chilling journey into the heart of darkness with \"Primate Panic,\" a spine-tingling horror game that explores the eerie mysteries of a long-forgotten research facility. Unravel the secrets hidden within the shadows as you navigate the twisted corridors, plagued by the echoes of haunting experiments gone awry."}]}, "developer_name": "PugWareTM", "developer_privacy_policy_url": "https://sites.google.com/view/primatepanic/home", "developer_terms_of_service_url": null, "publisher_name": "Pugls", "support_website_url": null, "website_url": "https://sites.google.com/view/primatepanic/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "reco
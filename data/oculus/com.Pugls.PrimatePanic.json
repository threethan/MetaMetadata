EC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-14_103350609_2560x1440.png", "id": "355199840797276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223476_355199844130609_5518611787303143220_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1jN8lXJrwMQ7kNvwGrZWlK&_nc_oc=Adm79Eqd9MS8Pg2H62bFQDyg-X0oIhU9fy8GS_lsqdNgOu-cuHwDS7SXWMgZAbpQ0c0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3TgwZdNFMwsw1GUFfzjzrT_NLHdGwIxYpO7WoqB9biw&oe=69B41C61"}, "display_name": "Primate Panic!", "keywords": [], "long_description": "Embark on a chilling journey into the heart of darkness with \"Primate Panic,\" a spine-tingling horror game that explores the eerie mysteries of a long-forgotten research facility. Unravel the secrets hidden within the shadows as you navigate the twisted corridors, plagued by the echoes of haunting experiments gone awry.\n\n\"Primate Panic\" delivers a unique horror experience, combining psychological terror with the macabre consequences of unethical experimentation. Face your fears, survive the relentless onslaught of mutated primates, and uncover the horrifying truth that lies beneath the surface of this forsaken research facility. Can you escape the clutches of your primate pursuers, or will you succumb to the madness that awaits in the heart of the Primate Panic?", "short_description": "Embark on a chilling journey into the heart of darkness with \"Primate Panic,\" a spine-tingling horror game that explores the eerie mysteries of a long-forgotten research facility. Unravel the secrets hidden within the shadows as you navigate the twisted corridors, plagued by the echoes of haunting experiments gone awry."}]}, "developer_name": "PugWareTM", "developer_privacy_policy_url": "https://sites.google.com/view/primatepanic/home", "developer_terms_of_service_url": null, "publisher_name": "Pugls", "support_website_url": null, "website_url": "https://sites.google.com/view/primatepanic/home", "ca
-1.oculuscdn.com&_nc_ss=8&oh=00_Afy69fNFmidVuJWqeVcjPRbJAZCoYx_7Hg6rzp6kCJCV8Q&oe=69BE7DE9"}, {"file_name": "38974745_356482555170515_2032556263098810368_n.png", "id": "2885420638275288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_2885420641608621_2195831309562377225_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgU3Q75Ajl4Q7kNvwHlzGD7&_nc_oc=AdlodcVcyeb5RQWsQx9Q78ZtSwc_q4dJGAMPtBGqAGMm-EmUZEl0b1gBEzqMZgwHnvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZPkcl1GE1FkkcsrS7z49dOvKYPpRPKTKffjTfmtbYuA&oe=69BE9C8B"}, {"file_name": "38974826_378008086304529_7920435661130170368_n.png", "id": "831297329107707", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75647714_831297339107706_588535524867628212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE3KtONOCz8Q7kNvwFyrcZi&_nc_oc=AdnnQZ8OEXl3uUw--0TxTU-MnTOlhVmTJwxP6QRiJsJTGzrGiac0WuGdwZm2s2bpTlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyEkl7ixhJitzfWqR1d5WnLN2s23gr1fjnHS9kFazWsw&oe=69BEA3DC"}, {"file_name": "image (12) (1).png", "id": "350524578108373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570314_350524581441706_6483345684963408915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrNhf8nkGcwQ7kNvwETflVT&_nc_oc=AdkkC5Jm5Rfio3zoCyV0iHdvqby0LSfche3NIKhjdA4jDk0m8fGA9VfifAyJB6cGWm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5IgneE0HgGUoTuP08zn-Xy6ESqvF7-67t7JjXG3ii3A&oe=69BE77A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "497977659842667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982544_497977663176000_8757830213700921902_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0QykTO-MWMQ7kNvwGIubWp&_nc_oc=Adkc3cDnit8wcFKgki-V1pZt3FIkHNUtJz_inul4GDVI-X3et-DKEdi352lyUMfBecI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-eF2pUBBKRS02J8u4mLTjpFfoOstSFbofZJkEQfsmnQ&oe=69BE7EA6"}, "display_name": "XRHealth Physical & Cognitive Space", "keywords": ["XRHealth", "Physical", "Therapy", "Cognitive", "Health"], "long_description": "XRHealth Physical & Cognitive Space is a virtual reality platform for physical therapy.\n\nXRHealth offers an engaging way to participate in physical and occupational therapy sessions, allowing you to explore virtual therapeutic environments under the guidance of your therapist. \n\nHere\u2019s how XRHealth works in 3 simple steps: \n\nStep 1: Sign up, tell us a little about what you\u2019re going through. We\u2019ll match you with a licensed clinician. \n\nStep 2: Meet your therapist in a live, online video appointment. Your therapist will conduct a clinical assessment and create a customized care plan.  \n\nStep 3: Feel better! Show up to your telehealth appointments and complete your therapy sessions with the VR Telehealth Kit.  \n\nSign up at: https://xrhealth-us.clientsecure.me/ ", "short_description": "XRHealth Physical & Cognitive Space is a virtual reality platform for physical therapy."}]}, "developer_name": "XRHealth", "developer_privacy_policy_url": "https://www.xr.health/vrhealth-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRHealth", "support_website_url": null, "website_url": "https://www.xr.health/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9112262868805749"}, "review_mes
-3.oculuscdn.com&_nc_ss=8&oh=00_Afwad0dXELihwf5jS_PFxbays3VO7t3SqyPPMyfGaYcUcg&oe=69B937E9"}, {"file_name": "38974745_356482555170515_2032556263098810368_n.png", "id": "2885420638275288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031640_2885420641608621_2195831309562377225_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1rpDefX3HwQ7kNvwHSEOCN&_nc_oc=AdmOJvdSddqpxFbE-8yXa-CeKZigWGHfzYFwWJstD6oz9kQkyQxynksoCoBk7FESD8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxetAS5TrV3rPLyWbxGNwNysQamZBKe0I5k7wo19HEC7w&oe=69B9568B"}, {"file_name": "38974826_378008086304529_7920435661130170368_n.png", "id": "831297329107707", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75647714_831297339107706_588535524867628212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ruWq1AohcQ7kNvwHJVDsW&_nc_oc=AdmuDuthYQ0l4vtO-wmDsugTDE26pErBPxy3sjYx-fWuObvbw60b7zpDgzACS7ka-vQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPB3O7_xpipnLb8U1EGkD9PhV_CEQoRDsAORop_bXCvg&oe=69B95DDC"}, {"file_name": "image (12) (1).png", "id": "350524578108373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570314_350524581441706_6483345684963408915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfCNB7C9uuEQ7kNvwE3xaF7&_nc_oc=AdmURHYYThGRch24WZmoFo6iqrgAxwodlqIcU5eqmqk7l9TbyBiWqsYFCRXc2hcbZ8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTziGEQ7-vJwTJ-3w2EASdGO5UlftnaSdTluCi_LgZ-g&oe=69B931A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "497977659842667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982544_497977663176000_8757830213700921902_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKDRA7soot0Q7kNvwGxlCfe&_nc_oc=AdkKhIKxE-hpcUKci2K3ob7QaaPiteErf9Jw3ybyAYEze1gik8TwfQ-OzgQLGRz5Uys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEZUL-37G29raxeGl10LpAjAvQ9oUjVzMJTFZJt7VFdQ&oe=69B938A6"}, "display_name": "XRHealth Physical & Cognitive Space", "keywords": ["XRHealth", "Physical", "Therapy", "Cognitive", "Health"], "long_description": "XRHealth Physical & Cognitive Space is a virtual reality platform for physical therapy.\n\nXRHealth offers an engaging way to participate in physical and occupational therapy sessions, allowing you to explore virtual therapeutic environments under the guidance of your therapist. \n\nHere\u2019s how XRHealth works in 3 simple steps: \n\nStep 1: Sign up, tell us a little about what you\u2019re going through. We\u2019ll match you with a licensed clinician. \n\nStep 2: Meet your therapist in a live, online video appointment. Your therapist will conduct a clinical assessment and create a customized care plan.  \n\nStep 3: Feel better! Show up to your telehealth appointments and complete your therapy sessions with the VR Telehealth Kit.  \n\nSign up at: https://xrhealth-us.clientsecure.me/ ", "short_description": "XRHealth Physical & Cognitive Space is a virtual reality platform for physical therapy."}]}, "developer_name": "XRHealth", "developer_privacy_policy_url": "https://www.xr.health/vrhealth-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRHealth", "support_website_url": null, "website_url": "https://www.xr.health/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9112262868805749"}, "review_mes
-1.oculuscdn.com&_nc_ss=8&oh=00_Afzws03i_pRBqy8P6RG63wz6xKOSpNTADchmmyYMpd6sMw&oe=69AEABE9"}, {"file_name": "38974745_356482555170515_2032556263098810368_n.png", "id": "2885420638275288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_2885420641608621_2195831309562377225_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlXhGJUAFNMQ7kNvwHPak-S&_nc_oc=AdnF4j2Ws4ojtpcMagfIG97Z08wyYtvgbfF3U7fcYeJO0VvZHlGEyFbZ_txiV4U_z4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP5Mpf-2L-QITPuq4ZNt35mcQkAxZmJt1TWeWdkiieUw&oe=69AECA8B"}, {"file_name": "38974826_378008086304529_7920435661130170368_n.png", "id": "831297329107707", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75647714_831297339107706_588535524867628212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkort8niAn8Q7kNvwGV5wOT&_nc_oc=AdlIpdRC5lJ0FWodSRb7r_bdBMIS2m-yLMW-gsgwHtr1OjXfChtLg5P-0El6fbgsYhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPrtlXl47Kyy6t9uzLIxyf6FbNvCE6nQHoYc4l_j45Xw&oe=69AED1DC"}, {"file_name": "image (12) (1).png", "id": "350524578108373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570314_350524581441706_6483345684963408915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJLq1SViWWAQ7kNvwEqLkdS&_nc_oc=AdloVYTqQEaj4rxIXgdhaJNUUGq7w8lu-btQhhn2GdfcapRFB_CHVirLli3Npi7phy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcvABOrmE0FUQ0BgzDE5grkxq5FrmejrFNCAbaa75acQ&oe=69AEA5A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "497977659842667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982544_497977663176000_8757830213700921902_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yI7F8yQC9EQ7kNvwFFAfFa&_nc_oc=AdlhXM9t8B8Kc91-sVveL3MqAVANd8JDNAjycoG1Zzh44gKBGsbLvyPgCaGLx-KTQ64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp4aWrNJ3Xrn_SyEq3Udoz5jXKXw08MxAp4yx1hetkaw&oe=69AEACA6"}, "display_name": "XRHealth Physical & Cognitive Space", "keywords": ["XRHealth", "Physical", "Therapy", "Cognitive", "Health"], "long_description": "XRHealth Physical & Cognitive Space is a virtual reality platform for physical therapy.\n\nXRHealth offers an engaging way to participate in physical and occupational therapy sessions, allowing you to explore virtual therapeutic environments under the guidance of your therapist. \n\nHere\u2019s how XRHealth works in 3 simple steps: \n\nStep 1: Sign up, tell us a little about what you\u2019re going through. We\u2019ll match you with a licensed clinician. \n\nStep 2: Meet your therapist in a live, online video appointment. Your therapist will conduct a clinical assessment and create a customized care plan.  \n\nStep 3: Feel better! Show up to your telehealth appointments and complete your therapy sessions with the VR Telehealth Kit.  \n\nSign up at: https://xrhealth-us.clientsecure.me/ ", "short_description": "XRHealth Physical & Cognitive Space is a virtual reality platform for physical therapy."}]}, "developer_name": "XRHealth", "developer_privacy_policy_url": "https://www.xr.health/vrhealth-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRHealth", "support_website_url": null, "website_url": "https://www.xr.health/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9112262868805749"}, "review_mes
.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNWbQztL_L0Q7kNvwERrCm_&_nc_oc=AdrjDMLgDwI_m6ByxlTLLDUeCm-BZxyU87KI_Z8QdWTfGcDY8qLjyA4IL0qNaH4xJGk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Mgzct45_iw-u--vlHh6Q0NLiAR6gjAVIVBewGKXgLpw&oe=69F6002C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2TLTnuUVPQQ7kNvwHWWUhp&_nc_oc=AdoHmpLNH0kTBR2uAhe2FNBL5Z14F5Jn_qVijRFpIJ2bGZ4uCaxKcgoYiCY7Xwg2ASU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XLB5lPCTQPjWhbFiUgORZzhj9v9JIURY0NYg-eJPUqQ&oe=69F61E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MUZjKg40vcQ7kNvwG8ZaJm&_nc_oc=Ado9wa3VtXepVj8NhDVUZga7Zcq--bQkUGfZHXnH4EXA4dCGUp21h_DU-iR1hy7kYV0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1K1y3jiI0SL8ci8dr-oVSYKvQkn37hziTQXH08EZAmmA&oe=69F5ED9F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE6L8HGYv-QQ7kNvwGXCA45&_nc_oc=AdqrNtbCiqF-Tu4nFmTjIO6NxmLMmvxsSTYDUZq-tlihd9XRO159C05urnPY1ThrEJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26ct4SOsOdy7_KnmY6NjzC3DmNQds1jmZauIQ3VyH21A&oe=69ECC5AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY5C_yuRzSQQ7kNvwFUu4UP&_nc_oc=AdoEEwfMP01Red2oH19Ryl4vZ7GWNIMfc-MpvW9MsPWp2f7OtijRqQ6FXZufs8WDg60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NoPjT69ubMtp1SMiBps0jSvoMBy9DvGmf9e_BItPxQQ&oe=69ECABAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81FlMZ1OpwUQ7kNvwETQFNP&_nc_oc=AdqGWRzqe9TrDJ25eQi0Exn_ygyAjDsLZoDHzLm8DudOKIKpvWqlMDrvzyBwCaV_gJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ddOvsTebgOBNEi0HDC5g1Hp_MBjpIGB7plDPYMUEi-w&oe=69ECB31F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCDJYdLznEsQ7kNvwGM7M8V&_nc_oc=AdrMYuPrmLg1COuuw5N94HE4tJ1EtACJ1Ag22_bz7MLR81HLUMISIwPWRg6NlqMREKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eGiSRZZHGA0X1xHqjK8ivMjXfeYx6eR1O4Ye6Y5yzBA&oe=69E38B2C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VnxrpM7KoQ7kNvwGPnnyZ&_nc_oc=AdpVCyRhPzCSH2eqHLaa6LSOXN4furCNUkxulP6-vVK9mk33N-JqUhu4cWp0pvDTYeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YB0yB5iTOJjCE0aY3G3HekwhVurvnX4IJRZYaSKvwUA&oe=69E3712A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcC4DiXAms8Q7kNvwHzLcVF&_nc_oc=Adprx6KP7DTdSmWhd4D5VyHqXKltowmpthVjZWyFmNUrvMQRrvOE4KP4M1D6iB3l9kE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fCY0WyD9lC0qjgewcu-7eg-_BaK12rUaqOB9nEoqh3A&oe=69E3789F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNWbQztL_L0Q7kNvwHd7OLP&_nc_oc=AdoJVhvcVeokoN_I6JIh0teyAlTp8dYUGYd-hSwVAhFLiBz--ZxBIBJRzqoUpTIPGTI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qeRGsyBP2lHhOnc6VjChyQmYrk--OSLkEQrSq6N_uNg&oe=69F35D2C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2TLTnuUVPQQ7kNvwHz-WOl&_nc_oc=AdqAZOZof3Lr-5xQuYXL_WRu2cDR7EwOgkp-dcx0Wn4HLWVPEFiWhjcSEfA4YZW12GA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fQU0OVQ3D8cufG2lGTVCRhPP971PVo4O09hh2kU87XQ&oe=69F3432A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HjJXGaJZzgQ7kNvwGA6Sk1&_nc_oc=AdoPOf-d4IEj225jyrR88DogD2YrFfLCWGPoDBhhCMmnmH6ALjWXvoneKgZpfVfR0dA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bVKTiRZBKwG_sC9QtFvS9iS0TWfzN_0XJ25Q75Ba7fw&oe=69F34A9F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
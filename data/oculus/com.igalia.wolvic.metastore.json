.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w3TX2xcDKsQ7kNvwEEHcLC&_nc_oc=AdpugbTeRee5O_aU6HoPn7D6V7miM7rf1ZRvmiQbgi0jvhmmN2z2KRiiEIq96gPOyL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZDTX5NT1cjB6hxgSvT0uVq27AS77DNWgVUKqB7cc2rA&oe=69EA22AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stv6ffYNUqUQ7kNvwH-1xm1&_nc_oc=AdqXir6wSvfduInfMBfAQaxtDcbdyuUeeq0lP8Oygq9438eJ-AvYFtRw3Lq9xovM9s4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m8cJDL8LKorA9wnQZEcITGixCFTcgAaSmJ6UcdC3W7g&oe=69EA08AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81FlMZ1OpwUQ7kNvwFae33u&_nc_oc=AdoYWbeaeuKt_SO-dYTTvwN7Yd6BGyuyab1kee8IbXtvgdwSzOxwhCsfyaO2kknIP-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k1zGTV_gYn9xmEVaNDkUxxBlCl9vix30IkvtQxRgj0g&oe=69EA101F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
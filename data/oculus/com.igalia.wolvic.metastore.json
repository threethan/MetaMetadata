g", "id": "564470599076600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031560_564470605743266_2861867456206183433_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWFHGJlBRtYQ7kNvwGN304W&_nc_oc=Adq1V-yuCfQ0ld4iHi4lzSdjqj_bvFrkgu6-meRl9BJfq1Ozd-TqD0V6JRmSiV_cY9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLl4JZCtrVYU1B2E-SZG3zdAheInOFuvZ8e3XgDqkRPA&oe=6B01EE4B"}, {"file_name": "screenshot5.png", "id": "519807043408308", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_519807046741641_2803606823603566651_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuP81iwoEVYQ7kNvwFsDiHR&_nc_oc=AdpI_gwmBwk0rqNz9ZhyaBNh1KlcrdHLWMCUY01YOnta3auua4ur4DtT18BYdayakUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIwQmaT3RyMfdvvkWx0JZTL3cNR49SsNw-oiCjf6CEIw&oe=6B01DE7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhEUfG2VNqcQ7kNvwFmWAdH&_nc_oc=AdpKClNRUtjzQSulD9OTxwrs_obtUc_wJYW1svU3sm9EK6EzDqHvE7TAaP5JnSd4754&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYsfdjbV1JY3TUOBwq0G54KcjZp_b7jfuXCzngO35W2A&oe=6B01C65F"}, "display_name": "Wolvic", "keywords": [], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open sou
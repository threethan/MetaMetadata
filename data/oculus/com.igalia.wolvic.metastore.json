.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-j6G3lO2h4Q7kNvwFRKp_x&_nc_oc=AdrhQDJkLM4zvMAYn3Mj6Fe_vd4hAKmTWxG_Z4C-J3iAeRZPWQR94gk2E85T-wottsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JYUPYNFlSIlOvNyTkemxA4cENOlCXEaAIrhhabTBNlQ&oe=6A0480AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmobnmoO1TwQ7kNvwGjRTA8&_nc_oc=Adp3j7X_8eBnevLtleCGZfPIlDTo4tkXSWy4Sx2OHZ1ayjPzp8oHWPzpMk0Q-KDQPnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_g43Uqb5PBEWrS-GHOFF_okix3I84TIc497KKwBtrdg&oe=6A0466AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi4HN9K6ffIQ7kNvwHwGeH3&_nc_oc=Ado_xKkP44U7OgjxHnpatRuyV1SlfttlepaqSvO0VYQPMkvQ6bRTUQvidKHz26Ca_Tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47rkgAzPEazEwRKMRn-w6F1AGV92QpDZBHWArHetG-8A&oe=6A046E1F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
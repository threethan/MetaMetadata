.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot9gkSz59scQ7kNvwGFaHDr&_nc_oc=AdqOBsRVXDbSa6InOwK9tpQzIXIDuQ7xEnqs02cMhPsxC6Yqq9XvkPLZp0WfQZ5aX-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dSd1b3Y2YiUPC8hApT3ZW_y3hLlfJ8vaa5Ap4jYiAJA&oe=69DF96AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaqjUWSeu2AQ7kNvwGjNSLQ&_nc_oc=Adp_rjendyGNX_Vl5XzcdB_2yO7la3h6z1pLJINbeoKAJNSpl3AE6aEUFRQnU49wV3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ItXITSOpaw3zGuMSon7pbNvsGQEKFj2qc9IgpqCAPfA&oe=69DF7CAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy00FL1yyAYQ7kNvwGiGF-B&_nc_oc=AdonaZkGn4IuoOCqtFYC-d3nDZcGxy4t5cBJmI-vpwHda73bQjFQKsccq5_xsd-XQy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EALkD_wu5ly9XZ0uBtfpRhJJQvGD88Am0Z1LxHN6l9g&oe=69DF841F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
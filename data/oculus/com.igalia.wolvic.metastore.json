culuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbfdMyE6vQoQ7kNvwHrUE1D&_nc_oc=AdpdRPzN0AUI5jMaJQhr5pVfIfSr4NC-PMD4Duotd_-NymVe9DshuxKGm5kI0DvYeio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqlMwljvEUrzIz4rPNYW2NQjg-aXnZyp3PIjK2M2ufbQ&oe=6A4FA62C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78cyt_TjddwQ7kNvwF0o540&_nc_oc=Ado9eccaMsRHHygH5q1Dtwu0YwCP_poHoT_Ezu5vpUI2Kp8YT9L9ERpLb0PU2jVgpqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuqAlfevJO7hMa0teOnjWoggnZ46AKFRKsaXW0gpff1g&oe=6A4FC46A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3g6jO2akkkQ7kNvwH-v3ON&_nc_oc=AdoxdyFc0YUU5XX0YrPeeptt2bYCO4t4JGcmZuA2cbSGnJ-QG1IfAZ6s_4e0mNEzW3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv5KegRg5D0k-nxyc48xadsxptMKyKg44uFvesX7KDDQ&oe=6A4F939F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and a
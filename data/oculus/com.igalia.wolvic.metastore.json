.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3LOn5_x2yEQ7kNvwFKSosg&_nc_oc=Ado4VEqEQEb8miPUBeMTlXiZi42jxcZIaKg5mHJPfJCt_b6Y44emMH-6w8fHb0ahtqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-xzxL0TkHw__p0ptcQpAuXUwz1BuV0fXlmB9r9AAxYQ&oe=6A08752C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IHHEa41yE0Q7kNvwGLSuc0&_nc_oc=AdoC0p2M9OH5zmjfBfON-rx5f6bNT9lGZDfhUNx-CZ-Kbq3lG5kazPaXl2ZpRk4o5ng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7phsMiHv7HSHc4AeMj0R_2qgq7hCHvKtpQ6BTtKzESLw&oe=6A085B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deObqjb5rvUQ7kNvwGN7J5r&_nc_oc=AdoR2shLc5_-hNszqHbQ5G_7BZNzPvJDVfRXQxTGbR3e7I-Ok0FQb02BkQxcDjxTymc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UMtkVwiZhavK6o4PvXPE1JqXfA4Mg6erhUtejYfPqmA&oe=6A08629F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
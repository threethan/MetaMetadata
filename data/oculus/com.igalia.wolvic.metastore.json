culuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oReITMUUBecQ7kNvwGk0k-Y&_nc_oc=AdqKMJgRdlrmMaWOTUJCNkorIT26kI_P0sP-enl88WjKIogvBX5GqTYNxLkg3eWoPl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ1RFDxGyhCQPHLVe42s8gN_8smWE0zS6AS9nUUnYItA&oe=6A7C792C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeirUHz3tacQ7kNvwH2kgPB&_nc_oc=Ado9aw8P-_eFds-8Hwo-HGqQRXSREgAtS3KPonYrxkcRRtJUrS4KKykssutsrQk0aB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2b-6VZYtNbn0eGjFHMvF7GW3LYNn-ZDmJf6pYFVKoYQ&oe=6A7C5F2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EB9jq5OZocQ7kNvwGjcBZa&_nc_oc=AdqMKmkJoqPit_bsf5bTMf6v-HuYKsGPySa2fGy7lcQm2QDC0ALaX0md3-Sg6kEpjfI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKt3aDvfI89-kXbL6hXsqz-2P20qGen8S6PfN4BguzTQ&oe=6A7C669F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and a
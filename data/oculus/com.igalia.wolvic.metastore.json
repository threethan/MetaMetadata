.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCDJYdLznEsQ7kNvwFmygq6&_nc_oc=AdqZaimGeYymkPbaKPTPq8sx2aoiB0fSz9UMO80mj7a17i8deyUiivf5tpa8Sf9HW0I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V2F9cKKhi-AEjKsnEtLXszDPTeH6rH4KtJG4kseBWsA&oe=69E62E2C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-NGKSrAvxQQ7kNvwFOwRpM&_nc_oc=Adr9cycA9B_2zGC3p1yiN--Z4h3ru5j_MSb35sss7ngFjD4u4M77g_aXab1SxmJpEpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W5G18hywdAv0aCA08BrcQfIh4UQFdqJxkA59feYD7BA&oe=69E6142A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYpxK5ldHigQ7kNvwF5fUDs&_nc_oc=AdrDPbGXMjsY16YiCS53rdVdnpg1y8n90967aiyr4PDPzDbRvDlHV_fqDusgw7PBClM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IusoQi2d_BXG9drCXmuOR7kUO4AKdg7jkZYdcs4vf4g&oe=69E61B9F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
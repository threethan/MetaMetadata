.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrfbTS7mw10Q7kNvwFKPUEg&_nc_oc=AdqWLh21gSVtonOzAHB6dOCZgpYRBKjOwGORjS7vg3X_QvQ_a7-NhJ_XvqEBVoTdgOY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NWxtJnbZJ9VNq7JZUY2CHDkyEvBP6ZwnTUeZ9lWXVkg&oe=69F751AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV_WErymmQQQ7kNvwEt2v5L&_nc_oc=AdrfUugzS9VUpmROIdSARdIH0AboDwmf23xm5oM2msikg6j5T1UXkMRvbVbxYKtBO1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-Q-Py6yWQA_udDqIPWp34x3HaPZXu3S5dMzC_2z799A&oe=69F737AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MUZjKg40vcQ7kNvwF3_psV&_nc_oc=AdpzrBH_Y4IrY8V7KpTfTEtGK8VZWMjccxIwdThCZCxjOh5aLhRkeOB3tivdj5Y6aFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J6UzIDxzlkhmC3NazLeYS2EBwk3l2B0Igmlak3k4ptg&oe=69F73F1F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
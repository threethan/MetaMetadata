.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE6L8HGYv-QQ7kNvwHupIOG&_nc_oc=AdpbUJVSbd_QLecuJQYyF6vlr_73xK5MnnR-pk3aOFv1DNS6o7OwNiYGlIOT0Pa_G9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25Zo8h0Np3m4ZopV92Hd0wOFI75PeMmXn9idfRggyz9A&oe=69EE172C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY5C_yuRzSQQ7kNvwFNVS5u&_nc_oc=AdoeKiQGNWgrKlnXjVrSecdNK4UP4bp8OK7sHjET-nFiyUjfg6V4tcYOEzH4cxH72Ak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wWDVTZSbvCvVH7afpWqwLYqIK6e1O9-2F0PjK4dHtWQ&oe=69EDFD2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81FlMZ1OpwUQ7kNvwH5cXWJ&_nc_oc=Adr6zJwbw2pwyx5J_CYfezQ97ssYn-D04lwnHlu-BvAoyeW7wSHGbEi2iAymUOEfJ7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mN8JN0l2UohLHzthGe-B3TXxb93zy4_mmVgTdF2bocA&oe=69EE049F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
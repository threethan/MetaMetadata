culuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPXpGSHF1AYQ7kNvwFDG8k8&_nc_oc=AdoDPBV7pbZNRpDj5wse8tkeZ7H2UMIdQSqIKJVxBUdNo2SJGFCGbajvhSrI_S_3194&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI2iTcv-z_9eWnvvd_NSxVWKTgPmsoLPX-5FzOySEijw&oe=6ADCB6AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOWTDPwyKokQ7kNvwFa9wop&_nc_oc=Adr_dJqoebq7lz52923qw98HXeJ_uXjnn_Z_b0Smgfgkw7DkAiVI2FV_LQFEXHdw4BY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBI_eOL1Kr9Z4pU6QC0sN95lbrmSrs6cz1CGffjAgfBA&oe=6ADCD4EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n5k8UII324Q7kNvwGCt-sv&_nc_oc=AdoWL1X262HmgEDlqBJUFaQKYL89-fPa1Rh39QfurMIrJjvu5XZYvRx6N3vv7ealHG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiyFz_HiFPZAZxH9vqcBEVVuFFQqXguJuG3207Q7RtsQ&oe=6ADCA41F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and a
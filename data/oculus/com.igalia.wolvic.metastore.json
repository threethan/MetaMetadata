.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE6L8HGYv-QQ7kNvwHOMX0N&_nc_oc=Adr87LTKD9A9rV33hWwmkZVOao6StliAO_UJ-fmB2EhVaUi-I08d-dxtLjeAfpQmkZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ReSjChxGQ7f3XJU2koXWjO7Rv4CqUX_66hxHVWRjLfQ&oe=69EB742C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY5C_yuRzSQQ7kNvwGouZrA&_nc_oc=AdqeJCJFiqKaAyLBcgEnnV9LQU4kX2qPfg83iPauX75NzssgW_Cks-rKcAvWrRC84R8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ie5EQ6KxCcZxoMatbSReZTRFQTzqzA4JDdWBfNj7DlA&oe=69EB5A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81FlMZ1OpwUQ7kNvwGuIcO6&_nc_oc=Adp6usC1LE5Y1eKheq-V3oYpouH-a1a273Y7rChOCVC7r2TmnESnL-AUc6kHWoZWp08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y3YNEZYHjhfdeyRoc42pkcM5HpKpfV5PFHmpzynhsxg&oe=69EB619F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
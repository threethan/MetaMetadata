.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-36zsmhCz8Q7kNvwGJQJJD&_nc_oc=AdoAb1W0LzdOJwBvCkTwOW7qUofR1nG4qsLdNae7MtEEC-Gj4r94SmU5k4tG7t0u2IQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Pm8O-Ah4PtfT-6E-5EfYf8vY560DQyxpKzCWKtinsQ&oe=69FC97AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A33q4CQLhKcQ7kNvwGnrNtT&_nc_oc=Adpp0cIM2v2Gz1Pnq3DX5u1PxjfLdFA6tYewxBUgMNeCVHc5b5OQ76Ws2GrS53uK-b4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eGr3BK1KNQf7m9823b6ssaNnokA_Aux_U1sBOt4UEgA&oe=69FC7DAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw6VITf1hVMQ7kNvwHmYjRh&_nc_oc=AdoOS9EBpqlAeO8LlUarzFXns1rnIKPAK_AGJAxZF-OFdD98iEQ94pTpckbueDb7raE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m8vWHkqkI7jCPiFC33Q25tk3AX8zLColMIjwWFIcang&oe=69FC851F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
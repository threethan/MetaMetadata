culuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt0aSF9UHzgQ7kNvwGBN9p5&_nc_oc=Ado-BmyfFoaJB90zvHYTtWIT9OHmbl7Aqt2E19ieA08jUQ0LCPm1k1SrBMb9NE7wGvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oj20eadmGv1jCnAaPbQrOgl3yzlvXLZu3_pgy8ovqBg&oe=6A43C8AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsAqkwQWQ_8Q7kNvwFZyijb&_nc_oc=AdoFQetd7fo645OamtVl-mOX5bNL0mD1E1atydprtqe3WpPxXr4NQdA5IWyecRxL0GA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lhJ3hdM6CgPENJtvRwzMOIpaiIIiDPVRAL6RjVD5lzw&oe=6A43E6EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUpzaOjiuWUQ7kNvwHj8jPu&_nc_oc=AdqMKRgIARMSNti8Pj4_Fl61RHNazfMmhJxDPTYNLKVI-Tfdt_n6Hyn73EjDqfjhCSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IXdEWo9cJoj3b6b30ZRVMR-4Vy0eRM14LcCMrrL2ekA&oe=6A43EE5F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and a
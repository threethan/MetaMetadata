.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOnVWxG-CHIQ7kNvwFdbKWc&_nc_oc=AdrG5J17TSD96fFExF-hriK_gar7hQM806NTqdkcpk_uwagowzEK3qVxk4m_lWG1Iwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EFg8wpHu3-rK_CVrsKoXtO-LfyXNoYQr8AtcB8tu2jg&oe=6A008C2C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7jS8a2yZowQ7kNvwF0w_pF&_nc_oc=AdrQqJVcXd5fjrLEuWKPa3ZD3Ss4cZiAWO8NrWXLbNA6BvXpLKnMfN8xo9KKkxwUOtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dO4Xc0BJzxts3nWPO9prIScm2zVLIgWufjHGEd9wplA&oe=6A00722A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do3kMkK3cpsQ7kNvwFuEeNI&_nc_oc=AdqjlFRDHR8zvlJT4VD85EAZuKccdlEHEqI0mOCL_izAb2FzaBbYG66Ct71Btl0BGN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Domak5SD0KroFc7jJd2n2nzZgK9v8uI5m4aAJekdIw&oe=6A00799F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
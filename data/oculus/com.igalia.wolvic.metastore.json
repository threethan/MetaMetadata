.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot9gkSz59scQ7kNvwHi_sBe&_nc_oc=Adqlk4BWlXD8mEafyroQN6qpMk7tzF9u2-R7Yr5d5t9OnwG6iS9x9hHIDjbhalUHvS0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yAwDBTxzbs3q8CQbFbN7xDaFuio-iDxyzE_tCdgDXLw&oe=69E239AC"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VnxrpM7KoQ7kNvwH-J6-u&_nc_oc=AdqEvZeQ0PZGzZ44lH7Ucsiww4wgYGf5tdIBAZm1Z_2eI5wHGJQR0-wvVlgvUszJ5q0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18zjthr7kJkeaRrrLkGtrmXDs9_xVIqy_IUcLZPqc6vg&oe=69E21FAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcC4DiXAms8Q7kNvwHQMqHn&_nc_oc=AdrkNfIS1N1LIxmvODKvFQ6haMyv0KBLB12AEou6vm-0OWdCzMDiWro-2m_ECT4CydU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a-AAccVLFwtsr3CWpBQtM9W-J_ymdN3-YLdgR6Hbtmw&oe=69E2271F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
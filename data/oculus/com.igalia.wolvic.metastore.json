.oculuscdn.com/v/t64.5771-25/491819923_1943416799733210_2823172147282715970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-j6G3lO2h4Q7kNvwGeU4hN&_nc_oc=AdqBGa4EjkHMMUhZLhb4m9fAx2Iu4HEh5wMBy0RfPjDB6wiz2Ra65CmdCLJ8H4Er0mA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OLDgc5jbTZhvskPjasEI08rhbIX1LS8ZNChutF63eQg&oe=6A05D22C"}, {"file_name": "meta05.png", "id": "1749470509333587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820270_1749470512666920_8044662210283263751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmobnmoO1TwQ7kNvwEc_N-j&_nc_oc=AdpxMsNXlG89Os0TgRKglrbHgu-HjcrXOhePMJkpKkvjRCDctS2Yft9z2LOledRNLTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z3p4aC90LojbMMxPkcOm9PhFjHvQ2B1r5zQoxjTGbTw&oe=6A05F06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_landscape.png", "id": "727698835666643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036655_727698838999976_3109522016144474866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deObqjb5rvUQ7kNvwG8L8cC&_nc_oc=Adq56Ja_tbHz21PzMpWQ53zaXVZKLRWT_bRRROHYpaQ85zwfEDA6V4tUDfisybZO3L4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wUbRRhtDpNeHYJvKPGYNnqsaQe7TQI9Ihh5M4wJC8OA&oe=6A05BF9F"}, "display_name": "Wolvic", "keywords": ["Web", "XR", "Productivity", "Browser", "OpenSource"], "long_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and applications to the world of XR, and enables rich immersive WebXR experiences on the web itself. With interfaces and interaction support designed for immersive headsets, Wolvic brings you the best of both the web and XR.  \n\nInitially developed by Mozilla as Firefox Reality, the project was taken over by Igalia and has become known as Wolvic.  ", "short_description": "Wolvic is a secure, open source, and accessible web browser that brings all of the web\u2019s vast information and
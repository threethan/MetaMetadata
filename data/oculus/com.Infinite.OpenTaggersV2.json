2_1343942360203178_6984919727893603608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8_zQsVcNUUQ7kNvwHNvNUt&_nc_oc=AdoQShsuClJy0Fy0IfIHjq5eCBxJ5qr25sihMktznJawZ8dVpCzv1wwzhh97VOAuLe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0VaedYKnIEU5hs5kIU6trZBixyGbK81LZy_Ts6JNDUg&oe=6B01CEB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open Taggers V2", "keywords": [], "long_description": "In Open Taggers V2, movement is a key feature: players use their hands to push off surfaces and climb, simulating natural gorilla locomotion. The game's emphasis on physical activity and dexterity creates a highly engaging experience, combining strategy, speed, and social interaction. With its playful aesthetic and fun, competitive gameplay, Open Taggers V2 offers an unforgettable VR adventure where every match is a test of agility and quick thinking.", "short_description": "A Fun Monkey Game With A Cool Map And Fun Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YkuKez9tDPLiXSZIzCtTpiRkFOs86Siu5Sf97QGnUlQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "InfiniteLists", "support_website_url": null, "website_url": "https://sites.google.com/view/talkingbenstudios/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
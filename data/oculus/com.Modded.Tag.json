content-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4VH9LCt5Ikw-B2XJ1DXV6aFb5CDwqiNu13xNyjqCKug&oe=6AB5204E"}, {"file_name": "screenshot2.png", "id": "2660245627694123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_2660245631027456_4006396215182725065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wPfLVCkbYsQ7kNvwFMdwjF&_nc_oc=AdoksOI700E2qeDZPGQr_MSqmPtPqe5kod7K7UTJfgDZQtIKg2ynCvo8Y7X4K6ZPFqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUoJ26rKIv81YmqMQsbdq_aqdE40TqTvYeydhstOku8w&oe=6AB54CBE"}, {"file_name": "screenshot4.png", "id": "1436475950781014", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821714_1436475957447680_6328623682678720022_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuiQ0YTl5pcQ7kNvwG67z2t&_nc_oc=AdqFZikmA4p_irBnu_z1rEaquINCJDZON3eqYpTLOkai57aO-NsSf2p0fFVbCPxbtKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJNGzmWqAdZk8FegCIWt1D8ySXKyr_E4TQK6jcoPcdWA&oe=6AB527F1"}, {"file_name": "screenshot5.png", "id": "2327863561016263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_2327863567682929_3115774888399151271_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iacbB5COsWYQ7kNvwFN7P4n&_nc_oc=AdrJm0-PNH0ocIlvtJtDspRc_l1lJ9LT8_yOrESJrhai1Qj4gbWQ3UViIuKfqlJpxEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJaGxM0JHZNmpLkWQ96fWDBv2ppadUM_jMtiKNqvPPUA&oe=6AB53C01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modded Tag", "keywords": [], "long_description": "A high-energy multiplayer VR experience built entirely around physical movement and player creativity. Instead of using traditional buttons or joysticks to move, players propel themselves using only their arms\u2014pushing off surfaces, swinging through the air, climbing walls, and launching across wide open maps. The result is a fast, skill-based movement system that feels both simple to learn and challenging to master.\n\nMatches are centered around classic playground-style tag, but the mechanics transform it into an intense test of speed, awareness, and strategy. Whether you're evading pursuers by scaling towering structures, juking around obstacles, or coordinating with teammates to corner opponents, every round feels unpredictable and full of energy.", "short_description": "A fast-paced multiplayer VR experience where players move using only their arms to run, jump, and climb through open environments. With simple mechanics and energetic movement, it turns tag into a chaotic and hilarious test of speed, skill, and strategy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1xN5OUBEK7K-NEcq2qtbOpJfQZiGf3UoMc51_4JCP1U8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "kai", "support_website_url": null, "website_url": "https://docs.google.com/document/d/16T9iCCbRGNAlKq4bO5aMgad_Ec19yKIwwFQdK_I3o2c/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "34457641587182789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_1606598290627799_2157068055874634456_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiotlfyXBs8Q7kNvwEyXLZU&_nc_oc=AdpZmQmqZuSg79RrdfzvHA38MIkj6SKP5x
bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fQRzoPZlQcQ7kNvwF0bQwj&_nc_oc=Adp1M2PAB2xWjwQ9KQKWtDwsAiCI4-keSl6LELAkFzBPZ3tR4DYGM1zNtntPD-hfydQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpAwkzIcLeQfJvVMbS4I_gIONxpHQlUJsyUd5XjeK46w&oe=6B01EB41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modded Tag", "keywords": [], "long_description": "A high-energy multiplayer VR experience built entirely around physical movement and player creativity. Instead of using traditional buttons or joysticks to move, players propel themselves using only their arms\u2014pushing off surfaces, swinging through the air, climbing walls, and launching across wide open maps. The result is a fast, skill-based movement system that feels both simple to learn and challenging to master.\n\nMatches are centered around classic playground-style tag, but the mechanics transform it into an intense test of speed, awareness, and strategy. Whether you're evading pursuers by scaling towering structures, juking around obstacles, or coordinating with teammates to corner opponents, every round feels unpredictable and full of energy.", "short_description": "A fast-paced multiplayer VR experience where players move using only their arms to run, jump, and climb through open environments. With simple mechanics and energetic movement, it turns tag into a chaotic and hilarious test of speed, skill, and strategy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1xN5OUBEK7K-NEcq2qtbOpJfQZiGf3UoMc51_4JCP1U8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "kai", "support_website_url": null, "website_url": "https://docs.google.com/document/d/16T9iCCbRGNAlKq4bO5aMgad_Ec19yKIwwFQdK_I3o2c/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
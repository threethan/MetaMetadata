z3d2Y1CbGpjq7aGIybdJ9YuUqjU4C4j8i--geNieO6jpo2k-e01LjTe_wcdm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADIe6u_BzpqhY7bwy8OrIKIoV38fKlmQ8SYu1LTS6gHw&oe=6A53AAA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmHxRmgftdgQ7kNvwH6ujp7&_nc_oc=AdrwLpGUxQvYjzfnXUtSECfOnfrX1tc6DACJh_0kn5-h0rHnb0hvkujocEaeoKlHS3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlJt6ShYBl1dz_Q4g8miWA-q-ZFDq0KMBMLUW4BZ-exA&oe=6A538D6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o5OoTtrA5IQ7kNvwF5-mLR&_nc_oc=AdpIrhgL7Rg7uE-UeIaQQPzncA9ukeBUlaOJwR2hg1bScFjC_SoyvBxd1BXUALsUZjU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_ZvkObECURdV5E4P--VedyLCmD9DyqfcaMkxruj1hQw&oe=6A5395C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbUVmION7zEQ7kNvwEvC2Xx&_nc_oc=AdqwD-qbhuML0_pKlHt4863N7dGuznrJJMqeC3dnSDFTbnAsUH9wijnbxjmUGHU9j3A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4gr_1fMvMIUVB1f8GigxvLb5mjq6TvdSoFnMVVV157Q&oe=6A5390C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZl0f6et-sIQ7kNvwEbNs3Z&_nc_oc=Adq2NDhusKSBaBlbGsUd4ts8iPjCE6cojZ-jEov0omaSLWUvEiJZSYEWJgZQm8ITgj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7N2HpbxkEwNFjNqRBc55I7VJVrxppOC-Jn318ldqTjA&oe=6A538AF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com
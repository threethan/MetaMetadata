tR3HFOv7g6S65er18expzVKF1H8uM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3c1HquvSnutDAb-RmKmX7OUE1Z-GzGAA7v5hWT_A1eA&oe=69BFCA65"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYJy--VLJL4Q7kNvwEMwx9-&_nc_oc=AdmNAJzyowY2Cd4AX64nMmglmR0jYUEbiayG90lZ8XYhnzybl9wb7haazTIkArLHa5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzzaz8Jz9fn8RmoDKVvzZRS8vqLnROWZt6mg3p2CruODQ&oe=69BFE56E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-ThZTtZXOMQ7kNvwGF3qHZ&_nc_oc=AdmyvtFT7l9_ofI0FwqjLRCyRW9jlHeuNz3w0EhNj62SNSCdgCENtnAska1_wJUQqvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQeZSuCOkGfPa9kAfePooJpKO1CHO7v8TexxDrmXDPMw&oe=69BFEDC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImUYaMLuBzgQ7kNvwEc93Fv&_nc_oc=AdnXNQ-y34OXoH6SLJIfoNAMxF2ry2KaS01hFkM8GjuLmRsh6UYLFno8Z31m17DnizU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1g5A3j-jtjCwKPRZUcFe4w_GlNKLzwJLFtzoqFEAFyQ&oe=69BFE8C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpotbQexNxEQ7kNvwEmYy0s&_nc_oc=AdlVvfCgwwQsg_eXgR1hMWUKAcnKaNLs7yRKJixU9_XHT9rBR8EBmO2BlISAwCziE7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxsgzCF5Riyk7gyEJ57EmuHacI1wsNyJGDYE4izoxTtQ&oe=69BFE2F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
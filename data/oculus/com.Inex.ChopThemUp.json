7233557214551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031412_1437233560547884_5895315923405567287_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgZfeqLJs5sQ7kNvwFzCkw2&_nc_oc=AdrcrZE2L8P--PqR9yMbCGyAggnB9BFusSKzIXUayEN6q8oIBUr1JzmrydxpFB6Uock&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRApBYZKrvcv7OdK4OMrCmTGfW5ukNeVb2a4i1Ktc0FMA&oe=6AFDBC25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_HDt1ANVLgQ7kNvwGeLCuZ&_nc_oc=Adr_an4Iez8XaCpusIDlsEeLkqthrmO0yy2C-Ai3UdYB4YHBIaUZs9UlLFiqxQZO2is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuNgc_wuWHgRMGw0qRtScOnUziM5kCi2ejCpuXEgmwuQ&oe=6AFDD72E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6DuPZNLQ_oQ7kNvwEtLfce&_nc_oc=AdqhYscbw2KdeevRMM8SoH5TDzpvZsEvxeVW_cnEC6FQTTo6RfmxZYjToskD0F7DkXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL9u2gmTjiayPrvlLKcQ-aFo00BrBZkyCeOqysQEmKtw&oe=6AFDDF88"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCjEOD4NS54Q7kNvwErImww&_nc_oc=AdqmlmiMVRCkFNqQsL-i9cKBRPTTi4XTJEqWtJwVY4Ng4kKzImlWKqZ7EbZZ2tzNiqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuDQMbylcki7CBNP7CEWFp9nslZ-Mktto9dfYYAeS_6w&oe=6AFDDA88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puEnctrgY54Q7kNvwFYfuno&_nc_oc=AdqaqAacNIe_wKo-HnNmcA12jT1jMcdN4zwpJA67yJ_mPtaGOcy2h6n6KMkAJnZhRPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeab7hMMI751LJKL3OCil5ElaOxSkxAYQcvD-ws7A1YQ&oe=6AFDD4B8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
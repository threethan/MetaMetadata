5XYIXyx35CPbdvip1TFynQG2d3ox33cpcK0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX4BnEF99H4P4_3IFom8YcwOa6sCrELkf3Bmb-O81Zjg&oe=69AAB265"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dw-Fh_eemoQ7kNvwFvUTpV&_nc_oc=Adkj9cECqp3L4worZYEgMqQlG5zkRF7wt2Un6djl9rOoLXCQHeeAKu1BoG_KU3P1NCM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLXnIRvd4xlF0z6w_uU4-huuqKsFbujN2jqZfD4xIwbg&oe=69AACD6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXAc_Gp2_6cQ7kNvwFBVULZ&_nc_oc=AdkJ4QoC6JD6Dq_ZyCtGtdz12cM4TF27GdSYsbtH14hC63rZPH53boansjDwwRwCeY4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpj7Gh18prb4v1JHJ4iNFGOoydB5pcVEX-YOSI-4J1Nw&oe=69AAD5C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7h3TAG6Xx7YQ7kNvwGXCqGk&_nc_oc=AdkSedPNcKMN93--4hznJNEyaUwTrfg25uzY4OCJBhPazALkcQAp_XzLhAoLNk_j2-A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCuv4nyCyOiZ3OeWnIYB9J0nMZOfFhV5fTgtoejdRafQ&oe=69AAD0C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iePeBrMQEzAQ7kNvwFkfeWE&_nc_oc=AdnXuWV689pMHm5424a-NKNSfnTZ6vflN7cDdOmqBNJg-k1MrmeTYD31R7n6JFy3kEU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzk-AqSG94EQ6gQLbrsUc0qgYFY__t9m5KJqsay0wQu1A&oe=69AACAF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5
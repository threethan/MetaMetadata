GmLx8DDXrG1FJOPHAUtKHrz3LxqgKpaUYqdtMNKz5zaV3zlaz5o4FEW36tOsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lhmth6EELwsn4kDbk7io0aFChuz0i58a6UCO8EjOf2g&oe=6A355825"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr5VysGaqNQQ7kNvwETUR7g&_nc_oc=AdqYdB19TJP42vFK31z_Bh1KWR_OM_9iTb2G0Ea66XOkJXxG8O_wUqCE30eLY02UYPI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OQbLagy8PYb2Izv9wr9tHDcb76df15ySjMYuH8jG9_Q&oe=6A35732E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obp_36u-0-8Q7kNvwGjxr8x&_nc_oc=Adod_dEuHtYDY3Bib9qItc8dxJnyFk1Q-80bR6VDeGrgeQQpq1GpO7k7-jbgOcgYMoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R1l3Ovna6zOLpflBVI0g92KhQOz3V6vt70XLBSoHb-Q&oe=6A354348"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rxvImNMshoQ7kNvwGESNOt&_nc_oc=Adqx3-Rgtsc1UN1SWbrNsM2NKOEVVwG-ESGVb0Wh3ahEo5ktCuDpFdv4cmagu1OS2E0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9txUCwIDorKNXl7rMNFehNOERw0mbgjmFkkAiYudNPJw&oe=6A353E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK-ptBiwOXkQ7kNvwGvfsxs&_nc_oc=Adoh9TLzHURQrr67WpG_26FUQCRtsTou1EsgMyowYjNDuxIS0lzCc_6LdE6t2DzWGn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8fDHi1iCnb-L2LNqxxN8eMMSXLypYe_nE1YY-dbyHdA&oe=6A3570B8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com
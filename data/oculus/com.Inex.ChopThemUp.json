tEj5cW_j3Z9uaFCC1jHT_902QEiOHQ5Qbj9J68DKm6E5Z0DWOy5zF9Vz6v3gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ObxqFlhXpb_4i3xDtdGsinsfMbejOZ3wV8o1M6OTsPA&oe=69FA04A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoB8ug-nwZ4Q7kNvwEJwwmq&_nc_oc=AdqhA55eoE6hEhdgkg39LaWZJEqLaHE718-t4eTwcbtrlDWbNOcQVV67kvgeU_MhXY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LtoPlzJN1yl1XUp6eapn_Iq8QXhxbsyAYDBQ2GF8ivw&oe=69F9E76E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYpb-7Njkj4Q7kNvwE9XKsg&_nc_oc=AdrVpUvfUKEda6DELCiYaxhPAE2sIS4snlO6u_kn2zXu8IAQe40bLVrV1tZR5zhfi24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q0D6-QpacZUqnc8MSM2awrd-GnvYbW-HM4CztGnkcwQ&oe=69F9EFC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcIxZQxuVNsQ7kNvwH7x1OM&_nc_oc=AdoiV-3CijSykABTrZ2cJEOA1q5OqyFmHCexEpONacC4R_tzPEmLsBtxfpsFwR59Dm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77p_5Wf5SaHtA9IV68ofjvzC1uWhksF_4UGhHQmQS9UA&oe=69F9EAC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk9IbYY96IUQ7kNvwGvA8Sr&_nc_oc=Adq3PREvrth3cujLxrw6vlI8PvehbPrx1IjmB2kbDOklVbdhccS-85FhhrgWdDkQtU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zC8l6tXtkSglmyVbuQviVNUNdzy8mhDTe2o4SKzNbgw&oe=69F9E4F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com
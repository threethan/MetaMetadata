opoSxiuwIRzgRJAvNUbgYUaBxGGw1w4TIMqZELd5rBtJghxNvNACwKZlx_z70&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK5iTLXUz4pG87qub18pwQ3bvbwNffK1w9kSRUnrIhMw&oe=6A940BE5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rto-Mr_OPwEQ7kNvwGvU9Dr&_nc_oc=AdqNdrIlgpNHSpQhDecHpCDKDwXnEee8MLUd1xv5NtemJBDDCAPyiTPau9wmP9Hmqr8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6JKtnl2nbatmOCnLtv-bOlEPn2VagrcCHFvpkFVfWLg&oe=6A9426EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKLjykpL3TQQ7kNvwEq_FaE&_nc_oc=AdpiHXAQ8l77YGwcpCUIGnPc3EqGWjbA7SvqOLtVaSantZSpAtSYb9gS5PDKY3lTAn4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjTutKpFqsv-A68gDZAEw3p_q1_k-X4MweP1w32tpa3Q&oe=6A942F48"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kukyb0h024Q7kNvwGGwtIS&_nc_oc=AdoMh1X7uipbtiTVJVrFS7DTOq6jLQJ0wHK3ADNd2hu9RpSaS_5zCDzIhFFrIdPaC2Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9xWKmR6F3j48enpi4yNJSRoRqLAqXh2LXfj3Am71MrA&oe=6A942A48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqyU5HBPlnsQ7kNvwGd4w2O&_nc_oc=Adq5-8Y1gizkYEoeRrd_rR_V0ahNpPL8INUQkgmebpVQcdi_hbQiYr_fvI7C1Nr8ZNw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8FMa0yz5t60eFjoMdDmJemzVsrJKZDIYsV6N2TnozBw&oe=6A942478"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com
_R3KHIqp-PpmyfH1U0U3TOgZ4Ol_Fq-eFKV4XiRfYWRUpkbjhwL3Zm6f5Tvk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7ixy77o6plFgj2ZNW2PHaE5LQACQMzu7Gbx-QlKxf4A&oe=6A79E625"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0lPyKjiySYQ7kNvwE7a2hy&_nc_oc=AdqSfupkuXKHRkbZe7PHarxn4NhwMflrnMcS4lA2_Egh0S60WsFPoM6kwtIBl6CAXfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPpZdkZBY7zfje07nYanBlvlrH2kgKMPvB-vdXkjQxgg&oe=6A79C8EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD0MB4iT8jUQ7kNvwHV-cZN&_nc_oc=AdrxJ89eeA6OuUxd1vyR21_UyLT_PEHgyDvlw2OyrJwbQVFAMji3Vi62u3_rN0VJW3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEINTfl8Si347sTkvH3s8F9KA1iph51z5C7NaG8O13_5A&oe=6A79D148"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLxEsGJNKUQQ7kNvwEUR3-Y&_nc_oc=AdqiTOh0WZEsbTqm_mez6PMY2l_hZEF47w5i6To83QBJSi4-loIrpVC-3AGE6ZKGqhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6eqdZs97IqDbJBCRPO68mJ4ENfYBSoRKExiILjEyoXQ&oe=6A79CC48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v98rEzSG0QQQ7kNvwG4Ei4E&_nc_oc=AdpQwfkD5rViH7gFpj4y8fl430RWezm4y7J7tZUXj511851C5807zPuPZRMnKQCt_Dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqmPI2eGDKLbncjl-qNP7yLogIDWgOKWN_e3HdY6cRCw&oe=6A79C678"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com
wO2MPN6-NmQCfu9PCMCtuUb0XAUI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-zniDChrSiEB_NJBUuAejFyzAYoVqjantRCj_RaZzpg&oe=69B29B65"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwnKFNIOTtUQ7kNvwEhvV8F&_nc_oc=AdlcNeQFF4WPY0JbAMR0GjSwh6SONXKutDUF76-D6wjzo68Q2XAKgEJiwXa8SOT7Cf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVWw1mDh8vJ_aLa3goEOuyRKrXqbhh4DjoKKcqKED-sg&oe=69B2B66E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkFHcfslhRsQ7kNvwHvTYtv&_nc_oc=AdmHiE6Fwg58A2e1mSQs_aoOj93LKL8sNlXXsouQqq__QPnhZsGNFp6NTI1BUyoWerY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy49BOU9ELOHiF7CWAd467M275CPzs5S3UrBmWz5Cl39Q&oe=69B2BEC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKOtjZ5EB7IQ7kNvwHtml7e&_nc_oc=AdnB23djDQyzf8j5bl-m3AAK9VY7plJjrL8ameY0Y0Y2gmd2sGvgvgqioTiNS9H5SBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwraeNQTiwqLpcTMttBfG6A02G0VOFoAYf-xpPJ3MmcsQ&oe=69B2B9C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO9FBZQk4KgQ7kNvwHkQpoM&_nc_oc=AdlB024N2C_toY6eMGrg7FSuTPl9M6yV9buHN-jb3RZIOuUlUFnUbuhF5Fn6dH9Mw0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqOUBabloPsSLUagrIH1YrlyCzUu4OeCfeqrsaw6jyoA&oe=69B2B3F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
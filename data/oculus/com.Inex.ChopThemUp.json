6xTkWKjN9AcO5IRcFAlS4JpsTew01E7JmBchysDeFIxlJDQVwUKSemJMmw9mE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OYxqJ15gHDbOHEXm54GEsjcfPzdTtpBP8Q168GUi6Iw&oe=6A3A9E25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9p9JI5dG5kQ7kNvwGmYcuR&_nc_oc=Adq-GbVws1Q3Y1CPBhd6vpilYJ8PZwBfegIkwgnlr8Ui_k0bavRg2WVx-9_ZcS4PqhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rclgFCDbMq5r-gTtJCFTjbhThRs2kGGBhpDF5SBRkzQ&oe=6A3AB92E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDPb8dhsoIcQ7kNvwHbLGQr&_nc_oc=AdpKKsjwWCNxQQya3MR5aSoE-dQ2cVzKlsPjcB9k82bMKlsmLfSoGWDdjCT4TrDRazI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ENU12aFnD-JPDbmcZHA9ZXZsIOZJSV9HLWMa_hbnQpA&oe=6A3A8948"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_09VMF0-UbUQ7kNvwGDiZk1&_nc_oc=AdpmpC9sYq5AZZrn_Ef2Rsz9deSYkejG90n5FypaBLOXKVnTB3bBBdRKqrFcj2JwjNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K2Nt_MQxHW55QiYVX0qxr4OggNA8XpE8E-9wzDhpYcQ&oe=6A3A8448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX5-fLULl_4Q7kNvwH8LY3m&_nc_oc=AdruW3TkNFNJiKq-aiYk9rdRBQTgRLmBXByPffav6J7kB4UUKr1ZY-_Cas5Zh6W8Jnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-njaySCG6u-nWXOMZ4UTvCUkTbGPIoLQ-3LeECvsORSg&oe=6A3AB6B8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com
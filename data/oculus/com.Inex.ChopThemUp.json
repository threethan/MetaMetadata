jNe-sGVgJTt9KI5INKcVqogxj_YiGGEZj_aRcya7aSCWbqRu7cLFHabp4rx_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0auSb29ApQe8DLm2SROCSiraWx-yS1PTaa9ItLqkryOQ&oe=69D90F25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0HWqEhkR_wQ7kNvwEwfDRJ&_nc_oc=AdqOdPWez4bLT2E5uoVnszc-R7Da3_Hk6IrIKM32fKS2KNmDV4PVmDmK8pM6HvK07ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P8IZHosNGNyLIc8RyJcYEsRAuPMejlLBCJ8WkEukteQ&oe=69D8F1EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIDrV3_KuBwQ7kNvwF0dNqb&_nc_oc=AdoRKB-4BlP45X6HU_yOszf4ObPzlu39j9axBEN-DIVgb-iVA3COEn7kYmwJXKGmh7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cwSbMjtFDq4pduy3SVcb5PKCy5SY53ODs6AsI1ZQm6w&oe=69D8FA48"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWOnWB1dW10Q7kNvwG6DG9c&_nc_oc=AdpSpqveq4I-r-ir8xGpQe7RqeZgpMiKrPEewacN9UoDgnbGZ_57pKq4eGFwhe3ACFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RCuXocJmxXCn0TQ-Zpx1eDRIHb99yTjokzCCX6uWsAA&oe=69D8F548"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83kdMJJbgHoQ7kNvwHDy1Yc&_nc_oc=Adr0dDraNTHl9BQIKcAhHIiQisAA7Af6osrUcFdH_UPjbg9HcfF8_8ctGe2y0WCeqQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dpvDAH3YFdIVqnC6gW4nnbrUZ7387GLssR7k____o3A&oe=69D8EF78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com
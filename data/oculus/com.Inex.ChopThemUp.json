Hr6pLrD1ejc8lZMbVB_36UZTmr327Tocfs8-1sLRwWuawPnP-7xHBvFtpzAkE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkfctzSAjPg6ya43Jzh19SaSkTGyeDaNyUXwYINndoFg&oe=6A86DCE5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kBPcCbXNSMQ7kNvwHicrc0&_nc_oc=Adq-YJP2Jm-5NphteWTIrnobfVuExiSFjaWgCyuB7uFQny_aEDWwgsJYMMQ6ZBwWLv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE5B8gUTCdVre_ahbeuem_RA4h01DxyQfsqwDsjph4Pg&oe=6A86F7EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEygW8E0MDQQ7kNvwGRX7Ud&_nc_oc=AdqvEzGWUsBtUkgkinO1iruTVO4ke52iQaYMPdJXt4c-CA8Pe2SUyI-phNv3HuA_Qt4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq5Fa4SH9kXe63CZfRFDxq8y7ArTq7lD5mtfk7q9NcKA&oe=6A870048"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7aRaY8gILYQ7kNvwGjBrDg&_nc_oc=Adpgd6dEq4Aq2Dfk-b31mOM2_IF3dZ6ufUa3jQoE4neYx6pujLNzwMicnhV7rZvPAzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiL8yodO7ugA8lyK28syeYvrdwVOa_U5D5LBG8jBRsOA&oe=6A86FB48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duZHavYeeTMQ7kNvwHpfNWo&_nc_oc=Ado52OfwaHqIxkbrQdhF8JOq2KtWQXQUrAibCz4E9_rDttoYNVqTrHM88kW8YwRTsDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFroglId7t9Z0HIr63Xwwqe1QaZxCZEgk8AGgW1r0dh5A&oe=6A86F578"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com
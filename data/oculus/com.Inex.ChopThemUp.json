wbGWIC6wWWuddmfJgKp5_dDSYz89HZQSYRVrCLw-JbG89gTcrbt8GPW0XdVzs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnS7JZIP2og0BGXX0xVghNq2pJbgDbgZEiwaI-CJ5mxQ&oe=6AC50BA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cjIgYY_nvYQ7kNvwHQTbm5&_nc_oc=AdrDqXC2Et4zgaxIBqe8I6E1AWXR8JXw1KCm3iMp8vQv1e_F0we6IlKWF5wWfz5WSRk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpXQSP-k6wEY1WDGh4Zj5bXd4YAf3SoPOQtXlraNbvdg&oe=6AC526AE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLnJAYGZwlcQ7kNvwGbBH3a&_nc_oc=AdqzMQxCAKOBa5J8FlIeijGPg7IiJKvJ37NtNIzl77Q-uIQCOXe6jdAvJ_SLNSVhigM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJxHMbn0ZdVSXl2uJZphg0zt_8IHZFVxDgv2vCLnNGzA&oe=6AC4F6C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwfubFkV49YQ7kNvwGtzf-c&_nc_oc=Adpcb8wQCDDVJbjqdaWzT3ZdD2L0oixKBV0aC9-hDcXYQu-KWpIXPyV0j1TJrjSwTYs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOAjxuMWxuejHq4RpbRREIRZh7ZfVl6qS6jk5y9rhFMQ&oe=6AC52A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uNsqNT02XoQ7kNvwF8vwCv&_nc_oc=Adpj1Tw2WtVRsJOgY84QHzrqQ62D8RZiEH2Ms-2x4VKuFrRTwGMWq3bSwnvaagPJoO0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT1kL9d-TyU6rBLwtHa7jDJUQcOqfvAcVTKw4xrB9zfg&oe=6AC52438"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com
tOteWCAYVvXnWh2TUZlhMZPZ6SXmK4vj078NDtjZ2-PvFU8u3qAawBQzLcmD8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMc2vH9tzgxjKXQZH2C2nnkm7vMnBsiAfvVTki0-n7kw&oe=6A882E65"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaCAOhAKk8IQ7kNvwGMhxl-&_nc_oc=Adrzm4v7tGehcvsxQU2Sd7brgA_lgRfgS5dKj_LTnYwqelKR1uOQwj7esiE0hWDUzuM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWc35cZbRGNSsKYNj8UiGZD1t1ruoxkpIkbgTLEenfpw&oe=6A88496E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEygW8E0MDQQ7kNvwE4zGZs&_nc_oc=AdokZ9s-kPC-m_PLksOrX6dJTSF1dNoxHbbdiEK3kPSkynyWcOAapUr64ERCo4Cgc1k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_98Q1DEawrTABLv-kcgmupvztMgu5OzgU5hRD5NtHgw&oe=6A8851C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7aRaY8gILYQ7kNvwFaetij&_nc_oc=AdpoUONOLatPdAuxhlCCehOl384SmBksz2MebpmvQlR9eDv_z7zGzCvTgCPh8FytPw8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfyXtM0Q9IdLVIjn4mP9PGnSMmbbaalP-9X2_b0XRKlg&oe=6A884CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaUaGPCHgaoQ7kNvwHaX-vI&_nc_oc=Adr_jZP4HjlluHObvWl37lWP8676Xb2-WHITBbBKwjIsOCm8EEyC6lz8Fyf408faAcQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH87PjIEWVe4-nUoPH5PO7j196lz7r0aRznXDWuGNDIbw&oe=6A8846F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com
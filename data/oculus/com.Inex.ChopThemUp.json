xBLGTUuNL9rgL0L9QZ7dysLY6O9gZondKe94GvKe89eB6eSnCKbaXqYc_8j_I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeECAfEcPGIMiOlj5P_sYEfnS7qnwHh53q2yZAZk3H_Q&oe=69C7B365"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umU4wt6q4nMQ7kNvwGrynkZ&_nc_oc=AdpmeUHZL2ONKFYbaXWH7Yw1sBQeywtNFmGeLivUEkRlTlFpqounCHb8tdAHdDCy9Kc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpJ_EFwUHofPv5Crfm2ATWRQVlIP7thy5TkV2QQkiiyw&oe=69C7CE6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TAnJeb-qeUQ7kNvwExkKfM&_nc_oc=AdrGwkUSN_2weXjSMWnd9ldpdCjs6rjVX2rTJdtcyeRStI1iRkZWwiX-OneE7xlrUrM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRn_zwrwbEuebqpXgdkl0KN0aRJ5chobYIgpuq8M07Jg&oe=69C7D6C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MzzZLvAth0Q7kNvwGXNliY&_nc_oc=Ado4ha71oOqMm1iw3Z1aancNC-p0XDuS-8wtpWI9sFI0cpsk_wiEKt8oCy5AcWwA1-I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycT94TB0WKgCTxXcURWfq6sZ7rQ2m09rrvFPL6Pumcdg&oe=69C7D1C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7QzhGDrwjQQ7kNvwFGUmA0&_nc_oc=Adp1kgB_t6uM9xycpp8Z8FdbgDiI-Q0-HX3451XFpKyzFbOBeXAS2h8V4RDHOR0gjqg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGCEhAAfmelN96I4q6uJFHF7c83BNPzHempa8M9VUZfA&oe=69C7CBF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com
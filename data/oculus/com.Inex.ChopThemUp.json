7233557214551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031412_1437233560547884_5895315923405567287_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FT_vY_h47ykQ7kNvwHcwuYB&_nc_oc=AdrHTsUYKwb_hJcf2B2UOjmZeiUev0Dwi671QMAJ3XfmKF3XEsJ3JDYrC3xMy8GLREM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQC7_Hw1umI2UpwiZyp9ewTnJUYGFriPHppI56bc0S5QQ&oe=6B0B2365"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPfdKIXQGQQQ7kNvwG6V-Z_&_nc_oc=AdoNqxy_UqEGQtgm4ljvV9jSnfMWTlzFDnVhZOVxAyEG6ezqJb4W5uddt5I-FVh5Ij0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRJ4snYAEpqdNGWF7QJm-svb_OdxDvZ0Hb6plnAWCfDw&oe=6B0B3E6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wFaXe1r5DAQ7kNvwEdWyP5&_nc_oc=AdqLtEwAL1jephe96lIS9ozJQgaJyGJLPf6FSJJKDVMcF9eTO-tCu0NKQQW6EzQ4P0g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRz1RHc_z8G-7qOK7Api-udI628sxBi8Ue7r9heTCPy3Q&oe=6B0B0E88"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpvCSenc-mcQ7kNvwFhvdGT&_nc_oc=AdobWfaOXocgSbp7XVJkRPyHTyjY8041j8UARhdQjA3V888XamEMYXaaqF3TCZhhs-0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrUAvaljliWggLQkDIzzCv9VYq0m6ahlxXhKweuFsqYA&oe=6B0B41C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLZyLbKx_CgQ7kNvwELj_x6&_nc_oc=AdqP4hgvk-M9z_qYanCYe29CQ1qUxazGX3GOEq6dxyg5IkLHxynqj9EbNE26H-UqZqc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4-m2as_tDW7NXmFc7vx80BB4wTDbGEiUFOLv6vVFODw&oe=6B0B3BF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
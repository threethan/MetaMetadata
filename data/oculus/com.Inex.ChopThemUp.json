c0NRwoM4a5ho3bOYyUY9sT4lPC6feWrMdXN-sLUWdE594Y5aLv9pasqHvAW6w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDDA-ofIpY5K5u6gBI9ABc8bFq7u3RL5J0ka6bXVPIuw&oe=6A661FA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ-DsmOCO0MQ7kNvwH4epYx&_nc_oc=AdqkKlPdqYe6prywy_X2ulo7wWflUZ22UIxMJC1oyOLM4SpbSql1-Cv-auFOARnoDQc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqSASEOiVrUol73pc9c59__YVLXHxe8E95KxjE4k22Ow&oe=6A66026E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnALwcOwPZMQ7kNvwEqCjBN&_nc_oc=Adosr4czBwm3MMv0YkGySNP7vSOr-brVlcwYnBRpM2bAXvX_Yf5o1cMGbFdKvPoJSZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1trrYJsLeyxHsHOaFn7GINq1IhHs-pMROSFUyJkCWnw&oe=6A660AC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5Jd-5wpb1UQ7kNvwG7b48s&_nc_oc=AdoyXvCVIq3w5YPKW0dYB7OP3tX9IiIa9LnGPeJt4-VITU-rL-0FBOWAI4tLMl4YEgM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6AA7zRt019Xkq6BcYSMmmUArWwq0BwCqVXHcELuhuLg&oe=6A6605C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx20XYuyxUIQ7kNvwGazw4k&_nc_oc=AdoNlOxI4FgNw-2bNml1GtP5K-GgSLLylJcKKY5PPjPXEiYRkEVvBv2d8dcb67AqU4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpVO-voqKTjKbpXzw75n3B9Oa7VYR4m_705XhRgO64UA&oe=6A65FFF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com
jG5RvpfzCKGL_G3iG_FyevxhKXXePP826ORNfPH2nt_pbqadI1X0of6aExqyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhw2Y9bZwKcGhzqvDK3lcJyroZEb4LrxpBh1hQHOTEzg&oe=6ADF69A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gy8WU0Jl34Q7kNvwGtFoFk&_nc_oc=AdrWgt4liEjo_ypfc0CmnoEsLlGNQGrpG0YzpnOK_etoY_EptS3aBlH-y4mB-W5ZhLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-zcLsr5KHlHNcPuMiXoCmONfAddzJGcQVm_hOzHrfJA&oe=6ADF4C6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEU9bfwp6PUQ7kNvwFM_Aou&_nc_oc=Adqv9niiagD76KEJ3N5atv8M80TD8RyXOnSZOr8JORv3iOB2xFsazOzuHc6jTgy31iU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8V_lJDIqXnKZPbRf5dpX7_PtvyI9VYPLhPs4GlJv3uA&oe=6ADF54C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5yCImuUplQQ7kNvwGsZeJm&_nc_oc=AdodG96AuzBHNOyOshHSFLVJhfUBZaz_47GMY0i1Gcv4kkFVPtoHgIGKjIQazR8lc9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlERjLvQE3YDpXsfsk3HOqVQY9v4ZfNEQLIgF_4rQFZw&oe=6ADF4FC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_2I6MCqTRMQ7kNvwFY82wF&_nc_oc=AdqUxAws0a-SJpvfvT1LW9f_UsYRT4G6HZp6dB06GmF2LUYY6B4vFIid9t-eGITklXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOASmW-ZvxeqAaNChUkx12tjnmQJN96UUB2Qo-9kxwJPQ&oe=6ADF49F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com
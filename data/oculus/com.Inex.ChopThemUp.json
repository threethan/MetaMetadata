nm96_FFYesWo5MOAsu6jxL_Vu0PE046k_xOEcLAiKhMO2YawDNlgDOL2rN42E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfqhD9MMGHMgvry3_dZVm53fS5BE7In2ZLlZC392PODQ&oe=6A71FD25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVwbQMOTaRgQ7kNvwGdBTo7&_nc_oc=Adrq7DjKkhiEup8IKJ9veJMFXvTjTqgUQL6IPCZrsGdhDtRtUBeLw9mLv-klGwvP27U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDxUlo-jD9GTwsAyjED9-LXdh_zmtR3UC_jEZFK34EMA&oe=6A71DFEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ienfZLqU5MQ7kNvwGwFHpl&_nc_oc=AdrH7ygW5AU8KbBu1O4U0R1r1vMVbz7q5zFW0Jv3DJwlchA6s6tB4CYrdd8iSTwrQrY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvKERvupvBQJp290JMiaHFDT-8HuwFleq0-lgCmTe_xw&oe=6A71E848"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZQf2CH6QKEQ7kNvwGx51ER&_nc_oc=AdrUna6-aeUK-yLrFWN1RZ5Zy7IMCPUbj6mjpgaXIeS16h-cI3fDRkEk9LL4sccwu3s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMoZ1Fy8Qtyzy2mwgWxpWIFhFI-xDtwPNZE2-XQq2Tjw&oe=6A71E348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOkwiYvk1koQ7kNvwEeOxdP&_nc_oc=AdpzO3J5nTCoOyRKEsNYnB1bdPqtPOe7QlicqKwiFFEVmzY4zqPXpShvM41eBe3i4VA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7Sfh2utb8DitSV_T8sHhbaDzgguMhs04NNeaQHLxJiA&oe=6A71DD78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com
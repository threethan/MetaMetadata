RTddFQx_6H-mvnFsexKtcH2zeOL7roJaAH8hEcnv6Nn5sjf2ndbMr9mqnKYOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA_Xi9R_047Iee5GDx4NC9GAJnsbLnwlvdvdcRwjB0Hw&oe=6A7C50E5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtvDiWc4VaAQ7kNvwFg2VVX&_nc_oc=AdpQEbIm0SWbem7pcqqT8UNjVVUIyJ9GGVBrScrAT_6fpPClJ7J-01rI3NipImOqvXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQQEH7amfFwP3DApO1gkw2I14UN5cZzMlRmzSyp_z6rg&oe=6A7C6BEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P1v8yO8fCgQ7kNvwG1kKPG&_nc_oc=Adp6ERfD9i3jHh7URUGcygUTP5VCN8S0un658dht3MACGBwhyGuD0B7yd5vCs-Y4Dy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0ogrrCl-CWsGlc5RQ8Wu0zBepqa-74aNvyQGcrl9ndQ&oe=6A7C7448"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0q_31Fz5hEQ7kNvwEegiP4&_nc_oc=AdrTGF7k0GDHgMwCdbNKv_aNdDUG32lufXQse0bvntYMVOpbMj7D4hVuhhvghJ_fM6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXMUQ3_XmVLh7kOoteSoRE9sC5sRS9p4NNFO0BRTmbQw&oe=6A7C6F48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vVOEbkHHFAQ7kNvwH2idNJ&_nc_oc=Adoi0qQ0P--stmDloTjkeU90xGhEhVdZlpdtHjH9BGLh_nQFaLd0fiDHLZTsIaFpGHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSutz92hisDaCHNa7Fhm3w9NHgQK0YpaKPCWuWNLWDPg&oe=6A7C6978"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com
Oj6ia7bgQgqmSkFBQTEvSNalrB-g1PVQkUkDwVzMfzkJII_OAeHwEHRU8gk8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28ENRV0N3Gukd4hiKyVF-fuLHfXmFJfi1yoCZIa8T7zQ&oe=69D277A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry-elrxblWIQ7kNvwG2k7OP&_nc_oc=Adr-RGPbaMZsSREQJX-8Nv5Vzg2GnIg2LvzxCnYIHKRv_Q4Vf6Tby6fqczU2asLhLt0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ReDAvYs5LMQwRxBjo-mFv0oR5fwGlaZ_XqN1vToSBLw&oe=69D25A6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j1TxLrlSy4Q7kNvwEqQ-Zz&_nc_oc=AdpqLY-fmTOBhAVl-98k_FTQtar24LDb6g4uh3g7_jEWxnCK6GiZZLlCcZs8KEldDvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wTT_90h5U_uhugZWabFnUGk6SW9pbpesbdkecyePrEA&oe=69D262C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNtKFWCPh30Q7kNvwG4phaj&_nc_oc=AdrjkgTUTGthv_P7NEhmczKZeeHg8OASIT-cUXBMsO-zt6rDBrkStS3AiQltpE0LVMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wG29_ywH5hgWEbmoJZenXKlhvuJDajCR1BRC8rk7POA&oe=69D25DC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26mixL4Ld2cQ7kNvwFVwoqw&_nc_oc=AdodXtY_oWsBaEvjHm8BWzfI34sQlYaYUQ5iF6vxoyPGT8nzYBWCwhWb6Z63TT-t5fM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kdOdxel6X5pLGqM5EIUpggZZHRO4Q29KgtYms6aTLuA&oe=69D257F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com
c=Adr03QRvgQoZFiNukzZvkHl5ayOj2pp_lEM40E5C_XsCqNmqgbnszkF4f7gcWgAXTRE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz5Nr_ve5mj0bybY1_QfOyoZzr5xRb4klKCps4py4_3w&oe=6A8EC5E5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HEnyBC482oQ7kNvwGPHAfQ&_nc_oc=Adp2EMpMIQEEYlrkTm9TrPTUZVbdtFW7fUEANNZdXxYOXmYHMJeCdurQpywikdHOmPk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL9gOPSBkQlQdL7Hnd8DHc1hnt4Tt3ezPzzz-oR5dVVw&oe=6A8EE0EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H58rlyLTTu0Q7kNvwEQSzDE&_nc_oc=AdpULMHUg9I2JAA504JY0F5EK0NF5zkjVgHnBiQGcSi-0wlzzxy5BAG2LhcQ-K_NXGA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv9NouRyS7-q5DYQfA1z-aGis2xZWEL8VqqEFaecXnMg&oe=6A8EE948"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMjSZ2rZepwQ7kNvwF7P6wr&_nc_oc=Adra31Th3xWs0G0158kzjHbhuhPeSwPF9facdGYgmcOXym8pnOQvanZqr7MKLy5lds0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGErmjgnupJq4k_q76Ur7HDshiAikbMDhzSqC6p5MUd0A&oe=6A8EE448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOuLs_AJzoMQ7kNvwHisjZI&_nc_oc=AdrXaeKMXEY9TggjNagZdyTxFi29NBVJ2b0i_tTDHOLc3uW1qKOoDXb-pz5qaEy87DQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnj5D4dDlofhXDqhxmLRE6FEFmRKh6XJeWKP_jiTnk2w&oe=6A8EDE78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2
com&oh=00_Af1diISImxoa9abJz5ozYUrvx_9yBA1mcAhSwgfI6_JFBQ&oe=69F0CA25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_cSxrSIjkUQ7kNvwGv8Kk1&_nc_oc=AdpsQ1H7Q06FPhu5HhRbxV4TagEn9E2jeeZ3cgU04-Khe0cxukzi27lmB6P8OAmzPKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2J_K4_Y03-xE7sLu13QNEQKGnbJnz7OtXKq250VZTqoA&oe=69F0ACEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS6PxGutHzgQ7kNvwGnwMwJ&_nc_oc=Adp9_aE7PXpt6KzS4pmiLFiOXyeaihijaOhLcKMEEGXmNPd_FPemB0cyLw4_E1TCk4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Jhr0wd1SC1M82s98AwEaJ_WC3sVtwSpTrddevY0ywFA&oe=69F0B548"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUOFNLS4JP0Q7kNvwHFWw9r&_nc_oc=AdqonfIqQYSIUUwax82JlbGmvAAxXyKy_d5cV8yC466TFZQzRfJuENtL5mRJRHEuD0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Ai5yMbRnesT43px4lvgFIzAALkriBP0N0aI06MKpbog&oe=69F0B048"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JuEbdo-HgQQ7kNvwE7U73D&_nc_oc=AdqCajphP98h0hjRKrgHPc-jdWcDqQm68p1wQeEhz0WY7wfkpP1osTGrsFZPzER_-Gs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1if1fj91tn6LQMi1oBKwiMaNgW0K139RrHKJsE-b0zfQ&oe=69F0AA78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdF54-5iGYYQ7kNvwFOfq-Q&_nc_oc=AdpcT5ko
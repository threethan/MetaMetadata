7233557214551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031412_1437233560547884_5895315923405567287_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w38BTRAfbZkQ7kNvwEg8Wij&_nc_oc=Adp2VZpANqp2DAdjnNKweggeyBWhvNhmTFB3AxYlpwtA-8x1fy0M8EV6Fmv_jPqHuAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk5_s2keDkk2a5ma8scOogKBwf2e6rqveaahEw4gWGSQ&oe=6B05A525"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbFxjwMYwdcQ7kNvwH3k8ur&_nc_oc=Adpa_DMoNrK9AXFdkmsj20sdzIfNVHen3t4AkmAeTa6qTg96h6g3VMwjGr93pdf0-f4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPcDsvnKP8GPRqR0bzyZjgRJHDNWmvRMxtQglqvbcxIw&oe=6B05C02E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHalzoDS8kAQ7kNvwFGNPoL&_nc_oc=AdpXFgskplgK_IaJv95HsUFGAMvt06Mxrb-dl-SrXOmVoabyAbzPDRuVTJH-4MPGB4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJfWZEkk_MhYsCX_7_R74-BJjKynVOc_cycv36LNWg-Q&oe=6B05C888"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GifTw5ds4KUQ7kNvwFpgDF8&_nc_oc=AdpwFMd6x45UIYTdJNSq6fSEvhJRkKS96rM7InegV1OVI3V2lS-87rYq7bKjVOtIuUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3In2Gk2qaQazvg_kPt50e14UatCEEbQEfzKGHCa-Fvg&oe=6B05C388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JV2FukwlQ4Q7kNvwHvHQ-p&_nc_oc=AdrGEiVsFqA4MIxQjFeSR3MUP0-rfJPzSm5PLPt6IN5PtDxvWKf0tIqO1sWQaRntxOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0SndbndVwKwOMRSd2-SEtbgtLhd8dwjfq-dzp0z1h_A&oe=6B05BDB8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
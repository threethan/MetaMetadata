c=AdrRDgJKl44-Y1-iREhsGj14V9j-WDDm7Qdi7BOJJ2UGeAQ_SRWXwPSCxVJL7tfbbkw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVmo4rrCeV5Ce4q3jt5w5KT1xRz_3lqHfRCwn460R3Zg&oe=6A858B65"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kBPcCbXNSMQ7kNvwEgjw4G&_nc_oc=AdrKU3RJx75sXJoeDoJfPPKlRBVOIDoeek9wt9B7StGY9-d99qVMoHdsKD5T3QGcebM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJYq8RgLxGyaJGeQhciH9_RtBzW4YDfgFtiDPVS7KHlA&oe=6A85A66E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWSiUblZRJcQ7kNvwFbl2B3&_nc_oc=AdqbGDJgXIKkQr6fEvZJE7mRpSUQfX8oIGqCrXgzzFGFsofqsdiESBcn2pDig_jzJM4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGuTOqp1_uxNQd9Bdjd9iWlC8EToRhk9LK198ZUV-r7A&oe=6A85AEC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Kar_eO80R0Q7kNvwEjopNb&_nc_oc=AdoR0a9piIlaNxUln-TYsaFKoxRjUUeCpwQjwhw0DEis3YiBl5LG5LljKuTskmwj8L0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4kecskc3NlylH31GaCZhbRxazZp-MPexCe8AzCe0i5w&oe=6A85A9C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duZHavYeeTMQ7kNvwF5JFWr&_nc_oc=Adr0HvRQaza6bPpKpE4Z6KNzYfRyEKeb-zcZx0c0PgTQ1pWPzsx8FnDs1OpW4q0HumU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESFJ9bZbz4XsgqtxTHWszP27w93PHKlUUyYydVrAo46g&oe=6A85A3F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2
II7RkP8cAkiDG-T-Pl9_629hI2tplTvpGxxx0QdX77agNVx-QnW6i0mv2-o5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ppxj7Ij2r487Om1SeK0RRnSNfwUbTwd9M6H3dnPrxUw&oe=69E4ECA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyGz6r0F8R8Q7kNvwEHb_R4&_nc_oc=AdodwLy24kzUqopMnKvoFvAWqTZGn2cYEZ2ADRUx60dtCdU3TNi-ENZ9fbwBka6qaAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33PrhAmBes4JYv76DcBnIBLAGWbZL1fIOywDdDgf-qhg&oe=69E4CF6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW5w7PKvElAQ7kNvwEludUl&_nc_oc=Ado0mUBmebfHq05sFw0u8t4WH3q2WdjE8MXD1VE36m7JvKJxQNLvKcp4oNt7yJYHWwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rTgUW7VB_6SSPeAKFVMp4c2Bbec5kpmP7Q376A2eNaQ&oe=69E4D7C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2urGNCXiGwQ7kNvwEy0nU8&_nc_oc=AdojvTxLl7yGpDOb7119uXlAGNUPjokXweunrr0_p_oqsXzf5sTYNgvzvijpoTVQ18M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X0izfopqHuk6yaFQf3Scx9jpHiAVn1qQcJs9M7UBYbw&oe=69E4D2C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWqlY4Zi6GYQ7kNvwGOMKmy&_nc_oc=AdpXkNTM6oSQbh6_LsekIGgJPDGJG5hyMQJzgZpgV_-LfcrRqMxiLQM-G3Mbh3vSnq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mvqoII04hFFOVZa4WvWjtWDtoH9Vm3uzaSgpgk3x6gA&oe=69E4CCF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com
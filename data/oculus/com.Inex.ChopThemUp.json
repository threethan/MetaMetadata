com&oh=00_AftnbhITLUZBVeGlEPYujLonRsVS8u2uLxy3Pp6UDx0FWA&oe=69A02665"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xixdoFdKoO0Q7kNvwEVX-SO&_nc_oc=AdneOSDCZNuytmNf6mrfg7O8u_6z7Wtpnr7QO6nxxe2bmEFXXkjhEpbQq1TcHAivkpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7muqgDLH3g1fo_lrQLRewCduEU2kQIm8EgZhazNZJBA&oe=69A0416E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNyy2jRqT1UQ7kNvwEdX64c&_nc_oc=AdmhjVacV_7m1KemxhmyjULiYEGHW_Tdb-hYhrq3qKlOMn9ju_tGjURaLkMBmay7Ld4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwQabql_2U871x8uhfLD8haH4F1JvS-5YSRgljjG5kMg&oe=69A049C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fj8JapAjeUQ7kNvwGh7LjG&_nc_oc=AdlScklS1g7OIOTkdgxh056EhUzt6j20UJLn3e9kJEnkHH5KDZXvuggnrwOn0c0L5Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1JvefVQ_-ELSv5DqfDOWJQb4xLOf7wsEjyHJvjLEhFw&oe=69A044C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7daF4SZdRdgQ7kNvwE2VFv9&_nc_oc=Adk_1eZZFD03-E680_0dLclHC0G8Vuk_Hj0TaYZFyNnsZFW1LE3r2OE4y4QaW8TQmBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftW0qYL2p84xtmPkmmv6skOCEOabjfe_YybGW2vm0zZpg&oe=69A03EF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg9s-0dV5QQQ7kNvwHwtrgA&_nc_oc=AdkPigGG
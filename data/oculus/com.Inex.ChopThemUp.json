EFOnVTKzhlPxz6avQBds8EmY0BFXIi4f0uzWI-E253ab7Du8AXtt4OF7a6FLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiAc7GB_D2TXS-0s4iBnRjEBq_TVtv924qYlavCSAakw&oe=6ABD22A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWOIM2Dne2YQ7kNvwHVskQi&_nc_oc=Adqkb2sC0JI39HidNDCOZ2BnwuJ20e2gbfO_4KeLBIb03GfyY3zSN3BOFcQo0k2LAL0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbBB0boI-RkHHbtOtfju4iMuFy2ETUIOlN7zMzqMD28Q&oe=6ABD056E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Pk_RL4sl4Q7kNvwF7NW7k&_nc_oc=AdoiQhjGEQUofld62chJRbp2JfYoVIIJXYTWYtOKSzuIyltFCBSuWPuWukYhbi_bXz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTDxTGZ_lQ3cLTw7u1a8jsiUpZj6emga_Jr9CjVVH7rg&oe=6ABD0DC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0__PuoQ4-IQ7kNvwGhdpLL&_nc_oc=AdoAE_V41v92e526HaMR65v3QUMu5uaBeLDRhHb6II8oOPz2wcrImMSEwm7Q-e3BxkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFOpRvzrMPXDKCQ6rh-OdB0lQmEklmZFDTasr5N81paA&oe=6ABD08C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC3EnmbY_j4Q7kNvwFRG3gl&_nc_oc=AdolBg49Z9gD20knuGeuEHDoqqYy5aYtyjwMcPMQG_RWPmkmgrPNZdUfg9MxmL4MEH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvJL6DJHKPAHfR0_9KfgdBwWXZg3mhRlW5BThm2apYIA&oe=6ABD02F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com
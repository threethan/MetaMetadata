eNF03JVwadH_ZYYnUmrylL511qV7t6stMrw1qu25ynofwQR-fvtF-PMhmPkmg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fIXmUosvKrZ2AsMzmsRKt13EnyGuwTAudeUi0It77uQ&oe=6A0F1CA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP0AHCgk96UQ7kNvwHeizN2&_nc_oc=AdqVM6Qatb1IPjxn05BFt4-bcbvS1o1yHpJ8slN-xolyUrlj2lqrW4vyXwEwtNH7m4M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ltw-agYKyndKLIiskF9lk3DYZimXVja9Cml9Vq4Hyqw&oe=6A0EFF6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En7aDAkbplwQ7kNvwEVItVb&_nc_oc=AdoVBjPpHflCMk-zdMA6XnwR2a2-im8z9n2vjGijxrJOy_QEssSDqcCvF8wdLy9gkkE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BDv8Y4T7zDfP7kPkImd48BjP4z1y0E6EJkfiq6ULAkg&oe=6A0F07C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjQ63rWKCSQQ7kNvwH2QsvC&_nc_oc=AdokDBxvCyvWfePS7XKPhu2cajsB61wbO705atTT5CaU2SySUeXmmySwHL0Ss8ZTT5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jFyyTK1bqpERmpEkRkgxNybcVSGkHYvjuoN1W8I_8JA&oe=6A0F02C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJpb5LDK5yYQ7kNvwF05mzK&_nc_oc=AdowVavQA23v3rdfXOsc3NEfYiCE5At0CCRGABK8GtWmfOeqEeYB9xTEI6SZmGEJ-f4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40oQp5h6Y1oX-s0gGosHeM82cVTNukZWKntf1Bx51xjA&oe=6A0EFCF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com
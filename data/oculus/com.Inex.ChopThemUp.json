c=AdpEt4Crd9Cd1xlgKDvZVSi0Jot59xJQBs3fZkKiG1WZd8X4n9q4HOsHWUIOdXaqpq4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKTrag-rFPF2FFLNdF8mZ07BKFE3Jwx05QeDKTzOh_MA&oe=6A8D7465"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HEnyBC482oQ7kNvwHuJqLF&_nc_oc=AdoXYPnisnMcWEPVM4vbpaeMjUJs1FlEUkUwzEHjnUC4ApFp2uc85k4qJMOW8AOgOjA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoCrpX6dKLANEWwaA_XEg0HpChVspYg_LLan6CsGpmgQ&oe=6A8D8F6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp2NuuFPDkcQ7kNvwHqGTxt&_nc_oc=AdoFiUZ0R3RWPG1JFnj7la-qMcpnaohidmnovfscm5tLcFIN-JXroCBeIj54x67gF6Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8APT5Zh4NuiX26yBmDwxpjx631ioEgYxA5K_YkDHVDg&oe=6A8D97C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGU7f2JbKVQQ7kNvwFUBqCJ&_nc_oc=Adpcu0I0gcD_RV-79yxSRwgr91L58bmetmN6pas1Vt_--aIHR5ywtRvQQmO8HmmQ2XQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoKYKQhEkWn5MDTCIIv43JBs-VQ6bNFUKSROu3_PDt0g&oe=6A8D92C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOuLs_AJzoMQ7kNvwFLgaGP&_nc_oc=AdoSrKBdv-9VPaCknz_FfuUO0sl7p0ne5Ka40kMfQcKBtV8jjJX5dNXfQOKLtiwcpRM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP7KQYAFEfrdygITpCCneF_bGwRPqVVR6s6KaMsVh9_w&oe=6A8D8CF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2
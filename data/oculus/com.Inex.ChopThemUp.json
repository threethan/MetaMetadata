F8C3CmF-m-NIszX9jukKHkNamph1DI1jAT_lCydoKuQoTTPrTE1gbyK4-tzhQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyDt89y_ylD1F72vkXFvViym6fccbAAMWURtY-RiuYPg&oe=6AA567A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVoj7YAW9GMQ7kNvwFYUob_&_nc_oc=AdqjPKjRqPlP0hd13CaOI0vIb1Xy94YxJMX-_OhQAKPUj-isqwc6ZhYDCbbUbDJI6aU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnsppcL9R7SYsb1FRuYteGrlNiyxi80Hv_kCHKxVTVBg&oe=6AA54A6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91Ix4O3bZ5UQ7kNvwFjneFS&_nc_oc=AdrbQol68NU9r_zHcRlM5PdKFb0NJfKDxb_HBUKfYqyQIVMy5ydu110uip82BcUU5rQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeKgZKQJUskf-yuRphFK0qFEZVPtBG9cgxavr1WmYqYw&oe=6AA552C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWmvGzTV7SwQ7kNvwF5IHOV&_nc_oc=AdqBeoywfAOI9zv2LKRxcj0YLbCUczuRJN6mIk_X58SGdeGFOaBLLaRPzIV1EbG0lA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl0fK_YXog2E6aSA8mXEZJAu0tMOLsdn1HF11_Efx4dA&oe=6AA54DC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7bHeXKyaN8Q7kNvwF5ETcI&_nc_oc=AdqlfRQnVDSKr9ozPwrBK-Xx9lvpDzTsF__J9XhKLOspExG-EEZKDXcSj8uac-FXNOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKibHbLKTz6laO5F0LzDX4ljOY3CY9yQmaX0tQRj933LA&oe=6AA547F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com
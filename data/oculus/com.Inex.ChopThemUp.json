rl9qolS6zsz7c3P2O7t7Bpxf-3Lg_01yX8Dm8xrzeLaLSDZeKsW3VMsqVKle0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk-Fr_hMpf2c1s7E8J0JFx3PxL43FGwCHgc3_IbOZZHQ&oe=69D0EDE5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpA-pTxhZOQQ7kNvwHE9Xw7&_nc_oc=AdrUfAwG1o-7Gd9LvCt_Ehw2xZV5c2CikZSHYhSihcimgzEUKOr4VssWBnCKLirEamU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHr6TTI0eLjAG3TMmt3oW3QZm_2KY0-CXn3XZk5IGMbQ&oe=69D108EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j1TxLrlSy4Q7kNvwE7_MxU&_nc_oc=AdqhzJ0D4MkfzwdJq5rCeXf2SkxD1EaRLqLfsFIpSueB1KuQ9lzYXT_x8O27pLYHYJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8UxQtP8DYiQt5amjzEaXGNqLmPnXjIfomz4N69KGMww&oe=69D11148"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNtKFWCPh30Q7kNvwH4rK29&_nc_oc=Ado_uoY1sHV_1_5NoHUSMb9jvw2dX7XPtSlgInxzotGD9TRUCzxYAs75VZk0a-PuH2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwH-Kos4Z0BgnF3kuMGyjjvGnm6hahBen7-K7S_fGPzYQ&oe=69D10C48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkQVXV-7bPgQ7kNvwFXxOP4&_nc_oc=AdoVlbH844PF6eo-e0z7RUakY8tZV0Kjk3puhJOChIDjnotDfhovHRIctYYpOZS-BPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFA_zRpaIIIrOo4rzSbtuNpby3Cvoxq3RSxJV7e6JRnA&oe=69D10678"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com
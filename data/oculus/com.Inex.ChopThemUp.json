3OSS-vWOkgESfwvaGvFHHnnYiz1W8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyX0UGQQ6l8n7lw66Z2koPfzLn6CinfJanj8yI0gJS6Q&oe=69B7E165"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0dRHdYwBx4Q7kNvwHLQ4Rt&_nc_oc=AdmbJcJr5oWNX10C4NdHt1xtV-QijY0c1gCBBx0LV1q1N-wdaUpCO65D6RJpWXMiUp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzm7AvMOjoQziYrQ7456dfsGDeTcXD1HR3uLA9MkCKjfg&oe=69B7FC6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a42dHhUw6D8Q7kNvwEP-InE&_nc_oc=AdnIZXEhlwVNCdcx6DS-vkaWyhfUiqtNvoH4nkVsH8x3Dk4AmnaKVwSLcu3CM2Gi-50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFQGBeVHBjIzyBT3Ex1x2SgOhpnn_j9Oasl9GxUgqKFQ&oe=69B804C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKjQ8CaYQKsQ7kNvwGjy1Ad&_nc_oc=AdnEPrr6fc8Ez2LEvqGzCNbf0MzbvzvXpDDn5xyOb56qftPNzY06J34ohgJA96LinsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJi7jaOdQjKStgfnGDzqBpBnfkXpbUa6C54OY-nRMN2g&oe=69B7FFC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edw_2Df8ddgQ7kNvwEL3MIr&_nc_oc=AdkRpJUFzl8CV4PDyzUpIseVvgEWSWzl0Btx7DhaEQtJqntOIsPI2G3j3kIIeKPt-hU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7AJyEIrvvXEK28XN8WyVuWO1qav3alGL2bAXv6ffieg&oe=69B7F9F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
J-yq5DmJHyebA6MdeK6hIlrCMxXtRD4i-Zpitm66UdXa9oyGBLV06yMWEvfVU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yODb8ZNNwYC0ciQZG4uUDVoBGmXYqklAxFmTxshLbwA&oe=69E78FA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__CK7e4GUtgQ7kNvwG0yqq4&_nc_oc=Adrhd6Rf1cgcDWxC9bPr-tI0hRGchnrOZPa4TnXqshXje7bbdEYMemB3OlPn0kstSUc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mxukytL_uXeinq0XqYBkPRA9oOPA9xvtS7pxWqqfwSw&oe=69E7726E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW5w7PKvElAQ7kNvwFG70oE&_nc_oc=AdqGESzcsC3aVWaKTEkcHH1EnlnM0HvuqTkEy_Cip5rbyL3oG-ykzuAFbPxbnW3B6OE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MRki0qqGYCPrCvBu5kruhTQGuboQBNOaAsqcuhKdQRg&oe=69E77AC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2urGNCXiGwQ7kNvwEecWK-&_nc_oc=AdoAp04B0EgtvLuLugi50AF343nYuqfCSXMdWNnLYQjy96t7VF_xTPCwUA9LiKAzMgI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jPMVrDT24FoJkZew96RIbQ1OFmDGnpjlQvnnxryttGg&oe=69E775C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzaVxaUcffIQ7kNvwGaSM63&_nc_oc=AdqF_ckXTYoFSv26-R9zUgnJtGZBwUbnDykOblfClBLUIn6i6_loH6N1xc1UeKmWhNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GE1qALL-nZSu0CA5zd3_SLKDo16WCmAYdF90qqMsHvQ&oe=69E76FF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com
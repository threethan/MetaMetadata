J_kSt2jBHZrSy1rbDQBRSmzbgtKpJsm1OwaWh8CNROCoB6EgF-UQf8syQDpCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtNobwsBAeWnB2ws89SbL8X1x8IVnpQTL1zKl1i0P3Mw&oe=6A75F1A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHeikJ8cNIwQ7kNvwHDtQD4&_nc_oc=AdqZmN9J_L3rzU4Hx-Cudmo2BmPdaYwrw9brnaVCbDMX64klvlTie6F2KOVrpcvUTMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1QKFEz2G_HSnB4QwMRInZY3zXLM8LRL1iTFHivS0EYA&oe=6A75D46E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAOnzDU5CuUQ7kNvwGQHc5x&_nc_oc=Adqbsve-wYzkMHhP5xdPUtf-iQUm9aMRNcPQACYhYUH37k4O8bHLUz3YV3_rkYWfUTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeIWhQ06QJosfKxfVlqqJQo2RoyrEi3AFAp72QADE-5w&oe=6A75DCC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgfCM0YaTj8Q7kNvwEbpwlS&_nc_oc=AdprgJRtX0cbDKNcm4CpW6j1bDdytZo_tQkehil_HT5e-j6VsdsxoFkT8byU4q39jPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExZ-vbdKz1YLx349YEJtt5d29vsEyaCU2TooajD78KNQ&oe=6A75D7C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOx_-aV8P6wQ7kNvwHxn3Eo&_nc_oc=Ado7sOXwSQQM1pr9hh5Txrjfv16OEV3WjkuecjjAeSw45rewBXz1rLnDmDdGqy-mpdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcfCFxHtVZ5nJlCh5rdlKGF6ODyS8pvVGhBQJ66rX4Rg&oe=6A75D1F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com
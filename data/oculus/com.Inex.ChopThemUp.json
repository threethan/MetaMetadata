XOmCspEwiuCDiavTk_c9FJXzpitog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9tx7wd9ib4dwi8EFxUNYeeHv55jSjHYSwxx3fO4y2eg&oe=69B932E5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0dRHdYwBx4Q7kNvwERzLL5&_nc_oc=Adkkf-wDhtSSsS0x8CSS1eWYyRO4gBiwGmKUtIDw48TwctwAa9Tg6XbrQPUyTj-orpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgYi-Lty2EDV6pOUz_IUVE4laXtiSVfEZox80PJ3TaFw&oe=69B94DEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAZy5eSE1bUQ7kNvwHBy6Rv&_nc_oc=Adnmm-XUkFyOpLcTCtvABpBg-MUiNPhhnwdTfyBMsaMiie6437x08kDnSxY-9Je-EpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9-DLXEuZ33NOjmXpAxIh62Dm9kveO527bSDCdOMjqZQ&oe=69B95648"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWQrlkmCOToQ7kNvwHXK_Ou&_nc_oc=AdmcWPf1O5wog1e24461QdF1pdLlRR9V1IBDCs3lp6iqulqyJP01ALq1Ef63CuhIoq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxe20h4PpsBPonbw0kNbAFuK8CIHCYavhb5qziaAPIIfQ&oe=69B95148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edw_2Df8ddgQ7kNvwHvLPJL&_nc_oc=Adl923gtZAFvy5w9uEC3llAoKO3CNoIZyc27YFgPg8GYmkXqi7fJwIw9WxIY0fZWUOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAFa1OQ3MefuOSh8uCcIz3uRH8JAzxHNuYf4cKqaOkoQ&oe=69B94B78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
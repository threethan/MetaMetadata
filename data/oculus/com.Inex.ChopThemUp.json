7233557214551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031412_1437233560547884_5895315923405567287_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugs2W0-nqywQ7kNvwHXNiHK&_nc_oc=AdrEuTcqBejluEtIraTk_hW5KPyjxj1f2A4rZo44IH67k6AFmi6LuafONp9Pu89ytuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp4l4KrMlgXMH4_iCMpbjGCTmiT0MO5Y42z0QGeTj43Q&oe=6AFF0DA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3Gtj1X65uIQ7kNvwFvnP_V&_nc_oc=AdpxQrVeZjuCzVTtZ14Y7Qy9nB73s2teBby49XC-sL34YIu33WpCW2ykdkoDg1CRS8w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ae6shx_N1Ew3JzrJLeAs45MIB3ZZ8eB7_zuBIl6Liw&oe=6AFF28AE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6DuPZNLQ_oQ7kNvwFZzJFU&_nc_oc=Adqi9AwDU9E35bjlcKdMdpC445L89GMyxtGhl0-M2skFiPgoDwzKZwDAwm5a41r-WYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT111gzN84Nmj_-DpxVop6HVzYuYz5LrfuozBaSQ_21BA&oe=6AFF3108"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCjEOD4NS54Q7kNvwGOo3oT&_nc_oc=AdqaOcjtAH2SQtmW5OOWj26IkJf7LjRe02C3UEeVEBp1xXzvzl_X5IGvuKLpHLj8Cxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdcVPhdWdeJ-0rjnTL5dgA-exsqrkWKGErM1ayLUH88Q&oe=6AFF2C08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4GOV04CDAYQ7kNvwEF3dTd&_nc_oc=AdrRXSjBJy_fiUuSRupwEZD6SpQtje688iXNCxUr6TFidbW0pWdBeALPY5edgFlAeDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUAyiVM7ZqiDBVEGBpffY8dtwVam_YtMUzFCfjaddmmw&oe=6AFF2638"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
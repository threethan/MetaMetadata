lpBiwIHSDOz5XgwS8y12B06MdOGfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBDcbsJlyRBL7cFe2R6Tcr2egL8V2rdZtnDBPPZp296Q&oe=69AD5565"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dw-Fh_eemoQ7kNvwFlOSUl&_nc_oc=AdmbRtz8GKnCveEIZagUx_eeCcgsDoo_kbRN3eyhaSIRe1ki0C-URAnwN5WKK4TGU3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQ_uCagBl_7ncj7-mNGDVsbAI61_mF1x1DbtZHrqA6vA&oe=69AD706E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eglpMgHBXu8Q7kNvwFLU9DN&_nc_oc=Admj0wo5Kz74fAD43RzZeKRKTlNI8RyF14Nm3G4gC5rQUzAJmjyXZ70tUFKAaMpThfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9rV0n0ON4A3P0JJJlHEo3HzGWSXoThMT5pwYZOFN98Q&oe=69AD78C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glUrkHSBohoQ7kNvwFyvuyQ&_nc_oc=Adnj4w0RK0NOU3uTvnnS4cS6bknJSXjl_V8NNVZv1MO-gxG8N3kEEYDOt7DT_m64dYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo3DjnydoKDseaU3mUEEKaFKEq6pLdC3z_7vNdhw3l9w&oe=69AD73C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iePeBrMQEzAQ7kNvwG42ema&_nc_oc=Adn2HJDzj8WRoLj-gG0_wkxS5R3EjC00OI4VZpijwLNa-BiDLtNAd94ZnkIlZruF5Mw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFwzQlwLuM4mWGEs0bjW_tv2_hC7L_cNe5HSVYvIqYig&oe=69AD6DF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
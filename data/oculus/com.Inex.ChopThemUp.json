com&oh=00_AfuWcTf5pGDCMfXHgIbIoVn991cMqmkckRCH1-S-ncKNYA&oe=699ED4E5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xixdoFdKoO0Q7kNvwEBYwmF&_nc_oc=Adk9DlNMZhz5n_mb2ZOtWyvvMx8zzi_cABZypVscUp4GO7xC-kERUdkE5gHtqyXJ_m0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv0gOjfjWgYrVuHc1xRGz4yxZuiktX8O1WXEWZ7fCj2EQ&oe=699EEFEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNyy2jRqT1UQ7kNvwEljCl8&_nc_oc=Adkz7YDZm1-SsvSwGgrd2nWKncsOhOXF7aYEsDV2mNDv1Ysb9v3U_mrXVlEZPK7dupg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsIXHLfNeqzvoWwrrTjiZ46NEiMpjwDetXkeHJ4CJ5GFg&oe=699EF848"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fj8JapAjeUQ7kNvwGN4E7M&_nc_oc=AdkyMTuACjsRmcw6c8zUgfHUizakphASPlk3PhpbnR4MK0EPj43GIZGr9ooQtTt54Ac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv6aVugtrEt5xm3VLxSzHVHRca6cWZlWhUVI_FfAKc5Ew&oe=699EF348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7daF4SZdRdgQ7kNvwFILruN&_nc_oc=Adm6gakgfSvDEkGxqJ1_m6Cta9e6BX3qfv3eRhtrGf78blLE-Y3UuRjqiighMbkLJx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvN6fm1FLWXxJ_bMA74XgQyA9sNhvIdwJWl2B5xONI07A&oe=699EED78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg9s-0dV5QQQ7kNvwFSzBwm&_nc_oc=AdkBZFyI
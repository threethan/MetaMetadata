com&oh=00_AfsffsY0UJN4Grsp7GhlnJrneZFJilEoyOM-gusnqWsTjA&oe=69A56C65"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5tQtfKlfeoQ7kNvwF99YDP&_nc_oc=AdnucEOdHmnlX7RezQqREjg8mcsoOEpPT7_yaGtFKSl0-YMoLdkJtU_0hph8exKNl8M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvmFWLOdNcDzGa7-uH0ugoCSDZlH5Bp15pibwmHpBti6w&oe=69A5876E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lly4kD4G0s8Q7kNvwHLnmRU&_nc_oc=Adnx9fxA7bbRHibc0a5K6uaNyBJon84X8rW4yabASWMvM-wYyOzdRfLs13JIDvArS80&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvI3arA6fVC8EFAbx9tSru82AqwxhUvYdCVX_jqdBcYqw&oe=69A58FC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IMmSuwOkx0Q7kNvwEmSwwG&_nc_oc=AdnvKFSTMq4AOLUPOX79R8bo4ftL4qYjpLqDjhnKFIavjAFjnnTbnnztuwgpiPpTX0o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv7Kk34J-k4loEuHu1UsYD9BdfQAvPYDkZWhs-wkXu8nw&oe=69A58AC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf41zLxwh6oQ7kNvwHt6_IQ&_nc_oc=AdlObLukLzSUW4QGzllHLxnLq2RrT349lB-BRE8UBTHOZo3pDKCIaf5PzbNglYu9UY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsrHMnaDxL_uLR4pHcOtnd3IuiKx9D1PK0accKLoTGomA&oe=69A584F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpGh9p4junQQ7kNvwE-FxKb&_nc_oc=AdkS9Eka
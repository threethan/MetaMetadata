com&oh=00_Afvz2B_rxs84fOBOkoEBlpw9xgorqYMSXjv4mdubGe8MkA&oe=69A2C965"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5tQtfKlfeoQ7kNvwG3XmJE&_nc_oc=Adm0IO-utQHc4Jd6BocSSwyVo8B-mhXVMO63wLRi5yVR33e5VxSGW5FOJie01auMvHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvN-QIqCfu1YzSc-UA0MLpYnLa6_zelFbxC872Z-wke2Q&oe=69A2E46E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Md08ruBgYwQ7kNvwGQHSXb&_nc_oc=AdlftOixHVdSkZQbEqzSGR8SMn9DgjfF3EYX7z1Soa1u_yjqkp_U-VaEGi1qN-OEMpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvR9s1Y1NRQTNzK7YNYZRBcFfNsdQTDxT9LBKWqlb0bYQ&oe=69A2ECC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO0bUAfZQE4Q7kNvwGajd6s&_nc_oc=Adl78cdWUINgqUNQBcccO0fIrxNEvs-CilhvIbIv9q4YVWH4UL5pPkNP8cSeyeWJRF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBHkeqOSMdsXfUUYIPZxLa_04OCpwo9LPQkHtn4nQfww&oe=69A2E7C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf41zLxwh6oQ7kNvwHPZNYz&_nc_oc=Adk_8Ko35hjxs4N1lOe_DQ77Rcz2MtosYjqGeptccxbZEbqzym4frIqV5jYkQTEmnEI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYSJfQDVi2w6xpExEtwv0615X0aFTgeupIlaV-ya5YZg&oe=69A2E1F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpGh9p4junQQ7kNvwF6yOMk&_nc_oc=AdmjBjiL
oo6AxDKcQFC50Iz6QwMrvrw0fXW3sVd7gW87n-wFIWyt-8JDdqZX8B6EjGGEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nxJK7qyrl--etFAQqSl86gm4XeEnI4Jzf0BRhI4U16Q&oe=6A0DCB25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP0AHCgk96UQ7kNvwHA-EO1&_nc_oc=AdqBh1a9CtKocnQuVNlBsLcGnnfMftSP7ujvHqjNnKrEvIl1a-CVK4u-w-fvbpVPHtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v42CLRJbKmYv6zqUwHlOIDdDP9q0i2hGoF_r_gOYVeQ&oe=6A0DADEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En7aDAkbplwQ7kNvwEPE9w_&_nc_oc=AdpJQXGSvUgh8uWKNUW6jJmTtunq6KaRJ2huPMg5J_CnlCfHlezVlkQvRap_2lVWdn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af498-1IeqOKT8ST08sdqGGhakFmT68NKoovmckoG4Rexg&oe=6A0DB648"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjQ63rWKCSQQ7kNvwG2__BD&_nc_oc=Adp_qzXOENrr3ql9hrWw58FwZEuuG1-OF7ObpG-Katrwj1E4I_W2LnMml1q6scO8g08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hFTyzaTpLII931Mky2mX4_q3sG7G3i3aZWgdgH_8V4w&oe=6A0DB148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJpb5LDK5yYQ7kNvwGt_p-S&_nc_oc=AdpzuIT_HJAPiGQtALfLK5fXdAmdGBUuc_vRXazP6JDdva-oonoGCmBVCrNN5IDPjVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g46GEQnaYG6QVG3SsNY80v3fpmbiScliM4a5IrYb5gQ&oe=6A0DAB78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com
uEcci9R9cUjxueOTV2ab813n4hAgl61cGoGY7DNPWhVPcTm3COtmdoJmBNmgs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG5zffwEPBG_nd_MDDkZjrhqhwkFHGT04wtRTDJYUQFw&oe=6AF08D25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0C9oz1RJbYQ7kNvwEWOUk0&_nc_oc=Adq3K9JpeVeIn5c2WzQEqjeLc7UG59XyAL_6nci8pLsvhaIQrZl1fx1Tn5J_6KhogDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc4v391QuSYEYbDhPjA1JhZJ8ywnAbisuK_Sb25j_2qQ&oe=6AF0A82E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbEkSq5mX_UQ7kNvwERIJrx&_nc_oc=AdrQfuoTZB69QU0aCjeNJwrVgvAiCkrie3lLHOogm9Td0fC54Vx6Vim9DzbfVyHTvf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCrs3zPnZtMs_3dsTSeW-4VzkSBsanalNXBjsS2qGZFw&oe=6AF0B088"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7WNCq-aznEQ7kNvwE7MM4Z&_nc_oc=Adqkjt7phyrSAMFWZAvzTLgYqc3lYLPnihnwdDWoBLwoq8AGBbXqh4n_FmfkexLsCfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6XVRd_KJOfCpKsnHXlfu5aumVgDZFs5amD7Gg_oD2Wg&oe=6AF0AB88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRo5Hz443hwQ7kNvwHSNx4p&_nc_oc=AdoohAvP_cp3KCkb3jpsm9HurRKuhvR26Z_nj4bAJC6EMY6SbV95W_dPjFAIzP_jn2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXGhaam084UJRwKqCHI9m6AysoX48eD_OW63HQAKhVNA&oe=6AF0A5B8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com
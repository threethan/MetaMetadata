w4ZHhGM_q1DqpKLxTPL4wPFZYfwtA-Yahh-uOgUo2ZgbKpsr5sIiiXfqT1m9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49P-LQQOYdgkfXcgqs1Bu7FhYLMQCtlJb4RE3x9XnDQw&oe=6A0B2825"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXWXwIGMBoQQ7kNvwGS_U28&_nc_oc=AdrQjjcO8yQQ1ZSi0e2WY5vSeqTOJgmvDeQFBDr01QOb3GQ5gekNas66TdA5sDUAylY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PWT1h98E6aKCSN_QG08PyU6Fm-5BfQoTLJ2Dp0m1hWg&oe=6A0B0AEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgsJrL0nPBIQ7kNvwGgeg2N&_nc_oc=AdqNuEnO9VHVImrLR1oW3NlzHlqjYu2uPMIGhNozb0iAcyDIpRBIBbWzYPIrUR5Fj0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gDzD7Wi0OKqwflFAl1sHb1-FstqnSaBhQ2WF4vhHDig&oe=6A0B1348"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKCJQBRk2K8Q7kNvwGGZzVU&_nc_oc=AdrBoODF2A0PfzYHAxqCUeyBceh160Gp52b08qzsTCHXEm0wg3tTpIg-muvys6ryr1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KODlxQiGyiSdni3SAUiXegVjVItEqBkYb5oi6CiFK5w&oe=6A0B0E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQMHo2Z_IvYQ7kNvwFprV0a&_nc_oc=Adpk_Gg-b5ABHmwJgAp7IyME6pPt-E0H7ZoSdb-dbNYSW6hKy5fJDOL3nFim072e5GQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bYCAvNNJBq9rIsGbmIwqAaBrRGaDgL3Z7nz0g_fY27g&oe=6A0B0878"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com
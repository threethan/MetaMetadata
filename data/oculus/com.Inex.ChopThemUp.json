kGYECgxGU3TgQ-KNG2Ppx8navxiTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKfob8ETbU8R-WupmnMtrYmXMGTE-TxeKbcBVxPPgSeA&oe=69AFF865"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH5Ptzrrc14Q7kNvwGoWntm&_nc_oc=Adn5OJXypSPruMMYR5m4lB7o4PRwYEU8QMDhsVbjgMSFw-Qs1X4JbtSN3KIWYmx3FAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8EUwMZXcximdGGDJAl3R1saIEx6Q3UdjNzzZfx7pXdw&oe=69B0136E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eglpMgHBXu8Q7kNvwHOyTe1&_nc_oc=AdmcUsEDEpXKgQMgdFBXA3wGjC22nZ07DkxGKZ1ufO6vht12EaOOu1Kf11wHPOsQRNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDHF-RjRdWEdn5KSrr6ysaEvfEf3g9RlMHMOW6AwKVRg&oe=69B01BC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glUrkHSBohoQ7kNvwFZ9ull&_nc_oc=AdkzE8N6-2-q9to6HGuhmLjRHCmKXfw_cZNfN7-a_mLZakSgSNhTVGL0RjRx5yvHXUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyo9ZixSGMXA8zaeiIvGbWIfV-FPUS3ZQkop0zhQpvwpg&oe=69B016C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we2crgKNg_QQ7kNvwHzHYX5&_nc_oc=AdkjImTqpTwz-xMbgA6osOXIsUwVxe4w3sYsauZKfYrNi4_YOVVSPnjnV7WZM2k2b_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTT1kM1FpSmEP78RSO_2V98bm64jdB4B6fGrdrZGlIxA&oe=69B010F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
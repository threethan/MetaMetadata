7233557214551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031412_1437233560547884_5895315923405567287_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgZfeqLJs5sQ7kNvwE4_gGO&_nc_oc=AdrmNNSaysCdbcG1K34dc5lhMTgWqyVncusoDi61s1sKOW202aMoaGLD2QN5ELvrvh4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYXvvXAXjlBW_dvdwtgnBAsBATVUzKu_dKWDDkNp5vSA&oe=6AFC6AA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_HDt1ANVLgQ7kNvwFDbutd&_nc_oc=AdqXkVAApcD6qJP_SdZeGmd0dh5TgAhbd4SG6F-hp6jTlYN0zr0kbNfsLf1j8wBbwW4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKW_IGLKD2BmgIqDDrHr3UZdq51dcLqSu-kPvb6MKdDw&oe=6AFC85AE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teA8mqd16E0Q7kNvwFD83kW&_nc_oc=AdodgYJeYSG9feRPN79z1bNnHzse4BNStYgy3n7FtQFhv6Ka1redHAbK7VpCorVZ908&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr0b2-SDdbXzpu5S0UaZ39xvQRcInXJHRNN63gaHGJhQ&oe=6AFC8E08"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEpVA8y891AQ7kNvwGF9ari&_nc_oc=AdoDPOmgnUhhGhip5cMMKjADyd4Yp91ypKAe4VZQYd4qib9jHe_tlfYAY1xjwPDiMM0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUZ5IOnQW0Vl6XIrlQQzIHoXfDP6DhYDrC-jnCmtdVJA&oe=6AFC8908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puEnctrgY54Q7kNvwGlggZH&_nc_oc=AdrQCEASZgwNdG9-9Bf7TcgA5lkPq2hEJ4qfx3OIHZDTeD-Mf3yQAHJK5R2olXoLn0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNQ9gFQmjPNeCqbsg5t5rdqoV-keznxjLV4R-2lD9W2A&oe=6AFC8338"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
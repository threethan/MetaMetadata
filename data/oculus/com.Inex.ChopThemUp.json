7fIII2pIF4ZIIvcN1O3euQ2u83FX2-qfz9Ij5529DtRA3s-qoqhx_aY1vsb_k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXxaDt8CYx2kC_Uxm9ou4pZaD3bZMadQoLUkjdU0DFHA&oe=6AA021A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVPV2HFHO8kQ7kNvwFpwB4Z&_nc_oc=AdoXYxqZcqJmGqGc1vB_pXTh_E0EejK2ZuoFiPfLo4ZjEen1S3eAAreGRzKa4pdOUaY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLgYVw-0z4JLrLc5OU3wRyp4jbuXftsVKX3RCzdMNPag&oe=6AA0046E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2UXn4J2aucQ7kNvwFN3sS_&_nc_oc=AdpXvrqUGi6Boj_3cjPVBOxzjI97rhESmDkQbCeMLTSLEZSmZwe3zlN1mVyzs5NZTB0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWzZt3O338WMDFgvMx3anRw5ajj4rkiiHKBQ-yfNm-YA&oe=6AA00CC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVU6ZIezpE4Q7kNvwFCpoxR&_nc_oc=AdqLRkLnF2NPAgF2NbpH-21OJ3wfiakBdR_eCBYqew0SctS1jG3tr7f30mSIaFsOg24&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZQrw2DsBEk1cV3RVMMhe_y__xU-ngpGtjiYQC67Esig&oe=6AA007C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10EIq3L5cFQQ7kNvwGi51hR&_nc_oc=AdqTt6ID98PTYAaosPPSca2h-r42aNTugcQy3sA8Xvb2pqeNY76NaY0RxsZUOfqYRiE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfI47mv2b42ezhitT_Rl0KCQYsDQojd_fG44IkHKPLdA&oe=6AA001F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com
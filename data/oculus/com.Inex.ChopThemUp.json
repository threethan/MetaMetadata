kAeGNJOvApoqDbRDEJXFrzrFLua8wp2yaCayE14yzLHJbtbYH6nWCatqyc8Ko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9JP55RqgwTECxgkMjGm1nH6wk_jpAIFvDpqpp4oFr8A&oe=6AF724A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-vhM5WPZ5UQ7kNvwF4d5fB&_nc_oc=Adpz2qvFUs8dpHFsCbZ4LBA3z6QeEDfIqPreMdqePPeCJzxc97sRe2_sWkuBNeizv4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuReglRNIzyDpOEc368-5xXkN1cNStt7lrTOmQ0Rt77w&oe=6AF73FAE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1ESNe5FFHcQ7kNvwG98Pjp&_nc_oc=AdovpLWIbyIIYNC1iR6Qsvtm0hTezyDfdKs0hIM1foN5uq1qakvdV0QINNd7wK7EJxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThs-WlpB5hgGOdhi5BUuq_l0QssmahliYsdMU2grw9HA&oe=6AF74808"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Zq2V7ZoyTAQ7kNvwHysUXA&_nc_oc=AdqS9CXOrbbrYPQJ1pGCMTYWCSdmXPgjl4JCuZjW_ABpasZWEmXT9SipCEfigph9gzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZsyRyJ_sTHFGvIRjTY_D7azkjXsxIkmtL8h-k-uPT-w&oe=6AF74308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MugAvUiaGboQ7kNvwF3sw8J&_nc_oc=AdoF7M-4l6c6XDpsN_wZOUreLxVgJIqiZ045Py6qgCAxwNQtS9y9NwzkahxAleadgVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQie-WcxMVG536tvOXMtD4_3L3zxIpeREbHEsT3OA1naw&oe=6AF73D38"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com
cyV6hPRak5uRzdEYYUiiO5svRcPc3L-nfxI_e8OQi9oVegjKzS09t8d96dkQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sqze6w-2soVHWJhqvEPups7yPamRDB5CSCAqHDztiug&oe=6A301225"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50jCoZ2LeGEQ7kNvwFE_i7d&_nc_oc=AdoPaN7griyanSI9jYGq9aBKAorRoW08hFiSVuRV6PiiNiFUq_iSsd9evnqG6vulIDQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8--emEhPEDRNbx8RvcDNAE9x6FapumBSC8HJUqq0HGhg&oe=6A2FF4EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Aq5KGJ6xGsQ7kNvwENqp1H&_nc_oc=Adqcc88i4Ab1LF86vojgT34Xv9c5Vp-14p0jDdsczl-OodGKRzjbjCnzosuVH6YAufs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g7Vg-kAUU6V7cCp1TlhuwnLglY3DEhdcYOCfrN-_7sg&oe=6A2FFD48"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJk3ch8uMU8Q7kNvwGV5asR&_nc_oc=AdrwCdOAIWx5GUHbifGzD6Y4ZVdlN6c8kUe-vY4E16JG1oaW2dAiRy3cfJhhJFL4W10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kzU3Q4Vw34fG9GJKlGtT6XQTB1QucH5ti4zoQ_7uYsw&oe=6A2FF848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYtAhRnfRVUQ7kNvwGyHFOX&_nc_oc=AdooxmE9OPLnh7PjQ5xyH-TQRSvp7G4JjjnZUzW_VF6RCGufQxPvTQLvoU4fmqqR7lg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FaM3FCOY4rIH2DwZvl0zA-DJGx3qYGXI7v8bY5OIgkQ&oe=6A2FF278"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com
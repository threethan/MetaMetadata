oK0xHO99YB1IN04QwWrak4fgKxpDc1IPqQ4nBfCdzwwtyl_Q_2_poK_p-K1sk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ATz18k-0xJqgLNzyJSnv9-ZThqPMqn36dLlwR_mabYA&oe=6A1C4BA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEBR4jsMEcoQ7kNvwFB8UHg&_nc_oc=Adpd8mO9fOe1IIxizl4vJ6W9FVy8hqKymDlGNmjVT7HDkxtCo2fiB0npRLRk8Cm-Oxc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i_EeM-XbTU1XamBs-jiFhely_bwxGvkr3i3rI4pvPXQ&oe=6A1C2E6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdF2mHcXSH8Q7kNvwFJhlxq&_nc_oc=Adpa97obsLUUCE4Dpw1reNarH90Ua6CpVNLwb1Qe02FTold8GyBXx2IdzNeYLShl27U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MBv5JjSUl8xVSMnnRhQ4MW0FETtt2s2bQR-kjN_xN9A&oe=6A1C36C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ1Xn56fyXwQ7kNvwHQ34zL&_nc_oc=AdqwrCXFRY8kDpIA2AQ9viIse5X3nKk_rFvi1mKN1NYsnQhehfZIzdaZNmN4I81Wo0E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64knE_wI96lJ5GRvD9-Aq8PvoKog6ogsn5MnROgRZBSg&oe=6A1C31C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJfKXXgn_N0Q7kNvwE9XwDV&_nc_oc=Adpni8dvDSrAgPvNzEv7sBZqtF0TvWFioahi1sEZBD9FLiU9UKQf8GjrOXOMDQwgyxs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cuw_rh0yJtxJzpt1H0tEYoNxWeS5hx_xzLYmYZlXdAw&oe=6A1C2BF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com
h96m1IX7pUo0ihvnSa30CYMG2teFA9j63P6l7dQabxeOHlipQ4yJJm9joZUng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD-fZhTHELaFVmGmM4d4Rb8RoQqhIouNtE2Mzezeo1yA&oe=6ABA7FA5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUpN722cmH4Q7kNvwHQ96Km&_nc_oc=AdoO098CIFSFrC5Rvn_RyyFXo5Mkm6-aGy5vCLf5J-FqMAtMq9OwGKVKihBul-N3C6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA6gW9ZCELl-zyda3WZhJs4h2hnV0v9nrE-T0jTssh0w&oe=6ABA626E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Pk_RL4sl4Q7kNvwEu_NY4&_nc_oc=AdqIGoJvoHVmfpcpVhjeY_j9gfgvCEEZNeNTLZR8ZZHb4BQ76zLu-YvlhLL4pFCnS-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgvYtOc22L0Ixom2Zy19SwDSznf9rYab08F_-lP6fcTw&oe=6ABA6AC8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0__PuoQ4-IQ7kNvwEDk0dp&_nc_oc=AdpfhnhECE3vbxalV0IQMvL1FL1VN7hOL9krut1jqdpfyqv10dfgewpM3B6qJk2_aU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTFvTA7zdys46doQJzM7yEtNPHesZCdPihvi82hKDfcQ&oe=6ABA65C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwJfAExKo_cQ7kNvwFH_uxM&_nc_oc=Adp6tmRZWdy7xk-GUW0DwLv4aAW_yumQKH238-eT-684Zmo7XoUZw6Z06QbhujLm_J4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb5kSZes1Ih1entLCE9v9LXaWLEHUe8Q2hNwRbXr9S1Q&oe=6ABA5FF8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com
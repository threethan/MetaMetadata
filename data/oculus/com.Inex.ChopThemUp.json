com&oh=00_AftSJL7crl6APplR17d6Q9sWQJ6J51ZfutUR0DEbI6uY_Q&oe=69998EE5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D9kWtjjhikQ7kNvwHb4_Rt&_nc_oc=AdkEngLdy6HqCGBf9KnI4Y4tJgX9bEk3d8uBQmN_-Zqr7i2e7bsoBYC11BiI7TxpsmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsANSiBMZ11jPpf933cJGVYpvvcs1Ek0mKz-lSY3vSYnA&oe=6999A9EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzRAIxhT5toQ7kNvwEGtddm&_nc_oc=AdmbJ15osdY9RJZ3qQo_Rn4JQ54lj76Zi_B8Vg0p9eH2icDnTzGY56im5tCkniiZEeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQQrPQmM3JZEz1ju84QQxGWnC1MsMAL9ZnIg0P-qxPpQ&oe=6999B248"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN8i-WZG1CgQ7kNvwFRMihj&_nc_oc=Adm2YjKqXshrx-jUl1b025GOW8XYbS4uVbdZbZi_5k0XFJnkTsAIKx8Gbo2gHYa3IVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGSbkU0qPdq6Aex5_xZEG2tNPU068hEjOj7n4rM4SjbA&oe=6999AD48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbsU3AyQJgUQ7kNvwFXpeq5&_nc_oc=Adm6bJ8jkF9LJVKX18gfONuMbg_RqM3YVe_X451nQLEU8dCIxM5rjxdDuo4dbx8GhZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9w91VkGeDJyqbKrnQDVasYeHN2LQtrJkgMw3HW4t0sg&oe=6999A778"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_RTgI7l14MQ7kNvwF66Kzc&_nc_oc=Adm1GSzs
44_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IMmSuwOkx0Q7kNvwEmSwwG&_nc_oc=AdnvKFSTMq4AOLUPOX79R8bo4ftL4qYjpLqDjhnKFIavjAFjnnTbnnztuwgpiPpTX0o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv7Kk34J-k4loEuHu1UsYD9BdfQAvPYDkZWhs-wkXu8nw&oe=69A58AC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf41zLxwh6oQ7kNvwHt6_IQ&_nc_oc=AdlObLukLzSUW4QGzllHLxnLq2RrT349lB-BRE8UBTHOZo3pDKCIaf5PzbNglYu9UY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsrHMnaDxL_uLR4pHcOtnd3IuiKx9D1PK0accKLoTGomA&oe=69A584F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "http
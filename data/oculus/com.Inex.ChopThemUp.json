FpezPmUAhxAAVYGTi571vBcTpISOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftx1wsRZVzCpWPPB93VQ2l_oj_-a_Ppf4yYrFDdT1-v6A&oe=69A960E5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h5zFe14NUUQ7kNvwGlqX1U&_nc_oc=AdmMeF0NbgoSXPJPW7H5yRA_ggiShY998TakXKh1EatH7sgYVYMhIMO-g-RUSbamsII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftvLURVAY3FuqPJmkLOFuZavSkZHhin2Ixo2MZI_yJZ0Q&oe=69A97BEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXAc_Gp2_6cQ7kNvwHB1cSU&_nc_oc=AdnLlDx536-5bpyX7s3k5eVDQKbmyFTimv_s6TI_eOPzNZqH0Ukn761xL1dx8ERswZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsfJgPh1gaczZmS6VWsXN3s8f-y9s8NqLQK6IWY4ChEdw&oe=69A98448"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7h3TAG6Xx7YQ7kNvwGiISRP&_nc_oc=Adkx16uRySVbCpiB1XUSBiyRQI_MDLYCiJIRp-crXPCGWgHPiPeuqzllUQyxTP5dh2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftWiQeBm9Hn7liRu8dpElYqaVSRfFxcQcTB2er4KHU0Ww&oe=69A97F48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiLhFLKZ0b0Q7kNvwGEmuMk&_nc_oc=Adk54GUxQyXQfbi6ZB9hR4jcRRqZo_ti8zEk92MyGir3UEGNsEEgbke46F5wPQi6YMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfusQIRAJtxoBPNbT9gZYt-OjABBb1BCJ0jg-sUDUaDatg&oe=69A97978"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_598236598841
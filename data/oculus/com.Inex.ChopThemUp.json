zI5ZyWtYGsZukkCcRKzwfWsSixX4AOVA2TrUJmDqpI3efHOxdJGVfg4nn2kRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk-yhGRJrMnPYYweYwTajLPEpj8UKslZK81b5XHpgu9g&oe=69CE8325"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpA-pTxhZOQQ7kNvwEMCkNS&_nc_oc=Adq_YkObpZdXY3hHwDc80cFtrKMUnomlYXjgJqjFKOHwkE5rRIRhrX0X0Vg7D6p_6Eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS0y3pExAda3VJSzWvv_NyEU5oTQkqVqBEc5e_AbYOOg&oe=69CE65EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDLIJ59Y5pwQ7kNvwHZtP_H&_nc_oc=Adp8MWCyiZckeOqCCwJsKWmjFqThPO3CUiGHTZMkWotjSYOegtRNBpq6p35eilFLIn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSPDJA8spHi5AAjFGp65z7W68VHkBsuJPng3m4vLcqFA&oe=69CE6E48"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkkigS-sNsAQ7kNvwFcOGnq&_nc_oc=AdoAOdVurK0InotXyDjaqPmhreQXcLpNifQBBWqf4PeEluZjBFrHQYPLrXenoxql9yE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyL55B6SVZHn7dCRCU5jTUEDy-Sz_ycfLKmCiAhEtz4-Q&oe=69CE6948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkQVXV-7bPgQ7kNvwEivEBi&_nc_oc=Adr00mdB5lObFkPt-cXCARKt4P2CAmTViKHjFMJUjWYPggrh1w7U3aHy0WWDoYRwgYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXlAA4Mn8Q0VsNWSxE1DtEX5MeZ7YBW5y022oOdem8lA&oe=69CE6378"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com
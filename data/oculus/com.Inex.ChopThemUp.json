com&oh=00_AfvrtP1wuFPtZghG9dwNOP_7BD8-DgLh5ll4vOfzEE5kUg&oe=69983D65"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D9kWtjjhikQ7kNvwE_Q0z-&_nc_oc=Adk_2G-9K2o30SpZWLl8YNFpsySrELGX8OsJM1ADn4wLIm2-nP5uWtaTxzWQJ3Uht7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvQEjqgEGJ5Mu88BFC-lq087M2ir1rTY6JprTXMexXXwg&oe=6998586E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Egd6kIWJfbQQ7kNvwGSryh2&_nc_oc=AdlFWPnl4SpJF4UlW9R_p--nyMpRnvF0gS3RPyBUeVcLxS2ZyQLzJ5amrCwnbpIP3Hg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftR3T-PMfbHrExrAw8TyQKE0Z5e6EU5LNQ5XN3QHLENrw&oe=699860C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq-j5raQ6fgQ7kNvwGL3ruL&_nc_oc=AdmJaXh0yk76M_Uzs2oXOmz8V0m3B_hTSHExYCi1EZzN7QdiA-P7Ah3Pq9epkacAPQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvC4PAtik7v8ALECak-eSqhI4VPr7aDoyBglIlLW5xoJA&oe=69985BC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbsU3AyQJgUQ7kNvwFYXuAm&_nc_oc=AdnjyiheaSaNPhEKrnnvQcKUT09RoGtmbR9rBy20u4VSS_197ScR9XtnBERZR5rlE0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftr6rNnYOfzvt2BdkXxLGPvfR7BBRPv7d473D9_7m0qlg&oe=699855F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982724_400786142614496_5982365988416986619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_RTgI7l14MQ7kNvwFE-tfE&_nc_oc=AdlNQtJA
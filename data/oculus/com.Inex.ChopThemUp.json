r-4ikZeRzXnE69rMdJcGYiev7_3k_pArApdy--WrOCQjA4V8qD-5IDm4qZcYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QvYK-1B_kVi8tMJnqvnR91ms_1HJbMHEIgitG2lLBFA&oe=6A131125"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ05ulQYYCsQ7kNvwHRquez&_nc_oc=Adr7Yr5xu1fMP992Om56dnqbfjuvylkqEgP_k8WITNS_NByBAkuKBBvAnh6JewlTIQw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Mc2naITjkHZ6imaIL0-Xge442IDd_eQvphmOGxL4Vw&oe=6A12F3EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j8TfwhG4IwQ7kNvwGXK0kY&_nc_oc=Adr0UtbYbUvCQatYkI0EbUPYiigKGiw3nokHhkwDDO896LgmQYdgGyvgjyzF5C2Q5Yc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J132wnw-7r8wMFUb8YguItkgMXCZrapbuBMHCbGi12A&oe=6A12FC48"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGpjhPeeQcsQ7kNvwErT9oA&_nc_oc=Adrf-_BXqGjMOyL7dBPx9R9V1fAD6E5tohC-cIgATIf3lU4746gsm0dRHjJPph66Cpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d5Z06Yzc1xCXQ6rxCL60CbFLRaUjjNsfhDo94fRXywQ&oe=6A12F748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QjtTFJXfsYQ7kNvwGw2H6m&_nc_oc=AdoYgI2lwllgYk_x5M7TLavXfB0QEdfKav5_Fv7j74NLH60gXMbjmh3LA5k2FuOTLVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ciXUv787jQdGDj4iDemXpwXuGu79ZUH8RsiifwwJgpA&oe=6A12F178"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com
QgGuYHnzxbMsLcJEpl-sLjmrqw9kLsQ0L7I0LKE0POXJS7tFfsudZO1bCkFpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eLmK6WD1Ca2utFptD5nX9LEhCTt3vRYx-mzQJKFGX-g&oe=6A452A25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu4FQzBCa1oQ7kNvwFubcP2&_nc_oc=AdqC85Cidb3FoRXPB079sSqfL1lWTpAB17ynX617kWWEF-fbMzNpj57dyaVJSSiQiXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6viq1xZlbKnI7Tzlnivsbe6WLfhrTMMGBA9oF1Yc8PA&oe=6A450CEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUpmKq0KOcQQ7kNvwFV-UR2&_nc_oc=AdpNxD_1UDDSF_0qDonl-xHhAsmz2rHXDFZJhrhsF-pmvKBpzkXcYiTNpzMmnSlCyUc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90sIc_RMs6KgIF76RKRpTRA5JoY_nZd7MmrQzyWaL06Q&oe=6A451548"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDnS1GOonWIQ7kNvwFQQlsX&_nc_oc=AdpU7e_0oW_hvb3Zi3WMe33z6rSuVChiR7aWOXsLOcb7wrS9_Q9wiTwoT9cuhh_SMLE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nB2YoYhJMOhrr15PhFkmOH6ly3wabbGM19m3gFZLtGg&oe=6A451048"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4weC4ljs4IwQ7kNvwFADTW4&_nc_oc=AdoZqu7JXXCV9Q_UrN95O2B8qXAk8SOU5iSdsnb8zXQJPfUPDuZ5FPrIj2gLKaWIRSY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KKQQu8vsSENwtCOdlVguQqyKSy2ASzeJF47wfN98SAQ&oe=6A450A78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com
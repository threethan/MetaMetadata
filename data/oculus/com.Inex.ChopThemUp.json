SjmlS35TEVQ4WGfQOZlXxorgehM3s9sQWkDvf8u9DRrsw_Ei_gts3qIiA94NQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PiqoZw4Bu-L1rCibBcR1lYcM3AEH25BXwQCdq_Kkb2w&oe=6A0C79A5"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXWXwIGMBoQQ7kNvwHaS4fz&_nc_oc=AdrvotQdG850tWx9uLXgMCPusVCDrWpPYW-WqfET3znk39gZ2IVNwkh263e0ySLNjso&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c681IOxhMPUoWPT__BowF0CzkcWmwpssIFRZOhVFmtw&oe=6A0C5C6E"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En7aDAkbplwQ7kNvwG4M6jX&_nc_oc=Adq4659gcDtgr6z7lz_DYWY73S5EJDfm3gHuomXPISWXRf0-XpoyyBTPdl6QbRKtBe0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_hBV6MPEQkDDn5vl1KjCPQxUzZB7yIiiznIjLLEQ7PQ&oe=6A0C64C8"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjQ63rWKCSQQ7kNvwG2PFoO&_nc_oc=AdoBd109R82KfzYAa7u-iu2ay2jkZcCqKWO6zEsDXYs02mShzLzUzm4rC6q-l37qQoM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nKmsAogvzD8nWoyxSc2GTq3g_hNNjE5vWU2tPQjzl9g&oe=6A0C5FC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQMHo2Z_IvYQ7kNvwFdXjC-&_nc_oc=AdpDsKa5yemh66WP1cxB-pGUwad7O0vkBFQ_dQHeXmPVClcYbbb0q_Z2x2yACUgqE1c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oEmAJKZzMYrg7LYvoSmmxgelPS3jpyHnAeH7bv5E4Pw&oe=6A0C59F8"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com
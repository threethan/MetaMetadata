f9-MVNgPRotPprtrYSBHFp2wfK5AfsMFFfotGH6S0ztNHot9Yw96ZAwqtLvR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PIBS_xdFjaWK5GzC1B5LpirK6tiNYKU3y91JSzhSa3w&oe=6A15B425"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDNRCIAIBo0Q7kNvwEufOKA&_nc_oc=Ado4_dORLFhmHaMfieinhJCH4AK2W_Abf9aWZJFkQu1VLsLFPfSAwWwBNTAk5ZmQX84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wk6Fqa1ZKhQrEo3zbTUT8NxFsLyCkPim-NIOCs2NIzQ&oe=6A1596EE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vdXJXNVWpMQ7kNvwFbGAnq&_nc_oc=AdqoiIwthvaWsL51CKQ1RrD2Me0CzBhm6M0lWNiCD_1Ej4uqhorMsBv3xBbqEHcJ4oU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dZoboTwN55qV6oqHh8F-_I4KZtE_yKPZmm8rfjpClyQ&oe=6A159F48"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYYiBwvbgh0Q7kNvwF2WJJR&_nc_oc=AdoAcL0_aVhI2T5TTyMLZUeb7FqfgRszRUyQ7-Xhx7vpdrxtO8fFA_pf-GMfQBByf3M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uwA3z_D8gT18tmnIOSmxqSXNe6D70OCaxD6sk9asa8A&oe=6A159A48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JH9VkfAdLkQ7kNvwHGOg69&_nc_oc=Adqb9b0qgYW3zR_E6J9UIYtawci05LtV34l_DBYMHsfkx3i3ZCMah6qoVdtXX3CiRDM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70pENgOM-EdQkNgDmokUhFTLrROMmZr2joSBYHgZOJVQ&oe=6A159478"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com
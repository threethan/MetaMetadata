PxahHLDsVn6po1pTT9iLJwHCa4XrNnnuYDWXbG0gRg0I3h9AhoBnJe68wDVqw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nDcsQd7tGkyk2UwyyVm-nhESSwvtn7UGilBRNZ2aSmg&oe=69F36D25"}, {"file_name": "sc4.png", "id": "3526752437639250", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_3526752440972583_6058314038840199676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TI_fhR82YUQ7kNvwHwHToe&_nc_oc=AdrYZ_gqPN2dessKGEgyUHHVgzW8n-b_VZ2bOuZ-c21sAcSPlXwlkX8Fx5Dwi2Kibx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PI5qT2wqCnWE_FbBqjl399u4thqx5TK2pjLJEZFn5MQ&oe=69F34FEE"}, {"file_name": "sc2.png", "id": "1747744252391736", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75236135_1747744255725069_4473964218104072760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS6PxGutHzgQ7kNvwFS6GEM&_nc_oc=AdodkHGrK4BEkciTo6MEOnMXcWIGqVOTPISp9hYGJoF7a9bVX_gxNi8WDtaZ5iGzlZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36vwZ62QKnQ7Ukm0Qa4uATgWrnieUojE8eHpyi-lVQZA&oe=69F35848"}, {"file_name": "sc1.png", "id": "1356534795222765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031344_1356534801889431_228841040873018553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUOFNLS4JP0Q7kNvwE6Y0Fn&_nc_oc=AdpuDmnakiIuMw2QLvZYMvPcftt1JuvTFPXKDj7XRjMHtyQSg9vl1MOxCkFrxIBFGWo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0imLdLWVEu5qeu79q75r3811BwP4-R1eJbN4ZCF72z5w&oe=69F35348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc2.png", "id": "414552960941034", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615893_414552964274367_5891673864145207075_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcC2T6jV8rAQ7kNvwHTYrml&_nc_oc=AdqCkRKlRWYK-MQL4S0kzqwuCc-2kQyQffWUMP3_aYPiXAmF6lFuwq2hN-SYoLoF3sA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0q0-envLIRRcwlI-_vy4g-CnmotLaIhDctajeyTExvKA&oe=69F34D78"}, "display_name": "Katana", "keywords": [], "long_description": "Your objective is clear: slash your way through hordes of agile and cunning foes as they approach from all directions. With precise motion tracking and intuitive controls, you'll feel the power of every slash as you cut down your adversaries in breathtakingly realistic environments.\n\nUnleash your inner ninja and test your reflexes, speed, and precision in this high-energy VR game. \"Katana\" offers challenging levels, formidable boss battles, and a variety of different enemy types to keep you on your toes. As you progress, you'll unlock new abilities and upgrades for your katana, allowing you to become an even more formidable force.", "short_description": "Step into the heart-pounding world of \"Katana,\" a thrilling virtual reality game that puts you in the shoes of a skilled ninja warrior. Armed with a razor-sharp katana sword, you'll face off against waves of relentless enemy ninjas in an immersive and action-packed experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onetwoplay.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "OneTwoPlay BV", "support_website_url": null, "website_url": "https://onetwoplay.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593019457396467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com
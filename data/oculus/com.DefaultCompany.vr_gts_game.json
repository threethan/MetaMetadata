NHWzv7g_sA_j9eHx_u5vmses&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qb1O7CrmL0_AWiB07AnwwBgSICW3omwgDHn5cB5LbHw&oe=6A466878"}, {"file_name": "vlcsnap-2025-01-13-22h30m15s597_2560x1440.png", "id": "938376941756842", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391952_938376945090175_2736050455578534391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyV42Ksqgh0Q7kNvwERuk7e&_nc_oc=Adp4khROCUsGGa0aY5QjrZNwtCZG5Z9CvokyBdswnyiF_SZeeczwfB9ZqExURnw37Pw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L5wwP9QgepqVDkz6ETrUoKRfbdYdlJYzTdEgmr0zW4Q&oe=6A466426"}, {"file_name": "vlcsnap-2025-01-13-22h30m31s444_2560x1440.png", "id": "1119238099881546", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393491_1119238103214879_4431993679704694192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ga39MAtiCIQ7kNvwHBsoAk&_nc_oc=AdoxB91CUz-hJIPkdOVTRE3yrni-g2ru0Ose9Rkn_t2IHZEIrrvZ0uaDcMLbvkonL38&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Clj8ESVlxaPUyHmwlNmepSuiUCdkGUUhn413z2-sh2w&oe=6A467AD4"}, {"file_name": "vlcsnap-2025-01-13-22h31m59s071_2560x1440.png", "id": "641639515193624", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391899_641639518526957_509402194385058773_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEg1p3US51MQ7kNvwGAIyeC&_nc_oc=Adp7QOmm_sPIgIPOiusrx1IqlSH9gk6LB7YZ34e_9RkcnTAiOfUqnL1I6XHjf7Jb7oA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rFCJmLIbkqb0FPyjb5c-3n5Um61wm8IKNCukDc-vvdw&oe=6A4683D3"}, {"file_name": "vlcsnap-2025-01-13-22h32m11s579_2560x1440.png", "id": "960344882424632", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393425_960344885757965_1600943231845641938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co9G-nQ4KY4Q7kNvwED3rYO&_nc_oc=AdrjEdllXr7pL9zeZnnugvRfQt0r0qU4TjKNuS6DAj-VJL9S8mm1eKMRCIboz0liqE4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82h57cl7XgwAfWVSgkfQxkVggwxZ2W2_rGEHEK33ffvA&oe=6A4687EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Star Defender", "keywords": [], "long_description": "# Star Defender\n\n**Overview:**  \nIn *Star Defender*, your mission is to safeguard the World Crystal in a serene, engaging idle defense game. Strategically position your defensive gadgets to fend off continuous waves of enemies and keep the crystal intact. With its intuitive gameplay and uncomplicated mechanics, *Star Defender* offers a peaceful retreat\u2014ideal for both brief play sessions and extended gaming marathons. Enjoy straightforward fun without any in-app purchases or disruptive ads.\n\nFocusing solely on defense strategy, *Star Defender* eliminates the need for complex upgrades or resource juggling. Simply plan your defense, watch your devices in action, and relish the satisfaction of protecting the crystal. Whether you're a casual gamer or a seasoned strategist, the accessible design ensures a gratifying experience for players of all backgrounds.\n\n**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  \n\nExperience the tranquil challenge of defending the World Crystal in *Star Defender*\u2014a harmonious blend of strategy and relaxation for every player.", "short_description": "**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sd.codecola.uk/privacy", "developer_terms_of_service_url": null, "publisher_name": "minggu studio", "support_website_url": null, "website_url": "https://sd.codecola.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9080203488759979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392114_1976471039527983_2305534605635432702_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXYxQ8uzeagQ7kNvwEXGbBy&_nc_oc=AdoOOSaGuplhNFHmjJRZFK8QxANL8TSZf1OQ3tGvklIwjaA3fPbyM0a-9RnzJ2twQh0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94-cwRRe1qbdla9F0uO1pRVRDotwvvuSyZ8BupnqwC_w&oe=6A4673BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Star Defender", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1738908300, "lastRevision": {"nodes": [{"id": "8937868512993478", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "e
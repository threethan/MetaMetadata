zYQFuHJdm6Bv1Kk50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qju1oo7aYSBC96hwNsv98s2UGBXUILer6S_mEXwPoDQ&oe=6A1D89F8"}, {"file_name": "vlcsnap-2025-01-13-22h30m15s597_2560x1440.png", "id": "938376941756842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391952_938376945090175_2736050455578534391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh_aa0uI_iUQ7kNvwFJu4jr&_nc_oc=Adp4Ltjhqebg_OYKqIyKQXeRzJZoBhshVPmOwl5MiK-hgoOM0L-Av44YsHCg3Wr1aIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pWy2Ie-vZorIc5cfzIcoMmKyARznHC-tCsEA5PGoYfg&oe=6A1D85A6"}, {"file_name": "vlcsnap-2025-01-13-22h30m31s444_2560x1440.png", "id": "1119238099881546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393491_1119238103214879_4431993679704694192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygUztIiU6bsQ7kNvwFhVkAr&_nc_oc=Adqw1VzpFAlrQRHlooIKpOLmjooySfoFxWJc3cgtzGJcAnB6p5Wrwxbbun2yOUGPQHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YhZ21qcG3rDx1R81-SlMwVVTdHbP1kV64MpRgFEJHog&oe=6A1D9C54"}, {"file_name": "vlcsnap-2025-01-13-22h31m59s071_2560x1440.png", "id": "641639515193624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391899_641639518526957_509402194385058773_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fnK-X5zjJAQ7kNvwHDy-Is&_nc_oc=Ado2fTqHYrVQT0wBSf8bYCYJcrLgbKDc5tyRPBeVvhnnIrAkd3gegDFhIlFJSkZJp80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w4IvCR5TNzLWxv48J2TCGyAzzOuOy7rK4wJF_0oMhPQ&oe=6A1DA553"}, {"file_name": "vlcsnap-2025-01-13-22h32m11s579_2560x1440.png", "id": "960344882424632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393425_960344885757965_1600943231845641938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjLdca8UPvEQ7kNvwGvUQAX&_nc_oc=AdpQx5MWUnnHm7v2owLSvOsOuayKuaIyfra3jdc69wwM7HtZkjHbT22AQvYWvtXwSfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4__v1MEoMDnqWde9gkw-jFUyv53SRhp28Z35APBSFJyQ&oe=6A1DA96E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Star Defender", "keywords": [], "long_description": "# Star Defender\n\n**Overview:**  \nIn *Star Defender*, your mission is to safeguard the World Crystal in a serene, engaging idle defense game. Strategically position your defensive gadgets to fend off continuous waves of enemies and keep the crystal intact. With its intuitive gameplay and uncomplicated mechanics, *Star Defender* offers a peaceful retreat\u2014ideal for both brief play sessions and extended gaming marathons. Enjoy straightforward fun without any in-app purchases or disruptive ads.\n\nFocusing solely on defense strategy, *Star Defender* eliminates the need for complex upgrades or resource juggling. Simply plan your defense, watch your devices in action, and relish the satisfaction of protecting the crystal. Whether you're a casual gamer or a seasoned strategist, the accessible design ensures a gratifying experience for players of all backgrounds.\n\n**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  \n\nExperience the tranquil challenge of defending the World Crystal in *Star Defender*\u2014a harmonious blend of strategy and relaxation for every player.", "short_description": "**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sd.codecola.uk/privacy", "developer_terms_of_service_url": null, "publisher_name": "minggu studio", "support_website_url": null, "website_url": "https://sd.codecola.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9080203488759979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392114_1976471039527983_2305534605635432702_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbMi0Lj4WIEQ7kNvwFl2p8b&_nc_oc=AdrRjk7J_9dTatXr2gvSn2pQU3C30gYtSg4uR9pOoN9Hr6U7Apxi0iSYZ2FkZ4B7ZuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eJTcKtdK3J5b57pXFUD4wRDX5U3FUS3TpVuVJQgGtuA&oe=6A1D953F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Star Defender", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1738908300, "lastRevision": {"nodes": [{"id": "8937868512993478", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "
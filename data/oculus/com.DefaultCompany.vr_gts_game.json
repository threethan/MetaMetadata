a-8fjl3MKQtPzFyU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDT4ZkONzWgXI-_8IcYBZszQjPs1YpTmnLJVkRlmCJGw&oe=69CD1E78"}, {"file_name": "vlcsnap-2025-01-13-22h30m15s597_2560x1440.png", "id": "938376941756842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391952_938376945090175_2736050455578534391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jbTQEwo3HMQ7kNvwHhe_YI&_nc_oc=AdoeJqE83pVTPHNgsm6obTe2uyzFWDvI8h5gXk4JJ3CcUsRy_LALlFghwEgMoUTbUqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAkhZ-Y_Jl-o6A9WiILtbKUUod09k38tvRJ6COYFmYNA&oe=69CD1A26"}, {"file_name": "vlcsnap-2025-01-13-22h30m31s444_2560x1440.png", "id": "1119238099881546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_1119238103214879_4431993679704694192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWFr3lOiB7YQ7kNvwGMWxAN&_nc_oc=Adr4cxX0Iuh2wEtIpqW3dZ2RYviOT-8DoVTKtoe3yJ-LXcQbKsnMT_iQDfQJ-ZcuF3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw52bRU7zEtK69HoDK_8LYHizxu3y-TcE5QsfWeDdF3uA&oe=69CCF894"}, {"file_name": "vlcsnap-2025-01-13-22h31m59s071_2560x1440.png", "id": "641639515193624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391899_641639518526957_509402194385058773_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79hr6AMA4WIQ7kNvwFuFO_z&_nc_oc=AdronTBKkb7jNE1n7oZ-7MgYwZGIvCipbR-T9X5Rht17GNj7eDlqhZSjq1QsJd25XsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZFb0DTUNphkjwJCPke2l1h-N4hvFPIilRn5-huoGt9Q&oe=69CD0193"}, {"file_name": "vlcsnap-2025-01-13-22h32m11s579_2560x1440.png", "id": "960344882424632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_960344885757965_1600943231845641938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tncAvRaXXOkQ7kNvwFoLneu&_nc_oc=AdolQNANszFvOeHkSbtCw8Oqw3QanY_0AuQlguGx4EBrYgg7ujn96txzv_lcy9QGjwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2WEMAw0g1vgQp80v2uvyyHJge4CV0jjjmwFtOSCg2wg&oe=69CD05AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Star Defender", "keywords": [], "long_description": "# Star Defender\n\n**Overview:**  \nIn *Star Defender*, your mission is to safeguard the World Crystal in a serene, engaging idle defense game. Strategically position your defensive gadgets to fend off continuous waves of enemies and keep the crystal intact. With its intuitive gameplay and uncomplicated mechanics, *Star Defender* offers a peaceful retreat\u2014ideal for both brief play sessions and extended gaming marathons. Enjoy straightforward fun without any in-app purchases or disruptive ads.\n\nFocusing solely on defense strategy, *Star Defender* eliminates the need for complex upgrades or resource juggling. Simply plan your defense, watch your devices in action, and relish the satisfaction of protecting the crystal. Whether you're a casual gamer or a seasoned strategist, the accessible design ensures a gratifying experience for players of all backgrounds.\n\n**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  \n\nExperience the tranquil challenge of defending the World Crystal in *Star Defender*\u2014a harmonious blend of strategy and relaxation for every player.", "short_description": "**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sd.codecola.uk/privacy", "developer_terms_of_service_url": null, "publisher_name": "minggu studio", "support_website_url": null, "website_url": "https://sd.codecola.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9080203488759979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392114_1976471039527983_2305534605635432702_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nvp8WS743nMQ7kNvwGm2ijh&_nc_oc=Adrivu2bgob2iupbZ_hAFpgFdh9xR6EHHfdWDTDBabua8ZjHtkZq6xNUPFQHVBJksEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZq8eYL7ibh3pOCCMUcjU75lrPS4yQPqfYvU5hApJI8Q&oe=69CD29BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Star Defender", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1738908300, "lastRevision": {"nodes": [{"id": "8937868512993478", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "
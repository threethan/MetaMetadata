c_sid=6e7a0a&_nc_ohc=QL28BlBfYa4Q7kNvwFFe9d5&_nc_oc=AdlNuvH8SQDAWtcWc_dc_fJqcSoEbrnlw1vcIog0exyiiXNYPaI031Ff4zM43If7A-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvwsQDjKuQ2SQ2JznqtinUgmuYoK9AjlsD1MyMmPiQCQ&oe=69AC28F8"}, {"file_name": "vlcsnap-2025-01-13-22h30m15s597_2560x1440.png", "id": "938376941756842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391952_938376945090175_2736050455578534391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlnPIMareQwQ7kNvwGdHgNJ&_nc_oc=AdkSNgerVwT8SXQFt5Uo4F05YSC87ehi7TBzJHJqxWhIAFcuyhtgC-a1UvnA08aosvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvGCl5Dqh_2JY-MzXgEiZqFXkgtuCyrGzSPodWQ3GD0A&oe=69AC24A6"}, {"file_name": "vlcsnap-2025-01-13-22h30m31s444_2560x1440.png", "id": "1119238099881546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393491_1119238103214879_4431993679704694192_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgiNo_x3MVUQ7kNvwHepCmZ&_nc_oc=AdnElAMmzUod_DhOStqr2UjRQDKjxH7PgKrqnKFAJyZi7EzLm2OuoAlaXRB5PXdw4T0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxtBOOXTmkzVNAk2SLSWOICnq28FoAyUb4fu2GeLmWmA&oe=69AC0314"}, {"file_name": "vlcsnap-2025-01-13-22h31m59s071_2560x1440.png", "id": "641639515193624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391899_641639518526957_509402194385058773_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvSzGXQxeqIQ7kNvwGMFcCF&_nc_oc=AdnNccUnh28UwI_V76SCEyPqxBX-rQIKCCGYbBS4R1k6AdPSo51nFca4srOIQqXN_JI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlB9KAHzJq1RpSxCHSi92dHQKyCFkxMoVuTIZUsu96zg&oe=69AC0C13"}, {"file_name": "vlcsnap-2025-01-13-22h32m11s579_2560x1440.png", "id": "960344882424632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_960344885757965_1600943231845641938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsUIy2yzX50Q7kNvwG_Pyg6&_nc_oc=AdlfkA1qypSngJhpShT_2ONe3kI_x-5PIuHmrl0ux7xlPyADZz7F7PSPGHuFB1_XsZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwMOy1SJjnEl5i3joKXTBzncwQxrbNidXpWMk2kuJRyQ&oe=69AC102E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Star Defender", "keywords": [], "long_description": "# Star Defender\n\n**Overview:**  \nIn *Star Defender*, your mission is to safeguard the World Crystal in a serene, engaging idle defense game. Strategically position your defensive gadgets to fend off continuous waves of enemies and keep the crystal intact. With its intuitive gameplay and uncomplicated mechanics, *Star Defender* offers a peaceful retreat\u2014ideal for both brief play sessions and extended gaming marathons. Enjoy straightforward fun without any in-app purchases or disruptive ads.\n\nFocusing solely on defense strategy, *Star Defender* eliminates the need for complex upgrades or resource juggling. Simply plan your defense, watch your devices in action, and relish the satisfaction of protecting the crystal. Whether you're a casual gamer or a seasoned strategist, the accessible design ensures a gratifying experience for players of all backgrounds.\n\n**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  \n\nExperience the tranquil challenge of defending the World Crystal in *Star Defender*\u2014a harmonious blend of strategy and relaxation for every player.", "short_description": "**Highlights:**  \n- \ud83d\udee1\ufe0f **Simple Defense Mechanics:** Deploy devices to shield the World Crystal from incoming threats.  \n- \ud83c\udf1f **Relaxing and User-Friendly:** Easy-to-grasp gameplay for a calm, stress-free experience.  \n- \ud83d\udeab **Ad-Free Experience:** Enjoy the complete game with no in-app purchases or intrusive ads.  \n- \ud83c\udf0c **Perfect for Idle Play:** Engage at your own pace with minimal interaction required.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sd.codecola.uk/privacy", "developer_terms_of_service_url": null, "publisher_name": "minggu studio", "support_website_url": null, "website_url": "https://sd.codecola.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9080203488759979"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2068889513557554"}]}, "baseline_offer": {"id": "2068889513557554"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738908300, "status": "PUBLISHED", "id": "2068889513557554"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9064946596952335", "version": "0.1.0"}, "id": "2947601592083715", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8937868492993480", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9064946596952335"}, "release_status": "RELEASED"}, "binary_release_channels":
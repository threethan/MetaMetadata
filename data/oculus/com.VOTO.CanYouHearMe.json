uluscdn.com/v/t64.5771-25/38974738_997302058023767_4236170914291994928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhfqqeDplT8Q7kNvwHcNU4I&_nc_oc=Adqje-qTEOXQhyAg3yGaAlO3Dq-C8vu_eGMQucqDvHzU7G4OFzPTZhXs_cFIRWiyL6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85xxtAVFGW7njqkRA6mZwSOaURDq7yJ9lF0Ow6ljZQlA&oe=6A3A9AA5"}, "display_name": "Can You Hear Me", "keywords": [], "long_description": "Voice of the Oceans is a non-governmental organization dedicated to combating ocean pollution. The Expanded Voice of the Oceans project marks the beginning of their collaboration with Accenture to incorporate new tools and technologies in achieving their mission.\u200b\nThe primary goal of this initiative \"Can You Hear Me?\" is to develop an immersive virtual reality experience using the Meta Quest 2. This will enable users to virtually explore the ocean, witnessing firsthand the effects of pollution. Throughout their journey, users can interact with marine life and take actions to clean up the virtual environment. As they navigate the virtual world, they will encounter relevant content that raises awareness about the significant impact of pollution on the ocean, as well as real-life efforts being made to address it.\u200b\nSome key aspects for this approach were:\u200b Crafting an experience that capitalizes on the immersive capabilities of the metaverse; Engaging users by bringing them closer to the reality of a problem that is often distant; Presenting pertinent information to raise awareness about the scope of the problem and potential solutions; Encouraging users to take action within the experience and prompting them to take real-world action as well.\u200b\n\u200b\nKey Results: \u200bAbility to collect data on user engagement levels throughout the experience; Development of an experience that will be accessible to people worldwide via the Meta Store; Establishment of a long-term strategy", "short_description": "Every minute, two garbage trucks full of plastic fragments are dumped into our oceans, contaminating the environment and killing marine life. Even when downed, injured, and gasping for air, animals keep crying out for help.\n\"Can You Hear me?\" is an immersive experience that takes you deep into the ocean plunging you into this urgent problem: Listen to the voices that rise from the ocean's depths.\n\nIf you are part of the problem, you can be part of the solution."}]}, "developer_name": "Accenture", "developer_privacy_policy_url": "https://voiceoftheoceans.com/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "contato@voiceofthoceans.org", "support_website_url": null, "website_url": "https://www.accenture.com/br-pt", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6987958794586088"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7158616420853657", "version": "2.5.5"}, "id": "1061994278310159", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6818170608231575", "is_concept": false, "latest_released_binary":
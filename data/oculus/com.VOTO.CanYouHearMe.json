7kNvwGDZfAE&_nc_oc=AdrPbxcWg1bp-gZzByS1EDd7CPOYWqT14-YqoNxGe2a0jCZaE-R0Yv4xOFCSs4PUJRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__1Gt812k8UHxwnCwwSgXK_zFkVVJah_Sp-MV9Xn3ajw&oe=6A3AAF11"}, {"file_name": "Captura_2.png", "id": "1307830473043303", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86665761_1307830476376636_5673800190086255214_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLmnP5XFdswQ7kNvwGiVcDx&_nc_oc=Adq2nkrOqoaUngLE-9f8Y9F344IKsB4-K3tYAXEVAzqtqvEflhyymMkPBDnVc9qtcnc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-93ZUcT3FdR3RUh6WZ-2SGNP4b0Y-FzeCqQQ8RUWzs5A&oe=6A3A9675"}, {"file_name": "Captura_3.png", "id": "1075993950080480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974914_1075993953413813_6985491305993052925_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYDz2d210pAQ7kNvwHRIJ9J&_nc_oc=AdqDWwk2l0OIDC3UwVIH4Cz7a2O-ofnoG5W0ni366n8fpL6sRWLvM1tWkFNeTuhlc-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tpa_OmHSOzDLbnNU3qZH91zRbyOpEqBukUw6LLSzaCQ&oe=6A3AB154"}, {"file_name": "Captura_1.png", "id": "1061509361929881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_1061509365263214_235575179153559422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgGRzqQesJYQ7kNvwGCEKzs&_nc_oc=AdqrIM1D7zUI7pS41sExrySs9BacbfbPUxgHfZ_fQpjuDmykA2Pd3jdUIcm4ImpKKS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BnvAtg_eLtFGsYclbKTusogyg8uex6ZOHRhqIW3uLYQ&oe=6A3AB64E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "997302054690434", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_997302058023767_4236170914291994928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhfqqeDplT8Q7kNvwHcNU4I&_nc_oc=Adqje-qTEOXQhyAg3yGaAlO3Dq-C8vu_eGMQucqDvHzU7G4OFzPTZhXs_cFIRWiyL6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85xxtAVFGW7njqkRA6mZwSOaURDq7yJ9lF0Ow6ljZQlA&oe=6A3A9AA5"}, "display_name": "Can You Hear Me", "keywords": [], "long_description": "Voice of the Oceans is a non-governmental organization dedicated to combating ocean pollution. The Expanded Voice of the Oceans project marks the beginning of their collaboration with Accenture to incorporate new tools and technologies in achieving their mission.\u200b\nThe primary goal of this initiative \"Can You Hear Me?\" is to develop an immersive virtual reality experience using the Meta Quest 2. This will enable users to virtually explore the ocean, witnessing firsthand the effects of pollution. Throughout their journey, users can interact with marine life and take actions to clean up the virtual environment. As they navigate the virtual world, they will encounter relevant content that raises awareness about the significant impact of pollution on the ocean, as well as real-life efforts being made to address it.\u200b\nSome key aspects for this approach were:\u200b Crafting an experience that capitalizes on the immersive capabilities of the metaverse; Engaging users by bringing them closer to the reality of a problem that is often distant; Presenting pertinent information to raise awareness about the scope of the problem and potential solutions; Encouraging users to take action within the experience and prompting them to take real-world action as well.\u200b\n\u200b\nKey Results: \u200bAbility to collect data on user engagement levels throughout the experience; Development of an experience that will be accessible to people worldwide via the Meta Store; Establishment of a long-term strategy", "short_description": "Every minute, two garbage trucks full of plastic fragments are dumped into our oceans, contaminating the environment and killing marine life. Even when downed, injured, and gasping for air, animals keep crying out for help.\n\"Can You Hear me?\" is an immersive experience that takes you deep into the ocean plunging you into this urgent problem: Listen to the voices that rise from the ocean's depths.\n\nIf you are part of the problem, you can be part of the solution."}]}, "developer_name": "Accenture", "developer_privacy_policy_url": "https://voiceoftheoceans.com/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "contato@voiceofthoceans.org", "support_website_url": null, "website_url": "https://www.accenture.com/br-pt", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6987958794586088"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_309353205383063_5981862094433805149_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkKTcDMwARsQ7kNvwFRGVak&_nc_oc=AdosTBZlyWM8bFy3ARYcDKpPXssylpJ_j7HKEddn8mwQWtPoLV-gWi6Rt6WfjuJ-eIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_eymF3YvN_DcaEz5WD6rc4y5zSumn8PIevShfxKRl7w&oe=6A3AB770"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Can You Hear Me", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1702668600, "lastRevision": {"nodes": [{"id": "6818170641564905", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_lo
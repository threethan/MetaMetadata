c_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqBb_Cz3VNyVS1gX8jCbk9GfT7QDgcwuGXsgRWCWxa2Q&oe=6A7C452C"}, {"file_name": "migrated_image.png", "id": "2614702835464427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727931_1885549548355508_7510415208058191872_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmNlxEC78iIQ7kNvwHn230_&_nc_oc=AdoToyKrXI11qd29ZrJmU-S9EPHNazNnlNyEsmFD5hADSl0Ns_Vo9b3mlkFOAqH2E9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZa0HIJ1MWVWax-7iOyauoWBO0rd54PvMsTCTzTxWlSQ&oe=6A7C6B15"}, {"file_name": "migrated_image.png", "id": "544421042881208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602284_190388158127198_8037412647374684160_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwhnepsdju0Q7kNvwFhr-wW&_nc_oc=Adr-3e73KPo8KDuh6Pkp5cbXTXlNgoVecqkGpOjSoBBEKSHoKBrnHn9pzb76b7Sa6L8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoLMXzuDfKFv6XTqOcctgYydIGu4lgZ3i-i8KOgj_k2A&oe=6A7C70FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vlisco", "keywords": ["Fashion", "Clothes", "Design"], "long_description": "Entrez dans le monde color\u00e9 de Vlisco et d\u00e9couvrez comment nos tissus de cire sont fabriqu\u00e9s.\n\nVlisco fabrique des textiles aux Pays-Bas principalement pour les femmes africaines, qui portent ces tissus pour exprimer leur style individuel et communautaire. Fonde en 1846, Vlisco a maintenant une collection riche de 350 000 textiles uniques. Les designs audacieux, color\u00e9s et surprenants viennent \u00e0 la vie en raison de la beaut\u00e9 naturelle du processus d'impression de cire, faisant chaque yard imprim\u00e9 unique.\n\nD\u00e9couvrez cette vid\u00e9o unique de r\u00e9alit\u00e9 virtuelle qui vous emm\u00e8ne dans notre usine d' Helmond. Entrez dans notre environnement de design o\u00f9 vous verrez des designers en plein travail et faite un tour parmi nos machines sp\u00e9ciales et d\u00e9couvrez nos proc\u00e9d\u00e9s magiques. D\u00e9couvrez pourquoi les tissus Wax Hollandais ne peuvent \u00eatre que Vlisco.", "short_description": "D\u00c9COUVREZ L\u2019USINE VLISCO"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.scopic.nl/", "developer_terms_of_service_url": "http://www.scopic.nl/", "publisher_name": "Scopic", "support_website_url": null, "website_url": "https://www.vlisco.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "902748427054646"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1314210481966870"}]}, "baseline_offer": {"id": "1314210481966870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1492016400, "status": "PUBLISHED", "id": "1314210481966870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1239721416075441", "version": "1.1"}, "id": "382710958778825", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1233634056684177", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1239721416075441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "382710958778825"}]}, "change_log": "enabled app to show volume indicator and replace audio en
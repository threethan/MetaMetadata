t=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmVgbtohzz6M6S6GtQ4-M4sjIZ3Msxyeq0d9-WTv20Gg&oe=6AF47C56"}, {"file_name": "Custom dimensions 2560x1440 px (11).png", "id": "1209144200692376", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297059_1209144204025709_6430856179699557481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STGgzWYY1tYQ7kNvwEKRVOC&_nc_oc=AdpyM5bYEDygK19Sxy7wGZlVCG2zaoe9RQBWV60rbs9SssY-4d93HU515MXv_ToENu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmZCkbNpjkP4aq_n9KTWhN8WfRBSoGUVewRPgND2H3MQ&oe=6AF4A41B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TACTICAL TAG", "keywords": [], "long_description": "In TACTICAL TAG, locomotion is a unique and physically engaging system where players move by using only their hands to navigate the virtual environment\u2014just like a gorilla would. Instead of using joysticks to walk or run, players push themselves off the ground and surfaces using their VR controllers, simulating arm-powered movement. This form of locomotion creates a highly immersive experience and requires actual physical effort, which makes it both fun and a workout. The game\u2019s movement system relies on physics-based interactions, so mastering techniques like wall climbing, branching (swinging through trees), or vertical scaling takes practice and skill. \n", "short_description": "A Gorilla Based Game using a Movement Locomotion System that you have to swing your arms to move around!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tactical-taggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAGGERSTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/tactical-taggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781
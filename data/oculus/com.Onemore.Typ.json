https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499301541_594308027034488_4893675478839727338_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaGRAJ7qFssQ7kNvwHoOmOU&_nc_oc=AdpHRih3-09qVEF-yCKc_tU1pR0kh465AuLiJmHtac0-Yst2G5cfSHZaVCAD5O7W8lU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShpEU3Tw8R9LKw_dfCbPKlRARnq3vIQLFASnJ2S04T1Q&oe=6B09CC96"}, {"file_name": "Custom dimensions 2560x1440 px (11).png", "id": "1209144200692376", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297059_1209144204025709_6430856179699557481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mfSoSPjE2QQ7kNvwGM0-Is&_nc_oc=Adrmr7sbOFVvfxaMwloxKuR6rCKCAPhd_VoBFO72qvMF60TXJNnysu3qsATPBATRw_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNHP-EqBmrgvNEkpXqlYPxZMTkk0jAq7X4YvMQZvVubQ&oe=6B09BC1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TACTICAL TAG", "keywords": [], "long_description": "In TACTICAL TAG, locomotion is a unique and physically engaging system where players move by using only their hands to navigate the virtual environment\u2014just like a gorilla would. Instead of using joysticks to walk or run, players push themselves off the ground and surfaces using their VR controllers, simulating arm-powered movement. This form of locomotion creates a highly immersive experience and requires actual physical effort, which makes it both fun and a workout. The game\u2019s movement system relies on physics-based interactions, so mastering techniques like wall climbing, branching (swinging through trees), or vertical scaling takes practice and skill. \n", "short_description": "A Gorilla Based Game using a Movement Locomotion System that you have to swing your arms to move around!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tactical-taggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_n
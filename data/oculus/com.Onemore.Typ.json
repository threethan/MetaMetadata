n.com/v/t64.5771-25/499303551_731416285999855_5629680872314218804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFGzOpcew6oQ7kNvwG_ZVTe&_nc_oc=AdlKzgL63nrr7R4_1wBYUd5XL4Ht3HwKaLn2d9HFtaroVquIgWTaGr-oIAGq2CcSxgM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfveHDQrc8YlK18a5qHeHzZXrqrSbTL1PgIKg6_O31ComA&oe=69A58D9A"}, {"file_name": "Custom dimensions 2560x1440 px (15).png", "id": "594308023701155", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301541_594308027034488_4893675478839727338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hC8Cn6DEssQ7kNvwG9lavh&_nc_oc=AdkqSSXgzdrAhOTNE0KleckZIpGe1GDCGgplGcD0vM_vcl1Jydiz2K-DCvH8eOpYWJ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv4e7E5FS_RvOCsL265cmfhgpje6JWBJnH-cUnrp6-caA&oe=69A59F56"}, {"file_name": "Custom dimensions 2560x1440 px (11).png", "id": "1209144200692376", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499297059_1209144204025709_6430856179699557481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJUjq8JAWpsQ7kNvwF18tpP&_nc_oc=Adm_FAxagKLLnfNHzhXCehE2i8ioprpfZdVhDvhfq56C6YpQrnJcu9NO7nNQai8OeJA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuVq1On0Of0QjuGNn_sSBpzM7EdIL2uySas3628EwkVkQ&oe=69A58EDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TACTICAL TAG", "keywords": [], "long_description": "In TACTICAL TAG, locomotion is a unique and physically engaging system where players move by using only their hands to navigate the virtual environment\u2014just like a gorilla would. Instead of using joysticks to walk or run, players push themselves off the ground and surfaces using their VR controllers, simulating arm-powered movement. This form of locomotion creates a highly immersive experience and requires actual physical effort, which makes it both fun and a workout. The game\u2019s movement system relies on physics-based interactions, so mastering techniques like wall climbing, branching (swinging through trees), or vertical scaling takes practice and skill. \n", "short_description": "A Gorilla Based Game using a Movement Locomotion System that you have to swing your arms to move around!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tactical-taggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAGGERSTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/tactical-taggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9868435779860123"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9683886614981708", "version": "0.1.0"}, "id": "1427609462012450", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9683363235034046", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9683886614981708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1427609462012450"}]}, "change_log": null, "created_date": 1753489039, "id": "24133875546222908", "version": "1
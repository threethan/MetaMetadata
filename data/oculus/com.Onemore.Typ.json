t=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt_q3A3ToprKJ_wFTUBMFL-M-udN_KCNAUQDYjVmVJaA&oe=6AA16DD6"}, {"file_name": "Custom dimensions 2560x1440 px (11).png", "id": "1209144200692376", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297059_1209144204025709_6430856179699557481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlocuRkYSvMQ7kNvwFi2qAf&_nc_oc=AdpDugdW5tJ6boOxreHYmng2rPcyQlcWSTeuEItatayMIOP4mpimKG5hFDUN9InKYr8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhA8UBAqVM2PbbzSPZ5BUhjHiM7Gxg0JUM8GdIElVr_w&oe=6AA15D5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TACTICAL TAG", "keywords": [], "long_description": "In TACTICAL TAG, locomotion is a unique and physically engaging system where players move by using only their hands to navigate the virtual environment\u2014just like a gorilla would. Instead of using joysticks to walk or run, players push themselves off the ground and surfaces using their VR controllers, simulating arm-powered movement. This form of locomotion creates a highly immersive experience and requires actual physical effort, which makes it both fun and a workout. The game\u2019s movement system relies on physics-based interactions, so mastering techniques like wall climbing, branching (swinging through trees), or vertical scaling takes practice and skill. \n", "short_description": "A Gorilla Based Game using a Movement Locomotion System that you have to swing your arms to move around!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tactical-taggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAGGERSTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/tactical-taggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781
https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301541_594308027034488_4893675478839727338_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaGRAJ7qFssQ7kNvwEo_YwH&_nc_oc=Adp3V1zKYORzdntV162Zq2-VmJnDyU_M4iuleXdRFXyR5o48gZfRNFzFo1CMFq1IUcw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTiU2LgNynR6haW0khhvoTTx7F9QywiawSwK7_k_oEQg&oe=6B0842D6"}, {"file_name": "Custom dimensions 2560x1440 px (11).png", "id": "1209144200692376", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499297059_1209144204025709_6430856179699557481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mfSoSPjE2QQ7kNvwEiVPoF&_nc_oc=Adq3Ymy5ieYYnriE2En5zORTVWLxmdpII2TwKbFeujKsG0V0sCPe2lzypTSzV1-M2bA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkQsWWShvk2lkmUlnKnAkncT4BPgUK07Q81seypXb33Q&oe=6B086A9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TACTICAL TAG", "keywords": [], "long_description": "In TACTICAL TAG, locomotion is a unique and physically engaging system where players move by using only their hands to navigate the virtual environment\u2014just like a gorilla would. Instead of using joysticks to walk or run, players push themselves off the ground and surfaces using their VR controllers, simulating arm-powered movement. This form of locomotion creates a highly immersive experience and requires actual physical effort, which makes it both fun and a workout. The game\u2019s movement system relies on physics-based interactions, so mastering techniques like wall climbing, branching (swinging through trees), or vertical scaling takes practice and skill. \n", "short_description": "A Gorilla Based Game using a Movement Locomotion System that you have to swing your arms to move around!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tactical-taggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_n
&oh=00_AfyMGaSb_PFYqTdxaXt-cQgW2wA1rSSm-R-I8qShj2CGTw&oe=69B02B56"}, {"file_name": "Custom dimensions 2560x1440 px (11).png", "id": "1209144200692376", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297059_1209144204025709_6430856179699557481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNSkrWLw2UIQ7kNvwEVSAT3&_nc_oc=AdkVjy150XfhDjiCVHW9XHPO08Bx9NdhsM-qcJp_O7XvHmcfrgjQ_Bz6YyPAb_HtwDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl8XnihTM4BxE-Lt_4Vsw4FPvGM11cGv7_zcHCtdk7xw&oe=69B01ADB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TACTICAL TAG", "keywords": [], "long_description": "In TACTICAL TAG, locomotion is a unique and physically engaging system where players move by using only their hands to navigate the virtual environment\u2014just like a gorilla would. Instead of using joysticks to walk or run, players push themselves off the ground and surfaces using their VR controllers, simulating arm-powered movement. This form of locomotion creates a highly immersive experience and requires actual physical effort, which makes it both fun and a workout. The game\u2019s movement system relies on physics-based interactions, so mastering techniques like wall climbing, branching (swinging through trees), or vertical scaling takes practice and skill. \n", "short_description": "A Gorilla Based Game using a Movement Locomotion System that you have to swing your arms to move around!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tactical-taggers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAGGERSTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/tactical-taggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9868435779860123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301100_931476352324834_7644026485320698201_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjdIMHmOiqMQ7kNvwG12Sj0&_nc_oc=AdkeL9L9i__IKUe9qjh96KSnGSo2g9ZDLkRoNvhLKYL0uXCo2YgJS2lzyMT22CqkkTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfxWqEXFyOzhvI4dA9JZKSCgNFBM0iBL6l9KqlvF22Ng&oe=69B029EF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TACTICAL TAG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1747668780, "lastRevision": {"nodes": [{"id": "9683363265034043", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9683363235034046", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1575686349794683"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Custom dimensions 2560x1440 px (4).png", "id": "1499427411462638", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307555_1499427414795971_7517065915860027006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nbuJAJoQSkQ7kNvwFe2hO4&_nc_oc=AdmdIQVds8TGK7h0rb3WDsLnV6p_gNTLrtx4d2GfaYfn1uwds3Pryn8ItkiBy1xAmfE&_nc_zt=3&
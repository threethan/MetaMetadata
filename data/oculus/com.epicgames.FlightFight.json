332_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcdSvzE72uEQ7kNvwGFqKML&_nc_oc=Adpkx5TnVk_eWETxTgYbtaTAbYxZrZRJbvWXuFWhHAzw-IdIJmG5eQCFqp9TB4xoMpE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zkFrEarXz8loqVxLcGO8zBotKjd41slhWSDR8fHuq6w&oe=6A11C568"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXAtLz1awlEQ7kNvwE8mlvj&_nc_oc=AdpOgXMupKLRo5iLeypgAmrRSEC883O_m0pTNwpIix-eyP2ojQ62pznioIivKEhSmI4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-OKnS6lsOPxCln5_G7IiJ7CfLMZR2IpDzLeGU1g1nyw&oe=6A119B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5tBqJEyYPMQ7kNvwGVnZ_6&_nc_oc=AdpFffMPvGG65wRGB4QQKRkt0Q8qpjDWVZufCWcG9OjKZiLz58S1Qv5xD3ZGR-HZz9Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uwqW7EfSeXZEUN5xbpfKNBh9G7JXhj2eT3L6hHj2Xpg&oe=6A11B920"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/"
332_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uVpmZv-YzwQ7kNvwGoM0WP&_nc_oc=Adqr0ftBgZethyD1cw_jQHu0Xygha_377-vdF_ElnWMWotyBXzYYzO9Cq7nfSjsqAmo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nEtJFPtY8gChS_-bjzbu8ftyOmzQdi8EcC56OQZeJYA&oe=6A468168"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNr1e4-X6FEQ7kNvwFBzGfx&_nc_oc=Adovg5iPqF9-fReSpbmQkU3zvDKj0A2lGk0y_w1w4EE1vpSeHaVcg9IEblGKY6Gt4pM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BdRU7bfxEuWJb5epVO30b_myEGHD7RjY-TMGdBIDnhQ&oe=6A46576D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsO_edB6hfUQ7kNvwGoodpE&_nc_oc=AdpNN4jythU6nwzC0wCqSsAg7hVS-7IVx5H5JdDC8Ttoy72WUL1FbCvKTXkjOqWRoCU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ByaWB8DtZvnG18kMZil0Bs9AUAMNaC2cu2q_9bnlk_A&oe=6A467520"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/"
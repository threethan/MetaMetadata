y_lasers.png", "id": "729219081867908", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75588062_729219085201241_3095610675441618841_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwgil4QqaOoQ7kNvwFsDfrX&_nc_oc=AdpL5qecxTyOyYQLyP4UgQ3LSM7JHQmRfHvxd_vTeaZc0tEDXnBbmIezAbJFhA-loHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc5rUVrjO_Io2tcZaMoliwoDg5KT1WKS54GCJfrJIczg&oe=6B09BF00"}, {"file_name": "ghost_guns.png", "id": "1530926941068547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031403_1530926944401880_2598950862508915332_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TORYg0AgZw4Q7kNvwGSVV3A&_nc_oc=AdowEVPoyYmNfsBUm0cnHem3Z48dn0RC1HYoQBcmgEGUaCJNCACu8v-GFg-1KmJHeqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_PIhENG39sOTRw5TQkCR4GwvNr-zTzkZcL9KWXzYARg&oe=6B099F68"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMTzW1EqoZ4Q7kNvwEAOKgH&_nc_oc=AdqPL5lKbzx68vDOelbV5GRkD4fV7Y6K11TBNsY7oFz7az_gMdGk_5jgPwrLWm4RReY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgECqe7dp8JCTyjJsyZ_zK_Z1nVYkbn8UgQSXGZARZEA&oe=6B09ADAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InvzJGgmwdcQ7kNvwGW2uAu&_nc_oc=AdrFVlX34oZvQox50Vr9H0pE0by5UMhLFSKqARdkx8HrMFElekBSTMOonvnfgIDDGl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgo5eI4D0XeHmsY1H2BM7-Xz2PhBqH3nWv_lth3QqBwQ&oe=6B09CB60"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.allegory-xr.com/terms-of-service", "publisher_name": "Allegory XR", "support_website_url": "https://www.allegory-xr.com/contact", "website_url": "https://www.allegory-xr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7084882874903229"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9530911920300300", "version": "022625"}, "id": "1831876633872356", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false,
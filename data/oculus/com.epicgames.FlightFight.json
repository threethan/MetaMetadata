332_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXd0iO5ixhIQ7kNvwFNStNt&_nc_oc=Adpz3sFwiBOL-wPvmBJcPO26SZ6VP4b8j7GAKql-Ex16ItmEPaHpUXMuJH9ufqFD0Jk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fvsPiWRXJD-jLDf50n9CP1x7s7zLi3Rm74o9p8r0q1A&oe=6A22E8E8"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjcawW-wdNcQ7kNvwE1687G&_nc_oc=AdpSk-w9eSNVBcpYOKicjotvUui9uS2tJQodF3K3dbyexGncCnPlGgDszIBAmSamlbE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I5NjsmvkL_oyCAE8gnvA4rNMi_M8rFwaFES1DcVFu0w&oe=6A22F72D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uifoiHZJjYQQ7kNvwEkqAjc&_nc_oc=AdrD_lMlfZoiApuAS08nKxDqr-wqbCvTWmtDKiXObRhpLk78VxYtYmfPc34xWZVW9dA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85THb64vwNO-wUkW_T9xc39iK_3fN-A8vJfhqgMrSh3A&oe=6A22DCA0"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/"
332_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBNO16GIBVAQ7kNvwFxzfVW&_nc_oc=AdoXD_b3t4DVDz2GEtWzFDy9u6FZjfGjQ8QIvg_qern-uRapEEYUm6m4iIVXV5iUSNA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7-ZzjBMYtpvUCZrsGqhAcPd6DVWKGiZWfRun8jjRBgQ&oe=6AAEA7E8"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teUBT4XOi3EQ7kNvwEXYPln&_nc_oc=Ado_MCpAu6oQirCc7QOIV9Ny37Z9OHGAIavSfWq_ivieRKKY5FTYvcWaM5BED8GPxWw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxrH72lzwh8yzy9NvkKIidtIyJ-_MT285-fJRzmUjhgA&oe=6AAE7DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWN2dXq0l1MQ7kNvwFc7X-4&_nc_oc=AdoQRItpL88lDQ9jyLnUOHBEWJq32KGORHqeCyfPFUBo37DfInlclgU5or_0Mx6i5sg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOJZt1mTWOid_98_OYkpG01WeRguLKPXFsTDEbLbjVzw&oe=6AAE9BA0"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/"
": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5rqNSiCoG8Q7kNvwF-lMvL&_nc_oc=AdlJOxTPO9RyEzYvr7Q5vlo4VO-8SYvV72SoboJU1ajZ8OjZ2cXVZ_HrlgeTp6s5B5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBTft84-QemKJhFrTvIBvXS5jpladxCTR5crKwTl0GmQ&oe=69A03A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=po3dO2P588gQ7kNvwFKJB6J&_nc_oc=AdmgG5JJORxX9ncXi9gOtj0BhlNQpS3hRT3SGeUk3tiUwW5_SOLlLHSCZh_Pf56CM8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupwxW9YxpjGc7fNqS48C-vnmTgf2nLNPbCyMQLv5tReQ&oe=69A05820"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.allegory-xr.com/terms-of-service", "publisher_name": "Allegory XR", "support_website_url": "https://www.allegory-xr.com/contact", "website_url": "https://www.allegory-xr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
y_lasers.png", "id": "729219081867908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_729219085201241_3095610675441618841_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jGjVd9teTAQ7kNvwH8A4UP&_nc_oc=AdqYYZFitd-nkgiq_geLdfVFaMQtBV8jxPeFeeSU1uDGp1Th1VxMp--QUKU1rxWUlho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSYfSRQMPlHcr-STGYTCXv0aNQ4w6qgKd9FmewHtDz7w&oe=6B047900"}, {"file_name": "ghost_guns.png", "id": "1530926941068547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031403_1530926944401880_2598950862508915332_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amnFvL98iXIQ7kNvwG4ubOW&_nc_oc=AdqjrxfoRgVUdWXL-_YNHDLPYVBwdBZ4nXPqXapJyFeEXumNSdxUUBK2C6kgz6bWWrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO0JEx8Saj1jmMC5elNo17KH4roq4jILoB4QDCVUyQ-A&oe=6B045968"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DabDoDiHcp4Q7kNvwEWJu1N&_nc_oc=Adqw8tTQ1iE6jw4OXc9O7ADi5g_c5eEvmpj58jAKs8IFVFnKk5vY04eaTkEY_rek2EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3KB6uPdDL1Prj90zDaX55InrfSI9uYijkfM2OTIcucg&oe=6B0467AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw-16uHSHvcQ7kNvwHC012I&_nc_oc=AdpHSwXO3as9_EL9DHkU5uWrw4xW0W2nC3k6TM4JHMGWoHmS9KgC3R0DY5Wn9yMl_pQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjNnTqeUk8RT9MuiB7FVx--escEhPtfmIAT0HAGaRCHA&oe=6B048560"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.allegory-xr.com/terms-of-service", "publisher_name": "Allegory XR", "support_website_url": "https://www.allegory-xr.com/contact", "website_url": "https://www.allegory-xr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7084882874903229"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9530911920300300", "version": "022625"}, "id": "1831876633872356", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false,
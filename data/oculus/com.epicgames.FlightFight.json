332_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMqzALC2-CgQ7kNvwG2wcir&_nc_oc=AdrB0MMYVWcorMDSaMVaYwPuabHw3rtETKeN8wjaHJWUPZXrSMGvNlq0pOnN_u2L6ao&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL42OORmkyZ18x8HT_5mHxP-F4AF7ij3nA-HigNxDL2g&oe=6AA41BE8"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CuFpSoO5HUQ7kNvwG4_hDT&_nc_oc=AdpLh_JBHvbBTFgDywflMK0c1H3oN2m-rwiuOr9I3VrUNcF4ZXG19IkVw_doNfk4eKQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaZgko1u42Kvbgc4Y_M702QotFfR7e3XeBZRKe3rgcNg&oe=6AA3F1ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GBYnsY89OQQ7kNvwEFyBhq&_nc_oc=Adp1J8HX4DBWePesIPNYZ2athV-mYvGARFnOu7elfNh0GC0kQPgLpif845EacH6eOUQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaWTdlh6s9QsocmpoWcSi9N9lZaLbP9q2seDRNjrzBRA&oe=6AA40FA0"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-pounding aerial battles in this multiplayer physics-based flying combat game. Use your wings (arms) to flap, soar, glide, twist and turn in any direction. Predators must work together to track and shoot down the Prey - while the Prey must use their flight skills to finesse through obstacles and juke out incoming Predators. Your wings are super responsive so the movement is easy to learn but also very versatile. Conquer to the skies. ", "short_description": "Use your wings to flap, soar, glide, twist, turn, dive and shoot down other players in epic aerial battles. Fly or die. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.allegory-xr.com/privacy-policy/"
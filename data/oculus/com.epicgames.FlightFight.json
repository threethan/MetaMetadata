y_lasers.png", "id": "729219081867908", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75588062_729219085201241_3095610675441618841_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFnCjTEAjkMQ7kNvwHvHqRV&_nc_oc=AdqDqwG1a5vI_ruDKqomVcPw3CweE92M4nOItu3TQKXuHbMTv0JX69hVHJF0ci6x4sk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUpPUeo1ZM2s2imQPhGH5AI3dr-xQ7jz83qMYL4V_LTA&oe=6B086D80"}, {"file_name": "ghost_guns.png", "id": "1530926941068547", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031403_1530926944401880_2598950862508915332_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyYhCxoAzf8Q7kNvwHoZVWi&_nc_oc=AdqCEsdRk6g-W5hC7g_XTVf8CGDTg_S48Y9tBchxapSvy1yKjqSRA5F_nfofAul0MJA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmiwSLa0Pfp8FFRIWo4fNW7y1nSDJEQ6Tjb2tXSfufQw&oe=6B084DE8"}, {"file_name": "tunnel_lasers.png", "id": "900347214989305", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974523_900347218322638_3072419956379973379_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMTzW1EqoZ4Q7kNvwGWKxOE&_nc_oc=AdoRL-ts0M6Qhi4r_-Lgn5ZWSJephl-jaQUiqmypNSjxgD58hnk8MV73uJoMcqhPJ2c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXf84EWgMnePr710fRM-lYJLSsi1wtluCEorCLeU3mWg&oe=6B085C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_landscape_f2p_v2.png", "id": "993932871839479", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580069_993932875172812_1981840981276440823_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InvzJGgmwdcQ7kNvwFERtED&_nc_oc=Adq1aAAoJLTyhCx75SC2Rlg9Z1mZSz7bF_sXPe7p6NmO2dUzcCqZ_zkmSiclh9ohLp8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXpT13bjhbg0T0vvVwVGDGXxGiB2_E3HTqGTwEGtgyLw&oe=6B0841A0"}, "display_name": "Flight Fight", "keywords": [], "long_description": "Get ready for heart-poundin
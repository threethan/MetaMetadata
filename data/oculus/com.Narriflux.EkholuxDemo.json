s://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1495693091453369_3297324790879624570_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7SB5V-pNacQ7kNvwFsRDws&_nc_oc=AdoCb0HgpQi_YdfcWbnXQ41_DSuOPxZKNmg4PGfcI4wo73Jy1uSNd1Tt6LtnF3o-qI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lSER5IbcTk89aK58IPpjohlZOCuFfKMAo4YjUueBv5g&oe=6A18592E"}, {"file_name": "GameScreenshot03.png", "id": "1448617639526004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_1448617642859337_3603903853186903969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVAnEKTJw5oQ7kNvwFScVnv&_nc_oc=AdqkLNyZ9ZEmS_tbFjILgqqS2xJViu9mVsFx3grC6XYwCE4kxRTOfxQFvzn-wWY6MHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mNQEOb67CjhGVh08M9OA36PAkQAy9Z70opz2xmmJ_XQ&oe=6A1856EC"}, {"file_name": "GameScreenshot04.png", "id": "1310144190602489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_1310144193935822_5838368232913063398_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfVHnK4PdYcQ7kNvwGJ3ksI&_nc_oc=AdrgLGNNfbIFCeTf5fpHEHWu6_vHOM4loHkBwl8Z75WfI0M25LZoNHguixYzhO8fxqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gp_PUeJ5_cK6L-wyo0hCiIXBj20AWc_hTyAQSxltpxA&oe=6A1844F2"}, {"file_name": "GameScreenshot05.png", "id": "650649180986019", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618069_650649184319352_82050891026808090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-KNilSF7hkQ7kNvwGY5hX0&_nc_oc=AdrwECJPNSLh-qfxhWXqUvFjUZyjRfBf51-VsJLvphIEX6bKduCqKt824_PmMOwPG3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af712MhQKMGhNoC7JqNGM4yTXi8ioK8YMiRw0pAZ4vSuIA&oe=6A184FAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "1491354815384832", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620875_1491354818718165_6657141868492466243_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj9ZxzGQkBgQ7kNvwE32ZO4&_nc_oc=Adp5oShazt6hMs95m4ZO4cJCtuZigIOG2zukHzZJsikro5ZvY4RHghqXBhqT5F5WL4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FvPul7oaNU5rye6yJjrP7hSVGpT7tqBzyZyGjOAJz2Q&oe=6A1833DE"}, "display_name": "Ekholux Demo", "keywords": [], "long_description": "# Ekholux\u2122 \u2014 A VR Shock Unlike Anything You've Experienced\n\nStep into a world fractured by meaning, where the puzzle isn't just mechanical\u2014it's embedded in your flesh.\n\nUnlock sound-reactive puzzles. Shatter obstacles with motion. Race across gravity-defying rails in a sensory gauntlet that tests your reflexes and redefines immersion.\n\nCrafted by internationally awarded VR artist Hsin-Chien Huang, Ekholux\u2122 fuses the cerebral thrill of escape-room logic with the visceral rush of extreme movement\u2014engineered for those who crave a new kind of full-body storytelling.\n\n# Puzzle Mode\n\nIn a realm twisted by echoes, sound isn't just a clue\u2014it's the language reality runs on.Harness your Ekho Capsule to activate dormant systems, reveal hidden paths, and recover fractured memories buried deep within corrupted architecture. This isn't just a puzzle\u2014it's a confrontation with the remnants of human consciousness.\n\n# Extreme Sport Mode\n\nAfter every puzzle sequence, the tempo spikes. You're propelled into a velocity-fueled run through high-speed rails, carving across zero-gravity curves\u2014every twist synced to the pulse of electronic sound. Blending the raw thrill of parkour, skateboarding, and snowboarding, this is more than motion\u2014it's an otherworldly adrenaline surge. No gear. No brakes. Just your body, your rhythm, your courage.", "short_description": "Ekholux\u2122 is a mind-bending VR experience where language collapses and motion speaks. Solve sound-based puzzles, break through walls, and race on gravity-defying rails. Created by VR visionary Hsin-Chien Huang, it\u2019s full-body storytelling like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ekholux.com/privacy.php", "developer_terms_of_service_url": "https://ekholux.com/EULA.php", "publisher_name": "NarriFlux", "support_website_url": null, "website_url": "https://ekholux.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24391755107192411"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4046884565621627"}]}, "baseline_offer": {"id": "4046884565621627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759561200, "status": "PUBLISHED", "id": "4046884565621627"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25199768643057716", "version": "13"}, "id": "934901795519330", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24248062094895047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25199768643057716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "934901795519330"}]}, "change_log": "\uff0eFixed an issue where the menu pointer would appear completely black.\n\uff0eFixed an issue where the incorrect skybox was displayed in the title scene.", "created_date": 1766747134, "id": "25199768643057716", "version": "13", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25199765619724685"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24248062094895047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25199768643057716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "934901795519330"}]}, "change_log": "Ekholux Demo 2.0 Is Back \u2014 What\u2019s New\n\nDemo 2.0 is now live again.\nThis update focuses on system restructuring, content expansion, and overall experience stability.\n\n\ufffd New Content\n\nPuzzles & Racing\n\n\u3000\uff0eNew puzzles and racing routes added\n\u3000\uff0ePuzzle system fully reworked\n\nCharacters & Systems\n\n\u3000\uff0eNew character system \u2014 switch characters during gameplay\n\u3000\uff0eNew UI system and updated interface\n\u3000\uff0eAdded in-game music player system\n\nMap & Exploration\n\n\u3000\uff0eNew minimap system\n\u3000\uff0eVisited respawn points are now marked on the minimap\n\u3000\uff0eFast travel added \u2014 teleport back to marked respawn points\n\n\ufffd Improvements & Optimizations\n\nControls & Calibration\n\n\u3000\uff0eImproved height and arm-length calibration for better comfort and accuracy\n\nChapter 0 \u2014 Puzzle Content\n\n\u3000\uff0eChapter 0 puzzle content updated and improved\n\u3000\uff0eLv.0.0: Tutorial video flow redesigned\n\u3000\uff0eLv.0.3: No-fly zone mechanics added\n\u3000\uff0eLv.0.3: Adjusted board and shield placement\n\u3000\uff0eLv.0.5: Fixed multiple known issues to improve overall stability\n\nChapter 0 \u2014 Racing Content\n\n\u3000\uff0eChapter 0 race content updated and refined\n\u3000\uff0eUpdated environment and architectural layouts\n\u3000\uff0eAdded 5 new branching paths\n\u3000\uff0eNew jump pads and graffiti added to shortcut routes\n\u3000\uff0eNew red high-speed track added\n\u3000\uff0eNew instant boost pads\n\u3000\uff0eImproved launch force from jump ramps\n\u3000\uff0eRace gate mechanics added at the finish line\n\u3000\uff0eImproved timer readability and display\n\nDemo 2.0 is not just an update \u2014\nit\u2019s a refinement of structure, flow, and experience.\nThank you for playing Ekholux.", "created_date": 1766138546, "id": "25145308325170415", "version": "12", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25145306395170608"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24248062094895047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25199768643057716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "934901795519330"}]}, "change_log": null, "created_date": 1766137652, "id": "25145216798512901", "version": "11", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24248062094895047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25199768643057716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9
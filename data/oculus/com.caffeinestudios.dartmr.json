U82Hi68pI_ySiNikwLrnPYeqaVT6b0e3QOXz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpA3va9LkXWtDm3cL_6dtKpsvSHo3BcJlJIKD3yJA58w&oe=6B05AE52"}, {"file_name": "ChatGPT Image Aug 3, 2026, 09_43_10 PM.png", "id": "1574435364061915", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312470_1574435367395248_3339332235102796349_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVjNaDCn_woQ7kNvwGE2kIm&_nc_oc=AdpwJHnmP1nAoQX4zqviEHR9aq7EwU1lC7INSphLMNAALhj6bny0CkuWaMBzEhAEwNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBNWVmLZvkBr2NEQGDuUpjIp4z2MVihMklJz7REMDJ1w&oe=6B05D57F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image Aug 1, 2026, 05_48_02 PM (3).png", "id": "1070944822551966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311585_1070944825885299_6844069984632619902_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guQ1KCQ24_AQ7kNvwHkae1e&_nc_oc=Adq1rS08fQCl2RJ3XsLQu1dxKcg-X9TBBaQQssaIy7TonQSFvODAfT-uGymKlrmPUA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr7ATvlovZt805RYeDQLkuTWIk0LA0i0H9o8xxjRRMWA&oe=6B05A807"}, "display_name": "Darts VR: Real Room", "keywords": ["Darts", "Mixedreality", "501", "Targetpractice", "Sportssimulation"], "long_description": "Turn your room into a personal mixed-reality darts space with Darts VR: Real Room.\n\nPlace a regulation-size virtual dartboard, take a dart in either hand, aim, and throw using intuitive Touch controller interactions. Passthrough keeps your real surroundings visible while the dartboard, darts, scoring displays, and oche remain virtual.\n\nBuild confidence in Practice mode, or learn each interaction step by step in the playable How to Play tutorial. When you are ready for a challenge, enter Solo 501 and try to finish in as few darts as possible. Standard 501 rules include busts and a double-out finish, while a regulation 2.37-meter oche rewards proper positioning and detects foot faults.\n\nResponsive dart physics and accurate board scoring make every throw matter, recognizing singles, doubles, triples, and bullseyes. Live feedback tracks your distance, hits, and score, whether you are learning the basics, sharpening your accuracy, or chasing a better 501 result.\n\nNo room scan is required\u2014place the virtual board and start throwing", "short_description": "Bring the classic game of darts into your own room with Darts VR: Real Room.\n\nPlace a virtual dartboard, grab a dart with either hand, and enjoy skill-based mixed-reality throwing. Practice freely, follow the interactive tutorial, or test your accuracy in Solo 501."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/darts-vr-real-room-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1277924898736120"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1109712495178008"}, {"status": "PUBLISHED", "id": "2010760242976358"}, {"status": "PUBLISHED", "id": "1079627078393941"}, {"status": "PUBLISHED", "id": "1567668581401174"}, {"status
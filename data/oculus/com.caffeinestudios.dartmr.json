026, 05_33_02 PM (1).png", "id": "2121803292101287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310726_2121803295434620_2367499196581325910_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uufXQ0fKXhgQ7kNvwGGyFtV&_nc_oc=Adr4HHDYxLgriMMb5LLk3DujKAPDMNJXXVyvH7YbtMOTWdGG2rz7F9y4FqE0eNgALaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHxalimzyVcQMdIcmsyHPLGH85g1wK2lr8zHxKAJJO4w&oe=6ACBA82E"}, {"file_name": "ChatGPT Image Aug 1, 2026, 05_33_02 PM (2).png", "id": "1777875146959130", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_1777875150292463_3523674607086464487_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smCzvsX-MdEQ7kNvwHQmrhT&_nc_oc=AdqIo1Mqjq-Q0E2TmTpRyCcreuIY3A2IZadj_Gz8ELHoKBEmErPst77oygEqnuzG9c8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-wQvdaJ6HtmAxplpTvzPzVTaEcoGoj-Wy8hNV-XkYkg&oe=6ACBC45A"}, {"file_name": "ChatGPT Image Aug 1, 2026, 05_33_03 PM (3).png", "id": "1792373788794999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840145_1792373792128332_5935298017948912391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T7oxn5pqh4Q7kNvwGIe_t3&_nc_oc=Adq0dRuotERLOWmZkhT53wdXIEl4-3jmOTbhQv8w8foUNDynmO6-R7VQATFOo8LrgmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmy92twGm7vWGc5F7OazJLhn4jauDf2YTU4D6FMJyQcw&oe=6ACBAC52"}, {"file_name": "ChatGPT Image Aug 3, 2026, 09_43_10 PM.png", "id": "1574435364061915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1574435367395248_3339332235102796349_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAKrZikrOGQQ7kNvwEO00Gz&_nc_oc=AdpWz87z57Zw2tcmJZWLKg0gZNLCnq1ADHO5OKVrS5XrHGLoLaVkIb9vE4ykPe29t4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUo7de3D3DKVWPod7JKUxeGassOV2yZrLjpyGrF34MdA&oe=6ACB9B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image Aug 1, 2026, 05_48_02 PM (3).png", "id": "1070944822551966", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311585_1070944825885299_6844069984632619902_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4cSNI2gHNoQ7kNvwFV4BRe&_nc_oc=AdohfKWx9hh0M3kFqF4zSuTvovC387pWwAzgeVd-00MWnSPv6tF97O9w7-oLbNN-N9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf33IKAmNTXpi9aFNbTrpH1m9760li2tWHnQdJF8G9uQ&oe=6ACBA607"}, "display_name": "Darts VR: Real Room", "keywords": ["Darts", "Mixedreality", "501", "Targetpractice", "Sportssimulation"], "long_description": "Turn your room into a personal mixed-reality darts space with Darts VR: Real Room.\n\nPlace a regulation-size virtual dartboard, take a dart in either hand, aim, and throw using intuitive Touch controller interactions. Passthrough keeps your real surroundings visible while the dartboard, darts, scoring displays, and oche remain virtual.\n\nBuild confidence in Practice mode, or learn each interaction step by step in the playable How to Play tutorial. When you are ready for a challenge, enter Solo 501 and try to finish in as few darts as possible. Standard 501 rules include busts and a double-out finish, while a regulation 2.37-meter oche rewards proper positioning and detects foot faults.\n\nResponsive dart physics and accurate board scoring make every throw matter, recognizing singles, doubles, triples, and bullseyes. Live feedback tracks your distance, hits, and score, whether you are learning the basics, sharpening your accuracy, or chasing a better 501 result.\n\nNo room scan is required\u2014place the virtual board and start throwing", "short_description": "Bring the classic game of darts into your own room with Darts VR: Real Room.\n\nPlace a virtual dartboard, grab a dart with either hand, and enjoy skill-based mixed-reality throwing. Practice freely, follow the interactive tutorial, or test your accuracy in Solo 501."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/darts-vr-real-room-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1277924898736120"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2010760242976358"}, {"status": "PUBLISHED", "id": "1079627078393941"}, {"status": "PUBLISHED", "id": "1567668581401174"}, {"status": "CANCELLED", "id": "1783901306072860"}, {"status": "PUBLISHED", "id": "1078501874527994"}]}, "baseline_offer": {"id": "1079627078393941"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792162800, "status": "PUBLISHED", "id": "2010760242976358"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1335867756275167", "version": "1.1"}, "id": "1378191840909309", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1266112913250652", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1335867756275167"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name":
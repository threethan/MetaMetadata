108911649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003230_494078115578315_8312086541720777904_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86znpfkvLsEQ7kNvwGMEfu5&_nc_oc=AdnlUkLbXn_Ey461otDXfZtuu8AUzM0BoibtCSlfAxVCqeDb3VpKLbY4rftTyax2w3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxb6jd2QOgoWQKZLA5pHKuP3FRqFSPqvRKfKJGHlRaKnw&oe=69AFF9B5"}, {"file_name": "Screenshot_3 copy.png", "id": "1003180167005014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_1003180170338347_6894569288803162942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_MA6n3hincQ7kNvwGva6qo&_nc_oc=AdkXSG22-_okseTrXCFoR7O_Ps5dBENkL9hId2syStJ4OPwphlGWzDUWLtH2NLdZDBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4YqxtGLUz3_fhcEdTBQet6JwySRpUNIcPpVdmeUUC5Q&oe=69B0170A"}, {"file_name": "Screenshot_8.png", "id": "712354020075120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974751_712354023408453_7478492730701503284_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDgVBBmTaQoQ7kNvwHo_ygW&_nc_oc=AdlS77CtMz4ojN4Hfe_u0R6_PAGDAfx4AtRKu1THriBg2oYSgqaXZsUcXYxDtvI7--s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYAcy_JDY81nWenr8Xix3VEB_l0hCP62OncsNxMcqCNA&oe=69AFF743"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOOD_Cover_2560x1440.png", "id": "3199990370274868", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031433_3199990373608201_3634187053865464482_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObaeTvIqVgAQ7kNvwGjhMxb&_nc_oc=Admu9l5ucbnPHtbrn8_O9hAyA2pdAZc7OZ5O50m857VxQEe5a8U3tD9C8en1u5T0xE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7_v6HvMt3KiyPEwAkyxM3efucaZHQWAdRJ2YbsNFUhg&oe=69B001FA"}, "display_name": "MOOD", "keywords": [], "long_description": "MOOD is the gym for your mental fitness.\nThere are many paths toward a happier you.  That\u2019s why we strive to find the best instructors from a wide diversity of fields including:\n\n- All meditative & mystical traditions\n- Psychology & neuroscience \n- Practices rooted in music, art & movement\n- Peak performance coaching\n\nOur goal is for MOOD to house the most comprehensive library of mental well-being instructional content anywhere in the world\n\nNEW FEATURES IN THIS VERSION\n\n- Get to know more about the practitioners that are guiding you.\n- Find an experience that better suits you by filtering based on meditation categories.\n- Discover new practitioners joining our community and collaborating with us.\n- Now we have the ability to post brand new experiences every week.\n\nGive us your feedback!  Email us: info@moonshot.la", "short_description": "ACHIEVE PEACE OF MIND IN 10 MINUTES OR LESS\nMaster your mental state with MOOD\u2019s one-of-a-kind virtual reality experiences:\n\n- Learn from the most innovative teachers in the world\n- Find the mindset tools that are right for you\n- Choose from an unprecedented variety of practices & techniques"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonshot.la/mood-privacy-1", "developer_terms_of_service_url": null, "publisher_name": "Moonshot", "support_website_url": null, "website_url": "https://www.moonshot.la/mood", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "482015257153052"}, "review_messages": []}]}, "cover_square_image": {"uri":
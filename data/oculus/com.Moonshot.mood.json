e": "Mood_Fall_6.png", "id": "494078108911649", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003230_494078115578315_8312086541720777904_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB3Rth17XDoQ7kNvwFkRh_k&_nc_oc=AdqgQ0HSxSjC_ycu1UdVcPpPILKSatat1ewjI_F92sJtsDsnlIVV_hlfxtPrw3Ajvq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA5FF-UBIPvMmVu6XtEUTW8X2VuyBP2CvbIm4FpxQf9w&oe=6A637DF5"}, {"file_name": "Screenshot_3 copy.png", "id": "1003180167005014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1003180170338347_6894569288803162942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9SNz7xrXSEQ7kNvwHBADO0&_nc_oc=AdoM9g9e_Hof4sJMVrjWAXdjcNh8VenwG3XP3UfOtgRtVlxu0pcV8lfQ4UdhU0j3aPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN6xmJWPBew3IEE3YAdELN6ODXFh3S95qltkwo4GbVTw&oe=6A63630A"}, {"file_name": "Screenshot_8.png", "id": "712354020075120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974751_712354023408453_7478492730701503284_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmdPP4xSQUQQ7kNvwF9kQ3v&_nc_oc=AdrlkRsb_G4V0FSw4x-HdM0nwOD1QL2ElK1C9CJcYxMYWw1PrQIsO8fn6u0JEOuyAJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJsoxva1aanbgwUjH5lGd8hzq2qrS4NlwUWA4TwMSb-w&oe=6A637B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOOD_Cover_2560x1440.png", "id": "3199990370274868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031433_3199990373608201_3634187053865464482_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_17tYC6U1XIQ7kNvwHgIx2Z&_nc_oc=Adr6VAxKrc2-EeGpPaiu3jBlmefw4WGZKQ2x7th3w8uTlSs4NG9ZoraagLWVoi_3JvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqHp4G8R8YiNU4jquZrxfq3X0fN78MbkivkMyhanJHdg&oe=6A63863A"}, "display_name": "MOOD", "keywords": [], "long_description": "MOOD is the gym for your mental fitness.\nThere are many paths toward a happier you.  That\u2019s why we strive to find the best instructors from a wide diversity of fields including:\n\n- All meditative & mystical traditions\n- Psychology & neuroscience \n- Practices rooted in music, art & movement\n- Peak performance coaching\n\nOur goal is for MOOD to house the most comprehensive library of mental well-being instructional content anywhere in the world\n\nNEW FEATURES IN THIS VERSION\n\n- Get to know more about the practitioners that are guiding you.\n- Find an experience that better suits you by filtering based on meditation categories.\n- Discover new practitioners joining our community and collaborating with us.\n- Now we have the ability to post brand new experiences every week.\n\nGive us your feedback!  Email us: info@moonshot.la", "short_description": "ACHIEVE PEACE OF MIND IN 10 MINUTES OR LESS\nMaster your mental state with MOOD\u2019s one-of-a-kind virtual reality experiences:\n\n- Learn from the most innovative teachers in the world\n- Find the mindset tools that are right for you\n- Choose from an unprecedented variety of practices & techniques"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonshot.la/mood-privacy-1", "developer_terms_of_service_url": null, "publisher_name": "Moonshot", "support_website_url": null, "website_url": "https://www.moonshot.la/mood", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "482015257153052"}, "re
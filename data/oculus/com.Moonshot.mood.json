phics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1264872103998723"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6107013545993022", "version": "1.1.5"}, "id": "1002793260270417", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5282365225124529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6107013545993022"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1002793260270417"}]}, "change_log": "NEW FEATURES IN THIS VERSION\n\nGet to know more about the practitioners that are guiding you on your meditation with information about each experience and the expert behind it.\n\nFind easily the experience that better suits your MOOD by filtering based on the most popular meditation categories.\n\nDiscover the new practitioners joining our community and that are collaborating on creating new experiences just for you.\n\nDiscover a complete new lobby dedicated to the experts behind our meditations, and filter the meditations you are looking for, based on your favorite practitioner.\n\nNow we have the ability to post brand new experiences every week so you can access a fresh library every time you visit us in search of a premium mental fitness experience.\n", "created_date": 1663800335, "id": "6107013545993022", "version": "1.1.5", "version_code": 12, "release_status": "RELE
4078108911649", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003230_494078115578315_8312086541720777904_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSVBye6ziskQ7kNvwEc7KS3&_nc_oc=AdnQ7_tkHCaSgRE4FHGTUWwgrTxlVsAcxvvQ1IGNPv07ql7Q3NSeldnqN3ij3fS4RG0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4StcyGYfgpjWcake1mhn0sY80v_6nsyOezwxvgVqPdA&oe=69AAB3B5"}, {"file_name": "Screenshot_3 copy.png", "id": "1003180167005014", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974447_1003180170338347_6894569288803162942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrbPXyV3UbgQ7kNvwGC99w2&_nc_oc=AdnzXgomxS_Yq1BFj8AREWCKt7-9K1JUt3zuOwaNhwyvi43R7UD0fP1h2rWWBIHmhxU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCFThx07MqcXvs4YV5EVwXWfqoY0aYPbe2QMeGGVFCxw&oe=69AAD10A"}, {"file_name": "Screenshot_8.png", "id": "712354020075120", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974751_712354023408453_7478492730701503284_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9RaD9OuypkQ7kNvwFmJIY_&_nc_oc=Adm1I9aGPy0TYI5-SHfeoymTNdg5iVSBEMT-7AVqYDunwdFIHD4cMzWk9-SVhdpj9nU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx034Kmz6fFgATBYhU9MfMFoCOCkECuS2YmDwRBXQ0Z-A&oe=69AAB143"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOOD_Cover_2560x1440.png", "id": "3199990370274868", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031433_3199990373608201_3634187053865464482_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcj80SRtStQQ7kNvwFELVAd&_nc_oc=AdnICRtLNiGjxzPNI71Yz8z9P6cbz8t2g2SQOfONspE9clzVHowWC_5bDmnJvTPbO1g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFM8Q4VpGh3sIezJcQaa7dRsvZqBXC2mxgrQM2W9bP8g&oe=69AABBFA"}, "display_name": "MOOD", "keywords": [], "long_description": "MOOD is the gym for your mental fitness.\nThere are many paths toward a happier you.  That\u2019s why we strive to find the best instructors from a wide diversity of fields including:\n\n- All meditative & mystical traditions\n- Psychology & neuroscience \n- Practices rooted in music, art & movement\n- Peak performance coaching\n\nOur goal is for MOOD to house the most comprehensive library of mental well-being instructional content anywhere in the world\n\nNEW FEATURES IN THIS VERSION\n\n- Get to know more about the practitioners that are guiding you.\n- Find an experience that better suits you by filtering based on meditation categories.\n- Discover new practitioners joining our community and collaborating with us.\n- Now we have the ability to post brand new experiences every week.\n\nGive us your feedback!  Email us: info@moonshot.la", "short_description": "ACHIEVE PEACE OF MIND IN 10 MINUTES OR LESS\nMaster your mental state with MOOD\u2019s one-of-a-kind virtual reality experiences:\n\n- Learn from the most innovative teachers in the world\n- Find the mindset tools that are right for you\n- Choose from an unprecedented variety of practices & techniques"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonshot.la/mood-privacy-1", "developer_terms_of_service_url": null, "publisher_name": "Moonshot", "support_website_url": null, "website_url": "https://www.moonshot.la/mood", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "482015257153052"}, "review_messages": []}]}, "cover_square_image": {"u
6_8126461296232420926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6GX8_eJ5_AQ7kNvwHbatFh&_nc_oc=Adr5u2gx3-iKFLdTKiS6cwcP_txxvEgE59CTKrexVmfNfw8vYNxI8BNg9Ima-t3LNfA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9noIqgA_S5NI99stUwSJKYFSHgcsQOkOyv5cvCXJjcHA&oe=6A2FFCE6"}, {"file_name": "RoomOfErrors.png", "id": "1726560644977386", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312422_1726560648310719_6303907975841992512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9WGSpS3Z5QQ7kNvwFJd4TG&_nc_oc=AdopgouKMfhHdxQmWxzpnSEMk3zAaTMt99VaVv_rvg3vrenCADF5r1qb9hjUVAVPLuE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M5wItDcm7L6FaXxEHlL4xcF7uTJZ6C_qGxxrHf5dHIQ&oe=6A301AF0"}, {"file_name": "PPE.png", "id": "1303417328519968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303391_1303417331853301_657704254367296400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI-zauK4LdQQ7kNvwG_Npb2&_nc_oc=AdpjMJ1hJTs7XQldCIwjsH8Nf2YRuchVoQQemppCvJGSpz58vhxbnctzkXl6LLJMRxE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AWIKwd3aro4a6SGXwoVVVPt1pjLLLxAQzOHT7tdQBUQ&oe=6A2FFB4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UpSkillAI", "keywords": ["certfication", "simulation", "training", "medical", "assessment"], "long_description": "UpSkillAI is a virtual reality platform built for education, training, assessment, and certification through immersive simulation.\n\nThe platform provides realistic, scenario-based VR experiences that allow learners to practice and demonstrate skills in a safe, controlled, and repeatable environment. Each simulation is designed to support performance-based evaluation, capturing objective data such as task completion, accuracy, decision-making, and timing.\n\nUpSkillAI supports academic institutions, training programs, and organizations that require consistent and scalable methods for assessing and certifying skills. Repeatable VR scenarios enable standardized evaluation while supporting learner progression, readiness checks, and certification workflows.\n\nFormerly known as Health Scholars, UpSkillAI builds on established experience delivering high-quality VR simulations for advanced training use cases.\n\nKey features include:\n- High-fidelity, immersive VR simulations\n- Designed for education, training, assessment, and certification\n- Performance-based evaluation with measurable outcomes\n- Repeatable scenarios for consistent skill validation\n- Suitable for academic and professional learning environments\n\nUpSkillAI enables immersive learning experiences focused on measurable skill development, assessment, and certification readiness.\n{1838739923491249}\n{2177715149301818}", "short_description": "UpSkillAI is an immersive VR platform for education, training, assessment, and certification. It delivers high-fidelity simulations designed for skill development and performance-based evaluation in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://upskillai.com/privacy-policy-meta/", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://upskillai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26693250716959502"}
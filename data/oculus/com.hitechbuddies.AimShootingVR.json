3.png", "id": "8707009796023481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQNTBdZEAx4Q7kNvwEwmDqn&_nc_oc=AdmbtjEtyn16wNLRp2RJ4SLc3ljUu2FZN0rYCelwc8t47cGhGhUOwyVXNQAx_f-mxiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJLhOk-3svQUqBNfOxAHjpfY99bv1zXtRKD2S239XSuA&oe=69A6CED3"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk70ng0ochkQ7kNvwGqlYvT&_nc_oc=AdlCnNIHfaWcOGXI32gI1w4p93yszGznr_mN1flXmsObtQOEXZuv_d7Aoqqmnl3MyuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvK70zQD4reFePR96W5uP8DDrabwdVed-7AWnO0vRKrLQ&oe=69A6EE9F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzZczEpdOIkQ7kNvwEbnIRg&_nc_oc=AdkQAQ9egK8Uf6mx6lFwx-Fcre8arzQQqgClqm5wUEuH0-7w00TaBe8nRFAPzuEGic8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIv6piNLBvM1vAz3FC4ptYn3BJT5VQ2j9-8aV28MzOGA&oe=69A6C50E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlVaCvIGvAoQ7kNvwEiBrPQ&_nc_oc=AdmEIBpTqsRxHNy6SQhc0uAyGe1-8VKdl5gBoGRjCuV0LNH_uRdgPMhfzPs77IFODDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1N2iZEpAxAdoLMtnrM_IZFe4V3ud1Ebv_YcGgfhscRQ&oe=69A6C934"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "27
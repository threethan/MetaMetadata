4_304400906440489271_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTY_u472s98Q7kNvwG0xUXX&_nc_oc=Adr37NfB8Wd_Lfkf0mU9wjtAnRiYSZtVoVqZCeeaPLLlbGdA2HuwuL7RaEHv_F1d5E0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnSthmbv7b0xGLYv9Vego2dgt7wNQV_d-3vokysnfU1w&oe=6B0B1EB2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BwExveTJL8Q7kNvwGrYmQk&_nc_oc=Adpqze0EBWMJZBElUgVtcV2jkfDAcqgviAukccLz5L3JarDaEilc-nWS4WK0t1SO6ak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgRccXAOFLEqtC9qzEsLNSuXjWZUzLIkMlOHXRNNSIkQ&oe=6B0B3453"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVJhAVbB6m0Q7kNvwGaUBp8&_nc_oc=AdqMmICFm8fATaV0-iuNYW4vc5wwbxLcMBB2I95DtKB0rF2yNYWcIBZ9ChR7zW9j_RQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlsRmwka7gld7Bwnbvj9FUhjp-pwxd2fJR-SiF0KFFeQ&oe=6B0B1BDF"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkw6ZIrW9kEQ7kNvwFXGZzb&_nc_oc=AdppH2p0aSOaeap0ak_uqRnnlXDLypuQW094HbfdCKhRB6G8oPgZtII7wLiOKXvCg_I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZHffITK0kHrqfIr9dBC-_IWIe73RZoZXOCGch-O_IfQ&oe=6B0B2A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfWgP01RGwQQ7kNvwGfdhNV&_nc_oc=Adr72NqXWUzLRWyWeJBNDEz5sLUrLjeJZdRwdT5qRNQmxa4Mn-6jYZ6Sa7Xx7j9p-4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5lnM4tntxHYP-8AQv7VtT_EfjtWL5eV7u0HitndJdPQ&oe=6B0B2EB4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9066943130022247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391781_2309881102714134_6132535165188365306_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-nifS8zbRgQ7kNvwE4rjpv&_nc_oc=AdprsLWhydEuIpeqtU8daPuwQoVlimsbgav2oiOqkHBfTjvGS7Ix8geM7BXqly1CO8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiE1WtyrY8hEOckTar16N38GWKGnkpfIma16TMjAt2EA&oe=6B0B3EAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aim Shooting VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1720845165, "lastRevision": {"nodes": [{"id": "7605141339535774", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadat
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvzjQss-kKsgJPxL3dKUd80KXTVtcR38oedGFXhPVaQA&oe=6AAE9D72"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymnml0JLdFkQ7kNvwF2Vl8E&_nc_oc=AdpzRJ5gs3rrbU91reZz5YSd2RZ9nrnHTK8IOyUu8iFKIY3UXFI8Gx9U0tJR81MG89A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7taETHH2KW0pbNdUacIQl6SeaWzY4UKHYttzcU8tjOQ&oe=6AAEB313"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJo0LGgFyJMQ7kNvwEYRtC0&_nc_oc=AdpjmFmPgUGz_vUi7pnX3XHvMk1b9SwcyE57ssozmxcdS700AUmr2Lck01ijl-b1x-U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzGRLwCVcp3Z1RvBTp7zum58Txy1dkzxtwXtQovL4_yw&oe=6AAE9A9F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0CNhW6hp70Q7kNvwGx1Htr&_nc_oc=AdphuyemhSEavBlQkH38eGKoB13zRBzpdYig7ZtgLkzi5vM4KLjBQ7YOb6GVfDZb8r8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvl8m7xPp258hrAdxCBDmkglwblWBNuSEV_pGgwIIZmg&oe=6AAEA94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww2n2cz9Y5cQ7kNvwHX8v0t&_nc_oc=Adp7qS-lBLQvzTHwPvMaOSeZKGbn0EQn3kdSKoK7hCXzNIU_wB8OaoA89NAwH6DHHNQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImaaC8NywXQuZO-UXZP6XlStDwh0yZ1d_ApqAo7BGyNA&oe=6AAEAD74"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies"
dn.com&_nc_ss=7f20f&oh=00_AQR02Xi6X-kA8Ga4WsJLAD-URmTiQRUe65H8m1YYAfm7nQ&oe=6AEB4272"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOhwC55on7QQ7kNvwEwrMA0&_nc_oc=AdoMyPawfaPAeoB3ZcmAFpBQi57BU-A9IIqP4AgSb7apHIRUnSZMbdDVjG0QmSW0MM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQewAy6u1Sz6Vk5bZnHFsCXCA6bHbA96J0w577E3dqAJQ&oe=6AEB5813"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovhSXP4eOM0Q7kNvwEm7_v4&_nc_oc=Adq9Ist4U_VvxUEnUsv_ahxQ-aZY0fZb6DYpS0d-bwMXQt-ilNauvx1sLFYY-WGiTJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEC_7wUnN8F-VHW_yJ547-IM26bDH0QMf4xsFmAHZoEA&oe=6AEB3F9F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP1PxnkHKaYQ7kNvwG0-W_5&_nc_oc=AdoP9KkiP6B6X6vXJCVBRfwnojrXULReaiYWxnpZHojYfNt4QNkf3iPgcKko_wsq6F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0SpFUbgPNHujP7Hf28vZdrDszekIMzk0_lI8WSm6ebg&oe=6AEB4E4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FHA5HBQk9kQ7kNvwHj_LuS&_nc_oc=Adroe4EITUd8zleSpVTzQgq4JoJAus4ysVuD21C6rVvA2nQKMGZ8TIU26Gp2gTEbhbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGRt5sXDXmz5cbEhp2PZbVnuD526Sh5W8m1o9Tce8Orw&oe=6AEB5274"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_websi
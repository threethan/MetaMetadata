dn.com&_nc_ss=7f20f&oh=00_Af8RbvR8FA_stc3JadVkxe8sbzOwoR2FYBxf0UAYghvpIA&oe=6A2C18F2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z88BfJi5uwQ7kNvwEkfdII&_nc_oc=AdrU-NZKtwhrbjT2Ch-8FfnIdUNCFK2usI-9zxWzar1PXX36bohPxZWL7SiD36c3CS4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4K750n3L_YQ1Q_ofuKzucpktpd8eI7Gyfsb3HoyFG9A&oe=6A2C2E93"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzsaU6DNwjAQ7kNvwFuP6NZ&_nc_oc=AdpGvqyQXwsuOVG2rs8K-mh3h3z9HDOduF38SeqvNEp3o_vpxOxkzbqwB5-qvbMRy4k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8noBZCMeuVJQ5kZFlxZAcRD25CBgEwpvh-VADk-AY5WA&oe=6A2C161F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X_j9EyfwIQQ7kNvwGmauWH&_nc_oc=Adrbh-6jYG7e5Ix6QhGZWEXGJRzx0IWy-u_AxBy5KcolZvLyOsCg1-C0-QlGSmoDt_4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a5QsPUb0K0UZHuTC1M078MStkkmHKlPrJ88eUhp28Mg&oe=6A2C24CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2wEYtUdo_oQ7kNvwG5iMVk&_nc_oc=AdrAOb3uROtCOOYuYuDgT88-MiPu1DJkwZG-1Vszzahf03SFBVYheVbhbzwue6NG658&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cU0h5aTQ9Xnfm-FGV4Uyp-NzT6iy0KvEgR6vuNVN1Ww&oe=6A2C28F4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_websi
4_304400906440489271_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49fSNOwBs7wQ7kNvwGpRs2z&_nc_oc=AdqSMw3wOEjEQx8PdG0Gvyw8I6YCbEoSgRixTvP4HrimNJBZZYyBRgYpFBRAk7H0pQI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCOWtkg6J0aL8WieOPG2gj1w4o7r30dUDDY65zABffNA&oe=6AFC65F2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aScGmKy6lUEQ7kNvwHsfYw-&_nc_oc=Adp36DgkDJf5rrIvBYHCCiiScIJh-EqtgODIOE1N6gwuzdP2wH8Rk_VTVXVzHCkM-lI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmfnpNbdmJjC8i2FfZdr5MiPpcB_nfmjU6OpvgHE8Nbw&oe=6AFC7B93"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxRqSDis4_EQ7kNvwGXnjCJ&_nc_oc=Adqk8D16O0s0UW7wtaRue7PiAJiUv2Tzd7udm6AgqfOY4oSdQKKMRs_6e2xG3FqwKM0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfQSZv7hJ3-gIG023ULu4tFOZ50xa85_U0Lvd17wruPw&oe=6AFC631F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo10GgfRLYMQ7kNvwF2Xjyd&_nc_oc=AdpB_JbJZ9dGqDpqzILHI1FMuamhHgl0rG2y4tYruf6B-n30QYP64zX3qmJxM73mw-o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW8s1LCjyXAvexNuWwd9cCvr8ZWcYu5BqQ2YeMlJnD9g&oe=6AFC71CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng_s48nkXaAQ7kNvwF7YYVd&_nc_oc=AdqjA5FkvLQEKGV1eEXgqBSIxgtQ8xAOoDD7ylfqcQLVfdGEYztuwrKfXt8RzykWfeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaJiRv3rD-VgDpwmVguPwIiqUvl4_6xmgD9mZCr8PzvA&oe=6AFC75F4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9066943130022247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_2309881102714134_6132535165188365306_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0z8HmTyDdoQ7kNvwGPU_BR&_nc_oc=AdoKEZGAQy9TeMA2DlmkF4bTJ6peHBh4lEE783GHyM6hacosrhhTw3Ab6XarnZlNjQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtKq04vVMBvUKUaQMac8jhrGXls38KPw_c3SwWDPBzCA&oe=6AFC85EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aim Shooting VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1720845165, "lastRevision": {"nodes": [{"id": "7605141339535774", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadat
4_304400906440489271_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHSEY8Rg9cwQ7kNvwEuf0fB&_nc_oc=Adq9MuR5akrB0izKpo7YPqRhcdFrKj1kyT78qyA9Zbb7QrLhDbLFoOLLDREmD20UP28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBdBgBZ7F9V9eELKepdRh7VWr_u9P1xbsxcHYKLVBs1Q&oe=6B048732"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atsOWebHZO8Q7kNvwFMHiFT&_nc_oc=AdpPAh81EkNBjBbjlg7Bzp5EHOGBjwhOy1YjFpOaK70LU6dJk9gRWANkmR04dC3cf18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw5k1HP1GemmJKtw8_Zl9kEqWvHYB7ko4_F1D_TSb1Xg&oe=6B046493"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCMyQJedKf4Q7kNvwGr3YWk&_nc_oc=Adqp7DdnTz0jo3kkkBq2oSX7-UJLynigALZFO2sJ010wmdPGARppF6ZHZXaZo78pCIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZgQJJezuPoSYaE7RMy7dHIVMmdXH1LquGyStKmGmmIw&oe=6B04845F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RofGTbRWWtUQ7kNvwGDk-4R&_nc_oc=AdpEHq_dRtBxqGegJduoAkuqTJo_DYoMIAiy1QuF4mUGVLIcIG-U5xK1QP_MI1BGw-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDbru33t-wzsp66IEBTXY_zaJd8zcSRJecgEKlNSyy7w&oe=6B045ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIKH81G2KLEQ7kNvwEl_wL-&_nc_oc=Adp2hmh3xSCI594954k7U1Zo5Jv1CUa8hdqSPzWR79EZ7-xEomatNkNHtJ5masr1RXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcW0cFHHbfJp6h0vyFTT_YV7kifV_cC2KZgzXPaOmL2A&oe=6B045EF4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9066943130022247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391781_2309881102714134_6132535165188365306_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTCY-dD6iNgQ7kNvwG5P5yq&_nc_oc=AdqmI7vXet4_-mJr7VFUfBHmQ2L1fDmGvMijqkvnanccl1enXCK3jKpUA_pnof09QGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlkVCrJLQKE5hsnY_qFclyX-3zr1HIykk2BblsKp1uNA&oe=6B046EEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aim Shooting VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1720845165, "lastRevision": {"nodes": [{"id": "7605141339535774", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadat
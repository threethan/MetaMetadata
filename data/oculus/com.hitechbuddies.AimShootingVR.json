AsrRbjPcmr6LVGjW8E1nkBivWmSR0k8VogQ&oe=69B6C372"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeVfKdu7GrkQ7kNvwGS9Rxm&_nc_oc=AdlVr9EWpNRaa_v98o9DHuRwTkepVFjlp1TdfRm_upGYj_pKzRY4LqKg8UfwdUFEDjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1cM6pisEjMp9l0_larEEaIEom9M9kkqTcEa9tlmJLhA&oe=69B6A0D3"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhshyZ0LR6oQ7kNvwG4aap7&_nc_oc=AdlmeDBXnTvyBk4t4vmEvnyHNidez1uCU14ZsX_T1PIx0x0Fn1J7u_c_qtcjo3-xbuY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbnjxyKRjEZSnEBu28iUJb9x9Ct0guQ5V7fAkhl1cunA&oe=69B6C09F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fel3j1yuJZEQ7kNvwGCO6eo&_nc_oc=AdnutdMpbNgfvTWcu33edVP6_EHUiVD-IIPqTMiFgWmjScn6mA3zc9TIiLB3OFlR8OQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfznjSI815ZwhRR_cQ0A_hQEdzek5A97pbp7FOZpaa7WZA&oe=69B6970E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuDqEPBrJzgQ7kNvwGIbiyZ&_nc_oc=AdnhmLscsrdN4V4lequWU-dfiZ5nQD3VZsInYsG_9pQnz2Do8X_2L1CfWwbp0Kql9Pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOwYd5WWHjLfG-Q87ojKycSh5hksOeVJNvXp-sCP0rZA&oe=69B69B34"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.
tbwD-ijq3lzQwDn45YYnxHxkUXk1GQCi_Xg&oe=69B14532"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO9N6B9j69QQ7kNvwFUZtir&_nc_oc=Adkl5WCApSEbuAXyK10cEaEvOYoFqHrV-2MOAgZmjfX-inw0u7Aa-UBDLNo17Edzl6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuMPn2aq6HamQ3KA9JjTpoToUIR0Zv0QMwWUVW7mz6gQ&oe=69B15AD3"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi2_rFR8fE8Q7kNvwFnmKpC&_nc_oc=Adnsm3q0uVQNFB7n9xcI7t5G513mzNhTHhLuZ_UZz6uobVzioB_TOHMScfl5ZTagVgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjU2evrWQ_v7Ua1aO-WlNjArJ8UE1LDNbvOqcxllvkjw&oe=69B17A9F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1SY9U3lTTsQ7kNvwERNgqF&_nc_oc=AdlfPNM_5M22zZ9yQh4DrjTZNnx1jW6Ai-zRMdYAV8A6TIyjEddVkAbfU0Cg594UeJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_zPgf69DYN90SJRkwS9M-Yu-ZVZQ7ITba1i4vGhbjVA&oe=69B1510E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWVpN-Ek-nQQ7kNvwEi9rg_&_nc_oc=AdlxhaSeZsFkHMphItcPShgms8h7b-vMVN_LMgvwLYQlICxDB3ac_1VbNTF2YnzT5Vs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs_2lR822Q_j3rsANx9ARp1qS0jZyXfAmMQz4Z6AN0DQ&oe=69B15534"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VsdgrG1cDQwaCrAtJRl3jLK5w4Whn_WrVBlaamDTpew&oe=6A22DE72"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIapcPbEq7gQ7kNvwG_AuHk&_nc_oc=AdomVA5vfvJ_XgBZy2Du7sb_kuNMVTkN5ItY3iLjFV9tFIWa2V-EG02jDxLszNxffpc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89TmoQHAmhJg9gyqbq7YQE8vzgr0CPQhfjJ0vGwf8eRQ&oe=6A22F413"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7f6IH5ixfwQ7kNvwFXvK3e&_nc_oc=AdoRZ4jQb6aGBsFZg5iRdtLmzwB9Gaijv5T71idyS2S_OzyzR0cabSQGUhu80q1n4zI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-clU0QLLGr5PCZu9v677uWiSCDL17SRRlnQsfknNMOw&oe=6A22DB9F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YkQofosti4Q7kNvwFWaHMb&_nc_oc=AdrrfkTRkb-NV0Iz80ONTaMCvOJxenE_OGqeLu0Um2XW3v7BlkHVyNs94Qks2uYapsw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ZWDjg9OmXtgjxhO_dutaWQISsKQt7UVCrt3z6Xv4wQ&oe=6A22EA4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDiStRJ1jP4Q7kNvwFWZpdH&_nc_oc=Adp5FOZ9J-gh67cbXCh2_R1JPtNW4E9AmHJOpr2WunAL5B2cRGwf4EglZH0NAdGOJ3E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ifv4bwUb4Qcs4OY9mQfbUUFEYbT_mmylrBIfuLX1x1g&oe=6A22EE74"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies"
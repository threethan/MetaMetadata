r6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEixH_2T4ZC1D190k65dCUn8EEYYSWA_9H3QIyA-rJpTQ&oe=6A8586B2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I7KTDMydM4Q7kNvwGHrsZ3&_nc_oc=Adq6fwbswB5MRWlQCc1cTgE5dQf3MO29d0P8pDjOBT1JZh1eXE0cAdpuY0HEZrhD4_4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxCATCHQX73_v1w-XWQkYGqi0J1pYBLjgWonHyw-p48A&oe=6A859C53"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKnhAT2mxkYQ7kNvwG7kHTL&_nc_oc=AdqhFun4fKZsp41_RaH-9C0irTmy5_xOjs4bv_UWq39Np7deol5kGdZmDdv04tOW1T0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8m0Diurfs24m-yfudECDnpLO9u7DsVzePJ4AI3EVFNw&oe=6A8583DF"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6481B3UiCBMQ7kNvwF7fb44&_nc_oc=Adp4RP3OFjnxhHSFWkBED6n0KXvxrdOMvByiKBj7KOwn4Poa7v8Wadi5hpvhgF4AVnM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvJ6Opu2QXJo5-1G_wBooCCazvz1MUW5Sahj_CsPYyOg&oe=6A85928E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ42aYIGcaAQ7kNvwFgkRom&_nc_oc=Adr6sHeVARbbDnoWVsmiCex9SCd1_POQfOIcAuCsLEaGbZdS4jq4OCnCVUj0GKaccNE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhA1miikiJX7kKqtgG1CnslPWNuzrfhnCbPzcTR7pWyQ&oe=6A8596B4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies"
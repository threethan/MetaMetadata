-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWNjzpaG_VEPOZ1__fP9xs50dv4rOBAfXanhgAs2fTqQ&oe=6AA95772"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmoptDD1bxcQ7kNvwGERRqX&_nc_oc=Adqo32jCkvvQhfM0c4JqFaACiMDJEM4KRgmfusmNbuoqgcwPA4UarjL6jR5GiogVabM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICrkG7_CFAWZQXY7wTQD9V0Pp849ZEx-ZhS8qiXJ9swQ&oe=6AA934D3"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvo1W1IoD78Q7kNvwHAHwuY&_nc_oc=AdqOkq8YRBxhZQ2PIx2aZwaStLsiiC-hEQNuO-A4vC4ILqr9o5Pib_0eTIetjmf7toQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2p7Dk6YZsOmi3ViIzxOtn8x7Nl1kcp1Vf_oNSeKHXfg&oe=6AA9549F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1F01EzNWQcQ7kNvwGCDFM9&_nc_oc=AdrW7iqZtsvOC8DOPsY5c79it5M4s1HBsjuku5N2bHG6DkJWR7rkS7laB6tJ5Cw2LcM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3R40O3CgU-sAk7p34RsfmsxjPaDhLvNdi1juPOWnKDQ&oe=6AA9634E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP9zil-5YEoQ7kNvwF7p7iA&_nc_oc=AdpfUdY_mIEQ2QngxnnjIzIgsSK3UcTjwVmir47n9YqbIPY22LTCUrG_KZixNQjdopA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9HKcCq_R72Ndrt3_XpcwK_py3ZuRSbIbpqVjleauwWw&oe=6AA96774"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies"
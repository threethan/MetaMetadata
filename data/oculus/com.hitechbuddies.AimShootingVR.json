3.png", "id": "8707009796023481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN9nP13UxdoQ7kNvwHcd-UL&_nc_oc=AdkdzkS0ESGYo_sBshZZMfWLRfFwisK1fgOQBM0mFvYRfdgvOUrnX9H6yF3cQsn_67Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv78vGP06BwfOYB2Gq2C2ceO3PrAAlcR3v8HyzuKHdaYQ&oe=699AF153"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3ovpoBtBaEQ7kNvwED_H1N&_nc_oc=Adn-lYJoU4FwNa-MbpyLi27GOV9MDPgTl5UM3C52H2AIP7HPw51rab152ZOotX_OIsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftV-JCW0P0XkClRFIPuZ4r9JuWNDUss97kXMaGS2JPvhQ&oe=699B111F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dwcwnTXingQ7kNvwFi10dP&_nc_oc=AdkXYzx5f74VMynr2JCpR50i4D9Mykn75QptYll4GGd_ybiI0sjFsDBtJsM4dnM4HOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftbr1Dg-OHJRCiuSv3UAEBPJ5-BG67nVF2dzrtiWQ2-ng&oe=699AE78E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bygwfLAF3kkQ7kNvwENdnZN&_nc_oc=AdlrqsIMb_2BgTy5yEYX6Fr3lhgrbFBPAg9bSTXeVr2UHJ5L0UIzkekvnMSiaTQTV_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvOuEwja7t2MjPowNLud4kgPEkrGZlI2Ka39ryxdt0QXQ&oe=699AEBB4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "27
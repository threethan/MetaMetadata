dn.com&_nc_ss=7f20f&oh=00_AQIncQGot9F3tpuaUoESaCyBP7LfloKGVfWj0RnnfjhOqQ&oe=6ABA7AF2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_A0kCSXmqAQ7kNvwEzKtlA&_nc_oc=AdpSbhaYZwm1hXGMCV2ouVM7TWE167fo54Vqa5fAymBG2oIeSaYMn2-LjQOQp3OwikU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgsI2ld40nJcy4aPiPl9KSg0A1xsqT4zNSvtFDdB1UDg&oe=6ABA9093"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPHkNc8I_t8Q7kNvwFAXAeE&_nc_oc=Ado4R1qv6l-k65mqR7vY7kp2WhGveBRHJaH1zNGehPKxpGHcNnCZOvFBYjSaz_FDKcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi7oLIpbDF54iqp3XDnB-APTmBv66ssQUzcEi18s1dvw&oe=6ABA781F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ahq_9WdSHIQ7kNvwEGgjaa&_nc_oc=Adqo8d5gAQLWlu8BdrBzEMsW-QSIyxmvmxJbXu2NP3f80T8xyxG0eP7UZ3FuFbcXH8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkxTbh0LLXux_bn7m8Qe5syFAvv4wToFMhpQ8WfkLpsw&oe=6ABA86CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwHrbP-MkBwQ7kNvwEB72sG&_nc_oc=AdpYL51NDpXElAlL4UnSSpcikOxCk-eGuFSDiJq2I83kME1X1dq0hk6xljZ24Id92ZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHL1hTSi6L7tRtwoylhZYXSepcG8nj4ZIwEBh_Kmwzlw&oe=6ABA8AF4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_websi
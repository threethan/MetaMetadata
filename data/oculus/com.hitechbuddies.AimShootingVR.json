dn.com&_nc_ss=7f20f&oh=00_AQJTedVakswd1FcrwCUnzObcW9VrJhzDZb42SkqDDQt5PA&oe=6AA16E72"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYQJm66qMGYQ7kNvwGFqtHg&_nc_oc=AdrOeDBz5pgiDD5luT1NbBp91XCfEbpqI0o50OgLfLr4vCxIA4ggl8DiKMA7HBX-fak&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ5iRY2J4480lfZzc9JPHlv8CRPmLoTSQEwmSGbFPJ7A&oe=6AA14BD3"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFVZZy8z7psQ7kNvwEo7VAj&_nc_oc=AdpAW2_CQILgZHZ2mdT7jsVngwVnrDmjeM36QzQAb04CDPhGrQQHPVo7xlDw48bai5c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn8yWQewZfYibOrVOMBMVSh6ioeJyEuFcGmFesi01Qag&oe=6AA16B9F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keftxDqCfc0Q7kNvwGshUg5&_nc_oc=AdqKX9hMWdW7Uc4pvBISMNpshNbcDxJ6g37yE8nD3IWQQ6GFiEgNiB7J7dJwbXVNI_c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO3m_7yiBm8VvqsruQX8E8pJXDJgQnvmG-C91kOEQd4A&oe=6AA17A4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7NAQ_ZQGMsQ7kNvwFp3x2C&_nc_oc=AdrRva8TGpztLX3_VBM095HK-8tjE--hC4WrWFuD19s-vNU_GRQCG5QcR31OVxHInFM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzChbQeSvbaGjcUB0RvluhLGghZOJl2VYSpy0O5w0ZAw&oe=6AA17E74"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_websi
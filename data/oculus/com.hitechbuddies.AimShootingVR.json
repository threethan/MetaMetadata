b47CsGzfU_UpZTaC3aMPXtNmUyGfZ0TpR9Q&oe=69BD5AF2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhQwJpx0op4Q7kNvwHn30MO&_nc_oc=AdkOAddaJjAz-fUZj1IEmeK1UjT3rL9DPI7bUyRP0lw3FJdvFbHZSocZMGoGQJosp40&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEVqp-I1KhwfNGjqkx_B7iv2g-NYj5uunIHIZLdItB-w&oe=69BD3853"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IAL6EzlZ9oQ7kNvwGjDxJQ&_nc_oc=AdnWZl2vSC3ssYjQuiy60LzR8wxfxbHBMRq7OKOPS5swr1CY4HGPfqeovJqgZt5h2Ms&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZZy66zCcwqssPP6sZEO0JvtXcd44Pcdqya9xxSADeHQ&oe=69BD581F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0Z4KEfX6gIQ7kNvwH2DLbh&_nc_oc=Adk0Qh54y9lNcIRxfqXfFeTL3O4eMh5Cgntu7WvIb81JwVtm2CR4ZNgy-3xbxDDnReA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXxIEOZDolN6JEUTJdiqlj-YC60vGoz6AugreAFxnEDA&oe=69BD2E8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZYLfe06d6gQ7kNvwHWhE_k&_nc_oc=AdndsfdDPP0Vnj1ihUXcCXTXB4ACISBBjoYposG_vuRVE_fP9bFA6uTP1czPUa9mBBY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQ9EvUlDyp_MrrywVXlRuQiGXFL1gPysPqRJcK0fzTUQ&oe=69BD32B4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.
dn.com&_nc_ss=7f20f&oh=00_AQJmYCH3sZjWIcdBhsD8KZaCZ79RGvAZf_T5KCkEBWXx0Q&oe=6AA6B472"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy5zU4DLwXYQ7kNvwHEIZmT&_nc_oc=AdpYb_mlwxbX9SQWf_HCTJWglFTjx-HA22LD1pSxac0fKTWZtgwUiu_aCbDVPds68do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRFs6fw3lqQR06dHjl3SqFniNuFJ8lCEltXODCABa-Kg&oe=6AA691D3"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHbFk9ng6-IQ7kNvwEQO1Yi&_nc_oc=Adrbv9f21i6pK7POuc7dzMQ3F3XyJekhCiScGYXLHQLiROq4TFSY4EKjs0XZul0fe-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9ruw_nhGI1td-0bdns_0Apqmc-lJHukH56MVi2SYoag&oe=6AA6B19F"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1F01EzNWQcQ7kNvwH_mfFI&_nc_oc=AdqBxUwDxIfW19Gv235UKWYeZY5SmoPJrRvrNJHlPlRwxP0rXLbsI0wQSpfyepZFfzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVJwOBCH7Cio1fIP30Eoev-peyaGquSu4Q6tgxLgFwtQ&oe=6AA6C04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mblIxtZZmW0Q7kNvwHibzIX&_nc_oc=Adozx9uz2Txnx04spTDiqx8VGatd_s7zDaVemwFa65mTYX8_UXiBoRbe_bm49SjtwmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk_f1I_SgJY6B1nl8Fka1YtSelsq486K1kiWm9XCVkkw&oe=6AA6C474"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_websi
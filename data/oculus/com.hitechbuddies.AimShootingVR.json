-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWq1empIwNzcxI3kdDClAnJoYdmMri_cAfgfTZBGa-IA&oe=6A7D9DB2"}, {"file_name": "aim-screenshot-3.png", "id": "8707009796023481", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974551_8707009799356814_3994664724273049762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjmxbdT2Rk8Q7kNvwHuYQlO&_nc_oc=Adp5J-LdAygm3_zyJc66WfGtxHWMiBtxu3lW1yNO6XLsT0oGdT26usQ2DIf_ynwT-I0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLhOEL93aBE_n--bVkn-J-G3E_yHP8PMWJhcmV9ADY6A&oe=6A7DB353"}, {"file_name": "aim-screenshot-4.png", "id": "723934089953544", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982598_723934093286877_3873998242090367495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkJKmKMcg48Q7kNvwG6vOvl&_nc_oc=Ado2oZZHIjqbZO0nTcLfU7oo6xwrFPykzyuyDuvBk0aqUh43IdxWkSsujSVyxTH-TO0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGKLxAUp6_20-GWxbMZdmiFBv5049oBLKsS5y4xgEYaA&oe=6A7D9ADF"}, {"file_name": "aim-screenshot-5.png", "id": "514983164763993", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974751_514983168097326_4387669613788468726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkk7grW2CbQQ7kNvwE56QHh&_nc_oc=AdpPkWVf2ksT8yh1b_aX7UrZh2IUDWpPiTgnhRVtKOswBEYczq3quAaD6g3LTUSvfIM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTQ2-g911-_mmdw1zYAwNbVsv4RacxsmZb91fd39CMyQ&oe=6A7DA98E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1155009776085852", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391830_1155009779419185_2842688762588032358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65tIy46NuHMQ7kNvwHSzz6-&_nc_oc=AdpxnSZDWcKlC47h95S7DALN_fIioPAeYoyY1n4-tJ9CI_zGBxI_Et4H75dE4PzPNLs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXP7xe2ADwKFPcY5riB-eRr3wSrbpO2pyDyuvfSDlnuA&oe=6A7DADB4"}, "display_name": "Aim Shooting VR", "keywords": ["aimshooting", "shooting", "gunhandling", "sharpshooter", "aim"], "long_description": "Ready to sharpen your aim and master the art of shooting? Aim Shooting VR is an immersive virtual reality experience designed to help you improve your accuracy while delivering intense, realistic gameplay. Whether you\u2019re a complete novice or a seasoned shooter, this game will guide you through every step of the process, from taking aim to pulling the trigger.\n\n\n**Challenge Your Accuracy**\n\nPut your precision to the test as you gradually advance through a series of increasingly difficult targets. Start with simple, stationary objects, and work your way up to dynamic, moving targets. Every shot counts, and every miss teaches you something valuable about improving your aim.\n\n**Immersive Shooting Experience**\n\nStep into a fully realized VR environment where you can experience the sensation of holding a gun, aiming down sights, and taking a shot. The game\u2019s immersive design makes you feel as if you\u2019re really in the middle of a shooting range, ready to take on the challenge.\n\n**Step-by-Step Instructions**\n\nAim Shooting VR offers voice-guided instructions that lead you through the fundamentals. New players will appreciate the intuitive, easy-to-follow tutorial that teaches you how to hold a gun, load it, and fire accurately. It\u2019s like having your very own shooting instructor by your side, offering tips and feedback.\n\n\nWhether you're looking to hone your shooting skills or just enjoy a realistic VR shooting experience, Aim Shooting VR has everything you need to become a sharpshooter.\n", "short_description": "Get ready for an adrenaline-packed VR experience! Aim Shooting VR challenges your accuracy and reflexes in a thrilling, guided and immersive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies"
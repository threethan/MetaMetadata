luscdn.com/v/t64.5771-25/57575348_796034405324944_8908986719027688797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RseaaCrDp2wQ7kNvwFzh_QZ&_nc_oc=AdroyYCzJHKNQQHuH6-lzY8NxNEaaAL18xi1MQ_mT_blI_k2IFBEauBKQkigKWREIZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6ewWDldRGWoNANnQMLFcoZLOtfKIozPj42jTSvlPiNA&oe=69CF9D8F"}, {"file_name": "08.screenshot5.png", "id": "295911690214865", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974673_295911693548198_2567195772866003076_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T7aZZRAiJQQ7kNvwFcYduY&_nc_oc=AdpBlej0fikdPC39S8DLzUw4l9PBwfw6rdZKHJz8SYIe64IWcWG7w6zeT3RCDK_bTrI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2uAcPcAhEUSMHvtsw1c-f2cipJSbUGr6n_7aLTGdMmw&oe=69CFBE27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10.coverImage.png", "id": "960323861972159", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974763_960323865305492_1348944185261368978_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLYRkWYnq5QQ7kNvwFgE2nK&_nc_oc=Adot-FcLhvv0D3rFncwYbzrC8hoD7HD3r7fSXVEk7C7IM9uO1Kbg2jCDGPxmUymoyyM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ3J9kMur429aqk2Y89nw6avaDApAI3_ha2BwJS_xaMw&oe=69CFB69B"}, "display_name": "Spatial Perception Training (Cube)", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "It is a cognitive game for cognitive rehabilitation training to help rehabilitate people with cognitive decline and mild cognitive impairment, and is designed to provide two or more cognitive experiences and training in the game. Cognitive Cube Game is designed to allow people with disabilities who have difficulty using controllers to play games through hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7225481560912519"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "518262341141537"}, {"status": "PUBLISHED", "id": "1879294155924348"}]}, "baseline_offer": {"id": "518262341141537"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727851320, "status": "PUBLISHED", "id": "518262341141537"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7225556140905061", "version": "0.1"}, "id": "360772393016725", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Androi
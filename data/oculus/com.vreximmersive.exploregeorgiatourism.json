awm&_nc_oc=Adl9DYVTy4WcmrJXhjAVMwOO7-Ob4kw-95CF3ngIZk5rhfa34Y_yDrt8IjbMe9iPceQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvlEKiiro0fNgxbe6y9iI8xm0OVgbjEG9yh_7glmy1MMg&oe=699EE452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "710986296206592", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031616_710986299539925_222049059878038742_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADgE9DehkEIQ7kNvwF72DpA&_nc_oc=Adl_GR7EaUOEha-0v1ry_fKXSkjuMh7a4oowAjmyBeHAnpQ7T_PGHcR4JKTXFs8kPBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs-sQxA8w0W63s6bxM4Aofjlm7rQsnzpcCAAe594kgigA&oe=699EE14B"}, "display_name": "Explore Georgia - Tourism", "keywords": [], "long_description": "With this app you will be able to explore wonderful destinations and landmarks of Georgia, the country, where you will find experiences totally worth exploring. You can experience destination listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and exciting Georgia, the country where winemaking was born!\nExperience Georgian travel destinations, cultural heritage and theaters with this interactive VR app. \nYou will be able to navigate through the app by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_
fzx&_nc_oc=AdkJUmaratU5U49sZHTP65Tx9t_yT3H8Pdw2L71rNe1T3KkpHtshoFnIWPANgalND8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afto3DgL5DSyjlsAnonTsiN08kC88ZdZPqy13b_OYMX1qQ&oe=69A6CD52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "710986296206592", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031616_710986299539925_222049059878038742_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f65AMBTZ9O4Q7kNvwGpgKCx&_nc_oc=AdnjSelVtokm7TxlXnDKkZGCTxVmadupKU7QopEHulTBHz0MQKoYIyzfHI1SosAuNgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOlQQe5bOBuvR_zF1Q3cn4_hpsUVPz8yWMELVX3QLOCg&oe=69A6CA4B"}, "display_name": "Explore Georgia - Tourism", "keywords": [], "long_description": "With this app you will be able to explore wonderful destinations and landmarks of Georgia, the country, where you will find experiences totally worth exploring. You can experience destination listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and exciting Georgia, the country where winemaking was born!\nExperience Georgian travel destinations, cultural heritage and theaters with this interactive VR app. \nYou will be able to navigate through the app by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_
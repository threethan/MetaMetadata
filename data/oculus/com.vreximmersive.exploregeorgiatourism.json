m/v/t64.5771-25/39001679_142654050581133_5522203472922701587_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzpSoLYoDcoQ7kNvwFiBQaq&_nc_oc=AdqUbd13OOw3uUdwLGqm-PyEQQezbYLP0D6mQB10ShbZsscUhU64th6eRVcXFxvcVmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgLXIawpxOT2hx81ZFQ3OZ-D9PDrdoQzZF9DQI_chBxA&oe=6A79BD52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "710986296206592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031616_710986299539925_222049059878038742_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK2AEetmpdIQ7kNvwFayb2Z&_nc_oc=AdqBTqWJuXdGlgJvFYCti9xXySC91oKdWySB0uOYqVP4D8uy1GkFkcVeQiGNobHuLcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrk-omYuGM2Krhfxch8DOqmO4Ev8ts5LZVs7lsUkWhNA&oe=6A79BA4B"}, "display_name": "Explore Georgia - Tourism", "keywords": [], "long_description": "With this app you will be able to explore wonderful destinations and landmarks of Georgia, the country, where you will find experiences totally worth exploring. You can experience destination listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and exciting Georgia, the country where winemaking was born!\nExperience Georgian travel destinations, cultural heritage and theaters with this interactive VR app. \nYou will be able to navigate through the app by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOM
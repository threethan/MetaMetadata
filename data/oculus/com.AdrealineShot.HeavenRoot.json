ome dangerous enemies and obstacles, and ascend from a forgotten forest into a mysterious realm above the clouds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/heaven_root.html", "developer_terms_of_service_url": null, "publisher_name": "Adrenaline Shot", "support_website_url": null, "website_url": "https://adrenalinshot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290873414113925"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1108295485395155"}, {"status": "PUBLISHED", "id": "1676528546758245"}]}, "baseline_offer": {"id": "1108295485395155"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792328880, "status": "PUBLISHED", "id": "1108295485395155"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1317580441443222", "version": "2.2"}, "id": "2229396481247468", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1191645404036727", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1317580441443222"}, "release_status": "RELEASED"}, "binary_
 [{"file_name": "3.png", "id": "1058902872442952", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_1058902875776285_582379396325433195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuFuRRf4-5wQ7kNvwGeb-O4&_nc_oc=AdouyjghYg5JbCsirjrkb8dMBVUr_RC36ekKpB86guCfyMD7ORsGxufsO9EAIQhR7P0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmBhxkxIyrXiMCo-3sSvwDoNjTMcB3XCMrxgxaL-xkRQ&oe=6A831862"}, {"file_name": "4.png", "id": "3159172174249013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303976_3159172177582346_1057913720159975327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTfFbguVFCkQ7kNvwFZllvi&_nc_oc=Adoa0x5dGCpzS-WsIXgAYAAg3mverjIzPtp5ZXr880onudcoGGLCks15d-oeqmsgUgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGw8EpwJWmnrShX-SGBaHx4E1A4ybS5-8jtLnErp6Ug&oe=6A82E297"}, {"file_name": "5.png", "id": "2195706870865990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825091_2195706877532656_2331682641371329085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W37qRuL5xdQQ7kNvwGbyy2Y&_nc_oc=AdoxgTi7qGfFY2-MR8Q04IhW7VNI4uePKVonzs4gIyLFvWkS_N6hqhjSuK12xMbHbgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Wk7tBgxyW_V8D94c-eUZXF1QkXK9jPm4NamygNYK7w&oe=6A82FF65"}, {"file_name": "6.png", "id": "1498020834897615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822883_1498020838230948_31866027641037642_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbfafru1_9IQ7kNvwFV5K4-&_nc_oc=AdrhlwqtwMOGiiUJkkKulbWseGMV8s1pHiPXWE6YWinH9tFkYGPXOc2HMSWqyvh-u2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH56BmYTtcPUrjLnik6oWwkur-R3FlAlT8zlsiDVkLg6g&oe=6A82F0FE"}, {"file_name": "2.png", "id": "2077300049445010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303707_2077300056111676_1325654491941750820_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVGlqK2V54UQ7kNvwFTJzC3&_nc_oc=Adq8_SuN9ZudZH1Zs-o20bX3jzqxmVQwxuRZja-_bV6rwnP_teNVxrMaHi2ZlRMiGHs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ_dyCjiGr9nOo5fCmXQcH9KIgXTJGfLqKDkNrqXOo3g&oe=6A82FC48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Updated.png", "id": "776061208870984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_776061212204317_3233657376522468233_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vZECk5V32QQ7kNvwGw4zrQ&_nc_oc=Adogb03vGtNpiM7ynUyjjFps8v1YovrLVIVcxz66OnLtspCWD8TocfOj9Hu5E7yMEig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFssBkX0vpS9hUE0QnzqS2uxqztX0sQqLQeDLLIGln35g&oe=6A830EDD"}, "display_name": "Riddler's Ransom Escape Horror", "keywords": ["escaperoom", "escape", "puzzle", "horror", "thriller"], "long_description": "**Hey there! We put this game together as a fun little demo, and we\u2019d really love to hear what you think!**\n\n*------------------------------*\n\nYou are trapped. The door is locked. The voice of **The Riddler** echoes through the room, taunting you with his latest challenge. He's designed a series of intricate puzzles, and the only way to escape is to **find the hidden clues, solve the riddles, and uncover a four-digit code** that will unlock the door.\n\nBut there's a catch---you only have an **hour** to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!\n\n**A Fully Immersive VR Escape Room**\\\nThis **VR-exclusive** experience places you in a meticulously crafted escape room filled with interactive puzzles and hidden surprises. \n\n**How to Play**\n\n-   **Listen Carefully:** The Riddler sets the stage, giving you just enough information---but never too much.\n\n-   **Solve His Puzzles:** Use logic, observation, and problem-solving skills to unravel the hidden clues.\n\n-   **Find the Four-Digit Code:** Every solved challenge brings you closer to the answer.\n\n-   **Beat the Clock:** You have **only 60 minutes** to complete the game before it's too late.\n\n-   **Unlock the Door:** Enter the correct code on the keypad before time runs out to escape.\n\nDesigned for **single-player VR**, *Riddler's Ransom* is a high-stakes escape experience that tests your ability to think quickly under pressure.", "short_description": "You are trapped. The door is locked. The voice of The Riddler echoes through the room, taunting you with his latest challenge. He\u2019s designed a series of intricate puzzles, and the only way to escape is to find the hidden clues, solve the riddles, and uncover a four-digit code that will unlock the door.\n\nBut there\u2019s a catch\u2014you only have 20 minutes to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!"}]}, "developer_name": "Liminal Tech Pvt. Ltd.", "developer_privacy_policy_url": "https://www.liminal.in/riddlers-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Liminal Tech Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.liminal.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26672378609015466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_8969331
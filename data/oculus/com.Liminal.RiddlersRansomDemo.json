ts": [{"file_name": "3.png", "id": "1058902872442952", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818916_1058902875776285_582379396325433195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG7HhppWEjQQ7kNvwFfQ5xp&_nc_oc=AdrXByqZDI5vZIau5kz29Xjw-r54GI9FUnV73WC81fYLkidUPnlQtDxmShFByMZtj50&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sw-R7mloxT68uIQwJpmSc0rZ-Md-KlByVEgLt9PsSSg&oe=6A22DAE2"}, {"file_name": "4.png", "id": "3159172174249013", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303976_3159172177582346_1057913720159975327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MY6upsPdQ0Q7kNvwFThdaD&_nc_oc=AdpG6wSoi5lZwfr8d73iO6PKkeo9BVfyNn7HXehWlrQdB21chER14z4evFnYKGDBT-8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MOuUrKdY7AXRSahmdV_OXRDZnSA4eHvE33PKZ38KBPQ&oe=6A22DD57"}, {"file_name": "5.png", "id": "2195706870865990", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825091_2195706877532656_2331682641371329085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWo6GbG3-1IQ7kNvwFK6VGq&_nc_oc=AdqZjw4NHWZGCuwj8xxCy9aJ9bzNeS4c8jGXajcb3H5KUhDRCm9tOS7sjEoTet_x4pA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CKg4MKmylyqKoiOC5b5sO67Xj5Yeg8Tvl6CIOhX1kkg&oe=6A22FA25"}, {"file_name": "6.png", "id": "1498020834897615", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822883_1498020838230948_31866027641037642_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaNpq6zDq60Q7kNvwGO0Y5o&_nc_oc=Adq_9YRBmZsansf1OPUkga6PP46RlTEUEJ3moBTfof410LVDxLI0JulV3myqPp_4LAk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af974_9slbesArRzbZxyqleRtDIbrQgYrkVFjm6MvJpWaw&oe=6A22EBBE"}, {"file_name": "2.png", "id": "2077300049445010", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499303707_2077300056111676_1325654491941750820_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdcZ3eXS7EsQ7kNvwF91IXd&_nc_oc=AdqmtJZKd2U8YBCLUN0PwvSIDUieVTkO5u4zxupM9urSWXgm0QSiSZ5lyjxKTuyoL74&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Iwi_N_4Ltk-nqoPd6YbTu8-0De73ITTsGQVVsMPcag&oe=6A22F708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Updated.png", "id": "776061208870984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823905_776061212204317_3233657376522468233_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ib6I55HNCoIQ7kNvwEt3qjZ&_nc_oc=AdpxfkT9aPHhbX-VoJLyFmummRDSM-hn246OXFntjePqTmIekatX4oK6pqK5-OB5ras&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z81byE8Rfl5PzRJ5sOKGZ5aNiMzpL_ZfzVOGWQhxe6Q&oe=6A22D15D"}, "display_name": "Riddler's Ransom Escape Horror", "keywords": ["escaperoom", "escape", "puzzle", "horror", "thriller"], "long_description": "**Hey there! We put this game together as a fun little demo, and we\u2019d really love to hear what you think!**\n\n*------------------------------*\n\nYou are trapped. The door is locked. The voice of **The Riddler** echoes through the room, taunting you with his latest challenge. He's designed a series of intricate puzzles, and the only way to escape is to **find the hidden clues, solve the riddles, and uncover a four-digit code** that will unlock the door.\n\nBut there's a catch---you only have an **hour** to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!\n\n**A Fully Immersive VR Escape Room**\\\nThis **VR-exclusive** experience places you in a meticulously crafted escape room filled with interactive puzzles and hidden surprises. \n\n**How to Play**\n\n-   **Listen Carefully:** The Riddler sets the stage, giving you just enough information---but never too much.\n\n-   **Solve His Puzzles:** Use logic, observation, and problem-solving skills to unravel the hidden clues.\n\n-   **Find the Four-Digit Code:** Every solved challenge brings you closer to the answer.\n\n-   **Beat the Clock:** You have **only 60 minutes** to complete the game before it's too late.\n\n-   **Unlock the Door:** Enter the correct code on the keypad before time runs out to escape.\n\nDesigned for **single-player VR**, *Riddler's Ransom* is a high-stakes escape experience that tests your ability to think quickly under pressure.", "short_description": "You are trapped. The door is locked. The voice of The Riddler echoes through the room, taunting you with his latest challenge. He\u2019s designed a series of intricate puzzles, and the only way to escape is to find the hidden clues, solve the riddles, and uncover a four-digit code that will unlock the door.\n\nBut there\u2019s a catch\u2014you only have 20 minutes to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!"}]}, "developer_name": "Liminal Tech Pvt. Ltd.", "developer_privacy_policy_url": "https://www.liminal.in/riddlers-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Liminal Tech Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.liminal.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26672378609015466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/49182170
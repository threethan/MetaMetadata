 [{"file_name": "3.png", "id": "1058902872442952", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818916_1058902875776285_582379396325433195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wV3VKDhC4IQ7kNvwELjTAF&_nc_oc=AdrZ_87xHIP3cSSP-xv4eodztivOHR-UCDVvn1GEZGbOB67BtnjpwC4NMil8QF-TORI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnJkP0AXjG6vQE9OX_DVvlvZqQWJoEdHCmmzE3T0bwbQ&oe=6AF327E2"}, {"file_name": "4.png", "id": "3159172174249013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303976_3159172177582346_1057913720159975327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PotrrGFZmMsQ7kNvwHLVHMH&_nc_oc=Adp1E8xYM_n8bPrsMAsXv9aVr30NLW5LRWHU_9vu7QqbMlkEDDNtl_500HJPuWFoCxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaETbDCzU6eY_iFRa7Lg23ernhQ27aGu3_b85vUyBORg&oe=6AF32A57"}, {"file_name": "5.png", "id": "2195706870865990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825091_2195706877532656_2331682641371329085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-Ca3iq0fQsQ7kNvwFkOZIX&_nc_oc=Ados37-c2IeqweeYQSbTrB3TxA3Dls4plgYQ4b_fryaEzXBhr_g2Qgrf2Clu7YNmK2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROA9cZCgwWqu8M3948cGD3Gb5sx36eT3estmjHYEZLOw&oe=6AF34725"}, {"file_name": "6.png", "id": "1498020834897615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_1498020838230948_31866027641037642_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAyUqoQGNR0Q7kNvwFfs_js&_nc_oc=AdrrQvxhmvXRuLu2DHEkkmcRl6RBuEEIy46g1tZ6XgWpWDKQWdc4aci7litgLngN8MA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoOv2Whg5mrGvpzSA4QM8TJRUcOkfweVi_998xSLRE2A&oe=6AF338BE"}, {"file_name": "2.png", "id": "2077300049445010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303707_2077300056111676_1325654491941750820_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pgzqpd1a-0Q7kNvwFM2FnK&_nc_oc=AdoQ1LQBgLW71B_jYVDf5hpNN3dyzdu9Jx475QP2Y2PDFIUsg5VyQyaYq5ls9qgDJl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmCEBfdq--3DEQmHYBOTiU0bYVUoZlVJXuSq53eQ21qQ&oe=6AF34408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Updated.png", "id": "776061208870984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_776061212204317_3233657376522468233_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4-1Mdud--wQ7kNvwF_PrrX&_nc_oc=Adr_b5oktyzq6fnxH7DhNx1-YtPgTeYc3km91trvjeVai1ZFdB6B7P9avw29pDbEa40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQao3hmjnD_6nIyPhycrLHq1RinWwy_CridxDAUysHO1w&oe=6AF3569D"}, "display_name": "Riddler's Ransom Escape Horror", "keywords": ["escaperoom", "escape", "puzzle", "horror", "thriller"], "long_description": "**Hey there! We put this game together as a fun little demo, and we\u2019d really love to hear what you think!**\n\n*------------------------------*\n\nYou are trapped. The door is locked. The voice of **The Riddler** echoes through the room, taunting you with his latest challenge. He's designed a series of intricate puzzles, and the only way to escape is to **find the hidden clues, solve the riddles, and uncover a four-digit code** that will unlock the door.\n\nBut there's a catch---you only have an **hour** to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!\n\n**A Fully Immersive VR Escape Room**\\\nThis **VR-exclusive** experience places you in a meticulously crafted escape room filled with interactive puzzles and hidden surprises. \n\n**How to Play**\n\n-   **Listen Carefully:** The Riddler sets the stage, giving you just enough information---but never too much.\n\n-   **Solve His Puzzles:** Use logic, observation, and problem-solving skills to unravel the hidden clues.\n\n-   **Find the Four-Digit Code:** Every solved challenge brings you closer to the answer.\n\n-   **Beat the Clock:** You have **only 60 minutes** to complete the game before it's too late.\n\n-   **Unlock the Door:** Enter the correct code on the keypad before time runs out to escape.\n\nDesigned for **single-player VR**, *Riddler's Ransom* is a high-stakes escape experience that tests your ability to think quickly under pressure.", "short_description": "You are trapped. The door is locked. The voice of The Riddler echoes through the room, taunting you with his latest challenge. He\u2019s designed a series of intricate puzzles, and the only way to escape is to find the hidden clues, solve the riddles, and uncover a four-digit code that will unlock the door.\n\nBut there\u2019s a catch\u2014you only have 20 minutes to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!"}]}, "developer_name": "Liminal Tech Pvt. Ltd.", "developer_privacy_policy_url": "https://www.liminal.in/riddlers-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Liminal Tech Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.liminal.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26672378609015466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_8969331
 [{"file_name": "3.png", "id": "1058902872442952", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818916_1058902875776285_582379396325433195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGAtGCDuT8kQ7kNvwFicvY7&_nc_oc=AdqvRIxlmAJIAFQ2CpVDzV8ugKCOHUSl9cndA6e8FO1FPuaXo9uc0go7RcGJYD61TpI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e6I4FvJOo3-XR4ViUSe3fxMR7miwMPKT_PR_Gdesw-w&oe=69D7B562"}, {"file_name": "4.png", "id": "3159172174249013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303976_3159172177582346_1057913720159975327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wf7v0pPbeIQ7kNvwGLGz-3&_nc_oc=AdrV74rAjbh6lSSE1Tclietw3FPH877496HnHQkO1XFSuETDB4gb_JgztLXRambA5J4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DolY4VYpBZUekwFjTXmIXbiBXkxNT1ATFgqx26phXrQ&oe=69D7B7D7"}, {"file_name": "5.png", "id": "2195706870865990", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825091_2195706877532656_2331682641371329085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsrgrC-wDEwQ7kNvwE9jHF9&_nc_oc=AdpH9zkXP5wZEoJiV4FaRhaPpyJj3AKOtj3XhQHDhMQg73hEw6Xqpljop3g0UL04nw4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tkdln0UyL_62JBkFsS6rlWho0f9T-Uen0mre4efmDrw&oe=69D79C65"}, {"file_name": "6.png", "id": "1498020834897615", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822883_1498020838230948_31866027641037642_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05gOa6IMNIUQ7kNvwGdV6HV&_nc_oc=AdpjqJmkMRayy_YUp5Y4OhII3h5TrVnV6yYO1-zzHSvvDhfyJBDVOSmD-EP_lUnZ4fM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ok45SUU5nLumjrMzGvtZiWCJIl-cpVRfxtNfyDPm3XA&oe=69D78DFE"}, {"file_name": "2.png", "id": "2077300049445010", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303707_2077300056111676_1325654491941750820_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijXJoAWSW-kQ7kNvwGKS5EL&_nc_oc=Adp0DmtIjEX2EAYnNOpIw-Ih-qWJpo8af73RJGKwRdJkd41TCWqHxFdQHjDSCjiu6yU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oxbYde5GXrQwNiW-NA5oTnu1Zv7WST_M_MHoga9NO_Q&oe=69D79948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Updated.png", "id": "776061208870984", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823905_776061212204317_3233657376522468233_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu9gWIKNE94Q7kNvwFTKH4s&_nc_oc=AdqYo2GO0t2znPKVzTp4ROSJVcxCxNZeBIi7k3ICwYjLIGl3-2qmmLpkbWPZvEz3p88&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AgHyBZH-kwwfkNw1QaxLqMM7s9df_l2BB0CgYd5SEiA&oe=69D7ABDD"}, "display_name": "Riddler's Ransom Escape Horror", "keywords": ["escaperoom", "escape", "puzzle", "horror", "thriller"], "long_description": "**Hey there! We put this game together as a fun little demo, and we\u2019d really love to hear what you think!**\n\n*------------------------------*\n\nYou are trapped. The door is locked. The voice of **The Riddler** echoes through the room, taunting you with his latest challenge. He's designed a series of intricate puzzles, and the only way to escape is to **find the hidden clues, solve the riddles, and uncover a four-digit code** that will unlock the door.\n\nBut there's a catch---you only have an **hour** to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!\n\n**A Fully Immersive VR Escape Room**\\\nThis **VR-exclusive** experience places you in a meticulously crafted escape room filled with interactive puzzles and hidden surprises. \n\n**How to Play**\n\n-   **Listen Carefully:** The Riddler sets the stage, giving you just enough information---but never too much.\n\n-   **Solve His Puzzles:** Use logic, observation, and problem-solving skills to unravel the hidden clues.\n\n-   **Find the Four-Digit Code:** Every solved challenge brings you closer to the answer.\n\n-   **Beat the Clock:** You have **only 60 minutes** to complete the game before it's too late.\n\n-   **Unlock the Door:** Enter the correct code on the keypad before time runs out to escape.\n\nDesigned for **single-player VR**, *Riddler's Ransom* is a high-stakes escape experience that tests your ability to think quickly under pressure.", "short_description": "You are trapped. The door is locked. The voice of The Riddler echoes through the room, taunting you with his latest challenge. He\u2019s designed a series of intricate puzzles, and the only way to escape is to find the hidden clues, solve the riddles, and uncover a four-digit code that will unlock the door.\n\nBut there\u2019s a catch\u2014you only have 20 minutes to escape. Every second counts, and The Riddler is always one step ahead, challenging your ability to think fast under pressure. The clock is ticking!"}]}, "developer_name": "Liminal Tech Pvt. Ltd.", "developer_privacy_policy_url": "https://www.liminal.in/riddlers-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Liminal Tech Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.liminal.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26672378609015466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821702_8969331
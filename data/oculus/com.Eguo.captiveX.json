RoG&_nc_oc=AdpPLCflxbn6083b_gVtQOw8Q9SfzxsOUis7hOlxr8Seq1eJMn34nY9FVht4voNiSpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStvj3e6zadPqQFCclNJy-wI3_uI8bUDRlsAtTlRMMMMg&oe=6B032FFF"}, {"file_name": "captivexss3.png", "id": "1306848117219015", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391984_1306848120552348_3033397365832698129_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VNpefjx0Z4Q7kNvwFx9Ien&_nc_oc=AdofU4lI_VrLe0zj7kSMLYg1BTYMHz3Aqye6qjLC869fyvFGYFOit9dG1wKMsb_kHXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQOVwy_xD4uH6S4UPAZBY8Rio84OP3xqj0LR_dXBmDg&oe=6B03265E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "yokocaptivex.png", "id": "1375940026743341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_1375940030076674_7083663585491012012_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gEyY3pVByAQ7kNvwF8VuF-&_nc_oc=AdqFwUtLVDrVSapka__-Ut93ZmOx7WLyETNt7KrJWN8bc3WcputSSUNlLMydEhVUm3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkfdFd4Olgjor0GG4UmSNJzJdH1qMF4ldNM441hMZWNQ&oe=6B032657"}, "display_name": "captiveX", "keywords": ["music", "audiovisual", "vj", "techno", "dj"], "long_description": "A new dimension of Mixed Reality FPS.\n\nThe player shoots and breaks the empty cage, freeing the mysterious X.\n\nThe unleashed X attack, forcing the player to fight back. But at a certain moment, X\u2019s life gauge reverses.\n\nInstead of violence, the player must restore their life gauge through music and make them dance.\n\nShooting releases, selects, and combines music items to perform music.\n\nAn interactive audiovisual experience that blurs the line between reality and virtuality, redefining FPS.\n\nA completely independently created art game by new media artist Eguo, who won an award in the Interactive Art category at the Asia Digital Art Award FUKUOKA 2024, is now finally available to the public!\n\n# About the Creator \u2013 Eguo\n\nEguo is a new media artist from Tokyo. He creates numerous audiovisual expressions that combine self-produced electronic music and visuals, including live performances at Boiler Room (as Video Bouillon) and other events, video works, video games, and XR works. For his XR works, he received the PARCO Prize at NEWVIEW AWARDS 2021 and won an award in the Interactive Art category at the Asia Digital Art Award FUKUOKA 2024.\n{972807947654139}\n# Game Controls\n\nStart Game / Shoot : Trigger Button\n\nMenu: Left Menu Button\n\nSelect : A Button\n\nSound Effect : Left Grip Button\n\nSpeed Change : Right Grip Button (Non-Game Mode Only)\n\n# Settings\n\nArea Mode (Start Screen Only):  Room / Cage\n\nGame Mode: Game / Non-Game\n\nColor Mode: Color / B&W1 / B&W2\n{693550373348536}\n{1206868737639486}\n{1419891572714647}\n{954636556817187}\n{2127489154347683}\n{1708997543382846}\n{1074675164684965}\n{1331925147924654}", "short_description": "A new dimension of Mixed Reality FPS.\nThe player shoots and breaks the empty cage, freeing the mysterious X.\nThe unleashed X attack, forcing the player to fight back. But at a certain moment, X\u2019s life gauge reverses.\nInstead of violence, the player must restore their life gauge through music and make them dance.\nShooting releases, selects, and combines music items to perform music.\nAn interactive audiovisual experience that blurs the line between reality and virtuality, redefining FPS."}, {"images": {"nodes": [{"file_name": "captiveX\u8aac\u660e\u66f8store8.png", "id": "3978460582368639", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392179_3978460585701972_4602917864483253301_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3bsg8Xlzw8Q7kNvwFS3B_6&_nc_oc=AdpxPE_JwNDV3Z8FZ5NYiwWc8ZRLl92v8iGveeLvq02GgZCwmxSVBGYC2gxeEm_Q0Ks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXFW
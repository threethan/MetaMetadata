ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZc1UAuZCw8Q7kNvwGZuRT0&_nc_oc=Adp5qegqHuohmcysSUEgbsykyI3QqMFryAGk2iG9rR9gFVz4UJEZsvTyayKaM9F426g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPXkLuL4UZ-kZqZ9tlDLfE8N2BP_7MFS8aAs5OTV2XAQ&oe=6AA96065"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8fzTB1zavsQ7kNvwGx-_bQ&_nc_oc=AdoGpbppWNUfXqJ6G4IG7EmZIoiOpeBkSF4ePHRxwAWnZdUKw1OMmdTRunVKQEKNdbE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl_qAYThtEBT56-WtuDI7Q2akMejdUwy5Y9_c2laMRAg&oe=6AA94A2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c66lvb4AwwsQ7kNvwEeQLOZ&_nc_oc=Ado_1kv1A3rwofbBKY-5JLkHtiLEY2ejkNnBhOuL58YU_IG8wPG7jYPKyHwhlIELAVA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBpuqR1VgvSWtXBqUVbSnG5HKuP29plw66EoFNDmg-LA&oe=6AA93377"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZkzxy6PiQMQ7kNvwG0dNRg&_nc_oc=AdrOdP90xMWQVFZWD58it7B8Tmj8349aKWv6MPuC4GT3IAP8mrytzdfZElxojljqVOQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCdunKal5TqIczXVzJbagq241c_kWVopcHB3FVg9YUTg&oe=6AA951FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCaiMNswDjsQ7kNvwGtDLl0&_nc_oc=Adq1Pkqo2bTPckH-zHkF2Yf7pwd7SCtoQPJpOG3D6VNaTjh7lxpf0xvbV09xVsxorro&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlNEjKiAAPmflytWo2GJppDo7zPv8i-xXLBGuYACjBCg&oe=6AA93D94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
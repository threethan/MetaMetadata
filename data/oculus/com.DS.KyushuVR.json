ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnv0BH-1OvkQ7kNvwE2fjLN&_nc_oc=Ado2i-ljGog2jX10Mj9ld7An3-nmIV9sSqp1w_FZytxozBMSWiSaM5ZcGrcum7yjbAY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDphNh3IsmGACD3-6rl9AINTp2WWuGY5feo5-MOpE5rg&oe=6A7DA6A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL4N_scqN00Q7kNvwEY4TvU&_nc_oc=AdoT1kh3MOXA5Yu0ne6_Fay6bcT3lJtIuKt9lzHC236ms9zEzvjBSZpS2tt6qh7KrZM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMY8aJNCM4dQzx5rhVMqxkuaG_EnNUfvqDFcGIiY59Zw&oe=6A7DC8AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXeRBN71yegQ7kNvwGQEmnB&_nc_oc=AdqULo4Ks3dBDLdSF6c31vbzTbXqisMkG-sZjk_UJyWs9epbiDANgLpQvHBpjphhc0E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRgUJDX-z9YIBtGtt7UUPRthYW7fjAr3gfJvmG-NYrKA&oe=6A7DB1F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COszoa6mD3gQ7kNvwE108r0&_nc_oc=AdpOPfH4KVkJwQPifiw19a70_hVhskl32k3oQ9ACdtyYJS6CrpA4oS62-JgW6zpii9s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJt0aF-SsUj8PutOZo8I6kW9qxG5Siq5qxQPvpXU8IAA&oe=6A7DD07C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhYvvzk-QYkQ7kNvwHKi-kW&_nc_oc=AdrCZEA_DyZ_gexDTHu4Wqvu6ElajMQgyP1w0ro32gjqRyR3-AEOOaa7YgjSqNupUCA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsqgFg4UbefKq3M1Wugnpmv1km0tsVbriGM393QagkGg&oe=6A7DBC14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
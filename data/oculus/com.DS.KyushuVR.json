https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjoiYiONI5AQ7kNvwHbRF92&_nc_oc=AdooXyfSk-5FMrj-tL-jKAa5s2OfzwcAaRR0k2k_LAQHkHkHH9P1gcSn0EHte0cDR70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SZSzrXCjvUp23KnySHKCKYhbiqpIUVf78rwE2jNHP5g&oe=6A2D7365"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geT2aNFvDQIQ7kNvwHZLnJy&_nc_oc=AdpO2cQHKxot2i2fn1irkqwdPu9cmigQTegEfHBR09kmPpx_78yZYuOo-4r-tdDr6ys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GP7nlGFrvDL4yCF0mxukDnb5fIgCusyhQola58H6Lzw&oe=6A2D5D2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1i0bKDEaEUQ7kNvwFTmn7Q&_nc_oc=AdqTRg_62e-ygzN6g8lz7mckG5G6suKMX7jmDl9PnP4FTWxvbLfKSSZ6yuegr9L3iuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ifbiHAV2y3bPqJy1RSDi4TIBBjgDSKNSoXMhcqGDC9g&oe=6A2D7EB7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahCOvi3h_PYQ7kNvwGGNDNi&_nc_oc=AdpyIxYoMpioS__KO5t2-GXqmGlpEQKPDk29AmDI6VwqfG30nyxFPrI-Qbn_ClOymMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-seM9n2p17sTV-cEPxf3hnOe8Z45D0eD1ADqPSfU8IQw&oe=6A2D64FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W0EX-DlcvQQ7kNvwFTvsw9&_nc_oc=Adrtv3aGRGlQ2PE5QeBYteD_BdBOwvLao3QWeBhjw3M4UYHlRgc8LqC2qirHMTF_roc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L--njcbcczwY7teh2MxmVGVRLfPUEmtuba4DaMEYexA&oe=6A2D5094"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
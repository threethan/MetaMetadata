https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l9mH2eCrgQQ7kNvwFw8DWe&_nc_oc=Adr-1I_T4SNroP3TEpwMQIvh_FZu0oDHqDjxgMv9ab3PEXZCpC5YpGPA39aKaMKA7iU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV8Wy7haoOaegxOlqnB7lH1l8evQyBySXhzLvPmddJ5A&oe=6A525D65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtrtoXe_6wEQ7kNvwFoJhP9&_nc_oc=AdpSIHY_M_e42C9HUtVrmNwID25Ax1CUr4aT3X2SK3uGRmVZEPIxgMkvZ7iFWpaoDBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLWTr4MD05tFBVmhnOnRExRP2aXJD1U4eP0QSjRiRCCA&oe=6A52472D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U_08yMrZZcQ7kNvwHIE9Ga&_nc_oc=AdqMmh1suKQoRoWVtDNeaXKhQit-_m7LL__kd0ClQUvJsA50QtCQXZoTFEJl4WYogu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD04isV6a5vWP-k5wQCUfZFpDWngLR8lY6reiM58uMN9w&oe=6A5268B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY44q0GMQZIQ7kNvwEyqaS6&_nc_oc=Adrg3BFz261nwkZthy5Ig-k6hl4zLux8ucPZSSdD6G_5M0s_3ZLV75hxUbPc0PlS6eQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7L5Rt3q79By4KFC4mbaaUQ2Btt4zZo7dzu4f2LhUxzg&oe=6A524EFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VP7f9nBYw0Q7kNvwETgznz&_nc_oc=Adr7OhjObEtudzDWZ3Il_p9x5O0QDe_lX8X8ssfHb7A-DCWZY5AlN-R4ZpwoNacN1s4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn6htsOG92NFVnxT2rer_5oYGIM369BkE_x_gUp6QAhg&oe=6A523A94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
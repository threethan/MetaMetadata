g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arqxNFuewwwQ7kNvwFY4ABO&_nc_oc=AdqVY9HsR3av4ws5hhMGFekWvPPiryqQml9ytCVQLeie7ACzfhIQjIrH5FPPERLp5-c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhS0QVPZemC3XEynpQdyAGt5TDv42AMWh29BDC6hIwyQ&oe=69C7D9AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHwj4vA6GwQ7kNvwGBkeCz&_nc_oc=AdroVutARELdZ7lcX49BWM2RGG_wdAidGigYrfFWzNB0xFLXL0O2HPnrE7FxTkMBsO0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy1g9w-0lEwLUY2JBI6mEynbdxwKCTrvnlqzn6XEJIPg&oe=69C7C2F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGILZTC37vQQ7kNvwEXTU_T&_nc_oc=AdocJxUjfgEsVHpAAzEbzaBsd8e809CTtKBmH3jxnYUfq8kCntzdErvoqLQEjj5usJE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxw6g0SQ10O294sNqnLUQ5MlpKwU8xpDLjGlBVjkKWqhw&oe=69C7E17C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke7Ps5oLxqgQ7kNvwEozZeL&_nc_oc=AdqvDN4pTxXzTzFbEDEMle8WXu-W9aoTOS4ThvucMRIGPtNZuiYPnWfmL-Nu42dIxu8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5eSphs7b3afrAJtOilHj-cUQRzhutXupPKfA_TccYrw&oe=69C7CD14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "453868397385944"}]}, "baseline_offer": {"id": "453868397385944"}, "is_approved": true, "firstOffer": {"nodes":
https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylXjIPUJ81oQ7kNvwEX2mth&_nc_oc=AdrpUK_Am4bMLPfyiwCUqnzHpnDwWugdGG-BXdwvDdhGpNYF9xQuFLh1Kn_GJWIIh20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iweksPEJTJHxJfepXph7OGCAWqFoukjW9tNVjCBvdTQ&oe=69EDF325"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B47x4w_AXIkQ7kNvwFua7f9&_nc_oc=AdrsDATMKRt778AFbAwjakX1ZnvKxFk10tQdwjYaYitywau9dZiG888l5aSR5VslcC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o1B9JYzHMS9iqylRkwRCq3OP9oRLUzmCxPBOssd18cw&oe=69EE152D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JroVJrCDw34Q7kNvwEWiGfR&_nc_oc=Adr_lTcj74CvxVbzvzLw5Voz7nz5ZfnyuVf0jSEPZS6P4WWE29iTTZDJxVn9J1xsY7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E2ORtIXc0NcHnCGjXBqHuZJG92SMc4X0ScwvGnV2OGg&oe=69EDFE77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkCEXsikp6AQ7kNvwFodTz9&_nc_oc=AdqVu-iAJm_UASP6fF7IzpBPLrDsiVL7ZVZaTs1bvtxbDS5rc1aThXIaxFJ8sf1VILE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0juQoCUGMYDmjKu7A-SzCCOw0Mav63MU9Ge7Lo28RvCg&oe=69EE1CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCIjPtiu1JIQ7kNvwHw0xfZ&_nc_oc=AdpokImgbZ6KHSZFaNYwNOubDKXIXkk0BxzqCM19tK1MC2T7HV9yKYkVfMP0ybRzr_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lUOrKw9PRCXlCYw7l7Yi0TP7PAIhdcjN-l3T2YJWqLA&oe=69EE0894"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
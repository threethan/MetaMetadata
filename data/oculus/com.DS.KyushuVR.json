https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnv0BH-1OvkQ7kNvwGYCRYu&_nc_oc=AdrTYSar2usCg6zlRwL_7DJsNP1gPM2j7jaHc1LboVuhiKkxFhebFnrGUWuN52pnejI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrq-xmIxrZeeHfRajsaxPdJJKbvoc2fUtQyRstb688lg&oe=6A8049A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL4N_scqN00Q7kNvwFSLIEm&_nc_oc=AdqvhQmy-CumWyRGopOHGXVwrYY_SHdnJZoJbQxPcKybKZX-yOwCJ52P9R1OTaJRryc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_neduOTUewdzTxByIklOaoxbOKjWI0KSkKzfUR6Gg-Q&oe=6A806BAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XisEjcAdMH8Q7kNvwEpE_yQ&_nc_oc=Adp36B8E390BYzRkOlzO3wDxL1BdRvnPqOMr43zQ-zbH87jFDAKE-2yCEjCvcmm06LI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4fUlCZ1BapXvr4SwZjIhTma06cwEbaKWzg5NeAtj1LQ&oe=6A8054F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q47asudKTSYQ7kNvwFlfK3n&_nc_oc=AdoIK2Gj3VK20P76eWcfBjMArmLucchnZh7i4o6q1lvRHCOdalXQisLalKxZs-AxkYk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqTl3baw2jEeRKVWs8Cp3QmGC1WO-1SUh8_Aq3QOZx6g&oe=6A803B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7ibICb_gCMQ7kNvwHtvsXX&_nc_oc=AdoTm1-jEmndV2FclH_KuJAjC-0YRR7K74QnhqtRfcP8rMk-h56koVeepL9eC_1hNOw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-GacQrC9hIMUlcHr8uy1s--X6T9t_4LxKPBed7gdtFw&oe=6A805F14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
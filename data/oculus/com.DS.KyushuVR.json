1F7lrfc8nkJY2jZscRRGqaIm_Z8CXKu1x1VOfxYM4te9Mx6Rhdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBXTQ6ZgeYNvPbdRunA0aesS2JCXGZ0JCsb1T_zcpiKg&oe=69B807AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo59I8KHN-IQ7kNvwGOiMch&_nc_oc=AdlSZgB8vddCuLwS8AMagIb0eOuvOGD0Z1WiHDfeknQaRQyU4W20JsYimiuL1kZQr0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsBXMreRBtEraJGSd-Ekr-Rq1z9wu5gslnx7hYkglTdQ&oe=69B7F0F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC2wu_4a9gEQ7kNvwGIMawm&_nc_oc=AdmXPwfK3Ld0AAVrpVlQrpy_DT4Cmw2psgY4CU_0sKnbOfQuEfiKyfaJuR4nTPr9Oyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKn4TvwaM3hvW7NCvAW1aimlHFIPFxWyLz_5B5M6skFA&oe=69B80F7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJsKtwQb-v4Q7kNvwHyQp5r&_nc_oc=AdmZLfONtumZl3_W8B1zMu1_AZs3HopgdBrSkWe0M-vHrEviDRSiC71joqXOna84If0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFuJwSsbzUEPwayl4ON4salBv4vajAm0LbU5fEvyjN9g&oe=69B7FB14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "453868397385944"}]}, "baseline_offer": {"id": "453868397385944"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728304560, "status": "PUBLISHED", "id": "453868397385944"}]}, "liveChannel": {"nodes": [{"
https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqUskH_9zGUQ7kNvwGJlbgl&_nc_oc=AdoQtoXRpemIHNltyZpCMmyANMnpoKUasKmhBdsYCjg3fgiZCD8rhFRcpIw_i42_4dc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DdiNYLYfQLbTXR67V2kxEv490NpCKnNt-wGfOZ1FLaQ&oe=6A26DBE5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YABNAy6zZwQ7kNvwGXgnGG&_nc_oc=AdqzVGiB84RpViJ9QmAxg1r0goMnUAZwYIQ-e-F4HN6v2MuxZf1s_2MPplJOPAyCzCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FOl2x3h1UPIUiRFmSa6nwfsJ9SXueelqs43fKeawnkw&oe=6A26C5AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Y-hkUdE0RIQ7kNvwGBiK23&_nc_oc=AdqQmEvaXXepN3hWw6Cr2X0yY67EO7NhAEyfBK3XuzkcebcYRp6TN5Sdo4U2q83HVB4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ya95tZIezvtcEaYPkNXqbG1oTOCH3kcP066vT2d-BYw&oe=6A26E737"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jPFkDMlaEsQ7kNvwFcLNIe&_nc_oc=AdqIrLI97VuPFSoDrp9jbHcEdUJkNVpBoMdPsxd0IweFHd7G6B4YX5738M1KKY0YiOs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af870Z2Zu8-rO8g-LSY9VhWZd-p9F82v7c4ygEJHUZ2i4A&oe=6A26CD7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lBnZL4yW6IQ7kNvwEm4AzH&_nc_oc=Adqq5XRmAa0be3kHqfwLZ-OMri_TT-g5tkaR_QdYmO3G_ZSz_ZFoDPvo8xDK_3nWby4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--MaPpEYWzrdtc338CFHk-TxaJiVFmpjc27LTvdg_NZw&oe=6A26F154"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
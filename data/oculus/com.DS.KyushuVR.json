https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvPWw9Sr8ZwQ7kNvwGg9IQU&_nc_oc=AdrZEih390Ds3jaC7efQLVRa5HnvL6HPfJU4vKlItwnv1JsjIU-1MYM85AhjuOnmvZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrdPKH0BiE5-YsIkcz6cepOrgWEe8i6dIwo0nGj2wwWw&oe=6AF1E2E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LfE3X_S1ukQ7kNvwEX5QPr&_nc_oc=Adp6vOo_zJ1amhDEOzRaccqW2AhY5jYic4ybdMLU_3FZ8RnMF9o3KnnPXMM2Jii4fo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHl42hAIU-hPu832ClSS-5m_wVIvYucKwlySs9GB3goQ&oe=6AF204ED"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCKWartnIfYQ7kNvwE1SBZ9&_nc_oc=AdraW5EKbFRG_a6cIzhClf08CtkTSVUJKeQBkNKCEiGshPvVrsr1aWIG2B0MFOSqewI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu1QEotx8cUXA5LM328zZutD4yFUObK93jY9PPtkpn0g&oe=6AF1EE37"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8TSOxRrYBMQ7kNvwHn3Y1g&_nc_oc=Adoq1QxtIcy_Cbj2k_bw79nc_BaqSof6XhmwkwezfcK7aWXomoqJNKdtjIVGZ02xlu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmpjM0Ql2KsBlLsxzLGHZnjZ8vbA5VzDCCkPTQ--2yxw&oe=6AF1D47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVk8htoT2EIQ7kNvwFmriUX&_nc_oc=Ados4PbEdfEmsSY9gpBNhL6HMT_1vNOL_BG1HkVmd0vZbWBNQbj_5Zgupwx9pzsW4gY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsJ5fgBaIXrHLwo9Bl3h4OSHd-M-SmaQZi5kmUlLrUJg&oe=6AF1F854"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
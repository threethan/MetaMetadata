https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ABEhiVw534Q7kNvwHo5YHh&_nc_oc=AdoS8FgxXG09g3NItdUO-mv5CWjFbNtAdAbkT6hyfqSm65dE74klntR58W0qAXVDHRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNMpND3lZjgFgFGbUBoT2RpBmT0bKpagdO38_-UyZIng&oe=6ACF9BE5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1faKHSpald0Q7kNvwGg-sqC&_nc_oc=AdqrztZX3k8TYPTq-XUL_VLAnZhF0lLE8LOaNxD-sCrYMTuATPMtm0I_VIQ9a_CsS9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOsiMMrpXV07A2A9NQ8U9nNQ0BxAHWW7mxCNOiv1ixCQ&oe=6ACF85AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcAwUw7AG-EQ7kNvwEkJgOh&_nc_oc=Ado9ywT7czLD4H_9UAsfTELhJ9ryjytt1YLOIu6xhMi_p5frHjoazjnWY7q5nfb0ZC8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZmXxXdn1GssH1PgPqyMDNtTNLv7XSB3MxABW5huj6KA&oe=6ACFA737"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH54WpYNvOcQ7kNvwHIqufX&_nc_oc=AdoUV_EgFv97HJtvCrsXSQfbbV8LuG5Nc0615VFtOcNq6LZ-n9rXJgLfKa45YTloOqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWIdo0T-jpFo1yZBIqXdqGaZjtiiwJj-4DIl1Xbk3UEA&oe=6ACF8D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWtfqS76KhsQ7kNvwEUPAqr&_nc_oc=AdrAwf-5Rb42g05EKzp3bKGYx8V8RbWr-FVigRrimpHYsTVD7jfwjLknaSFOMle_DwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7TRj3lRb1dsCwMVFLGqa3XMb2kFqbHYmwawsYdF26WA&oe=6ACFB154"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
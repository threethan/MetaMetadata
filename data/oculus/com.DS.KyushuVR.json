https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsOWRcFcG0IQ7kNvwGuuL5S&_nc_oc=AdptufdB2-5TSbJ03jyVFnMafsN81w23gyTIDIq6AL6QvjME677tzTVKyfi6JX1U9Pc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iXbnw_AYz0cnpV8KPoLXc9fIrmeXDfkPeKCmHuD1kGA&oe=69F37165"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEnkUk3KE0QQ7kNvwFJJsBQ&_nc_oc=AdruZjnF2f8CF_-5OfJQ5jYqsyhEvo_Pzf791mZrR5IWPHGQSuq0k9_Q9dajOuaYXgI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eVjduPiELM2Bf8yXOk8HRBXH3HNyApPkG7fAaAQkZXg&oe=69F35B2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d5kpkp5OEcQ7kNvwEXkkmP&_nc_oc=AdqOZAM8LFZqxv_C6kxMAsig7QLXX6XRf8Mw12tzmsV5Aq8D4YuCp8mm9lvPNUypS2Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QkAy2BGLeEb6I5GQuMcu097ef_Hz176d4z9DsgiVaUg&oe=69F34477"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-EfHRZrpRcQ7kNvwGpew9I&_nc_oc=AdpVTUdWbDB6NthEvxVeG2tPOApSJXBhsNs1LqoeaoPNzHLEbGolAQTa14bb-1djr5Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jfLdISOo1YWYXXrpHVzaPPdos2sjjLHNoAQE12TukfQ&oe=69F362FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41dAgTkg_EQ7kNvwEuty5N&_nc_oc=AdoEv5eJ3EdJXlpAD-w6Nm9fNePtN9VAIzLz7_5661DNBqwiT6bIkb6p1yJNZ1pJi2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1F_5DX9ouX51IJQne2KJRYmZypSAhwWsUPw2K1gKP4Yg&oe=69F34E94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
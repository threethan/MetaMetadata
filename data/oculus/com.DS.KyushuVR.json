https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PgydlwPlfoQ7kNvwGPoVuS&_nc_oc=AdoY2YflEL2INdtsznLmynkjQTnNnH-cr_RsQy-qgawFvPItaZY6--ytOcugqNrd1Lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpE2PJjz9x3ew31Q6e2BdXDOFZNsuhNuQWn1rOscXjpw&oe=6A64D265"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah4NWcmG-OEQ7kNvwHz_SFN&_nc_oc=AdoepFrl2qDlE6BdO_4jl4Jwox804SNE29rLo5K7NQkL7allSD5dvgQ91kKUOx9X8JE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcIZYnUpJcnGDRBTRjnq2ftaGxnSSnnOSTRPz2xYl4nw&oe=6A64BC2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGdA9DPO2LkQ7kNvwEnbfU8&_nc_oc=AdpCqvPvA9PN942pdZCBJuTUstuS5KoKz9CNw0UxvYTHZwLTH5IwoD0W87hi1jEvCVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzTiWPjzFBbUbklkNddi1ZPYGSudkyEzQrlLd2-oSHTA&oe=6A64A577"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JKVdFysZosQ7kNvwFqyjYH&_nc_oc=AdpeIbl_Xato_xuiiPse-Clcu2J1JraTEd6Q5H1kt6nVZIzQucB_hjPdzFYs5dL6a0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHtx0BJ4A92MpxN6GLonLVO4LPdzHipZxOFzWYZvQ-Iw&oe=6A64C3FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxUpCweWMLsQ7kNvwGHbNQc&_nc_oc=Adrqz7Q8KQW3Djq36Xpnj5m33I0gmr0UBmqu18C4wIsI0KkLgWBIDN_HVrImLlRMsuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNxoKWO4sQEZ3sjLK2ziBu1FjNfitzt919cKtu6IO7qA&oe=6A64AF94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
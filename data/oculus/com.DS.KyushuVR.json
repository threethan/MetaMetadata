https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0t07gt4BacQ7kNvwHmVdUa&_nc_oc=Adp5QLnprctSSkF3-D2-NdQSn0TR1ASeNXJrPd4yNdVvQ_tXfYKSdJSazx0jSrNjobc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFshreWBIQvq0zUpYZyLrMHiMOem4kb94GQ55f1ce21JA&oe=6A898425"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNZ04weAuAwQ7kNvwG2U3AK&_nc_oc=AdripQ4EeJyznpVMKrP8SB8keSUCcAVq815LWkdCTOl6RMaXHApApL-H2ITI_hfadQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQowAB6GdMttwkEKDJtLeqh4mYKws4ZPY2u2oof-J0Zg&oe=6A896DED"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbMt5dz1sdsQ7kNvwGoVQ6U&_nc_oc=Adpt4NFZRPDMAHzP5rAlO-_1aXbKjNelYXMXnXL8kVZQzVnH7fAvH5JALiBfy11zWuU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAzOHQvQlcTSdcVvTFWa9SbjtasEaWll8NQRfxYp26Qw&oe=6A898F77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3AXoqYT-C8Q7kNvwHYacBo&_nc_oc=AdrfDGqRSNFmJO43Xu4lzvg3bPyX-D3eNRQoE43tiY6BMaYYXMKiKCyyB6AYlMV8xtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG80TukNXNAF27yoVcvn1euDw69Lg3GgzuveS0DnO0pwg&oe=6A8975BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVNvSfYz2nMQ7kNvwHSEirx&_nc_oc=AdqSvlJLIsbHx_L-FMNXy7l8kwrdMruVXZNNtPXXmrchP16bcl4TjNjFtil6MPlRezo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT1BN-cKsBFkJzsX1o6tsQZPGtM9e_KGrRMVimUvOVJQ&oe=6A899994"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
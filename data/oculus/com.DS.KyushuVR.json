https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqUskH_9zGUQ7kNvwFnB03S&_nc_oc=AdoT7358rPqGtYr4OgPKTE063ibWNe8yClw22aaSlmodaLV0WIk7DSFoxz7LwFZ0PKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lzTYGwdXmD5OBy_DA4WsklgFtzU9k5ge7kkJijODLpw&oe=6A282D65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YABNAy6zZwQ7kNvwHGVWYO&_nc_oc=AdrzD4RWoGxr49cVlZF8cmBzsPP_TeRgOQAlrndhGQb-Y9qUa22wCvxvYebPelQL7bY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EHV0QHQowW6JPmVT9arUW2N4xPjwyWUttMeGCyg-AXg&oe=6A28172D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2vR-YI1vMIQ7kNvwFPbVaY&_nc_oc=Adr4GLYgZk3vWu5zZI2VCQfdfvL8ia16ILqbnMHas7DsO7GtExNQ6klzeucKYRN0-Xg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vZoK9_g5ORpuXJ811mjddgk-40D7n4iiCiwIfVAUBZQ&oe=6A2838B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35zHiq189lIQ7kNvwFk73Je&_nc_oc=AdpP0WQEsLnWxTGcKW022nM8FtTx_5b9E3TmzO8gooMRjXXWb5JscxixDJhUBYKxSto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af936wj0o0h2Qwrp0inHLDgn8YbI7K26D6ecct75gMIcqg&oe=6A281EFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVNdvdJe95sQ7kNvwFvgBsh&_nc_oc=AdqZkj00emBFlVxgjehVp7135GXCPjb5QIq1A4rpbzaElqdiwH70ObwaXheJVP8JKq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PbF50zYDjGgGctt6SUm7QFaqLrB7jWSlpJp4UCvdFaA&oe=6A280A94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
8164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O54bTHSMxmgQ7kNvwEav1j4&_nc_oc=AdpkEG1MF8LOEf4DtJTVhq6VSGkEBcx06Z5rd88ElsSeHUAGnLqKuL6A2bgEEnd6Yhw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0xHyQkdFGF1YHdomKqreocfQ_LcMVyhrUWkLkcVYBCw&oe=6A8EEC2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM4q0ocR5KwQ7kNvwGu6JCL&_nc_oc=AdpxXTpBEUsOcf1SXquCnN8bg1Uf5TbCfx2sVYYuIf5cyBdVj7YmouBnNPYVLcgGKgE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp9W4z0nxK8puJ_ov-CYLc-cocfxyMk0oBcU1z-2wqOQ&oe=6A8ED577"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSt0oEQtMIQQ7kNvwEpzBnC&_nc_oc=AdobCFZ6YSVZr2A8VbaiIB0PV5827IKTCnDQOlF6ek8k-prSuylY2AItFwTvF4-lKb0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpcUB1CwEcSk-TP-td5N4TqXpdzaIcA_3M_hgARLUfkw&oe=6A8EF3FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqUWaCMXKY4Q7kNvwEvrO6m&_nc_oc=Adr_83SGLhWg0Fhg9vZ_mUAeD3Z2eSjRyBcLGqHzjsDoTLfJKoN5xZb3JNRRODmrIZs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOR1FAUtzwi0av01NbAcbyer0cJxsZlXv04u05nYPzgA&oe=6A8EDF94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"lates
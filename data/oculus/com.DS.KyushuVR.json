https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYQ_Kklf5RIQ7kNvwEoafnW&_nc_oc=AdoyI1hx5dqJ-WRpTG5i5W-e_Lrbt9Jot6NImZzdXt4tHUf_IkgRDxuL1J1kqG8bzYw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQmQ0M8AXK-gO-Ylv4H3kvp5yUUhrjSvT0nVdKBYFK9g&oe=6A6F5E65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rWT_k9IGTEQ7kNvwH9p-1U&_nc_oc=AdqaT0k40Ohidv4oec95pvfUeY0j6n78AHKfY5pEcx26UULwPBBbT584LuA5iyq6SQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPrcdfuEsAgR_rUNjgcFDSw_YWCrct9EB5x0YJMGTOUg&oe=6A6F482D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEJalhcWczoQ7kNvwFa_dSO&_nc_oc=Adqpdz5Almsn6UQHAqc2SXV3QokSFQvaQFdOeC-Lr0QC1PzCYe5Cz5folE09IMun3UU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPlHs050DSoAvA-8AraljLFuxU8CNm0_ayL3BWLj6qyQ&oe=6A6F3177"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYEcCP7hInoQ7kNvwENhdz2&_nc_oc=AdoNc6pHvBO611T9XWnKdWNCQeDuJKxaECTcB8xlos8wE2LrVacK05B25Ie_rkUtdjI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaoy_CfFUuP-ybfrY2K569uIUbNrfsr8UtH8Arq1rB1A&oe=6A6F4FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrvQ3kJfTwMQ7kNvwGpBH-E&_nc_oc=AdqoIEIaTU3FiomLKAwlHqqHDRNLhIWIEjSmLjcB7PK7a5H1z2pZnJV4ufyefz-J0Fc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC59n9RG8x1UhSDt2nU9JnL22aNewoZINRgtvw8IyAqWQ&oe=6A6F3B94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
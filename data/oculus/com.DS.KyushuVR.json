g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD0UHixsNUQQ7kNvwE5sj-Q&_nc_oc=AdqnKojjoe1bZvNtC3HOBBUyMnr7w4Y_aAoSGTYc8bSYGw5w3Mjef8uXPxkjy4BcNNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxsg6rCNaNB7CDrMSJUiGfGkrbbEX9u47lgxsnF99S9Qg&oe=69C6882D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHwj4vA6GwQ7kNvwE0gZgf&_nc_oc=AdoCL59E4ccfZfui8fmUcCqDQA3shVymBCj51-K3WNZzForwoCIS134LybIuvSMl4E4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK9DYNNTF3XdnvEDdEUBTXmlZhUSwXwMncB7W5fJ_0bA&oe=69C67177"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGILZTC37vQQ7kNvwEF45BQ&_nc_oc=AdrSttCljMs4RSHtG2K1ik_6RnDeaQQDGDDfNgAa6W3OImJwi5IxtZ53aj0PiCQyMpE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE_qc5Kkxpj6D3E9qWw8lR1h3s8JUfcjtRZFqsrtlhEg&oe=69C68FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke7Ps5oLxqgQ7kNvwFfyvQl&_nc_oc=AdpKklM2Ca38Fc-2x_yuDk36j0ZvN29_vdYs6xJTTlOsIqY7PGkARdaj2jn-ydMILCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhsomBFLR6sgncD6CaB_XiRZjkdBv2k0ImPVbvRJdoDw&oe=69C67B94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "453868397385944"}]}, "baseline_offer": {"id": "453868397385944"}, "is_approved": true, "firstOffer": {"nodes":
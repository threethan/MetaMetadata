https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l9mH2eCrgQQ7kNvwG3ebBQ&_nc_oc=AdpstYULcCG9fe0s_yeP-QLboJJxzs62-Fp9pSQ2Fh96twj6nWeiMgMmxNSHLkmq6Rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXBPIuUnmFq1PhacO1LC2TE7tzV1DdCj1fmVUFuvTKUA&oe=6A53AEE5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtrtoXe_6wEQ7kNvwGW5CwX&_nc_oc=Ado1haWRyRpav7lyliYeufKiF2zqwWankBMPXIycsqqrYRN-Z1r0gJJnVhwUGD6y7Z8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU4kQ3y1Gpq0Sb90p2ULWEKGbJl4wDs82tO2zYohIBHw&oe=6A5398AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJbjM-UxpYoQ7kNvwGpyHfV&_nc_oc=AdqLt24RNtcYpa_1hSBjtIh-RYcHlmupMMQnv924y0VUhNLTGAFhsiLby6jKcrhEjEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc8DTHf3db0QwqAXI95m1xIIRLbX9q-p5GzItu9xfcDw&oe=6A5381F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqHwQ7APsoAQ7kNvwGEPzL4&_nc_oc=AdpL2As3csYT6iA9UYhYXNlPCG6n1Mq336btOBHknz5F0y6vFnfEF5vmMX8_a0ss5_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClOHsF4JERGrcpxlt48gX9sBAHjXAwtX52OdNwOuhO0Q&oe=6A53A07C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJjJ2Mk9rQIQ7kNvwH2zqEi&_nc_oc=AdogdNDU-NPEYVnXI84-szC3xvxsBTcWWimIbqVQFCft6y1BX0vrfQwliunlDvYC06U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDry1FmuWrL6zffT85wjP-N6ZCRDiO_yC-i_9yls2mJcg&oe=6A538C14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86rgg5XpTVYQ7kNvwGEMyTL&_nc_oc=AdrsYURKY9BFSY3kK-PHv7Nx5eKBjhs9PuVAKG_X2bQ4ZVsU-puNpuQWLgiFe2aui3Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpuIJ_KHk_hFnrr9PuEXcnY0IrzVkwplit5mazwY7cbg&oe=6AA41A65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5d8JX6PwEEQ7kNvwF8KWvK&_nc_oc=Ado2z2LZwtoKDg0TCDCrADh-lH3pgJgXtYYETo1XeNe5hmK8TVk7rLJeuXLS4YOVCaU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFQ56t1WC7rqSVtcbG5mdAvdBFqHIEDqo03IcSt1ySHg&oe=6AA4042D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E958QQxk0lcQ7kNvwHi6CEW&_nc_oc=AdqbvryNqLMs4WA4IBaqdkYpS1D_bsG-h9BYLGN0iBtqVMqf7TnbloQEwnSRheWnpos&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQNJeHPiLyJDkZEEUVhzbNlggto-uuQDSQ1YG_Q6Tw-g&oe=6AA3ED77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6Lb3BZalTUQ7kNvwEJsxiF&_nc_oc=AdpLiIKWqFabi8T5xtqBgEidg6RXkz7gKa-6cqxx4n4Ky5Tta_g-qLvm8F-pr0kKsTw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCf0CfodiLIPXgTA045eGYB2YRoFNaln3natxBGdnKMg&oe=6AA40BFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJUf3SqgBZ0Q7kNvwEAguuF&_nc_oc=AdrPjhUq1Ud4YSvwnUOINXjNB7Q9QPXr4bC1Fzh_w0LM2hAML0GL2RUYlreWAqP2uls&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJubazJ7NSqnK5MIOEpNCIdRLLzdmW2kfn3SMOjKD-nxg&oe=6AA3F794"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
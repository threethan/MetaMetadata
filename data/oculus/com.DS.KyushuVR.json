n.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKx02UeDRxAQ7kNvwFTMl6k&_nc_oc=Admw1l62afxLPAu3ZB9xxPjf00yPCNvo9vwkBXqt_HWgIExGv0Ge-8bk9fVyXh3-ntQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0i1TaBW1qletyeg6XvwlgTtavwMh5tnsGNc_dinQJoQ&oe=69B3F125"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK7rSMFJixcQ7kNvwGD3QIJ&_nc_oc=AdlowU1TBOyE7GWl7OJfIRL_lMAnGNAkAbhWAUB7-1shV3H7T7D2xIC8mtAHVJazXHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPjW1qJkKallZi4NHBaRQOSUsNKsOcOFmoqAU-GLjwMg&oe=69B4132D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8BlrP7SzFYQ7kNvwECWLdt&_nc_oc=AdkYVy5lZtMcxXHAVVRcddICFAU7r8UXgihkxGF0jkK2ShmnqkoT1zU13TzvYDkLDGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwqf82dOC3caoIfaOzy38f0Ibb2ExgDeK7zfFI3zXxYvQ&oe=69B3FC77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCLiuMUFMRsQ7kNvwHzuZhO&_nc_oc=AdnX-9fzTld8YJLtS33a7A-4dF8t9QFLgdE65xKbCks3x9WMzs0NiS6mwYcPwZEr1lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfysEm28VAi2DaeYmBSN7Svrs5LvKiw39a6c-BnPTJ97qA&oe=69B41AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku3Cy9uOUtsQ7kNvwEnGijK&_nc_oc=AdlZYNDor4NYoEfpvqMKxAgU6002GICivrfTR9998spyIpzytnAJlEx9TBsNqfR7t_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztJA31Q7VA_U_bKHkfhQrKbP-wt87Jj_UeFsh8v_6IIA&oe=69B40694"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
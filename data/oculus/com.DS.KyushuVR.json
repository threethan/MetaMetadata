https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4TXpJS-dSQQ7kNvwEJtugN&_nc_oc=Adp053nS_P_lkr6ieidJvp3VyezSvcmSt6QWiyvIrzF6OIaYadnbDFxC7rBIl_SahsI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYA_P9hqv7Dhr2fUnTljoU4TNJnkbEWw6I2x5Mn1V85g&oe=6AC7B2E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUiqJhswTkEQ7kNvwE22M9v&_nc_oc=AdqZpFVbJb00058rGSsBP08cksC48T4i7avve3OfGwhpROMwRXfsPbmYPo-zw7wWKuQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmqU2vhbLzU2nHwAcPVbPGXKVOEK036lw3U0RzMwxN6g&oe=6AC79CAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_LwKVuw5x4Q7kNvwEWNyDO&_nc_oc=AdoCMuU_pSvlzA9Xw6ygcJFIXHl7vz1kBnfIEPAO83ieSIKUQZJ1OsPNMNyLe_NGyyg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIMjKbQcqhv09tM1QR8EHKKqGxF0pV6Q1xZY3_HaHtJg&oe=6AC7BE37"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiHUQXZ9ZEEQ7kNvwGtNvNL&_nc_oc=Adp8Go6KWqxY642D3lQoc6gp46xzgLSeLsh7lyeFEcmcfVfw3c0Kiy7fUK_ujTUMHLs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIhur5gapt4MFvcZjx4y7UOLKR_wAefGlwHYLt_jNVKQ&oe=6AC7A47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJjPZkvV2gAQ7kNvwE3B7Rd&_nc_oc=Adpw_fLAtULV2Rf42374PseTcIomutkvPfjd82-hu57zgPxY6VCy4f4BgTXlq6KGA98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEnDRuEz921RUFsMVP2wWB1fPbtiZafT89tP4WIf9uUQ&oe=6AC7C854"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
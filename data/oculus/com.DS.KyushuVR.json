n.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuEh-t7sI6wQ7kNvwGNAn6r&_nc_oc=AdlYLtmYJiyCVlwPgFesvT4cheHn_3iZvge9SO6NfwVJ8TTm1BovoHPXtmvm33dJd8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvyEZ5FYrEYX-560I7K9oYdp_bCdh1VHKFOVkbRmSoGlg&oe=69A96525"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IOCpDeb5M0Q7kNvwHtEAyR&_nc_oc=AdnBtqm26sm2NvWbj5iqcVLJgMeq-9Kh3rFmaM18b3pdjytrYXmUVzOMICFCocKzGxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsK4GrWVwdt5y7bPz7tOakE7-yNvVdtNwy__2M_LRoBQA&oe=69A9872D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_fWYqIABz0Q7kNvwFMC79H&_nc_oc=AdnUTqZgmyzzYzNzsCozbQmAVYksWm3ty6h7NcSII4sP2wQvw85dCsUiqNcLID-J2_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuNjey3jOKIXrkoxRXD0Pn9AutpdUVCp7eLqgCT6aXWuw&oe=69A97077"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwXVtKI_KdcQ7kNvwEVv_cl&_nc_oc=AdkItgKYU-vRFmzibvc95F7eIRMGs99B4JYq_rid7C1rNicrbWX6UFLZxfIOcxuAC20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftOKTzs_O2d26Ah9orRxEwHgSv4uja2yTPXEFjEmSf8oA&oe=69A98EFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6vJqBXNpcIQ7kNvwEQGVj3&_nc_oc=AdkjLbqQWkOCotvLPVr7cmpLmF2BozQC3RcXIFL4fayzn-ozRMnbZEtBcFssu3E2fQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsHl2AkYflXPuOcYhFDSOK6AlZgEMN9aBLl1NGJ7J-ukQ&oe=69A97A94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
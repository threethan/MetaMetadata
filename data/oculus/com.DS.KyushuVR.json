https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXQn_9sTU88Q7kNvwH9dJkR&_nc_oc=Ado4uScc52vXnqlKheoqvcctc3aNQlR4TvXWjVy9UFfKrrLSbzyZuQRncY7qATUtRJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJh0qAPhvFXD_CA9k54PMAI3vSmls3YSmt9Mb5cO_zGA&oe=6AC26CE5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gnn8TD6WP4Q7kNvwHJu2eB&_nc_oc=Adpx7FMADl-31nvzxVQexhOw4f1-G_sPu4Ad06IVTpGn47zXCizC42yPfqPIFNNBFbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuvfjFtM88VRNOLHrN97Rg5aOhXZ2b-dc7ASRze5kJMg&oe=6AC256AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Xl8p6jFtQQ7kNvwE2rce9&_nc_oc=AdrJstvLMg3Bl2XLCWjSyjSPC4XUi1cNy_fwsEtVKcmJMkhdhMspTcKNcFBwzSaoEzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbYQl4-dq1uGmlUQ213Q86MEcLx4DwxE0bVBCleTzaLA&oe=6AC27837"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSYGACZn8lgQ7kNvwEz45r9&_nc_oc=AdqwlZy-3yFyn6XFuOlJDfJavOrueCiDkm7bTWBp-zXhQ6jjPOjOzTVkiogKaSbdBEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0U-JZ851-d0xKYU2ldYCstnLNs8Y8MN2kwM2JXGuOkg&oe=6AC25E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5PvqPbsHqUQ7kNvwErrFwh&_nc_oc=AdqtCRtTi6zYRo8_0OxYlaauD4zh6C0qm8HsJVWpo1Il3F7xKabFp4Akl94MlFrA1UQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcky6__6qHqV6l1SR8ziZ01rVPsffmWFT6zwMrqFJ5BQ&oe=6AC28254"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
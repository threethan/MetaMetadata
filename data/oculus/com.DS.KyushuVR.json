g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEnkUk3KE0QQ7kNvwEQJXDJ&_nc_oc=AdoY5Z3cfAbDVHsmFjcI5nb0YLBsEfdYw7fpag0IcwG1qqAh1prTd0emIC8Qv5iungA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Cj4VIZEfpgajcVNkPfcmUPzAjnVb50LDGHzUE2a8Hzw&oe=69F4ACAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uH_yjkWYKMQ7kNvwH1ToGR&_nc_oc=Adp4SlBiJvAlJrEo7nA0P-dbaCHU4wdQCfk4TFa0wsFTYan1NKeisowcXbEi2rKqU-c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2utc6R5h0CdfAqOYCShNQ6iAy4MKv7-8V8WKpAVA1FhA&oe=69F495F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6br9uDXuiz8Q7kNvwGwkWRx&_nc_oc=Ado65u1E6SZZq83cBfDruxDLpJt-RHQDY1z56d81Z0vRVayF-zcNcVtAW1iWSLP8Wwg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MvwLfk6PWkthImRmhNjGLGJBmehGNk07Hmcylr49bag&oe=69F4B47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EKvFEBoP-kQ7kNvwG6Bc2j&_nc_oc=AdpAgNr-G3kdOAVsTQseN2qRgd4afhUrVZbc5kPJWi_8ZSQMk8i-E3mzlv5Ndum4TgA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mM5hvnHaJpBgFufJXEJ1OGNHPDb0Swyx-uVm5Cdascw&oe=69F4A014"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
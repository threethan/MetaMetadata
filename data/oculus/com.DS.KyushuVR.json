g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScGZbSkZCi4Q7kNvwHwYDCA&_nc_oc=Adp8cs2aGC0su8hQR5Q4vFnIhVemnG9EELyxjmQsbd2bi2WkQqSRwtc5zjCyMFxQYFw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nIurjcR-grpC0IQ-p4FjO5GjdvqR56_sXsNAkO_Taxg&oe=6A32A32D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQIVYTT0P8gQ7kNvwEL5rDY&_nc_oc=AdrBECM_o-vK1jWS8dVFjNJRBCiePektQIGBprmdCIOMrrvRIeqPS6aSADmyiFljXW4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mhGfGwrBCz48c_SkzidXy5b9oaPiS78y07gOnaWXlvg&oe=6A32C4B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsb0SaYBnQUQ7kNvwHDmyb3&_nc_oc=AdoJon6TdO_lVYCjgYRqXZZ4p4VkM3Hs9ZVhzyvAg62cix136EoWk_ZBw7T_Gihk4Bg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wuH8SOE1evkDQ2rZMpjQPYbjUdbYd2dG0UyAnoD5yWw&oe=6A32AAFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfcRtHmvn3QQ7kNvwEEr-2n&_nc_oc=AdoMax4cLM4at6IvnAa2lyTkLP5CP9et1zVOGw90MpNbMdDND6Ed8iNmaLi_zQqpIMQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hSYQJ8iDNM-AS3MYYI_CcSAC5kcDCFymFtcBCu2rOcw&oe=6A329694"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj6UePp_MVIQ7kNvwFNm6Wv&_nc_oc=AdrWi9OgSvmqSNDHTDUq1F1m0wWzjcfv7OY_rrj2-nLDF-AQsuIaO2sGWu9OZwSz0Ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIVsS2IcgOhLxFXwbiz4aMwCEwG2RNRGvqhjRkRdAuFQ&oe=6A677565"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B605TJ_zv0oQ7kNvwGWdzZ1&_nc_oc=Adozcomb7ytkya0ukA77ipEMS_7I3eME5ed2TQIbtQfr_5AlUUT6Y0YQISuowhysLe0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMFCBhoTrpqCurl2EUlJFMZr3445ghqw0soMlmHAW2RA&oe=6A675F2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6zZ5iUHbv0Q7kNvwEKzJTx&_nc_oc=AdoN7Jha8agvY5ICbkDwFvrBaiw5igcn9K7coMOzpiP78RCQHp5bXXA8UsomiV-FNGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkBYGZH6r2noEhg3uxIu2gLNsgkLrtkHuwuDyPJvT1Wg&oe=6A674877"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pa_4B7_PzoQ7kNvwEPRSUf&_nc_oc=Adr3BSDVZ1sxpplFuEUIi8qx_ZBmm9mxPa5KuXEadE2w02_ETdajm9-cvyZOWBH4ZQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo3UVCblzuRabNNRUJkwtQ-hJp673Nl5OCcY23qliSbw&oe=6A6766FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfvytLvU4wQ7kNvwH1i1A-&_nc_oc=Adr-PUAyAMluMasnV9myKxVoK9q69mMB7KzvHGeu6Xnlkqa2v3dSvkdW9Ic2cV1WdFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKfm6XlwfjUhVtH8VFkIvWgDWMe2Pm7GHts71yFfus7A&oe=6A675294"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
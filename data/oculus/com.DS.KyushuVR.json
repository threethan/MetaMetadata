g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaXcGQ2Z900Q7kNvwFAUTcm&_nc_oc=Adp6WVcD-jg0BG0ejhcz6d5TL8MxdMjSypdD-a2JQ5XsRG7dsepKmg_GSI0JXznDylk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rfy4rrbdPT8rLmkFmtRcMo_CXhGUlB8-eGENTfgEwbA&oe=69DE432D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf8dzqD7Xb4Q7kNvwHQiYrj&_nc_oc=AdrsxvvADfK4yNA7gkOkWyoFhhdUdnmOCRKUEWSjraJnqaiQ5X3HRdMdLk9VvTZ0Sbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uCqYhFdlcngxiul-E32du20uCnsHhs4kIfNc9Uwg_sA&oe=69DE2C77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oR1CubBlGdsQ7kNvwGOXb9u&_nc_oc=Adpfc5nyuON78FEGsBFH0rRKpeear5xEPhUAbDJe5301xCElwiCdJW_cK3ysO4FZFd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0izd4KEMXanz0s5iGReL_ITadCfzfKkzaqjVur_Bp_Iw&oe=69DE4AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pi_m6aLjdLAQ7kNvwGZz4Ib&_nc_oc=Adp4g6ky4grm_-wpOzMG6GsDIIgLP8_XoUDtRB4nwHn3A9Btbl-i8aW6wXVGzgYCeDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hU5vEtH2B_pyIgkC5zgoK4cLKkrUAGJpEo-8Xq2IzQg&oe=69DE3694"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
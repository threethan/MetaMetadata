https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8iTkukduEEQ7kNvwFBrvki&_nc_oc=AdpyMmyyIeFzw59tyyXFXfzTp-cZ5U_nCFjgsNdPZcNE-AJLOsZwKkMjjW_WT9mbM38&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mwoV9GjEG1bVDc_YgGifXxakJifOPiONpACVHtqBKqg&oe=69E64265"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hFco-jvWK0Q7kNvwFU5QIA&_nc_oc=AdpcMQIBMrNXQqZFTQdr2eyTn2YAsaYUcIxMCv9yw6TAWT9Y4Aufv532_6ebyQeTngI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TpLJTkweQfbt2Fyr37W25WJDnFyJK5uiapFejwp3hrQ&oe=69E62C2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-skBzc2zTM4Q7kNvwGPJVbA&_nc_oc=AdpjwYVXTkdAo1_eYu4SDmgEbj-0vlyCMz7WHmt3MeFdl_kuoxAXSEZwtI8SCpC17Hc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O15Kxc5JoyHfC7qhcfJY4mG9NIeAhgxJ9Cla3NgelAw&oe=69E61577"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBVOqBwOduYQ7kNvwGcNhit&_nc_oc=AdpZdom4v_mhLuNDzpKygFZRf-2V2R2jerRxisChYZZFMc75-fbhGO9tpHlf6aWlfao&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VKIAJJgyUGCaDTGRlloDozAgWPWfHsi00lEdjs2DTCg&oe=69E633FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw9GSV6pm30Q7kNvwH7pxwB&_nc_oc=Adqoh4dQNzot_Hpy2v-gwDuJsA7wk6cTE_hKUjY8KIGlhl39rdJRCzf4NwyCtHHF-S0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YqcgFdPyWSOSMMKTohth907LaDUcLsuxrIMoY-_JpVw&oe=69E61F94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2-E3lFza7sQ7kNvwGTwXaZ&_nc_oc=AdqRrsdyD6IaDVF-Vr3ynGi5Nd_FX3yfBf4FtI4YSyJtkkwG8AB8TqyY9rOubzesJi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfSs9YgOHsNeouXB0NIR9n1QGyH5F2h9ez3MKSrzLPlA&oe=69C90925"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arqxNFuewwwQ7kNvwFS2Gja&_nc_oc=Adqh_WUgg797r9o7RL8tl-GxW4_HpuBfDlp7NMaYhENHhsvJlVJ6Kydwkht4qHFkAjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwapkOZaf37hCj1mvVEZVA1UQKvrsD5RP2jtQIrdLRjGA&oe=69C92B2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ9eYCRxMBMQ7kNvwEvT4Rb&_nc_oc=AdqYSfyzdlhfBmOzU6uEXi_sbgWlFG09MVUiWuhiEkVM_9EtW363ObSxPAAYOdZMPLI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwuldx8_ZE6_F0LUHEXbnmotDMHcrXgRzu37n1sYX2igw&oe=69C91477"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa3ABecSq-YQ7kNvwHKGb8B&_nc_oc=AdoS_ppFjE3iKxNl5ZYIDXT4GLJCENECwqPjpoVygAB4E9NjTXKlHvjubT7jnq-kqDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzczfqImUDWrhUAfHHjpoxfmaZyxgClC0QcYI0hYp_BKw&oe=69C932FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdNgtWGHf9sQ7kNvwHd1iC3&_nc_oc=AdrB88d9cIelsGCXtu0ZSDz0Awudzkxc9tOuM2Wusteq6vY46E9Rd0yL3jZ7YhETKlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywxQW3Fxf1Ka17GzA7jdiGTVnZyIQAba6FUm00lw2ZFQ&oe=69C91E94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
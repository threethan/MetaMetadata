fL4suSP6suvl-ovPFgjeWmrJBnhTfR3gvY4B4dwN6mWbjCGa_Ts&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLwHXXQOaFnxCLlOphv0kpEmLcCSj4AzISN9oTyYru9Q&oe=69BD4DAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEspRSgGhaAQ7kNvwG73yde&_nc_oc=AdlQZ4P08NU7RAGkcxTl_8jdCRfcK4LxmjNjlPWA6O-Le2ivUFY-kMHzdfN5E3LvFWk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoLEHNlxSd1F-wwRqRGbV5HYchNAYllnhB1JvWCWOCSQ&oe=69BD36F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzWxMDwBlUoQ7kNvwEJsUBl&_nc_oc=AdmMYnsXNpHMnSk9yBmb5iRPG4Jvq9LUPznjlo-HDNAHxBGF37IDSwiXSoOBRNFoEUU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyo8xRZM1rh8z16-EEEIA-FyPdwmFJILVqswvc8GW7fhg&oe=69BD557C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wTKgqIt4jcQ7kNvwEyWOVL&_nc_oc=AdkjE8PjcGg0lEmrBPEe7sleEP3UGvdrhG6GzgDEDx0rDN_S0aDRX_PMetQjZilV9y0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxThQ9eLnxV5_g1EifGW9ZIGx8j9DM5JwYhrsA-mNW_OQ&oe=69BD4114"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "453868397385944"}]}, "baseline_offer": {"id": "453868397385944"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728304560, "status": "PUBLISHED", "id": "453868397385944"}]}, "liveChannel": {"nodes": [{"
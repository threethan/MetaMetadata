555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHqva78wtssQ7kNvwFRyZgR&_nc_oc=Adkn2eRS_98YPu49QdyhP9WJT9YLKaNqFRhlCt3eZo7Yl_thYGllvnusimslN3BRLlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft0dls21N0ZvEx9LCzBK7uQFpfz60Q26I4rSdbK34t_2w&oe=69999E77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3iH-8059n8Q7kNvwE3hAOc&_nc_oc=AdnQJ_MMnPSK1BV4581XkaqQndkUooeSM3Fa47qcvFjcifcfa3Pe4emSbf5l3e3LOik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs08Ai03myCOHE_xQ0lFwHJqyqBOntjiLX68lBwyLmNiA&oe=6999BCFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w4od-4IEUUQ7kNvwEaEp7r&_nc_oc=AdlEasmGQ68J-bsHzJKkQKvYOKE9N98hsja5kWCkHuzlSh0fVwmhfC6JgF1ryAia0IA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMHWSHpltb32IsydGas6bhT9Li35sWlP0iPJJ5YVmnYA&oe=6999A894"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "453868397385944"}]}, "baseline_offer": {"id": "453868397385944"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728304560, "status": "PUBLISHED", "id": "453868397385944"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7935993406529859", "version": "1.0.0"}, "id": "2551913838314352", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bina
g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiP6P3KmgWsQ7kNvwENMV4Z&_nc_oc=AdqRbcbAb2IUKZO5DQXEhou3T6p7FxRPhQKUqnBa4XGyGxWTL6k9khQThRWHPxro-F0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1qY37bZJy1Jvoj28mcHXqCZ9UZyrNAMg_CUUQVKOG9Q&oe=6AB284AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OIPZCpZw7sQ7kNvwFX8ySX&_nc_oc=Ado3BxzcEsnv7IuEFnIRYItU5--RwQtv3lCaPg2jRMJfg201aOwj2UzKgxSoAFOMn8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9DZSCmGzY371g7ysrrH2WmKUYUQGQBz5fKlmlQC6XQw&oe=6AB2A637"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qctGiaodUUQ7kNvwFTXrl_&_nc_oc=AdrKi8ZfzF8Xxt1HjTcLA_ZZo1QSjIh_BHhpezw74uABT67gJ3qymBK5LNw7nPg9s4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5asn08sOaCxFV-e7NiaGX8izzoVOq_HZ6CH3hjFRtoA&oe=6AB28C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTkTG9JzqksQ7kNvwFF_HJj&_nc_oc=Adov1OzSphoG-4R1nWN0c_b5epKrxye8rADciYmSLo3HoJ6Eedtz4Ppc48GWSMdb22g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmN4AGfyevvkUMeYTus09JczTArLNSn4jluseuQHSAkg&oe=6AB27814"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
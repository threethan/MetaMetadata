ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYKI5u93YlwQ7kNvwElQnZY&_nc_oc=Adpj87Tnrllkr_75bXmtsW_eSVdMM-4CJQEdvViONpHzrH3gLS0t45pJP2_zGSHHDeI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D1h6EhW1fH7fL8OY1xHf5ZC1jtnmOdTsd0aNv4C9Zzg&oe=6A22E765"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-9o2Uk_YrEQ7kNvwGz4fI0&_nc_oc=Adq5vUvGbEq8-DUbk76PUki-2s5vD5FuNL-y2e_kNYWnQFMMZlA6tPqTVsaYIRpr7YQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JXk0RCSYwcJ5rUFL8mJchddTlK61g8LzEgC88U77AnA&oe=6A22D12D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlppCvUPz8EQ7kNvwF0nPhR&_nc_oc=AdoZDu7aN5TbR6043grUw_p7cb2wo2_vtUUwIU092i4KiDijhcJpF4KqkNPV32WMOn4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tzQNNK6fcYE9KlBfD9UkGQdepHk_-0EzW58Q5kuDuig&oe=6A22F2B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS_sFueii6gQ7kNvwEOtzub&_nc_oc=AdrZZIHsMaK6MZwM6eEhpBBYsZIsUgk4oWkrlwNi6jpsHVxBxGpMIr4xeDOC_ukGids&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dlVv6r285WGugod1L1BsfQDUzkLRLN9B0dRKn-Ir2dg&oe=6A22D8FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikWty5rScXkQ7kNvwEQHzBY&_nc_oc=AdoOD6_X80XZSqTLtjqSRuhAxU113kCmDCmENpLJb7PQwABbjCRWTqH7pB7950-qcns&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AOEkKpkUzhkV_bczGYLsjbLKfSNQU2vvKD1aZWvSkig&oe=6A22FCD4"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
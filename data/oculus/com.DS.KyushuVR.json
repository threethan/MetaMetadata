g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIxxtDDxW-EQ7kNvwF-eJoF&_nc_oc=Adpmyv-MmfJafMzv7JANvhX0DzLyD4LVJRa3RJLa2icG-d35R5HBhIJhNZXlOHLy2tg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVWcE0gKQQ7HcHdRc1PhvrMKSTY4yO5TQduLCcusEPqw&oe=6A985EED"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_1MLeNWWO4Q7kNvwGX7bp5&_nc_oc=AdqO8t2EUl1-YuMwGzekwbDem3V69foOcR6qIi9oZ3Y8VCyNHkcx1kjcKoBQqpbinnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIJRsq1x6O1PQos5NbhYmHBDqHedvCa-3bVs10QHAJMA&oe=6A984837"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb86JdftLVQQ7kNvwGLTRBX&_nc_oc=Adr0lY5yDlzkdU9RljHew-Wl8qLDxFWQYl7HxuoCwquqJHRrQSFRslZ5862SuM4Q_ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJFSApS7Jaq0bPJoOT9O-abMfB2W5g54Qz85gSvkaU_Q&oe=6A9866BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qetiHnkTswQ7kNvwH_oAce&_nc_oc=AdrLO2tUDy_j97cWsqy3uMtDog7eMtfpNvqSXM9jDYnOKTAcjja9DpvktoXCxP3AV_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJweJU7mffhRd9ye_b7Bjm7lnxBIQOfyZHs_7g_PWSp1w&oe=6A985254"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
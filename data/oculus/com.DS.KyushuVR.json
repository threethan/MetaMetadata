https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6-4DA9ExS8Q7kNvwFy8G-N&_nc_oc=Adohhr8esl2oKThrOjIPgrHJZiRTYOekpntqpaWsE3Ja8eJiVdXX0pJb1K5AhpPLZ0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JrMkY91MDvP94k4VEyX2p7FovYPARZid495dMIPGBeQ&oe=6A01F1E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a7WwhfM88wQ7kNvwHAwncn&_nc_oc=Adpn0wgrFgcVc2SxV3gG0OusMP_sMe8sW6tNlxzKla73ydsc7hARpQSZImUwN_2W6Xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aYP9jGVGNi6_oc8Svy_Too-8-GeWRLUBIuLCP_kb_ng&oe=6A01DBAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AWvfOuus0wQ7kNvwEQbKbK&_nc_oc=Adqp0JiuRLNfa-vibPclPkAocuXAZfNTWzoUU3ild0juqHAzlYBshC0sFIu-hBtXK6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E6q4w9gio3bFdmgWYtEnDberHsdqdDSpeGvnAInaNRQ&oe=6A01C4F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzUDJ06LnDkQ7kNvwHOn0BO&_nc_oc=AdqJJori5WPDmqueJBJx606FQJ_h-2vMkjiJkq7bWRAd-8O0grkt64MCrvVXhmnWPkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wKeLchVtRpPlzHE9vF8NjBKwOBHXvRpICmCO0qnnXmw&oe=6A01E37C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbfwSpVxHc8Q7kNvwFuBYVV&_nc_oc=AdoPK2CrdXPfvu6fKMByasJPQSiwCPv_Ok443rn2_1dFh2mT1MpFwk7KkvnQTt_T2QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HmvJzgHXbGI-Ei8y-wlGiU1jJSeYnNDYZMZUPUmhLQg&oe=6A01CF14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
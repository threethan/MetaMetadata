n.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKx02UeDRxAQ7kNvwHUSgOr&_nc_oc=Adl7aLj0e4ahK-GezH0BEXcocFhzxt9W9gWj1dq0ix8DvuSxzbiQfo99bDGwliddiik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoKkrWGlvFgoJ8pI8gbZTOwiISE4QAKy_ES6PBGB18_g&oe=69B542A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK7rSMFJixcQ7kNvwFpAkFU&_nc_oc=Admi8AybGOBTuh2Tv1byhAJMBTNENJHsAvzMEkSYU-ZMGy7NV5vXcIUgr0wfzMH5ldU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdpilRKSwRrR4acgPPy4IpY4JXXlw2ojrRxoplhLL2dA&oe=69B564AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo59I8KHN-IQ7kNvwEWjyBB&_nc_oc=AdmG9F1y24t6nJkWdOTNcgqSBdXIEARVB2Gp9Mv7UfGbASRKT6xYBKt9TXc7Q1x4SL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyRsW1rjHAtb7YZfk879_YuIYMrXxDGZHRZF-dnGD5H5A&oe=69B54DF7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC2wu_4a9gEQ7kNvwHcYV19&_nc_oc=AdkVBkbzR-uypm2PVRpIpQueXaWCzCX5Y9Fh_hO-Y3JDidDp6vwBKxryaQ1iNP6e0eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp3xGM9CBzLbugiFmCmlu1FtkGNiCUJwe4Ubey_hJ33A&oe=69B56C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJsKtwQb-v4Q7kNvwGzwLKL&_nc_oc=Adlz4yl_ZIefALQnsBc7Ca3NOOOGbZhyNhsqopOszwElsH8MOYptlH5miLT_4k-TG_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7yBzq9Z0VFrTBRbp0TQF8PfxCiHlho-xmeWF1T8gspQ&oe=69B55814"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
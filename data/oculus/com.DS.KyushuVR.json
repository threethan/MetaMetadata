ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gx-LMhiqaxQQ7kNvwGKjs2G&_nc_oc=AdoYHiylHw6mCLbQx_DQSvYC47I8YQR37Qjkmg__aFVbYVbz2LOF68Fy4pbwz2E6VlE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ryGrSaWasNbzoweabx9WoKxIFiosKNJmj3iV-klan7w&oe=6A11C3E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuaPEu-_KoMQ7kNvwEptK3P&_nc_oc=AdrbdvugThnKUfiDk2ftVbBbIpe3zIyF__4-g8Lx1-23IrPsbirBH5o8kcMKqrht50E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cL-SCTEqFzSq7n9ybtCra5Ly9YHfq4GzGYlqDO0obgg&oe=6A11ADAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwjkOwFAEKYQ7kNvwElI-8u&_nc_oc=AdrECG9rn-BdE2yXkTTLMyB9Ch7cFlrGX38DJMpDUXfyZc5hVbiyYGaxtRusZTOQO2A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rVQfTCkCVZxFnrJKRWiMeCdzKqF2SPobhGXJMnFstdw&oe=6A11CF37"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGiSf-ruPEUQ7kNvwGiNjRl&_nc_oc=AdrJwfEc-YwDLurQPv8WLLHafCEqe6eS8qiwwdodEljUi9h2ZhZbnig-dPPnsXtDZGk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yf6xG5iPNCr2l1Gg_x1WFkItH_frOzj-7NulgBBYZ1w&oe=6A11B57C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJTh2VGffFcQ7kNvwEbQMcB&_nc_oc=Adrw8fy2P4sovscAotJoHMtAjHJOB1eokgUcESZlP3-msVjDGyAV1Dm7WeLAsZUnGtM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63IyM8LbKPusPTDNL26S1-KqF1dR9BxsZQsstOvD4dVQ&oe=6A11A114"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Dl68iqVN1sQ7kNvwFQNj4G&_nc_oc=AdrwhFZ-r8MLAqb6oQTHaQduZQVB9V0lK_oz3Sb-rj4E_AYunqIER2OCe4UVbhEa1vw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KWFoC_L78-0_yspiGnp1ilM8hnXiUmpSflMFaf-CZPw&oe=6A185B65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYM30lKNEOwQ7kNvwFozo-H&_nc_oc=AdpTaPpz0FFY_e8KUxD1hM4TPAaP78TA0E1Oyj2DcmU8EYbjX9yRAXswpoIIYjBjpOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WQaBJDwYHYe6OXb3DdAidnl_yBpJFVe3GqEmTzkJ4yA&oe=6A18452D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbM28CRtBSMQ7kNvwHOVw62&_nc_oc=Adr9RGS2dZpBfFy8BwpipqxZNFoNj00WQj4G370TXn6PjObxGOYO2FNAJBkkSQRl2Go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e8_0IpinHj7Y7SaER8F_VyW3aLPvppqz0ULLoAiSaaw&oe=6A1866B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHaX0e1FSWkQ7kNvwHo7bqg&_nc_oc=Adqn5r2pshSmiDdzawd17b8aLcZENrrznq6tLNR9TdoiTX9hcYGyNTNSxeESNTM6ifg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af448-1LqRWXWMPgDeyD6_BAikd3hl6qT00mgs6yYwoGlQ&oe=6A184CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onXbL7LhKVsQ7kNvwHWpGJu&_nc_oc=AdqudkdHYbU1DjuUTyiUciISWW93pIampGn7y702eyy1JBqA-VHkGuj4tFRtttKbSlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rukfxXu3o5dE9p3kVwkppaxTqCbIpQDPG5w8PaMEuFw&oe=6A183894"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPtRafV_3ZEQ7kNvwHv4Kag&_nc_oc=AdqS37pGxDHY5B0Z24V7hfjsZcWR_w7pIr_ikKNQ7QDmf8MQGCoSf9rUpmeq5P3t6nQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeDFLXw2G3VA4BFm6rU91HFV0fC9kgGbKZz5M4Q418MQ&oe=6A5651E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MwZij0j-SYQ7kNvwGuCsBY&_nc_oc=AdqrR0aeJtqtleHdMwrwbu8Oh9uzlDVVuqMSNBqtTxJCWjjFsu-BlrPvhDAL-y75NDk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhXu8MIYZfXq9Sm7U22BfO7_RNOX9vgMNRKbwRQEnkFg&oe=6A563BAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJbjM-UxpYoQ7kNvwF9iGLb&_nc_oc=AdpNPvkgiH-Mh5zIpL_2M5SlwQwAw_0tC6GhhpHYaeZMUGPRImxvYR1JwUHyDygVfic&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgLH9oMVFsDPNG38ZjnpIlNbO65lLUwUJPIADCGCTSlw&oe=6A5624F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqHwQ7APsoAQ7kNvwHXFCe0&_nc_oc=AdoQDXDHWQlR0uLkomFuAC1C1Hxg2ekn06cuF7cOw0-fFBQ89hq5W3VqLGyfJVtQoKM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf--FPh5N5CpRv-VqvcfDQpA9Jai8bBQbf0qJUlfeXEg&oe=6A56437C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJjJ2Mk9rQIQ7kNvwGuJnNA&_nc_oc=Adoy4cRLL1rP4avoOpyQBoGTowRzyIrmTRu2I3Cn72DHDTSoqxn9f6gNEpEGRf7I9ag&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUT3IdcHOrpRNWQzpxggrSWlz-wH_X0AvFeGMDJx6gxg&oe=6A562F14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0t07gt4BacQ7kNvwFztP_6&_nc_oc=Adp13WP0Wds4vUBBDyFpWJQQwxhpP02z8JkBfI3xf8XE9fy9CqVBHU0EJxUXdQGCRLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUeNLsn8eiAkh1iKXKfe4EvQBa1ARJ9iNTqQ7cbIXwMg&oe=6A8C2725"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNZ04weAuAwQ7kNvwGDN6e4&_nc_oc=AdrAMzWZnDHH_jaWXVyWlYIq0kPA2dqAwKKKxuGra-62OQAmMdkpxYPRxKaMnMo8MWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQZBqZfO_pNiDtOm7ANaZnJfbN8nLAwrgeB7esMzTxKg&oe=6A8C10ED"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10k6Xi6xh-0Q7kNvwGxsUk3&_nc_oc=Adq83zUYWLdL6JNma2sUaupUpC8z89ujwccjrkeJd45qWUrHiUBdI-f1NLxwjr2zAs0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_dZNxaY2rPKYY2BZ4Gu65g8y5jD-nKr79GJiX72g_fg&oe=6A8C3277"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W37_1HS3Kl8Q7kNvwEyQX8V&_nc_oc=AdppjM-lmR3XCPYsy15rGG7RHFNY4M5EFJMyNoG4ehtjM6ZOvI8JjZ7Kd-x_ySjm2lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8473ANZgtDggdFT_n64vKU5oq81Zpfvz-XSbDKdBgmg&oe=6A8C18BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29LZ7-6P9tkQ7kNvwHELAcY&_nc_oc=AdqQuuXHqGjjdMzkHwOBGhNmYwCTANxee8sj2HkwFXt0MaytZcMWQyEnmBlAlcTk3zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUXazCUHGFjS2nalMa3pRUp8ILm4NezCIayFqZG6snWA&oe=6A8C3C94"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
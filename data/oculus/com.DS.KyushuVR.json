https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iZuprwTkUIQ7kNvwGck9Fx&_nc_oc=Adoq8xn4C0dSbUrNE0B995__MTEYZM5H1jF9xsCYPlLzKRGYVWZxNVh1STp9GFarSA8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMacZYIFvq1nUtxO_E4OjCtISCxeJqfYlDXZpnhmpkDg&oe=69C514A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD0UHixsNUQQ7kNvwER0eet&_nc_oc=AdqGWKpfCT3BA-X66Zwr_RBgDNca8ktuqVvAVYw-1K3h6PW5ieuoNhsL4CbbUtF5mGg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdBoK6WL5O4ekmEzz1n33wRvL0-OiF89uuJuYkFN5j0g&oe=69C536AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHwj4vA6GwQ7kNvwFJ8Mjm&_nc_oc=AdqVzx_16hpql3K6gu7YT5t8RFBzpX10H2zQqTCJXQxyTvA26c0uWL4Jthc4ECbz4G4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfGMpBPfYBMXLjtmSEivQuRYGDjDwFCc3a97hKlcanrg&oe=69C51FF7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGILZTC37vQQ7kNvwEQx_JF&_nc_oc=Adp1rnNHHkQshVZD4f62fCsOFJd75Oq8UzZrJpYbCdXFsa5bR9us-scOEEPrCEgLN5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWaFbPMkXX_YZ8ao3Izf8Uq5QhKM45OC-86gDN5xlKbQ&oe=69C53E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke7Ps5oLxqgQ7kNvwETfCN-&_nc_oc=AdrmbG473n40EW0Fy3uaFDLQj4XQs4FIwsm_KPiZeVuLTxNlRxSQ2zrrNfoYYUXQMUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFuvhCWp1Y8N3GHFFOaXXdL-Tzx6NsU5AlYWmOD66qOg&oe=69C52A14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzO1ggtRcEYQ7kNvwGZAlHL&_nc_oc=AdpxXydTSMW_zuuvCayFcAvLdF1mFJegNQ9Tt4Ajeisc2RCE61jpqL-yPFFQBgu7hxc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfTXp3OYHe-ia9HUh4PO32Im9TRxE2lDDRS7cBgV0Dxg&oe=6A81BD2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XisEjcAdMH8Q7kNvwGJJ_9J&_nc_oc=AdpgV19mnVCP6F7GDKn5SUv5R57OtOxquvO-4WNNIYClSqRFXGP_z_4kZ6zgV7w2KaA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBwDV2YNBLteHQXLNherYxmljsD7L0rYrTGiIOTyeqYA&oe=6A81A677"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q47asudKTSYQ7kNvwEXrXqP&_nc_oc=Adp2YwZFadzLsaA3vAwKU3Qc2gQkCeNrnDsQbiQqo-8wK2GJ7WMDkdar4pHSefHk4tQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-ydC-4lNj-whqma6Cs-5ODIaa-w3cbEoNzz0aZGElwA&oe=6A81C4FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7ibICb_gCMQ7kNvwH67DzL&_nc_oc=AdoWzSfLmqZznCSYyyBvL1m1Lb_h-HhaUCOFSYwW6Ma3m8PA1A5pDBj5uiUZ4yzc_Z8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbV4Lug6O2ShpcsU4tLRiJknF7NXL4kSreRSjkkJpO8w&oe=6A81B094"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
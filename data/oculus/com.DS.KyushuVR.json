g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edobedtyEAUQ7kNvwG300bx&_nc_oc=AdoU4Fc7pLEE8K2KaOEQ2hmIFoubnBKzz7N2u0wWB3ehOpurqxfVsAhR01otDQEkD88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af644tLOrqMNol7b0vQKJCdGsYN1aKALLSwOxt6YKUZ8Lg&oe=6A032D2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AWvfOuus0wQ7kNvwHJlRSN&_nc_oc=AdpFcal2xiEo9uMTFFsL10Tl5GZ-GW3nHcR5URFgVROgPkMdrnZbUIcfkWFW1YjFRAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af698gZADjZ9QfbvT-II59O1bXQ5kwCKrAc1wnWunu3wwQ&oe=6A034EB7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzUDJ06LnDkQ7kNvwE3Vu6A&_nc_oc=AdoMSjpz2L4cYYA1EQiPBH9dzaiBDihyluEiyWgKZBjibOm6OK_0yn_FNtkYf-_7Jok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_IviGLaaGqrAtqrWXgVWxs_GiznnkeqtYAKX7tVxpQQ&oe=6A0334FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbfwSpVxHc8Q7kNvwE1ANBb&_nc_oc=Ado6JNg8NMTrpkvAVp2hPoq7PZUwGYIXld6hPw8uRkImT0xCJ3as9q9qrsZyEP_hzLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gk1nM48oHYeRaDCkiVd5tIaHvhbLXtLBe8aPmDE-8pQ&oe=6A032094"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
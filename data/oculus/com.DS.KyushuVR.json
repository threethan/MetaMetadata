n.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b55M-c72zu4Q7kNvwHNpg_6&_nc_oc=Adlo6ntk7S3k14BfSkqkUMxjNXtEmLgguQKpRv0fepxopPqZLfi11XttutaLVS6jKA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4RRmvYQgl5A9DsfpTAq55FXlnHLfifZpoQVdDNjFDmA&oe=69BA88A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6pyb9T9wUAQ7kNvwEhknWt&_nc_oc=AdlMylLWtiwIyQXHW2c-4MwxZ5AfWyYM56xw4-9stODCHsvDdoJKfouVZ9aSI79lka0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLghgitc8uLUDsgtKUuaRblizuGpCdwkKiXjch1_0R6A&oe=69BAAAAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ienemJ6V6rkQ7kNvwHPfSWk&_nc_oc=Adk5Vi65A9cNyRZcCA27nQ-O32o3LZgN0b5QS_tttfDOiZXUmHEQZEzdbMFw_AbTYzQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTkLnYpckTSmuQYEWdTnnvP-_gfafH8Mnhvx7cikJt-g&oe=69BA93F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jusxsf4qmggQ7kNvwFLOhTa&_nc_oc=AdkvZnxUx5RJlcWiyv2rdMjabZLD4XCUWsGExenMilooIAJa3solIo3wJ7xsah7u5E4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzhgj2UYy4di40XCwoXKCliPsta_dIz52PUR2pg9rIxjQ&oe=69BAB27C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHKvnCkApZgQ7kNvwEKfCDY&_nc_oc=AdkvAo8PmwwjLc2_JnEP-ULCHtSL9-sJGAoJCzn2NYEmsvw95piPmWxPbmarWv5wGnE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxbAFq0BGYtknauyuFS3aa_s2uf0iDOGMuSgF0rubrnmw&oe=69BA9E14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmieau1s2S4Q7kNvwFzT8F0&_nc_oc=Adp1q3kAjKXIIn_EGJ7DCYZQ6wUwd48DTILj0ZyPPdsOum2VRRLsBPcUdU1E5zqWv4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwXGbTxQNq22qDliQc3VugQZXtdLOEAhWrbbNklrb_vg&oe=6AEB4B65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_rtYnhOJDgQ7kNvwFoS2ut&_nc_oc=AdpuYhI73-8v__TB5KezUVb6rtRvPmht_JjnA2HBv0PodKnTX80LxgcYfAw4IHekKiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKhGVFahg_hyTAGvg1LHWkuqvzp4C_JE4jyG2c4zINLQ&oe=6AEB352D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WuwxhFVyxQQ7kNvwFHkYIc&_nc_oc=AdoPMn63nHj2m49Uqq_kUCNEpgyqVi2OOPf03UG454TxwBh9ti3Xke0ZUtQ7KDMnjHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe6nzO7eQ9rNdEuCXD3f47aqis9KsIZ_GEbHkkptC24w&oe=6AEB56B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZwe8iSnYBIQ7kNvwENiY3C&_nc_oc=AdpY5pn1LKuS0JA_XjzmeC4Adez6F7QLCAv5nwMHQc9FGkpbKu_-ba0tTSGz-drmb9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjl2GWCk8pTuXVMsH9wiwbWlx_teRCBIgjPiURKeWEOQ&oe=6AEB3CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wIAhKy1-kgQ7kNvwHjmcwt&_nc_oc=AdoMZCltP8J_wPxEdaiOJcGhMjZX3ixGAC2ydUP2dl8kI7-sR3NRpSvqlg25Vx2lb4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ZDFmu5W-KpT0tPqjS0OaMtuc3vWE5HNEYeX2upA5oQ&oe=6AEB60D4"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6SVGXnLdnoQ7kNvwFi6F2c&_nc_oc=AdpqyZSfH4NKhXPIeCo7Z-fuh7483OZ_WHmpBvXuqdwNqclI0Zdd-KlJZvI6BWoeN7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOklkq72YPjOi1zijryXf-ui5UjK9RXWaLsEslGx3Xdw&oe=6A79B225"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUSEOOvImKsQ7kNvwFO3BjS&_nc_oc=AdrONTtd71YWjs0uuUD7nBvSsDVfEnyyvwKMKPfA4HHUVphUhiEZ-SFaqmzIJPpGFrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpQhTVWk6qhJEGa0H-0IYoiQ18XQQQU9mJBmFTwpajhA&oe=6A79D42D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYKGxZBj0WIQ7kNvwEMUjQt&_nc_oc=Adr0T7u439i6pG2NqayLpfIUClcxWUAKQYughvxlLhdMdfLPC9UeFsL5lyOxNCKyE3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQqLqvMEtGBtm2pvG5ZhvaBi3EKZvRh6Esk_1uzyOLJQ&oe=6A79BD77"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMOs0HKL65oQ7kNvwHaUphS&_nc_oc=AdqqP7UttyKIfw4rbpj-xW3dikVs9gel7w98APhKnLRSRnR_MR9aHcMpWVqE1TUOsEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEny8z1FoB7f8XoMWBqxiJPMkbq8FVMvCM5kzvCRGBgA&oe=6A79DBFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtzNOAJiUGkQ7kNvwGsJLRx&_nc_oc=Ados_juz7oEatglBsuxb9UCkwNMnn7fdoqykJgCoTH91E7SElRRwhcsITJRaEike8Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ8YSHAZ5-WunjQsHXk_SaYM-uspDmXQp5k0MV-SQp-Q&oe=6A79C794"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ue2O2Q7oeMQ7kNvwFO1wuU&_nc_oc=AdqLVTW_yuzfA-rjc5a9lTnsTN3CP-9cRBudpQG8OM18PJyOHMpopuhlLOG73u3b-WU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg7ePzZvdhsXv5MAtVMr5QSJskWVPJ-H9ZtGpgBp5Xsg&oe=6AC90465"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QIhXgtgPScQ7kNvwFhc_ID&_nc_oc=Adqpu6EO0B0Dzb0KXuiYuS8j8omdTNOwl0WR9zyg9rgkRXT0yWpCmGFpVqMsgwRCP7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZpJl0GARpdIxyNbLYv2efurBrQd4UywNKhjAu8TV5sQ&oe=6AC8EE2D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_LwKVuw5x4Q7kNvwGapcxv&_nc_oc=AdpuKssmQDzPGzE3IbmHDyfF30sUYNixv4RAAs0zHT1gitGYGagmwSRYkFXcYurR4kc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_0K0koCAebAeEIiwCu46hpaDwEgHlf7_HyAwtvCWkGQ&oe=6AC90FB7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiHUQXZ9ZEEQ7kNvwGqT52n&_nc_oc=AdqA5Yn-eB4r_MEhkdHVbZkmxMExKrwKEQeSjYs70cmu5wnzIP90i5w46uKwWdjjk0Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-F1R1kNTNamakBrcMkJTm5gmOnfgvXQ38WQD8DLh70Q&oe=6AC8F5FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJjPZkvV2gAQ7kNvwGLchFT&_nc_oc=Adp06iL_QAS6vbuQ0hnCUAzHGuSYUv2UHOFhwK6gTVKBCkIbTF63TJP7vsFSs9QXR04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQf3loraqPjrgkrhpWCaEPJSwj8DVYs5LArNOix8QGXw&oe=6AC919D4"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
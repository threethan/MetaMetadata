https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-HxqAffx90Q7kNvwET8mu4&_nc_oc=AdoIHHbtF-DpkeeCkK9dLnazCg3F6atkMpzja_l-36U6FpvaVzy9Bw-UhKPKOQBsVq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXOVbYyxO6G_XFhljYLMTAtOye8kgX6JKitorHRikX3Q&oe=6AAD54E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jGyeDa_FGoQ7kNvwHBsDqR&_nc_oc=AdrRlQFzG0lF-O1cFUxVBeG375PCtcPKUEavk7vAGabSdVhDGs74ciAeQG-YYZI5kJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzbqm2Yae6BUac_T4tlvZzlrsXz1hHm0w1HV8Jao4JzQ&oe=6AAD3EAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4HPqb2QLR0Q7kNvwGqyTlj&_nc_oc=AdqT6LeBCcuzJ8tNVySNFoKIaSpqP9gp-Mt5_Hl9Ux_q7ovZ-EOAKQyJ1umOe8izz7o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKo_IWUY8DYj4nJ4a51Ihd7fB3pmwgr_8R5NzmTohcKQ&oe=6AAD6037"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaL3QK17CRkQ7kNvwFKut7S&_nc_oc=AdqrVUmvfOoa_asL-gQMrY_LFtjVW0TSL6hDFfpTW3SwuLAZlM96DQc-BxpDSNj7fxQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4PoP6WX9i_IkF-MZee84pnT79FIWhTQt6bOpB6wG66A&oe=6AAD467C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfwhG21H4t0Q7kNvwGXIswb&_nc_oc=AdpdPQgCYywawBuUD6BePjAnvRPcoRbIY1kkS0CDC14k15QUQnhIPIp3RAUq1ulwQWE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_N3S4Zsv2_IL-VgtbGT_FrlU-tbIxBaqXa7uv2Rre9A&oe=6AAD3214"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
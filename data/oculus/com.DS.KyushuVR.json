g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJtRMuI_p8Q7kNvwEwJcbH&_nc_oc=Adoe_FwIlQmnX8sPGSP__xtMw50-1AiFICeOU5HWH1iG4bGbE9f_7f4rJf4ATrmW0Bk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvbg1kAnHkYLGIUtZmP6t09Ri4baawDjWn7RcmA5JGCw&oe=6AEC86AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WuwxhFVyxQQ7kNvwFAmgWj&_nc_oc=Adqp5yDqtxknDx4n0cGCXjlCIv16ssvIfX2ZBzjR6GxZD-Mpx1VYQGxFtBxBNGGApEk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU-pYbLYd778pankBUx6rII30xW5xAG-IX11aESwOo7w&oe=6AECA837"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZwe8iSnYBIQ7kNvwESyGQW&_nc_oc=AdqDL5bfL6CqFXInmu4Hk2KMI5ASDN3cfSxcet1bobcrMzP8uqCLw2Di-AikObNQoHc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPAfaUeDN97balM8IKM5SBKO8BYNoLZocPsOsKlGZg_A&oe=6AEC8E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wIAhKy1-kgQ7kNvwEK780D&_nc_oc=AdqiqcHQWyjJPfd30sr2a4g09F1bv9ZXk_jUzDPxzFEPmdvKVbPgjUL33DzCOV56s9E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxLtutLt43yq3eHTUoC_Lm-ik5X3Cla33-R3e27dRGgA&oe=6AECB254"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
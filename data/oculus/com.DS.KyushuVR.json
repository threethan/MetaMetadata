https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dax1Mt0w19UQ7kNvwFM6kYG&_nc_oc=Adp_XJGROwpd6BC0Ecr7WbgQwUDSqqgo0WkrBRQMIDFOEFn00qv1jge3KKxNrVDTUHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2qLeLVCpRF17J0pvDP-X8huYGRVwAJwnUo180vESFDQ&oe=6AEDEE65"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJtRMuI_p8Q7kNvwHheAUe&_nc_oc=AdorLIIoxAiRZHnD3TRlDwGnqUlSEEssuLyt9tEy46Zm-YePJn8rXbOljylkt9ATNlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGD4gh5UUMENPzbaGgB7Iezd7rRpYX-bi0kD3JUkBnQw&oe=6AEDD82D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZLCY05t6E0Q7kNvwGDRSeQ&_nc_oc=AdrFLAhLO8fMmcIg2V5TiOW4ZkV5fA0pRtikJLIAl3TsLGyIu7XdBBuLVixGr_aVy8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAldN9g3MuevKy0nlwaC_m80dOIudNdqstWxvhPzk11A&oe=6AEDF9B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MamJDQ1Zv-QQ7kNvwGXHemC&_nc_oc=Adpyz2fEtyh1czMWUfOm7fJKeTGFBLVE-X9VrT97ST_l6Ebau4eIe1U5ItKnUlA1EuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz4Kkb_VaBWaNkbp76G8sEztIFZT9xffHV-GxjFCje9Q&oe=6AEDDFFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZ6FiAq_48cQ7kNvwGwOhjv&_nc_oc=Adq7Zzrt7mJRt4dMBoUzsAlnDRKt0oqem7ENdTnbuzfdZ7bW4OhGGQDjY774P-9ck4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi-Ht4fPHAL_USjweZXX280CNQYhl3Aa6GyfZ4yRZveQ&oe=6AEE03D4"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
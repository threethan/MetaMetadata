https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9gQqX0CPrsQ7kNvwFabIv7&_nc_oc=AdqBPf_jl188N1JVwvUEq396wlN8mmlL5ljyUCOoNne8XBM5F7Pzz3bk9lGmqYgh2B4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASv2ckSd_g3BAxk5_gvM90gZE9mhHI0BeGO8OLSvN4kA&oe=6A5E02A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAgmYrp2EcgQ7kNvwFA_ar5&_nc_oc=Adon4i0iNIunzGldKa4mwFtTyBr9rdRicsHutlKmiwlpdzXUM4qL9ozeAoCKXdEJ0so&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiNnrZeYFZbT28STWLAAFMMoUWWkv1a6UutnZM9cPDzA&oe=6A5E24AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3xfMglJwK4Q7kNvwFbhGeH&_nc_oc=AdqFgzG9Xbr167tECv8EKjBUIFv8iGGMdudSN2fNAl-mHR2Cbi6ltEatSs-FC-M_HsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSrCeK-T0L6zHk8kHK0fxN3fNzOjq2DhvjJeVoCe1xrA&oe=6A5E0DF7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uwShF-t9OAQ7kNvwHRNiNE&_nc_oc=AdqrY7jxu2nJTDgOGtloUeiSzkQjrZQIajTFNVvIwxwIrlmPH1fYvZErNLZGRvP6Ads&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXzXZMfVI4dFI3tt-NI2BKBmEMQuRduHgkkmW4gC_PLQ&oe=6A5E2C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cDyFa7uIlMQ7kNvwHR5JVs&_nc_oc=AdqaMfKSbqT3B3_M-AapqFzntmJfISNLOD3zupKCglVa-fjlUjbzG3c524QpmvoIuzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_0scIYJ2njzZXnxTxOlcNU7p8n0vC_WxiV5oH15ILsg&oe=6A5E1814"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
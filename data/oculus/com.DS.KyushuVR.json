n.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuEh-t7sI6wQ7kNvwEPxv3w&_nc_oc=Adnf6qn_hoORcZqyhzDPozCa9S5ZfUkyjwI4Pao_yTCF9bY7ZbVsMMyZcOLlipBbpO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLOhjMWG4qNAmus8L8zrwC6lGfmsUwEfw6yeGwkEceAA&oe=69A813A5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IOCpDeb5M0Q7kNvwFLood2&_nc_oc=AdleWc4F_tRAEjI4imVU2lbA63tsjPczC35WcJqQ6222giRJNeXkpQT0BAvVXpJqk-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afue8iAb6ulopl3dkU-_smL371P3muTgq7eb-GrlB39imQ&oe=69A835AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAF0oJGEupkQ7kNvwF5wk-o&_nc_oc=Adn8BI-nqBNtP75I_L2Tbl4EoRhwKkjAWqMFI-uWjl063mUTzl-c0L8OU4PZOQLUVec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuOEhxWMcld2Rp_fBWhu1gGqepgYD-WG5p0a9rLJL0_ZQ&oe=69A81EF7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af1wI8G2i9QQ7kNvwHepfEU&_nc_oc=AdnYdlW9GzK0MCaXkm4Bu5S29XgqH20JgGYM2iNhTlCDSt3o7w_q5gwUyQw5iWxlQfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsVBKhJ291ILetwVl-pB2gjvLEiHMJsZPvew7bQ6PO8eQ&oe=69A83D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUUwCtmZXdUQ7kNvwEi9AVe&_nc_oc=AdlyCFb_MjSwRiQ6L-oBdts_kYoW5055oNiDrVln9ShRJod0P-rEJhenb_1Ls9mSd9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftT4qu7-PK27LR9dM9Aki-990Awjr5iS1R1Y9x-Adt-Rg&oe=69A82914"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKHof9bMYKwQ7kNvwEJZK20&_nc_oc=AdqkC7KWMA_lVx2F4-qjjM4MumrEys7lagU3daMl2YoejBINXo_d8bzaNZKT1yS2PLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6oMOpTjiyPk9tvgusYhWoAOFaWCIxADu6e6WdrdimzQ&oe=6AE210E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_WouXGnBaUQ7kNvwGPhxpb&_nc_oc=AdrQ3kXYrK4L9tSTE3jJm0ce5OoNXS892Ez0NULY78EMZdSGxD5BNGQoD17zOV4TzkM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5KJZmYRf6afMtIHYFO1nJ2dxOc6lQd7Xp5preLp0sIw&oe=6AE1FAAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncAaIglIqjMQ7kNvwEdj9ok&_nc_oc=AdrlXRG9maX6N7LnzO7Zzqet0Qq2zaU_sTB2gjLtHKRLMW61VCThe3bC36GulyrYnh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN03tvugbFJWEzFEmnAhFJd5J8asv46sXgGSapU9L4h8Q&oe=6AE21C37"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8HZ5dCS0G4Q7kNvwG9szvk&_nc_oc=AdpDWI642Pmx9oQH-Z-CHXfKCEtAxjF4Kegi5b3EKNQm7RiMv7QRqVsZTdCtn4chCWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqe3ydpleUnyVy4Occgy60eJhiOC1nnVaJLvyJ0kag1g&oe=6AE2027C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jarbqyuZGOAQ7kNvwHLBxwO&_nc_oc=Adr0-lAt_L0UU0nfNbEmXR9ycd8awx6Xh7WBKZiGDZGprh3Dswk5Z0h476xzFn8BQ_A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuL7-iInRPXTnx6qXzpW6-pz4LT8Kh_8b1Cczjvf8kQg&oe=6AE1EE14"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
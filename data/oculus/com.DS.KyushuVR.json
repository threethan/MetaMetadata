g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoJCQqC72ckQ7kNvwH3QdFh&_nc_oc=AdpEP_pMapdXr2-jorr7U3MzRGzSY8z75uqOy_rOs4kRDkSXccayN7SpzBlNBpjUtRs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbprj72W3JNaTfyRTzF4gUNBP2jV42ns59roSaUnvSjA&oe=6A4E52AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCC3e1DiW1YQ7kNvwE6sy_i&_nc_oc=AdrM8T-_Vp7ARzRsB27F46DF-i5643o-iRU2_STJ1JsQpKuBg9APMpDQ9Cr-0PFbjuc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-7UfzUWUo2mL_i5iudRPcBL0yblNTBYt9vW-ETPoAcA&oe=6A4E3BF7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwgxOF4CdSEQ7kNvwFddj64&_nc_oc=AdrUnErbQLmwwL2RYJjynaWuIBPbVslrS1TKDPMZbD_odch4QZzBo_nK-8VOD9YIVcE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc5j-a2CoDMbJuh-SJMLCdlYIllE16JKVzCFh0nacWAQ&oe=6A4E5A7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FskxB5exRAQQ7kNvwGJvs9a&_nc_oc=AdptXl8R-szhzbTsUfyk4dgcd0ILHLeSHDdBLS4eDMRDr1JOFGRqvJOh3TIP_HZA1sk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiZQQEbAgM9R5qUEL9xTmpkdNdEnjfj8XKIEBWJcgd6A&oe=6A4E4614"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
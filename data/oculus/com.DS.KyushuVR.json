g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B605TJ_zv0oQ7kNvwF7Ntyo&_nc_oc=AdrP8nu8jfwjgRzdEykBWhqRkNH00T3jGa5_5HDK9eizuBBOECYgJq8IAgE9fIi7jl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBztqxUEfBbKvv7q5FMIV6WF9X3cuOZ6XwW8z-M3Dltzw&oe=6A68B0AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6zZ5iUHbv0Q7kNvwEz0XgT&_nc_oc=AdoO2jY9uz_J4MoB3pL_DIytzz9wQkv5wuiPAO3nMzdXyKRTcHlPJguiek6LD8i5Www&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUBRDUI6h-9acUQwbrP6FBtImUjrvQ1B0uoHOQqJN4tA&oe=6A6899F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pa_4B7_PzoQ7kNvwH7fuau&_nc_oc=AdpyTy9xEHNZ3z7BR1E4_wDUPCRrMrWQuxl6tvPSPKUJJpQLm4F2gxnM7zx_mYyd0lY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8daJWAuD5hoCqyPrB_gXeRfeXPS7Y6r3nw6sSz8VaQg&oe=6A68B87C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfvytLvU4wQ7kNvwFX9vTq&_nc_oc=AdqAFerK59XmOZH6TSXYNYYgCRII-iicK8rJbPsKYqcl-Y3kmKh-qTynFWgIOTJqsLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp0OrcXQASUVYMB9CQ7vqxIpzFHxp00BgX8PqVkI3CWw&oe=6A68A414"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7850261341769733"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
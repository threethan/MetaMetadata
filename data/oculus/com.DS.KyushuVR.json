https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sY7CH2lh_MQ7kNvwGHO0El&_nc_oc=Adqwg6xP8c1v91srfUaooYOvu7qCjShcGo0c2aRmWVRZjwNZpIx_Qj3qunnjyGkWgT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT1IX2cxZGGO7UpWiE4chcD9xccfOx7Lgs3A6zFPSCng&oe=6A75F5E5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9W0WPfkbZYQ7kNvwHSoauf&_nc_oc=AdrKi8d8WqWL-qGxX77MziH26rS4GuoFbKDmem5K3RZVBKBWQp2zACzNlUNdiclB6Lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV2kRrojZAoS1sR4Ei4mnuYnyDwfhT2PdQzm3LNBwfPw&oe=6A75DFAD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkQ01yN3XnQQ7kNvwG2xElH&_nc_oc=AdpHPBkaBi_5cMoUjQn80SpWZdatiKDZsSMQyWEmkCJ8aw0n9JUMbdIe7_zspy3pBGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyqjCXDurgDBFlvAl1boopLPDnVIAty_jTurkfabifqA&oe=6A75C8F7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EGZD4viCB4Q7kNvwGraXXO&_nc_oc=AdrKaRN20K7V2gkR_xgF30xCJtJOpp51osLEScV5Mfww6Rv0xXzor4QSmpTUt5KX78k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjNn3qFNfVir2IkVva7YE-5yhoE_-62k7aJk0eLMnBew&oe=6A75E77C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8tT1Xey2k8Q7kNvwFk2KNU&_nc_oc=AdrwIESMl9PG65DYrkWcjfxRycDK8VKduma_a26ETRMZXhBce7LQLyHlwp5X6c_fNGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDB95M64keOBQSunhBSzsFTKl9sEObPrGI8b6xt6qfCw&oe=6A75D314"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area
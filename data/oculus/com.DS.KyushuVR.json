ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-HxqAffx90Q7kNvwF2QWzK&_nc_oc=AdrhpMitntnNgtxeT05QPycJ0UvsQDkhVZiKCo3ajaSv2BfGCXhrf-P61GgsRrLkaPg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ1aveRiA867Q-6BExHeSyUkrdwT0bsumQS2CSjVvjbA&oe=6AAEA665"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jGyeDa_FGoQ7kNvwEea2lW&_nc_oc=Adq6JdY7L5Xqk9y_wrFjXQHgfk-Eh1R-ZKmOP-eMVENiBuc3sJJpcPqX7pvNxFt5Gvo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgwAg9DJyjffstvEqt2di3_PAosnEHNhFcoObGGV5aZg&oe=6AAE902D"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUcX_h4ExBwQ7kNvwEriNbf&_nc_oc=AdqrkmOQ5CHy-UpPrxWK0fGzRfaO6iVm42CnzaYkNkmTAF4g_swfBVgaYb-i0sEjydY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzHMRgMsNRqB8elq110quh6kc4UT9LPTM8K1YZp_sF8w&oe=6AAEB1B7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxJ1HMCsxxMQ7kNvwG0Vjih&_nc_oc=AdqviUnbHt_v5KGxOy9Eob1MxnIchvQKwa1CaiKbTi2XYjGR1J2RcdIG1ct_aHKjw2M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDtSgus0hrUK4yw0yGCU9BMJN_xF84nEkoKFQJdMpAHA&oe=6AAE97FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU2Ly1ouIwwQ7kNvwFeXp5N&_nc_oc=AdpHoP8P4LsEPtP_iGIzmdqBSQA4Hszw0GrPm6tSWkFI6cdAQCAbEoP1Kr5Bx93p2Zk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2f7GsIYFGg7b5dHRj6zJFVO0TZHnO8GS05_Zxo2sajw&oe=6AAE8394"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
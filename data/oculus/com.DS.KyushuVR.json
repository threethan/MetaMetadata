ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdyvQQd3ar4Q7kNvwHn_nv8&_nc_oc=AdqRXf2REzef5ebHyR01S9FjSDqxLfF0qKegvCP1SG-etppzfltbh2eZJcEfH4bs_CY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CwBHRzqNyi-fwK0dBNoUB5UILxGd0iNS1YdBN4gnhBg&oe=6A36ADE5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6yHkkXdjD4Q7kNvwF0FV-H&_nc_oc=Adr2KQo7uL4_627Xx7v2oT6fFAI7V_L9T00QFm4W8gu750LuVlok_9_8rxfgjD5pMio&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HnQi7xJjeUr1hHQ1v5czWxDTDiP0PjkxVaMg3H1MMcg&oe=6A3697AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4rO5HXjbg8Q7kNvwE90OxS&_nc_oc=AdpSgyNeL-sdGajlRFgCwuGu1oV12XPdeTuj9iM7SL3uzEkwrwkOwQ5Zm6JP7WP26J4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RvSxZXVmOyB5-HaEIMWB26Rq42hSoBZ4mxB6sqOXWUQ&oe=6A36B937"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1gzZbyakcUQ7kNvwEBA71r&_nc_oc=AdplNb4q_c2Ag_qtXyaIlQlwFEYTwADoHbiboMwCqF_ZuUip5iMhH9tVsj3FJGWEE9s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87dZVtnw2wdXIAAf3wX1WDzIPjVWjZ-_9jxPv3Xvo_ew&oe=6A369F7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKwyYLGbs7sQ7kNvwGAQGRD&_nc_oc=Adq_kfHoN79cfBpHvCvDihsaYdG2hQDchvfKlh2LNoT5KzN30gaW9npUTMW-lIbufd0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IqQKkfmktqWaakGoCgEZTuD6jJ9EetXwRV4KZuGNpFg&oe=6A36C354"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD"
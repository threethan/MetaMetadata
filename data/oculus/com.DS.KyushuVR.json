n.com/v/t64.5771-25/57566684_839122568067366_5325363856750465356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjVRYrIWaY4Q7kNvwFsHJWC&_nc_oc=AdkW325VPrHN4FBIrHXQlXoG4bMhLU25hTximEAsKEAF6GPUK_UUpGvYlfbZ-NxeXUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKcW48Sp3k6MfTQJPKh5U3SBKQ6RR6lo3XYM3vDgSkmw&oe=69B29FA5"}, {"file_name": "lake.png", "id": "2376138252744831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982495_2376138256078164_589648725786180825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs7uvINyi0QQ7kNvwGW2bf5&_nc_oc=AdkVfrb4aE3sgi96MwK-WDgRIVGr7RdaJVng_27NAuZIqQHy1K80OzfLp8NAZ4YrTR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmupAbKm8x2e0s_KsSve3A5rcZbBnOTGKj7_UpixqUyw&oe=69B2C1AD"}, {"file_name": "cable-car.png", "id": "490555963633013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299158_490555966966346_6525857663992777479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8BlrP7SzFYQ7kNvwGzVA3Y&_nc_oc=AdnXwfWpW_j7oLcSYYRvtKYrcf1VHsQHqex0Svvn0N0V35VNwSWsKcbEuhD39oAz2Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgubZoDYcJKUqKXPfJ8zN961OSVWwQa1tBFSpQInd1Pw&oe=69B2AAF7"}, {"file_name": "hot-spring.png", "id": "522841023733077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630186_522841027066410_7271407321016795360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCLiuMUFMRsQ7kNvwFfHHFn&_nc_oc=AdmriSH7IHR6dRcs0-kqwR2TGCNHJdjS6QWoxv302sr7GUD2Gl0PB6O5mD4lSnMmWFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9txucWMeUx_VHVpt-_L_iwtNe8im5nw-I6DzepdX-fw&oe=69B2C97C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-cover-anime.png", "id": "458164503489650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982721_458164506822983_8353242327976778900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku3Cy9uOUtsQ7kNvwETjxda&_nc_oc=Adl5b877C15Ymg6kP5rzpSIEzLHraBgHlsabAfdiOFAigO5xBzh3CCXk4AZaCB97nQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeucunXIZ9wnEr4ImpTdVO9ta2OUOdOFUTBaEchU0-kA&oe=69B2B514"}, "display_name": "Kyushu VR", "keywords": [], "long_description": "A series of immersive documentaries about the island of Kyushu in Japan. The style combines real life 360 video and more fantastical AI built worlds illustrating historical scenes and Japan's rich anime culture. Kyushu is one of the most volcanically active areas in the world and we focus on several of the islands main volcanoes, both the geological and the cultural impacts. Another episode focuses on the sub-tropical island of Yakushima, known for its natural beauty and conservation program as well as the inspiration behind the studio Ghibli anime film Princess Mononoke. Another episode focuses on the city of Nagasaki, the second city in the world after Hiroshima to be attacked with a nuclear bomb. The series is both informational and inspirational.", "short_description": "A series of immersive documentaries about Kyushu, Japan's third largest island and a vibrant blend of natural wonder and cultural heritage. The experiences include a combination of live 360 video and more fantastical AI built worlds to recreate historical scenes and acknowledge Japan's rich anime culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://catchreality.co.uk/index.php/kyushu-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Catch Reality", "support_website_url": "https://catchreality.co.uk/index.php/kyushu-vr/", "website_url": "https://catchreality.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
ltTUzZWJ9v_Z22KIEAW0rHiEUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31n2jcs7_cnrFK2mPNk4W11HswTgoGY9zLDXEMyG4xPw&oe=69D39F05"}, {"file_name": "SEG_all_star_smash.png", "id": "657260543892494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821674_657260547225827_15667374464005964_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmS70Bg0rpoQ7kNvwH3pNA-&_nc_oc=Adonze5Q_ZLEBdSKdFnva9Sk3nEXsRt635M0CeeumnaiZnCNRDAVdfET7dxKbu-0Spk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fF5b0u_3-caLn0OLvvL0HguToooSHVVnr36TXh6wJTw&oe=69D3C5B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SEG_Cover_Landscape.png", "id": "778139748375025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_778139751708358_1423033100072686582_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC8KBeMPG8MQ7kNvwEhaoD6&_nc_oc=AdpGg05gYFhPf_0M_hXd19i4CLoz5S3A193qv2lIL54y3eywdBDWOHtb_bpvHfDC9v4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yxrMxvzgPefF_TkHhc95U5PVP2yEAcyW1YMNuWWiHxw&oe=69D39A9A"}, "display_name": "Smash Eat Grow", "keywords": ["fun", "multiplayer", "choas", "destroy", "PvP"], "long_description": "**SMASH. EAT. GROW. REPEAT.**\nThe bigger you get, the more you can smash\u2026 but watch out \u2014 there\u2019s always someone hungrier than you!\n\nWELCOME TO **SMASH EAT GROW**\nThe alien Smashers have landed \u2014 bored, reckless, and starving. For them, Earth is an all-you-can-eat buffet.\n\nSmash buildings into pieces, eat the leftovers, and grow into a towering monster. The bigger you get, the more you can destroy \u2014 until another player decides you look tasty for lunch.\n\nIt\u2019s simple: smash to feed, eat to grow, grow to dominate.\n\n**PURE VR CHAOS**\n- Everything\u2019s edible \u2014 cars, buildings, even your friends.\n- Grab whatever you can, hurl it, crush it, or swallow it whole.\n- Every match is a playground of destruction where the last one standing is usually the biggest.\n\nThis is PvP multiplayer madness where laughter and chaos are the only rules.\n\n**CUSTOMISE & COMPETE**\n- Earn BUX for smashing, eating, and winning.\n- Use them to unlock wild outfits, flex your style, and enter tournaments.\n- Every victory feeds your ego \u2014 and your wardrobe.\n\nSmash your fashion. Make yourself appetising.\n\n**BUILT WITH THE COMMUNITY**\nJoin the chaos early and help shape what comes next \u2014 new maps, modes, powers, and more. Player feedback drives the evolution of Smash Eat Grow, one ridiculous update at a time. Discord link: https://discord.gg/gpcPrZUGup\n\n**FEATURES**\n\ud83d\udca5 Fully destructible cities\n\ud83c\udf54 Everything is edible\n\ud83d\udcc8 The bigger you get, the more you can smash\n\ud83c\udfae Chaotic PvP multiplayer\n\ud83d\udcb0 Earn BUX and unlock customisations\n\ud83c\udf0d Built with community feedback\n\n", "short_description": "SMASH. EAT. GROW. REPEAT. The bigger you get, the more you can smash\u2026 but watch out \u2014 there\u2019s always someone hungrier than you! Smash Eat Grow is a chaotic PvP brawler where everything\u2019s edible \u2014 cars, buildings, even your friends. Welcome to Smash Eat Grow, where chaos is the main course."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR Games Ltd.", "support_website_url": null, "website_url": "https://www.xrgames.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FIGHTING", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
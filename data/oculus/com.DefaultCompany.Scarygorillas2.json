nMYBy76nCw&oe=6AFDDCB4"}, {"file_name": "New Project (6).png", "id": "859490857256754", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_859490860590087_4461214709590730794_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rDZwfdVH1cQ7kNvwHSkaSN&_nc_oc=Adpc_4zZwFxE29FfFVJQ8wQhYo12SgUGk5SvEQEkHqi4oIAXNgwMGxsRE5QxYKoQi-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0SUPFTYmtAQju7Ppbs8Ma1HDKEyWJKJLgkfEeiO7ZZg&oe=6AFDB9E8"}, {"file_name": "New Project (5).png", "id": "663501180086909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303864_663501183420242_62861185708618062_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05Eox02_L1QQ7kNvwExmlnK&_nc_oc=Ado_Djj8c8iDiGXlUnpHC6tczQeSL5YlglgwtMp_-COohuGk2F9a0MQadInxF7N8skY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi0jU7CJY6AgqbR_01CF_fcwbt9zydTkDJVmIL2einVg&oe=6AFDDE1C"}, {"file_name": "New Project (4).png", "id": "2354912698304892", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302483_2354912701638225_1897587688850481934_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDZ0bu4_OgMQ7kNvwGSpZDi&_nc_oc=AdpbxpTPSq5R7SwRsqNIaGAwTcqAL0zm_1mTneTnMWRhqvj7tP1tvn3YywFGPiJuFIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIa3NTmubV0M1p3iIODA9mWPPExfPEUY_G1fsQM691Bg&oe=6AFDD6A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Gorillas 26", "keywords": ["Gorillas", "Scary", "Ape", "Monkey", "Tag"], "long_description": "An exhilarating and immersive horror game that puts you in the shoes of a gorilla navigating a terrifying world. With movement mechanics inspired by Gorilla Tag, you can swing your arms and move fluidly as you escape from menacing monsters.\nExplore various game modes, including Sandbox and Glass Bridge, where you can team up with friends or challenge yourself against other players. If the horror becomes too intense or you find yourself bored with the game modes, simply grab your SG Tablet to chat with fellow players and check out the leaderboard.\nThe game is highly optimized, delivering smoother gameplay than Scary Gorillas 25. Enjoy stunning graphics crafted by y65noah, the game\u2019s creator, and customize your experience through the SG Tablet settings, where you can also adjust the FPS.\nA new feature in this version is the addition of crates! Open them to unlock unique cosmetics and adorable pets that will follow you around, complete with engaging animations.\nWe hope you enjoy your time in Scary Gorillas and encourage you to leave a positive review!\n\n", "short_description": "Scary Gorillas is a thrilling VR horror game where you play as a gorilla escaping monsters. Explore modes like Sandbox and Glass Bridge, chat with friends on the SG Tablet, and enjoy stunning graphics by y65noah. Unlock customizable crates and adorable pets that follow you. Experience the fear!\n"}]}, "developer_name": "Those People Inc.", "developer_privacy_policy_url": "https://sites.google.com/view/changus-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "y65noah", "support_website_url": null, "website_url": "https://premiercardsandcollectables.my.canva.site/scarygorillas", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROO
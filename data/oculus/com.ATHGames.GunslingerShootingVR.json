&_nc_oc=AdoiHHZcV_nly8iryOmhrVtfx9CsRVyPYc9oj0GzdZDadXaQtHeLZ7xpX1Fmjr3iDoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j3edQgDuyEETpVjCersOOavpbm-zt6Tl-HWnW593cCA&oe=6A2AD76E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunslinger Shooting VR", "keywords": ["Shooting", "Cowboy", "Action", "Hunting", "OpenWorld"], "long_description": "Take on the Wild West in Gunslinger Shooting VR, a focused VR shooting game. Grab your revolver or pistol and put your aim to the test in fast, skill-based shooting challenges.\nThe game is all about timing, precision, and reflexes. Each challenge is short and fun, giving you a clear goal: hit your targets, get better, and see how fast you can react.\nIt\u2019s built to feel smooth and comfortable on Meta Quest. Controls are easy, movement is simple, and the focus is always on shooting that feels satisfying.\n\nWhat You\u2019ll Do\n\u2022\tShoot using classic Western firearms like revolvers and pistols\n\u2022\tTake on quick, skill-based shooting challenges\n\u2022\tImprove your aim, timing, and reflexes\n\u2022\tPlay standing or seated\n\n Built for VR\n\u2022\tOptimized for Meta Quest\n\u2022\tClear, easy-to-read Western-style arenas\n\u2022\tComfortable for short or long play sessions\nSharpen your aim, master your reflexes, and take on every challenge the Wild West throws at you.\n\nDownload Gunslinger Shooting VR and start shooting today.\n", "short_description": "Step into the Wild West and test your aim in VR. Quick shooting challenges, fast reflexes, and classic revolvers await."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ath-games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ATH Games", "support_website_url": null, "website_url": "https://sites.google.com/view/ath-games/support", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "27433260
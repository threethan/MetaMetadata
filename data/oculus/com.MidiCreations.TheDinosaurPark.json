69D4F37D"}, {"file_name": "ScreenShot5.png", "id": "3081794178689307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_3081794182022640_8990872075393770537_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43HTfanPykMQ7kNvwGJleSx&_nc_oc=AdoaQpG01anmmeoRbAacLKVAwoxWBl2EWrIKuAbF0TsER4q7B0A6JCu1Hu0f1PE42jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-CsfvvbcJGLL-3j8c3aQs4lEWIi2gCGIVLdYS4MiyGQ&oe=69D4E4D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "1435555668253840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1435555671587173_8787443424476076994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lerFo3Kii2sQ7kNvwEU7-vH&_nc_oc=AdqlBM7ox58e6txhYFZ7Rk8rLMWS9ih-Aw6YnAJ0_wwH-GsKmit9KoE_mc3xYvlwXOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d4ujuDS1Qu7jDfkEIKMfexj3TbPHSDVvIQu42SjRuZQ&oe=69D4F978"}, "display_name": "The Dinosaur Park", "keywords": ["Dinosaur", "Park", "Jurassic", "Education", "Prehistoric"], "long_description": "The Dinosaur Park is a VR experience that let you walk and see a collection of dinosaurs with educational information about each one that you can see when you stay near to the information points of the park, here is the list of the dinosaurs included on this VR experience (20 dinosaurs included):\n\n1. - Ankylosaurus (Model1)\n2. - Brontosaurus\n3. - Carnotaurus\n4. - Parasaurolophus\n5. - Spinosaurus\n6. - Stegosaurus\n7. - Tyrannosaurus\n8. - Velociraptor\n9. - Triceratops\n10. - Anchelozaur\n11. - Allosaurus\n12. - Ankylosaurus (Model2)\n13. - Deinonychus\n14. - Dilophosaurus\n15. - Edmontonia\n16. - Giganotosaurus\n17. - Medusacerotops\n18. - Nodosaurus\n19. - Pentaceratops\n20. - Torosaurus", "short_description": "The Dinosaur Park is a VR experience that let you walk and see a collection of dinosaurs with educational information about each one."}]}, "developer_name": null, "developer_privacy_policy_url": "h
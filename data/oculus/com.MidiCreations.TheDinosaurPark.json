195767197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8dmHdF4LTAQ7kNvwEL7caU&_nc_oc=AdqUxqFTMoKZ_8wi3fmQx5jmgD-bfLvCUsG3aw8raBio_2wwdGl4kUxSPBCF4fH48vY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ci2nD7slsYPEr9PYzsYmWUS2fvQJbrbR3uNFnLzhd1A&oe=6A429813"}, "display_name": "The Dinosaur Park", "keywords": ["Dinosaur", "Park", "Jurassic", "Education", "Prehistoric"], "long_description": "The Dinosaur Park is a VR experience that let you walk and see a collection of dinosaurs with educational information about each one that you can see when you stay near to the information points of the park, here is the list of the dinosaurs included on this VR experience (20 dinosaurs included):\n\n1. - Ankylosaurus (Model1)\n2. - Brontosaurus\n3. - Carnotaurus\n4. - Parasaurolophus\n5. - Spinosaurus\n6. - Stegosaurus\n7. - Tyrannosaurus\n8. - Velociraptor\n9. - Triceratops\n10. - Anchelozaur\n11. - Allosaurus\n12. - Ankylosaurus (Model2)\n13. - Deinonychus\n14. - Dilophosaurus\n15. - Edmontonia\n16. - Giganotosaurus\n17. - Medusacerotops\n18. - Nodosaurus\n19. - Pentaceratops\n20. - Torosaurus", "short_description": "The Dinosaur Park is a VR experience that let you walk and see a collection of dinosaurs with educational information about each one."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO
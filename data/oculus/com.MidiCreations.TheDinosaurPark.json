\n7. - Tyrannosaurus\n8. - Velociraptor\n9. - Triceratops\n10. - Anchelozaur\n11. - Allosaurus\n12. - Ankylosaurus (Model2)\n13. - Deinonychus\n14. - Dilophosaurus\n15. - Edmontonia\n16. - Giganotosaurus\n17. - Medusacerotops\n18. - Nodosaurus\n19. - Pentaceratops\n20. - Torosaurus", "short_description": "The Dinosaur Park is a VR experience that let you walk and see a collection of dinosaurs with educational information about each one."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34167168086259967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825345_3084841435052905_5466931642415926241_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyLBqkaixQAQ7kNvwEqxt1P&_nc_oc=AdpDnWwe_rilggRl8y-RcnQxgWJp_o2fI2ZhA8phGP1WcEX2x4I6v9dEC3M_W-BWa7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b5S9um5DI0ZFchP5-x-bmMGJJ9ZlAcMRoi4I6e9D-oQ&oe=6A0B09A0"}, "is_concept": false, "is_test": 
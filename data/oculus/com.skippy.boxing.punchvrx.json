 AI for achieve professional fighting and more interested training and other fighting features.", "short_description": "Get into the boxing ring and show your boxing skills. Defend and block the opponent and attack when ready. Play with real friends in Multiplayer mode."}]}, "developer_name": "ABSTRON Pvt. Ltd.", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29066993326225541"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1857159981582493_7416142682963603626_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL-iJkZIDkYQ7kNvwEBh0sA&_nc_oc=AdoFlYC6xAiD16wdqgg4Mb7GkHKglOsLyqOhnhpIJFga2ztvTjigjauevgIRaUcaDj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs2jhKfZ0lQpbQspk_YJfw4aHfa287iXQyXQkwI5PP3A&oe=6B07204A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PunchVRX - Boxing", "platform": "ANDROID_6DOF", "context_catego
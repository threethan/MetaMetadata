Ssxc2VF1PzjU76AGSQ&oe=69BBE50C"}, {"file_name": "Screen-2.png", "id": "1192899769475439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_1192899772808772_8495302902367977245_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4jOPkB-36YQ7kNvwFyjtpW&_nc_oc=AdmyA4hur719FCL1y_rk0at0tdUQVk9BX_dN916V9N9qYUra8-R8zPI-8OE_DPnsEzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3rcDe2jtV2dRQV4fEhxgkeG4UmLUZ2m6HXm81Vy3q-A&oe=69BBE473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1544213819639451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1544213822972784_4152525690508847704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J19U7joFCIIQ7kNvwERaSA_&_nc_oc=AdnVb3ijJgJ9nZKmzFnSbt_G8uYwW80afWGLPATHF2CtGxj9VM9_hoZ4ubMs3vxs12w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5FtuOOJIBvywCt0RFPlRDJwt1pCjdBKoG2HfRa-d0uw&oe=69BBFCDE"}, "display_name": "PunchVRX - Boxing", "keywords": ["boxing", "fitness", "health", "sports", "fighting"], "long_description": "Live your dream of a boxing champion and conquer the ring. Push attack and defend to fully surprise your opponent. Amazing gameplay with outclass environment will make you feel the real experience of what it looks like to be a boxing master.\n\nFor fitness, use the training equipment in the Gym and play with your real friends in Multiplayer mode. The game is still in development and check frequent updates as we improve the opponent AI for achieve professional fighting and more interested training and other fighting features.", "short_description": "Get into the boxing ring and show your boxing skills. Defend and block the opponent and attack when ready. Play with real friends in Multiplayer mode."}]}, "developer_name": "ABSTRON Pvt. Ltd.", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_webs
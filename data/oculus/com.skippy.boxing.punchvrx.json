f20f&oh=00_Af_xB6trPq8Ye3c0JyxiSnInVKZHBNI2wpbM_T6xSQOBkQ&oe=6A21A0CC"}, {"file_name": "Screen-2.png", "id": "1192899769475439", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821115_1192899772808772_8495302902367977245_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZGwkNlVmGkQ7kNvwFNc_aR&_nc_oc=AdruxZ24nkRNsXR3jw_BZ2BrZ7TYMGfNOmwbft1cxaPU406Ok2C7UExKHOnMF3KtPo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l0DC7i5w8JoBPtdyqWi-QK8_dtkyKDOn9DNvlU58oNg&oe=6A21A033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1544213819639451", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1544213822972784_4152525690508847704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eszQA60aleMQ7kNvwHqYg4S&_nc_oc=Adph_pzooP_tMY5pGBVK50GyguWp63zoLVEyVg6Mq9WJ1rnVTOM4roF8MqavTG8HNZ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Hda29XUiRcOB0NthPzvx7yyWYYK8hOQaUImFY060tg&oe=6A21805E"}, "display_name": "PunchVRX - Boxing", "keywords": ["boxing", "fitness", "health", "sports", "fighting"], "long_description": "Live your dream of a boxing champion and conquer the ring. Push attack and defend to fully surprise your opponent. Amazing gameplay with outclass environment will make you feel the real experience of what it looks like to be a boxing master.\n\nFor fitness, use the training equipment in the Gym and play with your real friends in Multiplayer mode. The game is still in development and check frequent updates as we improve the opponent AI for achieve professional fighting and more interested training and other fighting features.", "short_description": "Get into the boxing ring and show your boxing skills. Defend and block the opponent and attack when ready. Play with real friends in Multiplayer mode."}]}, "developer_name": "ABSTRON Pvt. Ltd.", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publish
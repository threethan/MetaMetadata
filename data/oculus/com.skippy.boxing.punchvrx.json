f-1TK3a7I3b9roBonA&oe=69BD368C"}, {"file_name": "Screen-2.png", "id": "1192899769475439", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_1192899772808772_8495302902367977245_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=450PeyOMD6AQ7kNvwEFlUAY&_nc_oc=AdkNgMYha79HePsVQN0d0ThPZG7fPkYXQhErhg-KXxXS4nHWWh2HX36I8MFtwS5oWYY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-GX5EyIzgPBSkxZ3z9bJvQBItLF6puPPt1Uh5-X7zVg&oe=69BD35F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1544213819639451", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974809_1544213822972784_4152525690508847704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj5yCcwRkZcQ7kNvwGt5Kk8&_nc_oc=AdlKMItEJvFT8O_1fJ6Com0i_9Bq1veiMVy0YyqESAtMURBZABRByc1ePSk2kROGEOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7zKQvQ3ItQ8F35NXuPhowsZvoJNQF37UELcsb_-LHPw&oe=69BD4E5E"}, "display_name": "PunchVRX - Boxing", "keywords": ["boxing", "fitness", "health", "sports", "fighting"], "long_description": "Live your dream of a boxing champion and conquer the ring. Push attack and defend to fully surprise your opponent. Amazing gameplay with outclass environment will make you feel the real experience of what it looks like to be a boxing master.\n\nFor fitness, use the training equipment in the Gym and play with your real friends in Multiplayer mode. The game is still in development and check frequent updates as we improve the opponent AI for achieve professional fighting and more interested training and other fighting features.", "short_description": "Get into the boxing ring and show your boxing skills. Defend and block the opponent and attack when ready. Play with real friends in Multiplayer mode."}]}, "developer_name": "ABSTRON Pvt. Ltd.", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_webs
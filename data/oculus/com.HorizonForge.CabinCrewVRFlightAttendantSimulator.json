nc_sid=6e7a0a&_nc_ohc=twXFYFjTm0oQ7kNvwEtv1d7&_nc_oc=Adojt_OPwdEh1p-v9UaHxx3-D-iUVdF0c-I4Cj9moT1aaenQ0Na8rm20S969nO9Ye0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K4u9mT60Inwed8GSS0zGq9lWZ2ejUzJW-V2fkEv_PAQ&oe=6A186368"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRVn4Y11mfwQ7kNvwFBpvPo&_nc_oc=AdrxYApn8zrPnaGbflyHif2miVK0pHzZGMYE-5BSlg0DzvTpOzuezms31vCdkUVHdLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HdDeMJwYcr1YY0ksL1ebpjDpHRXkUhEWDO6MRenavwA&oe=6A185687"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74v7RfrFldAQ7kNvwG9Cl3F&_nc_oc=AdpXNusiFisfZdaFSTeC_pufMDDZs03EG5nAS4NL46S8Xb2ZKbhHxhbzVPRVnFuaRIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RMSfaYUeJmeM-I-3fNSMCnxfRAd5Ku1TJV7_Z6PPT1A&oe=6A185067"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CUQEvWPluYQ7kNvwEiBTYK&_nc_oc=AdoSiaQzq6zZHTZfimh_eYFyGZaBkiASYeJHNo5Ywy0MqoMGwBEUwq413XleGTg4adI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uIHsFfUjvsO7o9B9xbd5MVAqFcmr4HM-2T7RiRVlSQA&oe=6A186342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLytWjSEQa8Q7kNvwHkeQ2G&_nc_oc=Adq01VWRvk4rzj55IETtXLhgqX5Xay2PsNWdYsntlXz_H9_N0aHwezQWJPhz7sbPC38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NO__HPXHsOqaSXVDD2M-oAEwDOo8epoQiuomnrj1I2A&oe=6A184D85"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
J-qfiKEw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd4PfFD4a5Nb-rj2DmYhtoab2A5JzOo0C_pbc_J0sNVA&oe=69C7BFA8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RI4YK4vSC0Q7kNvwGcm16T&_nc_oc=AdpUfX6-C22wCUd4P9v6GZ8yyzQsmTHrCHRdAJSEl_o4WBekXgosD6u12N5O1JvZz4A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdMvy-0DB2zlBnhrUCpuY8twZf_2f1BM4l-0UVQlh8cQ&oe=69C7B2C7"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xTq5x9_B2kQ7kNvwEm_tZp&_nc_oc=Adr7FjDTp3Iuy9-3UHbKcSoYGNUQVxPJ5YT4w-B6n8oQzfS12H3MlVQCnRgBjaZZs8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyALTIAUO1o7vFeurj5EO4D_l6QcO1UgJlzitV6lZSJVw&oe=69C7E4E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCAwPhfYDl0Q7kNvwGwbz9X&_nc_oc=Adr8We44rHgKzs5YfnU87JItub2Pvf8vGXkg7036DRkl-VAgtOsRA6Tw-8t0czel4gQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbIXCRRCILwZcMY_Ej1cvV6jA3QWx26tOy7oDzflXeig&oe=69C7BF82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22bqLY7vtCgQ7kNvwHXDXIb&_nc_oc=AdqHTqoOv0WJXSmTLJAlYOCPKeQVnz6xNr7ZIbwugMBZCzTeviaXY5jjANFTzXeHvjA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykGOaYiC_CujGlExD4w-ebW_UwV0JvOcSxFsInS5DQGQ&oe=69C7E205"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
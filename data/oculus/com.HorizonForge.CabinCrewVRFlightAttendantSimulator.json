QCJPr8SA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTOgBbCgaQeEPTB777RMt0xj6JA6N5Q2L8nfmW21dUVQ&oe=69CA62A8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qYwUN9RcjIQ7kNvwFY4pFb&_nc_oc=AdqqwtcWlUNFptbbzfKndJSPQUmD1opp_qXRRT4hERkwsIEyr_lOzstCNE1TU3xMvvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy6WN1iS1Ifv6MgVocGpfi3FEkmPesZjkhvGQGCSwAMA&oe=69CA8E07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYuCu5tR46gQ7kNvwFq3y9Y&_nc_oc=AdrMBGLgZiZpy1GTxIj_KCV6hqbuqCuRwe54fAQQJh1POlT81tae1FbjeMdmNkAO5Is&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzfs_NpuhHQiS7h0pY3uXYAKpuHJIroY9if17du5rL20Q&oe=69CA87E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCAwPhfYDl0Q7kNvwFqsM39&_nc_oc=AdrzJsJqfJ51sTqXmYhKyaBy3JKtBnxAbprEXk1cuWll9CBfq88uI2gkiKoNrJya6qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWCbwN3UGC_O1Ix4EscD1kjAaYm3vKWHBSHHC4avV3gQ&oe=69CA6282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm_C7JbzSKYQ7kNvwGYyS5b&_nc_oc=AdobJlV143v3gM7HQiEtIU-8FNwPqbK9kGxQhDYUiDvb7UzAhu30RqIH_6vHEpAH5Dg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3WoNm3fOrKjBkJQ02T9qEs-cCjVKcrIAjNbyfGjUJVw&oe=69CA8505"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
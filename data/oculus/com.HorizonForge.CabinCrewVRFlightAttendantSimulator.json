=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxT5iceNwEIQ7kNvwGnNwQY&_nc_oc=AdorTusuK9iwCguLqn7PE6OPCaSjriE_2rS5ybba7nt-oiKcmroWq8rd05wvVJq7yjI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Uj1MyPgQOeuuJmY7LcAgBCCI7WO5nZI6aN5b-KdViQ&oe=69D791A8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve1fRWovKb4Q7kNvwH-tvia&_nc_oc=AdrXuT4xmtwJY-Qgvsi7OZx2IWYhZA47UW_Q7NwqS_msMWHYdMk6MPQvZFjFI2JVHIc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PW2_ho809QlgTGEND1-QZmqBTAhGRYC3SRA7E6MFh1Q&oe=69D7BD07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntj8yN95DbEQ7kNvwHfyZe4&_nc_oc=AdrA4bYFLKj8wHmnDJsPJVr95P1_dCm8B_PARpCKjF6jZ8OOxHg0DYULzN8RMSBs-Tw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bj4rPNOZhJ6O62kQm7AAzX9y5mCoobgsM9fgsQNOvPQ&oe=69D7B6E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MTNuKCUyV4Q7kNvwEq5ifX&_nc_oc=AdoT1SfsL7bHVzv1JGcSx-BBwbCGs1Z08JuOSQKpChMX-qTVRULn6o1Al8J7m98lQeM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wz6tM6hIV_w5YBIw36RiHoBHXrbLphQVpYzMBiIVWgg&oe=69D79182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzjBbZ0rV3gQ7kNvwFYnZOT&_nc_oc=Adqp5wx4dKjHbtkUf0LtNwaAy54kH_maFOA6g-6TNeMuy6M8w8xctuCJLlIclLOHNQw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29bUpyEwpFiMKp5S2oVBrFy-n2TCMLbvl_s3i8RvA2jw&oe=69D7B405"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
h=00_Af3Se3ppGpcQuqowH1BElAqaOii8hyRmNPOr53U709NdqA&oe=69F1EFA8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajp5aRk94HQQ7kNvwG7Iv0n&_nc_oc=Adq6h4fzprfw_Z_vDg7trCl18ChICqaHpGzDY0L1MchN7gwZtLxDtJIl1IuR_fA21aA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2j_OxGpzk0wbpmA7nFsUVcnZi560zyeDm8QSb9Wi6ALQ&oe=69F21B07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZj40dS5qVMQ7kNvwFTmckv&_nc_oc=AdpZ6waWKuApFqxpUrr1yql0ITSqcxBx_rzSTrNwfXZW3P83j2BZ4ec2jVoSNwHF08M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af191mQc_oliP2-Xur3apReC1qjdvN93Rc-dPhYIliQTAg&oe=69F214E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnHAspKP2rMQ7kNvwEn1Jzp&_nc_oc=Adp8V0OpTsWJwzxmfpog9z03zCkzdWQ70l4f2nDBF0wtfAyy0kSaxMmnhsuEVaR5uXw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0JavPH8HVO6wU9Sck2otscMCT9p6XFRE0vqZwlYF6obA&oe=69F1EF82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsYOIClnP3cQ7kNvwFsew3T&_nc_oc=Adp-_K71_wwaNhMgOgFLE-Geu8LYM4rMLnaRFSHUYHBtbTf94ygRMBHwmITK6YXRgWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0D1W9M2VLpO7RZE6wnsNgn3sJnQ8174wCUZ4_rYOXpWw&oe=69F21205"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT",
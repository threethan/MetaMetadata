=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5d50N9WeHAQ7kNvwHWdE6t&_nc_oc=AdrGOYcW2Uyw-NqQzoqu5vQ8hL9sqmoYrD4afeACVtW_kplsZw77WJSDog75_WpeK6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xhDIdU156vJWtRwXX_x5YwiV0v25aubOLKNjMSYOW8w&oe=69FB2A28"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqG4MfYc4fwQ7kNvwG01xsM&_nc_oc=AdqPMjVMjTSv4zqZB9RZ6ZJNe9vLZtl3WiY5cxul_9PEZqCNuLVp3T5cjgYCHk2uXJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qwOXcCb9-eTbORtaKNxS01RkauY8Suzklu2qRQvB7pQ&oe=69FB5587"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_cP0YkZ8MwQ7kNvwFbm6ua&_nc_oc=AdqafhcRcDKys6GMjU3cDogIbR7xs6zP234ifFTIil3OGklqoDkHcoVj-voCwOCfKpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79BbD7H8b8v08Ge_kyE0lOo0qkoyzAuay6LN2WNyI_uA&oe=69FB4F67"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AInyrz7k6NIQ7kNvwGyGd1I&_nc_oc=AdpG9tkkL_4Arp-C8Gy-ivfBAuU5kQ6Xp1uRwgYqa7g2Wrb9A8OgyTPUzffynQWNC5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J8MpVZumBWIMHv-sNSJwwA4KMipff5yOgoWy5AmJB7A&oe=69FB2A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm059yub3OAQ7kNvwEbh7WY&_nc_oc=Adqf64kLZ6-jqx4UFRb-Hoc7gTF09cAqXQwhjZm-KFlfjiiUlUPiGbaiLwnvBugQ0i8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zhYV4Mf-dJIPW5ovunriBhENnQAc_t2k2J_XZUZftOw&oe=69FB4C85"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
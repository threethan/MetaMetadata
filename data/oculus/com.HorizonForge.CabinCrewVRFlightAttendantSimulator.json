7w9Ma2cA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWJXgr-2i3viFznss1TBHAjPoMYS4qWuU7UAKKAQ3CSw&oe=69C66E28"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RI4YK4vSC0Q7kNvwFY_I6Z&_nc_oc=AdpwKbkWdlkSOv0bKgAy88QWWNGUPss44k22M1IHH2wnjA5nsfTOAYSbIv4kW_-Q1Nc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9eyr4WIlutwc2Q3BguWug3k6llbDpUjD0dw_GNyReFA&oe=69C66147"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xTq5x9_B2kQ7kNvwGrD-mT&_nc_oc=AdoqfoX8jINW0V4DchE0MQQDlMVe-YYT3e3hPqiVpbrOw9ZhquRFCBcGY57Fhodty8E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzu211JxALOb4WMIcyIuIZfle_2lky5vsq6qRJVjqvnpQ&oe=69C69367"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1AMbtx63J8Q7kNvwFmXaGD&_nc_oc=AdqyiL6v1yrVJOvzJojEdw6pMVuoVZbB5ql32UY5tI3mmf78XwjZgsjYIYjz_XZjQ0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGEr7Isqni1fk6vm9WqCzpm0PD-yhCJnxeUkteQpPn-g&oe=69C66E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22bqLY7vtCgQ7kNvwF2wCOi&_nc_oc=AdpDV2RnRM-S0_FjEnFul8UA4iTEMRgcX2QgYFtb85NPHs0606HYVsdQ3JwKwPlOn_Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdL4G4vjDflz9QYTqDZwFxdZ7MMf5QUyhTZUuBo3kctQ&oe=69C69085"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
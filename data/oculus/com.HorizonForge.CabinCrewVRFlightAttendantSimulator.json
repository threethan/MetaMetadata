AzMZsBPZ1TfIp1Kqitol0wciOluw&oe=69BE8528"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7DvUkjLfdoQ7kNvwGQeRTv&_nc_oc=AdmlCcH_yzpd7w3YY6XzR8YdcUsW6xPmLT8PH1NgJyuUh7A-_47_wXJc-2zT8tWLmHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_pG4k-EH19PhUlAxzXk3ahX7YstYiRXsJc0baj-22-g&oe=69BE7847"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWUTITONAnoQ7kNvwGzYZB_&_nc_oc=AdkxMtwKkIyz82kZsYNa5c0LaDasK2F91eaRfclilik9q0653y3rs32LxywgOlbVmAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjXr16CiCeJ2hA6m-pznCcapAJaFE_lmlfY6jYeA87Ew&oe=69BEAA67"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxitvvejyZkQ7kNvwGY5fAY&_nc_oc=AdkoFgMws93WQs6QQGhTsM2COzahTPQ0W-834umxs0qP1lsSn7Uz5MQLSkPtceInxsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlQfQy5joA9NsF72yJImSIrBPApsjzFzWRrBSVvLC3yg&oe=69BE8502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d34zaB0Q-nEQ7kNvwGZxQk4&_nc_oc=Adnl1y98yZpGfN0hgPmsk9JNMePG21JDEbwfKs1yqNSaXVVhpsoGuNah4u0Cdl1SIfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU6_qm2YFJ1JfaRKjSmObOsj20lr6nV5mFb9-KJh-BIg&oe=69BEA785"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended
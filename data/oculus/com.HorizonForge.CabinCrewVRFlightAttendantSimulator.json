=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAXD7fsyOiQQ7kNvwGgQmxP&_nc_oc=Ado-HqATxKk0DGWwEciwGcm78IummwAX3vBN4aFfoHU8_oB1fRq9Ne9HZiQnlioLIqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af348v9Q5_r7h5ZMh0SbrYHlY9LIRwtC3-9vT1b2X7Z-wA&oe=69E4C0A8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXhyseU-z4oQ7kNvwG0KCWk&_nc_oc=AdoI9dZPoxo9JWVTCGK9uOR2z_151xOCMKLMgu_J1x01PHwohxB9ULtvIJVJP2638Zg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FryCcR27xxBNe2JQgzWpzqVgMt58NdrluHpu5T0OV5Q&oe=69E4EC07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i7VFuRqh3IQ7kNvwE472ZQ&_nc_oc=Adrk4PUhiJG162dD0UxiWW1fdS6ngusAM4_ajvTI485YcmIqS54Sni7LguSUjmhA8BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SMwt8lJ8WIrTd1Bg-nXtWHGO5HFNpoyYTHNV9PLDzNQ&oe=69E4E5E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMQkeOdJW4gQ7kNvwHxwXUY&_nc_oc=AdqHgjqJVO9hynUhaIfohl-Gf173oAcuU3NYvnCFdS8wGScnnu0Vz1cWCn43fugQBGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gX7oPlB-3geB9r4yOoVjzkzNTT4pjfti-esbAR7yMLw&oe=69E4C082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDHDoFZgDiYQ7kNvwE4kEnV&_nc_oc=AdptDXjRzqm4VCNEBiOJRX8hsaO4CdMOi0OPUZDZ7gtDjXc9hdj6Sqsbgs-LtknUz5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bdod9n4VkmXoGmp4FIrd0rqNqYXaU7_rX7IvidhtKIA&oe=69E4E305"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
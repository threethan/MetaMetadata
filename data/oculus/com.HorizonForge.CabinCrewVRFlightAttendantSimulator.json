fG3nVQUu6Ezg&oe=6AFDB567"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw9CXLacHXUQ7kNvwH-CoCm&_nc_oc=AdrPct5DixQkPR2soulmy2CURbxkwrr9viqSANjFvUteeBop74pGid9ic0u9AMTfqXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPHYl4iLyDGLzxwZpvLHgIi5dXkHLt240Xt5NYmZ9Oog&oe=6AFDC842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar6jn31YvP8Q7kNvwFtCp58&_nc_oc=AdoxWJ58cTlic-00Di1q-F1oTmQHkb2K6x1t2B8rC-zDVgWfk_Nprr-lw3mKZI0v6KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1YWBu0FrI8Wxkp-psMSdH25gJlYqmr26SCxfBvj6oow&oe=6AFDB285"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9365624026868887"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1649748146778828"}, {"status": "PUBLISHED", "id": "849445991559874"}, {"status": "PUBLISHED", "id": "1703485757407048"}, {"status": "PUBLISHED", "id": "1362816126025102"}, {"status": "PUBLISHED", "id": "2528966324218494"}, {"status": "PUBLISHED", "id": "945303358525164"}, {"status": "PUBLISHED", "id": "1737336767616276"}, {"status": "PUBLISHED", "id": "1270708548065383"}, {"status": "PUBLISHED", "id": "1290292669667304"}, {"status
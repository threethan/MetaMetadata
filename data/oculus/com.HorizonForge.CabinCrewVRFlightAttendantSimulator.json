uw8GTsMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHqVPUyWBatSzt6NsPdQ8ItOP9N967J-mquzNlf9YPKg&oe=69D0FA28"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3OHlIdiiFAQ7kNvwGw-ewy&_nc_oc=Adr45nwAZ3WqACnLpnRCbjcxGy80b6aUEiOYUWHXhiiz-SrLCq1-R78laWm3oXUobfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afypj0xbiIQ9ZmbGgWfzuVtAnn6Uajg4OF92S7nwzmh9gA&oe=69D0ED47"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30LZgPFjwM0Q7kNvwF7_-6Z&_nc_oc=AdpZp5u6IgJLU4wez-nOb4sMhjvm3xu8tVmUzNgPmNWqL24wS2q-BWy4C17mVZU4sYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoK04kb823DwgMc3-Pkjb8sKZ7H4Ud3egOr-e-b4yhFQ&oe=69D11F67"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFbZFbTDnx8Q7kNvwFF0Fe1&_nc_oc=AdoZTQpWgXdYvCZiUGQ6vwHAe9Z9hdwF1KrwR-G8PjYJ3pmWP_lKQbh5G6lvPnAEgDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvWFKVkw6VMj1xINn4Oghoj0KtU5dA6i7X54ALP64cGw&oe=69D0FA02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPXZW4EjfoYQ7kNvwEXcuPX&_nc_oc=Adqo7J3IjCLl-TidIL9BzsTCrHicQq7K7oK2POl26lnueQoLLezuri_D7xkYhZDuV0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEsruK7iRWJibBmMzzHpgV_Kwp-1Qw0byuvRzziU6KFg&oe=69D11C85"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
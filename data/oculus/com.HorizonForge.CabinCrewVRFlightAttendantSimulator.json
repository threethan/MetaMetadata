t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mrT_xrH6OUQ7kNvwHsOK33&_nc_oc=AdpCTpZfKxrIFRB8BtM5ym9zat2Z8ZG2NJ_Cfed1ty0xgyw_dYuOHORxYGUaU1h3gHo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47rmxhtm-347oYfUDmzigZsXQSkW9GEDqpEN-rJLtj5Q&oe=6A0F28E8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w3nLU8YZMwQ7kNvwEetXkq&_nc_oc=AdpyFLmrLUQrykAt1OboTX7O8QDeR2sHLG7Xtm7CuvhO6vJFDfj6JV44whK4P0vMVoo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OtiPnQfzXuhn8Ai76tegX5UPmFDHLXolMlixCmSeuew&oe=6A0F1C07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sijndw52OGUQ7kNvwGZDfSb&_nc_oc=AdpyOB1CemhFMGf8RsgBRQI-4qvGnf4W7oGRNEaWhRX7zt6z_85mbtTDKOdAo-YKAXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BM4rwtbfmCOSz4MZi_x2I3IhTR5S2mzJ8eyDULEhsiw&oe=6A0F15E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGKQ_COoNEIQ7kNvwE-V2kg&_nc_oc=AdoIpIoJeimWLMDy9SM0QrfNLBs5TguCWiqDHH5IMjSb-Gt4qmKwRE9IvJ5TEP4jHuw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wXnQEyPEWre4RcC1xmhOxl4Xvm47T5Z1Z-L1nx7yswA&oe=6A0F28C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59Wj6kTavDcQ7kNvwGq7oSs&_nc_oc=Adp9pOx0uwB4O9vbbzw4NDA2oBlnYsGKpSQt0EtQwZnminL3unyQqkgjNyZaq8xHlOI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qw1UOeyV9IhLUMmVieuPKdcrvARj7yUmPict4pTyaYw&oe=6A0F1305"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
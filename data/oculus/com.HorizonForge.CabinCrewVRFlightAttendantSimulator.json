h0L9tiTQx_6cfdgrGYGv4SDqfOqg&oe=69BFD6A8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7DvUkjLfdoQ7kNvwFpIWa_&_nc_oc=Adl-6COlq9eF7uAbdF0OEI33rK866nmduemJovkBfiLl7unxBG4OmPUKGAO5AE1jX5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPcceZm0SU8ulAkiK78Z4K3PzMk5kO9Rn9DiLiWgHWrQ&oe=69BFC9C7"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWUTITONAnoQ7kNvwEuEE5v&_nc_oc=AdmWEsg2lu09cbzZRBd1XzW-2Tl0dbQiJ6BoxoI1UDVeSRDLp7-gZMQTsEBm8Qdns1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDzvotIulnb-LLTwW98JCup2Hq3ndw2JuAiDF-qCDZ6w&oe=69BFFBE7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwo3TDBFcmsQ7kNvwGf_N6r&_nc_oc=Adma6gu42C84GnGAmvoZN-LEDvQoAgIZenu8UsLYt2I-7-5fmILp3H98TLmj5ONOGsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj1E_XF3dswhVifrohnQKX60ouvW2eHfnALkfBNS3TfA&oe=69BFD682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d34zaB0Q-nEQ7kNvwEHAWBi&_nc_oc=Adlr0ue6uyCBoQiNXieVLJ9G3sK7-ICv90Yhhqzad1ewHc19rAgKNtQvU_yHXfbYktI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYzdOFfhscB4twLz6ybxKToIaZHCgitNk1FkZK8zApLw&oe=69BFF905"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended
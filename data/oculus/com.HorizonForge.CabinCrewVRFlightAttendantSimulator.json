2356", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n18PhB90kvwQ7kNvwFvdXHY&_nc_oc=AdpN6BZ6Q5oJDAA-aJAnQk51c2shmyDr8vLJnZOa-COjc-nXApCJOMNeyTiYNKTUwUA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLk9QIRZPQXnYT8l2lMd8-J5S04Dh0C--7J2GHp-eCAg&oe=6A8D8082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnai.png", "id": "2288583145005001", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/585727769_2288583151671667_1397483590554063970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cn2CCfQxWYQ7kNvwGgDmMn&_nc_oc=AdoZlHNM4vQXVmIYdNIRoWM9Lc78arU-lxoFRRbBZN6_QFIQLjoWAdGoFvip8lcsFZw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGws1Qamj5NQ7aNpFcXIu1ikSzSeeFCnr-0U_-wiLz9A&oe=6A8D7311"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "- Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n{2465080483859860}\n\n- You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n- Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\n- Your duties go far beyond serving drinks and snacks. \n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\n\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26628998693438152"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823949_2461617847643190_1061507558082488087_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVNZNsvy65wQ7kNvwFwZLiL&_nc_oc=Adoalu9pfNy9nmPYGSzA7yYdSRZQ5rRm_ORFIiYuEXcW0NFACxVYkJWvIwxhzdroliQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm9Gs4HmyThv57q7E1eliWrGD1BcNy-4Dzwlt9q_o8iw&oe=6A8D8631"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1750241580, "lastRevision": {"nodes": [{"id": "9365624040202219", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "936562401
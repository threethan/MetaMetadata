nc_sid=6e7a0a&_nc_ohc=h2rmECu5c94Q7kNvwG-qCB6&_nc_oc=AdoFRFFQy5TYyHG9S5rndkm9q_Zvl7_8Zvd2WX7zoyXutgisD_Chx53PExKegyOx9DM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c5bH9AVTzEinpBPbcfJbYG8Akq6TQ_u_MXlGd4oipAQ&oe=6A1EFAE8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utD4JiM2PjkQ7kNvwFhFTMb&_nc_oc=Adohb12xL59cqyoyqJ7_rDKp5eaQ5jrGZQft042kWOYwtzrfD1I414s3CCDCceOmXXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rMzI8hmA1TaOnc3h2riP7pO7cYD9c2xe3nvzfvNxT4g&oe=6A1EEE07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg8tWORKHPkQ7kNvwGc2kuJ&_nc_oc=Adp7d3yaj1cpQdtRkwq1xHrkdo4PAXWrd0EAmwImUUTFm-oGGUH-go_3e36Yo1si9QY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HNEJn40xh74W4DfLcRU2DoN-IRiGXUPtUop3Aa1CqEg&oe=6A1EE7E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFtRb_uD7kkQ7kNvwF2abUu&_nc_oc=AdrwcSqJpWmgQMbjkybbOEyJAENAZFPBCksXyOIFvxJO9vEul6zwZogYHgUszgO1aq8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hPXnCHeoMskJS7QiXOoPU2_je74qHfkoVAx3yZJEJRw&oe=6A1EFAC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG5B8ikOE6AQ7kNvwGfqE4N&_nc_oc=AdqCjAefg2MGs-e79QE0xbBArBQPnvD72dyP0fzXBPLamgmzE0A4XuYiYngnOr9rzpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hJtxGpsuw8YpJa124gvhrkipWFfgTeow5wGyKbeiHEA&oe=6A1EE505"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
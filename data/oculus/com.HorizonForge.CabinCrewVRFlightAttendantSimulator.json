nc_sid=6e7a0a&_nc_ohc=lmiu1J5IcToQ7kNvwHsGLvE&_nc_oc=Adq-PvWwcbQB2KOgrMrgwTtSU5wneclRZoSZxa3CkpXs3Rkgsn-NX4Twh8XsEPZKuhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XqBgXMr1J1Yi5iPNsbQkmFovvBXwTUY1Lz9kyBZPkoQ&oe=6A204C68"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qZKmoET8zwQ7kNvwGvBaun&_nc_oc=AdpUMlGrTwwd6aiVj_LAotkrBtCxmJ8X2LbaSZyj-2Yhowv3-LC80PNN0oDEIUUtNaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TxqU6zyw3mNQ-LdtHR0M5FdRpqAA-BMIJ94ywTriCaQ&oe=6A203F87"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg8tWORKHPkQ7kNvwGPQNIt&_nc_oc=AdrKwy2okT0FB3hDp0r_BDTg92wPgecj1L8LgjKzMftS9KoWDPZ8D-KEiZvqxL9zm0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ll_yR51IcwoL0m5jrc2I-JqeGj-nF2T85epqvO7U0Hg&oe=6A203967"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFtRb_uD7kkQ7kNvwGGlhjz&_nc_oc=AdpKqV0zoOx1rMsE0t3wVFNOD82w_9_kYYx7Owi0HBOJ9YZiSwrIF83MVI-MSFCM9As&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mdtUnVUtjHZ4_xSAtTg1o2alp33xwNLcVn-tHWMd0XQ&oe=6A204C42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG5B8ikOE6AQ7kNvwFAcCUV&_nc_oc=Adrcg2Hys5rys6cYuKuSQh7g9UkKTRkm-2bL7TtX-ksPQ1Uvta9N0aeAdMRuU-ylFZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OSXMvvgodLwQfO5zpho972fgtQLJ1YW8gbtuYHw8hmA&oe=6A203685"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
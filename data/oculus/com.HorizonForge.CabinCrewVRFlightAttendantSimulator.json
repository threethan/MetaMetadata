u2vSW85M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYD8OZPJc07AF5AaUhMAMVmxeh8IpXoh2TihnnAW0sMg&oe=69C51CA8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RI4YK4vSC0Q7kNvwHpvtHt&_nc_oc=AdoxH4d7HXRPywJfnFVy2n-M9yrI0lmEnqG3nJ6iZ_8JgXXOc7nrjLnd2UhE_Uu-5Bc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtxqC2DdjJoTPj6iQaSyQksxqDKXvTug5yGWPlrq_3AQ&oe=69C50FC7"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oz-qPLGlYeAQ7kNvwHdG8CT&_nc_oc=AdoGe7q_YJ4akK51O9UugJ5nmez43CIvu4MPgmCXMhTX0Sw69smjqJ04Do_l7cFECy0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr99Mrg8FNU5Kk3YmLCUf7PSPEuoXy8vLBGqYLSHG9XA&oe=69C541E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1AMbtx63J8Q7kNvwGheaXb&_nc_oc=AdoogI5cJoYnO7lXQzQgFB3V-twZtchVN1gZq6J4SdWEx0U5APSUVKeWxM1Wzid0OFI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2rd7Ah0e93vV7a5fO15Sg5VjHlS-8NAOZl-Km6DFUww&oe=69C51C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ekw1NRSA1xkQ7kNvwFxJ2H5&_nc_oc=Adq0W0SXuY3vh2k1Zwm3smDCMy3qKIyZMc0K9nNJqzvscjYppEkrrD_d8wajZnUjOEk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIsexZcr891s115VR-REwnEzWyB-NhZjbuGSWhXmUyrw&oe=69C53F05"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eGpZ6nfwMwQ7kNvwGB1F24&_nc_oc=Adpk_WuqriGaMd1aJouWfunKq_0uT6KPPMl-_kLMbNCrBzp-bM2KkohqGO_DeXNtRBw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af149kRBb6Nhi-8JOjSfIAj9ck8TgYXAvZt7uSaoc6dnvA&oe=69F492A8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B7LKNTZHBQQ7kNvwEhrABY&_nc_oc=Adqv6OjnpuW_EIhmqmyC7j6gamfBl10UoF14iPrXGWxUgfI1emkobO4kDvIkv95Nr2g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aihSlfAJlHebQMzcUUFp01PcGeuwGcXYWgtU25MTKEA&oe=69F4BE07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZj40dS5qVMQ7kNvwEVNqAL&_nc_oc=Adrdhwhql1TZ08wO6sGGRKZero15b_KqvzJDLyr_vO9rzgxlCtubF8zCZ3GFPnxwNZk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OfDwDcEVTufAM9LQ2c6XYyHr8EgZWtFSkELuIbq4GeA&oe=69F4B7E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oeu6s8yltMoQ7kNvwFgI9yp&_nc_oc=AdqchgV0JaVprD05TfK04a2dtAkxFpc8UvNX71kuKSGRHVUupcYpmRQmJiN64uEa8s0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yEcKaxsFbi88lf2zH3LCubXsBdoPuc946rZXhFJtQ7g&oe=69F49282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsYOIClnP3cQ7kNvwH2w32K&_nc_oc=AdpRcDELibBVSxDu-7Hh0EhMmkSXn-MXakRDDjV7WLlNITIEuawcMrmsEUMjFAUe3Ss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3F8Fw5rsXCrjrzTWl_G45HxVwVBKhVjBj71vhfvEyFsw&oe=69F4B505"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
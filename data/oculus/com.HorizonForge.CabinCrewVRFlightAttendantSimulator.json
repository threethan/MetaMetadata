7&_nc_sid=6e7a0a&_nc_ohc=iq2svn-lt08Q7kNvwGVMHGl&_nc_oc=Adp6o1j6p5ubXutbIaxE53jXIdbaIXL4tIyLe-Jj4DKBW8oUifVJtRetix9_lXOMNYs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNUibs3C4Bm6AmpTEghS-aaxo-SVDeeTfBfWdx3MOoEg&oe=6A805182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnai.png", "id": "2288583145005001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/585727769_2288583151671667_1397483590554063970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwAbCjeEJl8Q7kNvwGlySR-&_nc_oc=AdpXhbv76erQ-yLGJ-f9eBQJzi3cCpj3f73Tj_56xqtw5TfFn-w3moF63DvDzNTkn3o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNZxI9Y4v_wRzXTW1OKHAumSODnR7VCuUlHZWDZcOZaw&oe=6A804411"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "- Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n{2465080483859860}\n\n- You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n- Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\n- Your duties go far beyond serving drinks and snacks. \n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\n\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_pol
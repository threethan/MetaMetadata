nc_sid=6e7a0a&_nc_ohc=dJFhE-imbksQ7kNvwEjcbEf&_nc_oc=AdpFlAgpUfpi1RdrAjtEibAgYIHbmX_m1T3-7wTHe4-W3GrDkcRtqY8Cva2Uso0UxDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DcEE_DPspaiG1QNp_zH9wBxuGGBx0oWPiQdT4N5DAxw&oe=6A259268"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6b0q_8qT60Q7kNvwF9Q0FE&_nc_oc=Adpqc3sM9Spi1my_Nn8rXbGGZg2Bn76ng7nn-EnbF2vxG-2qNsaOMiLQcseGijcOOW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zkInzBX4Ut_Tct_alDcN-BtdpPxWmuBY1y84fKmKE5w&oe=6A258587"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI-_H4poh8IQ7kNvwGfC87V&_nc_oc=AdoHJTUNQaubsrZ8ZXQcDqdv1QQ5NAzJ4iLVmCuQYQRcLRSQyyCeTtWUUjOogftYgFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zt5Q6Mg6cZKBZk5w_g5HBeTPTd_PR3vPWN0tM1EF3PQ&oe=6A257F67"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_OneDaaQfMQ7kNvwELeNX8&_nc_oc=AdrHiYduAX5Oq7maG2RvtFzIIdxgY5J60ZR-_d6H62gk2591dwBrVGqle4SYzQVzdnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vvGPhR9UaiMiAtjm8OsXHruKE1V1kkpx9HpAsoh9S5w&oe=6A259242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRuxWC2FLGMQ7kNvwHOJ_Af&_nc_oc=AdpCYCg99syAHKDrSiBkmIACJO3FTYxb8nmcxlV3PV8VC-A41Tu81fQ0txY6GMHnzUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fG_MflJ7lWkMZH2_ETSVfZHN41Y-YMSvTp2Hq6a08lQ&oe=6A257C85"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
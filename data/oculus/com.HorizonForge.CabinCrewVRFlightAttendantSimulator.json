rgK6xog8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22smb_z9Z1Fx0B18u89_gyzIxdYZZPudeBpIi7qkN5JA&oe=69D4EEA8"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve1fRWovKb4Q7kNvwGNEHwm&_nc_oc=Adrk40ZQ9VnusFbNeUuNJUOCMjqr5xVqQ3ERPbOEVYNfmaMw-qheWLoSO-wZwoUrLnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33fOZUXu57QK7UWfQfSTZdTs_DZq4AC7RCxfxcSxILLQ&oe=69D51A07"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eK8vwPtRiwQ7kNvwEBgbV-&_nc_oc=AdootGXG2hX4y9c3UViDlUSq2j3QeUf-8_cnRTUNwqHbvaURkr8oWp-hhtrAQ0vXWxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0asvo9RSuUcVgCNGRn5WxUkPuIlGCZkefhylZDLrL0rQ&oe=69D513E7"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBDdIukclwkQ7kNvwESEiIr&_nc_oc=AdplUiAeMIOzZVvnERAeQJhD_kCTc3wBGBoSaOHIvC9LwAkXRnKtMkgnoAPjPqh1qWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eJuW4KzlpnFxHEnwyAPAt5N4VwvsP8Qg0LYhZKELhag&oe=69D4EE82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzfjTRLpJt8Q7kNvwHohIUr&_nc_oc=Ado5EW0g0_ll58u5eXLKOFWLVDmAvHzielLAghWtZCtfcq8JIrbEfRprAEb03Gi7Iwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OJvONpKeUaiGiMlu_mhQwPVUp0j1j5gl4XQ7qNnCnfQ&oe=69D51105"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
CD0582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm_C7JbzSKYQ7kNvwE6y-bb&_nc_oc=AdolvS3Q_iZOQ38pFOTjAYCvOD34AebX8mzIzfv8-3xhXmmWOPaF7BbAagaKwnWXGEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQi7ytCaw5cO68fTtkLKqFB2R36z_tY6NeY_sujXW6pQ&oe=69CD2805"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "- Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n{2465080483859860}\n\n- You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n- Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\n- Your duties go far beyond serving drinks and snacks. \n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\n\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTA
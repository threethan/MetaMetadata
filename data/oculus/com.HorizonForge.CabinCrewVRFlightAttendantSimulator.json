YIN2mn_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y6zCSpA5SMzxEmzHpKQU4G2PMHDRMYVOzRUtb884OGQ&oe=69D39D28"}, {"file_name": "scrnshts 2.png", "id": "1267198861505337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618095_1267198864838670_4944188563308089434_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3OHlIdiiFAQ7kNvwE-Xm-Z&_nc_oc=AdrcJGxdDgKRb6XGVm4Ov9pZ8jhdMJAa41mw9UOcgwY0pf-6VjmrLeJGXOehzauwHns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oOuCB8DqaBh90SzidbAC0hbP11rYscSiHp9Qg75CM8Q&oe=69D39047"}, {"file_name": "scrnshts 1.png", "id": "1028223326179391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_1028223332846057_4400327930561230754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eK8vwPtRiwQ7kNvwHEt2EV&_nc_oc=AdqYjpWnbTAK91MigSoRgfsceNrx1Hcp5mcqhKgIcfmTJJmCUcSqCEEXgYIuDzqcMOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KZNMy_hV43PmylOms71faUDALOIyw0PMGOLeTmntuPQ&oe=69D3C267"}, {"file_name": "scrnshts 5.png", "id": "2445746839122356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBDdIukclwkQ7kNvwEbEzGI&_nc_oc=AdrpJH0HvvJBkjZ6aJBxbJqFr9odYXPmkVfzqIbDMJ4LVqgr_KQ1HXmxtnRf_LAMBFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WdmZ9T9fvAXujNK3_drtjZOjpeuVObp9jqUofupeJbQ&oe=69D39D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cabinCrew_2560.png", "id": "978684614174294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618299_978684620840960_4546904203080298951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzfjTRLpJt8Q7kNvwFOfHEs&_nc_oc=AdrpqicD7upPGCNBVZvXlZJCWsw8Ka2NUyiwPdKjrcEN7VJBFY6-27HMouyjNcUTdKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LsZB8IrjSL2oTVeF1rr0ao2zH67sU09NlFZw7OJoq0Q&oe=69D3BF85"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "Cabin Crew VR: Flight Attendant Simulator, where you'll experience the demanding and rewarding life of a flight attendant like never before! \n> Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n> Your duties go far beyond serving drinks and snacks. \n\n> You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n>Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\nEach flight presents unique scenarios that test your multitasking abilities, decision-making skills, and grace under pressure. Compete with flight attendants worldwide on global leaderboards.\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/CabinCrewVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genr
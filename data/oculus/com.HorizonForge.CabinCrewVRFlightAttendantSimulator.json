 "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_2445746842455689_5181447008509339268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8C0vmo1D5AQ7kNvwH3Wn1W&_nc_oc=AdqMQK6KyweAIvurFkmD9sj6mp06FMJXFy6LS4m3uL3EqUeI7sUADk23Ab9NTF2UoXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsFCAjfoQmgEoosP4YWuyBmHsAlhwUmv39dDCIty_NzA&oe=6AEDF642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnai.png", "id": "2288583145005001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585727769_2288583151671667_1397483590554063970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns1oDNLQkLAQ7kNvwF_wAyD&_nc_oc=AdrPEshMPMaPUXeSVkhmcuXtMLg3OWkPM6YWXhImaU4qLQqTQyblZqMSvaBWgGPwZoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgGiDrsGEQ4WXqtoJp3oYHZ4IpY7mboSyqAMUypv8ENw&oe=6AEDE8D1"}, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "keywords": ["Simulation", "Cabin", "Crew", "Flight", "Attendant"], "long_description": "- Start your aviation career with the SPRITE (Airbus A220) and work your way up to unlock the prestigious METLA and massive SKYLINE (Airbus A380) aircraft through achievements and exceptional service.\n\n{2465080483859860}\n\n- You'll organize essential safety equipment including fire extinguishers and medical kits, ensuring everything is perfectly positioned for passenger safety. \n\n- Take meal orders from diverse passengers, help locate lost belongings, and provide comfort during turbulent flights. But be prepared for the unexpected \u2013 from medical emergencies and severe weather to the occasional snake on a plane!\n\n- Your duties go far beyond serving drinks and snacks. \n\nYour professional announcements and calm demeanour during crises will determine your success rating and passenger satisfaction.\n\n", "short_description": "You take on the role of a flight attendant! Manage passengers, handle emergencies, manage items and complete the task. From normal food service to unexpected crises, each trip presents fresh obstacles in the air."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26628998693438152"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_2461617847643190_1061507558082488087_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlLZ3zwitB4Q7kNvwFeJK36&_nc_oc=Adoe5o9EtmB8FBFgfq8Q7h2YaGGqFOwB5JGSmjl29lSzLy_vlFKn35BjZA-ZCTMNu3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKoscR3EKAiBuM3UGakeZjXBoGeNbptadNyUJAnj3UHw&oe=6AEDFBF1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cabin Crew VR-Flight Attendant Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1750241580, "lastRevision": {"nodes": [{"id": "9365624040202219", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9365624010202222", "is_fir
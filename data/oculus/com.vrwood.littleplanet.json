cXVkYFVP1GgEeESCy1vwnpupHgc7hoF2NjBKf0gXhF7HC3hrbtoj4_mvrAs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrhkj2xce5XZcU65Pddq7WK24qgLD2U_PMivesXfpO3g&oe=69CBAC23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "567635975249006", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003243_567635978582339_385010080011966976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJeDBvzYqRMQ7kNvwFrRuow&_nc_oc=AdoHrDVBvai9tEiZpWiTtv04L0WAaAdvF8a9pS29ujxFJpiPeAf-SakO-AlpThqpjEI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztaqZMiAwEq4CtN4Ss7bQ04juUOBFWUIMugzRqmIPuwQ&oe=69CBDD92"}, "display_name": "Little Planet: Escape to a new life", "keywords": [], "long_description": "Welcome to Little Planet! With the roar of the spaceship, you landed at a lovely planet\u2014\u2014\nYou can escape into a fantasy, ever-growing and a whole new life. Explore and decorate your own little planet, which is full of  excitement, fun items, creatures, and scenery. \n\nMissions? Rather some reminders:\n- The backpack fills up quickly? You need to learn to manage your inventory strategically.\n- Complete terrain editing independently, making a maze is also a great choice!\n- Find a way to get gifts floating in the air.\n- Pay off your debts! Otherwise, you will be sent back to Earth! (Just kidding :) )\n- Fishing? Try to master casting the rod first.\n- Build your beautiful garden from scratch!\n- Look for scattered easter eggs.\n- Never drop items by the sea or else...\n- Make a room that is more aesthetic than the sample room.\n- Be kind to everyone, whether it's a player or an NPC (No animal cruelty!)\netc...\n \nNot available here: hustle and bustle,tedious, academic pressure, tests, cat's paw, endless competition. \nIt's your show time to demonstrate your extraordinary wisdom, aesthetics planning ability, strategic thinking and a beautiful mind looking forward to a better life.", "short_description": "Little Planet lets you escape into a fantasy, ever-growing and a whole new life. You can explore and decorate your own little planet, which is full of  excitement, fun items, creatures, and scenery. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littleplanet.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRWOOD virtual reality technology", "support_website_url": null, "website_url": "https://www.littleplanet.world/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "743332207302685"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1130417665907546"}, {"status": "PUBLISHED", "id": "1289923039167176"}, {"status": "PUBLISHED", "id": "690232957113594"}, {"status": "PUBLISHED", "id": "1176533287085003"}, {"status": "PUBLISHED", "id": "1152864422948630"}, {"status": "PUBLISHED", "id": "1259052215139483"}, {"status": "PENDING", "id": "617060860383421"}, {"status": "PUBLISHED", "id": "1601496193611048"}, {"status": "PENDING", "id": "2019749208382709"}]}, "baseline_offer": {"id": "1130417665907546"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761843600, "status": "PUBLISHED", "id": "1130417665907546"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary
0_AfsjZJXHli9wrfSzhurSqRnzzGsfGXhmdumLHWKm1O2v5A&oe=69A44BA5"}, {"file_name": "4.png", "id": "977806527680306", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974792_977806531013639_8884712140261493557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN-GLNx5M04Q7kNvwHMME57&_nc_oc=AdnqrUM-XldDH97RfEXYXFLyfv-I7U_IGMkPhq8WfYzS_MyLpJP08B0Ri9ML76ypTk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftvai_CM_U6wgTAwg4vfzD8s3t4kG63-L96YiNwK0pgPA&oe=69A42555"}, {"file_name": "5.png", "id": "383156268105431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982471_383156271438764_4500580467750980333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=167smkUhM4AQ7kNvwEjXUXw&_nc_oc=Adl0aqtC6FhEu845KNG1uugT2C3JyZoHmWBvSeKTmdhGpbbFWzHbBXKPO6CZBl6vR6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfshdR9RZEz_I5jKjF-y3aPgUAzqRVRf0YsglNqQNwSmOw&oe=69A43C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Probending Arena Landscape.png", "id": "473143148416069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75608439_473143151749402_2787368791221139257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ifk5uzRWIJYQ7kNvwGvx2t_&_nc_oc=AdkYrMhiFggkJ0gnbhd4ezGslZHNaN3qvSkn2CY5uk4VEAoYE_j0XEpSFTF9QlhBuHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsyD5gQgUiR9dbpyIJuDdr5wmePpSyD1dEZ6jzAOSB5CA&oe=69A45210"}, "display_name": "Probending Arena", "keywords": [], "long_description": "Probending Arena is the ultimate VR Player Versus Player experience. You strike poses to unleash different attacks, a fighting experience like no other.\n\nChoose between four elements, each with their own unique play style:\n    Water - Defensive and well rounded overall.\n    Earth - Grounded and heavy hitting in it's attacks.\n    Fire - Fast paced and slick movements.\n    Air - Light on your feet, dodging attacks and striking when ready.\n\nFight with other people and aim to be the best!\n\nOn the roadmap:\n    - 2v2 and 3v3 matches\n    - Character customization\n    - Leaderboards\n\n", "short_description": "Elemental Martial Art Fights"}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/ProbendingArena/", "developer_terms_of_service_url": null, "publisher_name": "Desmond D Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/ProbendingArena/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7629126017155683"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8949541465114125", "version": "51"}, "id": "1027670875695099", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7629126013822350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8949541465114125"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1027670875695099"}]}, "change_log": null, "created_date": 1735692856, "id": "8949541465114125", "version": "51", "version_code": 51, "release_status": "RELEASED", "stat
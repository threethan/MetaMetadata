0_AfvuzfUqq09fXmqLnHtA70kyASAWLAQfXruX5kQI2iZcww&oe=699F05A5"}, {"file_name": "4.png", "id": "977806527680306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_977806531013639_8884712140261493557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XplNI56IYiEQ7kNvwE_zX5r&_nc_oc=AdmFDcO30Kt24hFSr3hGMZbvKfYLQMz8KkvWigURV9lH4kX46vy1-gzbQskvsLb-6uM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQen9g9e0i3AJt802BTWFK29me0YYQkqk7YempEY0hNg&oe=699EDF55"}, {"file_name": "5.png", "id": "383156268105431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_383156271438764_4500580467750980333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbcRSUn0uVkQ7kNvwHlu0sj&_nc_oc=AdkgTG6n86GJnEv7paLP6iSodMnZHbxxG3msWmCf4FS7_vpsqzme3v4U1qXlNxY08Y0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsF2aCV6x2GwZJvChM48UDmgWFf2V-z4di6DzzlB2rHCw&oe=699EF66B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Probending Arena Landscape.png", "id": "473143148416069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75608439_473143151749402_2787368791221139257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwxQc-CxA1oQ7kNvwFKkO6J&_nc_oc=AdlLKp7zSOgZKLofQmJi2bCsXYYDvz0CUqQdSEW34jVJuT-Dflgdxn2gc87Ld2KQYYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfutjshurWlRkvRtC93p0j4zLxb6C_gi-3mH26TtJlf1Qg&oe=699ED3D0"}, "display_name": "Probending Arena", "keywords": [], "long_description": "Probending Arena is the ultimate VR Player Versus Player experience. You strike poses to unleash different attacks, a fighting experience like no other.\n\nChoose between four elements, each with their own unique play style:\n    Water - Defensive and well rounded overall.\n    Earth - Grounded and heavy hitting in it's attacks.\n    Fire - Fast paced and slick movements.\n    Air - Light on your feet, dodging attacks and striking when ready.\n\nFight with other people and aim to be the best!\n\nOn the roadmap:\n    - 2v2 and 3v3 matches\n    - Character customization\n    - Leaderboards\n\n", "short_description": "Elemental Martial Art Fights"}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/ProbendingArena/", "developer_terms_of_service_url": null, "publisher_name": "Desmond D Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/ProbendingArena/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7629126017155683"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1289151179073230"}, {"status": "PUBLISHED", "id": "1335705304504237"}, {"status": "PUBLISHED", "id": "1941624369682042"}, {"status": "PUBLISHED", "id": "757378283266508"}]}, "baseline_offer": {"id": "1289151179073230"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739246220, "status": "PUBLISHED", "id": "1289151179073230"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8949541465114125", "version": "51"}, "id": "1027670875695099", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7629126013822350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary"
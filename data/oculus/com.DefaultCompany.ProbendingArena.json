0_AfsDUDo_0WlxPwViGxvgDq3VacEAcUPS63NizE7GgEpfyg&oe=6999BFA5"}, {"file_name": "4.png", "id": "977806527680306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974792_977806531013639_8884712140261493557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOj8ATd9XfcQ7kNvwFK4m1v&_nc_oc=Adng5CB3dxhi_VFARWIadEszC_kkuXuyMEnqe10xjw-N2uLFd3JEPWChqLE-57ojRAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCc_SkEDYkQwa_QyZ-UY5P198j_tXVtmWgcH-_aMOUrg&oe=69999955"}, {"file_name": "5.png", "id": "383156268105431", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_383156271438764_4500580467750980333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CMvhHxY5JAQ7kNvwG7oB8O&_nc_oc=AdlhxLpuEOUB05Ub9a1XdYNO8K56xfPdrUIOHvGLtYTQ-FvAq_2bs-3t1obZZUNiWEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_Gf6xT-YRa7wzcPRtHUKGAS517A2S203bY9n0zlNOGg&oe=6999B06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Probending Arena Landscape.png", "id": "473143148416069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75608439_473143151749402_2787368791221139257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeIEdThnn1oQ7kNvwEH0DMb&_nc_oc=AdmwypMymuIIvFF0WK0jDWIagcmVzLqJIvYBqh01kvRhMlfxEpG1XZk-g07anhSxBDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpRzLKbj_AIObKPZYld0LgCQJaYEgGF4B3NQbZg8KvtA&oe=69998DD0"}, "display_name": "Probending Arena", "keywords": [], "long_description": "Probending Arena is the ultimate VR Player Versus Player experience. You strike poses to unleash different attacks, a fighting experience like no other.\n\nChoose between four elements, each with their own unique play style:\n    Water - Defensive and well rounded overall.\n    Earth - Grounded and heavy hitting in it's attacks.\n    Fire - Fast paced and slick movements.\n    Air - Light on your feet, dodging attacks and striking when ready.\n\nFight with other people and aim to be the best!\n\nOn the roadmap:\n    - 2v2 and 3v3 matches\n    - Character customization\n    - Leaderboards\n\n", "short_description": "Elemental Martial Art Fights"}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/ProbendingArena/", "developer_terms_of_service_url": null, "publisher_name": "Desmond D Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/ProbendingArena/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7629126017155683"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1289151179073230"}, {"status": "PUBLISHED", "id": "1335705304504237"}, {"status": "PUBLISHED", "id": "1941624369682042"}, {"status": "PUBLISHED", "id": "757378283266508"}]}, "baseline_offer": {"id": "1289151179073230"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739246220, "status": "PUBLISHED", "id": "1289151179073230"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8949541465114125", "version": "51"}, "id": "1027670875695099", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7629126013822350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary"
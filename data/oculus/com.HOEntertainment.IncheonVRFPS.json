329953075200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XpYFwen7wkQ7kNvwECUL8W&_nc_oc=AdkMjHCfalGXRrSUUanwUH045tPJ-rT33gV6LX6u04XN3wrntJHj2NsKu9NSRV7yPN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsMKsNPy2iAfF5lSeW7lpM7xoeuM7Z8FNOcfxyQShpTlQ&oe=699AF99A"}, "display_name": "Operation Chromite 1950", "keywords": ["War", "FPS", "VR", "Incheon", "Game"], "long_description": "his mobile VR FPS game is based on Battle of Incheon- code named Opertion Chromite- which marked a watershed in the Korean War. The player may assume the role of two playable characters- a U.S Marine or an R.O.K KLO.\nOperation Chromite 1950 has 3 missions and 6 stages, comprised of Pal-mido infiltration, Wol-mido landing operation and Wol-mido bridgehead defense, which the player may complete by using the two main characters. R.O.K KLO's sergeant Kim for Pal-mido infiltration, and for Wol-mido landing operation and Wol-mido bridgehead defense, U.S Marine's PFC white.", "short_description": "This mobile VR FPS game is based on Battle of Incheon- code named Opertion Chromite- which marked a watershed in the Korean War. The player may assume the role of two playable characters- a U.S Marine or an R.O.K KLO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://hoenter.com/", "developer_terms_of_service_url": "http://hoenter.com/", "publisher_name": "HO Entertainment", "support_website_url": null, "website_url": "http://hoenter.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EDUCATIONAL", "FIGHTING", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tra
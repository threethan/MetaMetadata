do landing operation and Wol-mido bridgehead defense, which the player may complete by using the two main characters. R.O.K KLO's sergeant Kim for Pal-mido infiltration, and for Wol-mido landing operation and Wol-mido bridgehead defense, U.S Marine's PFC white.", "short_description": "This mobile VR FPS game is based on Battle of Incheon- code named Opertion Chromite- which marked a watershed in the Korean War. The player may assume the role of two playable characters- a U.S Marine or an R.O.K KLO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://hoenter.com/", "developer_terms_of_service_url": "http://hoenter.com/", "publisher_name": "HO Entertainment", "support_website_url": null, "website_url": "http://hoenter.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1080977886078472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_110920502921999_2980194011882455040_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhW1mpd6KXAQ7kNvwHiJj6T&_nc_oc=Adpp1_V4ybOw58c8aWqyvPAe853XnbUfbnZs0A7_hz145i-3UH944bXI1v1K-yYXtmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af14oU8AiD6rGUL0GievBshQ3D3HlNzHYxyVB_8NvfFyUQ&oe=69F1E9DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Operation Chromite 1950", "platform": "ANDROID", "context_category": null, "context_topics": [], "releas
luscdn.com&_nc_ss=7f20f&oh=00_AQIUS1zKOASFYySXux1nHFG7D7uF1OOtCmwLPYXaG-CzVw&oe=6AA949B0"}, {"file_name": "Screenshot-3-2560x1440.png", "id": "602174537468582", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001663_602174544135248_5865464325635770496_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm9pMXmEx2EQ7kNvwF7EM7F&_nc_oc=AdqPU0gYWgw4C75XVK7NtiJgxQ1sBS_WQtj_xvWk09cP-FFpFxHqMW4-eEF_Tuw3oi8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZeSqWgGk4HiGOMdU3BCG4zA-XyQb8pG2qJUZDmOBGaw&oe=6AA93ED7"}, {"file_name": "Screenshot-4-2560x1440.png", "id": "4340169082764956", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031384_4340169086098289_2544863504009270391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyXDN3fmuYgQ7kNvwH9oi0L&_nc_oc=AdqRp8LkFUSZZjjyjOOWAcQzH7H5jLbigsil8flGf5XxyfL52CXKOGW2HnKaKwPEYsg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYP3uzVBulNbt5wWKoI86Yqz0wfg1Z_fKR7Q_xNYpPdg&oe=6AA961F0"}, {"file_name": "Screenshot-5-2560x1440.png", "id": "552648675990485", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031524_552648679323818_403128391474068333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtnhPbE8ex8Q7kNvwHiKP_h&_nc_oc=Adrc6xXUTtKihBXZtJPlh-LtdHZ6MzIlwivlkAvCrhOg6UR58P7azoe6Y26ImKsB1s4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINv-S7yGbMFyaM_hiqN2q4nEIXE2DS_dfmpoDTfQN1mw&oe=6AA947D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRdirect", "keywords": [], "long_description": "Exploring Virtual Reality is now as easy as never before. The VRdirect app works like a browser for VR experiences: get direct access to your favourite experiences and create your own personalised VR app!\n\n\u2022 Open VR experiences with the VRdirect app by entering a keyword or project code (Demos: \u201cxxxxxx\u201d or \"yyyyyy\").\n\n\u2022 Once you have downloaded the VR experience, you can watch it over and over again, even when you are offline. You never need to enter the code again.\n\n\u2022 Create your personal library of VR projects by downloading several VR experiences.\n\n\u2022 Easily share your VR experiences with friends, colleagues and customers using the project code.\n\n\u2022 And of course, the VRdirect app is free!\n\nThe VRdirect platform is the easiest way to create and distribute stunning VR experiences \u2013 no programming skills needed! For more information about the VRdirect platform, visit www.vrdirect.com", "short_description": "The VRdirect App lets you explore and enjoy a wide range of amazing Virtual Reality experiences created with VRdirect. Create and publish your own Virtual Reality projects with VRdirect."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdirect.com/vrdirect-app-privacy-policy", "developer_terms_of_service_url": "https://www.vrdirect.com/vrdirect-app-terms-of-use", "publisher_name": "VRdirect GmbH", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "889743538359874"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename":
siest way to create and distribute stunning VR experiences \u2013 no programming skills needed! For more information about the VRdirect platform, visit www.vrdirect.com", "short_description": "The VRdirect App lets you explore and enjoy a wide range of amazing Virtual Reality experiences created with VRdirect. Create and publish your own Virtual Reality projects with VRdirect."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdirect.com/vrdirect-app-privacy-policy", "developer_terms_of_service_url": "https://www.vrdirect.com/vrdirect-app-terms-of-use", "publisher_name": "VRdirect GmbH", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "889743538359874"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8167920726585529", "version": "0.8.1"}, "id": "520755348960603", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id":
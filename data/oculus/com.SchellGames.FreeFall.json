HoBjqwLIL2RTA2GRrwK_9RC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zo7w-71vtSCQ9mEnIB0dwx8t2Dz2g-1X6kF6rIIV9Qg&oe=69F21A3A"}, {"file_name": "Freefall_Screenshot_07 (2).png", "id": "696411700126151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308998_696411703459484_6222627623803304155_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9-DytwIDSQQ7kNvwHyaeJO&_nc_oc=AdoXS8ABsdCYmpsP0TdHOFVjGOwxIhLEG_qhr-dkgd3i5jHfBRQXqPHShMn0PFs-wKo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nf9PM1LbiRfvSDwQ3gY34Ha1ZkBa3OWpaOevndFEXbg&oe=69F20871"}, {"file_name": "Freefall_Screenshot_02 (1).png", "id": "655666917555583", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299745_655666927555582_6126808797951872270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4kcERmMuXQQ7kNvwFNhJRL&_nc_oc=Adq7Fy0K9bZpemSHjfAhXlsoVkMmdEQYAHFVMlQWPGmGcTNECJyJp6IOD3TKLgQiwgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af08nr7NSQbvN0M7GvlwLuRoGFZ2wV2Tmi1EnADHuXyp-g&oe=69F20061"}, {"file_name": "Freefall_Screenshot_01.png", "id": "1237991958094979", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830812_1237991964761645_538112053924044308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6MHxCXu01AQ7kNvwH3gjeW&_nc_oc=AdrN5475HE2QgzIhW5a2-uOvb_1-hBSZcz1K8MKO8FXrEy7p8Eq0IsuODaQwn8ZAWko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3046VsAjTG_WPbzoa4_-8EdEMmqcsHrRd8IzXRTWgqDg&oe=69F20811"}, {"file_name": "Freefall_Screenshot_08.png", "id": "1269574814908444", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298212_1269574818241777_758556989194239379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ7pxVYdYz8Q7kNvwHU4xGb&_nc_oc=AdqQx8TkJeQQQ362xGs6R8rnm4igBh1Yq4uTKUJpTPZDfuLdz_hwjb_TlQ3_woebboo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2rOuOw_VuzrV5n4kGTdaO6swJLyl0_BPbiOaJKCBff2Q&oe=69F20AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Freefall-EarliestAccess.png", "id": "1808420356428695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300661_1808420359762028_6370515042281540577_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZmHDybBrzUQ7kNvwHbQ64f&_nc_oc=Adp0mmGHLuCVSQ--2o3RA2DeZ6lors8XvNDeE5Gws4_5Jxy_8dQM0-Ie9smmP15dc-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0wujZls1vTcCJ_Vh4YrGB2vHL_QUqnrlTVUIjE_1_mPA&oe=69F1FA1E"}, "display_name": "Project Freefall", "keywords": ["skydiving", "party", "tag", "friends", "free"], "long_description": "Dive into Project Freefall, where the stakes are as high as the altitude. You and up to seven friends are plummeting towards the earth in this adrenaline-pumping game of tag... but there\u2019s only ONE parachute.\n\nThe rules are simple: survive. The parachute drops from the plane. Your job? Skydive out of the plane and grab it for yourself. Toss a grenade, spray a fire extinguisher, or dodge the shark as you weave through the clouds in a high-speed aerial chase where alliances are temporary and gravity is permanent. As the ground rushes up to meet you, the intensity skyrockets. It's a hilarious, high-skill dance of chaos where only one can claim the ultimate victory, leaving the rest to an\u2026 explosive landing.\n\n**FEATURES**\n\n- 8-Player Mayhem: Invite your squad for the ultimate test of friendship and reflexes. More players mean more chaos!\n-  Cross-Platform Play: Dive in from either PC or VR. Everyone plays together in the same sky.\n- In-game Voice Chat: Talk with your friends easily as you plummet through the air.\n- High-Stakes, Simple Rules: Easy to learn, but mastering aerial maneuvers to secure the win at the last second takes true skill.\n- Flex Your Style: Look good while you fall! Shop for unique characters and diver suits to customize your look.\n\n**What are you waiting for? Download for free and join our Discord.**\n\nIt\u2019s a race to the bottom - will you land with a prize or a splat?\n\n{792047206721044}", "short_description": "Grab your squad and dive into a frantic chase for the lone parachute. Project Freefall is the ultimate game of tag at 10,000 feet. Toss a grenade, spray a fire extinguisher, or dodge the shark as you skydive with your friends and try to survive the fall. Will you go on to victory or go splat? Free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://schellgames.com/freefall-privacy-policy", "developer_terms_of_service_url": "https://schellgames.com/freefall-terms-of-use", "publisher_name": "Schell Games", "support_website_url": "https://schellgames.atlassian.net/servicedesk/customer/portal/1/group/23", "website_url": "https://schellgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10028033173968026"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2017655228977966"}]}, "baseline_offer": {"id": "2017655228977966"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760374800, "status": "PUBLISHED", "id": "2017655228977966"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24983733024638129", "version": "0.0.1+349853s"}, "id": "429961223039967", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false,
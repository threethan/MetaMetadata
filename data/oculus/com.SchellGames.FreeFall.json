77", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299745_781261817718210_7279724541550981701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw-2OrbHU6YQ7kNvwESTX55&_nc_oc=Adoibt-0TK9J1_WbVFcc-d0bS0CNEFYp8MjLMam9Z_00eOcpjwxJ4h8hAgJEcSKijqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSIXnrDE8vl1oH5rPknLaBccT3z_Zpjx8MQePOG3frOQ&oe=69CE81BA"}, {"file_name": "Freefall_Screenshot_07 (2).png", "id": "696411700126151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308998_696411703459484_6222627623803304155_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHfhkDqeAmwQ7kNvwHTqLH3&_nc_oc=AdrLt-DEP5MCpQw4v6PsV6i6TDEATWquG-aimREcAu8H-JgHeTN6-C7KF_NgoKLwzaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1c5Nl2HKpDE-bAz8o8YRWI1bLSXBE6pe5MnFbhGsG_Q&oe=69CE6FF1"}, {"file_name": "Freefall_Screenshot_02 (1).png", "id": "655666917555583", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299745_655666927555582_6126808797951872270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGyzO8q2xEAQ7kNvwHzdA3u&_nc_oc=AdrUop6x3idFPY2bQz977_LzzbcUmDr1wZ8InHuXwxkFNXPwc6jS1Frbfe-YN7arlSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaSNxSdwLhYr8jbcIHYvsWpSIFLG8AJUN5qGGDaRm_4A&oe=69CE67E1"}, {"file_name": "Freefall_Screenshot_01.png", "id": "1237991958094979", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830812_1237991964761645_538112053924044308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYfCKBXVi5QQ7kNvwHyk9cw&_nc_oc=AdrGBNERuDvcKHO_gvsIO156WTSBf-PYX80x5AHmZ-61LXUdFN-iSgvdUjckw75WlBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAzcpMPxePxMdTL88A2eCrzap1bQ9s6juKoWOS6m-olg&oe=69CE6F91"}, {"file_name": "Freefall_Screenshot_08.png", "id": "1269574814908444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298212_1269574818241777_758556989194239379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yb3tJJPanXQQ7kNvwFBiaSw&_nc_oc=AdpcMANSm4fGDKAw80kA1cakOKPMwMSMJ6QjB0AVX3z12JdWk7dAy5RE-Vpa3nunJ1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySYYAPp28_VgQ1vXEWeOhN-0-OKWNOwJNUmdk3E3nnIA&oe=69CE7257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Freefall-EarliestAccess.png", "id": "1808420356428695", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300661_1808420359762028_6370515042281540577_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxGJ5uoRBAcQ7kNvwGGqREd&_nc_oc=Adq-ZtLBHFZIeDpwfMrJzs1EQcKGIyiPW5vC7KJln2AJC8XZw3Z0w4pNhwxXnTkm3QI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIjbEvD5Plbp1Xcd-65WgacETYNNEIW2WPQNofLZQ1mw&oe=69CE619E"}, "display_name": "Project Freefall", "keywords": ["skydiving", "party", "tag", "friends", "free"], "long_description": "Dive into Project Freefall, where the stakes are as high as the altitude. You and up to seven friends are plummeting towards the earth in this adrenaline-pumping game of tag... but there\u2019s only ONE parachute.\n\nThe rules are simple: survive. The parachute drops from the plane. Your job? Skydive out of the plane and grab it for yourself. Toss a grenade, spray a fire extinguisher, or dodge the shark as you weave through the clouds in a high-speed aerial chase where alliances are temporary and gravity is permanent. As the ground rushes up to meet you, the intensity skyrockets. It's a hilarious, high-skill dance of chaos where only one can claim the ultimate victory, leaving the rest to an\u2026 explosive landing.\n\n**FEATURES**\n\n- 8-Player Mayhem: Invite your squad for the ultimate test of friendship and reflexes. More players mean more chaos!\n-  Cross-Platform Play: Dive in from either PC or VR. Everyone plays together in the same sky.\n- In-game Voice Chat: Talk with your friends easily as you plummet through the air.\n- High-Stakes, Simple Rules: Easy to learn, but mastering aerial maneuvers to secure the win at the last second takes true skill.\n- Flex Your Style: Look good while you fall! Shop for unique characters and diver suits to customize your look.\n\n**What are you waiting for? Download for free and join our Discord.**\n\nIt\u2019s a race to the bottom - will you land with a prize or a splat?\n\n{792047206721044}", "short_description": "Grab your squad and dive into a frantic chase for the lone parachute. Project Freefall is the ultimate game of tag at 10,000 feet. Toss a grenade, spray a fire extinguisher, or dodge the shark as you skydive with your friends and try to survive the fall. Will you go on to victory or go splat? Free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://schellgames.com/freefall-privacy-policy", "developer_terms_of_service_url": "https://schellgames.com/freefall-terms-of-use", "publisher_name": "Schell Games", "support_website_url": "https://schellgames.atlassian.net/servicedesk/customer/portal/1/group/23", "website_url": "https://schellgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10028033173968026"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2017655228977966"}]}, "baseline_offer": {"id": "2017655228977966"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760374800, "status": "PUBLISHED", "id": "20176552289779
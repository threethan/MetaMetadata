}]}, "id": "1316867326909239", "locale": "en_US", "screenshots": [{"file_name": "Patch Notes for Freefall (2560 x 1440 px) (4).png", "id": "1548698249715515", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303707_1548698253048848_2342831858422959458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt5dZFv7n1EQ7kNvwHmS_5p&_nc_oc=Ado7KfZRL8HpOudIbm2chMayXbKYEAWzkjwKgFuRaKBxWttqfE_c8eDYYxqeGj3TPzE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1bDKt7Q_jCQKQ04Di-f4Tj-H4DUtJVq3LkxQo5ENDatg&oe=69F21959"}, {"file_name": "Freefall_Screenshot_09.png", "id": "781261814384877", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499299745_781261817718210_7279724541550981701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-LpyA9InZIQ7kNvwFAYX9p&_nc_oc=AdrWiaQtQt5rZ_-8k2h6Ot5GUVleUXXX0_-jg-NMBarHoBjqwLIL2RTA2GRrwK_9RC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zo7w-71vtSCQ9mEnIB0dwx8t2Dz2g-1X6kF6rIIV9Qg&oe=69F21A3A"}, {"file_name": "Freefall_Screenshot_07 (2).png", "id": "696411700126151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308998_696411703459484_6222627623803304155_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9-DytwIDSQQ7kNvwHyaeJO&_nc_oc=AdoXS8ABsdCYmpsP0TdHOFVjGOwxIhLEG_qhr-dkgd3i5jHfBRQXqPHShMn0PFs-wKo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nf9PM1LbiRfvSDwQ3gY34Ha1ZkBa3OWpaOevndFEXbg&oe=69F20871"}, {"file_name": "Freefall_Screenshot_02 (1).png", "id": "655666917555583", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299745_655666927555582_6126808797951872270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4kcERmMuXQQ7kNvwFNhJRL&_nc_oc=Adq7Fy0K9bZpemSHjfAhXlsoVkMmdEQYAHFVMlQWPGmGcTNECJyJp6IOD3TKLgQiwgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af08nr7NSQbvN0M7GvlwLuRoGFZ2wV2Tmi1EnADHuXyp-g&oe=69F20061"}, {"file_name": "Freefall_Screenshot_01.png", "id": "1237991958094979", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830812_1237991964761645_538112053924044308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6MHxCXu01AQ7kNvwH3gjeW&_nc_oc=AdrN5475HE2QgzIhW5a2-uOvb_1-hBSZcz1K8MKO8FXrEy7p8Eq0IsuODaQwn8ZAWko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3046VsAjTG_WPbzoa4_-8EdEMmqcsHrRd8IzXRTWgqDg&oe=69F20811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_new_03b (1) (1).png", "id": "877437711354891", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307602_877437714688224_6239876745034796379_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN9p7P67mogQ7kNvwFV7lug&_nc_oc=AdoB-am-sDrkQ3vynb4Z8e7gXNmP-RI6jq7tgJstCbtw4abPT9tAyo2ybb11yPrCluU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3VQBiQxEvXABfNvZvzPcisuNMtOGeNsvBOYw3U4Wt_wA&oe=69F1F308"}, "display_name": "Project Freefall", "keywords": ["skydiving", "party", "tag", "friends", "free"], "long_description": "**1v1 versus mode engaged! Play Project Freefall now with 2 players +!**\n\n\n# Dive into Project Freefall! \ud83e\ude82\ud83e\ude82\n\nFree to play in Alpha, where the stakes are as high as the altitude. Plummet towards the earth in this adrenaline-pumping game of tag... but there\u2019s only ONE parachute. You got this! \ud83d\udc4d\ud83c\udffb\n\n{1352437436427667}\n\n\n# Grenades, Sharks, and...A fire extinguisher? \u2049\ufe0f\u2049\ufe0f\u2620\ufe0f\n\n Toss a grenade, spray a fire extinguisher, or dodge the shark as you weave through the clouds in a high-speed aerial chase where alliances are temporary and gravity is permanent. \n\n{25154760170823539}\n\n# FEATURES\n\n**More players mean more chaos!**\n\n\ud83d\udc6f\ud83d\udc6f2-8-Player Mayhem: Invite your squad for the ultimate test of friendship and reflexes. \n\n\ud83e\ude82Cross-Platform Play: Dive in from either PC or VR. Everyone plays together in the same sky.\n\n{1135177462105042}\n\n\ud83d\udcacIn-game Voice Chat: Talk with your friends!\n\n\ud83d\ude05High-Stakes, Simple Rules - don't splat!\n\n\ud83d\udc54Flex Your Style: Customize your look!\n\n{838454395335088}\n\n**What are you waiting for? Download for free and join our Discord.**\n\n# It\u2019s a race to the bottom - will you land with a prize or a splat?\n\n{792047206721044}\n\n{785279220770425}\n", "short_description": "[Alpha mode, engaged!] Grab your squad and dive into a frantic chase for the lone parachute. Project Freefall is the ultimate party game of tag at 10,000 feet. Toss a grenade, spray a fire extinguisher, or dodge the shark as you skydive with your friends and try to survive. Will you go on to victory or go splat? Free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://schellgames.com/freefall-privacy-policy", "developer_terms_of_service_url": "https://schellgames.com/freefall-terms-of-use", "publisher_name": "Schell Games", "support_website_url": "https://schellgames.atlassian.net/servicedesk/customer/portal/1/group/23", "website_url": "https://schellgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24982523701425728"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499302483_4269021499993746_8626175869850962370_n.png?stp=dst-png_s360x360&_nc_cat=1
_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxGpnapp3tojJzlfpLT3FeMV2392w-3cLIrpDZVxQJ7g&oe=6B0C61B1"}, {"file_name": "Freefall_Screenshot_02 (1).png", "id": "655666917555583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299745_655666927555582_6126808797951872270_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwmYDjv21iwQ7kNvwHgh2X0&_nc_oc=AdqabhbtkHJdh5kIohoIazlfpmKjZHbjopzFZI5q7DIBGkDDMGaSQrOAaFarWY9Rwdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvaKIHar8aH1d29NiL1ZAX1MV9tRaJCXQ9EkgXbO-z7g&oe=6B0C59A1"}, {"file_name": "Freefall_Screenshot_01.png", "id": "1237991958094979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830812_1237991964761645_538112053924044308_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUQUUeb4aKsQ7kNvwFEPwcQ&_nc_oc=Adqhe3vGEeGcX3Nj-ZZjG6MEYlw1kMkDuLOCxArNuPZGCVIqG3Uui9DMwRUj-ctEQow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5nzDgMDenuQDiVG8lMxlupHVrjXSv9ITJsrVcMDkWhw&oe=6B0C6151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_new_03b (1) (1).png", "id": "877437711354891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307602_877437714688224_6239876745034796379_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1kUjAyd6IcQ7kNvwGLAsZu&_nc_oc=AdqSICK87y3SMkwRciSUOz3HH7xSbzmkjaEib8YRKejxLboQED25M6yBPfCd2dGIok4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5nizBwaVy4NxR1RIzNXBPw8ckbVXQN_d9J3zxZAJsuw&oe=6B0C4C48"}, "display_name": "Project Freefall", "keywords": ["skydiving", "party", "tag", "friends", "free"], "long_description": "**1v1 versus mode engaged! Play Project Freefall now with 2 players +!**\n\n\n# Dive into Project Freefall! \ud83e\ude82\ud83e\ude82\n\nFree to play in Alpha, where the stakes are as high as the altitude. Plummet towards the earth in this adrenaline-pumping game of tag... but there\u2019s only ONE parachute. You got this! \ud83d\udc4d\ud83c\udffb\n\n{1352437436427667}\n\n\n# Grenades, Sharks, and...A fire extinguisher? \u2049\ufe0f\u2049\ufe0f\u2620\ufe0f\n\n Toss a grenade, spray a fire extinguisher, or dodge the shark as you weave through the clouds in a high-speed aerial chase where alliances are temporary and gravity is permanent. \n\n{25154760170823539}\n\n# FEATURES\n\n**More players mean more chaos!**\n\n\ud83d\udc6f\ud83d\udc6f2-8-Player Mayhem: Invite your squad for the ultimate test of friendship and reflexes. \n\n\ud83e\ude82Cross-Platform Play: Dive in from either PC or VR. Everyone plays together in the same sky.\n\n{1135177462105042}\n\n\ud83d\udcacIn-game Voice Chat: Talk with your friends!\n\n\ud83d\ude05High-Stakes, Simple Rules - don't splat!\n\n\ud83d\udc54Flex Your Style: Customize your look!\n\n{838454395335088}\n\n**What are you waiting for? Download for free and join our Discord.**\n\n# It\u2019s a race to the bottom - will you land with a prize or a splat?\n\n{792047206721044}\n\n{785279220770425}\n", "short_description": "[Alpha mode, engaged!] Grab your squad and dive into a frantic chase for the lone parachute. Project Freefall is the ultimate party game of tag at 10,000 feet. Toss a grenade, spray a fire extinguisher, or dodge the shark as you skydive with your friends and try to survive. Will you go on to victory or go splat? Free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://schellgames.com/freefall-privacy-policy", "developer_terms_of_service_url": "https://schellgames.com/freefall-terms-of-use", "publisher_name": "Schell Games", "support_website_url": "https://schellgames.atlassian.net/servicedesk/customer/portal/1/group/23", "website_url": "https://schellgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "45
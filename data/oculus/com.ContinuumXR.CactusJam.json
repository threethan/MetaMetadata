f&oh=00_AQQuWR5nEW_MfyMfcuTi5l8-gNSHWsPC9pDoTYBfpvpM3w&oe=6AFB1E85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rabbit-store assets_CA_Landscape_META_2560x1440.png", "id": "32786521354280060", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_32786521390946723_7597186805546034595_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S2U_mdNmOwQ7kNvwH71ck1&_nc_oc=Adr5fMX3ueKrY6rsEXrUpw2xp7DmIph2j_yIqYOjwuBSPxayzqMop4WwUaIgHNCT91w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDLldamBu58h0xViKq7fJMmjA9vcYblw5WNOqgYGAF2Q&oe=6AFB305F"}, "display_name": "Cactus Jam", "keywords": ["multiplayer", "horror", "free", "shooting", "party"], "long_description": "\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e\u200e \u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200e\u200f\u200f\u200e \u200f \n\n{1951357125720232}\n\nYou've heard of cowboys versus aliens - now get ready for cacti versus aliens in **Cactus Jam**! Explore a terrifying UFO to save the wild west with all your friends. Collect jam jars as you dodge, whip, and outrun alien monsters in this **fast-paced, free-to-play VR adventure.\n\n{2097272317723091}\n\n# \ud83d\udd25Why Players Can\u2019t Get Enough: \n\ud83c\udfae **A game mode for every player:** Horror, Prop Hunt, Deathmatch, Capture the Flag, and more\n\n{1476664860189161}\n\n\ud83c\udf35 **Dynamic VR movement** and full-body chaos - master arm-based parkour\n\n{1428260678398794}\n\n\ud83d\udc7d Play as aliens, cacti, or \u201cwhatever that is\u201d with **unlockable cosmetics**\n\n{1331172708419330}\n\n\ud83d\udca5 **Weekly Updates** with new content and seasonal events\n\n{1535655647599902}\n\n\ud83d\udc6b **Play multiplayer** with your friends in private lobbies or make new friends in public\n\n{1521127855326153}\n\n# Keep the party going and join the jam on Discord: https://bit.ly/CactusJamDiscord", "short_description": "Aliens have descended on the Wild West, and it\u2019s your job to explore their horrific UFO. Collect jam jars, run from monsters, and outsmart aliens with your cactus power ups. Play VR\u2019s best social horror game for FREE!"}]}, "developer_name": "Continuum VR", "developer_privacy_policy_url": "http://www.cactusjamvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://www.cactusjamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
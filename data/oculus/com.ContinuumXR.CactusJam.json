nt-iad3-1.oculuscdn.com&oh=00_AfsXslFp3SRl0oknTf3ZZmSZDFF3lcgwI1pBrv1nkirHiw&oe=6999A868"}, {"file_name": "2.png", "id": "7497045893659265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_7497045896992598_1843004853547828033_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS7dZeccB5AQ7kNvwGmODij&_nc_oc=AdlUQhM8jo9pIsmsVm3ouGJl8SxvYwjd_VtCeSBiBM5w4ApiU8CjlufPXsSe__KQrrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKwCzX1tWU-9HUY2sxtK9V79J5y-7WryzDdfOXVNjhpA&oe=69998BB0"}, {"file_name": "3.png", "id": "349907624600198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_349907627933531_8803335368883209591_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R00VbDK_hoQ7kNvwFVVRtU&_nc_oc=Adn2PgS90vm9kJ9cskRyENKp1t_2E3Ls5eWibpeaL93zGyK6CVgW8WcUxdAURaVW-dY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFakCIrSmN1NBGGEa-IcMg7GiXjDi1yvCPR2LwCdnzfA&oe=69999BDA"}, {"file_name": "5.png", "id": "299329666453217", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/44000512_299329669786550_2834925494622853204_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rse94v5TbVoQ7kNvwEyys9S&_nc_oc=AdloxjJ0z_t5Va974AJxuQ-VZQaSlEeNUdq0rz09yxuhZXHEpxBPOlg1kOsS1iDIB9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiFUBjY6XJSK7SOb1hOZqGBgwTNGW3-Cy3Hfc7RBQT-w&oe=69999CF8"}, {"file_name": "4.png", "id": "704002208549325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035401_704002211882658_4561892767722696478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ppmpw1sJOMQ7kNvwEOVCnj&_nc_oc=AdnDmWevf_chkYmllKQlqGLMMI_lHlymEtozo4aELnCJr7Bb_MaYwwAbGWnMbiVz5Eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuKrEdlucCTy23VIZ8cDhWh60cyqN6QOqGGTa-ZgFch6A&oe=69999E02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cactus Jam", "keywords": [], "long_description": "Welcome to \"Cactus Jam,\" an exhilarating multiplayer VR game created by two brothers in a basement! \n\nImmerse yourself in a thrilling desert landscape complete with sand dunes, rocky outcrops, and swaying cacti, all under the watchful eye of a hovering UFO. \n\nEngage in an epic game of hide-and-seek between aliens and cacti, where stealth and deception are key as you master the art of blending in to outsmart your opponents. \n\nDive into this immersive VR experience and experience the adrenaline rush of the hunt in a visually stunning and cartoonishly captivating environment.", "short_description": "Welcome to \u201cCactus Jam,\u201d an epic hide-and-seek multiplayer game, where cacti must master the art of stealth and deception to outwit their alien adversaries. Explore a sprawling desert landscape under the curious gaze of a hovering UFO, complete with sand dunes, rocky outcrops, and swaying cacti. Cactus Jam delivers an adrenaline-pumping adventure that will keep you on the edge of your seat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cactusjamvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Continuum VR", "support_website_url": null, "website_url": "https://www.cactusjamvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6956433494479167"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "315386104553232"}]}, "baseline_offer": {"id": "315386104553232"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
nt-sjc6-1.oculuscdn.com/v/t64.5771-25/44000512_299329669786550_2834925494622853204_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMw7kIjfxnYQ7kNvwGMnzJX&_nc_oc=AdrsVsqiKhqLCpZlSEFGMIA6XaOHZRXk-0ZwU0_fxrO99loTlShtmRKcE_VT3af-a18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAutojFJZ9uOUo18bbFVbWhQe9ls0FbQ8Y7MxWXqe3VNQ&oe=6A6DDE78"}, {"file_name": "4.png", "id": "704002208549325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035401_704002211882658_4561892767722696478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvfWcm2WlGoQ7kNvwEj-usk&_nc_oc=Adr36vrJST1Nt7Obumlf-A2ZMOkzXvlupCXl6BlxOhzGBZjbB-zlorTCrkqzry8BCs4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM18WrkqLDpCfmVaFx_xBb1NY-94ikBWXKkFUPStRY8A&oe=6A6DDF82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cactus Jam", "keywords": [], "long_description": "Welcome to \"Cactus Jam,\" an exhilarating multiplayer VR game created by two brothers in a basement! \n\nImmerse yourself in a thrilling desert landscape complete with sand dunes, rocky outcrops, and swaying cacti, all under the watchful eye of a hovering UFO. \n\nEngage in an epic game of hide-and-seek between aliens and cacti, where stealth and deception are key as you master the art of blending in to outsmart your opponents. \n\nDive into this immersive VR experience and experience the adrenaline rush of the hunt in a visually stunning and cartoonishly captivating environment.", "short_description": "Welcome to \u201cCactus Jam,\u201d an epic hide-and-seek multiplayer game, where cacti must master the art of stealth and deception to outwit their alien adversaries. Explore a sprawling desert landscape under the curious gaze of a hovering UFO, complete with sand dunes, rocky outcrops, and swaying cacti. Cactus Jam delivers an adrenaline-pumping adventure that will keep you on the edge of your seat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.
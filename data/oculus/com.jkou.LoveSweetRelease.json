APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A2nf54rSTIQ7kNvwHq1pWN&_nc_oc=AdolLDBvELU0abZ14Ht1aZiU1F6zXHpaSxTqKN1BfOF10vE2B4PEUOL_D7IjtT27cJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B8eJV_WdVJB7mGT8OYIcwZlogY5EhFWqH_xC3O_JQTQ&oe=6A3800EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAIRu3Q4RL4Q7kNvwETK0ZJ&_nc_oc=AdqoMvlQIjmcyG3dfZLnLP8e-5FvdGf1ot3MtDGksfw8G1flbWcAYrYaANEvl2P74oQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q1dTXVuESwWEKij0j-CJUce0mcCRhb_QM5QlIg7q6tw&oe=6A37F01D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GPxTcy_SPsQ7kNvwGn3GGq&_nc_oc=AdomQF3MmKFraGYsBiwVgY_ml-e5t9_VD_QvFswQhaK4458_fDUJQJUwjPZLKNQC5-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tSmDtDU4J3kStLzFYMXl-4AlUzOySmFWMoVW3eESZPQ&oe=6A380C17"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AIk3Z7UBAUQ7kNvwEmZHuZ&_nc_oc=Adqbv37BiYi4isjDH66w2f6-M0EJzHc3XJzlno9YhDyMDROOa6cZz1j6ghVDa59wbto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fl_bG0MT3jViitE1u3gLIkQuGMB-0GMayzIc27MeEGg&oe=6A37FB72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTfmvyYcsWYQ7kNvwHo1K-g&_nc_oc=AdrvT8N_UH3WTNZX0vk-EI4cwJMiGgPR5fnqwKUGtw8HFvQb6cyf18nAiHOuStkoVtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9cHoqtNBJBonRTVwv1pVNClrh03FrebRcvXSlY9Epvw&oe=6A37EAA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IfP5iGL-6kQ7kNvwFRnk3c&_nc_oc=AdqdRom922njTtHdxWBjDRoOZ1P6IV1VMtOKNeKcOb_OjsetJlGIb76FkSN3vp-aiTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RoC4tPPxfcJdZdwmhZh63IS33syv0PBVhF1HkAFK9tA&oe=6A37F7CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iH9hietyzEQ7kNvwEpEARs&_nc_oc=Adrb88MPMlAniCaVZDr3L5j4ujeFP170bHJdn9khj_D_l9Mi8PP8PHaiFdxkTveDC18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PfGOabUWIjHoDKTteOaGGWhtxO_r0Uem_eIp6yT3oKg&oe=6A37F496"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg82uvHTsEQQ7kNvwEyljmH&_nc_oc=AdqfHGmT-lMbhAmpMg_qwTHiGD6eHr07ADdsJW0gDN1y9DJPSFujWbgAbquQwqYONlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lvUU8-v2kelqwEfPd7ydpbR_z4kKK_YJE1nAcHm2HxQ&oe=6A37E174"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
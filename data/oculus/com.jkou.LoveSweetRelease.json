APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-2xDn6Eeo4Q7kNvwF9Enc4&_nc_oc=AdrdVpsvs9iDBM2p-V22jj-SA2w2QV2tRuIbWfdJGqMUXPnrk-6Hwrcz-64VkKo8BGQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfqoGsN22exvNBA8CKOYgcijT01OZz0rrgNgaB0LiaSw&oe=6AE363EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsSXdluVe5oQ7kNvwHD3arT&_nc_oc=Adoh5a_KYKQMX4s1q9FGFivzP_mYPODCNRpF45CqNyEP7Oji86d2PMgOjDLpWc877Zc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxyXfuVJSo7_FE-UpllnJjhZuEggyyWZeVnZsaTmsO0w&oe=6AE3531D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0aX7DeuQCIQ7kNvwEFRR3n&_nc_oc=AdqrBy38Z8ng1QH6kVbDQ5O7Iz1E3eAJiwD45FLNOsAq8QowYZwg9BfQL-iSprIv0o0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvSt4HnVjOIQ_KUzv6XUhRd1offcc7TZ90nupysmT7Tg&oe=6AE36F17"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0w3LBLLibIQ7kNvwEo3kER&_nc_oc=AdoBI0e7MdG_o0PQirF-KdBHdTNWwwnffEOc0k737LHN2C_jDZrsZkzXd4XCL2Yvno0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQc3_UtyZk53_KTg47YxZfNTNc_fZAVW2a2k-sOktyTw&oe=6AE35E72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5op4g38wq4Q7kNvwHjCrpf&_nc_oc=Ado9Mb-k63SkLBaBQjz_5HkowxbXYMvYyl1eXHqogr2TMerGIWWB9B7YOkFLTZ0BNtc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCxVcGCcSQD8xhaJd6wHoRG7WN6owPPRnXePl0qLC5og&oe=6AE34DA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C4mHJvsqiYQ7kNvwGAcoV_&_nc_oc=Adp_5QC5UDwJI4Nt7c2Y2zmQNW3quETfCII_m-7qjxyVXJv2KQwvJiJIbiE4q_DvQac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVSFVcHghkzydfm0rKcrKFxPI3vylUzb6oYZL4SxJwPg&oe=6AE35ACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TslH8HX7nnwQ7kNvwHUkY_J&_nc_oc=AdrPAr995LGXUaspqNaNADlzkAAmqEKClhvot5uYf3vjZ3lQrcKPz6D2r72ErZVCvS4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpjilQgfBA6TKM9NdVf6Rt5D3sfpoQLxnTZxbLU1vaAA&oe=6AE35796"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4BPEY1lI4QQ7kNvwFi4c5P&_nc_oc=AdpdCZFCbx_n_j-h3i7nXJSdNE0wp15CujwaYj1v1l0ZSwMMFyPwVwuQvqtb_o0d-nk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFc6nEFezs5uIjzZT0CV-MZiZ23bLNRFYu0E1yt56h-g&oe=6AE34474"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
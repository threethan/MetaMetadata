APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jeqf9toCWl0Q7kNvwEQGHAW&_nc_oc=Adp1qQEkm-u1ToEZb36eApRb_SqqZlInO-dgymXUPX1kh4VKJHs8FEkBHcmo-HSyePw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXtdZ2wvCYIBFk46cFOOhwqt1JJPM5BqRnMLTm0oW1GA&oe=6A4BC76F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcjWOQBZgNEQ7kNvwGmUohB&_nc_oc=AdoJwrZXvHrwnbK7oJHU1vOKIb663afvptpG3_hZ8Gws1Y8ZHlDSrZCTSyi-PIBMfxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3RN02sRfUnOmSUivIR_NkJRz81wSu3-mJJ4QVucaD_g&oe=6A4BB69D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw13z9TGuIkQ7kNvwEnzKwe&_nc_oc=Adplv5dtbaG0YxdmgI_IFh6ABQcKwUYCK-Q5jx3MzFEKQlJVIEeP-VL__OV_3cRMLsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3yh5Rl1KKktzihqhbQcGRtOM7nAQ2_SQnOZHNheHChA&oe=6A4B9A57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn6kkEFoWhQQ7kNvwGu2mV0&_nc_oc=AdoEyJkLxXSP64E7ALwsufSI8Z9knnMeQgl5iffXScFA1GVHPZoiPRU2Hzj16-e3COI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK5b_fYGbVS2fbvPNUrsMD1zZXn_FGPPPKDWKoMU37bg&oe=6A4BC1F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqn8DXS8S6MQ7kNvwEYw9QV&_nc_oc=AdodLgNiO_-JY93595KlEQElBrjvuerRTM_CMSnNWtczww4v7uL1uILUbYPc4TEwBPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALAvEihaD8yW2B6li2lFlc3ysU3n-DyZfx1pI7pqT3fg&oe=6A4BB126"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwhf-CpHNZ8Q7kNvwEvOYp-&_nc_oc=AdoaG37EwM4nboIkUjKThbJbeO_PTsvaPLMtxTijFdCaEHDRVzM6SST12_85KWbMSqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOjWtTDzOwUhdu1Zunqq6HgnFiMmuEGN0a0P8vn4ozuA&oe=6A4BBE4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBhNBq8REp8Q7kNvwGrDVgb&_nc_oc=AdphQOyEXjXQEUVAgUfXFdapeLzMKRYCp7TmC-ulr--Lpf1jtAgdxQ1j9Gn26WAMXWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYRBF8tFw5Wat85AXATq2x8lsQB8INQafuMrKNsnfgpQ&oe=6A4BBB16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCLExp10GRIQ7kNvwGdrUK_&_nc_oc=AdrC1HgwoImPkYji63rvM60PlglPIs96Dhov5cHke0B3q1BOgbzj_0nxSbHgc2xYoaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoQrOIlmLVlljjp5Y4TnScH4YLhwv0nj7IUw6_sgSPhA&oe=6A4BA7F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
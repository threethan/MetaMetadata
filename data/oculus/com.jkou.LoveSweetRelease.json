APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNYfzI9lA8AQ7kNvwF1bL-F&_nc_oc=AdpOfJ_nPx05yTBaQUDVeEIZ4rfZtSZpfkhtYuhXVtAchjyiyTcBOkREIyqcaVfUUr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTec54KqKwPdMrWAhHSD_mdmyJsMD7tkYdxja78S7zMHg&oe=6AE9FB6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K1f6RscvPUQ7kNvwEtQKeD&_nc_oc=AdqJmnHXNUCxjFQKQyeFpeP-yQSZk7UcxG8VGlkLRCR4lfZ5na61XzBTcPtGfgKbQBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAVzvTgCBUM6_w-ACU61XTcFmYbUJxjVESNO_eYC4wUA&oe=6AE9EA9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pc_U0m2d9AQ7kNvwHKGAeM&_nc_oc=AdrJpn5i9eTsj_DrN7fpTAwmlDElg_necmTLLZ_su93pBfZFxiNOyYXZ7Iim7K_kzVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzlEeKce4a9Gz5ciaJ6PAC2P9klz3sMtRN20qlX0cgjQ&oe=6AEA0697"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ageu4-sPBNcQ7kNvwERlmPd&_nc_oc=AdpUrApyn8u4s6kCAxMTt7xq0_glAKnmnmai_0Dl43piclH7rDx1qUoWF2wgHrZttDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJpSSXmGkW5mF1wA7FNwBXN50-OIxndo-s8TO8LBoZ3g&oe=6AE9F5F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIw75c5rRn4Q7kNvwFJIvLX&_nc_oc=AdqAHbN1-4eXf3Qu4AZt3KD16oVM6VsjTVdDbw6hYOsvMxsP5KCsd4_zgIx-Qv-nVDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmnU_OOzl1FQDH9PQVBse2kl5uZBV6_pF0pkti0iXayw&oe=6AE9E526"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1tVUJ7sgfsQ7kNvwEUPw5L&_nc_oc=AdqVTFG7TOeRIPQZw2M5wCF18MuidoQtj96XdgH6UiU6vMtamQNmpQ5hF0dZdKQvT_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_godkgx_uEBGEirEeW62-uHubEFewyW2EMfQSSKA7Ow&oe=6AE9F24B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp_VFEObmvkQ7kNvwEJSGHc&_nc_oc=AdpO-4JaU-HESK78-PaH-ganD4StOlNvPRuIBzRCy-VLeDEVsS6IJ_d0uIvZCO1T5FE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTriXWdxkf823FbsU6cjv3Op-FFBuI5UR7hnN6bvDNmcQ&oe=6AE9EF16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isoA-h640rQQ7kNvwGQ1qHL&_nc_oc=Ado8P06gA9HyIJ-R_Zjw_zvHQSDlua28UvJPSi2k7J1xx0WSGa5Cr5VznxDqQdgzOs4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Z6Jb-6q62TSt7H_AxyJtATWJtQdVH9UBsyfO76IEvw&oe=6AEA1434"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
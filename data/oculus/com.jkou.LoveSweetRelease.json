APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THXjk998MV4Q7kNvwEdztFX&_nc_oc=AdrQXimcYTg0CI12yqMZQxahO-JAEwxxOAPul22mna6-pqmzZKs28p9m3XOXOc5BdXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoOoPEvan8TtJR6F3Kx87sAsMR4cxft_XsaPUq7eUrxA&oe=6AB3EDEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4qiYL4cbSkQ7kNvwEYWSFG&_nc_oc=AdqdZm8jzAYs-_Nfi0XaxVaXPywtp7Zs7FEiznGYew0z3hBvDKiyhVgnnfwORRCmMo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUdV-sOlOjtUFB0LcwIms_rtKWaqw-xvHOyYcBOQTeYQ&oe=6AB3DD1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMiYFz6mVVkQ7kNvwH-h0B2&_nc_oc=AdrUFGw54aeYeYYn9QRsyNohJ_VhVCbPjb3DkVmvefkzZJd-B93UU4i8XbmNWuQP_w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBMikyR6ri0DKBckZqUasSMQSFY--B1ziK51Lxd9qMUQ&oe=6AB3C0D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJzcqYRUgawQ7kNvwGa0e1w&_nc_oc=AdrUcpf5_-62MwzhOtBMbq7xk6gqZqoiFGumPegfK4oyyjQRfkTlTXG6rX0HQpThU5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD0BN_a_5Iv14kpjNzks6ZEtuU-Gr2C-hyFipO_GzkZg&oe=6AB3E872"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDQjcwjEHv0Q7kNvwGm1ITA&_nc_oc=AdritLgMcfpPnykhSlkgl6GcunnECyW3Qht8P5tAw84yClLURVkFx0JIWxOLFxGtfxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFNQ8dCdbHA9uwJbHv_ZsNQTa39KGqq4x7X143HFSiPg&oe=6AB3D7A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6GJvdB2NoEQ7kNvwHWxMnl&_nc_oc=Adqolt1b4d_yaFXIJD67v1n-MVWCriZeGIVNTriaYMkFxxot4smqhzhXxyARp9BzGrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfu87Xk21u4_ganCTlSwK_tHaE_1BwKdc6w1v5_vM_eQ&oe=6AB3E4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMd5aj76P0AQ7kNvwF9XcjC&_nc_oc=AdqGjTXcbZPSrRj2mbXBvL5a-7iBYL7_uu5XQ4n-4kiEs7ZvxNklVOzgjWUdAJnOjmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhNQ4ezGagW9YTgp_R_UEaoQHfF_gbQRrjWLhfZS3JGQ&oe=6AB3E196"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1Hsu_g7EycQ7kNvwHy0xP4&_nc_oc=AdpSGIuH1ksmGehpH3m-bzbYVfzGvANyDD9fxlb0RPOoz6d_luOpHNdABeQtVLwUTPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMPaEYj7npJXagl4tXfumtrHHIsjYNZ70X5YewLU0OHQ&oe=6AB3CE74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
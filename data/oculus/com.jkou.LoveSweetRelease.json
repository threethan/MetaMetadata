APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THXjk998MV4Q7kNvwGuhbBW&_nc_oc=AdojQYioVsEKv-iep2E9J8FXgWdajHu1bMXR61nNhdKb2Mgghi4Q_nDKsjdX9POpDho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu1YdUNwugCjWlkrVdHK2DbxhdQXO2jb5WVtmZCCyBXg&oe=6AB14AEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGGPW5zdsdIQ7kNvwFbXFX1&_nc_oc=Adri8K9-YXxR3BS1e76MtH1jcEdCFLnu3h9Y-2Olt4h7FuH4pW_y2SuJZQw7dovIJ1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ99zshKfrw5lLdrFAaLnYG7n_8IAsiOJpzVnE9ACOzLg&oe=6AB13A1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OVGQlNZ-wMQ7kNvwFHsl1z&_nc_oc=Adq6Nsrs4QMbj5bBfwSikZLDrR_ESj4oT1DL01xdfXD-5mtdlIZKgPCIt8IygqnS6X4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjHDz-gFqLa7a-bcpSOO7Sat1HDmy0JovLU9rEGL70BA&oe=6AB15617"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPwBWGIqapUQ7kNvwHiZXab&_nc_oc=AdoYXurrDAYok9EQP25eopr6Va54UfarD66p9OmfAf0En_2dbxoot6evDUidsmbeVFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY0Udd5UzQ_ivS6CuPDlit6VqiDuSTY_uWU35z2fFiIQ&oe=6AB14572"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nN33iqgps0Q7kNvwGVSArM&_nc_oc=AdrFGKZhtex2CNwqVcNO4ZJ09Q73nCdgRsqIGeDak9qIti5PVHIILthZR_fEZVC3LsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxyyjw6-k18hxfNMvmOYaTJjY1khedv0eJ3i5dPQssKA&oe=6AB134A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crQgNUple_8Q7kNvwHftj3_&_nc_oc=AdpJ30TlfGTapcwnqVLo9HtspapEe7530JfmH0MR6_-c-sftsneGhfj6Xyj_kN-jyWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmuvlQivuCjJmgo8m6DjK8vx80klxqCowlFXS_nmKWNw&oe=6AB141CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MShrU7Kkj38Q7kNvwEX1QjJ&_nc_oc=Adr9uqpFmzjmxzf_9KRVr8R1Wvo7kPjNAVeNzU3rYhNeLPIZyVfL9QYlJ-bKf-4jhnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLusZVZLTGLLsXAewWMQT6djlYd6o7Y3ayZV5-1xabvUw&oe=6AB13E96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydgX-p5TxogQ7kNvwGp0mVt&_nc_oc=AdqyNx4-Ro0EwRJyjmEDwr_ZeIjxOqGm26M75yhs2IW31MfFfX8iQgSANEEb3FHCiTg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_HGVPto8P6ANoxkF20TkgQWQWVnTSg8dKL2X5fBlXA&oe=6AB12B74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
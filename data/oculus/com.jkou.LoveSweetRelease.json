APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-UwqVyHipMQ7kNvwEakadT&_nc_oc=AdrHVwzklfTs_GPCwwNMuCdJdGXB5yue3sSchazmb5PrgeoV7kpuHPX3oH1Iw8GVBNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvucnJKNUn1KTk4Fjnw4123DJ6US_oTlRtOMb2g7vC_Q&oe=6A70792F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYeEap1zydwQ7kNvwGktSch&_nc_oc=Adrrp4WpUjQr-UcCclhUm9m83ElSsQzas1uuWt1AAcf2RSnGu4D4sYSzTF2CtM9GI4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp8fqQGupDx939ct93RaKjoTwGmmi7aGSLDNCE716RJg&oe=6A70A09D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFWl74J9tjIQ7kNvwFMOTMI&_nc_oc=AdrfuAYIyTEqKih6Jda2CAdeviLBb3s5kR_Z1RvwU3bD5G1KuNYqTtsMn3AsfqI8Oyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLH_LcmK-XDGPBTHhit3S0rIy4TfWRNeDSOhBQPdyU9w&oe=6A708457"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsCXGpUYuiMQ7kNvwH0Sy25&_nc_oc=AdoQp2PzgtWRhiZL9UHL2_JF9qjCHajSK_vj88Cfgpi0eY6VyV04ny_Vt7LlJnFUWPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIMpplVMKWLiXltij288OK7vKc0cmNBAH0it13k6TAcg&oe=6A7073B2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZc_C1VxBEQ7kNvwHkCu8S&_nc_oc=Adq0ozPpvLb59RFvMY9MboCueMHIt56HiwUiQP6GcXc8S5OPZ6G_6WhjbSu-PpYzUpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHebGEjVSvmqT_fSR8intVkPu_8Qh24-gCAlMjZ7Z0aLA&oe=6A709B26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_TLSG-LAS8Q7kNvwHkRqaF&_nc_oc=AdpRoce2DrdprR0SJ2e9iddidLTkR-cixUz_OkcRSyUoDc5yvQ9BOpFVh0sy1u07bPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgP1SSOrBrEDmyAafYheVbprzCLUjRRX-739_-VUDNzQ&oe=6A70A84B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0R9FMRFWCoQ7kNvwFE5FO8&_nc_oc=Adpz5tn-hz6VgmGKlsSQ7SYVu_Txggpulb7XIEpuzNhPemMZxFlqBpOev37SZMoq8WI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc83Rdsy7JDp8ZcuHygll_ECiy4-KS7VGWOZINaxM9cA&oe=6A70A516"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C9LN90fApIQ7kNvwFpkp6G&_nc_oc=AdofyNtBJNb2WAI_tylmYY7MvHc2uXSNhqu8-eGNVjXUg-s7Jwi9vjnpuDZYyZLCEKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUFGmx8_IWep9TCBQegKi_35qgK0yY_yTjzdwAcwjcow&oe=6A7091F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jeqf9toCWl0Q7kNvwEzxRJT&_nc_oc=AdqUJwLHGR8Tc3CfRrU-Fn4Mr02okXEGH3fDosb1InqhVhPXUxRSkhmGRRQUe4StF18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF-Ak3TzX3UPRev6nTlwf2U1_fwJLXCvxx5qhlHu_G4w&oe=6A4D18EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9krHJkVbMgQ7kNvwFQ56fs&_nc_oc=AdrdSQMtnurC2-EDVEuOgnk7GOA9z6QwJCVRBFfWPHDbKMuzswCjVGqK5PJmIcPTmCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKwldnPbORkpbRnjrQrxb2xTWz1h-ZOyl9-RkZKQBYPw&oe=6A4D081D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xub8eo10eNkQ7kNvwGZ-62z&_nc_oc=AdrmFxbC59Mg7uH-PK0hlYlXG9cRpkdWaosmfwGLWlL_gAH2vL5KAGM2z0dG4tnAoco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc6KN9AOJC5Mtk5db12G2B0vBi5pWv7UxCLKBSGXio3Q&oe=6A4CEBD7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg4pSuWQjogQ7kNvwHq-c1k&_nc_oc=AdpMIsnWGuE3eIYtYEalnxP1rZKvg9lenlj4Y1x2ERmT0F2lFdhV8JNw4Sl11HRf050&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrq4smRmjCtHpUtlwTJZ4nP7KN7PuQEt-7PsGwIg77XQ&oe=6A4D1372"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4UbdZf5kmwQ7kNvwEIePG2&_nc_oc=AdpWNQed5TnJ7RTK6xOlK3f0WE_iYYINOfRHts5lWX451FXuy2ltkfCrP6LnDNjHDFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjRkFLnX77MyhmIqe6qQ6yRddSxqOoK1hcGDjvh7Y8Iw&oe=6A4D02A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwhf-CpHNZ8Q7kNvwHVAmhq&_nc_oc=AdpQlODm-V8fyKrRue01uJ0ZMk_1yYm4gfTRj9OpISo6RO37iFpjQ1p89DfkmuFnwZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgKhViJclINSMKoWwr2A-uE32xSJWyd_Y79U3lUG09Pw&oe=6A4D0FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpyqls7VvLsQ7kNvwGmmCwA&_nc_oc=AdrRXdGvFeMkGDGBWgCUEsJwr0fxs7LmZTlZw9RbxWVnQH51aiJFRuJHrAIphiJY1-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe9jmBmESlDLKg_B0g306Snu5FEbBG-OKaSGmj-48-ng&oe=6A4D0C96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A87M6FjSoocQ7kNvwG_7SrE&_nc_oc=AdoMhmNp1H-maY1eyYAB8p7j-QnBgLHNk9MbGF82G6VEwjrI2Rx9-I_AmXusU0bDNW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLN9dADr7E1eAeYSwrFf-2Zerubba7d5-hZdO8FWB6zw&oe=6A4CF974"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
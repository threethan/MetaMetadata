APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8a-zWF7Jq0Q7kNvwFU8lTb&_nc_oc=Adq9u58RJedVmaA6KUWY1cT5IvOddpKBJA6dPSfPC4EI5n6LoTiGR7Ky7t0NM_khQHI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb4E4NwJFtktyKnp4tMWTiQcBlR594l7rry7WFo5l5Ew&oe=6A97252F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNRpzITFJscQ7kNvwG_LoC6&_nc_oc=AdoYUFYw_VAc1im34qZre03yAYTyxurNFC5Wy6TqmAm9YlSWoXRjhZxouTGOqwmAj4U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7nXy94oL2Hh73ad0dibXol3wzV8GIaxmSetA8YDmaIw&oe=6A974C9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC_9UhwutD0Q7kNvwFnZE74&_nc_oc=AdoBOGxzLiKcA_gU6uNXygzENmuxsnlQMg8XROEachEmUsxGRvGA6geWXUBL8m9uI_M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcn85_jZPGrCWwDb176z9e5TpmQN2noyHHdfqEqlWKnA&oe=6A973057"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOO6G-7-RBYQ7kNvwF9MsAk&_nc_oc=Ado6nM89oz6kQJ_lI8qrgMRz7X3SauMEV0KIQMz17d_fAH5Pp8jC2OUSpcpY1uwLoVs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlSWWdZjirsZWha8klgRR-EAi8oVVPw5YyIB3mAGFp6Q&oe=6A971FB2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Rw2XPqfm8Q7kNvwHIbl2L&_nc_oc=AdoRELWPmYGNH-FP0dI0bZlHxKXEthkL6O7sTm1kjvysIvcbejePjM5tv2VSq6B89rQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENT_KGjqP-JmDV_2iqmF9697ZdQAMPKO0dEvpBeQojWQ&oe=6A974726"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsvtr4MwG5AQ7kNvwFmmE_D&_nc_oc=AdpBJJUk6vdfT39ocB2_PjY1OVg9hPNUmNN3uxfJPkjuTWseVkykEOUDqLUhsrm_ygw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLXroWpxx-DGRZmZ6fzXg-JQXH-y1ifx1eWjirJ5-eGg&oe=6A971C0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EkemiOU06gQ7kNvwEkNDni&_nc_oc=AdqpjnrdcvhckquQ_iSas-eq10FfhJeFCfp6Ad8aSZ3yGdGrPeLVaMOqcvQKE5H31_8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCj9mjuFrhm1RJ8LPVcd1kptX3yksB_HHsR5JxNNUqQA&oe=6A975116"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80YkT-y_7YQ7kNvwEdhg99&_nc_oc=AdoM4MQwff9Rf2bkZVPNsIojysWpEK71UgCyrT5iAxnfNvMPWX99JmJ9W1Q-LzqZUmw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi862KOVv8KJNFV9skKlGrBRZBwctqcJvOBhaWY-7nZw&oe=6A973DF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
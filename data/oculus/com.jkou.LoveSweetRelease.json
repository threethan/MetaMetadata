APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ43KGDqxU0Q7kNvwHxAXeA&_nc_oc=AdpFlU6RfpXSVMg6AbaBsM5PRjr55xQCpEp6go484ZFkvVuvUIfj2Res0INzgzz0JX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO_wT7tJlI5FPxYv-hT75OUCoyKujGZWgZ0ixVc3Brkg&oe=6ABBD6EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRCcgge6QBsQ7kNvwEH0U_e&_nc_oc=Adq-iXQKoc7fjGo_4YSby65SSkd2WKItaq2TpSuYTQuxD7xxz7t3jhYylxPJx_3cpYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr_E-or4bmef0I2EnDHvMmN3ammMyqm5Kq_FzfJFSafg&oe=6ABBC61D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hij3rzJ6KOcQ7kNvwFCP759&_nc_oc=Adq1tHTk5yieUhFnbz1jzSle7YVN7OggyUj3LlvlIxP-T-pCy9OuoAsW1wPxO_gcJY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2nMBxeDACRyZqMWQOJnQJ8Eh2CcBeH0O7zI31IsCHDg&oe=6ABBE217"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XuQU6PZGjEQ7kNvwHynNU7&_nc_oc=Adp0vo53SglayW2I38dIEV133fSfYOJ1J9K0ALj9oQP8pDdcX0HYnm_bgRQkWnXhI2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa6UsqOEk3atFLqlH10Xuy40A4E05f7McQ3KgvxR-IUA&oe=6ABBD172"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcSN0G1nQFkQ7kNvwF40UOD&_nc_oc=AdrnL58ucHoi5UU8d3eVqbLgFjBmYVIEiA0P7Mp4JERabCru-Qg1uV0c5xeK71YJx7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpyt0sl4ooSvOrU1Z5ef66PqTCebu2cvpYxd-rLK715g&oe=6ABBC0A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcMp7XieHzUQ7kNvwF32ph8&_nc_oc=AdqWalSa2CClgoR9l5DebIVeijwlk0qzY_WKivdz_u-TghAqxLMcO29ZHlFoMcjJBho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvie79uFZrQ3ogej-m4epVDn9Y2fgFOgfA6tXrKOrJtA&oe=6ABBCDCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7T50fzCs3QQ7kNvwERHRd_&_nc_oc=AdoKoevAkNlMiXODe3tYf__3hC7Hers_q8-Oz-c9qyelx7lRrIA1JTVG_dWCGAkBCeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9DP9YB0AU7H2K6VGQjV17bQ3Rlb0X14txI50znue4zw&oe=6ABBCA96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZZl9WqGGnoQ7kNvwHyoCe_&_nc_oc=AdpoQhEOfDcrfpzr7m_e8ABxfWGWZeHd0JoXXuES_N8JNP-1amaTIyb8PrCcjs0ap48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr7T4dPTMxcBCOC9I2SXrUNR7udcqY6UYasn6dfxxEeQ&oe=6ABBB774"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
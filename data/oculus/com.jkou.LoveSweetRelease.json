APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL_Taf3fxRQQ7kNvwHGVzBv&_nc_oc=AdppFkSBgbMMgJ0Olr0JjciBsq5U4yrJn2__5oGFG3lYVfhdePMRvHoBcYSLPtv3yOQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWr7ktPxDUIG6elOAYENHoM6dFRckcsABfCiu54wznQA&oe=6AC905EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOipKQ2sVLAQ7kNvwEUVVvD&_nc_oc=AdrpY84Y0BQAdFiWAN77eVrxCgS9jkZ9xPDn7HMGCkRi1JOncoZpsTpZZg1e7oFFDvU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM03RD-Bvn-pyxRI2KBMg--Jd0554ta9G66MxBjri56fQ&oe=6AC8F51D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPo9pDYc-bUQ7kNvwHlbLMm&_nc_oc=Adotb7gvMkmhd1F_ehWWaf01-UYgLuwZ90OI5pMR99L40JTlNSvlleIBeHctUEFj1KM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXhUxddcyNTdfuleVc8KqwdB0Sgg68cnEe1K6uggx9uw&oe=6AC91117"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g15sENREOHIQ7kNvwGAeR8R&_nc_oc=Adqp9wo2SQWIjNrbUcoIWhIAVxnm_3SiSbp_ScrRDaIve_raTaD94HYseVvQcSIJE5A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXQ5pCqeCsCHLqBMZKFkeb9fwc0qzSFsJy8JKPrONbZQ&oe=6AC90072"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsOFNitSfXkQ7kNvwGRYuot&_nc_oc=Adp4BI4qNqHl7htAHx2DlEv3AP9bWia_OBJHg4flv32Y-z0nn82-skdUJoC2AmGWb38&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaX118bPDliM-82cDmtGUSDHqbs73vBo9Zg-5i4Z59kw&oe=6AC8EFA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy-0BEG-tUIQ7kNvwFfHbAH&_nc_oc=Adpff8T8nHyCSOVQyl09IFNrNzIyqaQQg_QZmXYP2SLG7Rz8gn-nAunqpM5WanUJzvs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSJu1bXNmjgdDzokQOlGhNWKMbwlBQ2gRgDvY1nSidAw&oe=6AC8FCCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4AMZ-6SBFoQ7kNvwG_FGxz&_nc_oc=AdrDbSBajifnIjg9KBb4eIqiEG6G7O0tnFpGPNWqiVLhr-4FE-pNQ8b-vbyZ9G8Flxw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3MAjcB-634sFB1MSAPciL5skYpqNxlWfJEZS60Y40Zw&oe=6AC8F996"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrq_fViGzJwQ7kNvwHo0BlK&_nc_oc=Adpyl6vPLdbxIC8sSNwA4tAlYVm8XqGcW-sUBLxfZzRduEECpenk1yJuvnj94AAM5Ro&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFel3t8OFlItd2jaYkjBEfGUaJxXpc0x44gbYxnRGxMg&oe=6AC8E674"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
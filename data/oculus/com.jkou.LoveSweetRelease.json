APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bysCRlBVr4MQ7kNvwFcTL87&_nc_oc=AdqSEMGHV_KlJ3-ces8NlKTkT0SXV5hZ-RkO772WYtdWNt31mElPHSEZF_O9v15qcH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHGh5BB-6A6f0jEwN4xsveqs17_fhQS6zFTEMDr0KS_A&oe=6AF5D8EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4zswJJ9WGUQ7kNvwHwg462&_nc_oc=AdoRhk7YXW_KkT2gvr9Z8qzLB9Mgj0M0Py__cJvAvzjvtzI31f_ePxyQgICqDDKnwhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJbecIS_giPTS2vtJC6ysBytBUzyDymTpm4igeOcxeFA&oe=6AF5C81D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFhq8P6PZssQ7kNvwGc-meK&_nc_oc=AdoK34W35q2JhUEMHPggkMCc822xdh7B74X_8_VfQM49_ofYq6FCy3N0AxIbOH_l7Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrrFxZuFyElmmXfuHmY0Q0uwRXqvqdpzJWNe7puZxneg&oe=6AF5E417"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glN1RjUvCmYQ7kNvwFVLRW3&_nc_oc=AdpCS2OlCcy_en1mAuV-EMEZJ5UCv9Zw9tnP6w8F6_kXV0mZ91vUaLtmIJP5vz4Yiqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLyZKM8EILuOiufBrEYZjhbsgqq9XJICbiqoOlZiOmTQ&oe=6AF5D372"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOi1w05VFZcQ7kNvwGy9Vjn&_nc_oc=AdqNvoekGc7QcmLNg3mv7wxFsqzsxJp_SCxo1CIVsnC9WJ8D7sT_RdRwlTSsMmBHlPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBq3AqX7HCSpuLx4SvYZ8dgIuJkw69MaZZRymePqjhog&oe=6AF5C2A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7ESA0Bb0BoQ7kNvwHJTYDf&_nc_oc=AdqlVB1oJ7JPbgabAPyCcqmkZ0qHleHMaTy_ermsgbdjo0xe1fI2AlX0IgvI4b8Zrp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUg48Q7sZ4EOmvqJt9ZJXElSq2dlr2WiAhRSvNTKfJYA&oe=6AF5CFCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szF1pyPsDswQ7kNvwHObaUs&_nc_oc=AdrS2yX1OdeX22G-mCElMmPVjaOfAQz6tNURfFf9KuIgR3tjTDIRa4g16Bir9Qqw4Xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLI7lWc1UZYYo7Fhn_dgBeJtFaY3xHO1LvMH3x-Z7Luw&oe=6AF5CC96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhZ03DZ5EHQQ7kNvwHqAvZ6&_nc_oc=AdrXnf9AM8jkerskK9s2m0NWgbpbuRIHSxNi9B-uqhFdT1a6zXfz_GPXm-aVu8w_4cU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVmVlCQJ96XM6cbb_xDOg-NWVd_zwd3e2GoKUvZcqQ4A&oe=6AF5F1B4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
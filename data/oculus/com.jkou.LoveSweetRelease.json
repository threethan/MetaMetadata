APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7LuOqXrm3wQ7kNvwFFBCR8&_nc_oc=Adq_6QK5CsEluU0tYUfxyfD4GNfAfvpX7SR-J_akw4pUmX-PLYBmOVgyh-y1cdxQkJE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo_Lz3XYwRIFh96t_ae4RMGVbnh0vm8-tvqV8C87zD0g&oe=6A8AD72F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYcBWIyKOsQQ7kNvwG40PaA&_nc_oc=AdryNQ-UzB1ccq5eaQnxwEreACO9g64xC_uwJeLUyj1WEMb8tqMYCUrXK_-tl5MWT8Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0_NpRIv4ifAsJ8yvfYewkDHx0pH83zcyMp8AeTbpG8w&oe=6A8AC65D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOx4bAL6PhoQ7kNvwEcVRIl&_nc_oc=Adry38PSqo0Y0vY9zShHcsuJISqSkCm8iEvyAt9xLDFFvnOhA8_k8ngNBjySO4VIqdU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUdYL2luVfh_ekfxOiPtFBmcx5UKnVeIYQE9X9Iw7VTg&oe=6A8AE257"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miPxtVwlNkgQ7kNvwGxJJfL&_nc_oc=Adqc_FDE-1VfLYA28DcUwFsmBUyJ1CydajIzsD7PKnPntL_HluM0pQPXPimUj68EsVk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF81B8On-AURftDJP2y4UPuaBEPuhcY6enSTJebbiQieA&oe=6A8AD1B2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zheqjuja6EgQ7kNvwGx4S6y&_nc_oc=AdrlUQxsxzdb8nvITCUBe96MGwDFcQiVCea-nuZBO4FkZ7-Lf75Wj2Mt2Q91-AYgC8g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrRuj458neevRtYmrXESLKd5JdZWWR7TG2e_NDDk5rfw&oe=6A8AC0E6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtS1gM2eF7QQ7kNvwE-9kmD&_nc_oc=AdqFE6lM0B4pmCig5lrpmzUZmk2C4i2g1crFFcdLvya-PJet9KojYMEhfU1f2ZBD3C8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxgscKDB3fAuxrJKgpSRtAG0gOJXYgSEyfqUm5umhH2Q&oe=6A8ACE0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0S4SpWCqDEQ7kNvwGbSGai&_nc_oc=AdoeAONRHsQ0Mhd1K8fyuuaOgFqbcvnrOq8bdvWHPyr2oR-ioK8Hv_RbvWzEC5mw7d0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr93C6sogwJ-AQOvvY58SGLyFoSwuAHAlCu25pT4NAIA&oe=6A8ACAD6"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1KJpnEn65gQ7kNvwHAvxa2&_nc_oc=AdpnKB3vNfkeVnMUVyuhnoo3zlxr6kURkuKXnrO8GdWLMIb5qts0kJWWbVFn7KierFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFArVWpGhpjOO6FLGlafPVZz67dNcMOKECObP0BdknxmA&oe=6A8AEFF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
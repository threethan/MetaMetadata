APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSc6_xeAnKkQ7kNvwGc_3Cz&_nc_oc=AdpJGbqRloVTdM6xIrkqb-3prZal1B6OnEpOnY7e1YJSP6r0N12KpsZnFXtsAphEonY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtlTmBL431xZoQ_CrYyifKtubawks3s8fxrpIIaUqkhg&oe=6A58F66F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXm5RmiXVwIQ7kNvwH3Fdy8&_nc_oc=AdpvH8rM8Ql4RdCmZWCjI6kiAFC7tX4Psn3fxu7FJdnTM1rPoO5A0B0viMCZ_hLqOl8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPcmPtf99iz2qFS2SFv3KBYLN1kL4MAUoG3izxTW13gw&oe=6A58E59D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N64OV63_el8Q7kNvwFDkAMb&_nc_oc=Adp8uknC4pnlUOSuNNyE-eKYHz-LWnvmNC_Im7alt4_1tpmNRw2hD4Q-Xf30maeo-g4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYQC2MP-1d4Gx7QAwk2U18KylVU-fU8bQubSXalWCZ2A&oe=6A58C957"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvW31i2ESB4Q7kNvwHZKSdn&_nc_oc=AdrY9IstnD42Bv0nPqFBBKcD6wrmQs5Suby43p50Es27DkZVPZwLovMR0ogv5DE5v2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh5ImhphFUr8tqUbipmrJ5F9LyelOFqFJiSAc2jezj7Q&oe=6A58F0F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ejvRZhBEwkQ7kNvwEsxp5H&_nc_oc=Adr80ndbxuaMpsel0RctDABCW9tkTKWkkleLzJElJ3_tyRuKUUjFo3DLEMej1dXWkwk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj9QUntk6unbqZcflLfSHRta5yhQwSZPM8UMI576G4mA&oe=6A58E026"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAvUq-5G8fkQ7kNvwGuttOA&_nc_oc=AdqkJBLoNUtCEv_KXVy-Y57Y_Fq-1Yw6gCU-cC7d5lAcnpxqKHvkLj8Fsp4Pkb5lx6w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1otzalHvDgfj6wabWF52rJGyN_siYPvkYd54B4Wkvlg&oe=6A58ED4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS2eYYk75MUQ7kNvwHwDOsi&_nc_oc=AdovmGkCaHq2Bfi6LwNwzo7fOexhroK2kdpMTc4iloSks-Wwt79ZFh3KNn8oJOTpOuE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0C_9EqFWai_p4Wd7e4ONksRLsaLJXeA1qPUtHP5sShg&oe=6A58EA16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1q7Vx0vAIwQ7kNvwEaBLdY&_nc_oc=Adotqch25cxg-sfX0rw7svlHzrqFOKjmyoqKswWa-66Ep7lhm2pKaFoKLZbyVfY4eJg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo-1pr9052flXCMwiXP9M7Zx8Ccu-WrBGOaSkwmeMT-w&oe=6A58D6F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
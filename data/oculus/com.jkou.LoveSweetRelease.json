APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL_Taf3fxRQQ7kNvwFKbZ4P&_nc_oc=Adp_r7KRkUIQ8q5998Ec7gwhWfVkmPBWHhLur75qHrBVs5ZMrb9CKlv0tHmIUYAmrQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp8TI54USjm_6z3z7FYEm4Btv_enJybrB-wQrkUbnGcQ&oe=6ACBA8EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ13dTcFZ4YQ7kNvwF7jOya&_nc_oc=AdqeD1oTyZ4wTRFZealdKpkEXBFMX01-hZBn4fmTIf-HbRuxJkRNoYbkBDx18c9eEdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJMNwzuBTrAUu-DJ0BItKH89Ur65hH4opHapjOtjam8A&oe=6ACB981D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Y1mj2TnNo4Q7kNvwH4yqu2&_nc_oc=AdoF3cUVs83s-kfVsQ9yYlJdRwyCvdXbqWHu2K5e2s0eSgrfyJEbTWVsmtr4g9uPm3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIDn2e-v1wqtZVOayQJDFAfQkea2530TGwRbz4gHGFKQ&oe=6ACBB417"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USsflJ14m9QQ7kNvwFummGU&_nc_oc=Ado7AKo7Ybu8U-7zeXKdoLDsBYVnX_Zu5kg6o07nOUNvS9bvBRxUmBKDyEoewiS0A_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTBNyq9YpYMIgJx5R6Gztac5aeMiLvXl7IgNTPyuharA&oe=6ACBA372"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tEC-K-rqRcQ7kNvwHTROg3&_nc_oc=AdoEn96ChBKaiZnpfXYnnyO2UlRe5RRWuHzPS16gWt4jp7fllxLMFmS6_wIztLLSB8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmFRxYlVjeMWCkSw2Wk3JFEFsezAzYXdBmAseWt_X5hg&oe=6ACB92A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYKbHKf7OGgQ7kNvwECAE0E&_nc_oc=AdqWoocmYhLDPI0S9IFak10L0wUxjq8dxM43W7wHoXK5ySiIDIVJ7FGA5gWBrJSvreg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvt2D7QwXPLE4Iuz6nfGCCUxnqlU_VDuCMwkYeZYG5mQ&oe=6ACB9FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSOpyQZJzGgQ7kNvwEbhz3H&_nc_oc=Adqw2KWOo1lMnELiH4d4g9WDIXB2XXZGSe7Dzdsyn5jU_3NPLYK70R5kTheaATkH3Aw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ_boD2kLZVq71t22CxoMzo9LfkW9VZZ2v9KmE8RX5hA&oe=6ACB9C96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfJvIlsnVWsQ7kNvwEi8sx6&_nc_oc=AdrLPXgUDf4ZSnfVfMq97CTlt5W4P0GPpWmF6f9rPRqZRPj72nTSJsZYm2KdeP0Nq1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOyuELQrUARuDuZh0Uxn8UF_0R8YBs5h2hWI1E8JRpPw&oe=6ACBC1B4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
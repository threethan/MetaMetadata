type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A2nf54rSTIQ7kNvwGGurz_&_nc_oc=AdokbPBPC0HHdA8fAOIH08vN6U33b3xHFNNDZV8p7zqF94k97Zgh4DPNcOoBj3zGtuU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M8AeRgv1S4m2WV9JBi13OUtcuamD6pajTdDQcJxzIsw&oe=6A39526F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyKHhpjzs6oQ7kNvwEGyvDw&_nc_oc=AdpLVvsLFDtBOyw1YNwYLZlxI498wav_ZP2hlhrd4DqwO7q1Y7_iy1ZOFZOTQUoCoyo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AAx8guikZDCaAQQncmyYL5PHkqZwzVsL2SJfkwN3HTw&oe=6A39419D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t5fmEptH_cQ7kNvwGylPhT&_nc_oc=Adp5RniWkZXMQkoFRiNm1cyQPmVDis7SkEokHbX0ny0evkJXQ1mqWIq4fpFbbLLbPpg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-52bC9lg24sS_h4J7MioKGrpCSciTaseMsQqcRmfAO1Q&oe=6A395D97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvWrgHXlW2QQ7kNvwHuHdhR&_nc_oc=Adpan2bAffsmmUR-NB6pZ05UaleQC5e6oOGaiF-gD3OKCK2g2ddJ-ECxmFDitie8fco&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Xkw2VtbBVYZDuczUS-l64LJKYXDhW_FvGrHjp1rmkQ&oe=6A394CF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOSQV3XlTIgQ7kNvwG9cFxs&_nc_oc=Adp3ZmUcf7Ss91DMQWV5GDn4LP3iWLB0fMF7f-bADZpGvbbTJXJcskeD6ixrVY2wzl4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ES0YMfocVRugUdGKDHK_Gi1ErK-vW-RDVYIVpoWjVAQ&oe=6A393C26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IfP5iGL-6kQ7kNvwFE_rU7&_nc_oc=AdpeMK1ahQ_b9nih9v59e5g_Ad1oyKvTgC5wndftN1I2RI-hiUNF3AFdJ-25IFlUCzA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kXDoINnRKsdJ589X6GqIQaXGzd_aWf6vQTlbT18JOAQ&oe=6A39494B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScCL7w3C5YwQ7kNvwGZ1ZYX&_nc_oc=Adq_12NrQfjNsDmb9szmIgcv43dJBQ-m3ECdYn1kYj6r-pUMXW04XBUlYL1mJ5Mwzjo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j8jVvsvGxl1NwHv1Jb5lNV4e3hBUpmmu6NTIJ01GGHA&oe=6A394616"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2RR70Dqb3MQ7kNvwH2WxaY&_nc_oc=AdqDjG_zoLcMFSsUdQSd9Vxe4QiOYp9ogNxt38JcbgwRzRrsgC-ekeBAVkvSGk_-Bck&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OsyfQPkfUeeQ17y-q3bbDiZGlGGcvnSiHarucKDXaRg&oe=6A3932F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "AP
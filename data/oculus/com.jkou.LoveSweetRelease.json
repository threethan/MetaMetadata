APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9eHOFBP1FcQ7kNvwHJ7otI&_nc_oc=AdorN3_hgmW17lYVU2ugaIXpoxM5ASPqYbBlupwruQTlR6LnQXH8EQv-WApxrMRHk3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUP3_hbUtlAbZBbVhDiKzdBkoAtLnBjBm5RLrVyhKFSQ&oe=6AE606EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsSXdluVe5oQ7kNvwEcWMwP&_nc_oc=AdrutwMn9XiU7syS-QOJiIgh7kaVjjFysEBTUnZOiy0OQ6Eu4APV0hTb7k6hzM3B-sI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNERK7lLHPFyOBtb_OUt8UGZUeuEWbqRlcthYepSDdSbQ&oe=6AE5F61D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0aX7DeuQCIQ7kNvwH7Oxds&_nc_oc=AdreZk9F-Myb1lrH8fpm4x4bl2APw8yezbCduUfwT271k3zMrf566Mc7HRGOWcUE2Rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq7T_IJP6DHQcUTJltMGHd_6umavoWRg0_vPhqxxQ4CA&oe=6AE61217"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0w3LBLLibIQ7kNvwEWqrs5&_nc_oc=Adq0LPng3sD0GcT6KHhwGbMsIoQWcy9zbWK1Ox0lEJiin67SdGcGfJpy5QtFwdJq5Io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4jy6ZZLqot03HFnV0MrALdh6yVmJKlfTbfnK62pmiGw&oe=6AE60172"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5op4g38wq4Q7kNvwFZ8RAn&_nc_oc=AdqaaO44busCTWjqxdze9sXZ-D1WpzjiYiwiwpkmoCPdsocXaHiYIdMxZNwB88GQ958&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEcOSvn_7L-YarbExKZz7IvaOAzKE011mhxGgNawnNOg&oe=6AE5F0A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gl7H2-vdzYQ7kNvwEv9E-3&_nc_oc=AdprLBOjKhSVFoC29jJFeySHL_TWZ69O5d8OsOTKWDPQsdO_fi31CtX7DEAAPsPeXWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_QmBbvRcUTL8-ROwxX1YMyGQNBbyvB4GbctQS4D7vWQ&oe=6AE5FDCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TslH8HX7nnwQ7kNvwFuuipx&_nc_oc=AdpQuGul50kwz00ggdCV2fLdQpomw22tRlPe9towLKMTSb4wBshzX5TBeXGimOWkL7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKInDUAFaeALmq9dYvngeNme8ByHgHZ6vRYeQjlzBb3Q&oe=6AE5FA96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4BPEY1lI4QQ7kNvwGXTqQu&_nc_oc=Adrcu6rI0_JgLjcSkwrP-GunjvO0cvfHKbLsFeib78ewH_dnZbmrZDxNpuVyl0em1ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtQMDXaqqsqb619DPemHMplLi-sG9z_gSb0RKhOncRuw&oe=6AE5E774"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm9-AjBwd-kQ7kNvwG3gIv0&_nc_oc=AdpjLcVLysMT-bsgcmAQXJ55F-amqvRDkZlEukEuu24zaK60kV_kIbZQHLL9dl6kk1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgi2FAoeFcoWLSTNHlCpQGlht3_7-sqakgGSS4BEJ1fA&oe=6A804B2F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFvAf74YLBIQ7kNvwFYGwKE&_nc_oc=Adoi0z3BiFFv0rRT_28moPbu9eMMTj3TT0pgTGzyOmAanl6YiQe57SeXy8BI9L64UVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAMLkhzWJYDbaa8BB0FIJikYmR_m5a1BBzlLDSnqWjFA&oe=6A80729D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QqulnA4takQ7kNvwEEIW-K&_nc_oc=AdpE84Zy8W_1N5H_7O4YLK1_RORAceFxFk7tOJTWYPQk7AIkZGcVyQZkf-i4EU3KzTQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjNJ2ZeOE7_scP4BqTQfg8ZKhOD96QT2ikAV7CfEB0_Q&oe=6A805657"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VTGOw6tL9YQ7kNvwHUet87&_nc_oc=AdoXHALyzp7W5NNNVMJfFZr4nnx8sK8RMR28d3Mi_h3RV9iLruHz_OOAOSbAySqhaq0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIOM_UFMqcRCMaeDhipVbUvpZ4weNyD7kTqkMbEBg_Bg&oe=6A8045B2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fs5nXNYdM4Q7kNvwETMHmR&_nc_oc=Adosqz2rRS0vVa7FuB6ezg5PCkciiDn4aq0v05NYnaJ2B8fnb3bF86gLy8KGcEEhZlc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT4FvQZ0zx48KkIzEV2Fu4gVi-Ivw7rHGrgZRlA_MOHg&oe=6A806D26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV-4lgfocu0Q7kNvwFSVweL&_nc_oc=AdpqBn3jjSmgbejjfM92bDia7JPbGMhzzWCPKcpQVSOQj2roMpIF7VorgZMfwQ-ytmQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvcIvHaq7WRgRx66orMf31hqGg6L5ZgbkGcFRAjBlZEQ&oe=6A80420B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM5gYY5j7hMQ7kNvwGKBV3z&_nc_oc=AdpAObUeNh0ToGBo-_iO0wvr6a85Xc0pmtnbRBBccJEUllsUsCKdgBCkpL0ywgioiME&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEND6sybc2Gswwd9_5-HKBMVTjpitoRH1Vu3N3I83qC-A&oe=6A803ED6"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT8648GP-KIQ7kNvwGaKKhQ&_nc_oc=AdpkgeLwxKDavnouaaody7CtWyXpdV7tYZT6n9UvB8mAwiW_VuECcLSdYiLWYoVfozU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdN5bZUXNbXDujonZma4mTtmF98txE8lWWf6TnF0e4ZQ&oe=6A8063F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lJEup0Sv6gQ7kNvwHuAs7v&_nc_oc=AdrH1HgpK4U6RralAYCv6CABuZGiywDlWPo-HQ6FNBtwOZI8PyjVX-RuRDP-o3SRONo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7bn5LIJmZ1KfsoGXKhr5JMm1WdnrsU811T3hfoOPZcQ&oe=6A63826F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtThaC5YGZ8Q7kNvwFB4rA7&_nc_oc=AdprzY0CO7QjvDhqKoaxqew966MRbWkoQi3Q1YpqL0X2mmt0X-GZGFfeNRJX675-rxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvp6Ep-7zTKwaQRc8HgcsocpVS3onzIZvxcreiw4Nk0g&oe=6A63719D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bNWJcj4WjIQ7kNvwFhtc4J&_nc_oc=AdoJ874O5dd0cqXu-Yhu5cjH8EC6q2jDbtPcC5RxoJZd5KsaIfdxMn-H2bFq3UXejY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeGYH7iDkv-roTyQZc6MpZ1aay2Q1XGNAHlvh2sLDi0A&oe=6A635557"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk3_tYJh3s8Q7kNvwGn6iOK&_nc_oc=Adpty_ItvuWJ9ERSSsH46M2lPOLH1UYP8xt491206ERhOd08HiSVTVllXVragHVC8RY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr1NJnMqe7Xt0MX9U6IARcf-R0omubNXAzBNMGwISCRw&oe=6A637CF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSvFfM40DpAQ7kNvwFYDhsa&_nc_oc=Adp6t2hDqIy8fJtKuC4RjKC5R638svldOsKIiMBrFDDZJydu-mZTGJkyArTBi6QXlcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXQueziyf6CQ1_ofvs8j5-cq-YqlSflJOaaj4iqATPlg&oe=6A636C26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIk2YoYIeAQQ7kNvwFcunu3&_nc_oc=AdpYTCNPB_WAJlkS6IImWMHbIIRxmKhRhL5jSrLB2I6gjsyNslZ4Oko6PJYAIRQCs78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT1LfiWn1SFea_AdcRyAUOliSy3PoZIRHXwb2UZIGNVw&oe=6A63794B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RcqsNbS8KEQ7kNvwFTuHpc&_nc_oc=AdqIP36bg92kMugOKX7Oa99U0etpItnPmZ2j54jNvWLx-106oWyW6tFTPFmtDl6z-Yo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJe5eGiJ3NfDMnU_jLvMv4tKVaNU_4QugI2gqYvEjZ6A&oe=6A637616"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YOsrhrsoQ4Q7kNvwFoJIso&_nc_oc=AdrQ8JS2b_d3cbmAVOtodQ1Lb4YrrnT7Mf0srT_wZGCzh5WORoiOHS3pmgmFs5z_GPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTHsV7kdDoE1w_qNjJRreNlSVzJf9i743y1PBF12BV5A&oe=6A6362F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
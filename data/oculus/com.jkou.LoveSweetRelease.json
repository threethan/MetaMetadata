APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCtqLWI4ogsQ7kNvwGaE-R0&_nc_oc=Adpj2gpjF-icTXq5k02sVVyIsAuXuejRhHCF_v7Ja8oqZB8pVeOwAavBswALjhTiG84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0E4JTInpNcVABllAoLAaZ4mlTtqEIL4MUSNgTLsSfQQ&oe=6ADF6F6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dbrk052PKz8Q7kNvwGRwqdC&_nc_oc=AdpwbzPQ4M7NII6YNE65pfcDzLEwFum1faE1eYzdfbx7S7lDc8NHLYiJw63gI17Gu7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz7DUKkQnTwurIAOH0LpNfGAJwcx-QS_rnqQ4oo_-fXQ&oe=6ADF5E9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92Uohx9fnF8Q7kNvwE3hL2M&_nc_oc=AdoFWEuzSYx5GuofiUyU9gInoVN9iAbhHxISJUKDFFrvchoqE4d5W_Dc7w_6ItuGjFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo0j6_r7sV7BSuvqN2yoLoGZStN3F9etoSesKlPMx-0A&oe=6ADF7A97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3YnPtGseL8Q7kNvwFg1NB1&_nc_oc=AdrlEr7jxczH2cZFoWFc3j-TCbAGKXBUB9t0A713oK9TYRjN2sCOHn4osXL9AVPyV7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-VIYChffq_fS2zViEQ0dNM_igfY9lOcw2Oa19GiA6GA&oe=6ADF69F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhd_c4sIunoQ7kNvwGwuhJJ&_nc_oc=AdoTzRGa6jjazCSv6zE8iGWnnHOPbx5hSFv68UJfWu_gUxwjumpsTF8bZbo3REk46_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5uJFybWBMyTOe1-3EgralotDxMK4RKlvsSn4XgIBT_g&oe=6ADF5926"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxHvyaDUc40Q7kNvwHTQgUj&_nc_oc=AdpXd1M7bp268GW693rst0vwbkziwmguWcK-UrMElY9wHiSvvdir667RzZ4gVCYXI9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_4NXHQch3reI8sArKgvLf51C7pi64ch3rWvmLd8950A&oe=6ADF664B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLFmg5uK5DAQ7kNvwHM6v2H&_nc_oc=AdpBtp4fZsO33HG6RORWXsEMHNQoTIvRnny3B0QE16r793AUlr0JDsksAGaIX8tS99w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvW8Jtuma1vv4x_Zirn7kgB_iugdUaHgwoz68UijhitA&oe=6ADF6316"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Kk_L1p7e4Q7kNvwEVCbP2&_nc_oc=AdrJLOniOuGCtpwyBZOE4M1hHkiWYqmy-zITXxwiSbVHmjJXk2B83vL3h7mvFv8Y2TI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzEtuU_2HGn1Bq90qZM3XTRgHNJjCt_bDG928Mt602XA&oe=6ADF4FF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bky6xLxr09cQ7kNvwEOKz6e&_nc_oc=Adr2R7jXS_rCGmI9kGfOPEM9F4_rFkeR0uCwRHlMBtQJjHxKNfHpWHrmv-_RzbuA4_I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzv5JMkiXa9yVoY62yg3IUKVtr6Qsa6rlm5qJgyPY6hQ&oe=6A819CAF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFvAf74YLBIQ7kNvwErhtcU&_nc_oc=AdoP7jQroXuH3HXNBm4d5VAbcXdQsgDvp6HaYsT6dB4Sw06qiCwa1iael5_s1B_F0bI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY2NJTs9_jnfWxrGQfnVnH293w_vo829GIr0XMwLSeGQ&oe=6A81C41D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QqulnA4takQ7kNvwHjPMs7&_nc_oc=AdpC7LtugBGkyIeYaj5Q8ehd25nd8b7hub-L9al8ztMfPFstVX58REKGnvD7tOlaWno&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5IRSt9T2WfCuqGjrS9AUFlp5htS2jxpCjHaNARaVZTA&oe=6A81A7D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VTGOw6tL9YQ7kNvwGGjFWE&_nc_oc=AdoyPfW2ntLYSUv_SZeXeq60hbw8tMLWVoX1eh8xJ6QquP1yHfMRfzjDUpeDltVgCsI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHblCa-FdI07H7jPblafCre6CWLYb9mj0tNumHG3aP9uA&oe=6A819732"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjhB6v4XCB0Q7kNvwHcMl-Q&_nc_oc=Adr0W7yZLcAjZb9IKQjfgeYiMcXMnYfhCc9k-gblET2Zuv8_fVe6jk5EyoFJ-uU7b5k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP9iJTu95fNR_Ik0Qb9AxxfHqpSuq2Qm6J5ETOT_0aYQ&oe=6A81BEA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV-4lgfocu0Q7kNvwHZfbVj&_nc_oc=AdoTuwX9niq21wvvzuu71gSJ63xVaWzfjvhQAlrZ-XGk0OOab1mo2CRTf96QYl0lKi8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFybSRwmdec073LlcVuOajF2gEvwZI6Xs425DbJ8sw03g&oe=6A81938B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM5gYY5j7hMQ7kNvwGFVYEU&_nc_oc=AdqIgmuW5rL_kZwgWwXVQzsQJAfYtwCBGDPEdqFc8C5e6Xu5tUBLYjEyX7Pu1UtsCzg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6RwV90DpxIcqWwVUuXrAOc89yb4KtRoWhQmbx7TH94w&oe=6A819056"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT8648GP-KIQ7kNvwF4J7YS&_nc_oc=Adp-rlRslJrpDvTT8TJgQm1lAWPXSVKqCYv6wXHAyab0oavGWMrIMt45ILXC4-PXK4I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIu_T0gn27a3HJe9AK3dzNujxklPamf9bcJSHvIa7x0w&oe=6A81B574"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
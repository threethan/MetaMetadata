APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNYfzI9lA8AQ7kNvwF7VqOK&_nc_oc=AdpQKVWD_HCP6sMipOjT6BUUFQsTlU0CxMu8krjRSGCrzgurGgup9AyAvrBs-dHLmJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkZ6ANOshbdiGTcG5gjpowwHoNNDNTTC4jLwM22g6BWg&oe=6AEB4CEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIkIpYjGjMEQ7kNvwFefmAC&_nc_oc=AdrifyfL-kqeoM1UUoGcpx9cr_yOhVjsV3emAV4mL6osrvrT470ONX4BbETzx-jXwRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJii0Am8sP1h6plfrXWRD5Ic8kH8nYyvF9ZomDwzauWA&oe=6AEB3C1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUyaUNER2zkQ7kNvwGgGhlI&_nc_oc=Adozwj7Iii-b0XDhFKEMu7AQD3pfKZZchSE14bBk2DCFf18PsKUjGOrfwQ5Um7COaIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7jQBqnc4denr9hUo4G49VHR5BohUlfpKa6H3Zqd75cg&oe=6AEB5817"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP8a4Wm8JP0Q7kNvwG2U-_2&_nc_oc=AdrR1ec3HYlbvxBvqjqVvomyjSNjFAfrIKSfFZa9-KLXUXgv6P4xnuGIDGa8cDwHYnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4u2SInlT-wdfLqkMTCeflcVk0l4GAVj4Ak9wBTtt_Mw&oe=6AEB4772"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9kzn_8W_KUQ7kNvwHm_P3W&_nc_oc=Adpdmgz6PRLvGxx2Z_NwnpnhFaqEh8H6TL-pEEA40IVU5N_Kg2p3UXEt_dTEgQaCyP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8TNsgEBzMpIkacr0oWptxGXdWiPMlAEKqpMjeMJjLvA&oe=6AEB36A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1tVUJ7sgfsQ7kNvwFEt_Gi&_nc_oc=AdpmZ5P9bY4cE1et4WX_6P1Q8NokbvNBAEbpw-tWqHhW0d8L3mVya_bHYI3L2ilsLag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCA-A-arB1T4BqjddXU2bUr_A965fZFJttwUbJWi3xjQ&oe=6AEB43CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7qj4-tdNoUQ7kNvwEhA9FV&_nc_oc=Adpzdk50f2if9by2s6DpuvBFqonvwOF2CtBr6TWlV0sGit3wjhqjSrBvPIxzaNQAgvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1kI4PohxoGgyG_4ZX3mk_il2laj-DiljvvuXKsDekGA&oe=6AEB4096"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M-sRf54jYYQ7kNvwFo4fnK&_nc_oc=AdrIpUwP33RJ_O_JKfEfMPDn9WOF7Gt-Lm9zFtsZfyku6P9n-90zdzc22LLOD0awIOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg9AvMnLR28eLAVCmSmpzuv_SaXHZIbJJNpVDo7_uO5w&oe=6AEB2D74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
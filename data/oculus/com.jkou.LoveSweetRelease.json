APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92ENPfN0x74Q7kNvwHWYXcf&_nc_oc=Adphl0h1EIHmHwIrON4ovBw-0S0z2dtalX6Voz7Fmg36-yHR4kaJpVKvoiNaeMUAATw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_jX9UW4YceOWQiH8mN1tJd3QfHfKZH8HHt_d55nM-tg&oe=6A74A5EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u33oVMGBs24Q7kNvwEkNOT9&_nc_oc=AdpbSY4zezBWkeoImP6-DZa3DM-aGzmYv3OS2ilqkgRoznP86MIueYxvN5hsOy5PxcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0Nexg-HGWe1Ym94C1hsmbalaRFbKkN8GXuHaq0gOlTQ&oe=6A74951D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYgz8OfaA3AQ7kNvwEh0Auo&_nc_oc=AdojCOZtehgvcP2uT7DjaY4rCdOOYhRe5UH1JEWIxf3NfH8gHHSo8a97RnaoMv8pZAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe4DkqXSXnK0cIvbImRe_lgx_7fkROS0E0-1hHfN950Q&oe=6A7478D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JElUTBrsUTwQ7kNvwEyByUV&_nc_oc=Adq4jiXX3SVuJpWe9WLwG8VEvrKja7XJl4JGMPz-DP7LZhmkniOvPckxCBAJpkW9s3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcmviiTgEgz4Jv3xfkIKxk9mM_c9ezwNmUMw_9GVyL7Q&oe=6A74A072"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbjAAnncvd4Q7kNvwEE8yyd&_nc_oc=Adr4t9Ho8KPE2rSYDrmsCaZAxRPmaz6JdR5rfVBz_liTMNI347Vmo4SItOrmTYfCzE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuaIigto0UrIFzYnOYorRLXD-oFEsCohCcCp6vg8yRrw&oe=6A748FA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRnPRhAlkcQQ7kNvwFcsfWY&_nc_oc=AdrL98XNgIg2wunOQN-qrN2WEDh5B8OXGMIUqBdvHGR_RVQQLtn1JaTCi-BbciVHGaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG7uv-kdcpbx66nctSOnjz3FaZ3MwMEEQ7f5bVLj5pMg&oe=6A749CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sYTnqT__20Q7kNvwGT_vkp&_nc_oc=AdpQET2HeJnE_ELkwiF8eNMzBOhEreNhoIyz3oH1KEmWo4KtKDv-_G8Lrw5HBb1OdOM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5yKRz9kbMWlrAzVeQSgEQrHKUsN6oQTwGRhvBTl0jjw&oe=6A749996"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqJxDz8rosoQ7kNvwExA2jc&_nc_oc=AdpiVGH8yzKJPupboAZrs3nAhM5671AZySmsfdOMGZAnI33GvtdIMEhknli-zXZcvRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8dPtqJWm0Kghd5TgI0ow8KfJZxclXlLTWOYYJ5lWnGw&oe=6A748674"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
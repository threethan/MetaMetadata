APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ5BzMbKwd8Q7kNvwE6kOiZ&_nc_oc=AdrtovRkldps-5RtLR6N5_IxpXcjz3tAba3KMReneHI7SOd0XaFec0mRa_llp9g_gtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFuBi2kd4ktVIj69EYXUXRXk4jiqA4xfqAmieulprYPA&oe=6AF1E46F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKfib1ydwdcQ7kNvwE1qPYq&_nc_oc=AdrDi3tfDbRqeH4Wiyq3casQo-TgKTwRsN1GDKMNs9pDEY6OIl5ZVeBa0B7UzFSNr9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3v56H2dDMiD4p1jmFZr7mBaFOj9CRzEeVSieIJA75Ng&oe=6AF1D39D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YsOPcH-YsYQ7kNvwFzZSc5&_nc_oc=AdqjIbsrHM84AQkGdCZyvZfVw6TFr1VxAv-TfKV7g3y0XK7_GAwzq_jOlZiC9Hz20Bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc2ZJ53JJjSFO-OgZfhjZ3Q0rapKCC039Jz0HNlm17tQ&oe=6AF1EF97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7pFP7qa6xsQ7kNvwHuaPFD&_nc_oc=AdorhU__8iwxHBclH1aJgJDtAnlNvWc3beJvKL53Sm51pH2zlNmbo47tv3P-vTmPPqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQcyaY4OnzXWDtlOymfnzTfZ6yY1xM0ikOdeBGRN8M4g&oe=6AF1DEF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFR-hZpAMooQ7kNvwG5xe07&_nc_oc=AdpzYaAB0yxFxdAVhNMENN0wXAdE_NwDw9bBfUfXckslHMpajrMtYy25zFGRmVZQTAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfgr0ORG7t2UVJ1N2ayb8hi9H6Yl690EOEUDaZ6BWdow&oe=6AF20666"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1lyHjJE-DYQ7kNvwH00f8p&_nc_oc=Adpc_y6x-UHDlFmhQcIkuR6y_qG8_7xg3sjdBD6iP8K7CtyZAkQPQm02mpoMiNqMJY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDA_GvUVKFya2sluUvX16zbJIth4D19VTcUU3sPOvEpw&oe=6AF1DB4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ7eYP509T0Q7kNvwFJySvd&_nc_oc=Adoo_cVjRaYcOGv2kBSpyDtzCf-NaQvsVy1YWWqlaiBi9tkb_I2KzLDNBWMxlTDuCCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvnPCxsMGThE7Izi_mblzPQkiuCVTMjnLtjzUwBk9quA&oe=6AF1D816"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8afOGlblAIAQ7kNvwHgGPi2&_nc_oc=AdpuzvKALWDsjKCItECSh03nNu0h-pgcwPJtgpeALE3sQgJ0nBNMEdrAtzhLD_vJjJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyEBQfGGICK3WEqys7A_kxN2RARRKOiaUduFHNWr1zCg&oe=6AF1FD34"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
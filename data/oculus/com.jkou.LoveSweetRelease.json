APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHHdTFVEAV8Q7kNvwEmae-K&_nc_oc=Ado23c24sbljjDITjh6U7G9qdPnhv87TWh4YTttzj0ju_GPiQf8JVlzpH5q0jiuyTV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcgCktyA4MNVRV0LZsnvDEM705kpw7EVmwkiDy2IuWrg&oe=6ABFCB6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijpbFQqHFPAQ7kNvwEBy4ny&_nc_oc=Adr5RNxC2AhoHUiHFCfEWB_WPJiSkZCh9WY5EfXrLyDyGE1-p8nVSHGCyZk9SdHHnqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgT_NeCyJioOXjkoc2UwJwAUiiBBv7ShZdSwi-z3M9vA&oe=6ABFBA9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ngsacFahA0Q7kNvwHH9GVh&_nc_oc=AdpV_7T2Arq-xTvSA5MBquAVlOyLUeyse_BYHg8F5RL6fLzU-f4oLLd4Cb3eK20BF3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8364yFcua-Qi_rz2pY9vW0hRB1C32fFu0JjdMQFlTnQ&oe=6ABFD697"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVya4KFfwwkQ7kNvwGHieRt&_nc_oc=AdrtkC2TVQyeW8F11lqX7GW79ceg_tKoJ5ihQvI2-7DrVD4Hhex9NPXUX1mLpAZulf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI3glunsYspP-JGPVxY7vbuZjHcNMRpyxRqQpH_aBL0A&oe=6ABFC5F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlD_VZusk0wQ7kNvwGqXTEO&_nc_oc=AdrvperCg3AoMU_uLMR6yXUQXi13IaLqT0seiDqyYH3t7FLAnAQHW51qojkEIoYmuyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-c2JVgveFWvhckMVxLwrz9k56lwe7-_7a9LVXma3RIQ&oe=6ABFB526"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMCXIefIWRYQ7kNvwHsEwZi&_nc_oc=AdodwCTwc1YQDdQJECFSPJ5YS0gOkTlKhPCsu_i6K7Mc3rT-bCx1Msruxuuk8JwjnaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCa0HOk55J4h5yNuHYGeqQywbloSOV6NTahvaYhjH9pw&oe=6ABFC24B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzpuv74vl68Q7kNvwHbN4xr&_nc_oc=AdoHul6VjtSZzybvY7U_gGiHUtLtZGxtWT_jdtqSAu5w98oJrKoS7Lc_5WQ-leIEqgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT0Beuq6le_JNlTbtX8kX7h_WbYtms0e8S93u1oLOQzQ&oe=6ABFBF16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN0386OGTLAQ7kNvwFNrWkf&_nc_oc=AdrJhCy83_07NQ4cwp1GuqsLdPpHb14cnSpK0hvJh6b4S85SBEYcMKMILzQJ4yMUraI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjtPwnJf6d2BJ9owAlpxXHwYREnqfWuf9Er_PhzJREaQ&oe=6ABFABF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2OFbeblU3oQ7kNvwFAexJ1&_nc_oc=Adry_PdOaDJU98osxj2IXu8sRcsdjuj_B5vwMOffIC3ffnKWC8YRnbwrsyErJagXRNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdTcB4dsD23ygYtlqdtFrDIncFSQ_yhyaC4fson91eMQ&oe=6A49246F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcjWOQBZgNEQ7kNvwF5q_c8&_nc_oc=AdpuLJhoks6J4-8Wl0P3GrzPDNv-uin2owaZT7IxCheg3Ch3zMlIJb3HFXx4C8maejI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDCLruibbEZWtYY8a7QFP5Lwml9awoN6vcYUzdRBKa7w&oe=6A49139D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw13z9TGuIkQ7kNvwH4hYyc&_nc_oc=AdpkAgcsvrzdHqRc1uwbBb7BPfP1m5XUaqXMgSPYTUUdQllIAuQL6Wvi9ZbVAE1LJ28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8qMk1Fzojqlugdod6cDynl7Gjpg-KY6o9wuPEEGFxmQ&oe=6A492F97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn6kkEFoWhQQ7kNvwEBGyfW&_nc_oc=AdoM7Ozyi_hAyRK-7FHDOHjqJZXCC2fzNzb7_CqOQwvklHN7P3NE4LQKLhZYd_8nAUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEaaowToIpRrLKzwVt5am3ugWuvUXOFAFZFUgAuFqpHw&oe=6A491EF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqn8DXS8S6MQ7kNvwHH_QQF&_nc_oc=AdoqivbpsSfLYgs47ECp7BUhl-uvtBYUGUMXjGtz1nQqm7GX5gyXMUIWa-BoonQHozM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOp0ry3rb6z-qZ_OV9IJPTVq9OvNv9wKFjnHDEhHISpA&oe=6A490E26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3ZXSw1wDvcQ7kNvwE8Rhf5&_nc_oc=AdqEKXME-fufETQMzGxp4Ik9677LH7eDoZ_KPcija5k2tixDjf3atZPtsFCMFGyq_n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDncYpPmD5PPBtUlOp18vmCd1Il3Pz5pTJzrmdFLgOD9A&oe=6A491B4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBhNBq8REp8Q7kNvwGyitHP&_nc_oc=AdqLBQTJd5IRN6dWLVGv5FIHUnCZDi63_O2Tp8Lwku3i5fXI21pEum1ZDstKKFFnbRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSL8CyJaITWX_8pNtAO0NAUBoyc5lj5n2kKeod-oVafQ&oe=6A491816"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCLExp10GRIQ7kNvwF9yJBn&_nc_oc=Adpm0mkp6UKdMC9PkEzsGQIQxdDZK9XJx-M_pRqh06mjMAY4oHZ3Ls-wUlpTkv8NzL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMeKaQCvZEhWaEZeKtgYo7p9ZhKIUwcPs-fvL0k7VL9w&oe=6A4904F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
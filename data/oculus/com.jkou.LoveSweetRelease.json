APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JXczkIguPoQ7kNvwG26AHq&_nc_oc=AdpvpFhv9_zpUocLY5uBEQWxFu3mJMiuc5mWecv7lXHVeTmfcgmJDb8ThfkNHSzCzcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaoKG24h2TtJB7INU26FtcbeXAgqSVa1l2Zf3RN059Zg&oe=6AD2406F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmSpTOYvemYQ7kNvwGwVMe4&_nc_oc=Adpl3wCMEF4MCauGtsIo67K0UEwc59O3GJszLFYvq7rOKkW4QqmaFWy8_co1sp0YtZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNZTJ7r4QuYU49R_3yLVTVF0iEjsxtH2Vx7b_6Aoy9ng&oe=6AD22F9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6Zjongm38AQ7kNvwFQ0MBg&_nc_oc=AdrNv5cPzm4gMv3Z3QVxxAar0uFu4uY7hU23Uhcqfs6ivQL-ufs9cyPDWHt1yZ1dy-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5Hd7VNmQV4RIuifOluW98IQpxpn-yE8qtKUxxlW7kSQ&oe=6AD24B97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCEfp_gEZUcQ7kNvwEmSaDA&_nc_oc=AdodQiQzAtKBhdSdygHwbOscIyGGSR5AwiLALUHSizp6dFlu-EQuKamA6SmePN-ogqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR-K51Ty5edXaaQNOPB9uCGophZEGiHQfbiRnYryGokQ&oe=6AD23AF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzFWkhKZ1GgQ7kNvwF5w05_&_nc_oc=Adpd1BOzoR5q6uFQ3C7TGEmHMrvZehjeV6RscwSdy40xd38jwQFjm2EDsIcY4DNe2Ag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtdA10BaYoYefeBOumiXpQufKHYm-Xp1c760mhwx4owg&oe=6AD22A26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63_IAgn31DoQ7kNvwFYG58E&_nc_oc=AdrwFGoeA8MbcGdqKQEJad34AQg1vQOoRyVUksJS1Zj6ssauf2dBoi8h6Cx4Vnhw9SM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7Kg7pS6YwhKGEJzFKN656UdVusLb-okHbxz4JX1Cswg&oe=6AD2374B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt5-R69hEPUQ7kNvwGhP_iL&_nc_oc=AdpMNn93u1lhpctlEwMGZPGqtc6AagMzL-1Ah7f1H-EZ3qbumjaXnO2nXEJPu7CMIr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8yuxgIy-9eIikq_e-aUNOnh9lpdahYcKgxdj5iibxgQ&oe=6AD23416"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKo592mO5eQQ7kNvwGDr2rr&_nc_oc=AdogLP9UBcnt1RLUwdlLHtqF3P1pJ-efn6s-gFIk_pSifi-zq6pkTHM7QIQj3nlKLs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPFn354faFIWTvewL8DuhAbVq6BfixXn6GeH6zlTUWqQ&oe=6AD25934"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
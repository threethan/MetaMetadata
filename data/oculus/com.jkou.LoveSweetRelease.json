APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxY4JvlyYQoQ7kNvwGcYQph&_nc_oc=AdrcsV2tu7FWPj2us5p-CB6o_BuHPg9E8dKMPIgIJ84HRvtC26IEhLdbVsVh9nTQGAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi3BwmJuMGcVG7euH2A-hvj8zxMl8syqyB43y6smYVaA&oe=6AA0276F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQQHc8RqezoQ7kNvwHA5xTQ&_nc_oc=Adq3Lk2nmNz5Cy69BD3AhU4pkfz74_wkB3fvNyvmvSomaGvpdDmArA-eefvKzX_61rQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKELZJ94x7elk_6UyJYyfebQ2pt33CT-1tTYpFQNKFPQQ&oe=6AA0169D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn-4ECIFaD0Q7kNvwGsbB99&_nc_oc=AdrLuLAeN4XiUbjP1lL2l-6ooktctm_wvmmnJ_0szERDO6saziW9Gii7hnQxsv-tjQs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjxkS8d0ZKjIYgh9rcMFy1Za3-UJx1X3gIZC-6n4mngw&oe=6A9FFA57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRw5S9-f-EQ7kNvwFYi4Cn&_nc_oc=AdqxGPMce5VNl2diiMxBcGz2Xp1inPbbdPpKsg79KPz2JC--3mN3-0zloE5wC2xk_QU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSkZ5woyoX8gqKMF8vLBv_9G1GFpGptF0o4iRkOBn2qA&oe=6AA021F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zkcUGiKHxwQ7kNvwFXbX7V&_nc_oc=AdpsjjCpSRwNBiH-y3JBeiHabNfPSOdbFk5PvQ6H4fMJu59E7tOhU9lVngA_czZcLFM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzmVWGAslUOM6WbebUpylKGywzO9Dk8T7DUcp2sftu7w&oe=6AA01126"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l788J-JkTmgQ7kNvwE1xG2H&_nc_oc=Adp8aLg9HBacoyUGRnCBcgOHcRjsZZbQdLpK_T5lOQLv7SMJSJSc2pw6pvMoX0dqJx0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk11TchKE6NPffPWjoYgUoSr9qy2z71dLw2LsSf2UFMw&oe=6AA01E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln1EysshOR4Q7kNvwFr8Php&_nc_oc=AdpWC4IgcUMs5amHD41kUqjW7odC3d2SfbYl5_aoLdA77TBm0sFojc1LvHUoWoPrvZ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXKoiMcTDN2DP-c3uqKGKLw2FMnAr30ye-zMw2Y9CX3Q&oe=6AA01B16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo3vOaW5t_wQ7kNvwGU4B0x&_nc_oc=AdomzbyclM95FulR856nS1iJG-01HxaiiW7tXDTyjQ-T74orFxIeWBtphWEzuuiFes0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWVObnbKkkKLBdq5K28gpxgtfofAMuKt1GSwxpWySQIw&oe=6AA007F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
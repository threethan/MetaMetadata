APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZGQP1RlSzYQ7kNvwEdIvxc&_nc_oc=AdqSzaMyBZ2mpt6htv_6rtLRN01jfgqColx1dlUdXe63IaYQoDYLjqrZe3f1oXyA4BI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa5-w-8cjkCydPzz_ETp8ozUQNfkxb59SyWXTcKQkkKQ&oe=6AAD566F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqH048SWRsUQ7kNvwHr2ZqJ&_nc_oc=AdoQH7gxjqJ2Hrt3QQP2Pm35aoanQPNgbOLWESP84hl4V2fTJaU6hKGRHz1shTp1v6c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBhN7Vm67iv7hOEaUCf-sVvM4eqRmj7iBYqdu0S9ROBw&oe=6AAD459D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogtcBG_8-dQQ7kNvwFxcM2i&_nc_oc=AdqFyfW8Q08eSOb_Vrunrq7X1UGJLsN3ChoxvZNB76uwQEKeWi7m0kIiH_VA_XJA7ak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhnAqpd9PmAl2I7JbC8MybC9V4hTIpZWJwkHJugdGODA&oe=6AAD6197"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmtmzVwDI8cQ7kNvwHpwTZO&_nc_oc=AdqmXIjEK0mDZlnlDEGLiCQdO2vbNCEDL0MKs7a_rqPrKNSv_LriK_KMKGkn-KbV3Os&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICFBPsGImDWQOs_uQ0fVWn3khwkeaj3zEvhU4XupS6Xw&oe=6AAD50F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuFvUioZNfYQ7kNvwGbdEib&_nc_oc=AdotrD5GNyfjbgqlh2-Isylz8nRE5SVTukvoCltqOxI3yVHadzGrEmLlqOVSaFRIAZA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCfIyM-eNzn_vB7MiO_KQIBVflYp8ygZZQoCyJqqx6qg&oe=6AAD4026"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9ehZvUnv5wQ7kNvwHR_Xdg&_nc_oc=AdqsMtzN8iAl9t44sfKYpbHhrCVqH6y6eb_r9EG_zRRPrSAtf-puXVx0lkfb098ufrI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIiKMZ9xKR5nGaxD10Pj5SqS0xfNUcyNNmbVZLnXQl2w&oe=6AAD4D4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G5rcjdWWewQ7kNvwGp51rq&_nc_oc=AdplCoas1hOaQFaNNoFHBC6mc62XUgUWwpagwg7jstq7HJBgLn5V0K9-zHixk8V5Ow8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK652ytwSZRnLtp-n2i7_mS44nUBh-IJFNbOCl_3J1f-A&oe=6AAD4A16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbizcUGpbocQ7kNvwEct4g5&_nc_oc=AdppycjePM8nbcO5MJW1-7sG_EeNxDi9MEnp-NueBw06jE4uu7EFSl_jmc_gwbn52Yg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVS_enbS-FhiNZtFbiJH6IU7zsYvosQiUcLpMxnD252A&oe=6AAD36F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
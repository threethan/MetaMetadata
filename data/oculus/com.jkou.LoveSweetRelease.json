APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgQAAm1AyU8Q7kNvwFUMdvX&_nc_oc=AdqrFfVs5JV6GkwV3545XMhLzQCEEm7o-YgfpNWFYYYwbemt48pYI__uuid8Gy-7or8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkMznyzSJNI1t_AKPvkfOfDOe9ZoPZo-NJYBH8KKeywA&oe=6AC26E6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijpbFQqHFPAQ7kNvwFt_zhf&_nc_oc=AdqRhCR7WNBd8RJ2-YUeQLiDZ4dqfrbJ9ffnxsh9_Id8_Smfp_NxufJpQuSM8Nkxe6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTWawm4K5d9GZh1dj9xU6ORm-ElrBj9BdmknLY0JAr5g&oe=6AC25D9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ngsacFahA0Q7kNvwGrYz00&_nc_oc=Ado7GyFhqWJvFrujBhVF6LURtdTzs3nxtY_v-a11rKKgayTVmrg_NQ7XrVwpDmTSLCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqGGwdWvi6MQgtrVXo5fXkQVgVYak3DQ8RFNUE3vWZ6A&oe=6AC27997"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVya4KFfwwkQ7kNvwEkdx9i&_nc_oc=AdrzTTXmBzjZqeW40uO5IN68FlaRABQhGtyyOJXtXSFjA1UJhD99qyy0tqU1UEqkiUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSEiMJFPEImZLQMKgUL8-er-N8MnBfSLQ4BDhYH0Ivag&oe=6AC268F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlD_VZusk0wQ7kNvwHECVoM&_nc_oc=Ado08IlHRmplkUB8-2I6ojo8CTN79xOJrpP3LNHAb1_gx0eXMlWDJWaNejRddvJ8AbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSBoq1LMoERtD-fzXgPTMIxRCup_U0O790ZALOYuKX8g&oe=6AC25826"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMdcdEiVruUQ7kNvwE7oYQv&_nc_oc=AdpO-riOcPKCsf-xb5cxcBpZSeNawQuWd6_e4Rby11vW-StpyvPmdlJ4qXhUrniwiDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX4wKoDvfl-wDv0HNsRfOHivz2Uetw80Sj8R5ZcGn5Rw&oe=6AC2654B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzpuv74vl68Q7kNvwGuBTpH&_nc_oc=AdoUg_IoRg-7TNVRNJkGqL2FV3-S3vtDVx5N_h_0yDV_1jZhCgTbQi-lW9r_l1SxKDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUr-er9LLFEJ2roOZeETjmZZ_kUP1mcFLS1nQ2_UQRUw&oe=6AC26216"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN0386OGTLAQ7kNvwHl6433&_nc_oc=AdohIKJyTOW9U9G7jDm09Lb0e5pJQdLQCQIa_kXnZdlJ1ibTrhU7j4xrKLagbUhBCgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcyIGcraCZEUSun8_E8vywoKcZu7XQlgz7VXfOdezDkw&oe=6AC24EF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
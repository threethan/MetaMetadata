6c8\u3001\u68a6\u5e7b\u3001\u65e0\u62d8\u65e0\u675f\u3002\u98ce\u4ece\u6307\u5c16\u63a0\u8fc7\uff0c\u661f\u661f\u5728\u638c\u5fc3\u95ea\u70c1\uff0c\u90a3\u4e00\u523b\u7684\u6c89\u6d78\u611f\uff0c\u4f1a\u8ba9\u4f60\u5fcd\u4e0d\u4f4f\u53d1\u51fa\u201c\u54c7\u201d\u7684\u60ca\u53f9\u3002\n\n\u66f4\u795e\u5947\u7684\u662f\uff0c\u4f60\u53ef\u4ee5\u628a\u8fd9\u4e9b\u661f\u661f\u7684\u201c\u671f\u5f85\u201d**\u6ce8\u5165\u4e16\u754c\u91cc\u7684\u5927\u90e8\u5206NPC\u3002**\n\n\u4e00\u4e2a\u80c6\u5c0f\u7684NPC\uff0c\u6ce8\u5165\u201c\u52c7\u6562\u201d\u540e\u4f1a\u4e3b\u52a8\u53bb\u63a2\u7d22\u672a\u77e5\uff1b\n\u4e00\u4e2a\u51b7\u6f20\u7684NPC\uff0c\u6ce8\u5165\u201c\u6e29\u67d4\u201d\u540e\u4f1a\u5f00\u59cb\u5173\u5fc3\u8eab\u8fb9\u7684\u4eba\u2026\u2026\n\n\u4f60\u7684\u6bcf\u4e00\u4e2a\u9009\u62e9\uff0c\u90fd\u4f1a\u6084\u7136\u6539\u53d8\u4ed6\u4eec\u7684\u884c\u4e3a\u6a21\u5f0f\uff0c\u8ba9\u6574\u4e2a\u4e16\u754c\u56e0\u4e3a\u4f60\u800c\u6162\u6162\u4e0d\u540c\u3002\n\n**LoveSweet** \u4e0d\u662f\u5355\u7eaf\u7684\u63a2\u7d22\u6e38\u620f\uff0c\u800c\u662f\u4e00\u573a\u5c5e\u4e8e\u4f60\u7684**\u6e29\u67d4\u9020\u68a6\u4e4b\u65c5\u3002**\n\n\u5728\u8fd9\u91cc\uff0c\u4f60\u65e2\u662f\u65c5\u4eba\uff0c\u4e5f\u662f\u5c0f\u5c0f\u7684\u795e\u660e\u3002\n\n\u6bcf\u4e00\u6b21\u6458\u661f\u3001\u6bcf\u4e00\u6b21\u98de\u7fd4\u3001\u6bcf\u4e00\u6b21\u6ce8\u5165\uff0c\u90fd\u4f1a\u5e26\u6765\u5168\u65b0\u7684\u6545\u4e8b\u548c\u611f\u52a8\u3002\n\n\u9002\u5408\u6240\u6709\u60f3\u5728VR\u91cc\u5bfb\u627e\u6cbb\u6108\u3001\u521b\u9020\u4e0e\u68a6\u5e7b\u7684\u73a9\u5bb6\u3002\n\n\n\u6765\u5427\uff0c\u8bd5\u8bd5\u5728\u5929\u7a7a\u81ea\u7531\u98de\u7fd4\u7684\u611f\u89c9\u2014\u2014\n\n\n\u628a\u661f\u661f\u7684\u671f\u5f85\uff0c\u8f7b\u8f7b\u9001\u7ed9\u8fd9\u4e2a\u4e16\u754c\u3002\n\n# \u6e38\u620f\u7279\u8272\uff1a \n\n - VR\u72ec\u5360\u6c89\u6d78\u5f0f\u6458\u661f\u4e0e\u98de\u884c\u4f53\u9a8c  \n\n\n- \u661f\u5ea7\u201c\u671f\u5f85\u201d\u6ce8\u5165\u7cfb\u7edf\uff0c\u6539\u53d8NPC\u884c\u4e3a\u4e0e\u4e16\u754c\u8d70\u5411  \n\n\n- \u9ad8\u5ea6\u81ea\u7531\u7684\u68a6\u5e7b\u5929\u7a7a\u63a2\u7d22  \n\n\n- \u6e29\u6696\u6cbb\u6108\u7684\u60c5\u611f\u6545\u4e8b\u4e0e\u521b\u9020\u4e50\u8da3\n\n**\u5f00\u53d1\u8005\u7684\u8bdd**\uff1a\u6211\u4eec\u81ea\u5df1\u5df2\u7ecfDebug\u548c\u6d4b\u8bd5\u4e86\u51e0\u4e07\u6b21\uff0c\u5b8c\u5168\u201c\u514d\u75ab\u201d\u4e86\u2026\u2026\u73b0\u5728\u6700\u9700\u8981\u4f60\u4eec\u65b0\u9c9c\u7684\u611f\u53d7\u548c\u7075\u611f\uff01\u6b22\u8fce\u5728\u6e38\u620f\u91cc\u5c3d\u60c5\u98de\u7fd4\u3001\u6458\u661f\u3001\u6539\u5199\u4e16\u754c\uff0c\u7136\u540e\u56de\u6765\u5206\u4eab\u4f60\u7684\u6545\u4e8b\uff5e\n\n", "short_description": "\u5728VR\u91cc\u4f38\u624b\u6458\u4e0b\u5929\u4e0a\u7684\u661f\u661f\u5427\uff01\n\u6bcf\u4e00\u9897\u661f\u661f\u90fd\u6765\u81ea\u4e0d\u540c\u661f\u5ea7\uff0c\u5e26\u7740\u72ec\u7279\u7684\u201c\u671f\u5f85\u201d\u3002\n\u81ea\u7531\u98de\u7fd4\u5728\u68a6\u5e7b\u5929\u7a7a\uff0c\u50cf\u771f\u6b63\u68a6\u91cc\u4e00\u6837\u8f7b\u76c8\u65e0\u62d8\u3002\n\u628a\u661f\u661f\u7684\u671f\u5f85\u8f7b\u8f7b\u6ce8\u5165NPC\uff0c\u6539\u53d8\u4ed6\u4eec\u7684\u884c\u4e3a\uff0c\u4eb2\u624b\u6539\u5199\u8fd9\u4e2a\u5c0f\u5c0f\u4e16\u754c\u3002\nLoveSweet \u2014\u2014 \u8ba9\u4f60\u5728VR\u91cc\u6210\u4e3a\u6e29\u67d4\u7684\u9020\u68a6\u8005\u3002"}]}, "developer_name": "TangJunlong", "developer_privacy_policy_url": "https://gist.github.com/tangjunlong99/f84e9f68b761d6d6f9c8ec4f41a60d12", "developer_terms_of_service_url": null, "publisher_name": "TangJunlong", "support_website_url": null, "website_url": "https://gist.github.com/tangjunlong99/f84e9f68b761d6d6f9c8ec4f41a60d12", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "ge
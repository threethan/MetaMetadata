type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A2nf54rSTIQ7kNvwEzZ_zB&_nc_oc=Adowls44aW9CVEMrzCjWXq3QgmaMF9A4DUcUET306nez-9r0pqHwbf9b9BY4GK_5bL8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91pFvdseLjpP2M9vbNz67tbA8EadbEvuZF322S1t53Uw&oe=6A36AF6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAIRu3Q4RL4Q7kNvwFg4p-m&_nc_oc=AdqwbxSgOMc3gWLe0ziqXDQ9u6Tp3BC1312p19KcUQtXEbKpxq5wUr99HQRPJf8RY9Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z-w5EtNoRsUMl9cmASsLwL2gae-gTcPzzOUNsFS8arg&oe=6A369E9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GPxTcy_SPsQ7kNvwEHAEQk&_nc_oc=Adr8BLupp1-cBrlgfAIQuD1Sa8orR5k3gNy5-w3Vm-BSjaEJZzcJM72Blycq3n8v3vU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kfp_UGysJeCzN884D3O1q9PYZuKKpm4PRVJxZRjRoig&oe=6A36BA97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AIk3Z7UBAUQ7kNvwHmw1Lb&_nc_oc=AdprsmsPemFZ3Uj9ZWRaI2aQpJ4kihQfWfj3yUf1nFhkybSqwq1U4uhBJTbAa4KsORE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n8Qu510CXUVPy1EDVoIrpRCpKXW7geaReGevaIDeUXg&oe=6A36A9F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTfmvyYcsWYQ7kNvwGVyxi4&_nc_oc=AdqJJYXoDUOXBMmOcO7-qyo_EnBuf3HA3_ZixZMy5wj9b3iGJtgO2Xkf9hGatQPpB7k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KoSsPVVKbCSpArjGctZyJ1g_BPJI7FbBcdTaXEpPVrA&oe=6A369926"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_7kYX7AjY0Q7kNvwEjDCwG&_nc_oc=AdqDY5lxLB3lWfCb3hJtkPYsDzeJ8aIy6izwrHN8ou0dpjCcRFk4GxJE_wt1KzQ3MYE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CScW9oB81TLrQMtfNvoJs0IGKBNYnWpu7_k_BYU9BKw&oe=6A36A64B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iH9hietyzEQ7kNvwErqUE6&_nc_oc=Adq7WOglEw_DDBs32eWP_Kerb3KIy4--ytE89MAg2Y-8nfcnv9Hp1lLYhNkgu030aZU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8di3twb4hEi8mn1wFKURuwewuOC30ge79rxrXcRVvQZw&oe=6A36A316"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg82uvHTsEQQ7kNvwHAX1X2&_nc_oc=Adpmrr9_wqPZBaGX1jEptOrj6CBzpYsrW9UV65QegxeDar0qeSKdJokyqsm3eTjU3r4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9ZXwsoS8WyonyBawDoaDQXW8u7NmOs_z66bCI41aZbw&oe=6A368FF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "AP
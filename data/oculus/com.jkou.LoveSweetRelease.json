APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvA0zp7SZwYQ7kNvwFcvkHE&_nc_oc=AdrYE1BUdHM5Kyxk5DyL3oBlLGueY-t9qHhVlTYAdNCm53BKIp9OQqNCGDaT_VHovgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N88KA55yDnjAs2FAq_bOJwa4g1auI-du8FmkLLxztWA&oe=6A3AA3EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyKHhpjzs6oQ7kNvwG1pB0m&_nc_oc=AdqhFwC5Gk5xH7e6Wy2pyoMamXujeaxhoowWe5nD3ZZJLyhDIjilM6_Jzro3iXQf86c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h65hn0fWxP_m8jKjmSZmouQfLuzcVzek_lNMAHZKNYA&oe=6A3A931D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t5fmEptH_cQ7kNvwGRPJnD&_nc_oc=AdqJNqb_WTzhz5o_2_cFKtzM8IQPj4_MN75ifWiQFv5H2obEOl9ScFLJBAdN4Q21uFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kNNQARK3lbVFIh0Zqf22cidbkX6ClF0PHPn8BaJRBbA&oe=6A3AAF17"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvWrgHXlW2QQ7kNvwHOmmyG&_nc_oc=AdpgaHLlovc47LQsE3AQUeAiPrZD3cX4Hb73WjxxxqhmKnEoGoY6OpP1mqNggltidTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_47t-myyHJ4vMnBfMIYll5TLETtz9AEGnbWHuWWu_ApA&oe=6A3A9E72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOSQV3XlTIgQ7kNvwGn3WOy&_nc_oc=Adq2k-Z-5JMwBxyN8_W8C5fyvOSUDOFLctyUfHcpQGxD3n3G2Ag6w2VGKwqQP7a4Z6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WU6uqZN_-yAcS4-Ha_l_o0MUPMfjmBJVg9try6Fi-tA&oe=6A3A8DA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IfP5iGL-6kQ7kNvwEbIfn9&_nc_oc=AdofFhZGbyQTqt4FE-_VDZdpGGn6k42r8CEioQrcysgJicW5C-_HDNsOmYDx4nHuDhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Md0YiHq-D-EtVHdngpqLwD1DVAqzwj7wCL87blcaVgg&oe=6A3A9ACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScCL7w3C5YwQ7kNvwG9BDxY&_nc_oc=AdrywD9E8obGD5oBDUspkXwNsI1s0X4WGeUesr-qaLGEskeMSFVZr53-oillBjXks0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zUkUOwYrTzV5gaBdYx8RrqEVtNg_PJGyvJseU5vIn3Q&oe=6A3A9796"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2RR70Dqb3MQ7kNvwGwMNpV&_nc_oc=Adrkac4mmLUseuuS1x-qKf0f59iQFohRXWQxlOLkuqH_1D8zhQtjtSzYswYV8idOQIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F4R2Kd5CHPbFXcpajA3KBCOTPEKrNNZmp9NJKRMuf9Q&oe=6A3A8474"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
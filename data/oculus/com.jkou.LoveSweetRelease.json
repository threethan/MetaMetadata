APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TIVCjIBZ5gQ7kNvwFMxyy7&_nc_oc=AdqssigBLhSV105uxTnrfmGok2Ua1Vm69s9xxECMEC4YuY3ReJlMG5BwHVEroWL-Ens&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx6UlFLabVVVzH-mwj4Y3rFq_vjwLbrORc5u8Cvhfg-Q&oe=6A510D6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0NWcUdq_YIQ7kNvwEocHk6&_nc_oc=Adp2lB_J67j60Cxz90e3Z8J8OC8WCbmfJM055K37-7sHMqgiJAcf0b9sZeVs1NjKp_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLIdHaVq-KRVH086I22VrSgdsw9I1x88Tl8OjIs28gIg&oe=6A50FC9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFOywlj06fYQ7kNvwGRl4wx&_nc_oc=AdqEtoqAN96ClrgC4UMp8bOql_yLlzdsjLyF1mb-58ZH_KOMqqWuD_OvNV_zyyohkf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0j5lhONg0BpLfJ0aN5bVuqbS9mHehpmLChoOIH-us8w&oe=6A511897"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUJpiNwLjGEQ7kNvwH2York&_nc_oc=AdrCGCRq_LAXGIM-c4Uk91-L0O7q1_sASOugnpRUNNIk_Lomt4XfLFxJB5X8EZNY0bM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA71EqDltWoC7sRzQnF0knFzDPu9-EM6nSF4W03llcH5g&oe=6A5107F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krhfq8zttdQQ7kNvwGpcu9I&_nc_oc=AdrTflFDtDKCKPkmJS_FItJ-TvQeYgHWgHhMCH4UKUe-zRYRNXuBtPd1OBm12uK0haw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmlB6PTnk3eGPD6VFQYg4HDh_PhWpQ0mk4WxpnFjEU8w&oe=6A50F726"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB62UBZDNG0Q7kNvwGhnosj&_nc_oc=AdrsQjpk00C5LbF_zmwFILizNv8qjWGi34T1kUDy3wdQl5yLMZ23KRUxv7lqf6EW2zY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr2JE9xxB09zvn0yDzkTWomN9zmbVUXINHbua_HKffXA&oe=6A51044B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPL9gPUugvsQ7kNvwE0JcJg&_nc_oc=AdraQTQTMptu8SRPDQBAFaZlCQIKdsXRaMq6gadz86RGIgsyIuq9s2Pni2niz-tGasM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm0QmnGMjsWNN-GQAySGk_IXv58nqa68I7WRU5FnAX5g&oe=6A510116"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlnOQzM1nWoQ7kNvwFgZOci&_nc_oc=AdpUQR2IKaciowqEBSXGPolDE20MKPqztBUQ13slegNYrJlus97u90A0KM7ZetSFIlw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAonU17AlZwx_YsbXkbg-Huty-8AJ8S1z6VDwEMxgtCkA&oe=6A50EDF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
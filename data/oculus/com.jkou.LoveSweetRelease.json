APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpOgD1WVcP0Q7kNvwEV5oSf&_nc_oc=Adq9VN3GAdqzxvQBPFSFjrwD96_LfSC5mbYMEpAFMfDTXAAPSxxm8tKXlGduyoMgzFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERhSDBaelQTrgbSv88tw3K2BJU4yPExIC1zdcf2-2CXA&oe=6A79B3AF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvoNaMhcfYAQ7kNvwEOGwHp&_nc_oc=Adp35fYzoI2f_0qYJtfcCFhdPmqmNZTzk4ebXCWtZyszmTwCTsnh7ujwysoi8xcHMHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTbV9DD28HtEMFebKP5TiBCpfL43WC-Z5JV5mgTT-OjA&oe=6A79DB1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlujcLGgrlEQ7kNvwEMTieg&_nc_oc=AdpmIaB5Je-e4P_A0gNNYQLIwSHn3Nx8yDIStnWPrMb5n02GiTF01HCLcUZ0UB4fZEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAPM5czu5UVwo4WvkJrY9t0o0ghXcHBRH3_IEQl3V7Ow&oe=6A79BED7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6g8mkaSKx8Q7kNvwF847QF&_nc_oc=AdqrQ3AAzlMSHdZwHcYdCJwqXXI0h99c15qo64zC8Wo-IjIBvOoZMDz-7w52sVA0PMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1XwC0kpi8MHPaf_EFbsIVqmkohy3XQana9Ep9LYgoiQ&oe=6A79E672"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j55hZViy_yIQ7kNvwG2zoWx&_nc_oc=AdrRV6FQU3pcCpIFlHvxbuIVoH7zGOcHuNA0EdoPKPMc9PH6axp1ScWBtcd0N3BjjiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfZzYmLCwMCBQd0PFSfBBf5Aolbl2JQz2UxMUlDjNt3g&oe=6A79D5A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkpV2pUXMy0Q7kNvwEO870M&_nc_oc=AdqD7XHLQZ72OuGxjugFCo_NVICeh5YnT-6qEnWjNjlJbFTOn3-GuychFB1tp_2vz3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECOD-ApkaROSl2P4KJp4NckhBxWinUQPHbmp7FjHtD7Q&oe=6A79E2CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z54tZUDil2kQ7kNvwGqOZmD&_nc_oc=AdoweQuRArhG5rC2zeTBrbJdn4YaDAGiYfKKVzs7vbz4R7R-6Wz0mk_8ncYAZgKjL6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6CC7B6pAJpfRVfKEJO9Y6S3QZCW9hqw224ZZbr_FpgQ&oe=6A79DF96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGjUp0o-plwQ7kNvwEEgIZp&_nc_oc=AdqkNO7JBuMi1ztwI4ksOwyhIp3CGNQCXGov7LGqstvj5H8vZP0qRvzNynqSnTnVbPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWXeE-pwTxf6CRr1INliCV68oByzmh210xnBmlZAFiiA&oe=6A79CC74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
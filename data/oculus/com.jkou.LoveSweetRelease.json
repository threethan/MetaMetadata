age_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aemMtfc170MQ7kNvwHP9w1O&_nc_oc=Adr5rl_XGZEQmm1mLChGHUVPQkB5RuQe_9iMtpSf7khbDm3RW3CkvlnsvNuv9bqqizc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZjSe_luIevNEgLzviXThcLdl2jvmn2cOrUgOB4VFf_w&oe=6A8ECBAF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXx_v9213QEQ7kNvwHr4bMS&_nc_oc=AdoUskfBca27PqUv0lH9K0-zyYCxZN5Yrm2b5mB177zpbUk5waWTo6mMyoappc0L7_Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3-WeYQLgUB3-vUW05RzDBKV6y6zMpHlkqE2VnA2gdiA&oe=6A8EF31D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTLrtnLQN7MQ7kNvwGtPvvQ&_nc_oc=AdqpC-jhAPx_npRYtFZAasxKO25z9P1usjwogCNAf6ZeG1C4NClEoUkt6E7-on_ZKgk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzQWxbDC59ORfvkrqr22rdtKQdDQZ_0qDLD7YxjvwsfQ&oe=6A8ED6D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j329Cn9V2VcQ7kNvwGLa9-I&_nc_oc=AdqnTKBQO7UUk_bq8pgaF-XCv18vzb7riF_WyKKUYlIDbyQ1y7q8OUxFoxW8qmWOVEY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk0GSKGaI_r3q7zghSoMSE07mri82Aeti9mZK-J0OMuQ&oe=6A8EC632"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKSEqQLy33kQ7kNvwHSBnZP&_nc_oc=Ado3ubFARo6uaDegtBhiXemgamDQmkOCaCUtWnxny9n0D-zrw5dEhrSgxcb7J_UaEtg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw5pAMEz5hFoiYJjBJtA6mPXdGbVR-d3eYwMWdnO7qnQ&oe=6A8EEDA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCU7nLAV8eIQ7kNvwGcHTqJ&_nc_oc=Adq75c35jxROGSpM9Vd0pgqwl3hmlF1WM8EFxtkYHFXjnYRmCOwdwvFRzg7t20u3WPI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgN1hQxLUPO1Pdgkc3_sJ6-79uN1FNestbZ5OxBBvxgQ&oe=6A8EC28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY_NEAow68QQ7kNvwEUh9Lb&_nc_oc=AdqAptsFtKKNyrwveXEJ0t4V5TYXUHJKIqExDzJQEFyKIcwixerPcAZ0qgUpAjCMvAk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1cZwXq5Ek54i8m1jqpC1zQwOG6TebDOH27NPZ1IfSZg&oe=6A8EF796"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TTMOfpnmRUQ7kNvwFCXbEP&_nc_oc=AdofMlcOjXi13S13mlBgEB_VVh9YNrVLdisMRH3QPuvA05loTTcU8rfn-nwEwFmLy3w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBOKfyXFJtRdc8GP-s7GsUhcxRIj9SBZeRHb4Hh4cZtQ&oe=6A8EE474"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "
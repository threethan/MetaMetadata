APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfFQwVKO1LQQ7kNvwFhYEhg&_nc_oc=AdoJykHgnVBrjpHKcTmli0DKAPq7RyB9pE2_ujgLB1WvbL9MpfW97Vlmsi0wU3Q3ArQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYN4NayCRFb_ewMsu1wRzT85PN3cLjN5XpbCqKX7wGPg&oe=6AB7E26F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8Rb-OYwRvAQ7kNvwEHVxEC&_nc_oc=AdrsuzlPP6JwOcLmmdSlmRTl3mnLg9u9CBiFy3oFVoXbK2Wfko34gxuEEI_8Spw02F0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIawc0FzuE1FxjF2dKV6S0fqn9k1hEf5XzsmX9wwJyjhw&oe=6AB7D19D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC9oxwNQ7u8Q7kNvwEA1QC8&_nc_oc=Adr5o6EWtm_zuB5CsnfFIE2HP5rl3cvPbTNpp7wm9Uq35gMm_el1jIIlKTnoazqpkgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN_-CabR-JoL1BBqkC0VYih7-nrs9X0GUrKCR8OAK3Hg&oe=6AB7ED97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUq2HK7xKzAQ7kNvwF5KRDX&_nc_oc=AdpST2dDRESzZnYqDiBRuAvHy_AEKCN1p_6UkAD1BUqWHlpGMDjeoqIlEgAw6ToGgbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4Vwg2uIdv3B5aHfe5H5zFZJfarbOUZ_WX7M2GK-pPKw&oe=6AB7DCF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui-2qKQRsU4Q7kNvwEWYeMq&_nc_oc=AdogCim-kKch4-N8EK8Q0dKimXmOs7gSQp3zLv2My3BaS_upQYDTEA6CB-yXwZVfaX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDz-hZ5Y0aFj1Rt2-_Q_xwjhiU6C5IDVwt0_gQRlzkxQ&oe=6AB7CC26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dA9EeYlWe4Q7kNvwGGwwUs&_nc_oc=AdpFz_F0l43RnBae9JzlVKxT60-dZoahxoHsCmgVjFLcIExVitnMP485i3-WxNsxd-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlJ5T2TNTvuxMsvqTMTW9OM4ONMOCv1IuL73GDbQESvQ&oe=6AB7D94B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPgRZBz2O4wQ7kNvwEtFvxy&_nc_oc=AdqQSf_XR7TopJi2-98GuboJOcvTEUOYVZqt-Kq63Y5bvtmmNQePp59DOVO-SW0MdEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE2e19z1lxkySVjov2y3RHyM1wMkbh0iKGM_6HLpdvRw&oe=6AB7D616"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbVAf3OpM0gQ7kNvwHIPSNh&_nc_oc=Ado3qfiJsEYpQ2BVQUuKs4kIdDqnIxSwPSMUD24WKMxeCi-74gLYvxZ_NVVafXcWuyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqvQz3kOTulH8Xv1YO3-T9SczXe96qXST0KZW3JnnAUQ&oe=6AB7C2F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
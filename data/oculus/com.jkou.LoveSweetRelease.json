APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgQAAm1AyU8Q7kNvwGxgDx8&_nc_oc=AdqaKE3hZvKLsi9c2K5MMNYYKyz9HORphqWKGStLiLl-vT9J5JgtXAlEtzrt8Vb5-HA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7ok5nWIrN6L1l7PqHOk1dGJiOtqSV9fnGHonTqFzdLA&oe=6AC3BFEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX9xHqWNTeYQ7kNvwFzhv3P&_nc_oc=AdrPqUSBjxmi4_0n9hQ0qNTne-jtOzPbAGxynHuokfRD3cQSpedbSvZ69k6R8OPRCmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjAFFM9Adb2GMwR9_oPvtDhAfqsXUNnYPt0oz9Td5pNA&oe=6AC3AF1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec5EEbjRMDcQ7kNvwEnKi0Y&_nc_oc=AdpG3DRjjDLgrHU0_c3uMHlNwJfycHFmQlffgSSupBsRyhx5fHvOSGbKh-vb0AeclYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOITlQzw5LJiqsj4qtH4TiZuXgo6_Ti_RNFMztclUnTUw&oe=6AC3CB17"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8cy8N-i-PoQ7kNvwGCTTMJ&_nc_oc=AdpnZjewpCc2SIh52kB2ig0UhVzrPcu-WT4NQFr6SC4E_2wQGmmgUwTqoG-4z4nvs_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5Pj3WBBRjWQf7uomHx3xkoTZzfFTLUzkLxbpfUgfX3Q&oe=6AC3BA72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rG63yiY-kgQ7kNvwHkVJ4Z&_nc_oc=AdreE_dTo906ag_xxPX-Anwyl3_BMingCanyegR_0-R5mgzW9yoTiR2hgXxdCptS7kI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh63ufZM0McBNmEAu8lJBKsB7j3PIIKotUYyGnjhMKow&oe=6AC3A9A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMdcdEiVruUQ7kNvwGWF0oK&_nc_oc=AdoafNWskqrZgKWNR5Dpmy5V_sK3G4pWai7iMoT_P3E5X0ex2y-xcFuqx3q_O0u_9xY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd6SLj9-mU8RWlX4x45lSf1owSF8vIA6Dr1YRlAJi2QA&oe=6AC3B6CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNyENqjPDyMQ7kNvwEFOER0&_nc_oc=Adp7OCJOvI-6YM-w1nl7s4byv5OBZUas-sPoglZn0dqVj4QkL9ImJXQ_OyoaW74KdnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-pbOopkzZQWa2rk4D5SmIAh6bnAcM0mj6SSCb9x5nzw&oe=6AC3B396"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c7JDvfzQOIQ7kNvwGWAY2-&_nc_oc=Adp1y22Si2tsFJv0cnQLi20pvtmyiRXxMRhekA8nHklAEnCMkbhW3K0M9y2AYcrjzqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA517tyLrF9-7of_CSGRaihUgsgN7qw3LY0LfxIkE17w&oe=6AC3D8B4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
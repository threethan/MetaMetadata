APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpOgD1WVcP0Q7kNvwHBALPp&_nc_oc=AdpHfXlv3ELGrQuD9eseK_ICkhP9Q_O4yjVf5Vd17SE0kEkPzXjPHpFe79Cgie48jKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK-gbr25I7ajVqHdOnAxXRnPXXoHls-THpmvOHynit7A&oe=6A7B052F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvoNaMhcfYAQ7kNvwHxqBEQ&_nc_oc=AdrlbDO_zAhWOCmbUcvi8eTcvvzaNsOWuBYjs8nIZLImRl8FoRw5B-2lAlBB1vfyX5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd9q9MFgm6TiYdHnL6NF0xnXr8yP2gczxC4nsokAWctw&oe=6A7B2C9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlujcLGgrlEQ7kNvwHtmu_N&_nc_oc=AdqH4-gFDKK9S6SiMTwZsKXZw7bTx6IEhDOKcO7W-4Snkf-tjNqBX1v7qCkgfj-6gUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_VoVTaVlCyGugLngEjzX2ECj_TSLeN3C86P0ZL6-XUw&oe=6A7B1057"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6g8mkaSKx8Q7kNvwGura6U&_nc_oc=AdrpbhCrYfmUZmtiWxyUyLR0q0XJdAKxIF-lLy_reCaDrj4UNeH0SIVi5LNNo0Mhqv4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwAnn5SyfA2-bQmZiommgb-RTMa0ePTHjAhzHwUU7Drw&oe=6A7B37F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j55hZViy_yIQ7kNvwEm8dbJ&_nc_oc=AdqiHqLOEqi_VcxwfLZy-2jG5v0mbpEcCPVtO5DeKe4CcyECKQ5Xfg9DZst0lYKKbSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM3UBf0UpUQ6vTMESLiGDE2bDlHeKsDu8GUf5pAkHr4g&oe=6A7B2726"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EIQWJ9_qTwQ7kNvwFoOba9&_nc_oc=AdoANeDiMEPCBEYn7boDTzLMc5BhXT23f2LD33SHdOC2l58eGdvYH4aiftt4r5BTPVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECVwBf5BrfPOtBGvdPg-nTYOBzfpU4M_NZxyVLvTItLw&oe=6A7B344B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z54tZUDil2kQ7kNvwE8Y_Xs&_nc_oc=Ado9wfVeOVBOPP_rykkZEJ7H-nc0BYEtRVIvdJJq3h-7oMql5tvm1719R5CBH_Kwmrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQwZmjcRTa9OAFZjCFTAbKFR-STEpbHe8S9duW8c65CQ&oe=6A7B3116"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGjUp0o-plwQ7kNvwETw_1m&_nc_oc=AdrJGz3liTRocRvB9msbsVCDvcNgHJM4oIQ5wq9ze3U23T9o9PC2MSAwzSKnI2QzZ0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExzc7V_0xhVFwd8kR4i5kXLnRtdSIio2dYBjll_dkQBw&oe=6A7B1DF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUj6E8KU-B4Q7kNvwGJKBnB&_nc_oc=Adr4EjWAx-03XgrzR2Fkw4N8klYL8s6ubGcC1zSPP5Qvt3TldZ6Y33IA-lMvjfwu2lA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEeX2Bjx9Oz3bI062IoDs-8JbDW93lrbuafAfz9gaMHw&oe=6AAAB36F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFfZuosFjVgQ7kNvwGFrKIx&_nc_oc=AdrJl-MsvdYQ2-6rZGYaRfTK8sffkeZUa2bLq83OpUvALDq92T13QEkka6Koj8Lgrw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZR6jdJ-SpFT_VSanWHb4sBrCtzSwHqOpBxeFfAdCSmg&oe=6AAAA29D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aOjAfAcq-cQ7kNvwFS1qYj&_nc_oc=Adp1DGYltVwAmjjgfztssHnMYBeEZKr5p8gSExYcSum9WTQo0re8UQSNUWCxq_l13Ec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJoNBAeWm_o3J7ENe03L_rKi9fjuR5-qee6DlsYEPlGA&oe=6AAABE97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJWzBzQOSYIQ7kNvwEv1tJa&_nc_oc=Adp2cUslBNNsBJJjYeQVjNy_-lmcWiOU18zo9ujCwknfczdWomxCk3ElhBjc82nB2OY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIliHZKSJhJRZ1pey2uJ835D2YYwGas1jwpqiiXWDgzoQ&oe=6AAAADF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjZID2jlAD0Q7kNvwEdIw_0&_nc_oc=AdpE7NVruOdTEDiK4jfxOhCd9Pt68xaDAzm3R57aoYiVuCsbYuERUpya5WsqevEDzcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItlRV3MkXjyM5XF-4FgygmydgR4NrX5k9nvTrePqg5iw&oe=6AAA9D26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9ehZvUnv5wQ7kNvwGv1bit&_nc_oc=Adr6wRx2yaKxvn0UBdGbLtuuvVnt07_ySepIe2zUEOeQf_9rZXQYAFu-PL06jAuHSrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs2nAV2-jT3LCeWEsz5pWjQPf643L59b6DFe6boKNgVA&oe=6AAAAA4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR-RH44BE_kQ7kNvwFc7YpU&_nc_oc=AdoHE0K5vGCTlGXLRt2s4u1SqD23jzygLH_3MGQppAD2PR_uyZf2rH1cmJYtX8U5QJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWMhCnANTNsE9SygtQNCFYoYfiMzDE_Lp_kHKhk6HHeg&oe=6AAAA716"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JyXJmK-NxEQ7kNvwGSeQ4y&_nc_oc=Adpp6p9CmiMq6a6MyJSdBdGZcIkBCSd2rdWOKbFStKlc_RPse7vMLqPME_136bg6m5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoOqogO3CNjpLcwJ84CkHKHKUc38x3_RFTpp4tFl_ELQ&oe=6AAA93F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
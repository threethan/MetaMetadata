APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rCqGY2WIQ8Q7kNvwEOHkZi&_nc_oc=Adr5psF7WFNd_U3OcinEC_YtUGXUDX-3iTSI2dwnzDj01-UMoNMjZAB10VFYlM2SDs0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDlB6htAp1bc_mZ4V0LJOOalIPZnO0DiJLySFW80DPXQ&oe=6A916EAF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsL92QBysJQQ7kNvwGwLDBG&_nc_oc=Adrknome4iWltHo0SvxQ2FrOM6yhcSLXBifRRkJYa3H_K146OT4hxAcsH7h4EJcMLbI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXo_0MdTZ1Ydc-qLLB5dMjZfX7Dod5hKqgmWb_cVEv2g&oe=6A915DDD"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiVxtKeuSMkQ7kNvwEG3-hs&_nc_oc=Adoj98Dl-sH_2UlEPpXEMLBkItDbRqyYTr1FbjPE_cICkcnv1XW55grN9FtYmI4Xn6E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2_vPWHErJ52J8Y0wk2E6YWtf1Lz8CBD8J-_enWybY5g&oe=6A9179D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s10svpv_jsQ7kNvwG2-2ET&_nc_oc=Adpgwy6-6P7zBTZ4qaLm-ATfQsjaOVRVhqsocPe44W_6tZmKDNY38IuCtVi79H8S1ms&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCKlrr83Sd-x--sPn4doyfUocsv34suVgld6l9cAdtQQ&oe=6A916932"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M5Kvb9Ghq4Q7kNvwGr6yvP&_nc_oc=AdqzCyhPTX49zBFLJarpU5-Jbeh6Kg97CWi7KaDv5JPk209UjqS7FSn0x2f0ih0w-nA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa8jX4X0GYke9QHcvfcJcItcoHex2P9-wG6KmHuw--lw&oe=6A915866"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCU7nLAV8eIQ7kNvwF6Fo_S&_nc_oc=AdqSjYcpL5rcKh82IVlkyO2Zucs24PEzUPpHullVapS-i3cIZtv8WHb64jX2T5y-gqw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrupAg_-Y6Y_T1pD-NX083q5Kb1u8lhsEdhmSX03D1sg&oe=6A91658B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYEdKJBSS0AQ7kNvwGneWoY&_nc_oc=AdpLOL8cNIkuiKPQV8eKAbfcshGZYv2-wFKdmEnlW61xuxgF80-25Ux8frls4ewNK5Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUseGEUNzu4XaPI8biiQNBUDNJutwn6h6HvpfzSr98EA&oe=6A916256"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl8oTVZkq_gQ7kNvwFYTqvO&_nc_oc=AdqnwYUcsdCtm0snR8STMMHk7opwPLMcDJsi9Ag3cMMj6qnHfp94hIlD5E1Phx6KxE8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzfyOC5PnS9XDxbfk7gbxQmlZetIJzP540tZB7sqbSAg&oe=6A918774"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
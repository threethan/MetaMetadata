APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGp8Y8k0bF4Q7kNvwGjNjcO&_nc_oc=AdqWTXyJNW5h44DgrGp4J0ZCjsqJYUsNwwlzyLVZfugq5OhV-sDt7bhBoL3K35oy78I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KO_7XMrmpE6yke7Ao7TOnzTwCET22Yp2JHcBaniC1Ew&oe=6A43DE6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BCOWNVZvdEQ7kNvwH5SWHi&_nc_oc=Adpz4lPoAQaBF4UZv7toqXmjiqAlz3h7UwB0mrBiPbVJLYcQVrKqnhdXK7qfrS703-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZytsM3mPHrTX4FnK85yan3bijJ9GR6B361Y_xMjYg7Q&oe=6A43CD9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4k8dtbvPH4Q7kNvwH7OlcZ&_nc_oc=AdomD3Jsh-h8AkmG61b1WE7yELQoWOhcNgt5s_LLQJZ2I4Hh_RiWwBY1bbVNmOC6N5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pLJ6ygWsUeXM1JmeE21OidBJdfccjG1UilGGheekTCg&oe=6A43E997"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PowpyNctQqgQ7kNvwEeR3W_&_nc_oc=AdqLZvpN-p3G4wg_FgjIJu4jKvkVVXcJy3ZlnuD1cef_Ebp_iCcrQKmOWaKxlOS0O7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PjuEbdobp4Kbs1Fbrm9Ps0JYCtLLn7WghNuHLXm9HQA&oe=6A43D8F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJw7L3Ql7-sQ7kNvwGw5aNE&_nc_oc=AdqRAPto0K8hG8qbsU2APCnVH1mlzDBTJzV5jyBrrIfXq3RuLw0CalAjAEGn4gjEheg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5rozdLoMC_5QjgAAuSvRaWqkFrWvphkwXiNHIKL3diw&oe=6A43C826"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvBxYH7ACP0Q7kNvwG7hygs&_nc_oc=AdqMV1DQcXS8HmVvxUKOBzuvlPyyG7QQOZhcKBX0dUHJk5k5bvebI3zbVRPk3YKpOB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yH9wZHWyU41FMZJAcWv8UeMGmtDb3oryyZmmfRLpzOQ&oe=6A43D54B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b2Q_1nWxzYQ7kNvwFSNhCr&_nc_oc=Adpcf_ZuPdb2XdzN7Al_iuthU-vkI7lnU3jfjGawaO7azXIolCq9QxQr7Yro5Txmwnc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WDwXx_NZ7w1CiVuWxZ3TWe4SxdD1-U1diuJfun69H3Q&oe=6A43D216"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWIUiuBpciMQ7kNvwF_H2Ko&_nc_oc=Ado9_cEajkuj_PrGV0IBqyJsosXWmNL3UBJi5OqIqNl9AHCypbTt1elVNqPXT6B14h8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V4rKq_OtiAmqZiDerj4N0M7wSlqxnWNyxD7qYjSoIVw&oe=6A43BEF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
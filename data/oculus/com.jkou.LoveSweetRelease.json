APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUj6E8KU-B4Q7kNvwHO3o3F&_nc_oc=AdrA9G6wZklA0ebXcYlhNfXVyaUe5VTww2U2-y8DukmsCybwc_IXbox9H01EvTjfmZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaqQnifXix0Ju_bIRkQ-0kDg1xAwrxSpmREoK38On3jw&oe=6AAC04EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqH048SWRsUQ7kNvwFivDcS&_nc_oc=Adr4c-cho4fgwRhGytVLjC9jUrP-yb8lsjcaveO20YzLlzmazDFEmCtG-bGYLCSg7I8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhI4QH8XHjU7xRAjK1kk1Cd4e3yXlT3pjIje67krwXag&oe=6AABF41D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogtcBG_8-dQQ7kNvwFvrVLD&_nc_oc=AdoBE0_YR2vFlWUOw03MD7_j-6vEHZrqNjidCaLFxhiaPWUpgUhCsqbFkrzguC7h2LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuQJKnP__It4ZwznYHcnTDiMCNRfPj5HUxu939iBSO_A&oe=6AAC1017"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmtmzVwDI8cQ7kNvwH8itCv&_nc_oc=AdrcdjRWEOrW_VsPfnHFCz1w9y9BFeX_q4a4E3hc8pm5KuFqQzHDI_OqofNHmIK3svs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH7gylOLs0XMVtXvEt982yNyKnVFGQWAwvjQwy52uwrg&oe=6AABFF72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuFvUioZNfYQ7kNvwEIpPKJ&_nc_oc=AdoZsI7ObUbQOfFQ0k2TEKSn4e-mWKRbvCrAm62cvtkxN3_Ajdu6vhAybGNUZE4CGpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqu5JbvOunoVV94buIOqA0MZZ9jUAI8fKHfPRUBJiQug&oe=6AABEEA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9ehZvUnv5wQ7kNvwEG_4fd&_nc_oc=AdpgeEd5kQHEalF-e9w4GRK0IgmXFmO_Z1Rs6GbtliGwE3pRlvu8MBDd5YUYXa21VqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInGxpe5LVG4xqRQpOf-FzH_Eegh_qH0PlDEHt-WoI45A&oe=6AABFBCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G5rcjdWWewQ7kNvwGBogvC&_nc_oc=AdqyKjykrzDFs1i6qzNFBvdsL2lUd8KYSQx4HvkrsDr2t4HEtptkmgyo1WoK1Z9nhBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDX2D7moj2N2-fNPLW-SKQzkdjc0g9QwKINAOz-gQL5w&oe=6AABF896"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbizcUGpbocQ7kNvwEtp2KY&_nc_oc=Adp6MifYVDC5v-6l3q2vK5p2Hnou9WjE09EjB0qazdWA-0XdXXYLe2F9A0W8B_Y5MyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwRNsKGz1DRqZxWmjgqaNqdgzp30p2FBMYBLpJGPVXEA&oe=6AABE574"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rCqGY2WIQ8Q7kNvwEBQygt&_nc_oc=AdqRUY4VLSaUjIDyiGPq33HubAd2pIzFlG_QRNGWxADhXWMO70qC4xXcewV68_-1_5c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1-30WUxp_YIRAYFMR6ttmGUiLHARZqC2Xcjbp_YiEeg&oe=6A92C02F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsL92QBysJQQ7kNvwH87PA7&_nc_oc=Adq_IQrvKGOv_QgH71zODbvWzGLwGR2mvUwbsVM5tHmb7WDIS3NCLT4Zq-_9m4D0iDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrEK7kVbMOTtp1Nr4bsWHUKPLo951Paeshl-JnkZ4zSw&oe=6A92AF5D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiVxtKeuSMkQ7kNvwGKafMQ&_nc_oc=AdqVm43LnFqfUctWoJVYa9JOxmd-qOegj5KmiIdu19yCi5gl4sbbtfbaokfT-M1kX6c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl_vmcIRUCWGR4Jv3gusHkSCCg7cHQ-iLNE0QGQ5CeJQ&oe=6A92CB57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s10svpv_jsQ7kNvwE5lbsH&_nc_oc=Adq4aB0h6IreXzyBiy6R0TBJifoc3tk_2CDOFnOHPi9yGNtqJVihMyuRRPhGiRgp_L0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHtF2H1eZJ-zQOs5xKmmzTGG9oQrb-jEDDAUBc46Dq2A&oe=6A92BAB2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M5Kvb9Ghq4Q7kNvwEXo1sT&_nc_oc=AdqX-GlzXyKu48Ybjwt-6PZdW0ew6BXUvdDBw0y_To7mi71iUSneWu4AhC4Bz1zW66o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm48USi12K-EwUs_W1XFfFae0cs-2l37CdLipNAZ6REg&oe=6A92A9E6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mk59J5Xo70Q7kNvwGcm4P_&_nc_oc=AdpfHUxV1N0DdFrVTc3_aYL4le6yywAa-NvHGWQKH7tp1rQ0CvTUceq7VawJLlTuJ7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKrncA5XT3PpKL6fIoQlDzRVRmclpkkxJP2nwHb22ISA&oe=6A92B70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYEdKJBSS0AQ7kNvwGfa4nF&_nc_oc=Ado7ryNfUBx4IDgS-lqt_HHC1GbdYchjrsiyigZ6ZfD9mO7NOiCWdfWQPkcz6qW57eo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgsoQ5H0JxthmHAj4eQgO5vdFYWKXuTPRvAItjp3qQ1A&oe=6A92B3D6"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl8oTVZkq_gQ7kNvwEa1JDK&_nc_oc=Ado7ztc3JBgt9pWzw_C-K1zjfEz8RTpCQaI8DQDyUql6Zu3p93-P45Jo9xZqFbyG8SA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6ymjn1Z7dRhiCiAJpiXxJ5AVgZJmCWoPX2hZ1niIf_w&oe=6A92D8F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
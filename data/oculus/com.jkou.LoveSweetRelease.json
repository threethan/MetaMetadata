APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRl5NitOi5MQ7kNvwGa0YL5&_nc_oc=AdoY4-gr1OySGvXkXVGY6dV6LPzGEwpvJfsTT0_JGi0gn7RTQCH4GsPU6RaU75vETqE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIftCFtkhlIhG-v_XlVSRn4MwVruMLIfaKi8X_pmOFG9Q&oe=6AA178EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQQHc8RqezoQ7kNvwEe-VgI&_nc_oc=AdoRCue2hdpuDpv1v27IsdgRNYViXRT7lEyB1EgqI2t2wBEyfGl_jUwYyDWrcNYHxvs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiZyEZI52BgIWXNf2KTWZGNdQOpVj1d8Cn3YA13xQATQ&oe=6AA1681D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn-4ECIFaD0Q7kNvwHQ8X--&_nc_oc=AdqHZgE4LMi8A8LiQ55gSft_r2Bbmdzi6t_X4CvK7OWB4AIA5QtiI-jt7UMlsnoSa_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhBgwJnztEBBHsquFRySyf5OQxGj8_Joulv5kTVD1Hyg&oe=6AA14BD7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRw5S9-f-EQ7kNvwHeBDvW&_nc_oc=AdrP_75NmKEZMHrqQIYisOvAk4WsayvMeVyZw9NTQHLq9SOn0kOf_dluVIbm_N0yH1s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX3RCw_jT-nRBffjdDH2gWf0-2mbwW3pQX0wTzXkG4AQ&oe=6AA17372"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zkcUGiKHxwQ7kNvwFAJtvd&_nc_oc=AdqehqTi2ie_D9yHkzBBjlRD_8ru7luAp8_NvRFCNrNCqQ8y0ACACkTdrLaP9i74xHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgOO5XD_ktxMO7I5KW-j2GkRIEX2jQ24d7DHIs72e3NQ&oe=6AA162A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l788J-JkTmgQ7kNvwEflg0h&_nc_oc=AdrWlrEsBhjiLFgsdBQGz0zur8UouFtKYXL4S-ANPQciNPo38IbG6ExEltccBDxZYRk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkRRBCyTQ7YjcMs_8BUNucu-fmHzVGptlxz4nKcjfcRA&oe=6AA16FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln1EysshOR4Q7kNvwEh7YH_&_nc_oc=AdooJ8SO-chujITSfadCX36wUv6n4RPXfyPZ95o_3-FcKVo1dTS5RxBwDLtECD1piPk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsNtIIi2ZiIaSDTLz-fuzhznC6OyywZgPXCtsIjGQYew&oe=6AA16C96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo3vOaW5t_wQ7kNvwFykU31&_nc_oc=Adq7pQH6ks2b1DJLzLz_khvkjxvED1yCNMl6i_tNo89rJnE6ipSVMwRn9KjsI2YgR54&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6P-aGXdMsxEZpFw3gs2T-_wahdv7bWlHTINPkSbLLMw&oe=6AA15974"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bysCRlBVr4MQ7kNvwH3TB5k&_nc_oc=AdodHA1ZyWgRRayS_IMPIrkaSCtSYQnB3AhUbBrCPb2sOrEKhh8GQHcJh5-DqGwuGzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSywYHV7xv8WRGztzMcrHHif40HyVREao1guHNNKoIxA&oe=6AF4876F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4zswJJ9WGUQ7kNvwGt7V5E&_nc_oc=AdoN2XTpOt-gxkz_3GeVK5zSEl7O3xK3J_gZnEzG3QfKz4CamJ2YZ2cOm_Smj-EQK8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpAb441J0VujUG3zBxq5E4Jx64Ssqve2FqpOzGB25fwA&oe=6AF4769D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFhq8P6PZssQ7kNvwH_u1t0&_nc_oc=AdqRYBBFU9x4M4yiwC_5r7B-fnPuXKqFHc0le-mzYg2pPk5exvRrdtOpCu3kn14h9FQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3yohG2CYnBijZFKVuxZn7fZx3yo_2pnSMiXBwQQlAEw&oe=6AF49297"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glN1RjUvCmYQ7kNvwESSN4f&_nc_oc=AdrxJr6XESNOiP6ZeQcXGlniIgwBXAmVHcTWQvB0h1L3tlP1_uXGiBJ8EibBpFFXUkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrOO67kr2JPbKysDh8PByZ0rNo49XArXueLAUHGVovsw&oe=6AF481F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOi1w05VFZcQ7kNvwFCVL6o&_nc_oc=AdqDwaxM2Y6mkPREt-Pw5tgQvkosnOTnYeRuP7ncWxSJBahDjlbBAvGpcQnRhvVPVOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqRAcSWNidLhdzZwkcKzgILK09aUd1f_a2fJv1y3R9HA&oe=6AF47126"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1lyHjJE-DYQ7kNvwG94WkO&_nc_oc=AdqRTZ4TOP8D1nPWmqRy-_mml8qdfjx2lmipevd5XZIASDWbZFNjjrmPGiAprsDm_gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQgHDiAOB0nMgg97vxBOi-pgJxcezgUD3DVO-rAbik-A&oe=6AF47E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szF1pyPsDswQ7kNvwEOGs_m&_nc_oc=Adr4gipYACu21aHjC98Yn6zz-yqzLh3SMgLwnWvXc80xLLSkp6TQ2eyTEO-5bdfpEq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR70h_qx12ly07_3TxlPha9HitZyYpPVYrJnDtnOgmCjg&oe=6AF47B16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhZ03DZ5EHQQ7kNvwGLT7XX&_nc_oc=AdqVwfYQVBbLuNw6hhaAtxovGjXMeOjnHW38TorIfCKkwqo7I4UZcrPalOTC6zlbfho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfFEzcNb_wTx5u7k1ulFMK5P2kXw9TNgAqn_MY3iAVjQ&oe=6AF4A034"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
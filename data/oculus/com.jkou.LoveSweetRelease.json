APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ6jxYoCJ1QQ7kNvwH-rv9A&_nc_oc=Adqo6FZ1W7S4nkkxJGWa-WUz1NE-2mL-H0BtoeSC4hZlOQfVrajLYpTxP3ivxCGzdJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zTukYkpzR9_CKKW8F1nMZakAuy81Vz5gXDJgzlQitww&oe=6A340C6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phLJVQAh2aoQ7kNvwHrzNay&_nc_oc=AdoW7c8Q7w_P3pMiz8n-ZB_qOB-VPcp1lCztrHwFtCRUNmSwfNbZDJPJLmKAETsnJLc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bU8TeeaGo7_zpSnzNn4tg5hI0_FqjJKtaKl8-rxcO_w&oe=6A33FB9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As-83FZz3JAQ7kNvwFDJ5Pq&_nc_oc=AdrLt6EaAQm1vAEW8u2UTcNMI1T0JTgsbdS2vAtbZm-3SUYaM5OdtsmDwj1PMqSH9IY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_end00wPBgn3uG3RHte4yfazAh5X5vo5mLlIpoZ9Po9Q&oe=6A341797"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF7Vxpkt7c0Q7kNvwH4C9OZ&_nc_oc=AdqNZlzm679UGXRGmNqdI3R3ZdX20BZgZ6gNl7UWJInoFUhZAcQdrbtpT_6oPaVcuZo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Wy3xuhFgHlM4vMXc8q4d-KjsN1Z2LTWP9NdAaL7CaA&oe=6A3406F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aROlGenhfs8Q7kNvwGSwxC8&_nc_oc=Ado6j6bysYrubwMeOmrb5QvCZZDL_RtW9b4TK0ZOLV1wds41CjgOub9tt7voDOJ6Q74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jq6gx90XGZHwfHuLyY0zjaj9NMJrZpGkLu74xiDmkKw&oe=6A33F626"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_7kYX7AjY0Q7kNvwHfGrvg&_nc_oc=AdpyZSi8RaHFI5XwR-WVUsEcZ0w4e0CF6l2CwCUlrvUn0kLMz3ClFMbtdvLe1l5RV3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vb0Q074cqNtXyjlcwBzwu3bxJVlOM3uqrotHaXOY5RA&oe=6A34034B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb5nqf0gxYYQ7kNvwGfm5Cd&_nc_oc=AdoAVPO278t3ZhDhKd1lPub_-XurcD2wnlQyrPXPX1rBUz2ET6ZaanZvgitBqLTmZSo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H3nc4ZXw5EvQoO49FY5n5WhY2JgMBBHl3sn8ADWMQ4g&oe=6A340016"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KXMYCcpi74Q7kNvwGApkAM&_nc_oc=AdqRV2EHC_6KQkPDS4Po5JRRiEgckTKpCDt0NbpEegfrPjQ216XALi8YmDdhyTaTaIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QVtYcRuT_pCk6eByd0swbQ1ah-cTVUnoMZEoqE5P9Tw&oe=6A33ECF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
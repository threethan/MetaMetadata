APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A_9AceI5_QQ7kNvwHjIJKs&_nc_oc=Adp7sT5LGyKtpBRsWYD0GMQjPJqon1ArZZAUxEVVHMOc2_2xpcyA-9_9FhtQpI0tgmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaHg7X5yp_2knjjylwaZk3BhLF-Hz1G_r5-1sidJzKLg&oe=6A5B612F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXm5RmiXVwIQ7kNvwECG7Aw&_nc_oc=AdqzNDOLtjXaMOU9BJfL_3bls-StQfY6dCONtmZINplDFET6f5pTWARt0RdHeQ1yLO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbRWFY_B6EpOMQ12qmuCz8MOGcN2FTHS7L2WKjm6o3mA&oe=6A5B889D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N64OV63_el8Q7kNvwE1InnI&_nc_oc=AdphZWhAOkHzCcUBQoql689YVs0B3cSWWniAOrPgsrMMkBQxaCReNo0rJxa4rOg1JNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyyyzRDOzA4gLSWW75V0bHP6RxV-8gd-yDHhqFefBKxg&oe=6A5B6C57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvW31i2ESB4Q7kNvwGZHcrW&_nc_oc=AdpD6ulECAHL5BMx2mxKFe6ulc2UpCf13wYEQVDousrfwVX0NDj5cERwD0vouvcw3aM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm-ATD5zEF23WanZy4j92B3hR35Tnt7FomAxG9URGeOw&oe=6A5B93F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ejvRZhBEwkQ7kNvwEPngI9&_nc_oc=AdqI8VdyfVy3nDVOr37tTYIgfXJV8rmzLwaOPeeWlBb7YXSvukKKZuid9WWG0Y4loPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC8bhVhx_FHTwdghH2p7LwceKoqElVo6FIcKFGa4XtEw&oe=6A5B8326"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Qi4DihKUEgQ7kNvwFqkbqm&_nc_oc=AdqseozuHg_puKOpHhOGV9ey96yn7iT4q-xa6Uc8fbNLqD0g63coPX_Dccw44qJVnQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3DDvXYUCdGBErQBj7JcHxiNi61PnrPD1KsxmRbrL6yA&oe=6A5B904B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS2eYYk75MUQ7kNvwHBXB_X&_nc_oc=AdoPuWFQDfp1n9FWZWsMUt-1sktAHz57CDullkbrH5fztN4hLZwvuQLvEBZh1eHCXVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH67xpnRsNDH3_5LY57RJDpeneOqzEN4EvslHoUvvUQQ&oe=6A5B8D16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1q7Vx0vAIwQ7kNvwEL-sGj&_nc_oc=AdoyJim_tzU7h1Jko3rXknedRY-kec5Z8CzQQvGdbSxsi7pIwN3nFBWscNMUnBiAfpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrgeEFX68dRKefVUphIypMFrFt-_1kOTNxFGY-p-dpIg&oe=6A5B79F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
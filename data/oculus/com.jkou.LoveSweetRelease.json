APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk2FYzvMR8IQ7kNvwFCoI-a&_nc_oc=AdoxH3Fk5cNBP6WOYKHQnJpD51XPRMWs6-6l3PXV2Eyu78sHeyXGD6By5l9jncoitXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDokildRrfJ-nLN0air8yJTIyKC4kTKI5arITV-Pm0OnA&oe=6A65ED2F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9nRh7R4U5MQ7kNvwHjVgYI&_nc_oc=AdoNj5Q7kYugq5epypZLIdbmlZmnei0IYyUFQAV4IbO2mRH1G1v6XMmRTGTzQucept0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqfPXmto5PHgSO89yFRoA6r-AdkJZSoVRDVhyAFF4mhw&oe=6A66149D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VXRFDx21GcQ7kNvwEP1aHA&_nc_oc=AdpGPBGVjzu44wtvedHpkUghfijpP0xvcBPWgzI561G6PNezdAIyI5vxb2r9qHahYBY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQg3Nm723O9HM5eeSs96YOTLZngkUqWlig38phdKKhgA&oe=6A65F857"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyK93q0JtnMQ7kNvwHJDCPY&_nc_oc=AdrBMifIxCm_0CpKp_nRGu8DzVTnSgFa6mQw-qGd8ObszTgRz9rEZCblBgJCC8lntzU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV6K4tMfD8l6Y3ViSTNLpjeX7JQ15ovmVTpTXak46TCw&oe=6A661FF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjrFAD_4ws4Q7kNvwGxWDcA&_nc_oc=AdryRTSGpILC2UZcclvUnx50D4IYt10SwipEFs3qLj4bdUjtzpGyFMiKVhufDYy5Dd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZZVxXtl-oG89jK_Lm6jUEIAkyNReJ40dj8U_hh_Dtvg&oe=6A660F26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIk2YoYIeAQQ7kNvwGNM21b&_nc_oc=AdqC45n4rBw81KnUEfwdwOx70_1NzpNNcJnfa6wjzS5FrEwHiyvWlFQ-9QDD9uRnKwU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALRiRLuasnyLZzpGzbFp-N_XZAzloWqZqU1o7hdg-3qQ&oe=6A661C4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWWE85F1ZwgQ7kNvwF_zKBI&_nc_oc=AdqOFexGB9CvdWiih973Fji4VbxirWZTIA_JqXc8j4lGyqt6HJ_TjFGoYUPoGCa0Oz4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw9CVaDK4QpE1_OHN9Lil02OGGcZ4Um_tciiqJ_OGx3w&oe=6A661916"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6OrywRFEusQ7kNvwFFlguP&_nc_oc=AdoQxJU2hcF92BDIPCMEQ93uqS_kpOq1rKlOdeyXSWHwiziaDxpGiUMcncyU1xsU954&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuowTNsxeWViz2tvu5SKAV0TZHH8xHOua8ttkZcfapNA&oe=6A6605F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
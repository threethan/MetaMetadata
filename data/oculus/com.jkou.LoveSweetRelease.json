APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7LuOqXrm3wQ7kNvwHYQAm7&_nc_oc=AdqcKfNCL0ghC_4ZPoyiPsqfGt9WWwpgGYg-JOlxddqYWGQ5RgARvwcOb0k4kLH2afA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFisKoXU9vw2Tbo6ds31uNOY55OATQFD8bZn8kR38fvpg&oe=6A8985AF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYcBWIyKOsQQ7kNvwHNjrDk&_nc_oc=Adqg-mYFp6Dt1YzyiJcBcpHPESCIEsjit-fthpWWPORzyu3ehBXnKwt_Sh7IsQXqlz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkkEoYjp7iIaEUmV706PTizee9tx8kpuhn8HpyWAQrMA&oe=6A8974DD"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOx4bAL6PhoQ7kNvwGjeOcD&_nc_oc=AdrmgH4CPIHRBZ0X3A6OUKU0QDqXN4D7NjFSRhD8yBiuejfl1Dvqm-j2y2gB_UfRN2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Z-nEMcyblvYl19ygHzO_QvHy9IDqLw2bN6rXjRDXQA&oe=6A8990D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miPxtVwlNkgQ7kNvwEbSbf3&_nc_oc=Ador_oUIBxUWQuYsTjq4DiX42lKgcplBNlvoEcnOBp92T-E0tZe8F17dp6IjlA-A4r4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE24DyIJiqxFzQPI4WJ61Wsfv4mzxK9ocGJ43e9T8fMpQ&oe=6A898032"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zheqjuja6EgQ7kNvwEx58AE&_nc_oc=AdrZfwmV-tVRxoBEnMvHRFp3z1Ks3UN_pmPy-2FW_aFLkj3dJ9qDJEEsjPtU0w8wE48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKKzlUEG69TqlSfRK5JyU1gy9xsfeMEtCLVByvBg8cZA&oe=6A896F66"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VDvwML_IF0Q7kNvwHDS7t8&_nc_oc=AdotJb_pdrbmYv2A7do8PBlqWCQX0kaQ55cIVuphA1Oi62bEv998kpi71-_9y1xWOwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhGom7IqzKfxHbY4fX_ATHDzxMNIVEUn2A7UHKVzF7nA&oe=6A897C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0S4SpWCqDEQ7kNvwFiYVm3&_nc_oc=AdqzJkk3WRYAx2M93LFXggAUBcR8XqaMVVibiQ-rWHI35HeOJn730OYzSKegK_sJaew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBAGzGuLXiT1YZy4yPJ4jFy1cKg7ZJ534VPc9fEe55wg&oe=6A897956"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1KJpnEn65gQ7kNvwH4stTy&_nc_oc=AdrKFN8Vbjrqrat-D0trn166mghhZ3h1hR5H78NZLoh4yY2mBSSQxf59SOW0yjPs-v8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF4QQP0Cnh_RXwxLvSHoPFgng6zT4FI1DT-L1osjj3jA&oe=6A899E74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
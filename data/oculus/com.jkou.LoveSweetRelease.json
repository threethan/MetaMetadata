APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8a-zWF7Jq0Q7kNvwHFtM53&_nc_oc=Adpqk3adO-BfgCvRToodV8N4RahKfds2Z2iIP3-gDdHE4CPoeyb8YZGIV8rIp_Goc64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYOI7xvlzkOgumHxwDJTfSIlXksG8NdL-q8Tq4LGhCNg&oe=6A95D3AF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNRpzITFJscQ7kNvwFhY5ss&_nc_oc=Adq_g7xt-uawWxMqSewSuFCUJ4bJAkrt0IuZ_HLevuVW6LWo9MC2jxj_SiM4EdryV4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKiY7ij_QTqBGkwtWPryrYDh6eIEBS0QcWprli-5lpwA&oe=6A95C2DD"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC_9UhwutD0Q7kNvwHVA-Wg&_nc_oc=Ado8Lq1oLFXXHb68XKmBH1iz-7mLD_geQ4uWjMDKA_e6kMd6l2XgtbV0rf4fBXWCs3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHACAo24C0Q-_d2JqbzjSpJLm1r8o6dVH5GM2K1opuKSA&oe=6A95DED7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOO6G-7-RBYQ7kNvwF63DDt&_nc_oc=AdrH2IFrqc0Xnpdqc9PA73nthI8SL3QTKnPffaBp_naukcbCpQP6gjKyrbRTgGc_0kI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnlCkPYIdlS3l2Z5s-h5vgrR1HBDInBpUVNkoiW-ITSw&oe=6A95CE32"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Rw2XPqfm8Q7kNvwG6exzM&_nc_oc=AdoydZ7VMj5Mcrn4FPQnm4JuXJgyc4SoMjLfhTQD0p-4ho_lu3iwUeAmMz54uqfJTYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbqYxGVQHBJmMN3MYYHdPkPXkKkZ9wpLW3c_XixG-5ng&oe=6A95BD66"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mk59J5Xo70Q7kNvwFHdkCc&_nc_oc=AdofMhJjg3DxowZICFeGzGPcyvA9j2JWTwI8MTLRUExwVizCIsR1FgDbEb_X4j1TMIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERapSE-R2D0DfSLNkhprY7NdBQVCs_3p7DkcE0MM-wgA&oe=6A95CA8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbIIUBCkV90Q7kNvwEyQuUV&_nc_oc=Adp_yHSK9lYKlFLLv-9A4znJ_A5g09hSe9uDpcrZuWnjifaABApQF7QMs8UhWaIDZiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY17g7A0aqiy1vwPkm0o7oXQSGRlQIZZpwNJAhx25Vbg&oe=6A95C756"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80YkT-y_7YQ7kNvwFD5_xN&_nc_oc=AdpaED1Dlwko3EW1vkB5VWtO12oE-YqxIoiReim_wIbg9-FWZi_jM34CXKArZ0sAlRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEZ-FEoIwNhGsxcpzstZE1Tb54I55A933Q4BIWPD0vmA&oe=6A95B434"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
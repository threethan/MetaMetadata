APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQfZ3gplqGMQ7kNvwGgybYP&_nc_oc=AdqwQRoKafZgNjBvxORUP59Fc1hBB5ItXIjxEwWC4VGVKL4NNBZ0K4-pUdyN7SBb7DU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2QLjJnCJqoW3EXK67Z6RGf0VZMunu_X31X8Cmr3n_hA&oe=6AEC9E6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIkIpYjGjMEQ7kNvwEO8oKB&_nc_oc=Adpe1FS1rA1x4Xlm16_-gePvqeh1-yqcGD6FXujWOA1TvKB9stl6ZrbbTJr5oWp7TFo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSBVrU2kgu-eYzQJMOqlByfGP_58RtR5o3zwAg1LlEfQ&oe=6AEC8D9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUyaUNER2zkQ7kNvwGdCK_I&_nc_oc=AdqJYS3ymU9Kq1_C8PzmqraQK3vBZxxKETliQegZSSW8CSQlatTj9ussPYuP8P3cTzg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOXlga2qjxx69JR8Sfb48PboeA8OMHXJmY8O49v5H_Qg&oe=6AECA997"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP8a4Wm8JP0Q7kNvwFq5NYe&_nc_oc=AdpD-6apzV6VmpUftERmHnaN_8dYlwgFdByMoDi31oc9JfbzLnQL9UmRhNC5vbsDeOA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr0MKscat2p303RfwY9MCZLHxjPZyrJari00ix9vbA0Q&oe=6AEC98F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9kzn_8W_KUQ7kNvwHQJXwR&_nc_oc=AdrfByH2-DkwYlHL-2e5_KdgrlQD-MJ8mkKqSOgmX8ZmdSTsuKJim-Kscc7tFcIc7QA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiHVR7HLPDSxGjrxDA8XHzZMwXYLGBwbdVdNRdIKQ1bA&oe=6AEC8826"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1tVUJ7sgfsQ7kNvwH_zOV1&_nc_oc=AdqeMEesTDrYNYJj3_Ae3yYDrmwCw6OMI-AQptF0fmS1H9L-LTHMKuAq3k1RPnm6Gy8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjm-y3pMf83WjrhbmEp81KkhMHgNxIQZ83Mk4Jcks5Lw&oe=6AEC954B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7qj4-tdNoUQ7kNvwH96tKt&_nc_oc=AdrOnUcG9i-KlZSvxBol3ano1s6RmRHqeqCZUxjzvZdi-dNwm1PwWx7pZtotlm4qTXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyfqd0JMEQSn_7g0KQuTJMNF_p74EJ3jWqy0Nyg02isg&oe=6AEC9216"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M-sRf54jYYQ7kNvwG1mEC6&_nc_oc=Adq5ekzQ_M421IljRxMkRzWwRWRQZMNhOWENKhZsBixPSk7WZYVnKFmXKnb7z9NtSQ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPevXjsZvhuJeCcpg7IzEkjUDq6mOh34KexbB--2SrNA&oe=6AECB734"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
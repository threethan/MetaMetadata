APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvw4ELvzlCcQ7kNvwG9gEzS&_nc_oc=AdpUbOA65R3Ii002hPGkS9Ykd5gi6IHUl30AcqailO9iKveYUtLzmOk8uSKCFUSciEc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlpaUStxjP8IxRmoEQiJsV1uKRXQhbqYul91I3Lz6Nrw&oe=6AC7B46F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOipKQ2sVLAQ7kNvwGhTrZ6&_nc_oc=AdpTa-dlu8t08FJWhT3YJhV2yuFyCQwHAxF96ltFe67QFY-a90I8TXbd2tM43bbSMHI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY-PyRfeax_0IJpz_tJvHQqTGItVS43EgukUW2cALUsw&oe=6AC7A39D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPo9pDYc-bUQ7kNvwE0RQmf&_nc_oc=Adr8zg09YRvTwTcKMWLSUlkCWfSi-3UCxFxt4_rzhxILTc4_sbcfuT_RnalmwOKZi_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOf8U5A1Evc0zZI0v8ihu6Dp8g3yOo60lXOpnLhHoNyg&oe=6AC7BF97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g15sENREOHIQ7kNvwHbVXGt&_nc_oc=AdrxSZ3L2FLgtpo0JFNq6ydKNGRLo501qS86UcNNvO4cBndBeNQM9l8LtkzctpJKjB4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5DhWW8uqKx9TOQxkfAtSxK7Xr75XUv2WSobaWogb-MA&oe=6AC7AEF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsOFNitSfXkQ7kNvwGyq6C3&_nc_oc=AdqkC5iOf60RxLr0hKuE82Rpg4i3vh00jFeMxtQ6sZWdaBZR2AzvxlF750tVrw2OWws&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYhrsGIvTayO_S52lJWAOL_Yp979m2-vfBitGy_8xFag&oe=6AC79E26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy-0BEG-tUIQ7kNvwE6yAXM&_nc_oc=AdqGKEn7AnndoKb-mYeoUjsXd3uLDaMQychF7oFSbfvd7GMA0lDq7X9UvtPzXiFARLM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKPATXisMxT-sk3b6KGwqZ0S1rP5q7Oiqg4KsRWQJySg&oe=6AC7AB4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4AMZ-6SBFoQ7kNvwGLKxyU&_nc_oc=Ado95R_oERY9nsEcKypJBmy58oJjwpv2xcMdlrnTB72k1Er0_Al51YE8NfUkp6Lmj5Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3FjN38qayhCAh_BagDEG__wKlDzRNyV37MkqO-9QRoA&oe=6AC7A816"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrq_fViGzJwQ7kNvwF2orAZ&_nc_oc=AdoeafEN2N4RzaxiUWpPtMKIw9FB_oMWIkIdJBMtm3gY66q4yYPluBCrHhwc0iVRJ0s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDiHMtqMzfrJhV0UVKfIo2UEpAP_E667yfg9ZlJ6UdCQ&oe=6AC7CD34"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
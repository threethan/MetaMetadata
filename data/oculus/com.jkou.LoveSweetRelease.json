APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9eHOFBP1FcQ7kNvwFhkpI0&_nc_oc=AdovqWS58szOpFwOUJdj5Hu4OtbYtB2i37pl7BcGdml4mWdC1DlLTgcMM2S6xrVs7Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKcmkz_X-PWpjPPf7AQmlGoB-P-9ftuvCfd2LFJkhnig&oe=6AE4B56F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsSXdluVe5oQ7kNvwH1oFWy&_nc_oc=AdrIW7P8HNKwXzqNLmDg9EL_gUpCGvAnE3qJbmdLLYPTdZCc-UWGecor-JHgSJ3DHdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIrZL0I1IZ4ZcMGnmdFW8G82ImyqR0fW1MUsCEPT9khw&oe=6AE4A49D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0aX7DeuQCIQ7kNvwHCrAth&_nc_oc=AdpUUMpJnLEs0jN7TIK9PQsnUpLExgc4j66r-g7jy1KkeftOMM1wrFzkY9pAQh-I6Pw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOILHN9n77n1OcMRdwuKlyx8w734vIgzqHrYVDxm0lm3Q&oe=6AE4C097"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0w3LBLLibIQ7kNvwHU32J6&_nc_oc=AdoiL3VfzecZsGGsxEeh1d_6T5DCzTlzSu53PKxECwJcoLbNsteEfdV5crCgeBUsMKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzvDuKkPlYnXkYgCnpqN_Y7myc0c1A0QF3P0DBiE_FOg&oe=6AE4AFF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5op4g38wq4Q7kNvwGEMHzi&_nc_oc=AdpxBNQRwoUUBjjIf7M6iFLUIYZFdJxkbtZJLWMrbFutAspjnxeq7VlT5mmutWHi8IA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEPt9YHWW5Z0Ov5BWYraTz_7sRFn_eo8qkpQRRn02IEg&oe=6AE49F26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C4mHJvsqiYQ7kNvwEmEc4g&_nc_oc=Adonw7v01nYLxaQ47cZlA2ds8WvdCSZoz0Tqysb1TisBL5JPcMBo0sLvLNQ4DNIyJKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpXZ-m2AJVPSuQuv3QMd2YjtxauZV-aK-AuDyZT8rLhg&oe=6AE4AC4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TslH8HX7nnwQ7kNvwHfE9EB&_nc_oc=AdoXqo2gHKD-F9M7FXhehN9VP2TOzYaHr-K_5_BkNRoJCslq4aES5r7sOoJNuJIiNK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwXOOI0IOwf4PcJyruC97dPpJ3oN7hsv37YyZ9oUybkA&oe=6AE4A916"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4BPEY1lI4QQ7kNvwHvQCM2&_nc_oc=AdqJBv7vue5SaOgs3noo09Lbni1EriBInsVknK_48TZvE6FNjAb8lPAwYi8Qhiois5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7JwBkkrzJSWcKGOMEbwa3daftEmUU2qV3B065OZWWAA&oe=6AE495F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCw2xXCtElEQ7kNvwFShWAQ&_nc_oc=Adpc2XuOnYCScjaoiWMJUs_giOtnv7UECbBoK1dD62LUuG46aDLg3XpoGSHICAKRPV0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTE527l4ugMF_Yw2E6DTeoRc00ou1kCY3__fHJxULLbg&oe=6A525EEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0NWcUdq_YIQ7kNvwEz27en&_nc_oc=Adq7cC3xC8ny9gSzEZZiRJBRtiDLbeN0pNS1CDGt7eKEswA_uBtyU-_weUazd38vYnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBfQ3LwJlViJaHiqb9_mqPDVhx1unz4MySyyZCKNgqIg&oe=6A524E1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFOywlj06fYQ7kNvwEL6goG&_nc_oc=AdqQbABO8A1YVpuD8r3HI6cWPNmFhsQP9eHd_nqHXGCCKeOV0NC51E-RQKZJDmgFBjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW54JRtsbbo3CT3j_HZH7LO3Aj1sYCW4CMBoqUpmaWqw&oe=6A5231D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUJpiNwLjGEQ7kNvwEiaabG&_nc_oc=AdrWBNOEldpRWDS1PqpX-WiDIKBD61wk6XgR-hzsy8irRFaN9PiT96i2yWliC1RZY1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU7Kw80dcfXfgKi7qGVkXqxqtfjf269QFKoHS68n_Ebg&oe=6A525972"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krhfq8zttdQQ7kNvwFP0KHh&_nc_oc=AdrMLUs9No7A53PuOifr45oYa_BzUg8mgiAeKQoRODrHrm_Xa_7PMWbpKgICr4A2e6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRqjyFALZqPqailzR8EUEtTH8b1cIlvrN-k0qrEHGlYA&oe=6A5248A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB62UBZDNG0Q7kNvwFRi068&_nc_oc=AdqsNS8GpXEYzUkrUKvgD83jsdDX4rJWZLP86JqOPnJ0RHyy9ZAIosM8ifPVJ1_kHAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQwvdg7cgus6MSMUKZ3QsObeM11QbkI7BU39unI5xbRw&oe=6A5255CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPL9gPUugvsQ7kNvwFtDJTQ&_nc_oc=AdqJlLZYSrxYMGiZmWJ4tuFKd3YxgmYQ0jtS91jVSTaziKaWJVeT5JOCSXXMTi0lKHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIto8sLjhF2Ono7opVZC9j8GmfsgWwKRKeWkz-JYmSjQ&oe=6A525296"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlnOQzM1nWoQ7kNvwF3o_rw&_nc_oc=Adpuy6bzUg5KJhqoanF3FtKwYWmeamFI5zQMn_bGYyWfzq9rPXDokU8XbzbTIt7edpQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE3-dKTxA4EnqvBnTROE70XBcq1k-v2A_NaJAo3ltb6A&oe=6A523F74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHHdTFVEAV8Q7kNvwFwXjVH&_nc_oc=AdpJeBDN9BgJLYs58EMYeX49SEmrbonUPWO7W3XPA15rkDQYKAXrFxBacyeS_llB4rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkknM2uH6J5DLm_kwSG5TsxeyWY1fNIGIMiOQw0iKC5w&oe=6ABE79EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRCcgge6QBsQ7kNvwHtyx2H&_nc_oc=AdoAhX-1qHxKK6Qpj5_pV-kDfpblw-BTWsTKBMXpWh68BBo22POylk9qE41KPv2Tbeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKORjuS70pFB_lEINQqY9FBcMHMTF8lb-ujbDN8eWWMMg&oe=6ABE691D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hij3rzJ6KOcQ7kNvwFNoWu8&_nc_oc=AdoDTI19Lrm9aRdLbVQNvcZq1HFRTNl3B00HU3kE4qYLyhrJYD0iORZaikMeVC9Xqa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBYAv7MHmYjKJUAiP3ywjvz9woPfkMRGMC51KVkHzgCw&oe=6ABE8517"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XuQU6PZGjEQ7kNvwFKjo4d&_nc_oc=AdotEtredYEbC4agdvOcA4SRgYV37qc0azEhzR0Rg3WNitxGGkoQDAaFYfXiKbaQRyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA4hKGLbWVXTTSlhnvi9V6DJJsQUZQ6xtLxy-6glIb0A&oe=6ABE7472"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcSN0G1nQFkQ7kNvwG7NgLI&_nc_oc=Adra5G5Y-sqvoZjhZkNmUPRzvD5BySz0TBJtKNSgLe_vE0kXtfO1sG21YIsOSKZ4EeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInPyd_9SsQW6fZUMt-GeMu19t-vHwhdgMZVqCfUKzclQ&oe=6ABE63A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMCXIefIWRYQ7kNvwEHelQn&_nc_oc=AdqI8H3OUENzkzTLGNH-o_1Fs8Fj81H5ZKBylNQXyDMk_vcJnFiJ-DalbVbzBVfHZLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXQjGuhSB6Bsv8LyoK5gq5otr7DL4hkxhErlz9x4uZ_Q&oe=6ABE70CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7T50fzCs3QQ7kNvwH0jw_m&_nc_oc=AdrUJj9GpUiEnIyFBKpHxDOa-lWSJCBVoVTbB-kW_8fP0VrEZCUuFyM3-MoT1yP2A8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHA93QkMjnRRw3C9nGTKyI_hnjtnqXIUpv7sy-K5O7SQ&oe=6ABE6D96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZZl9WqGGnoQ7kNvwGMjXbP&_nc_oc=AdojHkFf2ZyKvBRLN090LAmrkuOJjLi-iV19Nd2gG2SMb9PcMsB1eknDiwulAtmBUeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxr_c_DuAVORAvQj5mKPVd4bHojMYYuZr_Qz94heiVeQ&oe=6ABE5A74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
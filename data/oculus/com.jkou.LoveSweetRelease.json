APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpOgD1WVcP0Q7kNvwGi14MM&_nc_oc=Adp_ST0NTsuX_-w0FNshpDahU0eAIAMZZ-2fHRYBgfkliJj9TCBcX7mO6C5CVmxNYCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIi9qH2GZ6miMg8qoXigSNdMQDU_Uxayi2tp-pcDxXKQ&oe=6A7C56AF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4miguFw_hkQ7kNvwF9U4qn&_nc_oc=AdrVldd0Eu0cRSbHeIOg8zS5Mw5bPo7AwFswvpl9GTsjcicoaF7dp2tMzPSWoVkcwwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl3SQNor6bj-wXHUqQUgATZ6i8jUtCMzuO_MIiz-vVrg&oe=6A7C45DD"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMQrqDFem6MQ7kNvwE2Ejv8&_nc_oc=AdriyKVJBdVj_-NB4PhoWznLs2YkIpFD7ULKXI0TWQMjUi5XqI2zwnIgpjOIpAZbzgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGogHUIXKY2w_QxYEYERu6jFVaLnnpmdbo_GLW7xBHdOg&oe=6A7C61D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D23vmftDGd4Q7kNvwEa_z5d&_nc_oc=AdoUA1OaigwQmuRnldUgFgqKUygY8rs4AgEJUHFUguitiQ1O6-PZxx0zOlDPI5jJ1To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9bQdcjIpZxqziBPXsPvg52e4lQKxk0Ti_Jciw3jMz_w&oe=6A7C5132"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j55hZViy_yIQ7kNvwHHfWSE&_nc_oc=Adov4sd1q4Tt0oKytbVjlUnhGSeS2ZZaPcAClWzlTv_BWDR5qcUFY0qU8oNsxaPAfDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzlQEHIjaBKZqrQsIIlay0PYxvGAPNHPkk9Hrx3wG9aw&oe=6A7C78A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EIQWJ9_qTwQ7kNvwE-iF_F&_nc_oc=AdqmrNcxh6EHEbu2E57qEvUzJ8tXKaiHIdA_WLC2aGT5bQmWQhKKecOkuZF7waoBs7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzzwIf6y_GNM8bnueqsgF7Id_LVa1asjrJA0SuwZ9zjg&oe=6A7C4D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAMZELJ6BHAQ7kNvwFl8WpO&_nc_oc=AdoxTTpdDvA-4fIjE_KFkeeo7E-7pwjpIEZIY7V2I4Q5851F6yFeKoksK_TcT-gCSNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYkoTxzuVROqDMhMlS_pYbmotYsk_aQ0u13wTOeijTIA&oe=6A7C4A56"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXQMoO_ik0EQ7kNvwH2kd9O&_nc_oc=AdrGtWyBhnzmbEt-ZwBS1zu4S8rJm_QMqb2lu1ROvD1PFxfR6zaMecR8GiyXnCzfEJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlz2vHv2nWCB4XDfpzr8El7bi3ShnrsPw2uv0XwiWA_A&oe=6A7C6F74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL10KJPXBxUQ7kNvwHs_mpl&_nc_oc=AdrF7idYKYNoS4W84YMUxs5DyS19TQgMcJXDjxN-z-B2_iaBB-EgFjhCViLHL1EFrcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnZx1BrHkPUwTG2-BphNFTqUiLUqHnn2_PaJR41kJjGQ&oe=6AA8106F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFfZuosFjVgQ7kNvwHwOdTQ&_nc_oc=AdpPtfSDjWzqRguQiC_oICBHOYWIKW8XdoC4TqOu9-VHKY-mQHimOsoBygKx-zOJn_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp6-zGd9KAlyJCIlcUFmjYS8Uy_K-HqGy8ZTI_8sjyyw&oe=6AA7FF9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aOjAfAcq-cQ7kNvwHNmt46&_nc_oc=AdpGP90dXGbCjg6nPqnFWtag1RTm4kr6Ienhc-v6ybl-idcZC-lC2enJUddIpa95gxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ45fcbfYUNBr0nDv5n9EUxe50kxqzhiHyq0J9HArds_g&oe=6AA81B97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJWzBzQOSYIQ7kNvwFz14vg&_nc_oc=Adrx-NCmKe3tuNorET-IW_DIc4qCobYzn0EmFZuBJp22lBWl0F5C3W_IVLlSpueTW3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJleqCOSen45FSWvsDLueaiKgScXQ2R1O8LodMZHF_B3w&oe=6AA80AF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjZID2jlAD0Q7kNvwGyLQX8&_nc_oc=Adr-A_CfyeJlkCjiCF9z1fJAluva-aukvnCuZfqPPfToMcT-F-Y4hEJs93oPmJs2RZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0JmX1vs_Cv5crozFWmBJ_xCsF_IuZc6_rKNmHnT3VFQ&oe=6AA7FA26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zlSellIQ0QQ7kNvwHtRvmg&_nc_oc=AdpsT9O5UyPhaUEwblauIUBTHZxQoXrofRZ-HC3HQ3kFBCpfTcDmalc2yYMR0dw_8b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZwFzzDvW1saoBelIDtXtBld7gxzRioHtP6hTxiL24fw&oe=6AA8074B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR-RH44BE_kQ7kNvwEyrimJ&_nc_oc=AdoUbDAlOqW79GifF875sHJlMnm4Vtl0fVODn2M0SXzMI2L71dHTp4e_wgfo-LK2YX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8LL6ucT0WwTt2Rl1UBNFW4xAuwUM-pENi3YdtYIZrVg&oe=6AA80416"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JyXJmK-NxEQ7kNvwFTtIxs&_nc_oc=AdqxJ_NJQS8Jro9PwZWxQSheyWTWKSsI6_dkLsn-a4m0B5tX6Nqm8SsAaMEaJJiRxto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeWge6MF_iRkV-RXwrf3yt42tGZrPDLQywpgXSkcTQmQ&oe=6AA7F0F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgQAAm1AyU8Q7kNvwFpDkxt&_nc_oc=AdoBJ8nEFGb56McSEYnn71Y5p4Mk9oEHrq-nhDnRmCZmwpRqnQPumfjSb4xpRfDhiIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqHjyIVfe8IB_u-ECtdbyuaXZaAETG4xh_rhsuOAmv7A&oe=6AC11CEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijpbFQqHFPAQ7kNvwGaRMO6&_nc_oc=Adq1TsztzkMt7XXgZ1l7xv3EM9oPEoVwbWmBpxnPrrcvPGgm6g8WR53VsHEGlkZVLkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbXVXOxszk5iPKSCAUTJbV5GW-VcKDn0oNvAmNv_vYag&oe=6AC10C1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ngsacFahA0Q7kNvwG0Ddzg&_nc_oc=AdoupiEj0gDGfD8lZpwLkl-pq2zXZlv36Vf3TqukT4s-x9M1Ewsuq9GseCtvSKASx6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR8CTHo6w6qMMoLsLJV4o6-tK__6A7Fw1gSYUABQ1N1g&oe=6AC12817"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVya4KFfwwkQ7kNvwFXu42o&_nc_oc=AdrePuYES207AXyNSpNqF4u5HL9PjGGrSJ84VObDlB8_79iScMdCb88qAdbDF8io2-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS_V1_ey4wDmEtziekLyR3dfnW9nUpv5cmYMEIHUTeZg&oe=6AC11772"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlD_VZusk0wQ7kNvwHow8IZ&_nc_oc=Adq32TrOXKzlZV32cf34ihJ3JYHWd1Fq3mPAi6R_3NRuxDPJckiSxWgkvBMB_y4kGTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo3sqBF5tTuOJ9FgdeVa9A_Dqc5g2mkyVC-aklEgkCow&oe=6AC106A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMCXIefIWRYQ7kNvwHkh1Uu&_nc_oc=AdqK6uX5PbtXXnawRlSCC0AQyGqLIj8VMbpK4UaCRHDc3A7JLKLVlZgKXu-aI18Dl_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh-e4bFVo5FYVnwiThxc4X76nb72OaS_NEJIYt6MpxBQ&oe=6AC113CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzpuv74vl68Q7kNvwFqgsCB&_nc_oc=Adq_dM6ykICYLdHRLSWXR_vd0lg9e-PACyJjjMSeoofuZLRI3tCsz1ZCqtRT3IZ1L_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYmrNLS9rL5YVNyOnBTdArf8EswZvFueBI_QJuc05wsA&oe=6AC11096"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN0386OGTLAQ7kNvwGhs2ne&_nc_oc=AdosxiilvzyGLrT5DM7tBghdxTmkSut9BsELw8oUBvDf6So3o0xBkzeZ9HJ1r87zxa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODoxVabhFQwSU8VeXBB6ZQ_SLIg8Kn5v7nbrfD6vL4bw&oe=6AC135B4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
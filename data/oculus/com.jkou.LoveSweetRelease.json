APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxY4JvlyYQoQ7kNvwFEtgu9&_nc_oc=AdoOD0zRUwx92UC6WANM6uV4UQx0zOyrOAixe9vRIFuiOUW7dbw_SKPsRQJFbA2Nq9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZE9-Ip7rwKIy0cwnVhJE2WpL5BjSnPr0wOF92r1OCcw&oe=6A9ED5EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MES95a8pROUQ7kNvwFHmEFk&_nc_oc=Adou6gws421RNn3Az4jfuDWh7shrfttB2-0-z5_n64RvmqhC4jYSa96EC73gTiKzMk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR_SlSBmwCObV833RVP0KLgwxE7eSz7ngf5QpL3_B4lw&oe=6A9EC51D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgzhX9BX4WwQ7kNvwFJoDMS&_nc_oc=AdohALlQzhpxQJdJqsUb9TmrBvOIF8bnkPKgwpdJCNJqQTqilPdLY5zS1sKSTD68H9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVdoKa3j6BV6zRTaDI9kM3yG1J_8sc1QNDmbAUG_brbg&oe=6A9EE117"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPWKmqgZOCsQ7kNvwFxVtBZ&_nc_oc=Adq3XUfCRQKDeoq2jj-x3pSRaFyfMlr7EjTRv3PMR6a6160fRQNYmvpuHfRu4_Ykr2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvSbz1ocztNu3XF5lGOy4YDbz3fWvEfKO8NkjTeMyWyw&oe=6A9ED072"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXq7ob5AtxQQ7kNvwHyVqrw&_nc_oc=AdrcF9Rt_tp_LoDZJ0BI8a4t_x787OqYyX1zdYJOGxKaYLDGR2XemmdWDDfPNrk8rRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDH7xcBO1r9HKb3ZoSU5UMIz9O_n64NoK6eXItWFA6aA&oe=6A9EBFA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l788J-JkTmgQ7kNvwGtKh2s&_nc_oc=Ado-e5HPijD_PeUjKM0HdhFcWzNvYMJkrhYAmc0pYlWsY9pE_K7vpNyLk__lP3l4nOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU3j9P4d_0P2a5Y0e8b2f1NiOhTVHryIXuz4d9mOwDdQ&oe=6A9ECCCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGySgCA_MDAQ7kNvwH_atWP&_nc_oc=Ado_2oMDjqRJgqtmgV7Sx5ZiIEL9r_7uROSAKfivpIlmIoHwzR2Ow4TQ0QVsdMFCCrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOJdpnoqYi6DCPlJWiOMjw06G_8G_hYDS6E1gmAswoPw&oe=6A9EC996"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cwS5VQpJOsQ7kNvwHnLyzc&_nc_oc=AdphTrJOcLSkHxgovUfoBR6RSR6vBKuGO4ZAdxjVIt0om6wcW1He99WbZh8KmDM-DR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIREVnv0IqgPa7qzxvEx2NX19ksmw_s1swBGZwNejN0QA&oe=6A9EB674"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
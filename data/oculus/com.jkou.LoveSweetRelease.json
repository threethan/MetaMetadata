APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OyjCfPZyZcQ7kNvwFycWkD&_nc_oc=AdoiQrqpClVZ9gddQYylkGwPLlcm5yFNDYhYnGPT4xvxQwLHiGKfNVRaQ3QTCX3c-yY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsG-G56P6QHRVJB5FuoUkYziAD0VavjqAltWkb_SCiZA&oe=6A9AE16F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyvRGsUkPHIQ7kNvwEOfCmS&_nc_oc=AdqsVWBR9jeIBpYEdLz2ygMmjMOL6t8Rcp26IVLc4eFq_XjqtTyG1NJN6eEMiGuwzBQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvxXJwoRbpbtKjTyLsqJoEmq0YdKb8FuwXpcsyJL0wLg&oe=6A9AD09D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o90fgntUqA4Q7kNvwF0Gyp5&_nc_oc=Adq0EIdM1vnOwMvsRWBCgU93cY-hsNTqKIpNPf5CVy8SBbqOweBzalMYsgZnN_1fakE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5waTEqnFv80HhHgJ6o1a4GCOf3SpJS9zLvCkBoQqyGA&oe=6A9AEC97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=limkBApE45UQ7kNvwF8OR0I&_nc_oc=Ado9DTKfWKsCsBBoz8--gvDAbwKgMGDS4yC0LbkkTHFNaqZjh64TYdqXcJU63bkqp0k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGXpQhAkkmSaVIKr9DYJb9F1Tv-pzppqti_lIyrS6lBg&oe=6A9ADBF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4oKe_uXOH8Q7kNvwEHDefN&_nc_oc=AdqdYolyAP97-sxSQVCYKZg1yPzeG4wY-rVQxmZV3ZndxXVEUt6nBKy9OB43ZMK7PlU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI7OflEs7UU2dTLQTeSEZ96JOPkhot6Seh6tA4glv5UQ&oe=6A9ACB26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHH2Uf98zHYQ7kNvwFsTvml&_nc_oc=AdqsOdRG-k0Usf3Ikxb2kbrrvp9j2XB6RX0wv2RHJmgvh5jVbHApGeV9UUbOFEjYJWY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcCm91B7gBWRDF6Og4I3XCCaNt25HQY1DjEQ9RPvtbaw&oe=6A9AD84B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EkemiOU06gQ7kNvwFv-L8V&_nc_oc=AdrJjt3kJt9rfhCOBWoKEcfogPV1x-_ztnHvxppMxqICxUW12--JZ8OYheopr2gLZ-s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo0cwCEGcOwhBXLFTycFaeOaBbGr2G_xPHEz7EjbuL8Q&oe=6A9AD516"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZTkcd22RT4Q7kNvwF9zPld&_nc_oc=AdoSe4hQHKNP1j2YktN7PHNR750s428ze2f3BE1aJciRbIJXO_kTHGhDI6SBpFvTlDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeABnITMSOAQ6HUU15anqYxtS8LgxjTWDzncIuF0Rb5Q&oe=6A9AC1F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92ENPfN0x74Q7kNvwF58U7U&_nc_oc=AdoATsrLC49D_q6WW3bCJrJZK5n4eBuebhgnVdxpTpUIlS2h76waaY68NNJ-vSwkQ5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx_BXkly69JLnQsXwwLAQ7R9YPdF2n0zodtCJ7b60Seg&oe=6A7202EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYeEap1zydwQ7kNvwHfLUN4&_nc_oc=AdrqKJqCGX4DYiFqSn72kvEausJIHC7Qvsw1bvW5BVzdd3Tzz3f1hRdA7UI3yqn_CZk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEfr7kPT_waKRNF5pjQStv1CUcxXgeEMzoT_k8gGgi_w&oe=6A71F21D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFWl74J9tjIQ7kNvwHBPwYy&_nc_oc=AdoRxogUW86nz0Re5JMxGZi3HT4YWv-q-PPskkf2HPlk5slA_iurdMw_ooX5vhJY3YA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxE3BeW9mDVW3pty1BderZDesiVhpwTWZOotnEiU8AwA&oe=6A71D5D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsCXGpUYuiMQ7kNvwEyfmJP&_nc_oc=AdreFK05Xg-Dy8euBnMbfKM1tZPWJYLeBqAIUXSlrzzG4juTz7qvOLy0i7sOXDg1ItU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYPx-8wiuN_v4-6Hmred135O8zgOU54URzr56RbK9XUg&oe=6A71FD72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZc_C1VxBEQ7kNvwFKvaYw&_nc_oc=Adq-ACn2t16h-qw8kUQ32Hr_RUuyyL8RM6oS9gEaYv-NQTvoOG33ljid67EnMX1Ce3c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhIKMRJv1KmgMhdqSye1Djceor7iS72ZTaQwGukpsSEg&oe=6A71ECA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_TLSG-LAS8Q7kNvwGH1g_1&_nc_oc=Adpg1mJ75cW3nAbCbzc7mUKgDa8Jum9NWb8NdgZAQm5ZbHEAgTuL1ZBSmpHV1_NGgoc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_NFXvSTDNQOa2PWnp7R9RTO6dPE9_OKIvMd5OudH1YQ&oe=6A71F9CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0R9FMRFWCoQ7kNvwECExWH&_nc_oc=Adrk6zdI77so6c8EVtJ-gL2bf_YwFKVh3OHZ2duOFWXdb6uuqDtD9WbkuCZY36dqOOw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8LwhwXdT5Qlb1rwnWfr8rP0r9q4IAJ9z0l3HTEdKFJQ&oe=6A71F696"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C9LN90fApIQ7kNvwGbeiaM&_nc_oc=AdokxlcUcfCq9p8fUd3zCP_ywvflWnaImqwQHI0XPYHRw9XZVWE7eAbG5_AR7Wj_wrE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBfK6ck9kbgHEsdb5ay3XXBLsNtQQPyntlbS7eyccptQ&oe=6A71E374"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
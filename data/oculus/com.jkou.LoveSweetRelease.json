APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ43KGDqxU0Q7kNvwEtnLcT&_nc_oc=AdqUQlu5-kxL-mYrY0vu9tjx6Ceo2Rnnhol3lvr3pyV6NgmTEAIImYFrYeTHwBzfoQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXbvcMLNOaH2pfyUgk4mZjs80EMG6hD3GhlupAayaCyg&oe=6ABA856F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8Rb-OYwRvAQ7kNvwH8aPKq&_nc_oc=Adq-7xPZKoGra13Lfe6ZI6kJ5PUMrcYHSjzpLYQhsadk0e1f6-bHD1j5z0BYahSDFcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFZA5nQg7dWQ3_Vyg14qOKk2cxrAplYzYoiE6nwya1OA&oe=6ABA749D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC9oxwNQ7u8Q7kNvwH7-MZw&_nc_oc=AdomYi7uLPvd2yzJtpaUlvqPiOdAtjiq8RCANS7uS01aqXdO2UhcsMcRDnSUGw5Ew9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_C01q4Sld2W_VOD8kDUCsVm9tZ4RdyioLxhCTCNZJVQ&oe=6ABA9097"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUq2HK7xKzAQ7kNvwFovKds&_nc_oc=AdqXlFm80UiuJMwRTg0-2Sr_U-UzWxoVq5spV1lVrI8yqCG0X5TEvubG1Bn-fXAWuJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJFVKg4a8rYFLTNG-Zjh94ALaclXT7t4YpBmXd_xZCYg&oe=6ABA7FF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui-2qKQRsU4Q7kNvwF_v_qN&_nc_oc=Adqdip0RSP4sg4TABaWONF6_LnBFBgePK4QTwWLp15SSo8BFVxHfAV2Cd6hB1-mouZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT1pCjXSYAVWKQD8zbry_b3hWmIy6vQG2T9WGBaLpqBQ&oe=6ABA6F26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcMp7XieHzUQ7kNvwHXm_xd&_nc_oc=Adq-6gMJv3vHcQ44C9aXIpH8ga-JxUNJtgguZtmpFNcxQg2gCuMRs_-kv8BkpYs2bfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLntp1fCIMJvPtkYfL0pWYus1kr7XGleSJjd2ydlKcYJA&oe=6ABA7C4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPgRZBz2O4wQ7kNvwEFuFhw&_nc_oc=Adpab21VZMwL_TFR3hOyR7Q2AxGArAeI1T7A0WZfRVUpf7b6Lb7JBMlLpLssp6N7Wa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOYCyTOP-3f4ma11t_EoXJZF4Gll2NmZK4n2j1IFCtVw&oe=6ABA7916"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbVAf3OpM0gQ7kNvwEFpau9&_nc_oc=Adr1d70O-yegoXBCztAgY_7bkfNXBdwr8oq4BuHXGzrx1YX_IcoVnNF9hUTk2I7LNcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA2fBOP8vE70Mv_ZK7g7HSinHC-0-N154BdtGE0r7Twg&oe=6ABA65F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7LuOqXrm3wQ7kNvwHPE8o9&_nc_oc=AdopxuDpcVVRvXaZIm5P3B7YH76SD45PUXbvxuWne8vtfNTNJ0YorZhmoQxEuJZCFCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuFYI_vBtk5yJP9l9yE3_ir3LYGdZ8rhi9M883GYlebw&oe=6A8C28AF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXx_v9213QEQ7kNvwFnO_Ht&_nc_oc=AdrqV0hpfEorCaKoOyfCwW1fpG3K2pU2FgLNV-Yz_eUqFT0acw-cCKRJonggiInr5JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxvE3zgPnHOI5O59tIOeQbdjuuB8SQO33V2awJAA7G2g&oe=6A8C17DD"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTLrtnLQN7MQ7kNvwFpJjMH&_nc_oc=Adpps41gVOizplBO5BofToUkfh8vDnDKDhMQHSCa0cioGLQ6FGhm6Wy6EAOjQemsHco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVqpI9y55yq9NRTZTUjY8sQYxdfukqqb04moJOYQYyKg&oe=6A8C33D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j329Cn9V2VcQ7kNvwHGz-eG&_nc_oc=AdqPYWHvF6OHtwysjCwsidv90KgFA-rdI2QfTKtxbwZ2_g0D291kaLQRKgLghE-pLyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfCLW9vTZSXXx6KBvVPoFVdcX-K6lX4KaO_Ye2dXLB0Q&oe=6A8C2332"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zheqjuja6EgQ7kNvwERgNms&_nc_oc=AdrMBu8KyvrP2qfkaK3UoMfIywH_W9Hg_6tUG_yOf-_AifGipSbrzHRyGdJShobmmbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Aky8fkzYW-KBJ0evVPnnNLmOEjOVN5sWr-TDqBnnJA&oe=6A8C1266"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtS1gM2eF7QQ7kNvwGECl-3&_nc_oc=Ado_Lk20zxuP0kDzB4fIrWzGbfhVVIOhwYbdOGX8_xLW3YneycjZCXLwO4voDcCnGA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEckOHCVimJZiX77gT1eqfPXVfV2wbnEFENPOenddFc-g&oe=6A8C1F8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY_NEAow68QQ7kNvwHm4r6o&_nc_oc=Adrr18i2jqy0wV4Uz5LvmYGjGiSR9dg-PETDpd82vuzamlsi6GYCHiesH4PzCbma5Go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH1Xja5hwxNRAXeZITK79TrMliY6GFbkGi1Om8Qg-5cQ&oe=6A8C1C56"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TTMOfpnmRUQ7kNvwGAYrEb&_nc_oc=AdqBum5L9VlJ10YP5Jesp3QRbEuC7Hvft1bKOQEn-W3UAL8mO75eP5ZPAdrdM5rgn_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMEs20t8FkF8QIcdQ8xRJG15k6nD421W7ySjUTLhJ0zg&oe=6A8C4174"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JXczkIguPoQ7kNvwF072oO&_nc_oc=AdpJ4C9bDr1hOSsXWskDglwHF1C_L1YWxJydDPCiD_Fd-eR94DaqnWtp9JhVWuq8Brg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTcNFcBcFhYXruInvDNMlI61rLsE6p3O_TUqGUK7OUqQ&oe=6AD0EEEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmSpTOYvemYQ7kNvwHibriC&_nc_oc=Adp2FIhNvMWB0vpOmUBGgBK4SsXJkPunSvnh_qd7_5C0ytp5oN4XnaWg6uPXGhQPzNE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzIXXruRyWoW79MgB1643jhvBVO0bXalm3SIhvQaYHdQ&oe=6AD0DE1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6Zjongm38AQ7kNvwFBw5UB&_nc_oc=Ado_4mmPp7YtsjF4uiv3YKOcHCol5fa2dP4lnMQefIZcIj3S6mQuAjSa5daOfOLpKjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGJhtx0I32ZCiWvx2zZB838i9_lfNNAka3mFF_VbyCPw&oe=6AD0FA17"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCEfp_gEZUcQ7kNvwFnC7cS&_nc_oc=AdpLVMUwBimKy0RM2xy5nUiZr-NMeZP_X4m9Aai1DgCM8eCtpfB5yl6QOja5cmr6TEI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN50uGhSLE-BxHzoI3SNXmD07HRvvu4_DPfUfdqUB-GPg&oe=6AD0E972"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzFWkhKZ1GgQ7kNvwHKzgp5&_nc_oc=AdrNszJ8LutpXRrQADTC5qJSQpS4foI9vtZeetx8eb3kkycbKgQ7Nr5R-TghNCDU7g4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNnckDMHGzgTydfYbmWBraJnkd_9QdokqtfCJZXGUKMQ&oe=6AD0D8A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-p2l_aGpBoQ7kNvwHsnoiH&_nc_oc=AdpMHj21hE0qW_GQ4jrFQYcHOcg0DZCihqh331AP4gBN8gHhHlQpFHlrmbqQ5oet9RE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5HJ5aOEXf9IMbAEsSeFOGEc8risZphipcgAEj2FhcrA&oe=6AD0E5CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt5-R69hEPUQ7kNvwH_3Vl7&_nc_oc=Adrqb0vWLr-tBZd9fmz4L2fHhptWlfpReJyisp3Rb4uyUp42IYVNIw5s1bv0T9H_bCY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsJEpSZixCfDb3-yKOOBe7_1yrjqA1oqbwy3_YtivwZA&oe=6AD0E296"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKo592mO5eQQ7kNvwG0Lv7n&_nc_oc=Adon9252KakU2j_rkPtbZ2BxP9fguQ0bnbwqnaG656Hj2XsCDQEGvrpjWY-KonKOKko&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjCPKX4iikaSkpajFCyesEceoy7x9Za6y7XCfIKi_TdA&oe=6AD107B4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
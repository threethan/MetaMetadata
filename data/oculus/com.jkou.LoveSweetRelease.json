APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV9KC4_ovPAQ7kNvwFFn3xY&_nc_oc=AdryFCrtlUgOhAM_pEz9ZQm2NGO-fDZf-0_THz-bVpYnlvMM6WkjCG0JmUt1Y6cBSX8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PYGw8xIBoGOE0Uep9F3i8ykgbjLcRczwciPzVAUOE2A&oe=6A3FE9EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqA7PYNTRUwQ7kNvwFTVuSK&_nc_oc=AdpTVZRLWIn5wzuPMh8IxoijvDRTQrCiEWiJLnQ8Cdvco8QQFzOUWNbM1m0yXUK9us8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G0A_W6cFBu9Mms67HIzfMBCWSSr-p_s1FUtHSpAnOAQ&oe=6A3FD91D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaFmv5T6as4Q7kNvwH5dkJ_&_nc_oc=Adr8wMV5kF19HtMM18cWZT5RHWmONTiarbY4g3UGSSDUAoE1VoJl-POE84Wj1vjxrgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H3N9IICW7z9V9VK2dCieHtxCu_KgXBAXId3PnAxmWjQ&oe=6A3FBCD7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FocSec41wFsQ7kNvwGzq_An&_nc_oc=AdrxbMT13PD6AW5G5j7XMk14QDRkrgVHPGlPuVmrYFViz6OOnlDe6MSjMT64dUficjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CaoBKWfk7mSTdWN_7qUpwEfuL7Vb3HnnI4MS3yHBlLg&oe=6A3FE472"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1UFZGVoqXkQ7kNvwFNfSm9&_nc_oc=AdoqJ3wffn1gHwoHJvik-s2p9O30Xu9M2NLGX0qx6sJCWDPJiAJczxNXILkcmuEf_Po&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cxSVBru_zB-iKjBiVMleVciA79yjrb8ReMUtoNWBE9w&oe=6A3FD3A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGbUv9klJCgQ7kNvwEsP2QQ&_nc_oc=AdpI-jrf16_WB-p4-Vntx4_PrQGeNZEhJAaP9WrFC7Nf8ggmu0zyCQHmuv4nFLJPDUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p3xk8602tFKAQBDtQjdEt3WhzmQExtRhsdNl_anofKQ&oe=6A3FE0CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjE-_LIxd-UQ7kNvwEd6Ljo&_nc_oc=AdqvMdh_Rjh4d7mF5lyCqnuPMmSwulsWGKDwB3CyDHcL62wuLOsMHb_X3D4aNU1uoiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ONdq-wNlz2pSpZCDMjI_SKYSYok-zIQJANbTUtRFMWQ&oe=6A3FDD96"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8llFvcVOnIQ7kNvwFkfM4t&_nc_oc=AdpnlO-eUElBmTIfdtKIX8lOA65LG5SMjJH_SZmwhoAYS25-O3hWNfto0Yo1Yva8ius&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dk21X1X-06XbFmJd71BeNsUXBJ9EfHL1Z0OvEPzl4pA&oe=6A3FCA74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
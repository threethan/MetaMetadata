APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRl5NitOi5MQ7kNvwHeiNgM&_nc_oc=AdoSev72EBGYnyp_UJD2FT73CGg-IViMc-vUmImFn6zyJPhmcYG5jW51PSJ9R_9Zdz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkaxz171aaWFdL6TvzHmN-XaW-1t_9MFhNn33CsLONTA&oe=6AA2CA6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQQHc8RqezoQ7kNvwFuMH8x&_nc_oc=Ado-2pZL2-HZjrTVyjhjAu5jDIskTdIMkDv2dBf-iwoPzDSAZSm67SM4Dq2Fr1moBOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvcY4TlVJ-VoP0lNsl4q023oUx6V8ylqVoUSwFRY9-EA&oe=6AA2B99D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn-4ECIFaD0Q7kNvwFgISNk&_nc_oc=Adry61pMVCMoGpn7r7A4SBC9ObPkGue62OrmuL_1KgJXYV9dfuhUePn-ryzm9sCVecY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsrgEWYwqkNQO1MY7hF6vLAO-TT-wY2TC4j2xhBRBUdQ&oe=6AA29D57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRw5S9-f-EQ7kNvwEOaauN&_nc_oc=Adrfu1mIYBnAT9TeuPCDIj4otFMKa-ecVEoCwrA8PI563FqUYWPpnum31Vl2h7Vtmww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyyZmav3PJgwkHXFuYD99ao3t_hw327K9TMQ6FjSw2Ug&oe=6AA2C4F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zkcUGiKHxwQ7kNvwHTId5t&_nc_oc=AdqnNULhp-FFW5ulxvy53bO8PYzj2oEFLvA81a4qrBjIL0bB9IHvG169GQdBZDzcGII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhTr-tML_rtjL7S9SDGSJpep_Jyu4CCPzH915onxKjOA&oe=6AA2B426"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhRkaqqZdIcQ7kNvwGJeYJb&_nc_oc=AdroVZEx-PC_wqm5fdl3u52EUg9uWx-_o_z2W5vSbPYIZ8E6i57eQDDY9QjAERxOF3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsWq1PsVIWkK6jkCzilux_Lnv7xnaBliTFpJB43ALQQg&oe=6AA2C14B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln1EysshOR4Q7kNvwGBuKln&_nc_oc=AdpunKb9bPFnXL3axDuDuVTDqFZLYh9xUBOE39r7WabbcnLZ6fpZD9ZmljjegYXxLT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYz6GLuQ9LVmfARBqRpMzuCLCJs7J06YEPtnvw2ICF2Q&oe=6AA2BE16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo3vOaW5t_wQ7kNvwGs4yVS&_nc_oc=AdraOKVpy6QqjIbv04-8ngBORfS0K05-Beg7w_XTv-tv8YzUURK1aTntn5LgzE5aRPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImK7eydbEBCwpJokold5MDoKDzZEoPMjMt0scW4Q2tMw&oe=6AA2AAF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
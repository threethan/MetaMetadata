type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2OFbeblU3oQ7kNvwEE2mdx&_nc_oc=AdqGqLcEQSEemexi5CX9fyX7EsA-_VW7DBWbGmcsJlrCZGFERK29Uv6Kum7B5cDrULw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9P1btnsrWTOFie1N9jgyfeaQ63gfDEFjgormRhHVMiQ&oe=6A46816F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP5-oM74hKwQ7kNvwFxBdGn&_nc_oc=AdrrvrEf7y6ZPAZE_UMT0jEKWVdIrRHP1ZaJPAjSEPCfXaOj2ZuvyqHpRqpnBsRsP0I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oFtWwg8TTRrPyy0Q3tCflDsr_kVgdMVl3Vp_KJk4RFg&oe=6A46709D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgbOzhlrzIQQ7kNvwGXnr9Q&_nc_oc=AdpCIWjPMYPHABP7-ZH-KwhEBO_9-2BjwFuLXiVZOKDLhhDs8NSyHJNopmscAUQqyJM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pvYhbH3_sdMwzXaCT_lLz4IQ1opiAqbUoatuODeFyDg&oe=6A468C97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieswMWNOkXMQ7kNvwF26e_t&_nc_oc=Adr7WV7wKfcmEVjNK_BRSumgKCjHKsMZ3wwtnB4vmM8_dx9BNGcTWpWcF2bYqJE2jZo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iRFrjEKlG9JJHOhGKs9WKaaUcERye9xn0wJPmwS3stQ&oe=6A467BF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7Id2UIpQzoQ7kNvwGL1emg&_nc_oc=AdrXJnFL1s_xyoLxoM-iHeGQPOBWt6nZU4p1nfUqJW5ndrceqZrVaSAteGsqkOgkbiU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qIoHIkqawr-MYpCAL72Dq6zLKl5Inmp7R3MoXwLG4ZA&oe=6A466B26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvBxYH7ACP0Q7kNvwHIdNFc&_nc_oc=Ado5MsPV7XTOa6hbCQWSlvzxEiST9iHtgjinpXp81PsixfrkcYE3aFUKxVhjQXcdNAY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hS4wwS_Xg1iAZJrahbImnueaVw78HfXkv_d8JmC5INw&oe=6A46784B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da-YiyUaSNIQ7kNvwGQcIpR&_nc_oc=Adp9jLXft3TYx7nJYIaB6WyhonyrdYZ9PeBs_fEuLnM4-R216Afd5hchwVH5tcH05BA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nq_4EZ6Z-lm8OitN1nqJbhp7BZu3lhhYeKJ0FssuYaw&oe=6A467516"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVHS4aLq3fMQ7kNvwFZVgSm&_nc_oc=AdqJ3FGEaLz3u0quIfZhXzVrpZK7NtcklHy5BbfjaPe17pjrGSQaqEKTfswrsibDCPg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sre2_nnb1_SUIXX_a_l0TzaplqV2jBttPKyHVseB-Aw&oe=6A4661F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "AP
APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC29D4_VnW0Q7kNvwG0ZuyQ&_nc_oc=AdrAZ7Zwu0rcIfalJVze4RzfaGUxT8itiNPXpLXKogZqOxDzu1IkDcRF1YWSPxLG1Ng&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRus8H8eNpPb4C_SCyAWVX0uWX302lTZylWXD3jVvqJ-g&oe=6AF9CD6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY1n2ZiEZTAQ7kNvwHSaAc-&_nc_oc=AdpEZgPXk_WKt9kqXLHsyBkdu-mnjG9Q_Lk0gev4wUJ8nExf9h0RbTfAgSTPM5ofLWk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQxbDCyno7LUl8PKBEw3RKZVuZHRkZ_y-F6LCtojiTgA&oe=6AF9BC9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iY0wnDp1ycQ7kNvwHwKBPD&_nc_oc=AdqDd3kXEh_xNzM6dYoyQ3x6Ggbo5D7U2evOqsqhfIzeCndw1dsWkR-uefHkwWaY9R0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhNbpQfL1bdPQimUdJRUIZ8azcERDTKUfQknyA9srRnQ&oe=6AF9D897"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK22Hxc3p1kQ7kNvwG74XKT&_nc_oc=AdrHfaCkpu67wfcdTtN1ZKt31MpAxC4QP3QxZJLYqCeMIAlYiNn4eGyD1gG-_ziafws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKSsC_di4Py574VNZ3sx456Pwc8-JNk6ObDqbHlm_TOw&oe=6AF9C7F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsevbAYz2bQQ7kNvwFcJYWp&_nc_oc=AdqINjn1RD9vtQh1KVB6g31DflGA-98YT5XVdbS42c3sAH8G8Ie-KzqffxLi3BeGYaU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyxHDI5u9ToF1UR5WMxYWIE3sZoiROIL-Js50vXMYVzg&oe=6AF9B726"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMPT-KkBlM8Q7kNvwElKqy-&_nc_oc=Adqt9YOhiLOayZqw9kg9pE8I7fQDHrHDefraopmTDMJxxUdOjOBdNqxI5O24rpfJOG0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxPlnxkRbYD-m0OQbCz5BTz6-XMu7Kgff6cojt7amV8w&oe=6AF9C44B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3FnzDGilVIQ7kNvwG1dsJq&_nc_oc=AdrSCjB3snOL8QYkicNlHuwdGEB4p-uGUGBV0MYxgBaabbNun5J96tdQbCI9v--DVP0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2BGx7rF3XA2aa_bDOlnHYN-4WtlfbWDC8il1EeHlgIw&oe=6AF9C116"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-imEAt3dR3oQ7kNvwENymiT&_nc_oc=AdqcyACi4fG4pos9puH1RKg0nKP14Nn546RVWcxApdEOvAecNIJWeVcABFJv847OaAk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTon07Yszcs1vHqCHbynP1isqMibg_Nbbar0OFdQhMlg&oe=6AF9E634"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
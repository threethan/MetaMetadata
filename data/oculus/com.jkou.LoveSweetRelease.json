APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92ENPfN0x74Q7kNvwHa5lbH&_nc_oc=Ado8knTH46hyxuRwf8_WtnPpGV6EGya5AW5etz4k7EZGW2AA8DJyF-r1X4mPBEUOVUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi3FIInZvUHBaunzlgrQMiTYQg2_R-32Km7o4MQ6-M_A&oe=6A73546F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYeEap1zydwQ7kNvwHyA1pv&_nc_oc=AdrdkOxL38sfQXbVAx8u_qOeukPYrNIKbD90zq8-eIN42KaHXxFkpN5T919Mp1J3M1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb9z0AvPGcZJfzusRTAiByfuKy0Z9NO70Bk2rYKDQZWw&oe=6A73439D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFWl74J9tjIQ7kNvwEtFqTa&_nc_oc=AdrDGrJ8Aue4w8-Zg9HH-r0iKdhWld7WNbJfLLXy8-vFLyPL5ifg8L_XY-3tdYTa5LE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxEIvuFRO2l9GOuX_83JX1DUZjZuXhQzBeOcBDAqt57w&oe=6A732757"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsCXGpUYuiMQ7kNvwFLaGZr&_nc_oc=AdotOxMeTh26CKv8aHVaTH4u74dzwsDUmlN92tWwMzajnt8QMvEQAvFIrmMa56Z9dzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6ZT3uIjHk4w9BF-sq8sH_y-yFxWjxmkTDYF7XZcIAXQ&oe=6A734EF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZc_C1VxBEQ7kNvwHZCzvu&_nc_oc=AdqPACvSj4A5myMLm1-dz-bRTMB_7punStFrbClD089ytN-eOnCnFubS1KJhYrhXTL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLgUtRw26hQ4sh3YeCUGX5LUn2DBG9hg6e6-ZN7vzXjw&oe=6A733E26"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRnPRhAlkcQQ7kNvwH0vbeV&_nc_oc=Ado2mB7Be3_E16_MwUNo9IAykQuaUe_PGI-RI8sQVakaTd9wt6xk5Wdvvgih_W9rf5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOqQk7yiIgIZvqbiP_OiMgiZe8HZtgl9oXMH0Egt4iOA&oe=6A734B4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0R9FMRFWCoQ7kNvwEh1Zsl&_nc_oc=AdpWr9sFiDKTdK6r--s4yxd3jydGUCJZofLNKT6Yi-occORoNVN_ynyywNdIQqn-r5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRhj8ZZlQk5aVeQeX6ObQnUSheUafqzOH5CmIn7i_Efw&oe=6A734816"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C9LN90fApIQ7kNvwHhp7Is&_nc_oc=AdoJ_WwUkOoV5LAmmB8OczXWSpEWZuPVa5oHOBZNeFzCdqiIHH8liOmtTZoibdeAuUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBg_qxnVDwOOGndwz5gaV94udYSx1WZpg4sMjkct8z1A&oe=6A7334F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
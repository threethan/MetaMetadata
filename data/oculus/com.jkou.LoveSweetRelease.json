APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPPNtEXj_m0Q7kNvwEKhvH0&_nc_oc=Adq0XyAoNwvDzC45YYPHzH-VgjcyXqSHGS7VtxV0at7kCx3eHF7abigIxC505AZeeoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC60VIFKqKB2yRJ884MBQwWVJ6d0bbyh6pbMf8lX68CcQ&oe=6A6B6B6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NTYAhVPsMUQ7kNvwHe39zZ&_nc_oc=AdoujYh6Et8kx_IBRoYOymZ28WN3o7AlbXPI1bO4CsTGbbwzpeHFP5qeRx9ESGg9RdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWvXj_Iz8mXxvQLIDb7XBwTI33ufkUC2obCW7iRiJw1Q&oe=6A6B5A9D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqz4EC821QkQ7kNvwEWKPu_&_nc_oc=AdowcXjmiV_i_KJLIUBGG70c6sBNG3OlAvh8jh05jBoTLpJM-807tjaFaQkHpdsSBk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVXSX_Xdv4GGELwAjM5BBNIe8FD3g5TDCrcZelc1oJXg&oe=6A6B3E57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42iaHMwFliIQ7kNvwFvzMcX&_nc_oc=Adp2FIW1dvasNKr7X_8ZC3ff24ggNVnv037r8nKds-5VRyQQ2uamO-UlRSND_u8-WiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGTmiuDJYBLt8DGtZ0ipWOP6RhxaE_PDNrsLTc1AfU1A&oe=6A6B65F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBPH8ceRxiAQ7kNvwGRfqv1&_nc_oc=AdqlqaB35SLDP7GnBMbEIgMsGS1RalTq8KV2YLxIDQXr1dwAeyvt_pgUsLyVKqGskT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdbdEOvN0KziozC46ePLWJ_a2pwJjS4Rr5KkiQNkG52A&oe=6A6B5526"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVKjfmLnBw8Q7kNvwEk5wCt&_nc_oc=AdpCEbtHbweHaXdFssBbqe6hKdxRM-F9VXQqu8aMdjiSUeHZUnhyXrdHG0C3zfgk58A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb5R8uz20Zz480IsOELiUWQhTPo44V1O_C9-B-pkC_sQ&oe=6A6B624B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv1elLUZxfMQ7kNvwH8sfzM&_nc_oc=Adol9lcNqAn0-KqECnXkwah0CiAnkuDhmutOYkq1kvuWq-_UWsIHJMPSGuTDoKYYwQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH8ZljffD4aEbhBBOc4PpHxPrAfPPt3efPObvEoW6Lqg&oe=6A6B5F16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsD-evjedMgQ7kNvwGhWzWm&_nc_oc=AdoCHr_MjG9TVIGnb6xT2pRTShpENnX-BMIy1Wdkot-O1y0iQBl5Q6du-DcmYcsqsVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbhu8clH7ABqAhRYjlZ2_Z-23O1DeM5uv7XPAD5jcj9Q&oe=6A6B4BF4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
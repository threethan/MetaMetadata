APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCw2xXCtElEQ7kNvwGqMKxy&_nc_oc=Ado0eqsjMH2fpx3TdIZb2CXdWJ_XsrPzn_GzkoptFbLCId0UURLbALSboPFbnpKzGlg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzbIXa2YTXL2cmqSYBj403JBrnqgcMOGFRXSrFP6tibg&oe=6A5501EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjoIg-VFgSgQ7kNvwF_WsQJ&_nc_oc=AdrpmWiY_PYaOwECIcPisgSOh0Fz0letd7QHO9a9aa7QhnfefHRWzfjHZL60aYvJQlw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCspaRmDF8A2YbOIylhoiqwAnNXCNupP9KDfUTh37UKBg&oe=6A54F11D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bbMZv0Zgl8Q7kNvwHG1Y0D&_nc_oc=AdohvVol-Ew1P-IGW07GUVergtIxcbWQw6qiK3tfhL5FsbuuAWs05baGLpj-xT5VFWs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwR4A0DOBUKw1WyAntwvG9s8LU7Y1dXuh-bQeDNuTuYQ&oe=6A54D4D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv_yQxEjrKoQ7kNvwFjNgAy&_nc_oc=AdppgZWuBS9C2qBWw7PAns0UGyrBdXh3uRt8VPp49Dv5Hv15rBnlp2s4eXIhor-Udqk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVQiHcW9LMDxXFO-VsbJdkq13mFv4dIl3DENM92QI3og&oe=6A54FC72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AzXHJ7hErwQ7kNvwFnxcdk&_nc_oc=AdrGIjZP2bo4x--oeMnKUTGNk0_msBcKPiP3YoxPQChrmsm_-v23ri8fxGlx4tz5SlI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgC-tYstZsW4c0BkQI4I9ZkERiToCML_eoMbpPdxPxPQ&oe=6A54EBA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQAYl9e1YggQ7kNvwGdJJbG&_nc_oc=AdpGytDOGW2UsbYvF-oRojjCXQABPz6XcQgoU7OuebQuHvAfQeRmCu26ciSl2Eihs-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUGpkv48kUMxJeRRU6ZX439G7yEtU8_S3nROUw04ECDw&oe=6A54F8CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRiaKN5vYa4Q7kNvwFpuso5&_nc_oc=AdoPZBhn1_gbWYIkvaA0MgdR1sUFKB3kmdMRLkDJm3v1HSJuOeEqyorZGCZlx9iUBrI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ50OgLPdSaJTrScxW4Mnhf2WCOD3tcJPvmn3Zmvvhgw&oe=6A54F596"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSd8qNrFb4IQ7kNvwGRVcQ_&_nc_oc=AdpIGp2B0_Z5Kv-S1fx89zaRU2sKV0aMsJmQIqC_8kVr3oGQQn4OZyID7IAHttMYnYI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcpcfCZf__YGp70SQ2mSd9q6jPJ-b3L9dwnEwuEgv1Lg&oe=6A54E274"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
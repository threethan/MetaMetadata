APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHHdTFVEAV8Q7kNvwHYKVwF&_nc_oc=AdpPRCV7vuRjqmaBl6iQ6U92LuLg8ARDBb7G3PIzfoSwGgQX_duPoDck6XCbzUnOyqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3GbrScoVkHcT1_AZ8PMJSNkzHcizZiQx1trK9x1Pzqw&oe=6ABD286F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRCcgge6QBsQ7kNvwE1LPnr&_nc_oc=Adq1_6kaMmFLp9je9OLzfRIa-qaeXjW7oPfVv4HOaDSyHlBSsh_-v8tzJsYi6dyMXN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIDSzBcnLV705W7fjFb-qf8xJus_5WZWNjEIYbUxIkNw&oe=6ABD179D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hij3rzJ6KOcQ7kNvwFD86EX&_nc_oc=AdoFF6S45HIkJZHjs4towm6fpPpn_TRLqiX_7kqKk7H-RG6QEZpfK9HmBL6NiagI5PE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVH2zkdy1-Ghvwo2UIvz1kL1Crl3Xl_xOVlppYoBi0Bw&oe=6ABD3397"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XuQU6PZGjEQ7kNvwGhO1vh&_nc_oc=Adp9xA_6GtEUT8nnHlZexEUiLHnRPPeYy-gsnwWjgtWePssLYM92Wy-bqghXWNFiqxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVAaAOnyWHSvZpSlTLSKLT3zK2_sfO-w66-B9iCVqmJw&oe=6ABD22F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcSN0G1nQFkQ7kNvwF82FSG&_nc_oc=AdpZaqSmH3MzYe6hkHXUUe6C4FoB-dANsJqztzRxdObGTwTA8OrD8FpOFEUPMYwAyeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ2OhL7kp61Mv3DbyhxOpZYY3UDNO37gv_xTc6_IS4YQ&oe=6ABD1226"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcMp7XieHzUQ7kNvwH0C99c&_nc_oc=Adpe3fV-fR4zx2t_DGLEQU0PocqSUz8E2wnLoWlGfw3JqYb34xHdfCVphLGlNSr2mUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMJ_2W1szS56GUq6UIBqT4O-Km3VJxA7MwRVYmgKmnKw&oe=6ABD1F4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7T50fzCs3QQ7kNvwHMmbdG&_nc_oc=AdqnWCH7BnBDM3jqazt2aEcliZVJjeSrkjwiG9EDPlxVs8nV4sXpS_GezmIA0bC9yZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMcpOP3jJBEE-DFJKVt4C_229ybl0oEYjdl_H6BTVIFA&oe=6ABD1C16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZZl9WqGGnoQ7kNvwFchK9x&_nc_oc=AdrIv6kyPNv0evvdlqN0Sqn19mO3yURQNDwCT2QUH9xHiIqODJljkOll9pI-SbxIpI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgpOcJO8Zu3CIrHeBSUBbPTp9NyAzM8ONA2dGW4Pb8XQ&oe=6ABD08F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bysCRlBVr4MQ7kNvwGGXwBb&_nc_oc=Adp20dt-yGy0670SoY5Pqw67d6VHbs12ta-0Mpyvs7ImWd4kF8EwpClYJgfyhiqXMq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbumMzFs_uHwjYaKxzHv-95vrTuzDZD0Ho98hf7Ku9AA&oe=6AF72A6F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY1n2ZiEZTAQ7kNvwHku7QH&_nc_oc=AdpJixHyKEro_KoLPjuWKWMgWeiQ_3kpp8XBqicLLjBaks6w30hzfV8INws6qYva0yQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6MHhWiq6tV4bp7P_x3kyANHJvT0iCuK6zxaOyaNYSyg&oe=6AF7199D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iY0wnDp1ycQ7kNvwGVoa4q&_nc_oc=AdrGxGlSiXfuz--P1vFDWr9SEu6Q2xGyZSlunwIeIOG-n4Wmt-oEhKDeaXklK00_g_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuHJzfM2Z0BQxsamiGuyJNezL8zNbL5JWBhKhxrCcymw&oe=6AF73597"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK22Hxc3p1kQ7kNvwFhf2FR&_nc_oc=AdoA9wRr6jLoGqOD2SnjS-g4ca62TrTgUOmYLND1veFDb-hSs4uEAE2Q2Iye3xhv5ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDBNJl7DJRnJXpERJeeevKsnZVpkm_agXUPJEyrdWZ2Q&oe=6AF724F2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsevbAYz2bQQ7kNvwEBjUCL&_nc_oc=AdrmEIXIz1sgoqKMD39sPyYcxvAXPrRI_a2y02N0t0wCwY03sZoAGI358uuK2Dtk_a4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMRl0_VD3kSocnBorc2t8YqyThbHAG4Mbk6v9AoxXmKQ&oe=6AF74C66"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7ESA0Bb0BoQ7kNvwHHh3vU&_nc_oc=AdqHyPBmvaEwA_QXxnprMxdJi_XZIB4uTVjkfSHQdDOe9Qbf9W0Kh_i_ukhxBjQNY2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDwpGZW57TgrXtTcKEl8dPjgfhoqxnfoAMJFs27e7DaQ&oe=6AF7214B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3FnzDGilVIQ7kNvwF6l7a2&_nc_oc=AdrG-HPgQ1O7gZZMNxG7BgB-Rg1p9ruoIBSA9IjMsMEfhPnjMuwmDU37rE0A6_katm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjO2zSeY-WYFojciPzVJqVLyxkVr7muzrUfJmrHqq2AQ&oe=6AF71E16"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-imEAt3dR3oQ7kNvwEafbdt&_nc_oc=Adop7YTpA8742EnhU4__CCfNNzG5O8r3geakVgBL7Upbu8cU74vRwD_MvSQkpf_Qoo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNcsDCVKZ_lBn8Gqm4fFD8t5i9eSfOjByYuJc66SEBwQ&oe=6AF74334"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
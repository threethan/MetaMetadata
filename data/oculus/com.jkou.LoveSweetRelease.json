APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bky6xLxr09cQ7kNvwEnku-7&_nc_oc=AdocP2ZLhcwKdtmTHFWRRKdukXV-ndfXbAy1q5p89xBRkD-W-cWBEgncoxJG5jvX348&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6mcZk3nZxciNo564yZOKujTVlkuOPbPY8vNlECiZq3A&oe=6A843FAF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lDjjghTAHMQ7kNvwEw0Bho&_nc_oc=AdoCSzwYu_g4YhnAF2i9jc9utLhqxyaNIavUDlAT1vPFsn6s77mQoc-GmZtJYBJmot8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAJtNuCA6KiuiN4xet1ogp3mDUU6w5wdUXVl9UZCk_qw&oe=6A84671D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvwgbAUmmqsQ7kNvwHUH5rS&_nc_oc=AdrpbBBMiPX29fst59AZKi-3i89eE1FmVVlRj86awsc3CGUG3Vr36uNxrIuAJFr8dYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwfS61ey572z4mNsdT8T3zSsMiK5B7FXInfdAHB6ZkCw&oe=6A844AD7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0AQWTTOKTcQ7kNvwFj72Jh&_nc_oc=Adpifh_1_Ue7neXVwPLKQaXy7GAwDxe4S8NHTN0Soc0Kls8FXtgoZOeiwTiuPgHMqeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL-zaS_LRs7C5ryBQWK_DZOZeVjTp_OGhpzgZsdtrwbg&oe=6A843A32"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjhB6v4XCB0Q7kNvwGfWgzz&_nc_oc=Adr-oUHbRKS2qiKJ_02VDzFfJ7DMrfEEMLFmfDCs39lMWtI-Im8DXrTiioW7Ocdr6cE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkKa-G5And6onzsMaoQ7HIzvBqUnlvZ8mlTVsO32KzJA&oe=6A8461A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dE-c-U-Xf4Q7kNvwEnMiX7&_nc_oc=Adr2DjHV70h8qeY8yXX0eAKL6tLXS1TM65CJJNK4t7IUCCZOo-A-DX-722F0tExlgZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbnACeEcW2SiOcXtqdUKoC6UZYxOWh7Ij8qXXQKKMY1Q&oe=6A84368B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox-vYvB-Y-IQ7kNvwEMZqXb&_nc_oc=AdotBfiQ_-6EGqCO7N9xn-IdkF0cjDO72q1kiFWhRi84nvFJLtay0hohP2DoPMhO-k4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu1r3o_tKwATtIgjBg_Aq91zPpxULcw0imFdTJJ-bywA&oe=6A843356"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crnW2UFGx5AQ7kNvwFXMkaQ&_nc_oc=Adrcz6Bu0Wrb1jU6djmvzUgVLxpKrbnBMM3_1NimPnDrgRx6H9Io9wlk7hkCtWEKAX4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5jYUG8fpTyi9rVq2pHru9wBQlj3hGNcpfnd0UDGHEJg&oe=6A845874"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
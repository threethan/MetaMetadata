APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGp8Y8k0bF4Q7kNvwG1Ormk&_nc_oc=AdqpVNfj7g0Uwy8kJxknbaZFfhFewINzAmDgXayqrErbDreMQf-sB6Hv5YM5CKF8dJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VZFOWdetuE644_uKw2RGjmx1g-VWs0sFA1zK1ItF1xw&oe=6A428CEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BCOWNVZvdEQ7kNvwFETIVu&_nc_oc=AdplboYHM4vORaNYXLvmCTGGFkwCa50da9gmhnVvtpw-FtIzJK91it4yfiU8p-_e7fk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qEuj4o33xPCRdZOdFQeKh-Cz1jGkE1uSS4vZo6VeWwA&oe=6A427C1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4k8dtbvPH4Q7kNvwHhbmoc&_nc_oc=Ado8KyQ6srKyismFUZQJ3XorU0nbAsKFUm-MuEMVWVDC5Ya4AjeL73axW7CWFYZIZqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BDVHgTXo0slgdMowl5RVeY5uOjg39Y5avhgoY7DCL2w&oe=6A425FD7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PowpyNctQqgQ7kNvwEht6DQ&_nc_oc=Ado6KTj6XYCRHpGXbGZy9yDbR3HTHUjWklLsiLCUc191fpb4jY5szdFs5-A1Uim4MYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vJqC3JNGYrs0ah_-NwJE1sZXFCUS5dKbFZnWzGNvG5g&oe=6A428772"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJw7L3Ql7-sQ7kNvwEQT3g3&_nc_oc=AdqgLREc34sloE5qJWf2pIEnatqBzk6d2kRi8lpaYEnQwy-PoiScb0IXdxRuZ-BJD1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97NDfbChvZVIc3nCm2c5XDK6Mz7kZggIWWec_FhXl82g&oe=6A4276A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGbUv9klJCgQ7kNvwErjv2T&_nc_oc=AdpgoPrp_GfysP6Dt7ePmTDVZiEPRbnD9HBKSJPvn8R8DzoqoGRvHtsufBYjX6ipQFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r-fcsNHqpGWQO7d5GOuW2PhqYZJgvwfEklOcSmBJByg&oe=6A4283CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b2Q_1nWxzYQ7kNvwFUIj7N&_nc_oc=AdqDmU139NWlboCHkz5brt9pzR1W2GID8Cc_58xBlmgQeFZd99M7SUAjJMJm6OVA994&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tqi6uSTrRxuEwkzGEKvuvQWp8jzZfAeC3UiA4s14f2w&oe=6A428096"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWIUiuBpciMQ7kNvwFhHM0m&_nc_oc=AdpUrUAyjAJ1xs3KdEoGh4n3IPrJZNbopsorYQCKMYaLX8zuEGWQIf29rmgBn4YucgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SBL-xrWpqqJ5288oclRBOGTV_ToP9Ps-4tz6ug03V8Q&oe=6A426D74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
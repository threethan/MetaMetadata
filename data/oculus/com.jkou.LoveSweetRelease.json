age_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBEoef0J4tEQ7kNvwFWfwcu&_nc_oc=AdpMrOiYbbnvW-h8iPJmes-x3HvDWtq67QIbVlRYcmNKcjlBqo7znIjcLkKaQWYrf88&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRl6AIpNTUJCBkFsPgbNX51fQf7rvm_-BfusU18492yg&oe=6A85912F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lDjjghTAHMQ7kNvwHsks5F&_nc_oc=Ado1p3pxKaZT5rjUbZi7ASsOp0E9YTtJmCweU7wlwOc0EaFVLtiwRzG7ChD_zOB3CfI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoKUPLaYXzPZXpkri1nbwUmEmGQCZCh0VmvX19a_CRPA&oe=6A85805D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvwgbAUmmqsQ7kNvwHHpx3w&_nc_oc=Adry5bzpVptjt_JlViREJ-1jJkAIyT0djTfhsJ48f0OGQqJcqKaOsOaivsFsdCoPsdY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJJehU003GJbDFtOc4twZOzcNvpdvNDjWWdZ8cuUxL_g&oe=6A859C57"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0AQWTTOKTcQ7kNvwGTNn6Z&_nc_oc=Adrw1PFuGgUQNQcYa3xxA_xtmcdSh-TOmLyyItaOET6IyDwVsvTo4f3NMSpwQRmtsNI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBPtOl7AdJRV3Im6sz9CLHQj26nMqLoCnjAAzxQ8GARQ&oe=6A858BB2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk61pAzK4QQQ7kNvwHobvYa&_nc_oc=AdoxpNLpAWdNHxpISY5YZx5u85CtyIR0Z_6GkiBHzoyD7IhFG0IrtD4hxBSkPDolBYY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAy-g1lWydKAcS-OJWFT3jd8r4ElMvYnNmB4LIgA0Msg&oe=6A85B326"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dE-c-U-Xf4Q7kNvwFh1mOv&_nc_oc=AdoeE0yMpiFZLkrmlJLU2JD1Yh0AZ1eMb6IDTZd9ISlWPjU5K5q1_YsklpHXFiPxoeA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvhTyw5-fHk6I4VnwqW5ycj8esfr2vn8r2KxX6Xk8qaQ&oe=6A85880B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox-vYvB-Y-IQ7kNvwG3VGpI&_nc_oc=AdrL890X8GeEEdn7121Mr6dER95LtSgfINMAFZUxEjg9RsSGhqEs4Vn-UkIOQY3AE-Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJtSCxLt79-Cb785UJ89CmIGnmlZpUWP2C11gXHLfZfg&oe=6A8584D6"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crnW2UFGx5AQ7kNvwHGKmoJ&_nc_oc=AdrJU83MN3bf1Q1Who56TA-otPNG6Q5tT_q8s1Hm4uy43oGER4_2k-ebW6XXKMG1GoM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4tjanGtSzxaLoJPTbiTYS3y4ysfjPaqk1qLuodXTOoQ&oe=6A85A9F4"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "
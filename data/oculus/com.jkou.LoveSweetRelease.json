APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQfZ3gplqGMQ7kNvwEkfGuk&_nc_oc=AdrR923U8IytNfHV8rXKRqdrrJUCP7CAwXjZ9CaHnJMdu-sOGLjN_3hWt0y0cdgS4yU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgF0BosKznrUbuYE8GtvbgFLGU80SXdckfANitLmwjew&oe=6AEF416F"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKfib1ydwdcQ7kNvwFkgSPE&_nc_oc=AdqnBU4-NZ8s2nM59Kykq3JiSSwvALxePSW8oR9pCIWg-lTzielpKWKpJcOK21zdOzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJQ0EKuc4SDicX3GULrQIVMY2YTyVVtwTItugeIK2xqA&oe=6AEF309D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YsOPcH-YsYQ7kNvwElXi2e&_nc_oc=AdpuJFLXhp_CK8zZ6-Xi8K_g5bH5cslm5B_N0BNYPYPtmhFe1pPT5DJ_QXBmxQJvzjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXF1ueRbEyOXt9nG9No8uMOB7qYmm6SzPNvUr8q4qVGQ&oe=6AEF4C97"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7pFP7qa6xsQ7kNvwH5gZLT&_nc_oc=Ador0Fnsr9Gsb-sZkEFogaQJpUtxm2iAhP8loPN8fj0CVEeAeUscDDcuMQs7RUvutAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI5ytB4pWTShUO6og40uYBhJNmBsAcv_QH0TgWnEg94w&oe=6AEF3BF2"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFR-hZpAMooQ7kNvwG_DsUV&_nc_oc=AdqQ6oZiGHD2JdfiqSsyCp4brN8_LhxWJOV7FhNR2xBkUdB9imWnfNToEEZ6T_QLmfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdxadQxj_5vwIc4AZEZuXwIK5_Zaxa5A2tUV4wpbsz9A&oe=6AEF6366"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC4GKgZlz7cQ7kNvwG8usnD&_nc_oc=AdrI8mCusAFfxG_5bgGyPoTSIL2xFehET0AeU_mJSAnidIAdoCmG5w922L-Yk9a4yL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjxNH811MuVoWkghZQifrQQwX7-tmzmQeO1oyo9XL3PA&oe=6AEF384B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ7eYP509T0Q7kNvwHz6Jp4&_nc_oc=AdoPuLzDyB7LBo_OStqY6NQGFCQuy4mNelNMxEXRK7xDnmR6WF8VZ8zu0m3RRKbzFiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkB1nMQIg72xFMhCC6bTgiiDX6xhGXdTfbQloMT99I4Q&oe=6AEF3516"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8afOGlblAIAQ7kNvwGLkjMH&_nc_oc=AdqDzf0g-keBN0dZODty8KCzHcA_UYWUVImbxpMPxFgQtZVryHMqFn7rNwY701OImKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwlmQNwD4Y4DCLloOpWIqYVA2cxOVuHMX0LUwml0G9Qg&oe=6AEF5A34"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
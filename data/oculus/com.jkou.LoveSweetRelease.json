type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUj6E8KU-B4Q7kNvwFLhcXg&_nc_oc=AdpHyuh7wbn7fWah2ysGHw1dslPMdnYyN-vyWhDqU4a4gzFc-9n3ThvXhsC4OxrPRQg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgNyY0TTvWoJXRbrfqbfgXduZsq35ksaNXpL3wncV3TA&oe=6AA961EF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFfZuosFjVgQ7kNvwEse7Bv&_nc_oc=AdrmFTSnEWgRwjhygExmQww4F7Sqya4lmlY28l6uVt04jgCTuhfWP4EW7b2Mm7_SOuk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn_TQM_pVchBgMNQy9YejBcKtSyfb33syclbJqbfTjOg&oe=6AA9511D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aOjAfAcq-cQ7kNvwFTFwdj&_nc_oc=AdoYbp7ZfWGCj9ow9oBC8knC8a1UHi8tXQNh3Ez8e0AVKv95c3hLIJHPp5HQeJnUz8c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiQVB_6wLL3XxTW5c1ArV9ecMwqako9OMBE9ouqbFkmQ&oe=6AA934D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJWzBzQOSYIQ7kNvwFke-k1&_nc_oc=AdoiuKzaEi51hbedt3Cb3hbaX7UKGYkSv6xQ2m-EcwpIXO6p4oPziPQbUZI7n16Pd5M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYbzyCsfwQUsYSqO3IlV1-3SOeLDDixBX3BSeeVhze7w&oe=6AA95C72"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjZID2jlAD0Q7kNvwF8BXgS&_nc_oc=Adoo28kGsLqD2Ar76VA2t9sbLRjPZhxzFU6I-4gzI3ppR9JjNTAB8_VOR_0fVdacvrs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ80LPlYwpTvqQKPSlgtaEKSGIan6CQxahzq4buPC5Etw&oe=6AA94BA6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zlSellIQ0QQ7kNvwEVHkKb&_nc_oc=Adr-B7T62ri3OmCZfzcYjG_1IZO3LKjRBuNEMHU1DYof5Jx7ar7YN82lk2veIcwAL68&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiSXDonw-IlqAYap34ju9BBtIk85Hdi6dV7cIJXmUL_A&oe=6AA958CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR-RH44BE_kQ7kNvwGjT-mp&_nc_oc=Adr37dpv9TFmLsmv18xvVsU3HCCK31C8-f6xuUqO9rBOCXzhtCysRMHDoY5oavOmyzA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJP5IwZvv8Lf4WYunJYGI1CBYOwK2l45sYM9MwfQ5tCA&oe=6AA95596"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JyXJmK-NxEQ7kNvwHIGERz&_nc_oc=AdrcHudDbUWy10XglN_lmZ82fZCLh-oWTOxdswyQg6hlqvXFWh0IaWqFh7UdVs2PTO4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbc-MzsONaPzeTb1KVQoQKMc3oPiXteaLNZMTNC_3cFQ&oe=6AA94274"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "AP
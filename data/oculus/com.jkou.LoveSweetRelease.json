APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_181027834108237_4010161385831159346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anDTVZp-WZMQ7kNvwFfPdDz&_nc_oc=AdpeRqNYuoJ780kyEJQEvBCDg1GKvEBurh20cWWfUNa5WFk1eve115hWfnESV-xuSuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBniPv01VKhFVYaKIhyVj2WUbmslilATDdojElDThPWYQ&oe=6A5F8DEF"}]}, "id": "1676497836938214", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1619932903027499", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1619932906360832_9023164107050636344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHgAAjytziQQ7kNvwEpzK5W&_nc_oc=AdrZzoqQlgVh_zDTPuwMow21Z5yZ3MbVMzheR-seP2QZtabHoAAOoWuPn01h8u_dDYo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_G5-alCtu8xcuddxHDBd4T4SWZrlV9ZI3KGiGMNTmbg&oe=6A5F7D1D"}, {"file_name": "2.png", "id": "892869660494255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673558985_892869663827588_7463212264666725674_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZRv1o9qmnsQ7kNvwGEIuyZ&_nc_oc=Adr1WJ56ETF9eX2AgLnxa4bqgAynbJ4ivVkfRJ3yktDlsEbEDjgISgSaLUTgPwh46fE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdeHlSSuJaLZvilJVdKtirntB2XwbQ7hlDLyVZX_UwnA&oe=6A5F60D7"}, {"file_name": "3.png", "id": "997388806356967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_997388809690300_1285532474151893271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuogWhFov84Q7kNvwEjTKpT&_nc_oc=AdoGNfFUo8ad1DOgeDVS2NFhdtnDoUCjHAkleyCUG6CkUNJlf61zplXFF0pbJ7XAmc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ1PKZIVRsw-4t3A8qs6BzCs96ZGyavMEVPBffoqIIjw&oe=6A5F8872"}, {"file_name": "4.png", "id": "27136482506013641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_27136482512680307_6165729917653941493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsUrT4iDmBUQ7kNvwE8QS0P&_nc_oc=AdqW3H5DRbrWlUkcF9gGvdOyb506sL7-d9QhZilpaDek8spSjh6grXkMDY_ETxYmyUg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChK_dMtQGoAqYVzDJzr0b8IlF8AujQO4TYYTVg7eZw4w&oe=6A5F77A6"}, {"file_name": "5.png", "id": "1140504474960577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1140504481627243_8406610962587380331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-32MLZhw_0Q7kNvwEFH2yW&_nc_oc=Adq0rUHRnERP2TS2ls6D6DRES6L01_tX13d6KHvMR51sAvfq7K0609SLY91f6e31eV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc97ZYULp6-A-LptE1lfDRkFoUg9Q9ZfDq4x_zqAKSaQ&oe=6A5F84CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2028093047581095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_2028093050914428_4516307181800575249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tqoryMglSsQ7kNvwEu3jSb&_nc_oc=AdpxJLSZM7l-wsSJ3cA-RZVDh-0UgAy6r6x4a56lkCk5Qhe6zdQklHglhmbsM2IK8z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_zy5HmwE_f0wNTW2dHjScrUg4ELit5Qk4-YrD330lRA&oe=6A5F8196"}, "display_name": "LoveSweet", "keywords": ["VRFlying", "RelaxingVR", "HealingGame", "CosmicExploration", "DreamSimulation"], "long_description": "# LoveSweet \u2014 In VR, reach for the stars and gently reshape the world\n\nPut on your Meta Quest and look up at the night sky\u2026\nThose twinkling stars are no longer just distant lights \u2014 **they are yours to reach out and pick.**\n\nEvery star belongs to a different constellation and carries a unique emotional \u201cExpectation\u201d \u2014 bravery, gentleness, curiosity, calm, and more.\n\nYou can **fly freely through the dreamy sky**, weightless and boundless, just like soaring in a real dream. Feel the wind brush your fingertips as stars glow in your palm \u2014 the immersion will make you say \u201cwow\u201d out loud.\n\nBut the real magic happens when you **infuse a star\u2019s Expectation into the NPCs** around you.\n\nA timid NPC gains bravery and ventures into the unknown.\n\nA cold NPC becomes caring and starts looking after others\u2026\n\nEvery choice you make quietly changes their behavior, letting the whole world evolve because of you.\n\n**LoveSweet** isn\u2019t just an exploration game \u2014 it\u2019s your personal **gentle dream-weaving journey.**\n\nHere, you are both traveler and a little god.\n\nEvery star you pick, every flight, every infusion brings brand-new stories and heartfelt moments.\n\nPerfect for anyone seeking healing, creativity, and pure wonder in VR.\n\n# Key Features \n- Exclusive VR immersive star-picking and dream flight experience\n\n- Constellation \u201cExpectation\u201d infusion system that changes NPC behavior and world paths\n\n-  Highly free dream-sky exploration  \n\n- Warm, healing emotional stories and creative joy\n\nReady to try?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "LoveSweet\nReach out and pluck the stars from the sky in VR!\nEach star comes from a different constellation, carrying a unique \"expectation.\"\nSoaring freely through a dreamlike sky\u2014light and unconstrained, just like in a true dream.\nGently infuse the NPCs with the hopes of the stars, alter their behaviors, and personally rewrite this little world.\nLoveSweet \u2014 Become a Gentle Dreamweaver in VR\n"}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2276745736412388", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_2276745739745721_6935528064806192183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTO1OLDmwLsQ7kNvwG1zoHP&_nc_oc=Adq4uStNPwsWLWN0l1E27v5b4Etxg21S_-A1Q5o0fmgYao5mWT7lHXVNbPKjyfQtidY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxXz7Ij_mV_ccYCa650VKWaVnYl0JQ92e5wZ3gFc5PVA&oe=6A5F6E74"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2093976640944279", "image_type": "APP_IMG_COVE
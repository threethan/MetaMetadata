short_description": "Reise in der Zeit zur\u00fcck, um das Jura-Zeitalter und die vorzeitigen Wesen zu erforschen, die einst die pr\u00e4historischen Ozeane beherrschten.\n\nBESCHREIBUNG\n\n- Ein Spiel \u00fcber Zeitreisen, pr\u00e4historische Wesen und ihr Aussterben;\n- Erforsche eine eindringliche VR-Unterwasser-Welt im Jura-Zeitalter;\n- Befahre ein lebendiges und gef\u00e4hrliches \u00d6kosystem, das von den geheimnisvollsten Wesen bewohnt wird;\n- Upgrade deine Ausstattung um noch weiter in der Zeit zu reisen."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.weareminority.com/privacy-policy/", "developer_terms_of_service_url": "http://www.weareminority.com/privacy-policy/", "publisher_name": "Minority Media Inc", "support_website_url": null, "website_url": "http://www.weareminority.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1199184137277915"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12727726_1024255064346699_1274508292135059456_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTBRlozPuBEQ7kNvwEH7ZEZ&_nc_oc=Adogm-9fXAlAeKWM0gkY_v1_EqznRE3G8ZSwCu-L-zNfvjM8vPzaDGJCyZS0PxDpSn0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4Mo1-84nPmve2PX9Pt8dw_pBO7p7k7TQ44-yb3FoVQg&oe=6AC8EC22"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Time Machine VR: Monsters
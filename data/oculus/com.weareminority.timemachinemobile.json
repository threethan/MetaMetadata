=6AC90D89"}, {"file_name": "migrated_image.png", "id": "223561235691798", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12727726_1024255064346699_1274508292135059456_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTBRlozPuBEQ7kNvwEH7ZEZ&_nc_oc=Adogm-9fXAlAeKWM0gkY_v1_EqznRE3G8ZSwCu-L-zNfvjM8vPzaDGJCyZS0PxDpSn0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIvRF0UIWZBuX4htnQXY_y_okyWlNlr4rVAJz_cty60g&oe=6AC8EC22"}, {"file_name": "migrated_image.png", "id": "215131792882410", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12533983_390510394617369_6244670951309443072_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvOtkDC7sTkQ7kNvwEsAP_n&_nc_oc=AdqRMRWGzWPSq717t22ro772kMujZ9sC6shFjwGH2lEMGHlg_kMmzWcRb5UUZE2R4M0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO03_GO4MEIR5_BrdJipf8CbeZE6tf15aVt8TgZUKWvEw&oe=6AC90647"}]}, "id": "1834604310009560", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "2641811122704264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12727971_1835183633428779_2303042720601473024_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP2ip-iPE8sQ7kNvwEgvMqV&_nc_oc=Adr9dw5kLLtuHPhIwioYr3WJOxjboTcII12grRoXk660nQSB-xZW8DPpTyReXuzE-Cs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHFm-XN3lUkb2XvOpEAGLQeHtrR_mm1CgRCjczZ-UfJg&oe=6AC8FD73"}, {"file_name": "migrated_image.png", "id": "573019606631176", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448837_1142901719170579_4989418685484498944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odw_jY4J9m0Q7kNvwHWOHOQ&_nc_oc=Adqjx4CPKWkfflrjEUChJ3PFnkIlf1c-psH500l8QymH9nowO6Fgei7ynnj6d6dlmok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSq32Emf9uq2x6YZ2Xz-_DdE0fQwxPN8FkuoSZB-zXng&oe=6AC8FC05"}, {"file_name": "migrated_image.png", "id": "221802479228664", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139237_1867120743571017_2480277818835992576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyen7rNgdzgQ7kNvwGKbpDx&_nc_oc=AdrsyMW8qOlQIu2HDZyeNh6ues3Tt7UWIwpoBcXY6jIaYBVlR5TLJ9IB1TBv4rgylak&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOti_rd0_p0-oVbZ3zQd24zQis1gKZfhBRd16q_7OqRsQ&oe=6AC8EDC8"}, {"file_name": "migrated_image.png", "id": "197370841565414", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12533755_365911037118364_5846039591865286656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkJT9mO_mMwQ7kNvwEC1znQ&_nc_oc=AdqdPCk4M9WdmtcfyR4DCCUxQiboOnPsNqzVjH7QBUBpW0FXbULUIFyv9a0wXI28b6U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4cleey6OF9P3Y4K9T1kB4Nwgm4f3eYDHE46sTn6eMVw&oe=6AC9073C"}, {"file_name": "migrated_image.png", "id": "195126225240205", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448923_368621133496971_3946465351725744128_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbknJ_mMJdUQ7kNvwHbpGTq&_nc_oc=Adpi4wVfIqaiUU1ToFJ43Qs4ZjuwQ_o6Cgj_fe__0PnrdyJlyqsnqehBJT7IJ71DcRw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHDHNx0qKfkPjn4qXQc0xD9djtGFEQefi2FKgJr6ezQw&oe=6AC9086F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Time Machine VR: Monsters of the Sea", "keywords": ["Dinosaur", "Jurassic", "Science", "Prehistory", "Water"], "long_description": "Inspired by the hit, Time Machine VR, an exciting experience made especially for Gear VR! You are a time-traveler sent to the Jurassic era and the ancient creatures that once ruled the prehistoric oceans. Use scanning projectiles to unlock and learn about scientifically accurate creatures. \n\nFEATURES\n\n- Explore 12 levels of immersive Jurassic underwater VR worlds; \n- A game about interacting with prehistoric creatures; \n- Unlock mysterious creatures: dakosaurus, plesiosaurus, megalodon, and more; \n- Upgrade your equipment to progress and score more points.", "short_description": "Inspired by the hit, Time Machine VR, an exciting experience made especially for Gear VR! Travel back in time to the Jurassic era and the ancient creatures that once ruled the prehistoric oceans. \n\n- A game about interacting with prehistoric creatures; \n- Unlock mysterious creatures: dakosaurus, plesiosaurus, megalodon, and more; \n- Upgrade your equipment to progress and score more points."}, {"images": {"nodes": []}, "id": "1323509787841802", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Time Machine VR: Monsters of the Sea", "keywords": ["Dinosaurio", "Jur\u00e1sico", "ciencia", "prehistoria", "agua"], "long_description": "Inspirado por el \u00e9xito, Time Machine VR, una experiencia emocionante hecha especialmente para Gear VR! Eres es un cadete que viaja en el tiempo con la tarea de explorar la era Jur\u00e1sica y las antiguas criaturas que una vez gobernaron los oc\u00e9anos prehist\u00f3ricos. Usa proyectiles de escaneo para examinar y aprender sobre criaturas cient\u00edficamente precisas.\n\nCARACTER\u00cdSTICAS\n\n- Explora 12 niveles de mundos submarinos inmersivos Jur\u00e1sicos en VR;\n- Un juego sobre la interacci\u00f3n con criaturas prehist\u00f3ricas;;\n- Desbloquea criaturas misteriosas: dacosaurios, plesiosaurios y megalodones, entre otros;\n- Mejora tu equipo para avanzar y marcar mas puntos.", "short_description": "Inspirado por el \u00e9xito, Time Machine VR, una experiencia emocionante hecha especialmente para Gear VR! Viaja en el tiempo a la era jur\u00e1sica y las antiguas criaturas que una vez gobernaron los oc\u00e9anos prehist\u00f3ricos.\n\n- Un juego sobre la interacci\u00f3n con criaturas prehist\u00f3ricas;;\n- Desbloquea criaturas misteriosas: dacosaurios, plesiosaurios y megalodones, entre otros;\n- Mejora tu equipo para avanzar y marcar mas puntos."}, {"images": {"nodes": []}, "id": "1039720029735548", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Time Machine VR: Monsters of the Sea", "keywords": ["\uacf5\ub8e1", "\uc950\ub77c\uae30", "\uacfc\ud559", "\uc120\uc0ac\uc2dc\ub300", "\ubb3c"], "long_description": "\uc5ec\ub7ec\ubd84\uc740 \uc950\ub77c\uae30 \uc2dc\ub300\uc640 \ud55c\ub54c \uc120\uc0ac\uc2dc\ub300 \ub300\uc591\uc744 \uc9c0\ubc30\ud588\ub358 \uace0\ub300 \uc0dd\ubb3c\uccb4\ub4e4\uc744 \ud0d0\ud5d8\ud558\ub294 \uc784\ubb34\ub97c \ub9e1\uace0 \uc2dc\uac04 \uc5ec\ud589\uc744 \ub5a0\ub098\ub294 \uc0ac\uad00 \uc0dd\ub3c4\uc785\ub2c8\ub2e4. \uc2a4\uce90\ub2dd \ubc1c\uc0ac\uccb4\ub97c \uc0ac\uc6a9\ud574 \uacfc\ud559\uc801\uc73c\ub85c \uc815\ud655\ud55c \uc0dd\ubb3c\uccb4\ub97c \uc0b4\ud3b4\ubcf4\uace0 \uadf8\uc5d0 \uad00\ud574 \uc54c\uc544\ubcf4\uc138\uc694. \n \n \ud2b9\uc9d5\n \n - \uc2dc\uac04 \uc5ec\ud589, \uc120\uc0ac \uc2dc\ub300 \uc0dd\ubb3c\uccb4 \ubc0f \uba78\uc885\uc5d0 \uad00\ud55c \uac8c\uc784. \n - 12\uac1c \ub808\ubca8\ub85c \uc774\ub8e8\uc5b4\uc9c4 \uc2e4\uac10\ub098\ub294 \ubab0\uc785\ud615 \uc950\ub77c\uae30 \ud574\uc800 \uac00\uc0c1\ud604\uc2e4 \uc138\uacc4\ub97c \ud0d0\ud5d8\ud574 \ubcf4\uc138\uc694. \n - \ub2e4\ucf54\uc0ac\uc6b0\ub8e8\uc2a4, \ud50c\ub808\uc2dc\uc624\uc0ac\uc6b0\ub8e8\uc2a4, \uba54\uac08\ub85c\ub3c8 \ub4f1 \ub2e4\uc591\ud558\uace0 \uc2e0\ube44\ub85c\uc6b4 \uc0dd\ubb3c\uccb4\ub4e4\ub85c \uac00\ub4dd\ud55c \uc0b4\uc544 \uc228\uc26c\uace0 \uc704\ud5d8\ud55c \uc0dd\ud0dc\uacc4\ub97c \ub458\ub7ec\ubcf4\uc138\uc694. \n - \uc7a5\ube44\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574 \ub354 \uae4a\uc774 \uc2dc\uac04 \uc5ec\ud589\uc744 \uacc4\uc18d\ud558\uba74\uc11c \ub354 \ub192\uc740 \uc810\uc218\ub97c \ud68d\ub4dd\ud558\uc138\uc694.", "short_description": "\uacfc\uac70\ub85c \uc2dc\uac04 \uc5ec\ud589\uc744 \ud558\uba74\uc11c \uc950\ub77c\uae30 \uc2dc\ub300\uc640 \ud55c\ub54c \uc120\uc0ac\uc2dc\ub300 \ub300\uc591\uc744 \uc9c0\ubc30\ud588\ub358 \uace0\ub300 \uc0dd\ubb3c\uccb4\ub97c \ud0d0\ud5d8\ud574 \ubcf4\uc138\uc694.\n \n \ud2b9\uc9d5\n \n - \uc2dc\uac04 \uc5ec\ud589, \uc120\uc0ac \uc2dc\ub300 \uc0dd\ubb3c\uccb4 \ubc0f \uba78\uc885\uc5d0 \uad00\ud55c \uac8c\uc784.\n - \uc2e4\uac10\ub098\ub294 \ubab0\uc785\ud615 \uc950\ub77c\uae30 \ud574\uc800 \uac00\uc0c1\ud604\uc2e4 \uc138\uacc4\ub97c \ud0d0\ud5d8\ud574 \ubcf4\uc138\uc694. \n - \ub2e4\ucf54\uc0ac\uc6b0\ub8e8\uc2a4, \ud50c\ub808\uc2dc\uc624\uc0ac\uc6b0\ub8e8\uc2a4, \uba54\uac08\ub85c\ub3c8 \ub4f1 \ub2e4\uc591\ud558\uace0 \uc2e0\ube44\ub85c\uc6b4 \uc0dd\ubb3c\uccb4\ub4e4\ub85c \uac00\ub4dd\ud55c \uc0b4\uc544 \uc228\uc26c\uace0 \uc704\ud5d8\ud55c \uc0dd\ud0dc\uacc4\ub97c \ub458\ub7ec\ubcf4\uc138\uc694. \n - \uc7a5\ube44\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574 \ub354 \uae4a\uc774 \uc2dc\uac04 \uc5ec\ud589\uc744 \uacc4\uc18d\ud558\uba74\uc11c \ub354 \ub192\uc740 \uc810\uc218\ub97c \ud68d\ub4dd\ud558\uc138\uc694."}, {"images": {"nodes": []}, "id": "750890778650270", "locale": "zh_HK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Time Machine VR: Monsters of the Sea", "keywords": ["\u6050\u9f99", "\u4f8f\u7f57\u7eaa", "\u79d1\u5b66", "\u53f2\u524d", "\u6c34"], "long_description": "\u60a8\u662f\u4e00\u540d\u65f6\u95f4\u65c5\u884c\u89c1\u4e60\u751f\uff0c\u8d1f\u8d23\u63a2\u7d22\u66fe\u7ecf\u7531\u53f2\u524d\u6d77\u6d0b\u7edf\u6cbb\u7684\u4f8f\u7f57\u7eaa\u65f6\u4ee3\u4e0e\u8fdc\u53e4\u751f\u7269\u3002\u4f7f\u7528\u626b\u63cf\u7206\u5f39\uff0c\u4ee5\u79d1\u5b66\u5730\u63a2\u5bdf\u5e76\u4e86\u89e3\u7cbe\u786e\u7684\u751f\u7269\u3002\u7279\u5f81\n \n - \u4e00\u6b3e\u6709\u5173\u65f6\u95f4\u65c5\u884c\u3001\u53f2\u524d\u751f\u7269\u548c\u706d\u7edd\u7684\u6e38\u620f\uff1b\n - \u63a2\u7d2212\u5173\u5361\u62df\u771f\u7684\u4f8f\u7f57\u7eaa\u6c34\u5e95VR\u4e16\u754c\uff1b\n - \u822a\u884c\u4e8e\u5c45\u4f4f\u6709\u795e\u79d8\u751f\u7269\u7684\u903c\u771f\u800c\u5371\u9669\u7684\u751f\u6001\u7cfb\u7edf\uff1a\u8fbe\u514b\u9f99\u3001\u86c7\u9888\u9f99\u3001\u5de8\u9f
9743117458338660_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9jEoiffyswQ7kNvwEcUqbF&_nc_oc=AdrvWfBfE6NX8_lL8pTaGe9QqOagXMWcoKUAnTJBUyJTbhpIMO40eejFgly_UE1ZxiU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MAiIrqPh_AMLe1BpA1xAfk1H32TcFs-BzTnu8hWtJiw&oe=6A393398"}, {"file_name": "Canopy Chaos V2_Custom..._17.07.2024_20-57-44.png", "id": "492409816637350", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75207233_492409819970683_4668425510427297834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMKK-66PoH0Q7kNvwGT_Cb_&_nc_oc=AdrqhN-CBAWA2-CLgTthuD5c0L5YehbUBJjEqypeNSYIB8r_dK5exZb-Y7DOGRe9CJ4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LtWYdTjnyqnSb0ipTRJHFteypIY_j7Z295ck1SQAUUw&oe=6A3951F1"}, {"file_name": "Canopy Chaos V2_Custom..._17.07.2024_20-57-44.png", "id": "7511942448932065", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86655532_7511942452265398_1655702758443543344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ux-ZZMbNCsQ7kNvwESGTIL&_nc_oc=Adq2RuHyzKVs4LYwxZUGFcdIuK3VEJURWBo7xVLW4GkQXj8Mk60SjdfsOFw58PsdkmE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J2mrfakpCe89mpPyX3_kyjMN9UxgIUl76cEWLtAQT-A&oe=6A393DE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canopy Chaos V2", "keywords": [], "long_description": "Canopy Chaos V2 is the ultimate Gorilla Tag fan game for those who crave excitement and customization. Dive into a lush, vibrant jungle canopy where you can swing, climb, and jump through the treetops with fluid and intuitive movement mechanics. The game offers an unparalleled level of customization, featuring over 100 unique holdable cosmetics that let you express your style and stand out in the multiplayer arena.\n\nThe gameplay is designed to be both challenging and entertaining, with a focus on agility and strategy. Navigate the complex treetop world, outmaneuver your opponents, and enjoy the chaotic fun that keeps you on your toes. Whether you're exploring solo or competing with friends, Canopy Chaos V2 promises an immersive experience that's perfect for those looking for thrilling adventures and dynamic, fast-paced action", "short_description": "Canopy Chaos V2 is an immersive and engaging Gorilla Tag fan game where players swing, climb, and jump through a lush, vibrant jungle canopy. With exciting gameplay mechanics, customizable characters, and a wide array of holdable cosmetics, players can experience thrilling adventures and chaotic fun in a dynamic, treetop environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/canopy-chaos-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Jupiter", "support_website_url": null, "website_url": "https://sites.google.com/view/canopy-chaos-privacy-policy/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7627287364035611"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "438529849165954"}]}, "baseline_offer": {"id": "438529849165954"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1721762569, "status": "PUBLISHED", "id": "438529849165954"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7668954906535523", "version": "0.3"}, "id": "853853423371118", "channel_name":
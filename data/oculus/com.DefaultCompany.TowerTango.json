_ohc=x9Wpe9LII4kQ7kNvwH6E9kP&_nc_oc=AdkQZbUkH7GOEEmirenyQrSXeUeNYsoRXXqgPE-bwIR96N_mTZL66ftUV4KlB4Pfwq0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZLEhWPlZyFgFedRrMgPq7Vo7gCW7etodaO72fOma0SQ&oe=69BAA6CC"}, {"file_name": "screenshot1.png", "id": "412727798050719", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982483_412727801384052_3050873979854878977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpEdF318m0YQ7kNvwH7NSh2&_nc_oc=Adl8GZB8C_-HpDkMSI4j5GnDxI5szdyfRXS_P1pSIkTJx2OwYNfyDytnqJgGmnAWVuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLLV7xdpVRyO9bTIw3sOPLEw1MaPchFvfjv3LYCEpa-w&oe=69BA91B9"}, {"file_name": "screenshot2.png", "id": "8746043432075092", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_8746043438741758_5582753368612337561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFZbAGTD-B4Q7kNvwHnsSJE&_nc_oc=AdmUe_bV86NomNM9eBgxQ3pArdpPC65tu1CbHro4HHVxsGLjpMvzZFKx2twqk4HDCV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxL01VWOqQzdltd3LBcDk_7ol6wxZEdn5TQ51xhocFBlA&oe=69BA8A46"}, {"file_name": "screenshot1.png", "id": "733187238941323", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974554_733187242274656_9060180601804483531_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZd2yDEI1bkQ7kNvwGvPgWw&_nc_oc=AdmYdeBt6WKUtv66zq-e_YUVFAS7CwCfWLiojbFj0ncxdrSZ67jtO-uZjboflcEHsak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPk61x4UfPVeKCiKNwqDykFBeLLZoSDkC2eHV8V--Y2Q&oe=69BA9FDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Tango", "keywords": ["building", "chaotic", "multiplayer", "free", "climbing"], "long_description": "Tower Tango is a chaotic 3v3/2v2/1v1 game about building a tower higher than everyone else's. This, however, is not as easy as it sounds! You and your team will need to work together and stack different building blocks on top of each other, while being careful not to unbalance the tower! \n\nTo spice things up, players also get to fight for the powerups that spawn in the middle of the map, while simultaneously defending their tower from AI monsters. \n\nThe character customization in Tower Tango is also not limiting! You can buy and equip a series of abilities that give you small, stacking buffs over your chosen main class. \n\nSo what are you waiting for? Join the fun in Tower Tango! \n\nMake sure to also join the discord server: https://discord.gg/zmK7rqDs8R", "short_description": "Tower Tango is a chaotic and fun multiplayer tower-building game where players compete to build the tallest tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/towertango/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MasterOX", "support_website_url": null, "website_url": "https://sites.google.com/view/towertango/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7983661658412673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982492_2041938206278044_634517241008743598_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKBjkQ0obBAQ7kNvwFq89GF&_nc_oc=AdlztJFnD8zD1yJZXSZVBj-wLavEcJpyVa7fhlmcR5fG4EWNB5s5GmXERq0emEzaiQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00
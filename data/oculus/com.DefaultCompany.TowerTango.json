_sLLfhFDLBuRW33ew&oe=6AFB4212"}, {"file_name": "screenshot2.png", "id": "887747056584799", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974539_887747059918132_6925685869229931289_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrludxRnQ3gQ7kNvwFQ9wNo&_nc_oc=Adqlz-lLYCUSTpPq4ORvQ7YV3lZ8l2RZbTszSF6PhLQ_IjoO1odfNc43p35Xcx3TD1Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScesLqlM-aZbfO_TGFRDiLwqaDoNbZcr43VEKIY2l7jA&oe=6AFB3B8C"}, {"file_name": "screenshot1.png", "id": "412727798050719", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982483_412727801384052_3050873979854878977_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBY-OaD3p0MQ7kNvwEdoA-M&_nc_oc=AdqgvHF4_LLA27h6ihD2Ry1gr9gtnojnWNK4tkRSHFLvr85-K_Zv6WmBiLa8wvnsrxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNq7jqDaJmTIllrqGeLHsYtopvyXJ-1elwS0wje0fzCg&oe=6AFB2679"}, {"file_name": "screenshot2.png", "id": "8746043432075092", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_8746043438741758_5582753368612337561_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpRNB6hpg7UQ7kNvwESVVw8&_nc_oc=Adre52OTVjIFJb6T77eZuepG6oEfhaXlK3s_pEKwRZX-wpTmlKHBhwqkxV1bN9u9MOI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzOIuKExB_QitepjyPn9kkoetCQbB9Di_zpT44-QM7tg&oe=6AFB1F06"}, {"file_name": "screenshot1.png", "id": "733187238941323", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974554_733187242274656_9060180601804483531_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNjieGyk5_wQ7kNvwHiijRK&_nc_oc=AdqUwzGyEhKxHFQDSNyVG3k4geDPsKbmkWGL47QCvBOXVGkMMGltCLVbuLf4sxMI_hc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrZYCVpxMpa1Axii9mNvU4d5UTFdOm7KoTkwIW1JRRVA&oe=6AFB349E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Tango", "keywords": ["building", "chaotic", "multiplayer", "free", "climbing"], "long_description": "Tower Tango is a chaotic 3v3/2v2/1v1 game about building a tower higher than everyone else's. This, however, is not as easy as it sounds! You and your team will need to work together and stack different building blocks on top of each other, while being careful not to unbalance the tower! \n\nTo spice things up, players also get to fight for the powerups that spawn in the middle of the map, while simultaneously defending their tower from AI monsters. \n\nThe character customization in Tower Tango is also not limiting! You can buy and equip a series of abilities that give you small, stacking buffs over your chosen main class. \n\nSo what are you waiting for? Join the fun in Tower Tango! \n\nMake sure to also join the discord server: https://discord.gg/zmK7rqDs8R", "short_description": "Tower Tango is a chaotic and fun multiplayer tower-building game where players compete to build the tallest tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/towertango/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MasterOX", "support_website_url": null, "website_url": "https://sites.google.com/view/towertango/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7983661658412673"}, "review_messages": []}]
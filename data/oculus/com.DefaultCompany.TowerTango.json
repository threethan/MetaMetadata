K5o5dcQb8pdu9QvVP7duSv89fbTt0jU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWDQLt3MZRkNJMw_57UGWsWO5jV0z5_5ihRvuRzxvDrg&oe=69A2EBCC"}, {"file_name": "screenshot1.png", "id": "412727798050719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982483_412727801384052_3050873979854878977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFpSmEQZRvsQ7kNvwGio00a&_nc_oc=AdkisstN1UWqp3eEG4jPu7ldWjB1YGSy1TzL244SKfAL2kmbWpS2wLgMgjEyICV5AH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfD-paE9vM-OuHpOACIYoKDHTUzmILmDz9V2kVfXcefg&oe=69A2D6B9"}, {"file_name": "screenshot2.png", "id": "8746043432075092", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_8746043438741758_5582753368612337561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EdEJEFH2IoQ7kNvwGJNDyZ&_nc_oc=AdmTd2E9NKJTdWuzQeEr3Nk9KTLS1EFxR296BhOP_5YpnCLqVkV7o3a_N8K04FyEcu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGjdlNgCSkmO2rxAtZ-Z_ToUNn6CJR5k7-iqxo8eO2VQ&oe=69A2CF46"}, {"file_name": "screenshot1.png", "id": "733187238941323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974554_733187242274656_9060180601804483531_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdpK6hpO_OAQ7kNvwES1khj&_nc_oc=Adn4fObEBleQ9lzzASicU1mDIzb8Mi33_kWtY4lnLwd7kQkv121VF7dg7xhhf5xToT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAZzBLWRK9WSUa_9D6lELDd8AN4Ct81NAJRoO-a6F4Xw&oe=69A2E4DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Tango", "keywords": ["building", "chaotic", "multiplayer", "free", "climbing"], "long_description": "Tower Tango is a chaotic 3v3/2v2/1v1 game about building a tower higher than everyone else's. This, however, is not as easy as it sounds! You and your team will need to work together and stack different building blocks on top of each other, while being careful not to unbalance the tower! \n\nTo spice things up, players also get to fight for the powerups that spawn in the middle of the map, while simultaneously defending their tower from AI monsters. \n\nThe character customization in Tower Tango is also not limiting! You can buy and equip a series of abilities that give you small, stacking buffs over your chosen main class. \n\nSo what are you waiting for? Join the fun in Tower Tango! \n\nMake sure to also join the discord server: https://discord.gg/zmK7rqDs8R", "short_description": "Tower Tango is a chaotic and fun multiplayer tower-building game where players compete to build the tallest tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/towertango/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MasterOX", "support_website_url": null, "website_url": "https://sites.google.com/view/towertango/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7983661658412673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982492_2041938206278044_634517241008743598_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ggeby3MpXH8Q7kNvwHUI9qs&_nc_oc=Adm7usKLu1-3CRipPywJZmR-3ky0StrOdguWg6a_x953kDoLSEJS2FQ8-b6yC-1K3mQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afspg1WU4Kds0YQiRDcvX5kqPh_mXBZt9kNLC-qhdwIlfQ&oe=69A2F9C0"}, "is_concept": false, "is_test": false, "is_trial_offer
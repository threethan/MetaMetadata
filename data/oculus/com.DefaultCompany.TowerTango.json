gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmxMFgwY8oIQ7kNvwEohZkE&_nc_oc=AdqqK7Ja5SYsaELSxZ4D1kdAriMeDjbH8zKxoP1mk3H5f69C9jBeWKdXbP22HfU1fMQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgdWftmLn8kGkru8y2VQWVh3UsCRvvKmcythGmy9_bAg&oe=6B085579"}, {"file_name": "screenshot2.png", "id": "8746043432075092", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031450_8746043438741758_5582753368612337561_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfxVR9fTxw0Q7kNvwHI0t0o&_nc_oc=Ado7_Tun86mdw8IYkuFng-6sGsBLoL6qVR386ajsfNZxhKQYWCAQvFJdYXmCdo6QcHE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtqFEKc9PahzCbE_0BV7yZkfNYWWlwRBSisHj2nACHYg&oe=6B084E06"}, {"file_name": "screenshot1.png", "id": "733187238941323", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974554_733187242274656_9060180601804483531_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBRSCxpqlfoQ7kNvwEL28bN&_nc_oc=AdrNwWbL9-VKtFqEpgNTHxKkHx0VBBio9c0Y4vP1Y_1mXwFPIfUSe0cmTEuEuKdbtks&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf6V6GELTh8-WCkbWd736JBJbYUDTPB2BH8AFbNh7myA&oe=6B08639E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Tango", "keywords": ["building", "chaotic", "multiplayer", "free", "climbing"], "long_description": "Tower Tango is a chaotic 3v3/2v2/1v1 game about building a tower higher than everyone else's. This, however, is not as easy as it sounds! You and your team will need to work together and stack different building blocks on top of each other, while being careful not to unbalance the tower! \n\nTo spice things up, players also get to fight for the powerups that spawn in the middle of the map, while simultaneously defending their tower from AI monsters. \n\nThe character customization in Tower Tango is also not limiting! You can buy and equip a series of abilities that give you small, stacking buffs over your chosen main class. \n\nSo what are you waiting for? Join the fun in Tower Tango! \n\nMake sure to also join the discord server: https://discord.gg/zmK7rqDs8R", "short_description": "Tower Tango is a chaotic and fun multiplayer tower-building game where players compete to build the tallest tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/towertango/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MasterOX", "support_website_url": null, "website_url": "https://sites.google.com/view/towertango/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7983661658412673"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1485174442373908"}]}, "baseline_offer": {"id": "1485174442373908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727102340, "status": "PUBLISHED", "id": "1485174442373908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8247033345408835", "version": "135"}, "id": "443211165073499", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7423729237739254", "is_concept"
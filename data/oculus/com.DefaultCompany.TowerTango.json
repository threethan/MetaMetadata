_ohc=x9Wpe9LII4kQ7kNvwGTYvab&_nc_oc=AdnCL52qqwASds21H604Cq09dmBtbD1u74cFsqB8c7hJlZsxTZsplmHfNq0n4Oei3BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3Ma8yRVN7D4v5i6gDg5zca8uCg1ZHGK8pfriutF2yow&oe=69BBF84C"}, {"file_name": "screenshot1.png", "id": "412727798050719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_412727801384052_3050873979854878977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyFNYXgOWT4Q7kNvwEj1wjB&_nc_oc=Adn_oY79irRB6SkM2RFHTdWBVMpOsBhn3EJJNfabUI4oDxrAYzPW5KQQEvVp0jo0RjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-9bnYXWUVgVH7cnP7shvnUl-c5IsoPaCnOa9hVxeKDw&oe=69BBE339"}, {"file_name": "screenshot2.png", "id": "8746043432075092", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_8746043438741758_5582753368612337561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFZbAGTD-B4Q7kNvwFpYjP-&_nc_oc=AdkzuvmdQFoQbXUiiANGIEo6r19gAiEjroiYav63PS9OUJqYDDyp8IHY-pzTM5iwr70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWj1EmNusAYCQwFvzlEq987McMLPqKvCU0EjDQsdukFw&oe=69BBDBC6"}, {"file_name": "screenshot1.png", "id": "733187238941323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974554_733187242274656_9060180601804483531_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-hPjCB2mnYQ7kNvwECW6b-&_nc_oc=AdnQwU0U1hPlMJrTzVV1kRY-aU34n2PWxPUBpzFrF1a8_a5NHVXymTq6INZ6FxqVf-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhlQiin8PmfqkC5ydrFs99T8E6_NnadL2rmpBJyq2wiQ&oe=69BBF15E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Tango", "keywords": ["building", "chaotic", "multiplayer", "free", "climbing"], "long_description": "Tower Tango is a chaotic 3v3/2v2/1v1 game about building a tower higher than everyone else's. This, however, is not as easy as it sounds! You and your team will need to work together and stack different building blocks on top of each other, while being careful not to unbalance the tower! \n\nTo spice things up, players also get to fight for the powerups that spawn in the middle of the map, while simultaneously defending their tower from AI monsters. \n\nThe character customization in Tower Tango is also not limiting! You can buy and equip a series of abilities that give you small, stacking buffs over your chosen main class. \n\nSo what are you waiting for? Join the fun in Tower Tango! \n\nMake sure to also join the discord server: https://discord.gg/zmK7rqDs8R", "short_description": "Tower Tango is a chaotic and fun multiplayer tower-building game where players compete to build the tallest tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/towertango/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MasterOX", "support_website_url": null, "website_url": "https://sites.google.com/view/towertango/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7983661658412673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982492_2041938206278044_634517241008743598_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKBjkQ0obBAQ7kNvwHEtBiY&_nc_oc=AdlKtQvZN39hAZl41LRelynI6YeJSe-486N0b5Hp-7hacYvjLU_AqgjAB59gWCx7VNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00
e33_HfPZ3k9_iHaa2TGR7a6mfXykxSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftFCWL4z9SDhsxzW0Cmf-zuOVF6fAerlrqCXg2V9jlE9g&oe=699C544C"}, {"file_name": "screenshot1.png", "id": "412727798050719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_412727801384052_3050873979854878977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NktUu-9Xcn0Q7kNvwGTPZaq&_nc_oc=AdkN05CDC8hH2AAMivVPTwcj2mLLixe-aS-j-Xh4q5XYx8IP9HWjdIubrDlPE9uM09g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuiPrbToPZsKDQAz_FIJXbEUaeEPjI6ZMo1Aaz7gS-q8Q&oe=699C3F39"}, {"file_name": "screenshot2.png", "id": "8746043432075092", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_8746043438741758_5582753368612337561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgMQOCk8ITwQ7kNvwEHUY9f&_nc_oc=AdlV20WS9JCriS8BrBZe8juNGzL58JsmJh3gZRtH2GSEyJwUCNz2DfA1gPnzsgYli0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfshHXbWJMGWPQgzS7e4g9Emtvvi21oQm7lJR619CGueJw&oe=699C37C6"}, {"file_name": "screenshot1.png", "id": "733187238941323", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974554_733187242274656_9060180601804483531_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBhxUgdOe00Q7kNvwEn4QKD&_nc_oc=Adm7g5QZB88s1XveTxSgBnmLGTuPhjUmOTa-VSXeEQpw434fVDWwJmTKjQEzFO7a_tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvZ9PqJoo2_0DTWwlM3EMKZXXK4ivgwC8G2cU7MAbEi1g&oe=699C4D5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Tango", "keywords": ["building", "chaotic", "multiplayer", "free", "climbing"], "long_description": "Tower Tango is a chaotic 3v3/2v2/1v1 game about building a tower higher than everyone else's. This, however, is not as easy as it sounds! You and your team will need to work together and stack different building blocks on top of each other, while being careful not to unbalance the tower! \n\nTo spice things up, players also get to fight for the powerups that spawn in the middle of the map, while simultaneously defending their tower from AI monsters. \n\nThe character customization in Tower Tango is also not limiting! You can buy and equip a series of abilities that give you small, stacking buffs over your chosen main class. \n\nSo what are you waiting for? Join the fun in Tower Tango! \n\nMake sure to also join the discord server: https://discord.gg/zmK7rqDs8R", "short_description": "Tower Tango is a chaotic and fun multiplayer tower-building game where players compete to build the tallest tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/towertango/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MasterOX", "support_website_url": null, "website_url": "https://sites.google.com/view/towertango/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7983661658412673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982492_2041938206278044_634517241008743598_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWdPw2_fbpIQ7kNvwEqmmEx&_nc_oc=Adm3Iv6Om_gwU0_00zXCqifZdNxXblYNMsw2DrrTvw2rTwZGgkOeua7hn40NMc2lIGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvNnq5j2dhbOOjOhcUPbSCMjV7cFZUjHJPAiBxIIrRHoQ&oe=699C6240"}, "is_concept": false, "is_test": false, "is_trial_offer
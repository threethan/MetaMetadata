le": "en_US", "screenshots": [{"file_name": "VRChemLabScreenshot1.png", "id": "952699708889446", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974685_952699712222779_5060338853593148044_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEpb5FwcDewQ7kNvwExlyiX&_nc_oc=AdnC7ceTRSU_G1edAfngSpAIUUYHOJiuRgE8tdeco55e_xHR13KlxOrtRmqjnKiScPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzC0zbof3DwlSyk5yAg2w0WuG_5jb0j1J3VeMXypPXIuQ&oe=69B2A146"}, {"file_name": "VRChemLabScreenshot2.png", "id": "324594862620245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974506_324594865953578_4367279156715063246_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVKpRPemRowQ7kNvwG_h00E&_nc_oc=AdlABC_8qC22sSzBqgJdp3Sb6POnuyr3tF391b5Rs4LwwCgZswjHB4TeaMYeMIS0NmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfSEjxWSBWzObo80SuOcLGnsrTS4yE-LHr6HcKnHhzmw&oe=69B29D9F"}, {"file_name": "VRChemLabScreenshot5.png", "id": "4063439060362216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_4063439067028882_1925107953584439780_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzqDe2Exw9oQ7kNvwEI50n4&_nc_oc=AdmQ8VXbfhJ3Ac0iJzomM34ZlC3RbRn2gYD4GfAjTl90f7DTXI0TBS9XXreT1GSGmUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyvY7ZPB5axluoGqS-uY4OhRhQJtvGpcuyZnO_JcQ5lEg&oe=69B2B978"}, {"file_name": "VRChemLabScreenshot3.png", "id": "920482272127955", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_920482278794621_1432969144147325397_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlwjzC5HPi0Q7kNvwGypfSY&_nc_oc=AdmdE18dYIHpc7zUrzh7ZUFtbBYHwuMbj6l2alBRGYSw9bC3BcQ5p1WjvJiPkKukZLU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5vqi7l81mxkE4Ndpue6eV_HsQPPy6JK1h_6PYo3v00w&oe=69B29F36"}, {"file_name": "VRChemLabScreenshot4.png", "id": "338842120931038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569453_338842124264371_1271572442538917737_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka0DjPl06IwQ7kNvwHyVyjJ&_nc_oc=Adk39VmvS1eptalNcV9avYgxLG7cLQGCSId_ddzP02-1122jJlIAiCWk4dpK2VheoH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxRU5dltiZTS9mLCYSIpv2m7O7UC_JbALGIuDPXUiJaw&oe=69B2C1E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The VR Chemistry Lab", "keywords": [], "long_description": "The VR Chemistry Lab was originally designed to be a research tool where studies of VR learning environments could be explored. Currently, it is still being used in research but has potential for student use as a hands-on science lab experience at home or at school. It also contains experiences where players can explore molecule creation in an immersive environment as well as play a game of catalyzing a chemical reaction. \n\nThis is still a work in progress and there are many possibilities with its potential for education. Any encouragement, advice, and support is much appreciated.\n\nCreator: Elliot Hu-Au", "short_description": "The VR Chemistry Lab is designed to be a VR simulation of a typical school chemistry laboratory and an immersive experience where players can zoom down to the size of molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualrealityforeducation.com/the-vr-chemistry-lab-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HAE Studios", "support_website_url": null, "website_url": "https://virtualrealityforeducation.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
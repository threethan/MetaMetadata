flOckSsKg-APJIBTks9Lo_UkQpOq1kY5n2bE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMPF12nWbk6sUYJI7n-ncQor5NV0yzgiGBpk9u_c9v9g&oe=6B0DCA36"}, {"file_name": "VRChemLabScreenshot4.png", "id": "338842120931038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569453_338842124264371_1271572442538917737_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT7r-xp5dPYQ7kNvwFt-nIw&_nc_oc=AdrQqJWqvtWIsMgQqNsIwaQBnZl8-frKx_J_zLDCC7C0nfC-GJxiGjOBSfhbRo9Fnr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcPcNIzJax4eW9KWXo03HFhypsls25d8Ulk6v_8x8MgA&oe=6B0DB4A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The VR Chemistry Lab", "keywords": [], "long_description": "The VR Chemistry Lab was originally designed to be a research tool where studies of VR learning environments could be explored. Currently, it is still being used in research but has potential for student use as a hands-on science lab experience at home or at school. It also contains experiences where players can explore molecule creation in an immersive environment as well as play a game of catalyzing a chemical reaction. \n\nThis is still a work in progress and there are many possibilities with its potential for education. Any encouragement, advice, and support is much appreciated.\n\nCreator: Elliot Hu-Au", "short_description": "The VR Chemistry Lab is designed to be a VR simulation of a typical school chemistry laboratory and an immersive experience where players can zoom down to the size of molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualrealityforeducation.com/the-vr-chemistry-lab-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HAE Studios", "support_website_url": null, "website_url": "https://virtualrealityforeducation.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36269221144287
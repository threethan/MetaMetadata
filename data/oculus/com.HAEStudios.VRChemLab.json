le": "en_US", "screenshots": [{"file_name": "VRChemLabScreenshot1.png", "id": "952699708889446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974685_952699712222779_5060338853593148044_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdNcUakh_DwQ7kNvwHZdyNw&_nc_oc=AdlmYZC1QEkicQ5lSR_82GGMwyxTt1pq_Z8SckEM5FU4TiOKEOjs39Ac2_xVwas7Szg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymbpSr3it3yITL67m1N3Se5PFjh-lAH5HIWrgLaJhHUw&oe=69BFD046"}, {"file_name": "VRChemLabScreenshot2.png", "id": "324594862620245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_324594865953578_4367279156715063246_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETi9AkpSYaUQ7kNvwFP_RFa&_nc_oc=AdkxuIOZp7JuGAlb1cQZxFjilHl5zidfoGVTRLm-ly_AnsKVsBbXD614kj7kPGAaoyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUb0yXpWS_nsHdw3CMQl9zCMvrWkkeLTmrWlX-QxhpAA&oe=69BFCC9F"}, {"file_name": "VRChemLabScreenshot5.png", "id": "4063439060362216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974693_4063439067028882_1925107953584439780_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR7-T8Fa-Q0Q7kNvwHOOlNg&_nc_oc=AdnO64R2RqPBvK7tFFOdn4aEB_LlkFZW9jOe6EY6uYsxmVnldxHEvkkOkOPzcXhdPjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh10V2N1nAifSjEGzp8GuKCuZoKcbJKINcAaEWWXErHg&oe=69BFE878"}, {"file_name": "VRChemLabScreenshot3.png", "id": "920482272127955", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036661_920482278794621_1432969144147325397_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knANq3k7I10Q7kNvwH9gkGQ&_nc_oc=AdlkP5TRF89vFtKMv13x-qbqA5shIVvqrBmyiLVQeQuQONUVRSXnbnZP1xomrrJMC94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGFuEyg8r_jw716rAw5CF3xkS3VdIeYB0_TE9xQnhJ6w&oe=69BFCE36"}, {"file_name": "VRChemLabScreenshot4.png", "id": "338842120931038", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569453_338842124264371_1271572442538917737_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzQocwF53v8Q7kNvwE_1QTT&_nc_oc=Adk1rVYCYORbP8NEGcqca5jhwxEUeuA8THnT9pNzrXPm5n0kp4-lBljDjnEhqaVX6NY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfysafOBCNjmjWNvJQHumKFFVWNKO86LaajAM0F22UirsA&oe=69BFF0E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The VR Chemistry Lab", "keywords": [], "long_description": "The VR Chemistry Lab was originally designed to be a research tool where studies of VR learning environments could be explored. Currently, it is still being used in research but has potential for student use as a hands-on science lab experience at home or at school. It also contains experiences where players can explore molecule creation in an immersive environment as well as play a game of catalyzing a chemical reaction. \n\nThis is still a work in progress and there are many possibilities with its potential for education. Any encouragement, advice, and support is much appreciated.\n\nCreator: Elliot Hu-Au", "short_description": "The VR Chemistry Lab is designed to be a VR simulation of a typical school chemistry laboratory and an immersive experience where players can zoom down to the size of molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualrealityforeducation.com/the-vr-chemistry-lab-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HAE Studios", "support_website_url": null, "website_url": "https://virtualrealityforeducation.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
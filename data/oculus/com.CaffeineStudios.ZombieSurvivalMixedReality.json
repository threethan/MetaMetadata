oUkgqMHGDYOvDvjfpSokoAs7DJ_-lqAp3qQDheyb_VhUcvbZJPKVUCFuRHRg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNvDqHoBI7TENTE-rwEnn1-AHzbGDbDIkT7Q6nBga2ZA&oe=6AFB1804"}, {"file_name": "04_face_to_face_2560x1440.png", "id": "1404814864484491", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_1404814867817824_4595555900634908146_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaV-SslaBwwQ7kNvwFT2sWa&_nc_oc=AdrrSic59GpT-eB6KU-z9cokf-F73PS0OEof05CghuV3dBSxad2IH8ZTjq8CxIVw9qE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyJ-HG6ZJypHaoESua_0nhh23cTYeeQ9eH6OmiFz7x4g&oe=6AFB3462"}, {"file_name": "01_double_threat_2560x1440.png", "id": "4227526544058931", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673652249_4227526547392264_8001907187050855408_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o65B-KP7ZiMQ7kNvwF6cgbB&_nc_oc=AdqdfFdnEh22F1zECGHxUxjuRMJ9Bfib-ZDo1SPrUZmEhloc8td1CQjX87-uFIw1jcY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTASIxMxnKKctsxg46GrrfqA7FsjQuTNgtVmq7VjK-Tgg&oe=6AFB2F73"}, {"file_name": "02_portal_attack_2560x1440.png", "id": "1760052898442704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604375581_1760052901776037_4030111458170413401_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYKzn5qcXJoQ7kNvwEV198U&_nc_oc=Adovjqe1B-L3LejQTaL3o4VA72DE7lB3bJT_V-erNrDf-llCOKK_NVk7dP1TXJVVOYM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK5MWIJpRSD2kfVQspR5PtqbIAfyWol4s2xHTCzIEb5A&oe=6AFB3A31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1050513144656148", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823259_1050513151322814_97339410552878944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiEg0an2_JcQ7kNvwGjF5Ll&_nc_oc=AdqrR_GGuSMfL-L8FHyDGTRYDYDwifRETUydbv6-NgegcfKAgJY-cL6D9oLp0PQi7Lo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi4S1ZLXBQONWu06BeEWCpp8FORxJ6bnyQfb47NR4DTQ&oe=6AFB39FE"}, "display_name": "Zombie Survival: Mixed Reality", "keywords": ["zombies", "survival", "shooter", "MR", "Passthrough"], "long_description": "Your room. Your pistol. A relentless zombie invasion.\n\nZombie Survival: Mixed Reality brings zombie survival combat into your real surroundings. Face undead emerging from portals and fight to stay alive as enemies become faster and more numerous.\n\nMIXED REALITY ZOMBIE COMBAT\nKeep your surroundings in view while taking on approaching zombies. React quickly, choose your targets, and hold your ground as the pressure rises.\n\nHANDS-ON PISTOL RELOADING\nEvery reload puts your skills to the test. Eject the magazine, insert a fresh one, then pull and release the slide to chamber a round. Keep calm and get back into the fight.\n\nSHOOT, STRIKE, SURVIVE\nLand headshots for greater damage or fight at close range with pistol-butt strikes. Use the pistol in either hand and make each shot count.\n\nCHOOSE YOUR CHALLENGE\nCasual offers a gentler start without poison attacks. Hardcore brings greater pressure and dangerous poison projectiles. Both modes grow tougher the longer you survive.\n\nBEAT YOUR PERSONAL BEST\nTrack your recent and highest kill counts separately for each mode. Learn the controls with the How to Play guide, then return for another run and push your record higher.\n\nStep into a mixed reality zombie shooter where steady aim, quick reactions, and confident reloads keep you alive.", "short_description": "Fight zombies in your own room in this mixed reality survival shooter.\n\nFace undead emerging from portals, aim for headshots, and reload your pistol by hand as the pressure builds.\n\nStrike back with pistol-butt attacks when enemies get close.\n\nChoose Casual or Hardcore, sharpen your shooting skills, and beat your highest kill count.\n\nHow long can you 
ent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_N7mACfL5CrFrYA50nkNwz2Px4cB9bOYikl-q9ZJ-CA&oe=6B104620"}, {"file_name": "screenshot-1.png", "id": "1476305734367807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830822_1476305737701140_8537478220238635039_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z668iGduJGEQ7kNvwFMUtuh&_nc_oc=AdpPIxOlmiN4DBRowfHvD6FjVsfxnx5LD3xfbU3-1HXaxfF2tAmtn2Svo5uhr6tpqEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFx4AWdWXONVSU3wHPG4NQN2gySTYJIJQI5NDsLGtyuQ&oe=6B1051A7"}, {"file_name": "screenshot-5.png", "id": "1018515224624486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673536876_1018515227957819_4259004761960368071_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZScFWgrHSQQ7kNvwHpNbcf&_nc_oc=AdqTGgbl_d4oWHPH29bTR8HlX8h6R7BoxSui0adudR0gYvUKwDpET7KZ1SsV92nYqXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRCj3Z0X5pNhNovRZoAw9xLRBfxVZRP0b0aLJl_MXBWw&oe=6B1066BB"}, {"file_name": "screenshot-3.png", "id": "2628108334291024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2628108337624357_5175117208445814206_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJOAtahZsVIQ7kNvwED1Nkh&_nc_oc=AdoX20QCI-_I02_Pvxc-wgIxOUYEtDIQZjPu3o_VmENXJe7SH-ZrZUHhgyGs2I_dpPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhGb4Pd1vLvORecw5HwfCak0kGmAI-8OvCg4fo72Eqvg&oe=6B103AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero-2560x1440.png", "id": "2500674393761768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_2500674397095101_5680615025974252312_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9aqjAjqzr8Q7kNvwH82Fgf&_nc_oc=AdruPLHqsSPWJvDIpr0aBt4XzPjLYBOMkGhz_G6oItwPj8wZbUG8s9sgtIe61RApn1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWeYnZZAWJiPsm7t1RqtMWiOUzv__OBh_fwrjmfuXAV2A&oe=6B104861"}, "display_name": "Wet Bottom", "keywords": ["battleship", "hologram", "naval", "strategy", "warships"], "long_description": "Wet Bottom is the sea battle you played on paper, projected as a hologram into your room.\n\nA tray of glowing contour lines becomes the sea. Your fleet rides the swell; on your turn the projector flickers over to the enemy's waters \u2014 another seabed, ships you cannot see until you sink them.\n\nAIM ANY WAY YOU LIKE\n\u2022 Turn two ship's wheels and slam the big red button\n\u2022 Look at a cell, or drop a pointer arc on it\n\u2022 Tap it on a small tablet beside the console\n\u2022 Write it in the air with a pinch \u2014 \"D6\"\n\u2022 Or hold the radio key and say it: \"delta six, fire!\" (recognised on the headset)\n\nTWO WAYS TO PLAY\n\u2022 Turn by turn: a hit fires again\n\u2022 Countdown salvo: ten shots your first turn, nine the next\u2026 down to one\n\nPLANES, SUBMARINES, AA GUNS\nEarn coins, buy them from the rack at your elbow. Fly a bomber down two columns, send a submarine under the enemy's fleet and aim its torpedo, keep AA guns ready for the raids that come back at you.\n\nCLIMB THE RANKS\nFrom Cabin Boy to Admiral: each rank a sharper gunner.\n\nPLAY A FRIEND ONLINE\nInvite a friend from Meta Horizon or share a 4-digit room code, then battle one-on-one. Climb the world and friends Victories leaderboards.\n\nMADE FOR MIXED REALITY\nPlay over your real room, in darkness or under a dusk sky. Lay the sea flat, tilt it to 45\u00b0 or stand it up like a wall \u2014 the console stays at your hands. Drag the whole field wherever it suits you.\n\nHand tracking first; Touch controllers work too. A navigator calls the battle in English or Russian.", "short_description": "Classic sea battle as a glowing hologram on your table. Turn the wheels, write a cell in the air or call it on the radio \u2014 and hit the red button. Battle the computer or a friend online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/wet-bottom/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/wet-bottom/", "website_url": "https://80085.games/wet-bottom/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1855602545749149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_2354337348655899_3680004292532651367_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=252nsGJiq08Q7kNvwFe1-BC&_nc_oc=AdpMCb_DuuZGbRwyEX3tZBw1JLXRePMn2DX0WfJhRMNZLDWWxlu-VmYyCt1i_nMPHxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWA6AG1ITxMZWZnz_r_AmzOZmqLYgY331tFX7ViLuEdEA&oe=6B1049C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wet Bottom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1793660760, "lastRevision": {"nodes": [{"id": "1840880370554700", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", 
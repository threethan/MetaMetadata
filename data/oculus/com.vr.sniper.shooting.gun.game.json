65_9032281631263644008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0gds-QwBmEQ7kNvwGEGIIF&_nc_oc=AdqicIwx9sPumsx9Mr9ICQcmRSSBJqAZ2zH0FurHRcbWAbMUjK1B1wqQYQWOwh3jlH8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W0VX0R-tUSqxTbWtcWgCtYG_TW9HJollUzgsoUYLqVA&oe=6A0B0B38"}, {"file_name": "3.png", "id": "4020154088295705", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303971_4020154091629038_1389557931390196086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL7Le0UNcxQQ7kNvwFOd-An&_nc_oc=AdovDzznevSBzs2FG1blpoRVhr9nmB4DxFe_hJcvbfQd7Z2lOVJxwNH8xGCl36JEmno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lWoMhDvdMFUy4QS0TGXc9E1db6Y0DcJTXLLvtJp6uuw&oe=6A0B2C0D"}, {"file_name": "2.png", "id": "1915388125908243", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308103_1915388129241576_8724277152382803844_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8zCegahopEQ7kNvwH5vXWL&_nc_oc=Adre-zJXfs6NBpZYA42uD8aVBbEQl8l4G1zuxr17wQKOg1_kcfB2O0zUsZ2g2g7OiNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G5mDoLxxPwiCuz8PU6G7ANq8bOywd9HFC57VdvNhP8w&oe=6A0B288D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sniper Shadow Strike: VR Shooting Game", "keywords": ["sniper", "shooting", "zombie", "Gun", "ShootingGame"], "long_description": "Take your shooting skills to the next level in Sniper Shadow Strike: VR Shooting Game, the ultimate VR sniper gun experience designed for players.\n\n6 Deadly Sniper Guns \u2013 Unlock and master a wide range of powerful rifles, each with unique stats and 4 unlockable skins.\n Full Customization \u2013 Stand out with masks, paints, and shirts that let you create your own sniper identity.\n\n Game Modes \u2013\nCareer Mode: Progress through challenging missions and prove your accuracy.\nChallenge Mode: Push your limits with timed and skill-based objectives.\nZombie Mode: Eliminate the un-dead in thrilling sniper gun action.\n\nImmerse yourself in intense VR environments, sharpen your aim, and experience heart-pounding action as a VR Sniper Shooter like never before. Whether you\u2019re a casual player or a hardcore marksman, Sniper Shadow Strike delivers nonstop thrill and replay-ability. \nAre you ready to take the shot? Lock, load, and strike from the shadows!", "short_description": "Stay in the shadows and take the shot to become the ultimate VR sniper!  Choose from 6 powerful rifles with 4 unique skins each. Customize your look with masks, paints, and shirts. Play across Career, Challenge, and Zombie survival modes. Test your precision, upgrade your gear, and prove you\u2019re the deadliest sharpshooter in Sniper Shadow Strike: VR Shooting Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ksgamestudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "KSGameStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/ksgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "de", "pt", "pt_BR", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26164565086538149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823431_1286943979828807_6609393041202886662_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_s
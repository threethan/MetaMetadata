ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5i2U37FXf4Q7kNvwH1TaDn&_nc_oc=AdqjZRgrEEKLwG81oj3Xy28WMdHA4rSsG4Ypx8ONELmF1CWyt-ETD1N1WJl7IPpfytI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzyYQPD6JChxwYpXaoseU1rk1b9NHfvulHTokBQR329w&oe=6A733A43"}, {"file_name": "6.png", "id": "1716716059697232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_1716716066363898_724038435472879524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsA5HXaRuL0Q7kNvwEBY_7H&_nc_oc=Adomkf_myGs5_-mSnyz05QkLwFSvaY1uLg_y9cmP3PtTI7lvORYvep5QPsITXB5BN9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs6y8x-tsO-X-fiJM39YUTjVxdW3nQdbkavTDH31zUvg&oe=6A73290B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_MetaStore-16x9.png", "id": "4449934821937147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304952_4449934825270480_7911730375985857477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycCVS0GzeZEQ7kNvwGAh04p&_nc_oc=AdrI2X81Df6DBtYYSaUMxuUPIocAN8O5Gw6vA35iCcvp4gzvhe_dRoMhO1W6EkWxkRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF40hD-7LGzF4c2ScdoDkO_NHKQWev-du74jtpLjyBxzQ&oe=6A7336E6"}, "display_name": "VR Social: Virtual Reality Experience", "keywords": ["productivity", "relaxation", "mentalhealth", "personaldevelopment"], "long_description": "VR-Social is a virtual reality application that offers a wide range of content\u2014from mental relaxation to real-life scenarios\u2014within a safe 3D environment.\n\nExplore 360\u00b0 content with your smartphone or VR headset and step into immersive 3D environments.\n\nWhat We Offer\n\u2022 Relaxation: Experience 360\u00b0 natural environments for stress management and mental relaxation anytime, at your own pace.\n\u2022 Extensive Scenario Library: Safely explore 3D environments for professional, academic, social and daily life scenarios, as well as social anxiety, specific phobias and stress management.\n\u2022 Flexible Use: Access all content on your phone screen or through a VR headset for a deeper experience.\n\nNote: VR-Social is designed for both individual use and expert-guided programs. A personal access code is required to log in to the application.\n\nContact Us: info@vrsocial.com.tr\nWebsite: vrsocial.com.tr\n", "short_description": "360\u00b0 virtual reality experience for stress management and real-life scenarios"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vr-social-privacy-policy/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://vrsocial.com.tr/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25047437078227325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831964_4295785577337661_7245390819449195147_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcvBLqnPIy4Q7kNvwG_10Wc&_nc_oc=Adqi71BKuDZjzwsgUQVobZ1qMnmrmQYJLype3dx-0ztg_oXrq58uh2m4_ID-9Y8AM1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6nUwwCnk74AtOe8OSZczfe1MzcsQ7SWvyQ7gtrEkFBw&oe=6A73392B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Social: Virtual Reality Experience", "platform": "ANDROID_6DOF", "c
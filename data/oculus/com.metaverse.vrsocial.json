ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpNExci8cWwQ7kNvwFdMdPE&_nc_oc=AdrGyrnHIgM45dAxLrXkGpElL-c7j_RPkuOtY2_r3ANrJ1OeRGOBNsM9BkoPKxTSSPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9KEwZSEIMY8SHhoJf9AKSl2Z8AsxEmwLRlqFyM_E4IA&oe=6AE73E43"}, {"file_name": "6.png", "id": "1716716059697232", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_1716716066363898_724038435472879524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHRE0GDq1QQQ7kNvwEgTJ0F&_nc_oc=Adp7fDrMa1CDLsv6Y-2SJ8TeuDUU7SFmA3Z1-IDMcKAyg3UZnLEwONypCcr1cNH53Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxtlCFykDspkfb9WKpGdeIR5UtO6YwvJxYNjU7jYnkNA&oe=6AE7654B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_MetaStore-16x9.png", "id": "4449934821937147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_4449934825270480_7911730375985857477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDgeHhChEBIQ7kNvwE4QaBO&_nc_oc=AdpZisVMam2cZMB2O8EsW6RNMZVJrqP3FT8btPkYnqaC_Qy8HL7bj1A9a3WKiWZVnk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSZ--Gxxr4GOvNnqOr19VLooo9neXEZupF_oqt5U4otQ&oe=6AE73AE6"}, "display_name": "VR Social: Virtual Reality Experience", "keywords": ["productivity", "relaxation", "mentalhealth", "personaldevelopment"], "long_description": "VR-Social is a virtual reality application that offers a wide range of content\u2014from mental relaxation to real-life scenarios\u2014within a safe 3D environment.\n\nExplore 360\u00b0 content with your smartphone or VR headset and step into immersive 3D environments.\n\nWhat We Offer\n\u2022 Relaxation: Experience 360\u00b0 natural environments for stress management and mental relaxation anytime, at your own pace.\n\u2022 Extensive Scenario Library: Safely explore 3D environments for professional, academic, social and daily life scenarios, as well as social anxiety, specific phobias and stress management.\n\u2022 Flexible Use: Access all content on your phone screen or through a VR headset for a deeper experience.\n\nNote: VR-Social is designed for both individual use and expert-guided programs. A personal access code is required to log in to the application.\n\nContact Us: info@vrsocial.com.tr\nWebsite: vrsocial.com.tr\n", "short_description": "360\u00b0 virtual reality experience for stress management and real-life scenarios"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vr-social-privacy-policy/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://vrsocial.com.tr/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25047437078227325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_4295785577337661_7245390819449195147_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmGXpmcVOiUQ7kNvwHwk3Hu&_nc_oc=AdoqNT7mQHKtalcL2P8PEyjzWABKH0C7U9swRFBOKj0PY7_nqkj6JEa2EacsGV-Qz5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd8Vp20u3obAW_Y8f4ZdyqgYuoRfpA4y8NC0A4V_Q0Gg&oe=6AE73D2B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Social: Virtual Reality Experience", "platform": "ANDROID_6DOF", "c
88771243_3269555170817240909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ASJar5WpZ4Q7kNvwFKpCru&_nc_oc=AdmMiMVnU20CAzrCxcmUteW0aeb4Iaegf52kSbs6-wNOz0dydHAkb9cOyjLjtMJ3fOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZJ1XvG5h1eToxa-mdABvfXsuEwUyp9DPP92xbCwwktw&oe=69A02670"}, {"file_name": "2560x1440-screenshot.png", "id": "2083559048784368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499352509_2083559052117701_2871947907454852102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCZW79vMJ4oQ7kNvwHTxiPd&_nc_oc=AdnZ8EA5bFiIkfXbPuBc0yhHwz9uDCTNVDgG2lHPjPJvIO8rv714LpNXe3G9n0tPupE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3HQByuqAThrLASoOzDIccmDVElBTCeaxwF0Z_AqQOZw&oe=69A02F5C"}, {"file_name": "2560x1440-screenshot (4).png", "id": "576992131664334", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhUSmp9PHeYQ7kNvwEi7Yem&_nc_oc=AdkKrjUaVHiiumWMS74OhAFf0VE3OdmmhT-Z_X0vQrQXZX43ztUuz3hdPmfqJqsH9UM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJquC8ZigpvYlpnp6e10jqqy5rAfxxTQsMsmZ9flLpHg&oe=69A0338C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojNHghsUqQoQ7kNvwG1cv2F&_nc_oc=AdnWvuUqLD8EVIZJ9UlAN5g7BoBQT_RD5oWxjalLVoSa9QagW1ObklMC7seFfKZqfOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftl24oegXz9aPvw3ob538dbVFgl1fwaeNtTH4DIdCOo7w&oe=69A046F3"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Yq5DaEZbYkQ7kNvwHuVIiN&_nc_oc=AdmEAHk9PpRN5WiXYDsd-55WiZAVNEWebBWzJDAWlK8vYB7t_kZhuqATV84rlKh__r0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsdOC2CO7XSJcXSFyj3so0nO4j2W_R485sccnF3XOztpQ&oe=69A0247C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "
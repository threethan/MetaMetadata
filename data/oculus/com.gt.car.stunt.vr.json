0qMgA_9rE4N3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rEdF0E1Qrx4mGjfb9rInNOz75PQUiyUFB0eoPlaQ-Dw&oe=6A2179F3"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjnWNljMOZ4Q7kNvwGyxZYF&_nc_oc=Adp_MqAUI04zDM66KvQ__BnembVZ-P7z5TqJS4haUC9Qg6lhlgXkZhJvPqYmrNelbaE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kICEfcK2go4-ZLoLkjQL-65CIhDN0LYFlIusiqtINZg&oe=6A218FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9970253569723548"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1237848365051379"}, {"status": "PUBLISHED", "id": "592738779922119"}]}, "baseline_offer": {"id": "1237848365051379"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756362840, "status": "PUBLISHED", "id": "1237848365051379"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9951453828270189", "version": "1.0"}, "id": "564629212960486", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary
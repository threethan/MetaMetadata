88771243_3269555170817240909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ASJar5WpZ4Q7kNvwHXJ5gz&_nc_oc=AdmtnzQvOnV7kPk-bGZYiRB36VxD43qwIKd-4R5BBWZG-4T4wjTz5PqQuVljhc-JHIU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuFx-XamG3EPHKjHT2kAbroTZZ9ig6OXarXGj_QCR0NLw&oe=69A177F0"}, {"file_name": "2560x1440-screenshot.png", "id": "2083559048784368", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499352509_2083559052117701_2871947907454852102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCZW79vMJ4oQ7kNvwG_PNra&_nc_oc=Adls5HYHx9J21EIxUku6FSsm0a8clAW8cNHGF9JlK-TfiWlFTretou65rDptvqGOReI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfudRDLKN54zYWwKQzFoVbzj5ZJwJWoVw-RK_0PTitv-NQ&oe=69A180DC"}, {"file_name": "2560x1440-screenshot (4).png", "id": "576992131664334", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vumtB0fZajoQ7kNvwHLHmP4&_nc_oc=AdnGhlu6w-Xavin2Gi2k12p3WLhfZ03D-U6-Lbl6Rqo87QkZPMVlu3hzitF4vKLvl0I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftjDVXE1LZSzmMJ-xogboQirosAEeKTzlrSv_EMbkeWvg&oe=69A1850C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojNHghsUqQoQ7kNvwHkw_g7&_nc_oc=AdmznBxizIVi942WLYA-SYqnWXB4GpebYy4Ugil1arSUqtbnenSqX_fhZfBok-tbxzc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftkTP13n2p1wN0Qm0FRSliXNY95g4tY2mdsjnlQWq1R_Q&oe=69A19873"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Yq5DaEZbYkQ7kNvwGlzY0M&_nc_oc=AdmYMRvAuF4sFdJ6WBEG5qWOLvsOG91clMUQDEMV0gS2Sm_vP77NPPdSE3IcGE8vbFU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsgjDVNSFTD0aZf1zd3H7vD9-w7Mf8QtKXKeMU2Nzqrkg&oe=69A175FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "
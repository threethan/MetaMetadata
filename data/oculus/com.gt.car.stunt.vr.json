 "1759769688271158", "locale": "en_US", "screenshots": [{"file_name": "2560x1440-screenshot (1).png", "id": "1358449285437910", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499339633_1358449288771243_3269555170817240909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx_owDA2YXMQ7kNvwG-THGl&_nc_oc=AdmGvtJVKo1Njxd82yoqwC2Zr5NAXaBrkeW-nsFkt0WkcR1ZRw_mAHR5pPhAtV8Qjvk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmOeQ5jdyCysyg1doveLEXU9A7tYkLOSv2zbeX31-JOA&oe=69AAB270"}, {"file_name": "2560x1440-screenshot.png", "id": "2083559048784368", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499352509_2083559052117701_2871947907454852102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNGSOMCkFOsQ7kNvwEMzZNA&_nc_oc=AdlKfoRl4tYsyn-KvKUcMYYhCQvvcxLe3QGjzHacmlo5FyCIZ6Z4yVlB3hUcgV4CZwk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwM7A6qUAB9mgDupNqPNzYX0WHm66u4pkG__mkyKQcktg&oe=69AABB5C"}, {"file_name": "2560x1440-screenshot (4).png", "id": "576992131664334", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NpskpZfQuQQ7kNvwEzV7wS&_nc_oc=AdmTgvXdIf11NgDx90cBJ0GOPWgi4Pr3-JRI5qD_r_3rjyJc2fZv9xNYyD9ie4Ylb-E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtoERLZXDXr4y2vrpDZbcIlPTt9J_Q572hKQ3rHSwh8w&oe=69AABF8C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A-n7EGpoW8Q7kNvwGpPoiQ&_nc_oc=AdmtkmlVKGej65u6441EC9u34_IN5BfzWjEFgW2pB86jUDOfRe1NHyb07bE60c4emfw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc_AAndA4OQocdpvFx1zBTRixlRBVSAHKdGY3ZP6NKLg&oe=69AAD2F3"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdU_1BhrWeAQ7kNvwGsN9pG&_nc_oc=AdnvXEuU0SxM7-9PFA0ghKbQMT5oEFi5_x1aeIhAsBZjE5Ff20mu6nzNDz9-M8BncIw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxqQqqyNuzRj4zDBuCFInpUt_k4zWLPkwWZbs9r6P4cw&oe=69AAB07C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9970253569723548"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1237848365051379"}, {"status": "PUBLISHED", "id": "592738779922119"}]}, "baseline_offer": {"id": "1237848365051379"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756362840, "status": "PUBLISHED", "id": "1237848365051379"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9951453828270189", "version": "1.0"}, "id": "564629212960486", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9907734229308816", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9951453828270189"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "5646
88771243_3269555170817240909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ASJar5WpZ4Q7kNvwHZklRg&_nc_oc=AdkgSAoeNBMf0w4iHdEo9DC8vt7P7mvWfD5ZbWeT1vY37fPksbEEqPm8ouYpvpQr4MI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfswkdotnevlIWScTbTH1c4nJefQar4Yxxvynay4QlmnxA&oe=699ED4F0"}, {"file_name": "2560x1440-screenshot.png", "id": "2083559048784368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499352509_2083559052117701_2871947907454852102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCZW79vMJ4oQ7kNvwHS_n3z&_nc_oc=AdmR1trH-XvbkAP252Ev46djnxvdP-DnCRKO2jsTtS3Jb0M9pX2VTsuDJ4BMB-RJ0so&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsSgfIYKyedBk7BaP_oEuWkj4RWbriezNfWwV5cOtjWmg&oe=699EDDDC"}, {"file_name": "2560x1440-screenshot (4).png", "id": "576992131664334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhUSmp9PHeYQ7kNvwEjXcdW&_nc_oc=AdnytbLwoSQOk3ZrbT8ODK3Sq_Dy_ZgfYDpTd5P_J8QuGOSqdrWVGCH8ccpoacEhAoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIWkhUzf5MAxSjp6nfEEbJYn8mfAPu-5XHfohusK4pqw&oe=699EE20C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br4lkl_P8X4Q7kNvwGx8XWX&_nc_oc=AdnzD0c6VvgxuBlI2V9j-6aPPeqUIiE5hGhzyTWGY4wmdM6WiINHITkOIY_8wacriOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftXlS1JCmF_WtXEpkWQyXna-DwPldaFes3cPWz9zdQxlw&oe=699EF573"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YnYEDQPtHcQ7kNvwFzvCGj&_nc_oc=AdnSeH79yB_YFgt9iHSe4Sx6zL6X9E3GCdle2DRUAiMmdjFhkzqF6ozaAXYgZVsRCzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afub07WhmLvn3KaN2o4Oz_FZeXB5TDeUa1juv5N61i-YvA&oe=699ED2FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "
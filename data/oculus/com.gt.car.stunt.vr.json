/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etXjn6DQRh8Q7kNvwHAjkwb&_nc_oc=AdpbD7h61ROHL7d_9ro2tH49_5Gg1WrgIeoBJwl7q7pNH4h1vFhLSSTROHGmLLuI_o8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNjTGKKTwRG7YtB7nwmepAIPSHCdgaalauUaUg0VVYRw&oe=6B006C4C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFu8hR8XaXcQ7kNvwGwpcPc&_nc_oc=Adr_VJIZgTJ3n6AD7IR1dEEOu3p_qt5h6O3GCd9uhDp-VSEAVDlh0Q-wxhESIENVVkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3HhHemvZhva69hnMlF29XqYgLwdu0awD__crleve4Dg&oe=6B007FB3"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WjbAf8jc5AQ7kNvwHqjfjq&_nc_oc=AdpJK8N2gxpZFwQwD2TYDLLO_8twNienFw45vKc7o5tnvP6F7iXRKk3jgb16y9nJ-OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvfcJUOdwcvZUILNFFDK6cligL0aMm8niTCE16k3MPKw&oe=6B005D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [
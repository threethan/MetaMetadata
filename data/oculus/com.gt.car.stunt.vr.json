88771243_3269555170817240909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-tSjGf-FfEQ7kNvwGW_4rM&_nc_oc=AdmAKRpyfgM3VwVkB3jal76WyE3or0PrJVo6xrViAqmt0Ab2npIYWE6HmY0ylpnWyI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvtHMXVx7GJSjKPMAmnJWG1hFJtKaaTST_CL0ptJDA-fw&oe=699AE070"}, {"file_name": "2560x1440-screenshot.png", "id": "2083559048784368", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499352509_2083559052117701_2871947907454852102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsW6QGQQz64Q7kNvwHGQMpC&_nc_oc=AdlM1WtslG1onP0MBewdX3M0Cr7j_czGT0rukB9Z7uMEPxAAfgRlBL-kWVKOiktIURM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVIQg5SjhpfXprmq5Hv7twp6jmH0iv78oO4kViED8JPA&oe=699AE95C"}, {"file_name": "2560x1440-screenshot (4).png", "id": "576992131664334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibhd92OPA0EQ7kNvwE75KZd&_nc_oc=AdkiVhSK0X3_CZO5wRGE47MuLLUtIOWykWf2ZUf2Pyz1OYeLMGOKn1TOCoEQQMyBLW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu1688l0rEynn9nCwNSq3EXI4q-BE3fi1MolC6JBEIZbA&oe=699AED8C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4iRI3niBt0Q7kNvwFCjRJ5&_nc_oc=AdmphGQSC9Sn7RdtW8raPUi7EakXnduVrU-lyrV1i7T86XMnG7ZrZJmetoUG-UAbQvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfstVBtsC1zQ9PpHD7vzNZdwd1_1_5SUPZcNdVdW7QYKOg&oe=699B00F3"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFArDVH1oloQ7kNvwHCMLZD&_nc_oc=Adl_5fMkMU8O0y0jGUgXfVZtAUba1k3JD7t0a0nPChtFOhFfQh-Sdi3renJp_k6tp-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu0zhjhVSMLY_v7otGf9nXSKdnfTRjRH73Wwn7nSjNPpg&oe=699B16BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "
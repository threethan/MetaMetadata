88771243_3269555170817240909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVGyGCUoL0UQ7kNvwGtKDiN&_nc_oc=AdnColCXIsd9fkLK9nOee-TFDWs1iwAnupNYyk9Z96nnK56qfRKFEvjN0botbDWvkY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuwoMIosS6sRqVhkMxca9MG6YgepswrP7u0uj7oqSPvvw&oe=69A41AF0"}, {"file_name": "2560x1440-screenshot.png", "id": "2083559048784368", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499352509_2083559052117701_2871947907454852102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D_Boz6_XaEQ7kNvwECB1wz&_nc_oc=Adl50f3Mm9vdHtxkziwfDMbBePfs7h5yNasUmlv4As_BjEOx7wzTPbPA-sYINAsm7Bw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftfk8JMzPXzT9hE0RONqogkGfE5KZoUBfaQfqDATP0U4g&oe=69A423DC"}, {"file_name": "2560x1440-screenshot (4).png", "id": "576992131664334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499326386_576992134997667_5620616854185790059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vumtB0fZajoQ7kNvwG3WP-T&_nc_oc=AdllCuvoJMgOvV42tuZ-R3NDE5lG7kHek1Jo2duNULJyTFY2ePYTAgGmmIUPGNnc8vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsmmR_iOHK5v6UwJEODfOgI-toRz909sW76JAiozwZUCg&oe=69A4280C"}, {"file_name": "2560x1440-screenshot (3).png", "id": "1215405056995755", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499347589_1215405060329088_195246549635966283_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ2onFJBuy4Q7kNvwEjADHl&_nc_oc=Adk7t36U7O8rxeE5vH-sJewQ-cRtXGG9ASqr-bU2EjguxJOlyUD7NSg25VAkHqZgJB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsq7djTj0EO40qzbbcSjzuFhPdu_jJEpB-yLirB_LG-og&oe=69A43B73"}, {"file_name": "2560x1440-screenshot (2).png", "id": "722450846916740", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499325635_722450850250073_1016253018636497235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpCyZajbTTgQ7kNvwHSL8it&_nc_oc=AdlpChzVJhbAqfLuJ783TFBXz58P07kEmw_qRsnYoSy4gi5HY8vo1LKSZuk7JfIDxVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUk0_MjL5riFvZX0CDJeXtOJPjz0GHdHeba8HIKjgEfg&oe=69A418FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ramp Car VR - GT Car Stunt", "keywords": ["CarStunt", "CarRacing", "Stunts", "Racing", "Driving"], "long_description": "Ramp Car VR - GT Car Stunt\nA challenging VR car stunt simulator with exciting and puzzling levels.\n\nDrive powerful GT cars across massive ramps, narrow tracks, and floating stunt platforms in full virtual reality. Ramp Car VR - GT Car Stunt is a skill-based VR driving game that blends stunt action with puzzle-style obstacle challenges.\n\nEach level is designed to test your timing, precision, and control \u2014 with some focused on speed and others on clever navigation. It's a full VR experience made for players who enjoy both car stunt games and thoughtful level design.\n\nFeatures:\n\nFully immersive VR stunt simulator gameplay\n\nChallenging ramp and puzzle tracks\n\nSmooth VR driving controls for a realistic feel\n\nDesigned for both quick play sessions and long challenge runs\n\nSolo experience with no distractions \u2014 just you and the course\n\nIf you're looking for a ramp car game in VR that combines action with logic, this game is for you. Master the tracks, perfect your stunts, and enjoy a focused, skill-based driving experience built for Meta Quest.", "short_description": "\ud83d\ude97 Get ready for high-speed action in Ramp Car VR - GT Car Stunt! Drive powerful GT cars on massive sky ramps, perform impossible stunts, and defy gravity in the most thrilling VR driving experience. Master loops, jumps, and obstacles with realistic controls and physics. Perfect for fans of VR car games, stunt simulators, and ramp racing. Strap in and experience the ultimate VR car stunt adventure!"}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "
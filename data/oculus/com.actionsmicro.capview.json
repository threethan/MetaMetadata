5kaTtpPcBLboQ4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFwFv3rllBcFNWD9Q5TNe6IRj97tQaIMBEIsy-yuM1tg&oe=6B083FBA"}, {"file_name": "Screenshot-2.png", "id": "942632094355131", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKmHaClEEK8Q7kNvwG03HXW&_nc_oc=AdrEdjeolX-9_7wdFo-eBfbFZUSKy4cHupDiiliCXcU-cNJuMY9LuAepbjRHH2T3vlo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNe9ntELsuqOeeOx2K1uGx0BfAsaVQdxJrRhBcEpIplg&oe=6B086D9B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3bhIV4bgVUQ7kNvwFdRK1e&_nc_oc=AdottPSFNTO8adXWQ4p1B1B08UHqvKUGGOtk1TqHdWweefSU-AJxA-WCtN_XJK3LSVQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY-ozNU8BYMogr3Cbo8GJBz0WjR9HMk9PU1y3jBhKeQQ&oe=6B085E94"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-2M9VWwc8kQ7kNvwEHv7b8&_nc_oc=Adrs-G5vK8RAIxvU0FTmA4xGS3x63uG5bsdGzd1XJhXrY6IzTAjhcvQI008NEfn2D3I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlTyl7y5sMMA3__ZDRTZ1iM_r67dVgmkbELJNHLvh0Gw&oe=6B0865FE"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w2cp205NyEQ7kNvwFZM61w&_nc_oc=AdouuiDcjH4JuoGjb53HV0emwDr9szcuJ4DK-qjymye5FrVSnAKvo6wLPc_kpn2kCCw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrvqi3rgPFtSKjEIrft7Buh3W0DvSP_Pgdj5akeCvx6Q&oe=6B08594F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28941935872117988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393741_643376554907535_2250231599708664132_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOGTqjYOrkEQ7kNvwGbu6VQ&_nc_oc=AdoJ1B4RAB08V5p0Hm_qcPrIGMDYB14U1ACmjyjDdZwHYghrlSOHc95M3y3ZEpt4MVI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUYAlKmaRhUmJt8yzxTPXXDsCAwog3OT5tzTeMxVndPg&oe=6B0845CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CapView", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Computer Link", "id": "1055187466124150"}], "release_date": 1743497700, "lastRevision": {"nodes": [{"id": "28769591596019084", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28769591512685759", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "989269133156865"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "landscape (10).png", "id": "2003509723493820", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393518_2003509726827153_2314437064397203
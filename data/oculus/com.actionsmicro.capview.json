kzjoH9MKfu9Cmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMrvliIEpe8ooHbsrHdk-5l7x9Us2rG9Or5X0cOm2WNw&oe=6B09C97A"}, {"file_name": "Screenshot-2.png", "id": "942632094355131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exLtzhNF7iUQ7kNvwF6dJ44&_nc_oc=Adrcfd3zIyqKpzU-YFhgWd7AMnNSqbaEaqe7i55oHdpC_CQXubk6zHm4xdOEeL0EGLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIs0voA950kAHGGVYVY2C4p43Q10Ak4_MKcHUdP-e5vQ&oe=6B09BF1B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3bhIV4bgVUQ7kNvwFFS7fL&_nc_oc=AdowOktbVi25UyFYuNVyu0L7otrZrJjxtuFMz-ZBPz-y_08mifabw4WgLN-lO5963vo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeEsM6oiNsYOed-5fhl04IAeX6VB1AMsiCe5Nn7Kw8jQ&oe=6B09B014"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-2M9VWwc8kQ7kNvwHGACO5&_nc_oc=AdrcisPkLXYOfyDrvcgR_0nuN8VsoB3zkpVamxt96rH1DZYa9tfdQ1b7zJ0giL0rISA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQut6JqlwTk3776iRd4DPUarpBChJnQ24wYhn6mM_HTzg&oe=6B09B77E"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w2cp205NyEQ7kNvwGdRPAx&_nc_oc=Adr-gt7sDIrpRMRyghZQBTdhy3VzgfO_2DKA6cpU5ZN5SyXvyRKEKI1pelRlYJlLGL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSui-4R_RkDy0g3KK8j_KEi7fkjtN09K4hbPbsdWWQJ_w&oe=6B09AACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36
OwUELKaFubOjwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvMqeJGjoyfJcs5ah8kslvn2fEQ7qgfg32DQsYmRn6Sw&oe=6AFDB3BA"}, {"file_name": "Screenshot-2.png", "id": "942632094355131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QqNKWIDUg8Q7kNvwEvlzVK&_nc_oc=AdqpmwXU7pzp0HNH_1ULm7scYiR6a2z4ZprzF2u9cPvJtFbDNl9v1er0ztNTYVUkSWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRTtnH_fkl2L_9dS13x3hgTfyl1QqnnoD2Y9x3r1sg2w&oe=6AFDE19B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z7Pd6D3-fUQ7kNvwGtlbcu&_nc_oc=AdqIs7DE5q8JFcgn2kOQv_Z0NJyT30tbu2OMH6Tu3escxfWl_KkzpQDGlQel39Cg_dU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGWSUmkvo1aYMuWtrmyGnqZd1Tmf6QVMjJoJfMQym8pw&oe=6AFDD294"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEl4sXnxtk8Q7kNvwE0OY-P&_nc_oc=AdqIkav8YPaZNnN-aoZUmopssLuZPlnXPdKvEcr_uWu_qgVugEh2I5OZVjNixM6SG60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShK_xljsFPyhPSfXG7MqyBAYgCwlO85HMel7du4lef9g&oe=6AFDD9FE"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2F5lOz0Dp4Q7kNvwGmWVHR&_nc_oc=AdrxyzUw54Uu2tajDqwNeZvuhgh-usRKFgQaFd4cjangVKqkgJ982QLcwr6kkZXFqcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIBOUQJUzYcQ7ecx1VNmvcD-8hGkelrypo_pr_fmDVtw&oe=6AFDCD4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28941935872117988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393741_643376554907535_2250231599708664132_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1mTXUb93xIQ7kNvwFIVtFw&_nc_oc=Ado26uj91CVmvGr6f973qaSYVaIe2e-7t_cd46BZwBSZLR4cyhxrsG1i42KQFbs0L6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvnGkm7l5SaIPx7gCE7kvalZPecMPPvkP4ig1sUaZWzw&oe=6AFDB9CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CapView", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Computer Link", "id": "1055187466124150"}], "release_date": 1743497700, "lastRevision": {"nodes": [{"id": "28769591596019084", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28769591512685759", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "989269133156865"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "landscape (10).png", "id": "2003509723493820", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393518_2003509726827153_2314437064397203
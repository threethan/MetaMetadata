"https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN8egIeyXGoQ7kNvwGnQRh8&_nc_oc=AdpuMRYPLtRYDtBNS7EiC9l28nhfnu1qhunmOged5HTBRU2b7KhjRYyRuQ6I45Vnxik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjSwrw8e1Ddx-we5DZnjL0363KHfBzc5xYzSYHA57bzg&oe=6AEC85DB"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtA8yo1L5FwQ7kNvwF-nXak&_nc_oc=Adqi-pgoDfUFmWoI7xMGQgr_DKxffAaRhaWk7kNhG2vkcq4G3zCbOZmvOsqswgZFwQw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn8xHvsC3AXPOzCPT7tOkKyIDtau4idEGrM-wfxb6BSg&oe=6AECAF14"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5g9ntmSUwYQ7kNvwGtL99W&_nc_oc=Adq8o-bMtk7Q_LftaIhs-3UgJpHjHCiHqyWKFKhC8uLQQpqEU9BXEq1H-5yluA0EQ2w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwJ7GnGUT7WB0H3_eOzh5mEC6uEDUQscFMRT8wKTgdkA&oe=6AECB67E"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzZ5Zu8caHQQ7kNvwGbFe7r&_nc_oc=AdrGJcj_ChgV4F-MhFJS_6rl9JtyhT9rJLD8RUkXNEs7P74XyytRmrcs9uRuOPXRT5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnquci5V4_XQ9Rgw1XEupASSY-uID7oMAkZAUYhMCoaw&oe=6AECA9CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
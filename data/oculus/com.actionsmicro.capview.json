"https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA_33s4FydAQ7kNvwHJdsV3&_nc_oc=AdoXkHTTwiTKvNYnNBaOyqq-en7BmqoVUhapcwIytp7ZqI1d7atV1aDhZ-1nwaVO0n0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWOlE_96lLO-s4fDSnm4waVt9H4iIZOMDKBFkLY2O1Jg&oe=6AE0A85B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-gggK607ZEQ7kNvwFBneoZ&_nc_oc=Adr-LX3NeD1N-5Lfxpp3HzcHI1VwlIpLPJ9GVR8NQo73MjGn3UmcAuS7Vc1ziU68NyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIyw25M1ltJrs-nc277aAFYnwYkh12rpAfC-j-u_Ss4w&oe=6AE09954"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkH-SzlJ4jcQ7kNvwEoh8Lp&_nc_oc=AdpFAUOEQPHQ7NGzIV-QWIm5dXDQ2dLuh9rAioUA6YSx-jYGmii4Pr0xhh-2ZLrXdaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaAGkCe4SzCzxfRjOUKrHWKgG0yVE3_dS4Oyb1Ptxl2g&oe=6AE0A0BE"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWmQ8K0GzkwQ7kNvwHq1G_d&_nc_oc=Adp3xVt6sQGnqvrzE4jvm22q3Tio8G5SooNVDbtrYJZe_S2Ykb0PqlwhT-f2ycZyZ1k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyYSgseOAQFeVjLYUdIkcoy38B1-7ZU0PV1TaAY2_9_g&oe=6AE0CC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh_GlAEBoewQ7kNvwH0gPlZ&_nc_oc=AdpiaWtGXX1kthMAiSIcDV4-w3WSwOmG6bGk2WZ_5xQW6W2ek4K8DVvYCP1hEtFg1LQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4oWy14hOg0dGwPI7ETt9iJwb74qzEl4aO3e1CvE11VQ&oe=6AFB3E9B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z7Pd6D3-fUQ7kNvwF2aPJ2&_nc_oc=AdpGrJU_i4zOmxJvH8Poe1R9qZnx5k8s0duVZdt1yJgt2PoMBeMw62QXyV2p8SuNqKE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9mD_qelQqztuTwiqOxXl5mYXS--0FkYEqDQKzE91_sg&oe=6AFB2F94"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEl4sXnxtk8Q7kNvwF-2Iy4&_nc_oc=Adp_Y-yOdWStUuF76Twogx_jIEEzjG6EHW0mqRzFeRC7GCCVEIsKt_K3YPzpDfvvGFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVc1B9mkeLBaKAAR6pWpvyQ4ReeI14-Xj_lVsw9hPJbg&oe=6AFB36FE"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUVWR-nWvPEQ7kNvwEFZ6O8&_nc_oc=AdoVA-K6-LDpaG4jRAZHXF6uBcuf8wMo-_IY4zqRgDGJcrPA2f2zJYACfrmw3o9BM3o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIFAHSf3wJktJQDtoZDyNdjRFl4noaVNP_RBaEkgTl2w&oe=6AFB2A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, 
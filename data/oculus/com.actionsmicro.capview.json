T5hPGJvtjW5L6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_RaxrthYdmBcit9d-tc50eO7CeUlk8Rp8Yl-nyYDDWA&oe=6B04837A"}, {"file_name": "Screenshot-2.png", "id": "942632094355131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKmHaClEEK8Q7kNvwEfPCz8&_nc_oc=Ado_oBtgO61e3s2AgxmHb0ddQ5kRaHlIjYW0bq6Nu8msBWw3G3H5iRKC3Z1vqKULRYU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6lyeKmXirp2KHBSqTYa4F8pi24_HmqiO0RsnItBveWw&oe=6B04791B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lXfQp04mhEQ7kNvwEjn1PS&_nc_oc=AdoerngV3rk0j1B-ApBermq06FFdeEEpAs-WufWrfXfKC05o4Eu5QbYmiUtzA7keXb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUWdxxvgv6nFiaYjPDMPWxIbZU5-FoQ5XazyXXgrc7gA&oe=6B046A14"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZStvXhbNB0Q7kNvwF-XNhp&_nc_oc=Adofz64wZlglx9UJmGouxSS5JCH8kw9YX_mYx8pk-x78ze68rk4uifLHZnPxCRC5fX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Ir-_BFPl3zfO2ftiIAzAWpObGH0GxVrSg-099wTkSg&oe=6B04717E"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRLYR7K9Vz8Q7kNvwFUrfO6&_nc_oc=Adr_nDlCw78bHHs3lWLz8EgEX2JfsxIEgYfKi1WxERHNBQEX3ja_zmzWzYNc7QSFpAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScmMWYrQ5rYwBd4X_EY3IR8xtBTbyiloX8DiuVx2_2rA&oe=6B0464CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36
"https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh_GlAEBoewQ7kNvwGFsV7C&_nc_oc=Adr9qC5BXKWK2-535VnmRzYELivybDtCGDkWef-K3YyGx284DGKWT3JO9KWeAIxX1uE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi0yTUx46-cLdLNahdCbBcp1dQ8ICXNUkaY3oKfWZQtQ&oe=6AF9ED1B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYZu_vR71oEQ7kNvwEpWcpD&_nc_oc=AdobkoA9vDPwjgHctFGea6dSyVqPpQvx3Rlff8a2qaV28RZrQDg5R7B9YSu-58ddayo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo7LcoDw2hNk1RmspKKkbDwXWF--rLwSOHN3tFBS6TQA&oe=6AF9DE14"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDZ0xY1R_pQQ7kNvwFkodEN&_nc_oc=AdoOHGT13ptBkRIQcUgEvH-Dh8jgXZxzcr3Q432lAJ3HYr9Fw1Z8cJAiYoW0lcRRbs4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyrIAHkU0YzF8ReXzrx9zwaU4pjy7WzCdLnqHDit5Wvw&oe=6AF9E57E"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUVWR-nWvPEQ7kNvwEdnOZI&_nc_oc=AdoidSAoXO33Vksqzh9z1N7mugYEKXUewSeJMoU1AR4spK20eEm71G_HgJRQVr-MVnY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQue6YIfDwEWltr9N_LQbXvbJ50PhIHMGMwiaOIqhctvw&oe=6AF9D8CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
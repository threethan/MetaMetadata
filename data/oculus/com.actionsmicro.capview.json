gWN-sfk4Jdh3go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbCFSNUmxTBfp79P1M9S3ScANjB0ycqFQUbyYkhhc67w&oe=6B1060FA"}, {"file_name": "Screenshot-2.png", "id": "942632094355131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHKqskmrOGUQ7kNvwH5ntGf&_nc_oc=AdrQfdMXixbCb1wQQ1DvvG3N9ETDd6FmuKK3GJxpw55eNJ8kUX1Em4yqyZ8HncS4uh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVu0mB5yfOOSfrJ6Li06p9lPVD63NeVbfqrHoLNYIEcNw&oe=6B10569B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z__AvmGqA_wQ7kNvwEqjnm9&_nc_oc=AdqjxJG8YXOVhiKBFaTAfB2_nuKkyxMJ-DvlCBheEd70sTAR2AGo0O6O2f1h2nhXi2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAKkW2nLfbxiW9Kl3W3HWRH_rzRR5-uz4XT7JTxds6nA&oe=6B104794"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e3qWXDfCvkQ7kNvwGD6apG&_nc_oc=Adoktqpr0y4RAL_Kmw3boBonz4TkxNsKgLUwAqeTKHPGkSPuGi8xp_46GLYyD917Jbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUl04hM36LKQ0naNJ4Xwx1TWvcCip913rkEskhpeFED3w&oe=6B104EFE"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3jNnLiWjO4Q7kNvwHczzhh&_nc_oc=Adq0Ywnh9levy2i8lX0OMZRvO8-5CduDDl8eueyRnM2sFrrbIeEVBHJEcriYnkb0ieg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXibi_WfZPlGO1lohLSaAwNiM8dHgSe9YjxwpT9t-9mBA&oe=6B10424F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36
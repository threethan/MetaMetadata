_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClU4ouERAPEQ7kNvwGCIIBl&_nc_oc=Adq22YbgHFuHA4BniUQj8nUdOKCQ5Xp8g0V_2L2jJpUzAXMWL4q2mx0udExrMWip1Xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFMbfIKL59SPHTbnnh0MUkA8oQSIhBX8shuJY2UdpX6w&oe=6B03279B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lXfQp04mhEQ7kNvwH8hdAv&_nc_oc=AdrUwzetV8jx1yUhdX27R2bkHwsX8pSNCyAIaU1H49wDfJvNYbD2oI2RYmh1Ih9aPtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNuTUIZ9YpsGUotgooPors-vAxc_wNwFoougii_QtIWA&oe=6B031894"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZStvXhbNB0Q7kNvwET-4e-&_nc_oc=Adp_3fw4RsWUJ_pGns4GSiLDnGeqfPcDaGNlCFqJ6VlCD4MDFxlhC38W5SdbZxXAPvs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp7Zh7KCAnZ9YUH9S-c5GnJvtnPAEjYhLmGHJCA68Eog&oe=6B031FFE"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYA7bkn5KX8Q7kNvwFicLtw&_nc_oc=AdqNj8Av-LgIK7_S9-YKXGsQ48fbCzdu2dybIZI0Ps23bNix9kGGL-B2UCCxkIXXJbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT55k93tfdWeuwa2EhwZFgGlNUE5PWAI0QEXpYuGmodnQ&oe=6B03134F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, 
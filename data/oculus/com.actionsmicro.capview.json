0jY9b&_nc_oc=AdqPjAGd7LINckKNy7mv_b2HAXvK1BanQR1LlM6tavnTamKXZ2j7muopNixYEigLR2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStHgbSAbXN5mLglyoi1tEf0UTtBEwAvxg1lLFdF6uNjA&oe=6AF73B14"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDZ0xY1R_pQQ7kNvwHZ6MZz&_nc_oc=AdoWegLo9s2xIDW581ZverNaHT5KZERsk76zIZZuzBrABZnB2RqRL-uIRtyuIx0WGoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgOtBPs21hG37HlPEbZ8oIrTQvABkGP4__2lQnq_Vo2A&oe=6AF7427E"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eDAIUJ4xi4Q7kNvwGU0GoB&_nc_oc=AdplOEpauITgnXRr_AkFk_eDBvvI88NbfQao1UwvUJhgIw1PUedVZPpOTdaGJd28_tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsCfULoywKWxNERG1J4aOr3vPWcsCHLnAyQVVUKJWLkg&oe=6AF735CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28941935872117988"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "566019096460687"}]}, "baseline_offer": {"id": "566019096460687"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743497700, "status": "PUBLISHED", "id": "566019096460687"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
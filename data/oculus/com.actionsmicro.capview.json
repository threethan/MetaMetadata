xCMr4we_87O6_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKkr8BCm_1RTIFoU44iYhyuo77YGc-TOriVqCRcVYYJA&oe=6AFF053A"}, {"file_name": "Screenshot-2.png", "id": "942632094355131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392192_942632097688464_7734268562435578213_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QqNKWIDUg8Q7kNvwFIuXtc&_nc_oc=AdplFrBDR6SUJf68M731dOuCi-fIH6NCQvmUJqZqBle_l21eRGD6pIXEgN-42eAzTMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHhyJpdvgMu-30YInwZne8NjXl2ksCX2iL95rYs7pJag&oe=6AFF331B"}, {"file_name": "Screenshot-3.png", "id": "2027977571010981", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393469_2027977577677647_5263047611580177209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1brOowj_aQQ7kNvwFIa9qa&_nc_oc=AdosdMeXixSP3LpaKFnBZsobUNU0w4akKVXQ-dAKzBr98GnqjHbSfM67QwbMZym0Eg8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRvECkfy81uwCkiqOen3v8lrFg0AX3iFweNk8tWKoCSg&oe=6AFF2414"}, {"file_name": "Screenshot.png", "id": "598792926489761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_598792929823094_7374282041928074360_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKB-yEnCyVgQ7kNvwGGUpRc&_nc_oc=Ado7-_Op8QjuRKADNT0RR6zIVGvTpeCq4s5AjmFR_zAK0ZImVDHXEeyVxqt5yeNTS7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTJugaJM9iK5T3SAQNHMcmfQbRTb4hj4iLExPtJXTWww&oe=6AFF2B7E"}, {"file_name": "Screenshot-1.png", "id": "1175543857274243", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391880_1175543860607576_4947877015394205147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2F5lOz0Dp4Q7kNvwH7MHwI&_nc_oc=AdplDaeuD5LpXzjBCLxIQqS5WOVwBcIvvX-nrw-qYs4iaOrv2H_kFLCvHgtAcf10BSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg2lYFadKnl2e2Amj3MBsAodZTVdA_r-uMsuH3BmnrUQ&oe=6AFF1ECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapView", "keywords": ["display", "monitor"], "long_description": "CapView \u2013 Effortless Video Capture & Preview on Meta Quest\n\nCapView transforms your Meta Quest headset into a portable video display, allowing you to preview and capture video input in real-time. Simply connect a UVC capture card, and instantly expand your viewing experience. Whether you\u2019re extending your gaming screen, monitoring a camera feed, or showcasing educational content, CapView brings seamless video display to your VR headset.\n\n**Try CapView for free today and enhance your visual workflow in VR!**\n\n# Key Features\n- Capture and preview video using UVC capture devices.\n- Intuitive interface to adjust resolution and frame rate.\n- Flexible zoom and mirroring controls to optimize your video composition.\n\n# Requirements:\n\n- Compatible with Meta Quest headsets (Quest 2, Quest 3, Quest Pro).\n- Requires a UVC capture device to input video.\n\n# Support\n\nFor any feedback or inquiries, feel free to contact us at: support@displaypass.org", "short_description": "CapView \u2013 Video Capture & Preview for Meta Quest\n\nTurn your Meta Quest into a portable video display with CapView! Connect a UVC capture card to preview and capture video in real-time\u2014perfect for gaming, camera monitoring, or educational content.\n\n#Features:\n1. Capture & preview video via UVC devices\n2. Adjust resolution & frame rate\n3. Zoom & mirror for better composition\n\n#Support:\nPlease feel free to contact us: support@displaypass.org"}]}, "developer_name": "Connect Dollar Co., Ltd", "developer_privacy_policy_url": "https://www.displaypass.org/capview/privacy", "developer_terms_of_service_url": null, "publisher_name": "DisplayPass", "support_website_url": null, "website_url": "https://www.displaypass.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36
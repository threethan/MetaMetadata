3030929077769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hP_bax5gDwQ7kNvwEQiZ6L&_nc_oc=AdrxOYB6TinQMbBcvZK1f-dPZFPSBDM-ep5wns37yKN2KIWhq1WqMtr73z0vf45HLec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL41i_lGRs2zvGarZHkWbumhhqU0aXJo7MLoOQ9aR5_Q&oe=6A95ADE2"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.08.47.png", "id": "1426309168884035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1426309172217368_1019297969091737075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e4UqPYKsOUQ7kNvwFdXtRO&_nc_oc=AdrVUiIBHpH-BErXo1-TSQYczjsNKNFCYyDU6d0HSFk1fpRopKR0A4pT8hMqZ4GHCHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOhKm1q-1XDWw54gxTPKXAk591FeR7Jq3etTU0EhJfmQ&oe=6A95D411"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.12.png", "id": "1791231008391357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620432_1791231011724690_7646563548256713933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bpj_xNZ0mRMQ7kNvwEayR9J&_nc_oc=AdprULCgpk0LRi7KuSVWD79Xt3Lg01Cn1oKVr2816oI9oYy1nX9aMuQ_ZXiWoM7X1Pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0wBf5999srGJHwccxeEWHmOreJAc4rx6hggWgS_vtqA&oe=6A95C661"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.41.png", "id": "25923127443961648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_25923127447294981_5221699009642254234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFdWMBlM_B8Q7kNvwEPTCIa&_nc_oc=Adq-5EAEDUqeCNU-hg3rCJtAup-YIv1UoMOzFAhecA0wYKXN_u9FTZ2loo8xjVI-bUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpI7yyt874hbszQ1mZkSWeZEGop16hdssB_Yu8uFXA1A&oe=6A95B2B0"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.10.18.png", "id": "1374499653759686", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_1374499657093019_1388091325729183700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5P4UCkXrbIQ7kNvwGiALe_&_nc_oc=Adot4pRoK8X-dtpANJWKMUUsPnqXzXiNZLLMqNGsUdAQZZYp6P5PhlVRyFN5lX_NGxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhxhEGPsG3IbKr44swf9IZ3YPU7gvMGJcSYqaellQSLw&oe=6A95DF6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S-Calculator", "keywords": [], "long_description": "A stylish, simple, and easy-to-use calculator with a hidden feature\n\nA stylish calculator app with a design based on black.\nWe have simply gathered the functions needed for daily calculations, pursuing true ease of use.\n\n[Main Features]\n\u30fbBasic Functions: Arithmetic operations (+, -, \u00d7, \u00f7), percentage calculations, and sign switching (+/-).\n\u30fbUsability: Equipped with haptic feedback (vibration) when buttons are pressed.\n\u30fbDesign: Uses an eye-friendly dark mode and a highly readable programming font.\n\u30fbPrecision: Supports input of up to 15 digits, designed to minimize calculation errors.\n\n[Hidden Feature]\nTired of calculating? How about a little break?\nIf you tap the \"=\" button 5 times rapidly while in the initial state (when \"0\" is displayed), a hidden game mode will launch.\nPlease enjoy a simple yet engrossing side-scrolling action game.\n(Game Controls: Jump with \"0\", Return to calculator with \"AC\")\n\nMaking daily calculations a little more fun.\nWe hope you download and make use of it.", "short_description": "A stylish calculator designed in black. It distills daily functions into simplicity, created with a focus on pure usability."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "publisher_name": "Lubyte", "support_website_url": null, "website_url": "http://lubyte.net/", "category": null, "comfort_rating": "COM
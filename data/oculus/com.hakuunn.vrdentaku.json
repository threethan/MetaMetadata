7_855324797272964_6547007288884241904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFb76VwlhI8Q7kNvwFUecme&_nc_oc=AdoPnduhXQAvnnvTngCrTFTg2uFDTfvpUTEGMoTgtuAv7ArW1DJKdR5aWzUt0-AN060&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vj5iaPHqZeaGD4qnSQw_UFhI9hREaV3GoSd-SdA7KlA&oe=6A3BD4F9"}]}, "id": "25373900985562666", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30a8\u30b9\u30c7\u30f3\u30bf\u30af", "keywords": [], "long_description": "\u30b7\u30f3\u30d7\u30eb\u3067\u4f7f\u3044\u3084\u3059\u3044\u3001\u96a0\u3057\u6a5f\u80fd\u4ed8\u304d\u306e\u30b9\u30bf\u30a4\u30ea\u30c3\u30b7\u30e5\u306a\u96fb\u5353\n\n\u9ed2\u3092\u57fa\u8abf\u3068\u3057\u305f\u30b9\u30bf\u30a4\u30ea\u30c3\u30b7\u30e5\u306a\u30c7\u30b6\u30a4\u30f3\u306e\u96fb\u5353\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\u65e5\u5e38\u306e\u8a08\u7b97\u306b\u5fc5\u8981\u306a\u6a5f\u80fd\u3092\u30b7\u30f3\u30d7\u30eb\u306b\u307e\u3068\u3081\u3001\u4f7f\u3044\u3084\u3059\u3055\u3092\u8ffd\u6c42\u3057\u307e\u3057\u305f\u3002\n\n\u3010\u4e3b\u306a\u6a5f\u80fd\u3011\n\u30fb\u57fa\u672c\u6a5f\u80fd\uff1a\u56db\u5247\u6f14\u7b97\uff08\uff0b\u3001\uff0d\u3001\u00d7\u3001\u00f7\uff09\u3001\u30d1\u30fc\u30bb\u30f3\u30c8\u8a08\u7b97\u3001\u7b26\u53f7\u53cd\u8ee2\n\u30fb\u64cd\u4f5c\u611f\uff1a\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u305f\u6642\u306e\u89e6\u899a\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\uff08\u632f\u52d5\uff09\u6a5f\u80fd\u642d\u8f09\n\u30fb\u30c7\u30b6\u30a4\u30f3\uff1a\u76ee\u306b\u512a\u3057\u3044\u30c0\u30fc\u30af\u30e2\u30fc\u30c9\u3068\u3001\u8aad\u307f\u3084\u3059\u3044\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u30d5\u30a9\u30f3\u30c8\u3092\u63a1\u7528\n\u30fb\u7cbe\u5ea6\uff1a\u6700\u592715\u6841\u307e\u3067\u306e\u5165\u529b\u306b\u5bfe\u5fdc\u3057\u3001\u8a08\u7b97\u8aa4\u5dee\u3092\u6291\u3048\u305f\u8a2d\u8a08\n\n\u3010\u96a0\u3057\u6a5f\u80fd\u3011\n\u8a08\u7b97\u306b\u75b2\u308c\u305f\u3089\u3001\u3061\u3087\u3063\u3068\u3057\u305f\u606f\u629c\u304d\u306f\u3044\u304b\u304c\u3067\u3059\u304b\uff1f\n\u521d\u671f\u72b6\u614b\uff08\u753b\u9762\u8868\u793a\u304c\u300c0\u300d\u306e\u6642\uff09\u3067\u300c=\u300d\u30dc\u30bf\u30f3\u30925\u56de\u9023\u6253\u3059\u308b\u3068\u3001\u96a0\u3057\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u8d77\u52d5\u3057\u307e\u3059\u3002\n\u30b7\u30f3\u30d7\u30eb\u306a\u304c\u3089\u71b1\u4e2d\u3067\u304d\u308b\u3001\u6a2a\u30b9\u30af\u30ed\u30fc\u30eb\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\u3002\n\uff08\u30b2\u30fc\u30e0\u64cd\u4f5c\uff1a\u300c0\u300d\u30dc\u30bf\u30f3\u3067\u30b8\u30e3\u30f3\u30d7\u3001\u300cAC\u300d\u30dc\u30bf\u30f3\u3067\u96fb\u5353\u306b\u623b\u308b\uff09\n\u6bce\u65e5\u306e\u8a08\u7b97\u3092\u3001\u3082\u3046\u5c11\u3057\u697d\u3057\u304f\u3002\n\u305c\u3072\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3054\u6d3b\u7528\u304f\u3060\u3055\u3044\u3002", "short_description": "\u9ed2\u3092\u57fa\u8abf\u3068\u3057\u305f\u30b9\u30bf\u30a4\u30ea\u30c3\u30b7\u30e5\u306a\u30c7\u30b6\u30a4\u30f3\u306e\u96fb\u5353\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\u65e5\u5e38\u306e\u8a08\u7b97\u306b\u5fc5\u8981\u306a\u6a5f\u80fd\u3092\u30b7\u30f3\u30d7\u30eb\u306b\u307e\u3068\u3081\u3001\u4f7f\u3044\u3084\u3059\u3055\u3092\u8ffd\u6c42\u3057\u307e\u3057\u305f\u3002"}, {"images": {"nodes": [{"file_name": "s.png", "id": "1432201371949224", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_1432201375282557_1802287030317108100_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRF3MGEvS0UQ7kNvwE-6zCS&_nc_oc=AdqxAGzXe0GOCATkJHU13mhJbZl1C-wnY4wooiVo_CktXkRPkZfx6mH-76U30E1wPF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AKHH8BRET2V8HMHNGRtFz_8ZXj5fQrnxoJq_shcGKoQ&oe=6A3BF2FF"}, {"file_name": "1.png", "id": "1268497871756742", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/
3jB_o-xDe0Punqpi9MhcK2T6tI-TphU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsxcDcSr6GbyaN9F-tGRXhvS-jpXsZv__PaXkO7H5zieg&oe=69A43322"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.08.47.png", "id": "1426309168884035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1426309172217368_1019297969091737075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoamSJ_IKM8Q7kNvwE3g7pq&_nc_oc=Adl5Nk0WqiaflYFrX2TTpJfbP3sk0zGUNNOe7Piiru9BzFylWQGmEdmesG-I8FEi5kw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuFyBPI8dLO_wjQggsWCeCwdOaWPjYx4C_auIqxv3Fg9Q&oe=69A42111"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.12.png", "id": "1791231008391357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620432_1791231011724690_7646563548256713933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kRhkimXxH4Q7kNvwE4frvD&_nc_oc=AdlRLfwzqIE5jI1IfFlQ51wFtRkyYTDW3kj6cNV1mQtRxIZqyNX4gwlK-XwumWdYMj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUZM3kchvKsCjADClE4AF0n9UfAEWAc_ZGjos2QayddA&oe=69A44BA1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.41.png", "id": "25923127443961648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_25923127447294981_5221699009642254234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK1h6abqqKkQ7kNvwHPgzZi&_nc_oc=AdkSXhts1vX6suVbSobIWWMMZjbFdN7iD8P1S7OrT6RfRodUSqU4KVzOFK_d5PQ7RBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsusaOpwoRlUjKj0lRsZCn9OpEJQ_ZkQlCS27L-npBA0Q&oe=69A437F0"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.10.18.png", "id": "1374499653759686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618274_1374499657093019_1388091325729183700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h3JuzcjxmcQ7kNvwHqbGKN&_nc_oc=AdngDxhWP2l4GDziaunrk9cpJCbQ3-CZvD01eOzHTzp6dkbso8IcIOh61HTS_rQo6Gg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuhRtpnmHsiQHLzXC40YOhO3dSLhLeEUWF8w0DpNpZv5g&oe=69A42C6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S-Calculator", "keywords": [], "long_description": "A stylish, simple, and easy-to-use calculator with a hidden feature\n\nA stylish calculator app with a design based on black.\nWe have simply gathered the functions needed for daily calculations, pursuing true ease of use.\n\n[Main Features]\n\u30fbBasic Functions: Arithmetic operations (+, -, \u00d7, \u00f7), percentage calculations, and sign switching (+/-).\n\u30fbUsability: Equipped with haptic feedback (vibration) when buttons are pressed.\n\u30fbDesign: Uses an eye-friendly dark mode and a highly readable programming font.\n\u30fbPrecision: Supports input of up to 15 digits, designed to minimize calculation errors.\n\n[Hidden Feature]\nTired of calculating? How about a little break?\nIf you tap the \"=\" button 5 times rapidly while in the initial state (when \"0\" is displayed), a hidden game mode will launch.\nPlease enjoy a simple yet engrossing side-scrolling action game.\n(Game Controls: Jump with \"0\", Return to calculator with \"AC\")\n\nMaking daily calculations a little more fun.\nWe hope you download and make use of it.", "short_description": "A stylish calculator designed in black. It distills daily functions into simplicity, created with a focus on pure usability."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "publisher_name": "Lubyte", "support_website_url": null, "website_url": "http://lubyte.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NO
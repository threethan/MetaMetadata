_i3qO9JT2XHcH-PGgOn28GtZJR6hG1XNrHHOiAk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1CGG4Jup0QACPCPzW5DavcbMNMl4zy3XU0MxXeBpjVQ&oe=6AFB3630"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.10.18.png", "id": "1374499653759686", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618274_1374499657093019_1388091325729183700_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YKya4xX6ekQ7kNvwHKDftN&_nc_oc=AdpUt1m7HFfO3YsU0fn290mFnZd5B-92ZtTxV14IGxj9XMW_tO7j7UmmjRZMP0O-QLo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI1EKDNat3IprEyqvW4BVYpZNLEGMqM8d_KPWKsPbRIQ&oe=6AFB2AAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S-Calculator", "keywords": [], "long_description": "A stylish, simple, and easy-to-use calculator with a hidden feature\n\nA stylish calculator app with a design based on black.\nWe have simply gathered the functions needed for daily calculations, pursuing true ease of use.\n\n[Main Features]\n\u30fbBasic Functions: Arithmetic operations (+, -, \u00d7, \u00f7), percentage calculations, and sign switching (+/-).\n\u30fbUsability: Equipped with haptic feedback (vibration) when buttons are pressed.\n\u30fbDesign: Uses an eye-friendly dark mode and a highly readable programming font.\n\u30fbPrecision: Supports input of up to 15 digits, designed to minimize calculation errors.\n\n[Hidden Feature]\nTired of calculating? How about a little break?\nIf you tap the \"=\" button 5 times rapidly while in the initial state (when \"0\" is displayed), a hidden game mode will launch.\nPlease enjoy a simple yet engrossing side-scrolling action game.\n(Game Controls: Jump with \"0\", Return to calculator with \"AC\")\n\nMaking daily calculations a little more fun.\nWe hope you download and make use of it.", "short_description": "A stylish calculator designed in black. It distills daily functions into simplicity, created with a focus on pure usability."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "publisher_name": "Lubyte", "support_website_url": null, "website_url": "http://lubyte.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25542870515338385"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618093_828912539974886_5752184073262378825_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voZysPot3e0Q7kNvwEgsC07&_nc_oc=AdqqCPR36ZK96nGgfLTnQOoKzt08YUylIZW2gdeaNTSVsqLZ0BIZoEb8GFMPAWXGeSI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpiuWUJfddFsyRNpKJBxKflCdZ5F_YGTz84LaKzx1Nxg&oe=6AFB2EF5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "S-Calculator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1768461540, "lastRevision": {"nodes": [{"id": "25542870535338383", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
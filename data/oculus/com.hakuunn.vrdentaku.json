3030929077769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGLmMcbz5voQ7kNvwEOi93Z&_nc_oc=Ado1duQxngQoN03-kGyH2fyWR-W96X-GYz-VMK8UDx2EQKm4FN79VqE444dulASYzHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi_39-qlksy5hjf5OZSYzVfS9agEEK7GJV2Ff6F6BnAw&oe=6A6B45A2"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.08.47.png", "id": "1426309168884035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_1426309172217368_1019297969091737075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZGG_yQv1tcQ7kNvwGtE16L&_nc_oc=Adr0WJQGcb2hwuWErlx9m6c8S95hMrwBHrkF_g52wa-d6LXAN09zJ2jzJZdCW26nWEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4peNYxW4Vu9Cm7-x8EI6v_vAbH7jTcJUKcJGgO80A8w&oe=6A6B6BD1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.12.png", "id": "1791231008391357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_1791231011724690_7646563548256713933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBX1ZHu6qP4Q7kNvwHTj9Pg&_nc_oc=Adp1YBWy4SDa7i7Ply4b7o7BDyv80c7oNOtJKlsJQAgsevxh3xpp7jfwFu9d6AuIfWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzakIUAy_EhTgvsyt1sTcBCfK0AZ33o_8MGhtZLESvpg&oe=6A6B5E21"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.41.png", "id": "25923127443961648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_25923127447294981_5221699009642254234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUzLWrfbyR0Q7kNvwEgZ7ab&_nc_oc=AdqYrANqMEZaNYslKuukzEJFXCXtOSoBmOwCPArgjtsDuxSScweDsnIWpGx3e08mNwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcDqq4rvMIqwCDeJWShyQi8F-K94vF7dGMluUebcf-eg&oe=6A6B4A70"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.10.18.png", "id": "1374499653759686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_1374499657093019_1388091325729183700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in77H2-PHMMQ7kNvwGBmyVO&_nc_oc=Adq0bTs3yf3d3ykVk7mlOdaUtj-yPJcX4ff-7XmyYXGrhQd7xl3Gt62rta_Y6ikz97E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiaVN7U-ZmoawABB2V3Xa-CJKEyAc0rV9Zfn82jNXuBg&oe=6A6B3EEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S-Calculator", "keywords": [], "long_description": "A stylish, simple, and easy-to-use calculator with a hidden feature\n\nA stylish calculator app with a design based on black.\nWe have simply gathered the functions needed for daily calculations, pursuing true ease of use.\n\n[Main Features]\n\u30fbBasic Functions: Arithmetic operations (+, -, \u00d7, \u00f7), percentage calculations, and sign switching (+/-).\n\u30fbUsability: Equipped with haptic feedback (vibration) when buttons are pressed.\n\u30fbDesign: Uses an eye-friendly dark mode and a highly readable programming font.\n\u30fbPrecision: Supports input of up to 15 digits, designed to minimize calculation errors.\n\n[Hidden Feature]\nTired of calculating? How about a little break?\nIf you tap the \"=\" button 5 times rapidly while in the initial state (when \"0\" is displayed), a hidden game mode will launch.\nPlease enjoy a simple yet engrossing side-scrolling action game.\n(Game Controls: Jump with \"0\", Return to calculator with \"AC\")\n\nMaking daily calculations a little more fun.\nWe hope you download and make use of it.", "short_description": "A stylish calculator designed in black. It distills daily functions into simplicity, created with a focus on pure usability."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "publisher_name": "Lubyte", "support_website_url": null, "website_url": "http://lubyte.net/", "category": null, "comfort_rating": "COM
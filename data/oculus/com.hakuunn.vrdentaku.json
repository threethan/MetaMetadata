3030929077769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXpFj-LrtfYQ7kNvwE2vGhT&_nc_oc=AdqQQN2fm28fyCtpZ9u3q3O8n6xsW6czU4wDBogqo9e2uNEpmwU2JsWJZJcLQ6SOHpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YFEv8PiNf_iDjxpVRnOw1fWgzf6pvAcyO9FrmR69BSw&oe=6A381362"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.08.47.png", "id": "1426309168884035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_1426309172217368_1019297969091737075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIDDXxgQxgwQ7kNvwGwdJiW&_nc_oc=AdrXdwu_09CYSWokaawMKXXZxVKJVGZRXyQdQ-Vv6Toc9YRlbO_ndr1_-HZ_Iaf02zY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NrYc1hPzViPl8lwCN0SiZsCont6Z5uRN0RlmIuV8X5A&oe=6A380151"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.12.png", "id": "1791231008391357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_1791231011724690_7646563548256713933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hnaiqa2fcEQ7kNvwEaGSco&_nc_oc=Ado1eBGuZU0i3Opj2pvfHHyqamU7NnhEZVAd4DEx2mm3SDCpu2wSBJGywLiCQGcRgrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kuVldaHqBVM3ATZDSuxSUS_sNWEED7Gk6hRx3WhDOvQ&oe=6A37F3A1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.41.png", "id": "25923127443961648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_25923127447294981_5221699009642254234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upzLLvIuMPUQ7kNvwElQwMk&_nc_oc=AdpxJdYofNaq8zFpAFAnZAv0evm6gbZezVTGKufwfDse4uYHz1-3X9gbYPD8PrT8ZYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vGdFnFzCrsCNOrA3pIIoYeqQ0b_NLmYa4At7aUG885A&oe=6A37DFF0"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.10.18.png", "id": "1374499653759686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_1374499657093019_1388091325729183700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIUtphJPiCkQ7kNvwEjVV94&_nc_oc=AdrHXt65l1BmbpVcO8FmKNWAWinzzAr-wN6SqCHoX-ha5ao3vrQ5_zt-tVtUHRapfUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7i7tmjYFgYA8U2gp3ISzjsGbIdiO0FE2bXNQOMdLBcw&oe=6A380CAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S-Calculator", "keywords": [], "long_description": "A stylish, simple, and easy-to-use calculator with a hidden feature\n\nA stylish calculator app with a design based on black.\nWe have simply gathered the functions needed for daily calculations, pursuing true ease of use.\n\n[Main Features]\n\u30fbBasic Functions: Arithmetic operations (+, -, \u00d7, \u00f7), percentage calculations, and sign switching (+/-).\n\u30fbUsability: Equipped with haptic feedback (vibration) when buttons are pressed.\n\u30fbDesign: Uses an eye-friendly dark mode and a highly readable programming font.\n\u30fbPrecision: Supports input of up to 15 digits, designed to minimize calculation errors.\n\n[Hidden Feature]\nTired of calculating? How about a little break?\nIf you tap the \"=\" button 5 times rapidly while in the initial state (when \"0\" is displayed), a hidden game mode will launch.\nPlease enjoy a simple yet engrossing side-scrolling action game.\n(Game Controls: Jump with \"0\", Return to calculator with \"AC\")\n\nMaking daily calculations a little more fun.\nWe hope you download and make use of it.", "short_description": "A stylish calculator designed in black. It distills daily functions into simplicity, created with a focus on pure usability."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "publisher_name": "Lubyte", "support_website_url": null, "website_url": "http://lubyte.net/", "category": null, "comfort_rating": "COM
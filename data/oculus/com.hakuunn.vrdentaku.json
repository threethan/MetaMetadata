67\u3059\u304b\uff1f\n\u521d\u671f\u72b6\u614b\uff08\u753b\u9762\u8868\u793a\u304c\u300c0\u300d\u306e\u6642\uff09\u3067\u300c=\u300d\u30dc\u30bf\u30f3\u30925\u56de\u9023\u6253\u3059\u308b\u3068\u3001\u96a0\u3057\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u8d77\u52d5\u3057\u307e\u3059\u3002\n\u30b7\u30f3\u30d7\u30eb\u306a\u304c\u3089\u71b1\u4e2d\u3067\u304d\u308b\u3001\u6a2a\u30b9\u30af\u30ed\u30fc\u30eb\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\u3002\n\uff08\u30b2\u30fc\u30e0\u64cd\u4f5c\uff1a\u300c0\u300d\u30dc\u30bf\u30f3\u3067\u30b8\u30e3\u30f3\u30d7\u3001\u300cAC\u300d\u30dc\u30bf\u30f3\u3067\u96fb\u5353\u306b\u623b\u308b\uff09\n\u6bce\u65e5\u306e\u8a08\u7b97\u3092\u3001\u3082\u3046\u5c11\u3057\u697d\u3057\u304f\u3002\n\u305c\u3072\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3054\u6d3b\u7528\u304f\u3060\u3055\u3044\u3002", "short_description": "\u9ed2\u3092\u57fa\u8abf\u3068\u3057\u305f\u30b9\u30bf\u30a4\u30ea\u30c3\u30b7\u30e5\u306a\u30c7\u30b6\u30a4\u30f3\u306e\u96fb\u5353\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\u65e5\u5e38\u306e\u8a08\u7b97\u306b\u5fc5\u8981\u306a\u6a5f\u80fd\u3092\u30b7\u30f3\u30d7\u30eb\u306b\u307e\u3068\u3081\u3001\u4f7f\u3044\u3084\u3059\u3055\u3092\u8ffd\u6c42\u3057\u307e\u3057\u305f\u3002"}, {"images": {"nodes": [{"file_name": "s.png", "id": "1432201371949224", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296890_1432201375282557_1802287030317108100_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw5-70Lhf_AQ7kNvwHAvsek&_nc_oc=AdnPxAtVJl2cofL1sfgTDb3CXiBlqPBSIoOtLk3cY4MJoYYB7sb7BKx4hITdh7ePwcs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsALsMMaYmzj4yGRII-0h76v8wtRTTDhEZgTkvg3hTr6w&oe=69A56FBF"}, {"file_name": "1.png", "id": "1268497871756742", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618472_1268497875090075_6710919702693276086_n.png?_nc_cat=103&ccb=1-7&_nc_s
pm4KDfrMCi9q6Mz6bxFUE9fuX07cX90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyKNAx1qNJdxXKihy_IlRTUMaOKD7FKbtwj9jupVuW1Q&oe=699D9BA2"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.08.47.png", "id": "1426309168884035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_1426309172217368_1019297969091737075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOQc22GwsyEQ7kNvwEftM1_&_nc_oc=AdmX1p0gSWv4JcyhC0NAHjQ7kT2V5YT7FMAZTItNsfVuimcKKoCFXb9cg5pPWG2WXHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0DOEdiR0Uqm-_lxwOiYQMaIvky27SIHTuiURp6F5V2A&oe=699D8991"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.12.png", "id": "1791231008391357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_1791231011724690_7646563548256713933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsQMqx-LJUMQ7kNvwFAB_v2&_nc_oc=AdnlAOhtsEGktFYHolh_epwT42B7bqD9AyFqQZ0PXDjbh78nBVZvV0CZXxkiuneGmQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYzITyKOc3BiXCC9sbNvegBAe2H9yfsO6evNHpCLJWgg&oe=699DB421"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.09.41.png", "id": "25923127443961648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_25923127447294981_5221699009642254234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwCOKDxAqkQQ7kNvwGvkrIF&_nc_oc=AdndrPYiqTAJT5OswUqpe3KhbXCo9lj06QZK-x319w-bLw3PMgeALzhfipAq_NI_XPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvfsYTf8hPA8G1YUia3grs_QKkylKxb38vchT-8vVX7w&oe=699DA070"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2026-01-09 14.10.18.png", "id": "1374499653759686", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_1374499657093019_1388091325729183700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udFy_g4ed6kQ7kNvwHoZ2X3&_nc_oc=Adn1Ijw_tD1Bio4fcU7WF80kL4lpYnvhsnYto4WhHx7WHlFUX_iKX9hBUqomxWzoC9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZ7Ahg7hAOfj_TauL3WvhjYLXVeI7M43pVZON4dUtPpQ&oe=699D94EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S-Calculator", "keywords": [], "long_description": "A stylish, simple, and easy-to-use calculator with a hidden feature\n\nA stylish calculator app with a design based on black.\nWe have simply gathered the functions needed for daily calculations, pursuing true ease of use.\n\n[Main Features]\n\u30fbBasic Functions: Arithmetic operations (+, -, \u00d7, \u00f7), percentage calculations, and sign switching (+/-).\n\u30fbUsability: Equipped with haptic feedback (vibration) when buttons are pressed.\n\u30fbDesign: Uses an eye-friendly dark mode and a highly readable programming font.\n\u30fbPrecision: Supports input of up to 15 digits, designed to minimize calculation errors.\n\n[Hidden Feature]\nTired of calculating? How about a little break?\nIf you tap the \"=\" button 5 times rapidly while in the initial state (when \"0\" is displayed), a hidden game mode will launch.\nPlease enjoy a simple yet engrossing side-scrolling action game.\n(Game Controls: Jump with \"0\", Return to calculator with \"AC\")\n\nMaking daily calculations a little more fun.\nWe hope you download and make use of it.", "short_description": "A stylish calculator designed in black. It distills daily functions into simplicity, created with a focus on pure usability."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://lubyte.net/s-dentaku-privacy-policy-and-terms-of-service/", "publisher_name": "Lubyte", "support_website_url": null, "website_url": "http://lubyte.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NO
ills to unravel various puzzles and brain teasers to rescue the most important sacred relics from the Christian Era. This is a case full of twists and surprises.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.transcenderstudios.com/edmundpuzzle-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Transcender Studios Inc", "support_website_url": null, "website_url": "https://www.transcenderstudios.com/edmund-puzzle", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "293191446688977"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1037932501542113"}, {"status": "PUBLISHED", "id": "826881762442095"}]}, "baseline_offer": {"id": "1037932501542113"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751327340, "status": "PUBLISHED", "id": "1037932501542113"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6177342165711035", "version": "2.9"}, "id": "1038727537129390", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6140144366097482", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "61773
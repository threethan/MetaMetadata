", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974884_722256393071922_5714711793545250152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8OS7UZbKpAQ7kNvwFJUklg&_nc_oc=AdpKnXleeInPCKvpeieNUanJTXT7tbrXN0kG1M443YjUxO-9p-B3TNiYyI8gx2v8J4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3ZDnG-A5nJejZuUp_cIALBh0oZdcFB6Bt66_7SKBm6uA&oe=69F0D1AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateHero (2560x1440).png", "id": "617365083616992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031564_617365086950325_6308133504586485578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Rrv0jSuv7cQ7kNvwGBXlYK&_nc_oc=AdoA2jj_A4au-nwM6_AgL8yzKz8VsF2eFlRwUIi21ojhU8_WDkRvy12Tn3pXUloVPLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1p_cXtR8tejpqGG_F_OV3hwdlrMZ0PPnLg9oiEOFRcVg&oe=69F0D0CB"}, "display_name": "EDMUND PUZZLE AND THE MYSTERY OF THE SACRED RELICS", "keywords": [], "long_description": "Mystery. Adventure. Time travel. Get ready to embark on an epic adventure through time and space in Edmund Puzzle and the Mysteries of the Sacred Relics. In a world full of dangers and mysteries, every minute counts to save humanity from a mysterious and extremely dangerous enemy. You'll need to use all your skills to unravel various puzzles and brain teasers to rescue the most important sacred relics from the Christian Era. This is a case full of twists and surprises. So grab your backpack and your Oculus VR and embark on this exciting journey.\n", "short_description": "Mystery. Adventure. Time travel. Get ready to embark on an epic adventure through time and space in Edmund Puzzle and the Mysteries of the Sacred Relics. In a world full of dangers and mysteries, every minute counts to save humanity from a mysterious and extremely dangerous enemy. You'll need to use all your skills to unravel various puzzles and brain teasers to rescue the most important sacred relics from the Christian Era. This is a case full of twists and surprises.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.transcenderstudios.com/edmundpuzzle-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Transcender Studios Inc", "support_website_url": null, "website_url": "https://www.transcenderstudios.com/edmund-puzzle", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "293191446688977"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1037932501542113"}, {"status": "PUBLISHED", "id": "826881762442095"}]}, "baseline_offer": {"id": "1037932501542113"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751327340, "status": "PUBLISHED", "id": "1037932501542113"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6177342165711035", "version": "2.9"}, "id": "1038727537129390", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6140144366097482", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6177342165711035"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1038727537
88"}, {"file_name": "SCS1.png", "id": "1007361828506125", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620940_1007361831839458_8765810747723813133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpdpSuXvOKoQ7kNvwG0SWsT&_nc_oc=AdrKjfxHLv_HGBBuEGCogZVmkSgG3MP_DMwaVnGc0g-II4qsKea4T7HWmyESL14Fook&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6VGmTTCSQKKzYhtB6nmQ0j14VH2YgN08AMlo2I6XX1g&oe=6A4E5712"}, {"file_name": "SCS4.png", "id": "2230558887681851", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673554902_2230558891015184_3636757792075253546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdGaPdoyVHwQ7kNvwGYe-x3&_nc_oc=Adpw5-KmIu2RUT8fObx3VFs67tzvItQortCYrYUM3qfH0IQSl1aVJ8UDg36BaPqKVI8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi0DtI8S5fspKYzwYI-DvAkK5o_sB4j-N5sWZnG0flew&oe=6A4E6C56"}, {"file_name": "SCS3.png", "id": "985277867696556", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507883434_985277874363222_4455689543896954623_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fejN1YfZ9vwQ7kNvwE3NbC7&_nc_oc=AdomLWeJlKMAONAAybMNTXly0iYgdwDJI31qGN0rOuyBLRYkTWpjiHpIc3mVKfd4ayA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6_cG1kURLc7dKQ71dK_XPNhcDAnXjX0XqZxqferEzPg&oe=6A4E3CD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BugHunterXR", "keywords": ["bug", "hunter", "bugs", "hidden"], "long_description": "Step into a magical nighttime world where tiny glowing creatures are hiding all around you. In Bug Hunter XR, your room transforms into a living insect sanctuary filled with mysterious sounds, soft lights, and adorable fantasy bugs waiting to be discovered, using immersive spatial audio, you must carefully listen to chirps, buzzing wings, tiny footsteps, and hidden movements to track down elusive insects before the timer runs out. Search behind furniture, under tables, near walls, and inside the tallest grass as each creature hides in unique and unexpected places.", "short_description": "Bug Hunter XR is a cozy mixed reality adventure where adorable hidden insects crawl, flutter, and chirp around your room. Use spatial audio to track their tiny sounds before time runs out, discover rare glowing creatures, and become the ultimate bug hunter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://craftplayxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "CraftplayXR", "support_website_url": null, "website_url": "https://craftplayxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1123090047557068"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620817_27305729989114843_551818434809058275_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqqfGIkNMXYQ7kNvwE_1-mT&_nc_oc=Adq2vvCHkH9N4iQr5D4C95IJ0Ig_iGnuHhzCdOnGe4eMjktX_7qlItonRTVXQPXkDlM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0R82tjrpE7UaSlG0JIeC1gnmPE9l-zYQ6sq9aor5SRg&oe=6A4E5B8D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BugHunterXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"
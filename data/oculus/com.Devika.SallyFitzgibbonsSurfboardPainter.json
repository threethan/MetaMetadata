dn.com/v/t64.5771-25/75340713_633999525412584_6296529413470511979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeUatQt0gacQ7kNvwH3QtoA&_nc_oc=Adp42OcJqPpLtQVn4dYmm6zHmT1mEe5rN8AGcohdszJTL2ZHmHB7UQvd-C33ulNc0k0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdvIkNAJTn_cYqP8gQTTNixwj4dABxbaZ_nYcu50ux4Q&oe=6A6224B8"}, {"file_name": "sally-1.png", "id": "760719828826951", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_760719832160284_2189842543334867788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgV26ryWMCYQ7kNvwGcJv6-&_nc_oc=AdqPf9qRVhiTP-J1JWODKQITAeyZWtLBGXJ49Xbn2p2Qz2oBcpUo2W9_o36-glFSAXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg_LZheZEeq5NhbV533qOwhF_CPQFROL5Li5Oijq-gAA&oe=6A620094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sally-cover.png", "id": "260048689833367", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572933_260048693166700_8944212315922885440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzAHPlE16OQQ7kNvwGw6LXg&_nc_oc=AdpBaMqO3--eFL4_pHGDDuEpvSQ0pDZVuEDiDNtMYz0PMwLpZeRM7NJE3PVzVf5IwrQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoCNE3BpPU1rEJgeRDNRRYf-8lxDvC7Wg5mhTkh68q2Q&oe=6A620ED0"}, "display_name": "Sally Fitzgibbons Surfboard Painter", "keywords": [], "long_description": "Use Art Therapy to help relieve your anxiety.\n\nEvenness is about building experiences with emerging technology aimed at creating balance or equity between things. It is about finding ways to even out and balance the feelings you may be having with effective mechanisms that have already been developed, enhanced and now accessible with virtual reality. The Evenness Art Therapy experience is designed in conjunction with Sally Fitzgibbons. It lets you paint in 3D space within virtual reality. Your area is your canvas. Your palette is your imagination. The possibilities are endless, all near the ocean. ", "short_description": "The Evenness
dn.com/v/t64.5771-25/75340713_633999525412584_6296529413470511979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fPoYppBxIgQ7kNvwGGuTMQ&_nc_oc=AdqbuGEbFetzc2g0OWAHxql2DiFpKdZWBuh5i6CjrDH1VufTth9LUjGPlqZIjg-YJ3Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkt4nyqugRfn8H91tn0qIubNZyZHM9N9ENIbfe0ORV9A&oe=6A5A3BB8"}, {"file_name": "sally-1.png", "id": "760719828826951", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974635_760719832160284_2189842543334867788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpff2Z8LiaQQ7kNvwHvDt1t&_nc_oc=AdoZtEX817Bhcn8IV2L5GL75oUYdes4Cn1PXhEgLFjUKZJFmdvJ4p8jhe5sNxwe6nWk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy_E9iwJj43gjS5t3xPHdYcqfuCffvIprkZ-KTO6cxcw&oe=6A5A1794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sally-cover.png", "id": "260048689833367", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572933_260048693166700_8944212315922885440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv6_Fdh7qIcQ7kNvwGv7Zn2&_nc_oc=AdqkIX2TIXMTWjdaEPufbEKvq5PnGJrCtIEWYvNtlW9CWT5IGciZ9MdzUCPvqbzli00&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANT9yHDQLr2B-OL4pxe6dxvwzD7ifIubuhcxzsB2PVMw&oe=6A5A25D0"}, "display_name": "Sally Fitzgibbons Surfboard Painter", "keywords": [], "long_description": "Use Art Therapy to help relieve your anxiety.\n\nEvenness is about building experiences with emerging technology aimed at creating balance or equity between things. It is about finding ways to even out and balance the feelings you may be having with effective mechanisms that have already been developed, enhanced and now accessible with virtual reality. The Evenness Art Therapy experience is designed in conjunction with Sally Fitzgibbons. It lets you paint in 3D space within virtual reality. Your area is your canvas. Your palette is your imagination. The possibilities are endless, all near the ocean. ", "short_description": "The Evenness Art Therapy experience is designed in conjunction with Sally Fitzgibbons. It lets you paint in 3D space within virtual reality. Your area is your canvas. Your palette is your imagination. The possibilities are endless, all near the ocean. "}]}, "developer_name": "Devika Works", "developer_privacy_policy_url": "https://evenness.app/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devika Works", "support_website_url": "https://devikaworks.atlassian.net/servicedesk/customer/portal/1", "website_url": "https://evenness.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7112253325498088"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544505191173531"}]}, "baseline_offer": {"id": "544505191173531"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1705079920, "status": "PUBLISHED", "id": "544505191173531"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4563367613720018", "version": "0.3.5"}, "id": "501304570974795", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "42225317278036
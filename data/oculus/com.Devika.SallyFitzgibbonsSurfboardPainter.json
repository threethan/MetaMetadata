dn.com/v/t64.5771-25/75340713_633999525412584_6296529413470511979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_Y1V2EriwUQ7kNvwHt1BZs&_nc_oc=AdqMB5J-OLUEKP9f1gCttYxa7KHN3q0Tv2Rq2tE_OmG1_9LSKIzu7t8vPdLjvDbBXfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8UmqyDCsebb0mB2CPdDDTO9oykUwq0DJ9ep2tqmbQtA&oe=6A5F81B8"}, {"file_name": "sally-1.png", "id": "760719828826951", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_760719832160284_2189842543334867788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dosZgbIdpcQ7kNvwF_z0oF&_nc_oc=AdoWp-75ePS7dGaLSPX4sSgbiP68AksjxayVWCKxB8Tug_-R6etn5BDAHpqfJXttJcM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCZfixKyXSE3SdODwcbgaD52MgGsvSKLv7qYCeIyT-5Q&oe=6A5F5D94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sally-cover.png", "id": "260048689833367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572933_260048693166700_8944212315922885440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNulh8vegsoQ7kNvwF8vFRH&_nc_oc=AdoL3PRT_VjbNMjZNwiwImZSXbj2WUPB6P_RNftGzPNGtcLN-wZ1w9SEigkWkZo6xYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh6WNL-eic4HcD_VY7zcApvMfLHe_jOM65EaFJoWwOWw&oe=6A5F6BD0"}, "display_name": "Sally Fitzgibbons Surfboard Painter", "keywords": [], "long_description": "Use Art Therapy to help relieve your anxiety.\n\nEvenness is about building experiences with emerging technology aimed at creating balance or equity between things. It is about finding ways to even out and balance the feelings you may be having with effective mechanisms that have already been developed, enhanced and now accessible with virtual reality. The Evenness Art Therapy experience is designed in conjunction with Sally Fitzgibbons. It lets you paint in 3D space within virtual reality. Your area is your canvas. Your palette is your imagination. The possibilities are endless, all near the ocean. ", "short_description": "The Evenness
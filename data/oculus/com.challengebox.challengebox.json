e_name": "5.png", "id": "2081962049131227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835807_2081962052464560_4006068434614889067_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWVIlMpoLuEQ7kNvwEu8i8w&_nc_oc=Adom92o51bH4rEGV6efDWVzdI7xcHbJNrqtLLTrxtKpOSA9ytSW7_tqNrSPq5eKBeNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSriXOeoAxv1IIXpkrJMwI98Jft4wyMNb_Sh8QNpBzLWQ&oe=6B0C5CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poster-2560x1440.png", "id": "1701162434717268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835818_1701162438050601_6667147320239713828_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeN9_hSKCJAQ7kNvwFuRzV3&_nc_oc=AdoswtkaeKfqZW4Rjia8Sd95dgeJ1Ld37iHg_cW2p65QGrkPXibm8qtWClR5mTzpHfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9kt8vqr2WUGMcyTpSI8f9tk2gm7GUwLFvfg771aLI4A&oe=6B0C5E0C"}, "display_name": "ChallengeBox Fitness", "keywords": ["Fitness", "Boxing", "Workout", "1vs1", "combat"], "long_description": "1v1 me.\n\nIt's a rhythm game where your combo is a weapon.\n\n\ud83e\udd4a Hit on the beat \u2192 charge your power\n\ud83d\udca5 Punch the power orb \u2192 blast it at your opponent\n\ud83d\udee1\ufe0f They shoot back \u2192 block it, or punch it at the perfect moment to parry it back at them\n\ud83d\udc80 Drain their energy \u2192 K.O.\n\nBest of 3. Every round gets harder. Round 3 drops on the hardest part of the song. That's where the clutch happens.\n\nREAL PLAYERS. \nLive 1v1.\n\nNobody online? Fight a robot while you wait. If someone joins mid-fight, you'll get the warning: \"A RIVAL IS ONLINE!\" Fight them or keep the robot. Your call.\n\nClimb from Beginner to Expert. Win 3 to level up. Losing? Skill issue. Run it back.\n\nThe crowd goes crazy for every combo, every parry, every K.O.\n\nFree. No ads. Nothing to buy. Nothing to unlock. Nobody pays to win.\n\nGet in. Lock in. Don't get K.O.'d.", "short_description": "1v1 LIVE FIGHTS. \nHit the beat, charge up, punch a fireball at your opponent. \nThey can punch it back. Free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://challengebox.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "ChallengeBox LLC", "support_website_url": null, "website_url": "https://challengebox.app/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "SPORTS", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "39907421735568539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835819_1674442464266669_4072366847510256851_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qp1C54baTa8Q7kNvwGfWYQy&_nc_oc=Adq2jkWhp5XytSaC4SjvLAOunCLb87y5AEYKOIbDR9gz1G9sEendEPonwg09ZdIMU88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSg7UlG14HZKZiu5W5Ll370Z8-1Yj8xGubYSv8cTTLeQ&oe=6B0C820D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChallengeBox Fitness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "45978150496
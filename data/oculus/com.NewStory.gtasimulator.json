8Mse_e-7QgbjJGeTP1T3wk4Esu3n_8iov4poQdEfoCsg&oe=6A22E007"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yufdCXQEuaIQ7kNvwHWSgSz&_nc_oc=AdpAPBbA3D2yKOLgBOBUdtZBCaNXivyR1B4dRSBmIS_6vX2B6Fb_oHVzU3UNXZw9Chk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MttGCjDOKhBkXRZjLQOBA67dh5UmjlJNNttXPvEVdCA&oe=6A22FB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street Raiders simulator DEMO_2560x1440.png", "id": "578817307958844", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820202_578817311292177_7727960620223750763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AS8MkObT08Q7kNvwHeXupP&_nc_oc=AdqraE-2qte8ja7VaxoPprLxiaNK_FXq15sWO8WYhqPGOtGJW49wsxjbLOSlTkCa9ss&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Fh80wgl-haBR2t78-jnIQW1UzAkfajywQdTorfDZ_A&oe=6A22E646"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street
hot1.png", "id": "1018299793186988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRNmfkNlvsgQ7kNvwFduM8z&_nc_oc=AdkbCssjrLrNnyi3xGK0UnkXjF5PsNpz_PiQuJ1mbFGun3pRtaFwlAVOIv2ZzsrZ-h8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1sleMTx9UIgqsymR9PKX-aRcvmEFWZOD2xh3iwAeRYQ&oe=69B161DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street Raiders simulator DEMO_2560x1440.png", "id": "578817307958844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820202_578817311292177_7727960620223750763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcM4XQgta4EQ7kNvwErT3AB&_nc_oc=Adn2oD4Wja-D2IZgq4cPJ_JSs39TeI-4pKlYdji8PPIvHawlcvWbQMW_Z_6Pstfj5FI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpDn_5i6DFaxEpMWVwy-xyalFmiE-td7dQrIACNHRgNg&oe=69B14D06"}, "display_name": "Street Raiders Simulator DEMO", "keywords": [], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\nExperience the city in full VR immersion. Feel the thrill of high-speed driving, intense action sequences, and the satisfaction of building your enterprise. Immerse yourself in the detailed urban environment and feel truly present.\n\n**Features:**\n- Immersive VR City Environment\n- Build and Manage Your Street-Level Operation\n- Intense VR Action and Encounters\n- Upgrade Your Safehouses and Lifestyle\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393847820205629"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1382255216530819"}]}, "baseline_offer": {"id": "1382255216530819"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745901420, "status": "PUBLISHED", "id": "1382255216530819"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25259375120319557", "version": "0.0.4"}, "id": "1189693752829342", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppB
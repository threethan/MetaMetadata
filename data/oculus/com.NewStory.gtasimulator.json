}, {"file_name": "screenshot2.png", "id": "1347659076450766", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820511_1347659079784099_6934733937658321315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL-vUCFoGUgQ7kNvwF_HARw&_nc_oc=Adr8P78WNVZzrR2O2_D65lrKxVJR5dvq_CdfpT9fa1GkefJz0k60owTnGJ4bbvYjeNc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4d79H7aePnkpKnzJCnMKpuIVq9dm5TdhJDjRNUzaHTg&oe=6AA94EEC"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5djk1JKy6wQ7kNvwE-6OLk&_nc_oc=AdpaUMWG4eC5mujfqEwnpbFHjnN6KXi3MzDWIroqmjIAhptaW2T9M1OXhSetlQzxZZk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF3ezzjNhM_lptyhfVBhzdY6y8onn-ud3b4j6Trb40aQ&oe=6AA95907"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyde9Gq2cREQ7kNvwGHnKeE&_nc_oc=AdpsxvPbSiJW1MVn3VwHSbOJvQOMMywrMdWVVuBEZOaPzi0EAt8-4_-l8tZhYh4LQeM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkt7eZm9DrrVyGaR174IDcxQYGOkhr7JYxDLoUByhfzQ&oe=6AA93BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street1.png", "id": "1248056184413972", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499620666_1248056187747305_1140808395238685403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtZ_9i0xP90Q7kNvwEP_AWm&_nc_oc=AdolzPqBx-aZacvj_kPaOHgMYtppeQKk-S3bYKFD90QlDZFRi9tQ0NBMRXgG6MFknAI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXlYm9g2tZOPNwe76sSWG9qATRcyBJrgxLPQsdiZFneA&oe=6AA9504B"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_t
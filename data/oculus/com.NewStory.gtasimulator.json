e_name": "screenshot2.png", "id": "1347659076450766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820511_1347659079784099_6934733937658321315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL-vUCFoGUgQ7kNvwEyzEp6&_nc_oc=AdrVheybWqFU8hOuHsktda8dk3e4o_h0NhZbmbnPz4rZ_Lbzr5aq_PDwdsyF7soPdi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ31Qxt9kEwC3dKjikmE-7vDtIea_pnUPGtS86GT9zIg&oe=6AABF1EC"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7inmPn5-7BkQ7kNvwF4Umu1&_nc_oc=Adog6MSVAxtBTu59Nj704m9dAkv95FOMc2Fj842YZYjdOmuHZO7Man8LIxVo01ssdxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEZ21PaG1K110bcc4fD9ZkNiulcW_MKvArZ1G-r2VbTQ&oe=6AABFC07"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I6JV45CaP8Q7kNvwESYGnV&_nc_oc=AdoYKnQJDOrDxhZZGRDzzrPnIWJc85dyl5owYKtKgcV1tHmLpYf-zLIbH3Lu1HQ5bVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl-Wxqr3No6jR2h15yvACFJJ_UYq-2pvQd3xGmNGiL6g&oe=6AABDEDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street1.png", "id": "1248056184413972", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1248056187747305_1140808395238685403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtZ_9i0xP90Q7kNvwH3ODkH&_nc_oc=AdpIz66OaEIIgmDeCQcZO3csWct3VPh9REz-YhDTAkWRSKjeuSfmWMbkXgV-fcNw3Zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU3xWvRHCMX4y-bpMx4rSve2wTtLmsEFBjvR1aBKiPcg&oe=6AABF34B"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT
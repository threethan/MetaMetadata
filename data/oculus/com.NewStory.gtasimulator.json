ame": "screenshot2.png", "id": "1347659076450766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820511_1347659079784099_6934733937658321315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVJFgNG03e0Q7kNvwE2qYoa&_nc_oc=Adrc64c1bnJe8XLhQVCjXT9i6bfcPJh-cI8HnhRTeEfr3efgNHcz8-wnFaHB_H-Yuyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtkfR_EpT0o8jViyeDyXsWLwuHiGFgXKsXJLH7KS8g3g&oe=6AEDDCEC"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3qvA1SO38wQ7kNvwHLlP3l&_nc_oc=AdqdHpOwStRkh-BGN2XUfSJb0-hyoFCHf2gWVtqxm35KvOKUOm0BJtpmOSUZJ3xI800&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFI2o6r5bQ4VB9hjJRGW8AqhZ1l_I1vNg2jBMveZrgZg&oe=6AEDE707"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi116yoJ9OUQ7kNvwGHRRc3&_nc_oc=Adpp5vRzQ_6WXdVZ0P5-IRmo_qeAcl20HZ_UiHxhqJvdG1gnQJQ2LlylVs1BTdYJ5gQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwoencXWZwJHiIVD3LdprQ_jDsm8YIf9urCx4sqAuiMQ&oe=6AEE021D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V4.png", "id": "1082532311184966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593845024_1082532314518299_5034202910019754477_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XeKct7Wxd4Q7kNvwH_lCzu&_nc_oc=AdprjMrD_5JoLNy45AH0ezPaUHXrHGy63v_h-1IRudE-ZZCEe1IObKeuBVSDQK9_xqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo0d5RVNRGVsLDU5_R-IjTOELbiAE1i29OASHqSA008w&oe=6AEE02B8"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRE
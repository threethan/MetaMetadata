aqnaANqG1ffu_2MRpHI0byitPF407nI_GTDA&oe=6A09D387"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvxJ3Q8yw0EQ7kNvwFUe5R3&_nc_oc=AdrD6vv7S4a652gHewJX80ig4gKo_JlSlI9X0EcZF3QLChGHnyRr4LqgffMqz3p_XkM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V2_KwraSl6xoCCSRu48k5som1YRSnPzNaHPg6jynMzw&oe=6A09B65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street Raiders simulator DEMO_2560x1440.png", "id": "578817307958844", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820202_578817311292177_7727960620223750763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZHfnGkL5doQ7kNvwGtg-ni&_nc_oc=AdrInzh5mBfusCYlwlSD1oI974lWAJTt1sZtmWD_pyaU2hFtyy3YhUCihwT5QIot7go&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53pACQPxpcD7H8vkZg_V2XVP5CTMfPkcINeS6YadMYgQ&oe=6A09D9C6"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25264971413093261"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820074_1214025613255629_2081772838733151187_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3sjr3M8efgQ7kNvwFi2HnE&_nc_oc=Adp1n1VvZBA3xG0KUGci3XQ0_zDx0a-uVqqu4Z7QcuCoueR9ubOJuiyUQe_g2I9qLV8
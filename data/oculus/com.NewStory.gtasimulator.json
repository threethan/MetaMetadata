izKtRXa7ZATfnLbKNGKtmvdof4fhtEl9_NhpyA&oe=6A79C96B"}, {"file_name": "screenshot2.png", "id": "1347659076450766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820511_1347659079784099_6934733937658321315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoY3OgRtwIEQ7kNvwGfFA38&_nc_oc=AdqXCmBF_3tLFjgX-sS4hJ6nIFjr3drYrLEhMgSj4oF2tmjsvjQ_8ff4nrGkg9-mzIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAG30sSBQuifxpAi2eAugE6M4gzCyNRgarxt6rLy2Ndw&oe=6A79D8EC"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQAuHbyqkbQQ7kNvwG42uj7&_nc_oc=AdqgDORJrKyK8xm23KTSEMqq-mgV9OVuTaHkl0LekNz8JuprXNoj_0xrsi3AbEKSNgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt89WOMNmeWd84A8du0WJFWKCg2yX2bbHV7_Fm1skiKg&oe=6A79E307"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GhjNzVNpm4Q7kNvwE2O4aS&_nc_oc=AdryWS7MWHF5Kl5mjKtTt6Llb2rG4CFzpxR9cI4a9zSd1UEUMAweSnwWmV8gwTedEHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr2I_TdrGfueiC1hIdNZmQXx2X3TtxG-UUMOIpY_oQMQ&oe=6A79C5DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street Raiders simulator DEMO_2560x1440.png", "id": "578817307958844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820202_578817311292177_7727960620223750763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSdDXSQxHawQ7kNvwFgG-CO&_nc_oc=Adqwqoy8hXRLzO0vMTKzdv78mk-jYUR-cxKvRxTuk8LJkBCtrjL6ZuFpU8E1BrDFOCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFda8eDyeoxgq1XQ43ZlCeXx0deCSkwlxFlYrrK7U11OA&oe=6A79B106"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {
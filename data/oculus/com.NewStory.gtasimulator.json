ame": "screenshot2.png", "id": "1347659076450766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820511_1347659079784099_6934733937658321315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuQ6JmurIc0Q7kNvwF9_wPK&_nc_oc=Adp4l80no0x2oRNwMw_GqhDt6mWMqSTkQCzqQvlABJG8Fkmzux0XHuKN8C6MueomIwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJS8S5KyU4r68jZ3-hgJRHPWWebAnfz9rrf-B_Q6MMmw&oe=6ABA726C"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekEHKBx9JJQQ7kNvwGi3wtq&_nc_oc=Adrt3AT2DI_lUOa_kCdKF_jchOAFy0NDqzbG7qXmWMjk1-n-vvPnM_naIxjso2m3e8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO4Dk-v6-naJejwhI9SUepnEEBcL880k5XVvfE1wkiwQ&oe=6ABA7C87"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9_d5MnIHfsQ7kNvwH_1hTb&_nc_oc=Adof0CoPxBb9I1UVQcyVNlVyt_PE1sS5wmIbNC4OSVhWw_3yFymw2HQq_7dBMuuz89w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN4sOd-fSExNqqeqPXiH01XFlDPfGDdF7mn7NriQe1IA&oe=6ABA5F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V4.png", "id": "1082532311184966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593845024_1082532314518299_5034202910019754477_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyOIvWpG8DMQ7kNvwElQ18D&_nc_oc=AdpY_nKkmdShyCv2J6Fik3YhvUrlQIcawiqKEz4IWMKeBLzWtvSOGMHZW-kDYDy1iXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5nCfkZHFfLkTacR4SbjqgDJ_EiJQqcgsKpEY8EjmtBA&oe=6ABA5FF8"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRE
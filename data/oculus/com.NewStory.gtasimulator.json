=6A47BFEC"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS4g3OIgsJcQ7kNvwFbVXoF&_nc_oc=AdoNBjgOIluxAY3Aql_onY3I2MiVB9dOKf54TXEFwDMrW6-58xhuynCEw3SPutlwgD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BQGwyGTBBxia_Qbuh4rBPfO-_SZh5sae7isY6Bnn0aw&oe=6A47CA07"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZB72ndbfXcQ7kNvwGtqn5i&_nc_oc=AdrlpF-cVUkSU8AOdx6EYgmcCOkBGlKbDHpjkN-qy-LAOO-8kSOWUu5Pr7i5vTYEvJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NohQP2SiivGx0MWlCM9vKexSNtN9qsSOieLSJV21Qmw&oe=6A47ACDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street Raiders simulator DEMO_2560x1440.png", "id": "578817307958844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820202_578817311292177_7727960620223750763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yepV9-dY64Q7kNvwESFl6H&_nc_oc=AdprzTDXpL_yzpIk_pr_rodmWIRxc5m5RSSopykNqVtkFNOJ3cEd3EGJNqNr-5kO0Bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I4y7ISLmAquyCCXSCWm_B1WVwiR1Unv1Wzmw7uVvfuA&oe=6A47D046"}, "display_name": "Street Raiders Simulator DEMO", "keywords": [], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\nExperience the city in full VR immersion. Feel the thrill of high-speed driving, intense action sequences, and the satisfaction of building your enterprise. Immerse yourself in the detailed urban environment and feel truly present.\n\n**Features:**\n- Immersive VR City Environment\n- Build and Manage Your Street-Level Operation\n- Intense VR Action and Encounters\n- Upgrade Your Safehouses and Lifestyle\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393847820205629"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1382255216530819"}]}, "baseline_offer": {"
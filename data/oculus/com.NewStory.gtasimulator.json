e_name": "screenshot2.png", "id": "1347659076450766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820511_1347659079784099_6934733937658321315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioccTXPK1ugQ7kNvwGh4CK7&_nc_oc=Adr5RwL-J77C42i9KjReIAOi_gBYrYjhgsmAvXP471vqmmVaLPMqqXSF7ZQ8QlHkDR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcIOYjQNhDQn7H8lmjUaWVHHME-V_BzLveSNnCGVv95g&oe=6AA7FD6C"}, {"file_name": "screenshot4.png", "id": "694284529718957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820037_694284533052290_6997934587714940771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5djk1JKy6wQ7kNvwGax5-W&_nc_oc=AdrLki1uBrBcGex51wY5QoZEmBjzTbXX0TEhprcr7EpjMPU3GJ49_AZs-gMVZJtw6VU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg1MNSoJIdqFbhZmK6BKbxUo8vUeFFqOQi0LYuivGqNQ&oe=6AA80787"}, {"file_name": "screenshot1.png", "id": "1018299793186988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818915_1018299796520321_5931510015703660461_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyde9Gq2cREQ7kNvwHrvfdy&_nc_oc=AdriUc6mB8JVhfAnbJhC7L6dYqiu0bKwFX3nofoPYnF4w8EfHaEiOw465jmVAciEU38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY9OBGf2pnqR5pVtRxZoWVfImS_lbR_5nqeWE_22jStQ&oe=6AA7EA5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Street1.png", "id": "1248056184413972", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1248056187747305_1140808395238685403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfq3OfanhYIQ7kNvwEDI_Z9&_nc_oc=Adpfj8P6HrW5n3LmKmoGoRi0z_FfyB8MqsBZpE77cw4OYd6DtjamMGnFsfrHjd_pYrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5jUW1wttXLn3g028VXPN7gxq-MI_lXhPvh62jW3eOhQ&oe=6AA7FECB"}, "display_name": "Street Raiders Simulator DEMO", "keywords": ["Action", "Simulator", "Raiders"], "long_description": "Dive into gritty VR streets where cash is king! Street Raiders simulator DEMO drops you onto dangerous streets with pure ambition. Got the hustle to rise from zero to the top? Build your enterprise, live large, and make your mark in immersive VR!\n\n\n**================================================**\n\n\ud83c\udf3f\ud83d\udea8**Street Raiders is currently in earnest development. To deliver the best possible VR experience, we would be truly honored to receive your valuable feedback via Discord.**\n\n**Please suggest any features you'd like to see implemented directly there! We'll share continuous development progress and the latest news. Feel absolutely free to join our community!**\n\n**https://discord.gg/s448QJCTgU**\n\n**================================================**\n\nStart small, think big. Cultivate valuable herb and manage your street operation to earn cash. Expand ops, upgrade facilities, watch profits soar. Master deals in the risky world of street enterprise. The streets bring challenges: protect your operation and handle intense competition. Engage in fast-paced VR action encounters. Arm yourself with effective tools, upgrade gear, show your skills. Outsmart rivals and overcome challenges to reach the top!\n\nThat cash buys a lifestyle! Use your earnings to roll through streets in custom cars, get better safehouses, and wear the finest gear. Show off your success and live the high life.\n\n\n", "short_description": "Get ready to dive headfirst into the gritty VR streets where cash is king!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT
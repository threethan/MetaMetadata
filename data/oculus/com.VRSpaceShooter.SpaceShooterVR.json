.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnwagro_wk0jRXMF486lvRz4gj2doIBEvDgpRoDe6T0w&oe=6A8D7AE3"}, {"file_name": "MainMenu_Custom..._10.09.2024_05-21-09.png", "id": "3831649210488711", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982574_3831649217155377_201745631152051297_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H5j4-rB9Z0Q7kNvwGYVLVR&_nc_oc=AdqE3xJwYb8_BEArHtmxcvE2315g6AFZuI64Dauo7daSrFho2NGUKIJn96HMNifmKV8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGs8rifeYTP5Vya-wj_ys7NJ-UDVtDuKs0FKscCkjEWQ&oe=6A8D764A"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-18-07.png", "id": "429527983477201", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982574_429527990143867_6741772734893688567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5Z7FKUKoyYQ7kNvwFo_yXj&_nc_oc=Adpou83VzzLQg2J3G7309wmQfhhUnFUsJUZEgNKtGDzFHmjBhz-DqqbHeNZCCIfesDk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzJ-VOU_pyZ-kLQ8FQZT2A0in0AyUuJXFrWvP7lX330w&oe=6A8D6BD3"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-19-18.png", "id": "388370104096536", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001733_388370107429869_5435028206607268347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8X9r50KqooQ7kNvwEaFnwg&_nc_oc=Adr3WJ3DC5_MTum9de5U9FAgWrf6Y7XF-Ab6Nnkb5Oh43w59mdFgSDEm-YxNnpW5RDk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlRB_80-YsJjVVO3-79TJhfetxdi_qAKVVzMONq6V5VQ&oe=6A8D9203"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-19-41.png", "id": "1663108787867384", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974507_1663108791200717_9096010438077891718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-O4-om9pFsQ7kNvwHGHj8B&_nc_oc=AdqQxXJSUBMYDQuzXWBT7FjBa-GREEk9A4mdL9cN7iilNz8bhjSW76y0Z_Icz0i6FBU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoU7M_PXmIkIGuzh_o13bb87dQ_-FpLFRrH7cSH8D3zw&oe=6A8D95E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRSpaceShooter", "keywords": [], "long_description": "Space Shooter is an immersive VR action game that puts you in control of a spaceship on a mission to protect Earth from alien invaders. With high-quality 3D graphics and lively sound effects, the game offers a visually stunning and engaging experience. Navigate through challenging levels, destroy enemies, and dodge obstacles to advance.\n\nKey Features:\nHigh-Quality 3D Graphics: Enjoy advanced graphics technology for a stunning visual experience.\nDiverse Weapon System: Upgrade and choose from a variety of weapons to defeat your enemies.\nVaried Game Modes: Challenge yourself with multiple game modes ranging from easy to hard.\nOnline Leaderboards: Compete with friends and players worldwide to top the leaderboards.\nHighlights:\nEngaging Storyline: Join the battle against alien invaders to protect Earth.\nSmooth Gameplay: Optimized for a seamless experience across various devices.\nChallenges and Rewards: Face unique challenges at each level and earn attractive rewards.\nJoin the fight in Space Shooter and experience the thrill of defending Earth in this captivating VR adventure!", "short_description": "Space Shooter is an action-packed VR game where you pilot a spaceship to destroy enemies and avoid obstacles. Experience high-quality 3D graphics, diverse weapons, varied game modes, and online leaderboards. Join the battle to protect Earth from alien invaders in this thrilling space adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrspaceshooter", "developer_terms_of_service_url": null, "publisher_name": "VR Space Shooter", "support_website_url": null, "website_url": "https://docs.google.com/document/d/13cbiPAUWlbi86NP9azT7q-OsoBuMvl4X94gZPPw76KU/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
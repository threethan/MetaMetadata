.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLrTVfdRi16DphntceJAOYKyCFfyMXkfJ1iZjONd2TrA&oe=6A7DA8E3"}, {"file_name": "MainMenu_Custom..._10.09.2024_05-21-09.png", "id": "3831649210488711", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982574_3831649217155377_201745631152051297_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAIRBL7vtlcQ7kNvwGA54kN&_nc_oc=AdrHCJIGhLPcwKvcywZ8drrkkCOLroU-NOJ3mGRtsKQ3LOBiQFsKN2f7iWJ-K0QvgVA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjwHFOKtw3k_1PSk8b5ROW2lOntCABwe_tfPsQOOjmOg&oe=6A7DA44A"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-18-07.png", "id": "429527983477201", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982574_429527990143867_6741772734893688567_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyRvEnuJov4Q7kNvwHdrmmU&_nc_oc=AdrzRN1YHpLpTgziBooE_ANu7OH4JjQF2EzsBUVeS4TJFSxTGPPh6aFR8KX9t3TDRuE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHabXbrASDFIw-vGRBkzCi17JkIx_NxQu0plJsF3Y4jdw&oe=6A7D99D3"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-19-18.png", "id": "388370104096536", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001733_388370107429869_5435028206607268347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tavjb8tmjWsQ7kNvwE9F1Oy&_nc_oc=AdpA2FMqSw7U5OPKBswUUXuBtAnnThU0_oVpiENd8njRQqf10hxmZHm5wFBkt2rKMz4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAObF-mIDAFnUeI-0K77nr590sjHSPROKP8ByLjuc9uw&oe=6A7DC003"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-19-41.png", "id": "1663108787867384", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974507_1663108791200717_9096010438077891718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8uLoQCYZ1AQ7kNvwGbO-ed&_nc_oc=AdpNt5xs29zNg9uh1ADu5_CtSB2eHoIDdKSsVRnVFQt6CaepYEwURWS57fzfyoToV5o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVwU2cIXidsGoMI7qxn11t6ChBMYQDnw6DSC2TrJsE0A&oe=6A7DC3E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRSpaceShooter", "keywords": [], "long_description": "Space Shooter is an immersive VR action game that puts you in control of a spaceship on a mission to protect Earth from alien invaders. With high-quality 3D graphics and lively sound effects, the game offers a visually stunning and engaging experience. Navigate through challenging levels, destroy enemies, and dodge obstacles to advance.\n\nKey Features:\nHigh-Quality 3D Graphics: Enjoy advanced graphics technology for a stunning visual experience.\nDiverse Weapon System: Upgrade and choose from a variety of weapons to defeat your enemies.\nVaried Game Modes: Challenge yourself with multiple game modes ranging from easy to hard.\nOnline Leaderboards: Compete with friends and players worldwide to top the leaderboards.\nHighlights:\nEngaging Storyline: Join the battle against alien invaders to protect Earth.\nSmooth Gameplay: Optimized for a seamless experience across various devices.\nChallenges and Rewards: Face unique challenges at each level and earn attractive rewards.\nJoin the fight in Space Shooter and experience the thrill of defending Earth in this captivating VR adventure!", "short_description": "Space Shooter is an action-packed VR game where you pilot a spaceship to destroy enemies and avoid obstacles. Experience high-quality 3D graphics, diverse weapons, varied game modes, and online leaderboards. Join the battle to protect Earth from alien invaders in this thrilling space adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrspaceshooter", "developer_terms_of_service_url": null, "publisher_name": "VR Space Shooter", "support_website_url": null, "website_url": "https://docs.google.com/document/d/13cbiPAUWlbi86NP9azT7q-OsoBuMvl4X94gZPPw76KU/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
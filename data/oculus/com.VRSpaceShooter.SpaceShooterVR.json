isplay_name": "VRSpaceShooter", "keywords": [], "long_description": "Space Shooter is an immersive VR action game that puts you in control of a spaceship on a mission to protect Earth from alien invaders. With high-quality 3D graphics and lively sound effects, the game offers a visually stunning and engaging experience. Navigate through challenging levels, destroy enemies, and dodge obstacles to advance.\n\nKey Features:\nHigh-Quality 3D Graphics: Enjoy advanced graphics technology for a stunning visual experience.\nDiverse Weapon System: Upgrade and choose from a variety of weapons to defeat your enemies.\nVaried Game Modes: Challenge yourself with multiple game modes ranging from easy to hard.\nOnline Leaderboards: Compete with friends and players worldwide to top the leaderboards.\nHighlights:\nEngaging Storyline: Join the battle against alien invaders to protect Earth.\nSmooth Gameplay: Optimized for a seamless experience across various devices.\nChallenges and Rewards: Face unique challenges at each level and earn attractive rewards.\nJoin the fight in Space Shooter and experience the thrill of defending Earth in this captivating VR adventure!", "short_description": "Space Shooter is an action-packed VR game where you pilot a spaceship to destroy enemies and avoid obstacles. Experience high-quality 3D graphics, diverse weapons, varied game modes, and online leaderboards. Join the battle to protect Earth from alien invaders in this thrilling space adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrspaceshooter", "developer_terms_of_service_url": null, "publisher_name": "VR Space Shooter", "support_website_url": null, "website_url": "https://docs.google.com/document/d/13cbiPAUWlbi86NP9azT7q-OsoBuMvl4X94gZPPw76KU/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
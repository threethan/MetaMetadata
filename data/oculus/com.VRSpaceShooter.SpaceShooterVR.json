f&oh=00_AQQea_xRE_EuR2he_aO-CIx9PYb3WX_9rgIESzG9YFS4RA&oe=6AFC8843"}, {"file_name": "Space_Shooter_GamePlay_Custom..._10.09.2024_05-19-41.png", "id": "1663108787867384", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974507_1663108791200717_9096010438077891718_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw1IElttaOMQ7kNvwG0pQp9&_nc_oc=Ado4O4d43L5o_eB91yBS3GevRaHLLiGgkaR4xQDJj2AAM6z1gk7PlCV0CgvNzRv2o6U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT02A1Xl4aVk7nWJnoKn2aEGxrcZ6QWpEH3R2ER1KZ6tQ&oe=6AFC8C22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRSpaceShooter", "keywords": [], "long_description": "Space Shooter is an immersive VR action game that puts you in control of a spaceship on a mission to protect Earth from alien invaders. With high-quality 3D graphics and lively sound effects, the game offers a visually stunning and engaging experience. Navigate through challenging levels, destroy enemies, and dodge obstacles to advance.\n\nKey Features:\nHigh-Quality 3D Graphics: Enjoy advanced graphics technology for a stunning visual experience.\nDiverse Weapon System: Upgrade and choose from a variety of weapons to defeat your enemies.\nVaried Game Modes: Challenge yourself with multiple game modes ranging from easy to hard.\nOnline Leaderboards: Compete with friends and players worldwide to top the leaderboards.\nHighlights:\nEngaging Storyline: Join the battle against alien invaders to protect Earth.\nSmooth Gameplay: Optimized for a seamless experience across various devices.\nChallenges and Rewards: Face unique challenges at each level and earn attractive rewards.\nJoin the fight in Space Shooter and experience the thrill of defending Earth in this captivating VR adventure!", "short_description": "Space Shooter is an action-packed VR game where you pilot a spaceship to destroy enemies and avoid obstacles. Experience high-quality 3D graphics, diverse weapons, varied game modes, and online leaderboards. Join the battle to protect Earth from alien invaders in this thrilling space adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrspaceshooter", "developer_terms_of_service_url": null, "publisher_name": "VR Space Shooter", "support_website_url": null, "website_url": "https://docs.google.com/document/d/13cbiPAUWlbi86NP9azT7q-OsoBuMvl4X94gZPPw76KU/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27111931881731528"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1055040456025688"}]}, "baseline_offer": {"id": "1055040456025688"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726296960, "status": "PUBLISHED", "id": "1055040456025688"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27131794066411976", "version": "0.1.6"}, "id": "837533218468596", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27086544837603566", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27131794066411976"}, "release_status": "RELEASE
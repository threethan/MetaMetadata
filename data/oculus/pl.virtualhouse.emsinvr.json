/t64.5771-25/75507164_1259938094943900_8272243446161919516_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCcknTurADwQ7kNvwHUngf4&_nc_oc=AdrPmesWQFPBG7niGXVAZPa_U9IIPkongdEXsnuDSBi-49ss6m78rPOkuukfSaMRbKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jj7H-UZoxGxMirPVKhcLdnwDZZ8mXYUBBIAVScGWDlg&oe=69F8A7FF"}, {"file_name": "western_single_exercise.png", "id": "521983190095642", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367594_521983193428975_208393683604116557_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zAZBMSK6DwQ7kNvwGbfTZa&_nc_oc=AdqrCnuSIFJnjtQnh8K_CvMivs0ejQOCnyZbWyx18JUoDIe94muOCaDeJmJAI1__Ssg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1K1jOh-xhNVNGetgp6sXj7Vpzoo9spMhQ8lGRYcG8yqA&oe=69F8C176"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BraceUp VR", "keywords": ["Fitness", "Duel", "PvP", "Fun", "Exercise"], "long_description": "BraceUp VR is the ultimate Play & Train game combining arcade fun with home fitness! Compete with friends in break activities and get your heart pumping.\n\nMaster Break Modes\nJump into four action-packed mini-games: hit targets in Archery, throw Snowballs, deflect Shurikens with a Katana, or aim true with a Revolver. Each mode brings a fresh twist to your workout!\n\nBoost with Exercises\nGain an edge by performing real-world moves: Splashing Water, Running, Jumping Jacks, Boxing, Squat Jumps, and Wide Squats. Better performance gives you an upper hand in-game.\n\nExplore Immersive Worlds\nTrain in the Castle, chill on the Island, focus in the Dojo, or duel in the Western. Each has unique visuals and obstacles.\n\nOnline PvP Madness\nBattle friends and global players in thrilling multiplayer duels. Will you reach the top?\n\nSolo Adventure Mode\nNo internet? No problem. Conquer challenges and prove you're the hero in offline play.\n\nCustomize Your Challenge\nChoose Easy, Medium, Hard, or Hero mode. Set your own intensity with adjustable reps and time.\n\nKey Features:\n\u2022 4 Worlds: Castle, Island, Dojo, Western\n\u2022 4 Break Modes: Archery, Snowballs, Katana, Revolver\n\u2022 6 Exercises: Full-body movements\n\u2022 Custom Difficulty\n\u2022 Cross-platform: Steam & Meta Quest", "short_description": "BraceUp VR is a ultimate Play & Train game! Engage in thrilling break activities fused with home fitness. Master modes, boost stamina, conquer environments and dominate in multiplayer duels to become a Hero!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.vhsoft.io/privacy-policy-braceup-vr/", "developer_terms_of_service_url": null, "publisher_name": "Virtual House", "support_website_url": null, "website_url": "https://blog.vhsoft.io/braceup-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1118925045585508"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "707575525584384"}]}, "baseline_offer": {"id": "707575525584384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750949280, "status": "PUBLISHED", "id": "707575525584384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24338355442437246", "version": "0e2cd953b92bad3268c04f2ecacd42ac390a10d7"}, "id": "4006859
cQ7kNvwE9TG4R&_nc_oc=Adp24nu7FRNHeY5Qdt-WJ5TjhGWMTWtAa4QpWCxwnfSfZ-tO5EZZXlYgUWnitiQF-QE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpNDVHRRdF0Z5O3PRN6g1uR1Bt_nuT0pv193iRifExZw&oe=6AFB2E0F"}, {"file_name": "Screenshot6.png", "id": "439311521207171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570299_439311524540504_2923130480112330182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyY0qU91e6IQ7kNvwFgtnbS&_nc_oc=AdpIOATIltSl4UfDKL9bbdGTiUdfQukU2AjqZ3bIWU29dLO9bWNffhZNHgDoF5on_2w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbTFKMcAePIP33QAHYgF_YHexEdJEYoe3tKOTswdWrvg&oe=6AFB2AE5"}, {"file_name": "Screenshot5.png", "id": "1106512179889108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75314851_1106512183222441_8736178581101901246_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JThCHi8kgCAQ7kNvwHT1WQr&_nc_oc=Adr0vkXE3yKvUhHuU_maUePJcNl4uI3DyWo694UfZOt_BeFeySxEPQdWHHKYNVYcsnI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpoerBXbL9EMBKQD1QfW49x2UFk2U3xrahPeLQyR-1AA&oe=6AFB43A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "998185164436897", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974854_998185167770230_7947512444184852752_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTCdVrmCb5wQ7kNvwFX7ON3&_nc_oc=AdqSPQu2GcALU18lQt9qS8KxxT7xwJ9zd0aWsmp4yRGUaVoWN9mb_mgW4GwT4ultM9Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8D04K7Z6PTDln-RIMQEuOKDNbKDITBDEe8yKfH4d7WQ&oe=6AFB4AAE"}, "display_name": "Paint To Pixel", "keywords": [], "long_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art, travel to 5 different galleries that cover themes from the roots of graffiti in 1970s New York, to the explosion of Street Art in popular culture and urban festivals. Hear interviews about the illegal art of train graffiti and learn the lengths that the legal system will go to deter graffiti writers.\n\nVisit each gallery to unlock all the artwork at Graff Central Station!\n\nPaint to Pixel allows marginalised artists to share their own story. It is one that crosses seamlessly between large scale public artworks and the illegal roots of the culture.\n\nBecause of the nature of their work many artists have chosen not to be named, but each has made a valuable contribution to this exhibition and the wider street art scene. ", "short_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art by UK artists, travel to 5 different galleries that cover themes including the roots of New York graffiti, the illegal art of train writing and the explosion of Street Art in popular culture and urban festivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mbd.limited/policies", "developer_terms_of_service_url": null, "publisher_name": "MBD Limited", "support_website_url": null, "website_url": "https://www.mbd.limited/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
UQ7kNvwEOZcXU&_nc_oc=AdplYMJUA3Ha1FotCvU4bnsPwXYnlivXj_tjWIB0go1U9ta_VMP56RTfy8cVRC_VOKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2wsDuxiMkv48mTh7NjWt9l1lXARJSxRi8o2W3tyiHnA&oe=6B0EF48F"}, {"file_name": "Screenshot6.png", "id": "439311521207171", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_439311524540504_2923130480112330182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bdX_BxKEsAQ7kNvwHYobhl&_nc_oc=AdpqZo07V2C30-2xwFzcWY8GbbSqAHaF_WPEGEaZeXLVR-mPyoLmBs4tkGWIIb_eXKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmbX4l4TKYfxnonKyyz6SMsSeTCWimLlGz5my8OsVrMQ&oe=6B0EF165"}, {"file_name": "Screenshot5.png", "id": "1106512179889108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314851_1106512183222441_8736178581101901246_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4QeGTkMn18Q7kNvwHldxnD&_nc_oc=AdpNgTgApvsPgVBqAYEvT2QPfbf96fAGCO5UeDEr4VwM-EFnCiU7ZfZvGUQajttVrUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDVVlqirdrk80L_6a8GMvSVgCD-Dm6mp-xTadN0p3hpg&oe=6B0F0A20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "998185164436897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_998185167770230_7947512444184852752_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7oD249Gt3kQ7kNvwEfbWJs&_nc_oc=AdqFlO1twrsIk9jJU1cYd1Y5_BkB6LPn5LdbMJwfey477hSUQWfBOEaUPtYtPqbnITs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoydjsVmGrMzAM7CvurYlKRvNo3bB8AGILctRQ5TNxRw&oe=6B0F112E"}, "display_name": "Paint To Pixel", "keywords": [], "long_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art, travel to 5 different galleries that cover themes from the roots of graffiti in 1970s New York, to the explosion of Street Art in popular culture and urban festivals. Hear interviews about the illegal art of train graffiti and learn the lengths that the legal system will go to deter graffiti writers.\n\nVisit each gallery to unlock all the artwork at Graff Central Station!\n\nPaint to Pixel allows marginalised artists to share their own story. It is one that crosses seamlessly between large scale public artworks and the illegal roots of the culture.\n\nBecause of the nature of their work many artists have chosen not to be named, but each has made a valuable contribution to this exhibition and the wider street art scene. ", "short_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art by UK artists, travel to 5 different galleries that cover themes including the roots of New York graffiti, the illegal art of train writing and the explosion of Street Art in popular culture and urban festivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mbd.limited/policies", "developer_terms_of_service_url": null, "publisher_name": "MBD Limited", "support_website_url": null, "website_url": "https://www.mbd.limited/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
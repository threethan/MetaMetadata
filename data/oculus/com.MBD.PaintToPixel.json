oQ7kNvwHD9IYK&_nc_oc=AdrvTABEQvBlj-FEgTP_CF2IKNfHkTAukwI1dhC8G2aQGtO9EB3AHaFmBITAgR7N4o4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqnmu91J6QtWerAkPzet7F19X8cCZIT8zmwpmn292hvA&oe=6B01C58F"}, {"file_name": "Screenshot6.png", "id": "439311521207171", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_439311524540504_2923130480112330182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnCI60OxMLQQ7kNvwHW8MiT&_nc_oc=AdpzBulqY0Tz1vqxqkYyXw_prq0CeY37KEd0n6CnkwYI3JXLmqX1LsjAumk3Q-I_U-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPuPTlMD919lpie2CKsar1kwJohqgjlcH1YSMt5H_C9g&oe=6B01C265"}, {"file_name": "Screenshot5.png", "id": "1106512179889108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314851_1106512183222441_8736178581101901246_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b48Hji3dosQ7kNvwGp-VRE&_nc_oc=Adp-Po3CrmGUmnzbXxci8R0llXd0y6T5PGnFmkGqAa7RkCuASbrVDfMNaQR8UVTbV4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9zZtlJglqydBz94DBM7eTwl6luMQvku8zk5rvXn3uWA&oe=6B01DB20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "998185164436897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_998185167770230_7947512444184852752_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_rnF8wU_McQ7kNvwFIEX3O&_nc_oc=AdpTJcvkNGy-xOYbqmpJDcJJyJNQMlJC59DqurQivpEVd0jFth_369AUnwIkjfQ7MnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlRMkWrb_RXNMQP6Mi7Sp4hSFwAUXemGJDdMSKavvNxQ&oe=6B01E22E"}, "display_name": "Paint To Pixel", "keywords": [], "long_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art, travel to 5 different galleries that cover themes from the roots of graffiti in 1970s New York, to the explosion of Street Art in popular culture and urban festivals. Hear interviews about the illegal art of train graffiti and learn the lengths that the legal system will go to deter graffiti writers.\n\nVisit each gallery to unlock all the artwork at Graff Central Station!\n\nPaint to Pixel allows marginalised artists to share their own story. It is one that crosses seamlessly between large scale public artworks and the illegal roots of the culture.\n\nBecause of the nature of their work many artists have chosen not to be named, but each has made a valuable contribution to this exhibition and the wider street art scene. ", "short_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art by UK artists, travel to 5 different galleries that cover themes including the roots of New York graffiti, the illegal art of train writing and the explosion of Street Art in popular culture and urban festivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mbd.limited/policies", "developer_terms_of_service_url": null, "publisher_name": "MBD Limited", "support_website_url": null, "website_url": "https://www.mbd.limited/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
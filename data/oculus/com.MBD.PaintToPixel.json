oQ7kNvwEDHEDS&_nc_oc=AdoKab153m9ZYyTi36vheOt2aEz_Cdd1cAaT2n446p_yEYMVrrFk3y8NnA4dfKPtcgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtLizgXjUzszGu5gbT23RqIE6h0aDyX40vQKgH8pQjKA&oe=6B00740F"}, {"file_name": "Screenshot6.png", "id": "439311521207171", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_439311524540504_2923130480112330182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU09a6tiXOUQ7kNvwFz7HHk&_nc_oc=AdpigvJf1VOWFbLfP1tOzXc0S3uKqSZQJA9ifH5GbxbyCYAM2zVml4LSZ4HbRB6ncAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8z4ma9oPoJZmS1J77HXMuRj73Hn1tB3vj9oyNCxRFTw&oe=6B0070E5"}, {"file_name": "Screenshot5.png", "id": "1106512179889108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314851_1106512183222441_8736178581101901246_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b48Hji3dosQ7kNvwGJU2hR&_nc_oc=AdqmWj6fXqnE6jinGQ2Yt552xpD5uO6Bm2cTimIvbB_BTFJueyaB3uMvBDrz6RkfWJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqdeS8E6d-jny_nLn_W7LR_tPm5WE-yArcvXD49X9ezA&oe=6B0089A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "998185164436897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_998185167770230_7947512444184852752_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_rnF8wU_McQ7kNvwHDpuwC&_nc_oc=AdpmohpOZEA14o51D2K6zpGaXADsbXIeGecxA3DpTFEUjq7h3QZMtAp4cTR7DiZmymg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDKEH5WQuVp2P6zNpcbnwuTI6k_Wj68J9MG7VaYk59rw&oe=6B00586E"}, "display_name": "Paint To Pixel", "keywords": [], "long_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art, travel to 5 different galleries that cover themes from the roots of graffiti in 1970s New York, to the explosion of Street Art in popular culture and urban festivals. Hear interviews about the illegal art of train graffiti and learn the lengths that the legal system will go to deter graffiti writers.\n\nVisit each gallery to unlock all the artwork at Graff Central Station!\n\nPaint to Pixel allows marginalised artists to share their own story. It is one that crosses seamlessly between large scale public artworks and the illegal roots of the culture.\n\nBecause of the nature of their work many artists have chosen not to be named, but each has made a valuable contribution to this exhibition and the wider street art scene. ", "short_description": "Paint To Pixel is a Virtual Reality exhibition that charts the history of UK graffiti. It features interviews with prominent UK artists and personal photo archives that cover 6 decades of graffiti writing. Trains from Graff Central station, covered in original whole-car art by UK artists, travel to 5 different galleries that cover themes including the roots of New York graffiti, the illegal art of train writing and the explosion of Street Art in popular culture and urban festivals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mbd.limited/policies", "developer_terms_of_service_url": null, "publisher_name": "MBD Limited", "support_website_url": null, "website_url": "https://www.mbd.limited/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
igrated_image.png", "id": "523223165058045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602290_411461529217586_3404579416867602432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIVv5URhLNMQ7kNvwGrlqOc&_nc_oc=AdnD3mHHtLbEj6taZeD8yrPC-7SxVgJTqdsSKsE-iyq9lrxebyxfelfyTsUbEoWpRjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBkyFKcs9eobDbR0pqnx7JHD4pChoUFOZAM2HBy1unug&oe=69A0530B"}, {"file_name": "migrated_image.png", "id": "209657676927209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162771_155781144947442_6179205208652906496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSB-KvF-gFcQ7kNvwF_bPS_&_nc_oc=Adl16SXWPazCpbmbleiC3aFlHlf4z5XUGFtkUuQJ-w9iFGmVYfHqeHU1aXjX7_wzaUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftItyeeIwSDK-aLlxihbQyDGlQib8ZV3DszfriS1zj-3Q&oe=69A03255"}, {"file_name": "migrated_image.png", "id": "501349350554705", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482393_1658717311102609_5630930827769544704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD0TvewIyVIQ7kNvwE1x5V_&_nc_oc=Adml_mGx9keBnRoKV5G-vII-Ozkf2o9BsQdTZslLnCmdwwno-Tlx1O4sVtwO0dvReD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGYGPhjEzx_bjhsT6tXM-pxL5jj2kYVsnlAoXJO4hjBA&oe=69A02BF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Night Sky", "keywords": ["Night", "Sky", "Star", "Casual", "Controller"], "long_description": "You are invited to relax on the edge of a peaceful vale, beside a crackling campfire, and beneath the open night sky. Using the new Gear VR controller's simple point and touch controls, connect the constellations above to form patterns among the stars. As the different shapes are revealed, strange and wonderful creatures are brought to life. Watch and enjoy as your new discoveries stride, bound or glide around the hillside in an immersive and charming spectacle.", "short_description": "Relax beneath the open sky and connect the constellations above using simple point and touch controls. With each new pattern discovered, a charming and wonderful creature is brought to life."}]}, "developer_name": null, "developer_privacy_policy_url": "http://coatsink.com/", "developer_terms_of_service_url": "http://coatsink.com/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "647445316379790"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "408759706170906"}, {"status": "PUBLISHED", "id": "141048246516968"}]}, "baseline_offer": {"id": "141048246516968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1492101000, "status": "PUBLISHED", "id": "408759706170906"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1922204664462282", "version": "1.57"}, "id": "1900837490161821", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1613977911951627", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1922204664462282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1511434311, "id": "192300
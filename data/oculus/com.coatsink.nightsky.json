["Night", "Sky", "Star", "Casual", "Controller"], "long_description": "You are invited to relax on the edge of a peaceful vale, beside a crackling campfire, and beneath the open night sky. Using the new Gear VR controller's simple point and touch controls, connect the constellations above to form patterns among the stars. As the different shapes are revealed, strange and wonderful creatures are brought to life. Watch and enjoy as your new discoveries stride, bound or glide around the hillside in an immersive and charming spectacle.", "short_description": "Relax beneath the open sky and connect the constellations above using simple point and touch controls. With each new pattern discovered, a charming and wonderful creature is brought to life."}]}, "developer_name": null, "developer_privacy_policy_url": "http://coatsink.com/", "developer_terms_of_service_url": "http://coatsink.com/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "647445316379790"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "408759706170906"}, {"status": "PUBLISHED", "id": "141048246516968"}]}, "baseline_offer": {"id": "141048246516968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1492101000, "status": "PUBLISHED", "id": "408759706170906"}]}, "liveChannel": {"nodes": [{"latest_suppor
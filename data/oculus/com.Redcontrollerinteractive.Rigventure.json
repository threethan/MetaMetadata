-controllers.png", "id": "1421205653015124", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1421205656348457_4985975902291167239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKOtpxqtSP0Q7kNvwGQqLme&_nc_oc=Adrgi2cvEw2sB8w97PtS0rPUuVeAE0gN7Kka1N7qytuxw8X5zmrnEVcKA0pKUaylO3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDCLB_HGIvMdpKZ1ZaUuvi1SF2zmoCCqaJcVCxTijeIA&oe=6AFC7D8F"}, {"file_name": "02-tracked-offroad.png", "id": "1142019598780697", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1142019602114030_132432268089035918_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY7p5YyETR0Q7kNvwGD8W5N&_nc_oc=AdpsHrFSExw_qAj6cS3XMAdFlMqShaAuZbDB4ddGQTZVGSus6LLLutxerrGlnd2qFK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGhd6ZGZpyHVPA_ZAX9XOlgK3JD4aaMXqhF6H05rw0LA&oe=6AFC8218"}, {"file_name": "01-crane-campaign-lift.png", "id": "1429400966041772", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620414_1429400969375105_5998360566465311921_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTNsNBIKGzoQ7kNvwHOlRX9&_nc_oc=AdoFb0yIY6wV_jwJfYtmBYS_6cuMF49KdoZrvojX1jxrIv8B5F9suIv7GZyihGFmRKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZITsQcFi6cU1n3jzn6rd24PZV5slgYHnaR75Ms6zeHQ&oe=6AFC8B1A"}, {"file_name": "04-plane-airfield.png", "id": "1091194347040268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620559_1091194353706934_5153979128037522304_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvWHgnV1f34Q7kNvwErI5ya&_nc_oc=Adpa758m_JYJq-GoSkoUgcaYRvWPc3NF6RJdULXS-VQt9n6KI03I-oGdguoQh6md1c8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVec5iZnI4KNZrrbYsTwVhxe5Y-ux-JXUhPaNkIvmR9A&oe=6AFC7F8E"}, {"file_name": "03-helicopter-valley.png", "id": "1151966247266211", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622195_1151966250599544_21783635520622499_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cf-TYuD70kQ7kNvwH7JjuG&_nc_oc=Adp244B00Q3k_92KprAN0TSjD9i9CfBYaSHCZHZ2lWdWiUM6-SiPwzVITK8wgSjdEq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmqDdBxb0nnWnAN_bK-2KBhTC9_MU2eWlIDQyj4gVDaQ&oe=6AFC6FF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RigVenture-storefront-v3-corrected-propellers-2560x1440.png", "id": "1040800602363158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624990_1040800605696491_5890381946538600512_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsDbqC_ETZMQ7kNvwFY4sBm&_nc_oc=AdpV8keiIPqL0tmmf9xvlb1RfKwadKhqKQERwyljTHRIzBPQ0LsNYqzoa_Js4L4QMyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMjJDthZ9-HcR5WRTOqqzsp26jLpCORmF1jKVEZ-L9rg&oe=6AFC6989"}, "display_name": "Rigventure", "keywords": ["sandbox", "physics", "vehicle", "build", "simulation"], "long_description": "Build your next adventure in Rigventure, a physics-based vehicle-building sandbox made for VR.\n\nCombine modular parts, wheels, engines, hinges, pistons, and wings to create machines that drive, climb, carry, and fly. Build a practical rover, experiment with a flying contraption, or invent something entirely your own.\n- Build and customize: Assemble vehicles from structural and mechanical components. Experiment with different layouts and discover what works.\n- Solve engineering challenges: Design machines to navigate difficult terrain, move cargo, and overcome obstacles.\n- Race your creations: Test your custom vehicles on racing circuits and sprint courses, then refine their handling.\n- Visit the test park: Put steering, suspension, climbing ability, and other vehicle capabilities to the test.\n- Create freely: Explore your ideas in free-build mode without a mission objective.\nEvery test is a chance to improve. Adjust the balance, rethink a mechanism, or rebuild from the ground up. Discover the satisfaction of turning an idea into a working machine.\n\nExplore colourful, stylized environments and find your own solutions through hands-on building in VR.\n\nBuild. Test. Explore.", "short_description": "Build, drive, and fly your own creations in Rigventure, a physics-based VR sandbox. Assemble vehicles from mechanical parts, tackle engineering challenges, race your custom machines, or experiment in free-build mode. Turn your ideas into working machines and take them on an adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13v3Qw_K4wj5v28wqiSpY9LPJpm9kBZhzVuBl8AyA0nM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/rigventure", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1662517082325461"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593853621_1872365947530339_890245090808879951_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asjS5coMpasQ7kNvwFuIMUl&_nc_oc=AdoEEqddl6AgsvrtYQcTd_iQif7KCF0R5pGTVNRXCMXEmfosB6Lrb9syhYKDZHN-VeM&_nc_zt=3&_nc_ht=s
-controllers.png", "id": "1421205653015124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_1421205656348457_4985975902291167239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKOtpxqtSP0Q7kNvwFdS4Vj&_nc_oc=AdqyK4bNEy7Woy8oirzxkatdflVmWWh5zpmuA3lWpitOFffmNO-zIC5ScJsi3yUSojs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdJzZwB_iM3cZvd0OCqkM-RYRpedirG9ugNPEPTTcLxA&oe=6AFDCF0F"}, {"file_name": "02-tracked-offroad.png", "id": "1142019598780697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_1142019602114030_132432268089035918_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY7p5YyETR0Q7kNvwFn6iIg&_nc_oc=Ado-Dm7gmM2PlPWMGnXJ4595RMJuwG5J6fA5bjkvW9Dun7_f2XvzrgU1G2QjxFU-np0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVKfKVk_N2m-Mbk5L1oPYJYC2H2qF0rpCCNWziZwxCmg&oe=6AFDD398"}, {"file_name": "01-crane-campaign-lift.png", "id": "1429400966041772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_1429400969375105_5998360566465311921_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTNsNBIKGzoQ7kNvwH0gajT&_nc_oc=Adpkvrez0EiiC5L1AlqoD3r2Ne_-ho-W5v6WBi3Jd9yZsyIcsunV4H0Yamr_xfXvglo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMg5z9RpUtukyNStiY7WQkbvGkl51x0uGM1-lQEOG92w&oe=6AFDDC9A"}, {"file_name": "04-plane-airfield.png", "id": "1091194347040268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_1091194353706934_5153979128037522304_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvWHgnV1f34Q7kNvwEA3l49&_nc_oc=AdqfcRN18PFYqaHeUlgph_C71NNS1fv-RsiHzMVmxcZ_IiSrrkmZsaprj9879d3ZBXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPlwrmagsb9PSZk0qIXS-ugfZktRrFjeHY47mBgYDePA&oe=6AFDD10E"}, {"file_name": "03-helicopter-valley.png", "id": "1151966247266211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_1151966250599544_21783635520622499_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cf-TYuD70kQ7kNvwHhycx9&_nc_oc=Adps3EoUFjZ_8BVjZWUdtGiSgyUIVhY6pKwDWqW8jKgjMtS5CUfdMmxCXUzuJ-X4BOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQX8k_wVIuLl39vBWScW49iWCK3bP0jwfpkzp-9YAq4w&oe=6AFDC178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RigVenture-storefront-v3-corrected-propellers-2560x1440.png", "id": "1040800602363158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624990_1040800605696491_5890381946538600512_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsDbqC_ETZMQ7kNvwEQaKCr&_nc_oc=AdqPzn5FY7cnlM8NAxEzkGHK5zH0hZmkLYogMyVthPPU4Nl7JhyXJifTadykRwtPx2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRhJENMnGdYcWkJg7BcqMkgqlZdmHFNVTD38xzexKu1A&oe=6AFDBB09"}, "display_name": "Rigventure", "keywords": ["sandbox", "physics", "vehicle", "build", "simulation"], "long_description": "Build your next adventure in Rigventure, a physics-based vehicle-building sandbox made for VR.\n\nCombine modular parts, wheels, engines, hinges, pistons, and wings to create machines that drive, climb, carry, and fly. Build a practical rover, experiment with a flying contraption, or invent something entirely your own.\n- Build and customize: Assemble vehicles from structural and mechanical components. Experiment with different layouts and discover what works.\n- Solve engineering challenges: Design machines to navigate difficult terrain, move cargo, and overcome obstacles.\n- Race your creations: Test your custom vehicles on racing circuits and sprint courses, then refine their handling.\n- Visit the test park: Put steering, suspension, climbing ability, and other vehicle capabilities to the test.\n- Create freely: Explore your ideas in free-build mode without a mission objective.\nEvery test is a chance to improve. Adjust the balance, rethink a mechanism, or rebuild from the ground up. Discover the satisfaction of turning an idea into a working machine.\n\nExplore colourful, stylized environments and find your own solutions through hands-on building in VR.\n\nBuild. Test. Explore.", "short_description": "Build, drive, and fly your own creations in Rigventure, a physics-based VR sandbox. Assemble vehicles from mechanical parts, tackle engineering challenges, race your custom machines, or experiment in free-build mode. Turn your ideas into working machines and take them on an adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13v3Qw_K4wj5v28wqiSpY9LPJpm9kBZhzVuBl8AyA0nM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/rigventure", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1662517082325461"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593853621_1872365947530339_890245090808879951_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCFZTcDcFeUQ7kNvwFpQyoV&_nc_oc=AdqolZKiGELvMYDDNPDWnKgJEMN4tKxo5W4QDxMw5hyEOTPEWl3SiSgSOSqMBP8uE_c&_nc_zt=3&_nc_ht=s
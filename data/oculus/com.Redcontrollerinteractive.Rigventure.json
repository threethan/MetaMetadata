_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdu_jFqGe_g2k2sPaHmcDaQWlEkFItLOYFJSLW89hJ1A&oe=6B10460E"}, {"file_name": "03-helicopter-valley.png", "id": "1151966247266211", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622195_1151966250599544_21783635520622499_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2srmeNVTNeQQ7kNvwFYuZeT&_nc_oc=Adqp7CONxJgD2ci1JgrlcY97m5BhRTz_eSUxz9QiJJUTwxot9jjV4yeNqALqQX5kydw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVD2MrtEYHLA7NoQj0sGnuCNC3RZem7kk_RtJW-iGPnrw&oe=6B103678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RigVenture-storefront-v3-corrected-propellers-2560x1440.png", "id": "1040800602363158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624990_1040800605696491_5890381946538600512_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9M6SzlGc0cQ7kNvwFyqckM&_nc_oc=AdrWHVIeNAza7SyRAMHprc_JlL1mv22DnCrmBxyEIgFmCr-X2UlnbroCg0yYR_yyAD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAGsDgnffg9oiuop_4NtfSBy72ZAT_Io2lb45UAORPHg&oe=6B106849"}, "display_name": "Rigventure", "keywords": ["sandbox", "physics", "vehicle", "build", "simulation"], "long_description": "Build your next adventure in Rigventure, a physics-based vehicle-building sandbox made for VR.\n\nCombine modular parts, wheels, engines, hinges, pistons, and wings to create machines that drive, climb, carry, and fly. Build a practical rover, experiment with a flying contraption, or invent something entirely your own.\n- Build and customize: Assemble vehicles from structural and mechanical components. Experiment with different layouts and discover what works.\n- Solve engineering challenges: Design machines to navigate difficult terrain, move cargo, and overcome obstacles.\n- Race your creations: Test your custom vehicles on racing circuits and sprint courses, then refine their handling.\n- Visit the test park: Put steering, suspension, climbing ability, and other vehicle capabilities to the test.\n- Create freely: Explore your ideas in free-build mode without a mission objective.\nEvery test is a chance to improve. Adjust the balance, rethink a mechanism, or rebuild from the ground up. Discover the satisfaction of turning an idea into a working machine.\n\nExplore colourful, stylized environments and find your own solutions through hands-on building in VR.\n\nBuild. Test. Explore.", "short_description": "Build, drive, and fly your own creations in Rigventure, a physics-based VR sandbox. Assemble vehicles from mechanical parts, tackle engineering challenges, race your custom machines, or experiment in free-build mode. Turn your ideas into working machines and take them on an adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13v3Qw_K4wj5v28wqiSpY9LPJpm9kBZhzVuBl8AyA0nM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/rigventure", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1662517082325461"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/59385362
iler": null, "video_trailer_thumbnail": {"file_name": "RigVenture-storefront-v3-corrected-propellers-2560x1440.png", "id": "1040800602363158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624990_1040800605696491_5890381946538600512_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsDbqC_ETZMQ7kNvwFY4sBm&_nc_oc=AdpV8keiIPqL0tmmf9xvlb1RfKwadKhqKQERwyljTHRIzBPQ0LsNYqzoa_Js4L4QMyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMjJDthZ9-HcR5WRTOqqzsp26jLpCORmF1jKVEZ-L9rg&oe=6AFC6989"}, "display_name": "Rigventure", "keywords": ["sandbox", "physics", "vehicle", "build", "simulation"], "long_description": "Build your next adventure in Rigventure, a physics-based vehicle-building sandbox made for VR.\n\nCombine modular parts, wheels, engines, hinges, pistons, and wings to create machines that drive, climb, carry, and fly. Build a practical rover, experiment with a flying contraption, or invent something entirely your own.\n- Build and customize: Assemble vehicles from structural and mechanical components. Experiment with different layouts and discover what works.\n- Solve engineering challenges: Design machines to navigate difficult terrain, move cargo, and overcome obstacles.\n- Race your creations: Test your custom vehicles on racing circuits and sprint courses, then refine their handling.\n- Visit the test park: Put steering, suspension, climbing ability, and other vehicle capabilities to the test.\n- Create freely: Explore your ideas in free-build mode without a mission objective.\nEvery test is a chance to improve. Adjust the balance, rethink a mechanism, or rebuild from the ground up. Discover the satisfaction of turning an idea into a working machine.\n\nExplore colourful, stylized environments and find your own solutions through hands-on building in VR.\n\nBuild. Test. Explore.", "short_description": "Build, drive, and fly your own creations in Rigventure, a physics-based VR sandbox. Assemble vehicles from mechanical parts, tackle engineering challenges, race your custom machines, or experiment in free-build mode. Turn your ideas into working machines and take them on an adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13v3Qw_K4wj5v28wqiSpY9LPJpm9kBZhzVuBl8AyA0nM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/rigventure", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1662517082325461"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1457595224094338"}]}, "baseline_offer": {"id": "1457595224094338"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793465820, "status": "PUBLISHED", "id": "1457595224094338"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1663141675596335", "version": "0.1.0"}, "id": "4783969221831338", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1662517075658795", "is_concept": false, "late
ontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1vVNBbimu0DWXzX9AMtF2Tbuuy9K70VDtj--8tfVh1Q&oe=6A84695B"}, {"file_name": "DistanceHorizontal.png", "id": "813826881552202", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_813826884885535_535557338119136076_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIYHENrcE3wQ7kNvwERcKzN&_nc_oc=Ado3NrSRl0V4DIyTzI9wYGrsaSjoIHueYLqBzD4Um-ZoHtvtvxtztZ7zdQdsJ6x8s8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH68zb2ubDnlnI3nsM8ySTL_1WvySzOPdGDv8qGyKEPgQ&oe=6A846512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailor-cover.png", "id": "3349228971882502", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622315_3349228975215835_170585959284011411_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmVTWJbRPicQ7kNvwFFtZM1&_nc_oc=Adq-Eht8EOhnOkx5xLivjmvhUPvwul_sFYJCQj-5N47vAycgkOclUDhyESiY3D2yGVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9EA8IQlQEvG0xKdEzaWQiMc4P9VvdZ5IK_O50Z9c5QA&oe=6A84385D"}, "display_name": "Hook", "keywords": ["grappling", "cave", "competitive", "hook", "adventure"], "long_description": "# Hook: VR Grappling Action\n\nHook is a VR grappling action game where every motion determines your survival.\nUse your grappling hook to climb through a colossal vertical cave \u2014 dodging falling rocks, flying ice. \u2014 as you uncover the mysteries buried deep within.\n\n## **Story Mode**\nVenture through perilous terrain that demands absolute precision.\nEach swing, each anchor, each decision shapes your path as you ascend toward the truth waiting at the top.\nFeel the rush of speed, the silence of freefall, and the thrill of near escape.\n\n## **Challenge Mode**\nPush your limits in competitive modes against other players:\n\n- Time Attack: Escape the cave as fast as possible.\n- Endless: Keep climbing or diving \u2014 how far can you go?\n\n### Key Features\n- \ud83c\udfae Immersive VR grappling and pickaxe locomotion\n- \u26f0\ufe0f Massive, hand-crafted vertical and horizontal cave environments\n- \ud83d\udca8 Fast-paced traversal with dynamic environmental hazards\n- \ud83c\udfc6 Global leaderboards and competitive record challenges\n- \ud83c\udfaf Precision-based, physics-driven gameplay\n\n**Hesitation is poison**\n\nEvery second, every swing, every breath matters.\nIn Hook, survival depends on the courage to keep moving.\nCan you escape the cave? Believe your reflexes and DVA!", "short_description": "Hook is a VR grappling action game where every motion determines your survival. Use your grappling hook to climb through a colossal cave, dodging falling rocks and flying ice. Master precision, speed, and courage in Story Mode or compete in Time Attack and Endless challenges. Every swing counts \u2014 hesitation is poison. Can you escape the depths and uncover the cave\u2019s secret?"}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://www.notion.so/Privacy-Policy-2a937fe5ed81816b8232eba62c608828?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "ImmersedPlayer", "support_website_url": null, "website_url": "https://www.notion.so/Hook-2a937fe5ed81815fa612c381e8b6f7ca?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["S
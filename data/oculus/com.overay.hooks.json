632_4613382766983567522_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0C2W7KLOy0Q7kNvwHJefRT&_nc_oc=AdribKqBQpLAvUVAZPLgVHC3O9KDD68gjSKm5ewNRlGE_u7aA4tFd-36-zlgU_7-3MM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx-ufSFkhVnl207CpPFdt8JDEg8RPMYgY2DvK6W4k_qw&oe=6AEC9751"}, {"file_name": "Stage1_2.png", "id": "1163921502365795", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620817_1163921505699128_6682163057006758212_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA57lXFRdP8Q7kNvwEM6GXs&_nc_oc=AdowHm41VadeZDa4Eq4AnVbVfATWw-ZX3v650R12q0SHYgaFTW0RtUORNQbrgyin_l0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlAuQsv33mFrPbpvD15LNFSJLndEhPNmYoXNMFtWCrmA&oe=6AECA9C7"}, {"file_name": "DistanceConcept.png", "id": "1202687331923165", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618293_1202687335256498_895992731027320588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2H9kjz1q6oQ7kNvwEgfM5y&_nc_oc=AdpjD1WHAcmjeUjYEyW4xBS945_UDrRUr3nG2jDlx9ktW0yguE9mMVKS8oCN3KPElj4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRadL3vg4QlTemPSDJ9jctmUI-w469im6CwYX9xS7yHSg&oe=6AEC8FDB"}, {"file_name": "DistanceHorizontal.png", "id": "813826881552202", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619113_813826884885535_535557338119136076_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsvlgH3tonkQ7kNvwEkUY_d&_nc_oc=AdrvTnOiXl73NBLdbtHxMc9DMg98Cx9CxM-Vgft0ROWLpVmLx4Ksg8H-aTB1HvLJI2o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSWELgKZEhWStl3cBe59J4ns_I_TVPFAhKzsEF9-NBfg&oe=6AEC8B92"}, {"file_name": "Endless_Ranking.png", "id": "1408943907357152", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618288_1408943910690485_3826072633583745756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-711dHJ-7EQ7kNvwHzbHUC&_nc_oc=AdrKRbV--4E83lcyN1tzD0r-otM_FmU8wyGWt290E3yZZRO9ln5yT0WhgieRaSXngIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpKYmf6jhR3wvMtnj0Xui5EdszNIL4ihXn_dOWjpH1Ew&oe=6AEC9C65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hook_MainCover.png", "id": "2170561733349526", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617729_2170561736682859_5823749276128829607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31Fza4hZhy0Q7kNvwF0y-Nk&_nc_oc=AdrFr0geNC6MAmeziAK_6FMJ8ElvfHv-XCHJrKsT47H7zTkYtK5BOqUxztZEKrBT90E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRox0mylYp_Fb-vG-M0eW6Hg9JzLUJzojKpHvXZgFLwnQ&oe=6AECA789"}, "display_name": "Hook", "keywords": ["grappling", "cave", "competitive", "hook", "adventure"], "long_description": "# Hook: VR Grappling Action\n\nHook is a VR grappling action game where every motion determines your survival.\nUse your grappling hook to climb through a colossal vertical cave \u2014 dodging falling rocks, flying ice. \u2014 as you uncover the mysteries buried deep within.\n{1635213931220848}\n\n\n## **Story Mode**\nVenture through perilous terrain that demands absolute precision.\nEach swing, each anchor, each decision shapes your path as you ascend toward the truth waiting at the top.\nFeel the rush of speed, the silence of freefall, and the thrill of near escape.\n{1156559629533163}\n\n## **Challenge Mode**\nPush your limits in competitive modes against other players:\n\n- Time Attack: Escape the cave as fast as possible.\n- Endless: Keep climbing or diving \u2014 how far can you go?\n\n{1901379284095662}\n\n### Key Features\n- \ud83c\udfae Immersive VR grappling and pickaxe locomotion\n- \u26f0\ufe0f Massive, hand-crafted vertical and horizontal cave environments\n- \ud83d\udca8 Fast-paced traversal with dynamic environmental hazards\n- \ud83c\udfc6 Global leaderboards and competitive record challenges\n- \ud83c\udfaf Precision-based, physics-driven gameplay\n\n**Hesitation is poison**\n\nEvery second, every swing, every breath matters.\nIn Hook, survival depends on the courage to keep moving.\nCan you escape the cave? Believe your reflexes and DVA!\n", "short_description": "Hook is a VR grappling action game where every motion determines your survival. Use your grappling hook to climb through a colossal cave, dodging falling rocks and flying ice. Master precision, speed, and courage in Story Mode or compete in Time Attack and Endless challenges. Every swing counts \u2014 hesitation is poison. Can you escape the depths and uncover the cave\u2019s secret?"}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://immersedplayer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ImmersedPlayer", "support_website_url": null, "website_url": "https://immersedplayer.com/games/hook", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27705938095742687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619159_1571918370485551_3498755494986236372_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Iu0_qY_J-0Q7kNvwHMzSJZ&_nc_oc=AdqVPh9sjVQlXqLuegscH5EXX6TK9JzXiWuGdIgOp5Yf2zV-J6CbyawumQjY0lw-Jv4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9CcD73M8TRZO1vwAb2pLNx4ugdwPsszyFKSX6-dmnXQ&oe=6AECB80A"}, "is_concept"
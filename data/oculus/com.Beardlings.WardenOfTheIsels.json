png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB5MAFRjLPYQ7kNvwELTpOP&_nc_oc=AdpT-E_3drAtpD1NCIrPw-OJiUEDf-2z3Tuxnf_48oCa09OykcGuz-J3-wB9xAO6f3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROzaEQ4IvEGQMCISFdgy_I_yVIF35S6lpAsnZ6Q1MI6A&oe=6AFC7050"}, {"file_name": "Screenshot1.png", "id": "981794860996899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_981794864330232_6880595839343008113_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mJV5dQRlhAQ7kNvwHH2SvC&_nc_oc=AdrAHcVDOivaj_IGyCQpQrmTVY8CSAvJO92z3KVkDlrRjdyGLi9BxLJF8Gmn2H6UWY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwQl38pH_6amwcryjSYncPOExed5dci_mKuWmLz7r0Pw&oe=6AFC9280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.png", "id": "1022336784175817", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593716858_1022336787509150_9191553698289609335_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8cXZOiRHiwQ7kNvwEfQb69&_nc_oc=AdpSaQI4dZTp9uWpc5eRbOqWfGw-Ch11wfrngZ2DkiMygez6Pv_b1gY9t58b6iXHcjY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8yUrxxVEQ_Th41iW4XepK8k7POUf-GunOoMP7aHCi6Q&oe=6AFC735C"}, "display_name": "Warden of the Isles", "keywords": ["RTS", "Strategy", "Multiplayer", "Adventure", "Spells"], "long_description": "Use Magic and a Powerful Throwing Arm to defeat enemies in VR as you Build and Command Troops in this RTS and Mage Simulator. Uncover the threat facing the Isles in the Campaign or battle in Multiplayer or Skirmish modes as you become... Warden of the Isles!\n\n**You have been chosen.**\n\nEmbark on an epic adventure!\n{839544445869701}\n* Cast spells. \n* Summon elementals.\n* Grab enemies. Hurl them to their doom or rescue your own troops!\n{1437282094982096}\n* Assign workers. Gather resources.\n* Construct your base.\n* Build your army & defenses.\n* Organize unique legions and take the fight to the enemy!\n\n{1383697794817071}\n\n* Battle together or as rivals.\n* Up to 4 Players in a single battle.\n* PVP or Battle challenging A!\n\n{28673665332323434}\n* 15 hours of gameplay. \n* Uncover the dark origins of a mysterious threat.\n* Fully Voiced!\n\n**Become The Warden\u2026**\n", "short_description": "Use Magic and a Powerful Throwing Arm to defeat enemies in VR as you Build and Command Troops in this RTS and Mage Simulator. Uncover the threat facing the Isles in the Campaign or battle in Multiplayer or Skirmish modes as you become... Warden of the Isles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://beardlings.com/privacy-policy/warden-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beardlings LLC", "support_website_url": null, "website_url": "https://beardlings.com/warden-of-the-isles", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28493099523650792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620384_2313595729407636_7882012023965714483_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF-S0Ol2oe8Q7kNvwHh3zbC&_nc_oc=AdoERsjmSdjSm5T78HvA4Hkiybtvl6xBr2fx74xkGgpCPMmbCfMnVt
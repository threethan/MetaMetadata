_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjjOiAbReSYQ7kNvwG0HVOt&_nc_oc=Ado7ATSSKPgIyzny0MrwAEoIizuRUfH-BLhP9ztzt7WoKPz7IQI36F19j_9ZYi7tkD8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYBi12ONPuXXU9Nwgy1Fl5BYZXRNRhSDJsKhPGI4lfrw&oe=6A85AA4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laced Tagging", "keywords": [], "long_description": "\"Laced Tagging\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of \"Laced Tagging\" is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "Laced Tagging, A New Interesting Gorilla Tag Fan-Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1kL_tZPGLPil5_bQuvD1Q8TnANynyNNM4Vo0TKj9_Ads/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Funni LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/laced-tagging?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "95
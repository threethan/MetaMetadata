uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619774_25889003940728132_8417144482166505532_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVJmhIA54IEQ7kNvwF7nV4M&_nc_oc=Ado9n0jqZMHGHMbv68-gFj8v0Sv86CsbATPEOi1BiFzV--hpXIYOv2I50kbx2d6YeAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMSIw-IyRlwYNbhPkI1PfTdyr_2gnZKSDSAIVvBhvO8g&oe=6AE21E32"}, {"file_name": "image (1).png", "id": "1335333438620414", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617831_1335333441953747_7769471488204172432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZkuudflny0Q7kNvwHyA7Ca&_nc_oc=Adp9swBbwB_1Cv7NzY-GFWYi9AwJ-T6Pq615mUHL0mlrAquKtuK_7B3Xwix82Q8UUSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5sZ4nh6UPfxpBd3Uvhtqgfz_Szor533TpsfiJfT0Chw&oe=6AE1EC12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mania!", "keywords": [], "long_description": "**Monke Mania** is a high-energy fan game inspired by Gorilla Tag, built around fast movement, skill-based gameplay, and nonstop chaos. There are no complicated controls to learn \u2014 just you, your arms, and the environment. Run, jump, climb, and launch yourself across the map using pure momentum and practice. Every movement matters, and the better you get, the faster and smoother you\u2019ll feel.\n\nThe game features unique, colorful maps designed to encourage creative routes, risky escapes, and intense chases. Whether you\u2019re scaling massive structures, juking opponents around tight corners, or flying across open spaces, every match feels different. It\u2019s easy to pick up and play, but mastering advanced movement techniques takes real dedication.\n\nMonke Mania is all about fun with friends \u2014 laughing during close calls, celebrating insane saves, and improving together. From casual lobbies to competitive showdowns, the game rewards quick thinking, smart movement, and bold plays.\n\nIf you love fast-paced action, skill-based mechanics, and a little bit of chaos, Monke Mania brings the energy every time. Jump in, trust your instincts, and unleash your inner monke. \ud83d\udc12\ud83d\udd25\n", "short_description": "Monke Mania is a fun, chaotic fan game inspired by Gorilla Tag where it\u2019s all about movement, momentum, and pure monkey energy. Run, jump, and climb using just your arms as you race around unique maps and try to outplay your friends. It\u2019s simple to pick up, but mastering the movement takes skill. Whether you\u2019re goofing around or sweating in a chase, Monke Mania is all about fast-paced fun and unforgettable moments. \ud83d\udc12\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/officialkel/privacy", "developer_terms_of_service_url": "https://sites.google.com/view/officialkel/terms?authuser=0", "publisher_name": "TheOfficialKel", "support_website_url": null, "website_url": "https://sites.google.com/view/officialkel/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33826261790353140"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "910427708023620"}]}, "baseline_offer": {"id": "910427708023620"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771578420, "status": "PUBLISHED", "id": "910427708023620"}]}, "liveChannel": {"nodes": [{"la
64532120057914", "locale": "en_US", "screenshots": [{"file_name": "meta thingy1 (1).png", "id": "919146800479794", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821200_919146803813127_1878739110762461180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ttoxQtqFuEQ7kNvwHJddyn&_nc_oc=Adpj2uWgV0tr0Z5H3MbTLyre0tA6jUXaOBEwH-46ZNkz5naFP_e6ZCU2xC9vA7YfyxY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZtJND3PujTgXMxpYQ1arQGbYglUg8qDv5Vwnqqk5e7g&oe=6A26CCB4"}, {"file_name": "meta thingy 2 (1).png", "id": "1582204122903750", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620429_1582204126237083_7607699404192522262_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S87Skbv2AXcQ7kNvwGW7VFI&_nc_oc=AdqH4VN0nw59Oa_5ZFbz3kCVIghmMJBtuJp0l0jZeRSuSwam0VSA4YJcjcY__0oZV8c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81xqvXQB5QDnHEjhMrTk6sG8akOW7gAvOM53ra0SfarA&oe=6A26D8B0"}, {"file_name": "meta thingy 3 (1).png", "id": "1461425458889790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620860_1461425462223123_3846269418048698405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCVyUFMU6IUQ7kNvwFw5cXV&_nc_oc=AdpGa8_6NaLtzMW9FCAGddvs-urUeHnNGurEgfllNPPSCg5E8W0CAlVYjclLei37xvU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zdaEGxRZqZm7BmGPcCQhvnwMlncCnvSGNhcfwc7cekg&oe=6A26E76D"}, {"file_name": "mm meta thingy (1).png", "id": "25889003937394799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619774_25889003940728132_8417144482166505532_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTL_ijqnK2QQ7kNvwFO0v7g&_nc_oc=AdoX4EWAv4pR1_db10UgKDrgpeMRwzanaFIstwIwuKYvd0nqvhXGiYKxmbfQ2QZvvx8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GshBTYae-ZrhU9Cc4VzZlCyDHsGJwdp2BxeN6sFTW7g&oe=6A26E932"}, {"file_name": "image (1).png", "id": "1335333438620414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617831_1335333441953747_7769471488204172432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcQ62VjvARkQ7kNvwHIhKHD&_nc_oc=AdoCUq7MacDEu8MphbTGNsJF-i_faFmNnK2x2Dx4B7w0fRW_CYgDiJuymZdbAuKbWCc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FygQDZPctJI5o8wp_bECMHpUGVkPtEq4SQad4d2UnJA&oe=6A26B712"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mania!", "keywords": [], "long_description": "**Monke Mania** is a high-energy fan game inspired by Gorilla Tag, built around fast movement, skill-based gameplay, and nonstop chaos. There are no complicated controls to learn \u2014 just you, your arms, and the environment. Run, jump, climb, and launch yourself across the map using pure momentum and practice. Every movement matters, and the better you get, the faster and smoother you\u2019ll feel.\n\nThe game features unique, colorful maps designed to encourage creative routes, risky escapes, and intense chases. Whether you\u2019re scaling massive structures, juking opponents around tight corners, or flying across open spaces, every match feels different. It\u2019s easy to pick up and play, but mastering advanced movement techniques takes real dedication.\n\nMonke Mania is all about fun with friends \u2014 laughing during close calls, celebrating insane saves, and improving together. From casual lobbies to competitive showdowns, the game rewards quick thinking, smart movement, and bold plays.\n\nIf you love fast-paced action, skill-based mechanics, and a little bit of chaos, Monke Mania brings the energy every time. Jump in, trust your instincts, and unleash your inner monke. \ud83d\udc12\ud83d\udd25\n", "short_description": "Monke Mania is a fun, chaotic fan game inspired by Gorilla Tag where it\u2019s all about movement, momentum, and pure monkey energy. Run, jump, and climb using just your arms as you race around unique maps and try to outplay your friends. It\u2019s simple to pick up, but mastering the movement takes skill. Whether you\u2019re goofing around or sweating in a chase, Monke Mania is all about fast-paced fun and unforgettable moments. \ud83d\udc12\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/officialkel/privacy", "developer_terms_of_service_url": "https://sites.google.com/view/officialkel/terms?authuser=0", "publisher_name": "TheOfficialKel", "support_website_url": null, "website_url": "https://sites.google.com/view/officialkel/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33826261790353140"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "910427708023620"}]}, "baseline_offer": {"id": "910427708023620"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771578420, "status": "PUBLISHED", "id": "910427708023620"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33884856031160382", "version": "2.1"}, "id": "1426127852638952", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33798953656417287", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33884856031160382"}, "release_status": "RELEASED"}, "
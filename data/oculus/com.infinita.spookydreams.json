": "Spooky Dreams! A mini action-packed VR game, for all the family! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or solo play!\nIt was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! - \"It's like being at the gym while you sleep!\", she had said - Little did you know how true that would be!\n... Eight hours\u2026 Can you survive the night?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinita.com/games/spooky-dreams/docs/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Infinita", "support_website_url": null, "website_url": "https://infinita.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8433234110085684"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1533311185233649"}, {"status": "PUBLISHED", "id": "2060815867848519"}, {"status": "PUBLISHED", "id": "2689519754755456"}, {"status": "PUBLISHED", "id": "1924665618928648"}, {"status": "PUBLISHED", "id": "1206139231663695"}, {"status": "PUBLISHED", "id": "1511075343647972"}, {"status": "PUBLISHED", "id": "1629022304722570"}, {"status": "PUBLISHED", "id": "2470594219978212"}, {"status": "PUBLISHED", "id": "926151676230686
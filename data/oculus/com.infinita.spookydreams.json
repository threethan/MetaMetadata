VpUUDEGj4iYPKSGhAXBA7cA2Ec4b4qRs3JxhZ_2C-DmcUsDrDE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuEkEeEaZzlzPK2b4zn60htHBIRMC3up1VCfyUblyz3HA&oe=69A58AC8"}, {"file_name": "Spooky Dreams 5.png", "id": "2054323565400784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_2054323568734117_4321581195524651801_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4Hh6Ra03VkQ7kNvwGGceLP&_nc_oc=Adlzs5eQ-BFSC9UGzZnXWXVAXBFkXC5jdnUr2vnlZJxTF5vWuqrXHCCG3kL_VWs-OEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu_LbkETSGqo-ymaV12Hh_OsLv0UN38LP5SZhcCdhwANA&oe=69A57999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1226026461964281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982531_1226026465297614_2910294776192376285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPITtkUIsvgQ7kNvwEw4fWZ&_nc_oc=AdlCeGwuZzUyX1utKZy7Ynslnc4MnmQze0it17LCXJzdt2Z3mtBIMPenETRdh69Ew_k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afseqtct3Piwjxk0HsQR-acMybl3wm8cUv3BHQWadrVCZg&oe=69A589F7"}, "display_name": "Spooky Dreams!", "keywords": ["Halloween", "Spooky", "Family", "Action", "Active"], "long_description": "**October 2025: Officially Launched!**\n\n**Spooky Dreams**! An **action-packed** VR game, for **all the family**! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or as a personal challenge!\n\nIt was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! \u2013 \"It's like being at the gym while you sleep!\", she had said \u2013 Little did you know how true that would be!\n\n... Eight hours\u2026 Can you survive the night?\n\nRoom Scale requirement:\n- Min: 6.5\u2019 x 3.2' or 2m x 1m - (makes the game a bit more challenging!)\n- Best: 9.8' x 9.8' or 3m x 3m", "short_description": "Spooky Dreams! An action-packed VR game, for all the family! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or as a personal challenge! ... It was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! - \"It's like being at the gym while you sleep!\", she had said - Little did you know how true that would be! ... Eight hours\u2026 Can you survive the night?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinita.com/games/spooky-dreams/docs/privacy-policy-meta-horizon-platform/", "developer_terms_of_service_url": null, "publisher_name": "Infinita", "support_website_url": null, "website_url": "https://infinita.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25074185238897309"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974450_747765830868470_5435782756152328193_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIrrRN0AdPUQ7kNvwHJn7XR&_nc_oc=AdlarxG68C5ZOUDpwNvl_WldHil_u0UhMguRzketeXN4YSfh7o_kKf706CBdJMj1RMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvcHP9akhB4XFitgYyDzsz7xS-SyPMvq1085EBHovMOOA&oe=69A58A95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spooky Dreams!", "platform": "ANDROID_6DOF"
=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1a87dPyUxJXLCEMsXhjHvzFVDSghMKopywE0qsjciwg&oe=69C9258A"}, {"file_name": "Screenshot-5.png", "id": "2057616764686023", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_2057616768019356_5057866813059116118_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfOQggPapskQ7kNvwGzDaPX&_nc_oc=Adrb1BL8ox6nu5uVefnAbHK2h8u0L538EueQRD-jpdpI1HI9ypRQa4T2aAcsCR9zCbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUjJNAWjb26mfmMGEXtugUXCwevAy1ds66HtUVvy1BTw&oe=69C92F9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Dreams", "keywords": ["Halloween", "Spooky", "Family", "Action", "Active"], "long_description": "**Spooky Dreams**! A **mini action-packed** VR game, for **all the family**! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or solo play!\n\nIt was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! \u2013 \"It's like being at the gym while you sleep!\", she had said \u2013 Little did you know how true that would be!\n\n... Eight hours\u2026 Can you survive the night?\n\nRoom Scale requirement:\n- Min: 6.5\u2019 x 3.2' or 2m x 1m - (makes the game a bit more challenging!)\n- Best: 9.8' x 9.8' or 3m x 3m", "short_description": "Spooky Dreams! A mini action-packed VR game, for all the family! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or solo play!\nIt was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! - \"It's like being at the gym while you sleep!\", she had said - Little did you know how true that would be!\n... Eight hours\u2026 Can you survive the night?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinita.com/games/spooky-dreams/docs/privacy-policy-meta-q
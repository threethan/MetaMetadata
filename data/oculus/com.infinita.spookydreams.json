4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9eu5mogDisQ7kNvwHJpKim&_nc_oc=AdmKfOowV3db00t9L_FIXO8_mB060cUly95xw8UWXwlF4st4_qS1qeCygEgg3z5ytkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6Q2ggOHuseadO3snzqF-jS146lF_cCujxB_lDt9QgCg&oe=69B40B48"}, {"file_name": "Spooky Dreams 5.png", "id": "2054323565400784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_2054323568734117_4321581195524651801_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7eA9tjmbnwQ7kNvwHq6PLq&_nc_oc=Adn8tvwK_Zo5auCr-Jtn8VzLw1AO_XG-WQm7neaBE94pQrunx7COl6v_viruVqFoEzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxcBeDJxt3v2Z9g2siuLIdIXPCmmKTehb-G35VFOQODvA&oe=69B3FA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1226026461964281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982531_1226026465297614_2910294776192376285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdFTu_6Q5N0Q7kNvwFd68Ug&_nc_oc=AdnCyd3uw8j4wj0L2N4AnNWR-yUVXsjpnCzRWjTmWz74nlgOBegfdhFRBDMS_UOSKXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkRxKdmKC_RSpskwlLbleF7L2sDS8f_-HR_g4km9XFew&oe=69B40A77"}, "display_name": "Spooky Dreams!", "keywords": ["Halloween", "Spooky", "Family", "Action", "Active"], "long_description": "**October 2025: Officially Launched!**\n\n**Spooky Dreams**! An **action-packed** VR game, for **all the family**! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or as a personal challenge!\n\nIt was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! \u2013 \"It's like being at the gym while you sleep!\", she had said \u2013 Little did you know how true that would be!\n\n... Eight hours\u2026 Can you survive the night?\n\nRoom Scale requirement:\n- Min: 6.5\u2019 x 3.2' or 2m x 1m - (makes the game a bit more challenging!)\n- Best: 9.8' x 9.8' or 3m x 3m", "short_description": "Spooky Dreams! An action-packed VR game, for all the family! Dodge tricks, collect treats, and survive the night! \u2013 Perfect for parties, family nights, or as a personal challenge! ... It was supposed to be just a Halloween party! Well ... until you took a sip of that mysterious drink! Then\u2026 that night\u2026 it began! - \"It's like being at the gym while you sleep!\", she had said - Little did you know how true that would be! ... Eight hours\u2026 Can you survive the night?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinita.com/games/spooky-dreams/docs/privacy-policy-meta-horizon-platform/", "developer_terms_of_service_url": null, "publisher_name": "Infinita", "support_website_url": null, "website_url": "https://infinita.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25074185238897309"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_747765830868470_5435782756152328193_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUMQIciClvwQ7kNvwEpUq4t&_nc_oc=AdnSdpapFWAYWG67LCmxmM8V9y4Oj4b8w7NXZBTDwGCPFKXbmxymksPUI0MM7ndDwhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwY1QX3XEiKSXBLpHwe2OirK75wgcRrwpjDELjaNJC9oA&oe=69B40B15"}, "is_concept":
": "SAR-immersive-bkgd-20240123.png", "id": "330332223310075", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031441_330332226643408_3965486585831674105_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50JFONYfQsoQ7kNvwHSRsjl&_nc_oc=AdrDJlXLjiuKnNNPvg1Pf34s4SbEJZiowm8YfhwP-r1BoQsMmulKmbaznlqEO2rbC60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVf6BC1dSIqFA-12VgPsq4Vm62bf5fMe4a0k88EV_PLCg&oe=6B104E7C"}]}, "id": "862195467583320", "locale": "en_US", "screenshots": [{"file_name": "SAR_SS_dim_1.png", "id": "756360579225661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75295292_756360582558994_1764909476097146494_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbVOq3IhFRYQ7kNvwEvLc5D&_nc_oc=AdpXPgqsO3fqU8l-6uhhiUca3H2mns3feju0DiKGHG5S5Tbk32-8VfghojXGkXVp5FQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYXJ5t43h1dD89VUfj6OhqytpJOhrcBBc-ijQc0P4_vw&oe=6B105947"}, {"file_name": "SAR_SS_dim_2.png", "id": "880809304047381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_880809307380714_7583792906042158211_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvJKBnWcoOgQ7kNvwHv_6GF&_nc_oc=AdpUeU4KKKePllJcRby9rVY_F0MAR9srdEqxbRcyoDmr7LpKeOr3k9D1Qa2e8yAvg-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXW9aQGxK2AzDxAvG-PlHlUY8R7WHcSQIsIQA7e9x6tCA&oe=6B1062EA"}, {"file_name": "SAR_SS_dim_3.png", "id": "3573959236190774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974758_3573959239524107_2210087525223142779_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm4l8NQW8oAQ7kNvwFOszSB&_nc_oc=Adq88O2LIg-PVUgGaOnDpSAqFc4A_jgWDuCN-3DaV2mQt-zDv2nagobop6C94Mh73Ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVi-IAldPuNzBhgC7_RL_YckTgcOeBOKV6nQBaap9Jv1g&oe=6B1066E5"}, {"file_name": "SAR_SS_dim_4.png", "id": "880704230447256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974617_880704233780589_1418626937109406417_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt-y-Q45-PkQ7kNvwE6_ott&_nc_oc=AdpvKV0zR-enuEaagnYk5HWWHEtPfvODdIZ_-z4aHQqpbU8z3mtwyiWD-Xi9TDX4sSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWzTI8fhwb6GC67czuZ3Gsz8TILyOxeZ4Cb4XmAuvdIkA&oe=6B103A48"}, {"file_name": "SAR_SS_dim_5.png", "id": "2320180758181663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031543_2320180761514996_1133265871050196684_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGD3DFQPkUIQ7kNvwE-MIIY&_nc_oc=Adr-Y0EsKSHLYRBDnzFQ8ZQy7vAQQEXKDk4IrDnT15FIXZLZLnkousyPtY9chEKOdm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXV_lcr3iybgzrhLrmU8CWk6RkgAq8zH9erIhVtdXHZOg&oe=6B105113"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Some Assembly Required", "keywords": ["robot", "robotics", "sandbox", "building", "STEM"], "long_description": "Build robots, help humans, cause chaos! Some Assembly Required is a sandbox game about designing and building robots to serve the needs of squishy, hapless humans in the world of tomorrow. \n\nBUILD ANY ROBOT YOU CAN IMAGINE\nSnap together parts to bring the machines of your dreams to life. Hook up controls, customize how your robots move and operate, then add fun cosmetics like googly eyes and hats.\n\nCONQUER CHALLENGES\nFrom sandwich delivery to toxic chemical leaks to zombie invasions, our campaign of robotics adventures will put your robotics skills to the test. Let your imagination run wild as you design the best possible bot!\n\nPLAY AT ANY SCALE\nResize any environment on the fly with real-time room scaling. Watch your robots go from action figures to kaiju and back again! \n\nSHARE YOUR ROBOTS\nUsing the built-in community workshop features, you can share your masterpieces with other robotics geniuses, or download others\u2019 robots for inspiration and remixing.\n\nPOV: YOU ARE A ROBOT\nUsing the Cockpit part, you can hop in the driver\u2019s seat and get up close and personal with the action. In addition to Cockpit mode, Some Assembly Required offers Step Follow, Smooth Follow, and Free Look camera options. ", "short_description": "Build robots, help humans, cause chaos! Some Assembly Required is a sandbox game about designing and building robots to serve the needs of squishy, hapless humans in the world of tomorrow. From sandwich delivery to toxic chemical leaks to zombie invasions, our campaign of robotics adventures will put your robot design skills to the test. There's no one way to beat any of these levels, so let your imagination run wild as you design the best possible bot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.filamentgames.com/privacy-policy/", "developer_terms_of_service_url": "https://www.filamentgames.com/terms-of-service/", "publisher_name": "Filament Games", "support_website_url": null, "website_url": "https://www.filamentgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2036064639900671"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "983253617837559"}, {"status": "PUBLISHED", "id": "190188435052129
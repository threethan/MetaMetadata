": "SAR-immersive-bkgd-20240123.png", "id": "330332223310075", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031441_330332226643408_3965486585831674105_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1ltn1oqNA8Q7kNvwHBHUKE&_nc_oc=Adqb6P4q0krOoSfhmbR9MGzfWuq0KFQdX6SYiaRuOv9XJqNpOMfM7ei-fl3hPBQiUe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZOh9foxO-vwALK-UMTt3VDmuxfhsymadFDzdbVTHeqQ&oe=6B08657C"}]}, "id": "862195467583320", "locale": "en_US", "screenshots": [{"file_name": "SAR_SS_dim_1.png", "id": "756360579225661", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_756360582558994_1764909476097146494_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AzGUPSZsJoQ7kNvwFV_J-1&_nc_oc=AdoKuSGUeoFnYN_YHMtY5ZH_Tq_Er0ZGT9WpqlmVHkmfDdSmTf_MUkEXfwI8S3sbOG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUbVyC7vU9eoKn81zS17EsgxXlCDIVmEUTUIajr4dAew&oe=6B087047"}, {"file_name": "SAR_SS_dim_2.png", "id": "880809304047381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974645_880809307380714_7583792906042158211_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLr-6Ld6EtUQ7kNvwFyvDFR&_nc_oc=AdoXSgu_TaFcRGKpUH0GTABk1TDthG9cVJQUn0sGENrl3Z9Kc6KJ5qnoMlxmsptotto&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhewMe09n8z1ntA7nkYLRgVwJUip8j5GPuYD4zAhsVZg&oe=6B0841AA"}, {"file_name": "SAR_SS_dim_3.png", "id": "3573959236190774", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974758_3573959239524107_2210087525223142779_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqX7M8zDo7cQ7kNvwH8Ikwz&_nc_oc=AdpyCeKPVuWC5R15JMngVQLu2ifuJtwd7K4_XFNTm04sqzmZZN-AYWSYCzgloezNklg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM34C4pR9IsP1s5WIAqosw8uCacSxLlyQuho235UtFQg&oe=6B0845A5"}, {"file_name": "SAR_SS_dim_4.png", "id": "880704230447256", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974617_880704233780589_1418626937109406417_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eEOx-5dq7cQ7kNvwEU9NTB&_nc_oc=AdqT9jOqmVPo64AwuZY-jzzcPrVYRNPsfoEG_EE2ViRzHUVG1G-43pJ1dnsC8e8DZZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz3XG90Z8hXyfBZEgJaO43PH7mzxVBV_OkS8WWHv6DPA&oe=6B085148"}, {"file_name": "SAR_SS_dim_5.png", "id": "2320180758181663", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031543_2320180761514996_1133265871050196684_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4859W_Sn3K4Q7kNvwFucXnY&_nc_oc=Ado5pHKVCSoaan64pJ6wzr3n3Rhr249oFwGylPX4RfSvM50orAT0hs05ZFcorRhDwnk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkZYYpk1FuEWOLh3bccx5nnVZdb_xMXt4RUm0hNfgZ-A&oe=6B086813"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Some Assembly Required", "keywords": ["robot", "robotics", "sandbox", "building", "STEM"], "long_description": "Build robots, help humans, cause chaos! Some Assembly Required is a sandbox game about designing and building robots to serve the needs of squishy, hapless humans in the world of tomorrow. \n\nBUILD ANY ROBOT YOU CAN IMAGINE\nSnap together parts to bring the machines of your dreams to life. Hook up controls, customize how your robots move and operate, then add fun cosmetics like googly eyes and hats.\n\nCONQUER CHALLENGES\nFrom sandwich delivery to toxic chemical leaks to zombie invasions, our campaign of robotics adventures will put your robotics skills to the test. Let your imagination run wild as you design the best possible bot!\n\nPLAY AT ANY SCALE\nResize any environment on the fly with real-time room scaling. Watch your robots go from action figures to kaiju and back again! \n\nSHARE YOUR ROBOTS\nUsing the built-in community workshop features, you can share your masterpieces with other robotics geniuses, or download others\u2019 robots for inspiration and remixing.\n\nPOV: YOU ARE A ROBOT\nUsing the Cockpit part, you can hop in the driver\u2019s seat and get up close and personal with the action. In addition to Cockpit mode, Some Assembly Required offers Step Follow, Smooth Follow, and Free Look camera options. ", "short_description": "Build robots, help humans, cause chaos! Some Assembly Required is a sandbox game about designing and building robots to serve the needs of squishy, hapless humans in the world of tomorrow. From sandwich delivery to toxic chemical leaks to zombie invasions, our campaign of robotics adventures will put your robot design skills to the test. There's no one way to beat any of these levels, so let your imagination run wild as you design the best possible bot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.filamentgames.com/privacy-policy/", "developer_terms_of_service_url": "https://www.filamentgames.com/terms-of-service/", "publisher_name": "Filament Games", "support_website_url": null, "website_url": "https://www.filamentgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2036064639900671"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "983253617837559"}, {"status": "PUBLISHED", "id": "190188435052129
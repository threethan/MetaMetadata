1BH0AmKRDJA&oe=6A43E1C8"}, {"file_name": "SAR_SS_dim_5.png", "id": "2320180758181663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031543_2320180761514996_1133265871050196684_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BBAMQUk70sQ7kNvwF6votn&_nc_oc=AdoPmxyiINfqLrCvoD0HqYP9SSa7RTpHj4-03eIWfow_hLWbvPwWUY8lzZJSIKpMbh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vJzAXAGpejyaC6D76Z6ZoXUQLdKVBoebSORLjILtYbQ&oe=6A43C053"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Some Assembly Required", "keywords": ["robot", "robotics", "sandbox", "building", "STEM"], "long_description": "Build robots, help humans, cause chaos! Some Assembly Required is a sandbox game about designing and building robots to serve the needs of squishy, hapless humans in the world of tomorrow. \n\nBUILD ANY ROBOT YOU CAN IMAGINE\nSnap together parts to bring the machines of your dreams to life. Hook up controls, customize how your robots move and operate, then add fun cosmetics like googly eyes and hats.\n\nCONQUER CHALLENGES\nFrom sandwich delivery to toxic chemical leaks to zombie invasions, our campaign of robotics adventures will put your robotics skills to the test. Let your imagination run wild as you design the best possible bot!\n\nPLAY AT ANY SCALE\nResize any environment on the fly with real-time room scaling. Watch your robots go from action figures to kaiju and back again! \n\nSHARE YOUR ROBOTS\nUsing the built-in community workshop features, you can share your masterpieces with other robotics geniuses, or download others\u2019 robots for inspiration and remixing.\n\nPOV: YOU ARE A ROBOT\nUsing the Cockpit part, you can hop in the driver\u2019s seat and get up close and personal with the action. In addition to Cockpit mode, Some Assembly Required offers Step Follow, Smooth Follow, and Free Look camera options. ", "short_description": "Build robots, help humans, cause chaos! Some Assembly Required is a sandbox game about designing and building robots to serve the needs of squishy, hapless humans in the world of tomorrow. From sandwich delivery to toxic chemical leaks to zombie invasions, our campaign of robotics adventures will put your robot design skills to the test. There's no one way to beat any of these levels, so let your imagination run wild as you design the best possible bot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.filamentgames.com/privacy-policy/", "developer_terms_of_service_url": "https://www.filamentgames.com/terms-of-service/", "publisher_name": "Filament Games", "support_website_url": null, "website_url": "https://www.filamentgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2036064639900671"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "983253617837559"}, {"status": "PUBLISHED", "id": "1901884350521298"}, {"status": "PUBLISHED", "id": "652450707604709"}, {"status": "PUBLISHED", "id": "1339071573776853"}, {"status": "PUBLISHED", "id": "1279579866394227"}, {"status": "PUBLISHED", "id": "476841561639685"}, {"status": "PUBLISHED", "id": "1537406143475283"}, {"status": "PUBLISHED", "id": "3711777572431950"}, {"status": "PUBLISHED", "id": "1618410985566364"}, {"status": "PUBLISHED", "id": "1496223571236745"}, {"status": "PUBLISHED", "id": "
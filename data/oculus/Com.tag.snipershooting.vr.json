ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz3Q0Tqy4WEQ7kNvwHLzdan&_nc_oc=AdpeZYQug7yv7md04j_G3VcA4RbsLZhPruli4UXGxgEUJTkDx7q8toIU4zyyiCcj5ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoTqDWKmFdsbJjHdlV6VUGBVjPfB5jJod3JcTLunYEaQ&oe=6B01C5FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sniper Shooting VR", "keywords": [], "long_description": "\nSniper Shooting VR is a simple and exciting virtual reality shooting game designed for players who enjoy precision shooting challenges. Step into the VR world, take control of your sniper rifle, aim carefully, and hit targets from different positions.\n\nTest your accuracy, timing, and shooting skills as you complete challenging targets and improve your performance. With an easy-to-understand gameplay style and immersive VR experience, Sniper Shooting VR offers a fun and engaging shooting experience for players of all skill levels.\n\nFeatures:\n\n- Immersive VR shooting experience\n- Sniper rifle gameplay\n- Challenging targets\n- Simple and easy controls\n- Accuracy-based shooting\n- Fun and engaging gameplay", "short_description": "\nSniper Shooting VR is an exciting virtual reality shooting game where players use a sniper rifle to aim, shoot, and complete challenging targets with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_
7yOUSewn35HBcFwTZKNRFYPNJdQTJVNAI_mkPNxmw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00fbGoasItbZK2ah_ujAhh4iD3PAgZl_7MhXqsp0oR4A&oe=69F21B65"}, {"file_name": "4-capture4.png", "id": "1183935722155550", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974675_1183935725488883_4343956015059824120_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzVgGkORtZIQ7kNvwFZm6dw&_nc_oc=Ado4hZiMtt_12brjDZHxMq84NgMhQbyDk2bF9gyw3qmkBu3q5M7GXQqAXugrTE750_4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1WSEoqTKiP8-ZXHB6Bew1g0z70USn9UrOxIfY3Hk1QkA&oe=69F2037C"}, {"file_name": "4-capture5.png", "id": "433396578683022", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572920_433396582016355_3230390923770712844_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_ZyqkM-AB8Q7kNvwGVonVO&_nc_oc=AdrMNTX3duy3zdd9utnYZxcF9mYpDUNGHXkZFbWnyvA-qqll5BFP7-8oMLP_Ebitd8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2vMZsLpTmvqKGXGV-Php1wuzyl0tDh9-ovHUjR_5rc3A&oe=69F21AE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1267604337079359", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_1267604340412692_4425314845726952371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIkBqRwKG6IQ7kNvwH4aggN&_nc_oc=AdoyDV_YkD04NPN_4B2u4X_AdyyE6q2v7jhsf2KWv-DxxeADsgCBfBYvlg_U238du_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0JNPs_K-JiRiK-MyvGCb9il9hv15wDPuFDTB6bih0brg&oe=69F1F783"}, "display_name": "HomeVR", "keywords": [], "long_description": "Home VR, powered by ImagineX, is the first real estate platform to experience unbuilt properties worldwide in VR. Through our APP, you can walk through and customize, whenever possible, non-existing properties from around the world. Also, you can contact realtors, brokers, or developers directly and schedule a joint tour of the property. From now on, there's no need to waste time going to the properties and doing mind tricks when you can have it all from your own home. Welcome to the future of Real Estate! . If you want your project to be uploaded to our APP, please use the following service: https://homevr.imagine-x.co/. Any other questions, reach us at contact@imagine-x.co", "short_description": "Home VR, powered by ImagineX, is the first real estate platform to experience unbuilt properties worldwide in VR. Through our APP, you can walk through and customize, whenever possible, non-existing properties from around the world. Also, you can contact realtors, brokers, or developers directly and schedule a joint tour of the property. From now on, there's no need to waste time going to the properties and doing mind tricks when you can have it all from your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imagine-x.co/service-terms/privacy-policy.php", "developer_terms_of_service_url": "https://imagine-x.co/service-terms/privacy-policy.php", "publisher_name": "Imagine-X", "support_website_url": null, "website_url": "https://imagine-x.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1274234316686334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974602_1201483134010480_303899014793190494_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
L&_nc_oc=AdmcKoSnlxFnM4ZZMxM7nxUL2ZYSLWlAsFYoUIxDMAjv16-a6kzP0UdFG9qtbzSbWQs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUzCTwWluU1pVKkrMtraFl8F6FNJgBqHA6wHht3Qr_nA&oe=69AAB225"}, {"file_name": "4-capture4.png", "id": "1183935722155550", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974675_1183935725488883_4343956015059824120_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKyeJfpXfEwQ7kNvwHlm5Kr&_nc_oc=Adm5RHFv_ft26OvJntDkkiMY--Ke8cI_TV3_LO4e3VLz82rmsnmJgmpKB-pagSz8KoU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyHn4OJjElCIeKKJgKoZo-DAPOixRerKBbpycpq4pTkBA&oe=69AAD27C"}, {"file_name": "4-capture5.png", "id": "433396578683022", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57572920_433396582016355_3230390923770712844_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VsYwL5cWjwQ7kNvwHF_u3N&_nc_oc=Adn15FbERSncg4N3OCEm2CIOLd_1cz0tetPkKaajVjc4qkFaefuAmcPQ7Jbky-Fc9v8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEIH1Il2L8LScmRgKHLEfFqOCyLYppP2122yjHVbotWQ&oe=69AAB1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1267604337079359", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974820_1267604340412692_4425314845726952371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxhkdvvhcm4Q7kNvwEgsdxV&_nc_oc=AdkYu4KLmX7tXwYgYZbvAvPVy2YethvSgyxK2gDwXnHdcgLywS1WgAfPSKPbJdojhH8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyKFlSiSsah7eMwVj1IOgxQUqtln7ZQvXtEucmt7iB1Q&oe=69AAC683"}, "display_name": "HomeVR", "keywords": [], "long_description": "Home VR, powered by ImagineX, is the first real estate platform to experience unbuilt properties worldwide in VR. Through our APP, you can walk through and customize, whenever possible, non-existing properties from around the world. Also, you can contact realtors, brokers, or developers directly and schedule a joint tour of the property. From now on, there's no need to waste time going to the properties and doing mind tricks when you can have it all from your own home. Welcome to the future of Real Estate! . If you want your project to be uploaded to our APP, please use the following service: https://homevr.imagine-x.co/. Any other questions, reach us at contact@imagine-x.co", "short_description": "Home VR, powered by ImagineX, is the first real estate platform to experience unbuilt properties worldwide in VR. Through our APP, you can walk through and customize, whenever possible, non-existing properties from around the world. Also, you can contact realtors, brokers, or developers directly and schedule a joint tour of the property. From now on, there's no need to waste time going to the properties and doing mind tricks when you can have it all from your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imagine-x.co/service-terms/privacy-policy.php", "developer_terms_of_service_url": "https://imagine-x.co/service-terms/privacy-policy.php", "publisher_name": "Imagine-X", "support_website_url": null, "website_url": "https://imagine-x.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1274234316686334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974602_1201483134010480_303899014793190494_n.png?stp
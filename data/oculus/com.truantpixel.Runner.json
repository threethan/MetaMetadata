ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036698_541312717758216_2711815540609582462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC9go5NoSrcQ7kNvwGNXfLp&_nc_oc=AdkuGmiyKz-_EI_Mpv2rN5XHUzzEjiJ-_DXxukF8qPJD1cOz9MdEsD0foOd79npGWVo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7KSiuYGxoWlngQklUbTR1ZSTIOLDbFVT8mMrZMl-cAw&oe=69B68FC1"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujuSNwI6CpIQ7kNvwERCL7t&_nc_oc=AdkF10l51iNS9VWmZYhMUyb5s3oY07LczuXt_lUZU4X3Vosk494v4HTKYtonYoim0Ko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVTqpBDHh3KQUQXoOhAJQOCjmzJ97th25DNswdWBDD1A&oe=69B69621"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHNLg0-twjMQ7kNvwE1WtY-&_nc_oc=Adn2hcCUJc1i6cxjDSlPJtE8MMpm20GpZ5YPq140R1QjQAMvBBnsA0whQUwvbR1L4Hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykmelTP6kswY4p-QO9_XyzaFyoCrsDEi3rAPGdvhhMow&oe=69B692C3"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9S5F3y28DEQ7kNvwGxZ9Ju&_nc_oc=AdmwifYLmBBoOAE7j8cNGUvmG-1dMud1Cdy0eb7C9Zfr0ijJPQSd0_4Mn2iyOCLKXzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPpUb-PBHKvg7m_gnV_0ZD6ATThqUklggTu8_yOHz04g&oe=69B69509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUzClgSfmqwQ7kNvwGzIWXp&_nc_oc=Adm1DfM84f1GU0RGs3dKYNY5ocXYjDLt31WMJWHlAQ4WtEAx0KYM71wBV2c7n4Ms9wg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYrpqeXcguG4A7bXZ14o-d-xzO-Azvdc_aqXScYGYO9A&oe=69B6B25C"}, "display_name": "RUNNER", "keywords": ["cyberpunk", "shooter", "arcade", "fighting", "action"], "long_description": "RUNNER features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime. Featuring high-speed combat, intense encounters and an incredible throwback soundtrack.\n\nWhen there's nowhere left to hide, the only way out is through.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 massive levels unique to every playthrough\n\u204d 3 Additional bonus stages now available, with more to come\n\u204d Revisit stages at your leisure with the Level Select +\n\u204d Try 'Cruising' mode: just you, the music, and the road\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Multiple difficulty and comfort options\n\u204d Hidden achievements and global leaderboards\n\u204d Now Meta Quest 3 enhanced, featuring 2K native resolution.\n\u204d Features enhanced immersion with native bHaptics support\n\u204d Includes a dynamic high-speed soundtrack by Fat Bard \n\n\n", "short_description": "RUNNER is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": null, "website_url": "http://www.truantpixel.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27268770002767315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974856_617112653765820_8513376950172785532_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1avYnRWozSYQ7kNvwFUV3x3&_nc_oc=Adlq6qR5-_cFU1v5YG8Xq7RW63Nj87jYu0uOTgmYIiSa1lCAxxquND8ULK4Na4nHgEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc-FhyF_eRSeQ-j_0cVyPtAJ0rouE-XU8r0OoL1DTzRA&oe=69B6BE71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RUNNER", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES"
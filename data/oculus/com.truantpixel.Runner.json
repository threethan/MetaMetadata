 "1156233851628681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367586_1156233861628680_2894728255428788512_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLuJrM0IOGwQ7kNvwHf7vyS&_nc_oc=Adn2-77OCt7LGlM5REjpqxjkNZzYujWQBvB6hkEd7yzy_8CAlPuVfSbBVg0VUMvHs6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm8VMLracC4He6I0TGBaeHMc6WnptpjCN1KVKfz9fJ3g&oe=69BE972E"}, {"file_name": "screen_B2.png", "id": "541312714424883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036698_541312717758216_2711815540609582462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmyn9sf5hXMQ7kNvwHySsTd&_nc_oc=AdnkW4u9-QIPTcFGSz72xxjAC5PVM40SWzO2OI6eP6rSehlBPYp5XsNQA9dtVehSBHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfygQARXRWUL1PPVUDc-F7LCNmYezTvt2HNpvBYnWFTZTg&oe=69BE78C1"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4zrN9Gx5LMQ7kNvwHDaU5m&_nc_oc=AdlXlov-HbFp2joQ6JgVkC9GEmGAyIRyMMeCyRH7DqiwQ4kUj4PhX1aoUrpQss72N2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE97jhfeiJnu18ZYEh9Wfv1kxZFVANSmHc3Ze6aMZvlA&oe=69BE7F21"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_1Lo7eof08Q7kNvwEA1m4P&_nc_oc=AdmGGYmuxjKomBzS9CzAAfKhQotstkENo3fnhzPcDAMM_92JDUSbjH7KHsUGaehKx28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWlJKDLCWNXhHW_Cmt-MO-NoIJrlOOMBNsGnKhPPjY-Q&oe=69BE7BC3"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY4MyzuaCc8Q7kNvwEMmW8d&_nc_oc=AdkfEWTLWwSKNTkwDdif36HwCifyPjFwhSXBUHORmrhp-b5y5AxqCOsBVw0T1P8bpok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZOBKeiYdCajxIhcHzKBLa5xRtPHtNCHLU9Ohr_3BzwA&oe=69BE7E09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7MdCUgWUwMQ7kNvwEyvxTF&_nc_oc=AdktUvsSqLODzluoVotWWQnXCYlvsYK7ZNrnmnYpm6cLdBw51Xh6bbP7w2rboeE-TS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2Bk2KhBcFMCXE9OZTMEtWu6O7ETCGYyosIac3jbHbjA&oe=69BE9B5C"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": null, "website_url": "http://www.truantpixel.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497554628610491"}}]}, "scheduled_offers": {"count": 24, "nodes": [{"status": "PUBLISHED", "id": "3398939800265910"}, {"status": "PUBLISHED", "id": "4321640554791558"}, {"status": "PUBLISHED", "id": "2056692691843446"}, {"status": "PUBLISHED", "id": "2472686209795999"}, {"status": "PUBLISHED", "id": "836190492400673"}, {"status": "PUBLISHED", "id": "1302319371417378"}, {"status": "PUBLISHED", "id": "1246184073709878"}, {"status": "PUBLISHED", "id": "2425386464476897"}, {"status": "PUBLISHED", "id": "432074626599514"}, {"status": "PUBLISHED", "id": "1137797384608860"}, {"status": "PUBLISHED", "id": "1106421624158020"}, {"status": "PUBLISHED
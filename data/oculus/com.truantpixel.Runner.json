 "1156233851628681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367586_1156233861628680_2894728255428788512_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0bXa5en5TgQ7kNvwG7TP-P&_nc_oc=AdlnvB8phJr8UuPK2H5Rs7CaWn6bdLcT0eK_lFtGYsxj3XlPRUUkM3fi04ziyD0muZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwh41WWYZ9N6LFXOIT-d672fFjfxJL9-joWSAm6blhQjw&oe=69BFE8AE"}, {"file_name": "screen_B2.png", "id": "541312714424883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036698_541312717758216_2711815540609582462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmyn9sf5hXMQ7kNvwFuRX_T&_nc_oc=Adnm2eD5b2hfE1QQygR7GpM7kL0QSIchU1x6mXTd1rN3o88sYL9GOW2TXOV46U4yLw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1wjytCdY2GuYuc4vOdjXa5dVZj6t7QErzXwpzZx7ZiQ&oe=69BFCA41"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4zrN9Gx5LMQ7kNvwE_Gttf&_nc_oc=AdnsUrIsovpg8-OuA4jmwE-uD85AVmprHDv5OvE0qHpA-3kb5kRt67L7mXj4dvSmGt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoR-sYLd670LX_fitNa5s-N7WsMf1jYeTx87IwUC1c_Q&oe=69BFD0A1"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t07r9slzKwQ7kNvwHW9HWa&_nc_oc=Adkz_umcz806jFYKx2Jr73BUGDZb54zQgp7uNqa4zWkpGwpPbW11Hlyvhk-WmfJ0qcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOU_XpA9Fhxd_TRj8_DnZ_4HrJwr7HFzYmvxJekT1N_g&oe=69BFCD43"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY4MyzuaCc8Q7kNvwHy2Knt&_nc_oc=AdmGV_dymYh6DsTVS0i11UXA5HYYzMiGwxKj2We0E3VfHxzODXHzw-lo2xx15TRDawE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQo0w0ws6QbjgZ1usJ4uywNwGYRHh4m5MBlc12sJuy-g&oe=69BFCF89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Z1CsLgBMkQ7kNvwEiMvnu&_nc_oc=Admeq8jXqBJFkdIkD832t9RHUvZ0vqoip57HYUrgWGcJbhMwS1IoVvYAk4N_SlktClc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfoRHIdIbjvnr0qt6_K3Rxf5HVHvj49FezVQ_H_6SKMQ&oe=69BFECDC"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": null, "website_url": "http://www.truantpixel.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497554628610491"}}]}, "scheduled_offers": {"count": 24, "nodes": [{"status": "PUBLISHED", "id": "3398939800265910"}, {"status": "PUBLISHED", "id": "4321640554791558"}, {"status": "PUBLISHED", "id": "2056692691843446"}, {"status": "PUBLISHED", "id": "2472686209795999"}, {"status": "PUBLISHED", "id": "836190492400673"}, {"status": "PUBLISHED", "id": "1302319371417378"}, {"status": "PUBLISHED", "id": "1246184073709878"}, {"status": "PUBLISHED", "id": "2425386464476897"}, {"status": "PUBLISHED", "id": "432074626599514"}, {"status": "PUBLISHED", "id": "1137797384608860"}, {"status": "PUBLISHED", "id": "1106421624158020"}, {"status": "PUBLISHED
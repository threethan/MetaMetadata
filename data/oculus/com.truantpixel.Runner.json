 "1156233851628681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367586_1156233861628680_2894728255428788512_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbUBLm7EU8QQ7kNvwGpx5vk&_nc_oc=AdnPfaUyCo6JB-su-U1iS1W8j-U7mG9sUmhb3quzG6Jjt0KbPk65B1CkRg6607uUtvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEyN1b1Se5vAuOtpoqMXosDASxvMpMDFi1FmXhZnZjpQ&oe=69AEC52E"}, {"file_name": "screen_B2.png", "id": "541312714424883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_541312717758216_2711815540609582462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7DCFKsC2P4Q7kNvwFPs15l&_nc_oc=AdlcFMypGXEcZyM9nN2Zn3VS6Ysus2gYV3YdTlW2pyHx9n6BARY4OUA3wYpISwiSUmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIlw9GYS50KDH51lP4m501ltcBDm4Uu0AKnNuGryssEg&oe=69AEA6C1"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-7uB3Jri3oQ7kNvwEgsH1X&_nc_oc=AdnXp5oNSZRrirQDcOEpHDFhwgmIxsGwZifRPOF5DXB3sgfT9M3Vi8xK6vQ0I4LelaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9oZ_95bNywRGR3yjC712qgg0n13fWSZzO2SskBJ4fxw&oe=69AEAD21"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4Qg7j84T-AQ7kNvwFp5eyA&_nc_oc=AdmZqzQieLZr3hSVC0s9UEYeg5rD-6xzxfjML_MAtE2T5RmtWpJ6vyfyFWlpXV0BY3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBEbQlHiZMlZGm-fWSCSmHHW1w-0K-GMkXTzo8oZzZxw&oe=69AEA9C3"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqhtPKaWvl0Q7kNvwG4Rena&_nc_oc=AdltP_CiDh2XiXfzC6ZHx6uCFWsuxwrfUfFAneLuIVssh2pK5llRfhw4ziqZv4jf9cE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMpqTkfzOI8rOURSh639HBX1lmLIOxDpM3SWm-aXIlwg&oe=69AEAC09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVwDhfCGRmgQ7kNvwGJ0tm3&_nc_oc=AdnG4-excfUEUNjzT8hYfkpcj6j10eqD6lAdby8ovtYdA5oK2YOyYEKrzLV1RrrQOY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqtZFKwHeJ0VR1oQ-iev8iOc4ilcEMW4q8vBsmfVgCUw&oe=69AEC95C"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": null, "website_url": "http://www.truantpixel.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497554628610491"}}]}, "scheduled_offers": {"count": 24, "nodes": [{"status": "PUBLISHED", "id": "3398939800265910"}, {"status": "PUBLISHED", "id": "4321640554791558"}, {"status": "PUBLISHED", "id": "2056692691843446"}, {"status": "PUBLISHED", "id": "2472686209795999"}, {"status": "PUBLISHED", "id": "836190492400673"}, {"status": "PUBLISHED", "id": "1302319371417378"}, {"status": "PUBLISHED", "id": "1246184073709878"}, {"status": "PUBLISHED", "id": "2425386464476897"}, {"status": "PUBLISHED", "id": "432074626599514"}, {"status": "PUBLISHED", "id": "1137797384608860"}, {"status": "PUBLISHED", "id": "1106421624158020"}, {"status": "PUBLISHED
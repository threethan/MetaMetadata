e7a0a&_nc_ohc=UDHjFuFkEckQ7kNvwFVbgBX&_nc_oc=AdpHGKE8zJvRTObd-R56sK3c3XnPjxIRfO1AaAeFBNzTlfz-qBakKt8urXKqu_q8J6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXirWlRInCLgI76HInnPbHib3a8zG9RieUDUq8KgnisHw&oe=6B106941"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0McS5aFugkQ7kNvwEGgs61&_nc_oc=AdpYXY3GIpCyc2Maz2uKr8y63XxOxOf0mURbjVnZAibf1Fq4b-bJyx01at7yRuxHxv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0eWa-gGX2iSdwAE8IzgoHy9Fa8zoA6ghBPh87lfdOJg&oe=6B103761"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emRY8wdPtEYQ7kNvwGaujmK&_nc_oc=AdqrBnjk_EDQ63ywoKOqZLpwvFfgGgiYrrUV9jZL6bxVOywHAbpXGF-PCqhTxYYWYNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUh9CYooTwI2KrL9kv5YO3xXcBbDjqm4PBAoUv0hpEO6A&oe=6B106C43"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFjXD62BcfIQ7kNvwHppl1C&_nc_oc=Adp6yH2cX3H7L2ceHPLIGehLDDZlS11rzzqjA7kEprIPKpo3bD8hesTTCJVuLlFRyoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZxxzI_Th8ykpbCWGbGtq-zIS2hptt3hXDxaRbxSVUxQ&oe=6B103649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZODB52e3u0Q7kNvwGUW9u-&_nc_oc=AdpbAiyfpsaodJTRFj3RrOvdDsFd3bCLYu19fZ1R5slhB_hysoLUpjhLX60o3IxAsPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5FJ_VI0jryyVoV4VHybAyYS1sHsdf5HWP9RZX8eApxw&oe=6B10539C"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer
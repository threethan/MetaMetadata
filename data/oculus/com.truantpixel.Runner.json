&oh=00_AQEzFc3pjTje9Bu708EpP8o2LPAF1LXb3AIaTJDFqY48lg&oe=6A8D92AE"}, {"file_name": "screen_B2.png", "id": "541312714424883", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_541312717758216_2711815540609582462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHWrH24jGewQ7kNvwExSPqT&_nc_oc=Adq128LVvoPdJ01qXP_Uxj3gzcRht67YT1mIKo8cTfOQCLznNGzRchD3glH_bYZU50Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdgfJ3JHUTvS5eEACjCgdV8OGBEOtlBv2VYry4uj5Ucw&oe=6A8D7441"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7_c2LHcGUkQ7kNvwF5pSEK&_nc_oc=AdqlUO0Se2gM0LitDaejQyzU8YpQuWDKWz7ZXWVZN2gzEemg3Rc3ew4VddNgYBeuIuA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFas-0CzyXsZU4QMMBaWr6bVreOrjLHLEVBLL9pOtPpmg&oe=6A8D7AA1"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuzvjdOmRrsQ7kNvwFNz54b&_nc_oc=AdoNt7QjAWfpPzqubOBneGMxQqVrMAfGsPd1sg-p-Oo2ev1n9s7eDKRdXoQJMnLOePk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjLbEhuXzb-4kQxGlEfYs9-PhoIDqk_IrD2ss5mNaDFA&oe=6A8D7743"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDWo3Uskq7IQ7kNvwHOAThT&_nc_oc=Adrv_HhkhFq2XkdTnIZPoyWMTQunTh61SRIWk7u92lHuXaoDk4U5yM1SiHa2ZZuQyNw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-twbr9gWvMfa3Fyp1R9bD0DhVXAUgZXruf0mYRMMoSg&oe=6A8D7989"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbqsTJmF2zgQ7kNvwHbPTlg&_nc_oc=AdrFhnzc-xe0LJY5FL-2czoBb7ELB8Hte4XNJ6Sr484Iia0xFxV_Jl2EE1kWhhUX77g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhDQ_qqgkkDPpx_mz6MhaXMRtrY8i953XZAk5BuTbKdQ&oe=6A8D96DC"}, "display_name": "RUNNER", "keywords": ["cyberpunk", "shooter", "arcade", "fighting", "action"], "long_description": "RUNNER features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime. Featuring high-speed combat, intense encounters and an incredible throwback soundtrack.\n\nWhen there's nowhere left to hide, the only way out is through.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 massive levels unique to every playthrough\n\u204d 3 Additional bonus stages now available, with more to come\n\u204d Revisit stages at your leisure with the Level Select +\n\u204d Try 'Cruising' mode: just you, the music, and the road\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Multiple difficulty and comfort options\n\u204d Hidden achievements and global leaderboards\n\u204d Now Meta Quest 3 enhanced, featuring 2K native resolution.\n\u204d Features enhanced immersion with native bHaptics support\n\u204d Includes a dynamic high-speed soundtrack by Fat Bard \n\n\n", "short_description": "RUNNER is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": null, "website_url": "http://www.truantpixel.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27268770002767315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974856_617112653765820_8513376950172785532_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-ESquVwGMUQ7kNvwE-DPJc&_nc_oc=AdqwfMp2vPZe-gDowFYbA6uLtF-X3fh5VafezPkALJvSyRjxheTHH29aT2fT2tOdW2k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf00XUqS5gLiVlZrrQg4sKNfHuHmHBxlvIZUKwVb5JNA&oe=6A8D6AB1"}, "is_co
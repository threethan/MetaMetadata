e7a0a&_nc_ohc=pObIn4Td58cQ7kNvwEzZF6u&_nc_oc=Adp7SxhR5pL-mLoYxmr43Y-P37bYIMb5gdizkj6qz55xCBTmEMkYWmi3DD-4hgl-l_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIszZF5gHuEK8FATxLmkq-auKXCijhXrSO2o1twdCQ8w&oe=6AFC6A81"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV_ZvV1-JxYQ7kNvwFMwfzS&_nc_oc=AdqA9J6ilq3j838cLtFWiXDoDLLrlVV_t7McOgCa5qN8ZK7Sl9jwuzaPf5GTYqMYL4Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK4t4P3f_REpz2qedG_L4lnWtFDzO17WXWfVfmsOl97w&oe=6AFC70E1"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJeS_GP2zJQQ7kNvwGR52SW&_nc_oc=Adol660XinIAzu8NK4GOWslPACifXzzbgqEdPPfjze5RLYM0aAwaaMjIekJ_IYoX70Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2tNHtlg0JNCGrWy__nPrOp_PwU-8lgpo5qdUr_azEQ&oe=6AFC6D83"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkL9E_XSXXwQ7kNvwEocXpa&_nc_oc=AdqJn4oGSLcgC5GPEEBPd7ILoxqbC6uM21Tz5MRmVKYeHdLT7MH20EYv0cM3_YYKmuM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREBHiJnUSA-DlmQZRiSyQ4nZiuwuzmGkq9OpT2rUqSAg&oe=6AFC6FC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfEdKgBFJuYQ7kNvwFZwyRY&_nc_oc=AdpSwAjrC7L3MLh3fdUO8ettGdyX5GhzR-CDE-xZdXA5aUqWi9SPwjkFQqiUa4hN7Kg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdQmBnOjuT1VoVonGiVl_WeSUQCOCvOIMB_msif5eHng&oe=6AFC8D1C"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer
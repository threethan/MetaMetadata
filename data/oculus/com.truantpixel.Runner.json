e7a0a&_nc_ohc=xUGZho3J62MQ7kNvwGEkVEP&_nc_oc=AdrtvMqIu191WFREQ7uBrmxfJ6FY52j00nXkhno3c2kBKPR4T-zEf999JQWGF-earho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-wAFzizKtLeGJWxYIajDVEm3v1XvOjhjjz1haFMdCqQ&oe=6B045381"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zk7KZMKQ7MQ7kNvwFYeO-M&_nc_oc=AdpLPRuwR-Cs0GO9c148QymTPlFBL4-VdONhCwYQQbhCr7WxjT5CBnkCI2m4gDr28FU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaX7RjmZLafLXpdsgUKZAdK8FnHmhwaeMEDwxPvX_10w&oe=6B0459E1"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dRqt_PCIEcQ7kNvwH9YBxH&_nc_oc=Adodlo6h4yizd39W4ovdH7Q4C6ltJuiHy4-Jr1hWgAMzY-SYiHT_eI2RyinLTfz4FNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3iJGW4cNkJdNQ_vHQTgvkCOM2Tk2wW9Kf6gVd5-PpIA&oe=6B045683"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVL6UXYNHFkQ7kNvwHxS_Yz&_nc_oc=AdosA1j_29ntixugoCgfDZi9dlosP8GgMRHXI1eDUx-cIEyedXjYeOWHT_0nLOFIkTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq530EVLz8wcqfOh1BQRUHmdHPUUdI0pSWi63aLD2wgw&oe=6B0458C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3_Ai3IDlCwQ7kNvwF8Wv0s&_nc_oc=AdqXNiDlc9ywu0dm73zNy-ltCIsNBvSt9iZ7dIQvW4tyOg8ru1EXGwAGWuXOrVXnUtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMRMD4X9g2GbDaZnfHh1R2oIvNAxSa6RSm_LUwHmRyVw&oe=6B04761C"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer
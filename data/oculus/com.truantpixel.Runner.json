e7a0a&_nc_ohc=vgkdohOnu5YQ7kNvwHaOemq&_nc_oc=AdpsXLyC_5TXQevnW_kW1aIfw0ZncqMhknyrrPKFMP1s993OaBbVp0BV4jyJ1O9aQas&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm7GFuAi5FiYu7dSdRw4KE-DizwT_XTsUTsufrCVQfYQ&oe=6B084801"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyi5wWRTVpIQ7kNvwGC3Y8A&_nc_oc=Adp7oE1mpkNpIdCO3sMvT_8rCPyG4Zg-GQIF-Ua6Eq6XSpzf-ta_N0ln_lPQ457BXCc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSNcfZg--4x12jtev0vrFiD4uU1pkIpFcGcFJqwJTQrg&oe=6B084E61"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWGQ5d55BxgQ7kNvwGjIDEY&_nc_oc=AdqlvOJr2uKo2m7fCh2QisMxTuYhK7pAQ_cwONjbBgKrqrCf_eNzTPZy0VO_akmAUJA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOdmgyeM9B200XXWNMuIoH9iuwynoPYsnmBk2yjZNC8g&oe=6B084B03"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8bLyAT531gQ7kNvwEND1Gc&_nc_oc=Adqv80fenISgnf9W1CkQOA-aZ-_zZT9LBCn9W7LDBKOjEcJeLnDiEJc2oUl2JGqU9PU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6pbyBFsqcittbwiqlRzKpps9sTT2QEcu2kiDWZXfD3g&oe=6B084D49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T4ADtKBr5kQ7kNvwGBJBOQ&_nc_oc=AdppRK5Fxl3UmDgwZs7SnULfpGhjfehuArQH_oaYC0cB0Eeezze0YdTUiMZN3ROxplk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZjB1IpzMlhH9kXPmKTXTVDL-ZqYwMbr-tWINWktD39A&oe=6B086A9C"}, "display_name": "<RUNNER>", "keywords": ["Synthwave", "Anime", "Motorcycle", "Manga", "retro"], "long_description": "<RUNNER> features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 Procedurally-generated levels unique to every playthrough\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Accessibility and comfort modes for novice players\n\u204d Hidden achievements and global leaderboards\n\u204d Dynamic soundtrack by Fat Bard \n\n", "short_description": "<RUNNER> is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer
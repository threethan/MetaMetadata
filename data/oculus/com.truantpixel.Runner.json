nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftBOManbZmlywjxeCEpJHOMZsKwfNF7FhGyn1PUbt6jUw&oe=699ED4C1"}, {"file_name": "screen_F.png", "id": "1802116610155078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035330_1802116616821744_8345846180277977662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_4rNQtodIQQ7kNvwGRYKU4&_nc_oc=AdkhJq2EHNhpt35LmXw1xby6wB-Iw6sigVnqxDzuFD2ugXpBfCRt3rMBD-kjS4mAPeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftkgLWC4EmddcrElj1BqqkVddxSvzxKf3KXbOC4gJtojQ&oe=699EDB21"}, {"file_name": "screen_D.png", "id": "669399220857183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_669399227523849_1958680144486627270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2pX_xal5hEQ7kNvwHZpUDT&_nc_oc=Adl4UNTSFZPv4Wf0vIgIEATz5dkTELZ1akr1qeFG_A7Or44hISaiL5m9dflcyVeBGBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afum0ZLF_Ql6UhaAVPT9bLMFbeanPLukioLb_GJny0snyg&oe=699ED7C3"}, {"file_name": "sc_4.png", "id": "1239317000214777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568680_1239317003548110_2822747083612760688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlxtMveq-SEQ7kNvwGiu_HJ&_nc_oc=AdkDfZkUfa_xvAuA9b8Q4oICGFtqYUXAAwvTUYEzmtENq_f6-2-_vk9YXMwxWHTyJSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9MJOeSCyngCNQdnV4TaMOoNbdEFBV7xnstPlMbuemzg&oe=699EDA09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3183829855264952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294243_3183829858598285_4745021175035128889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FXHAC-MDBAQ7kNvwE9-GMo&_nc_oc=AdkcahrxVqn-78gndbxVRrtlokZ3sDOoPZA-bI4iTWqxj9JzKMLPoyjD4Jo8fqn4Ttw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftcYYPPfm5hGjOrT4LZGApZxOGlpc2MPVxdapEFSSuNUQ&oe=699EF75C"}, "display_name": "RUNNER", "keywords": ["cyberpunk", "shooter", "arcade", "fighting", "action"], "long_description": "RUNNER features visceral first-person arcade driving combat that embraces the unique visual style of late 1980\u2019s prestige anime. Featuring high-speed combat, intense encounters and an incredible throwback soundtrack.\n\nWhen there's nowhere left to hide, the only way out is through.\n\n\u204d Freeform 360-degree VR shooting\n\u204d Blisteringly fast motorcycle combat with full maneuvering control\n\u204d Unlockable bikes with unique attributes and abilities\n\u204d Intuitive gameplay with upgradeable sidearm mods\n\u204d Combine mounted gun upgrades to create unique weapons\n\u204d Utilize missiles and grenades as part of your arsenal\n\u204d Deflect incoming fire with the energy saber\n\u204d Execute time-bending special moves with R.U.S.H. mode\n\u204d 7 massive levels unique to every playthrough\n\u204d 3 Additional bonus stages now available, with more to come\n\u204d Revisit stages at your leisure with the Level Select +\n\u204d Try 'Cruising' mode: just you, the music, and the road\n\u204d High-speed encounters with varied enemy types\n\u204d Chain together combos for massive scores\n\u204d Enormous and intense boss encounters\n\u204d Fully-voiced narrative single-player experience\n\u204d Featuring the voices of Steve Blum, Sandra Saad and Richard Epcar\n\u204d Multiple difficulty and comfort options\n\u204d Hidden achievements and global leaderboards\n\u204d Now Meta Quest 3 enhanced, featuring 2K native resolution.\n\u204d Features enhanced immersion with native bHaptics support\n\u204d Includes a dynamic high-speed soundtrack by Fat Bard \n\n\n", "short_description": "RUNNER is an anime-inspired motorcycle action arcade game. Players take on the role of Mina, a rogue mod-courier at the center of a massive city-wide pursuit. Beginning in the heart of the Presidium, the neon-drenched capitol of the mining colony planet N-351, Mina\u2019s only means of escape is the \u201cThoroughfare,\u201d a massive highspeed expressway that snakes through the entirety sprawling colony complex. \n\nWhen there's nowhere left to hide, the only way out is through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truantpixel.com/privacypolicy2020.pdf", "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": null, "website_url": "http://www.truantpixel.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27268770002767315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974856_617112653765820_8513376950172785532_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRqIPPWH8JoQ7kNvwEwAnNx&_nc_oc=AdnW9YVr-Ivl9gX7N3CbbkfjpM1KpXJ7SrRCt-_SpFo6mVCYOdRGv334vL1jPXWqtAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftoJnvGXztkCIwiGDn-HcxTRDW46n1vTie5RPDXrVvq6g&oe=699F0371"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RUNNER", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1665075569, "lastRevision": {"nodes": [{"id": "5002905456406957", "release_type": "MAN
22276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVqSlkGgKgQQ7kNvwEmyK3T&_nc_oc=AdlBySh9YVmF7c7hCbMfEd_i6eEtGkRdQduqoUdQJ7FWmaxfWmgbRmnQDHDQq9Fqc-Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3P3VyJXjvi3IlXgSJBK3wOnXHdedrvtoCaBiTF8Ciwg&oe=69BA8E55"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WouoJwmLKJYQ7kNvwHBGMn-&_nc_oc=AdmXgVvm-SJ1JL5VUtPpAt1laQJUXj5Hdjp2r6544hCeCyXbPhA6w3TXsHMCs9uP2SE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxyqv36jTDPwT85fjqcyoHl4C3f8XH9lz_NszKQKbts3Q&oe=69BA8905"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOhIiAtuawEQ7kNvwFBKEbz&_nc_oc=AdmBTmDRHwpmkgleqriJyZMGTm_gm1yvWr24WxY2inHWQuEed5tZ-SA652qv7Ln5OxQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5BdZ8O5fQzSp5epTXNAJSYXLw7QdrlQXuz7JpIygxzg&oe=69BA9EF3"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDi0JdlUDrwQ7kNvwFXHvAf&_nc_oc=Adnj5RU04KhVOnOi51NxHvNeosUGGTjauLG4fJLvdi-sbrf7AZfLLO6sThHpQxBwkko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5eBd_MHGHxmPL9NzqAnuSUkfJ0zrya_q02B23C4CSUA&oe=69BA98F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613414459717589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162771_1662887517339930_6434635039824150528_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3HCFAldWp4Q7kNvwE1I3_o&_nc_oc=AdnW-yb_kGTjBzl9Mx6WBFBMm5wDcltO8hxFUFF7gT1QWjYKSl9HC1DyG-T
mage.png", "id": "2521964144734267", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522276_1608785019139204_9148230832391979008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWQU1NWdS1IQ7kNvwGwBhXe&_nc_oc=Adk-7LbsMH-Aqfrdpe6C0ADkPZqIcVlX9aiH-HTRSutXJWW6ovs35QeUWFYEbA-6k0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuVyBBU3bMLwFXrxGnM4gtQaf5HEnjT5x9TF3eG_F1OHg&oe=69A2D0CC"}, {"file_name": "migrated_image.png", "id": "245112086520187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVCMCPNfdjUQ7kNvwGlLWqO&_nc_oc=Adk3QbCRlbl-das-vyaofRRIUpboADBT2PUhVR8YL7MOStyHtj8Ov-ORvDjjqW66iEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu071Gpc2PcKMnsaatYA5lD1mKgJeFsPVm8ErVjUoLfqQ&oe=69A2D355"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSUmPKuLcPgQ7kNvwGayOM7&_nc_oc=AdlDdqgbw_I0crFFlM4TByRkxfBWA2i2ZEUQuZCrzdbqIzsYAyKcArEJ40ujJHMxW74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQvPhqhe9c9HVA4F2wrAL3sJGEVO2dmmyJxa5XX1jz_Q&oe=69A2CE05"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX12QPVkwEAQ7kNvwFhgIzz&_nc_oc=AdlaNJiiv7MuEbEtDsM-IpuIsEeR6K8vxT_tAxLcxKfUt8Mm3Q5HqRP9WR2ndhXGDL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0yPaT0ub5FnGESmD0mF1cLZmkELnJMtQ5HhlkYBd5dQ&oe=69A2E3F3"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlspIxW7DmEQ7kNvwEfPfg4&_nc_oc=AdkRjZj4fYs4FMit9aAfi-8MJxW3zjNc69vuqLHrYJaWUFpE1lq5zceAeGXgWSDWxxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc6fg9PIENieOvXzA_p0ABpFN2Rnx5v87gN575ay0mqQ&oe=69A2DDF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
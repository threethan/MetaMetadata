5/12522276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oGfmRdhTOYQ7kNvwFn2cnm&_nc_oc=AdnU6JQkZRX1cC_wjyiIp5__5WcglB3jDMF4vjjegrruJzQUs-2VOquX6CI3gIrR3mU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1FoUSvjmGK8NBvIjSwI9K-0Z5_FnTfUVijrKtFjFavQ&oe=69AABC55"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8lg6C_9VmMQ7kNvwFESGNs&_nc_oc=Adl-KtqfnK4LUmXNAnPi95G44KKMtFlffBuRr4n8II98OjFNfUezqCpiL43UTIhS0LU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfweITEMs1BU9VjpK_QUpESI-7MfnOYUqNgyUtHtK9efPw&oe=69AAB705"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvBi37vaUSwQ7kNvwEwRzY2&_nc_oc=Adk0thGkEbeLbZmnbC-eH-ifj5vAthVZxa8zAN79jeLm2IyoMzSrlwWs5x2ZhywQvNc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxhzB4iuy9Bc4w1ChhwldNJnmsv74jOVGHOtOXL0rVJXw&oe=69AACCF3"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3G2eH-tWMMQ7kNvwGCt3p5&_nc_oc=Adk7NOSvA52HnGbYvP7ea6pmRqilRwHVyjTmG0NgzLlG-jJUeJZ_lb-WUjOmi4IdJQA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhHajgPa5yquYvYjL66raw9Tk7UTCunQ_3050nfgGFtg&oe=69AAC6F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613414459717589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162771_1662887517339930_6434635039824150528_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsgV2ImjUW8Q7kNvwENm0ZD&_nc_oc=AdksJ0SXfvzHaFpkAqaeLgO064U3IcPfCk9ZLOj6RZERInRjyjO
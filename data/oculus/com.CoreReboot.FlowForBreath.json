mage.png", "id": "2521964144734267", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522276_1608785019139204_9148230832391979008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRuKUf53iuAQ7kNvwEkyuTZ&_nc_oc=AdpTukr1cpRiBazMwTK4GJssXYodmstFZpTsr5A39YUPASDHXtD6FtEmOENK36loQJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1JSQQeY3CRbVnLaVeOvBSnlx63qvl2rwgM9plun0q9eg&oe=69F0D18C"}, {"file_name": "migrated_image.png", "id": "245112086520187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SlCuEVxX88Q7kNvwG0W5A3&_nc_oc=AdqMsq4j0rw7MuUqbhpu7Lk2GNuDDD_PkOKf3WYsw9dfzT_OM00-dNNKZ5ZXyMewhF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2ueEEfVrA49rW8WJyj90hm5TlhZMXmwH6Rxt2kB4hTJw&oe=69F09BD5"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRmLePcIZYMQ7kNvwGgPwPu&_nc_oc=AdqhLLmKrFCRJxmXp_6VfehzXoqJdbqwkf75at3RDXbB9IXgFSf-gGW-bqbigQErIMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1O2tBTEMLmoILF0DzXxmBo-cyC2tl8loCLNnG1sqL_iw&oe=69F0CEC5"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i369NbW_GDEQ7kNvwE2P5q4&_nc_oc=Adp8afUpREVDKH_4-Zsfhs1gCc8sjq0JIMsC9Y9I3loO7xMTmka0OPwmtPeqpY4i4Dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3ANMTDWe3OF8FEk57S59Xpy-R-JCPYpfm5jdlUecP6kQ&oe=69F0AC73"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWP7U3hARlEQ7kNvwHNulrE&_nc_oc=AdpoZOisu8aiaMA4X_kHoFKJ1KOl6oPWkTBV8elqbZKvw2odlR_yi50g4cO6_BYTotQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0KiLpPphAUM-THKuyulJqwIlMS3yBk6o2IweenaCVE6Q&oe=69F0A671"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
mage.png", "id": "2521964144734267", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522276_1608785019139204_9148230832391979008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UXmVS2lOEAQ7kNvwHTfF4w&_nc_oc=AdkOHs-Ee2TdSZpzcnptOYE-0qK-aCkg6ly6qjcizttZWbr1OasDdL8VrAUjxez4Su8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsthh70r87xIPxKoby32bBrNUKtEJwYDjYJycjaeyR9Tw&oe=69A6C54C"}, {"file_name": "migrated_image.png", "id": "245112086520187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4Gu0w52tesQ7kNvwG5m8VU&_nc_oc=Adl0K-MshdlxSj2R3_D0xDq_e88yk7cC-OxJ7vUJoS4f_nFvR-BF2Te32l-yAg2ygXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsVVxBo00vRD0TjM2fB5KBmOowUlLUh2VT4qpZm4-kTnw&oe=69A6C7D5"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDpehTuzVicQ7kNvwElWoon&_nc_oc=Adm4iU_JsZppHEq-Wsi8kg41zPWLFYGTO3qUkkXnOAHwNqRo1IWdy3EljpRQ8RuyMYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhSYYtBhVF8bxngC5L8dtwRxCkexkDfu3yybMbzqU1kA&oe=69A6C285"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0hpG55R0oQQ7kNvwFGipi4&_nc_oc=AdmtGNAjU9POF0bp2DrhJBfvJu6AYrrHhX_or9O449NnNgWegTEDE1XXlnrsd7G5xCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteFCymBObC3rpCx9ZH-x4L-25aCnTYIbV5IpFyVTcwtg&oe=69A6D873"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ijhiu6PH10Q7kNvwEYDGK1&_nc_oc=AdnFcEh7cBxv75Lbv4ENoAfHQ1spN9NpTaeONmytVIqg9h3v6k2kSjk9m12NM9kuaLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuelqyIAG_NxbbPjz3CShyJKRB4B8ZfdRpD0caNSivCKA&oe=69A6D271"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
.oculuscdn.com/v/t64.5771-25/12522276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w7RywuFqwUQ7kNvwEkwdMq&_nc_oc=AdoD8axtr__QnrT_YfFDoTTFK0Hox4lgl7W6Sq5YYf40U-cU2KhT0tHrgi2svofWvAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_IP7yUlZWkSeCpd3R2ifIaxA_Q-4gWSnTBa7mQgesUg&oe=6ABA8995"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7mqCJ3TIsQQ7kNvwH2M68_&_nc_oc=AdpMUpZCamohoKCetmE54W2dJjeKLnjO_KO5zHih_6iGcLcfBWc0LPo7F4wNudmPStQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbu76AtJzAJBemM8gQ7L0Aisc59gyto01MAa38i7I3_w&oe=6ABA8445"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1xptcRm1RIQ7kNvwE2ww8h&_nc_oc=AdoSWOXecqWccc-SfJ5W_UqKqeU6T34uXfxt4y6i-slhCU71WHydUZMmqY_pvOfXrY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVugkTPM9f8Rve3hdgCDbSaZw_cfP2B_ZAxgASs8EWOg&oe=6ABA61F3"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSv7rRaX0LsQ7kNvwHvOgPN&_nc_oc=AdooTwu1hC5RtlK7tK58JrclI-O3HqsrpRvy9k1KmxiW0hbYhD9OEdvrlKfHs2Mcjkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8H4b0okS6c0k4sUfE9JmnOMIADRCjVQnKtpLg5XjJHA&oe=6ABA5BF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613414459717589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162771_1662887517339930_6434635039824150528_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hjEfSBr6PYQ7kNvwGqEhxF&_nc_oc=AdoyUdJlGne
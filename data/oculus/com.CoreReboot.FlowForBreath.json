uyn1SUpOa7yj25p7-fN9UDCnzXAuG4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA2iXhtGzsc9qkM9TagPZhN1M2zsw8WErf3L1Hd4CAUw&oe=6AFB1DC5"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxQ2CgJb-WcQ7kNvwEb-I8z&_nc_oc=AdpvoH0SXxnebul5oMDBFpXCW3vB5hAvPaIz8-phFO5NMMBoykCnmLAoGl5yA97fa2o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC998gzaWE9K9F4cDR1v6pwYFoS3ZrVl2y7h_C7lVvrQ&oe=6AFB33B3"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeqAzzpGoRYQ7kNvwG6IOn5&_nc_oc=Adp73dsTXbEaqrbaNgGPpiBnXrMKmB-H6Id5Cu4rGzYVZAoPpyPXC8Ech5IAorDmdkY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjYxFWfGqFr8wHVwoIg2qvRbQL8welk7BtTcQdvvwnhA&oe=6AFB2DB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613414459717589"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "125794584641469"}, {"status": "PUBLISHED", "id": "381353945651326"}]}, "baseline_offer": {"id": "125794584641469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1494435600, "status": "PUBLISHED", "id": "125794584641469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1083307321797106", "version": "1.2"}, "id": "764961243657000", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1079794805481691", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "10833073217971
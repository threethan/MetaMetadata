22276_701266310051674_4033098368254214144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4Gu0w52tesQ7kNvwF_iVGS&_nc_oc=Adl6X1IMaepHNI2_FJttQmiWrxyx0Dj7_jFu9nw6uHPmjO4pjDOf68n9s_G5ygZFaFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftInI8AIwgqY4d7mxY7I9BgYCyX0x0AYA9i3tFDuXqNCQ&oe=69A81955"}, {"file_name": "migrated_image.png", "id": "211887406695850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504601_812616472222313_6121044234704257024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDpehTuzVicQ7kNvwFRaCQw&_nc_oc=AdmwWzaWUIpeda0hrGS374xd7Hrp1APGa-l545Cmm3qHPg4dRTfh37Afm5PvBIw0gEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsw2mVapnpDpuUBPDI8EP_lcz4zU_D0-9h2ougEzRA02A&oe=69A81405"}, {"file_name": "migrated_image.png", "id": "247818559716598", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522311_247584632370558_6354352381550919680_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvBi37vaUSwQ7kNvwHfK05K&_nc_oc=AdmylqOw1iRaQKpUnaKUMw9gh0s6NR3-FLeX7oaWVbJbuQ364WyTQHAANoRmXT6V09I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvKMYy_PLOH9vCXUo8laB1vOUf8SjKHP55S04PlGHQz3A&oe=69A829F3"}, {"file_name": "migrated_image.png", "id": "668476670569937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482153_1858067167798991_7217008734889836544_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3G2eH-tWMMQ7kNvwGku90C&_nc_oc=AdlIkDAHkg2WndErhg8MB9pWWRHPKW5v-5pwXAejBoqmi0E5GhNAMzRE6uBc46soIYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfueI79e1YdNpvxCz7wDuorY2GOS8yzZRJaC2mbceWeEMQ&oe=69A823F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowForBreathVR", "keywords": ["Relax", "Meditation", "Calm", "Flow"], "long_description": "Flow for Breath VR is a mobile VR app that will help center your thoughts and calm your mind through deep breathing exercises. \n\nDeep breathing is a natural tranquilizer and, practiced in an all immersive environment, it has far reaching benefits. The practice of deep breathing has the following benefits:\n\n1. increases serotonin and calms the mind\n2. helps expel damaging toxins\n3. lowers heart and respiratory rates\n4. lowers blood pressure\n5. enhances mood\n\nChoose any one of five state settings:\n1. Happiness\n2. Calm\n3. Focus\n4. Energize\n5. Core breathing\n\nIt was researched and created by a clinical hypnotherapist and mindfulness coach to bring you a quick and efficient method to shift into a state of balance, flow, health and focus with ease.\n\nChoose your path and be on your way to deeper breathing effortlessly. Like sitting in a hot tub with mineral spring water and soaking in whole body wellness inside and out.", "short_description": "Flow for Breath VR will help center your thoughts and calm your mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.CoreReboot.com/", "developer_terms_of_service_url": "http://www.CoreReboot.com/", "publisher_name": "CoreReboot ", "support_website_url": null, "website_url": "http://www.CoreReboot.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613414459717589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162771_1662887517339930_6434635039824150528_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPQJIkQmup0Q7kNvwGJRlV-&_nc_oc=AdkaTmg2EARmNoy6yUCeH6PzEow6PR3E8bWGLMu4PKnAQmEQdy29d8mTAfA
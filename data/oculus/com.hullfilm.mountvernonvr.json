 360 degree panoramic images that you can fully control and view. \n\nTour every major room within the Mount Vernon Mansion, and see the upper garden, kitchen, the Fred W. Smith National Library for the Study of George Washington, and George Washington's Gristmill & Distillery.", "short_description": "George Washington's Mount Vernon estate is one of the most iconic homes in the world. Now you can virtually visit this historic home and plantation in vivid detail."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": "https://www.mountvernon.org/terms-of-use/", "publisher_name": "HULLFILM", "support_website_url": "https://www.mountvernon.org/", "website_url": "https://www.mountvernon.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9348831788466869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984471_1093753065253141_5668006244769131369_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpXFlvOh9uUQ7kNvwGgnR9E&_nc_oc=AdphMHPZptfWl0y6ACgz33wgJOFNvzdBEws2iGdmwLQ2lZChI-diebnRnwSkC9PKmh8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIikXpdwKbLlNariaPfD-zdM2VtBT_GWU71cp911zNtw&oe=6A857F30"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
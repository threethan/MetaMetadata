_ss=7a30f&oh=00_Af3Or35-sgHuwwIQcv97nES3uatCw5rXsGkmCzRDqPgumw&oe=69DE510E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_htoQPHlnWwQ7kNvwGQJVFJ&_nc_oc=Ado_XwHsMbpdefCLaC-c8zVjTo8jFfCdwtiVOdJlgofDbk68f8ECnPCaU6xfe95Fu5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14o8gOmOaG7lD1ZTnEE1a0--QsGmt_wRry_gd_eNBg1A&oe=69DE3F7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX0v6cbtsIUQ7kNvwF3Hfws&_nc_oc=Ado1ASH-xx_ooMwykJxbaJ2LuyWMl8CzTCqaEMYL37jsw5lFazCmzcn_SbpR7Y6Gmqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_9BI9N8IBoNM-vKnkYppeXHHP56sZ3Q9AOUQ6lFPgtw&oe=69DE224E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy
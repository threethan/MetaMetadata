D3yoQy5iHpeqkBrPW89Oo_c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHupdKCg9lRw0trPjhDUio3catX4DOoWAgfcs1jAV1iMQ&oe=6A973D55"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI2ULMCKKngQ7kNvwHjsWOU&_nc_oc=Adocu_gJ5nOvvndVmxwXRxCSSiIVfmyucmEDrE2qjvnrgxiXTn3DW_05GRT9_tx4Abo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTWiqukW-2CR1_Yub3ER8ZHARbtYobYkIY33G55nx3dQ&oe=6A971B4E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Idml0JJjfwQ7kNvwHQnvtY&_nc_oc=AdpNqIzKTnOl6f7ClJfPIyvDkn3HPFkUpko5cPaMRvYM7LfuSReR732Xy9ASc_IvSbY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVNnE1GF1DZ1Oh_FbSb-BSbxyMs0BstmEJrX0kWkZUog&oe=6A9741FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRMH_D2fj5UQ7kNvwGGn7zg&_nc_oc=Adrz0c1-pdmx5rffla9zQF4Dwm7xVh6zor4iLHZ_l3W5Nd8a-7WgwGRd-5Kz651m-Og&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIO_Re3YstDmMXVWb8GKmKVt4mM5u6oDWDpck6le16YA&oe=6A9724CE"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3iJKVAKMqoQ7kNvwHF2m-P&_nc_oc=AdoKu6C6TXBPgGJe2oVGjahnhpO_Kvx_iHCFeLTuUXUBrOn2Nlp-dqACtAK7XXyExb8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGyPmS_yiFYLtDW9Gc7WfEMU5C3CYYrueI_e36tvK_Cg&oe=6A975108"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_cate
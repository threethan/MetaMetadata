X&_nc_oc=AdoKNu0sCKNpRNNbFGcLOC7nBFMe98M_dEItkCCWZGUXSjYNu1UE6adzMllk0JxzkyE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pt6XkEnLD1umfMO3jlbfZ6YxQO7y_pGRWK4lMsskRxw&oe=69EF748E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I34a2M-4st4Q7kNvwEQcqjU&_nc_oc=AdqbVxB5-Dqg7fiUvA4oPOTYCfMqwdwpKq_IgwIchh1nBC1jtgo_FCPp3GPf_krMq8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J5FCsSUxywr1w7MSqgEvMWudAFWRM_jNU0oF9IfcgvA&oe=69EF62FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTj5FdLwK7oQ7kNvwGI_vgk&_nc_oc=AdpqJ7vRVj9A7tUlVPE54KYxvQunCJK7GvwFHMhIRM29UxH-XOk0SXA71TVUwY9pkwY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CR_vr6ruHJKn7NNiv8_6sT7WClEi2D0WRd4JQKOlsfA&oe=69EF7E0E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and inter
C&_nc_oc=Adq0yVBAsLvlU4yN4Aw6MPHt1GZq3cr3zWoQTaBaLoF7sG5pih7TzuJIDqLC4pNUg04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pN7_e177qGGpxQ9qpKY4zvrkNuveipmfiBvshOVDFPw&oe=69E8DD0E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHG-BbGzI0wQ7kNvwHKspgp&_nc_oc=AdqkS7b_PMtmrLX1a-uxm_rfuAn140lhjA6jyLKGS7QXYJ6nuqSDi0ss1T1Fwfa9C9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cdZA26S6HDN3oHYmktnHld3OSevGQz1ti4u55OK2zIw&oe=69E8CB7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgoCfuz5HgwQ7kNvwHLYDQk&_nc_oc=Adpp1kEUtNr_UjiCuvXmOTfu1KUUtGCvWOoZBl1Pa8uDGASW_n5V20KYGtlXnH844TM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UG2c5lN1lG6D0_1U2eELqhLwMEw5MoXZ0prBRJ07rHw&oe=69E8AE4E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and inter
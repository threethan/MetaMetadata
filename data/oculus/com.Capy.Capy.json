=6e7a0a&_nc_ohc=PPxTtuv5-j4Q7kNvwHYGcvQ&_nc_oc=Adm48KDpL7kXjWc3409l2QZz-C41a8xFKvWFo5NHfz7mgMVI086GWw6W_2Fx9JY4lP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNEqg0kIfExXePB76LDvF43yW1BHJUWxPa38mGvBVAzA&oe=699DA5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLFxw6iIbVQQ7kNvwF2wsdd&_nc_oc=AdmZ8xUX2FzCgoClRrkEqslaY2HFUxDtk7Hq3VKM9RBqyPhh8btWHPFVHZUptgdEVyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrwHFsuJKfddHc_qjxbojLpxrTRH-ieLm9pdnkq5ocmw&oe=699D88CE"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2
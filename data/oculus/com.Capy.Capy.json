=6e7a0a&_nc_ohc=Dub9hcJOH9UQ7kNvwGcESGG&_nc_oc=AdkehN2eQhyPHIiQYzoE1mnhZThGycqjG-PjEJOFsrN0fLNul8i4uW7mSSA2D3LCeDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuy4tuX5XoESBX4g5Qckc2XdUGburPD2XwO4C9IX-ZorQ&oe=69A2EBFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoqL_Y4NIv0Q7kNvwGH9ifw&_nc_oc=Adn6PiKR-kR9nJB3v7OcoyZRny6S6wsn40lAj_H2VHA20gvxybPpCEsOnHySkVpmfm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSbXT_9jk_JaDGJwRekAtSL2Aa5rSVheDx-D08e05UCg&oe=69A2CECE"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2
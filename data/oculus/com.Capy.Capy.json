t64.5771-25/39035380_487325790287317_743156636826703439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hC36k45krc8Q7kNvwHHG1Fb&_nc_oc=AdlO5JEecE4GF6m75YRFDdwClb3C9W1I1YJNRve2ll3KDp9Zp9_In3gLgHkSXr3_DII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvJoiCVngg7wcyCCpFSbONQtAB0r5udowtF9bt6jkvkDQ&oe=699AFE55"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_wq6gJQ6pUQ7kNvwF1TS78&_nc_oc=Adm4wLt4MsOq39tcs22N4G5JGRpGzAPUz5snXF7Xs8R8LR6S1iJXaBtyFAquomiLrCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs85-HoqvYokCzRKV0lGSGPM6zGqn2BUf5UCXr5CkE57A&oe=699B148E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPxTtuv5-j4Q7kNvwFewIQa&_nc_oc=AdnEL-uogMEAwBDbUCCul_lf2a9ZxDAt7RXj-Ry6xN7qCkU2po37Dxse7nVpF9dC194&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsWCCXpPWVI1vNrfJ4VpfueK6rvHscd1pJ7MzdW0ovA4Q&oe=699B02FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7518910234871358"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "196821590192894"}]}, "baseline_offer": {"id": "196821590192894"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1716305460, "status": "PUBLISHED", "id": "196821590192894"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7523865867709128", "version": "0.1.1"}, "id": "1110617466702442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7505917049504010", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7523865867709128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name"
02tP3A_xMg&oe=6A256BD5"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ1KtNxM5KkQ7kNvwFpOwxM&_nc_oc=AdqzCjiaQE_SMg3L0dCxica8-fupk8m7g-VmoH0bwSlrmsQUKdVBiSizK3wl0-ATFU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WQIScbebmCHSIqp1sqcS1bW3TX-e9jT1FObyElu2IOA&oe=6A25820E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJMw55GxHI4Q7kNvwH6x-Ai&_nc_oc=Adpo22xKXEpO_g_4VusSXjlGfHrUWG4lCIe658xFvGb_hoH3LTbb60QtwEqb0gMZ8Ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kqVyZwQdjEWd3fQmkYo9rNTkhlzODSkNV3chYgd-c8g&oe=6A25707F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYYGnkh2oXMQ7kNvwEKTx0t&_nc_oc=Adp5QIObvPPWB0BKJEFDnVtObmgaqPSghTIoL_juydzlNQ0Q53nKt3Qro13APUSJFf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i0kR2jg4PJYwktpqRTXVxQFmsjeQXeCIrvzbHiPHeEw&oe=6A258B8E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuNYVvF6DfUQ7kNvwHtJVN4&_nc_oc=Adr8DBsDAAXtcJ82xLrlOzqpqhvJE1aCE3J_3BJZyD3Cfw1QvoAdvkYS9ZIahWNx03s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oya4EY6k3kwxXnop922cKhLEoHFx2_4ImNpSejIu_9Q&oe=6A257F88"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529
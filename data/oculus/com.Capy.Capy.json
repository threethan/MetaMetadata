PY2wq74OkqBw40ifPe70hEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2w39fUnJESLqNcLmpowft0Q4T4qToS29KIoNd36a20w&oe=6ABFAB55"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKfk2X5FnOkQ7kNvwHQXGAg&_nc_oc=Adokj6jd9G4U1bToXNY-ut2PZXjT__Rm6X6loJPNtH83mQz2PDJYP8jx-TUTh2FtJDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgR0VSvzXwoku9AQ86MsDSxDkn10KeoJEqGuK6NU-hmg&oe=6ABFC18E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je4i6I6Mp30Q7kNvwEBhdUO&_nc_oc=AdqTdomwv_HWlBqWvrnjRssp00uM-3hQwrLa2CZfMwaAzkVYJRNYo8Xl0ZxAOP3vi_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4VqP_5VgrlbHCMYURHD76tFiRZ-S1WzbsdPYVJUS3EQ&oe=6ABFAFFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNxCX9HEuBAQ7kNvwGcgISn&_nc_oc=AdpQooKXcRVi8tNXgBQ8DsonDUAuzCcm5ase2Z9SUGHaaSnQw1NYjTPpCDtnmiVOwJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsR7ClxDAiZuuoLXjmQvWtjMlFK8uDHJeGnV5l5M-QrQ&oe=6ABFCB0E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgu1WY48MJQQ7kNvwEe2b4D&_nc_oc=AdqB6wSU-LDD8vk5UNdQlBCXF-wFMGkpHlN6bWc9xja-qBwshCIH8gxDh45rwzakqN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQS4vRyxGmKj8vcD_l7uSyFPpjQbKDcJ_uBNoFhguWKA&oe=6ABFBF08"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_cate
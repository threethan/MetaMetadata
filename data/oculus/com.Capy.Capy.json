ekr7vk9HoEnpL6VnvcOyaeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt3whl3svJ7_-RnfN19Oawwezmf52mBfkCZyycEgA1wg&oe=6ACFB595"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZcMwKvxoFUQ7kNvwFkv7cr&_nc_oc=AdpOvtBSLh5X-fIubNWBJQPUeEx23r-Bam_hBekWcvtS65Q9mAt37P6uhQI-BLXPmlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAB8MsN15SBAg1CSQAEthDODcDGSP3siMq4hJvpA7SvQ&oe=6ACF938E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSX0D5xRIW0Q7kNvwHVQ7xn&_nc_oc=Ado2R-DhZOOLI8DQf7JLjxUj_zQbpeqkd7KNpF8YlE8fPkNKy3WcpsVo0lQa9G1aNgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlI3d9QWA7xKnyXz6hGtsU30YY7BjRPRh12-7QOEOaXw&oe=6ACFBA3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulaDL4qWnzUQ7kNvwFw8L2L&_nc_oc=Adq43n0PCwK_6hxZxf6Sq3_EbV4LWbqrLDwu6pSMYgD7a0sPbKcgYB6pt4gAZaW0sjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX4z8ahTc27r29Vu3QFgx5-073J3GLIRJisBsq1SmH0g&oe=6ACF9D0E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF9PP3__OHEQ7kNvwGPA3P6&_nc_oc=AdrOVC61Ih6q0dID5CEHDDSdbgUqUbpCXvTKhWa0UbozWTnwYjeb98EtzoV6NlmIoIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLB4zJbCKIAjF3gTuoOjq8_ClZe5Fy0aPvXd4fcEW84w&oe=6ACF9108"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_cate
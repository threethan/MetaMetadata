IKulO0OHrZ4Zxi1BLuPCY78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZvGkBCk_GQL8MRo-3m2mcrymerTuaWimiIAhouXAajQ&oe=6A92D855"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXe93cGsXpAQ7kNvwEQFoRb&_nc_oc=Adr5ET68O1s8TaFTjQuAVSUE3SS20v_l8F8Re1vr_QTFkQdngeDJhD9_FQEO_wLRo_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEerXhu0rDKcZkCSJw_wOjZx6xO5J8XqN9xjFM1E1PhPQ&oe=6A92B64E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtsXW_X_yOMQ7kNvwHI37O_&_nc_oc=Adpjj7QxaoNRYveFglEldVDrm4k39Q5AlATArLNDoww2-QVZydoIjZQO4vCxacpUD1w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbSOatGfY-Tz051GA74pkHy_Q1Gdvco3tNXrNMc20fPA&oe=6A92DCFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NynucPiqoskQ7kNvwH31mq8&_nc_oc=AdqzgixAb5rDQ69po7R8uZ791iosuJXuFgBt2I8EjfL9-UEUZvczfSdmP5eYaN_aTFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_4vg0JMWnZipD6Z9QEMWxtG26fM67YeUXOfdCE0N0zg&oe=6A92BFCE"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On6CNKsVBgcQ7kNvwE4nTam&_nc_oc=AdpIuNNWXLhNc55ofPMuC2aAUstrXijuUncsDecl18-HjLqbe8CMcuZ2wNUXqxkG5RA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlE2d87eU-7ktNBZh9gok2VxSinFqtsTdaP-x123htiA&oe=6A92B3C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_cate
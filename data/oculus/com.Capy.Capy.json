vLNmyunW3g&oe=6A4E4A55"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBUVjShlAjAQ7kNvwFpWQ8C&_nc_oc=AdqQIROkb-g427pD2fs0id2nPCa2wqzSveFBbmGBtxgq6Avmbu-y_CkMFVCt_6z-TIw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcwMrJRqfpqMINXwO-UekQZ_rJ1Uj2hf7nR7WyFlkP4A&oe=6A4E608E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3_Ki81gVecQ7kNvwF1gZ1T&_nc_oc=Adr_jMhcMh0OwAkyYWDFu9HFN5DsfphO_xNSrnIXNieSgm0QtT4F1AdYwIa8rBw_e90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAOLsCjy9weRWfvO4QIcB63FiPr1i1Ww1XzUgS0pRv_w&oe=6A4E4EFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ7tFHYOpZwQ7kNvwGuRVB6&_nc_oc=AdqHQFWAAdzk0vmFMsier8sWioXVlt4pjEAyZlOBOAb806x1qk_P9z5m9BsZ1QrQDjk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBROeBwZr4ngXW1u57bTUQGXPkmVZ-W6191aIgQaYDf5A&oe=6A4E6A0E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE2JUPliqFIQ7kNvwFTzFby&_nc_oc=AdprED-e3sVAdVQ6SXnGQgSaBsgnKaQm7gHjDv3uLNb2WfAOGFt5yVrl6RvjT1flo8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK3iwn1_8IvAB-da_bie0lHXCvlneZZCnIcCGYtSetUw&oe=6A4E5E08"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529
n&_nc_oc=AdppbC1fYDAQsOHJJhsXmxoT7FeOWXqlRIsYhUy9sjpHQ9gorr-B7NqBibBYASRDfew&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gqFeaX_aXcu8hgb5SiH1qKERSHpD1oxt090fxONAcvQ&oe=69E63A0E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHG-BbGzI0wQ7kNvwE-O9kd&_nc_oc=AdqA-6pZK2JE0MIuYhF1TukSbyeqpvXcS_Z1zWFwF8Bqg5F51tR9v-qcPFCI_l0GVGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_5v6MSQPvtO_6WlT5oCxU0dTvLKxutaw5n0zF8liGgg&oe=69E6287F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ5FVe_THiIQ7kNvwH-x-2c&_nc_oc=AdovtJauzhYS1AlEZ0B4CuXIVZWuLCCIpUhL1ksw2IbJwgj6VouoAE8Ue8c4qvP2FK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AMKKxaLN3ckL9v8KPy1Zsz5HsveYHyb7MsykAANOEbA&oe=69E6438E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and inter
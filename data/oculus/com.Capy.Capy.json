984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035380_487325790287317_743156636826703439_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Z9K_3fs90Q7kNvwEJj1Yr&_nc_oc=AdrZv8xwuUtxeR-TDmd2NJISyBgKMXC2VyMXA7IMpywevp3AqJ_n54ieXj55RlRRSgw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaBaMaORoVaFF02ippzJfEM1cpD8AIE3KOMogIGqymjQ&oe=6AFF2B95"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pREQ3_Evyv4Q7kNvwFXgdrE&_nc_oc=AdoeJ-MUyYbmujkfWLXZHll0jU-wXh0-yim9qLngeVP-QXAKOeXoUVDTvlowhL1Qbbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqVdRPthrKDyRxR89mu2NvWegmQGrYGZzjKmSTCmd_5A&oe=6AFF098E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJW_yG2FQDgQ7kNvwFlgZOZ&_nc_oc=AdrCJAugnIJmM79NlaFIs3YEJ-G-WLnaqNWNKUDZK6z8qP6rx7pz0eGPuWJtLijh83I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQauFsGP7FAYnG2QCWKALTsXfCHTFBfnfwqdUyLhsSDYg&oe=6AFF303F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEGfsGRhsbIQ7kNvwHfRkux&_nc_oc=AdqcrmnJi1PTIQanb_5g6Ib9TkzQceOjYlvW89J1kJephPxG-zOKPg2uVocWniEphy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_qZMrbFkVASyjCiYechiXbI0OsyYyY0yciynr-IZmLw&oe=6AFF130E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Kh
nm0K84bWqw&oe=6A5CCAD5"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_S9pz7v4eAQ7kNvwE6KYpt&_nc_oc=AdqfSnTkYgMnWcEMkE0vpaaNy68i5gyeLw9mJK7GzdaOgXWQgStRDn4AUbri571DzO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHWQJF4DJDdIg8S6WusyD0j8jsk8TzY8Sn0qT1A_WS5g&oe=6A5CE10E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC_Oht-bqeUQ7kNvwGJvq3P&_nc_oc=AdrsnEyRtBD65kFgdITOTM9pux9G49JxAbHQYAqgzt4PnIfPxI-pn4xRCd7yzKCiEgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhmKCOQP-vwR_ZFX0cUEiJvSyqcdlD6N78LKa1ait97g&oe=6A5CCF7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4FciMxkLgEQ7kNvwG7QtKE&_nc_oc=AdoBxU-MqKImnU6RJnywUgoiYLTRdJHeNlkiepNbNfQUQ1Y6Q2jkeFugb8uOgc-Vuv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvK2ukZBY64ol4G4O-06Gr_1jgFA7dWazLEG5W9HpwNQ&oe=6A5CB24E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\
fWoFk7E8Y3_g&oe=69A58174"}, {"file_name": "ss2.png", "id": "487325786953984", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035380_487325790287317_743156636826703439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3L_cY3SUogQ7kNvwH5J2pu&_nc_oc=AdnaghsR5gfNmFtiXoCkau-kz99yfgJwBaWtvxR3LhI83EWE19C3HSu3_nYxOKkke4U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftAzJX08qETvKlJZQKj9P04yLxZFp8EPLVCBl8R4ruAzw&oe=69A58A55"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8758A2VmAIQ7kNvwE-9puM&_nc_oc=AdnU02w_jlTAtqvxVdHJtzsDJsin2Bix_mWyeNjljxkoo6XsR8r0Ip4u35gNaX-8DoY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftSQnCfWPECP_sKWpZpft0-VAh-RX51ZpbXlfLgWEwkkw&oe=69A5684E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dub9hcJOH9UQ7kNvwHFkU1m&_nc_oc=AdliFV-A7iiW19Ttmu89UET7kDVnmRYtpHbm0DBQeDjNE_hlZ53-QJgEvAtELE_gTbk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft25WGMmo93jPbOjIdYifPlluhPA6W0fGh8gNyhiFVHRw&oe=69A58EFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7518910234871358"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "196821590192894"}]}, "baseline_offer": {"id": "196821590192894"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1716305460, "status": "PUBLISHED", "id": "196821590192894"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7523865867709128", "version": "0.1.1"}, "id": "1110617466702442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7505917049504010", "is_concept": false, "latest_released_binary": {"__typename": "A
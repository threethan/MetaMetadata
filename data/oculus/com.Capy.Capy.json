_ss=7a30f&oh=00_Af23SKxdNBPF4yMmLJGA__rvT_soBjkpTGw8uxhgBIHKXw&oe=69E0F40E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_htoQPHlnWwQ7kNvwF8f0Rc&_nc_oc=AdppnnSbxTS_ZfQxB43rmGbebMSYCW70dosNirUJwHIH1EB0nOnX4WOYSWZvMn7x1SQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kRkmjm-6gVER_1Uf91ra0tG8qHLQaOlODOSWcVTu1Zg&oe=69E0E27F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiPgZEeg0AUQ7kNvwE3O2Wf&_nc_oc=AdrhgtADtpK14J485NSbT-LQ9DwRn9PdMRv_c64mPIWAdslhh93XfOCWs12rYwEvLw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VzZKBCg1w9rFXEazzHMyQD2nanAXJ-QFj9ANAsoz6rg&oe=69E0FD8E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy
B795"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I82SxOhDnrsQ7kNvwEVek98&_nc_oc=AdrN2_259aL9EF3bUoTu6xAOVKAK5Cp1Hb7lag1Bg6CEaSFOcLkDSGiNgpcFJ5MqxOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBhZpRuoxlyxEE7qz5dqYwbT57GPmqTZkLY1h7INZKLg&oe=6B09CDCE"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnP9ZY-IQA4Q7kNvwGdg-X9&_nc_oc=Adr5aQIEMMZOqcz0NzoJs7V2Khhi5rgHUVZeTT0cCKik8pi95xIpy8k0c5JoNw5tIUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf3dI2FnBmjaT_G3B0WdCvbp5UWWuNTcqT4wDuX7U7vg&oe=6B09BC3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocst
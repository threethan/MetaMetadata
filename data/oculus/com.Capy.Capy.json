mYQAUo-9dQ&oe=6A5F6DD5"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YXoSTRaDsUQ7kNvwF77Wvz&_nc_oc=AdoVNf8eX0zBfLJ3uoUwAcVYAoJ6LwAciO9YpwFEe1VbCutWEw6pqztlOOjrKmzx9ZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdwYzgnh4bEQ1gHOEGse7Fy7TXuvybSSnQglYidL4I6w&oe=6A5F840E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC_Oht-bqeUQ7kNvwG3ZOx4&_nc_oc=AdosNQBTYRx6ROINYS5RvBUzXFj4lBvkre1ZWoUIMdN7v38FUgk8X8TDanQ0RWQ5HzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs9h8bYJG0LHevO7vJx-lubBSAYGpJr7pzN4OKBe0nOg&oe=6A5F727F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capyherolandscape.png", "id": "1104667157499303", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75542958_1104667160832636_8737034789958696015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaXRjU6w0_YQ7kNvwEqPElb&_nc_oc=AdoRp6n3LkGL8Azx2StS5jVLMJQ6xbuozMEr7YY4swcTQd0-fTjwpVXJjhS1HlZ15-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl1jtoHszjJr6N_xXsl-kiBW-EEcszN3GHXcA_j5DcDQ&oe=6A5F554E"}, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7556290411133340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_413085501546068_7259603202275287226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61dwqd2zwoMQ7kNvwGWC-cD&_nc_oc=AdrB05ncCoghJx45NMdD6yebgYqUaosw7hdo0tQ2x9ufD6M5Gy_X9vb8L8gCg7XEx4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgoPNQLn9AG1CfgYtzHAcgnmHLGAepXSG2YAMbDbQnYQ&oe=6A5F8188"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Capy Oasis", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529
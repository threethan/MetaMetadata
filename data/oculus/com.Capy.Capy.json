3715"}, {"file_name": "ss3.png", "id": "495533993046120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570291_495533996379453_3498398816927922099_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzOZ4Ew5jukQ7kNvwGUu3UL&_nc_oc=AdrBxJMOT0oIJubK0_NYi90ncCD94BX-wSMSDZ4epO8_8DkeEEZxm8Y6dwHtvf8hHII&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeY0a81Dc6TAXWMzKIe4XNq4IA5UE6DI7to5JQlVHDmQ&oe=6AFB150E"}, {"file_name": "ss4.png", "id": "2167793816917307", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75530717_2167793820250640_7955545426742716187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FXhtTpECVQQ7kNvwEhOwSH&_nc_oc=AdpxBrq_aZPa2_R09DmQrBai68NXkXwxjiUfnfU4pY3pQ_V4VDSSOFXZ8UKs6S7bUG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0TMFM5WCIOdXyzQpgufqNDZ78BPWlOOrRwf3NlyDuPg&oe=6AFB3BBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capy Oasis", "keywords": [], "long_description": "Welcome to the Capy Oasis! Here you'll find yourself shipwrecked in a paradise filled with some of the cutest, curious creatures in the world - Capybaras! You'll learn educational facts about these critters while you interact with them in a rich, immersive environment. \n\nIn the Capy Oasis you can : \n- Pet a Capybara with your own hands! The creatures react to your touch, the objects you play with, and more. \n- Learn about Capybaras! There's plenty to learn about these friendly animals, and Capy Oasis aims to educate as much as entertain.\n- Unlock the mysteries of the Oasis! This mysterious oasis isn't just a Capybara ecosystem, it's a living world with puzzles and intrigue. \n\nCapybara Capybara Capybara Capybara, Ca-py-bara! ", "short_description": "Visit the Capybara Oasis and interact with curious, friendly Capybaras with realistic physics and sounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocst
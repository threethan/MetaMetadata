aMeta : VR Karaoke KTV", "keywords": [], "long_description": "KaraMeta is your VR Karaoke Box.\nSing various types of songs, adjust the Sound Stage, Vocal Guide, and Pitch as you like.\nPlay Basketball Arcade Machine, Baseball Pitching Machine with friends,\nor just mess up the party for fun.\nEnjoy a romantic night of setting off fireworks by the pool.\nWe update the latest song list.\nPractice new songs and show everyone your singing voice!", "short_description": "KaraMeta is your VR Karaoke Box.\nSing various types of songs, adjust the Sound Stage, Vocal Guide, and Pitch as you like.\nPlay Basketball Arcade Machine, Baseball Pitching Machine with friends,\nor just mess up the party for fun.\nEnjoy a romantic night of setting off fireworks by the pool.\nWe update the latest song list.\nPractice new songs and show everyone your singing voice!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.global-media.com.tw/KaraMeta/pricacy.html?type=1", "developer_terms_of_service_url": null, "publisher_name": "Global Media Co., Ltd.", "support_website_url": null, "website_url": "https://www.global-media.com.tw/KaraMeta/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24051842704411469"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
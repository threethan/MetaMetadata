tent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1092109656896133_4484028701254346517_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBrxM8laNWYQ7kNvwHmNsN6&_nc_oc=AdpvCtFaKSIYs9rj_UB38EhNT6w8GcXjep9GydzTCxjrC5kx-wQU2ziWVyfbKrThjTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5CWTll9WqDAAaE6f5xhOHgmv0R-c_0t0IaWk38ApPkg&oe=6AF72899"}, {"file_name": "Screenshot_4_feeding.png", "id": "886418871128938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_886418874462271_649555722255667368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xKjz0Z0LTwQ7kNvwFxp9AL&_nc_oc=Ado9zi0_Wqf46XXi_M_vWBI3IxmHjjwVOcma5OD1lhn8nFubd7LeQar9O-NRciPayqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtkanEzkvXNlJr-VvQLUB08ZDSvCySnGAmtW8gqroLMw&oe=6AF73203"}, {"file_name": "Screenshot_3_checkout_adoption.png", "id": "1656444815875591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1656444819208924_1046937247725440447_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmIea5O0IRIQ7kNvwHnGrS7&_nc_oc=AdpkTQFi089FQU7i3hQY7khY1FfacMOyDJadzQgCXKiTPOe9h8qXJLwHNQjNvA7dt_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdZEX3zRtN5dvZh7jNn7vlxnRTK-5UyIspkftHUF8A-g&oe=6AF72690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyPetshopSimulatorVR_TrailerCover.png", "id": "1746685463071323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1746685466404656_1343572218766906292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec8CUbqOq0IQ7kNvwGxba-I&_nc_oc=AdouvjaBMOx0OiE0I6FnjreEY8GSJLsyp0wHRtTrsf9-heLYmUGM8-3fFe7WLFmO9OY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNTTdrDFv7hqfWoKM_DgALNn_nR3nmdSMqA1WxKqT3JA&oe=6AF73D45"}, "display_name": "My Petshop Simulator", "keywords": ["Pet", "Simulator", "Game", "Animal", "Cat"], "long_description": "Welcome to Paws & Whiskers, the pet shop that's all yours.\n\nCARE FOR YOUR ANIMALS\nStroke kittens until the hearts fly, pick up puppies, wave a feather wand and throw the ball for a game of fetch. Tip food bags into bowls, fill the watering can at the tap and keep every pen clean. Happy pets sell for more.\n\nRUN THE SHOP\nFlip the OPEN sign and welcome your customers. Unpack delivery boxes, stock the shelves with food, treats and toys, scan items at the checkout and take card payments. When a customer falls for a pet, hand it over in its carrier and send it off to a loving home.\n\nGROW YOUR BUSINESS\nOrder animals and supplies on your PawPad tablet, complete daily tasks, open mystery boxes and level up. Unlock the Aquatic Wall, Bird Corner, Reptile Room and Exotic Suite, add upgrades like smart feeders and express delivery, and decorate your shop to bring in more visitors.\n\n30 SPECIES TO COLLECT\nKittens, puppies, bunnies, goldfish, jellyfish, an octopus, parrots, toucans, snakes, tarantulas, a fox kit, a mini pig and two legendary babies: a penguin and a panda. Fill your Pet-dex!\n\nMADE FOR VR\nHands-on interactions everywhere, a guided tutorial with helpful hints, and comfort options including teleport, snap turning and a comfort vignette.", "short_description": "Run your own cosy pet shop in VR! Stroke kittens, play fetch with puppies and feed bunnies, fish and birds with your own hands. Keep every animal happy, stock the shelves, serve customers at the till and find each pet a loving home. Order new animals on your PawPad tablet, unpack deliveries and grow your shop with an aquatic wall, a bird corner, a reptile room and an exotic suite. 30 species to collect, from goldfish to a baby panda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Game", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "cont
p can be seen on the Hx Heart app on mobile devices and the web.\n\nContact us to learn more about customizing the app for your organization. mail@medmovie.com", "short_description": "Hx VR Demo is a customizable tool for remote learning about cardiovascular conditions, tests, and treatments. The App is part of the Medmovie Hx (Health Explorer) Platform, that includes the Hx Heart app on mobile devices and streams 3D models, videos, and images."}]}, "developer_name": "Medmovie", "developer_privacy_policy_url": "https://terms.medmovie.com/privacy/", "developer_terms_of_service_url": "https://terms.medmovie.com/apps/", "publisher_name": "Medmovie", "support_website_url": null, "website_url": "https://medmovie.com/hxvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8965492463515617"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974561_997197321198445_6659960743147170707_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5H5BmjhimkQ7kNvwGrZ-10&_nc_oc=AdrSY80_nljiLPWGlRIb7jyAYqE9LPYzHiKdr3f0CyNanlRBnxTBQFwfe-pYp2-E088&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af06Y6Z7-dVW5RYIKlf1flqxkX3ay1lStRODmp9ZBA3ghw&oe=69F1E680"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hx
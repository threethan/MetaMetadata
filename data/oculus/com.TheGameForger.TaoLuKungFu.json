_ss=7f20f&oh=00_AQR2dN5irDFvq_dvckaYyIvWoTmK21tZQy0wfUlnXAhoZg&oe=6AFC97B4"}, {"file_name": "CoverImageSafeAreaTemplatePortrait.png", "id": "945527134922702", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304952_945527138256035_89697317871150666_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOs88VhBmaoQ7kNvwGw2nzD&_nc_oc=Ado7LDLs_2VHCxtYLYsOVRAQwAw8Tq9RHn2xrdf6G1LZl3n7GCIp-h4sfzZfMw8Hukw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoeFwVb2B0GBHmfBQMbzA7Kkhg_F4HXfLFb22Mp4OZOg&oe=6AFC5FE5"}]}, "id": "1677737806706786", "locale": "en_US", "screenshots": [{"file_name": "Hall.png", "id": "26268386106177869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308349_26268386116177868_3790577828981367266_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB1qllHehtgQ7kNvwGL0iAi&_nc_oc=Adq6Y3Z0TLZeeWJ9TLxgXE8Zh8cVSt3hosu0HLmzSth0R0pdDKGav8SSD3TUnIiPnes&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCTxf4IXtJQFUjBgo0R8Spzu3_Cf_3h56dK0ukhos7Iw&oe=6AFC86D7"}, {"file_name": "survival.png", "id": "1265993109031009", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1265993112364342_8908061190987466746_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB0yZPumhWwQ7kNvwGnN_rq&_nc_oc=AdoRxhsV7qMciH5M9Hvr5PTYRhPVYY69jI1ujYcptJa9OZMVpzjFBZc1UF2yz0tbYNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiPBVbazFn8ivI4ISjEYrkSEqrZ-WYtYg_O8N-Wvi1_Q&oe=6AFC7298"}, {"file_name": "Time.png", "id": "1490488879381259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296077_1490488882714592_1057244468047100056_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPVoIVEEmVwQ7kNvwGJCTA4&_nc_oc=AdpATl1z0mtwX3jOX_MG9KXwIUO9tesBzRua9SAV82xhtkyCpLOp-RJnszUldhVXI0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNxoJ88Jlo7-laQEo_VT19f3uxDVrH2jXM-COi75yepA&oe=6AFC6E2B"}, {"file_name": "3rd.png", "id": "1708387087248657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1708387090581990_3885461583002837473_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FStz16NK6qIQ7kNvwGa_jq2&_nc_oc=AdpstvYHpVt2yPDgSoH-ZdxJgap08NRBJ3kSSSzMqwBXjXPBksxaJapXoU3ztUY1V6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7XQX-k5Eye4aKHHc8X_opI-f8ZesxgyNWjGHGSN-JVw&oe=6AFC66B9"}, {"file_name": "Tatami.png", "id": "1283818910526525", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307435_1283818913859858_7411468799351658909_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HDbMZTEEcgQ7kNvwGMf9j3&_nc_oc=AdpML_AiDSIMiacECow1wIc6kUJ1lV-sLxGEYooS5q36g4XHlT55Usy4k-n1nLlpR7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBXt0LciWA10bF-lXVYzVNb3NhEo_DqOTYsALIUnPOTQ&oe=6AFC8612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Enviro.png", "id": "1406236798004582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298712_1406236801337915_3646722369979900216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JOZ4XOsq1MQ7kNvwGRrkr3&_nc_oc=AdorN9bzdKtW9Mi47M9atYHsDzVVrYDsr2neHjs3kcgENlnyZtq5vEWGtcHsAPmB59U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-vSrxbGU1YKFWa6E7og8zqKgyLS_5Zh8ZvCf4woGwRg&oe=6AFC6ECB"}, "display_name": "Taolu", "keywords": ["kungfu", "martialarts", "fitness", "vrtraining", "reflexes"], "long_description": "Everyone can practice kungfu! You want to train your martial art skills but you don't have a wooden dummy at home? Play TaoLu in virtual reality anywhere and anytime you want. It feels almost like in real world. But you'll get a lot more fun.\n{948117578129586}\nIn Taolu you'll experience one of the most amazing tools used in martial arts by many legendary kung fu styles, like Wing Chun, Hung Gar, Chow Li Fut and Shaolin, for well over 2000 years . Feel the real deal, but without losing the amusement of gaming.\n\n**5 Game Modes: Time, Precision, Survival, Wing Chung and Free mode.**\n\n**Time** mode challenges your reaction skills. Enter the flow mode and earn extra points. Climb positions in th global ranking.\n{1798458964908886}\n**Precision** mode alows you to set you own pace, but is more demanding on precision and hit direction. \n{1486077119682706}\n\n**Survival** mode chalanges your endurance. How long can train without missing a hit? Every run is different.\n\n**Wing Chung** mode emulates the legendary Kung-Fu style as performed by the legendary grand master Ip Man. As close as you can get to real Kung-fu training in VR\n\nIn **Free** mode you can train with the wooden dummy in any way you can think of. Your game, your rules.\n\n\nYou can use **Taolu** as a fitness and stress management activity. Proper training enhances reflexes and focus while increasing stamina, energy, cardiovascular endurance and strength. It will get you in a great shape for all your other activities and hobbies. But you'll also get a lot of fun!\n\nBe strong!\n\n\n", "short_description": "Becoming a kung fu master has never been that much fun! In Taolu you can train your martial arts skills respecting the essence of the real Kung-fu, expanded with the wonder of a VR game. Master curated sets of choreographed movements using a realistic wooden dummy. "}, {"images": {"nodes": []}, "id": "1500842145111015", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Taolu", "keywords": ["kungfu", "artesmarciales", "fitness", "entrenamientovr", "reflejos"], "long_description": "\u00a1Todo el mundo puede practicar kung fu! \u00bfQuieres entrenar tus habilidades en artes marciales pero no tienes un wooden dummy en casa? Juega a Taolu en realidad virtual donde quieras y cuando quieras.  Vive la experiencia real sin perder la diversi\u00f3n del juego.\n{1681515376319244}\n\nEn Taolu experimentar\u00e1s una de las herramientas m\u00e1s incre\u00edbles usadas en artes marciales por estilos legendarios como Wing Chun, Hung Gar, Chow Li Fut y Shaolin durante m\u00e1s de 2000 a\u00f1os.\n\n**5 modos de juego: Tiempo, Precisi\u00f3n, Supervivencia, Wing Chun y Libre.**\n\n**Tiempo** pone a prueba tus reflejos. Entra en flow y sube en el ranking global.\n{1522151152754824}\n\n**Precisi\u00f3n** te permite marcar tu ritmo, con mayor exigencia en la calidad t\u00e9cnica.\n{1317933783766844}\n\n**Supervivencia** desaf\u00eda tu resistencia. \u00bfCuanto puedes agunatar sin equivocarte? Cada partida es diferente.\n\n**Wing Chun** reproduce el legendario estilo de Kung-fu usado por el gran maestro Ip Man.\n\nEn **Libre** entrenas como quieras. Tu juego, tus reglas.\n\nPuedes usar **Taolu** como una actividad de fitness y gesti\u00f3n del estr\u00e9s. Un entrenamiento que mejora los reflejos y la concentraci\u00f3n, mientras aumenta la resistencia, la energ\u00eda, la capacidad cardiovascular y la fuerza. Te pondr\u00e1 en excelente forma, \u00a1y sin perder la diversi\u00f3n!\n\n\u00a1A por todas!\n\n\n", "short_description": "\u00a1Convertirse en un maestro de Kung-fu nunca ha sido tan divertido! En Taolu puedes entrenar tus habilidades en artes marciales respetando la esencia del kung fu real, a\u00f1adiendo la magia de un juego en realidad virtual. Domina secuencias de movimientos cuidadosamente dise\u00f1ados, utilizando un wooden dummy realista."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQlj3vVMaNoV7UHeXLL0vyeVvhA1VhzatqrGPdkhuZQmUDsuN7NgnmiJDWUBCYXmaPYKBfg1ta89-iZ/pub", "developer_terms_of_service_url": null, "publisher_name": "The Game Forger", "support_website_url": null, "website_url": "https://thegameforger.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ca", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27037947065868300"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1442284740539496_3919634443264405412_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXxsrhuexecQ7kNvwEWLl9L&_nc_oc=Adrts1dbQFi2807m3q5kjxqm7XtyNF1lDLQ5h9LyG35-5vJxPRVx2qynpeFPFnTpb9s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVJl0KHeyWsSOOUD0Yn5Un6nx66Mnq49nLWPIhaLz_Rg&oe=6AFC6BBC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Taolu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1784826000, "lastRevision": {"nodes": [{"id": "26465864596409886", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26465864539743225", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1537066181395940"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1743933723245216", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Taolu", "keywords": ["kungfu", "artesmarciales", "fitness", "entrenamientovr", "reflejos"], "long_description": "\u00a1Todo el mundo puede practicar kung fu! \u00bfQuieres entrenar tus habilidades en artes marciales pero no tienes un wooden dummy en casa? Juega a Taolu en realidad virtual donde quieras y cuando quieras.  Vive la experiencia real sin perder la diversi\u00f3n del juego.\n{1681515376319244}\n\nEn Taolu experimentar\u00e1s una de las herramientas m\u00e1s incre\u00edbles usadas en artes marciales por estilos legendarios como Wing Chun, Hung Gar, Chow Li Fut y Shaolin durante m\u00e1s de 2000 a\u00f1os.\n\n**5 modos de juego: Tiempo, Precisi\u00f3n, Supervivencia, Wing Chun y Libre.**\n\n**Tiempo** pone a prueba tus reflejos. Entra en flow y sube en el ranking global.\n{1522151152754824}\n\n**Precisi\u00f3n** te permite marcar tu ritmo, con mayor exigencia en la calidad t\u00e9cnica.\n{1317933783766844}\n\n**Supervivencia** desaf\u00eda tu resistencia. \u00bfCuanto puedes agunatar sin equivocarte? Cada partida es diferente.\n\n**Wing Chun** reproduce el legendario estilo de Kung-fu usado por el gran maestro Ip Man.\n\nEn **Libre** entrenas como quieras. Tu juego, tus reglas.\n\nPuedes usar **Taolu** como una actividad de fitness y gesti\u00f3n del estr\u00e9s. Un entrenamiento que mejora los reflejos y la concentraci\u00f3n, mientras aumenta la resistencia, la energ\u00eda, la capacidad cardiovascular y la fuerza. Te pondr\u00e1 en excelente forma, \u00a1y sin perder la diversi\u00f3n!\n\n\u00a1A por todas!\n\n\n", "short_description": "\u00a1Convertirse en un maestro de Kung-fu nunca ha sido tan divertido! En Taolu puedes entrenar tus habilidades en artes marciales respetando la esencia del kung fu real, a\u00f1adiendo la magia de un juego en realidad virtual. Domina secuencias de movimientos cuidadosamente dise\u00f1ados, utilizando un wooden dummy realista."}, {"images": {"nodes": []}, "id": "1576945916735714", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Taolu", "keywords": ["kungfu", "kampfsport", "fitness", "vrtraining", "reflexe"], "long_description": "Jeder kann Kung-Fu trainieren! M\u00f6chtest du deine F\u00e4higkeiten verbessern, hast aber keinen Holz-Dummy zu Hause? Spiele Taolu in Virtual Reality \u2013 jederzeit und \u00fcberall. Es f\u00fchlt sich fast wie echt an, macht aber noch mehr Spa\u00df.\n{3925003154468303}\n\nIn Taolu erlebst du eines der bekanntesten Trainingsger\u00e4te der Kampfkunst, genutzt seit \u00fcber 2000 Jahren in legend\u00e4ren Stilen wie Wing Chun, Hung Gar, Chow Li Fut und Shaolin. Echtes Training trifft auf Spielspa\u00df.\n\n**5 Modi: Zeit, Pr\u00e4zision, \u00dcberleben, Wing Chun und Freier Modus.**\n\n**Zeitmodus** testet deine Reaktion. Komm in den Flow und steig im Ranking auf.\n\n{2042524833315447}\n\n**Pr\u00e4zisionsmodus** erlaubt dein Tempo, verlangt aber mehr Genauigkeit.\n{26570802522604652}\n\nDer **\u00dcberlebensmodus** fordert deine Ausdauer. Jede Runde ist anders.\n\n**Wing Chun** simuliert den legendar\u00e4ren Kung-Fu-Stil wie er von Gro\u00dfmeister Ip Man benutzt wurde.\n\nIm **freien Modus** trainierst du nach deinen Regeln.\nDu kannst Taolu auch als Fitness- und Stressabbau-Training nutzen. \n\nDas Training verbessert Reflexe und Konzentration und steigert gleichzeitig Ausdauer, Energie, Herz-Kreislauf-Leistung und Kraft. Es bringt dich in Topform f\u00fcr alle deine anderen Aktivit\u00e4ten und Hobbys \u2013 und macht dabei richtig Spa\u00df!\n\nSei stark!\n\n", "short_description": "Kung-Fu-Meister zu werden hat noch nie so viel Spa\u00df gemacht! In Taolu kannst du deine Kampfsportf\u00e4higkeiten trainieren und dabei die Essenz des echten Kung-Fu bewahren \u2013 erweitert durch die Magie eines VR-Spiels. Meistere sorgf\u00e4ltig zusammengestellte Bewegungsabl\u00e4ufe mit einem realistischen Holz-Dummy."}, {"images": {"nodes": [{"file_name": "Spatial1.png", "id": "35211689231808269", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823341_35211689265141599_1886400491143406172_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CelqFl5e_P0Q7kNvwFs9OAV&_nc_oc=Adona6cOg76EEXvNAp8lmmfKB44XRu-YOPQXS1x66U6NLGdYgPecbFTm3RiUtYUC3Uk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuH_Yb_hqFcU6YoJplXXEg5VDajPIj10G5Fl0AXaFeUQ&oe=6AFC7133"}, {"file_name": "Spatial2.png", "id": "26626346793682927", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823296_26626346807016259_172651004695932764_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZXifA9e5LoQ7kNvwGtFTaC&_nc_oc=Adq4Q8Y8EiAxGJHI3KyG4sJya19zUMZTcSWXjpvZ8o_wpXb6b83uZnZ3jiChdw0gav4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU0G60Lwjsc1nmKaZBtj5tVfAlml6Vh6CYEiZidtC1Sw&oe=6AFC6DBF"}, {"file_name": "layered_icon_composited.png", "id": "2427364291104850", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618938_2427364297771516_1584960596387692838_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RDZ2QmzPZIQ7kNvwFDznGl&_nc_oc=Adpp5X9QJw-F3aLHMnUQ_LTnReUB9t_NFbJOxer1bUFxRGlvzbl9VtTk7_EvNvvPLp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Oam6tMOb-hEjafrB08LeiUGW-2CDJdh-gWB9TfCPpA&oe=6AFC7AE8"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1681707043018774", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499293669_1681707046352107_6888056813955126533_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXc9qI5F5AgQ7kNvwF9VV3H&_nc_oc=AdoCxULUo5FOeaZyolnHU3JSdF9zy_UYTGN7-GMRrwBhn47NcvU9QC4UeyAnheTXuKg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAALCTLqp-N3RZYiR_ERo
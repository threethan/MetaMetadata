0_AQRNxoJ88Jlo7-laQEo_VT19f3uxDVrH2jXM-COi75yepA&oe=6AFC6E2B"}, {"file_name": "3rd.png", "id": "1708387087248657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1708387090581990_3885461583002837473_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FStz16NK6qIQ7kNvwGa_jq2&_nc_oc=AdpstvYHpVt2yPDgSoH-ZdxJgap08NRBJ3kSSSzMqwBXjXPBksxaJapXoU3ztUY1V6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7XQX-k5Eye4aKHHc8X_opI-f8ZesxgyNWjGHGSN-JVw&oe=6AFC66B9"}, {"file_name": "Tatami.png", "id": "1283818910526525", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307435_1283818913859858_7411468799351658909_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HDbMZTEEcgQ7kNvwGMf9j3&_nc_oc=AdpML_AiDSIMiacECow1wIc6kUJ1lV-sLxGEYooS5q36g4XHlT55Usy4k-n1nLlpR7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBXt0LciWA10bF-lXVYzVNb3NhEo_DqOTYsALIUnPOTQ&oe=6AFC8612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Enviro.png", "id": "1406236798004582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298712_1406236801337915_3646722369979900216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JOZ4XOsq1MQ7kNvwGRrkr3&_nc_oc=AdorN9bzdKtW9Mi47M9atYHsDzVVrYDsr2neHjs3kcgENlnyZtq5vEWGtcHsAPmB59U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-vSrxbGU1YKFWa6E7og8zqKgyLS_5Zh8ZvCf4woGwRg&oe=6AFC6ECB"}, "display_name": "Taolu", "keywords": ["kungfu", "martialarts", "fitness", "vrtraining", "reflexes"], "long_description": "Everyone can practice kungfu! You want to train your martial art skills but you don't have a wooden dummy at home? Play TaoLu in virtual reality anywhere and anytime you want. It feels almost like in real world. But you'll get a lot more fun.\n{948117578129586}\nIn Taolu you'll experience one of the most amazing tools used in martial arts by many legendary kung fu styles, like Wing Chun, Hung Gar, Chow Li Fut and Shaolin, for well over 2000 years . Feel the real deal, but without losing the amusement of gaming.\n\n**5 Game Modes: Time, Precision, Survival, Wing Chung and Free mode.**\n\n**Time** mode challenges your reaction skills. Enter the flow mode and earn extra points. Climb positions in th global ranking.\n{1798458964908886}\n**Precision** mode alows you to set you own pace, but is more demanding on precision and hit direction. \n{1486077119682706}\n\n**Survival** mode chalanges your endurance. How long can train without missing a hit? Every run is different.\n\n**Wing Chung** mode emulates the legendary Kung-Fu style as performed by the legendary grand master Ip Man. As close as you can get to real Kung-fu training in VR\n\nIn **Free** mode you can train with the wooden dummy in any way you can think of. Your game, your rules.\n\n\nYou can use **Taolu** as a fitness and stress management activity. Proper training enhances reflexes and focus while increasing stamina, energy, cardiovascular endurance and strength. It will get you in a great shape for all your other activities and hobbies. But you'll also get a lot of fun!\n\nBe strong!\n\n\n", "short_description": "Becoming a kung fu master has never been that much fun! In Taolu you can train your martial arts skills respecting the essence of the real Kung-fu, expanded with the wonder of a VR game. Master curated sets of choreographed movements using a realistic wooden dummy. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQlj3vVMaNoV7UHeXLL0vyeVvhA1VhzatqrGPdkhuZQmUDsuN7NgnmiJDWUBCYXmaPYKBfg1ta89-iZ/pub", "developer_terms_of_service_url": null, "publisher_name": "The Game Forger", "support_website_url": null, "website_url": "https://thegameforger.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
1-25/499618442_651931851338970_1074636068811286131_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8VaODuFLnUQ7kNvwE1GXz1&_nc_oc=AdqeJDm-U5Xp8KKhctazFfa0gj5Ad_O2zoLh_oPoVI7NENZpRvGtNHRT4NcmGpLX_4o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrlqH4lHFqOd7EXWhaDRdWNirKG21fIy2lLQyf-Dpa4g&oe=6A7DAE9B"}, {"file_name": "New Project (26).png", "id": "776119051631392", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/604275479_776119054964725_2545421838476906794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9zHlUlVvYsQ7kNvwF_EqKj&_nc_oc=AdrAY45S9d7YfsneFfKB4LpqHhOz3bBLsCHIhQa5EtUyL3GF6ljdoriw0uSY1IZxu2U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0viDTY5KzBJMivULRMOgcdrD1bNgbNPploM1TW-DRCw&oe=6A7DB9B8"}, {"file_name": "New Project (23).png", "id": "1563599251359581", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623314_1563599254692914_9165997855703285150_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVky5foaE8wQ7kNvwEBBTv_&_nc_oc=AdrP1u0RjxhCH6f9nrsC50McKyDGSaDIekkIKjaKhoVbuXQDjJiF_QHASSUH7lwXIwk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG01_bRmXjX5QV01FTsshq_A32kkN7c_hScJh2m3Wme1w&oe=6A7DBAE9"}, {"file_name": "New Project (21).png", "id": "1590913235486172", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824534_1590913242152838_8358432393169549138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kox57K5dsaYQ7kNvwEYpSgs&_nc_oc=AdpRqeZ-yaG6fd91iYn8SRCF11b5CCMdIIik2yxu7vSlxd_P8nDEh9OZmjpGV6hLo8M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1O6fPZAylgZBaYjsk72wPNW80OyiQU-0mSypA8UxqAQ&oe=6A7DB0CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kartracing pro.png", "id": "4940272682918760", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620817_4940272686252093_4519024353397914261_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLSUIXOlBgcQ7kNvwGEVJcT&_nc_oc=AdrF9R45d4jnMHwVr8VNaR6GjNkH1R8-9hJBVbmsBprV5tbHXFV4JwxQNbBwDX8bcpU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEevum6OROW9lFO6IhU3R3HaJA5eByp7Nn4y7t7tRd4iw&oe=6A7DBCA1"}, "display_name": "Kart Racing Pro", "keywords": ["kart", "racing", "car", "kartracing", "race"], "long_description": "Kart Racing Pro is a competitive VR kart racing game built specifically for Meta Quest, delivering fast-paced, skill-based racing in immersive harbour environments. Race through industrial dock circuits filled with shipping containers, tight corners, and high-speed straights designed for intense virtual reality racing.\n\nExperience precise kart handling, responsive controls, and a true cockpit-style perspective that makes every lap feel authentic in VR. Kart Racing Pro focuses on competitive racing gameplay, challenging AI opponents, and esports-inspired presentation with professional track signage, crowds, and race atmosphere.\n\nWhether you\u2019re a fan of VR racing games, arcade kart racers, or competitive esports experiences, Kart Racing Pro offers a polished Meta Quest racing experience built for speed, precision, and immersion.", "short_description": "Kart Racing Pro is a high-speed VR kart racing game set in gritty harbour circuits. Race against skilled bot players through industrial docks, tight corners, and competitive tracks. Built for precision driving, fast reflexes, and immersive VR control, Kart Racing Pro delivers an authentic esports-style racing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/01068b07-0c71-4f47-bcab-02fbd774dd69", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "277654
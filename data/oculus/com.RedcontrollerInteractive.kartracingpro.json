cQ7kNvwGwhVJm&_nc_oc=AdpfvpvuQhg57cniGYxWseAUSsqG03wujFFTpMxykUCg8UDafV5wrKi3j4KKARPo8XQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKx0X-p-UcgyzyFYhleykCeMoRCADH4jyJEM5MC6UklQ&oe=6B0C5529"}, {"file_name": "New Project (21).png", "id": "1590913235486172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824534_1590913242152838_8358432393169549138_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6MeigD5vSMQ7kNvwHXElUn&_nc_oc=Adrec_BDdr48PlgL2sKMoF8d2547Xt84Ix2OqbAc5H-DDH8Q53oKp2Tm4RmMBgg1APQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-wec8gi4dNrhEqEcy_kIgrmdLuBGk6tUP-zwFMtI0Sw&oe=6B0C4B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kartracing pro.png", "id": "4940272682918760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_4940272686252093_4519024353397914261_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSSXjZ1-_6kQ7kNvwFcmQrU&_nc_oc=AdquYI-ulVEj9inrEB4FMyhXJTWhNsWlvuYlJL-DsfOzfY50xRbFJtXPLHtSViqGav4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLbUVzp27JzMcSK6VKwsmg97mTmWVPTqYkhoAUT5X66g&oe=6B0C56E1"}, "display_name": "Kart Racing Pro", "keywords": ["kart", "racing", "car", "kartracing", "race"], "long_description": "Kart Racing Pro is a competitive VR kart racing game built specifically for Meta Quest, delivering fast-paced, skill-based racing in immersive harbour environments. Race through industrial dock circuits filled with shipping containers, tight corners, and high-speed straights designed for intense virtual reality racing.\n\nExperience precise kart handling, responsive controls, and a true cockpit-style perspective that makes every lap feel authentic in VR. Kart Racing Pro focuses on competitive racing gameplay, challenging AI opponents, and esports-inspired presentation with professional track signage, crowds, and race atmosphere.\n\nWhether you\u2019re a fan of VR racing games, arcade kart racers, or competitive esports experiences, Kart Racing Pro offers a polished Meta Quest racing experience built for speed, precision, and immersion.", "short_description": "Kart Racing Pro is a high-speed VR kart racing game set in gritty harbour circuits. Race against skilled bot players through industrial docks, tight corners, and competitive tracks. Built for precision driving, fast reflexes, and immersive VR control, Kart Racing Pro delivers an authentic esports-style racing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/01068b07-0c71-4f47-bcab-02fbd774dd69", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26744748638492938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617729_1272217881725053_5035278209538476991_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDN-TMI-ZEcQ7kNvwEyUeSP&_nc_oc=AdrzGH7chC-6pXulJSTBTw-AlTPADTIDLu9-QOTp2G49y0tsPzmFjkXx-Fy_p9UAMNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCq_g6ZANZtg_iVGsx8NlSmGnKoSQnCiEmdlB
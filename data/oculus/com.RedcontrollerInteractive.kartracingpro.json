g?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6MeigD5vSMQ7kNvwGDictL&_nc_oc=AdqTVO08pcwaaDEqvxXerqcqGQnuFiHOeZWNLHZnEgcyGS6lvnQj6CK7v-o5reoKW0w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSos6XI9Y2LiaZVFHD8oJ-iZhKhfliR_8aw4Mu9RNmkyA&oe=6B0B31CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kartracing.png", "id": "1465770651805010", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619096_1465770655138343_3175179226009691736_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suJvKe10K44Q7kNvwGsjHYD&_nc_oc=AdqnaLDOWWYlMkgnbiNZipVZufOfKLqy8NdwUny9ffdvwPeuhJ8DkqPEUm_H8EE8CLY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5r1wfDvHlwqzyTEU4dQzNSe_O1A8as-0UmjuHv1HJFQ&oe=6B0B3758"}, "display_name": "Kart Racing Pro", "keywords": ["kart", "racing", "car", "kartracing", "race"], "long_description": "Kart Racing Pro is a competitive VR kart racing game built specifically for Meta Quest, delivering fast-paced, skill-based racing in immersive harbour environments. Race through industrial dock circuits filled with shipping containers, tight corners, and high-speed straights designed for intense virtual reality racing.\n\nExperience precise kart handling, responsive controls, and a true cockpit-style perspective that makes every lap feel authentic in VR. Kart Racing Pro focuses on competitive racing gameplay, challenging AI opponents, and esports-inspired presentation with professional track signage, crowds, and race atmosphere.\n\nWhether you\u2019re a fan of VR racing games, arcade kart racers, or competitive esports experiences, Kart Racing Pro offers a polished Meta Quest racing experience built for speed, precision, and immersion.", "short_description": "Kart Racing Pro is a high-speed VR kart racing game set in gritty harbour circuits. Race against skilled bot players through industrial docks, tight corners, and competitive tracks. Built for preci
g?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoF_L00pZmgQ7kNvwErrnjS&_nc_oc=Adq3lXwcaqZwNiSYFHynQUaldavzTeCC7_NamedkqP4sZ41yClpLJFyZxVO_mVqn0JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxLAUXA056wmO1iXPW9H_Ov2jfn-JtyXL4h1Daw7RNEA&oe=6B103F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kartracing.png", "id": "1465770651805010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619096_1465770655138343_3175179226009691736_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4drxVFJLYjcQ7kNvwEit9t1&_nc_oc=AdqjsJrQzIFDyJizQUN7QuNXDVixD3lg6Mzw0WVQ8CxO3trWmNo6NH7K8k9TOFha4Pc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCyDgFviwaSYZWbgzbUbvlL7B8gkdEH3rfZSqgUNW5yg&oe=6B104518"}, "display_name": "Kart Racing Pro", "keywords": ["kart", "racing", "car", "kartracing", "race"], "long_description": "Kart Racing Pro is a competitive VR kart racing game built specifically for Meta Quest, delivering fast-paced, skill-based racing in immersive harbour environments. Race through industrial dock circuits filled with shipping containers, tight corners, and high-speed straights designed for intense virtual reality racing.\n\nExperience precise kart handling, responsive controls, and a true cockpit-style perspective that makes every lap feel authentic in VR. Kart Racing Pro focuses on competitive racing gameplay, challenging AI opponents, and esports-inspired presentation with professional track signage, crowds, and race atmosphere.\n\nWhether you\u2019re a fan of VR racing games, arcade kart racers, or competitive esports experiences, Kart Racing Pro offers a polished Meta Quest racing experience built for speed, precision, and immersion.", "short_description": "Kart Racing Pro is a high-speed VR kart racing game set in gritty harbour circuits. Race against skilled bot players through industrial docks, tight corners, and competitive tracks. Built for preci
AQ7kNvwExC8LD&_nc_oc=AdqO11-xOp4WdhiNKdCsb-aTfmxj53RAqiqvmmPb-92dTGKK_lGmBFklKSxJGJfvJ_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP6jHAezwHklgFF0b9FvI1_Yvmll-xeUG6J9tVn7Wzow&oe=6B1049A9"}, {"file_name": "New Project (21).png", "id": "1590913235486172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824534_1590913242152838_8358432393169549138_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoF_L00pZmgQ7kNvwErrnjS&_nc_oc=Adq3lXwcaqZwNiSYFHynQUaldavzTeCC7_NamedkqP4sZ41yClpLJFyZxVO_mVqn0JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxLAUXA056wmO1iXPW9H_Ov2jfn-JtyXL4h1Daw7RNEA&oe=6B103F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kartracing pro.png", "id": "4940272682918760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_4940272686252093_4519024353397914261_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0yJMnsUATwQ7kNvwHTS-uV&_nc_oc=AdpmfMPXve3duiUMmNOifulklHYdtxXbTZdAcXE6BcliG6Kb1clA4y1Hpx6pO_3uBEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUi2F2aoAfLWKm4BGpG4xMaLTfQay3LobQ4_GT57jmFnQ&oe=6B104B61"}, "display_name": "Kart Racing Pro", "keywords": ["kart", "racing", "car", "kartracing", "race"], "long_description": "Kart Racing Pro is a competitive VR kart racing game built specifically for Meta Quest, delivering fast-paced, skill-based racing in immersive harbour environments. Race through industrial dock circuits filled with shipping containers, tight corners, and high-speed straights designed for intense virtual reality racing.\n\nExperience precise kart handling, responsive controls, and a true cockpit-style perspective that makes every lap feel authentic in VR. Kart Racing Pro focuses on competitive racing gameplay, challenging AI opponents, and esports-inspired presentation with professional track signage, crowds, and race atmosphere.\n\nWhether you\u2019re a fan of VR racing games, arcade kart racers, or competitive esports experiences, Kart Racing Pro offers a polished Meta Quest racing experience built for speed, precision, and immersion.", "short_description": "Kart Racing Pro is a high-speed VR kart racing game set in gritty harbour circuits. Race against skilled bot players through industrial docks, tight corners, and competitive tracks. Built for precision driving, fast reflexes, and immersive VR control, Kart Racing Pro delivers an authentic esports-style racing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/01068b07-0c71-4f47-bcab-02fbd774dd69", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26744748638492938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617729_1272217881725053_5035278209538476991_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgNOJ3y3KOoQ7kNvwEK3RGe&_nc_oc=Adqylj710wLByliEYGK4BfzZ-stCnctEzna5GopPJauIK3a0WOpMNpOQ66rZ0K7CJ5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWF_86BnFm4eK8NohIQb7A-6F2HwwP_jw6d4bH
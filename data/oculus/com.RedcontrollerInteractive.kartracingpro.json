JMivULRMOgcdrD1bNgbNPploM1TW-DRCw&oe=6A7DB9B8"}, {"file_name": "New Project (23).png", "id": "1563599251359581", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623314_1563599254692914_9165997855703285150_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVky5foaE8wQ7kNvwEBBTv_&_nc_oc=AdrP1u0RjxhCH6f9nrsC50McKyDGSaDIekkIKjaKhoVbuXQDjJiF_QHASSUH7lwXIwk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG01_bRmXjX5QV01FTsshq_A32kkN7c_hScJh2m3Wme1w&oe=6A7DBAE9"}, {"file_name": "New Project (21).png", "id": "1590913235486172", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824534_1590913242152838_8358432393169549138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kox57K5dsaYQ7kNvwEYpSgs&_nc_oc=AdpRqeZ-yaG6fd91iYn8SRCF11b5CCMdIIik2yxu7vSlxd_P8nDEh9OZmjpGV6hLo8M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1O6fPZAylgZBaYjsk72wPNW80OyiQU-0mSypA8UxqAQ&oe=6A7DB0CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kartracing.png", "id": "1465770651805010", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1465770655138343_3175179226009691736_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG2tg0tLwtkQ7kNvwHmHlej&_nc_oc=AdoCHGlH9gJ52OUpxpHQ-EXo6NpUUEE4hthsC-a92k-Dktsz-YZReBez746DoFEUdv4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGe6w3rzFf7m-8G-9RFW8465GJdlMbbRDEWSnjxjRhPQ&oe=6A7DB658"}, "display_name": "Kart Racing Pro", "keywords": ["kart", "racing", "car", "kartracing", "race"], "long_description": "Kart Racing Pro is a competitive VR kart racing game built specifically for Meta Quest, delivering fast-paced, skill-based racing in immersive harbour environments. Race through industrial dock circuits filled with shipping containers, tight corners, and high-speed straights designed for intense virtual reality racing.\n\nExperience precise kart handling, responsive controls, and a true cockpit-style perspective that makes every lap feel authentic in VR. Kart Racing Pro focuses on competitive racing gameplay, challenging AI opponents, and esports-inspired presentation with professional track signage, crowds, and race atmosphere.\n\nWhether you\u2019re a fan of VR racing games, arcade kart racers, or competitive esports experiences, Kart Racing Pro offers a polished Meta Quest racing experience built for speed, precision, and immersion.", "short_description": "Kart Racing Pro is a high-speed VR kart racing game set in gritty harbour circuits. Race against skilled bot players through industrial docks, tight corners, and competitive tracks. Built for precision driving, fast reflexes, and immersive VR control, Kart Racing Pro delivers an authentic esports-style racing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/01068b07-0c71-4f47-bcab-02fbd774dd69", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25881503428150801"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1014213161601345"}, {"status": "PUBLISHED", "id": "4114033098888595"}]}, "baseline_offer": {"id": "4114033098888595"}, "is_approved": true, "firstOffer":
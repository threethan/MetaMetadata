HsQ7kNvwHY3V7h&_nc_oc=AdrAU4SD2ku5FYzr1mnemaLoCk6fylwE4z9sk07GrvJ_lJSU6GArUQkQEj3ydFIPO-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLymCYxrVMu4k3IYoMedi0iXoLiNL_AEtF3rUhfcCWFw&oe=6B0F1F5F"}, "display_name": "Scary Chimps", "keywords": [], "long_description": "Improve your coordination and reflexes: In addition to being a fun way to exercise, Scary Chimps can also help you improve your physical coordination and reflexes. By moving your arms in response to the game's prompts, you'll build up your muscle memory and hand-eye coordination. This can have real-world benefits, such as improving your ability to catch a ball or perform other physical activities.\n\n\u200b\n\n(none of these are claims but are possibilities)", "short_description": "Pass the time in an engaging way: Whether you're waiting for an appointment or just looking for something to do, Scary Chimps is a great way to pass the time. This immersive game will keep you engaged for hours on end, as you explore different virtual worlds and complete various challenges. And because the game is so interactive, you'll never get bored."}]}, "developer_name": null, "developer_privacy_policy_url": "https://scarychimps.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mr. Exploded & BAV0N", "support_website_url": null, "website_url": "https://scarychimps.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
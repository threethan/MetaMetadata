-25/38982708_904364754550629_1211282689928400821_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9H27Q0CygoQ7kNvwFLiBOJ&_nc_oc=Admw97Q0a6XmM7TyOOB4EAMPTbBHOfBUefzLn2Xxt13Cd0KiP1CMK4RMdu5ABLt9Gqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzZx8CPqqokp9nPKyacp-Ry78PPbVAf4uNw_uuOIQIeA&oe=69AD77E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1211.png", "id": "1578224769655053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974777_1578224776321719_4506502587852088046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z72VeiWNx0Q7kNvwEEb4pi&_nc_oc=AdnNQqc2x-VdY2RAaS5PJJGfra857bhQj5hBCnubWMsqfg1E2ChRdiLqdwP-1jTEwJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZpyq1xd9-HRpi-FAuWTpnHbUm9PrOM4N5B3_o3ouFJQ&oe=69AD6563"}, "display_name": "Super Tag 2", "keywords": [], "long_description": "Improve your coordination and reflexes: In addition to being a fun way to exercise, SUPER TAG can also help you improve your physical coordination and reflexes. By moving your arms in response to the game's prompts, you'll build up your muscle memory and hand-eye coordination. This can have real-world benefits, such as improving your ability to catch a ball or perform other physical activities.\n\n\u200b\n\n(none of these are claims but are possibilities )", "short_description": "Pass the time in an engaging way: Whether you're waiting for an appointment or just looking for something to do, SUPER TAG is a great way to pass the time. This immersive game will keep you engaged for hours on end, as you explore different virtual worlds and complete various challenges. And because the game is so interactive, you'll never get bored."}]}, "developer_name": null, "developer_privacy_policy_url": "https://supertag2.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mr. Exploded & BAV0N", "support_website_url": null, "website_url": "https://supertag2.com/#", "category": null, "comfort_rating": "NOT
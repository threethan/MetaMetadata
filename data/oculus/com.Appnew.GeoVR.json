E-sOlo&_nc_oc=AdqMWqRdb9i5cfrH3RjQeugZ48m3s5cjUdfR-g7f0nED3gGnuouzBcUoeQ_5qfT4SlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMckAv1EH67gc8wRrDDVeTKMOYocvwTpwqUrziOfAmtQ&oe=6AA6C19B"}, {"file_name": "Oculus - Google Chrome 21_04_2025 03_51_37 p. m..png", "id": "1459543995023384", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821176_1459543998356717_8311695456826521939_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJl2kepMb3EQ7kNvwH5X4Sr&_nc_oc=AdoIdjtTnq9zZToxIatO58hSKnkREwPf9yRRWF_l7ui1uk6qmyniXMBcuiSI5qhK2ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkXdRtzO4-QnxcTMdFJMdP5HImC80Dh_AJuoyplbptNw&oe=6AA6A59C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Applims", "keywords": [], "long_description": "Applims es una innovadora aplicaci\u00f3n en realidad virtual dise\u00f1ada para profesionales y equipos que trabajan con objetos 3D interactivos en tiempo real. A trav\u00e9s de una conexi\u00f3n directa con la plataforma web oficial de Applims, esta app permite visualizar, editar y comentar modelos 3D (\"muestras\") de forma colaborativa y eficiente.\n\nExplora cada muestra con total libertad dentro del entorno VR, descarga modelos en tiempo real, modif\u00edcalos mediante trazos intuitivos directamente sobre su superficie, y env\u00edalos nuevamente a la plataforma, sobrescribiendo la versi\u00f3n anterior para mantener siempre actualizada.\n\nAdem\u00e1s, Applims permite a\u00f1adir comentarios en formato de texto o audio, facilitando la comunicaci\u00f3n entre equipos desde cualquier lugar. Los comentarios pueden ser consultados en cualquier momento dentro de la app, creando un entorno de colaboraci\u00f3n fluido y moderno.", "short_description": "Aplicaci\u00f3n inmersiva en realidad mixta o virtual, orientada a la visualizaci\u00f3n, an\u00e1lisis y documentaci\u00f3n de muestras mineras. La aplicaci\u00f3n permite a los usuarios explorar modelos tridimensionales escaneados, realizar anotaciones visuales y verbales, y mantener sincronizada la informaci\u00f3n con la plataforma web de Applims. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://applims.cl/privacidadmeta", "developer_terms_of_service_url": null, "publisher_name": "App New", "support_website_url": null, "website_url": "https://applims.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL", "es_AR", "es_CO", "es_MX", "es_PE", "es", "es_PR", "es_VE"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24199761102958824"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1265690681875521"}]}, "baseline_offer": {"id": "1265690681875521"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745867040, "status": "PUBLISHED", "id": "1265690681875521"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25865305006404417", "version": "1.0.11"}, "id": "980217554271550", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24199761076292160", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25865305006404417"}, "release_status": "RELEASED"}, "binary_release_channel
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974698_738605781811491_6864589510425080853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVeDY4311swQ7kNvwHVcpqQ&_nc_oc=AdmWMBqhy9LZOi2u4SpGIZhp2Xgg2X3WvCzbq8xKfkrrBv0tDPgKriCh_L-6y4B7O_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvMds8FCniNDgp7qQMqzHlGwO96Cm00A-rHDf05i7dW4w&oe=699C37DC"}, {"file_name": "vlcsnap-2024-04-03-16h22m49s964.png", "id": "1145408583476574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pc-JJjIA4Q7kNvwHoqnof&_nc_oc=Adk3YhXdzUnSLYzKIDLPl_9mN4543hjBK6JFvn_HvIGi0AJuMrhoVC9TagdMuf7q4hM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuZzcV1hxf0murj4OCXfpJ5ZfQe-lTsLeOGgc1Fhjpk3w&oe=699C30CF"}, {"file_name": "vlcsnap-2024-04-09-11h25m06s391.png", "id": "990153359378736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566679_990153362712069_1829045077122921579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNQ35NW-B38Q7kNvwHK-R1d&_nc_oc=AdnI7mmsw5Y1W-AMT46989lHOmgRP2JaMDHwLIJ4vmy7xTxThPQEHMsQXAbdAb_Z8vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft6tS7Ft9cG0no8BbcLSURddBq-upcuSGO1-XthsJ6h3g&oe=699C6134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Och6JKkU4aAQ7kNvwG-xWpV&_nc_oc=AdknLPZWrgLzjMps4yC_CdqC5tQoQBuNvMKOlgWk-ye1Qom1t6QkyrlXPwBpaRnd1o0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftWsjuktV7l1ubvFw5Zekk--uy1EHsgSDUTP2D_OfGLaw&oe=699C31BA"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7442505625832568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XtREFRvUkYQ7kNvwFTP5ww&_nc_oc=AdmQEbuFBUDAmf-JE0_pj4rgF6HYEAX8jrDNR_n5Hnn96bngW918ZVbVn6AiWq4lnAs&_nc_zt=3&_nc_ht=scontent-ord5-3.ocul
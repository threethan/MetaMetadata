 {"file_name": "vlcsnap-2026-06-03-10h53m46s154.png", "id": "2766313387072433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_2766313390405766_5977130729849343113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8-5a3HlhaEQ7kNvwHI3cpj&_nc_oc=AdovJaO4xlYKhr8OIFJQPqK-1oevOZYhPmbDfkLHmHicxTi9UM2foienBfz5ZlPlKek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyacXELIVhlrzlwnlybj1D5Z-JyOJ7sihwtmp9y4LNJA&oe=6AE7464B"}, {"file_name": "vlcsnap-2024-04-03-16h23m46s469.png", "id": "979731941617945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620432_979731948284611_3131212548877664483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxty7AwpOjkQ7kNvwEAtjrh&_nc_oc=AdrwwXrFfxE0ImzWihdk2I8B3FAwP7Z3JOpSifHd0oaGD8fA_DsH_oqYrrytfFVm3Eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcnrNK2k0KuDt6oqkVIkJIjZf-oWVK0rPe9S6BmBNJtw&oe=6AE74D43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUGUguoEsqEQ7kNvwHSbL2G&_nc_oc=AdpfKh7VsZpE6BhI4lDVc1ueScHdqi-Q7_2T1dBjx_Oeuv6Hk_w1d1Ef5YArt4JRw2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRbaia604aKD0G8Z670HesMtmFwX96UeXgKWh27CqbqQ&oe=6AE7527A"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://asterion.federation.edu.au/CampingParasitesVR/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26907490895574084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqGUYW5F4KAQ7kNvwFueyDx&_nc_oc=AdpSyMPNT9EdjIC9K5Dvf_ooIOUO52_WVfgjlVmhgaqt6Z3N9MraK2jcr6X_twazc7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpvofOUfd2rZyMaRZgTpLsS_NSPyJB8hAeh0Rh0Qtx_w&oe=6AE741E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Camping Parasites VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211
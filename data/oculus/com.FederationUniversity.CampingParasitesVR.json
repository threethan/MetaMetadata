://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974698_738605781811491_6864589510425080853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVeDY4311swQ7kNvwF9J8JB&_nc_oc=Adnau_E-C3X-gUqrHpq1fc6F4v0WkDoEH2rZqkcr2UDqDUklPozqR8dmLZdeiN9Hl2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftW64mQVU6nzGVo95yNTIsVCZO-372ARE3LKTXyRwJiNA&oe=699AE65C"}, {"file_name": "vlcsnap-2024-04-03-16h22m49s964.png", "id": "1145408583476574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pc-JJjIA4Q7kNvwHcEWfI&_nc_oc=AdnJ5LjtIhhN8NKZc5D97zrftGLNCJjMHuWKlXnzkYGSYZRqSP_g7pxJbz8vSn3Z9NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9qdo4SaQoUqF06K7AWeOnfNzLsVsJRsPLdaPQxfjteA&oe=699ADF4F"}, {"file_name": "vlcsnap-2024-04-09-11h25m06s391.png", "id": "990153359378736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566679_990153362712069_1829045077122921579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNQ35NW-B38Q7kNvwGMFJPi&_nc_oc=Admtr4ZnTpej2R-yg55hm6RNWLxMGzQgQZqWpV9iMcnuUyNluUO2I6sj3b1GEGq459g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvIaJm7WoFpqRpDJEZ5ZRf3mrEIfgi_E0WYFGLIiveCTQ&oe=699B0FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Och6JKkU4aAQ7kNvwG9H4YR&_nc_oc=AdkQDE5gqFlmQsaEQyObaKU2KYoKl7TtQYQXC7zcLjl4dVYgmM6XA9VGcCWLmMVjrVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsAYFO6Q1190Ft2nYgu1YunjiYByLPKRUfMrFOiSTkGbQ&oe=699AE03A"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7442505625832568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XtREFRvUkYQ7kNvwF2B0lg&_nc_oc=AdkEa4cwJB12Bwu8RqfBL80rg5iMhGpb0TZ7RlVGPE6KXu_rHkOsKibTDWAyFqu5BmY&_nc_zt=3&_nc_ht=scontent-ord5-3.ocul
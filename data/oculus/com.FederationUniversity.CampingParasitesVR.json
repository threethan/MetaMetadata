Gx4Q&oe=6B0C7ADC"}, {"file_name": "vlcsnap-2024-04-03-16h22m49s964.png", "id": "1145408583476574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzfKnD8EG8Q7kNvwHlaXxQ&_nc_oc=AdrT4bwVwLr2nQTf21KBhzXs8UVDiv5xARE6CsZVtGlZ9lLZU9TE9MNea0gVFsSoMfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRn2QMckDiHiT22ejBc2jlWbqGesmnj7H92ywWgbND9Mw&oe=6B0C73CF"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2INiUFqZcYQ7kNvwHmGKIt&_nc_oc=AdqkxJ_KUqiqN6kjpk97GjJT0-LPwfgEoDd_P9wNzCOaGN_Z0SI0HdSOPWAhWiRuKHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIZ-pPTl-pMg3xBWdmINgkjPjNMo8TfLkCoiEJpMhJAg&oe=6B0C5DF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjORsQLO3UMQ7kNvwHJlsQT&_nc_oc=Adotdp592C3Scnz2xoVl8_kWnrGfxQKDAzCv3sAClKvcKoannDgVQeDbRBubWRP9aLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEALQIlaFV-3YV4rX6taUPholYJ1g0fie33D6Yi89pNQ&oe=6B0C4A95"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7298012850281847"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1998080183898939"}]}, "baseline_offer": {"id": "1998080183898939"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712781840, "status": "PUBLISHED", "id": "1998080183898939"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7578828785533584", "version": "0.11"}, "id": "1308342566506127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Androi
&_nc_ohc=Bf3rNayU1ngQ7kNvwFXvNrV&_nc_oc=AdqF0b_H15SiJw1hYfFl8aW5poUGGpJv46LW-WCiJGoavTUY2VYrcf_hZ4kUjAAkDbc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLDHRTH70VMAO5H6Ye-OwZ6uEJY7LLDaeZ60M1pdjNYw&oe=6AFC85B4"}, {"file_name": "vlcsnap-2026-06-03-10h53m46s154.png", "id": "2766313387072433", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2766313390405766_5977130729849343113_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UMyV7o49OEQ7kNvwFHqwHt&_nc_oc=AdoavjMR8UZb7MvVdEOpbjisu-zKK3Kh7eYKdhQjoU3jMXFfubWAYCiER_vkTmaaGoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUpozp9nYUCTiPdmYWFImW_UkkA2galEQu1zSevTroaw&oe=6AFC5E4B"}, {"file_name": "vlcsnap-2024-04-03-16h23m46s469.png", "id": "979731941617945", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620432_979731948284611_3131212548877664483_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frFtTmKJoS4Q7kNvwEDc2ie&_nc_oc=Adq_kq5yjGMckYGCIdEmjJpIRkyvIn9vzdUZhbZZSHLZgfEaHd38xenO5MqYD54EvVU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK_vjKjebaIAik4psVrxu_EHvxQPfj6vl8sB2-HmkKlw&oe=6AFC6543"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxQ3Fnp_aykQ7kNvwHEu2AL&_nc_oc=AdrGLL5rpLlmYtHT4b3VY_Q_kO3LddethARtQw1dCJiFvPKI4EDTg3DTNc2UIvhXJwU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREC6Q4ZCVC98L1Pi86GbKxzBY1GhKimdsKZd9aaqXN8w&oe=6AFC6A7A"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://asterion.federation.edu.au/CampingParasitesVR/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26907490895574084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEVjnS1yJm0Q7kNvwGlmw36&_nc_oc=AdqDbAsWDHogkfy4n7wTyOnuEUD4mso8Bkm44j8-RDXAkpea3pQhkkj6LKgy
E84F4"}, {"file_name": "vlcsnap-2026-06-03-10h53m46s154.png", "id": "2766313387072433", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619808_2766313390405766_5977130729849343113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhYC_umJiQMQ7kNvwHlF0Aa&_nc_oc=AdpR7UiXCjwMN2tBMbwP1ATuPyt7bo4CSoZ2RrH_u_2-D6VT88hhSxukA1AJC1olUNc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhm4k5TGOMrpfMP972dhBXTM6d-5hVByoPI_hc98MY4w&oe=6AAE95CB"}, {"file_name": "vlcsnap-2024-04-03-16h23m46s469.png", "id": "979731941617945", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620432_979731948284611_3131212548877664483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAZksvdLqIAQ7kNvwE2gERN&_nc_oc=AdpazIG25r_VXVy7WWWCagyMUUuti2V2Yli857xPJmjVJGiWEY0ShHktJkH-dEbgnhY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF4q3mpQ51auaZVQMQguE1ZAVobPkTBAEEXXZ4U6nXKA&oe=6AAE9CC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1swXv89JnmIQ7kNvwHSkV0g&_nc_oc=AdocvWHpd3D17uOxnP66eMhnkA_bfLbdHud_OhSerBHyFzE6QKLlrSbxPyCq6-xheyE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJurQFxYGxiQwjlFu5CjI8yKg-76lH6KsR5tYgDkThUw&oe=6AAEA1FA"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://asterion.federation.edu.au/CampingParasitesVR/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26907490895574084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXCuJvGZFEcQ7kNvwE3i_CE&_nc_oc=AdrLkq-kA6Dc7ICQLWm6Khut-7u6ZbjZxCNz7iIZzIShKIY5_J-BPFmEOzWWRRX_lOk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHJ3HlEPqlF5PfG_3uPRr57KDU5O6MX3foTjXUj-EKUg&oe=6AAE9162"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Camping Parasites VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "i
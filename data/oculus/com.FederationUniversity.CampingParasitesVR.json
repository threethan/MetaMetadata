uscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpVLnRwgeIcQ7kNvwE_fIbw&_nc_oc=Adp7ahmPJnw2BdSJvSbn2k7RD_0rtmODZc-hZJJ6XkFD_wolLe2Zd1oui_TNAAZkkFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mCjEwCMP62492f5YFb3Tv55e4mDytFNxTz1dgo2_5vQ&oe=6A07328F"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw7G4m68a7MQ7kNvwGTsaB5&_nc_oc=Adq1N5e3QukftlPyR-1cDBJqaN6IxU313FPifvz_qvTIJrL4VrAdoTQgyyezwsLf_pM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IYltZE_AsnH93FT9v5oEmONCjAQwgcV0CjxHdHz5xfw&oe=6A071CB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o415Zag93gQ7kNvwHZA12H&_nc_oc=AdpxkgFbOYSW5ONUtMMauCHEPYr7AkPKLyr_FM30I1ytyVVPJE4QE54Ec2-PRF6kjGs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TPISiis1sdSSrEXgCfPwxfWQXpVLy0-UlXzy_SZxscA&oe=6A074195"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that 
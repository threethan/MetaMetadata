NPSw&oe=69A2C84F"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgi_I-ayfYEQ7kNvwFa427n&_nc_oc=AdmuwFXfYyZt-FnhrzSYRDrEtjI1scYdisuMPXyZtIkzceLdG5yfDI3H7ds8D0zn7YU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_lUwdFxytwivRDy30Bbasy9t_HJMx1DyRGvFh7lYAAA&oe=69A2EAB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqItHk-MhOAQ7kNvwEzp6Uo&_nc_oc=AdmBLZdO2NtBSYsGHNLgisODJh5yyJSy3-4piMBVL0c5rNJsQI5DQUFRUdUCeoweDLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afupq1JqIKY2Kq9NacdhQziGBdJrcHCv6f94QcBO9HzB8w&oe=69A2D755"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privac
uscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEAUgjb6ypEQ7kNvwHCDKA_&_nc_oc=Adoq8cfbmdug28Xspy7lZVIv6eMi0whivOkp38WWG5gqAWTmS07rwVruOpn-wLTv35w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BHWrs7NLmDOACgOW4mjyiljiK2joKRswsbK9bnw4drg&oe=69D2768F"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIoLP0Rl180Q7kNvwFBxh7h&_nc_oc=AdqE1oZhdyc6KfYlgP0CyufrnxKGy6fcfStBUxr1aHy4ciHNhxWnNhYAV-BU78iVYj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VPveCZZbPZUftMfNdequ4nwGT_B2Isz_y0sx4o5B_Tg&oe=69D260B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA8Q-SPamUcQ7kNvwHFD8dM&_nc_oc=AdqQsY-OJIMAMnlox1GovGtqs1jC672tbPQcyzwg3VJ-J-UhjfWllQ7VCXX9OD8HEYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FNpBRWWNKn40Ts231TGo07Q-eJsjH144A8fQjPUshag&oe=69D24D55"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that 
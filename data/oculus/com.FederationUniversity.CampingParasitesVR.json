dn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwka-EtejpcQ7kNvwH4giER&_nc_oc=AdqXb1VSl-QQuht2OIoG3nfB3ihWDP5HDJgi6Ngn_YnSWwEKPxQmWUpdimSeaG0sxgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlu7gQ8K-Kps95CU-0Ql68zW49vTyROA8fr42P5xyXQg&oe=6AD25BF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkwFhveh2mwQ7kNvwFC7Ttk&_nc_oc=AdpYaUVuIr9BuIBOG_BQSPhL4O5-XnWplBxsHAkn_J_QPJg7CYdetvxgJBTPgpiNFgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZfe3X94gAnl_YAzxMMnrQ9yDxOJcxkyGscBWIOTwGDw&oe=6AD24895"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "sup
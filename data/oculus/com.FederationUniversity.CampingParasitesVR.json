VVhA&oe=69A419CF"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgi_I-ayfYEQ7kNvwElMzFm&_nc_oc=AdnPWxXRBKMP5RkhCiPCQQnrACQKyyi7xR7ZYYAEnt1vqMfTFEueYTew-SioMzq9zd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTzF6YCbHV5xovymfHM9TKgoNEoufX3upcPdSZN1PyWw&oe=69A43C34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqItHk-MhOAQ7kNvwHittzb&_nc_oc=AdkbbKM4osqLm6yDpf2jjO1lQnYWiiy2FDtxkfYuddSobb5IKbVuwKs2prA4gtHVLBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJ2Rgf7baLA7MBsoJMPuO9M0nFqiPzbvnyzkml64a7bQ&oe=69A428D5"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privac
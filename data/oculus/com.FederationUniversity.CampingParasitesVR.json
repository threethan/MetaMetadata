://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974698_738605781811491_6864589510425080853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWsnWyZf6bAQ7kNvwFCBHnm&_nc_oc=AdklglCHWhxX3rHmgohmuRhZVqh5snEo3St0H9rtDgLE0bdsT8mAdr14Nqmj3drji8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvXg7uVyuUtE4qqyhuI3NE92xNZFDbZRflSblS_8F7gnA&oe=6998435C"}, {"file_name": "vlcsnap-2024-04-03-16h22m49s964.png", "id": "1145408583476574", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh7eND-lGGQQ7kNvwGhhJ9E&_nc_oc=AdkKwi54SEqHs1-2zE45fIPCvtAYKqr-vhg4cFiGisYEO_oakOiPEU13Lc8L-wxCCcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuq3Ue5xkgRKn5i9ZEgUSjLOxJS846zT7ge6TaobdJ0sQ&oe=69983C4F"}, {"file_name": "vlcsnap-2024-04-09-11h25m06s391.png", "id": "990153359378736", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566679_990153362712069_1829045077122921579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq0v7SakjZwQ7kNvwHywpdO&_nc_oc=AdmEkHIGjCgLr_KL4sqCuFMCabGMpZEqFioli7EmdloKw64O7TYkoDu7fTy75Lsyetg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuULxmfeVv_3P8JqrbzcCoV0YdVi7F3AEtmuq-7gWoJXA&oe=69986CB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA0kyS7VYb8Q7kNvwFZBZ_I&_nc_oc=AdkBljpXD8aubv1jaJRrBiNXw1iyhi1xlbJ1aqflsEm8ieQixHVkCB_hWFVUF0mwVKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afty33ZPCLotLXxBm9-5Z_2BUh0ZrjQw4npbJYczuCXy4A&oe=69983D3A"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7442505625832568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgRLVGQO4CYQ7kNvwHvoRzz&_nc_oc=AdlakK1XFnVWzBnHRy1eNpJSIuh5l5Fa0usT2DjwpHYfxVO1VjVbDPKwfW2vHANNgbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.ocul
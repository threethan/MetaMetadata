jteA&oe=699ADF4F"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUHbMJStIPsQ7kNvwGR32_t&_nc_oc=Adm4LHCgwW40r3q1V8yGEGiWP-2w5uy9OIZgIAiZM6NBmhIjSGRB_3nmFY0VUF71Xts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftQ6wvpdNCqX65Y-WuhdKTfuPdKHtuDtquOHFSWFWhgiQ&oe=699B01B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uNftjTq2m8Q7kNvwEpXHSc&_nc_oc=Adm3wT30r0_pSlR3M2zgSFaLE0VXGiFwjaLnoH-r9hFUbkzcPawxx1csiyrXpYUeKyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsONJ30X4-c09dWcZpc3NHoO-elWNKtJuaCAlhzfjJ2zw&oe=699AEE55"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privac
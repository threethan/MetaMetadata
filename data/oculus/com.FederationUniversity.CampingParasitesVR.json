e": "vlcsnap-2024-04-03-16h21m57s916.png", "id": "738605778478158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974698_738605781811491_6864589510425080853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj5O93uUrxIQ7kNvwEhNVaQ&_nc_oc=AdkyXfgzJmSpw4i3njLUC_CvQXf-J3vdVkHn4v2eugHjUWbY58jnQBb_fQXyrjBTcl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwExzOX7uWK182c-8GfGM9x-kW6O2HcK2B-2tJwXzJMpg&oe=69B938DC"}, {"file_name": "vlcsnap-2024-04-03-16h22m49s964.png", "id": "1145408583476574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyrMQ4uTSsQQ7kNvwEDAXFt&_nc_oc=Adlgpv55L3L9tHnh2ip16nSSNbQxt2E8nzmKuvU1Dce42eSIHTUxWjhURcdL5Zn-2Ec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx617sQ-BEDjJLbfEmbxcaAUTp10Bqwx12dbvoaqWX-GQ&oe=69B931CF"}, {"file_name": "vlcsnap-2024-04-09-11h25m06s391.png", "id": "990153359378736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566679_990153362712069_1829045077122921579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF_UiPweaWIQ7kNvwFeCUUk&_nc_oc=Adkzmu9fil_tNdYlYAutGhPQqnZO1t7UiO60KniIy0XNNNCtC_5ezjUQ9gpHQgoViOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpmutowjL5KHiyLdmBSsINmO-8yOt8w2zo2bPKqedt7g&oe=69B96234"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoJDfR4EjS4Q7kNvwHV0-uB&_nc_oc=AdmZOUHQB2uC_Yi80yQGuiIn1ihCYMVnlXaIYnAw1oKB7N-DcI2yEc5V1a4Y8uo4uZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtJJo71EPTTI8hxryEE_B9G6eXA7OX-jTQb3UGC8uGvg&oe=69B932BA"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7442505625832568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNqmUpy_MDYQ7kNvwG
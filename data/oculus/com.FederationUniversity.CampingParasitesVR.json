uscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqxiwYizx3oQ7kNvwHFR0KL&_nc_oc=AdrEp7clsuxSDeASOAx99xr7ERbAklH1iJMi8DsBESa_tprcvMWfGrSR6XyNQz67f8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26Q13LvozsaoDFr7OJEMcsjRre9N09upQJ4BazVzhNwg&oe=69ECD48F"}, {"file_name": "vlcsnap-2024-04-03-16h23m12s763.png", "id": "2517726955074571", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195910_2517726958407904_5999032242929387525_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZnthtmpz10Q7kNvwGObguj&_nc_oc=AdoEy43VDalJCqqxXWRxbsyzTE2fwsqYuyNsHm4YIvDizpqAT2S1MJJKIfyT7cRWjwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kvgC72H56X1Qi_xrrpkZGk6va9Sza8TQ4lSJFm8SObg&oe=69ECBEB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "808917054384177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621346_808917057717510_348664999365519455_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYy-ygriI64Q7kNvwHt4SS5&_nc_oc=AdrBI4NuThCPn5Nx1KTFwNOtn-O9M6JFqPAPY2uwZGV_itQiW3E6IlRLEn4xVL--Lds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OZmjGHMDRcgIFk7lM5WF24zf8j3jtouaEpyrNArYehQ&oe=69ECAB55"}, "display_name": "CampingParasitesVR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that 
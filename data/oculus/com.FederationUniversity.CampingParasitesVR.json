://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974698_738605781811491_6864589510425080853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKbcnBKbfOAQ7kNvwH7qIQp&_nc_oc=AdoUYxi_6ohR_Hq3zvP7RZ38dz5b0G90sb6w93RyYzsraTAZryh3gaFcd8F3o-Yutds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2AI3itZz53p32iXQBbcXWRNR8aAW4pd2-hT6fs6Xo7Lg&oe=69F0D01C"}, {"file_name": "vlcsnap-2024-04-03-16h22m49s964.png", "id": "1145408583476574", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330715_1145408586809907_2174860653630430099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YhoW3q5iMUQ7kNvwFsZdCV&_nc_oc=AdqDF1le7BD6QCvAPFuzkqfFygK_bu8tfIvjL2S91l1STzra-mXnhLFqiEca9lJePII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3LPQQLmWdZCt3QOMqPfVszN7SCcCLFMRV-raRucO1q2Q&oe=69F0C90F"}, {"file_name": "vlcsnap-2024-04-09-11h25m06s391.png", "id": "990153359378736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_990153362712069_1829045077122921579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBWRr7UgbTkQ7kNvwHiXp5c&_nc_oc=Adp5Y4RGQ0rDR0Tuih1i7O_YwWWqc_3tbc1t9HzyOipYwC4wracrSs4rQzv1qnak_Lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2dlS9-SJmHaXaLtaKkW7tiRYMn9CYws5JcFNkAm65Xqw&oe=69F0C134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App_Cover_Landscape.png", "id": "1018296166299033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982518_1018296169632366_1533638476091087477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc3bAhqlu-wQ7kNvwE_-cUi&_nc_oc=AdqzB_ndDkB2Js13w9G1ghNzWntBhSBblRKb6Uc-dqODlc6Bzy_DKmHSkljxhLLL4NM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0KnZfcUZwrAJkA0vQdJdI3nEQG8USaPaH1vo_DvSIFqg&oe=69F0C9FA"}, "display_name": "Camping Parasites VR", "keywords": [], "long_description": "In this VR experience participants are encouraged to explore a camping scenario, and attempt to complete several tasks. Each task emphasizes awareness of parasites in the wild that may be lurking, and teaches preventative measures to defend against parasite infection. It is a hand tracked only experience.\n\nIt was developed by Mr Evan Dekker and Dr Sarah Preston at Federation University (https://federation.edu.au) with funding from the Australian Society for Parasitology (https://www.parasite.org.au). The original concept and tasks were pitched by Parasitology higher degree by research students.\n\nPlease note that a play area of approximately 3m x 3m is required for this experience.", "short_description": "Camping Parasites VR is a virtual reality experience for preventative parasitology education whilst camping."}]}, "developer_name": null, "developer_privacy_policy_url": "https://federation.edu.au/__data/assets/pdf_file/0006/617199/CampingParasitesVR_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Federation University Australia", "support_website_url": null, "website_url": "https://federation.edu.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7442505625832568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622020_1492524921620154_6714756420492948458_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x39oH2Z4nhQQ7kNvwH6r6HO&_nc_oc=AdqOlMZn3NEtTeFDrhTzLxpUaGLERXxolx_TfwFibCnglArK3hOvp0dBZ5v5iPPCNNA&_nc_zt=3&_nc_ht=scontent-iad6-1.ocul
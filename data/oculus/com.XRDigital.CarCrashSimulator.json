": "screen_2560x1440_2026-01-20_13-01-29.png", "id": "1969168150481765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1969168153815098_1268075573958744313_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNaAZFokIjUQ7kNvwHP7C3_&_nc_oc=Ado_fCUxW_8HMBmUZJXj7gem3-mpjkzqZI2yJtHXTGaWb44A6_-o_VhT5PMjxv7RpCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u-D3Jq-h0XgnrPMeqHZc4j60VZA0bpsFumgHIqOWmng&oe=6A3A9B14"}, {"file_name": "screen_2560x1440_2026-01-20_12-59-58.png", "id": "897987706423151", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_897987713089817_6563796499452406935_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byZHiBLsJPIQ7kNvwEJKtKO&_nc_oc=Adr1OckCn-AwW07IIQiMK7o4v2MpXRgc67FA-1GQiGFiUXPUe3LZj0NuK5b1qnWOs4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bMcQNZtF3-j38bNldnb88Wv3crLViILwJWDanxKnvjg&oe=6A3A98B0"}, {"file_name": "screen_2560x1440_2026-01-20_12-58-42.png", "id": "1461831822338488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1461831825671821_1613501223148834940_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYApd1h5LPMQ7kNvwEig9uX&_nc_oc=AdqsjcjB0Sva3ylVBzCLaEQ39_Zk1LRNK4gr3FwrgGn61WgSTt-aG8dsI6pYE0fcbYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yQ0VG4eiApXklfCJSaksZT0GYqTx_OyikwmEqlCrVXQ&oe=6A3A99DD"}, {"file_name": "screen_2560x1440_2026-01-20_13-07-05.png", "id": "872973602135494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_872973605468827_3359750998814292352_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NBd3hZuzEcQ7kNvwGouXLv&_nc_oc=AdqSNYgGQ1g9LtnJn5T8oWObmHn7AaXWldtWdyXc5yo05Y81ClOSSZUnP37_ivXnBKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hDDjb5BVJ7FayDnjd7agxJ-F2ON8882fZe2YVJJ2woA&oe=6A3AA06D"}, {"file_name": "screen_2560x1440_2026-01-20_13-06-43.png", "id": "1185065850377324", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821682_1185065857043990_3284158692037187504_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG2aTl8QDIAQ7kNvwF6EaFh&_nc_oc=AdqSPnFDIrH1-iOHc0LBZU2QM1KuI2v3MWsVPUdr5epy2tXSD7vnHCKlyvN2laF52so&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7zgP_BXs-Mbjhf5y1s8eyv03D7CbGcqmsAzqR-F0SPw&oe=6A3A9C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies & TV 2_9_2026 12_44_28 PM.png", "id": "1104697781730608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_1104697785063941_2872457152044535051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbIuNdh5SzsQ7kNvwHWHNxY&_nc_oc=Adp9Upul0z-FlANNhn71e4jLkdpTqubXE3RVUGSX6zsNnd2LU1FELggtO2hPFCXSGAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QUqxUB_SgkD8e-PLd7nByk6UiUYB_B-3rRcX65owCRg&oe=6A3AA0A9"}, "display_name": "Real Car Crash Simulator VR", "keywords": ["carcrash", "carcrashsimulator", "carchase", "carpursuit", "cargame"], "long_description": "Step into the ultimate world of crashes, chases, and high-speed chaos. In Real Car Crash Simulator VR, you\u2019ll take control of powerful vehicles, tear through massive crash zones, and stay one step ahead of relentless police units. Every smash, collision, and rollover feels incredibly real thanks to advanced crash physics, soft-body style damage, and immersive audio.\n\nKey Features\n\n\u2022 Hyper-realistic crash physics and dynamic damage\n\u2022 Police pursuit mode with challenging, reactive AI\n\u2022 A wide selection of cars to unlock, upgrade, and destroy\n\u2022 Open crash arenas filled with ramps, obstacles, and stunt spots\n\u2022 Smooth handling and intuitive driving controls\n\u2022 Stunning graphics and lifelike environments\n\nHow to Play\n\nPush your car to maximum speed, drift past obstacles, and crash into whatever stands in your way. Stay alert as police vehicles track you down and attempt to stop your escape. Try different cars and crash setups to create the most dramatic wrecks possible.\n\nWhy You\u2019ll Love It\n\nIf you\u2019re into realistic car damage, thrilling chases, and over-the-top crash action, this game delivers pure adrenaline from start to finish.\n\nDownload Real Car Crash Simulator VR today and see how long you can outrun the chase.", "short_description": "Real Car Crash Simulator VR delivers the ultimate, most visceral crash experience, placing you directly in the driver's seat. Get ready to push the limits of vehicular destruction as you take control of a variety of high-speed cars. Your mission: to aggressively smash into a multitude of challenging obstacles, witnessing the raw power of impact. Brace yourself as you watch vehicles realistically deform and crumple, showcasing stunning and incredibly detailed damage effects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://x-r.digital/privacy-policy/real-car-crash-simulator-vr/", "developer_terms_of_service_url": null, "publisher_name": "XR Digital", "support_website_url": null, "website_url": "https://x-r.digital/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27245717598395012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303679_2467125710369955_7390186213163504010_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij6LHG5yuJkQ7kNvwG1253s&_nc_oc=Ado7b5smPrWjxGKbU_OZqruFpu8
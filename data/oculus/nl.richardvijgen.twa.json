&_nc_oc=Adol0jxDcTKXA-7O52suzmsrvf8HefBv4bbbn6JrcDLxGDrq4e87Jd03gU8MhJ1kF00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWufno1Lp1JucZ-U_iPxdfoclvTn4DQ40Arszrh49b9Q&oe=6AEB2FF7"}, "display_name": "Terra Ultima", "keywords": [], "long_description": "Step inside the mind of a generative AI, a vast mathematical space where all the memories and stories we shared online are compressed into a statistical resource. This data-driven VR experience reveals how AI models extract and organize our visual culture into a multidimensional geography of meaning and how the space between datapoints promises infinite potential. But this digital mirror isn't neutral, it's curated, filtered and biased toward aesthetic ideals. As you navigate through dense clusters of contemporary online culture, it poses a critical question: can this really be a space for artistic discovery or are we pulled towards the points of maximum statistical gravity?\n\nTerra Ultima is a data driven experience that explores the concept (and promise) of Latent Space as a contemporary cultural phenomenon. Latent Space is a metaphor used in data science to describe the empty space between data points. It is what allows generative AI to extract \u201cnew\u201d images and texts seemingly out of nowhere. Because of the scale and abstraction of AI technology it is often considered a \u201cblack box\u201d. Terra Ultima uses immersion to descend into this hidden world, translating the abstract mathematical space of an AI model into a virtual environment. It shows the training data that was appropriated by the companies who built and trained these models (through a dataset called LAION) and allows the viewer to explore this space in an embodied way.  Run time 8 minutes.", "short_description": "Step inside the mind of a generative A.I. a vast mathematical space where all the memories and stories we shared online are compressed into a statistical resource. But this digital mirror isn't neutral, it's curated, filtered and biased toward aesthetic ideals. Navigating through dense clusters of online culture, it poses a critical question: is this a space for artistic discovery or a black hole of the imagination?"}]}, "developer_name": "Studio Richard Vijgen", "developer_privacy_policy_url": "https://richardvijgen.nl/terraultima/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Studio Richard Vijgen", "support_website_url": null, "website_url": "https://www.richardvijgen.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1298961179975125"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452919449983876"}]}, "baseline_offer": {"id": "1452919449983876"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791289980, "status": "PUBLISHED", "id": "1452919449983876"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1323517757519467", "version": "17"}, "id": "1646731873509883", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1283022381569005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1323517757519467"}, "release_status": "RELEASED
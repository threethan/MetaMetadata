ss=7f20f&oh=00_AQTwOuZJtz67yJXNVsz2Wk320FgkHImw-J90lWFYpJxRJA&oe=6AEB5D80"}, {"file_name": "5.png", "id": "2115370452401880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_2115370455735213_3389223578822221410_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sn4nGJhCcEQ7kNvwHFbsBp&_nc_oc=Adq0FaPdBnpy06kBfEWWB5f8PJFz842aoCSAFWd_3tdFLq66PbUZ_5cyXnH7e_MRVUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoZ6QlktQeGxLWJug7zBgtuKwZtlTaNE0fAzQ06PkmFg&oe=6AEB419A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash.png", "id": "2348342235927517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_2348342239260850_2300317417533692183_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN6ieDniXh4Q7kNvwFJl45o&_nc_oc=Adol0jxDcTKXA-7O52suzmsrvf8HefBv4bbbn6JrcDLxGDrq4e87Jd03gU8MhJ1kF00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWufno1Lp1JucZ-U_iPxdfoclvTn4DQ40Arszrh49b9Q&oe=6AEB2FF7"}, "display_name": "Terra Ultima", "keywords": [], "long_description": "Step inside the mind of a generative AI, a vast mathematical space where all the memories and stories we shared online are compressed into a statistical resource. This data-driven VR experience reveals how AI models extract and organize our visual culture into a multidimensional geography of meaning and how the space between datapoints promises infinite potential. But this digital mirror isn't neutral, it's curated, filtered and biased toward aesthetic ideals. As you navigate through dense clusters of contemporary online culture, it poses a critical question: can this really be a space for artistic discovery or are we pulled towards the points of maximum statistical gravity?\n\nTerra Ultima is a data driven experience that explores the concept (and promise) of Latent Space as a contemporary cultural phenomenon. Latent Space is a metaphor used in data science to describe the empty space between data points. It is what allows generative AI to extract \u201cnew\u201d images and texts seemingly out of nowhere. Because of the scale and abstraction of AI technology it is often considered a \u201cblack box\u201d. Terra Ultima uses immersion to descend into this hidden world, translating the abstract mathematical space of an AI model into a virtual environment. It shows the training data that was appropriated by the companies who built and trained these models (through a dataset called LAION) and allows the viewer to explore this space in an embodied way.  Run time 8 minutes.", "short_description": "Step inside the mind of a generative A.I. a vast mathematical space where all the memories and stories we shared online are compressed into a statistical resource. But this digital mirror isn't neutral, it's curated, filtered and biased toward aesthetic ideals. Navigating through dense clusters of online culture, it poses a critical question: is this a space for artistic discovery or a black hole of the imagination?"}]}, "developer_name": "Studio Richard Vijgen", "developer_privacy_policy_url": "https://richardvijgen.nl/terraultima/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Studio Richard Vijgen", "support_website_url": null, "website_url": "https://www.richardvijgen.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323526414185268"}, "review_messages": []}]}, "cover_square_i
=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSnP7oaTHiDgHk6gSsd1KnzDz3xtLaop8qiBqocQojjg&oe=6AFB4810"}, {"file_name": "SS 2.png", "id": "681642347997805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98Gw8ziLJlQQ7kNvwHdAgiA&_nc_oc=AdoT5U9NN6ruWbMDNYDsPETEjPI6u9X0mZZeey7GQD1HcpBiLS8fkVb6vDpHC0WzFJs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2FvSdxGJHXxlQOA34oPcaSmzCHiAsSQkl8Leb1m7Bw&oe=6AFB35A7"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRY-mhzUf1QQ7kNvwE24Cli&_nc_oc=AdpGu7PHQEFBIeC0U3gp36HgLoMADxsp81x6Nhz9Qp3bXdfNFQhrmKrSlxURuzUEZF0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNVuOhoSHT3IoU-sOOpgUOAT2e37mygReqQivzLQ3bLw&oe=6AFB26D7"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De4eWftrFqkQ7kNvwEv4iqC&_nc_oc=Adp7jWNva8DuFsPkat59Zb1ySeg-zsULSVSQb6xllnFm9_S_Ek1lrRbTBw67ybrKHWQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKjbJpPU7xVvYMOfE5iJjs7h9qgGxVD6HUC57eXP3WAA&oe=6AFB3391"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xgfB5sLnpYQ7kNvwHQff0e&_nc_oc=AdqxOijntAhdu3g2gOa1IhAR9KEYTDxoR-Mclml63debtmbOREH-kvhJM5KOJFRaE4I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt2Bp39yGIKNsGne4KBT_jlG8ZGo3maNdWpMZOclqtnQ&oe=6AFB1BB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_ter
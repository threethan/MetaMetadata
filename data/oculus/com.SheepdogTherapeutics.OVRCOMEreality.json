=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViuTsGRKQwjFdbclaMtKqRV6V9AmpjEHdqz_pqtrdPZg&oe=6B106010"}, {"file_name": "SS 2.png", "id": "681642347997805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbrRYhGgc4UQ7kNvwEKj7jS&_nc_oc=AdrVdpAejIpFfKMofnaHzuYWUasZbal9_eV4pEej5qXkrV71ZxNwIz-zjOB7grwF3ZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVnJ6SG1V0nbjYDkHOlcY0PpgXXs-7OW8WuK__eg8c1Ag&oe=6B104DA7"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TONUCT7vRMoQ7kNvwGI80rc&_nc_oc=AdqDhVX3iTnGyZz5rNUmET3fo9mrX12XMn3C4tueGQeMYs68jj22LzOp4IVZkpFhpKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFfSXl-Ago4kKTXuiiKrVCjrh7OqVRWS9oc7wDfETRNQ&oe=6B103ED7"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLIDT0TfsMcQ7kNvwHR_8bg&_nc_oc=AdpFBlC_9upMBemA2CMY2gTDjWGwA-YE0lm_BfxZFpy4_Io97dZUBMqPj3ZokOo1tAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMgQFbvZ5NntrH0plwzsSxoFbAFQbBYxa6OzFZFNMASA&oe=6B104B91"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmt102HadKQQ7kNvwGjShKB&_nc_oc=Adq41VmRtXeKY6k0AxZWMU6gjqB_8uvHVt1owjmedRbTwl_hNECX5YPN1Q3NKZAP7h0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpwhqe_0Zoqc9tImTMqGh3kHZy2Aj5fZL5SBlRdM8Kkg&oe=6B106BF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_ter
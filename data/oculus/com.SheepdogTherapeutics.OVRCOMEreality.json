51331138_1144107631829234471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukDZt-EGbSUQ7kNvwGkrb31&_nc_oc=AdmW1PURX9FdXwubUTsripc7Z6ZgXioGvskq4JzD8c3juQafzrPU7Uh4eGwhYnX0NNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_s_zP20J_q8lH-e0tnpF468NMLmj20rx_Iaw9K7ocuw&oe=69BBF267"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDrC8PFf4GMQ7kNvwG_adMk&_nc_oc=Adkj3qkFpTvSFup7AbQX5CR4OUKONlD9xinz8KgrvYFja7C_kpfJ0rBT8Q8yTnUxO9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxmAofMYMpAAEJXONiRF7Kcn-JYuT4iaD2CZ-PC4VJV7w&oe=69BBE397"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2eaOowEkZsQ7kNvwFZ3v36&_nc_oc=Adl5PKojL1fhbptfwQhVQZnTlROgug01y5qcPI3GgZWcpnfqFNqnRqpGNy7R9TyOtDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydNiB8GyflyFVFEzA8RA0UtQNYm3Oka4FfSd_Hxo9BJA&oe=69BBF051"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2lYRXqN0p0Q7kNvwGkYzrG&_nc_oc=AdmeyVi65vEg7tQ-L5J3QHJMYQzdd7GpO-jM5387sOqaKtJTB8zi3thlOGMau6k04U8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdRmND_AWDaZEJBoVx5ET30tgMTDZS4yW7UU5Xop9s6g&oe=69BBD870"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "ext
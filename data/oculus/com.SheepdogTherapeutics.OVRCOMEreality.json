content-ams2-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V3QshSR9DwQ7kNvwGPWRD5&_nc_oc=Admg0pT1URjthy6gjpmNQDEekD1RITZejBF8KqOxf_a29nbpu7bSqaGVGL1HGtIJ_uw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPihGm9JFmeUlNMxeE56kTMjHCoGJBLs5FihikBvq0RQ&oe=69B00617"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twkKk0O1MiAQ7kNvwGRNn30&_nc_oc=AdljAR7aKL3Zka_ABbTMv-PzyAso8EcWuNTbKob17wdyQnwZsR15DOjqUTZ3tWAKhqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3C2fhvwXkmY8orZuRQnjOPgfE-D3NfvIchVhFFdrMKQ&oe=69B012D1"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c4m2oDN-BIQ7kNvwELzV-c&_nc_oc=AdnRwTIGvNE0QtGj3vd-h2mkxJ6BK8vniJC1vsix7B5gt72JyMUBV0Fh7FwhhMUhPL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyumrAuCWcL-ZuIXpqPYJBgt5tJ4mz0h9FVE0hNRMhYxg&oe=69AFFAF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTIN
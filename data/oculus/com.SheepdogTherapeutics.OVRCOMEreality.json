c_ohc=eXE7SUfkMyYQ7kNvwGcL8zz&_nc_oc=AdnWCihF1wjLC07-7dPaznHhQW2wAFGn9mi9e1obcVYhvdpn3mrN0uzHZYAHakSyfY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBLj4__BgwFILCHuRiMPcxqfBzVByhxJzr1288CdqUCA&oe=69A6DA67"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln7V8p-ynjMQ7kNvwGAO0xL&_nc_oc=Adkh178H5H5oflB1u1zIkmivrb0KnwkVI0EJkdRxsNBMCAExf6Yj3ll9mhUsH6TAPSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveFJro1BfiYEpMZ5_6MwD4eJVQADVBEkLrdbNfpnwGXA&oe=69A6CB97"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lheJ8YsuZ28Q7kNvwH1O6qy&_nc_oc=AdnX2x6x425sb_oJRqMBj9eSfBjI8JlnbVGXU6j_TpqebR4okwxdZt_UGJNsXxOL59Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOS2dTVt_m5zvzQY5PyNpTD82Jaxx6lPWc5HDx3a8obw&oe=69A6D851"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0Sy8LG39IcQ7kNvwFLd70l&_nc_oc=AdnoEK6NsXTQNEs5ZCK6m6ub1yFIkeJszydWZ71Jdd6dlAJV36PHWgXln6dWbYwBsNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfveTBsxax0ZqjyW86BdCTGMiuPlfg9w1S99F5zh_D3eEA&oe=69A6C070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
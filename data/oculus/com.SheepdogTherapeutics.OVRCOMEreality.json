51331138_1144107631829234471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roIaHEAqy1oQ7kNvwGeDhC3&_nc_oc=AdkSHz9ZwLX0RCMA1U9aMsJEZbHkHax0rbCRXwW70odGMZ3cbZd8gebyavfSdQVPUfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIQzOIiiSWYI1Q4atuE0ZTw-2Q8lUoKxJtlecbOhXkiw&oe=69B6AC67"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m4nzDJY6hkQ7kNvwE27OCW&_nc_oc=AdmNdVb7he-t3v0ke-zoxvIbfn8_EgeqUcvzuvkQDeIQ-_875nFkwTfJblm6wepwS-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyITFEA11tiCOdj-w1vYrsJ7CNT9JDLkV59CYMBVK3Zzw&oe=69B69D97"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-x3jNsjWWgQ7kNvwHnQf_Y&_nc_oc=Adl7IOc4n9xQ3v1H3E2rmACX6dkgfWfequZxe-b7jGvX-CNT6DL_gK87SjdjFfzDdhw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybCz3nGcf3V8OYm4p0j-Y_Z5N-ha9RKFN8vR-cyClo8w&oe=69B6AA51"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ldpOASVEuwQ7kNvwGAN5vG&_nc_oc=Adl19o_Wf5jjumnSTT3xJFcC55BKhMlAHsIIxl9RVPuzLJCaGdxWXa9KDokfdiMso1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtIwwq4GsyVg2AtXxi-Vq6R8gcEaJnW8ycMyF3ikHZkw&oe=69B69270"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "ext
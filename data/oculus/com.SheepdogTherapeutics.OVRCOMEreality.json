51331138_1144107631829234471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAYnKxEzdrIQ7kNvwGey1S5&_nc_oc=AdkfpUHs8e-Z0WJ8O6FgXpDjXk4K7TrTMzqFosAPVZ9py8UfmmK_-LJgRglCmS9Faps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxW4HPL2rCv3geTzpaNI4TF-VI6--XEm7QUNwTcIdxatg&oe=69AC2067"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBTEbe8gmdMQ7kNvwGXUdWk&_nc_oc=AdnpjrOrhPpQpve5uAeNtIUBxq8iMCXaADMgqIxmHZ0OIklXs632A2U_b8I-qdgpS0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyuWVKzfRKJwJTUhQU9rgBR5X12Mxgdc8NS_3YNliClqg&oe=69AC1197"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x4d2Pz3ascQ7kNvwHXrV5G&_nc_oc=AdmCeNeoLv5Q76lm-DSNmkd5zxG4WJqlkVJpDnftstNFuTT9R9iA2f00G0czkZzr9mM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDtYj-CFyZJq3-EHt-1Vz9NchCKC7DTSXKQHRvHQF8vw&oe=69AC1E51"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrKDDCpp8QgQ7kNvwGHLtn3&_nc_oc=AdmlAHQLIvrls66ccP3WlkgTcwwP58EVaiVUdp-YKBKCRCtILDjKvFhqLmZGJ0_Z8VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxzqqdu0dKMuKLk-clO8nbJHHqAhi2heJ_4dRub95or1g&oe=69AC0670"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "ext
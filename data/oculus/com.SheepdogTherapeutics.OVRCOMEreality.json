uscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u12CajveC0IQ7kNvwE6xMYn&_nc_oc=AdqX1JTWOqA1oVBQF-x3iW1fIKI65yRXIAOWcUXcvD1l2lCbkvWQqvJuL1QD-ZwSLJQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f_EGe2QG21xK_IAwwZlzgCd31FcBUnua23EeoyXDzyQ&oe=6A22FFA7"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aECnaX9-1wQ7kNvwFYC_7S&_nc_oc=Adr37cQ7F8injQM7rQQ152NnArZFIDG5FrhoPy_SrUylWgsEBbVFc_10ZvKTDLU3jp4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yo8CiV2ZDyJbx3ydImTml2vgYb4QPuMorfPdU8mh6PQ&oe=6A22F0D7"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBBPcBIpuL0Q7kNvwE8Xrb6&_nc_oc=AdrfudnVSCKRZmmNmtF2Ckz8_At_shXhmHPOUwyehpyJ7ZmDacQzyBFGggKjBQIlzOc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-Xa_bpZ-3x2xnHyzxuqDh-ua66D4I3JEmbLM9MShYrA&oe=6A22FD91"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd3tCURiIbQQ7kNvwEZzC7E&_nc_oc=AdrI3zG70T73R6vutp_LTh5-BlLYd45SYOMS4eELTm_fYSrQvjFuUoMOAIVGuTCHnnU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gZh3xhWmcsiEVj5xz2IFp_AkFJQ4kcBFPhI1jlva91A&oe=6A22E5B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": 
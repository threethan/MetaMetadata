uscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgIzNzBTNeAQ7kNvwEYiGR7&_nc_oc=Adr6g6u_T389hRCSqLOcSkEEyznW-aYvlN3xmJnbcwCPoFWUk2YeUkJ7Lnw3kwspFH4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfUlMRvP95JMT2SPBM4Y5o-w0DLc23egRnxOY9qowRvg&oe=6A7DBEE7"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-J5cMsIKPsQ7kNvwEdUbmH&_nc_oc=AdphyRQv14cNwiZsGTEapqItBx0wQrBdsIxpRR0DDDAiYQKFHPsCucBzGgFB456Y1gM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNkQnixEdVbsMLdicuG4rQe_obFoWLzyFpkJsEGPNMPQ&oe=6A7DB017"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M1MzMn-yKUQ7kNvwFcz-iK&_nc_oc=Adq6PosJnC4U2605DYh8dZxOw3FBGsbQM8mX6QnI_Sjk3wc7UwQFPvTn1vHn-OnHR8o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuJ1NyAiy2cxVUhuCW0YXAzAFIFSdqAM47g-UWy7wiGg&oe=6A7DBCD1"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QxxkcCXNBAQ7kNvwEowR-H&_nc_oc=AdoLd-osqNKAg42Uhoujw7AdsQDa8iBL2RaUckqITqectQI_MJlkwBxas5aw_64oLDY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrRlbkL_vM1hYU2gB3by44rzabGqfkLVlHloIQVp0e5w&oe=6A7DA4F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": 
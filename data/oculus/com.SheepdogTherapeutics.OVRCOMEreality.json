c_ohc=Bu8pJ3Nd5CcQ7kNvwEwoorJ&_nc_oc=AdqVKsQHgn-cGTmpARZl1Pm2bS01IGcM8hlCJVlF0jNxl-XsiFDQu2kxO4D17NrewfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3FTP_Dm2PVMupWigvf9ICIKGVE9EFBgj7aThZ5JdTTzQ&oe=69F0AE67"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x7jbU6CCbgQ7kNvwED10wy&_nc_oc=AdrPLBwVxNFHRkRH9_qSwsqlPr3PMIUZWH2mEd65kUgf6Uh-OCsldlCmmviTu7IRy7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Bx8p0371dHk1Qza_OkXgDMl76DB6CYmjMXDZtoAvQxg&oe=69F09F97"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHXJUGJtuYQQ7kNvwHqouJ3&_nc_oc=AdpuDbiU1iS6-S5RsP34BtaHJgw2UzBogrP3-8Mj5rjcgQHpX__29zBj9nKI7NR4hqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1YG7Av4VdY-4x-sZdugk42OCATPFmTI-4l0hGMqFjsow&oe=69F0AC51"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbD9wpew3tAQ7kNvwHWKCmi&_nc_oc=AdqtVFGIHddz838BBRTJh1bRewdLEYiWl-VzxDD3_plKiCOSs1u41fDHoAdSpExnKME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1kDsoySTg46FJ70eVOkR9DQV9WjGDaAugShImTDsuX7w&oe=69F0CCB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
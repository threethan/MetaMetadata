uluscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV8ZkuaCFPYQ7kNvwHSjbiL&_nc_oc=Adol793uZtooGoA3FDDrIZQwZZMsRwRknG2X3yDC5r1hSF_XntvyN3o7kSz0Vb_IhZo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe3eZ7Rwd9hdBbfzML1R2y6vDrqKYwMJtRn1hBi2W_yg&oe=6A85A7E7"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BzjOkxLVukQ7kNvwHManqi&_nc_oc=Adph3rVi_8rz4x8NHnINZbQvw2uZm8XE6inYrjH3jUx7JraEPaAWSvS-BI9Qj42qj7o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJCrPcaA2JNHMdBQQT37od3a4E9WdTzHwcy6OqM9ji9Q&oe=6A859917"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4v36yrxYYAQ7kNvwHNEVNg&_nc_oc=Adra113ViVZQdBBSeR-Bjz2--gGICeTtsTFthJ4jja-ID73qGpYAbSj6rrDvbr4ZlFk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOGlKcixlx0iFwOMucyroLiwLI5Djro1nhMHN06BBISg&oe=6A85A5D1"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mrYia9Yw_YQ7kNvwHpdioP&_nc_oc=Adp1VD74TQ5kdB-hKPlqqupIl23cSa-b4xge-beutCUxzvDLjGdVJwu_Ok815x1kBZ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgGq_vqjpKvxVzDs41zbfPUyrtGtvylanUU56KGugqIQ&oe=6A858DF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sheepdog Therapeutics LLC", "support_website_url": null, "website_url": "https://sheepdogtherapeutics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categor
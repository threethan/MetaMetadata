=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuNSWW5Ky6Ngn1LMheR15UuZr51R205_0tTPsuTmbNQA&oe=6B01DF90"}, {"file_name": "SS 2.png", "id": "681642347997805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WqtjLT_xoMQ7kNvwE_kG0u&_nc_oc=AdqaPu76g978TOFyavnrPET21BxbuHzWqKvwOvBUumnOIkkJNJ6o1n3eTW9W3oXMPdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVKKqcG_dg98P4JdLLv_Hi_-O65Aw1-BPPq-FVGCQa0Q&oe=6B01CD27"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SLojFGHEGYQ7kNvwGmUEDu&_nc_oc=AdpPnNa6GAqSFLqGMCR-WhMLewaCGiwr4e3t1TWTuezmRIm7Uxob3Qcqx2dG_k6-u0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIYcav-KQ5HbbV9SCjkH4HruybN_gLdeXKYI-__1CPTg&oe=6B01BE57"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP5zIXI3OH8Q7kNvwHs6Lt3&_nc_oc=Adpcj4M3c9G1ZquDsTP-W09tM3KgyWx-BljClSsJXbc2mS_6c5ODEgyHLCfgqm-OOZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqZtGtMcLWw2epk8VK7s8FKTxCqt3hyht62pa6fnapgg&oe=6B01CB11"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knurxd3HtREQ7kNvwE6oRKD&_nc_oc=Ado6tIcf8RcVZiIcVneGrRaTb6zWa2FXpu4kytcQ3p1mnE5o3-8LlmGJOO1qJWT-N6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMYDr53RCfsZ-PJJXDpKhcAK3oy-e-cLxVtRqk-OLUOw&oe=6B01EB70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_ter
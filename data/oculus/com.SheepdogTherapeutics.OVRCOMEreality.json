=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvR_W9Qa_TiU-eY1zBgVh-Xz5Nm_E96zhqLpYgVaDb4Q&oe=6B09C890"}, {"file_name": "SS 2.png", "id": "681642347997805", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEdx9o252uAQ7kNvwG2qfWU&_nc_oc=AdrG9KvDHghtTlzfpGD47WC35ZxK8daeGNcpS5-Zd6qhMpRHXayr2Knw7rj3-K5mZfQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtQmTKzepa42C2As7z5iuKB38DXQKb2KtzV3W90XQarg&oe=6B09B627"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2v-z6BcicsQ7kNvwGCTRer&_nc_oc=AdoRTM_dQH_G-A9469fzrQhW8uWGVsgsNdE91l3uo6BgZBYhBSoNKtOzaPo8lwuqe20&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWd-R6IEIQAd7pxXDCzp_hF8VrLLORQR2oCLmyCHn-qw&oe=6B09A757"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=510aDGo-99cQ7kNvwH7hYFS&_nc_oc=AdpvTAtgBtrFGjAYZATb8k5lOzwlMRyDWiPjb4ZoGeLIeV0UZdWNSddWGOCU_jC10gQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqWQPwJGy82AZ0IudEIUmPOmVRGI6YBNzWhJGtIkBpUQ&oe=6B09B411"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zBL_5nx1LUQ7kNvwFOUtDQ&_nc_oc=AdpDbVke6XiYbBNZTfd4zPlkkSaBBSxTMiplXhvdAT1VUiMOW6R4uxer3bNYRkBmP7k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuj2sZLb_XD8C-aTw7BOSz3WgQMNKHtk-Bpymie-N-GA&oe=6B099C30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_ter
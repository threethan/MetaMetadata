=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDnRLbkB1qoNIS-v5jIgAmrXCwd6K5nd3F0ZZocuQjrw&oe=6B0DBD10"}, {"file_name": "SS 2.png", "id": "681642347997805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393827_681642351331138_1144107631829234471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpDxH2n6dccQ7kNvwHdiYMG&_nc_oc=AdrNyRHa6DxRmiNG_nmgM82esTOQw-1EAFflxpUULi2uOBHHWNmcAPEfNVKnYm2DGW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT295qA0Lz3JkVZBjwgpWtcZ1FEWkTiWn98MR59jyjBxw&oe=6B0DAAA7"}, {"file_name": "SS 3.png", "id": "878896681089692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618056_878896684423025_7938109788866274252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mfc6c_Mp0kQ7kNvwEGugIO&_nc_oc=AdrAgHvjXllL53IdQJ6g3lcf2VIIdsDeJzLA8Gcl0RuZsgNij1AOQYt6i-uzMrv9pMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSedDA1CwazdhqpSGFGSm2AOc5JK1jNuIR67_fGaSRBUA&oe=6B0D9BD7"}, {"file_name": "SS 4.png", "id": "675739215286283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623321_675739218619616_7558413963940472379_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnICQ956hlQQ7kNvwFfp0Hl&_nc_oc=AdoqXZHw4Id8feRBunu1g4sSe0I00xwxfo6rwGlKoi0nSKlUlFOJJ1qpBZ6GgvwtWhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXo5fjRKNPb7xNvHZwhdbJ6ayHI1ZT4aC8AiAhxxTpYA&oe=6B0DA891"}, {"file_name": "SS 5.png", "id": "2554056678276810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307417_2554056681610143_4076224680162324997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmt102HadKQQ7kNvwG4DMl0&_nc_oc=AdqLdXfzfVpIRJ8YTqH8Wg5-GZs4dtVA2xWjVvQGNHZi5z1hWlqFLH1T4E2UqRBVcDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiZ0Su8Pg98MeREwH21lLcojEkgRGa3y8i3PUyS3ECjg&oe=6B0DC8F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVRCOMEreality", "keywords": [], "long_description": "Welcome to OVRCOMEreality for Corporates, an immersive VR platform for workplace wellness. Using emotional resolution and brain training, it empowers employees to manage stress and reset emotionally in a private, self-guided space. While not a diagnostic tool, OVRCOMEreality improves team well-being and fosters emotional resilience at scale.\n Why OVRCOMEreality?\n Backed by neuroplasticity, our sessions help employees release emotional stress and build clarity. Unlike one-size-fits-all wellness tools, OVRCOMEreality supports long-term change with science-backed methods and immersive VR.\n Key Features:\n Emotional Reset in Under 60 Minutes: Self-paced sessions help teams manage stress and improve focus fast.\n Science-Based Brain Training: Uses neuroplasticity to form healthier emotional patterns and boost performance.\n Self-Guided, Scalable, Impactful: Employees engage when and where they need it.\n Enterprise Dashboard & Insights: Track usage and outcomes across teams.\n Imagine a workplace where your team can manage emotions in real time, stay clear under pressure and bounce back faster. OVRCOMEreality offers a VR-first wellness strategy that integrates easily into daily workflows. Bring emotional strength to your organization today.", "short_description": "Enhance team wellness with OVRCOMEreality for Corporates, an immersive VR tool for emotional resilience and brain training. Empower employees to manage stress, refocus and regain balance through self-guided sessions in under 60 minutes. Built on science-backed techniques, OVRCOMEreality fosters clarity and healthier emotional responses across teams. With secure deployment and impact tracking, it\u2019s a powerful step toward a more focused and emotionally strong workforce\u2014anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sheepdogtherapeutics.com/ovrcomereality-privacy-policy/", "developer_ter
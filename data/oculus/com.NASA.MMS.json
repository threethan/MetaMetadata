cowLXJV4CVxn2efINJQ&oe=6B01D4B8"}, {"file_name": "3rd_cropped.png", "id": "895368759909597", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_895368763242930_3583617501666575404_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn--ylUhtR4Q7kNvwHi6aEB&_nc_oc=AdpWDy09_wEyHt78IMeVXZF3gj0cJ8ct86Hft6Kqz39yWOQ-XhAUY7BvBTwDOvfKJtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY5eQqJD9fXj84rIe99kIbTkusnRQhuQD1tXnAPH5mSQ&oe=6B01D0DF"}, {"file_name": "4th_cropped.png", "id": "1594526331762535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292779_1594526338429201_1333081832200664076_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F8oY6jOB54Q7kNvwGYAwgD&_nc_oc=AdqzQantttQWLHuDFsE-GNEn4cph_rPJ-AzBtMS2BhjGXqnSHpPS5vwnnpv1icJoagk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBR4LEw9_e5cvaSLDPnB0qu-DpwGhkxgaRbvNv2iBHGQ&oe=6B01D045"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Physics Laboratory", "keywords": [], "long_description": "Step into orbit with NASA MMS, a hands-on VR experience that blends immersive simulation with real science. Designed in collaboration with NASA\u2019s Magnetospheric Multiscale Mission, this interactive journey puts you inside a stylized space station environment filled with holograms, games, and physics.\n\nNavigate using a jetpack orb as you explore the station\u2019s environment. Dive into the data cube and use lasers to trace the invisible flow of charged particles as they interact with Earth\u2019s magnetic field.\n\nJump into three retro-inspired minigames\u2014Pong, Breakout, and Air Hockey\u2014each reimagined with magnetic field dynamics.\n\nWhether you're a space enthusiast, a STEM learner, or simply love exploring new frontiers in VR, NASA MMS offers a fun and educational experience that brings real-world science to life in a way only virtual reality can.", "short_description": "NASA MMS is an interactive VR experience that lets you explore around an interactable space station, experiment and learn with labs, and play minigames.\n\n"}]}, "developer_name": "Mean Free Path Laboratories, LLC", "developer_privacy_policy_url": "https://eos.unh.edu/space-science-center/outreach/space-physics-laboratory", "developer_terms_of_service_url": null, "publisher_name": "SAK_Games", "support_website_url": null, "website_url": "https://eos.unh.edu/space-science-center/outreach/space-physics-laboratory", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32711573608487700"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312422_967157679315849_1400206860933606366_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z5-yCZpWTsQ7kNvwFcy_aM&_nc_oc=AdrGpq4bDU-WGPewQZV75KojEFs2AXeL-3bRAdY6l5aUuCv3kinY2BvlMt7304UBpt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmUQ8674MPUIpZ6ive-5fxbABVmTSJvSfQD3K7X3NJtA&oe=6B01C0E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Physics Laboratory", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1778695380, "lastRe
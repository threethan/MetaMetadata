0FzNY5r71MJnvx1n2dg&oe=6B0B0F38"}, {"file_name": "3rd_cropped.png", "id": "895368759909597", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303746_895368763242930_3583617501666575404_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jtQ__BXTi0Q7kNvwF0Dg2N&_nc_oc=Adrmre2ohJwIlWmqDEwt1dEpTGtha2czP8f7g1zCaR8klVaXXrcQnaX5zFT3rHRiAck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrP9Lu_QJbSbLHHzJi8wQ0umdwsppCgmYo6PUqP7QSyw&oe=6B0B439F"}, {"file_name": "4th_cropped.png", "id": "1594526331762535", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499292779_1594526338429201_1333081832200664076_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mswm6QZHAHAQ7kNvwHql_As&_nc_oc=AdrzbGsn5MRoTEYhlE4J_T3c4T9XQpX-CPFGBreZRs04w_f7-y7P91xJ9SBsBF9E4a8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5SdDPRikvWRRJeb6N_YfFNT51hknzYPmEdV6OjwyzxA&oe=6B0B4305"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Physics Laboratory", "keywords": [], "long_description": "Step into orbit with NASA MMS, a hands-on VR experience that blends immersive simulation with real science. Designed in collaboration with NASA\u2019s Magnetospheric Multiscale Mission, this interactive journey puts you inside a stylized space station environment filled with holograms, games, and physics.\n\nNavigate using a jetpack orb as you explore the station\u2019s environment. Dive into the data cube and use lasers to trace the invisible flow of charged particles as they interact with Earth\u2019s magnetic field.\n\nJump into three retro-inspired minigames\u2014Pong, Breakout, and Air Hockey\u2014each reimagined with magnetic field dynamics.\n\nWhether you're a space enthusiast, a STEM learner, or simply love exploring new frontiers in VR, NASA MMS offers a fun and educational experience that brings real-world science to life in a way only virtual reality can.", "short_descrip
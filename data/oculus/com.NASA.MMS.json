_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj9BQLdr5s0Q7kNvwH_d7Vy&_nc_oc=Adpibeph4tk_MjN6izS1EsoeaDyOoKN1nC2O_zVVEZa6DiMlY1oH6mC0eWpZ7FoPqZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUyOfRTMSG91KUqpt9kEXodfSXf5ERS8mXf7oup5obYw&oe=6AA2AC9F"}, {"file_name": "4th_cropped.png", "id": "1594526331762535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292779_1594526338429201_1333081832200664076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBP0CLHD7DIQ7kNvwE-HGr2&_nc_oc=AdqVbUZhuiACudfP7SmVJfg9sRrbtVRL3kR3bbGxFUI3WZPHubTHjG0c_VDJ-ALG6WM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyJ-DvJ0lrCxvoQ-TUPeJL4mFH5Bis1Dz-r03ZTukSbA&oe=6AA2AC05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Physics Laboratory", "keywords": [], "long_description": "Step into orbit with NASA MMS, a hands-on VR experience that blends immersive simulation with real science. Designed in collaboration with NASA\u2019s Magnetospheric Multiscale Mission, this interactive journey puts you inside a stylized space station environment filled with holograms, games, and physics.\n\nNavigate using a jetpack orb as you explore the station\u2019s environment. Dive into the data cube and use lasers to trace the invisible flow of charged particles as they interact with Earth\u2019s magnetic field.\n\nJump into three retro-inspired minigames\u2014Pong, Breakout, and Air Hockey\u2014each reimagined with magnetic field dynamics.\n\nWhether you're a space enthusiast, a STEM learner, or simply love exploring new frontiers in VR, NASA MMS offers a fun and educational experience that brings real-world science to life in a way only virtual reality can.", "short_description": "NASA MMS is an interactive VR experience that lets you explore around an interactable space station, experiment and learn with labs, and play minigames.\n\n"}]}, "developer_name": "Mean Free Path Laboratories, LLC", "developer_privacy_policy_url": "htt
ore around an interactable space station, experiment and learn with labs, and play minigames.\n\n"}]}, "developer_name": "Mean Free Path Laboratories, LLC", "developer_privacy_policy_url": "https://eos.unh.edu/space-science-center/outreach/space-physics-laboratory", "developer_terms_of_service_url": null, "publisher_name": "SAK_Games", "support_website_url": null, "website_url": "https://eos.unh.edu/space-science-center/outreach/space-physics-laboratory", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32711573608487700"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "591413080317235"}]}, "baseline_offer": {"id": "591413080317235"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778695380, "status": "PUBLISHED", "id": "591413080317235"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38680176434960691", "version": "1.94"}, "id": "1579099229357913", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27109658028679314", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38680176434960691"}, "release_status": "RELEASED"}, "binary_release_channels": {"node
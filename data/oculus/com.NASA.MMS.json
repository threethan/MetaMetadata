_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E9u6KhamMUQ7kNvwEZAFtQ&_nc_oc=AdqL5x1rBD4cpLRGjvkF1w2XBeafKbEnpFXHW3umS2zbY7Jh4aDG9dfQVV76mI3rdN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYwrNDiF_JPVyk4lmxF8KVFZ6fXQaTymohji-eqQFPmg&oe=6AF1FEDF"}, {"file_name": "4th_cropped.png", "id": "1594526331762535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292779_1594526338429201_1333081832200664076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMeXUTCGI64Q7kNvwF5d7ox&_nc_oc=AdqjYd7DaqwOsdZwLgDWmkHlTecymp69Nx2lx-H2F7NcGOvRE-Gcyan1-3pfxf0Gz_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc0Yon0QrFx2RHbC4955T9V_y6JFefiB7ixaU1S1bgnw&oe=6AF1FE45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Physics Laboratory", "keywords": [], "long_description": "Step into orbit with NASA MMS, a hands-on VR experience that blends immersive simulation with real science. Designed in collaboration with NASA\u2019s Magnetospheric Multiscale Mission, this interactive journey puts you inside a stylized space station environment filled with holograms, games, and physics.\n\nNavigate using a jetpack orb as you explore the station\u2019s environment. Dive into the data cube and use lasers to trace the invisible flow of charged particles as they interact with Earth\u2019s magnetic field.\n\nJump into three retro-inspired minigames\u2014Pong, Breakout, and Air Hockey\u2014each reimagined with magnetic field dynamics.\n\nWhether you're a space enthusiast, a STEM learner, or simply love exploring new frontiers in VR, NASA MMS offers a fun and educational experience that brings real-world science to life in a way only virtual reality can.", "short_description": "NASA MMS is an interactive VR experience that lets you explore around an interactable space station, experiment and learn with labs, and play minigames.\n\n"}]}, "developer_name": "Mean Free Path Laboratories, LLC", "developer_privacy_policy_url": "htt
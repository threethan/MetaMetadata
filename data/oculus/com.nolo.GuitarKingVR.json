=7f20f&oh=00_AQEeJ1y8jIXtNqU6971XweDuNcZ7p4g9ctKEWgMHRRijCg&oe=6A7B32B5"}, {"file_name": "sc7.png", "id": "334927098602548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_334927101935881_5158294247075539097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jyWkKAEzX8Q7kNvwGwXpQl&_nc_oc=Adp-gSa2vymBgv64pzXNzXi7PgJOUJxt4NXtyP-ibqA4Da_lQPZ7hoHcbThuGALTASo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnn3UmvYadiR27XtHjaFSaagAq88q47UPAmzuDlNf3oA&oe=6A7B0DDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1 landscape Kopie.png", "id": "933328440717048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_933328444050381_9033272655491295354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ6YrOPVhwQQ7kNvwEwyZCG&_nc_oc=AdrSM5ZkasNCDgZ2meiRUGwZw4do7sJxNpjcSgKYZ8aqPthp0udt7jDoJ8nT9PXKJYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs6d6NFImY7jN30jPh9Kcde-_LFDL-UkHCV32EwjsInA&oe=6A7B1C69"}, "display_name": "GuitarKingVR", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvr/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "htt
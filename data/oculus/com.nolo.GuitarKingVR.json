cdn.com&_nc_ss=7f20f&oh=00_Af99tb_9-6fPAr3JRfo9c8Z3-QgeAepfw_DyIKI-1rEfkw&oe=6A3947B5"}, {"file_name": "sc7.png", "id": "334927098602548", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974821_334927101935881_5158294247075539097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REp9FOWptYcQ7kNvwGSUAo0&_nc_oc=AdqjBHwNAvDJCv6FqRjZJvv6pcX4EtP4oVjcYzLr_w2UsR-ldlkM7_RXt1sarDSFEPY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96S5uzlI730F_OJfylB0C66qeCT21RKQay_EuAdR20Tw&oe=6A395B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1 landscape Kopie.png", "id": "933328440717048", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031379_933328444050381_9033272655491295354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-G-1N_KUM0Q7kNvwGzgErX&_nc_oc=AdoeGRgfiHjcJGHKpmd2HrHfyMxj7lFJW2YyI2b3sfqUPy3ZaTHEAdrKXzPWkSpEj54&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZxmSDSXkx2r5z1qKq2vWGDtiQl6hTGKF6esfwVdcoOw&oe=6A393169"}, "display_name": "GuitarKingVR", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvr/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "we
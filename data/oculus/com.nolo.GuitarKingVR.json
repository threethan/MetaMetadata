cdn.com&_nc_ss=7f20f&oh=00_AQGSUDNzEOAH9w8WXppb-bZ-eo4CKivB5ogZB_NcvSb7qw&oe=6A7D9D75"}, {"file_name": "sc7.png", "id": "334927098602548", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974821_334927101935881_5158294247075539097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYSIKeZTyE4Q7kNvwFM-GqC&_nc_oc=AdqZZ3qNzQgx9zjuIU-z5T412cZOatYxWd0AlD5Gp7M1_LUXzlHlyQm-vAKhGlyb7KU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Q2cj2Xu3kdAAtNUgb5qPDUygTZyQYB2B0Rp6Pfh2_w&oe=6A7DB0DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1 landscape Kopie.png", "id": "933328440717048", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031379_933328444050381_9033272655491295354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ6YrOPVhwQQ7kNvwH0A-pQ&_nc_oc=Adoe-NRo3m3vzA2EH9WiAwi9VcIhwVuz8GxUWBstxRNNjzTiHeWiQ00IEtUp3K5z4v4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1sl_fVmIZokEWH2KlhS3Q6UYbGXuLSW-dhjyuE4Z2ow&oe=6A7DBF69"}, "display_name": "GuitarKingVR", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvr/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "we
dO3D9luJ64TE4RBeJVDSs4QixVW4pDSV6nSXR5pjxhs5ixsIsvR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7DSf_95MUvugwuoXWoPr3g0XxnBCFUwfFnQ5IluLRAg&oe=69A6CC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1 landscape Kopie.png", "id": "933328440717048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_933328444050381_9033272655491295354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywmmw3DsejUQ7kNvwHktZQ4&_nc_oc=AdlaO_cxOBYxZku7J8uARLinNz-vkz3vpuqk2w6LGONok3rDEc8-O7862qPjUby7L9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3fIeBit1TFjot26AXbLnCKcj5fHwoUlwp-KGokzP4uA&oe=69A6DAE9"}, "display_name": "GuitarKingVR", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvr/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "https://www.nolodesign.com/guitarkingvr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_c
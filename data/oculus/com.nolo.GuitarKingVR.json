=7f20f&oh=00_AQAh0DCIr1ohQtr8E6V4uuYjTFPoIJVxRjm1fB_mGj0bLA&oe=6A6B60B5"}, {"file_name": "sc7.png", "id": "334927098602548", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_334927101935881_5158294247075539097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN4Lh8w35QsQ7kNvwGF48Pp&_nc_oc=AdqWs8efRIrN-E_T62LSBQpRlBj8fiqLDpoBdhzY4_D3RJv-dG4ZJ1mAC1N_SUx58JY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGwU4YB-e3ayamDXwhA4y_xpQ3HZQlR5GyOQXyli9aig&oe=6A6B3BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1 landscape Kopie.png", "id": "933328440717048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_933328444050381_9033272655491295354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQMrq4Zc-JYQ7kNvwHOwu_-&_nc_oc=AdqDHfT1_ja9_rx1jLYfEIiiOIG1LHUNDUrukGdzaEAjuWL2aqA8WApoXg30NbOjOfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiAEH9bGypzwWwfcESH5wYLIWc1XIGANs7pY4Wn27kRg&oe=6A6B4A69"}, "display_name": "GuitarKingVR", "keywords": [], "long_description": "GuitarKingVR is the ultimate guitar simulation. Play different songs in different locations. Show your skills, grab the right chords, rock like hell. GuitarKingVR is more than just playing air guitar, you get what you play! The flying picks show you the way, anyone can become a Guitar King. Switch from beginner to rockstar mode and show the world your skills. Are you ready to rock?", "short_description": "Are you the next guitar king? GuitarKingVR is more than just playing airguitar. Can you hear the hum from the amp, the feedback? GuitarKingVR is more than just strumming to the right rhythm. It gives you the feeling of playing a real electric guitar. Are you ready for your first GIG?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nolodesign.com/guitarkingvr/pp.html", "developer_terms_of_service_url": null, "publisher_name": "nolodesign", "support_website_url": null, "website_url": "htt
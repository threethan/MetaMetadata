t=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EgnwlqhD6js-hnUapMrz-hhlbwyzRzJ2kcpffokKIiw&oe=69F1FEB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Irispace", "keywords": ["memory", "focus", "logic", "guided", "zen"], "long_description": "This app provides an immersive virtual reality environment with guided sessions designed to support attention, memory and logical thinking.\n\nInside a calm and organized virtual space, users engage with interactive activities that encourage focus, organization, pattern recognition and problem solving. Each session is led by a virtual instructor who explains tasks, guides the experience and helps users move smoothly between activities.\n\nThe experience is designed to be simple, comfortable and intuitive. All activities take place within arm\u2019s reach, with no physical movement required, ensuring a safe and accessible experience.\n\nAdditional features can be unlocked by creating an account at irispace.app, allowing you to integrate sessions, access new functionalities, and enhance your experience over time.\n\nKey features:\n\u2022 Guided sessions\n\u2022 Interactive focus, memory and logic activities\n\u2022 Comfortable seated experience\n\u2022 Fully offline functionality\n\u2022 Clear and simple navigation\n\u2022 Suitable for individual or supervised use\n\nEnter the space, choose a session and start right away.", "short_description": "An immersive virtual reality environment with guided sessions focused on attention, memory and logic. Interact with structured activities in a safe and comfortable space designed for individual or instructor-assisted use. Works fully offline and is easy to start from the first moment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://irispace.app/politicas-rv?tab=privacidade", "developer_terms_of_service_url": "https://irispace.app/politicas-rv?tab=termos", "publisher_name": "Irispace by Virtwell", "support_website_url": "https://irispace.app/suporte", "website_url": "https://irispace.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26287615780926177"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1632505301273288"}]}, "baseline_offer": {"id": "1632505301273288"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774616280, "status": "PUBLISHED", "id": "1632505301273288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26541468865540866", "version": "9.2.2"}, "id": "1448806176291966", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26287615760926179", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26541468865540866"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1448806176291966"}]}, "change_log": null, "created_date": 1774558525, "id": "26541468865540866", "version": "9.2.2", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset
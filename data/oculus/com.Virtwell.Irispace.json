m/v/t64.5771-25/499303746_1677349640179157_8213345644585084599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuuD00WH4BgQ7kNvwGds3wS&_nc_oc=AdreW5Gwkyx30e5QhYjEV1TY9BanntYzEO-SZVQAFzJ1frIqnymo4oTKPZ-mtvhX6YQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EXe6aigYl4eY4S1tmLUCGTeg6Kd016u2v1SH5sIIg7Q&oe=69F1E98B"}, {"file_name": "SCREENSHOT-2.png", "id": "1618507942767448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828028_1618507946100781_8297504226167539327_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij0N-3PcHdAQ7kNvwFaerRj&_nc_oc=Adrt6wf4tOeWJcsnYTTtzCJ9LXHN6ivXG2CbTjAVbdr8t7V9vyZpRPvrPpNEJNqPVX4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2UmdkC9ETZcY_KAgfYoTBZX89JYsjcW62iR3Kg_-U94w&oe=69F2064F"}, {"file_name": "SCREENSHOT-3.png", "id": "1262212349222694", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_1262212352556027_6081129742264386917_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdVgwOxgvlEQ7kNvwHnL78k&_nc_oc=AdrgF7J68o90w0nmYBNiHBDk1537-QE_E2MHnn5LImF77cz1CTIoFtMVxUnAUQmRR7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2obWWZR-egxiAdxJ0B5UAmwMcH0qhKaLRd3Hd7be9fMQ&oe=69F1EE18"}, {"file_name": "SCREENSHOT-4.png", "id": "1270925371662359", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823271_1270925374995692_211502309644569240_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFlhzOTE5vUQ7kNvwGbvaBY&_nc_oc=AdqO_y_pvYJYU2K__mEFSxxBX0c4P9uS8Hc5Tty3TgUoHiPh_Z0eRjPNbxpGJuFFI88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CJgSwm8BkSNteV2DeJbzEDYm723Bbr5paAqy0K2cgbg&oe=69F207B2"}, {"file_name": "SCREENSHOT-5.png", "id": "1265495651644456", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823910_1265495654977789_7457377575411612700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vhTBHAiV0MQ7kNvwEPz4iu&_nc_oc=Adp8y9iMLuoPtZcqTa5kzjKjL3LIbeuKy3NIk77vtlm0T7G1vL4HjM3EqLHVEfujZrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EgnwlqhD6js-hnUapMrz-hhlbwyzRzJ2kcpffokKIiw&oe=69F1FEB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Irispace", "keywords": ["memory", "focus", "logic", "guided", "zen"], "long_description": "This app provides an immersive virtual reality environment with guided sessions designed to support attention, memory and logical thinking.\n\nInside a calm and organized virtual space, users engage with interactive activities that encourage focus, organization, pattern recognition and problem solving. Each session is led by a virtual instructor who explains tasks, guides the experience and helps users move smoothly between activities.\n\nThe experience is designed to be simple, comfortable and intuitive. All activities take place within arm\u2019s reach, with no physical movement required, ensuring a safe and accessible experience.\n\nAdditional features can be unlocked by creating an account at irispace.app, allowing you to integrate sessions, access new functionalities, and enhance your experience over time.\n\nKey features:\n\u2022 Guided sessions\n\u2022 Interactive focus, memory and logic activities\n\u2022 Comfortable seated experience\n\u2022 Fully offline functionality\n\u2022 Clear and simple navigation\n\u2022 Suitable for individual or supervised use\n\nEnter the space, choose a session and start right away.", "short_description": "An immersive virtual reality environment with guided sessions focused on attention, memory and logic. Interact with structured activities in a safe and comfortable space designed for individual or instructor-assisted use. Works fully offline and is easy to start from the first moment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://irispace.app/politicas-rv?tab=privacidade", "developer_terms_of_service_url": "https://irispace.app/politicas-rv?tab=termos", "publisher_name": "Irispace by Virtwell", "support_website_url": "https://irispace.app/suporte", "website_url": 
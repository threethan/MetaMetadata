0_Af30yaJkm6Y8SNYib--zXd02VAf1VLU_gw-QeHhL-XDn2w&oe=69D39064"}, {"file_name": "LIVINGRoomScreenshot4.png", "id": "777510657833206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569460_777510661166539_5504374753382887937_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNjSV8XP9X4Q7kNvwEP4KR0&_nc_oc=Adoa_mV_GxrTQxOLFdQqPiKmu2IZy5ikkMYRlAseVbGiYONa6JpvG2M1gfG4qfY14uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jW_rGXls6kJjiHDZyiKcHQLwftBF4NKR0NjpXcwTzyQ&oe=69D39228"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIVINGRoomTrailerCover.png", "id": "2269996916683404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974689_2269996920016737_3039468053589518207_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ffEYv3k1LIQ7kNvwFWl3WA&_nc_oc=AdofGYTbwhWic4X6VryRXf0NK6EZE8TxOkK3r5tTgCnLj7nusDBN-sSGMhVllxpNsrQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GMahlbVzE1AsjH9fTibY_B336LlsIeBtuQKAmKII4YQ&oe=69D3AD29"}, "display_name": "Living Room", "keywords": [], "long_description": "# A Wildlife Sanctuary Inside Your Room\n\nTransform your space into your very own dynamic ecosystem in Living Room - a wholesome and quirky mixed reality simulation game!\n\nTurn your furniture into islands and populate them with a variety of derpy animals and lush plants. Observe as your room comes alive with colorful wildlife, and enjoy the whimsical experience of managing and expanding your digital sanctuary.\n\n# Mixed Reality Magic\n\nSeamlessly blend the digital and physical world as your room transforms into a vibrant nature reserve. Paint islands on your furniture for your creatures to live on, rearrange them in your space, and watch as your chosen explorer pet roams and explores your room in real-time.\n\nUnlock decorations for your room, and witness the change in lighting as you switch between day- and nighttime.\n\n# Care for Your Wildlife\n\nEnsure the needs of all your species are met to maintain balance. Watch your animals grow, build them shelters for the night, and breeding grounds to expand their populations, featuring a kaleidoscope of colorful variants.\n\n# Unlock New Species and Biomes\n\nUnlock new biomes as you progress, each with its own unique species of flora and fauna, and introduce them to your ecosystem.\n\n# Casual Yet Challenging\n\nRelax as you watch your wildlife thrive in Normal Mode, test your knowledge and skill with challenging puzzles and tricky scenarios in Challenge Mode, or freely design the most dreamy and picturesque sanctuaries in Creative Mode.", "short_description": "A Wildlife Sanctuary Inside Your Room\n\nTransform your space into your very own dynamic ecosystem in Living Room - a wholesome and quirky mixed reality simulation game!\n\nTurn your furniture into islands and populate them with a variety of derpy animals and lush plants. Observe as your room comes alive with colorful wildlife, and enjoy the whimsical experience of managing and expanding your digital sanctuary."}]}, "developer_name": "Thoughtfish", "developer_privacy_policy_url": "https://www.thoughtfish.de/living-room-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Thoughtfish", "support_website_url": "https://www.thoughtfish.de/contact-us/", "website_url": "https://www.thoughtfish.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "fr_BE", "fr_CA", "fr", "de", "de_CH", "ja", "k
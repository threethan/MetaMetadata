oh=00_AQR8-Dfsu-ke1nLNVLO4pDZc58Y-P0yE-xJnxCSi7e3Cvg&oe=6B03226B"}, {"file_name": "migrated_image.png", "id": "644068183058339", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_2145663475459603_2916621233111957504_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s43QeEQL2pEQ7kNvwHfqggb&_nc_oc=Adqe5qpAnPG0DjuofuyUzVPN_2pykmfYxLJTbJHghU5b6CU2u6iLW5v44z4WqzkhJt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYf5Ns_ztRP7ym5Gc4Hq5hXc6NruEmxznKAFLN9JqzNg&oe=6B032EAF"}, {"file_name": "migrated_image.png", "id": "641567449740759", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_422233981506906_1161652120852627456_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIKw6NY013QQ7kNvwFSkigu&_nc_oc=AdoHHHW1qfWHk22xR-bVkDJrMMiLsn37KaRATHPgrnm2Kh2QOtdcoOlgFvqUSB00mMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSctX1uinE4ig7wKtj5URLh3DXShV29iAoxo5Tm7hgCKw&oe=6B033390"}, {"file_name": "migrated_image.png", "id": "496685247693021", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162696_295850914152470_7004689917125066752_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6WiIHxpleQQ7kNvwGNXDHD&_nc_oc=AdqTIMWQ-QnVeFycpbzQsioOhBvHmxQ4BIch7PdIK64q_wdj3gXtHcafOw0bIWZCADI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9zX8YSTYiIPemIFryg-FU5-n0dr_WdfaUHAGqgr6wkA&oe=6B031FC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest2: The Bed in the Sky", "keywords": ["animation", "character", "anime", "visualnovel", "FullDive"], "long_description": "The \u201cFullDive Novel\u201d: Visual Novels meets Virtual Reality in this ultimate immersive reading experience. With character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist. \u201cWhen you step into this forest, you lose one memory\u2026\u201d Innocent Forest is fantasy story about a girl called Luclei and the memories of her visitors. \n\nThe forest of lost memories: A doctor named Hauser, (voiced by Yusuke Kobayashi) just moved into the town. While he takes a walk in the town, he steps into the forest and then meets a girl, Luclei,\n (voiced by Rina Hidaka) in the sudden washing rain. Luclei catches a cold by walking in the rain. Hauser has been afraid of facing a patient from his memory of a girl he couldn\u2019t save, but he regains his lost memory with the girl as he nurses Luclei... \nThis Time, series second edition published. Second edition's Title is \"The Bed in the Sky\".", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. Innocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist. This Time, series second edition published. Second edition's Title is \"The Bed in the Sky\"."}, {"images": {"nodes": []}, "id": "302112007425517", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest2 -\u7a7a\u306e\u5bdd\u53f0-", "keywords": ["\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb", "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc", "\u30a2\u30cb\u30e1", "\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3", "\u30d5\u30eb\u30c0\u30a4\u30d6"], "long_description": "\u25c6\u300eInnocent Forest2\u300f\u306b\u3064\u3044\u3066\n\u300eVR\u00d7\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb\u300f\u3092\u30b3\u30f3\u30bb\u30d7\u30c8\u3068\u3057\u305f\u30d5\u30eb\u30c0\u30a4\u30d6\u578b\u306e\u8aad\u66f8\u4f53\u9a13\u300cFullDive novel\u300d\u7b2c\u4e8c\u5f3e\u3002 \u7269\u8a9e\u306e\u300c\u4e16\u754c\u89b3\u300d\u306b\u6ca1\u5165\u3055\u305b\u3001\u8aad\u8005\u8
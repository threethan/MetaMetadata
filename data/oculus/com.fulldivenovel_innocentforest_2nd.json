_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A6K-liF-KEQ7kNvwEkmABu&_nc_oc=AdqHK22n3ABNuItYMna5m5onosTn6Ici1aTm7E6EZUiB-VPD4dqKaiKh0gCD0i4-gpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZPzI4IEa1G61LyPFMP4uO4xYssYDZ_EBXd-0Gqvy6Dg&oe=6AEDDE6F"}, {"file_name": "migrated_image.png", "id": "641567449740759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_422233981506906_1161652120852627456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPTspPP2KDsQ7kNvwG9a1zf&_nc_oc=AdrP9n3b53Jt6GynnKfK1fLiZKDsMb9pBNjKNDUq5i6uX-xRmHaGs9MW_3J4mZ8ZvFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzvRPYzbVNDOC8c-x4aaLhFz761SQTPJKGXnD26NzPnA&oe=6AEDE350"}, {"file_name": "migrated_image.png", "id": "496685247693021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162696_295850914152470_7004689917125066752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj37GsKanVUQ7kNvwEDFsdL&_nc_oc=AdoB16rmbgVw7bkZAqjDjXtgcnvGI4vr7eCTmN3bl3bbsWJGLEcrMVOLURU2-p1hkPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ613Pbj417_7nsggpZuxLZymVF-R7ELDVsolGv3C4rdw&oe=6AEE07C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest2: The Bed in the Sky", "keywords": ["animation", "character", "anime", "visualnovel", "FullDive"], "long_description": "The \u201cFullDive Novel\u201d: Visual Novels meets Virtual Reality in this ultimate immersive reading experience. With character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist. \u201cWhen you step into this forest, you lose one memory\u2026\u201d Innocent Forest is fantasy story about a girl called Luclei and the memories of her visitors. \n\nThe forest of lost memories: A doctor named Hauser, (voiced by Yusuke Kobayashi) just moved into the town. While he takes a walk in the town, he steps into the forest and then meets a girl, Luclei,\n (voiced by Rina Hidaka) in the sudden washing rain. Luclei catches a cold by walking in the rain. Hauser has been afraid of facing a patient from his memory of a girl he couldn\u2019t save, but he regains his lost memory with the girl as he nurses Luclei... \nThis Time, series second edition published. Second edition's Title is \"The Bed in the Sky\".", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. Innocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist. This Time, series second edition published. Second edition's Title is \"The Bed in the Sky\"."}, {"images": {"nodes": []}, "id": "302112007425517", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest2 -\u7a7a\u306e\u5bdd\u53f0-", "keywords": ["\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb", "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc", "\u30a2\u30cb\u30e1", "\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3", "\u30d5\u30eb\u30c0\u30a4\u30d6"], "long_description": "\u25c6\u300eInnocent Forest2\u300f\u306b\u3064\u3044\u3066\n\u300eVR\u00d7\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb\u300f\u3092\u30b3\u30f3\u30bb\u30d7\u30c8\u3068\u3057\u305f\u30d5\u30eb\u30c0\u30a4\u30d6\u578b\u306e\u8aad\u66f8\u4f53\u9a13\u300cFullDive novel\u300d\u7b2c\u4e8c\u5f3e\u3002 \u7269\u8a9e\u306e\u300c\u4e16\u754c\u89b3\u300d\u306b\u6ca1\u5165\u3055\u305b\u3001\u8aad\u8005\u81ea\u8eab\u304c\u3082\u306f\u3084\u300c\u7269\u8a9e\u306e\u4e3b\u4eba\u516c\u300d\u306e\u3088\u3046\u306b\u611f\u3058\u3066\u3057\u307e\u3046\u307b\u3069\u306e\u4f53\u9a13\u3092\u53ef\u80fd\u3068\u3059\u308b\u3002\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb\u3067\u633f\u7d75\u306b\u5f53\u305f\u308b\u90e8\u5206\u304cVR\
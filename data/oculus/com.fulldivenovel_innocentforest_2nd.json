1-25/11162698_2145663475459603_2916621233111957504_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9EJijW_G6EQ7kNvwG5iwki&_nc_oc=AdrmpIUhEx3l8GRzoAmFUqzAZnCnXlKOX_J0af6qKpoYhgJTwzPKKOzBTS0sJiqB8Vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d8Q15KZyodMW7xYb_pjmEelSqRji-Sy4GZ2zA4vzU_w&oe=6A03336F"}, {"file_name": "migrated_image.png", "id": "215999726121004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_137451306885718_4542214351183937536_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymNZ7oDRIB4Q7kNvwHe-ASZ&_nc_oc=AdonckqTrJD9r_2rxNIzphYFwo-8rv3S37EOd6IdwaMl3UsS20C4bC7zAd0TPFkbVD8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53W7UNUd6zm3saW7XYnFo6MYJ95I4cQslG1ULodzzVRg&oe=6A0343E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "key.png", "id": "798670463669312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_798670467002645_5980358114157789184_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A5_z3i8T_cQ7kNvwHNiRyQ&_nc_oc=AdpEkj6eSUfT5GnJQvE9fQFvuYKjJPk8eQK_4TJobsiawVTszgQttvPAbvrhgOZGNIo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZtIIaWWJ9GZ0VrhBvxH8INHClzbLgSLUaOE-egVfsww&oe=6A034473"}, "display_name": "Innocent Forest 2", "keywords": ["VN", "animation", "character", "anime", "visualnovel"], "long_description": "The \u201cFullDive Novel\u201d: Visual Novels meets Virtual Reality in this ultimate immersive reading experience. With character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist. \u201cWhen you step into this forest, you lose one memory\u2026\u201d Innocent Forest is fantasy story about a girl called Luclei and the memories of her visitors. \n\nThe forest of lost memories: A doctor named Hauser, (voiced by Yusuke Kobayashi) just moved into the town. While he takes a walk in the town, he steps into the forest and then meets a girl, Luclei,\n (voiced by Rina Hidaka) in the sudden washing rain. Luclei catches a cold by walking in the rain. Hauser has been afraid of facing a patient from his memory of a girl he couldn\u2019t save, but he regains his lost memory with the girl as he nurses Luclei... \nThis Time, series second edition published. Second edition's Title is \"The sky bed\".", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. Innocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist. This Time, series second edition published. Second edition's Title is \"The sky bed\"."}, {"images": {"nodes": []}, "id": "144731900191920", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest 2", "keywords": ["\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb", "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc", "\u30a2\u30cb\u30e1", "\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3", "\u30ce\u30d9\u30eb\u30b2\u30fc\u30e0"], "long_description": "\u25c6\u300eFullDive novel: Innocent Forest\u300f\u306b\u3064\u3044\u3066\n \u201cFullDive novel\u201d \u305d\u308c\u306f\u300eVR\u00d7\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb\u300f\u3092\u30b3\u30f3\u30bb\u30d7\u30c8\u3068\u3057\u305f\u7a76\u6975\u306e\u6ca1\u5165\u8aad\u66f8\u4f53\u9a13\u3002 \u7269\u8a9e\u306e\u300c\u4e16\u754c\u89b3\u300d\u306b\u6ca1\u5165\u3055\u305b\u3001\u8aad\u8005\u81ea\u8eab\u304c\u3082\u306f\u3084\u300c\u7269\u8a9e\u306e\u4e3b\u4eba\u516c\u300d\u306e\u3088\u3046\u306b\u611f\u3058\u3066\u3057\u307e\u3046\u307b\u3069\u306e\u4f53\u9a13\u3092\u53ef\u80fd\u3068\u3059\u308b\u3002\u30e9\u30a4\u30c8\u30ce\u30d9\u30eb\u3067\u633f\u7d75\u306b\u5f53\u305f\u308b\u90e8\u5206\u304cVR\u30a2\u30cb\u30e1\u30
097473976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_Je-Ehckm0Q7kNvwGgA8-5&_nc_oc=AdrDIg-Q8Cowlqzb_SRXdgAmOdl65kdNNQ4Ir47fQC-hbaSqSJUJ_a8EeJl7wifTtRQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeVckBgVXpY3pLFhhd9Xq_ZTUAImD1ZfL2QWvi_vd2QA&oe=6AB68CAF"}, {"file_name": "ss4.png", "id": "1327874838994663", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823783_1327874845661329_3697785490152779551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUwkyoPzgpcQ7kNvwGcjmBS&_nc_oc=Adrea6fYGAPmJou3qr0ItUAQqWp1AG8V8amB0tyhA7eqLrwgpx9p9aH101Uc1LckhGk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg9WqTF_21y2hVWJ8rmkEAS4gu1ls2a-hD-Xr1YSl7sQ&oe=6AB67E5B"}, {"file_name": "ss3.png", "id": "1763223348182858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828038_1763223351516191_1333500536127776723_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHLcRXYMsXQQ7kNvwHUHiU1&_nc_oc=AdqGUrLcce7zgU08K7CxlWWQJF0zRzCNt-m6vbf_FoU4NDybVh78nZMhB8iXnEQSrIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtcQzUPV74ribr-XbUcK9J6qVVM7FEucl3ooVeBYZ1PA&oe=6AB683F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "794448030329547", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/593761155_794448033662880_350469816119825398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dszIO0bB8FUQ7kNvwEQCtT0&_nc_oc=AdrKKqnFSta8ouTYGhgyYGTkdkCxqaoqFt8h72vn2rmhsrFDr-wEqCClwoE-4rBfG8E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9eXBlmuZdRKlnQyvTBBB8dl3-mPlDn91IhSRIG6OlKw&oe=6AB69216"}, "display_name": "BeatBall", "keywords": ["Rhythm", "Fitness", "Boxing", "Colorful", "Music"], "long_description": "# \ud83e\udd4aBEATBALL\ud83e\udd4a\n\n**Jab**, **Hook**, **Uppercut**, and **Slam** your way through the music in our colorful fitness **RHYTHM** game made exclusively for the Meta Quest. Survive the musical onslaught tied to every kick and snare of the beat by punching beatballs towards their targets. Experience satisfying combat in levels inspired by both existing and BeatBall original songs. Climb track difficulties, earn High Scores, grind expert mode, and discover new music in BEATBALL. **Feel the double meaning of the word beat.**\n\n**FEATURES**\n* 11+ tracks including **DISCO**, **ELECTRONIC**, **ROCK**, **NIGHTCORE**, and **MORE**.\n* Challenge yourself to tier **I**, **II**, and **III** song difficulties .\n* PRACTICE, CLASSIC, and EXPERT mode for all skill levels.\n* Highly engaged haptic system brings the beat to your hands.\n* Audio-informed graphics lets the world listen alongside you.", "short_description": "The BEAT is coming and you must BOX to survive! HOOK, UPPERCUT, and SLAM your way through the music in our new fitness RHYTHM game made exclusively for the Meta Quest. Featuring original and existing songs, experience the musical onslaught of genres such as rock, pop, electronic, nightcore, and more. Climb difficulties, grind expert mode, and earn high-scores. Feel the double meaning of the word beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/92fea709-0e15-4c4b-903f-37fd44b7e50d", "developer_terms_of_service_url": null, "publisher_name": "Matias Ortiz Diez", "support_website_url": null, "website_url": "https://matiasortiz.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_mod
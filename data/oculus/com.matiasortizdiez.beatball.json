AIvCui5ygfj-RIBvjAEU_t9IDdtBv1B0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUozMEnkLuWqPG11Dtl2rRi01FOXNy-dufN7NBxKe4zQ&oe=6A983A2F"}, {"file_name": "ss4.png", "id": "1327874838994663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1327874845661329_3697785490152779551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs1kuYPsqIkQ7kNvwFODW3o&_nc_oc=Adr8MWTsqctafzSXPcSFtMVETS_LmwNJZdc2e78FYI828Ymsk5MCKBaYfJ9gjWk9xHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO_ag-ZK9yj7mJ03dJzcZmfkPIlLGOW0Cnyw8EWVnMLA&oe=6A98641B"}, {"file_name": "ss3.png", "id": "1763223348182858", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_1763223351516191_1333500536127776723_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NlKrRI_Y50Q7kNvwFyyU7U&_nc_oc=AdrBpajRq4m_ThirrzRZASB0NV_fe2aq9FscNlirxVlbyVt2HUG29vSFTFohZVjF5io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9BIK36D1i2-mSOp-KTP4FUiynmB1P6UTvKKzOXBWYFQ&oe=6A9869B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "794448030329547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_794448033662880_350469816119825398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EP_3TskpNi0Q7kNvwGs7W2u&_nc_oc=AdphhtfWPLWk_-auHwWpyNxTbYZITCIO63lhha-XAdpqRdGh8Dv1QoTvwv1WMl9_BUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIAtLeJUGNMuoP0rp67c9oaOY8fygVrXRtWctOJg0XYQ&oe=6A983F96"}, "display_name": "BeatBall", "keywords": ["Rhythm", "Fitness", "Boxing", "Colorful", "Music"], "long_description": "# \ud83e\udd4aBEATBALL\ud83e\udd4a\n\n**Jab**, **Hook**, **Uppercut**, and **Slam** your way through the music in our colorful fitness **RHYTHM** game made exclusively for the Meta Quest. Survive the musical onslaught tied to every kick and snare of the beat by punching beatballs towards their targets. Experience satisfying combat in levels inspired by both existing and BeatBall original songs. Climb track difficulties, earn High Scores, grind expert mode, and discover new music in BEATBALL. **Feel the double meaning of the word beat.**\n\n**FEATURES**\n* 11+ tracks including **DISCO**, **ELECTRONIC**, **ROCK**, **NIGHTCORE**, and **MORE**.\n* Challenge yourself to tier **I**, **II**, and **III** song difficulties .\n* PRACTICE, CLASSIC, and EXPERT mode for all skill levels.\n* Highly engaged haptic system brings the beat to your hands.\n* Audio-informed graphics lets the world listen alongside you.", "short_description": "The BEAT is coming and you must BOX to survive! HOOK, UPPERCUT, and SLAM your way through the music in our new fitness RHYTHM game made exclusively for the Meta Quest. Featuring original and existing songs, experience the musical onslaught of genres such as rock, pop, electronic, nightcore, and more. Climb difficulties, grind expert mode, and earn high-scores. Feel the double meaning of the word beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/92fea709-0e15-4c4b-903f-37fd44b7e50d", "developer_terms_of_service_url": null, "publisher_name": "Matias Ortiz Diez", "support_website_url": null, "website_url": "https://matiasortiz.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1163915480145233"}, "review_messages": []}]}, "cover_square_image"
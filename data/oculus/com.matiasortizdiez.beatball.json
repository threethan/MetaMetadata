eCI3Qh28gRCoPi0Asz6JXA2KaxiZsLvs96N4BD0YLQ&oe=6B05B932"}, {"file_name": "ss6.png", "id": "37315767041347908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507840144_37315767044681241_7533727520097473976_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukrT-rddULYQ7kNvwHWcOVS&_nc_oc=AdrFFGvzlKiueTNydRGDK98C9vNmqyLI-4HTGkR98F1mydsitx32_QS1y7h2DXkSOUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa3iSnA-uYSNs2Ru4Q_raqsg07fnrijWP5p0bzQH4SfA&oe=6B05A6AF"}, {"file_name": "ss4.png", "id": "1327874838994663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1327874845661329_3697785490152779551_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEaQnA_JwKwQ7kNvwHDFESk&_nc_oc=AdrQvZEw-pRNaKIm_PhvKDrQZxKt378-CodF7o0EmCaCKUMZc6TUgl_k1LvIeWidZXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6dNFzO6X0slPfNTZm0atNhV1aK0lka1nTsDO5EgE0xg&oe=6B05D09B"}, {"file_name": "ss3.png", "id": "1763223348182858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1763223351516191_1333500536127776723_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3JM08Jp4QMQ7kNvwEIwDJf&_nc_oc=AdppxLDHpUpK2vRckOokazY2xCJOz-mu9inAZgjfSDPrwgpjWr9CgKP8nIMlULSddfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwv2_AkiUD9yON4qcUsaswo_KRBy4CQfcONOPrJUEs0A&oe=6B05D635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "794448030329547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_794448033662880_350469816119825398_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqWOecxzQ30Q7kNvwEtnnvZ&_nc_oc=Adp8bLrCc8b82-OcylEXQ6eqSRqpXRvBLcEuBx06sqQ8ZtTk0BnkzN9G8H9dXTzST0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHHTV_M-d-mkk-LS5x6KCkqa5oy-C2G_hKQafAM8bvKg&oe=6B05AC16"}, "display_name": "BeatBall", "keywords": ["Rhythm", "Fitness", "Boxing", "Colorful", "Music"], "long_description": "# \ud83e\udd4aBEATBALL\ud83e\udd4a\n\n**Jab**, **Hook**, **Uppercut**, and **Slam** your way through the music in our colorful fitness **RHYTHM** game made exclusively for the Meta Quest. Survive the musical onslaught tied to every kick and snare of the beat by punching beatballs towards their targets. Experience satisfying combat in levels inspired by both existing and BeatBall original songs. Climb track difficulties, earn High Scores, grind expert mode, and discover new music in BEATBALL. **Feel the double meaning of the word beat.**\n\n**FEATURES**\n* 11+ tracks including **DISCO**, **ELECTRONIC**, **ROCK**, **NIGHTCORE**, and **MORE**.\n* Challenge yourself to tier **I**, **II**, and **III** song difficulties .\n* PRACTICE, CLASSIC, and EXPERT mode for all skill levels.\n* Highly engaged haptic system brings the beat to your hands.\n* Audio-informed graphics lets the world listen alongside you.", "short_description": "The BEAT is coming and you must BOX to survive! HOOK, UPPERCUT, and SLAM your way through the music in our new fitness RHYTHM game made exclusively for the Meta Quest. Featuring original and existing songs, experience the musical onslaught of genres such as rock, pop, electronic, nightcore, and more. Climb difficulties, grind expert mode, and earn high-scores. Feel the double meaning of the word beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/92fea709-0e15-4c4b-903f-37fd44b7e50d", "developer_terms_of_service_url": null, "publisher_name": "Matias Ortiz Diez", "support_website_url": null, "website_url": "https://matiasortiz.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads":
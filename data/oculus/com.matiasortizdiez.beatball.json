763223351516191_1333500536127776723_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn_9Njk0TaYQ7kNvwFlY8j8&_nc_oc=AdqLs0XLNT3NWic4Q5r7W60gIPoeRse3IrcYWkCOHvjXVyYw9-Vsnucu-lZeFxBL4EU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr53R2uwqdO6g3LTUCWT8s4ryUAp1iBJ8T22TRxyNW6w&oe=6A8EF6F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "794448030329547", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/593761155_794448033662880_350469816119825398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngMAmv5oUqEQ7kNvwGWrvCN&_nc_oc=AdrqztMEB6fL2012IqVqVMQi2GcS9FmWDH91RcLb13x-Burtz46dU0bvRQjf_Ndi_e4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5ouORWOSbZia1jtUACxQsBY00ARyMMdyDVeZInyZ4jQ&oe=6A8ECCD6"}, "display_name": "BeatBall", "keywords": ["Rhythm", "Fitness", "Boxing", "Colorful", "Music"], "long_description": "# \ud83e\udd4aBEATBALL\ud83e\udd4a\n\n**Jab**, **Hook**, **Uppercut**, and **Slam** your way through the music in our colorful fitness **RHYTHM** game made exclusively for the Meta Quest. Survive the musical onslaught tied to every kick and snare of the beat by punching beatballs towards their targets. Experience satisfying combat in levels inspired by both existing and BeatBall original songs. Climb track difficulties, earn High Scores, grind expert mode, and discover new music in BEATBALL. **Feel the double meaning of the word beat.**\n\n**FEATURES**\n* 11+ tracks including **DISCO**, **ELECTRONIC**, **ROCK**, **NIGHTCORE**, and **MORE**.\n* Challenge yourself to tier **I**, **II**, and **III** song difficulties .\n* PRACTICE, CLASSIC, and EXPERT mode for all skill levels.\n* Highly engaged haptic system brings the beat to your hands.\n* Audio-informed graphics lets the world listen alongside you.", "short_description": "The BEAT is coming and you must BOX to survive! HOOK, UPPERCUT, and SLAM your way through the music in our new fitness RHYTHM game made exclusively for the Meta Quest. Featuring original and existing songs, experience the musical onslaught of genres such as rock, pop, electronic, nightcore, and more. Climb difficulties, grind expert mode, and earn high-scores. Feel the double meaning of the word beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/92fea709-0e15-4c4b-903f-37fd44b7e50d", "developer_terms_of_service_url": null, "publisher_name": "Matias Ortiz Diez", "support_website_url": null, "website_url": "https://matiasortiz.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1163915480145233"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2867928233561872"}]}, "baseline_offer": {"id": "2867928233561872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784068980, "status": "PUBLISHED", "id": "2867928233561872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1195827573620690", "version": "2.0.0"}, "id": "1031949245893620", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1163915463478568", "is_concept": false, "latest_released_binary": {"__typen
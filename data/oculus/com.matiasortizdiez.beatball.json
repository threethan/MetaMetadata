EVzVR1pSLx9o7s-ph0hUJ9Hmtd1aB96N_mzcpppQ6g&oe=6B007332"}, {"file_name": "ss6.png", "id": "37315767041347908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507840144_37315767044681241_7533727520097473976_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMFrIHowXf0Q7kNvwGIrsvk&_nc_oc=AdqNg_NEXGABG0Rd4RcqTOWrmTn8wQEiJoCUOgLpPjpTkKg-fIh2-YpTNAggxLrVoWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5s-ujlvEcnVTaTf0U4moWX4jANVuBbjv3S4jeUN_taQ&oe=6B0060AF"}, {"file_name": "ss4.png", "id": "1327874838994663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1327874845661329_3697785490152779551_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXb4kKLfl4wQ7kNvwHjVLMf&_nc_oc=AdpnakD_Gs_p-QnCHt5g6_a9ftpEMq3eudrb9A4k9yaWm05J6r0ExQcUN8vxJkd98pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwWL-rskPZvb2F9QdukgQq79uCljLkLAJ-d34G-vFIow&oe=6B00525B"}, {"file_name": "ss3.png", "id": "1763223348182858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1763223351516191_1333500536127776723_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOIhctEunqUQ7kNvwH6SBD4&_nc_oc=AdpdbMXzAxTdBFgaNG3bSTQNHfJ6CRKQZeo1btT86HcP8VhgspcVxVGVS2fie3jjAdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAH_5X8KLnVEU07IC3yfw_9PqESi39LIR1RfqDxMS2Hw&oe=6B0057F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main.png", "id": "794448030329547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_794448033662880_350469816119825398_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNIzaFG8B7AQ7kNvwHMaUTB&_nc_oc=Adqkpj2CLd-3mDciR-BDZkqZf79fgAc6GXCdcz_p_YFbF6PS2Ry8A-qBSTb72hJoxwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb70vOQVKhIUw76k9M4UWiK338zLfQosteVZQJoyQCnQ&oe=6B006616"}, "display_name": "BeatBall", "keywords": ["Rhythm", "Fitness", "Boxing", "Colorful", "Music"], "long_description": "# \ud83e\udd4aBEATBALL\ud83e\udd4a\n\n**Jab**, **Hook**, **Uppercut**, and **Slam** your way through the music in our colorful fitness **RHYTHM** game made exclusively for the Meta Quest. Survive the musical onslaught tied to every kick and snare of the beat by punching beatballs towards their targets. Experience satisfying combat in levels inspired by both existing and BeatBall original songs. Climb track difficulties, earn High Scores, grind expert mode, and discover new music in BEATBALL. **Feel the double meaning of the word beat.**\n\n**FEATURES**\n* 11+ tracks including **DISCO**, **ELECTRONIC**, **ROCK**, **NIGHTCORE**, and **MORE**.\n* Challenge yourself to tier **I**, **II**, and **III** song difficulties .\n* PRACTICE, CLASSIC, and EXPERT mode for all skill levels.\n* Highly engaged haptic system brings the beat to your hands.\n* Audio-informed graphics lets the world listen alongside you.", "short_description": "The BEAT is coming and you must BOX to survive! HOOK, UPPERCUT, and SLAM your way through the music in our new fitness RHYTHM game made exclusively for the Meta Quest. Featuring original and existing songs, experience the musical onslaught of genres such as rock, pop, electronic, nightcore, and more. Climb difficulties, grind expert mode, and earn high-scores. Feel the double meaning of the word beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/92fea709-0e15-4c4b-903f-37fd44b7e50d", "developer_terms_of_service_url": null, "publisher_name": "Matias Ortiz Diez", "support_website_url": null, "website_url": "https://matiasortiz.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads":
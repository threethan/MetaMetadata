ywords": [], "long_description": "Ahoy, me hearties! Dive into Swivel Gun XR: Treasure Hunt, the game where ye plunder riches right from your own home! \n\nUsing Roomscale Mixed Reality, transform your environment into 1 of 6 Fully destructible treasure hunting grounds. Each has their own traps and dangers, so be careful!\n\nWhere will ye hunt next?\n\nAVAST! FULL CONTENT RELEASE!\n> Made for Room Scale Mixed Reality <\n- 3 NEW Map Types to explore!\n- Limited Time COLLECTABLES\n- NEW Weapons & Enemies\n- NEW Traps and Dangers\n- Seasonal Hidden Map\n\nSo tell me, me hearties: where will ye hunt next?", "short_description": "Ahoy, me hearties! Dive into Swivel Gun XR: Treasure Hunt, the game where ye plunder riches right from your own home! \n\nUsing Roomscale Mixed Reality, transform your environment into 1 of 6 Fully destructible treasure hunting grounds. Each has their own traps and dangers, so be careful!\n\nWhere will ye hunt next?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/sgth-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "https://pixelsofeight.wixsite.com/lander", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8991559780867452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
075292048317643_8815080526322488490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9mNx00v7X0Q7kNvwHUXGh6&_nc_oc=AdpjKAJjCY_7SoRAxflovVCitbv8BFrf3ReTaAabR4oBebkqsVf0ipCeyzNCjSOtF8k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_lmCnB8u_MDMQWC67YXrQ2PcZ82Ze6PgB_c4Hp9nLDA&oe=6AFB1F34"}, {"file_name": "Po8_SGTH_ss2.png", "id": "1306033794941103", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673536876_1306033798274436_3435292701315589141_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kr-Cj0Wi-wQ7kNvwGTY6fq&_nc_oc=Ado3xzbuEh0ZFvvyjEh_dHC4ixEAljovtYBco82En4q8CaoSyTPTiMIKl59cmhoPuNE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHJveJ4bcYS0KZRSPaUeE4VoomY3t_F1E5Ttzt5Lq-zw&oe=6AFB2272"}, {"file_name": "Po8_SGTH_ss3.png", "id": "2264073471007593", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/756589809_2264073474340926_7767431891618600056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev0fKDL2ldsQ7kNvwGTzzT3&_nc_oc=Adp-6GMHHzGU8YUqm2uz_CPzMKpvbeNfduxPe3RcoFTJ5zjC9zjyigOzLTvhJJ68PlE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOPzBbzu6ML7qHW3Pe5zF71HW9CFpDjhVbsasUeVvREA&oe=6AFB285E"}, {"file_name": "Po8_SGTH_ss4.png", "id": "1023075857218221", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507829691_1023075860551554_8681216763734214250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE_GwUKbB3kQ7kNvwE7djG2&_nc_oc=AdpcbL7K-Ri6xqMPET-qVgBzzhiw6RXQ6KtRBqducTAQNbL7_EPyh8kEFKeNh1gXaPU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Zqx9V0ihEVzRaX9eWziquWU-_cBamgbFVrXOFdE2gA&oe=6AFB3814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slrRg27APUcQ7kNvwFrbDLW&_nc_oc=AdpdOQCHSvQCh8dwN2-PeeEmzNCPIz6vGAZ13FkYglyThKg2RpS-C89bUcAzm_CSRIU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaELQl3Famvc7b7Ist6x8Qh669hPV4WcsHo2guL-PrTQ&oe=6AFB3288"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": 
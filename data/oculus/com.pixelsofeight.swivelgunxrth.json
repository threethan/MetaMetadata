nf9UlkJ4g&oe=6AE9FBB4"}, {"file_name": "Po8_SGTH_ss2.png", "id": "1306033794941103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_1306033798274436_3435292701315589141_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSJpc1fI5hoQ7kNvwFILtHE&_nc_oc=AdrDBWeSrI698j_mXXI-dEw9Xi4PNLR9R5uNxJM2ek1UY5_eVjlzqanU_VEUEuTkwzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrU3vVrDlK9yjAFJFCyLSsw6ESOQAM_-rTs2qzgn7tXg&oe=6AE9FEF2"}, {"file_name": "Po8_SGTH_ss3.png", "id": "2264073471007593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/756589809_2264073474340926_7767431891618600056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5L6aWi3VWAQ7kNvwEqahc0&_nc_oc=Adr4KwIDOAOAGQRexBJsxMsWXZMSUUXuFqZBFn-70qRZIGS3szA4rC7CIBFxhWuAMzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHppsOTpSF6kHvbJV1ooJTH_VgmupmNsUUkJOCMhRkqA&oe=6AEA04DE"}, {"file_name": "Po8_SGTH_ss4.png", "id": "1023075857218221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829691_1023075860551554_8681216763734214250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vKc8FZixB8Q7kNvwF1WME1&_nc_oc=Adq9d9blIlN1Yvf76RCxkOv4S-mzgDEyB0aS1HxFmZTtqQG036wtu2NmwO-E9mv5-Ec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCZHHejfROujI32HSqftD7c6JrqL1mpYDG2HVuvcUYKQ&oe=6AEA1494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd02Uw8EKgYQ7kNvwHE8nUu&_nc_oc=AdoUY5iKXbZOw6-I8p9GD4tul5_waUAj5RcUEGLobTH5ndkEmuWIoyjOv9q5o7EfZ1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR4KbN1p6FV2kpqA-3vg7gkIXj3hQzST1ZRouhIHzzqw&oe=6AEA0F08"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": "Ahoy, me hearties! Hunt for buried treasure in your own home! Swivel Gun XR transforms your surroundings into 6 fully destructible treasure hunting grounds packed with traps, secrets, and surprises. Grab your gear, find the loot, and discover where ye'll hunt next!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/sgth-privacy-policy", "developer_terms_of_serv
me": "CoverArt_Screenshot_03_0.png", "id": "466465192573352", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_466465195906685_6524410999576019529_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsDuDDh-9EIQ7kNvwHkH5Ws&_nc_oc=Adpb_9JgDq2JSF4ki401odzlMpXoQ_fWK9IsrNc3mjz_CFqmJAPjxX6aKpjC7BWEb7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPCiV-kWqYOBTM-5hxvhlINLgxOBkyMto4wp5HQaV6zw&oe=6A5F8813"}, {"file_name": "CoverArt_Screenshot_01_0.png", "id": "1779171239273279", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003224_1779171242606612_2456133946134135166_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2K-4FvgL7gQ7kNvwGk5Qd6&_nc_oc=AdpBmRVd7TD_adYHSGXb--uSM4LE4vM2404-WcDdRfwjoe_M3CcRAX23FQES45l-HHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALA0KwzlkYUXIbAbIshDe1QFLE4Fo-imA1jmIiw-yJqg&oe=6A5F7598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_0.png", "id": "1502591547345462", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75416835_1502591550678795_714131516175272875_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP5_VXXYxk0Q7kNvwHixjmK&_nc_oc=AdqLaL3Q2ipiCfSX8vW26QacjAXyqhqYa4SxRC0_xazx2nZuZfOaD4UD9J6K38RC-Pw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBchcmSrN70OJgSUNbpFQZaiSHAIYXmNvMnhRPrAP63Fw&oe=6A5F6103"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": [], "long_description": "Gather 'round, for I've got a tale to tell ye that'll shiver yer timbers and set yer souls ablaze with the spirit of adventure! \n\nWelcome to Swivel Gun XR: Treasure Hunt, the game that'll have ye plunderin' riches beyond yer wildest dreams right from the comfort of yer own home! \n\nAye, ye heard me right, me hearties! No need to brave the perils of the open sea when the treasure's waitin' right at yer doorstep! But beware, me mateys, for the hunt won't be easy! Ye'll need yer wits about ye as ye navigate treacherous waters, battle bloodthirsty scallywags, and unravel the mysteries of the deep! \n\nSo weigh anchor, me hearties, and set sail for adventure like never before! With Swivel Gun XR: Treasure Hunt, the world be yer oyster, and the plunder be ripe for the takin'! \n\nSo tell me, me hearties: where will ye hunt next?", "short_description": "Ahoy, me hearties! Dive into Swivel Gun XR: Treasure Hunt, the game where ye plunder riches from home! Navigate treacherous waters, battle scallywags, and unravel deep mysteries. Set sail for adventure and claim the treasure that awaits! \n\nWhere will ye hunt next?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/sgth-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "https://pixelsofeight.wixsite.com/lander", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7574005185956259"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1534163588067174"}, {"status": "PUBLISHED", "id": "1433267714600164"}, {"status": "PUBLISHED", "id": "972227168057628"}, {"status": "PUBLISHED", "id": "1199532991740442"}, {"status": "PUBLISHED", "id": "1483184289267104"}]}, "baseline_offer": {"id": "1199532991740442"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "
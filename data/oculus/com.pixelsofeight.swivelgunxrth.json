075292048317643_8815080526322488490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9mNx00v7X0Q7kNvwFt7iz_&_nc_oc=AdotWr-gHtKqkCbnrMLbZL-i_WiHGR1C0SCjM2aT8uq-6wn6SGv3YJhn8fjrNW_kxeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTqFDDkJtDAKmXIx_czwVnjuVe1W7jyORnAKFE2i9kNQ&oe=6AFC70B4"}, {"file_name": "Po8_SGTH_ss2.png", "id": "1306033794941103", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673536876_1306033798274436_3435292701315589141_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kr-Cj0Wi-wQ7kNvwEis_WN&_nc_oc=AdqA0fmrZxgRnCY5-PJ-CsYfUxDc80p0UllKW4hC_k67ybHIv2husbnvgX3kcM5TL8g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnrM219sZ8A2liak8_xpsYalviwdbxv0eU6cl6HgCFcA&oe=6AFC73F2"}, {"file_name": "Po8_SGTH_ss3.png", "id": "2264073471007593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_2264073474340926_7767431891618600056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev0fKDL2ldsQ7kNvwGaO8Y7&_nc_oc=Adra2ZZWUeFtB9sh0ecBEZVnG-u6Vp9yQ9Pmiu0KGObqjH7p2yN-Z58VmVH_QIK0NFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8hRZmpWS1xnDULjDVjwS0eK-4ybht3MgHcuMc6OGdZg&oe=6AFC79DE"}, {"file_name": "Po8_SGTH_ss4.png", "id": "1023075857218221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507829691_1023075860551554_8681216763734214250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE_GwUKbB3kQ7kNvwEgihWn&_nc_oc=AdrfNvMPoTXXy9rUEKl664iDXD8FRIHlW213XHCmWAcR-o0RuMLVcnG6LjhhUwn9sIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLZmgnUk7HrQEYZNtyqRJyvtdzaZBdPRplQLxATF3DwA&oe=6AFC8994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-dxFsmzIRAQ7kNvwGBC5GI&_nc_oc=AdqVRMhfDeLZ1S9MT8Rvlq6kTKM_JXtXVf1xw5ju9KbGnz_gAvmw-FyDV-Lh9NGKUWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0-wPXTxCMfiKolrk4l3Fp7Yb6ujEkDVB2TTwN2iNacg&oe=6AFC8408"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": 
e_name": "Po8_SGTH_ss.png", "id": "1075292044984310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1075292048317643_8815080526322488490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkzvow_HwdQQ7kNvwHNwSbf&_nc_oc=AdrhM5ER8GqSNQNjOmf022-b5jRjXqDWgisxscONKJOCYZrR_oBp5nhE_csLVTr83w0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ88y0ivNkUvgIAYA2kRJ2PEsJ5NF2V6Ncji5U0HonR6g&oe=6B099FB4"}, {"file_name": "Po8_SGTH_ss2.png", "id": "1306033794941103", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673536876_1306033798274436_3435292701315589141_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9vuDzGMbrMQ7kNvwEYRCs2&_nc_oc=Adq2D9-0byNG4bootpjRGSPFL9a8t8fJcFHapzyazcyUM4BHgbcJygzTk4d6idk9Spw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRFZZgyh5Oq9okltmCQNvp7C1zabLprRuIdhPXJZZlrA&oe=6B09A2F2"}, {"file_name": "Po8_SGTH_ss3.png", "id": "2264073471007593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_2264073474340926_7767431891618600056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1hBKRpE1_MQ7kNvwEn22TU&_nc_oc=AdrC1OUB68lUajtXowPeqp3Sgv_nvYtQJycGp7GdrL_Ps07UMOtxwKovDqVo0Xd_Cxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcWkApKaSjORsrvl9hga3B-uwWO0PnDEiT2Fig8BKPdQ&oe=6B09A8DE"}, {"file_name": "Po8_SGTH_ss4.png", "id": "1023075857218221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507829691_1023075860551554_8681216763734214250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC5B9D_1_3gQ7kNvwEGTvtA&_nc_oc=AdreucWPqsQExTGwtN58k3ICosKOgihmaLSsFTOqfLh9ZQ0TEVH3MBM8QnCj6IAjt2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9ASZRBJhksItHSEDB0NRiDBfYD_pPwk1yGLHhx8iNeA&oe=6B09B894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcagfYC0hOQQ7kNvwEj2Yc_&_nc_oc=AdoTBb_AAbe7GMGaRN6ijMx3EDHb6mAsPlnRXFGlKYyjt_nzsxZZIuoasy3RGK-HiYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRURl2Z-7iv_ljJH5iJy5eyWGNgkUVPCubxHcQhTmdd0A&oe=6B09B308"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": "Ahoy, me hearties! Hunt for buried treasure in your own home! Swivel Gun XR transforms your surroundings into 6 fully destructible treasure hunting grounds packed with traps, secrets, and surprises. Grab your gear, find the loot, and discover where ye'll hunt next!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/sgth-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "https://pixelsofeight.wixsite.com/lander", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9249305361759558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593776279_938380981893606_3841585100029017464_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBGkN-uLkU4Q7kNvwF1jNRi&_nc_oc=AdqgAfYvBE-DR7drDU9mb60jIxuo9usq4Y-NO5nF4hwR2uvxRPGtaT3laofsjc8-9xY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS10SbhEiUy9vZFprEo4UDEVhDMufDzd7LcV8KYJkqt9A&oe=6B09AF0E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swivel Gun 
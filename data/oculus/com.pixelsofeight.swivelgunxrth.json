railer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT9ij2H0wNIQ7kNvwFFCkY1&_nc_oc=AdovsCzZyVXVkr17mhQFgQ-OTkybnTDbuZn71w_9of2nwL5PsrORnj0cd6BsTi6PW_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoBd5SDhcxmmZliYp6fRVK16_CQTfhjm1f9zZNtfcqsQ&oe=6B0DA788"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": "Ahoy, me hearties! Hunt for buried treasure in your own home! Swivel Gun XR transforms your surroundings into 6 fully destructible treasure hunting grounds packed with traps, secrets, and surprises. Grab your gear, find the loot, and discover where ye'll hunt next!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/sgth-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "https://pixelsofeight.wixsite.com/lander", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9249305361759558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593776279_938380981893606_3841585100029017464_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEAOHWpdrnEQ7kNvwG4oW8U&_nc_oc=AdpRI2nZeQylFshViYc0NqXehua6wc2YJ0LC5IVK6XqMDzGH7jeDJOL6Yh5t-F_7V8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4IaQUSC-vNvvxUAtfbGsVUE1ujW7lLyf
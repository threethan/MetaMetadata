075292048317643_8815080526322488490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBuGS6akIBgQ7kNvwFeorLq&_nc_oc=AdqRMNtDzX-hAqrci4OCNPGgPo4Eb4iBrgZ08U593kd0nPun9_SPWbWormJ4eFS_PoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAXs7QfiTBJ2KpfDPlz_jQ4fAO2kheBxspOYzK3q7ABg&oe=6B0459B4"}, {"file_name": "Po8_SGTH_ss2.png", "id": "1306033794941103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_1306033798274436_3435292701315589141_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BQNNjqNzsUQ7kNvwFzYD5K&_nc_oc=AdqzilnUHCMNvoWBlBsbNW1zU90yDOkCq29VjWkv16Pq2eKPLLk1HFZ6lqVOZnIuTbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4kAkTlNV1cydkBa9stJ87UQk6zkR2GU0GJQYxSBreGA&oe=6B045CF2"}, {"file_name": "Po8_SGTH_ss3.png", "id": "2264073471007593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/756589809_2264073474340926_7767431891618600056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fLGDxwSNA4Q7kNvwF2jzDp&_nc_oc=AdriGiKPBz0Pdok8GvWKTvxe-xZx6RRdC5SRn4GV6_6HY4AgioZ0mlHtZnMea2nyPrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDJ6z7ea4suLQmYNML4-q2pWW5uLwdM5TuNFAyBxjCrw&oe=6B0462DE"}, {"file_name": "Po8_SGTH_ss4.png", "id": "1023075857218221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507829691_1023075860551554_8681216763734214250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZeBAmySBpEQ7kNvwHsP2cj&_nc_oc=AdpciIkIn20ZIK7DVeobI6Hx7Bdd62btz2CyCb-O7yYX0NWgMzkNCtpB7eqob3TA6uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGcvXSFhwO9MixWPTweEQv5gXyCDujY49nPbazCC_QAw&oe=6B047294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LANpwxByb04Q7kNvwFEQF8J&_nc_oc=Ado9wiGzzBjXEFBq90bO53kaXMj-zlSVrLbHmmiTe8eIh-U9q042KZPjQQ1yRijm9aI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOIYCU_UB1QIU4kz5kiOqcxM9NbylMTncH5KMrZibGvw&oe=6B046D08"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": 
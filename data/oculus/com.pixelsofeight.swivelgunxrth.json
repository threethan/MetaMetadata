e_name": "Po8_SGTH_ss.png", "id": "1075292044984310", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312470_1075292048317643_8815080526322488490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkzvow_HwdQQ7kNvwH46ifG&_nc_oc=AdpXp6sOC4DyoREoxuWUn2yiwLkA3-YQRabrbD9ht1uZv__HHws6gogasTE5ZT3sGHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq3TJVZvrScAEeBBP2cHfCmtKZ42lcLnwm_BDizk8M0A&oe=6B084E34"}, {"file_name": "Po8_SGTH_ss2.png", "id": "1306033794941103", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673536876_1306033798274436_3435292701315589141_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4XsGNVG1SQQ7kNvwFskm7B&_nc_oc=AdoLE9uCqJtNTda7SJklwxPHUiFQsHM9P7bV0CMbwltp7blomKWF99gdGMgoPOrJ6lg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg-PFb1s85lZD0xBVFzQ-fQlU7Qi5fS0popxINURWJig&oe=6B085172"}, {"file_name": "Po8_SGTH_ss3.png", "id": "2264073471007593", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/756589809_2264073474340926_7767431891618600056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1hBKRpE1_MQ7kNvwEukk_C&_nc_oc=AdquW0Yu1UFFjJxz1MUV6NPZ8Em1WAMNb7V3Q7Ef8m6ZwZwOBaW8DC1vJC73cGv8RhI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKEjTXzhchTVSmzmymK4EHxGLJQQTfegDc4lNal-2wbw&oe=6B08575E"}, {"file_name": "Po8_SGTH_ss4.png", "id": "1023075857218221", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507829691_1023075860551554_8681216763734214250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTRQY4QBZ8AQ7kNvwHR8jBH&_nc_oc=AdqBEM6Im9c9C5hFN9f8Br7Irj-8_0BDa9ZKHIceNfXCzRa9S1eT-YN875m3G_l9D3A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQszFV1KYSFsU1YCePA3h8TdXaMgEAtMZYJIn2HXTA7pA&oe=6B086714"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Po8_SGTH_Main2026.png", "id": "1254742421055768", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312310_1254742424389101_8135618326636213207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcagfYC0hOQQ7kNvwHy4onG&_nc_oc=AdrFmYWnBak2ey2NjXk_SZ8N4707vkZd3McPCChq2PIErd_inSt8SSJ_04Y8vOvuQ3I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMOVAee3y0BGNriwVmociDGFhaGTt3OpqgzucudK71iQ&oe=6B086188"}, "display_name": "Swivel Gun XR: Treasure Hunt", "keywords": ["pirate", "treasure", "hunt", "skeleton", "fight"], "long_description": "# **Swivel Gun XR: Treasure Hunt**\n\nAhoy, me hearties! The treasure be buried... right in your own home!\n\nDive into Swivel Gun XR: Treasure Hunt, a room-scale Mixed Reality adventure where your surroundings become the ultimate treasure hunting grounds. Load your swivel gun, grab your gear, and hunt for buried riches while dodging traps, dangers, and surprises!\n{1709831363571926}\n\nYour room becomes the game. Blast, explore, search, and uncover treasure as the adventure unfolds around you.\n{2087471522206695}\n\n# **6 TREASURE HUNTING GROUNDS**\n\nExplore 6 unique, fully destructible environments, each with its own hazards, traps, and secrets. Keep your eyes open. You never know what might be hiding beneath the surface!\n{1623237512483280}\n\n# **FIND THE BURIED TREASURE**\n\nFollow your compass, search your surroundings, and track down the hidden loot. Watch for dangerous traps, unexpected obstacles, and treasure that's harder to reach than expected!\n{28206495362371080}\n\n# **WHAT'S NEW**\n- **Overhauled Spawning System**: More exciting and reliable treasure hunts.\n- **NEW VR Mode**: Take the hunt fully into VR.\n- **NEW Hidden Map**: A mysterious new treasure hunt awaits.\n- **NEW Meta Quest Achievements**: Earn achievements and prove your treasure hunting skills.\n\nAnd keep your eyes peeled. There may be more hidden treasure than you think.\n\nSome secrets are easy to find. Others may require a little digging.\n\n# **WHERE WILL YE HUNT NEXT?**\n\nGrab your swivel gun, follow your compass, and start hunting!\n\nYour **treasure** is waiting.", "short_description": "Ahoy, me hearties! Hunt for buried treasure in your own home! Swivel Gun XR transforms your surroundings into 6 fully destructible treasure hunting grounds packed with traps, secrets, and surprises. Grab your gear, find the loot, and discover where ye'll hunt next!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/sgth-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "https://pixelsofeight.wixsite.com/lander", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9249305361759558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593776279_938380981893606_3841585100029017464_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-PLfxWUR0EQ7kNvwHKUY01&_nc_oc=AdpulFLL_cXkHe0QIh0xJcIy8teEMtIPnQjlAYjDwcSKM7unn_3PxihaQ9AV7BsCHrM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3zyRujwf41MPAm3LLNLg8ce2J2bfyMexq0Lc5l6wEZA&oe=6B085D8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swivel Gun 
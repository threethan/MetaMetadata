.oculuscdn.com/v/t64.5771-25/491821194_1083802216506831_6711596802651647337_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vij9vFMJ7oUQ7kNvwGAZYEX&_nc_oc=Adp_7O0wCrDPDS7Kbv63JgGY4dMYZNCMYuIJ6Ix981SHhGMfsAVqpD2WMC7q-9wpTic&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpm_fofq4TOvj-MH372s0CFKNpwNg9mCvRLW-K03SBqA&oe=6A563B37"}, {"file_name": "Untitled design (13).png", "id": "1041375758108459", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507819003_1041375761441792_8898616913818701108_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0QGpe7T0kAQ7kNvwHy_w4a&_nc_oc=Ado0j9CYnMxo3PPm8glj8g6142CLxe8Ez_YhDdCGxCucc01e3D9Mweg2MFVcwg7JZ8k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4xyT9byTW-nNu9o9at1PEk52FgrtQBjdTHM5VLGEe5g&oe=6A5632EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Rush", "keywords": ["Monke", "Chimp", "Gorilla", "ape", "Baboon"], "long_description": "Chimp Rush is a fast-paced, physics-based Gorilla Tag fan game that throws you into a world of chaos, creativity, and chimpy fun\u2014without the tag. Instead, you\u2019ll dive into a rotating lineup of unique and thrilling game modes designed to challenge your movement, teamwork, and nerves.\n\nFrom heart-pounding horror maps to low-gravity chaos in Zero G, strategic puzzles in Find the Button, intense PvP battles, and the nerve-wracking Glass Bridge challenge, Chimp Rush delivers non-stop variety with every swing and leap.\n\nMaster the art of chimp-powered locomotion as you climb, bounce, and launch yourself through every obstacle. Whether you're competing, cooperating, or just messing around with friends, there's always something new to try.\n\nWith regular updates, funny cosmetics, and an ever-growing community, Chimp Rush is your ultimate playground for monkey mayhem.\n", "short_description": "\"Chimp Rush\" is a chaotic and fun Gorilla Tag fan game packed with unique game modes like horror, zero gravity, find the button, PvP battles, glass bridge, and more! Swing, leap, and explore wild maps with friends in this unpredictable chimp-powered adventure. "}]}, "developer_name": "SummerBlueVR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FjNVke83JFXorfa8Z9E84aKkMRDNfeqbYhfL4-c54UI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SummerBlueVR", "support_website_url": null, "website_url": "https://sites.google.com/view/party-monkes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "23889260657436048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822074_712602224921540_261577104216586750_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9rL1sAc7pIQ7kNvwFkx4Cj&_nc_oc=Adri4dJC7nOOZOnHUnsrglddeir5ntKXeOw1zcYRYRHdDTUXOxeJymEikbO1LH1a_jw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzlWMfTgM5K6N7LXc_dvghwlTdqlZg6w4AV2YXepZvRw&oe=6A564EB9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Rush", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2
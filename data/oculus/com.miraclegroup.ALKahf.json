", "id": "1637010070786262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824210_1637010074119595_8594847530869153490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ckzKVYSzOAQ7kNvwFS8nSS&_nc_oc=Adpbvp_fMo7A8hQv8-Pn-c9EuUrQZX34Nl-4bDBxnE2Ta1mCy7FVSqRL1EZC6falCbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSkGe-2LvN-jzrKxF9gaBcWxzKlrdQWeERB3980IM8yA&oe=6AFDD544"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7bzyFUqg38Q7kNvwHePqo-&_nc_oc=AdqzG9sDfsp029qrdeaOuUjYBlWeSdKAEw8q_LhzlIvD9XDQ6ZlpON2vD-ah0cnKYD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNiUSpfFaNEwToT8SjzrTlMb5P_uHuzyfflJq-4mqvLA&oe=6AFDE016"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9U3iskt9toQ7kNvwEWJVPv&_nc_oc=Ado4Kohz0RfdgpwWEkqDsNrRWL98n48RnBdWqg2WaknUuvGKgl1NLwcAcJ8jPQKADFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVNBCu-W_ARAjPXOl_qgIi2TaZMnv3jnbzPPr0Gp7buQ&oe=6AFDC5F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjzZv8zuL8Q7kNvwHQTjz7&_nc_oc=Adrb66E8_kHO1ryDzhDXLwLaxNoN9HALI-BwM2n1JpbVAQZhGobdV24JOySnOX1E9Sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9QK5Q6djzJhOHoe7WF
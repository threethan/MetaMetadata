hc=y5TKZAyfkB4Q7kNvwE7Dcni&_nc_oc=AdpSdnDCo1hCz75Ly2E_ullHWbrd8gykhZksAfKeZIENAw7xhowjtlVnxi1q5D704EM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf50jqSEgkuRfLlUs2UeN9yLqK8ZKZTrirctlAcmQbRA&oe=6A9EB104"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uauIVdWZMeoQ7kNvwGrv1we&_nc_oc=Adpvi-hmTki6KR43SikYyrii_8SU8oTmjttVSRut2AtNPBLOHRC8fUDE7Fi2P0a4WKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuv8qsH0BUjO0OH3sPjSCL1_6RNsisuYr-7tuPPZe1cQ&oe=6A9EBBD6"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzcDAvwVfDcQ7kNvwH4OKwf&_nc_oc=Adq06rirmMKKoxjIEI5D-He9KpHt5SPqkh7WKgyJ0Xf_KZgzWJUn0TKm5auG40kYYzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhCBS-YnBUmRNQLIadC8R0T_TvesWnLatxn0id1smRzQ&oe=6A9ED9F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lLOL3bJL7UQ7kNvwHbcLFs&_nc_oc=AdoR5zONw2T9cCzd6IgUAQ3W5_C6z7GGHdWihvEd3JIsmB--XpVJb9G2TlAWc0EtBj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKunUgspEgeBD5liDv6YE0MV0hkOqmG-YRT0vTedh3YUg&oe=6A9ECA23"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medi
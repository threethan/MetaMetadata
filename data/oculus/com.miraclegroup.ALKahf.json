824210_1637010074119595_8594847530869153490_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQc89puEsm0Q7kNvwHsqZA8&_nc_oc=AdrL-kXUzVsnwMewBNdmkD-bzz5uTnJ619GbkdE6RwdxErNDoRk451JVKTqBmDDLq34&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cvwxUrZ2v0OQDLqHV3q9RkVf7PgbmN9muP9GcsAD9EQ&oe=69EF5984"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeS5z5Zdc5UQ7kNvwG8d1iM&_nc_oc=AdofcgVNtqV_93pljQrUEnTbc-6u5l_nnkvE-60Y9TkoKnu8kvuNUr4aMuChgPjOxi4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18wrbbm1AAbY9KmaiRs_iaCK8jqrH4nRVjDUxk2pl1QA&oe=69EF6456"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xsMz0Mq4t8Q7kNvwGMMmqS&_nc_oc=AdooC6JgBae4Rv073GnyniJdvn17vqSymQfGsTgNfhFZrRGxYPQ9KYbBeL2tybUpujM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af118tcVw5iQ4EK2EkLDkZNN3yPhB4H-YvSZlyUObc5Eww&oe=69EF8278"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3450498551795834"}]}, "baseline_offer": {"id": "3450498551795834"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775116260, "status": "PUBLISHED", "id": "3450498551795834"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26361977483491618", "version": "1.0"}, "id": "959466826515417", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": 
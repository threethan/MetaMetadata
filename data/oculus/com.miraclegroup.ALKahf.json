hc=A-rA5Ndd5BEQ7kNvwE30dST&_nc_oc=AdrOOS9kfG6Wt8EzwX9zuxpqIePjxgX5rsnvY9b2c3g9kPJKlZCCXynGZUeqArVdTK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY3vtfL-RRjUW-vOcWbwzRGhMRoAgLlIkN_VbhCpCEJQ&oe=6ACFB0C4"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNBfTOUNyhMQ7kNvwFFvc_M&_nc_oc=AdrbmZgRP4_EpbQsZdiDcjGE6TgFGiIW1h8RRQAu5-pRzwwb0eIt69yEcPC-gpcq0WI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4ByRatyelnESkH8VQUnY95xoFEgYqe_A0okr7l8I9Bw&oe=6ACF8356"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXkUsfPtQSoQ7kNvwGZCHYi&_nc_oc=AdpprJ4R3zqlH2W5wZz0OSTOnLNM18wjf8qAKv5Yk8bpgpr10LaDhsUby_ru11GEdys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXqk9rUy9ZCnaesGkT-08J0tQG8ljhw-YZdWJubLWPyw&oe=6ACFA178"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prgMTXhSU-UQ7kNvwEyoXac&_nc_oc=Adq_jE7IUJJUvC5xuO1NNJrYB4rJGuIRLI_94Uz9lwk362LBQbwJsNVeGQ0IXoYi8BI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8eQ5uTtpR7mLbyoB3gGMSWT5oGZgNGNKCzsV050TTjA&oe=6ACF91A3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medi
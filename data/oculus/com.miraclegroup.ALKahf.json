", "id": "1637010070786262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824210_1637010074119595_8594847530869153490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0q2smdNEAcQ7kNvwGEjK4s&_nc_oc=AdrCDI-XvtybwuhAOanDFxE7XKnfzYMTJkwzr7WmETY042VB6fjaPbbHstK07yAWDPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAkpv5DzJwwMzFmpZhLjdiErllqgVTJOJAHM2edyzZTw&oe=6B01C9C4"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQbhIIMnXXgQ7kNvwFiSOOC&_nc_oc=AdpOBsuvnJVc_0bZ6vuBwrrHDiRP-J9V3NZs580nYG6pAe9vNHL9a-x1o0SemmX1JFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_kY1T-rKh633Ah71DzPvP1ppy8cHkDyX63-DYrBwpTA&oe=6B01D496"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wtv2STAffGAQ7kNvwFnYuRi&_nc_oc=Adp-o2yosYdKsYM7x7jM77OiX1dQxBPjF8B9XpOJkRMzTIwuwijdQ2-jBPGbYnCnsY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSndcfghUPIjq5aZJF5SDs_Zo_Ku9GAPFJWmXsfoWui1w&oe=6B01BA78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk4jib5f6sMQ7kNvwEXmmCU&_nc_oc=AdqQHN09dAPojxF7EHYItngW7H3v15Xd114C2jV_MtFf8bWZZqIXigU2IDcX9ykdaX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiTBXTSqKGlFirxhDZ6
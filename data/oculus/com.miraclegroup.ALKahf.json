0a&_nc_ohc=uE4jboI3EsoQ7kNvwH8TNM3&_nc_oc=AdpJsN7lgVoJs3gC4UxF3joAG-vqf3bjBir8vCPCtoLKzhXM22s0ytYzJS1iyJxFo2A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDNQXtGb971nhG_YoCiqhZ-1A4Dmcd-6t1n2yneAEP8A&oe=6A8D8D84"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYTV_gTfh3YQ7kNvwHk_bKa&_nc_oc=AdoEkTx_oMijWS3UeieeiswWbyI3gbfcTdw0BjafkxVRPMP15e-mP6um-l3e3Ue7Xog&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCxrsJMkvD9mILOvvi8uMkWc3M9xlCqTj1z2oJ-Ecyxw&oe=6A8D9856"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyAPwWa-8EQ7kNvwGF7PyZ&_nc_oc=AdobLaTvDGiH9epevpIK0qarWKnCT8QdAoH4Tsh9SRcSxqRWvgJMnALGCtVBBpocIT8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9HDslVMrKESHOfcmop3uFRXqPCxsPFwwtS2Cy0YknAw&oe=6A8D7E38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia43b8i60LYQ7kNvwGBW6YA&_nc_oc=AdoBZKLS6J1n2g8N82u88o4exJGyXVv9l0P7ovhrdPQhf6ymROGhC4Dq6veZpE4LepE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs42UkEObJMhFLR18CEdO-_qA1n6uY2QOV03JFHvIxOw&oe=6A8D6E63"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_na
hc=XmwXvhcHe50Q7kNvwE8Nj-r&_nc_oc=AdqY3fx2mN2LBVxQSI5tWrhgTeisD-Xs5sD4B2dlBwliF6M-ehShN8QGeDiPvO8kicY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiBQmmnJnxtl7iGMUhS9_0TWvWyP59hpFP7nU-GnH-ww&oe=6AD3A544"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvQcTDqtvQcQ7kNvwH83FPv&_nc_oc=AdrvoA80atxllJ4Ev7oS_rAQ_rBKHD4scHXAExuLOXj1uOTySWFktbBFQ_v0HEMncZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxmQeL290gAPX06Q28cFgXYOQQzRIOTff8pKS7Du0Teg&oe=6AD3B016"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y55kKEWxG90Q7kNvwFeO-fb&_nc_oc=AdpDAJrba1R0RpGtW8wPWxyE_RPH-c9OrEMmKckaWDMa8tVkv6GVzK1YUE3rhp7IcTU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMby6FElIvWZaG8TuH-b2mv_LZJPQ_cm3Hx38IK3itd3A&oe=6AD395F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnUsnyyH3JoQ7kNvwEnf3CO&_nc_oc=Adqlkg17-MEYf8WqgZFL3pjf7BXEKX759LQCdcOvyzR8c25AmifDQI5E5xNQ4S_bG1Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEl22mdnYem6H8vrI4GCfyvPE13sPMI8k3_MXMtsk6_w&oe=6AD38623"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medi
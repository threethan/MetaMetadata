hc=m6qzw5yX03gQ7kNvwHYZNyX&_nc_oc=AdpG9_Yg6J8st1bacVFjKNb8Y7jiTWE_-BaOKFh-mbmXv-f4Hxx18DZriB_nz_fLo3s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFrrKELfTvrbeEUpaRpjTz-GasDHEjumclrbhh7JP08Q&oe=6A5A2304"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHyeWwvwi7gQ7kNvwHOIAc_&_nc_oc=AdqXqViZr1EdnNh2JBU-Cb6QcgBYBmwD18Ntjv5-mCj8LDua5j2V3ykqbqjV5v82ilE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB-QnUq_vdfvo9rPgccypw9iUxApVV5ki_xU1YbmopkA&oe=6A5A2DD6"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIS_XW_5JJkQ7kNvwEnRF9x&_nc_oc=AdqrsRQR22Q-OQ8yt1spcjJsgcFullIIRiY9H5thvmnKFpVvSoTjpmz9mhZMsNJEpZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKzbtJn5kq4WUB8NGy8jx57E3gTco-wCqtVkqiRG6kYA&oe=6A5A13B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUsQcZ4IUPIQ7kNvwFUrBmG&_nc_oc=Adp8TFCH35mMWay0G5t7YY4tTRgyBtX-eVG3GznbD0m3CW8H64vkQWB9K-NiG4gk8A4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQVDUALGR-xfwBUh1m3rj9gbyuq_eEkROMGS8zy8wCDA&oe=6A5A3C23"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medi
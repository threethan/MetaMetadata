824210_1637010074119595_8594847530869153490_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYEQFTE5udEQ7kNvwHWyBuD&_nc_oc=Adq9u1k8xZDDc2ZhApV5aZ7EqdWTP56XxooOfThtXA2E48io51tqPPEGpmS4nM5xVvc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H-VtauYPRKqhHG7Gpn8U_JJElgF3PwniY4Iz__XZS2w&oe=6A2FF304"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF89zKkeaIMQ7kNvwEBw4bT&_nc_oc=Adrzly9DER3JUvYXR1BLdC3VcqiPTxAM7eVA1DfBcurXhi1MvFskK96DUOM8ixelaFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rrUrBmZ-MoUbOpcEvD3c9RL4Zrw4r-_kqP6vPnq7uUg&oe=6A2FFDD6"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hScam05zJpwQ7kNvwHtKAw0&_nc_oc=AdpN8CDz69ZHA51gTfcR2wsXatECgu7UG_FfwxiE0liIYPlWk6rYzQtWKHvT7GcZZYg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oJ3NmCq8K2T_uqXRiYDtfi8ZnecqpE9ySFABsT-C2QA&oe=6A301BF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3450498551795834"}]}, "baseline_offer": {"id": "3450498551795834"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775116260, "status": "PUBLISHED", "id": "3450498551795834"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26361977483491618", "version": "1.0"}, "id": "959466826515417", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": 
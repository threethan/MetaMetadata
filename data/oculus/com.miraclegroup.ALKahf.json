hc=9V1yzbHfJJsQ7kNvwG_xMU5&_nc_oc=AdpC17enxPZquUZv0kCUqZ1o3PyRsCWYujX-aHKXe_6Gnq-65sSSVCFzpoWbnHVdC4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lDuUKwfcTNkVhF4r1vks2JnHtwTxoeVb_JUked13ETQ&oe=69F9E584"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIfZl3Gf8Y0Q7kNvwFA4ak-&_nc_oc=AdrpCxaxgsDgaEx0seAn0IMg6-w79EUgyKytVbafEVOFD7WLGE-0PPs_g10bSdS9VU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a-AXleNf-45eCojQf3zwSzEWYSRi1pZW9ZEojRLmyQQ&oe=69F9F056"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2f9435dE70Q7kNvwGnLIo5&_nc_oc=AdovGHw0wV_x1SIBB0L4HHE8wNMN2LM3INKMrm6bD_-A6Pe4wiRW1o6usBLE8MSaiUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uBQcxdivS5qbyEwg-I9metSWwPLVrXa1eHFchkReZLg&oe=69FA0E78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0FxoR61qvIQ7kNvwEIu3hO&_nc_oc=AdqCgab7s1YRgNTE5fM1wpRIOc-u79MThyjuxNQcPGU_zU0aFwZln8tv2uSdkMZy0bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53wIHrYMsZBPPgxqMUd5o9fQjkp_Rg26tmE3JxnEJ2Jw&oe=69F9FEA3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medi
", "id": "1637010070786262", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824210_1637010074119595_8594847530869153490_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f38Fzzw4XAQ7kNvwFhQePc&_nc_oc=AdruE2L-f1rE0Ax2_dzaGIZldOdshJuZ7c5F2DIMDuKkRPhHSvL8gFSS5Y17EDDirtY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRj7sEfkvMiI_ejFghPJecJvAqg0rjqdgTDen5TCEIT6g&oe=6B0B3C84"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Om5XVTD9tYQ7kNvwEK67_-&_nc_oc=Adoj8Gp_MiwdhDwSN07ibpuybQjYNgN9lC6ic2en4-oJXP66IY5nFyhlhHdmNmRuFfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIwzw9K3QYQqF8JUvLbCifEIaCEnEeAIqxPlkQ3MulTw&oe=6B0B0F16"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYN3dUCwfdQQ7kNvwESXxQe&_nc_oc=AdobfxC432iGk0ks4-PI3FWHZxVGMGWYu0XcK-gMQhL7jm67CYXoWVgbZTNEhKw_wxA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTc23_QRwnVydMVDcKIkgbbBFmwTZ_MjPZ410P6-icyeQ&oe=6B0B2D38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FusivfHi59MQ7kNvwHECVI5&_nc_oc=AdqoxOr58lGPwq84iBeQi15N3WNpDUPhDp5kw9hAMkYPvvJaaFGbMMPiB-Uw7bgOKB0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgAQLv2sqSTGAY5J4BH
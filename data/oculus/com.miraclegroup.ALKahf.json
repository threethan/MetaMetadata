cription": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsvHdj7lI0oQ7kNvwHE4NS4&_nc_oc=Adpa44GOju4xYf4_C3s7f4_5qYoyorar4_klOBg8vqewtQwvOksd_dTEyJ-cWyhw6FY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EMKDKMpto0H2DYtv2XF-xbs8B4sMmU_Eyca2-5pHbpg&oe=6A412FA3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medi
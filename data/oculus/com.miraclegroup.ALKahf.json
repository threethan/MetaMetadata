qhBYuOVNdQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02GZB2K7imCZ93c3JScadL7u_gtSpaBCqT2R8Sj7LjMQ&oe=69F1FC84"}, {"file_name": "ss 1.png", "id": "1228013439320922", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314663_1228013442654255_6653356537693869670_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeS5z5Zdc5UQ7kNvwFF2hbl&_nc_oc=AdqSAhfm2dN_zTs6tdGuGLSlRvFb2vWc99sCM664hl3rf_Bf1iK5dvdJOM7lRYqr1fY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NPgptrVpRUOOCXVaNoPlO8OGbZNotVRGtjbxcz4LeKQ&oe=69F20756"}, {"file_name": "ss 5.png", "id": "942437105176010", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818890_942437108509343_4211134600841247693_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xsMz0Mq4t8Q7kNvwGFlae7&_nc_oc=AdrmjTtD_EVd-mmd6lKm4ZnkfPc02zy17z0rf70fe67vqxXbflBRCIpfXUmc_Tsr6n8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2I4p0w8yvGYobT2JZfEW-wrJmWh-0JyoIF-4gp4Np4dA&oe=69F1ED38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Kahf", "keywords": [], "long_description": "Experience the recitation of Surah Al-Kahf, the eighteenth chapter of the Holy Quran, in a deeply immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Kahf. The carefully designed virtual environment and high-quality audio help create a peaceful setting for focus, contemplation, and spiritual connection with the Quran.\n\nSurah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance.", "short_description": "Surah Al-Kahf contains powerful stories and lessons, including the People of the Cave, Prophet Musa and Khidr, and Dhul-Qarnayn. These narratives emphasize faith, patience, humility, and trust in Allah while reminding believers about the tests of life and the importance of staying on the path of guidance."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26361569610199072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827973_919111104437733_5324153130356610378_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fcz2FvBO7Q8Q7kNvwHWML9W&_nc_oc=AdoWYUVXf1L6kGMRNpveJ_UsP9usjdX24LFwXxf1NuDPoyTKjpueloU-J-R9XxnvkkU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3d2y0gv5hcCbQ5-V-oU9_XZuFQdRGnhNKIOxv-V9bFFQ&oe=69F215A3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Kahf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1775116260, "las
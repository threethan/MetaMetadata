m&_nc_ss=7f20f&oh=00_AQFU6JTRIcIS_PxKbfJQCFv8CC2NJUp7lUdcCymj422vgQ&oe=6A901439"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K1B5ujrTXAQ7kNvwGXOHfC&_nc_oc=AdrOlnE6x7MJYshLjOgZ-Fk3HKQ6WJqnJ5LrR5Zpo7pYPkaGspZfgcMMkCSIMOJH-6E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9UZG9WiWf7q1WjRlLgR82I8wwtvAieHxJAxaxx3OBSQ&oe=6A902C98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI4pSFpxFTMQ7kNvwGI_RBK&_nc_oc=Adr6mmTP15AgXTW-3-sAygtj2nvRdWdlz75KegoEax9cHbfYlqLGtZGUJEdK2U_NLr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1_6L7AX-TwHynVS2kxTEXwSViWfoubGVU7QBQXCW3Hw&oe=6A902017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LESDfaH8JaAQ7kNvwEbJpek&_nc_oc=Adp3tbGFmZ-VfQOxu2EafM_HWnDZy8m5As-r6RyoUA6Uz7cePC8QCLoI0WgAxhxZ3aA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzLGOxFGJiE9W8Z3oZESevmbA5YVQBm4zf3jRt-bO72Q&oe=6A900D81"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orc2nRBuCt0Q7kNvwFOeK9A&_nc_oc=AdpZBJ1afBx8hAOTpHC7dNicRR1OpWLlONnraJgVLIuR7B_K7cxtob7h4qpFEAMziQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyh7XrMw9jqVeN6Ldp9f3IKVy_xKbd_vNLVzNhkUOXyA&oe=6A90327F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEXFKghm6z4Q7kNvwE42N0c&_nc_oc=AdqaGLYkS4LZ7gvkdEMzezsStWYAq3sf5YPT_xN_32DZuL72IhVDtpxeAixHSSCGmx4&_nc_zt=3&_nc_ht=scontent-
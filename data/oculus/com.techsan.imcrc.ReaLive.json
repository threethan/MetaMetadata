m&_nc_ss=7f20f&oh=00_AQKKwry_wIf0vLICvBR5Yg2jesHn2T1hHz-1rVaa4IKXqg&oe=6AA16FF9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L15xjH-jB4Q7kNvwFG7rHd&_nc_oc=AdoqLCRSW4DE6MI8cGF2dcgrPLnxNQ9UHBzak7SkXc4_0tYROXcLBBmPn2E3wCgJyqM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrRy30qWE_abv54S8TUGjzJ2X8Kug6TFKd5G97OMs7AA&oe=6AA15018"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lROLNyA3yJIQ7kNvwHxSgeW&_nc_oc=AdqC7dFUsChdmcGNTOGsiYD_F7yNR73SFO8Tb_5-9HCjpkMxi-hQ23U1JYL9UwfRkvQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtAnx0IJywQd8yFhNhtIfAZYdyZYED32rpG5BsA4lcMA&oe=6AA17BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNHAyD8D89kQ7kNvwGato9q&_nc_oc=AdpDzFteSbpyRdwaR0M9ZjDG1oCMSDBBGxY2Zf2jt6NCj4v0Eitp_kCE3uH8eMo5f-c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFPrNbnwv591T3uI2CzxY_LSaaBVRvlKUk2VIlY16KUQ&oe=6AA16941"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD_dH3LXZ6oQ7kNvwHSAIBj&_nc_oc=Adoj91cAk9PwtQVVRY8eQTjjSrb_yC6fFL9cyOenkT0VcNqL-FYl8oZeh-ubYjOk4Mk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyEfFKJGututylJIC5PWfGlKLmZRLc2Q-LrbaauDScYQ&oe=6AA155FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTgM0TAWTfQQ7kNvwFqt9ou&_nc_oc=AdpNCS0l63udZQ8lHBwm6jHXFsDJwYKneAHeEwRftcLI4aKjZO4nFjnCRORtcSlKDS0&_nc_zt=3&_nc_ht=scontent-
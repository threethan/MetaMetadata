m&_nc_ss=7f20f&oh=00_AQHpEHW87OJgmmL5EGFXontairO_eax4YKi7PQpxMtxvSw&oe=6A95CAB9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGLH59bMovgQ7kNvwH1If3F&_nc_oc=AdpstVng0VgjiE3eJ9d80K1KecMnvqA1llcgIFQ6Wc0mORIjT9OIjommS_TiK1jpbtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxFSqgwYIl7RiC1ZjSv59rxpWmEvYAgApFXxu3CBhrpg&oe=6A95E318"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mjkn9n7TMUQ7kNvwHesjeq&_nc_oc=AdpWjtjQ0wGHyaQeHnor4YVs4KeTJ-C1DV1dI89XucF20aJrzy7yTBI8lYQSTgqYeP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaoiC8_clwc4B__OQD59l9y85xcm2qKUkoTPxdMZP-sw&oe=6A95D697"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4l-lJZJMJQQ7kNvwHvu2Rx&_nc_oc=AdpZIn9HJH_y_jH6OoO_LoZbNnpZ-9E8JTzRbKlnd4VcG1aECPvFHTq7KOPI5Kz1vHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7-iowm9a6GI22EF85es5qV_FQvSqhf1AO0NQB3SZQwg&oe=6A95C401"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3WkIhE8RZMQ7kNvwFckoTX&_nc_oc=AdrmUC-DkR2LJGkh3WypHz-0wgVqg-nH9ZIsbaDhhPnWhCG1NVOknxPfFhMACbXD4zg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGv8yYDGg5oyZGiO3INELiwHaFgAWhdWQfKUfL6H6ynQ&oe=6A95B0BF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR4IoUFyD8QQ7kNvwE1FIUN&_nc_oc=Adrsmo8vKWax81OVfsy0Ins_D6wo8o2a28DZh6SAYBXVnPEMcPMl4FwOzpRlktiBRpc&_nc_zt=3&_nc_ht=scontent-
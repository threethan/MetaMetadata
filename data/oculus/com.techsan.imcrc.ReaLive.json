m&_nc_ss=7f20f&oh=00_AQJTH_q3Ngq3obuMPZOaMfp1QBnE6pKNSTxumWNmffgPTQ&oe=6AA56479"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByQpRG1Sd38Q7kNvwFaqroU&_nc_oc=AdpoimMIw5V2nysAkVwuMWG-sEKKAEDanolsm1jFDWShj-9WRdAyivxZN-ks0TYcDaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvsKtSJslJqAU_tzV0t1G3tdJaEZ5vyWj2jBQyHSu_lw&oe=6AA54498"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJj2Eqz0faoQ7kNvwE9DgWy&_nc_oc=Adq_q8kZC3breYMRMUWt2ujUMHHjXFywKWWBFh2PrhotBoWlH6SEOzd45ysn8HpqNys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCCthjQPol_wZWXxigxJyKZT6PezSStv9JMEwxAWbLmQ&oe=6AA57057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8OtSd_t3tsQ7kNvwFa5wd0&_nc_oc=AdpB5OOkJ6Qr39StGMtN1BAR11npPDH_1t3Iub1CW__DdNYIq7xQJEuXXCmVyHbvr_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_dAKDffHVig1c_zswOG3unnpbm8q9GF3NSo3zfpreNA&oe=6AA55DC1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajqhhxd2v6sQ7kNvwFvhzH_&_nc_oc=AdrZP76fbCnrswt-eUDqeHkZtsLZo6qO_REHE456PGYj7kY2v30LZMMwS8nwowMTcLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnPBWwf85y8dTUx8L8fYuwiqhn7cRKhQtv107PKJDQ5Q&oe=6AA54A7F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7CwkZOdnjYQ7kNvwGqgWuX&_nc_oc=AdrTGYCPhrHYng8MJdMw7GtehLJ7_mx3IRA34HxIM602dRwRTxz78CaFG6QDflQmJpk&_nc_zt=3&_nc_ht=scontent-
m&_nc_ss=7f20f&oh=00_AQP7Yva_uHPLGN_yjz-e9rLjalHi1q9YSqn2NsBSvD9ZKw&oe=6AC26579"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB1ynf_q4MgQ7kNvwHvWV5r&_nc_oc=AdoInzL-8Odf7LXLx7ov9Y4IFZY9MUnb7LPlz_Q47jtij0cR1MhTCSu9Y_e9o5YdyUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2iFsCQBRMrjv2JMaOMF89v_WkcQqq-VmuuSkSrp3RWQ&oe=6AC27DD8"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7LvaQnl2OAQ7kNvwE6h_lS&_nc_oc=AdpwuqiLQD8xzEmjrC_pbjFaYJA7TE3gVlO-PTrSWB1Sh3wU1_Pev9gEKPfsb7yQs6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiR7OYYofSDPwW2ezeGJWddBo7MEW-TIqI1aYT0KqhKg&oe=6AC27157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmtNBz3awqMQ7kNvwH85mvB&_nc_oc=AdrfLC5YNzr0ydpB7UPV6DH8-RuKAYUendENW-KVoUgr9nSJA2FnHqAezL-Q1lU2H6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTrXdxfssWkrJBQhbWP2-1UaLZDXtRygu8FMiwk8Q46Q&oe=6AC25EC1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLWZw4MCbfgQ7kNvwGX510U&_nc_oc=AdpU3oj-zLnRC_VeEye_2jYgusHOhxHxCSCCIFkmwkxpvzS2kCrnSIqop1kWYaydmBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtuSlM78NJrHL87I7bejr6uEwWFUJ9_k2Y9372MSVNPA&oe=6AC283BF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_S_srW6clgQ7kNvwH-Prfj&_nc_oc=Adpn8IkbKnU51RQ2k9hdhYJLMHpWG2O7XQzZ0lSqszN2GkPCHJNWUT2Zt82vIb63Gvg&_nc_zt=3&_nc_ht=scontent-
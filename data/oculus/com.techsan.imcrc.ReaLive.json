m&_nc_ss=7f20f&oh=00_AQIvZ8tdzduQ70nStlBn0qxfdNVk0IOztpU501FN1-bT7g&oe=6AB141F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwhxr2C7v5QQ7kNvwGxcgVZ&_nc_oc=AdpMdC68mgJmgRc-bP5lnpbmq4XM-yPvEf0HDxryxg6evwSXd1wXpN204jPCgDn4-5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZu53SvFeFPOstV_YtCDOdhcWbAfcQWWlUWrjA8bSmKg&oe=6AB12218"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsSaBbnj-AEQ7kNvwFtFKyu&_nc_oc=Adrz1VIq5Lt9Kt2_Wr_b2xmBLcZ8uoxDPyPBxYEl1iam4tNEDX5EapKwAkr39JZ4W64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnv6IKuw0Nf2CxYcfwt2ILcVYmOQq5-U7h0KONhnMP6w&oe=6AB14DD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRTIEtwBK6QQ7kNvwEna0k6&_nc_oc=AdqaiWoES1qBm1bKpWrqa9J3hgd7hcl0EhZNlD8NC5jXKbNQZDljWh86kXKdI0fJyZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSFzT3VXkxPpySd6iMhaTQaYCH_ZeobEbEcOUbj80FhQ&oe=6AB13B41"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PuPmlBa3hoQ7kNvwE6UMot&_nc_oc=AdqBVjpAtvn_HzguxXR51wm0PCqwBNcu8jPGUE0CZE5AQuvAv0xbRKf4rz3oFe3Eudk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcrH-bz6OiU-fQ7Kt1Fkd8BzvufUaw3-oBNjjkxcQg7A&oe=6AB127FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzkANxYmcEsQ7kNvwGmeRYF&_nc_oc=AdrFeFPfZzMux6pco0EpOWO87_IfXB9U87KDbR5ggFxpQOX2P09s_qKIDzXLI4QhDQQ&_nc_zt=3&_nc_ht=scontent-
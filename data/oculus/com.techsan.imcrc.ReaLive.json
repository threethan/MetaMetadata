m&_nc_ss=7f20f&oh=00_AQL3KiQnAI37sKpNUzQlXClNeaBmXQW-sRoohoklTdtiEg&oe=6AA01E79"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L15xjH-jB4Q7kNvwEJS7k1&_nc_oc=Ado5Cr5k04FWM3xrS8isfY2gxVBwOQoQ7Zse_cCsRhHAdrDJ_Xkb6M8oKfuE1IAgjdQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7M1LSg-Hp2Wj1dySiPhimiFSb4RBO8NWXl7V_SwGapA&oe=6A9FFE98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhfRAsrnca8Q7kNvwHnm6RA&_nc_oc=Adp7BmqlnO1g1wxsbeYDPBAQWVFkv1NZZZs2RIYoLTQbmMUSSjFMjA-bzuvwm9jKXOQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlP3zu_RqZXOTyZBVdI-GlGBfLp5fJ2FUYhGyQi56Dag&oe=6AA02A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_9h3Z07ugIQ7kNvwGMj3ND&_nc_oc=AdpTxXMUhN7fFGsRKMX1HEIoam4-dhR2HRxqxG9rAMj9DiKwzhTZwA9GE2LbmiTKMDE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK03W5cYaXhKV-P4nsC9W7VIeZG1gF9lGyyTYPWgyS5dA&oe=6AA017C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD_dH3LXZ6oQ7kNvwHWox8i&_nc_oc=Adr9PyH7nndfyq3W2YLG7EOPpSleI7ilI8kxCvLzMNdlZo3YXcP2HtfhN7S38mWNo8g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUti3hUPKkfXbcoxBWWvQ4xTucFiaHi038bAhMKB1png&oe=6AA0047F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTgM0TAWTfQQ7kNvwGBiiKP&_nc_oc=Adq9jsOqLyvTJgsVTLihFTW3XFcrIsiB1-nNKxR7w1-UJvdnSIFQTIQ4OUhby-bFeNw&_nc_zt=3&_nc_ht=scontent-
m&_nc_ss=7f20f&oh=00_AQLWPqmLnk91VFa9JyI-cYFeq95JAqMl_1Aa_pqLddaXzg&oe=6AABFBF9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na_ZS4C0mj8Q7kNvwHMcUn0&_nc_oc=AdqhBgd7lKhfAneRHgaxQu-8WzvB9aQQs4YPP7kAsmPuvm9U--N0eJCjESFFSx5MsSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKGUUGjMoDohHCBQ7U7hSr8FxZusqTwuJU7SHWbCyA7w&oe=6AABDC18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbPNHaYk534Q7kNvwEdUqq1&_nc_oc=AdpxgMNZE927QSDxDES3G8aWoxgM4VMDlCRgsRZDI43WX4EEJrEoLsUr57ePpD_gOns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj2pFqQcCieT1bjzbjZq-2sWl6gy86ewCPAsQ3ts2iaw&oe=6AAC07D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnaJ8A3KIM8Q7kNvwFuxOnG&_nc_oc=AdrUdhD6I-T5lSsC8hUKgvFpU1HX8uSVnCerTAEQya2Dqp6BBbxImIhoeMPBocLrk4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMpr-y5xqESkaqKeulNqChMKXoYtcIgaaIYdXngArMHg&oe=6AABF541"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqvnSZBkQE4Q7kNvwHAPVVw&_nc_oc=AdrFNXDVOkbXM9g_2-wLnhdyX_Ftw34vYC3OjqZs1AOxe2M36INZvbMkKxQJCes6dwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_6aasXJjMD2cuvtrOgmWVBQEdt6CtEpGOFxXUqSqQwA&oe=6AABE1FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klIHE0RtN2cQ7kNvwGDbcQA&_nc_oc=AdqBkRaBwvhzzqrPi6cA9XtCWcFXlgyEv3Y_xYNgA9wIYnfA4pB3er0YxXYECRKVhDg&_nc_zt=3&_nc_ht=scontent-
m&_nc_ss=7f20f&oh=00_AQFwJ2iyJR4MgHJoDSWouE8w-xNI3luCSZw6DONDqVbmOA&oe=6A82E539"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOpSsR3j-nMQ7kNvwGQ_WWv&_nc_oc=AdrTEA43p2_0hro6rz5DSZM2b-gjskwJaJvvK5tgFtyQ42e_dsC-TKlwRydFdfAto2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmCIGK1QD8gqb__dOKY2jPm_VukdhpCq9WoCsHBkZmRg&oe=6A82FD98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrfuEB4r06gQ7kNvwHGQixA&_nc_oc=Adq0oaQu6e-FZp5A2gCuU9FROJiv57vH8Zvp7y_ofVSmbgOcDmZLMUNDO_IH_uBFREA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz8msKe0ZtVRL314XDpwFsainEf_HqEZ0qZ1MPj1gqdA&oe=6A82F117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A7T9hMVtRgQ7kNvwEg2Wg9&_nc_oc=AdrXV4yCU8w4WUahflCt5vGwXRnRqj-bTw795-nFHw3CRZgf1L7MyysMvHQokr0O7qE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmP3mfWOp8jqWHYbve5zP1WJjcN6NzhWBYY_Vh8bOlsA&oe=6A8316C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lko71crecIQ7kNvwEs6DH3&_nc_oc=Adq6gdXhjlXJqrfzEuLX41H6tuSfctcFcExsq0DFoJzwJFhlExNdiq0w5wAbgdbUAgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5ER9Lrkg_XBXAGwfreeFXX4i_2creEjWfSub21yD6iA&oe=6A83037F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alvZ0br_RSkQ7kNvwGl607r&_nc_oc=Adp8VytjttVelxXxP3ZfVY8s0ssAN65_1fcgTwjEsfIZ2jq_rEu9arCA6fi3poEBVqQ&_nc_zt=3&_nc_ht=scontent-
wsEOqay9LQ&oe=6B0B2C17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHueDPlHcj8Q7kNvwGJ8qSt&_nc_oc=AdqdyBV7A6rEU0b7XlM6pw3t3K1wg5MxSSDkstCIokCyJi-d2IJyox2gWBB33VWOEvs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYToSsxEnDg15eQZbFqULoLMVpbIXXXU5IRAI52p3j_A&oe=6B0B1981"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "MixedReality", "FirstAid", "EmergencyTraining"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}]}, "developer_name": "TechSan Co. , Ltd.", "developer_privacy_policy_url": "https://www.techsan.co.kr/privacy", "developer_terms_of_service_url": null, "publisher_name": "TechSan Co. , Ltd.", "support_website_url": null, "website_url": "https://techsan.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1167010293167202"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1595062315476429"}, {"status": "PUBLISHED", "id": "1761969791664967"}, {"status": "PUBLISHED", "id": "873653862023776"}]}, "baseline_offer": {"id": "1595062315476429"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787118420, "status": "PUBLISHED", "id": "1595062315476429"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1295710956963801", "version": "4.0.1"}, "id": "850182411104327", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1167010283167203", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1295710956963801"}, "release_
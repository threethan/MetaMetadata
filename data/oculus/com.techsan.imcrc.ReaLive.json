m&_nc_ss=7f20f&oh=00_AQL9WoT-POfpz5faeww3qpC_fzGX3f5ZuJi9Qbh82yVWWQ&oe=6AAD4D79"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na_ZS4C0mj8Q7kNvwHlGXHD&_nc_oc=AdoTWazLFrhtEA48vp3BrSrnkqTI2xJIjKEIewtdMLHELdcrOTYRp0qXW20MTxTTChc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0C2QlfR2JvBeXypcZbnk2YVL_q7HlMEKSOFdHJTy7fg&oe=6AAD2D98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGM3WL7dCEIQ7kNvwEUz_69&_nc_oc=AdrggH3Pbu80CdGUxyUlidI7eIOgMs3dCCK0Yo9OyLiV3kPwKB2Q0l0W-OP4y5IIO8M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0tYdp-xRqiOXBcz008cre8vCQA2yy1b3qS--qdMK4lw&oe=6AAD5957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmMM-sENNMIQ7kNvwFp_PIn&_nc_oc=AdoNx6I16Txkx2jhEqLBG8a_kFB0mCobJZsJMWbj8tUDrZX3k-Pz7s_fOYe1YGxKIho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpjnYKfGaD2lAQTMbwrd2I6KNlV0livmMIcMX1Mbh34g&oe=6AAD46C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqvnSZBkQE4Q7kNvwFxQMuP&_nc_oc=AdrcdTybv8SaQJ9RmfKxs2eGSh3oIz1REJiw0cgviytF3jMEv7cZxO3wKzTPwIVPqzE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_Z3gMJwpHW1v351hYlHjBhLPuTsN2c9not8ITe56pZA&oe=6AAD337F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klIHE0RtN2cQ7kNvwER2ddN&_nc_oc=AdrfDTaXGyychLS50nymLy_NEjt3ZEvSkSYrDrUQ52nzQxs0deOO8L3rFAiYoLmz0M4&_nc_zt=3&_nc_ht=scontent-
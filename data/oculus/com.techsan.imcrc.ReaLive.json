m&_nc_ss=7f20f&oh=00_AQK5MqlSTi9DR8UP7-VltMGjcX6yHIEzDLlVeAusl2UtnA&oe=6ABBCDF9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvGSR2MR1pMQ7kNvwHF1R8k&_nc_oc=AdrmWzbKoh9UIm8JQ_nNvQSyb7wFCnHwkZOZ_goQATHZBqy3Lci3lm9NEhwvrBzH_DM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIauAzV8CvB9ebPxAokUWgQISKIY360xpsLOF9yVpuQuQ&oe=6ABBAE18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy5Oe45FcpkQ7kNvwFP4aAg&_nc_oc=AdrMsesEK6aEXSQYvp0cgocbWznYO_RRanizAw6UDcSqX7tCON5aHx2ySXpVjXHCZOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzISWBB2zcfoq9ZBj5fXWvnLiiWS9PbubhYUPa0OTBQw&oe=6ABBD9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eW7QTpJaFIQ7kNvwEyvYKl&_nc_oc=AdqYKzm8LSmIY44E-MA68MZ1oQdEXNRWY6peyCa0kDuaKGfznFdEMBnjtqLz1cO86To&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEokpKhpm4NPUfqINNvhLL5JHP-j2olFUMNxvVmk4AqA&oe=6ABBC741"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4i-MVVhYIYQ7kNvwEz5K3K&_nc_oc=AdqvRxirfXRN43PuMhi7q5aYsVUgCqfTXQ_nJ8kgpq-jpuJAKPMnE_hTange-AlSE8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbH3qmbiqMHgxXf2crthUcaLVvefTy1M6m1mU7P_juw&oe=6ABBB3FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1kREmfJW2sQ7kNvwE_4eDH&_nc_oc=AdrPZ79A_v1ZFXc9fih4VSKiB1LWQ-RllLjc3yKm0-jcXwQBKpFshEjkSOtZMKcYLts&_nc_zt=3&_nc_ht=scontent-
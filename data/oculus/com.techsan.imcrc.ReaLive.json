5/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na_ZS4C0mj8Q7kNvwHJ3RIr&_nc_oc=AdqikNl1N5G2oLra_IPIdbq2XIkfLzGgZxvjljn5q6IsJ0PKeJZq6GnLUDhgWjdL5dk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRCHC4Ns313NFtTfm1ZosXmTfMxEKKd7H-79y-a9Cgpg&oe=6AAE7F18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGM3WL7dCEIQ7kNvwHqlWDt&_nc_oc=AdqP8E2k_Qu__Xp-HwqEaGulwCRuJZ7tjzGPceCWM4SYUD3bV4hpaGI3GeOgByVlhOM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuJpV001UyA14sGqWR7FBfZRAlRkiQI4lKzwa6mkiadA&oe=6AAEAAD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmMM-sENNMIQ7kNvwHkcPxL&_nc_oc=Adr4Pt3z4DN2N4hgNiWt6YjfcaR87mIw2jHVu72eHnR7ATuIEsMv7l28VlmXqDyKf9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8YhwwtAJ-Rcb0oFRaMtXfvC49xhEIScnTPbKoY48BKQ&oe=6AAE9841"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "MixedReality", "FirstAid", "EmergencyTraining"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}]}, "developer_name": "TechSan Co. , Ltd.", "developer_privacy_policy_url": "https://www.techsan.co.kr/privacy", "developer_terms_of_service_url": null, "publisher_name": "TechSan Co. , Ltd.", "support_website_url": null, "website_url": "https://techsan.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1167010293167202"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1595062315476429"}, {"status": "PUBLISHED", "id": "1761969791664967"}, {"status": "PUBL
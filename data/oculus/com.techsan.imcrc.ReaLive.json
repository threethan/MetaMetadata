m&_nc_ss=7f20f&oh=00_AQOqcfoderiLa4aHLgBlx1d0J6zq_srKngI_exyQKTFI3w&oe=6AC113F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB1ynf_q4MgQ7kNvwH2B5Tn&_nc_oc=Adrq1pqosgcJJKYeaIicQPeLojWM_0wiXHYB9tw85MSbZsM_hP61EwyC_gTxfxZCK9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqKrMp8D8kuAPKVNEWowbKN5VTEBpqDxhyXYGgINupjA&oe=6AC12C58"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7LvaQnl2OAQ7kNvwGZiPMd&_nc_oc=Ado3AvIpzjgFO_nzPyy3FuChSSFQnAAPJFSGLJHhrBJCogEDUvEgNzlBB_cbAh7iqBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKtOk489HhjAzMm3Rpn4fAq8BpEiKYIEXZxGRBRLi30Q&oe=6AC11FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmtNBz3awqMQ7kNvwGzNbKD&_nc_oc=Adruii_idNGIz-rEBhtfULiQUUDk0niattPn-gg6ygqvrqxawJjpfLQxtnstXOetpsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoG8jpYgncFvKrXnTjgef_64MkyF1ETAIvWFLId82aBw&oe=6AC10D41"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLWZw4MCbfgQ7kNvwEeE1tV&_nc_oc=AdpFqeOG5MkMF20XAfjmGACFi2l1O4v3He2JUYzIwXkRInWp83pYaDEQKM8TCoW7gVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOITz7CMKm3S0t-6NwzrsJsUf0dvb3QjpJsiH9y1AxHA&oe=6AC1323F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_S_srW6clgQ7kNvwGl9oS_&_nc_oc=AdpuibsewmKs2NCV9DChnQy4Eephq-lw2U5MOBm2UUCJvWReXpQQV6SlHw58admHADo&_nc_zt=3&_nc_ht=scontent-
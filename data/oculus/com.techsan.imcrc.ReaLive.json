m&_nc_ss=7f20f&oh=00_AQHDeae-wfP7W626H1nyDK92AivKkyykh_m3ujvY6P1ctw&oe=6A70A879"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s66gOzp60aoQ7kNvwH1DN1L&_nc_oc=AdrqOpal-UsMQoAjMTCUWf7-OxLy2Zhi5xGTklC5lBLeSV7oXs4THghffKpivYWSLis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfZN0-0e9krEIlrHTBO4UWvcVd97zCPeCucsNAcX7Zqw&oe=6A708898"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxAlZKJKmIgQ7kNvwHk8yz4&_nc_oc=AdqFKu8h2Kman_H0LaYZMjrvAPhoN8s6aINY2aUMe6uawh37Nq4oObZxGrIjiMZfnEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmRwge5dCm1bhf0jiF4xq3WRyw170VITkU1tiM1Ja-Ow&oe=6A707C17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0hRWVU99SgQ7kNvwFLCz0Z&_nc_oc=AdqefXapL-Qp62rEO07YwkMVCNCBq7uEJ8Qg3d_RdVcjcLgXYq50ZLnUW20pBGNAXzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNZGHp_voHen2StTQPmYUV2fMrS-5mCtOK_lCO0NJ9Ng&oe=6A70A1C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXb8RdQKuSwQ7kNvwHOSsFc&_nc_oc=AdoB8Ee9v5LBkqp6qdFdXrvDC8Z32GMs8lKxakXdV1mVQD6cPdO7tuM4DPbY1jFOj0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ_FsnWmx_5_3wlYPuHH8Edje5lotqHHlYEu2kWzS4NA&oe=6A708E7F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9MG-PcmXJcQ7kNvwEX6wNE&_nc_oc=AdqevfXv--UjofUs5p4BBOWUZUsLeu-3Yg314onNyjPhP7sjM427RLMpxu3nNBigBW4&_nc_zt=3&_nc_ht=scontent-
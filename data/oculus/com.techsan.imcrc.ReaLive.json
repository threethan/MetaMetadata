m&_nc_ss=7f20f&oh=00_AQHjPmsv8-a0wT44sloCWa3QHjKqkP15tYQmrkImbPu_-Q&oe=6A804239"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOpSsR3j-nMQ7kNvwFDbYTl&_nc_oc=AdpHbcI7grAXRW67510bpSHnDoA6jO0NLzC1pUvgxAh0v02DzKdnW2zz3VQF7_U3s3w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdljhumYMMPYLEedz1qJpunSr-tjIsh6MSTIguicdakA&oe=6A805A98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-vq5PtdX44Q7kNvwESqTuI&_nc_oc=AdqOFPeFOw2dJ2wEBji9CDMWav4E6s-h6F4n14OCEksHjjxtT_hTtXqjAcVNwzGUlu4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaVmT_hu-6sDI8-JjPJ2aOUdpabM8XsacONT0CkdVbCg&oe=6A804E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYxRf-bERPAQ7kNvwFi8w5a&_nc_oc=Adp7sLZBeN6R45ufrDJ-906ueCC_xrMmcVhDMlRgs2HO9wQVjdcpw5G1ZT-xFhKe65g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG65TAEo7IC_qxzJ5yLxrnQfNCkflgpYD7y0ER--hgN2Q&oe=6A803B81"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lko71crecIQ7kNvwFFVRHQ&_nc_oc=AdrCnbQVVhwVp467e-DdS2-sWgKha_-PPigdCJUhS3xteDNOX1JqWODxngspqJ8vH-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVTrtfKKoMPaNrbA2Ki-vwmhxCWxoniLXhV4sT9arnzA&oe=6A80607F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk9lNGh0HSsQ7kNvwGLon2t&_nc_oc=AdoV1FuXFX-y-rd-XazXNXZCu-8hZWexYDcgIKZtOhYNW4kdv1YYRbTWGB0Z24C7xXE&_nc_zt=3&_nc_ht=scontent-
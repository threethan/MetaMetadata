m&_nc_ss=7f20f&oh=00_AQKmMD1PU9_nIoPBe_Tx1l-aOtYdKfgFc2IfLjNBq1-I-A&oe=6AB92AF9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKP374OEvh4Q7kNvwHo1AYr&_nc_oc=AdppU3bPM-S_fDRo4vOLN3u8YkdjiC9N0IlfB4Lh9-i66truhFiD12y0a64Gx2SzXZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuF90nSZnCUdlzodbFBfULJLC_0maz0rPArwUufG32sg&oe=6AB90B18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy5Oe45FcpkQ7kNvwEjP44B&_nc_oc=AdoyXaHSklS58HEjqjFuB6yB7j_TNn274zxhopA4N2qneZVLSBNBjMCjNUhiq7g1W0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoPzAln3XLqsMVYT4MgBwVXjVzarXU5dTsT5r6W_Xu3A&oe=6AB936D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eW7QTpJaFIQ7kNvwEe-g_s&_nc_oc=AdoAcKLt79lm2L_qaxF_w1j77OSutn8qRTyZeAWPLp2PW5MX709iWgKBayQbSJTJaVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJNua2xUTsspc4wTDUzY9XaC3HeuVK0OtMP_fQ3IEiRA&oe=6AB92441"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fHQz00h48EQ7kNvwGSzfYN&_nc_oc=AdoUK34Y3Tse84QgHV-br_suxNWdZwlciP3BcLsBi4VMhns6DoRuTI_SYlqnIn8sGMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvSXxE5e0gwKOgIIpjA7MLvWs0oJXfQegeptX-ne1t6A&oe=6AB910FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzH0qrttu-YQ7kNvwHXsEbk&_nc_oc=Adq9UM8ai42RCnqfIPPfdplrvDSfELBKF57o5nfECyzCg2B52MzejyQDfZXmOqrSm3M&_nc_zt=3&_nc_ht=scontent-
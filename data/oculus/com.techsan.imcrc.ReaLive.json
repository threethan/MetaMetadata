com&_nc_ss=7f20f&oh=00_AQLEEywWMTJIv3MxdGk9ZFyaNyKPnc2y3JeQPFwxMVaySw&oe=6AA958F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa-zi4IzSBgQ7kNvwHPf_ZY&_nc_oc=AdpkXePiFgXPygXQR_BUuaHrTlODA3Q1uc_Eu1RwC_ZGOhvQv_uFCAlpimMxpkW68W8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS5ePUzjJ3HkWosTCFGtIzzcV42-WEF4RTyFOt_GzLjQ&oe=6AA93918"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbPNHaYk534Q7kNvwEWmZ-v&_nc_oc=AdrJ-5OQB6ObMfRAQh2MsKomPevUlLefT7RTzPlEO5sEinjwch3yER6cegrGUQgXQsI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7rnnoE79JS0zOMIGMVqFI9k-Iqv8xzBt8zF31cyj_6A&oe=6AA964D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnaJ8A3KIM8Q7kNvwFEr3h0&_nc_oc=Adq-ixre5RFbjD0KlGHNjGjzETSDS_FEkaSyWZefj-i5BZRs766RoeodRohgSWmSWV0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbmJeCkd0ef9oFotgNTlTMpwIEIobTCk-ghvc1ptoSgw&oe=6AA95241"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqNStcO-BEAQ7kNvwHI101V&_nc_oc=Ado56K6EJhnPXJztImQY4-Oj35aT_k-uAKO06-5Ec9tWWt7k1mjZf3ljp_Rru2vOdNM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5SJQXkWKRHw-TNmW97M2p8zDvWgMLBHK4FuIPWXEuYA&oe=6AA93EFF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKhAxTmIHvgQ7kNvwFtSFy8&_nc_oc=AdrQlJTCqA5wEc6gJ0IoBMjLpd0aVym6W9Ph19CZhhJLr1iUW_dMycd4kuugT-4Sw3k&_nc_zt=3&_nc_ht=sco
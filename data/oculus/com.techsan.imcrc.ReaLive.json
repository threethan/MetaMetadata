m&_nc_ss=7f20f&oh=00_AQE5hPlmtczFjyvknQqTEb-VHTyCkrpghEDh62wheimmvQ&oe=6A773FF9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2iWc4kWpK8Q7kNvwE2I5PQ&_nc_oc=Adp6eHyNb6sfOfeG5rZIRv_fDEonpHAyn-dpu4MZ2VaUMl0k3EDTGBvekdcFCE7AcR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF2KeQxbfGmkzCPnd199dxtP6ZFdRQRc-sfcVKFA8lUQ&oe=6A772018"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9l5uN4UiLoQ7kNvwEtZ6Eb&_nc_oc=AdoAK0ZRMQBaOZ6QDozk37yPDjpEEFiEN8JErXgoIlxbZZiCVe8ikNhW8gXKRO90ir8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYhts7pzPTnfu7nfK5N27tNqjk1QfLgJIkVhRTTwIiTg&oe=6A771397"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AhzqADnZzgQ7kNvwHD3gUE&_nc_oc=AdowiRwHFjjFGOHdsh-vINZVxZeDzlBB9obOLJfiKfyPlz4LgfiXqQvJbnHEdma_5dE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnkvD9vzszdaYBiA6lmWCWCALfVTZXrHQf5IVZGIN2gw&oe=6A773941"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkTr5tS__vYQ7kNvwG-Wpuz&_nc_oc=Adq-2IYDxY7butW-807ShX6e9ZJfo5QdosK2ui-t1Fh2EgpZxp1YqFErSKWpmZi5n4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy0Zv2SvT0kbZusMFE6p7GAorkhVdeJ-NlHr1vXJ9jKw&oe=6A7725FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye4GuAsErLcQ7kNvwHzq48M&_nc_oc=Adqw70_m5xMvLLvKhfWlLqctFF0TINxmuxqd_E7oN10ihwGWHaqBrdzXuee1zNVHVyQ&_nc_zt=3&_nc_ht=scontent-
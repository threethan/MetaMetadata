uluscdn.com&_nc_ss=7f20f&oh=00_AQG1Tt7JpVYkBSo5zNxgjvaNUDZ1_cmGRbxkQ9epEOnc_w&oe=6A8EC2B9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5usCU2hzDCsQ7kNvwEWQknL&_nc_oc=AdpIdhsLUGFWM4qhW7cw9tBeW8mxzcZUc-XyTGAdAnOvCnWfjA5OP3ZrHTynCYsfoaY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7tkR8YQk22d2QQJo-mAY8VZCmYxKT9ix2NGN32ZN4rw&oe=6A8EDB18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI4pSFpxFTMQ7kNvwGBMt4Q&_nc_oc=Adr5wyJNVZpYg3kLnL4CN3ufE4knp8tYtSv4tXGny_byp-IKDjhNE1LhZIbOEzu6Dok&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi-xhtJWIMYKz9DxM_br1Ho_HfDSBUeZtT8vjOlyLbeQ&oe=6A8ECE97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LESDfaH8JaAQ7kNvwEnXa7I&_nc_oc=AdqwOGW5Q_Dna2OYRPBI5topQn7R8LkJchZ60S8mw6raDmCgm4Phuuh9dgutLgl35dU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeR0brTFRHEASOZfaDzK8c2PY9B6ALE7CA4rTBf7Xggw&oe=6A8EBC01"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__1Cg5mObmQQ7kNvwFkmzdI&_nc_oc=AdrxN2CvSStUhreeP1jpNnmQDCe8vYWqZW3P7MNxJziDenzp2fogcXFi59TUmGtEDI0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX5Q6ROOGVMb1akyoqe9wYnOqociRJrfDI17b78Il5tA&oe=6A8EE0FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEXFKghm6z4Q7kNvwF6iZCB&_nc_oc=Adqd3Hz65_PTtOUbwKudpVQeaxPKftv87pRwwwkt-ktY0z85TiO98HA00vYCkohAPSE&_nc_zt=3&_
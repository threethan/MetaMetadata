m&_nc_ss=7f20f&oh=00_AQEYxCuzRGY9H7eeJ490GNdFM8RXCJ2nTJl5NaaP8irX-w&oe=6A734B79"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s66gOzp60aoQ7kNvwGHXCcA&_nc_oc=AdpUO_46QFluaqk0xhPjomNcgPCROBKoO9H4ybMaW9PhlQA7L9XQuuQrml68MKqo0bE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX_FeZAT29C-7RUNjhx-ab5k-rQwA2nnk8jZzGCnSp4Q&oe=6A732B98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9aX-FLBf0UQ7kNvwEFSP4D&_nc_oc=AdrUxtNLA1RLrbRofIUViKku1qpx02ycE0ap0GlymBG_lwCN75R5Gx5XnrxNjC00QJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIJsPrm8cgQuuuFUuphnsy38JOcqi4zuqkU-Bl-WpcQA&oe=6A731F17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnib2FgKLKUQ7kNvwGQM1Re&_nc_oc=Adpxta1xlSFfEqFDlFonsLGDRSBYju5tMoyoOmM_QTLwfedXCeFOQ9SQ-P5oa_l-Veo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDCWUetc1kZK_aJLP7R37LlGqhxe_qftNJU0GhWwjLlA&oe=6A7344C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXb8RdQKuSwQ7kNvwFKmQsX&_nc_oc=AdouKFI6EPcWwZStu6-QLIXRXvSi_lXHsplsDqGcnI1jUzFY2ep2eo-Ej-Aai-p1y3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqNkxkZ3vORV6KguYq4iJgwwXVAfy3mMsKdZQikSGh9g&oe=6A73317F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9MG-PcmXJcQ7kNvwHhbXJ9&_nc_oc=AdpCmhq1wXT1_KAS5uz8OrPP7OwgL3pkkqnafmg_36Y9wgMpxX2TI-v5KjrS41BzCdw&_nc_zt=3&_nc_ht=scontent-
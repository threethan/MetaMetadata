com&_nc_ss=7f20f&oh=00_AQJXhujDj69VBwGthAR5iUZpvxTutv-wXeJxFctM5P_Kwg&oe=6AA412F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByQpRG1Sd38Q7kNvwFG5MDt&_nc_oc=Adre0bwO5Ukn8Fsxhl7lN4mrtiQGfcldNrWCSisJwNG5ebfeT8WtKsTy9kjgnocPXHw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYVJmPmdGTOMyUr3BCYzYd7OMC0eSIJ6V2tsXvfzFbcw&oe=6AA3F318"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lROLNyA3yJIQ7kNvwG3bZG6&_nc_oc=AdpC0nKNsEhd2kPBGA58v_ski8SFnkRvIk_-Jl-C8ORkDkKA33UQbyWyPa16Cm4-5Co&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9Ob1EDuLi9bLruJigQcNGMv0wqGhIGVevCJOmktAd8Q&oe=6AA41ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNHAyD8D89kQ7kNvwE8v-x7&_nc_oc=AdqzP_CqIsJ9EqdtvbiuYzemUaPqhEnjChclV5zF0s_560fRqTIe7XtaabUftwil6xw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFElu1k5Yu9Nu8nkFuVVx6VlcRe4mmU-mETitwEv1R8g&oe=6AA40C41"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajqhhxd2v6sQ7kNvwGoPd5M&_nc_oc=AdoG-pGxG3gaI8sOghOZHxgC-wqMJeE3KqnpyA2vaWfOdm0Zgc-iQmrg9vVIMWSf2uc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSZfRymKKwVp4TRsH724i22vt_nHuHgyfBSo4f62JUOA&oe=6AA3F8FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7CwkZOdnjYQ7kNvwFhDZqZ&_nc_oc=AdqAsjGoUDcI57Ky4-ocZQTxxDPg-SHjCOfLIbDpqJyfPVHyShDptizv-z0qljYcHMQ&_nc_zt=3&_nc_ht=sco
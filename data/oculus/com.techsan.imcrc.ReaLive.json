m&_nc_ss=7f20f&oh=00_AQF1xU1Vyt0rh9f32LqNRB3R2csbDjR6g7MOpSuEGhv0Eg&oe=6A971C39"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGLH59bMovgQ7kNvwEXa4AP&_nc_oc=AdoZrO5zazR3XfQkXXPtndk2uso183eonVMipStlGRzDcfuu11E7UCedtplx4zHphG8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjS8I83GlReVYt89-cJ_UsaqyHoZOB_bSYgob17xzsmQ&oe=6A973498"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mjkn9n7TMUQ7kNvwEAvDcn&_nc_oc=AdoNQ4xG3AuRw5baepwKRY8j7x2WCG5TgvASiGdrWAxcVVORtIYwWhaF74V2Is7v4ks&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG74otKOlbuBnZl-L794r_VmBSU43IHhC6u_ywWzwtMeQ&oe=6A972817"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4l-lJZJMJQQ7kNvwG_B8ue&_nc_oc=Adpk9K12YoqWBuAKUfSjv-mF8df0OYc1lOXkbcJSAIXLp5Q3kq7yPt7HgIpunEJTY6g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnZGWlKPdMGLYzna4Z0ton1Niu3Fw42z-ZcS33rgOrlQ&oe=6A974DC1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3WkIhE8RZMQ7kNvwHaI9Ru&_nc_oc=AdrPcb5gEmeNJd455Vxi1dTdpPrI4kLoHST7e8q-ot2IoEbZFbO80siKblFSLgtBkIA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDUzkgBDe32ctSL1MJpja7iXLwvRka5WeRaevvAu7wjg&oe=6A973A7F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR4IoUFyD8QQ7kNvwHPOOmm&_nc_oc=AdpuOH_ff_9OHLyO-0fH-TR07ISSB2zSrEdtVr_S8cpmrYogF-JI8ncAm0ibOxIHQro&_nc_zt=3&_nc_ht=scontent-
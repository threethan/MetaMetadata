m&_nc_ss=7f20f&oh=00_AQHZgKQBijkVSps2I22TaSTrXLMGcoUWpWsRJ1djcLC35w&oe=6A9408B9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGLH59bMovgQ7kNvwH-JBWy&_nc_oc=AdqrIYfvS5hx50bK9JbRuHlIP7RU-zcrHHQKkghO--bAMUbSfFI0FvAHRHf3Ln9Ybb4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUpvHnU4_76WWXl42fVqMO-l9NhyH3-XSPmCCv_6TPmA&oe=6A942118"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2F8IelZ3yUQ7kNvwE7t4S1&_nc_oc=AdreHLWszrvp44j9drkDP-0B13LDct79jFfEHDXhhS_bjJMLyhv1cEepcfBG0nq4t7k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn5xftvRYqg8Gee5hCXeaPTOeMDDd69NzoaoY6Na5DiA&oe=6A941497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51Hh236rebMQ7kNvwFPXJgK&_nc_oc=AdrWdO8HNV7RyLgnfh7WAeLtCiOEm46OR39WN23J74RL7n-nemPYqa_p4do2KmfUKdw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9DOWbwhidcCLav1sRUZvevNl4nD8q15E3KU_YaL6zAQ&oe=6A940201"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3WkIhE8RZMQ7kNvwHVYbK3&_nc_oc=AdogaNT61hg1bi9ywcAdEBW3f-SNEfVSEboQJcimVFLAmmsBJsvvq7K1u43jJK2iudw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHClCEyB-Yvl5Ehzq4NfXaO07mpfJmmunKQb4KQ_mO4_g&oe=6A9426FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6xuLQ4RFwYQ7kNvwEdBGcZ&_nc_oc=AdryL_8hQzwyEizXQJsiztlLF3bngigH4sh8K31GDmVaVn1QmJAZbuuV8QxJJf7lg0Y&_nc_zt=3&_nc_ht=scontent-
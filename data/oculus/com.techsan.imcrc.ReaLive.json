omQIN6g19MIN5cazi8c4hId1vLyGw&oe=6ACB9F3D"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_04_2560_1440.png", "id": "2165199861019811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624656_2165199864353144_6472965878579819584_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVPtLvt95IsQ7kNvwFeVhbd&_nc_oc=AdrEbfOrQXvOm38NCnto48fGSFFjum4ZjIkxaPpCl1FYZblt6eMf9eyucs9A_Xvd7MU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzjfDfCABjSL8BRqw71DAwDq18HUDoaukGYIOyJh7xYw&oe=6ACBBA9E"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_5_2560_1440.png", "id": "1450124427312766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620530_1450124430646099_2820453064207349037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o4pxhky2fAQ7kNvwH1itTG&_nc_oc=Adq-gNWft8NMZYtHmOFhQudNZCSQ1-LCJGeqfK0dh36S9MTthw3sIR98HUXbB65Ry-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6KJjb23MXAOsbtOyGhIENMbsWT4nIulyeXnYJs7EZfA&oe=6ACBA35D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR7kC5i1nbQQ7kNvwFWpl6a&_nc_oc=AdorJNS0M8QtsnZR8LVrBTSJIZFeEp05xCQ5DwrI3ozmETpc0HGZz_UqLoUFjDua0RQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOljr5n-IeT4vEaMNHjwMFfoPoZ2NiQ1EZHK7pKUs5m6w&oe=6ACB9941"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}]}, "developer_name": "TechSan Co. , Ltd.", "developer_privacy_policy_url": "https://techsan.kr/privacy", "developer_terms_of_service_url": null, "publisher_name": "TechSan Co. , Ltd.", "support_website_url": null, "website_url": "https://techsan.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1362990236902539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_907931708995117_8183020433127306122_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk0WQFQlBLcQ7kNvwEZlK2f&_nc_oc=Adod3-DvZpA6UrDo7_Ud0N01RJ3bp6vPUaleAtwk9kDDDlXeCywEDtYZe0tHIS2bF7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDGJh6gYja5fchjlbBdlIzLawJfwnOm25STSR7Iin_zA&oe=6ACBAD9B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ReaLive MR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1784207520, "lastRevision": {"nodes": [{"id": "1167010303167201", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1167010283167203", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1683837309585733"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toKnOdR0XKkQ7kNvwFDaYXl&_nc_oc=AdpnHC6ain44E_QUNiowBaOp0-ybkWxrngphO_aD3ANbimvrDFHz_EWb7AkU8HwJ-7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3iEKmpTqSvYT3KvaRWwKYyy8pmwRERXfgBdoTYEGXsA&oe=6ACBBE3F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-
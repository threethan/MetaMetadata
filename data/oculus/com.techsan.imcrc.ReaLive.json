com&_nc_ss=7f20f&oh=00_AQIa8Zq6tmMtg7mGccubY0OaLS7fpeICqr-SXzY-pzFfPw&oe=6AAE9EF9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na_ZS4C0mj8Q7kNvwHJ3RIr&_nc_oc=AdqikNl1N5G2oLra_IPIdbq2XIkfLzGgZxvjljn5q6IsJ0PKeJZq6GnLUDhgWjdL5dk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRCHC4Ns313NFtTfm1ZosXmTfMxEKKd7H-79y-a9Cgpg&oe=6AAE7F18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGM3WL7dCEIQ7kNvwHqlWDt&_nc_oc=AdqP8E2k_Qu__Xp-HwqEaGulwCRuJZ7tjzGPceCWM4SYUD3bV4hpaGI3GeOgByVlhOM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuJpV001UyA14sGqWR7FBfZRAlRkiQI4lKzwa6mkiadA&oe=6AAEAAD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmMM-sENNMIQ7kNvwHkcPxL&_nc_oc=Adr4Pt3z4DN2N4hgNiWt6YjfcaR87mIw2jHVu72eHnR7ATuIEsMv7l28VlmXqDyKf9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8YhwwtAJ-Rcb0oFRaMtXfvC49xhEIScnTPbKoY48BKQ&oe=6AAE9841"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqvnSZBkQE4Q7kNvwH6CWHE&_nc_oc=AdpvUWW-TbOifTUPzCYukgbUy00Y29nX1Ki8cx5NNb-GIIEoq9UshVxSwKSR0Z3nuKw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjbUjj3iIsAlpKQ3arpUkZUCpicK5oLD23gDJdzizpRg&oe=6AAE84FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klIHE0RtN2cQ7kNvwGNNUcA&_nc_oc=Ado_2Us8qNQDGq7-17daKy1SU9uO-95xEST44T6ZdCtIqfKqA60DfQGjHZabNAN6zU4&_nc_zt=3&_nc_ht=sco
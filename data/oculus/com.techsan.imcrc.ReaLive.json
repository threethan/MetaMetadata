m&_nc_ss=7f20f&oh=00_AQJLPZkcDIabmvekxm8kFCQiNz8DiRoqrIp3G1hMhLKtRw&oe=6AB687F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B71fqH_8Zm0Q7kNvwFy8Rde&_nc_oc=Adq1fKGO_unKfRJqasIpl4-zTRuMSy81T_e5lP0oEHi5JUvoA1xjJcX6ZSF5JsFLt4c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMR08kGyRx5EW6qNGW1QseKt16d7HiWk4GF2UUBV2xyg&oe=6AB66818"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu2hSwis50MQ7kNvwEXWeLF&_nc_oc=AdqfwX01vsZbtjnIFu0GxM3SIWNM9Ro_6rGxh3ojhupmevPyeORymsF4CoqymjCLRFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTjhgL6nD5MU_mO7Bphl2TdWVl5OMlCXahVvobHYbPTQ&oe=6AB693D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--gUK3WyDUsQ7kNvwF2geNn&_nc_oc=AdpjNsxJUlCKzJ8r-XpBo4rSaQEjaeghy68myd9eOdadmXdQP8bkwPesWwouGoE3l5w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCQ-Ir9lubewz450ECAsLiBzDFoGcoGA1gWKF778o7aw&oe=6AB68141"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLEQQF_skMYQ7kNvwEf4U7O&_nc_oc=Adp75rylshd69cm-XCOvQSid6-R1VvmWzwrZoM3yZBW-Nbr1gDcKw6LLYgpcMiQzh7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-_oXgSkKiT066_9XHkJiSb_eC_GJuOcwxOYbYx0w7IQ&oe=6AB66DFF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoifO1LaKakQ7kNvwFeFFbh&_nc_oc=AdrXqh_NLO4PeqteyMal_yjTxsnjk-CGfiPIoun6S021wA5l9YQNiT5WivIYn5yuPqw&_nc_zt=3&_nc_ht=scontent-
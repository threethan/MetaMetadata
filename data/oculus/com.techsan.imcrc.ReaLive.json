m&_nc_ss=7f20f&oh=00_AQL6ZLh5dHNBCYxUeHh-2ng9vkBGz-9nBaavTxpRQ3E43A&oe=6A9C29F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRRiJCSLURYQ7kNvwG1S8Ra&_nc_oc=AdrDj7lHDVcKG86r8tH3klAFpL6bDUkaAmLUFY43ISWqubRJVxL0IIREs1-2m-_sovk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLorPEj6w8VqwgFRZ5F6-6GaPvCtikTiccBKTtiZRLHDA&oe=6A9C4258"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj_y3JG2c-kQ7kNvwEImEne&_nc_oc=AdqXXdCSvmPaC479L-rnIB1Wyl5dqnVhVr7mtKo5KYkukl_lBjX06muMVC6MNvrCm6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkZtjyzutYmxKg1gX_D31IRYqzNWwftgQlJgSLsoqhLg&oe=6A9C35D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPB9RcCdoXQQ7kNvwEhY4nL&_nc_oc=AdpSVudiGAheZndqNaoTBXS7kQ3OQBrfFUi8QRTJG84vRB86Cs4oMOqldlcublMIAKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6UgeumhxGyHOZj1J-xOKE2pT6QccvNx-s5ZybnbOeLg&oe=6A9C2341"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW0B5vZFrJkQ7kNvwHfOLJw&_nc_oc=AdpTdo9KoviizybwrzzIgYKZhOru-x4UDtHdAuZPZRjGG0n9-KQybYqgzJfiQ4n9QTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkrKGqApXJl3Y31OwN5ZyRfLQclDBBPBb4WwZ5V0bb0g&oe=6A9C0FFF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjkDexIwPJQQ7kNvwElGAv8&_nc_oc=AdpuOI70XGH_65B76igrj-EW3nZNjkOxPPr1Yjm6S0WZFBNH8FIPQ-SdJHAe_ttyXxA&_nc_zt=3&_nc_ht=scontent-
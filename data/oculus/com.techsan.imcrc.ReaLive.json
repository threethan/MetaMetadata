uluscdn.com&_nc_ss=7f20f&oh=00_AQEB9DVAmGORbvMblgILPlDiq3-4ST_lfWQZi1zPIgTGTQ&oe=6A858839"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AoCfM0Nj3MQ7kNvwFrzG4J&_nc_oc=Adolfr6UawAsMd4PHM6MuJNfImxH1BBXtajZibgvLFgYcZwxUj-LiCJg-hc6UBurGLo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-m9BCLqVTe3Hdxkuh-Q-nFgWy2mUk14FhN-41ICdR3g&oe=6A85A098"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLe5ljxDYFYQ7kNvwFSoImx&_nc_oc=Ado-G1OoQuwVE1Ar3Mzx1BQ2WZmugdY5ytpZXHQSprNqTMMudggjZHYKJ6vRWLA22XU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlcdp_drBDWNjCZ1a0Z52n2EJgBXdN3CnrZ09EGh_0Aw&oe=6A859417"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ggjdc0UL3kQ7kNvwG06RKA&_nc_oc=Adoj74mDLXRqB51CdK222WHdCkVoRTggkGFCIwN1swODPZRg5puv2cJgXsueGzanyoY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYVqUydOfDpvVt3af44wbaDQdzWA1jnz8qLhV-3bFytA&oe=6A858181"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrPF3WVtli0Q7kNvwGW6pWv&_nc_oc=AdpO_lSwOy9-c3Z_lcMdxiZuQmYj1mI-DnzBHySlLfNkjSuSbvTfgzduA6GoQJnad-s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtvCXJb3VaRa79kHp92fSZJvI53hV6_OCIPTRSahdz5g&oe=6A85A67F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odtKv1QEIUIQ7kNvwH7SbXR&_nc_oc=AdqfQ6pjD7NM21RSyVjzFwd9TT3NqR7nZUGBZZnusCs0B0SyT8EGOcoEYkgR9AZz7OE&_nc_zt=3&_
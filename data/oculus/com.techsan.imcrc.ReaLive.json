m&_nc_ss=7f20f&oh=00_AQFTxGP70dTe26PjHOTaDHnwhT5IKiJtvVcyL9QJdDeEFQ&oe=6A8436B9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AoCfM0Nj3MQ7kNvwHS2Nfn&_nc_oc=Adpb6uRpmQBsyDKMJ4cD6ko65Km9k__2J-le9I54LhpXfGK5OC5jS9It6hrzKsZwjq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2VJRhe5GwrLCKGRJF3UUAVyOjenJcxEOirjS5G6FViA&oe=6A844F18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrfuEB4r06gQ7kNvwFSKjqa&_nc_oc=AdrZjXz_1xrwYxH_jc87hfXoJiGnRkggXQOJWVcfLSTyumAL_D3mCMJEsoCKE6je8BU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH540cqypnZXgoDdC52XoiJtxejT3AghCBAH-IzFxIqig&oe=6A844297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A7T9hMVtRgQ7kNvwFTaY-R&_nc_oc=AdrSzaTfah6uCgCx6tTt6gMeOeTUzy1TB3IGuwsye8egRz8GNMCMl6uqDVrEGaT1Ias&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdFHrbzhWajx86s_VmNpdRQ64yDnjG-nrzaLHsrmhTrw&oe=6A846841"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrPF3WVtli0Q7kNvwGhI-Hf&_nc_oc=Adq3xfYrb1HApkA9kxEOhEN21djHj10IZ90VNL-NyfiLYQmlIOsRuMUZ6wQjqgNHs-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmSasxJE6l1FVUXGobScviX8J2GevsMen15qoIbbOFug&oe=6A8454FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odtKv1QEIUIQ7kNvwHLeidd&_nc_oc=AdrlcIbKHLCTqA80Gf0H2odY2u0BvpTPSb2dOVEx_uEGVNCBPbvJgTVcQRB38gbZIDE&_nc_zt=3&_nc_ht=scontent-
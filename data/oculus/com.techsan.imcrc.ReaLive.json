m&_nc_ss=7f20f&oh=00_AQHST6T4u52zmZhzdSKlDl23hJwEEX7lxxWCayjF_1qFrA&oe=6A8193B9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOpSsR3j-nMQ7kNvwHSIp7K&_nc_oc=AdrAFNqLukz-Oy3mUNhR3UpSAm1A5BVEDls4AbEaOau4dLw5SURMuQtCSRprlYnttpM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3h71-60IT4kuFsx0l8C1NaCVJVZ9WHEPE6Wva7GIUIw&oe=6A81AC18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrfuEB4r06gQ7kNvwGDWQ0o&_nc_oc=Ado-cWcnqNAR8O8m86yRvjA0MxbYAEmd8K5WImgs4N35A5tJuoH9cXpHfYGafbLu7zE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlsmwGtsLnS8Ji--cTFs7NJSgNzagtkXO-4vDnCEMrpQ&oe=6A819F97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A7T9hMVtRgQ7kNvwE9fhxd&_nc_oc=AdrxmHPcPzJtiIvIt5_ubK4tN5L6dihtcRz_6F3fSPjCOjema1iCPcNLwl_gJyNuK1M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESMV5He9rEMMzTPZ7GWCSdfu8LhvZnCHKxmZiYWNJRZw&oe=6A81C541"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lko71crecIQ7kNvwG7YC_B&_nc_oc=Adp6gcdsnAU3QXVS9537N8eMzcv67XCpT51VV3pPMSzsfTWxqWGotiy27ee2oZsrnew&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV0ikiJ1ESbiIoGripQYfiNHOZiavQtBPLL351mlYmfA&oe=6A81B1FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alvZ0br_RSkQ7kNvwGSL8QO&_nc_oc=Adp2CSt9mYLZ_jstdivgwgjRLDH3cG6w_n7omjYpfuLsZT-MsHCOlc3Q12o0mGgumgo&_nc_zt=3&_nc_ht=scontent-
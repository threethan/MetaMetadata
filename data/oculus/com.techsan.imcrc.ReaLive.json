ud6c8\ub828\n\u2022 \uc2e4\uc81c \uacf5\uac04\uacfc \uac00\uc0c1 \ucf58\ud150\uce20\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc735\ud569\n\u2022 \uc9c1\uad00\uc801\uc778 \uc778\ud130\ub799\uc158 \uae30\ubc18 \ud559\uc2b5\n\u2022 \ud559\uad50, \ubcd1\uc6d0, \uc18c\ubc29\uae30\uad00 \ubc0f \uae30\uc5c5 \uc548\uc804\uad50\uc721 \uc9c0\uc6d0\n\n\uc228\ud130\uce58 MR\uc740 \uae30\uc874 CPR \uad50\uc721\uc744 \ubcf4\uc644\ud558\uc5ec \ubcf4\ub2e4 \ubab0\uc785\uac10 \uc788\uace0 \ubc18\ubcf5 \uac00\ub2a5\ud55c \uc751\uae09\ucc98\uce58 \uad50\uc721 \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\uc228\ud130\uce58 MR(ReaLive MR)\uc740 \ud63c\ud569\ud604\uc2e4(MR) \uae30\ubc18 \uc2ec\ud3d0\uc18c\uc0dd\uc220(CPR) \uad50\uc721 \uc2dc\uc2a4\ud15c\uc73c\ub85c, \uc2e4\uc81c \uacf5\uac04\uacfc \uac00\uc0c1 \uad50\uc721 \ucf58\ud150\uce20\ub97c \uacb0\ud569\ud558\uc5ec \ud6a8\uacfc\uc801\uc774\uace0 \ubab0\uc785\uac10 \uc788\ub294 CPR \ubc0f AED \uad50\uc721\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}]}, "developer_name": "TechSan Co. , Ltd.", "developer_privacy_policy_url": "https://www.techsan.co.kr/privacy", "developer_terms_of_service_url": null, "publisher_name": "TechSan Co. , Ltd.", "support_website_url": null, "website_url": "https://techsan.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
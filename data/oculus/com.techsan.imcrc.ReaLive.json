m&_nc_ss=7f20f&oh=00_AQKhALppBqGnHMhg7L4G7JWA5kuOFTx7DumExWSrcqv1mA&oe=6ABD1F79"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvGSR2MR1pMQ7kNvwEGKClF&_nc_oc=AdqzfVCt3VUjzgpJ1Du1cUPL3fGaSCDqo1QhHrZvrl51qIJv1YSAb_iwGaacFaNXvWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeRc4FyQEP4pkIzR4vMXZqL7WJugQrvTx2iMXTCHeFzg&oe=6ABD37D8"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMvpRdu_XMIQ7kNvwHi0LoZ&_nc_oc=Adp2Q24gCPDNC7L6Hl3YaLzD5wJ7ylBdanjCPbJMhXkKXxZ3rElxPU9KxnLyiRz3Spw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxZZsNmvx6W6cf1ic2u-HAA2E0wiNBgmmDSmeT2gOEGg&oe=6ABD2B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aqbmG0RE1sQ7kNvwH0g3YW&_nc_oc=Adod5XFa_0-Gz_5RHiDZK9n9YMY-3_Sq7t3OimCsxx0Pkf_XlKHSryeATfiEp2oaSO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5fx5IfOVeW4hOZB9EJZTiB1Nqa33MVyPYCIQb3X8WjQ&oe=6ABD18C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4i-MVVhYIYQ7kNvwEWoUTt&_nc_oc=AdqcctQGT1oHYBuOCDinFbGRIGf2wYaTt2valn4zFivep9Eya6iOeopsiytkVxbI0yU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9-XJjhacweGUWkknvXKTn3pnWQUKG5vKzvL2Dya6nuw&oe=6ABD057F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1kREmfJW2sQ7kNvwEgivhu&_nc_oc=AdouoKObJP_j2WQh43T71BNURmp3_HslUspA1T58YgZM_fLFIjTinzWRETS8ikfapsE&_nc_zt=3&_nc_ht=scontent-
m&_nc_ss=7f20f&oh=00_AQFcZsGzLNnZlvDzkR85CJ6pL0qvfs0BAeWi1rsr-1tihQ&oe=6A9165B9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K1B5ujrTXAQ7kNvwHKvsYT&_nc_oc=AdrSzjhOCMg1NeyXurt9kvDY6C7x1fn7ojevi7twePnSHqSOr96osYhH0NptRJ_-_2U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi7tLW1SoS5oVaGC7QLcQ9MgoaWMRFtGFQVLlonbsREA&oe=6A917E18"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2F8IelZ3yUQ7kNvwGdj85_&_nc_oc=AdrrtiPAjzGzUeEmJu8up3GTvHHkl0LN2LesLpMq26ohld9hOnkFu54cWY2OVwGcayY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCn4hB1oJn74-OY-TRcbVcyKWml774wIJbxr6Rm5QP1w&oe=6A917197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51Hh236rebMQ7kNvwH2UnBQ&_nc_oc=AdqJEeG9F2BzCY3ffOeStLLQalP9j_NXy0I6n8rmyZU8fJ0Cr4tXYiznhkEyqJIyj5o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKc5KT_c8g2407fTlrcN0tLrhhkfljWPB10rePJZPsXg&oe=6A915F01"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orc2nRBuCt0Q7kNvwHdfPx5&_nc_oc=Ado5m_6X_xsP7kzUD7vm4tAP_hWJqN1eHQIIC9b81l-526d27_YJqlNvLGzH4_Oxy7E&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX9G6ufJhmOzUOoYbyvWmd7sO_MWDox0C4fUn6lP1fEA&oe=6A9183FF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6xuLQ4RFwYQ7kNvwHqlTIE&_nc_oc=AdqowWQu_E5xuNUKhM_fmU5pABFHL1hXGgwHwQX2oTWTzJOAvJBG2SZj0llnX1OJZ38&_nc_zt=3&_nc_ht=scontent-
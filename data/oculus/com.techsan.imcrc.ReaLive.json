m&_nc_ss=7f20f&oh=00_AQIzK70y1XmaJUmRkbM_bCrIJwXkw4HCvViFTuB3Rl7f-Q&oe=6ABA7C79"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKP374OEvh4Q7kNvwGqHXyA&_nc_oc=AdrBI7xUV5PVsy55bAzwu_f1rlY9EnMZt8N3ZlDh0NHR_sPk81DWl4ednXJ5dCreLVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1M9C0t8EFNUT_ZmjLdB25Oh5KKSOXhzQ4G5m8nkeaXA&oe=6ABA5C98"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy5Oe45FcpkQ7kNvwF-sx4W&_nc_oc=Adqc7UdspO9b3VHn48aKxaggK_g8WJ_4jbdVX-BPzGfucXIUFfdEPArai08pVNSFBZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJX1DQ5NbIGszfQWbA9c_ExY2H8Y3cidFL_3I-4A-a5g&oe=6ABA8857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eW7QTpJaFIQ7kNvwEBiwp7&_nc_oc=Adp-KpUEBVEMwF845r02dJWoTvNthhdtMeZUGQ_pQ9Ws3YPqi1zWsjRPCFw0AG2-aRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLRfPL9tcN6_a3bxEI9GfZBWUo_pO0fITeEvhLT4EcBA&oe=6ABA75C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fHQz00h48EQ7kNvwEBiUbc&_nc_oc=AdqLN0ITG73dzxS5lNy0auFa-o15z74D4JxVxh3RnBWN3fUd9P39mA8nfG4vNDjZ4uU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSCTXJHn0D4Z7HZ-XLC7BosDIhamhOo6-JHSslJyqCrg&oe=6ABA627F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzH0qrttu-YQ7kNvwHVf6S5&_nc_oc=Adojgc7Y5ZqPmMgUfUY8jEPavjntBTuf-TIbGV0gFGeZDVS1pkKs48P1_tkWXu8Y4H8&_nc_zt=3&_nc_ht=scontent-
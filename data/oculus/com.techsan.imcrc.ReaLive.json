m&_nc_ss=7f20f&oh=00_AQJDqrqkxdCgv5jQVNV_MlnipRQKQdTTJPFCxPnxLReOkQ&oe=6AAFF079"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwhxr2C7v5QQ7kNvwE3HIpO&_nc_oc=AdovhJaczLnpnKq8RsxRdoMy-qjfIG0h7W8_L0uYT914OPCf0y8pPpyI9IAmgseGs8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfUglFLiSqod7RZnjiY104F2zl5og5mD2ckIn9S2zNXQ&oe=6AAFD098"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGM3WL7dCEIQ7kNvwEU8QiC&_nc_oc=AdrgbF-u984Sf2U1ijoyhst63nq0GH63fXbaoqoXx2sxygdIxFUg2UklZ_qdLMTfvQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzDR4NZhpG7Kss11Y4mesa_4MLfG27tNYHBzMt6tDkvw&oe=6AAFFC57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmMM-sENNMIQ7kNvwF7CzyY&_nc_oc=AdobGnec8uDr2LcMPUQze2b33NOolvpBLkIuU91_OUShvoMwsr1D9MsevY2nYMOIbiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOSjlp99roVGVwZViAC0kf05Cu37oYMnAa2pBY0UHsQA&oe=6AAFE9C1"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PuPmlBa3hoQ7kNvwG4XiFb&_nc_oc=Adq_foMhuXLb8pIJVxlGpwBgdTH_GYDb7y5Ba0j2harLucRAuHf87BBRL3LUAbaXzB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrdtFTDtmGysITaPDv0CHid-rigv8zhYe2OqU2Ly49GA&oe=6AAFD67F"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzkANxYmcEsQ7kNvwFkX_Sy&_nc_oc=Adq-H5TSK0cQAuRj8UMRrXdRbwGGfmSNDVTRsrKj_2zWpQmkls9JvF7YG9YzvBEev_U&_nc_zt=3&_nc_ht=scontent-
_5.png", "id": "1422395933058309", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622315_1422395936391642_433886355379307112_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ0CShxHiO4Q7kNvwEoTb22&_nc_oc=Adocs-_OsTnSpW6DaApb6sZYbd_xFs8LkYdgDd66_gnBoLALWXFT4xeY-4g5eA2zIwE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMk_U0VGoQxRflLDOS4mHF8CpZH2rrqOJy_auWIekWssw&oe=6ADCDA8A"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\ud55c\uae00_2560_1440_3.png", "id": "1597861655041519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673522158_1597861658374852_2047826014421612954_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sakAKWH2tIwQ7kNvwHVbCo3&_nc_oc=Adp4Jo3cT5DTd8QKQFVyumcWIDxmN3oSc4fVYxFIu2_kIogy--acj2nHOldbnrvOhgU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhLWnvaWL9j4duihajADEEdukg5RilP_XIXZB7I7JX4Q&oe=6ADCC465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uc228\ud130\uce58_\uac00\ub85c_2560x1440_Safe area.png", "id": "1947380032587071", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1947380035920404_225227094201288907_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTnMECLsOsEQ7kNvwFMKNjA&_nc_oc=AdrWnd3Urno05t9T0yL92BbBIyVf1gJmC6X_vV7m09U9YoPM9a0mXwMnZvFf0e_ceNc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxH6etl8OuMxxU2mmKGN9cUZwW7TrrSGsJqXiOUfavHg&oe=6ADCC131"}, "display_name": "\uc228\ud130\uce58 MR", "keywords": ["\uc2ec\ud3d0\uc18c\uc0dd\uc220", "CPR", "AED", "\uc751\uae09\ucc98\uce58", "MR"], "long_description": "\uc228\ud130\uce58 MR(ReaLive MR)\uc740 Meta Quest \uae30\ubc18\uc758 \ud63c\ud569\ud604\uc2e4(Mixed Reality) \uc2ec\ud3d0\uc18c\uc0dd\uc220(CPR) \uad50\uc721 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4.\n\n\uc2e4\uc81c \uacf5\uac04\uc5d0 CPR \uad50\uc721 \ucf58\ud150\uce20\ub97c \ubc30\uce58\ud558\uc5ec \uc0ac\uc6a9\uc790\uac00 \uc790\uc2e0\uc758 \uc190\uacfc \uac00\uc0c1 \uad50\uc721 \ub300\uc0c1\uc744 \ub3d9\uc2dc\uc5d0 \ubcf4\uba70 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc2e4\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc8fc\uc694 \uae30\ub2a5\n\u2022 Mixed Reality \uae30\ubc18 CPR \uc2e4\uc2b5\n\u2022 AED \uad50\uc721 \ubc0f \uc751\uae09\ucc98\uce58 \ud6c8\ub828\n\u2022 \uc2e4\uc81c \uacf5\uac04\uacfc \uac00\uc0c1 \ucf58\ud150\uce20\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc735\ud569\n\u2022 \uc9c1\uad00\uc801\uc778 \uc778\ud130\ub799\uc158 \uae30\ubc18 \ud559\uc2b5\n\u2022 \ud559\uad50, \ubcd1\uc6d0, \uc18c\ubc29\uae30\uad00 \ubc0f \uae30\uc5c5 \uc548\uc804\uad50\uc721 \uc9c0\uc6d0\n\n\uc228\ud130\uce58 MR\uc740 \uae30\uc874 CPR \uad50\uc721\uc744 \ubcf4\uc644\ud558\uc5ec \ubcf4\ub2e4 \ubab0\uc785\uac10 \uc788\uace0 \ubc18\ubcf5 \uac00\ub2a5\ud55c \uc751\uae09\ucc98\uce58 \uad50\uc721 \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "\uc228\ud130\uce58 MR(ReaLive MR)\uc740 \ud63c\ud569\ud604\uc2e4(MR) \uae30\ubc18 \uc2ec\ud3d0\uc18c\uc0dd\uc220(CPR) \uad50\uc721 \uc2dc\uc2a4\ud15c\uc73c\ub85c, \uc2e4\uc81c \uacf5\uac04\uacfc \uac00\uc0c1 \uad50\uc721 \ucf58\ud150\uce20\ub97c \uacb0\ud569\ud558\uc5ec \ud6a8\uacfc\uc801\uc774\uace0 \ubab0\uc785\uac10 \uc788\ub294 CPR \ubc0f AED \uad50\uc721\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "\uc544\uc774\ucf58_ReaLive 512_512.png", "id": "3172765129601136", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619805_3172765136267802_5330056257537530487_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw-rXT_PxDoQ7kNvwFwbOOQ&_nc_oc=Adrw5spZQX6bsB43kym-aLax9476e-qHnAadGuRq4L2BEutsmVVloUiyiNKjlGnsYRw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNexqNySrTx3_OfRjma471fa_zyuzuiHEGCMkrCbeKP3g&oe=6ADCBB3E"}, {"file_name": "ReaLive_\uc138\ub85c_1008 x 1440_Safe area.png", "id": "2056872501575900", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_2056872504909233_101411
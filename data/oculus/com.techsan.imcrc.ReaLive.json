m&_nc_ss=7f20f&oh=00_AQMXQJVP7xMjbNVmjLGSySBZNa4i9CF0RpurE4sp1jYR3w&oe=6AC659F9"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_5.png", "id": "4402465093348555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_4402465096681888_8727541928891717257_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdW5VsuaWFoQ7kNvwGHq3Lq&_nc_oc=Adobk9pDiCCAAz1EqQ_gZG9erFKLCisceH9uaJOo2jegBTFIncgcgRqngZqHB-vnQQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_scdpCJY60ZPTQJX7sBGRBrX1X6OOFuIk4MN-c5f82A&oe=6AC67258"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_\uc601\uc5b4_2560_1440_4.png", "id": "1600253395151564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1600253401818230_8931921356295326260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc9ekyvquqMQ7kNvwGpyqtn&_nc_oc=AdpYp68KkqJkTsfKNKzS23VkZydYg_CshhZq-6y2BjWleqccqllvzKptVt79dK8acaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPhTJL6EvlceadCT7bEgjat9mpoSmUGSL9wBIr6rWRRg&oe=6AC665D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReaLive_\uac00\ub85c_2560x1440_Safe area.png", "id": "1333275339009795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1333275345676461_1777668474491896745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPmQbHtxj4MQ7kNvwFEMSLi&_nc_oc=AdqckkkTxSleXOdsr8lERCqVCXG8sllIXbkS01oLSLbFCUGUH24PPX5hBd9_MUYY5EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxZoFHBs52XM6_04vXEUNW_LLKhYBaqQOObmCFmh-r-w&oe=6AC65341"}, "display_name": "ReaLive MR", "keywords": ["CPR", "AED", "FirstAid", "EmergencyTraining", "\uc228\ud130\uce58"], "long_description": "ReaLive MR is a professional Mixed Reality (MR) CPR training solution designed for Meta Quest devices.\n\nThe application overlays virtual CPR training content onto the user's real environment, allowing learners to see both their own hands and the virtual training scenario simultaneously. This provides a natural and immersive learning experience while maintaining awareness of the surrounding environment.\n\nKey Features\n\n\u2022 Mixed Reality-based CPR training\n\u2022 AED education and emergency response training\n\u2022 Seamless integration of virtual training content with the real environment\n\u2022 Intuitive hand-based interaction\n\u2022 Designed for schools, hospitals, emergency services, and corporate safety training\n\u2022 Repeatable training sessions that enhance learning effectiveness\n\nReaLive MR enhances conventional CPR education by providing a safe, immersive, and highly interactive training environment that helps learners develop practical life-saving skills and emergency response capabilities.\n\nDeveloped by TechSan Co., Ltd., ReaLive MR combines advanced Mixed Reality technology with immersive CPR education to deliver realistic and effective emergency response training.", "short_description": "ReaLive MR is a Mixed Reality CPR training solution that enables immersive CPR and AED education using Meta Quest devices."}, {"images": {"nodes": [{"file_name": "\ub85c\uace0_\uc228\ud130\uce58 1024_1024.png", "id": "1592341982239556", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624983_1592341985572889_6947409751023236525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSOU7_Asc68Q7kNvwH38G-y&_nc_oc=AdotnplgsS6jtbTri3KVp6RQl040rt3DRB_fisjG-qvu7hnH8Lf_4YZ5s3vUaJwAfL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUWOTdxBCCMthgbfbKbnCbAKhuH7sEt23aH67IcQGH0g&oe=6AC63FFF"}, {"file_name": "\uc228\ud130\uce58_\ub300\ud45c_3000x900_Safe area.png", "id": "1306835034770003", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623384_1306835038103336_6820841876092211466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ-bHoFrLJkQ7kNvwGWipAu&_nc_oc=AdrvIRCUjD5yEQfu_1EM5gRF3pcdhF2CsSyghvPjmKOLz8y0ZqyxkNDKbR4WXgmELcw&_nc_zt=3&_nc_ht=scontent-
tent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_2310026229849833_4327883539992179747_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhUYbwZr3ugQ7kNvwFT82LA&_nc_oc=AdqziazL5l-BJIkIeU1iKXyycYAjyikeDfQVJ-H37ByxpFWc3J_euYI67m0rgUBngU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqqV26AosvC-IgHmZWDT0fqR2S4eZjUE5bLNuRg11hIQ&oe=6AF8A7C9"}, {"file_name": "shot5-view-2560x1440.png", "id": "4387128121549091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_4387128124882424_8880568201599567638_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxVV7fjhIV8Q7kNvwGLLzVd&_nc_oc=AdoBgZ18HPhrSbCRfpYFly2RbvsNiUY_yHvj6JZTJxbQaPzQUDzOKEAzADVNC74ERGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVbZa_m3qFWyCMlM8cG9NArP9EMxMm6ouCIszXu2Tcmg&oe=6AF89281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1855782625585361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1855782628918694_2666355021243136012_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdqOJuYfBY0Q7kNvwErrpEm&_nc_oc=AdqCfb0oJmN67jciz7bKBtsICL1hryz2C77uNFFxNiS4itiTABB16jBqp3JC-5JZyMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrY78s4KP-gKfFm8UGSQ27EeS_DGSVh1hLV8jdGhxC6Q&oe=6AF88BF6"}, "display_name": "Paint Penthouse", "keywords": ["paint", "painting", "art", "sandbox", "creative"], "long_description": "Paint Penthouse gives you a glass-walled penthouse high above a sunset city, two long blank walls, and a table full of real painting tools.\n\nTHE TOOLS\nSpray guns and the spray can lay down soft clouds of colour when you pull the trigger. The airless sprayer covers a wall in seconds. Rollers put down solid, even coats, and brushes pick out the detail wherever they touch the wall.\n\nTHE COLOUR WHEEL\nPress X and a wheel of 44 colours opens in front of you. Point the laser, pull the trigger, and your tools are loaded with that colour. Or dip a roller in the paint can, the bucket or the tray, or touch a brush to a chip on the colour fan deck.\n\nTHE PENTHOUSE\nA floor-to-ceiling window looks out over a city of towers, with race pods, drones and a sky liner flying past. Walk through the sliding glass doors onto the balcony, relax in the lounge in front of the big TV, and change the sky from the remote by the glass: sunset, daylight, dawn, emerald or neon dusk.\n\nSTART AGAIN ANY TIME\nTap the red reset post with any tool and every wall is wiped clean.\n\nFEATURES\n- Spray guns, an airless sprayer, a spray can, rollers and brushes\n- A 44-colour wheel picked with a laser, plus a fan deck and dip pots\n- Two huge paintable walls in a penthouse above the city\n- A balcony with sliding glass doors and five skies to switch between\n- Background music with its own menu\n- Walk with the left stick, snap turn with the right", "short_description": "Paint the walls of a penthouse 300 metres above a sunset city. Grab a spray gun, an airless sprayer, a spray can, a roller or a brush from the paint table, open the colour wheel with X, and cover two huge walls in any colour you want - then step out onto the balcony and watch the flying traffic go past."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-paintpenthouse.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-paintpenthouse.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
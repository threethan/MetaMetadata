CcBzB-EuxChLQqyVcbETEYiTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Cr58Ib20ZjyFbhHM4Pn6159Cu8udQuyvGe_kRhruEg&oe=6A426C64"}, {"file_name": "Meta_Screenshot_Thronehall.png", "id": "1220738396435561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1220738399768894_6431150361118762524_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-wrJb5u2yoQ7kNvwH7BI5l&_nc_oc=AdrX6edHOzh4npIPnagJK_XvFiqbYrrQoMu5B_JtnXzjGazpjXk3bmjpr482pA87TD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dzPP9vbMH5cm1P7nTEzONGB69SqQLZ3mT2pWc_gxa0w&oe=6A426AD4"}, {"file_name": "Meta_Screenshot_Koch.png", "id": "1483936299832288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818943_1483936303165621_7007847590217145618_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdgjntPpeQcQ7kNvwGM3o1J&_nc_oc=AdpSa7szVJ67QtVttqIAXk3D8wg867BR5CzYk_y6YhCmP6ViFP9rxLqYDA23RDR4XTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_0mww2O8ZArn66BtAfsgmlt1xu_qlwaAFi0Gyb5r-RQ&oe=6A428E44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ludwig II \u2013 Virtual: Neuschwanstein", "keywords": ["History", "Education", "Castles", "Kings", "Airships"], "long_description": "Ludwig II \u2014 Virtual: Neuschwanstein is an interactive VR experience that brings you closer than ever to the world-famous Neuschwanstein Castle and the visionary king behind its crea-tion.\nExplore the castle freely\u2014from the outer grounds to selected, meticulously reconstructed interior spaces. In a vivid virtual environment, architecture and history are not presented as static information but as a space to be experienced firsthand.\nGo beyond historical facts and immerse yourself in the fascinating life of King Ludwig II of Bavaria, the legendary \u201cFairy Tale King.\u201d Discover his visions, dreams, and fascination with technology\u2014including visionary ideas from the intellectual and technical climate of his time, such as an unrealized airship concept that anticipated later Zeppelin flights by many years.\nA special highlight: for the first time, never-realized and unfinished areas are made digitally visible and accessible. They offer a glimpse of Neuschwanstein as it might have been.\nThe experience is a standalone virtual journey that can be explored at your own pace. It may also serve as a meaningful preparation for or follow-up to a real castle visit\u2014or be enjoyed independently from anywhere in the world.\nDidactically curated scenes, interactive information points, and a quiz turn history into an engaging learning experience.\n", "short_description": "Ludwig II \u2014 Virtual: Neuschwanstein is far more than a digital tour.\nYou experience an immersive VR journey centered on King Ludwig II of Bavaria and his famous castle, enriched with fascinating historical insights.\nExplore the castle grounds as well as selected areas\u2014some never realized or inaccessible today\u2014and gain a glimpse of Neuschwanstein as it might have been.\n"}, {"images": {"nodes": [{"file_name": "D_NWS_Portrait_Quest.png", "id": "26061999996766573", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308090_26062000003433239_4866885436894495053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SQF3Xd_DtMQ7kNvwEg2cGh&_nc_oc=AdorjTgaq0KlhVEgCK-KYe-gh_TsYzgfbBlqERJmRPUKiCVd2KdPG1xIoai0sjRJQGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fn9hnVolVc84Ah2G1ClVdwx96m78k2S65gpexmlVOPQ&oe=6A427FFE"}, {"file_name": "NWS_Steam_Bibliothekslogo_BDrop_1280x720.png", "id": "4408384066099848", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_4408384069433181_1365389682621205160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oCevC4cTOkQ7kNvwHTGEmX&_nc_oc=Adr77GaPQD06t9scIKDTkhlWJGnZkG4svvAjkLBzZL6_FWkNhxHN_FI3PleQv0ABq6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8piRpcLZpFRLtraAAh6KgYnGaFUdtJFpmunEH5OUeFuQ&oe=6A427785"}, {"file_name": "NWS_Icon2.png", "id": "2327165627779863", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_2327165631113196_5395896842584344700_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi1HKjuhghMQ7kNvwF0Tnx_&_nc_oc=AdoWuxEvdeMo5xRDa07mExek5GZSl2wyv5SyRl3Q6Fu_wVaOweIj4PE_RsN9yqiA5L8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OvXtDe9odp0kLHZ382z5oFn8UUCpJUqqVeJhAcdVwxQ&oe=6A426865"}, {"file_name": "D_NWS_Hero_Quest.png", "id": "1189592416530657", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303672_1189592419863990_3588532922376314105_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8fj-BpJAKsQ7kNvwEta-D-&_nc_oc=AdqlKH0xco99ci9oKd7tOhM1AXmkyjLr9_NaIsRQuopFzSQ6r6rrH-UMQv0BZOzgU8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pam86Jq6C5BHMcOHnDaD-JVOBYA2uBsc1WG10YUCk2Q&oe=6A428A71"}, {"file_name": "D_NWS_Landscape_Quest.png", "id": "764367526365874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_764367529699207_3269192048657223268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKhsx1pCrYQQ7kNvwEQKVMY&_nc_oc=AdqMjI_VllBZuM7geVhdAO-DgAfjHwChsfZni6ZN86SxEJNLmM8kzuc3z_dFCyHKIBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iRPFJvQo06Bvt51w1xno2xYdz2DTXF2cHg16fvej6FA&oe=6A426C35"}, {"file_name": "D_NWS_Square_Quest.png", "id": "753586720885513", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827987_753586724218846_7833108467434362709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjKYmkpUfr0Q7kNvwHAO5jm&_nc_oc=AdoSLOeckast68ZTtgbxwh0cgJU3xrD1Sb8WsS6S19_Xiq2ecCoBRBsa7-VHm-Y5PpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jBfH9XjwsKQDFvgBfd32IhPpL3Vky1EEiIpMKpSS5FQ&oe=6A426596"}]}, "id": "1623688545306114", "locale": "de_DE", "screenshots": [{"file_name": "D_NWS_SS_Aussen.png", "id": "5328150267319477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_5328150270652810_8368302322461584679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=982mSRFadToQ7kNvwGMAXyr&_nc_oc=AdosqvNxQNvrfBnLjkz3zDb2rw8_FdhtKutlFuVgn6mpB3gsr7rwqA9wzIVM3RV5udw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UJ3sopJhKvuGHXPXN_74uIm7Pf9oyadYvQEEcE3BaDg&oe=6A427D6E"}, {"file_name": "D_NWS_SS_Prolog_NWS_History.png", "id": "1282566670384885", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821682_1282566673718218_313205984841298439_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub4LR0oCkl8Q7kNvwEAVP4X&_nc_oc=AdpRTvt4-U_uHDvku82zdTLB_WUBaZz6k_2Gx3eUAe-i4SZM7-s7J5DsB7QVTLv87IM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gXT_5tLBQSyq6aK_9PaD-sgQjRJ_SpsE-b8mtE67zTA&oe=6A4271CB"}, {"file_name": "D_NWS_SS_Torbauwohnung.png", "id": "2345494512580744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_2345494522580743_7037003563555491367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69ECOg41GMgQ7kNvwERcROM&_nc_oc=AdrWJtlG_oXF6oBzpaITA43h8x72rEhrQ7dMp_YadUlTs2BVHsoJcV9D2QWLoe96To4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af869M3mTmSbUy12A56kHzsiSj0tDHNaDyxnQT0JVh74eQ&oe=6A426133"}, {"file_name": "D_NWS_SS_Thronsaal.png", "id": "792965677179158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_792965683845824_8007895417359859081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnPOtuMY-6gQ7kNvwGqrFHs&_nc_oc=AdpJCpH4gQfK-oUwqWcSFCVd3l_fh1TlBGRMvHSGSE2tcrL30xAXOZszdREHz5e6dyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hlYAq_-LOc2-NG3ZPIeQ519YIBoBM3CZCn9y7b7IJ5Q&oe=6A429304"}, {"file_name": "D_NWS_SS_Prolog_Koch.png", "id": "1876222703017408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_1876222706350741_8867395935702735695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfSAROXH0BwQ7kNvwG8GXeB&_nc_oc=AdoRVBm12ygL32nrCY2HK1cARXWxM4b5F24YtOSEYwq1OewUdSv8k4HIMDrJrdA3olU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z6-ZeinZXB7nMeyCCs6PZvzCEy8ci_icOo46xomntMA&oe=6A426D00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ludwig II. \u2013 Virtuall: Neuschwanstein", "keywords": ["Geschichte", "Bildung", "Burgen", "K\u00f6nige", "Luftschiffe"], "long_description": "Ludwig II. \u2013 Virtuell: Neuschwanstein ist ein interaktives VR-Erlebnis, das dich dem weltber\u00fchmten Schloss Neuschwanstein und dem vision\u00e4ren K\u00f6nig hinter diesem Bauwerk n\u00e4herbringt als je zuvor.\nErkunde das Schloss frei \u2013 von den Au\u00dfenanlagen bis hin zu ausgew\u00e4hlten, detailreich rekonstruierten Innenr\u00e4umen. In einer lebendigen virtuellen Umgebung werden Architektur und Geschichte nicht als statische Informationen vermittelt, sondern als unmittelbar erfahrbarer Raum.\n\nGehe \u00fcber historische Fakten hinaus und tauche ein in das faszinierende Leben von Ludwig II. von Bayern, dem legend\u00e4ren \u201eM\u00e4rchenk\u00f6nig\u201c. Entdecke seine Visionen, Tr\u00e4ume und seine Begeisterung f\u00fcr Technik \u2013 darunter auch vision\u00e4re Ideen aus dem technischen und geistigen Umfeld seiner Zeit, etwa ein nie realisiertes Luftschiffkonzept, das den sp\u00e4teren Zeppelin-Fl\u00fcgen um Jahre vorausging.\nEin besonderes Highlight: Erstmals werden auch nie realisierte und unvollendete Bereiche digital sichtbar und zug\u00e4nglich gemacht. Sie er\u00f6ffnen dir einen Blick auf Neuschwanstein, wie es h\u00e4tte sein k\u00f6nnen.\nDie Experience ist ein eigenst\u00e4ndiges virtuelles Erlebnis und l\u00e4sst sich ohne Zeitdruck erkunden. Optional kann sie dir als sinnvolle Vorbereitung oder Nachbereitung eines realen Schlossbesuchs dienen \u2013 oder unabh\u00e4ngig davon von \u00fcberall auf der Welt erlebt werden.\nDidaktisch aufbereitete Szenen, interaktive Informationspunkte und ein Quiz machen Geschichte zu einem spannenden Wissenserlebnis.", "short_description": "Ludwig II. \u2013 Virtuell: Neuschwanstein ist weit mehr als ein digitaler Rundgang.\nDu erlebst ein immersives VR-Erlebnis rund um K\u00f6nig Ludwig II. von Bayern und sein ber\u00fchmtes Schloss \u2013 mit spannenden historischen Hintergr\u00fcnden.\nErkunde die Au\u00dfenanlagen sowie ausgew\u00e4hlte, teils nie realisierte oder heute nicht zug\u00e4ngliche Bereiche und er\u00f6ffne dir einen Blick auf Neuschwanstein, wie es h\u00e4tte sein k\u00f6nnen.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr-dynamix.com/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "VR-Dynamix", "support_website_url": null, "website_url": "http://vr-dynamix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35076141791973129"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "938413605800870"}]}, "baseline_offer": {"id": "938413605800870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774374600, "status": "PUBLISHED", "id": "938413605800870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}
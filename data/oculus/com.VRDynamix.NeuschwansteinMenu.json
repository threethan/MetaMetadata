7&_nc_sid=6e7a0a&_nc_ohc=TAhceTjvU1MQ7kNvwGgOvW9&_nc_oc=AdqmOcnoc6XK7tzjMVsL0mHz1Hko_lBIJxZsycBF1YXmCdlTx-4ryIKf0jXzYj9M2Ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VI8RTITJLyWolCAHLKlXBcGNrDGy1DQLFwgxOAxW4og&oe=6A4287F1"}, {"file_name": "GateHouse_Apartment.png", "id": "1257632163168909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830003_1257632166502242_7521835977477591996_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quo9aShnOrwQ7kNvwHyn33s&_nc_oc=AdrONq147osldBfArRK3VI9XWJCY0oXGeT9iJXUQIlOWtgmL4R3l7G141ijesd9j0k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MG2VKuTi-p_WH2DE9Yndd5td15qgxFx5MtrjMn9W5kg&oe=6A427C97"}, {"file_name": "Koch_Prologue.png", "id": "2665780873798115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825034_2665780877131448_2610840041481182206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Eijw7BRdScQ7kNvwFWLJuB&_nc_oc=Adq_Y94ieAyiZhnHmhfLSXgKP4L_inKM98eJgdyRyLGcHYYJxhbooH7N6dLo5v-XWaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TDxgqypHhElGJ9ZpUaWKSUvQQEzuYsGQckXodQgD3BA&oe=6A4285C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "D_NWS_Landscape_Quest.png", "id": "939566938622361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_939566941955694_6976613219349353598_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEb2SGVfBBwQ7kNvwFNJ3tz&_nc_oc=AdpSFb5w-GFJfbtPccohZwtaWsjarXq_kvhintn3V0-gXXc7XzmtcvaHOSzcHYn9hIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NFScysWAbHEMDnt4R-3vBdsbjnnW_-t_PgNtnSddHng&oe=6A42683D"}, "display_name": "Ludwig II. \u2013 Virtual: Neuschwanstein", "keywords": ["Geschichte", "Bildung", "Burgen", "K\u00f6nige", "Luftschiffe"], "long_description": "Ludwig II. \u2013 Virtuell: Neuschwanstein ist ein interaktives VR-Erlebnis, das dich dem weltber\u00fchmten Schloss Neuschwanstein und dem vision\u00e4ren K\u00f6nig hinter diesem Bauwerk n\u00e4herbringt als je zuvor.\nErkunde das Schloss frei \u2013 von den Au\u00dfenanlagen bis hin zu ausgew\u00e4hlten, detailreich rekonstruierten Innenr\u00e4umen. In einer lebendigen virtuellen Umgebung werden Architektur und Geschichte nicht als statische Informationen vermittelt, sondern als unmittelbar erfahrbarer Raum.\n\nGehe \u00fcber historische Fakten hinaus und tauche ein in das faszinierende Leben von Ludwig II. von Bayern, dem legend\u00e4ren \u201eM\u00e4rchenk\u00f6nig\u201c. Entdecke seine Visionen, Tr\u00e4ume und seine Begeisterung f\u00fcr Technik \u2013 darunter auch vision\u00e4re Ideen aus dem technischen und geistigen Umfeld seiner Zeit, etwa ein nie realisiertes Luftschiffkonzept, das den sp\u00e4teren Zeppelin-Fl\u00fcgen um Jahre vorausging.\nEin besonderes Highlight: Erstmals werden auch nie realisierte und unvollendete Bereiche digital sichtbar und zug\u00e4nglich gemacht. Sie er\u00f6ffnen dir einen Blick auf Neuschwanstein, wie es h\u00e4tte sein k\u00f6nnen.\nDie Experience ist ein eigenst\u00e4ndiges virtuelles Erlebnis und l\u00e4sst sich ohne Zeitdruck erkunden. Optional kann sie dir als sinnvolle Vorbereitung oder Nachbereitung eines realen Schlossbesuchs dienen \u2013 oder unabh\u00e4ngig davon von \u00fcberall auf der Welt erlebt werden.\nDidaktisch aufbereitete Szenen, interaktive Informationspunkte und ein Quiz machen Geschichte zu einem spannenden Wissenserlebnis.", "short_description": "Ludwig II. \u2013 Virtuell: Neuschwanstein ist weit mehr als ein digitaler Rundgang.\nDu erlebst ein immersives VR-Erlebnis rund um K\u00f6nig Ludwig II. von Bayern und sein ber\u00fchmtes Schloss \u2013 mit spannenden historischen Hintergr\u00fcnden.\nErkunde die Au\u00dfenanlagen sowie ausgew\u00e4hlte, teils nie realisierte oder heute nicht zug\u00e4ngliche Bereiche und er\u00f6ffne dir einen Blick auf Neuschwanstein, wie es h\u00e4tte sein k\u00f6nnen.\n"}, {"images": {"nodes": [{"file_name": "NWS_Landscape_Quest.png", "id": "2379230982523948", 
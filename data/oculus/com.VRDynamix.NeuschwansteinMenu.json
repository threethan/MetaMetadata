ctZFMgsQ7kNvwE5I0iZ&_nc_oc=Adq0VHU9H285un3BFdE5l-AdfKwkOHzzC6D8jWtPYd3Sbqc4gD0WPpjSIZTgHVE1KoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aWMTqXd4bwmAJRA5GYun7RG3-3MjMnIjYI1YqElTvNA&oe=6A427ED4"}, {"file_name": "GateHouse_Apartment.png", "id": "1963208467967025", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_1963208471300358_6000798160407599962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBCOHTddMgwQ7kNvwF1-fQu&_nc_oc=AdpSKpjYxmlIhqlC_EeDdrO3DQKkhvk5oFPgnBm0IHRLw2nRjRR1HQHgvbtq_qBPNMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ax6WOG4kz3gEI2KlOOEIc0Ft2ZKcOJUZtn1crENFjQw&oe=6A4266A8"}, {"file_name": "Koch_Prologue.png", "id": "913899164738929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820387_913899171405595_5458696101635261927_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeAVIITcjY0Q7kNvwHR-EjH&_nc_oc=AdoszVHHBPReaAi3YAzcit-EqAac_RMVXIyz_s9Jp1cELSnvUPJrMi7Uj12j6sR4pUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uv6daqar7KzpBhnZZhpVEIm8ufdpPYuQZOknh-1kgvw&oe=6A428D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NWS_Landscape_Quest.png", "id": "2506423976440677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_2506423979774010_4681553476348777314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMMSqVPiu1sQ7kNvwHGPhnB&_nc_oc=AdoYSiDo0lB492Or7C5tlbbX0BmncQRDpOnrx7zFQCEQnOspv1WIzaahIz_mgXFhhws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-baim1Re7NjHFJJqnC24R32mSLiG7OMhvgqmHPIexftg&oe=6A427055"}, "display_name": "Ludwig II \u2013 Virtual: Neuschwanstein", "keywords": ["History", "Education", "Castles", "Kings", "Airships"], "long_description": "Ludwig II \u2014 Virtual: Neuschwanstein is an interactive VR experience that brings you closer than ever to the world-famous Neuschwanstein Castle and the visionary king behind its creation.\nExplore the castle freely\u2014from the outer grounds to selected, meticulously reconstructed interior spaces. In a vivid virtual environment, architecture and history are not presented as static information but as a space to be experienced firsthand.\nGo beyond historical facts and immerse yourself in the fascinating life of King Ludwig II of Bavaria, the legendary \u201cFairy Tale King.\u201d Discover his visions, dreams, and fascination with technology\u2014including visionary ideas from the intellectual and technical climate of his time, such as an unrealized airship concept that anticipated later Zeppelin flights by many years.\nA special highlight: for the first time, never-realized and unfinished areas are made digitally visible and accessible. They offer a glimpse of Neuschwanstein as it might have been.\nThe experience is a standalone virtual journey that can be explored at your own pace. It may also serve as a meaningful preparation for or follow-up to a real castle visit\u2014or be enjoyed independently from anywhere in the world.\nDidactically curated scenes, interactive information points, and a quiz turn history into an engaging learning experience.\n", "short_description": "Ludwig II \u2014 Virtual: Neuschwanstein is far more than a digital tour.\nYou experience an immersive VR journey centered on King Ludwig II of Bavaria and his famous castle, enriched with fascinating historical insights.\nExplore the castle grounds as well as selected areas\u2014some never realized or inaccessible today\u2014and gain a glimpse of Neuschwanstein as it might have been.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr-dynamix.com/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "VR-Dynamix", "support_website_url": null, "website_url": "http://vr-dynamix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"
uNBTaE62RwlNfdrLhOwZ0nhARDaXLscUSyZqvmO_1tg&oe=6AFC6EED"}, {"file_name": "Screenshot_017_0000.png", "id": "1500150608539924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_1500150611873257_4349446639345876106_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9dnNKEzel4Q7kNvwGUicua&_nc_oc=AdpVPLeCy1F7L25W7LFYGxV1y7QvrID9sfD0HBAC0ump4p1BBuVHT_rYQRvYttGP09k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4OIGja1oxx3wlBwNuEVQN7KgaRfR3I1PiPTIyKbFJJA&oe=6AFC83DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2.png", "id": "1175841074765964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593761155_1175841081432630_8196053371496330457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUDtOq88TOgQ7kNvwFJPPYp&_nc_oc=AdrW-6pvGhr_J4kR4J-dMw_KAUItYFnxCEhhG0sSeB9H9PX0o7vEKJ_YeUG5GZNtWT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsZelZtyuIlpzi2jYxzre6WeEJHiMupiP6_f2EAq3l6w&oe=6AFC648D"}, "display_name": "Duel Me Bro", "keywords": ["duel", "shooter", "combat", "multiplayer", "social"], "long_description": "Duel Me Bro is a multiplayer dueling game built around fast, ridiculous 1v1 and 2v2 battles with meticulously crafted weapon mechanics.\n\nStep into the dueling ring and battle your buddies across a collection of competitive duels and mini-games.\n\n# Real Weapons, Real Reloads\nLoad a flintlock by hand, spin the cylinder on a revolver, or skip the guns entirely and go in with a blade.  Every class plays completely differently; precision one shot kills, high volume gunslinging, or fast agile melee.\n\n\n# Duels and Minigames\nTest your aim in the shooting gallery, race the clock reloading, deflect bullets with your sword, or push your luck in a game of Revolver Roulette.\n\n\n# Go Bananas\nUnlock weapon skins, hats, and getups as ridiculous as the duels themselves.\n\nGain experience to upgrade your loadout with an assortment of perks that increase your lethality and customize your play style.\n\n\nWhether you're trying to prove who has the fastest draw, the best aim, or just the dumbest luck, Duel Me Bro is all about creating those hilarious, chaotic moments with your crew.\n\n**Grab a buddy, choose your weapons, and settle it the old fashioned way.**", "short_description": "Duel Me Bro is a multiplayer dueling game built around fast, ridiculous 1v1 and 2v2 battles with meticulously crafted weapon mechanics.\n\nStep into the dueling ring and battle your buddies across a collection of competitive duels and mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://noeticrealms.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noetic Realms", "support_website_url": null, "website_url": "https://noeticrealms.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28191291290549586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624656_28421667650861886_3809594479622355656_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLJHXkwOkdAQ7kNvwFO1G-L&_nc_oc=AdpSL9NzJM8luGk0jnVLWy6QehEmo
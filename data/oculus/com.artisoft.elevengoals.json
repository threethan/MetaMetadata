_sid=6e7a0a&_nc_ohc=M_dvXBE6qWoQ7kNvwG2agt7&_nc_oc=AdrSKpyULn1xqPeNn6aI5yQm6RDEQRVBQJqbMAsuMA3HruQF333Q-8uzAN0Nqwk5oFI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MueH6C8Zwg4Xh4cf5Avv6DXxO5E4W0fQYfiQJ5k8iNw&oe=6A1B06F9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_1haE60EcYQ7kNvwHhVvmL&_nc_oc=AdrZRQ8-hXfARcD2BGkVSJZHvYXdGcOEe9iLyX_DW1cpm6x79Qixagx6e7G71JzRChY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VrFkLvNSp0RxbEUCAmKiulb0eIq67FLDnh5SrcXrJSQ&oe=6A1AF68B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2Rgtdus7ZgQ7kNvwESqpdm&_nc_oc=AdpH2J35H45BV1lqxjzKnhelVjrTAyY1Qj2U5jEcWTkXgCkOrvFMVT9Efgvt3C43HBg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nfoukDQw6yvKLaUJS8PpDeJmEo9IyoU_nc9Cvk8igTw&oe=6A1B0BC2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN2GDm_xNtEQ7kNvwG_49O1&_nc_oc=AdpEXGANk15rZAA4WWjXY2_eRmcRqQAjhyQt_Y9TzgGLcsH3rh5ViVZFGhMQGMxOTRo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YGg9bkDkmU6NY5I572ZlLN57purucgtjFvNre_EKc3Q&oe=6A1ADD4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BQqPU03uiIQ7kNvwH4h2lp&_nc_oc=AdoUcvzUOXAy1k6cuzhy-Ox0-plowaZZ__Ld0XiSsE1mdSLjV41seQvtv4jdxqiVyFc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PgJaDZqaATBHk1A8VVJMQkOesThoGU89DSpklL8yYlg&oe=6A1AF177"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
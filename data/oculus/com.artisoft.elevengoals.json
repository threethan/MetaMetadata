e": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsvtnCzLR_8Q7kNvwGxv0cG&_nc_oc=AdnxyhNzA79bsqXIRVZiQUv8mBVuKgtpO-CYarAtl54xxn9fmh9diw3q0bR8wZ4flj8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvrreGAnIfRcZwphFUM1E8FcUsJsl2khcdL_IEX_Pogtg&oe=699C668B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_52fvZf6j_kQ7kNvwH5EKxq&_nc_oc=AdnNKVaFAPOerBQMytnVXxphc9Gzl6mZw-83LMhPvlImKC7_3XC7244pwR1TVTTf7rQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftlrHuvw9HuBuB8Q8_X6_tMUYNOPcN8ZMdzwS_ycm7YDA&oe=699C4382"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK89bYqxYIkQ7kNvwFRpV0H&_nc_oc=AdnJLDcmzVOYT5x8tSj_z1aBXeaiHr59AKOIH3YY5EjnpxuWYYjK20QGi_TGfwuIdnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsPV_v_eTww-37QUdp2dT7xoEee4dyaILkZfYB5ppviFQ&oe=699C4D4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDohZyLo4isQ7kNvwGdU08H&_nc_oc=Adk-M5PaH1JrRw5Ygp0UkHTFJHiOjh6m4aDsHjwqpmFis4ul5OCvWe6Tw-PCHoAqyVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu1JfDHpJj-JNeeKk-6aablWEBs2zerVFJHEqLFSYP7Ow&oe=699C6177"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
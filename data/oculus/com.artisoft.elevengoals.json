sid=6e7a0a&_nc_ohc=xyP2_JET0bAQ7kNvwGJ-bPC&_nc_oc=AdoI4Hw3CnxFS3xEgy3IdA2124G7fjjgtrNlqs47CxH2PjBcIU4wOB8IzZaERzuMbvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnhJolv5wuIFTgzhUDVpkpBCNSGymk5Li1QcStDxz-3Q&oe=6A4BCE79"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QnJWhZHkIMQ7kNvwE7huV6&_nc_oc=AdrAo64kgakNkPSqjMQ2h6-d-F9xSw9Tfv0vlQ7XY7ANBi-yOwcsNJbldMKCZKDLrZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAalbWxJHx9tIsMM1o10jwuOTt5veoDQ9DyZQVVAM9mkA&oe=6A4BBE0B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aubJIbRhSx8Q7kNvwHZmvKd&_nc_oc=AdpLTHtZRsV-Fh-Pi83No9mxBg_7nIsOVeDrGPTRO821KBz4shAcOJfAzgvZ0DBWOLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7WxIDrAPajGoLYifb83tuLQS0INJeHOeWS8VKyxZOtA&oe=6A4B9B02"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJH53uMUFFoQ7kNvwFmRZ4B&_nc_oc=Adr5ZMJDTiCgRRgMtEzi1KPaWXJC0rBMw4sCFtTX6yuO_-SZH_x-cJdAB4q0enO6-Mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARtGWYcJ_-ERmQY0xHs7X49OPxtMpVSbwjqPMtxLeblg&oe=6A4BA4CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLU7sbjurp4Q7kNvwE27WI-&_nc_oc=Adox5SF_y6-qXfdCCzZbgfyb-tj2o0XV47AufXJulpiv56NC95gi_q0JUcDMmW7uwcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnMbOs-tMnVFlMgOa0e643uIVxKzwoYKMP47aRuVdi0g&oe=6A4BB8F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": []
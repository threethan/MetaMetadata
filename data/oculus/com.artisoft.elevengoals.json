_sid=6e7a0a&_nc_ohc=IfdQhRRePy8Q7kNvwEFkABE&_nc_oc=AdroZI9oLYrEzGUumsf9Nj4xn5YotcW38JLU2-BVkA1jvfduDsSUDqRZsXGMo4FhD2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9vr32uwhGetpnCpLRuoHezvUaW0wmscZC-7CzGnHKEg&oe=69C66EB9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWKubiisZW0Q7kNvwG1aXSI&_nc_oc=Adq0gQjGtFlssIkuEubJ83VVz2VOqRECsLTShf_B4tVs6W172Tm7DpEz2SKMbISnjbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwawMViT34_r-NWRpwHqyq-M-_izmaZt3QbDWLeGBqAxg&oe=69C6968B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0fkYULbruoQ7kNvwG2iFGC&_nc_oc=AdqNrmFV5h0D0BHrlR-Tkhtzwhevn-Tn2at33sMdn-Zg4h_EcgQtHYJu31A4sonXMIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2BJTTZlaafO-ZrHqfrVlS2aXDovix8Ytzx8YsBxRI_w&oe=69C67382"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue0XAWf7e_UQ7kNvwGwY3Gd&_nc_oc=AdpS9Ym0WqFmZeIV-aq38Dz9nggKMsIEOiGq2oLAVjZX4VurxtgDApOzHtXyZYOEX3Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYFWATyIFcc3nPIj40mdSFHJooVU5YPTNMmUkJm30U1A&oe=69C67D4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUmriQ5i2sUQ7kNvwGXkwDr&_nc_oc=AdqNmVVztz8F808v8Bue-jng4QIA9bJa1k5O6RUqPrl5MiLFDbhCNbJx_i_fyV_YSfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBdRRMGOfU-X1scu9zHUm94h-nnI9qvVUzTm_ulk5awQ&oe=69C69177"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
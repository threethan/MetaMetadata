_sid=6e7a0a&_nc_ohc=jSbv6TIBMV0Q7kNvwHtOqp1&_nc_oc=Adp6qzcFHqnK8Iud2RxJSs8Nwot69BhL3MRjLGSaEfN5BIO0W-9f_AxDN8JoKR59Npk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82NWnhY5ujAh8xxyFTV0nziMIaLeJtiKCDnFxqwG7lqQ&oe=6A219E79"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6pMMo78KHMQ7kNvwEfAGSS&_nc_oc=Adps9Wa6vF_foRVdslqcc85OJtP3UzPD5rjOJGSRT5Zh-icwdHFaSsqt3IAJAnZPlPA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dsft6X9rXugswo5AGlb6yah-Cd2XnmXeqX_9ZTIX2EQ&oe=6A218E0B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kjcto20Yh0Q7kNvwHaUlaK&_nc_oc=AdoqLzI3VPtbz0bHVEPQ8Kq7WpAt502Xnk4Qy6YdapmCk7Hh2t2-_uYensYscfjG13c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NQ4HYNOpr2FKjSzog5Hq9zXpw_6PTAqSxoJ28Lznphw&oe=6A21A342"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42srgPEtSQ0Q7kNvwEJFFhs&_nc_oc=AdrGFOFrZ50yO0n2yeB5rIee7PD4OLI1iEL37NHdCU7wpGf-RG87bXhu9VtZGM1l7i8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p7cXgZ07ZufXiY3Esdvuv5DeEJ5qYlou3251XrwO2DA&oe=6A2174CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ--gYPBoisQ7kNvwHR2BUV&_nc_oc=AdpaRwM3eN0XkHrzXKbX1mMYURYda9QUeBaQLsQhbeKGZY8hnLpJEGnoWRDDIOsq2GI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U5Gfqb2RMw3ZB-BRc3PEnTp6_5aw-Vzq0aOsXzGirrA&oe=6A2188F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
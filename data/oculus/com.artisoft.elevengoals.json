e": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Zxu5yBoQcQ7kNvwE8eTfY&_nc_oc=Adm0UaSxGD8OzyuI5MGQu4x4TtOHXVWy67PmwKjoc2v6WCX2Dr53kITWgxsAyDHOuc8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv2H-CUpsmOcSwnS5XGhbxj8lM177jsAPsfyZ1mNLxoyA&oe=69A5A10B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDSvYUMZ-KsQ7kNvwEW2V29&_nc_oc=Adkslb-QBI6BGJrCPTkGqyJeRABfHOKo2KSKKOuz8DEZDFAygiwlVJ8c6yel4-44C7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvNApqHraAtJuzA7Wb0m2L-2Ud3NkxowFsUtkciLcCLQw&oe=69A57E02"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tLIE8AwDoAQ7kNvwFKTNC_&_nc_oc=AdlxVnriy2odFdph5QGbBdGAZhumKbuIxARlnhXoZdWPUCtLruQu1P5dom0LEsXV_nc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu59h2zp6tYXkgX6TOgazdZvyicMJsS14QPz3M6JMrETg&oe=69A587CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMhLfe8x-qkQ7kNvwEbCf0q&_nc_oc=AdmirsrLKDPMpy9R2dPhXh7q4M-wnhe5SBOUhA9MKF6Wx85_Bz3uUvH7GEn_n9ao1iE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvSQ8DVK5mU3obXrlest7nhaGXIJR5b_VYeEbVfvavFAw&oe=69A59BF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
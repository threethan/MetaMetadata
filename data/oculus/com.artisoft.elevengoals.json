_sid=6e7a0a&_nc_ohc=iebUue3PXvMQ7kNvwFg1jN8&_nc_oc=AdpergzHt1G0GRIb9IFdqV99XzJ1hoCnqBtPsYJB3lE0RUeVbpWwInwWi1ewSv-s_ok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGILJqKdNX7LfiVDiaCAD-1fX8pGE2FGKa1cfL5xWJE5A&oe=6A708039"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVvCKbNzyO4Q7kNvwGHx38S&_nc_oc=Adoi_D7wzkQ3t-PEDhdM2P0mROdmZ_9cFF0_80Y9DUM3iU7kOQfuey_YvrnhvW-JN0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjdFRMsoDdJ55vhrcjXTB0mT86ldwm4AjP8Ga-6sXylw&oe=6A70A80B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-YSRbE89U4Q7kNvwFRgUVa&_nc_oc=Adp5F2fsqC34e6Sq9ntXTwJaQdhbr8TzK5Fgw2x6LdAq8J6pLGtsuswidJj2RfjWOF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjVMuQCHxQokx3E4S0rZEtvnOMNZMJ1zitObhltZkygA&oe=6A708502"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqTO3ICuMZYQ7kNvwHAZdKF&_nc_oc=Adrv-UHtienArZ-UTLDYzyOWjqzO6JR25oUNGnfBu7jr9lygMIQJ8hoYLye1Oeue23Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFolgftzjdaiyPbjjvbetXyLfyPTLbC7OnA2WoQ3tOyYw&oe=6A708ECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLc1_9RuDvgQ7kNvwFBCUk-&_nc_oc=AdqB8RhPTtWmeJTnqvr1PNqyhBz8vQ451lcEmRiAHK_dK6_J0DJhr76ZGGVI1cXnzBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfgArG1xKQ11EJFwwSaJozJjkYoFkAdvePSBp8v1s7fA&oe=6A70A2F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=RSTLatjunRAQ7kNvwGbz9Fz&_nc_oc=AdrDdTlNCJMDP9ADtYLPReC18W5e-EooN5x-7_lSTBbFdyTSx26cCbEvRR_9Nic7E4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57Lmo6u3fi7fGDOkLfMVswECRWsAEihprP7JexVIYROw&oe=69FF1F39"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QypGeROkV1kQ7kNvwEknw5r&_nc_oc=AdqT41fkxkQLabNAdkzCYxBXwQRMzLNle1-H4M44_C4TknnAS8_YQJuDZ6Z-BlHHV1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t0PxcjRxR0hqOyMwUmJtg5YDzrJ-EpR1dMzHMnuUE3Q&oe=69FF470B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy03c8b2tSwQ7kNvwE_xfA3&_nc_oc=AdoCd6DF78NOIxHJvWNjBuybFvbiggcdCZiTmF-JzWpH3DZwUMf9GMUOQTDBkpuGYeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mLDUSpI5qXiuOugL4LEqO10xIucfugP4tQPfQcNLiNQ&oe=69FF2402"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dcpj_IA6gYAQ7kNvwEOa0Zx&_nc_oc=AdqdBezahzKPUJTzXq5KNIu2dez2-AThC94T0ootvTw6pbq_JoJNki-l86MnYChAhac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kykfJnV1bRzE6M7SwHus-JW7Kfqgc2XicZS6tYbLJGw&oe=69FF2DCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b5rEHEIX3IQ7kNvwEqEtWp&_nc_oc=Ado-KHBLno66r2JyYDaErR4haQKjxqqentYLbmau86wPR4ap5Ohq0HbFx_Uyy9G6rt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RsbEEMPewgNTTt0jh06fhjP_PJnnmvaCdGek5jF0j7g&oe=69FF41F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=YD01k9jVnlYQ7kNvwHrCRlm&_nc_oc=AdpOt0YFIA9PMdEjLLhtp45XgA9tLfMhPjYr1Dkb674peLEElIOutsah6g8rCw8XR8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zZ1oNn-VbDvXjyfdA40rn4ISpsMc6vc9DXirnmNFeSA&oe=69D24C39"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEJ6V6RhdgkQ7kNvwFSUeMd&_nc_oc=AdqxRc1rbwPM5jwmasuDXERkEpO5VCSr2ZWLtR9Uod0z-PLbLfQ-JOX0tBhoSXRIcr4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fSvFeA6iQz-0VN7Tus-Yy5t5CMOtVzavkewIPWeGMRw&oe=69D2740B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qICOeUAjqLsQ7kNvwGWv4MW&_nc_oc=Adp4TLyKGg7WA9e1kvvLBhqxaY-ISv9JiV3ucbcntl52uIqR_DEqjT7qdiFkxY7sWtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R1W86oWAwv48K24bIhvIz-PISFeGWMl9wENBclHS_ig&oe=69D25102"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSxcwqhieogQ7kNvwEiOREs&_nc_oc=AdoQaUTecTY_vP2A03T-Ji238RpNXw4Q_7jgUGslFe40cPl_XRKnLxJhYuKFpBLROyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h-rMxnSrOjaL3PeMpM6hy1fsMBeWagDlGku3epd8Oyg&oe=69D25ACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K678WafPc_4Q7kNvwGOydQi&_nc_oc=AdqrPs5LhtVHJm8KDW7bOgaO1psVSo44UyULOeoP6Cah84bEqioWJnvy8CnNkSg5J74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fyZPyzR0gVtawpTQiDpiVvd0h9GlllDCYbBkB8wJjQg&oe=69D26EF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=BzWP6OqqfmIQ7kNvwGEwYIC&_nc_oc=Ado_nqbScTE4wTZZy8nObmmLCNLB-b8bm211LHk8xxMOerZRjZux-GtB1dyjqHtse1A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Sk3Pbfb_u6hYab_x41OorvKlGac1XmFSqIZzj18kP7A&oe=69EF4D39"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nak8Q94BY4Q7kNvwF91Zc9&_nc_oc=Ado3pNWFq-ost05N8SMygX_bozFZDpoaHF9t7eSw7--Rv-melP5_RMtSN3_n22qY7sU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lORDANpj0WFWPX2cz3X6X7jWDJRbkQ6MU9IrMFNTg3A&oe=69EF750B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwR5cc7GtF8Q7kNvwGHVh2Y&_nc_oc=AdpMKAFZhvWOUTiHqcRq_UHOcehOF6_OSJ5FXhItKopANWmadBM6cj16VW_pTB8cnHk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yTaf-QKrNw7NXpNUJDeFCkrIryQESJO3_HdZimYjE3w&oe=69EF5202"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jckOjHC4yxkQ7kNvwFwBcQj&_nc_oc=AdrOWZCz87ffeRwnlPdeOHInvJud2XW2Xeumikz-RxyuEm4iu0AO_V5I5mvKeuSrmCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EoABZSRO95M7HQatEh3kJEV6_eE3AgfwbAl6RvFLF8A&oe=69EF5BCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2qiY84HBE0Q7kNvwHk_Ems&_nc_oc=AdowhICluOuWKxNi_Y5apKAYPM2oFosGqOrRjPrWZXZyI2qLHj6_jQXDA7LmYi6x3Uo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qJHg1uHtFQDV9TPtaiZGzEM63fbwm_qCvstBARwH-bw&oe=69EF6FF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
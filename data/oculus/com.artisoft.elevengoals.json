_sid=6e7a0a&_nc_ohc=Eq0dgt9-O1YQ7kNvwGPhOe5&_nc_oc=Adpx3tad9IvCzXLgIEyMpQvTfDz7nvt8O0UJQF5b-fwiklICuVFTvx94Q_lNWYdg_cE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LrII770wMGanAUecfAi2-z-JrBfLp07oepPfdRC7A6w&oe=6A1C5879"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=695naJG31yQQ7kNvwFlWVRX&_nc_oc=Adp117dj3DXztB7mGyG5lwYnPLl8jN5xOoWLH6yYqYcBcVgNJ-u4qCyWyYmzi57S1hU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KXuJzyEfGYtMT-0ADpqw2zy5ZRan7ujlFxKuUGXxqEg&oe=6A1C480B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0zbHbjXBBkQ7kNvwE8FpA2&_nc_oc=AdpCtQmO_69yHL-DZUBEv0w8T1_JkkO5NiHEj6uE2frQf8w48T3-AJPG-A1WdA3lS8U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ByVeamH2fETZ293t--kl7zAAUghY_dHQnBqkGapt8uQ&oe=6A1C5D42"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsYq7xRtYMYQ7kNvwFmYBM5&_nc_oc=AdqTjezJO6Dy1x9ByyQUQRhFNRpNO88sLtQCLM_cRAH1pUv-vYheDS0Rm42eZPHjm2Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KzQenK5Wc4CAwuzWRMBF3ezcGp3C9hZL3MyNsI7IJcw&oe=6A1C2ECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BQqPU03uiIQ7kNvwFauPZ4&_nc_oc=AdqA0zCceZWSv8oolwBtAVuiqb5L5ia-93ugNwPro2qBzP9AHQGYhV6HasLEEcu9ABc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68aV9QuQNsCFwitte-NGgiwZWLybZnp9YGKiSBB6CR0A&oe=6A1C42F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
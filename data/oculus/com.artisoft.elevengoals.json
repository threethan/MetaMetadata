_sid=6e7a0a&_nc_ohc=mDul9NI6lacQ7kNvwHhNW0s&_nc_oc=AdqSKx4S1_WXRtKfR6vnlPUg0lYCtl7sOdD5u4cEIFvRERP-e0OghAcGdokB4V2RPYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c2foCHcygsFYKNB-j0etJXGWxawM0qOOyMf0kRThTdw&oe=69E36FB9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDPOom9OAPcQ7kNvwGoi0Zz&_nc_oc=Adq-MiN7iHw4odkL5OgSEngW5MgtmOZX2wpBlVrkh1WcMEf56yYK3Kt_BvgiEInBFio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pMTdv5GWIkqv6CWnAxLLo7Poij6HnFPTNIEy153kqRg&oe=69E3978B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ef8DGcoKXEQ7kNvwFK6e5y&_nc_oc=AdqRa4d428bCV4VddDHwYBAvUHIuZkDWwfIXpTZBXGUt7r7-96IzV6dYTdN_UchaUBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HTwVOfEBMXILiJ0wWBkadJuZlksoEzQYWNhft3SSUCg&oe=69E37482"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1MJouI497UQ7kNvwEqd1Pr&_nc_oc=AdonbBzrxgXjKlLQCEM47QCS_CfNnxKHgVOt5QPxDT7f_DEBL1DSZKxNHvx5wJJBwGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tMaS7HONBOjv1amdyZMagdPgcl4wP5iVpUE-ab3Jthg&oe=69E37E4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR-I-PZCFvUQ7kNvwF7vTAR&_nc_oc=AdoabFliNtvj32DqQk4ExpLwcFAzztEXKK8X3_-0azDlg9FZBfLZjb19OyaGtMIuLqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36q3HD23ZK7-xiwafcc46SSB60nrmTiHP2wXLoYCL5ow&oe=69E39277"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=FDr23cIVp7YQ7kNvwGVPYFH&_nc_oc=AdrfRXkSRFFNxd61rI-AZYt9136VE1zS-KFm_OkLJ9IpqFUY8ZxFGSLDip8safiS2Kw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LNMDF7BKBYy8yg2S8tSF3Ix3pvMjH4vNPGAaghFmlHA&oe=69DCD839"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN3GnHulKn0Q7kNvwEtHl_N&_nc_oc=AdpPOr7-83eq-QkOmyaOmygoNgrdg-AUxPBFrVQZMmRcRvbdGoUVwNneGCq52G3vQj8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QeLAh0KNg07wtqdXr8KyD_4pPgvx3x5KPzY9B-yIo9A&oe=69DD000B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4djYpS79mRoQ7kNvwFRMFJq&_nc_oc=AdqLg8ZFK4eaZ6FHq8z5d-A5iUeXEEeWVEEsnAvNuiQeto3WO_A_bhAh6oS6S4k_wkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RXy6ZSAfg0KFxQUNlfAK3K1rmJ2dc9s8hv2sV8NV2DA&oe=69DCDD02"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LijHWXAEnPsQ7kNvwGFlnBe&_nc_oc=AdpeibRgJY_-94FWSesmG_f9N3XWRQY9cET0vlOAm9BwpCAcjt0KlqBbV8A-MgNdsAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tj4li5uhz_KC5qgWtIBE4yS8ZrrAqkm3_vTqhVPGcHA&oe=69DCE6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3D6ZvR7e2QQ7kNvwFdCBG6&_nc_oc=Adoqx1SfooxfdF3expUknk7_GBNbAnFAqPNQY4mEi7WENlojRPhzl_04_26f_68Xpug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uQHup_M6DzRT9BxVBzJ1Xdddba8Nh0y3T_712NyQsBQ&oe=69DCFAF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
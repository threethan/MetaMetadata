_sid=6e7a0a&_nc_ohc=8XWGdxYXR7MQ7kNvwHjuSuq&_nc_oc=AdowfCHrthMMnPRUxQS4Mrw58A7qe7phc97M4BIeuYoDY5mmOQ-jHLChVduRK-I9z8k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y2p29Dg5z5kU97MsEzQLevaL4I0MZBKR3jNGB4Uv6BQ&oe=6A107AF9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP7ek0bEoo8Q7kNvwEh8jWw&_nc_oc=Adq_lKqa3tDRRHqY6hN-DkiV2mNcBKe5jvjNspujyjnMG7F2iJkGhmJa5QSpU6p0oG0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MhZBewvDGvLpdYEsc9RYWs0lwOcuOjwv8vuXDgVKY9Q&oe=6A106A8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUlgEEjYS5oQ7kNvwGD6CzI&_nc_oc=AdrX3RptWuViwvsSIy-sdEwKU5w1WniPw4cHqJn0eueKCtEK62WVR3MnaGNoGdyY9uY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66I8YeVnbP-VpVqv9BVlFmYsGrLBBvXgJN2I-5yZfGqw&oe=6A107FC2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWwEtuNrIJUQ7kNvwGLzvns&_nc_oc=AdoFJgvVnZkh6NF8BIMWCTjt1MndwKNwXa3HmSdyaR-EZe9AxqXYQXbRMcf8rwb-e1w&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JoI9_DNapjny0VgAJHHCWgBUqVvNoN7nZ7vxDP1GxXw&oe=6A10514A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMTAB--xF-gQ7kNvwGo2TcL&_nc_oc=AdoanVqt-38yb8creIMelmTsywTh7mlt3wnj-JixnuUr0PC2_JUn4R4xSIoQ1zE9tjg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AajlsCLDyFHCvgkdGeZAiigsnWv_Mr8W2eda1aKFmTA&oe=6A106577"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
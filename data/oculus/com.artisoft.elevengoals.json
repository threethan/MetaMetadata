_sid=6e7a0a&_nc_ohc=WWX092cWH9YQ7kNvwE4Gh0g&_nc_oc=Ado0N0T7PIsKGp2nDAt6pWC78yO4pHPKdpckTCdoOevfJk2KzBYNKqIO49-i18btFno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Mvf4LX-wdDtOIP99np9P6JcbXslxa9Ffbx_zFh-PaA&oe=6A3D4DF9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW08mFB214QQ7kNvwHCtdZk&_nc_oc=AdrmcGPMdk9eU8eh8Vx7mCjoN_XnBjSfD2Tn61aw_oj90t2snMXEJ1trRAA65_v0_Vw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af972kM-coAG2-cWLwUSuhTee3veskZB72NQcp3cSWdC-g&oe=6A3D3D8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txwQeK1_TR0Q7kNvwEqW4IT&_nc_oc=Ado9lEL5NHnXKX7nHEQJVsZelpIg3J4JY5I-z8S_OTYRQQlLX97QjrD0IrTVQoD24g4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nFU4SQPKAQHW_vlanS5c7onbOyMC40-6JqWrtNUFFUw&oe=6A3D52C2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNDbtxOB5tsQ7kNvwFSIdrk&_nc_oc=AdpD04SlZkvoaz9f1tt2rhP40hItDpD-3UdEJzzbmkztIcMPS9wz1_CN0QHrdpRLsag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99AObcg8BDbmjd5OrimnA7irCJaQL2wJf__a-CzBw96w&oe=6A3D5C8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thVCjP9CYTIQ7kNvwFsgy5U&_nc_oc=AdqNRDnmJx1LHwXLeb58QH9vMPEzo5ua6ufs80fbeTrtbGzeo3xpMVaxk-KhbFM3kRg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fFAb2qr3ykOXmiCyN7QefYqkkgVAhIQgTlWxjugyAmQ&oe=6A3D3877"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=qsJKRQusfIoQ7kNvwGvPQgM&_nc_oc=AdpqH2btjjrbeVzJPOcPZOrk3YOQtjWse-MYL_MDTEpiLlaGZIt-Xf3V-cF_5vjutz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DypAkp37uspyZw8mZRDP8yYfXuyS3X_3cDnDv0FwELQ&oe=6A05EEF9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSefzbqRjhUQ7kNvwEdtIb1&_nc_oc=Adp5CF5CTOB_L82CfAmDkeVfhh4CGA_OY-FZ0yqd1K402ZPfNczkFu6S57uLPDqQl5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5735kpSsMBpxpnfRblNHSoHM7Zx8wIeqOKor1RV_xuPQ&oe=6A05DE8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko1HeXucIHgQ7kNvwF2yGiC&_nc_oc=Ado_RTy1uCRNMc5GKBzsgBIgiQMsVAzjZ62U9sHCcNDuiA9wV2wUQi_EhkIEzua72hQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vpETyKdWizxMqYgiSuNHxsmf_2ydlVawCWstGWPg1vw&oe=6A05BB82"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O9dspdq4y0Q7kNvwHehbgf&_nc_oc=Ado173hgWzlVwI2BoqCg8CD9wTk4S7q-oLriQK4thQUrP6ii-_CULijFNGXmR4ht27I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nV8in4GfE2ivhLXglVfDOsF1vhCMV3By4_Xmw19Weuw&oe=6A05C54A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74KX5qSM1ZgQ7kNvwGPU59o&_nc_oc=AdrkVjhpXreCvRM5motD2XNf6d2JuE6wNtfKgn2oVRYVAWBOrt7T-uTAvcSPzquALA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bPElcFxmk5ZN9Hksh5S5HLKRvv6NoaOIj6RJ5Fm8MjQ&oe=6A05D977"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
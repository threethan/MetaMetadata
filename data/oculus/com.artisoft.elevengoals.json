wFG2Tvh&_nc_oc=AdnBG9-kXA9q0Im0K9yH551QbyEjeczSOWA_pPGE_SvlK_6Gf5ukr3jYlz7K7mC4jmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUMMvSWrC_7_BQj_pNK6RdYNlT9C_qODBU1lnX-mCZLw&oe=69B3F9B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro0MKvASxcEQ7kNvwGptBz9&_nc_oc=Adksfg1OuRbC-Lz_JcRB48_pAOGbaWyRkyZXLBLUdOWniNpepHgpCvqCM5vk7CUpZnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw73aU5QHqoE_zdMgryt0RQoRSTNnxJ0C2lKzg3-gdt-g&oe=69B4218B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7SllyvWKz4Q7kNvwH7sE9v&_nc_oc=AdnPuleABtzTl9RW-YDK6GnStRDDDOsU1MQbVBrd8X-iiE1quHojMG82CghkwAavoL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-Ug-Kpn53Z0gNMOcR09MEZEADXkmCr-rmUCxLB3kPfw&oe=69B3FE82"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubGLRLXJR9AQ7kNvwGtrteA&_nc_oc=AdmyRCQTMh1qRZGzUSOE6Wz8smY8Qds3ud6BqBwurLHJlBIKLLIyVrL_kwnZJl6MGPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPU9gYqPHNxxhFuRB1CMqKYQHMc2EWirhhX29HyD1XQQ&oe=69B4084A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JtO0HC6-TIQ7kNvwFB70eP&_nc_oc=AdnxoJmKGaxjK2r5eNUDpfSd75vgNoQiMbBcUjJ_1PB4bjmrAwy4gdlE4OH6TFjWGDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVrCAIFA9leB6f_if_raljK5NZB-OEu-29JIflyKfkxw&oe=69B41C77"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
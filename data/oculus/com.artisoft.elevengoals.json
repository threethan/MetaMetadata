_sid=6e7a0a&_nc_ohc=xlAFwsS9O88Q7kNvwGHs9Tz&_nc_oc=Adp7ubN0DaMDNN7EQnOOGA3ALNTxd9T1NXvG62KB8elEQ_G8CjzFsuVgt95p3wSLeMQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dPcvdVTNx2dr5GdvE2hUjAVGZs_vlL9l0yjA0tVSnxw&oe=6A301EF9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXl4XZsSaL0Q7kNvwGPsDrl&_nc_oc=AdqMxF89AhrI7YLRE5hn9EQ_YHic3JfALxMDhoCy1mdbjfLrPmSyVgq5pHNmvYCQuE0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YcDQInb4WVbXShyt934mZ0Xrpr8kaHTUOIXQ8HGHGmA&oe=6A300E8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXFGI2WhsEUQ7kNvwFi80eT&_nc_oc=Adq4vpZdri0Sfe4TvE0_WUCSxK22oAHRxzwGaFIK_GeNGH9itySlrOb476_M5mUSi7k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93DjaxfjSACvWW11YXn9eTocQnshlEnGOhN6J0POkYHw&oe=6A3023C2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIy1-a_6YJEQ7kNvwHbwDc0&_nc_oc=AdreuKR43wILLV898CJSwoXlUbuGLLwUZCemjlr1Wl6qIOpkUWjMtb133YFFVuoSFqQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XQWi0yW-RjyEaqrZrUmysfWqE5eSTFdlQx-k-AfHNfw&oe=6A2FF54A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuXh2RNB9vkQ7kNvwHfvBR4&_nc_oc=AdqvOaqXFxwCdBn1dQbEdbHmEvmXadqv34wADQAvUXewb00VjuHaEv6n5hcMG3beqoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4aB1Kf201xuuy95egoE47h_ILpbatqs3MUZDyezQ-Mw&oe=6A300977"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
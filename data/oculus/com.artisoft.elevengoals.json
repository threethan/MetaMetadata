_sid=6e7a0a&_nc_ohc=OWLyTFf4LIQQ7kNvwF87XC6&_nc_oc=AdpDCT5ZIfL0DINyjfs7gIzaqqtAtuOUvwNDgbAhqv1_5c64rN6XD2DN6i3bi6voZn8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7jAyRXA3HGMtEXZFQw88PbfCiZQGu7lJIejhdp8H8Gg&oe=69C3CBB9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0gjUC00Y5wQ7kNvwHUwnE8&_nc_oc=Ado_5nS7Hp3MEroUamynMz6dtbyeunzb69HdWTg-tsp1VQwPAR3yKuTs0SnUi31N1kg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5lsr4fBxvcYdGbv7tIPq3wdTKyU2jqB33o98XK-TcgA&oe=69C3BB4B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Wf4q1F_ypIQ7kNvwGyxjbD&_nc_oc=Adq7Q6CHkZoI__kudG-LkYU2VlIIr-BPUhRFVfEjPliYsy5BF7o4ayVglAP2-xKjtuE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO92qKan5v6TtpE_nRDSJ58ZHCvAK92N4CBla1z0HO1g&oe=69C3D082"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxxuMVDdqN8Q7kNvwHWcgLj&_nc_oc=AdotGAbKpHG8KMJZBLej7aDM8tzV9oym_-bQ3Me9kaFcW_gP026WsqLQqaNq0YOFcu0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCQUoD0ClUQlOR6WDuA_scYkYp2AaYeEoGbCQ8wGM0Ww&oe=69C3DA4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUmriQ5i2sUQ7kNvwEPTzez&_nc_oc=Adr2_zRXOQgqAwy2G-gQ3L93IVCjLRS0Bbq43suzU_538i1Czxmky1CTrQ8SYYgIKa4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzspCUGHQP_MadiyX8X9vnU6ayPGb0lBVsqOw8KyhIgg&oe=69C3EE77"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=Eq0dgt9-O1YQ7kNvwHqLeOT&_nc_oc=Adr9N0wOVFakq-GvS7YtbKhLNij9SpH8L7np2JiqCK6_XRpyLmR19gjO2CmkVlXP5Sw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49wk686dayuy0JqY-W3MkM53NQgztKQqVhL4CN2y7JTA&oe=6A1DA9F9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=695naJG31yQQ7kNvwFj4tbH&_nc_oc=AdrVvPiKg2qqUQCfSc9VaeHSUiYoGQr36084fcUNbeT57FS89kdJwjs6BBRFB6yu0Oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VvRV2tUtn4z8loDxXwqfFCina6cYt3IX9uIrE0Pp8Jg&oe=6A1D998B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0zbHbjXBBkQ7kNvwGto1dU&_nc_oc=AdoPHqI5UGYBKAggGkchimXCNj_3VEpwjLTd5Iwsx87EqaY0Cn5QI2_rEt4oSaRqqWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EC1gIdRZH2qI3OHSm7yCTVVubHU9vGTPYFdtQ9A2jbw&oe=6A1DAEC2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsYq7xRtYMYQ7kNvwH3t_vf&_nc_oc=Adqp6wQ2wHbEwN6wqIc-F_FQDkzTI5KTIfeSoFpsB_QGDLcqqD0l9rO8xTXQi1zSLQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mDZZ0KgUlIaQ6VGbMXKd8cw1VlshHYWTT4hY-YCQ4qg&oe=6A1D804A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BQqPU03uiIQ7kNvwHFVbwq&_nc_oc=AdpbqdbkSkyT2uS_b1B2F9C_4GVsdJXs96OREEDcIhJCvrdQD8PpdKRoV7q5THzVd9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qHqEIF79q-v6LIvdAKqrMPBKXFPMgTkuvo52XdiN9Qw&oe=6A1D9477"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
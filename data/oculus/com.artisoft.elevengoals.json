_sid=6e7a0a&_nc_ohc=gcEKZamio1AQ7kNvwGXRVjs&_nc_oc=Adr-Qvt4pvEmIkmmw3fmTmKXixCKU0nCL3pKSC1AP9YgcH2irjD2ut7D9wI2E2WS6lU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm7XHNp5g3suQqwZeBPhBEQo8ttKAqzbsSsoDvZ33I_A&oe=6A65F439"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zmdo9PzBZAQ7kNvwHM1Oe-&_nc_oc=AdpdZ-QnHp_JcdKRiPpCBDTSkIWgkPVVvMwIu15X3tBtXgK1jvwFzt6gy7rIqPvlFoA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjPv53r6ig9mnlRsHALk469NqTCaAzI8ssgjKa-fq6Wg&oe=6A661C0B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJv2fzmWxv4Q7kNvwHyWOAJ&_nc_oc=AdpZwbZf-t1h2e5CcN2GPs-BsKVsh52482REWZ-L9EuQXZdpo0z7ruWijN6oC1OtUuc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLOJZNWUPw8OAvTdZ4b5tHTy8_Sbgjfh_m-Tm9Z7NIUQ&oe=6A65F902"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ulowJ3NYcQ7kNvwEDQUDv&_nc_oc=AdofWBUOPC8ysTjBP2tdrWDuCHdWDWTC9iaZjkUIl0rjhfyGFBsf1GWdMBGfRS4R3qs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXuZ6_Vldl1qIMk7MK2vh9oaxPFFgERI9XI5HNbONETg&oe=6A6602CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nozjrg_LeogQ7kNvwF1gdjp&_nc_oc=AdpvT6-2YcBV13QZYdP10O-WnyvyPrgVXGSb_pLlrKOih4idydUok4iqaf0uOnRqpdo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqSkOFuBLFX80JI3G_RdSXHrFxlGLy6HBb-DjDAZs6Sg&oe=6A6616F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
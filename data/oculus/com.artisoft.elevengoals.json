_sid=6e7a0a&_nc_ohc=XfZA-aCHioYQ7kNvwHLxCn3&_nc_oc=AdpH_0gDzzI2lVSb-ASzMHYBvimlyCviqTKW_iADuxTyqetrewN_p0XZPWN24sdLIiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpWJtjJjL6S3iU5ytoOrnmLd8scZtjbEZC717fM7Jexg&oe=6A6B3A39"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYC5i7-Y6xgQ7kNvwGXDONW&_nc_oc=AdqRXv-ePM9eXCgj6fPsoFjaGr1q6Uzl7h1JiqwykXVfEz38b7fcA7_vzUfFbffEuPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_wNC1JWui2yCMATfe2i3BkFEox2VLIJ1yTlLko304TQ&oe=6A6B620B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YejcMsnOgSkQ7kNvwFqFlY0&_nc_oc=AdrO23UVAaQNMJWJnpx2asRWnZF7rgSAnV_3i3knwpRdgowRNOQ1lwaEvu0P29DywDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYOHOJrP9ONxLkwt_E-xadgrCTf0AzdMjR0knlUINwHA&oe=6A6B3F02"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xMMQ4RxjG8Q7kNvwEdlurg&_nc_oc=AdpH7xm9HBlavZQuA3EWbmxe16GKv_ULKY0D4KnAYhSKTHxa3BZU88jC9R2Vc4x8d2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHUS6IxWak11ViItXEnoMarRJtAKqv0-XFYyZbRCtpoA&oe=6A6B48CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G6-AHlIhFgQ7kNvwGF5s4l&_nc_oc=AdoXRQPOBgFczOV5kcOhasI9UYHMvEVrnvrkghczYkqrr-YI1jvjGWk3bcSkW_xSPZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb9sFpN8nJowatCsMKqU0oI2UUU9Zs0GLcX73cvyC6hA&oe=6A6B5CF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=X_P8-bdOYPkQ7kNvwGTbs3g&_nc_oc=AdqhZfgGWz9zWU-NIWDt7rpfphvE-WGDyDn8P_HHlWWNu9IaRGlnRb_wObBwDdG7Kgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALtwuj4kKJjsq8xsGFRHovBsz1HQXWRPKc7Y5uul5QAA&oe=6A5F5CB9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnrAhoQs050Q7kNvwGSKCmB&_nc_oc=AdqKtPOOpBkzrFrMM30Sc7TTyNq64P3I7OEexoMhXLqSBKYe9UQtFe9k-gDdr2BMSuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpfXkIHfdVg5OWe3aSzbXOQyT7DmfyLrxMv_1IZhA0Fw&oe=6A5F848B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmTSkQLZpuAQ7kNvwH2RG4h&_nc_oc=AdqfXBFXcIFeQ5oLmER68ofu1KdmnxjEJLRo6JTe2xIvZpY8ZiBvTSD67xbfj-zyQAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtET2ylHA8wnugbRd8z3EpocXuuOv8Zo4f20Sc62V04w&oe=6A5F6182"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ3MmlyKVk0Q7kNvwFb7T4v&_nc_oc=Adp5rLFgmOmYuK5p1ucryBVaSnWlHVFkTX7iptaJFGuTJ8AnrTyy8-4Bzz0VIgOUz7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoUHrNtI95UaLJDA1Hv-ytKfFN1EHban4pbpEWdoBUww&oe=6A5F6B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3KI-fh1Z7cQ7kNvwEM_5Ej&_nc_oc=AdrQsaBBUGBKp6lgD7p8VN-qcD0vst5kYOtv2RFaQIA0Ln2PtJmdhdDxumuKvRO7oKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-hG2KG1bMYD3kXiiswNJBCdUrkuYIuvucB6bzURZlLw&oe=6A5F7F77"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
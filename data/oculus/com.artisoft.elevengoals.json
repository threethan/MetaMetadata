_sid=6e7a0a&_nc_ohc=WWX092cWH9YQ7kNvwE-7Dk5&_nc_oc=Adp4RR98di2W-OScGHTl6vtjH337tGeGFawYZDFC4adI_BptFLJ4HY8UsTxADMvJFOo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j6Yvi7yAskJFye7aCYI9mZdA6g3g6mDIzG4zUk2ZbQw&oe=6A3E9F79"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW08mFB214QQ7kNvwEBhKPs&_nc_oc=AdrLxX06aQOXGw-wUulL6UB3vFxwLrodXkgeAf7JmC8CfNEGS15pPyM7Lqy88sZ6z7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0nJmfxRGt5PE1986whJAge8sq45fUkSp8FXYuDy84oA&oe=6A3E8F0B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txwQeK1_TR0Q7kNvwHRCXku&_nc_oc=AdoUz79hsaiXETZBXWnm4xi1UNGmEoEfk07glOs-ZzChW2PAF_3TDiIUwjVj6tDm2xU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89l4xhSNwozRAVu1leydK9dPilqg_b1WIovZDnsNTu4A&oe=6A3EA442"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2otbjwCbXwQQ7kNvwGRphVF&_nc_oc=Adp_C6XHg9f3QELa5Ft1MD8S_uQp0ePAW-ttS-Er1j9M94q10_n-ATke_5pdCHmwtCY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TyVaiKZi2wurnqqz6vpFOeQp1whXlczvs_sescf0ToQ&oe=6A3EAE0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sANuvO4fB6MQ7kNvwHRIdmK&_nc_oc=Ado0DLeTG0Bby9DDhCjXY5mWGqTQLHYvdAPumJic-U5HTHsw9rItkKY7Glc1lSMXMo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__rn99WaEbgZ1gkmB0An64amypa2DiRqEoboNpfPnemg&oe=6A3E89F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
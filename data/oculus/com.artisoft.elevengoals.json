_sid=6e7a0a&_nc_ohc=2EMaecq8c7QQ7kNvwHouj3A&_nc_oc=Adpm3IFar4LK8CrAcTY_ShWCr08xDo7whGc_TSK0NOE_VXS8RLs6A9AVSmSKSpwyjMQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77AloQHyT0G6VZhZWAis18u1k3x-LvvYwRJHN1YTIg9Q&oe=6A0F2979"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBWi6yQNwfYQ7kNvwF5HcDk&_nc_oc=AdoT8RX-C0laeiF7AOimIDbslLDmOWrW9yMzzCc-OdAbXmaz1Ix3W4IggXT9EeOvxPQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZQ4y7sRJ-yBXgLDo6PWK8TpV1PpEv_VR4cZ2qEcFiAA&oe=6A0F190B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rg0XAb-jaoQ7kNvwGvVKXy&_nc_oc=Adp1KhRo9tuMmoflprahmok1W41g10kVGnR1ob41HINEICoGvc-8w69redkQEc7puSQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fVnCjImO9bNSwi-I8X-j52FU3c4KEyJyWfP7r0Iw9XQ&oe=6A0EF602"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtzJkuf_zdwQ7kNvwFtzBq3&_nc_oc=AdpYle6RKRihCiuMgAFsWJsVuwXsozF6r1QlUD-kWMJQqTlIZxiZePzCZcnwXBCSIrQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MZvrLKFfsSdmK_Dq0gJHS0X8jJXadGa2dNjUYaoPBpA&oe=6A0EFFCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMTAB--xF-gQ7kNvwGcbXl3&_nc_oc=Adq4NB4uZmFAOs_qXEl_KoK9Vdar2tvYj85wf4QvqNbFI-8i3Kf7riLGu0rCQF5uuSo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wMf7sNX5pqtNsA1mPcmxUo7kk4LkQxiXYETz1p4RaGw&oe=6A0F13F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
sid=6e7a0a&_nc_ohc=-jg7cKLFVfYQ7kNvwELAVIl&_nc_oc=AdrmW-am4sGpZyVM9jCHxVdknABgeU-W9LFYQyE1YTnW-a-cWN83XF5t3ouVbvtlpVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rt-wAHlytbMjwbfeoGT16t1ItrzjdbBUYXRnyT8LP9g&oe=6A4536F9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CScBM-MOvH4Q7kNvwHO1CPW&_nc_oc=AdqAxrnowPZmsRHXFN0A6l43XU7m_FBkg8NrQNfa2kBD9sSNbPYi1BLIsgEzQixQNlU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S_Qkul1XJnJkpmCTAqqJ77_hPRRcb6CElC_DBIs92nQ&oe=6A45268B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odz8ezQEGiIQ7kNvwH67Mcn&_nc_oc=Adoa3y0A2iGNVpRK9D_kbE165jlMgH9lX5avgzqH8Vk9llWKUc5jjR_o7KlWGl1tRR8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nc9PcRocI-4oD-YgMgcNUN7MqDoAc6Du8bv5dlTr_Ig&oe=6A450382"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBoMoXz7x5YQ7kNvwELProg&_nc_oc=AdofRh-3An8F3NhSFo_47Iv-iP4WjS3S0JwmJeCnKCatdXi4kowhkLOGYAPXbSjOnxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ytIZVLKhGCQbCdR4ABxL4I_QecLmDo7m2hHs3o_rfjA&oe=6A450D4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RNBGTSW_GMQ7kNvwEnO88j&_nc_oc=AdoYHSwmzO5hlFEsilLSqutuGyaBwyj6j9Y4TM6OhkXxC3g0VhpyNXbQnmfQBNT7luc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ts3y4SV1YGeBjkTKrPxokTzMCWfSzd4954jnLLibtdA&oe=6A452177"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": []
_sid=6e7a0a&_nc_ohc=ltXcjnlkOsIQ7kNvwFnOVJ_&_nc_oc=AdpgB3OqRrQY_0QuVEOn7v3gBnC6ppsjamcUmR0rOVka7OarAh9rpGRqQT_-u-ycu5U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08INadEhtD6g9oSPVd45mbUMFzKOaPzOrxz5Ufh6X13w&oe=69F5E4B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqGZa5JX2EcQ7kNvwF4ktaX&_nc_oc=AdoufJHnrZEtFqQmHa_T5lIW7rBXjvPV0Bdo3S7iMAWphsxlzPrKUtiyzNF459l23zI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MNollYKZK160u4vIfdSS3AL3sicehqtGaZZ4dmzzMGA&oe=69F60C8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfrCTQnIWHUQ7kNvwE8ylTk&_nc_oc=AdqL9uCkCGNXGFIMJakizXne91yZQIIkRpP7DE1EjN1mXPQe1VOcUiLkbH4_fKdOFbo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Tq55ftzvtjrLndKRV2zyXsCsGCC4bVd_LS4L-AGbWEg&oe=69F5E982"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWqshNmiMSAQ7kNvwFi-Djz&_nc_oc=AdrblqGE8in_SwG5Hm6ZgFNubMuC0qqn37q1ixm4jE3QtmDQXjPmwf60IOSssJ45eMo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KoIlQTpUQv89SMbtTAfzkkFed2LFAK7iaoHcQaZv6TA&oe=69F5F34A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZhMEIq8gqsQ7kNvwE7eOFm&_nc_oc=AdoO6ZE5F0_Fv3VNi728uV3BoHaElvUIw0qxWRZD9DjCq5WZV5CoczBkRex4gjicnp8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3K7LaexSnJlwUqUV96xBpwyyNVWYF-USmP2GQGK048Iw&oe=69F60777"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
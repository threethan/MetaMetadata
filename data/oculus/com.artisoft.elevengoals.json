_sid=6e7a0a&_nc_ohc=iebUue3PXvMQ7kNvwFe4nfO&_nc_oc=AdpJ_tiLQ8yZsvTXyVbQekBHyK8-H75aCsPzGOWLMCCNQKfYjftIj7YKl-_PTry1lYA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlMTi2VGKbrQHY79P2gXL05dtbO6ZBODtYSDF2KcCidg&oe=6A71D1B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVvCKbNzyO4Q7kNvwE9vRXC&_nc_oc=AdpUcTVxbLcQXECLWNnToyi5WkuSNDHbaGwV2tNc5KarvnicvdgA4Bnfsem2KNeStRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Vus-mMNAoELO39kuTzc6S1qPwpQwZdWi-dOwOcjEyw&oe=6A71F98B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-YSRbE89U4Q7kNvwFiZegv&_nc_oc=AdrNSB32dwSf0SbhdBvr7pAYvIj9kngOSkR0rXU5kceAsodM92MfKeLNeghdry7CUEY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKdmUAUXHvce96rK5ppB2nnC43HmJMhOS7_y-iVkOL0g&oe=6A71D682"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqTO3ICuMZYQ7kNvwEL4Nlr&_nc_oc=Adp630I04CSDsBpKgtIKioZqKd6Xs_09eCJZFdjVM5KUjb6OK1_2qeArQrBU-mJuL5I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2rz32BHh9To9Nad53XWGS3NDgg675tO1guxmhB2by2g&oe=6A71E04A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAGJD6klYt8Q7kNvwFgcC6U&_nc_oc=AdoRWCLhEdRSOfC8u2Fk4topUKE-EzHceTWTfdJOzB-Gwk4IRfiPv_1DqpQYy_ZTcrw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK0C_pWY6u9AtpgoEvXfHgF39oE1zfIrvE-m7DNsJT9Q&oe=6A71F477"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
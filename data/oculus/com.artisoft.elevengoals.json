wGzVC_z&_nc_oc=Adl11FZd5Y7K_xnU4jult84wjEk78_GF_ipJpsjo7JXYYK8A4Nh5MZXGegVEmx2LXUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww_11JAkOH3RjV4Y_5PLL23__sYuKtpn8sYwQHs-37eg&oe=69B156B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro0MKvASxcEQ7kNvwGTMqAb&_nc_oc=AdkXxU-tPXlFBB7W1wPdzq1j1JK_Mv-_kWiNFVMOwIG4yq0eZ_7_guPXutBGz73RuY4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9P2FxL4URvElUWqYrX04GDin5UVhFp6IjS-A3VWCEow&oe=69B1464B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7SllyvWKz4Q7kNvwFhsPYY&_nc_oc=AdlP5NQ0J6uJ6cx0BGXsUquUQFATvUmC6L4Xs1IRl1uYamdFX_dbIszHDICvdWj-NoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHDpRliPT46TmmVKwL62SRybXgxXODCio7cfqK98eKFg&oe=69B15B82"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubGLRLXJR9AQ7kNvwH8dmWr&_nc_oc=AdnyhHX7XqfNF2qXI4C2X70iNbmc9dhmjNEOJnEFe7W_iOyUli3OqDlCbwMVv7vYy0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAlUPErm6b4wmeS7yZodUJ-AnzPhfLGJplidDxOAblTQ&oe=69B1654A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1xMPOR7iqMQ7kNvwENDsyQ&_nc_oc=AdlPW6MDFaMkhjgXaWLcFkKqh37L0atM0LJV5Pxm87bdgHrH_SI99DxqghyH4Om9DK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDPleNXbI--8CUL_Uy-480S2Q5Y2_28SpXogjEEekOCg&oe=69B17977"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
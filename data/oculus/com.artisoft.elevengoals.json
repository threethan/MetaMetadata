_sid=6e7a0a&_nc_ohc=gcEKZamio1AQ7kNvwHIM_bL&_nc_oc=AdrW-jO38n85Ll3OyIvlJWwk99l8GUcCu4-Hrkw1B0cRvEBxCCyw_i0jXkbvZpQyVjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpryBzFUFZ7BcCozJL0eEowNOWbk3YmbkWqJQY2EtuCw&oe=6A635139"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zmdo9PzBZAQ7kNvwFd5XwP&_nc_oc=AdoxAcXROJ0SZRvEYAq15ERIpmMFSKUCwnCk8LgEiRXPTxUpZADabHVhhqGbFya6H9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGjUhlOTW6B3h-O2ecnnA0rXYqBT53-3ienoThJ_clbw&oe=6A63790B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJv2fzmWxv4Q7kNvwFYLw1O&_nc_oc=Adp5Aug9yQ64ZXabAPLRZr7IkENzObgFN_r5N045v1nXf1rAisSXGbVC32GI8NOhJSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7b7iZAibClOkQ-uBffhnhck893Ut_HFstWcBNPP25KQ&oe=6A635602"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ulowJ3NYcQ7kNvwFh06ie&_nc_oc=AdpeHTMH8tn8GkTVyOXCsy2R6rkTWg2WnCV97ucpV8M70iGddzv9RhfY-FaDtH57P88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC40RTRAUSu3OOGDQhAHgUTyEq9OzWuiABGJo-7qExY1g&oe=6A635FCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jrtcvJu0UsQ7kNvwHiTnrt&_nc_oc=Adp2ME5pod6m6MhU2MyfXywYspupplAbCOG4heNTNadKjWYS9ge4pzrk4JS7D3AxfIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEk9Zs14VaSx5Ocr-szM4rJmjMMI5F44S39gGR5al7qA&oe=6A6373F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=gcEKZamio1AQ7kNvwG2oVUy&_nc_oc=AdpEQoLA-WqYOnrLFL6hxQZsGlccx3_6k8myGqTHpCWQbCEc88EWHDHNTzAoY_nvtaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdv5pNdCQo91KIXLT7vnFCKmhDa8YWGph76ORzrzrmtQ&oe=6A64A2B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zmdo9PzBZAQ7kNvwFJk1tN&_nc_oc=Adrxze_FsK-uZr1R2iya7ggf9n-fEwW_Z9qf2NebAvfxB_65AivcVrF7tFalJUdxxmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhM0d_hHMckF6Sbdqrg6Y_0sUCs4crGRoUR-vwUVch3g&oe=6A64CA8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJv2fzmWxv4Q7kNvwHd8LGn&_nc_oc=Ado0Y6miQIldQi_YuLHP1GSyS8_U4zi7Sv98bDXJTR72GD62dKrGpgesECS9hEMCZ64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGH_Ej-aNOItedajvLNwKfMXmNX0iDgsK4wu5Hrvn7kA&oe=6A64A782"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ulowJ3NYcQ7kNvwGWpba5&_nc_oc=AdqCHVbBqYvH9J2t8DmkHOlTxiw_sw1-Qw0ThOaFNBLLP0zndCtSQRU8Tw8XaLBGYt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHhpdqClKfke9rCPmC7moegjK2Udqo3YLUva3JLYOS1A&oe=6A64B14A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jrtcvJu0UsQ7kNvwGqsQ2G&_nc_oc=Adra1Y4IpOtb6E99NIDHxp3IHvO_tuoVGSCoGeJ2GhHN6Gw-x3KfnGgVD_qsacunQhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp3E4kn9yiwra39oWR3nf3oV4srsqjyV2DzcpNBGFl5g&oe=6A64C577"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
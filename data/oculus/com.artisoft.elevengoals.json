e": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSdX55ytZ3cQ7kNvwGREt3p&_nc_oc=AdmDcNdLVyXeuN7VC-FbYAa0kC-0oAlWC2HmLLELkAEJ4zoUinGeOYfp7nKg2hVKhwc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftEFAypAchp9FXxCWDXzr_22YI1qPiUVwrPCNwPIBmPbg&oe=699ED14B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRiuRNAznu0Q7kNvwHJh1Ii&_nc_oc=AdntY1QcSmFg6Kil5aKYHKtLbjk7EmS0fnpnLhQhDY-VOsXd8QcPSfUcWOXDNRKs1zc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv_oGeKOnOILZhmx1rlFjuWtcsEm4eCQKdij_WnWzB6-A&oe=699EE682"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-l4mFj6CIEQ7kNvwFOqXub&_nc_oc=AdnDfgu7a5NcZqWP5loQ_cpDp4yP1XAGoNBDsLeM1awpnA0wFhr0fFQ1OFIl9GJSKOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfspoW1T5gXv4lg7JU-fz2Bx_Cl-aeGRce9ToVH875a3og&oe=699EF04A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDohZyLo4isQ7kNvwFvAWvd&_nc_oc=AdnyDFJAhmtruEFoFViJIupaOaTR9S3rDTtBzUIJNm6k04HAXQuPGf7ElelKvURDz1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsrPE5aI6k484E8faODl4m2aTuIBNsq8dHmeZWKJxFOLA&oe=699F0477"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
_sid=6e7a0a&_nc_ohc=fng7dSHVuGMQ7kNvwFL7hSI&_nc_oc=AdqXdsx4zLKjBnV6v9JWdezftYQqUMI6kLaWwYHvW1XmLI_UxkQTFJPwBB_EhqprlpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TVbe69uz31h0ltPE4GG5OP6IW3yDWXFoVKQd8ilLT_w&oe=69D8E3B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt-DyNPCpz8Q7kNvwFM14Pu&_nc_oc=Adoc36GwR5recrWAtg7I__u40eWGPdoSZi4eW8MLJqVtHW9LPO9_d6fRixOMwwk65k0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jpRPhEznG9COv03UJh8VbLN9iK8AMi0x1OGydxH6XUA&oe=69D90B8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsnUA10I3hMQ7kNvwHK5mEC&_nc_oc=AdqzC6-BZGHsr5QFPvrRBKUtloz66WzUXfW73wMItd84OkG_I5byKKyxBECbA-TEJgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2in6OXNUJapIlzTYk_1Sqyf85PePFAzGoSZrDekD5V5Q&oe=69D8E882"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6kAwaHIE7AQ7kNvwHgqsX2&_nc_oc=AdpTa6h9tWNyYupP5yMD3wf200eYxs_lP3eAlk4KpIG_KEZjgc1JFNG4CVDdq0aHC9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qrfs2hx0Okvv08AKS9XTsBUPhRpGx78dpwjMiVunVDg&oe=69D8F24A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABpUEBRpQYMQ7kNvwF0Z3aW&_nc_oc=Ado6fDB_39UpM-xsB-XAgywvckzQfO7C1v5tNC5QPAQzixv0k5hEWHj1j1xo6it0RzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vGB7KR8B_oPwqm2m3xc2QvKPT5uVMgZoHMoJAt2VSGw&oe=69D90677"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=3ZDNd2FFlqUQ7kNvwF93vZ5&_nc_oc=AdpxgrLmJvUe3cuNuhth-LYMHQACvMGt0K9-eLCLXXUnx5iaYOC64EzwBsXXbSIRxf0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GKUkzhxE8ZfDLBNt4mQVKKPPcJN6oUuMFrr3-F6Btkg&oe=6A26E479"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UeYkSmQcc8Q7kNvwG24KA1&_nc_oc=AdplvFJs2z39qJ6P-Zka9VrkT7zvZE0IlWaExsh_oGLdZk52BV_1ucJo-A8aV-yCieo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bxFOlBv5Z2dIxh1vJwCJZTpQYkxQEpGlkbJv_E_oYug&oe=6A26D40B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB2LNNiecjAQ7kNvwEjxL7S&_nc_oc=AdpWgPLHFolQMHHwEd6l310L4UVDysDVGipkrm4naJmNYQIBNHKv34C9df-G2TuAi8Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ts4z1IAOgBSj36E0cWGA8K5CykjHRgbE0juFzI_q-Mg&oe=6A26E942"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A9VxJl5B4oQ7kNvwHycczv&_nc_oc=AdoqYySVMb_0z9LVwMSbT5qzj4hnHxzolULzfwtk1JDYWaXwPA5dfiW4tnYV7jegSNQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QqOizZbiA1dO5kdXYatukxVx_XtYDMUiw5G3UXl0U5Q&oe=6A26BACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wDFsVbsvC8Q7kNvwGWFPW9&_nc_oc=AdoUCg6UqRTFE-AMkW9Vl6IOeK-3Nb_eNSj0VJ6yXV_fCGGkOq59IoXnr9N1hmGRKzA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YqZSCOQRnAqIIC0ZM7WtomYdlix1JTvTHqSk_H2WAvg&oe=6A26CEF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
wEKZmvA&_nc_oc=AdlhqOFgxXgSBEsrOJbCj-NQcDZa1r1viaWqjvf0ChoIXOOK8ccK0x9H0B7bUwvxzW0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKl4c3uCixO3czb0sTWPbc0y7H1n6WIUN8WqwiuzIK2A&oe=69BA9139"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdM_f5z2-mkQ7kNvwED8erE&_nc_oc=AdnFcXrKl1zxtsXKKNelh_SIt-HBVEHd0zrELfdsU-WHt5prx9zhbZGntv9SZBorRpQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIERfPW65TTA5zgZ06A9jqKgQDV0Li4Y2Rit51lVrx0w&oe=69BAB90B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EjvwcibfC4Q7kNvwEhuUoH&_nc_oc=Admq8WYZtN7CY-ATxzrM5pMlWwVFLaf1L6tRgr6UBRKiV4M02TeXGqxJ1N77lqUxLm0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxurwOl6KblGd7Z1DPoMa3zE_Gj0ZpRTHU7EmQy-alvoQ&oe=69BA9602"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27qws25vN2EQ7kNvwH-exOK&_nc_oc=AdkRz7-ZnvNbPL9AiGnVllNk5_jLyvtzrxzrLYWnrLEF6URftAHi0b13TQ3NhjBhmG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfOiY6iosURRiyPDeiqgwyhoUv8zXBJvDNSknVUOke9Q&oe=69BA9FCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UQbdE5tiwIQ7kNvwEgTK5A&_nc_oc=AdmG3uvyRNnt0rAQS_6HlI4Om550-1BCnht8evD2VEJZG1aZfscw0jvgwq9qhsoYL0s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1RZBPTJhdbguG4ciz45sX0h2VwMgVvnMY19IRB38v5g&oe=69BAB3F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
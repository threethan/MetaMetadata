sid=6e7a0a&_nc_ohc=85xuqqq0g7UQ7kNvwEfkbuh&_nc_oc=AdpgX_vDXo1DYuTzjpQpvD9oBB_nbbWvlpMrVSycBXZf_OzVo42JdJmO1n_a4lQl1Y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyilyNdzmttL7_P_UiFn0jIMyla1frUJxp2QSxwvlB3w&oe=6A5773B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfVatkhMEfIQ7kNvwGQ2Qv5&_nc_oc=AdrJcNZRRLAYbVElVWpfxDsnH9yjC7Tj0lyHrSdPRjMsBVLJAiFCovtjzCLELEk7Y1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLhQgXSZKfV-lyKmoOSi88iSMyVltlmGQl_iMYMJN0-Q&oe=6A579B8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGIRudD8BBkQ7kNvwHmKaUZ&_nc_oc=AdrRHW9e0tMiTLfYFBry265WHYL1hzaIh4Mc0_9zNXaFxsxOIU7zEWH_62_AOa1HVXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNQqRJFRJuEw1o0-54d1l4xlfnci6qtFjgnTfxTTvp9Q&oe=6A577882"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpAJkCPXoaEQ7kNvwEP37ta&_nc_oc=AdotOUT4oMFuREHL3hvhwL06JM5L0lHqXN-8Sal9nVI0ZZyNiZi0HOwChh3XAU4cfR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdv4PJb3MMMQgjUoUpkWQJVx_Wl5V6sSQVYGqME-Py-w&oe=6A57824A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvUGSM3uP5QQ7kNvwFVuYA9&_nc_oc=AdqER9B7dEMlSPQsXdWD9GJ98FyVi542Cq2oQLDRX0EUdt0UfCbt9Rs4-rxMS-VP5PA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVkbfR45wSUox66Cc7BaRf9Il5Ap6gz9FhN0mOo71h8g&oe=6A579677"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": []
_sid=6e7a0a&_nc_ohc=avg5nq-MCkUQ7kNvwFbjM9w&_nc_oc=Adr3hGO7xInFKZnTENOufVZjiMZHF90JeTwwbnYL-9TcqF4f95VDQGtm1W7D7pld4-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywjlDT0YlLpw0IJidoiEYGaxtrsS3g1EHkrC968F_rLw&oe=69CFA939"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2o_bB5pNIIQ7kNvwFBZv7P&_nc_oc=AdqI8OXoorKgZVI2A6TWf4MG4aAT8_R3xvlfwvSofx1v-eulbLL4QbX5BuUI5otncdc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnRG-Pho5_KhiFfpX-B3faP3r-Z4HLhFmRYcB1UpL2Gg&oe=69CFD10B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYuvFl_Ry_0Q7kNvwEwgwsr&_nc_oc=AdquO_jET_Jys1W4X_k2Twr0oAnzYc6gwsEhtf0rJTzZRTIvhhUHtzKxN-3BNJN1ipE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQvYh0i04Bi9APL4bqhVCXe2vQAqqUD4-o_f9wqmYJQQ&oe=69CFAE02"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlAyqFUC2tEQ7kNvwGzo8nu&_nc_oc=Adp4HKSKgX0ZPFXHsgCJdI6-iNlJxTA29QyWFpBh_iQ5slt9LtCgESzVu85MY1bUAsg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHrGThL7KA70fOB4v_DHBlbx54WGXB3d3JtIS6QIiEeA&oe=69CFB7CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K678WafPc_4Q7kNvwHpZMdZ&_nc_oc=Adr2t3mFun0sAmH9COMvwcVv0EZhRQsKG3Piib7ObOcozKPo0GMab7cTAYs4r-EJ7qM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLWzcOKOHd5KrhxJhVQ8QlFOL-eqqhP2nsym4EwKm8OQ&oe=69CFCBF7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=XZtYSEJufs8Q7kNvwFJAgn_&_nc_oc=Adp9tk09oN1stvcdpFVsE838jx5GVeCU1Mr7StRlY23_ZIxCszzXS24dZrIsjGeUrA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e0R0PR9thaertZHddMYH3QaZ8zCPN_VoPHAaWUt05kQ&oe=6A3564F9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWZBRr2jaZEQ7kNvwG1tXTu&_nc_oc=Adq6T4m3Zj2Lj5BlEcEEINBl8ybyfPHYdCkZv9JTIblAkkdldRO594w6xyWEg2Tulyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bIrDwWp7rNW1m3J7CCllssLXu4ZhUuGlW3J_M_lqV1w&oe=6A35548B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ING2fCyyBxgQ7kNvwHszzQn&_nc_oc=AdrgnKU0xin5zudsib2AZ8DQR3Q0NVyRKE7iqIWQnp-MaSHxp7aqiQSpyI71hnvW8lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N-agGpg8uFXe8q2ExHX5yNH5FpEMT3v76FXRtnwd3Qg&oe=6A3569C2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOBkYeTGP3UQ7kNvwEEKZFl&_nc_oc=Adq_htyQQ80GHmPy06J9uaQ_1v8rBgE-AbKOILvbmSXOmSzrO6ym3brVMINIGQ0QfCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sPp3Y6FiuFNXQqAxJ6dej2asYyvoK_mm2idSlY_snXw&oe=6A35738A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1W-1Pg86EsQ7kNvwFIpT7d&_nc_oc=AdoezgDIiDNrXgOA7Nyw8szK44OAZP55G1mqctb-qyX7eHdPDSsqDKCaEOfwQcf5lqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pjQL_TeKGOvDSJCu1Z4wSoVfEr0fhXKVXWC8ZHLH7Fg&oe=6A354F77"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
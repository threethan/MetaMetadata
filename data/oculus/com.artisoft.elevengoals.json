_sid=6e7a0a&_nc_ohc=shS0wTNNRlwQ7kNvwGNzKkQ&_nc_oc=Adr8HO3BEw_WDhYP3cqnVTebfQmEnQ1rawM33DzjgMp4QcpG6C3R9i5ve5NIeZ11Bio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YaosuMIswEnZ9XDxvEO5yjcr1Mh_dSF06jxAKkgS7yQ&oe=6A2835F9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0LrR-Dk0XYQ7kNvwFS8hC7&_nc_oc=AdoFECNuD1bJREG76sXwjlJmuBdBIufsvnjpn0xKDqHs-dcU2ygnLD_ACa17PzzqAJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zh4-SSz8u5ah9l04K52RAG6KqGjEaHZoYQqYJMRbXYg&oe=6A28258B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYF5SAEg-nsQ7kNvwG6yEoU&_nc_oc=AdpAUn3NaqAQGLSU04vzpYYxTcQP0NbVxCzOJo6FvMxTQk-cRu1p7HU6WxQmUbaDsY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Nvbl1lauikeOlsrokuGI34zMu6A6d1JzvRmxZ_X6Hrw&oe=6A283AC2"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keQurTwshg4Q7kNvwHJ1eeD&_nc_oc=AdqXJ6BJmwYxhgJGdiLuncC6AdL_aaFJH2Uzx_vo8YNt2kAab09kUugs84NUPoYMqZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97JXdbF611uJdLnSbi5MHIka8udn1Z5DrrgW8BXAtbnQ&oe=6A280C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wDFsVbsvC8Q7kNvwEEuBJt&_nc_oc=Adom6mqa0nTNansq1mQnkYsVASkRWf6T8GAQmQeJqLInHG3kpMRLeHAHf-O0FZd5Fpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99W5ZfGYGGMOvVAicb1IqvFYPRUQlHp7veC-Yeph7ekQ&oe=6A282077"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
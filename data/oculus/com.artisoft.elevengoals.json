_sid=6e7a0a&_nc_ohc=WWX092cWH9YQ7kNvwHPw6i_&_nc_oc=Adqmoy94TitC7ndPGIouRU1ADjVtcM_KCHc6FpldGNdkj3sU4aXYI811I-buv3hKLrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MqukIxvFEiEYBbkEcYygpl8_OF6zqNHY4z76oty9fFg&oe=6A3BFC79"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW08mFB214QQ7kNvwEIV1U6&_nc_oc=AdrbC9qCB68-tTAM4e0b_83ccFeJUx0VWiioXUpTmmGjKEHQ0eV1ReJ1nFHwwBCeozQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g7H2K2L-nSY6OQ1JZFEouzlVJ0y4b0BaUyYIG1uyUfQ&oe=6A3BEC0B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txwQeK1_TR0Q7kNvwG2O4SL&_nc_oc=AdooTPneQI8_S5V4cmO0Ewl0ZLkD4HiCowxaMK5ijd3_UNq2X9C9LghzkPDYuMzbtvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TyAU7_HuDL-8BZArtlOJc7nQfgfyOxwOePhnUHcl5QA&oe=6A3C0142"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNDbtxOB5tsQ7kNvwG9JKwU&_nc_oc=AdomIyiO1rSa0S7Vne5vhCdylW1n3YMEz8dXKJGSEbzL5WMOdMjcLzuDbJpnDEmM8SE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j4GjzK6fmqVOYqKjqoJhASYaAVhOwgB842qasWb-jog&oe=6A3BD2CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thVCjP9CYTIQ7kNvwF_UBA3&_nc_oc=Adp4qcm5xuiWt8htlUbPjkgUfqzq--wufyi9T91YS8IevVFIWSItuWbo2279rRvJUo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gh2Jtk19ZZ0fNDofzaQM-qOvapr2S5SFxrRQpWhl9UA&oe=6A3BE6F7"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=RSTLatjunRAQ7kNvwEK0Kr5&_nc_oc=Adqy3VuDSuJAAKwsdxprRK4SD_sK1MjCMvNXGnNsOlnQJ2LWAWaa9akfoYeggU3TnQw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VsE7eKP9ldUzt4R4Mv9gE483RphrsHeIm5rBPCXATJA&oe=69FDCDB9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QypGeROkV1kQ7kNvwHgSUIa&_nc_oc=Adp7YR6COAcsxnhwcFXS73kGPUiB_KpdUHYncFBi2a9Bq_OgdkE4gBQrniQS2HYjLuk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b2RG4b_mFv3Y77hSFefcfIswmDYFfo6q3VgO-kgBW9g&oe=69FDF58B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy03c8b2tSwQ7kNvwGSk_3Y&_nc_oc=AdqZogZ9x7tfQr1_X6QNW-WBcAQ7xzqS065mvWZc3fpS1CEJ5Wn7J23NMK4szCyOJbc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7duf8Wcmck9EoITQCmrnahcPEx-aVuqOWr4dDT4WlF8g&oe=69FDD282"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dcpj_IA6gYAQ7kNvwGFxc9l&_nc_oc=AdqWBBbFpu5EN_upj5zFwZ7orNgmfNbARfK5-SQwK8D56Ip4F_P1xdSbgI_HA3SB9lk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y6P3GAFfYaFHu1CKUqU6a-zmGvOSQlCtKhS2kjr4w0A&oe=69FDDC4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic_jOuppzq0Q7kNvwEhbGol&_nc_oc=Adr_bnk6Qvm6Fo5CTSPLwFakKf4rkmpCk2NWEeDXzSS_rDtbdLWpt7MRn7UNV3om8jg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BEAlDRBbt6KW-AV39Wbhngc1QFRwYuTBx82SlVirpDA&oe=69FDF077"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
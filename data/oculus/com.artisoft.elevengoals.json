_sid=6e7a0a&_nc_ohc=fng7dSHVuGMQ7kNvwFIAIwK&_nc_oc=AdpWTUapKeLr0BaNtz99CpDKaAuLhaXwwIW0Qo19WR07Rhxo1TfN8ovRLILUBQtgQFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2piCUS-Anz1aL1hwSgzkHBJzguLvPnHit63WsN_Sjg8Q&oe=69D640B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZLVHmNUe8kQ7kNvwGk5vPU&_nc_oc=AdrXIrQTEzw5GfRzQtEY69YU_7sESE7yGv_KZBr3yLnYhIi4DvDNO7EX2nWrPn5lXk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39AkDsEVLoR-mWCpafq-6gRE0FO7vHt8Ncg8Fd6hfeKQ&oe=69D6688B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKAVrfXZUKMQ7kNvwFli8gd&_nc_oc=AdoYK1rUCBeyWcity0Igvv8coK5PyPNcjbf0j1fe0EpYm8Jyx7DfjMoys0-NyZTMeg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JpTGL4_AyQCLeIoenrF-qLQYXH7bVTrBS81aXmbvfZQ&oe=69D64582"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTLzP6tTwiYQ7kNvwFtGNMX&_nc_oc=AdpTxIX-AJy0G28pAiJybsJAlW1dQr7avgkBZghgjtoWKlJl0BQ7Rkwvv0Gzzo7ceAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sEAwSrMQBnMdHc0IxlHoZyq8BEFBL2fIy0Y9AnHyPnQ&oe=69D64F4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6PUVoQc4usQ7kNvwFkDpen&_nc_oc=Adon6DjAIFXbf6SkNH_c5SqhQYpRi2-Ahp8nBscls5t1Gyp0juAqMqA_P2Yxj2B9Xeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fdQItpyetrtU-ZeBaFFbePL-ssNCMJqm4S9Z1R82rZQ&oe=69D66377"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
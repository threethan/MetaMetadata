_sid=6e7a0a&_nc_ohc=Vjc-qFqSujkQ7kNvwGpr0s4&_nc_oc=AdpnenEfacvJ0-ooazVz8_syJLQHWqK_JjdFCR677ic98GluVzoo-2IM9d28Cb7gZek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBikeDxaTFTN5MT_x5phk_XXnz_-Xv4cneFQYnaFptBug&oe=6A6745B9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyf012V513sQ7kNvwFz9bVm&_nc_oc=AdrqYpmfIVrRJMpBUhOzypyq8QvocWCmn3CL179ZI4Go0yvusJKrsyNAglRj53t6ZxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC48b1nKKoY2AV0QL_MvoQNW4vOP6vqD_SZ7FKN31-kFQ&oe=6A676D8B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2HeJDtkrAYQ7kNvwF_EUwI&_nc_oc=Ado2UkHYOMAJXdx0t2ar4TsJdJclClriu1ggwSiw76GPij-hvbkXCVbfTm3S9Yt3I3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwK8ZwL8Fbyzxv8Hb7kO30AeUmDR01jmV0SjHedknFQQ&oe=6A674A82"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOUWTk3_cMgQ7kNvwEJuCrW&_nc_oc=AdrAUC1Z2FRdPH9yfAC-qzClmnKXzQV6Q60-hMtA1GYr6UvxRHB_BrQuSJGAGPBT_sA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyNvuTrW9LqCu1V2CSdT8b1rqLtjq8Y5Rgn1f9kMxaLg&oe=6A67544A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nozjrg_LeogQ7kNvwFZJeTa&_nc_oc=AdqI7aTKNA6I1wPGajrsux8pkYpjFY5zzGWciM4VpywokpYN-4-1Mbs_w6QZdvlVVc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd4haVGvJSaHldjET4voOwjVA7yjcP4d54zyK8sWwRfw&oe=6A676877"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
_sid=6e7a0a&_nc_ohc=hTVkym2RCEgQ7kNvwEuFRgc&_nc_oc=Adr8XZeKMuBhR_or2-GoTSMKzRsvyYkhlfBYAqYT4te7QAm7JtQQfKnXhSYHWASGMX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VeYuTzuZI2EbyQlRLxvdDmwoyB3VPaGzC5keFMeDBLg&oe=6A00A8F9"}, {"file_name": "sc6.png", "id": "819781943005946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_819781946339279_8313737698820743009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1Tq97hMWa4Q7kNvwHGTW5n&_nc_oc=Adpouf-Aod0ff8CBHaidVFhmN7QPvZaloNKeA4h03-NQ0MJ3r3PB6DqJYaA1sFACSDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O-MIllZzKATqzIAO6n4ztn6sRrkoHu7l6qSFILQt7GA&oe=6A00988B"}, {"file_name": "sc3.png", "id": "237404199186857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262745_237404202520190_7269246516171065302_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E7cULSXeXQQ7kNvwGQO4Yq&_nc_oc=AdrE1phT15s8UZ0JdEc_mC0C4snyUPulBdYV16vbvbu9WzqjlZWhAoAX96blGhUL0N0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QO4t9H6QUjoCYZFuZ477YsaoiOUSYuD0CSNHEK4fMRQ&oe=6A007582"}, {"file_name": "sc5.png", "id": "952024302762284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031636_952024306095617_8441863511266288354_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN_yD_jAMt4Q7kNvwGM1Ue7&_nc_oc=AdqN38GlgheH_5pgDWbnkDIWkL1FlAg_lsq5N3wloD03uE4ckgqmvAI974x90EdvQ9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qOS9dtBCbg5bLMJZDhO_WAupAeecXOROcs_eDhLypmg&oe=6A007F4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_1.png", "id": "960043135211891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_960043145211890_8988895673906674259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b5rEHEIX3IQ7kNvwEJo7rE&_nc_oc=AdrMwmrzIQnXgddH6mGpcjmKgHqcoSDBdDmRSVwm67R3qpEWo2zAKPSkCOW5Vy0gP9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uoh-Z2JXK0n4Lb8UrZgesdnR4y7qWrPbL8UQKxiQAjw&oe=6A009377"}, "display_name": "Eleven goals", "keywords": [], "long_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\nYou can also tune the shoe, so it will fit better as well as changing the power level.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic.\n\nWatch video on how to securely mount the controller to the feet. In few words:\n- Take the left controller\n- Mount strips on both sides of plastic ring\n- Choose leg and attach the default security fastening to it\n- Put shoe on or not - up to you\n- Use strips to secure controller on the foot so it will stay still\n- In game use shoe tune if needed\n\nWARNING. Always use the security fastening from Oculus Quest controller.\nRemember to have some space around you.", "short_description": "Use your foot - that's not a joke. Due to a specific mount of a left controller, you can actually kick ball with your foot like real football (or soccer) player. \n\nYou can select to practice:\n- Penalties\n- Free kicks\n- Curved shots\n\nFive levels of goalkeeper difficulty. \nIf you prefer, you can use targets instead of goalkeeper.\nAnd during free kicks you can have a wall blocking clear shot.\n\nNo need for additional equipment. All you need is two 1.5m/60\" strips of fabric, preferably elastic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/eg_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://eg.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
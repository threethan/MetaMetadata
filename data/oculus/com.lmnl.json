AfwDMA-38HPAFZlN3QSAwS3TEchLxf0IHJd3fj8DwcOiZg&oe=69AC1D1D"}, {"file_name": "Screenshot1.png", "id": "620365807263144", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394150_620365810596477_5547468967949396169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e5E0pO1Ed0Q7kNvwFVV3Sw&_nc_oc=AdlIiqyifNZa1nIQIRKJUQa-AzEOxViv8GGAAJi8UAoRfUYza4EOAbDNtYdkQVi3HsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcMG7zoPOGUgTygSEYIa7Lj2JmdnqHd0wBSSsBU2DSVA&oe=69AC2F2F"}, {"file_name": "Screenshot3.png", "id": "1141812137151670", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473397569_1141812140485003_4851237339752471444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAl51Mgeiy4Q7kNvwFv6C48&_nc_oc=Adm_L3OC8f1RaNurt4dkSJxYRqDi0lLOuBplfMqmd98mn1jNtTkGvyXZSnFuZKvC8aA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUTEEzd5EerLjZqeDSoIs_hv3RQ_GzaaFWV-Mo_hCeOA&oe=69AC1797"}, {"file_name": "Screenshot2.png", "id": "944327567900550", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392329_944327571233883_8311350117266277585_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uajPYsSTR_wQ7kNvwGiCtKi&_nc_oc=Admfb_GuX6Jrnk1G0TnXQmOwNpfYYrCYw58RLjN8iq_Ut-HE6QjcSWnEPC9B26zcDCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-KYSUXuuPL8747zXZ-9CNuy8vAae3MZBBRWZStI1ECw&oe=69AC0858"}, {"file_name": "Screenshot4.png", "id": "1325575162104181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392058_1325575165437514_3145618738552362827_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3IlsEq_sIMQ7kNvwHP637m&_nc_oc=AdlHHIQ-wwRJC0fOPiqlZHra2POv_oqbTC82I92RWEZr98Orfvd2CndVVCspJ6ZgAfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzly1y19J09L4FC7a0_IW94MI4OvwadhlPdnMrXvteypA&oe=69AC1522"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factions", "keywords": ["free", "building", "pvp", "questcam", "action"], "long_description": "**Explore an infinite map**\n\nIn Factions, everyone is in a single multiplayer world - shaped entirely by the community. Want to meet up with a friend? Just walk across the map to see them! Building something big? Bring your friends to help you out!!\n\n**Unlimited creativity**\n\nUsing a familiar voxel system, you can build just about anything with a range of block types. Create massive castles, city-scale megabuilds, or small creations from your favorite movie!\n\n**Your favorite locomotion**\n\nFactions matches the best building system with the best movement system. Move around the world by swinging your arms and parkouring off cliffs - its extra fun when you\u2019re deep underground mining!\n\n**Enter a new world**\n\nWhen you join Factions, you\u2019re joining a new world that is constantly being built and changed by players like you. Even just one person can start something world-changing!\n", "short_description": "Factions is a world built by its players!\n\nBuild whatever you can imagine in an infinite block-based world. Everyone in Factions lives in the same shared multiplayer server that you all shape together - what will your impact be?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thatswild.com/privacy-policy", "developer_terms_of_service_url": "https://thatswild.com/terms-of-service", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
wz8ZcnY1jVnzJG4fjny7fEwjmEeGV5bQMUJstq0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNa-Sd2KBHjB0-BCeKdgplgWBy_dfkaS24prA3fIisaQ&oe=6B086C89"}, {"file_name": "Avatar Group.png", "id": "1718180722159729", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822034_1718180725493062_2053514633123286064_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WmhFNITjzAQ7kNvwEkAVKB&_nc_oc=AdqBDM94fYfBAn2_nl41ZI7UB4nrxCDk9uoaHSMTOVpYbuUihHCSlHm_NcZYpM08Qr0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsKT8yuIYnLn57FNa-ph9M3_SuHthaBgmnHdcBbv6tdA&oe=6B0847A5"}, {"file_name": "Circus Faction.png", "id": "726413900279688", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499311562_726413903613021_3086221891199492449_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLpLzc7ih0MQ7kNvwFK1DD3&_nc_oc=AdqMEbRY_mglthLC2VuVTa0xhYqv66vDtTTqu-gij_5sX3w6jSED4YwSqdkMAfk7ApY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqDLkU-SUFS__Ky6rbU6x6jbwmhtQ5Zr6pdQK1tVkUWA&oe=6B084B9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factions", "keywords": ["free", "building", "pvp", "questcam", "action"], "long_description": "**Explore an infinite map**\n\nIn Factions, everyone is in a single multiplayer world - shaped entirely by the community. Want to meet up with a friend? Just walk across the map to see them! Building something big? Bring your friends to help you out!!\n\n**Unlimited creativity**\n\nUsing a familiar voxel system, you can build just about anything with a range of block types. Create massive castles, city-scale megabuilds, or small creations from your favorite movie!\n\n**Your favorite locomotion**\n\nFactions matches the best building system with the best movement system. Move around the world by swinging your arms and parkouring off cliffs - its extra fun when you\u2019re deep underground mining!\n\n**Enter a new world**\n\nWhen you join Factions, you\u2019re joining a new world that is constantly being built and changed by players like you. Even just one person can start something world-changing!\n", "short_description": "Factions is a world built by its players!\n\nBuild whatever you can imagine in an infinite block-based world. Everyone in Factions lives in the same shared multiplayer server that you all shape together - what will your impact be?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thatswild.com/privacy", "developer_terms_of_service_url": "https://www.thatswild.com/terms", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30686715810943165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394113_3891566097749362_8976307208935441375_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeyhFI43GNMQ7kNvwGuTITB&_nc_oc=Adp_nUndmR0TJLLcSob0fV1SBFs4gTnm0Ep6Cc2xkEB2qOJlIE9dw5Dzo6VnyExsLf4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaxTQUN-waJqiDothihvzAV3SLQc6x_5NY8VYoZC5nZA&oe=6B085D3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Factions", "
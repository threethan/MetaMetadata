LV24sIGw45i1myJUTFempD5RKTEuIyG4cB1oxn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkUXT9PEKU1Pq3h15RJ2bGHEX5RH7eT5Dbc1uqZuMr7Q&oe=6B008389"}, {"file_name": "Avatar Group.png", "id": "1718180722159729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822034_1718180725493062_2053514633123286064_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5G0dCZ9RwIQ7kNvwFs60Wg&_nc_oc=AdoTW7PA5E1fg93r6et0d_KOJLhTLFUQor71mMx5fZ65eKwUp1uxzmhFlwotfO1jeUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpbmwFz8XuxOCfp6-RpIGOwyPrg76xRD_POkbCKL5bEw&oe=6B005EA5"}, {"file_name": "Circus Faction.png", "id": "726413900279688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311562_726413903613021_3086221891199492449_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HRcdC73KH4Q7kNvwFQ6goE&_nc_oc=AdoniyGYMI5t6VV5bSwJLI6pmMHhZxdmyFvrHvc8GpbedWKvQo6TZf98WcPD5SPcFC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3NREco14efZqZZSjbZfFHgv2duZAQP37zQnVXgYdUgg&oe=6B00629B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factions", "keywords": ["free", "building", "pvp", "questcam", "action"], "long_description": "**Explore an infinite map**\n\nIn Factions, everyone is in a single multiplayer world - shaped entirely by the community. Want to meet up with a friend? Just walk across the map to see them! Building something big? Bring your friends to help you out!!\n\n**Unlimited creativity**\n\nUsing a familiar voxel system, you can build just about anything with a range of block types. Create massive castles, city-scale megabuilds, or small creations from your favorite movie!\n\n**Your favorite locomotion**\n\nFactions matches the best building system with the best movement system. Move around the world by swinging your arms and parkouring off cliffs - its extra fun when you\u2019re deep underground mining!\n\n**Enter a new world**\n\nWhen you join Factions, you\u2019re joining a new world that is constantly being built and changed by players like you. Even just one person can start something world-changing!\n", "short_description": "Factions is a world built by its players!\n\nBuild whatever you can imagine in an infinite block-based world. Everyone in Factions lives in the same shared multiplayer server that you all shape together - what will your impact be?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thatswild.com/privacy", "developer_terms_of_service_url": "https://www.thatswild.com/terms", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30686715810943165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394113_3891566097749362_8976307208935441375_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRQHUpvB2JcQ7kNvwH8gMJ0&_nc_oc=Ado8548Y2O8FVmLdLnslPnIUTmneaEB68quIJn3AUZ-6TRskBHapVJzuvgUL7EXeMHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2STem8kLZDQNJDOpM6T4OXG9gbvEmkd-ufWnifsorow&oe=6B00743F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Factions", "
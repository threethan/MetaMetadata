wG3HrUzS4OHH_A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oAyUp7mmgbBrFAqQwUckTwbfRNEQOGw2FU6qoRUNnwA&oe=6A0C5A9D"}, {"file_name": "Screenshot1.png", "id": "620365807263144", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394150_620365810596477_5547468967949396169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znHPuwAQcFcQ7kNvwEHJhU2&_nc_oc=AdolBu0Vg84gjhitkvIuQ2qi43jEYiGloMRozV8QVrN12PD0cQqSw8IznF0NfkN6-js&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42HM2hvon4X0uCXgQVk_NrFVa-POqos0DDgd1IWOH_AA&oe=6A0C6CAF"}, {"file_name": "Screenshot3.png", "id": "1141812137151670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473397569_1141812140485003_4851237339752471444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_eFtYAOf5QQ7kNvwHYUVJC&_nc_oc=Adr-3ltcHiPZwHp0k9NkcOIzCqVRqdlHXZJ_N0ELr7BIhfmxdwnxGntF69mzVJHuJgM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kIQz3E1FHgXzcMXEHOkZ07w3iguY9q5wbCo816dwo9Q&oe=6A0C5517"}, {"file_name": "Screenshot2.png", "id": "944327567900550", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392329_944327571233883_8311350117266277585_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLKKc6KalxUQ7kNvwF-PUGx&_nc_oc=Adqbpwd70qTC1tOdQBNjqE6siUPlVRzkZ8JtvBuZt_XFE4BO1qntfOGN6EDXuULTV-0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LMnjgRo7wc3pBKeNlnupiyRSNJ4eBT17xNJUQDzipYA&oe=6A0C7E18"}, {"file_name": "Screenshot4.png", "id": "1325575162104181", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392058_1325575165437514_3145618738552362827_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGfAcMtQduMQ7kNvwEVXbg9&_nc_oc=AdqZAEADmdPURewTMScmd5WRztrv8TCKl2ku2gW20M7QXXA81H6KJleItNosyISx7-A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ISXt_02zz6YvVx1owSzWv7YJjuzyGMiVHNeKb1AnS9w&oe=6A0C8AE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factions", "keywords": ["free", "building", "pvp", "questcam", "action"], "long_description": "**Explore an infinite map**\n\nIn Factions, everyone is in a single multiplayer world - shaped entirely by the community. Want to meet up with a friend? Just walk across the map to see them! Building something big? Bring your friends to help you out!!\n\n**Unlimited creativity**\n\nUsing a familiar voxel system, you can build just about anything with a range of block types. Create massive castles, city-scale megabuilds, or small creations from your favorite movie!\n\n**Your favorite locomotion**\n\nFactions matches the best building system with the best movement system. Move around the world by swinging your arms and parkouring off cliffs - its extra fun when you\u2019re deep underground mining!\n\n**Enter a new world**\n\nWhen you join Factions, you\u2019re joining a new world that is constantly being built and changed by players like you. Even just one person can start something world-changing!\n", "short_description": "Factions is a world built by its players!\n\nBuild whatever you can imagine in an infinite block-based world. Everyone in Factions lives in the same shared multiplayer server that you all shape together - what will your impact be?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thatswild.com/privacy-policy", "developer_terms_of_service_url": "https://thatswild.com/terms-of-service", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
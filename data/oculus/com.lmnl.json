&_nc_sid=6e7a0a&_nc_ohc=oUanLZOB_kwQ7kNvwG9ktBu&_nc_oc=AdqwgNrdelpMSMgkccF1Dx2eRX2Q_MgjFih87fShvZZqFqS3LTw4patprG9sbrEr_-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VboAI3WGjxTGEHVYbM9-U3thP5Yd6qSeiA7w-q4aBCg&oe=69EB83A5"}, {"file_name": "Circus Faction.png", "id": "726413900279688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311562_726413903613021_3086221891199492449_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVS0R6SrZHUQ7kNvwHad6ud&_nc_oc=AdpcxoeDx_fTqmd4ibcuVj9ecoHjl7byah_jrr0zOCv12VBns2d02gjCGwK35ySPbys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ROw1j0xUAjKUR7wiu8toBIdpALxMVNwUCAXUbFVEiBA&oe=69EB879B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factions", "keywords": ["free", "building", "pvp", "questcam", "action"], "long_description": "**Explore an infinite map**\n\nIn Factions, everyone is in a single multiplayer world - shaped entirely by the community. Want to meet up with a friend? Just walk across the map to see them! Building something big? Bring your friends to help you out!!\n\n**Unlimited creativity**\n\nUsing a familiar voxel system, you can build just about anything with a range of block types. Create massive castles, city-scale megabuilds, or small creations from your favorite movie!\n\n**Your favorite locomotion**\n\nFactions matches the best building system with the best movement system. Move around the world by swinging your arms and parkouring off cliffs - its extra fun when you\u2019re deep underground mining!\n\n**Enter a new world**\n\nWhen you join Factions, you\u2019re joining a new world that is constantly being built and changed by players like you. Even just one person can start something world-changing!\n", "short_description": "Factions is a world built by its players!\n\nBuild whatever you can imagine in an infinite block-based world. Everyone in Factions lives in the same shared multiplayer server that you all shape together - what will your impact be?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thatswild.com/privacy", "developer_terms_of_service_url": "https://www.thatswild.com/terms", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30686715810943165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394113_3891566097749362_8976307208935441375_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcjL2AaTPBkQ7kNvwHzfuUO&_nc_oc=AdqRddO8uAejwHlBhmMBbUs5_tCleZLYtpGGmvbovL6eCDHEH9p0jzSCsPvEFSLpsu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fQ4ELEW7kFqOc52B0SkuwokR-O_quY2GpKpB50u58Hg&oe=69EB60FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Factions", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "World Creation", "id": "1725996564472128"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1740471300, "lastRevision": {"nodes": [{"id": "28354413474173422", "release_type": "SCHEDULED", "administration_status": "APPROVED", 
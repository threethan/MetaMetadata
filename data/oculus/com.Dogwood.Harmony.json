.com&oh=00_AftImu3pmjMjc8B4sbnXsqZofTTi0e47_Vpuqf6UQ0VEOw&oe=699EF002"}, "display_name": "HarmonyVR", "keywords": [], "long_description": "Introducing HarmonyVR a DEI (Diversity, Equity, and Inclusion) training application, meticulously designed for workplace environments seeking meaningful and measurable progress. Our platform revolutionizes DEI training by offering meticulously crafted content aimed at fostering impactful learning experiences. Harnessing innovative technology, we empower organizations to quantify progress and track the tangible impact of their diversity initiatives. Elevate your workplace culture and drive meaningful change with our comprehensive DEI training application.", "short_description": "Empower your workplace with our DEI training app - HarmonyVR, forging impactful, measurable strides in diversity and inclusion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualapprentice.net/privacy-policy/harmonyvr", "developer_terms_of_service_url": null, "publisher_name": "Virtual Apprentice", "support_website_url": null, "website_url": "https://www.virtualapprentice.net/portfolio/harmonyvr-dei-training", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24628110500137502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031434_1546844719422759_5621208483851980872
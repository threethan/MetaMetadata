nters, healthcare, and other essential industries.", "short_description": "The Career Explore XR project app allows middle and high school students to explore several potential career opportunities in technical trades, healthcare roles, as well as other career paths that don't necessarily require a 4-year degree, all within an extended reality environment. This experience will highlight how these careers support critical sectors such as the construction of AI data centers, healthcare, and other essential industries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.careerexplorexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska - Lincoln School of Computing", "support_website_url": null, "website_url": "https://www.careerexplorexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26423052437313916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_35882038151394801_4088792664084957709_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIPqMRstBXgQ7kNvwEkIREM&_nc_oc=AdoVXUOeZl3OlV1gtcbrIaedSAdqYQGkJlIDoKGc6qLmNf-QBLhEviALdNJ1zOa6krI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yJi5D_DAXVV59ax9TBmw46CkTghAHuTvbm1eFERc-RQ&oe=69E4DF4C"}, "is_concept": 
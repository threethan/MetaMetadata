, "id": "1025570511870949", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031478_1025570515204282_6839053392602625422_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gOJT8RTbD8Q7kNvwH8Xqsi&_nc_oc=AdqIxkrZPNMT1G-HxPaG7hdYJDPQ3LhzTP-qmjNocvEDtaOeeD1M5wnFXmiURx0rtJ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LUqicSf5xyZdiJ_DrpDQQqYxt6HYVeOCSU36hOllKyQ&oe=6A368FEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape zoodemo L5.png", "id": "1225668101657721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982656_1225668104991054_2069936562898724076_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpR0xgMLBGgQ7kNvwGZOp0w&_nc_oc=AdoFtyA0WEfhCrK1ax43d7q8TBk9b_78fHlj72iqYbjljQ1kEPnFNKfs7c7Lqj5-0O0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98-bqVMwrhZnktv4DlaOkY8zDZa62gWrFfAmgoLRc8Fw&oe=6A36B3D1"}, "display_name": "ZOSU Zoo Demo", "keywords": ["Zoo", "demo", "mixedreality", "Handtracking", "Animals"], "long_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents:\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality and hand tracking preview area with sea turtles, and some plants and animals\n- ZOSU Ocean area lobby\n- 360 degree background video background beach area with toy sized animals\n\nThe full game has 140+ animals and over 60 jungle plants in various mixed reality and hand tracking experiences with mixed reality visual boundaries and save state options in some areas, 30 ocean areas with a water jetpack, and 3 areas with 360 beach videos with toy sized animals or ocean creatures in each.\n\nMajor Updates:\n- February 2025: added 360 beach video background area with toy sized animals into the demo, and updated zoo main area based on latest main game updates\n- July 2024: add mixedreality + handtracking and ocean areas, with Quest1 being restricted to the original build only with the classic ZOSU Zoo Land.\n\n", "short_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality & hand tracking preview area with sea turtles, some plants & animals\n- ZOSU Ocean area lobby\n\nThe full game has various mixed reality & handtracking experiences with mixed reality visual boundaries & save state areas, & 30 ocean areas\n\nMajor Update\nFeb '25: 360 beach background + toy sized animals\nJuly '24: mixedreality, handtracking, ocean\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9564524286943121"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974528_567155941746303_7466232929525964652_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffg55gRg9moQ7kNvwHRu9_3&_nc_oc=Adpp0c6eTYaJ0GIe_nBtGB4ZodJR9tOiWvNwihMGGtCE5ks-SUFntvJ6dw4uN9cFejo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qBLwsFbWq9ec-H0kmlDSkR20FI4gkX874q9nkoDzuiQ&
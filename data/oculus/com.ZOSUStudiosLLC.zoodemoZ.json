/v/t64.5771-25/473393516_593727613443397_9082621776505936423_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_beT5U3nZUQ7kNvwFQ2OjF&_nc_oc=AdqfbzbZah3f3IuCw_ZTrLhZ8Na5qiDQRI1vQRYDJ_1WF3_O3nWvBKoNurU1CmbwbB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY92yrFGEHo-hLQQdqqkrOl3_GPaQPob7cGuYnCa5M7w&oe=6B07121A"}, {"file_name": "38982598_757493415437974_7947178304642023197_n.png", "id": "1207184963804334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031376_1207184967137667_6052624936629164703_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV0MxWxSd9IQ7kNvwGIMX8l&_nc_oc=AdpCjHtJ3Cp8I42YMWWRx_I-7aa-phiga95eTxwwGO75Y9u7Qgi4l-GFU76tNNevVEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHKDiwENq5p3pALYd0CFIiapm-eoZied9emEZI0J5BVw&oe=6B06FA37"}, {"file_name": "38982522_736624027988683_4471170494291747145_n.png", "id": "1025570511870949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031478_1025570515204282_6839053392602625422_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8ZGken0OXEQ7kNvwHOlPZo&_nc_oc=Adp636w9jPyxSm4Of-WBk3gGaEKtAdFy62hPH0admYozC71xRCQViz_XQEQD30jVsUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1_nywmGFDmz-op1RHb6C4osPbLGgloKOQCBXHvSX4sw&oe=6B07152F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape zoodemo L5.png", "id": "1225668101657721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982656_1225668104991054_2069936562898724076_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoakGECzO6MQ7kNvwEc9OD4&_nc_oc=AdoN5_5874_tu5AY2ZqMe4T88uzvvyXeLtAIsL9NrwO60JWiXaWl4OkTsEfw11PWH7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHTCqvDLP0Kr8Au_mlIdznUbKWDya_pkLfPc1wOSFY_Q&oe=6B0700D1"}, "display_name": "ZOSU Zoo Demo", "keywords": ["Zoo", "demo", "mixedreality", "Handtracking", "Animals"], "long_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents:\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality and hand tracking preview area with sea turtles, and some plants and animals\n- ZOSU Ocean area lobby\n- 360 degree background video background beach area with toy sized animals\n\nThe full game has 140+ animals and over 60 jungle plants in various mixed reality and hand tracking experiences with mixed reality visual boundaries and save state options in some areas, 30 ocean areas with a water jetpack, and 3 areas with 360 beach videos with toy sized animals or ocean creatures in each.\n\nMajor Updates:\n- February 2025: added 360 beach video background area with toy sized animals into the demo, and updated zoo main area based on latest main game updates\n- July 2024: add mixedreality + handtracking and ocean areas, with Quest1 being restricted to the original build only with the classic ZOSU Zoo Land.\n\n", "short_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality & hand tracking preview area with sea turtles, some plants & animals\n- ZOSU Ocean area lobby\n\nThe full game has various mixed reality & handtracking experiences with mixed reality visual boundaries & save state areas, & 30 ocean areas\n\nMajor Update\nFeb '25: 360 beach background + toy sized animals\nJuly '24: mixedreality, handtracking, ocean\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_c
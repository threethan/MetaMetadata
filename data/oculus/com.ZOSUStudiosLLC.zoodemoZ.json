0a&_nc_ohc=hcU0vJmXWB4Q7kNvwEQcpXn&_nc_oc=AdqIDRBPTQ_aicD_hJOt9-cDqv-cMwEtyf7gilzliOAqjLzepUGHtTbN3ybxZyfNk5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWwP6rssH4fjpRMRSw7TTSR64xNWd67dwAysUHEQSrDw&oe=6B046F1A"}, {"file_name": "38982598_757493415437974_7947178304642023197_n.png", "id": "1207184963804334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031376_1207184967137667_6052624936629164703_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSpNQNOzRkEQ7kNvwFkk0OX&_nc_oc=AdrBEc5QnSe42pc8d8XQ3gSsOgFbiVh2zzM-zJvlYAuCuVmLyZFIK5jxxLQ4qSBd1S0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTms7tSe4Boyo_CJL5751ZZAAYl8sLSTm9XpX8MV3nJxg&oe=6B045737"}, {"file_name": "38982522_736624027988683_4471170494291747145_n.png", "id": "1025570511870949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031478_1025570515204282_6839053392602625422_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYYQYWJwzVQQ7kNvwEfb3-i&_nc_oc=AdrDWGDWQijxV6mYFEaObMN2ZPTnOg5oU05a7p-2YVQNCsdIxpUneSjGb_G7lAYipho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG45CL9fomuRYlkuBtgpFRr6IHmAYM5KOIamWLVedf2g&oe=6B04722F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape zoodemo L5.png", "id": "1225668101657721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982656_1225668104991054_2069936562898724076_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoakGECzO6MQ7kNvwEpm5pA&_nc_oc=AdpugbEwI9RTynzRRHHL3XArIXOKdM2vXZgLnbQQiugDNU_JAQw5TmjYaTQfxSreum0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT_3ARMaJ6VvoH2D8tCXNOP2jQ7KXOVCQzqRb2rFnAUA&oe=6B045DD1"}, "display_name": "ZOSU Zoo Demo", "keywords": ["Zoo", "demo", "mixedreality", "Handtracking", "Animals"], "long_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents:\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality and hand tracking preview area with sea turtles, and some plants and animals\n- ZOSU Ocean area lobby\n- 360 degree background video background beach area with toy sized animals\n\nThe full game has 140+ animals and over 60 jungle plants in various mixed reality and hand tracking experiences with mixed reality visual boundaries and save state options in some areas, 30 ocean areas with a water jetpack, and 3 areas with 360 beach videos with toy sized animals or ocean creatures in each.\n\nMajor Updates:\n- February 2025: added 360 beach video background area with toy sized animals into the demo, and updated zoo main area based on latest main game updates\n- July 2024: add mixedreality + handtracking and ocean areas, with Quest1 being restricted to the original build only with the classic ZOSU Zoo Land.\n\n", "short_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality & hand tracking preview area with sea turtles, some plants & animals\n- ZOSU Ocean area lobby\n\nThe full game has various mixed reality & handtracking experiences with mixed reality visual boundaries & save state areas, & 30 ocean areas\n\nMajor Update\nFeb '25: 360 beach background + toy sized animals\nJuly '24: mixedreality, handtracking, ocean\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
\"\n- This is a relaxing and simple zoo experience with 40+ land animals to see, restricted access in the demo with fence (can't see all)\n- Also on mostly random spawners there are an additional 100+ sea creatures (they will not all be visible each play session), restricted access in the demo with a fence\n\nGameplay:\n- In the demo there is a fence, the full game has no fence with full exploration available\n- Run and jump to find the eagles! (climbing in full)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613916916993387"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "627994379632893"}, {"status": "PUBLISHED", "id": "3026142301025666"}]}, "baseline_offer": {"id": "627994379632893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737107160, "status": "PUBLISHED", "id": "627994379632893"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9567177900011093", "version": "755"}, "id": "5403398216372454", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__
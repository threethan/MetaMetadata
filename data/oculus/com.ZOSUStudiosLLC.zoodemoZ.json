=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeFEKS-CKUC3ERDWUnPhFMjJtsMIVCSe2PnRnp9dXCJA&oe=6AFB349A"}, {"file_name": "38982598_757493415437974_7947178304642023197_n.png", "id": "1207184963804334", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031376_1207184967137667_6052624936629164703_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjr8udJPUnMQ7kNvwGLJuJh&_nc_oc=AdoHGqldczauH_ij08KRZjSBVN_fau_SelRCjYt_o3Sr_FxhlvbQbG32lpTtW-f9eP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2rMKyUvQpaVUJzheb_7QbRuobqntjQVlhAjBVJpS3TQ&oe=6AFB1CB7"}, {"file_name": "38982522_736624027988683_4471170494291747145_n.png", "id": "1025570511870949", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031478_1025570515204282_6839053392602625422_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8UlNGRSImoQ7kNvwE8VSlb&_nc_oc=AdoMDM01pPGIoGXv7Y89LnUq-Z3uPzoIkK6cXACqWZvibnWGF2T2jWq2OSX-YhnCja4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2aLZmXgilX_v1jZQUfubDGXAEqpoxps4VE_46HKbecA&oe=6AFB37AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape zoodemo L5.png", "id": "1225668101657721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982656_1225668104991054_2069936562898724076_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2h8HCv_OuYQ7kNvwHZf0Bs&_nc_oc=AdrOSCg5lIfZ7ccDAC9LNRcmsjjKYxX3Iw5Qe6imDuif6fVo07XbKdUB_-6hGZlA8PA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcAOY4-RgFt5ilj_GtTS-0dw-nZanepY_mnjW6cESC7Q&oe=6AFB2351"}, "display_name": "ZOSU Zoo Demo", "keywords": ["Zoo", "demo", "mixedreality", "Handtracking", "Animals"], "long_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents:\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality and hand tracking preview area with sea turtles, and some plants and animals\n- ZOSU Ocean area lobby\n- 360 degree background video background beach area with toy sized animals\n\nThe full game has 140+ animals and over 60 jungle plants in various mixed reality and hand tracking experiences with mixed reality visual boundaries and save state options in some areas, 30 ocean areas with a water jetpack, and 3 areas with 360 beach videos with toy sized animals or ocean creatures in each.\n\nMajor Updates:\n- February 2025: added 360 beach video background area with toy sized animals into the demo, and updated zoo main area based on latest main game updates\n- July 2024: add mixedreality + handtracking and ocean areas, with Quest1 being restricted to the original build only with the classic ZOSU Zoo Land.\n\n", "short_description": "Demo of \"ZOSU Zoo\"\nThis is a sample of ZOSU Zoo, demo contents\n- ZOSU Zoo Land with a fence to restrict where you can go (no fence in full)\n- Mixed reality & hand tracking preview area with sea turtles, some plants & animals\n- ZOSU Ocean area lobby\n\nThe full game has various mixed reality & handtracking experiences with mixed reality visual boundaries & save state areas, & 30 ocean areas\n\nMajor Update\nFeb '25: 360 beach background + toy sized animals\nJuly '24: mixedreality, handtracking, ocean\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
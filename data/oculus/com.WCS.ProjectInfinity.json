https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308217_1081296843937716_3219348314232235901_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IcikkWZoT8Q7kNvwFX1mXF&_nc_oc=AdmGjSIZBH3OA4jA852NMzCfJ30twhsMMmtEFE-ar3C5qziHk2ZFiUjahaCJY2UMTDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzey1GTknSxFFoLYre8N7ymCRSheBQXoGQu8moxbvE_Ng&oe=69AD5B22"}, {"file_name": "pi_screenshot_3.png", "id": "985358530191303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619185_985358533524636_4551907484751322037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuBqReL815AQ7kNvwGXsJS7&_nc_oc=Adn4y6FTWKR811sjVwW3ijCh1vgkjfb8XF9M3mNkGxEQ0EQpotP8DDBWA9FGqek9Iy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4zvRPC_GqueoPU24gFsTQjRLwh6ETRTjOctSC41T14Q&oe=69AD6DFE"}, {"file_name": "pi_screenshot_4.png", "id": "755616923477999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295658_755616926811332_4471586807576819723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxbhyVCayp0Q7kNvwE8U2D0&_nc_oc=AdmqaoeNirKIgkvZ-4pH7DMlW848qMU7QaSZSkQjBDI2--TIAaZspoygmjppbzDeNsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEMHXX3eWPBqJYkr91O3N9MO3lHx9uUV_62e1pNlTx3w&oe=69AD6FCD"}, {"file_name": "pi_screenshot_5.png", "id": "762645679621327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_762645682954660_4257554240914676856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJWWtKS_VsYQ7kNvwGJP2iq&_nc_oc=AdlsCKPNbBqZy86ywqqopFE-7jUaICpzTa1sqUKigTJaEwe_U9H7A6wmyN-sCzadMj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJdvkG1X99NTe89b5UStC3Vyv69ux2p3nMTd3QPNOr6g&oe=69AD6DCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pi_cover_landscape_2560x1440.png", "id": "1024448233187842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308245_1024448236521175_201586701071484204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Up2zHd4y7sQ7kNvwEd3r-d&_nc_oc=AdmXDAFhHRnIfnwjOnJjtbQmYeDv8JvNOEc94m7mY2SHUjTLG9wNwc-w6KzMcqZyO7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE2qRvTdS6UvWPZkJQw4lXXDIN8V6GRdCr4c7P4j9PZQ&oe=69AD86D6"}, "display_name": "Hotel Infinity", "keywords": ["Puzzle", "Roomscale", "Exploration", "Atmospheric", "Room"], "long_description": "Welcome to Hotel Infinity, where every detail has been prepared for your arrival. Every corridor leads somewhere you\u2019ve never been, and no room is ever quite the same. Explore at your leisure, but don\u2019t wander too far.  \n\nThrough clever use of portals, lifts, impossibly winding hallways, and other technical tricks, Hotel Infinity gives the sense of vast exploration in a 2x2 meter space. Combining the familiar with the eerie, the plausible with the implausible, this is a revolutionary experience pushing VR to the  limits and beyond.  \n\nWe hope your stay is eternal.  \n \n**Features:**\n\u25cf  A mind-bending VR experience from the creator of Manifold Garden \n\u25cf  Roomscale-first design, creating vast spaces to explore in a 2x2 meter square \n\u25cf  Laryssa Okada (Manifold Garden) returns with an original soundtrack \n\u25cf  Navigate impossible spaces and solve enigmatic puzzles", "short_description": "At Hotel Infinity, every detail has been prepared for your arrival. Every corridor leads somewhere you\u2019ve never been, and no room is ever quite the same. Explore at your leisure, but don\u2019t wander too far. Designed entirely for roomscale VR, the hotel unfolds around you in  impossible ways.  \n\nWe hope your stay is eternal."}]}, "developer_name": "Studio Chyr", "developer_privacy_policy_url": "https://hotelinfinityvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio Chyr", "support_website_url": null, "website_url": "https://hotelinfinityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAM
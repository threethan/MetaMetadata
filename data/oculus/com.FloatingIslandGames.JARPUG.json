b=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw5NI-8CdPYQ7kNvwGNZ-qq&_nc_oc=AdqxWas3cOBFpBPFno7Yv-bIYPlBJlcGS-BMaoQJXn8TlOoHaia1Sw_kdx9KdciuRCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJiL5r9DsVmzocCmoLFOJswQdk8bH3h6JA8m8UfOIknw&oe=6A576E15"}, {"file_name": "vlcsnap-2023-06-21-12h40m03s566.png", "id": "255004630505301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035381_255004633838634_8188545989358915185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBhCBheVq9AQ7kNvwEz9kjw&_nc_oc=Adr210uielW69V_bYxQySn-tpubEAm4w1Ij7VYrMXdQLnzENbQECEE6HC7x8dD6o9kQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAlZWgSgoyX0bIzUtIuVGnOg9Y5_49R4S8OTs-QcWLVQ&oe=6A578181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Jarpug-alpha05-cover-2560x1440.png", "id": "570165148644320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982698_570165151977653_9176715864354609953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pT6tVjGVyncQ7kNvwEHqPxT&_nc_oc=Adr0vog_2r9FxauOfDnKFmQAQVBk700wC74yNTs1FtELfelyXPQsM_opjImEniCejIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH3rGDi8O9I7PJrhonp0gy6cH9DEiWDs2gfvNBEjTpiw&oe=6A578EB6"}, "display_name": "JARPUG", "keywords": [], "long_description": "JARPUG is a JRPG about a pug with a jar on her head. Help Pug and her friends explore a 3D platformer world and fight in turn-based RPG battles. Designed for VR and flat screens, either way is a great way to play! Explore the magical, fantastic world of the modern dog.\n \nPug's Tall One is missing, but she's surprisingly good at turning ghosts into goo with her head-jar. Help Pug and her friends fight through these bark barking ghosts in sweet turn-based combat and save some Tall Ones (that means humans).\n\nSome of the things you'll do when you play JARPUG:\n* Run around, dodge and parry in turn-based combat\n* Solve platforming puzzles using your ghost hands and tiny dog friend\n* Go to Pet Hell\n* Knock ghosts into deadly puddles of dubious origin\n* Hit combo crystals to boost your stats while building up combo points\n* Combo any attack with your teammates! Yes, you can make bad decisions with this\n* Dress your dogs in the finest battle garb, including scarves and lost sunglasses\n* Find coins and treasure\n* Rescue humans from a crystal hell prison\n* Pounce on enemies for an advantage in combat, or avoid them entirely\n* BARKIN' BARK THOSE GHOSTS A NEW BARK ", "short_description": "JARPUG is a JRPG about a pug with a jar on her head. Help Pug and her friends explore a 3D platformer world and fight in turn-based RPG battles. Designed for VR and flat screens, either way is a great way to play! Explore the magical, fantastic world of the modern dog. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jarpug.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Floating Island Games", "support_website_url": "https://jarpug.com/feedback", "website_url": "https://jarpug.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "297627686042938"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "370216188851648"}, {"status": "PUBLISHED", "id": "992877021885269"}]}, "baseline_offer": {"id": "370216188851648"}, "is_approved": true, "firstOffer": {"nodes": [{"st
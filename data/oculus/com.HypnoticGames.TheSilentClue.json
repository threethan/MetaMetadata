7680"}, {"file_name": "Cover3.png", "id": "816970730851396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304131_816970734184729_4132683642427698959_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK8GgSN6rVIQ7kNvwFvRnMF&_nc_oc=AdpTMXorF0CDFT3GNzPaXQ99eCxWHrpTMGWw3R4qTYyOAHyxNBa5cZ_IsOCPb1bQBMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcJKUQ30zNYnvUjnzm13P2lwHMFi6o2o8KVbSvRdFq6Q&oe=6A997C23"}, {"file_name": "Cover5.png", "id": "1465969001306182", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_1465969004639515_4803768927154576837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSM73AUkwkcQ7kNvwHmVKzS&_nc_oc=Ado-X5WZsc1EfeY6dPQQS3G2SvG2Wfr2EliKOuiunhwOFUIFfPprKHGdxAbeWNKRqWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFj_pzKyMP7XzIpzB4JCBu5NRDGCOuf2gJ8yCsLWpnBw&oe=6A996FF2"}, {"file_name": "Screenshot (41).png", "id": "852810053803346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307435_852810057136679_7646392224024364466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zve8icqumZkQ7kNvwHk2rKX&_nc_oc=Adq9pGwX2k7sRhwlFNHbyZBNezqhG7Ihqqwd4z1e8uoNSdYsIfZr2alQ0UyNaiNvUjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqyB70ZrleEKXXMPYnp1ETFtuVygcK2sH9jUjZkgrig&oe=6A998313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819511_1987824048664940_8191741301069026356_n.png", "id": "2078320226238427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_2078320229571760_3874311139698454901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZuCZ65oymkQ7kNvwHx0MW6&_nc_oc=AdoSvNOjUrVBU3a3CS3Bl-kEF0HzTnFNBUsx9Fgcca3zsUtRUkrfPfK7qTXb5taZAng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv9Bedf71YVYvIQtB10aZX0P90KyVqGq4vUX3O-o-kgg&oe=6A99A375"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective", "Mystery", "Survival"], "long_description": "Escape Room VR: The Silent Clue throws you into a psychological nightmare where fear, puzzles, and dark storytelling collide. In this immersive VR escape room experience, every clue could save your life\u2014or drag you deeper into madness.\n\nA serial killer lurks in the shadows\u2026 You\u2019ll explore mysterious rooms: a blood-stained bedroom, an abandoned restaurant, a terrifying maze, and a haunted asylum. Newspapers, notes, and crime scenes gradually reveal fragments of the truth. The only way to survive is to solve the puzzles and uncover the story behind these murders.\n\nAlthough the core experience lasts around 30 minutes, every second is crafted with high-quality visuals, immersive sound design, and detailed storytelling to deliver a truly cinematic horror escape room.\n\n\ud83d\udcac Your feedback matters! Leave a review to help us improve and expand the game \u2014 your comments directly shape future updates.\n\n\ud83d\udc80 Love it or get your money back! If you didn\u2019t enjoy the experience, you can request a refund \u2014 no questions asked.\n\nEscape Room VR: The Silent Clue blends the best of Horror Escape Room and Psychological Thriller genres. Perfect for players who love scary escape games, murder mysteries, or haunted asylum adventures.\n\n\ud83e\ude78 Can you escape the rooms, or will you be lost in the darkness?", "short_description": "Solve dark puzzles in terrifying VR escape rooms. Can you survive the killer\u2019s game or descend into madness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://linktr.ee/The_Silent_Clue", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
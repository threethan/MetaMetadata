4280"}, {"file_name": "Cover3.png", "id": "816970730851396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304131_816970734184729_4132683642427698959_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQKq-ox1uxgQ7kNvwHhSFzV&_nc_oc=Adq4OClp1tGYRe8N7-Hb_EzaF1tzvdWissRTMUsb3By0g60c-RNHiNnQZ5MIhPjxG44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mbmSgUp9Cafeeykr1jxQQWu9dzZ6prgLdF1oBBuEIow&oe=69FB4823"}, {"file_name": "Cover5.png", "id": "1465969001306182", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818938_1465969004639515_4803768927154576837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vbrf6VXzVHYQ7kNvwHcHs4d&_nc_oc=AdopI6TmtAKrHn7HVGol0Hra0bvFDPRXgaeVz60tofoMlAeG8jDwh-tTSx_gZwUfYZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QKx9MEJwRwjHuLJ9zbb_Wd2E-EuIy7RcCH9ljONtWeA&oe=69FB3BF2"}, {"file_name": "Screenshot (41).png", "id": "852810053803346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307435_852810057136679_7646392224024364466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u3aKaKTsH8Q7kNvwHDjchE&_nc_oc=AdoJqjmcwT3tvgNRNJGiwd5OPSLK3bnfwKJmQGHcMgrcIyJNij_egFXJL3qIr05lmJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kWRcWeK9jVqlqaX1_aLiFSlTiRepS3ZAaRIuktFxlvA&oe=69FB4F13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819511_1987824048664940_8191741301069026356_n.png", "id": "2078320226238427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_2078320229571760_3874311139698454901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWWUoCe4uW4Q7kNvwHfOa7D&_nc_oc=AdpwbpdJwQhjJDm5zuc8MWcZH4O9--zQgBsiQnGcjwdV_hX-bPMsC0hKFPXQBCCRDDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ggHLpD-wLYIq5YLi6oQNifMVOrci-CQsI7N8xVab7Zw&oe=69FB3735"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective", "Mystery", "Survival"], "long_description": "Escape Room VR: The Silent Clue throws you into a psychological nightmare where fear, puzzles, and dark storytelling collide. In this immersive VR escape room experience, every clue could save your life\u2014or drag you deeper into madness.\n\nA serial killer lurks in the shadows\u2026 You\u2019ll explore mysterious rooms: a blood-stained bedroom, an abandoned restaurant, a terrifying maze, and a haunted asylum. Newspapers, notes, and crime scenes gradually reveal fragments of the truth. The only way to survive is to solve the puzzles and uncover the story behind these murders.\n\nAlthough the core experience lasts around 30 minutes, every second is crafted with high-quality visuals, immersive sound design, and detailed storytelling to deliver a truly cinematic horror escape room.\n\n\ud83d\udcac Your feedback matters! Leave a review to help us improve and expand the game \u2014 your comments directly shape future updates.\n\n\ud83d\udc80 Love it or get your money back! If you didn\u2019t enjoy the experience, you can request a refund \u2014 no questions asked.\n\nEscape Room VR: The Silent Clue blends the best of Horror Escape Room and Psychological Thriller genres. Perfect for players who love scary escape games, murder mysteries, or haunted asylum adventures.\n\n\ud83e\ude78 Can you escape the rooms, or will you be lost in the darkness?", "short_description": "Solve dark puzzles in terrifying VR escape rooms. Can you survive the killer\u2019s game or descend into madness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://linktr.ee/The_Silent_Clue", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
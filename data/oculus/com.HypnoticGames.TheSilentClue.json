4F5zY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3SFrVtdd3z9FfF02sstnWwca11BJIix1Wl8Cw_BPngw&oe=6AEB3380"}, {"file_name": "Cover3.png", "id": "816970730851396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304131_816970734184729_4132683642427698959_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqCp1vAivmcQ7kNvwF1ivwL&_nc_oc=AdrGpyK0IZhtQYFJezTOOIC4VSGGQIsRQ94OkyMKS4inrE5B1KBRBpPYEixrBGFD-oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPCe6myrFhqzr0twbq42E-1io_1gUIQPrZyunRACOlqg&oe=6AEB3923"}, {"file_name": "Cover5.png", "id": "1465969001306182", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818938_1465969004639515_4803768927154576837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hhoCNHTny0Q7kNvwH44yij&_nc_oc=AdpOOR0BG6m0qGpB9I-QvkhKSht_0iR2fL92JcFjj5e61EAT3kWFyzhlguiy1vFSkdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGodrsFE1I3Xg1YGIXIA_GLA7M5XnAlpn0mheD9Zdgrg&oe=6AEB2CF2"}, {"file_name": "Screenshot (41).png", "id": "852810053803346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_852810057136679_7646392224024364466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMPqsCLAL50Q7kNvwHy7MO_&_nc_oc=AdoYZL4SaTgZuYFV9R-7lrUZLdzEavkGUNYBGaj5Q2TkS0N4-dExF-D6dHykmW3BoT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp9jOzcgj6_PUCtShqJSFtWL-6iPFCO0YXPCvXxSB7Cg&oe=6AEB4013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819511_1987824048664940_8191741301069026356_n.png", "id": "2078320226238427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_2078320229571760_3874311139698454901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOdRiqknJsQQ7kNvwHzbALj&_nc_oc=AdongsHV0q6mmDrihjbcNW1cNPdZa0LExU9Hbj3TCE9beNomrstOu09MNVllhSnj8po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_kohk7RHzKVgoDtSYedXPe3NBgx2P5besxlC3skk7Q&oe=6AEB6075"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective", "Mystery", "Survival"], "long_description": "Escape Room VR: The Silent Clue throws you into a psychological nightmare where fear, puzzles, and dark storytelling collide. In this immersive VR escape room experience, every clue could save your life\u2014or drag you deeper into madness.\n\nA serial killer lurks in the shadows\u2026 You\u2019ll explore mysterious rooms: a blood-stained bedroom, an abandoned restaurant, a terrifying maze, and a haunted asylum. Newspapers, notes, and crime scenes gradually reveal fragments of the truth. The only way to survive is to solve the puzzles and uncover the story behind these murders.\n\nAlthough the core experience lasts around 30 minutes, every second is crafted with high-quality visuals, immersive sound design, and detailed storytelling to deliver a truly cinematic horror escape room.\n\n\ud83d\udcac Your feedback matters! Leave a review to help us improve and expand the game \u2014 your comments directly shape future updates.\n\n\ud83d\udc80 Love it or get your money back! If you didn\u2019t enjoy the experience, you can request a refund \u2014 no questions asked.\n\nEscape Room VR: The Silent Clue blends the best of Horror Escape Room and Psychological Thriller genres. Perfect for players who love scary escape games, murder mysteries, or haunted asylum adventures.\n\n\ud83e\ude78 Can you escape the rooms, or will you be lost in the darkness?", "short_description": "Solve dark puzzles in terrifying VR escape rooms. Can you survive the killer\u2019s game or descend into madness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://linktr.ee/The_Silent_Clue", "category": null, "comfort_rating": "COMFORTABLE_FOR_FE
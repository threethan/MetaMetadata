101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N1py2tBw0kQ7kNvwHfSRuk&_nc_oc=AdqfmI6rAeHy2jVhEglA1eHcXCEuTwnbj5AEoy_2rWU1vKoEjQzWePvlDm1B87F4fgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbW7UXx4VxMbmrBGPn-n_12IXJGBk5noBk4psI47EwmA&oe=6AFC83F5"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective", "Mystery", "Survival"], "long_description": "Escape Room VR: The Silent Clue throws you into a psychological nightmare where fear, puzzles, and dark storytelling collide. In this immersive VR escape room experience, every clue could save your life\u2014or drag you deeper into madness.\n\nA serial killer lurks in the shadows\u2026 You\u2019ll explore mysterious rooms: a blood-stained bedroom, an abandoned restaurant, a terrifying maze, and a haunted asylum. Newspapers, notes, and crime scenes gradually reveal fragments of the truth. The only way to survive is to solve the puzzles and uncover the story behind these murders.\n\nAlthough the core experience lasts around 30 minutes, every second is crafted with high-quality visuals, immersive sound design, and detailed storytelling to deliver a truly cinematic horror escape room.\n\n\ud83d\udcac Your feedback matters! Leave a review to help us improve and expand the game \u2014 your comments directly shape future updates.\n\n\ud83d\udc80 Love it or get your money back! If you didn\u2019t enjoy the experience, you can request a refund \u2014 no questions asked.\n\nEscape Room VR: The Silent Clue blends the best of Horror Escape Room and Psychological Thriller genres. Perfect for players who love scary escape games, murder mysteries, or haunted asylum adventures.\n\n\ud83e\ude78 Can you escape the rooms, or will you be lost in the darkness?", "short_description": "Solve dark puzzles in terrifying VR escape rooms. Can you survive the killer\u2019s game or descend into madness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://linktr.ee/The_Silent_Clue", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24852889037673463"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "2003492580320288"}, {"status": "PUBLISHED", "id": "1071515852550560"}, {"status": "PUBLISHED", "id": "4779738105581253"}, {"status": "PUBLISHED", "id": "1438364914901783"}, {"status": "PUBLISHED", "id": "2730765397324246"}, {"status": "PUBLISHED", "id": "1408423944592079"}, {"status": "PUBLISHED", "id": "1422344726406717"}, {"status": "PUBLISHED", "id": "1918685685741034"}, {"status": "PUBLISHED", "id": "923666590093742"}, {"status": "PUBLISHED", "id": "1569990881002530"}, {"status": "PUBLISHED", "id": "4086761348321086"}, {"status": "PUBLISHED", "id": "865441799530805"}, {"status": "PUBLISHED", "id": "814862531600120"}, {"status": "PUBLISHED", "id": "1200661688682903"}, {"status": "PUBLISHED", "id": "2715189198873220"}, {"status": "PUBLISHED", "id": "863147149590379"}, {"status": "PUBLISHED", "id": "4275908652696182"}, {"status": "CANCELLED", "id": "703716195767955"}, {"status": "PUBLISHED", "id": "1566831711010581"}, {"sta
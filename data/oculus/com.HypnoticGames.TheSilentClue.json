7480"}, {"file_name": "Cover3.png", "id": "816970730851396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304131_816970734184729_4132683642427698959_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fcIj42MeRUQ7kNvwGGtnHC&_nc_oc=AdrfLpkInv_vyljuwo6eoqWJEOqqNYclBm15MZuffYWLutBYMQVhRhOVvQT8OyjmUyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH4NMaOmfKJ-uP9a7i_K9iByYxfeH91ZkEkaQPomN6UA&oe=6A5F7A23"}, {"file_name": "Cover5.png", "id": "1465969001306182", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_1465969004639515_4803768927154576837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF3cb9Ikfj4Q7kNvwHrOAMt&_nc_oc=AdpyX1cKei4nbuYDXHlcwyDmE-VPDor5nsyCE21WyHppAQ6luhDQ1YBWE4uQ9hxMRBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlU_7RHphJ3DB8Gd52RR6vL4-9c1bBxsaRBZE5yYJPlw&oe=6A5F6DF2"}, {"file_name": "Screenshot (41).png", "id": "852810053803346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307435_852810057136679_7646392224024364466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3GEGKrNG0AQ7kNvwExhPv-&_nc_oc=AdoM0ORCZZKbdRenTzAV4ruuCGME20KqcRDNp-uUWpPs2okT6sWEAFvKmvYVd3qzhIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjYda_fhXgYv3KMAz5dID2Ry5ykHTFMY_4W-M4n7GOIA&oe=6A5F8113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819511_1987824048664940_8191741301069026356_n.png", "id": "2078320226238427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_2078320229571760_3874311139698454901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dErjGc3x40Q7kNvwGkqxGg&_nc_oc=Adr5dvG8I3NEIfh8nBM_6TL9TiFRMV-Hf4PyF_xgIl1sgY7atufTqWupg36pcElWAJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJbQ9WlSw-VcklplWqUArxZv9vADH5w2BDy6wFwhqGxw&oe=6A5F6935"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective", "Mystery", "Survival"], "long_description": "Escape Room VR: The Silent Clue throws you into a psychological nightmare where fear, puzzles, and dark storytelling collide. In this immersive VR escape room experience, every clue could save your life\u2014or drag you deeper into madness.\n\nA serial killer lurks in the shadows\u2026 You\u2019ll explore mysterious rooms: a blood-stained bedroom, an abandoned restaurant, a terrifying maze, and a haunted asylum. Newspapers, notes, and crime scenes gradually reveal fragments of the truth. The only way to survive is to solve the puzzles and uncover the story behind these murders.\n\nAlthough the core experience lasts around 30 minutes, every second is crafted with high-quality visuals, immersive sound design, and detailed storytelling to deliver a truly cinematic horror escape room.\n\n\ud83d\udcac Your feedback matters! Leave a review to help us improve and expand the game \u2014 your comments directly shape future updates.\n\n\ud83d\udc80 Love it or get your money back! If you didn\u2019t enjoy the experience, you can request a refund \u2014 no questions asked.\n\nEscape Room VR: The Silent Clue blends the best of Horror Escape Room and Psychological Thriller genres. Perfect for players who love scary escape games, murder mysteries, or haunted asylum adventures.\n\n\ud83e\ude78 Can you escape the rooms, or will you be lost in the darkness?", "short_description": "Solve dark puzzles in terrifying VR escape rooms. Can you survive the killer\u2019s game or descend into madness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://linktr.ee/The_Silent_Clue", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
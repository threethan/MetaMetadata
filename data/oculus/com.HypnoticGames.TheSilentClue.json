tent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1255457003072945_1379705224012043033_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Yc6DhI0mSkQ7kNvwHCIVFA&_nc_oc=Adp8iY2s1x1DYK7pU7hUYn-ZZbY155JeSPjeRfdmGrWzNllptcqVXfNbCpLP8LMOtz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP9zEbSqeRtO4IcMSbzAleeWAjJ1AK4v0zHWyXhK4Tpw&oe=6B104152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819511_1987824048664940_8191741301069026356_n.png", "id": "2078320226238427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_2078320229571760_3874311139698454901_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0Xwj0Ch0i8Q7kNvwHB1kRw&_nc_oc=Adri5dIgMca-Pw4NkLVSCpvrd98qwLut_iXMN-zgjPqrz8gvqB9vrGbupTC3uJvGT2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOLrtJnThSmtn5rzpBxr3O-mZBBVvGyaknQTvK3lPpAw&oe=6B104A75"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective"], "long_description": "This terrifying escape room game plunges players into a chilling and immersive experience full of dark secrets, frightening surprises, and mind-bending puzzles. Developed by the talented team at **Hypnotic Games Studio**, this horror adventure will challenge your courage, wit, and problem-solving skills as you navigate through spine-tingling scenarios that keep you on the edge of your seat until the very end\n{867815619542365}\n\n\n\n\n**Ready to feel real fear?**\nYou wake up trapped in a living nightmare\u2014blood-stained walls, something breathing in the dark, and a serial killer hunting you.\nThis isn\u2019t a typical VR escape room. It\u2019s pure psychological horror.\n{1853684868601708}\n\nSurvive four terrifying locations, uncover clues hidden in the shadows, and piece together the truth before you become the next victim.\nExpect **over 45 minutes** of intense fear, hyper-realistic visuals, and 3D audio that makes every sound feel dangerously close.\n\n\n\n**Think you\u2019re brave enough?**\nIf it doesn\u2019t scare you, you get a full refund.\nOpen the first door\u2026 if you dare.\n\n\n\n\n\n\n\n\n\n", "short_description": "Trapped by a sadistic serial killer. Four blood-soaked locations. One chance to escape.\nUncover the twisted story, solve the puzzles, or become the next victim.\nMore than 25 minutes of pure psychological horror in stunning VR.\nSo terrifying, we\u2019ll refund you if you don\u2019t love it. No questions asked.\nDare to enter? \ud83e\ude78"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://hypnoticgames.adrenalinshot.com/web/index2.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29045001365128855"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2388092078307203_4538758110704241504_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x_DgWa8tUYQ7kNvwHu10G2&_nc_oc=AdpadDVkz-djAmxi4cs9waZ1ui50CbSgLtchyW22BQFk1De6zy7vtH7V6u9BvWiVP3Y&_nc_zt=3&_nc_ht=scontent-iad
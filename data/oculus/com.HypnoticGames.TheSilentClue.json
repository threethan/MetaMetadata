D180"}, {"file_name": "Cover3.png", "id": "816970730851396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304131_816970734184729_4132683642427698959_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeJGuNCTywkQ7kNvwGpOXxQ&_nc_oc=Ado0ivTmDmDgH4Q_7PvIW9_nntzuB5QwfhFfDkaJjuiubVLQTzntNtWPHpldaE2I0Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeV2bhjxyRB1DWOzMvdeajJ11chv6_GHxq6KIcW64giA&oe=6A5CD723"}, {"file_name": "Cover5.png", "id": "1465969001306182", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818938_1465969004639515_4803768927154576837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF3cb9Ikfj4Q7kNvwEdocWf&_nc_oc=AdrY2GGjOym9b58La9j18gWk63PysZD6lN3yTL6Hias1y2evKmWeNdCbJW6Z784UTr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn52UKXQbcC01L6x2moTN7tGSPJBkWWkIW6dbog3dpeg&oe=6A5CCAF2"}, {"file_name": "Screenshot (41).png", "id": "852810053803346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307435_852810057136679_7646392224024364466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_7wA8pDmqMQ7kNvwEw84AH&_nc_oc=AdpQZD27DJhc6wokXUGHzXOdJBTz0ofqhNZidBYNvHsdWgCbteNmX1lotxwqw3Vv1bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKmdBH3U5N6yHXpf1ntaCBvcJkVTMkTN72suubciwJ6w&oe=6A5CDE13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819511_1987824048664940_8191741301069026356_n.png", "id": "2078320226238427", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_2078320229571760_3874311139698454901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPpV3njcoDsQ7kNvwEd4YC5&_nc_oc=Adp0x_RQqM-Z08L0srXacBnRo-PJWTEOzBLq-EavC_mUKOx9wSSccnel2ZeFOdMV9sA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbitu0rskIPyvmh1VJ3qap84Fn1DSfgR54vdB7Da4ogw&oe=6A5CC635"}, "display_name": "Escape Room VR:The Silent Clue", "keywords": ["horror", "scary", "detective", "Mystery", "Survival"], "long_description": "Escape Room VR: The Silent Clue throws you into a psychological nightmare where fear, puzzles, and dark storytelling collide. In this immersive VR escape room experience, every clue could save your life\u2014or drag you deeper into madness.\n\nA serial killer lurks in the shadows\u2026 You\u2019ll explore mysterious rooms: a blood-stained bedroom, an abandoned restaurant, a terrifying maze, and a haunted asylum. Newspapers, notes, and crime scenes gradually reveal fragments of the truth. The only way to survive is to solve the puzzles and uncover the story behind these murders.\n\nAlthough the core experience lasts around 30 minutes, every second is crafted with high-quality visuals, immersive sound design, and detailed storytelling to deliver a truly cinematic horror escape room.\n\n\ud83d\udcac Your feedback matters! Leave a review to help us improve and expand the game \u2014 your comments directly shape future updates.\n\n\ud83d\udc80 Love it or get your money back! If you didn\u2019t enjoy the experience, you can request a refund \u2014 no questions asked.\n\nEscape Room VR: The Silent Clue blends the best of Horror Escape Room and Psychological Thriller genres. Perfect for players who love scary escape games, murder mysteries, or haunted asylum adventures.\n\n\ud83e\ude78 Can you escape the rooms, or will you be lost in the darkness?", "short_description": "Solve dark puzzles in terrifying VR escape rooms. Can you survive the killer\u2019s game or descend into madness?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/the-silent-clue-privacy-policy/c04bdec8-aa43-4c35-b0df-4b056f310779/privacy", "developer_terms_of_service_url": null, "publisher_name": "hypnotic game", "support_website_url": null, "website_url": "https://linktr.ee/The_Silent_Clue", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
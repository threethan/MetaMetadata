-fra5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pxzqR9ReIcQ7kNvwFc96MW&_nc_oc=AdpVvOnr59GEbsZ5Tfy2-0E7sSijV1NsQ_QaUmlIti-vLkzn73d4lTfCIZC625Y254o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPSnsqyLFQYRJHTxOYEfadeApMV0SvfL052yJB8I5icQ&oe=6A5658BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftr5UXF5_akQ7kNvwGznyQb&_nc_oc=AdoJD4ZQ8XkLgVZJFMN1WppYndkjMBZl69seFO2_Wfu26-XgJwMcrTnCB9omgCWEf14&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq8svLtHwkaAQwiP3wgLkoJlJ0pMIynPRPXefxJZxBvA&oe=6A5644E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M2YrTNfA6gQ7kNvwHKSrHA&_nc_oc=AdqUv4Lb_5IxjCJPizL5rQ3f4QEMNG4rwOYjSgMYgY4N3mRWOgG4T7LDL8SXP6z-7u8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmRCzmpAk1i0sBfDeDMXjIpr2yzn7LFK1hHYrPXb3pvA&oe=6A565172"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGaDg8I9uR8Q7kNvwEPqc1L&_nc_oc=AdqIsgNnG7JIPKqFWAlxMJhbTwdMpR32L9i57wRaawMgPfCo3kr6djpL-g7v90GHdsY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFvy92zZL4zkKtNsZKFK6oL1QviMqYR3iMjG3bzLnuFw&oe=6A563165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXriqrVd3gcQ7kNvwE1jefz&_nc_oc=AdoA5jBnRhM48kS2Q8Fr2r2UAlt3s5XON76NCQQycWSY1JhHAKHhR2WnzPvyJKDts8Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGVCx7JZGIjY5IeYN88okFcPBomujrsO4t_0BtDJOkBA&oe=6A563093"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abQDOfzx4r0Q7kNvwE2Pbtn&_nc_oc=AdoPv8ouVlZ1Jxin29W362k9Qw8KLM-HpwTxT3qT8r9Zh1gigYlko4YXNBF0aC946Y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSM0eF0X_Sws-Vlvo_JRJiEfxz8BncDnsE4dWsLshw7w&oe=6AC6683E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzG2kehfVS8Q7kNvwEYJ9oJ&_nc_oc=AdrPc-bX8rIPZChATWzIm-Ze8mN_wLeAu7pur1uHrBpQNRyKKQDfd8CZIy5EPFr52Qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkt_R_WHQHAiWMLVuNSY8UJ7ciq7gpScz_sEbE5V8FYA&oe=6AC65465"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwDpuWGwmpMQ7kNvwHM4ibL&_nc_oc=AdrWlHueG3OSq1bPhsQWrk4ii3HMgRqKVtG1Zv8jvCUsKAjLPas2fFEbiVaqqQqAbyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKU1g9C3tVl6T9wc4tq5ZUVRxYIZWPWtAL634iGZILig&oe=6AC660F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFxp__LMD80Q7kNvwG2IviN&_nc_oc=AdoHtd-1rlfr63iOLyVnM5hhSUgMDaN9mpE_wxg4oYQhFbNN8_NN55iKcKR-O9X_Xmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1XM68NWpZgbivoD6OflAVi63hpsjWTEsNePAfILKiow&oe=6AC640E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6beEqCeQdkQ7kNvwG8XHnj&_nc_oc=AdqfRqYd636Z-iSYBR0m1nH2F76S8mT9Q6wpM0lqkq4abXhBvS4XBs5wTQUyWftfkP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwGtxrqMB8RJ6wweNQVxoHEYZzqgY6hyhEorRcvpPt9w&oe=6AC67853"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
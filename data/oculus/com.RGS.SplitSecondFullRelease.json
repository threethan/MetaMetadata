nt-sin6-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzIDzCj2LBcQ7kNvwEKksvo&_nc_oc=Adq_vNKZxEVU0Q9XPEyIfFs4w7TL8M0hF-1Xe3N5VkDErBo_ej7P4h4qfeMb50QUJtA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZJ24BJ-fWgmahz1meqpmaSYt4U5zWEAq0WLZFX-iI9g&oe=6A7DAD7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2WAhuLBNh8Q7kNvwHOYnTV&_nc_oc=AdqKOP1Gsk0U9ooYflCy_MngFOF1_LFOYGulUTWidMx_rp8J_ypofshXd5X7zUA3H5s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH31WMbjodS_AbOV3LxqjxSnkroWrilex34CDbhv7MbQQ&oe=6A7D99A5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRfP1ipRDQYQ7kNvwEEgasf&_nc_oc=AdqdkKm4J4AAL4ElkQJyP7fPPc_1Ywakhf7-IfaCB2hIFSTDikjkPV7_lAfHLL1JVZs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAfGjlQbU0uyatYjxFsqgWFtP4aQ2XBTjBdWP7e2w61A&oe=6A7DA632"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rjAnyaApocQ7kNvwFf6xVm&_nc_oc=Ado2hBg_f6SlF2pRD5zL3RApBIqFEGctXE3CKYWQZdegOE9jnS_H50w95a2iKBNAnkE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiYZ557ISqBqC6tgDIE9Kr8C-qZKWKySKULJmxAqJs8w&oe=6A7DBE65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhUOVdLaJyYQ7kNvwF5yPW8&_nc_oc=AdoAqHPpZCmIXuuAO3JIJl6UPES1tD13KaLr9792mGjsuZR8lainaGyxewHHFvR0ssU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqXVjfKyDyXQD0wDn6Eke-Aanv4Xh69zbpsM0Zf_xO_Q&oe=6A7DBD93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_gr
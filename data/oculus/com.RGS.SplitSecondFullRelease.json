-ord5-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wg6VhckuW_UQ7kNvwFEL2kJ&_nc_oc=AdrH5flQqWidKVUpRzVOUsGI5Q6wSyXeW6yz-6hcdZNnLi1SyeS9aOHoGd5Ds9uaGKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46_Eq-DUk_2pjooHpi3iF93sBRtoZqN4_U228JrPXAYw&oe=6A19B3BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dk8ggbecQAQ7kNvwEMxqAG&_nc_oc=AdqfthVMemIwvXvD_44zpVbXyKCHJTkRltfxAkfzGSO9J9Jrlb38iilQnROcwtg_7yM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U3xNdyQPDJT0ZBoH_KaCUULCjBanOQEE2GdmYABklvA&oe=6A199FE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1cypDR7rSUQ7kNvwETjD02&_nc_oc=AdqUSu5mh0Vs7hg_OqpS_h93-utcHXVga_B5z4u9kzY9yVioC5CtGtZVkxu2Qw6OmRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W9YI_bRF6vAAjmY7oQKmmv9lBo9Sw1lveZZKIZDgFUw&oe=6A19AC72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCtqgq7JUtYQ7kNvwG3C_9w&_nc_oc=Adr_jgKcfhbU3rnRofIzeKhLhdGq0efVirKu1WiPU4RkkA04YWPSYXVKh3iYiYaqfmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DAe9Sp1yDB5rWI5DR5bS26QedrZPA9orRCoLmVv7dTQ&oe=6A198C65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJkG1Dx4ww8Q7kNvwExXS0m&_nc_oc=AdpYi08D2Jji656Vv8cKVcMAuY_bD_3_iew2CmqBoMRaLQSSvfamhHu1Cej3LR8tc_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uRrxk-S3E8hiUyUyS3fFknSFD0GMreE-X1xv65IChSQ&oe=6A198B93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
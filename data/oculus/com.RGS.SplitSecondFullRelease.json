771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCO_mIYRPYwQ7kNvwEOJFDQ&_nc_oc=AdnZ6vil43WX_nZxpX8eg1DY3WaGq6riH8Dzz7gg1tPfBdZdhjhExSaMTmyK6S6DjcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhCUYM1_fWpX9nR6iO1BIBKJg3B-ftsXD7nO3iWvwYJQ&oe=69A96BFE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_clxKd3vR4Q7kNvwFVAOan&_nc_oc=AdlqExFeXgonhzbYC3QmQ9rdCYMtrcTR8O2mRLtVGgjluJtliCB8XLzvMc-masnxyJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsvsaec0WpJeD1O-WrF2_voR8HrJ4Ee5e-z1WmfhbZ1Wg&oe=69A99065"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzM-vQRGadEQ7kNvwFyZHIT&_nc_oc=AdmruRewNXn7TGNV8IKexfi9YtyFPovwQksO9DVgrZwZGxCZxiItY1fErtDAOEuC80w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftF8pg3DZjYyORFtL5uDo9-XXaPW7wl6tN-GASdNkW-eA&oe=69A964B2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RkTVs5vkowQ7kNvwHqONQt&_nc_oc=AdkQ_QO2wVW-PzZEXB6oD0CgFS2sKmFslY8QVjJcQ9eNVcyQDny7dSwcazIaRa7u-qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfugMk5nNwADvgKtKvP_4wYJmi9EeIeTbuMea0tWjJgIGQ&oe=69A97CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyjCRJEO_-YQ7kNvwErG8i5&_nc_oc=AdnRKSVHBTL0fXHq1M5MGcAXc2N4iJUg_2nUO2PqSYJc6toMcw0YkDYL0DOYIIqp_90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftLzlwWHGCo6a-0id8bNsb8cmi-HNJT_GLjPeuTEjylFw&oe=69A97C13"}, "display_name": "Split Second", "keywords": [], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
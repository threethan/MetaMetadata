-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLbjsAyoQVMQ7kNvwG9j47Y&_nc_oc=AdopBM8l615F5g6SOB4zIGo4jc0ZTR5k9PeygdO3Oub_indyzWdMrEEK3aIzkK0Q3u8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiy18D9vDZXP0t_HbF9HrIL13azNst4D8hdkgTFwtCpQ&oe=6A5B667E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eyL8OX-DvAQ7kNvwEBuXaV&_nc_oc=AdpZ2udSkFm6RvXUSA6AIvYlhXiSuQVuApJbwQxLAonrktS0pf47BfY-TGCYXm0dq7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNE1ObHcsTbRS3unQNDoI8iUQkBXpcZFuHyLguRIHXkw&oe=6A5B8AE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt_-55CyyTEQ7kNvwHRlPfl&_nc_oc=AdopovX1HuXHzoHGQ25is0iWOGeXbm1P6ld6oqsouHonqkSAU_MAP3FRevVAWzocUfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsMUTSz7cJINrxA1oaxRZGQci7-5vUVMSWmBR5QctwXw&oe=6A5B5F32"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkq0PwB5ZMoQ7kNvwGw8OrJ&_nc_oc=AdqnTRF8-K_a-KiVbDsyAdpAL2yAu9-MNiSDV96tScA43mASEGdjS5_Iq9jSZP7-DCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcKIXrNGzKj7NUBhIzdFtFSORj4N54-O-HleyEzzkPZg&oe=6A5B7765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7ExvxSJ8lMQ7kNvwGT4LHR&_nc_oc=AdoqnYFy0LSUTUgHdOfprIoAcDLTEr8pSBe799_PWCC6A9CyGE_lhHYYGh9A25k9fsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV8ku5GNJIEK3BJLR7GB89W9lNG-cayVeVyJN6-gCuDA&oe=6A5B7693"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
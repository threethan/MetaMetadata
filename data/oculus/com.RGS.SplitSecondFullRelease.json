-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1rF2v-trXMQ7kNvwFFW-ZQ&_nc_oc=AdqAgsnn4o2toyxEh_4BIIbK5QXMt1rAGBeE1lp-ZlL7JWQPESX1OGWAlJtepfLlnEw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88UW1OCpd1CVY2WSlpo26q2xlgjqygqqQc66PP4tyX1Q&oe=6A3AA93E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7kA1TnmF_gQ7kNvwEbhZOj&_nc_oc=AdpH3Sd5NIKOhRyemcjlqTpvutsa-E6MzWSAShhOaCEuGDD3mGiMhii6uxDRHR4GgII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85QMendFRDzhEjYsPT7os4xYgt3g71b1gO6QQPSsJpdQ&oe=6A3A9565"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSzfYsG8ArMQ7kNvwGFgPz9&_nc_oc=AdoC0Ant1JK5JwfzshDQ-iQkAgu6H9-swDLo28dTwwdjklnzVmBPXcX1YN7CIaJ6ft0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q_IQ-P9RcwkR7asNMrpm5SNBh_CvKu321-qTo6-_rGw&oe=6A3AA1F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcKlD4oIhfwQ7kNvwEldUzH&_nc_oc=AdpCBUXquRjTIXiQEXtZuqDyT5XyMKlPLVvwNX1tjA8OvCJlS4mgMoQY-airPM-_Z_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RcjpBfC-hWuR5U8fa9ym2pxJKuJA03pJ7NH7IAuZ87Q&oe=6A3ABA25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTLcpqQPijAQ7kNvwEM7LM9&_nc_oc=Adpza5BFxbEmo8P_o89aRd79BMM6vJdsxYcXdR-70QfpPMrNAZ8ypHgOCECVqhY5Ubw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nRx6DxgMb4b6LyQzJLTyRI1WxT3eu7eQX2hoX-kdF2g&oe=6A3AB953"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
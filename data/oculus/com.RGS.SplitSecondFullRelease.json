-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPtEFgNHDEwQ7kNvwGQv44c&_nc_oc=AdrqhpOFHenjsWRN0hyF_SMnvtnVjCYMGJS4gJS61nXId7jxfNpymYSiryw84Gucuos&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2YD6z7gYid9Z4alCeE5xQeWEtIi7T9FOYKtCE4r38jg&oe=6ACCFFBE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjECfuaNn2UQ7kNvwEunxuo&_nc_oc=AdrBOfCbScMpE2fkzD5bf_EN9eCkcPky7DjSlkB_ODEwPsQFluD8_y1M1gmCkM_Imsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAPETiRH4ATMARbBSo3QIbrkZwcTruy8hWWVYyClZWVw&oe=6ACCEBE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHBy63E2KIAQ7kNvwFpI3oj&_nc_oc=AdoTvffEM7EJS2sxiQa3U2rKmQg13-OkniD57HU2ofNIsnyWY1-aOL_ZT-iToQ-dmd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1J1qjtwDUbVFbtaPtD3LxTcaoFDptxtt7ICh45m4cxQ&oe=6ACCF872"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcyZJKtDQ5sQ7kNvwGufxWf&_nc_oc=AdrN78McKx3Z_Ob4Xn6PGYLq1hQrshFf3lknHYRipLL1yFrrAbWnx7RN-WzTe4VxIDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7upmiiWvRlM4a430xCWT0PtECBVmwhnHEgCJ28jxlYQ&oe=6ACD10A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27ZLJ_gLK0EQ7kNvwGYp3HS&_nc_oc=Adq0pQ4B7opZdnVbPJRviq4pkKoUb-V4qjhoSFPCdpQas3DlTb-SRVw-GG_OvRaIkkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWslUDt5ZjJPWHmn_vcDxK5YQe8rekmxRbA6P2zOxgiw&oe=6ACD0FD3"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFbW1B6TiOcQ7kNvwGk2Um_&_nc_oc=Adodq2WDJqwTma4nE_DAWRXE6PXtUP8oDuLNxEY0qAWcZjpWBCiC3Yy-MAqeh-KvyOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tCb8dbUqK7Sukqeza45d8Pjn7hcFPlAaHxvg74IFzww&oe=6A2D7A3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4KIYZonIgoQ7kNvwGb2c4n&_nc_oc=AdrHESO9-KUr24FYj9mV30Vj5qbUb34RxMnxwh36SsGPOpVSwB35rO0cjcGqbR3rgZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95H4FgRdAei-ibvlelWfdmmjSJU0PzPYbo8SxIgULICA&oe=6A2D6665"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgY7kv07y7oQ7kNvwH_7SLH&_nc_oc=AdoSWDsmfn96VG78F79VBEAI7qQIMxIYJItlSDie1vYSAhtFc0mM1buSAcONfH3mTXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IY39VlH4Tdrv2MkAEoluJWiLl5979aAkCt2v7iQjzkg&oe=6A2D72F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRnfoUyAAgUQ7kNvwH5B1Fl&_nc_oc=AdpJU33gc0vgFcFDDp6cftjBvCeHkNqdBC-Rn0sRXzT8S_vdotsRN7Jf4e0249eqSAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kOWjLmiPXKcup9msKxRo0wx-z5FZSJg0T4fSaZx38Yw&oe=6A2D52E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AljCrVhOLdUQ7kNvwHOIJQG&_nc_oc=AdqLA8E7-yZ9gCFv3S6lu0BKVPDKiksY4T0Wd4g0PvdLM0Vxcf9eVYD0LOsrbrVRef4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DcMQn4rx72MTeZBppa1sTpamRJusiOZ8zr_-ql4Lc1w&oe=6A2D5213"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
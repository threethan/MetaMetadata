-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJAtliUuD6AQ7kNvwEIt0Qo&_nc_oc=AdrZawigzt2kqSVrZfjXe3jC4I0-pkd3O3NFw0RKzo7OxVPuxohD_8228oFbhuhIKdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyxGhxE-mBic8Hrd0bO_fxGy3mV8CbHxxHIdaK7CEUpw&oe=6A5112BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k98e-AZ8kMEQ7kNvwFsKamm&_nc_oc=Adq9Bqa5k5YqSPKUQLZqlhPTjhz--BAg6aBNW6X0-vhdJqBEPFbupLQpm0rwqk191yY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_p5nxFRueX3RmWBSG8Mz22OojifeGFRHwEWtBnzjvow&oe=6A50FEE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsuA5POAv8EQ7kNvwG036MD&_nc_oc=AdpEof_4hVYyDcYxsDWI3WmWXyNPfsC7IWCqQrXcgStcXSCyzbkmaYRJVcGH4PV0CbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzaTbFVuakLJrLD3G6F6hpMUeFaVn47zFB42MoefEZxg&oe=6A510B72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khL12a576PIQ7kNvwHXA_m_&_nc_oc=AdrwapVTeaTpg-fgOZbCM7Yai0dO13Vw29hjPzzmfOWill-9dCnrWXsjXUQlylBV2ao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4rIWg-i0i5fNmm6B2mRUv4xjguwCOqtvajGpw-aN2Yg&oe=6A50EB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4YGrVaxgq8Q7kNvwHrDwgj&_nc_oc=AdrSiPewNgpDO1hClt63kq_jHzyy1XX0r1dUJryigC5XEpIaszukjjXU9-vZKPU74JE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6BbgkN6SA2mOMn1RN8gydfA7UkaHAhlfZxM9tNom2CQ&oe=6A50EA93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-lga3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exz3VlRxkGEQ7kNvwFbnM0J&_nc_oc=AdqVqhWx6eZK9q6YhEDUWzqD0_mx6O8eXbh98Ma--DBBYFThFvw8GHMtMt52TnTcBvQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAHXFgGL1eiDhy20GQXP1Cpg4V4Oo2YIRgnjNQf4qb8g&oe=6AA17E3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4KwSNALULMQ7kNvwGUWYqe&_nc_oc=AdrwylkadT3ZHlQHpiwV4b2wVaCBs9ej0GF8oaBrDcORKpusnsBxeyjNYnmoX606i4I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6j2PukyMafQ61fDUckMkFh4OTvddBICCX1cSAQO9tMg&oe=6AA16A65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS9gGt26nyYQ7kNvwFaWXKY&_nc_oc=Adq7ddhyz5SRLmVA4CtdHeasMIw5c_7N_TLto7C2X9kzViu6usNhUbJYW2L9GKrEbYo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPI_EgyTy8ceAr5osxw9V8XWsJ4H2mgwYIsNID51YKZA&oe=6AA176F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFEWZz9fg5QQ7kNvwEHx44D&_nc_oc=Adp5eCiyFz1LPbEiNcsUXwtmDSzl5lu39qsoihrhm_HgimktkeqlWyFNJl5Mo3Zg47U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3va__FANQDL-vgIF-0SK2oiC9TiFJvlew7s7D4_vWrQ&oe=6AA156E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tALc5drwPoUQ7kNvwG2_h_k&_nc_oc=Adp_x4faUBjdZpgpM-L04Aun1gq8LgKOp2wIcqmKRI2x6Vw5jlA_Eo1wMeuM5e0M1f8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeUBu_thAFJeEr5K8yOBTo2svFXokloN1NUc89L7zl3g&oe=6AA15613"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
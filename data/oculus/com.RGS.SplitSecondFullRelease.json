-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOS8m6z7_88Q7kNvwF7zsZk&_nc_oc=Ado5ypg8A5T8ZYIG7y0rbwk2Tip6-wJ9SAZEZ4f3ehNtd_xz2azpbgan2rbv_FSDGDk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OHth5dgc2EcZGAzgx6D0Ug4gJfzLd4_lRFp0ZuZHexg&oe=6A26E2BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KK8EqSCWQoQ7kNvwFMqPg0&_nc_oc=AdqE7Tc83W6JDkxwm2NuyTjYekrRIDSMSiLxrhfTCQDIm2YNHOmdAGBVQpn4TUNUJjk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W5e2180RYY9eti96--Zpunut0arr0u4pfLY79ntI2rg&oe=6A26CEE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WXOsNvxSNoQ7kNvwEj0e5j&_nc_oc=Adohr_pMtUQpmI7JQ36HWwoJBaiQXboxB0bKZNf-WzpbbkuVauNIs-lTx5Iljh2oTPs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YUcR6dRETQ2VPE1SiaNRn9oSO7A020KymzW6WgyRyMw&oe=6A26DB72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6scNigNjwl0Q7kNvwHtSdZn&_nc_oc=AdrJ6UH1x1tRTxufiNntrmkDKhztscL37_pEMB_LwXCI-xYvA4ps3g2TWvu2pIhT0TA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZQ1NvoWRiM1NM5pNs4pAPzG6lCrzqnAKeAbYugtvK3A&oe=6A26BB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzUOizro8qEQ7kNvwEn1wk_&_nc_oc=AdqYPbnHSsz-mZfU9Xaxf1RbZxFkXTVpgQcobIg_-gN1Ye2LnayAnuUDYrlCqwMn9Us&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nl54esiVSb70aDTwRCjXd87dS0HXwPoHDk83czL5M5w&oe=6A26BA93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
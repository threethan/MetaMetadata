-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcl99PfBMpcQ7kNvwHAi3Du&_nc_oc=AdoTx-rbc5QAnJkN7qJBSQNph5mVaFv4JmTqGr9-VDDkjjIKtfmoufq7rBiq82u9TIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt9dlweioGbM445--EVBXmuma6_bkECbf1K-u35wng-A&oe=6A92C57E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw692n8qBGEQ7kNvwEJ2w9n&_nc_oc=AdrwhhKvUZW_OvUVKin1STFRsAc4u6aOEQFihOP5r8LjgBFSXsoA_6ZkhRk7ArZFs-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFw1u1SIaGIDoO5syzJOecQZWmGcC6cIcx1wFG5ihT5A&oe=6A92B1A5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQKqoeHXJXAQ7kNvwF9bdNK&_nc_oc=Adoo-vnWMNBmbGb7dLC5z5tQxLQ_5Cm4AVNylbsaCDNe0GodB_8PIuN7-RAVymnnGBg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTNlKaoTnfFhn9DfOycQz2IXPR0cESAB6UBwPXU2WaNw&oe=6A92BE32"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yYmw78Q9-0Q7kNvwHp7kKI&_nc_oc=AdqvcMDM6mGXBO4fW9Zb7epJamVfAKOuWU_X1yVDfIUrlT4sxnFnCK_38XFazrIbG_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzvq9nzuWNXH4hmW4EJt4CBB64sNm9RWH9iIUtUGKkdw&oe=6A92D665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG_X1Hojpe8Q7kNvwFWV6r6&_nc_oc=Adoab6YdriuQJIBCKLTmavjkALtQOyRsM6fC4Afhmflm4ZWn4OJBwRfJjQUoJaSE5hA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgJ7xucpA9Q5elIph979Ay5MW8dM5dk1uwbFbBIGeOPg&oe=6A92D593"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-lga3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKallegBHBkQ7kNvwGu6iRq&_nc_oc=Adp8druO6MnZR5rbPURfULCE9jENtZYfY2moRCrH1CkklsZP1G4j6HL3iTTf1VaVwWo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMvW3M7dJAJUj4juW3prXeOgbApiX2SUK5KTaK1bVZlQ&oe=6A80507E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2WAhuLBNh8Q7kNvwHdiKQV&_nc_oc=Ado7Hu7C4f2H6g2LWhPzzLDSoOPDOdmX0Va0GJ8GkAKMNsc6wd7Rioes1gH2JwfbrBo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJsTyGqEUOaN-yTo7CLAleIUuRZMEqipEw5zpM1967Q&oe=6A803CA5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt1N9jQu0GEQ7kNvwGXnbQ9&_nc_oc=AdqkHKHDVgYARX5EI2gW3he3RqFSg5mw5gdPuYpPgPykJ1ySZ39NF5Pvu1i8-LPEfuM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENGcOaqtT0vjqB5-KDlxVqT3EXAWAAesMBz9eDBolcXw&oe=6A804932"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rjAnyaApocQ7kNvwGRDebb&_nc_oc=AdoBy5Mj9DPWxWa_jbPZL-9hImRkPT5qSiZGXjHnrV0Vwby378_3I0t4EH6ccUEAnqw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAcFE9oeEVp0Lr4Gin3LkrUlpduQyZPc0sZheF6jObcQ&oe=6A806165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhUOVdLaJyYQ7kNvwEbItPc&_nc_oc=Adqksa7DrNzvBJVSOO5yv8zdJgJGajW9jooxp1dN4BgaO4AmrnG9JHHTes51rOqHxKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0bnpSDj6fr3PsFxPJl2DmCv31pGc1x4KIwqlyGgCq5g&oe=6A806093"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
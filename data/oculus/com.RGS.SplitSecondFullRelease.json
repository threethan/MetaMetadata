-fra5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAe4kR0oF9oQ7kNvwGqweRr&_nc_oc=AdpbCvvy4kfnSomziFgubdJUtNX5n_C_rUqdsINC130eXFqkoGzKbN5ARAgUeM2-BiM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q0duBfc-RhYP5eUDsfJOX3Cp13LDSeSe3D5xQkh6o2Q&oe=6A32C03E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT891NxUpdcQ7kNvwHGUb1b&_nc_oc=Adpxqhz4rHWSEZ6-1VdBa0kpKEsFidhkhWzSsmuEKWQFn48guXbmUmKYeRH6tfPNYkY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WBb1UXZoJdoS_JvUr251lRRJEUqFLofaFlaEn61wfqA&oe=6A32AC65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeHT3VryaRIQ7kNvwHrhtQA&_nc_oc=AdrsZ_Gv17hBriODXrINhj7_WaKGutbSU0Tagtn7p1o9SH_Q6AWFRooCVA8ThWXyITo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZGcgXnNG_l1-uIFmGZxvTc9efYKqtMT7vNwCgV7rPBg&oe=6A32B8F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSlQ7SetJrwQ7kNvwEdrY-v&_nc_oc=AdqE1heLaC4s8LlfN4vdgmss26NJyr6CutGdwvG5nieVBZWOzhxzIXdh2K0S1riMy3E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9neaO9BpV1hQNa2OjWtQ9RX6dcJlPi0NMe77_LfCU8wA&oe=6A3298E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxwU1ih6DNUQ7kNvwG_P7xl&_nc_oc=Adq4gjqM1a1ewrzv5STa1dPpnVEQC8_RUfBdKeJWcyIF5eOQJKMMVvqv0OYcUeGh-bw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bs1hwPhRwM790Q0mrIpVMGhoJH1RB3MOrntNH5FqkJQ&oe=6A329813"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
scdn.com&_nc_ss=7f20f&oh=00_AQS6tt_J8NlxENDSsremqxuE3GqGrx_Q9qypHnqpOpmnDw&oe=6AFDD825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tMX63LUMDYQ7kNvwGK2PIZ&_nc_oc=AdohwmApRfgHXXav8FOz9YbYE7e1nmDitn3Pk9hPIkbRx9yPLySrcOIpKJ_BU_Q5kZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHH18k-_MA_NExbHIEqIK6mr8-LqrjQosY4IBRRo4FUA&oe=6AFDD753"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null,
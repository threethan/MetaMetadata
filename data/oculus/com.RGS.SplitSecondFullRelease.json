031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwA5uuopAIUQ7kNvwG_SVuT&_nc_oc=AdpO8Birvt15vrKikMfJ_GSbIxo9xLXNDUPfPszDg2Kkq5ou-Mf8M8iMJKK1eBmHAzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3ahn1ajAffHo-dAiesd41gH2j36EoLucDfwKo-3JAdMA&oe=69F1EE7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COrSsJwI6DYQ7kNvwFqHtwG&_nc_oc=AdrKe9tLcwm7-uCxkwUbqXZSnKquEIjp7dYKDjg_ONPEO-uwxVyoohUALrvmgg1eSGk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af14Rcuykxx6xoAVS48QAQ6AqZSE0H-B-hFT6W-ue6NKIw&oe=69F212E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXXu8rsYrhsQ7kNvwGcaikO&_nc_oc=Ado_1-22aYu7rDJVKB_r6u-a9Rr5Tk8s6px7CqjHu0EGmMGnVK0qVFOwV6NpIadRBHg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HAQIhQsp4Tw166tLNhZZBmJ004WpPzHNEel8wQ0-Vhg&oe=69F1E732"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UuG9go1SH0Q7kNvwHZBomy&_nc_oc=Adov7K4n88Qw8F2IMTO1avDuIykKeZuNpGdaqjvNpVk6jROI9Azb--5vThOyYYiLR7I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3YqWvBXY5E13D1GDRxcxwShn3YLdYyGPbAyDZPgWLIlg&oe=69F1FF65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWvZyuurv88Q7kNvwH-o0OP&_nc_oc=AdrnC8FECc8qMaakx5nJe0i1gz4JaIgt7Zqz0q80D2GwGqsK6U0m6VxoghL4S2mOLcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1wja1u9gues3998FMCZ4uCQV72eZKNFQjs7EkgBVVvbQ&oe=69F1FE93"}, "display_name": "Split Second", "keywords": [], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
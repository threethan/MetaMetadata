-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxos-52w8IQ7kNvwGPTsS2&_nc_oc=AdoHsZ8akoI8vnnKpdTCHGneoLBbfqFtK3tRVG_2SUnwe017obbOiwWAYzuCeNH3ua4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UfEvfwSgnWaVGlmFpa0EIr9gvja0xSxGY34C_vnEI9g&oe=6A0D9DFE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2X5EyAf70MQ7kNvwHBcDhh&_nc_oc=AdqrqNCS7iXSKf94wLEB9T7XGzM5ogw_k_75fMsKfCAAQI0rn6pWUx9PUjQhnUDq8ns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tT2155sRQjbcvGNojo_Y7OCFdj3Y81cXrWPlD2hFjnw&oe=6A0DC265"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-Rs2qfh7EIQ7kNvwGtThfX&_nc_oc=AdrvVxC9MvE__Skqr2znyuwmnhWUfY6zF5SVbyqdEywoREVBADNnG6jL2BGjUF_gIWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N_oYWs1nYLBav3KyJpcyBD7nY1OsCes68JHz5wFQemA&oe=6A0DCEF2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lcty6XjDaF0Q7kNvwEOJtHL&_nc_oc=AdqY3C7Ywfh0t9M1-CcBMPhMoluSI9sLlPR8XwtCdeNLlHPonGTmk8qnRHmZaBtsEwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gNaifD8Cs5QERAHmym2N2eser8qno7Mai3X8Vy0DCTQ&oe=6A0DAEE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6_3J2-7V0YQ7kNvwFgpm0e&_nc_oc=AdrxC7AQ2DLCmxMi1SQ3YN827t1QowNEXoPsQXGGp7Do3xmepqD9O-aAQ22z2w4TQs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kdz-K7RZF5s_qaU_ZdBqzddLOsBvMcKhq0qSsN8hHpA&oe=6A0DAE13"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
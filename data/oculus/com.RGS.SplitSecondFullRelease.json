-atl3-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAC7JDvc57sQ7kNvwHAfIKe&_nc_oc=AdpkT96mHO9fJdSF79vA0uEJwNf6DbE6oqeqOf68Ly-6d5zgFS0CNlhbkGCVKx3QX6M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKToC1uIohNvi4xsTAIcVK-wTCgO-I-7aN6EmRpCCURQ&oe=6A9AE6BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPLZpR7xxfEQ7kNvwHuLC4y&_nc_oc=AdosxGhPknty5bKxQ4E9jmcHeQ9mYsz5QNaSWCTk5IvJixrcALCGRYLmiHAiSo0ACxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOVx9-zScPr9fU5ODdhsS2zUc5lz_evabYFS2ySSyuYw&oe=6A9AD2E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqhQLEVjSvwQ7kNvwE2cehw&_nc_oc=AdpVzPBpJ1HZh0ROhIHYa_9qAk4tR5mWGg7dH7D2DYh2X3Be9ID9OADkeUy6OU0L3ZA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqjqlqoYxQ82163BW836YSqeR4xzsCHF1bsR5Y6pDzXg&oe=6A9ADF72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjdwO1m7_0sQ7kNvwE9Krc2&_nc_oc=AdrV1tLtfKBsUB8cmIiTp32QZ12Igiz6_UgUmT64IxXFDKT3Z7h7IhU5Fr9OXP5QAYg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaIOYydWSbV-oXSIGpxyfBm4ypgyZbxxlOqusY-FkT-A&oe=6A9ABF65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7YMxsBLNbMQ7kNvwG5CdZp&_nc_oc=AdpqoEua4DnsetWY7nVR9lnbJblVt30Kfvh7ZVigKeDwLhoqgaKEHsdD57ZKTsYr8qA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdJHFd88Dl1fXXsBY7DmBzu8v7gZ_YKnlseH6MC7Pjzg&oe=6A9ABE93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
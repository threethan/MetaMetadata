nt-sin6-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OrHCy9j8osQ7kNvwHihEnc&_nc_oc=AdrrTn57aDOLOWz7NlgAHKpxTthJxvQT3tF20xrEe92es4f2rfEJF-PAC2-pFOhLCfw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz8wWnqyCbUusWbOdb0LTWLWNPFun3zpjE-3NAhONX2g&oe=6AAEAD3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E_WLRVpPDMQ7kNvwEL_NLu&_nc_oc=AdrM5iU3Vpp9GR1WHllr7sqiB1rkwxuZG8x2T7Ie1vABQxYQCH8wJSocFdv8eaFgbws&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX4eHc-3dHxvv87IUIl0bIleezabB3_JQCHFyMhQFR-Q&oe=6AAE9965"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey-R4fwv1ukQ7kNvwGHTACO&_nc_oc=AdrorkGmI_F8H3MkdJkHvGXiF7F0ag3Cq9AlfE-R9O6LjBaXUZFXc0ZfYcZ85DcXsrs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISgM9Jsc_mKn06mrV7732JmORnlreFIc9uR-QkxvBdog&oe=6AAEA5F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHv6vLZjwEMQ7kNvwFyS0F6&_nc_oc=AdrLH534u06JwfiWo0pXsORFjgjEtxvS1lO-0Ybflb54CM4AJ1YXV2fn6sugVIUj5I0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCD8pMEqTZJRv4G7HHQoWGyoFW_TJ-K6zDPK5gBwkgMw&oe=6AAE85E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZeHB-7I_tQQ7kNvwGXHv2B&_nc_oc=AdrJL9chM3vqHGsIqouHt2cXdmqekZ9Nv1_7DH9bVxYIY1_u1vh_PT6avWbIlRdvJf8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDCpp2QgpxhNMsW4k6ic3DfcMVsK786_zlbgWSHmEQAA&oe=6AAE8513"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_gr
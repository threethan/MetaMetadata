-dfw6-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epq2128E8DgQ7kNvwGn_WTS&_nc_oc=AdpLWzbrvXQWjyrl1g1-OhNO2R_-vJnmEwjxCm7CIc6XlhUBYRYV3RKtqRzJcVUOZ0g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrb47RrbXG6KfUoKymhg5l2oUCRbGQTShO-5o9LzG_hA&oe=6A65F27E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHoWQHBiR0EQ7kNvwFu3q2w&_nc_oc=Adp0GFyj9ISF0OH7Sb1BnfOcDm1dPTsgEBU4mxAAGsV1RejFaErFBN5E6v9Zrm7hnXc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqhIboWzqwaZDbgWJpnN7yHVeCacBw-dKMuZ4XOB5YSg&oe=6A6616E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_a4MOgzSDAQ7kNvwFgo13O&_nc_oc=Adrem_Vs4bVVsrFv5jpguSfSYenxcb4RBA1vbeuKZwIU0Xxfpek5byE9scDeTZq2JcY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5ZdInDWD5Kf9S4xpKxY-sOpQLqXgkKXmKG55USqfzmw&oe=6A662372"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ1liH23IDsQ7kNvwFdDQb0&_nc_oc=Adrhcon16-8jYW_cg55RkfhD3rYsksM0wjmu7aQ3xPyZo-2-xBuNrWOa0KDmrIyjmN0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAniloSBL2VaryGJib0OYE_AWE8tc_bNUb5dw10ZrToOQ&oe=6A660365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPOsQ8VqvAAQ7kNvwEPLoAJ&_nc_oc=AdqeRriDle6oPxlq9uhiE9ilGOIWI41OodhyDUPfhA82DXsAZYmAm8q6AUNEY8nljz8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAaVsqwsQJd80mli5x5PiOnY6-MA4VMFLtn2r1GUTZeA&oe=6A660293"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
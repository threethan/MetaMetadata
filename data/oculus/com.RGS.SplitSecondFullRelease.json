-dfw6-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOP3ymrHIccQ7kNvwEyo0X_&_nc_oc=AdoogKRCfXGSXBI_BPHEBU0i5WOZyqxAVXNTBKPNUe4ohsNKKdt1FNRJMiL2vjdTIQg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyg1h8yN5DS7XG8L2ruzhMJJRonD9j-pEcHQ5rysW8fA&oe=6A8ADC7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H98m5nPAnWYQ7kNvwHSvZAe&_nc_oc=Adqv9tmfegWzluRkKWLiDoSl4ZyZ4NrkH7ksrcb0D3sZsDBLTdf-DiBYtgMoi4j0qHo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEz3wmZ9ewNYPhEXawHaiH_YuP1BvixCUJx0mu3WkC9g&oe=6A8AC8A5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLC2WKpZnf8Q7kNvwHsQFNe&_nc_oc=Adq5RjglDBOCFCwRKGbOk4yPlbqcVBGOrfNYKH4OgzdK8hNg4fqlrX8JMz3bleWfZv0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTphcN3DaV--L2Fz3NW0sSu-qahy4ugQnvzH3i9UTd_Q&oe=6A8AD532"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paE4eOFBNTcQ7kNvwHw_Zoa&_nc_oc=Adp--TuT4L4uobs9NAit0ShZWJqesUSmVb8U8qolrXrVIi2LAXDuu1BoxYZqmFkd_8o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpBjjlKTGiv4NtEiLnGZwIBPDn_cEKdcgGXBP18JlCrg&oe=6A8AED65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihu-hFGS7tQQ7kNvwFO5jjh&_nc_oc=Adr0w5bGNdAqUgrwhmDVxgWTL01rvSau_XXQU6Bbyu_75GPZ46TMfkpeU_YWhXmwtTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEypPACDYZSKVtSVY6K5EruWGj_uMblsOuOPft_JV4aRQ&oe=6A8AEC93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
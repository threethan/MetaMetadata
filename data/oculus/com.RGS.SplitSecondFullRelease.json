-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pxzqR9ReIcQ7kNvwGGt99x&_nc_oc=AdrWJZeqseTqivHZFfBAo-AucbMlvU25u4l20iabbPLjugDDZzR4JZ6fgR7rCle3Chk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9e0jp4VuDSxGxkcthu8n0VSBp-KKw2XMWa4UEMOnvKw&oe=6A537D7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC5Llpxz5Y4Q7kNvwEmXFk8&_nc_oc=AdpINAmYpwGz1qi92aIE6ZCXKRjBiBffRqYAkDxVChi-KhHd4GsM_nYmM6iu0jsD23M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHzeb1fIJQhB6Ptq-WIR-IgoRWa_hM0Wq4Oi-G_w4F6Q&oe=6A53A1E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M2YrTNfA6gQ7kNvwG9UgNk&_nc_oc=AdowVPxq7lkHoZ4cygdblwu69d1O5asCCEHRoH3qdyHlgOT8B3v5IDb9f0_XN0Q8LgI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKL4Tz1_xSSF-v35pYSe8DAI-rHqB1JloqIdakOCk6LA&oe=6A53AE72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiBN7vJJdJAQ7kNvwG7yMD6&_nc_oc=Adq774-gVeQzRZdcOjSCUW56nm6Rd5CTPuSDfJT3FJ48IbLJelXfuHoG6kc7T3d43yQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKNs4gyCedx4aJujwpXhziRQ3Vj0IH8edmDCk6wF4G9g&oe=6A538E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4YGrVaxgq8Q7kNvwGTilgl&_nc_oc=AdrYpzRjfCEj5o9dOTVplCJTCoFC7I9HBmU2P-2eEP3zR-30932Y-sPKKseB9SVYY-I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk1yXS0ShLIWxVgc-5keLjTxvoWs4QJl-8FucthAWCeQ&oe=6A538D93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
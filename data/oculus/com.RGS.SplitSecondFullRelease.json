-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htRQyer7cW4Q7kNvwF7zlHP&_nc_oc=Adr4HbBgLCAZWUTtcunTj2m_1rM48IwDT9nLzwec9PQOyqthBPK9OYogeR_dfuIJFEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85rA9j6AZwd9LIRtL2PAf9NA7cBANbqkGAvKBmwpvXcA&oe=6A3E9DBE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw1VK1Dcf9MQ7kNvwHiZ7nl&_nc_oc=AdrbtHfFK15wt2bG6oOqCLhKvFmoqewh_ZAiTYg-nNzgGT2bJ_iZy6EMcY2AQWj6XZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oNJ2U2_1GxRKue2cN5YqpuBNAmt1U3u5OS-wcx3xDQg&oe=6A3E89E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TWpy0dPH60Q7kNvwGDlvi1&_nc_oc=AdoFBscfnWCer-Kq9MrDWlzQ2_z_ZOR-vNf3UZV-faevQRm0LjkY4v-CscBbLU9P1UU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ueh4ZB-CBA0ImELHvzRTiLQRvlWWCm5_Ew-QlGWIqfA&oe=6A3E9672"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JOl2Z1tvnIQ7kNvwGspU1C&_nc_oc=AdpHc2ayEWUbNdpsMzBs78UQLCZiPwOxwOgkiww3YIqa4SbW1Kohfz1T0Epe5p2TkzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C_y1kgGKM4Rv7wagBe46jt7hfe4zySUN17DE47iF8oQ&oe=6A3EAEA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzRHTGZtBfoQ7kNvwEPAhKQ&_nc_oc=Adro4yLmhXqjKRFIwOQkNpGOKQzCx3M_Q3pnAT8wr3Cswhe4KfroVlBCCXoZJbknXfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_drDUblRujMMVpFW-wvtlqasM3qc9r2xJL9D5QyW-Zsg&oe=6A3EADD3"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xbx5nx4Zj4oQ7kNvwGOYqI5&_nc_oc=AdoVVx0jYOri1CflqdG5UDAKBkz4X4lUhDyRYTA5HlgyjoqUrHYt5LwiEgdJ3ahw0jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0AZRZko8R3JbEDLvbxP-eTzJJq7U319nvpUhwqMgleQ&oe=6AB3F33E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ug6Tt3wTq0Q7kNvwFGxpZS&_nc_oc=Adr0Dcd3lIDBBsWCAAgQ8t27YnJ-apTmKD9Gb26XYc7xJq3Gq5H_aU2_v9CgMX7H3YY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyFaAAn6salmBfo01hQLIZQpXUGrdCRdQDP2xI1uZteA&oe=6AB3DF65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KSEbfkrzIsQ7kNvwEdI0LZ&_nc_oc=AdpvdVqkbyaW_NXqfdbk_lQJGpASNTxzt0UuT3DXgpLQEf1uEHhAfO-htcH7dPmHJJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_7yOYm53Ay-PLzz9Kug7ukDd4z53sEEfZEXsaLkB1Fg&oe=6AB3EBF2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl2DJ3S_yw4Q7kNvwFVntOe&_nc_oc=AdokdSrk8NlK0ueQG3zf88dSczRWtlQGRljK0jy9k8-oUFG-wqsD7eMH3N0qiNYnfQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK05AoYyvcxFbCMQgn-Se_SWEaTCY5Tyu1ZsacH1SHx2A&oe=6AB3CBE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR4hJJbw9zQQ7kNvwEUlZI4&_nc_oc=AdrLyRD9VY5vlnV9X3rsvo0cxVZ-CbOgSFbNqMxgKfzc6sHVwbdT0aUE2XVhgGTuhLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPDES4NEc8H6AHxO86FOBO-NEnEYb7OfQg6jwjrcWwuw&oe=6AB3CB13"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
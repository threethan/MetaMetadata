771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHUQmE0nDiYQ7kNvwHHfDKl&_nc_oc=Adm9mqdFbRDdRkmzwDVARGy5k06usGIBXUqz8Vx3zxY6x8cdRXPH6YYFoReWw6OuKVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy224_5JJ5JBVLl83xrOuUYC4tSyoRJmfE080oyyBwo0w&oe=69B7EC7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ_lp-YUmmIQ7kNvwEdbx_3&_nc_oc=Adkbeibm40_ex6gmqUB0F684F1fuVEjf1tBFolHA2abcQgTmq2BFaLgJTK4qqixE_-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzsnzYpdF5FWPxQzJyw6JU_UqwikPUEQLyw_M3XMeZ6Zg&oe=69B810E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9q073alzJIQ7kNvwF5g8eH&_nc_oc=Adn1uk-D88gtlCwWiVApVnlSaeXRlgrDQL8xR73fOW4I8Tw4UZ7DlyznHqEXG3qoT9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUULywpFm_69g92blrXF-bGzScziAsPsj8C55yd-Jvkw&oe=69B7E532"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbouo8GO4cMQ7kNvwEgWJM5&_nc_oc=AdlRX5G4OMPLAX3Br2K3x76iXORpFPmb8wjJ-GiPYZyKDL-9Bed8Hafr0VX8yPgqJJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3GmTZ3l86l55aKtvu8CPzeX1mR4_nQ6ejorUjdPhNoQ&oe=69B7FD65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0kRyKZtSKYQ7kNvwHFV-lW&_nc_oc=Adlt4s5Qk81V7t0R0Ruqbc9HOnvDxDgMQ3a2_ZJpHPVmRhoJ0j6POQPF0ajhZrRSwx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyHF3yLr5IT1l17MuFLMJFjB9lQMFxANoptL0i1d7Li_A&oe=69B7FC93"}, "display_name": "Split Second", "keywords": [], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
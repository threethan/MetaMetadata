771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD6zTvrVoWsQ7kNvwGo1d8R&_nc_oc=AdkRSo5QHBEjhQfTFH0oLheCnzdfVEYcCit94mkFU1Yv2By9YVpFukbYN5IOH41L8vM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbtbHeUEcE5dLCDQnudgUFnHdVmjQPOor64WSU6iMgeQ&oe=69BE83FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMSjpx3pbiYQ7kNvwE-hJLw&_nc_oc=AdlJteEKJ29kKdcYcuJF96ym8tYHIWoSmYrBFSrsJTHjFRqFJ15vwg66hr38WuPaQ0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNIfXe5a9u6JtHDGHxUN4QMBptapBKrZXAqF5f2ljWvw&oe=69BEA865"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6uFDxc-bmgQ7kNvwH2dobJ&_nc_oc=Adk5YIrh4YFE0NM5aToDHExF6rmP-Fzd6dPI9T---uS3kuuNDxnbTD2pkcklPiAaLX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxR-hqP6CJo8FTkeizphfe_8LLA6KVnWfV1JbO-wfhZhw&oe=69BE7CB2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3sKDGykulgQ7kNvwFCk-my&_nc_oc=AdnYadVPMMLJL9rcYCnpoinAhUgSBGNaCOIQczPAXS5Ra36VvRrTdUU1IdMQ6at5Ja4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxFtcvwlv3-vgApzow9T88JTsEjShcJGetv4cg6gKYnQ&oe=69BE94E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQsQskIpqvUQ7kNvwErjyas&_nc_oc=AdnZ04OduCDwVatUiqrIp8OSM_YMIPOLrmyeMk_MEokrbDOvtwVSvzXIz3sytIXuu5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFYWxkttVZFsOZDvHhh-DnWCfgjamPg5eFyLicZbx82A&oe=69BE9413"}, "display_name": "Split Second", "keywords": [], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
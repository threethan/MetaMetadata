-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2jJ3oDahPIQ7kNvwFaZbjs&_nc_oc=AdpVhYCgT-YGyDKsKZsUcH6v2UUBIjQ8xa5Pf4WCzrO3jRJr5qlx2pO1RLMEE6g-Ud4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyMhR65qQGDCS35dlNg1527wHU4f2KtHS7dc4PSIyCUw&oe=6AB7E7BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_eo3aCpC2UQ7kNvwERJK3F&_nc_oc=AdpN_O7cOGL1_zNbDIarOUH7LDne0dyT2ZMt0pnwmFCWjoN59TXozAk2vS34REofQkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISBrOmwamibs8aY8wqK1nPzxBQKaF-ItCoeTieqU3_qw&oe=6AB7D3E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as8ISPcg8n8Q7kNvwFJPbzo&_nc_oc=Adqh13o7qr0CkX2YOaAvYFJOlsARQOHiTz-kkAvkh92SlT-bP2nPioLSzeDu7-ebMGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvfqeGV9OG3p5kneBX68fu5EowMj_P6QsUiuE1wjq9sQ&oe=6AB7E072"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6s8LHfTxNsQ7kNvwHsyxeJ&_nc_oc=Adr9RIq6Bmo8DJiwyfIRGS7ytDs65-2e8MQjBy8vuJgWo8SFtzxq0Ew_s_IhQxBwHOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_XoyxtzjWbrdEOQ2gu-dLAN-8Cig-pQRKY0lurI03Ow&oe=6AB7C065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgPfs72Nf5oQ7kNvwFH4LjJ&_nc_oc=Ado6AWBd1uUmn3bHMUd8yZ-10JZPhW2Ko7db9DTF6_4uh2JJiyc8xFRKz1dFvVTqy3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIptfx0IfeJ-JVZkMSYiKrWbSysacezWkpx8c3vHOUT8A&oe=6AB7BF93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
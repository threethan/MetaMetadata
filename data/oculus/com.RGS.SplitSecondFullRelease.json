-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzIDzCj2LBcQ7kNvwE9a58E&_nc_oc=AdqghM_iLjpxm3nsKkV4VfxyNc0DezmoK9TGXIgJlvSrCq8Z-9DV4MMdkAgNtcka4sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZfLKVPxCLG8AB2ATlSVFSbe9N1-eAwyauwARq4BLbBw&oe=6A7C5BFE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqcQDdauinYQ7kNvwEVjs1P&_nc_oc=AdpPtt5qKI35a42gKv7-UPQJaHfJq8vBgfIth5Suhc0iB9jGD7hIvlO5eOVexelmKmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjhn1PtuiMyTmIvgH9QyLxNARuL03v_Zsjddws4vQO0g&oe=6A7C4825"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRfP1ipRDQYQ7kNvwG2hJh8&_nc_oc=AdoXBtmZk0ehNbijYcdrJrBrItujdwD6Srjdu5mH32pnm2dBdLWVDiZYgVZNv018ctg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyeVkobD74xGuScvTswIo0A-ZF0Uzj8vroweKzc8cpeg&oe=6A7C54B2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUDQOPGYeJwQ7kNvwGmP2g5&_nc_oc=AdqOgILm4n1w0P7yGEVe5YfrTyZremXn7CWu7UZxoZz77dJXw0wreDlBiwcykiIE1W8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcfQ0TDkXOTUJRZGXrqxZ9Z8i2Ur2LPCPRhV6gVdZq1w&oe=6A7C6CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYwxz_Vz-NgQ7kNvwHvkvm1&_nc_oc=Adoz3KDImod0R48MR7DKnc9hi45toIkXMvKzSJBMVauQvsZySs-86EP2ARgdoLr-IUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ1ZRVQqxeO-iRCULFzjcT9eZsKLYyfElzlu9av5JsNA&oe=6A7C6C13"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
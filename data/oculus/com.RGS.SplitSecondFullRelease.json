-fra5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqWDeHul8R0Q7kNvwGB8vwm&_nc_oc=AdrGT3wd5yBVX5Dd6NVTAEb7EVlNuwEBxeFAJEbz4qIcm61Rju5GAo07pqqk6r0RC1M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8wfRVY-ukxaP4U_b90R-hC4Ss5_y-fmcoUqm4mguHYQ&oe=6A88397E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haCWe9zCiR0Q7kNvwHMZ2qI&_nc_oc=AdoFkqNTkgjgb164U-ojHLMPsjIAXJ9CYnITb-LEl_URZmuPxIEQVVt-AXu-4FwbeJ4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_v8PFOtGz09eglVpqAgQOlOq17a-t_RrUJ1Rvw1HLgA&oe=6A8825A5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbGV6ZGDvAQQ7kNvwENdCRn&_nc_oc=AdpBtrq_HpFA5HjYgl1kjT5x42ofVDwR_Rsw-9K-1MIk9iDHTDRdzHXQIjDXAqfYklA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHycSMX6TXHhMXt_V45qWOwne4fxn1Z1pQZh-ausr6pUw&oe=6A883232"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzzxTuxDoDkQ7kNvwGD5a0N&_nc_oc=AdrnNPmWDCF0yxiWjq28e-3PES60ax8L_mXlIq7KuKVFeoRdNMVEM-qiLMAPDzSCOUU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBfhM3DN-ERAbOHUGThunkdHsOe06GULMHYW23LWGP1A&oe=6A884A65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka3TLMdrYWAQ7kNvwH-18Ij&_nc_oc=Adpmu2VblFjz3GUz8Ig4ZkAEIzpQt0LcwjGTzLtDbaFrx6B8Yg2NZevIMhPc59hhHEA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdjq0AQkfFM2xJm8TXliYdOymMNtLHTB7jU3x3l9GXMg&oe=6A884993"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
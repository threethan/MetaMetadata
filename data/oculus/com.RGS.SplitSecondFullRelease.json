-lhr6-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=514LRZFjFhwQ7kNvwFDBSZ-&_nc_oc=AdoOU2KwIrp-AKoZvopjrOdI9v_MlD-EmyD7aLFRVMtIh2ZpCsKg8Xd3urScHpRg-Cc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qbp3cBPc5BeMuJEi6lkuhTi7OG8oF3ZYl3c9pqo8ehA&oe=6A10793E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmzRDWXZVlAQ7kNvwGWgBS7&_nc_oc=Adq0nLYCPvB_zyBx-tjq3eHczWH9SJXF1V7zjb-TUDlBTlF0qKU6IvI3nPEgDzmMyKo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RXW9QwWWDwWp0WLqvzvuaOqYyeuo6CuEXtXoxp2m6wQ&oe=6A106565"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpWP9mvG1doQ7kNvwG-MJYt&_nc_oc=AdqvTLgLwPfxbn04GJniMK9bq8b04Kcrz91N4AvN_F9rSW1OJoy7uzDwb_RmS2Fu1iI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e9ZCb7Q74-7q1xFlzgOiQPeqpw0pQKPn62mT-JW1n0g&oe=6A1071F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kh2cqRoojkQ7kNvwHpsGLk&_nc_oc=Adq5zDhmLMZwBFAIT5ROVYTvgZEAoMRRx9ZyktBnlNgPvmkn44LX7Y_tWoVYZTgwsPs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p9v_Y4W95mMfkbBTkEC3aEKcfbv3KWd0ivvc8EUFx-w&oe=6A1051E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6_3J2-7V0YQ7kNvwHA8XBT&_nc_oc=AdppM0zg1jNc-Cu0t_28yH5M_NEv6OXBgWemT14NHjqrs6vNC351UqrQMHXEAJLQgN8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FdsbLXXa7ssCqEQlKRsMjVCmxot1n7z4VKfO5TCbHlQ&oe=6A105113"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xeui656WyfUQ7kNvwHJGDxb&_nc_oc=AdpPo46SLmLwewXoURPRAfv7D-pPuCQUFoE5X1sPsNm2Y4qqJLkecCzzUJUAcn-F_4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DyvlroXh3Q_gNf8uQbZFvVleGCY8xkg48fWwWmvKR6Q&oe=6A15BF3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmX9FEL-kz4Q7kNvwGEtN53&_nc_oc=AdplxRohRaH2eegG1aWMbCX95ZKU1o0CD7yljHlc-ZDP6CQqDCvVditXw8eFhN5HkN4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4McbJEpkyvDQIgZscqUFcD3xMhv5HEMb8ps5v0SoyWFA&oe=6A15AB65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJF1HGvCTscQ7kNvwElntEI&_nc_oc=AdqQZE3FVS5vpLyq4jljujpi5ELqUtYIaV22zNYUvxXrvkmQZ81yp5FrWKb0kYPBkjc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q9hIBHMgOorGM8zWLzfFwKmkNdL3lfXYzR54hy3kX8Q&oe=6A15B7F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-Bv88SSmDsQ7kNvwFn1QOc&_nc_oc=AdpLR1G-rQP9mk38raWDjZiqUwW_X4uo_J1XxyrYVqYt4LQaRCtbEE_jQx8-UWB6SOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r96DMYdAfnJez7phF--_zxnhpkp9grYgksHYe1tnKxQ&oe=6A1597E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UDJFZuRdw4Q7kNvwEASb6r&_nc_oc=Adq2JMZDYWjudix9hU-cqoHY7QNsrWAcMRjGgfiicEc2FR6uH0a8_oOQ6GsMIDNSYwM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SAduTwfJpqT0V5Ilr7BGq-IthLQ27E-3wlxKAEwK2wg&oe=6A159713"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
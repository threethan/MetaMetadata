nt-sin6-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGoRfVLZETsQ7kNvwE511so&_nc_oc=Adp5GtooO2iuHto4dAsQYQC6FUM2tQUWbBc_dpftJoqUsyRQ5X6xwjgqpGuGcC9rEMQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sVs9gcREboVlqp61p3CXSFsMPee02VzIKbDymPnFxxg&oe=6A36B4BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVzxU3BiqvYQ7kNvwF-jR35&_nc_oc=AdpWeGy6UxY4PvpQMBXgtlZGlSIkZG6YCTJWFlFITc0SVas_9HiIpT1N7ARSqmztHio&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3FqMiDFNknSUjT38BRxp_TtnkR-Viuyd5Pm0tEGy-Xw&oe=6A36A0E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qxUX8eWb-8Q7kNvwEIMQdb&_nc_oc=Adqd7B9CGZYclwgbBrmcFr_ZVzEqNVcf13HH3BtNO5k1vmJpYldjqMg66SAjVQsgZbY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YCsExJJM8jCBKVhkRQNfWUbTzbiFUOzgZ8b40gKw6Sw&oe=6A36AD72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHope23gbiAQ7kNvwEHKQRB&_nc_oc=Adq8P3c-K1eF-S20wKlttDzhSBQiSjMDq8WlwXjNBtrc2uPszAtnhz5h5gVKd3yeNwU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-otOTLNWhSMc4I1bg0UqN4Hv7nmDSxe2W3HKPhCXfDSQ&oe=6A36C5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Jt7VuxaxBwQ7kNvwGYtT31&_nc_oc=Adq-poJPVko3DcfufPNDC4wOdhyVFK1Jkc-I8E9m8Y1iotCkbI5dHBQmIOp5lsK0qFQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bbeI2trjJ58FikwkNX8qmkWiiqCLkqfBPHZRoanIPCw&oe=6A36C4D3"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_gr
-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpxpY3ItY9sQ7kNvwEpoCjT&_nc_oc=AdpmGROnzP8u5MLvl08T5dFu7sBQKrqgmHeC0tgdyJcnkJofOoSXglGczcNWvqJIR_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEILPjAydEaBO63V-xtW2BodX-GrmNrZ3XIehWK7VsIA&oe=6A68957E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHoWQHBiR0EQ7kNvwFaur0t&_nc_oc=AdrCR18TB-JoTHQ0ZGAG2qwc-579Y7MVd9WDzZ7cCtO2gQhr25xU-QmDdsj6FHnsmQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC-yHwB_UD6wfoDctl9ZfLDMdqoGpyIkg65GZ2wUdkAQ&oe=6A68B9E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ3HOVDHOrEQ7kNvwG7m90Y&_nc_oc=AdpGTxlJF68KpizJrHkIKrbIfjgTPLIX7WqzT6C6bm20nd1xsWPLGG-c7qNYIq-PdXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmmr6PK45wMelpxS6t1LrwvZZk1yH6wVzPTlgFDdoamQ&oe=6A68C672"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ1liH23IDsQ7kNvwEur50F&_nc_oc=AdpFbhGqYwpoHdKXH2Z6qnisQ0m7UJINbfmjBf89bqz_lNw9yjH982IROZvejmkivCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVk62WdL2uWOQDs-27LFpLqUNwtYCItWY_AJhU9Ha_sg&oe=6A68A665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR4iF_rsKucQ7kNvwHSyyD9&_nc_oc=AdqC8YfWmdLfehdn66opZ3W6a8tTInU1VtjX0-KCIuh2TKeM6qLdftgBo9yCc_8PKKk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4urFHhUg1vos2UXCGhhQUs1jLDQjOiDVq6qIB3uwZ7w&oe=6A68A593"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-qro3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbz2n4685D8Q7kNvwGEGoYd&_nc_oc=AdqIYquRDSFB--09xVt6LBY6H-8yTf5zNplWMjgLmm9WN7xJEHBXvbzEtu4EkHA-ocI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGecLVj7gbJKWjUo5UnD78yDbs5mSzn9invIdjzKwWP7Q&oe=6A972A7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIdowq1WFoAQ7kNvwHLxg8E&_nc_oc=Adrsmr4RT7uo8klu_4wOSLyNqRNH5MTCxgMOzIKMy5wJmkUkNLXrtEP6wh8unyttBYs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXm108sBO0cHg2ZeECA9XLhRjjWq4M3cUxTIPuaQvm_A&oe=6A974EE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_0TGD_n_XEQ7kNvwG3w4em&_nc_oc=AdpyGVa4MSjAO2DJ_wuHcYY1hoqzBDTW29cirm9vZf0Hucg6SSXv0Ea2TAx0viBAqcw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFidyb39mkX0Y9CZY0h18rk2-OcN3wI57K1zRT6BBYrIQ&oe=6A972332"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsrogVtpQc8Q7kNvwE6PPpX&_nc_oc=Adoqck2AOuuEUADavmiGJME_1R7uF5JqDYXn98X1n9MPq8vGdTh5K8a_g7iW9M-kupc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCsFA9YtPE5R96O-34aq2x-Zk1ihpQqQ5tyqbe-Q0S0A&oe=6A973B65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ1uaFnRkdoQ7kNvwHqV9sW&_nc_oc=AdpbO7XbGHnqYw_3lxgjC-yhMLHNIZGmIDOoAtEVd7gMSyytEWHttNTBKPM-AACE0tc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOs2riK23djyk1Mo7ZOqBOQEiFGkL2c10r9tpEpZjFrQ&oe=6A973A93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-hkg4-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTei9srF1gUQ7kNvwFP6Fep&_nc_oc=Adr0uUc-Z1NG1yooUuOchCzg12Q2B_lCEEUNdkfCc5o_ES744pWATHzGf45yukF-Knc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSd4xa05GTVqjhl0StdiOKHolV9WYS87Dxn2PaBMMHoQ&oe=6A9173FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw692n8qBGEQ7kNvwGc1QwV&_nc_oc=Adrm-IbQ3Vmalme1QpKCvbcR3xFcJzCSj2HAc4Yo1dQ6uk2OJg7gmfefRehhvkmt9Zg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG92vN8dJcGs97i54uzVU-dTJzIb9l0LPwuDFGsZl0BCw&oe=6A916025"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1mCsXQs7rIQ7kNvwHjmpLQ&_nc_oc=AdptH1S11vhpsdZni5xDUxwgJRi0hx-YuurkkmAxLjz_wdH8T5fJ6i8h_9iuobtlHMs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPzQMUA2HHFPWwoULPcwMoLVhI_WvTmGvSHW1q1VWMXw&oe=6A916CB2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yYmw78Q9-0Q7kNvwE8ozGT&_nc_oc=AdodX5i3s9Xeue3yzaQWaJ3ScFZWS3TPpgFUBziyM70BbYTx8IbyfvW1tsxMiYKtJ10&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaLttJyK76nhqDtIxN-XnaTEF3Jb8Izx_RuUnZ-AD1ig&oe=6A9184E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG_X1Hojpe8Q7kNvwETIlQn&_nc_oc=Adqll5gG0gse_WndtCoGxZx9H4eGgjsBrickv4XZaNZV72wctq9sjZgGIC3bxpCQfks&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhFNjtoAL3I0-jI7hA9ACHVVB0SqQZzblV7aLd97rBYQ&oe=6A918413"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-fra5-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wg6VhckuW_UQ7kNvwECrnsU&_nc_oc=AdpdH6G-606nh0_2ILH7J-D_6oBBQrhvPLXwrt0QTz8ezbYmhHmrYBxGG1Ocy4ZVdRE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aQdBnQoXL7SKYrOkoEBqEQXwGWtsaBM_SqMSPZo4pQg&oe=6A1B053E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1kvUIeUzGMQ7kNvwH7wE22&_nc_oc=Adr7j0HW67PVoFxNq5S-qJUH64UHB_anyNYHq0cNHPDEjVI-3VAlJ7qTJjNafWvr54U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56w4aM7Di8ghps3OsEPtkTZvFMf4ZgiSOLxMQLla7C2Q&oe=6A1AF165"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1cypDR7rSUQ7kNvwFfFji8&_nc_oc=AdoMeCJAHLeyMUmi2JjamJEzxMtaV7-P114kknmlA2ckVqhLzuSEVDvtLSIBqmdnllU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n2KqTODN9PPEnZrfzVRrsUDHBVR6AsdpRHt_EX4quxw&oe=6A1AFDF2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB-xr09nxekQ7kNvwGTLH9N&_nc_oc=Ado4qhyAKT8L4w03Axf7N0DPyk94PxrBshT4A25ntEME6E0XtTM-ePSxLh5idE2DTi0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yvQ0mhH7qXsXacjPsRZpjFB53-BG0UTiprJAzITUZlw&oe=6A1ADDE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJkG1Dx4ww8Q7kNvwEPeWfM&_nc_oc=AdqYWX1TgHzCu5W13X5cMMzzpilzHyGe5C9rxonT6fx6IWCQvIrBoXgbQCyyRItArLo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EsaZ_tDGIMmcExltT2jMfvute9E0aod5T74E9zxcssw&oe=6A1ADD13"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G4ormwf8EwQ7kNvwEcGOA9&_nc_oc=AdpF9wdtMyJYmL6SaRpWtmuD-UOuG6Ao-vqCQwQiEQw8Jm9Mk5_5PWF3NOMlTWimv7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwlRP2udfAr2y12YMEr6MifJKpr9Cs6teuLmsLX9BS-A&oe=6AA6C43E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJRTV3147LoQ7kNvwH3mZei&_nc_oc=Ado_3kdA2Qwkh-RWuR_szWV1QREqsg8x0dBWjtPKPGq4j2wWS1kMTd3M372QcoK6DXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrcerLAM5SXHrnTq8VqJaVYNf9sZUDeM80MPtUXafSQA&oe=6AA6B065"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-GxeNWmGQoQ7kNvwFd_ZfB&_nc_oc=AdqG-pVgM2EfDl9eMl0F-z3UGYP58Hg1cwJbnCyoPMvyD6_Lt4bzmE_xjIA7G3vra9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA5qDwUZdoOCKR3zpgroRwzZsfncGc-82G54gkoTgnDg&oe=6AA6BCF2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTB2c-sv4JgQ7kNvwE1aOq6&_nc_oc=AdooVVQrHcMH1R6ZaPIpQxfzdInvOiQ_dKUnNxFoukjGry75aWXbpqXikPhxKec5WTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBX2hlJhFJ9TOgvEGmZT8M5MPHDrFtm-ykjMHHhAX0pw&oe=6AA69CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGxjfkAsgHUQ7kNvwF1IvlP&_nc_oc=AdpNGMFCO0z88PFmFQDsATgkbC6qQIXCB6lJxxnquGi8w58zCXLWo6choeJB4Yc2b6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJy54uSzqC62r62CR0EFt-G6TmSu2L2rS4LWF6Zwx5WQ&oe=6AA69C13"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
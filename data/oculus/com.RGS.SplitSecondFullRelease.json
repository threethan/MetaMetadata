-atl3-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAe4kR0oF9oQ7kNvwEYfkkU&_nc_oc=AdrN2yCCOPbH-PbOehDoFesryqwBJGbiSfYL7B8x4mFLlUH3KP-016yO3LMwgZ3cGhk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gD5Gw_NDMYB2ArILPo0y0kw3Cp5iperZhJQ79RKPIeg&oe=6A301D3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehiDNYHoqxIQ7kNvwFwlShS&_nc_oc=AdqheCBTF31r5GATtnZTI-QhcGQnVxAq1R3XLa_uJiikOaNAg2xLep07MDJbheAubcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8OfIp6NLqgtXr1BvRTs0RsPDlUpv13h9N-1w8oYW5Pg&oe=6A300965"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeHT3VryaRIQ7kNvwFJ-o96&_nc_oc=Adryg3jKl3_SOTaZQ4ZPxHWQ_ubeVduoOTU4ts9zYqX4wpBYi1_7c2wLtxuVe6Pq1bU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zGkcwXRSS6rNFRX77mAhE6H_dy4JC0FQQO-O1AcOwfA&oe=6A3015F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qo-v2SfVLkQ7kNvwHQUukH&_nc_oc=AdpBjtrSb9p8YXweUUlR1jEyLabjtg0j0i64tpA5CR1iiCMRMfB8XfXuifm6VX03KSc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C59rUCz0N8vL8tky1v0O_URXzpDRMjh5JRmtOtubV-Q&oe=6A2FF5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AljCrVhOLdUQ7kNvwH0Xuqv&_nc_oc=Adp3O0gRwRnBB_htz6kPsAcKJNIHP3-LdjYqnztkC7IiVJDrj3O_p8U_nGfbaz_J6BM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bVx8eaJpl9NbX33FTqat6almlmmRUxGKwzMLJIG5mMA&oe=6A2FF513"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
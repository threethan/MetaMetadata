-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VGwzJQatRoQ7kNvwGiXGVI&_nc_oc=AdohueEOKGpXjhqFG4bRUO1Xsw73lwjZlCGVKyDvofhRr99DKgYx7oWWJGCsqYMfqeQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhd-tx7Crj6iAgE-sTDvLfg2Bh3wtR_oC0q46iE1etWg&oe=6A8444FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF3zHtV_YmkQ7kNvwFwpga_&_nc_oc=Adqb2yfo1BO9JY01gGrMhi80se0G6w6GFRm0y79yXyJPMo2SH-p8udVzPyA9vNw5TDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO11ZkZ2-fRfvuuZn6UJdBSbT_SJDga9A0WlzL8rB54A&oe=6A846965"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWpmnLQ-h60Q7kNvwGzLjE3&_nc_oc=Adp7Te4cFSCsTh4W8-TGetqbAht9oNA_Xpz-NDDCkNUPQju731lQMWyqQeWxkL8P9X4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDqmMs-KqXSAqy8pQem1y62c1klJCLHIkQQD3dJGskgA&oe=6A843DB2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7889D_fPNIQ7kNvwGfw_kS&_nc_oc=AdroURgfZspHQ_zWydmMb-UnbSh3QGNIdqNIjfn2cPkrP-upwrY0HnLl3SuA4FR0zJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcEBLEoGya292ZCSiLn7l8TTWAy6npKTVS5ziVjyPKQw&oe=6A8455E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdG416tkQgUQ7kNvwEK__Um&_nc_oc=AdqiYszdEyPgzBE75k428Pr4L7_aNTF_AQcvfTfL-xOi9MBAeiK9XbsRpctviaXYvME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiuXqYS1XF7SSQM3g-3kwQImqGQllPC4Ee6J6H_L8-ig&oe=6A845513"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObZHuIEl9_0Q7kNvwGzeMSR&_nc_oc=AdrwYbuQdz8SENa2sFVAu4rhhzbCpWwy1a6t-L8616NGI6b_pqrL1AtBG37rzn20QFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtTAYC3PkjttDvicEo6P_G5zV1Fm7HRdN782a2ZUUUZg&oe=6ABFD0BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGgvtZIGplkQ7kNvwGkJJH-&_nc_oc=AdrvbBJ3bbFlsMRDSV0qwNikYEwk3zuSqR9ofwDXJN-BFKfU80yXhWtpIZ8UJfky0PY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxq2rxcFY0dIWPxjHVjhjbWTPrZ8HpTbvSaj4c938iOQ&oe=6ABFBCE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqciZZb8g6wQ7kNvwHNaXaQ&_nc_oc=Adqv5nQPKO0YwznPP6k-5gLYL8dLeF_OIfJbtTD7Q2BitiKDv-MXt6RIl_3WxzWNqvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNh8MTZCT7GSQQ8LcuQ2qD0Y8XarFMg4n98xm0xU8ezg&oe=6ABFC972"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gMVrvCEnN4Q7kNvwEg9rW4&_nc_oc=Adqo49BYElLa1JLZllxStgy1T-m6RRMq-Uk8lKcDjqsjiAoOpHImKbKkyvcgjIVySzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMST74SM0aBWNiv0Kgq7kqEQBHLgyv8QEACAhJrxS7z2g&oe=6ABFA965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6cuFu8s3jIQ7kNvwHM5zTQ&_nc_oc=AdrcYFKdf88OgLC8w7uL1nFmp9atoHBnh09WSMcrN7l-nDklhe_5LUwZLNiwrCX0RS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoHgkzekrdPvxld5WbHHShOLUqacTqmssQIaZ1xaMnJw&oe=6ABFA893"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
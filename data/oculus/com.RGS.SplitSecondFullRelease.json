-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5_xo7sO5WQQ7kNvwF3pnej&_nc_oc=AdprptpFYpsWuadexZnHQNNn0vVvxxRgMRM7b-sdhF90UtI17oWyibWrK6csnYznj7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcO54_xmjGLZeNMizOfIK7OMmiH4VE01qqeBUwTk3SIA&oe=6ABA8ABE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA97mREa3LcQ7kNvwFbZxXN&_nc_oc=Ado9SA72bzfnsMPEBFcAeyjUsc2eUyaX3HKrzVaaWudrRUhicaa9NkpNCKgAn9zWf50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3I6BlzAYqjRrfNkX2r6RGgk1cQT-5zYQWD73Sbs5FPQ&oe=6ABA76E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSztvzeu_foQ7kNvwHXXQTR&_nc_oc=AdqNQpLnz-ovVURd0aPM7VqC40wFkmWTTXlcdOe_U8HKZki2iyJNtPy8ieLpo8gjeqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0KfLYXoCq131b2z_2DfDPJ0VpHEgInmv-nFPnZnfJMA&oe=6ABA8372"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FacLXHarFOUQ7kNvwGt1-ux&_nc_oc=Adrq8-7fNRaGbDsq0zYodGL-OI-gXf41MBUTejZ0_vn88F4yswpTUWZru5k4jog52yE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8P2_zHCSvMLyZw7zaccXLdmu_2nMGw8QnoNR26nFH0g&oe=6ABA6365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgPfs72Nf5oQ7kNvwF3IqZ7&_nc_oc=AdrqbYW3YV7GCh9huYFicIsXMzDMZg1qEeesOBUjjlD5KjHFGDItDmTLINsRPFQNVb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz3sFw1tiWj5FgSraIrFDYv6kFJAA1NbFJzO_LUJXjMg&oe=6ABA6293"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
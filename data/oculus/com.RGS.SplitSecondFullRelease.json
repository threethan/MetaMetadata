-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wg6VhckuW_UQ7kNvwF0R4vS&_nc_oc=AdooUj777R1L4yyaoLGn1iC8oXk3f3Ey8Cq78GcxGrs8jrGe0fQwyNIIAFbslIAssSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RZu8TUs2lw7LnXCdtrvgHmfqyndjqXz8HITgvIO8zRw&oe=6A18623E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dk8ggbecQAQ7kNvwE4Y151&_nc_oc=AdqEb_4VoNq60YdhCnNQD7EKm4VCJSxv7f5RAqCP7GNipT4waL9z_94_t2XKUNwzj-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_ll2ImGHNr44Fx6kPQ7PRuBPcSB-C-ZgBEdlGnAKAXg&oe=6A184E65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1cypDR7rSUQ7kNvwHUrDJm&_nc_oc=Adr8i3A4j0diHlYccJxIjwwYCVVywqHBOL3nMD8Bbv6-MGn3P-e6VY1tMOycB0hzlUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63IgGny_I_6fzd1AjDfaVQ1tfi_oWPtwmjZwVse6_zLw&oe=6A185AF2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCtqgq7JUtYQ7kNvwFRzC6a&_nc_oc=AdoVcDY9t_AdwV4ynjFzKmpQID6tUodh55415CAFeLBLoQLbKpvpHm4PAebzJf7q2ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-IAVgANnn03rAM940xhy-DgFEMjinbI0mHtoqRpAy0g&oe=6A183AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UDJFZuRdw4Q7kNvwHU6J95&_nc_oc=Ado4QH4NByZjlALz9DRExhxvviQtJIE5rPaRUv0ngu795lBLq4a-AayjkwJXZsOg_G0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G5ZzggzkWe8w53RY7MrgLfRa93bDSY-nqEoMVEJwNPQ&oe=6A183A13"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
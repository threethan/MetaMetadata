-atl3-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqWDeHul8R0Q7kNvwHqOqXy&_nc_oc=AdpdX3cd9XM7nbeqcSjZsMke_OIpaoWSbLKI65HB975dwkl_yNWAAf5r2KMazCAucW8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb6CHerJREnn_htTTGyhIAc9BkxWNQgu5yxE9zeV8T4g&oe=6A86E7FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haCWe9zCiR0Q7kNvwHIGAWR&_nc_oc=AdqoO5IVrejTfpQ7OanK8kFBwFfO1lPiRe0bUCjeO3gFMfP9oqMHR5kYJpzYEkq3e7w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzPiuhdb-X2UVADYtZkbNNv9p96DcHan1rQYKjuf0rGA&oe=6A86D425"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbGV6ZGDvAQQ7kNvwFHoUFC&_nc_oc=Adq-2EhAcQkZtaA6hckXPSHHuda6kQam3Upa7Is6d13FL4cNQsN7-Cpjjifzoxoo22Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEI4iRZ05fMlIujoXQmZM_NHxYcb7GmmHSpKQpB7u0cg&oe=6A86E0B2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzzxTuxDoDkQ7kNvwGjS6FH&_nc_oc=AdriHwUh4BepGslo1y6VEUtYdbrx8HU2cT9Rtie5cqAGnSsDco-zAsKOtNY5UXhACDE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfNjMEt8YJtwfz-oKwAbr3bSpMC0bQ1fUzv-JIYgDI8A&oe=6A86F8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka3TLMdrYWAQ7kNvwG7vnz9&_nc_oc=AdqoIeYgdAHfaGlPoy0NtQ3Rn1slpIqhWMFCLD3MKjj-S2b6H3bTDAEPQZigT_-v69k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKcUqeUTc4_fUAdn1qF94szqeCE2YSyPRK6Xz0qaHhlQ&oe=6A86F813"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
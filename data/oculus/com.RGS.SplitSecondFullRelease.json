-dfw6-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE6b7-2pwqcQ7kNvwG0q596&_nc_oc=AdqsU1Rc6TlUucXjyWsJ2LvfbobNnYM9wW_pgyno3OAJ9x7es22e4yfBbcL9ejFDSO8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm9inpTI7_nxm6HaG0_ot-uuwmvgfKz2FcbcMsEieHzQ&oe=6A5A14FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eyL8OX-DvAQ7kNvwHHKOMc&_nc_oc=AdqB2K9YavuSsekN2pElnCbwBEBlsqxwAwJfYt6ANbZ_4QZ2JWdmTO7IGWPdZCCywPQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5t89ZNYQjlll5Huji9OUojWtAoepwB6gBSB5H05CQNw&oe=6A5A3965"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83BSAFLCh4UQ7kNvwFqD6rz&_nc_oc=Adp7ERehR1uSpW04iyW4rjT7V3rzg7e5rQ6CHp_g-txogjdH25z8SFHxejK-Rd0XVh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3DWGjT8ZkyIIkXEp97n3DnQbo5iI3EjkEmnpVgVnzAg&oe=6A5A45F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkq0PwB5ZMoQ7kNvwHXe5pM&_nc_oc=AdoIcvbpgjcL5bgY5sY5VSCZ9gLFiKh4tfylg5hBLgSUDvuc3rgVgNDBFI0Vbdb75m4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3XRAtniuDoCQevza3POxUnU8d9YwlAGWK0UuBdINIDg&oe=6A5A25E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7ExvxSJ8lMQ7kNvwFaAkTy&_nc_oc=AdrTb_rme75nYOG1NNcWtQlE_OjES5BKH_KcX_CzBr7IT7BJwCAeirWbaSxFyjr1hQE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxhDsxz2RDaZkZlwmJPSwp4i_4TivMkQzx1ues7ogk5Q&oe=6A5A2513"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szxos-52w8IQ7kNvwE-3cZk&_nc_oc=AdorfrFc797TqRdPQvC5ZS_-0_PBeUi9JmkfygfFEOWtflbKPmn4Flb6sX5e3lnpBoI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FLmLy1_rodXja_SJDty_l9-1DqFi5Y-x1fRMqMpBJtg&oe=6A0F27BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmzRDWXZVlAQ7kNvwGYeyck&_nc_oc=AdqQA3eepl3gVv9exaQbpBZUjgHIZ-Xa2ehEcwi9HTO74nVPOGd7GthYR26mYoUJN-A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F4VENVGS5Tp1TpOyXfdq-0VrovdbhgQZzFLyj5u8dFg&oe=6A0F13E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-Rs2qfh7EIQ7kNvwEUaabJ&_nc_oc=AdqAzMPuh57j190wjiSc9UK2DDpb5I6JoEIBQvS5_fSOpGNDJgyBanVVucZ-rGqn_d4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VOmYU_o7zIcdyTqsBjDwkO12yjDy47LJg5ohFF7T8-g&oe=6A0F2072"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kh2cqRoojkQ7kNvwGfksF5&_nc_oc=Adp1C9xaJy_rRSFWzGGe3Da84OlS2JQMS1VHADh-iwV-l6BgLgPTeg0qbazWmwhdSKU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eVeiVNvP0oxl8VkUwXaCVWHyY_wnAB5V-9F3zKEU0Gw&oe=6A0F0065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6_3J2-7V0YQ7kNvwGxciJn&_nc_oc=Adpz0QcXARwQRyUSkem_fGX17Fa6JKVGXXLxknrBcDfm25IjYP0UmKoso3VXBxsBmiU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n634wC8ydIB-ERe5gl5Ul_uRV-GbEZp_ihZ7h2kkNZQ&oe=6A0EFF93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
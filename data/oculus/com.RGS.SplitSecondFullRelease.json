-lga3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=514LRZFjFhwQ7kNvwFT5-U1&_nc_oc=AdpojWPpjuflRrgAD03zeQ2svG_BmcpI1hrXbOD8DpKswfuEUL0rVw3MI2nF7u_-BfA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UXfg29K1jmppug7KBcZiZzea7X1ma8Jmtm1CzMs-mrw&oe=6A131C3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmX9FEL-kz4Q7kNvwGU1h1W&_nc_oc=AdppSihVyAuLLMxotxOuGOfsWf4M8r4Ue1MR3f0RBZ8PkovbzOFpehMDyOJqgitXWIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h219_G0-m5QcrnehpqiaAKyZEMNu-VLhZ94_1SzN7Sg&oe=6A130865"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpWP9mvG1doQ7kNvwH30IFr&_nc_oc=AdryArHI2mZX9_MCiKgb8ImRhkfbrkjDPb1fnSpN5Afae5q3Hg5f8abSvOxub54dOSA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gdxLJQNW-B192LjZ-Zu8Dr71lhw9AhTPFAbl4PZQsDQ&oe=6A1314F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-Bv88SSmDsQ7kNvwHOz8yt&_nc_oc=AdpMksurFJlct9s3W5pDS85TxHq7kcnSCrItCtNteCg7cWD4xaFAPGr5Lb6RVkoVuIo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JfDEfuCl-3iayI4oXvF0EiVS5jXagNeja-vGssZqOQw&oe=6A12F4E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggAVueXY1QsQ7kNvwHaFx8u&_nc_oc=AdoXo3H2FerDnycEdhpUa6AzSLet5cyl-kaxiA8BxgFs_X6-NyNh47tWo-DIkavuBXY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Om1e5CU7Xw-h5HqScwYyJxuRpmSI7VIN-lM05uLd2tg&oe=6A12F413"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
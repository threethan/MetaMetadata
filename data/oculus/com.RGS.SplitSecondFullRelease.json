-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2ATFvqLtpkQ7kNvwHRpNC0&_nc_oc=Adq0cJwrHy1LVWinlPPDbHcUs4T6qerovYNmSW7tVCXu2bw-z5IzZuQQFYruG0pK-rU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbcfuP1YUjNeFx_r7noolLRjyvsdoNr2NXOF5MLKP9PA&oe=6AAC0A3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obL09BiOD0cQ7kNvwEsp0S6&_nc_oc=AdrM3FgUUscy-lTjews_H5u-MZfgAcaWxpwAdo5ErtVhcJs-6Afx_FF_moN25L3pAxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeL0c1dovo70f6cQ2vHKjM3MeupH_35e0CAAk0ZtelpA&oe=6AABF665"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G7JMkJfIQQQ7kNvwG-bSnr&_nc_oc=Adpk9IDigyf8MMR4VPLI_GWRYDDftYAwPSj7JqVY7oETjrJ-51Z_UIroT6fz3jlRhKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqa1rw8p_G4-1AWQ3SWmuhN6owK373VSm6XJPToj55pQ&oe=6AAC02F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDbecjmEYR8Q7kNvwE4HYf0&_nc_oc=Adot6efQN4rr9YooHKk053lKvgMmTr9J8NorayCAawjRzoZpbyXyr3WxGCWaf8IQ4xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN7B9R7TOB4p7sS23liUZ46vTeLgIAGwHTfdoXGiOGpQ&oe=6AABE2E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZeHB-7I_tQQ7kNvwHTJm2w&_nc_oc=Adp3ry9auEO-IVuUi9E74x0qXvYpqOmx4yyGx_CF37HW5-b6EFglHyQYNjLEJrV0WMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7uXcuLBDaoCMHg3u6GxjanFtuJebRV07dR0wrtvkzuw&oe=6AABE213"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
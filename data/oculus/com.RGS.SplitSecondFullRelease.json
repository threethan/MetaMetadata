-ord5-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKqhxAhqH10Q7kNvwHd3KJG&_nc_oc=Adqf4QYsxiF3MnfVq0cGZ_Ld8DKib-qQ8IGeYaHF-w0ARqRX_uocmK6K-IfotLBXO8Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pp4u5UUhqrosUpYQ1GsKbnII8PpRRyD29vIm1uoaWJQ&oe=6A43E3BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBz0pj8PxI8Q7kNvwE4dQWD&_nc_oc=AdoO0KIwvaKkqxeopLJs2T6MJ38bqb2EueJGn2NJIGh3n-adCYU3HaUlxdoU1DOTObM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85hmhhiEKpy34c_tQgi4mHAKYj8n2J6mDD1CTQ1Q4APw&oe=6A43CFE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhEfxGgmX3kQ7kNvwGxYuQD&_nc_oc=Adr2KHOcd4Rful-II-llV7V5FZFHHm_-wZNQYqIHF36TcKqvHZF1pgHZkVipEAQtkoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t8kD9VV0ytUTtlxvFWNIQRfA8Q3usDUYXjqfQMobbqw&oe=6A43DC72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyDz72HuzbAQ7kNvwFfmYuA&_nc_oc=AdplUTFt1Uz68IMdUfJeMgMS62f_7dMJbfSm1QBnoXRzpuUhcTi_wWAOhCSaGTsY8Es&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DTxeDP0KhCL2ZjFmJ5tn15LCuLQ8xbsldsZHG-aYAPA&oe=6A43BC65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0G24Y9SEtQQQ7kNvwHWMvXk&_nc_oc=AdrlUCC7y8eZqYr-ZZUfyYfo7p1LFHt2nHmD5euoywxkMYUw9EboQT7_afG_CQFCanc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LZUN-LtsGP55kXwv9NZDHeunmzsEzq3sfAyNXMDvSXw&oe=6A43BB93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFRhhO0mDVMQ7kNvwGxVUyJ&_nc_oc=Ado8f1MBLHN8_3s8b2nv3lHGKLuyu42YblQTkfZDErgYM3jJgJMdiOo32iINzGPqnTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i4TgjiHbxgxhbFXHhAgyXA_8-kJWXAdTXVxwsi-XSBg&oe=6A2985BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KK8EqSCWQoQ7kNvwGu2iOe&_nc_oc=AdrFFNXd8tVISMNxlnLdNc5YojqBAgNWVcU6RFarcrQAgHgwwVvr6y546sbPgNXXnZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZbrjtA5ZuCPEcUMRAfzwJpTTwq0GYg5tcS6D5lVyuUQ&oe=6A2971E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWxXqM4d-cgQ7kNvwFh1bC5&_nc_oc=AdqHM5i0mBlU52QIqh4QaQxjUHAqYWfNlMvONB7v2MQdDz7dMTFywZc68l7npSxA1Y8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d97F0eEzXPhoA67ykTx9asUURut6AwlAXe7UyhF6vPQ&oe=6A297E72"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6scNigNjwl0Q7kNvwG6DyXI&_nc_oc=AdrJ7Ty4rfNyQ0FXZBwo35WJT3aXMxJRt46AHJ14yU9d-n3loxQ8V-4XYYHnktFoPU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TNSHRErRJ8HehuWhikkHq3GqDrQLff6RLpPyEIcQ6Cg&oe=6A295E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbGFEeJKE7AQ7kNvwHL0BQ9&_nc_oc=Adqypi05Rfz7LhNTx2xG1Y9A3xMC3EuTYF2HVdu5AC7zRz0iVJAEtxbSt6oSRmIch7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EkWoyFuLrShkrnprzbcTF7aN3SxAG6fUoIA-MLJVwjg&oe=6A295D93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
nt-sin6-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkGe0rvUN-0Q7kNvwE-1GeI&_nc_oc=AdpDZh5Z_9zN_ssBYbHZ0lziPtqxDL-PuTRotwWiPf04g4kZ2cNATazs_v8BUwJ01UE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5hXYhxN6VLsDNPgoXES87MPD8Fi3aG1kbyJ7jagyAug&oe=6AA4213E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4KwSNALULMQ7kNvwEjdun6&_nc_oc=Adqyoe3KHxtaGQE6Q4vx8JPW0ix6uCqLpjo8_IwOsk3o-SCFAbgwIPF3u0ORHRzIHl8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcfQK5xcWtWZXjchDf-UAfbhpyH2ZJO6xHQ5GUwFuPZQ&oe=6AA40D65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcPgQ3tPDDsQ7kNvwGvdxzm&_nc_oc=Adp-dmwxhcxzuLHa8P6iRf86xKLISXx0mO9zpiQ0CxnBSZpWScEBILX4kl_vDF2xzo0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQyyLIfxK49fliJgwwY0h4a5CwwrlIxckQWnamHHJ-DQ&oe=6AA419F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFEWZz9fg5QQ7kNvwEVPcND&_nc_oc=AdpG1sJbKk0wBOFz7QMGH-4QRHExFx0trRWAhezBO6sQ3Tnuk6IEWA5hlKED8-AK33U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKehZ3aDJ1nrj5NsJSYv-3jNCqg-Ut6s8eo5qnqSOWHbQ&oe=6AA3F9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGxjfkAsgHUQ7kNvwGU2RUE&_nc_oc=Adoody6Ts3Z7CaJh4Yb2fwbnWJnAk4J63RzT300vDIaDujOqNqth94khkTJl425ez4M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDsia0XanafERgVJrm_YYX6IiMeJd7SnJBn9YI46U4Hg&oe=6AA3F913"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_gr
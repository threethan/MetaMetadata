771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrsbfrhmko8Q7kNvwHCD14R&_nc_oc=Adodl-9r9NaT7LoOVFWIdFkUJbGauneSonRgvP6jvkIkxlhBgaQnXdYfQBFEuQTwjyM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGom2jxRYsDIr3-YhxhiitBz2k94lOIy_A4ar0LXAAvA&oe=69C126FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TcOM1wjop8Q7kNvwHhNsPm&_nc_oc=AdoviROZYljczGDJlEFbGwAgPZFLZ6K5MO1qxFFVf0cPRtvw21NlPqDJsRXR33VPyBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTe2OZ3vuKLh_FuSFRRjjCVH_uUnX0-TKhijQGKnhpLg&oe=69C14B65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YU32rOOQKOEQ7kNvwErEuAi&_nc_oc=Adq0x4jsywOYE68dzps_3U6xxA3oYfk8eBNWgoj1tmL7x3FzWkL5dgie_UsIwWkCxpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwdJxK5vkQf_3X6F1tr2_PrCtdRWDFP5ALtUh_GUsnD7w&oe=69C11FB2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXh6KbX0YqYQ7kNvwEpHcc6&_nc_oc=Adpw0vXYjaumPbkmocF6cAk7H0fQBxtvSvTvWb5RW-_7oTbLhhqh__yM8TeW0Wy5GqA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxbZIev-gW2dpS_g3yXa7UlEa3M5AY9Rh-kXxm7F80C0Q&oe=69C137E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8KNtkPqIVQQ7kNvwGdC_Ht&_nc_oc=AdroQktfOtCW_Y48uwAp0Lcj2KE1PzIWMDIxQ7XYLMPDZRIQac23YMRr9nbWGqtXTaI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMITBlnVBUO6LuweBcSNm3BAGspLJo3MyaSLmEgSryBw&oe=69C13713"}, "display_name": "Split Second", "keywords": [], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
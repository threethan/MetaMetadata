-fra5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFbW1B6TiOcQ7kNvwEjJ8tT&_nc_oc=Adp4uoLglXLnUKl-XB6lTrFW_vdXGqpbaCluF0O-mJ4wKzuLTVOauuJqw6jMXJgdMjM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KecztEh2FogmoFae4cUkQKhEwCSuLs_nFdiSEhe9Oug&oe=6A2C28BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4KIYZonIgoQ7kNvwHwnW4O&_nc_oc=AdokSMzdZ1o63g4FY8117ChbTRyRZ8cyYBk-tDPojvYT07rJAWpfW8d87uJ1HwAPmg0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EAZaRCTAev_ONFRQnI453E8tr7WxONUMVBv6m35TRNQ&oe=6A2C14E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgY7kv07y7oQ7kNvwHrR_Zg&_nc_oc=AdqPSPWeM2ZO9oU06UUAmNot23wlpNr1iAW3kygXJd4t0hlf8eOOzzCbZIWPourqz8s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VjDrf-1L8bHdCJHpt5ZDAYeHClaqpSbUS_AYTtpVwUg&oe=6A2C2172"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRnfoUyAAgUQ7kNvwGtbl9_&_nc_oc=AdoT3O2sg7rU65bLmsOPP_cXxQ7-6OMHPMkSst2uLH15IutuW8Hw3ui0VAceqLI2XrM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-g4c4iCfT6Xa11Ly9G5TbVo5nUmcqqGEqS_bgUwat5A&oe=6A2C0165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbGFEeJKE7AQ7kNvwHCkOmx&_nc_oc=AdoNpkMeVtHUFAhe2UnfJza8roTbFEjl48cZY_NweYq12lnecPNdFtsFWP3-iJmX0OQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kN3aJfV43tb_HEdjhjwXEuPvCj32XrQNG73xd-blhmQ&oe=6A2C0093"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOS8m6z7_88Q7kNvwH4ynpW&_nc_oc=Ado1LVW7XO0NfBb8t3MFC1kRzJSzbZ3tjA0QWxKAWP0Busa-JOxHpnK8Rfpu_wS4r24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JDAkkmkJKgyesN4M3GDcF3LKqCo09aoTkEGSlc2dMNw&oe=6A243FBE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0DWAXzJ1qAQ7kNvwGvTwHB&_nc_oc=Ado_lSsvOMlBPJb9paYmAUPFGS7mcIvIeb-QieEL3oTX_Fw4eHsVStv8d_HZkhqWY_s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DwAFqo9wW2qSIXX3LVDIKusFUePR_4esyyVIie_C3jA&oe=6A242BE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WXOsNvxSNoQ7kNvwFl8UnG&_nc_oc=Adq1rFXTrGbszOJh50WXzt1l_j8Ov7KXTpLJxpwAawhz-W6RRvkQNVjjj5PZRokDM1s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KPz_FUg38cTEK4-v0j4-b5jGBZgTViFTkKqjyBYltgA&oe=6A243872"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViBnNC9IaIQQ7kNvwEWfSen&_nc_oc=AdqpEjqd93yL733FByPnTcptGuNTuDBOnv1ixtbxPFyKHl9iwtSGGSx80ZPos_8lveI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8esfw3FAJHCDsxq8mxFOwSuJ-77njTC2AqkCIsXDqYdQ&oe=6A241865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihMrcqxO5M4Q7kNvwHYcRPT&_nc_oc=AdrhJM-gjGBU8gEWrJjlNBn1-v-gbkzoTFO5DQe_XrQ2-SzNGFtYughj6HO-9HX5ElI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wiL-0c0e0pmq2e_KZCnNQ6JGp2LrYjuvT8FOH0PN6Nw&oe=6A241793"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
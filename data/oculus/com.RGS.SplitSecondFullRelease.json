-lga3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abQDOfzx4r0Q7kNvwFGFJmT&_nc_oc=Adoqd44jHIV6cOTyhL4MlljckJnzB18cIKe9nE-WG-GdkLML7-CfpPKToJE9SGx49LI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo7kB1WJ1168AYE1e0Bxz-BQ2Gx6iwnju7SOk0zA2Z3w&oe=6AC7B9BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzG2kehfVS8Q7kNvwEeV2o-&_nc_oc=AdowMcAmBIwNhVEQorEqmiZvUmms7OVVv7jGohFoCcr2AB7Ywi4ODKDUQgq1Re8MJJ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl0Lc6jjwi1HcXkUDx1Se1wjekZaZjWURb59jQH7Xjhg&oe=6AC7A5E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwDpuWGwmpMQ7kNvwGFc2M8&_nc_oc=AdpnclrMUlOnz3nDg8aMSzGmlfpOXEogJZT0vUyURAJSgEyv8cfoMkb4e4tJbzHcS2o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc1y0oY80si97HUIzR0hlnUJhSiGgFYp2kU9cMElY-0A&oe=6AC7B272"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFxp__LMD80Q7kNvwG_nm4l&_nc_oc=AdrkIGUzyCFlgwQLYBs2APnTrRubV8PFhus24p_StF30SyedRIyPug4G5RAOLfSA694&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1l5VcyCy5AHpQ2zcqgmm2VIYYBOzvh7F6x6cX0Hre8w&oe=6AC7CAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjDNP1_Mc3kQ7kNvwG5Cof0&_nc_oc=Adp_OuE2VpxlgReNwrENz2rj63bxfF5wKK-Bpqy-cyDsL41HM7lD_GtlQRSUS_jQBkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdutqpFK4JpEmm_FGn86E2-u7CAD5SSfeTkNY0vHZD6g&oe=6AC7C9D3"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-atl3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2ATFvqLtpkQ7kNvwHAusJI&_nc_oc=AdowYbwp_yz0QGXz5zHNUjpr0dNsO6EUFGEkKmmmAM1LpwahIxG43IlPY3DX_vnRfSY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWlC_DkxER8PZXNprTvqSAa3sAwyTLus0GVxKBkF4Wgg&oe=6AAD5BBE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E_WLRVpPDMQ7kNvwHHehP7&_nc_oc=Adr08Id0WroQEy3eRHAmLfzxjDIwe6uCHXUXMViFdB3wyD1Icd8hXRkFJi10MdJDHZI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8TONtHQvHls1OvfG2Phg7MWZe7S-BiVxBaiiMJ5ojew&oe=6AAD47E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G7JMkJfIQQQ7kNvwEGOGMs&_nc_oc=AdrNQcYi__wHZBJ5UfKwaYu6srzXLYDtAckfF6IfBF9JLG_q7_ZD3v2-ImvVQ4XO8Hs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFh5-Xv1s8IqAWJUTnyBe2zvEGWxk50xadA552VTyyQg&oe=6AAD5472"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHv6vLZjwEMQ7kNvwH3pG95&_nc_oc=AdpxwOf6z6hErJNaWIejbYO9YbJaJ-2Gfz1S78XieY4W9WAsAfZaQRIrFIm4D0kuvw8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiIGK9E_exQ_ung_iRtL90wbYPBDgwM1OqbaoPNAQJ9w&oe=6AAD3465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZeHB-7I_tQQ7kNvwHYHYYT&_nc_oc=AdooYtV36IxCfSlY2uDhwSs1azt-EoALa2UrwThdWCdA5NgMVKpgnQN_rAbKwwKxMjU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX8Rq2DELEktci6K2XL5-JZji29vT-UnjZvjitthMYZQ&oe=6AAD3393"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
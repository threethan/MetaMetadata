-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAC7JDvc57sQ7kNvwGMQX-F&_nc_oc=Adrjf02OC7gxgoxB1R6eH-yWbit20fngCtSzWtTsLPaNXlmU9dK6saK0dBE1dN4VQck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWzsY-tIX3BUNLDVW3hAiOSGeEZ0EHkZJ2f3xHF2cqbg&oe=6A9C383E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPLZpR7xxfEQ7kNvwG-FgFf&_nc_oc=AdpzZh7YWuugzhf0y-pck5Qtw8UkbciWqYFrDdJyc7ep1fhJfhuzKs7YixoUJnnyvVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkzJySgy_ewyjCcs2n2pwpaUFSC9UBtw2QE7ZoWSEZgg&oe=6A9C2465"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqhQLEVjSvwQ7kNvwGvMDku&_nc_oc=AdrztGGFLd_H7IOW-2ocNproSUWs3RYrWV2cSwf2w78RpyfqOJi4NPdcwrY3oKMtsIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-jJd-2rI-Vw27S3Prqxpg4iV4XpeB5y9HmyIJ19D9CA&oe=6A9C30F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjdwO1m7_0sQ7kNvwFWzucM&_nc_oc=Ado4mZyQEj62B6nxbjy0PYjoH6Zjm8DYen5T9_xNU3dtGpcFHrvPlvSrVhfOX81TzBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1-b3mSgodNCiGObxIqY0IgTSK4QEMtPk6H_g69-8jkw&oe=6A9C10E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTG8b8ARpj4Q7kNvwGeDl3S&_nc_oc=AdqyI8tbmTLuyh3qNvdExuNvYGmPviE0y1Bkqk7ib6ltkrXOY59vDr1x6sKXGUYQ7LU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnugEFhlkr7hOwMxRbVzbNp1tJisVfHBY6NJvS4rtIkA&oe=6A9C1013"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
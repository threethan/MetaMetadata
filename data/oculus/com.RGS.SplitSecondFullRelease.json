-atl3-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xeui656WyfUQ7kNvwG8P8n8&_nc_oc=AdpBYz7Y0aLCcMEy1g6soLLGXQyYFYcMHiptE1M4LYrg-hggtniH0AvCTUPoOYHlbpQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UNwlW_Sx8_a3-mQ7f7lkQrQnhdrNIilxSc5s2F7jEdw&oe=6A1710BE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dk8ggbecQAQ7kNvwEIhDqe&_nc_oc=AdopYGa8qJtddZzGRkghBCdU1HYwSgru2PP7GuNUfgfgM04RVNPNCGO4odjNx_DfIFg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kWenjWn-VPRxj8N32BHWs9aTmmhs07TtA5GSVp6r6AA&oe=6A16FCE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJF1HGvCTscQ7kNvwHOrK6o&_nc_oc=AdpIEeADzEoKb2w6HOi_u6ivSzWJB19JqATE7kZ08T_ubGd80dQu5lOARzU9darqdww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ijLMjYN5dvWcq1fIwpxrvWuUVpSl9DDnuXiGTZzFHYA&oe=6A170972"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCtqgq7JUtYQ7kNvwFBxK9-&_nc_oc=Adq9HP-j8_EhXeAwoly46Xl5fXOifcuIAgrSkf76j8YPnsPCbhj1-3P9ltiNLC2czgs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ua3oyTiCfslj6zm_x186H0RFWwcuuu9S9cIkY77x7tQ&oe=6A16E965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UDJFZuRdw4Q7kNvwEz6lUa&_nc_oc=Adrf3nuSji3wkYY8oSty3tSL-jkl-FY7AaiM-ZtqR6Sr0spOrfjAneW6bHjTQn9o1N4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DMs83_FvbNqfTJDyR9letZpCqZ8XwmqLrXZs5zvPUBw&oe=6A16E893"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
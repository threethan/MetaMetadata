-fra5-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE6b7-2pwqcQ7kNvwE6H6xK&_nc_oc=AdrhHyd4pxJTkBeEGqFvisfYYgORuGgnqJO8BSW2Sk4N_AkTeAW6Kfefbi1CzaRneAo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvq73kqSdzs2ds-5hXYJFsYmFI2X8dlJTQLXT2doRrcg&oe=6A58C37E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftr5UXF5_akQ7kNvwHZwg04&_nc_oc=AdomvotJSDWK9mef5H9EKuRuVRdl6z-2CGGBbPwrHpbqDfbdQZ41XCTof4qyqYU2f4I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCvFMzgMjPGbKNj3nGe43ynAxqdEJD1RQ85WmIRDAfbA&oe=6A58E7E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83BSAFLCh4UQ7kNvwHSdBvK&_nc_oc=Adrh4go3Y4j5gOw-j7dp_8nGcdIQEgPFyp6P2DnKzzmszaxVAIDhxBxgUEcbyFMjyL4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBPdFFNUJuXme-PQjMtykuuCmFQL8TJbktnqtMp2BUAQ&oe=6A58F472"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGaDg8I9uR8Q7kNvwHbk0LA&_nc_oc=AdqQSgpZ_LE0wcmL-85zm-v6DYIvGWBxXr36vgoxBWvjboEh7NnSyDKoqbFoYELiK54&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYXqhr1CT14QMSHBIsfPFJU8rdh3RFJKI_tJw5H5YX4w&oe=6A58D465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7ExvxSJ8lMQ7kNvwGkPAOV&_nc_oc=AdoRHfnTkGjrpsZAiHXYcokcbTnd9_Xwic7M6gALqbJD4haG4RC2HYPCUjJUQKLgxGw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwZQ9w0jwbM8cFd6ruZtn3XTjparHSB3xJnDOcHsRdCQ&oe=6A58D393"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
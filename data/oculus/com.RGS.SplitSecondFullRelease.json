-dfw6-2.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUuUl3g-m3YQ7kNvwGRFEeh&_nc_oc=AdoKZ581Cy9wuoax3M8cK4p8Va56SGS5N-XnIm9_PFtaYoEl6hSn75GRihsq-aGUMgM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnrh-yPZAwRiC01Osjx9Z5-kGVpcQR5gaVqntpb4Ufbg&oe=6AD3973E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DQvQ_ErpOUQ7kNvwFGCuv1&_nc_oc=Adq9kqaLJVLM0WlV9wMKu08SUf08mCmFJabJKR5f9AZUZggeQRNAp6AjxxyTwpdDgUI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvWvI5t8dwO-CjzlQza9x9Br07yQkSF0W7wmBVG-FP6g&oe=6AD38365"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BUEUgAnDDgQ7kNvwHbtLv-&_nc_oc=AdpBddLOGpUsYhO1vW-AMohD2yXOCjWYvLT_UCqMZ-H9Mt8FnIaoZeZzF6cu9YwmTWw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYDa0gemQAodOENEe74UdKSRQKiFNAoIZRS5g4As76Wg&oe=6AD38FF2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhPO_PiGxxoQ7kNvwHdIKZB&_nc_oc=AdpfQHmDxQGi4tLYkebFaHemzkC9TCGYTKMNhcg4zbgiFvj323tdEZe1lxWIUay-U6A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLU1p5iAyBf3N_RR_yuuK2tcb4JEUfAiJpMRGfXgsplw&oe=6AD3A825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Hefq5LpNtkQ7kNvwGRRZwu&_nc_oc=AdqQenXos62Dt0FEi5Ch-8toYR3uUqlbFuzjeA9_zwNVqdogWhVTaaqrH1df8gemK-g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxt5f4ZsWWhTZRz3Rqg-Qpwh7M_WIGG1dv7bnRuakaWA&oe=6AD3A753"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
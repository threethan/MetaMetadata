-ord5-3.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVWftzMNfG0Q7kNvwFRcQps&_nc_oc=AdrZaMs902Gd1VjWHA9nS4r9P61UK_VVmx_oFIeljM47TvP44zS-Rh4Kku0a8bVQfSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn_z5yHWkJEuEpO_VwnpjIX9My3byiV9HwboBv3w8HWA&oe=6A60AC7E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah4kAG2Ie00Q7kNvwGvHsji&_nc_oc=Adq6M9IkYjeEbJj6QuAe0u6G_D1xfY8byrHVLA4TWlS4njSrYt0BGinUUk_xx-LJvtM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG5iDx83_XT-YgPcPhYv2Sk1YdfrmT9r947vaYUvknww&oe=6A60D0E5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1t2br0aW9gQ7kNvwFpfJd4&_nc_oc=AdpFzgyVkgLKzMpJ97w6eOvm3sqLzVIbL0PQLnwDylw6nhI694D4DrSGKgv197fyLrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOX0pyPUqnF_PT7om_XPoWf5PjDhXROvgJrEdsKUSYeg&oe=6A60A532"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YixKrFPhv4wQ7kNvwE0rngx&_nc_oc=AdqpsdgPEZk1VHaJgSy7gLzO6xolH-pVg__EmyxPT9YjDTs6jiUyrhOi3o1oxhkRYYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXbk9Vg1fjuJIGoN9cwDiDm2F2ZcBuTK_t2lyXNnRZtQ&oe=6A60BD65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUZY7Ijbv7UQ7kNvwFruyw1&_nc_oc=Adr2FUGEAzIYrpuVoGfPCRrktlKiweZZNSPcns5l8e9lPvzTmTmSf1t3eAcAwWDb618&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_hUbIPHyyXpKI13xtDFsBcnLxWLOOsZ2JPCyU2q2qfg&oe=6A60BC93"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
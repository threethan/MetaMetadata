-qro3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcl99PfBMpcQ7kNvwH_VbJU&_nc_oc=Adqh2zaIRiQsr7YKkLFsrENEpWa0WQkOjXvs-22ECty3yiHN6xqCSrmB_RXqwYRRWoo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-OyChtzIdOOUcUrNi-hjpV9YHpmiyiEIVhWi32wllyw&oe=6A9416FE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw692n8qBGEQ7kNvwHY1RC-&_nc_oc=AdrYNtzH-4QQKmwsyEAFzgUmjBeYTm0m_LFzpN68RH_Ixs5XsqQWwsGxPOqBXxBtZMo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ04hT5nF1hjcmw82ww9FrTb7F0eyTednv2Z0nuN_csw&oe=6A940325"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQKqoeHXJXAQ7kNvwHitDiH&_nc_oc=Adr9W4XkoGoa5feNW_dgBRG7wUDlDm_K0_otPmMUGI2bU_3pME3DE2o5aBPKIcYfHCk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuVYNkR9JSqbsBc2px1pcJoUV-FFrurtgFKYtwYRq0aA&oe=6A940FB2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yYmw78Q9-0Q7kNvwEMcN8D&_nc_oc=AdqkjQN7A6e-x7L2IZFVKlfjIwX6AYUxePFFjvlO6NZn6uBKusmOOgRm-MlxmjJhOlE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHIDpTi3C7TSlCT2pGIAUpbOl_tNAXo3b03OIJKZv-zQ&oe=6A9427E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG_X1Hojpe8Q7kNvwEsNNyM&_nc_oc=Adpx-94qvs-P_F9OoLgDsizwyrncszGXEGAG7BHokFNiXsRkRGS3ng-vgv0x3uL-pZ8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHubsYHzem9NgcRYCWTsHvMqOY3s_UGo15aHIhKyqruZQ&oe=6A942713"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
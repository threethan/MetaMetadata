-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAe4kR0oF9oQ7kNvwHdtw7z&_nc_oc=AdoFhi6w1AovxhaJyigGaHJGulc6YnMEExXgiDVbHQb34Yzk_KI_NDqa6UdsnR72hL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eLOiwFLTwY0ixP-jIzQXEaMSuVkV0Kp8UsQVDeOq4ig&oe=6A316EBE"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehiDNYHoqxIQ7kNvwFmH-P2&_nc_oc=AdoGPU51ykKJJgLP82Iq4HIbJMXMzj4BaKCnhNR3AQ2ksGPmWaIbDYrzwnJstGWtNo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YHvysoq2QOVg7AIWibD_bvwx-4GlPjB6nYtKwb8PHBQ&oe=6A315AE5"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeHT3VryaRIQ7kNvwEENMA2&_nc_oc=AdpuVye75dsq3j2kn-tMqSBhZUDOA7D0_t2nhzeSEgR639VO8UqXRx6qwOp52H0BpQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UMUPfohZFJJiGKKArsD6WADaMcklEsxuo30QQBNMNfg&oe=6A316772"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qo-v2SfVLkQ7kNvwHZirM4&_nc_oc=AdpL5mMgCqXY3dhZ7RwEJvN8AeeWrUihdm8p2Ru4L63uZT0aEIe1zSM7EVnU1ZaeTlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dq_b7zXOgiaAwK6zQQ2Ci66_ZYaIo_JXt2ZXZpHi9nQ&oe=6A314765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxwU1ih6DNUQ7kNvwHcJGA0&_nc_oc=AdogRCPUnwhlAgR_MUSfdXWwapX0rmFHAQ2jonY3qObAu9aUnZ4Y3dW0Ht_tKeAccbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pQZZL3kofcqGrx8B66B-pQQ1szON4Q64UTocxbdtDCg&oe=6A314693"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1112035530330174_2067750444236684031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMBnykqNdfMQ7kNvwEfkhaI&_nc_oc=AdpkOE942-2LmWofQGj0GSsu4GxgJZV_hF9CrkjkZLHfUzI9CnAP73iOq7X3ePciT_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBti_DgeXABsAl1FGMMi6_dHggpfJvFDR9u_yosBZ_yDg&oe=6A4D1E3E"}, {"file_name": "Screenshot1.png", "id": "746268728157255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_746268731490588_2668734346320704180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awEZyRzLKUAQ7kNvwGL4-XB&_nc_oc=AdpVVDBlYgocMIeVUVDHD-5ehEHAk81kAV1Bjc32vf5Zn9bfjCXQDfbiJENrLnOenLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxj7-p_10CH3_rXdk-or_heckVCELi6e0fjs1VeJBthw&oe=6A4D0A65"}, {"file_name": "Screenshot2.png", "id": "2558718261144127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822581_2558718264477460_4419946259400580889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPc24O3I-8wQ7kNvwG_V2hf&_nc_oc=Adp-kFWVG21dm1_4sy85AOi6xSClKdsUzK-MpYDnnNPcTdfT5ihzKmg4aVC0qR-3jLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5kR7mvTdpIRtpIjFwqCosvqsMK7JMIvQNWykczD9Pag&oe=6A4D16F2"}, {"file_name": "Screenshot5.png", "id": "4202613393318966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_4202613396652299_2459960639134163469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqaD2swu3UQQ7kNvwHc4k7K&_nc_oc=AdqdfW7nEB3ZRfoIriWswvCKk-lfFZ3T4AVpcnJ9qaUstueFdAm_P6PWvcnEqtugaj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiF35iALEMxK2oJfd5CBy1qTRiTi7fLqxemxHeqwNyyg&oe=6A4CF6E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "766639865832540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_766639869165873_9175476819114292327_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xGMPaBOrBQQ7kNvwE6-zAD&_nc_oc=AdpJ5ZBeB7oAjdKp2Z1MSoiD_cEBegfhu9dgxWZIEAuTiqYSaGRpywJkrF1oQKPqbBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRndPRq27SRmwd3FOpUsZzho2Gbd6xmJOr5CtG_J_aew&oe=6A4CF613"}, "display_name": "Split Second", "keywords": ["CQB", "Swat", "Tactical", "Shooter", "Sandbox"], "long_description": "Step into the Shadows! Clear the Unknown!\nImmerse yourself in the boots of a SWAT officer tasked with clearing hostile environments where tension hangs as heavy as the silence. This VR tactical shooter plunges you into tight, atmospheric interiors where every room tells a story\u2014and hides a threat.\n\nSweep rooms with precision, breach doors, detain suspects, and face unnerving encounters in dimly lit corridors. Your training, instincts, and trigger discipline are your only allies in this eerie, high-stakes experience where hesitation can mean failure.\n\nRoom by room, threat by threat\u2014justice moves in silence.\n\nCQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress.", "short_description": "CQB Style Tactical Shooter inspired by Ready Or Not. Split Second is still in the Early Access stage and is still a work in progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/91fd68b9-6ba4-4bb9-9e59-a65a0db58598", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": "https://discord.gg/bYWw6URxbz", "website_url": "https://robertsongamingstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xAP3TbmVzYQ7kNvwHQualc&_nc_oc=AdqtTjMzMQTsLDskKLuWkTmFuvOYw899ND6MSZza0IEca23kFtCpAXbNhStrPTca3pk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16ETzrYCS7eXybASQYuZMkNRSIBwl93g3alevRgRcE3Q&oe=69F49AD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n0BiKY33o0Q7kNvwH-cUSL&_nc_oc=AdpgyoOcFjbmrh9vbeL-TjyvFYugybIOYHVpMtRKjcQZarlEJj73SamOGK6uuByHsi0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aDRG0vfHm8-f7iFzglDcy5MtzpV_Z78B9tGJ8K-fIEA&oe=69F4A2E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3GFYVLrGH8Q7kNvwEZ0epw&_nc_oc=AdpvupPqVfnSeTKyUr2ua8P8jOmwHF8GmzeCCXM8ubTK8J33GAY20MtFvxkr2dj_TTo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tSVf3a0cziVOgGkvXZ_wQ5ftrnznOShlvjYGDIlJkIA&oe=69F4A6A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDO_sFZIQcoQ7kNvwGdchqd&_nc_oc=AdoaO5TnDNZZsTe9rHWolXFhjEnTt08ls8VXlkN2S82X1n1B1zCntRYhlyyAK0Mfjeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkPvn_yuCBS8toMJvWLCZnSuRj3LLJfIjY1OzygfM1XQ&oe=6A75CDD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLxiDkqKTEAQ7kNvwHzdVgO&_nc_oc=AdpcXN-Mi8L2Z6aAvNWrVj0VGWk3-89n4PGyEEJJTwKK65dUf7C08ILzZAukkLW4mss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbJd40Grq2P_nxqiFP-xmF9hX-AP3LetuCs4IId7OcLw&oe=6A75D5E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXe9bXKJ6IsQ7kNvwH-dF9O&_nc_oc=AdrzRmRDSS9Do7H9deIfEVYC36NmXn_GWoUV-PbHKoQgE_JGfqBzWpKO_MDHdAdDvSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFITJO73xVnEGmQFj07tss-BsKBUkIHb8Chp3qNLy08w&oe=6A75D9A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
9aWMPjFAu2OIJ4DQLA&oe=69F1F7D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n0BiKY33o0Q7kNvwEeS3iu&_nc_oc=AdoW-Pi-aUbFJpo17ZilRqlJTD60pmi9s84J9JULjqjsLN40n1rbDLeuW7gTw6JZ5bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2V8ZkomxoQnBESlQ1VYnLrlF9Yd-qdTvghbZBwSkN6mw&oe=69F1FFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhADwMjlBScQ7kNvwF627Zr&_nc_oc=AdpwAC2RonGnTUhhr4i01SGXoDQpx8MKagrHvX0ri8CP5BSNCoR1uOvKaDOGtApWYPs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af33lipTkxYJzeQPpSq6QBh2Vq-_eQRVcoT2vJvP-fPg4Q&oe=69F203A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot, sky hook and your DUNK! Oh yeah, there's multiplayer too. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OJOSmAlY
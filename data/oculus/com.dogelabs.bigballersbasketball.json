76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnhAxZbJ_L8Q7kNvwGgE-jd&_nc_oc=AdqoIspcRP-qZ4AYV5NSyFd32cY9me8DZA76Jz1j5ot7AkkKheY_X3Tm3l5uAlHNQ1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZLGLVhOTAmnR5Y_Nptt_6SMcmgtHfv1q8HqbxqLiCoQ&oe=6A79C258"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GLK1BvQbFgQ7kNvwEEUBkI&_nc_oc=AdrE5y1ZGzkYvCBAfqTuYfNEgD2OcdtoEJM9GyRzXsz1bFIqFCDmajXnKyNTleWQrMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXQTD0TNSx43o1HP9cVYyxLVdjrzfPAIPJhQYkn8f1EA&oe=6A79CA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmt-7suHKNQQ7kNvwH3Lxn8&_nc_oc=AdpZR6B2QrTke5D1X4mSAAJ6isJDwvVlsiQ2ySqnalh56dQ3MltY-crZ1YR_a7K_U1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7O8DzZpTbihoS5bNCl8aqoZ65o8-by6NDaVPXwCnjmw&oe=6A79CE21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
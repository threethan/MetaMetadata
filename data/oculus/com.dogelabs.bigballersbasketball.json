2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnX0YnIdBo8Q7kNvwEoQ6Ua&_nc_oc=AdqLbhGZdF52iY9loon4mejU9MfpuKaY8VDLCeiSgi132zGx0BwJVlf3flHZLEXjMBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZARpZcnJieM-hefyEermE2WsdGxhSwGPY-ArG9_8k5g&oe=6A1ECAD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qiccmLBwacQ7kNvwF5F4P3&_nc_oc=Adr7nb2J3GvDh1H8hA9ZlztqiEiv5TTjVvnf5qYgrDpw56wexa4dUra6H1gJQsP7M38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U9K5Rh_rVMoF1w3VfNDD-0tu86ZgTfewuNhOH2BGYEQ&oe=6A1ED2E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhJe3GfQkp4Q7kNvwEarIHf&_nc_oc=Adrnaj-7U8pRwlNJnNfpPzSevsHX7aXArADier7mAcVm9kaNYk_yBjlBKL5XmMaUM00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MSmK0z5nVbalefDWvG7S7eeH2b3pXSgNfWrvQcWVxWg&oe=6A1ED6A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
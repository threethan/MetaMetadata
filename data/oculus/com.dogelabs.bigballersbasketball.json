le_name": "Image Sequence_003_0002.png", "id": "2636265843401826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_2636265846735159_8484722916592851842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W954Wl_J_lUQ7kNvwGJxJZE&_nc_oc=Adl5xSl9ludwFAtfC-s4LBpfVHkYKEonr5XLjUVJKr-oRuLtLymnmkTrm82SC7-n1MM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVvc-Mks0G_C6qiBKn-40wiMldx5dzL-v7sy1SvTOKLg&oe=69A03923"}, {"file_name": "squad.png", "id": "896631746167404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_896631752834070_4437646810570389216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ3pKADxcqwQ7kNvwH5vlSe&_nc_oc=AdkCPG3m3S6lj2I0LPgIW609S0ZQLxQzNaNstE4AdabH-Um0skwmriojRZQNWx-dqAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYcsebr6rJsbpHuGI_lqZjPEKzLXM-qMlVPI3BQ4HbCg&oe=69A03CFA"}, {"file_name": "action-shot (1).png", "id": "1448982503229090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821194_1448982506562423_31654899059417498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfvUQynNL_IQ7kNvwHtCuLI&_nc_oc=AdnQjH5dXf1hpIymmXndWwK4i4EmRf4e-3uVqCXrTP4ARDnKU0ZXzApgTk5R3d2Ewks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgsAaYWTqccVNpnZYDWjqXDf9NNWha5CxAFXimAnargg&oe=69A02738"}, {"file_name": "football.png", "id": "883856530905560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314351_883856534238893_6087869377855534704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2WMm4vkEL0Q7kNvwHVR0OW&_nc_oc=AdlxY_GO8OX68jtTrEgMHShstyJ0HL9RMM1M0fL3AvyT9-xSEjCB4arFV15Htstrw-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHtH1jt-kdFExPHyp2zMdPwAgPjBChxGFIh6pBf8vXVA&oe=69A04400"}, {"file_name": "Image Sequence_003_0003.png", "id": "1218629390131689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtrAHXuU6pIQ7kNvwGQG_mJ&_nc_oc=AdnwCsmySc527ZO-z7ZwGxuT5P4wow9RxfFREZ_jfG_HElPu520YzvnR5RW4cwjlct8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFyZO-Gj4mAPzJJuFyOCqdOToEmf_XlupveKrQop3voQ&oe=69A047AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers26.png", "id": "839686339048058", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308103_839686342381391_5057831554818303431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zkdge7SeZgQ7kNvwETgJqA&_nc_oc=AdkpKJPQQJ9j2XeeF7Nz66Mnn0Nxyw7OQHFVnHpOyLOIakP5MIt5LF_LOk5aPrdc-Q0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsf5UwujODa8fQgBJ08qsfSZCKjJptDLpN5NpNoCh4MPw&oe=69A03E4C"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25635861269388850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303198_25580552911561167_7370385457210555593_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvPgYTZ4I9sQ7kNvwE2ohiL&_nc_oc=AdlLfst8rdFet6Cx3GbOTW-GU4y_HgLMCb5OjdJ
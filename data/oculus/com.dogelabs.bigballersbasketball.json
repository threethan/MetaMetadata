76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR8pnVXV-YwQ7kNvwEH8yK6&_nc_oc=AdpiecgqlfxhHJrqTN40pMOwauwI7C8XMBLTm3rLj0l1sCKAVICebPp6VepsUpxeNGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlIu8SpvNMOXAXe9_GufqwyHgdMsgH0Se0NGVE_Ho-cQ&oe=6A7087D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GXe_vP-4sMQ7kNvwGB0PWt&_nc_oc=Adq8TROahgPU8pCR1IyUPiqmw-A2PedQZG5HtcF744Xj6TJWlGHDGw7g6K-HzfPhWUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfmCYO44v6qbhOn3heS0lRpoz7UmVJL0BC7-tiAkFohg&oe=6A708FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdYJKrg1pLUQ7kNvwFnFACf&_nc_oc=AdoGPMVVzOaHp6e45--pA_ichOlyFgTKAnewm2gV7sQpp3R_WUnPyoj-PEfmhc_z7wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3hQgQ-96z51Vlkj2AyPUD0598wsbP1V-Zje-m8T1cqQ&oe=6A7093A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
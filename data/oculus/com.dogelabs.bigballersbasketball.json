76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXO-xnzHx4Q7kNvwF512p9&_nc_oc=AdrFtofquWBKQRRDArqb1b0V7hHAVbyI6UP7veRTv2FqA5spk5hhaYPsPKuAY4iv0Y8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq41ApUNkRt_8VIN9zEu4wpd1aP1yw3b2ZHYLOX2VOFw&oe=6A4E40D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P0WPLqe4XkQ7kNvwF4JTCS&_nc_oc=AdpuoThL6KtelKSxf6SOZ3LPrW6O8WTgFYAmxwW-x7nex2h8oM0ctAYDk-ZV17Sr1jU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsGmsJX4Elfc93V02Tx9e6Vv3Gngt4ZTEiKrAqy6RzXA&oe=6A4E48E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-77djPmyNoQ7kNvwER-SWm&_nc_oc=Adqq-YIf6ZMLrLGBYGm6GdC0tDwWfE6mRq-j4eq-I55vJ5pkcTklqxZdgXCPiFYkig4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBysFp3e__S740vDloxSZwwUXrhKorGY7eF-F2d910Oeg&oe=6A4E4CA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
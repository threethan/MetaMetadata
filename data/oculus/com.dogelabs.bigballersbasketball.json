2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkKQXGlzNmMQ7kNvwHqA0jz&_nc_oc=Adoe_Y3YFJFHPu3gGtMRYmEPdRRpoi_NCfCqWxt2dT9QL1gkjsZfDq5pQv05iTssq1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rge0_3dddQ6mopjjPBxPSl6bbSkIepoieEy8ru34pXw&oe=6A21A618"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnBZGDcZLqsQ7kNvwHkSe89&_nc_oc=AdrokL2ZPq74Cw3Jv_y7aC2IKyXiGD3KGuCuVRj4FGwcvwMzv35A0-jAZU4QuMLAD_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WbW3ZDRg48D5L2mH5zO6KOer00XvQ-PWkef2ePqNaQg&oe=6A2175E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iThgucI2NScQ7kNvwFb_aW6&_nc_oc=AdqtyqJDoXV-ZbtQySDY9CRbyUuUPgICNzXpsNbSM0W7Fzht3LeRGmpal_1G-NBjqtg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ppbm-Dr68DCjJM6_icRrI3tFIVKr4Johym-Hjtk_h-w&oe=6A2179A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
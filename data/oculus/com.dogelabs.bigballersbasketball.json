EKQkHgnKy1Uuyi_HoiNoDbvCd3zru00mExHBSdwHrHnWUgpeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVNnOn9nq3pw9r9SSo1hvq0qifUdFWpnQAfDiiT-nobw&oe=69AD69D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usdl0qGK4Q4Q7kNvwGNX0PI&_nc_oc=AdkIfaVEZHvc8X5Z7JnJM_vh13Vtfvw6i5yY1372zARox49TubmtwAd1YBaZ41QxqKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyhUYUzp2Xn8wRHOke8uYB3WH6EG4zHrbP9n5QmQpbaA&oe=69AD71E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUCCEGwguRMQ7kNvwE4tRET&_nc_oc=Adl-dHM56Oc07nB8I1t9HkxqKvVjqT6I55-1edXgEce_no_oh-CoW2MhzjaIF1ZV4aE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmVdWbU-QJcRlLRaMsjhSq5Jvw37AnldgictO3Cqv3Ng&oe=69AD75A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot, sky hook
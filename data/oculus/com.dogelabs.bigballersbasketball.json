76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU8EOxfCGyoQ7kNvwHI6U1w&_nc_oc=AdpLmP8ZNZeuKw7-BQwTfD6uZPTMNx8L7zZxEBLUdLnNDU8rWiqS6QeYaWkmJorrTlw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hu2BuucBWf0ejYj9FmJrdIzf9hXlhSpk2ZD9aVdWA6w&oe=6A450658"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8EMtMtEcEMQ7kNvwF4wjVb&_nc_oc=AdqGy7wB-rTzGZY9-oKMowkjGpZG0BBJBmY4qNb9urADmmFpC4ZPaN9f-say87XfxTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m7EAbwQgYuI4zj4-zWOWjwtDy7GyzUHiPeBmcu1AdxQ&oe=6A450E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a74nrdsawAkQ7kNvwEUFtHJ&_nc_oc=Adq1sIWSBVcuDJpIevAqCgyaPhBVgghGXpfonqaBb1PBuMeUbqK_xIghWf0Wo8bSUvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l161Lnqq44EmoPPWhxfHuX7-9DVn6R5gubOwznfkFlg&oe=6A451221"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
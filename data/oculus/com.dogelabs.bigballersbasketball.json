ent-iad3-2.oculuscdn.com/v/t64.5771-25/499314351_883856534238893_6087869377855534704_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJBIM8lNQM0Q7kNvwEdd1_p&_nc_oc=Adp2pmMLFRJyu6kKKRDYnTIDmXJwbqpMFH4dIIDX6ou7c83pf7yd5iTO18QibeYX3U4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYk5ML2qAC5MSQ_K8K759hk7cETWKMSYkoD6JfjXS5aQ&oe=6B01CE40"}, {"file_name": "Image Sequence_003_0003.png", "id": "1218629390131689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OijtD4VLRccQ7kNvwEQ50of&_nc_oc=AdpufJ2AbiJw6erqUH1P-yi8pT9dDy-7OTxnzyq7JwAuqLJ91CQ1uzCg9N5pM_YNlqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGvhVrnUr0warIEJrm4yQhZo7IU2ebYnjWVCDYbtsBXw&oe=6B01D1ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers 26 Stadium Cover Art_09_08_26.png", "id": "1310094481075509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312310_1310094487742175_562578261052614821_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiMDS3wmglAQ7kNvwHt8q4y&_nc_oc=Adoutppw7HSt1I6FsMXBOWrONlW2IL1hWYJpWFYmIjxHnXnn4j7pp8iBXHH3VIDtWxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdBH-LgumAJzzGSFKgMNqjoOu1OJVmt3hk5G5McWvvDw&oe=6B01D5F5"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "gen
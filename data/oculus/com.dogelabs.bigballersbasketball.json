6h4Q&oe=6B0C75B8"}, {"file_name": "football.png", "id": "883856530905560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314351_883856534238893_6087869377855534704_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waU9VPx6ALMQ7kNvwG0TyoO&_nc_oc=Adot0JYD6ITFw6XOjpPLWKWxBzYGUIv6yaCyXd-QzH9Rme4TH2r25vGskEliOTPcE-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS976fVtB3ECtS_vKtWfe_iWk6dAFRLCSnNNyyADh970g&oe=6B0C5A40"}, {"file_name": "Image Sequence_003_0003.png", "id": "1218629390131689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnFVeXP1hQgQ7kNvwFmUNTY&_nc_oc=Adpst3TgHCtkHyO8SJ0CUehkMvRLd1sGwbeNgQjfVW6R2LbPtFqmT3CDmtxM2NnXnLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTi1cKNiOSqyhuNWXTDQ5vt49gHrGz7xJK1sEiDEYRsow&oe=6B0C5DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers 26 Stadium Cover Art_09_08_26.png", "id": "1310094481075509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312310_1310094487742175_562578261052614821_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqJuM5PJ9eQQ7kNvwGYbrPt&_nc_oc=Ado5x1c4DXvKjn_vyHCLi-rS8ncf9Etv3Jgbh3YgcMIXd4ALf5WM75ZPi-N2l3rBs8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRskXAUe-Bmzk641G9zbj-GzaQ51KFGdHRbdgfy-7veqw&oe=6B0C61F5"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
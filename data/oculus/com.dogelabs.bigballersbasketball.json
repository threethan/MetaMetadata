76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hIcRvDLqWIQ7kNvwHZkgn1&_nc_oc=AdoDMub-jxzc18DWKau1PRK6V3l7pJijJaNnRZckIMoo-Hb5nwVaGD4jbdz7GQ5EoQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3A5WzPk8cn7ZrLKD9D5aSwvLk93ezCPmsKOdCwn_tyeg&oe=69F88F58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm2cd1p_W4QQ7kNvwFxnIeF&_nc_oc=AdqZVksp35YmzJnnfTIpP3b9BacYa7B3nU-Nvxs6ss4Gjc-4ScPa9BzvxmsVC3-NaUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cQLI-2n5ePFpAbteP4JnrZjP5sadjGagFOGkawmgvNA&oe=69F89767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8vYAS4wv2cQ7kNvwFi3Wz6&_nc_oc=AdrsPkI3RW3ookNndwX7BqdgbOkoQwGPDyV617XdAa4xTHz8HygfWwqC_phVFJkle38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xhvlVPvbcB4BYTaYSrWg1dpEm0bURwRMKUOSvBoo1Rw&oe=69F89B21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kw3xTxa0J8Q7kNvwFXVNYM&_nc_oc=AdkWM9plgCHOLY9D3Ekwl0iM7zEE0luffMVwvBaCxBzMDuB7i70Jm8xMIf60XNtdyAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxuOfQTI_Z8c2REAVPkl66PLWn5yPnnaLaYsJ0qlU4GQ&oe=69A6DA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGl7To8ApvMQ7kNvwG1zcyU&_nc_oc=AdnsYNRlryylJCMMgXHrCV-ch5Z0bcm1rAjKVix7mWWGYT7R7HXk89tHh6Q0r3NhYos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afux3Tm-vQs60OUOJuMEkeYm14TnO28eQl8zaFHDgpD7ZA&oe=69A6DE21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot, sky hook and your DUNK! Oh yeah, there's multiplayer too. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OJOSmAlYAxfsAdHu14Js2SWAe8pkr3AuREebGQ4Dh2g", "developer_terms_of_service_url": null, "publisher_name": "Doge Labs
2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOawi8FuzZQQ7kNvwGCZPGB&_nc_oc=AdpsWq1345XjRnTxfWVNdXjxOId-oPsn17QzhBngUmma-cIDZ4NvecWn5PG8JqBmbUE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C4k_BPHAbqdzIV44quvgiPmLnW77B_evAk1OOmZm51g&oe=6A0C55D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5pw8dEGQ68Q7kNvwEy0OQe&_nc_oc=AdrLEMMPM0ZuGvmUmAzpdkCAD563H_b_0OFIkHgROLR8tXKtP6yuWqeytszLboFIoZY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KRtupWMuwo-wmFco04-v_WCPhUn8yXgeAnMP8564gGA&oe=6A0C5DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pftd_vktblcQ7kNvwFT1uxR&_nc_oc=AdrnWfqczT9k3LI6yBYHUH0QJN-D3Go1am6uvEe4ORf_75jSfIzKRp87hHT1N-su9zQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LVNkPdYIvEODTaCCVNXGXYVjZpMJTHAwTHubymL7GmQ&oe=6A0C61A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
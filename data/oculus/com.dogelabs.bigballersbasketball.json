76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0mE6ocPnCkQ7kNvwEs7XcD&_nc_oc=Adqkl7e3p4iAuWgidVaU0EOk5M0vAC8eh3ViGC63YTnA82WJwVHwQX83JzE4FFHbhdI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysbHdEd-nd5fl5s8lqnmsETw3hC97ymgs1HgDSF3TbDg&oe=69C7C7D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe72gXFvkX0Q7kNvwEomHBs&_nc_oc=Adooagw8kj-vM3swyK0ZDQ-0cn0XEK0DaoSjj4MJF38WDv0LfCQcFkPFuh0v3rd9AVw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzust3ZcIId49R0nMJV9Nh3ZPkeXEw4y78_8kMY1S4tdw&oe=69C7CFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nXW7TiobnQQ7kNvwHuGxrb&_nc_oc=Adp6idON8E4u1c9Xr987JbXsgtG-A7vD8kp9FL_50cFmd0JtH6ckg9CPJNfCciZmveM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO3L5CJKusLkDGdSWQdqcfllCo64rnBnsV0Jd6R0D92w&oe=69C7D3A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
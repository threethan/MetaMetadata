76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hIcRvDLqWIQ7kNvwGNgnXL&_nc_oc=AdoN6UA-FdiGJZLyu4Nce5o0kVcSs261PgSObRg87DTPPmhals9ndLZ1GfyUh9khtjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BlEH1SX4tmzZAmeZO1o7lKwiAokBB9nVjkj5EustUvg&oe=69F73DD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm2cd1p_W4QQ7kNvwGlja0I&_nc_oc=AdrU-eLE_KhwldgNXgTvdzLSKHIqrb8X4W_6fuPgTa_fgRcR3UF18I4DMs1Yhj2N-mY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3maa2-yqg39vkIkTQHzvH46Kf_1fLVhANr_eqKwWUp9A&oe=69F745E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3GFYVLrGH8Q7kNvwGoxspe&_nc_oc=Adq1s7_y0lKb8VrUGczNio6-1u_0SvcvgG1BDhQIhH5oeq4x5HLcrZuzPl11E7Mbl_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qNY4FRrAND9a6n-bRUWQCHZR4ctHAp4TPpDbECkZp1A&oe=69F749A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
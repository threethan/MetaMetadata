le_name": "Image Sequence_003_0002.png", "id": "2636265843401826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_2636265846735159_8484722916592851842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W954Wl_J_lUQ7kNvwE0bYev&_nc_oc=Adn_rPXahX2woZNxujQJDeJZ1x_a6xAVvA5CCMVnHFbSBafWzyDFA_YJl8qsrlukOyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_-TgI-n1nc8t24r0Tibxoym9EYz7mIY1zSY2k9mzN_A&oe=69A2DC23"}, {"file_name": "squad.png", "id": "896631746167404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_896631752834070_4437646810570389216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-BG-PSqNE4Q7kNvwG1xk5k&_nc_oc=AdkIOjwes41qqn7gsA_3Zwqnv7ApCVdyYgT0btZhdr0V7EbLPhpepTafK3iQTi5ZdBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHMTcqRu6jOW5NOl0-5AjlrPVmQfQGEDCw0LUDdPWn2Q&oe=69A2DFFA"}, {"file_name": "action-shot (1).png", "id": "1448982503229090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821194_1448982506562423_31654899059417498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzjxm3zW71UQ7kNvwGO1Lik&_nc_oc=Adm83jotAzkcD34N5l2iQCLCXDyykEsf5eXEFrZBDN7r7tsWllSpgLrs7ELFAQ5muok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu09KeQVEkN8SfJuyyCHX6ZhnK1rJdhzy73xBVZm2e8QA&oe=69A2CA38"}, {"file_name": "football.png", "id": "883856530905560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314351_883856534238893_6087869377855534704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Pj3fx_CZpIQ7kNvwFiE3x3&_nc_oc=AdmpClUxA1PdDS9PDNtyctkoquf57FfMTNMlkieE5R2lefVjv81MHLSvlwjctAsU0vQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afujz5UxfGEJU1StUHNrv_D6Sy7Z597ZMEiRsw7DSnHSkQ&oe=69A2E700"}, {"file_name": "Image Sequence_003_0003.png", "id": "1218629390131689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4VDiedquIoQ7kNvwGDYklm&_nc_oc=AdlSQ1dluwDtzEvYqOPMkADHaC9Srg2x3uMIYdEOkA3qtWJz5JZ_a634aC1CaJSaKPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7AVbc6zFR4RDulk5gXypgnT7P4DUI17wDO9cNwbw9WQ&oe=69A2EAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers26.png", "id": "839686339048058", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308103_839686342381391_5057831554818303431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmGPZo0ZKggQ7kNvwF2auZ5&_nc_oc=Adk4mHJuku8c6_07rgeGKQEW-V-MRN1abvBECSGkE0PjXRlwhDL2stGJ_HLu--eG23g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuP7xUYT8ZN8IQOyCWr_Bp5tnnkV-hr8k539M8LtreDIg&oe=69A2E14C"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25635861269388850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303198_25580552911561167_7370385457210555593_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuK4pcIdnQ0Q7kNvwEDg_1R&_nc_oc=AdmFJt_Tu7a_PAhIGhmNIXKUk-DzCvSBw_Pld6q
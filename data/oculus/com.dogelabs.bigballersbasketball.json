2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_WX2xO32VwQ7kNvwETRT0F&_nc_oc=AdrU_2E8QC_qvRwLhft3ewHc_otyYBcuRTJkus9UozKVgP8th_5zVjMnNX27V6Q9qJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLhILMzitK3cnNo1aBmxMnxtW_MmjIZgoJP7bouTmV4Q&oe=6A50E3D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMc43fpa-9AQ7kNvwEu83K-&_nc_oc=Adr5vW0xn098_tCghvZjRumx74MveoRhEFHDA0HJrBkm65OVTtqJUbO5DC4plqC1Cj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0_0MSfheZEJwZUm2c7exyztA95An3IGTz9hVq6KjlZg&oe=6A50EBE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYtilU1RjLoQ7kNvwGA48mB&_nc_oc=AdqAeREEXZ1sdQxBgu3IOiknT7-zdgXSNug1PoHPhjqUS8o_ArcE5gUQW34QA9CxmWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9aYiQTSTEijVm4jyyjjm8rGG4X8rPhOipf8dE1M-k2Q&oe=6A50EFA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
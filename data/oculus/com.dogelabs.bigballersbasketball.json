76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAHVAxKgo18Q7kNvwER8ehC&_nc_oc=AdqmgEMOdpbq6DpWy_DiKVxx-gbZCn-c-9EnfwXpV1fXf1k1-SzSVb4lxRyOJiqAows&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT4qx7cXEoWs6qBBh0fXp-KwQ6x7hXx3J0QADcy3UTug&oe=69CE5F58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKOXo9N4RbUQ7kNvwGhUoZ8&_nc_oc=AdoVYPtwbgZwsQHAdjd4uY0frMlBAyQKcOjYT8y6azHTDhQsX4NX9vRboNhIFdUWzU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBBQZ7z7y3N0OL-Buw7YnM_8ZzvNV2IblIXMFxXgr3zw&oe=69CE6767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXsUVsXvq4oQ7kNvwFnF6zy&_nc_oc=AdpHAAMoSTwdB1iRX70_5Tuk-zFkfo3xuFAjzQWo0E3_PTQAMuyUA6x4G_GpWaPAcRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzHUas9Rk-tZKs_tCT3m9n63sAbOyTtnkReVS-E9SKXQ&oe=69CE6B21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
86193790_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU8EOxfCGyoQ7kNvwHxOnpy&_nc_oc=AdqkhauHs7VqPXvn5g0dwONCiUllxFy3G2wMTBUkOPFhGrNUItMyP-0w4meUd2tKQC0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xbbKuWGrmKrCchjw8Xa6SMNy8gHDAXVqVDlQ03clV8w&oe=6A4657D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8EMtMtEcEMQ7kNvwEiJvXF&_nc_oc=Adp9dBpXYfD2Tv8SqTi9htF_MArb0R2pP7DDMH0vmowiyuUdo2xj-1CTlhN_lnBZ4LI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U4aizVW6tfFgHumEjfJupsFzdZOFAfTzOg-H5Y5HZnQ&oe=6A465FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a74nrdsawAkQ7kNvwEll5jN&_nc_oc=AdrcDt4kpbdZ6DvSPNAtIY-ywxRpKnj59HPF-kkmsTsL2dQe3pOJ4PxsIr_WsxOQrGQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mb-8u28NU0qBMtXNFf7uhZDUruUeifIcQnKoBZFqPlw&oe=6A4663A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_descri
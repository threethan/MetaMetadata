2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDO_sFZIQcoQ7kNvwGqt9sV&_nc_oc=Ado5TloC_rWHb-qh1ExXNfCHY0PsOjL-5TxUd7WoQJrS5jKLh8cOU_2MjmUm_qjOutM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrdCeImEwTHp3UDKt6mAGoNeqIuc8WKwTrjipmNMYbeQ&oe=6A7870D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GLK1BvQbFgQ7kNvwF9OFFR&_nc_oc=Adp8OKLvztjI79fIb-NWrr7ZJa2nHtydObXSzXfqVF1Cz1ZKzezgYMrtw60t4WIOW0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAPPpoAyO6s-42Rrys54UThfBgBs4EA4Wn1OchXsR9xg&oe=6A7878E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmt-7suHKNQQ7kNvwG8Rig6&_nc_oc=AdoKtGlSPgKaCMXJMzSi1rOT17szEcefU-aBoS_HQXqCmdZTkpJGFyN9I8dx9ICiz8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuJw-GZT-PpWFs486sMLQ3ZybrWUnlQ3R9NjOe8N0yow&oe=6A787CA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
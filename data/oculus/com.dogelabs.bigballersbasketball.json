2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAT7RKcIrr4Q7kNvwGJMRSy&_nc_oc=AdrAoyNSoANGKUM3KrFGNEcAI8PPacdmzbPXe5RKMMwReo-Kr-OUQ1zGvn26GwKYunw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJN7A3Z6wRp4oO-Qz4FbuuSH5hJmXzTG4eQn4iBTnNQg&oe=6A64AA58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LyRpNpYeUYQ7kNvwGs8zIe&_nc_oc=AdpzlmW4Pe6rRdiuRK2k7w7qTRwiB664SOZWIEYeLfSjZ6PgjcAf258H0EX0dExocdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwKx1W99q19npGOEZdWLKYDHXb6dILeBBebL5QAI2EIw&oe=6A64B267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_inzWTGKBMAQ7kNvwFhWSD3&_nc_oc=Adp37oVPpgPAtQjLcKTAWioTWkAcc9Rcz3VXk3CpgGFe7zKuVIgejxsyqd5iDO4Xu2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSvyjsOndrZmc-z8iU0MxQJHb85avxxtjn9tPyGS0m6Q&oe=6A64B621"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
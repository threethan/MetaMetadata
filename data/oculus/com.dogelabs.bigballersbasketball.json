2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAT7RKcIrr4Q7kNvwG9NAyz&_nc_oc=Adp325_jcZarjwqpNkzvVldt8OG4D-UkfRTAnNoJA6vZFV7vvg8JKDixHFT-Tu_87As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsYQnve4P4sapGGUGaM9888Q072NzpKJOlk63YAWoomA&oe=6A6358D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwxxfJWJP1YQ7kNvwFuUxTN&_nc_oc=AdpmABqz7IfkOsFVnUoKlvtFKT2gOHXh8rvNdPQPnxiP4mPz297mQ2RaWH5gaSACR9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjuthYqP6YTQiKcOHUIVv_5tNS8Gu38mVJmfLcIkUStw&oe=6A6360E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_inzWTGKBMAQ7kNvwHHXiiD&_nc_oc=AdqH8ylmfVDTMNo_JnRWoj95QeWXuz5HoaSbCT2EYpl2BF01H5K42lzh_WLOEplgq7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGPckpDwrdvxwS1fikDI4VaZoQ5zFfGG-5HbVfmnUo_w&oe=6A6364A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
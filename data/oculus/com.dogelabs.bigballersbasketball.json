76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9c0JAblqD6cQ7kNvwHO-AgP&_nc_oc=AdqyuQCQA3q3hnjsSj7_GGa9ut9jDp4I2spJXpKWCRkhVOK-Zr7CnhfuUskkE6fwAC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyaftSdc2ax4FrU98jJyJuiYmxDD063OfVKSs_CK1dVA&oe=6A60B5D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwxxfJWJP1YQ7kNvwGwb0Dw&_nc_oc=Adq0wb8VYW8-ErvEK4vS_gsJwpPA6xmcwr9Ot40sI8zMYllNUed7MZLTfCrbNlZ9uOc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY5rMqD5yEgq9t6AemzzkADWL5OVx_3BKl51AT46-VBQ&oe=6A60BDE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDlUvqCTzBwQ7kNvwGxnv-9&_nc_oc=AdpVO19H6a5TJ7vjoD4dXNI2lr2cdgOhccmKCqLcQwONLIGpABFdYparPq4kTW1go70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6KzB3Or0z9_bIEcciO7vaD7ZI_nmBLukhUBSpEWIhbA&oe=6A60C1A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
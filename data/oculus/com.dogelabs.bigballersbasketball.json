976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMUsSrAvjg0Q7kNvwEdxDKH&_nc_oc=AdrxK1RW5dcIkPh0-vsxHjht1CJD08XazVU23_LGvsa5VCC4rmbfO-TGSOFzJ_r8FFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCx1pYBnGM7cHm8sgkEz0_EfTl4RjCpl4xAbhiV3t4QA&oe=6A902BD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOWCLR_R04AQ7kNvwE9keSX&_nc_oc=AdrW2Pg-cSK3dvTl_pUXFLNeVeTLVd5MqhbGcLhUDBiV3m3mvAfUjkwb4B1FJIRakOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Cui6oZgU3xKHPECXL-47i7Y22pe1XNdVGerwF_PBnA&oe=6A9033E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUhUaouUp6cQ7kNvwGqb_bJ&_nc_oc=AdrehVawoyoSY1bWZt_irrruRMxJqlSdf1RlFXdtEe-thYr9tQABY8_dppZuARFRJuU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWspMh8Q5C7dHKUZdyN_E1tBb_lv-MwLBCeT9W5iv4rw&oe=6A9037A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Ba
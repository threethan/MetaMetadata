2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REF3xGrXtDsQ7kNvwHOWcs6&_nc_oc=AdqbM7yR5bh8stSPoXGr62xmb8GNd3KCnf5OeBRlh0uD6gh4am_tSnHJNJeMy1FYhvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBinjVNY5q75da0Al0GxdTRa3Vjhmz_hhiQN-o9pIfR7w&oe=6A674D58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LyRpNpYeUYQ7kNvwGCBGgA&_nc_oc=AdpB22PH3l0PyjmfnBcqOAOx7IfvrPos-Di-dUUZLx641lQl-yY2ExCSlEZGqNp1w8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEw2Vf7a7O2arLXNkT1B7bgx6tLHvKuftRHPgbtWZGsQ&oe=6A675567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKrF_M_uSzIQ7kNvwGqeIKo&_nc_oc=Ado_rLRKmmw5VC_hVnlmTHxp6g86z7bsSCNoRY-otl3Jffw7Pqo9Vz3qBIynWFRTNgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqG7nmGznG2SeQvyjQ9hkrIOVINYfkE2AtLvG7TraUEA&oe=6A675921"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
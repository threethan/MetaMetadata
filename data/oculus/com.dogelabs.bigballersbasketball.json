2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIuq5TD2We0Q7kNvwE7sSa-&_nc_oc=Adp3lH0OPznO6BCsFZd6lkwwLsljr9teMpw8_SebpyExlpdmWkVXcwrXS2Ozs_e5HQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h6y98mlPKV87FZ2kA74AXyG7p9zZQ-OW3trXX6cbGQQ&oe=6A046CD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXWaZDbKJ4cQ7kNvwHg84ul&_nc_oc=AdrCD_Hyru374j0X9KIoShp3k4G6Mr1EnOcNSZHLVJHY7X5r2oRnCWlTlq4r1r1l0xY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pu3a1tK2DTmDJEXr6LTm2ODPX6iPrZY2YFbHg3yYj-g&oe=6A0474E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeGrJL0XLqIQ7kNvwHCutZn&_nc_oc=AdqbLz0lziH_habBsxw6WdeSi_eQNkuWEjxHZp8lWV-33IwbRZWxxlu5vG0Q1-_0yHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FcAE0ud107xXRE37-GKDzuy3vcp-mfEOJxj24oKkQUw&oe=6A0478A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
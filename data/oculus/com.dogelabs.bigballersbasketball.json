76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAHVAxKgo18Q7kNvwHQXj5c&_nc_oc=AdpGpxNkO9b-_bPuJ3INH9MM4FQ067q6Euj0LTniJpdwpuGYRtW3sOyr13YA3lhtpPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEJT9VLWhixyDtJPISmekWWFICrkG_stBkFi4MW_nBzg&oe=69CD0DD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04AQfV_JfGIQ7kNvwFDc47M&_nc_oc=AdpDO4LSamQh3MzDyIpNpUW8Wx92KSNjZzCNX59zI1CKlpjG7l34KuRf-wOU0xzvI3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR_TgrQajeCTAZMHGKLpVwuzu8FCCFpM7wpHL9QnQiYg&oe=69CD15E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXsUVsXvq4oQ7kNvwGdKUQk&_nc_oc=Adq52IW6x41bV5ASP0trHDNUqsbaYTDRRwDUUpcEHyEdYbbo_oQ2LrdS3wXgfjEHCcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzhu3bWs8tEX62FI9kRYNmlVYme-blreoayrLjYKOjbVg&oe=69CD19A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
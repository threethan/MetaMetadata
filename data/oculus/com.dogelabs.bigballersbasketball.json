76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6NOl3dXqUwQ7kNvwHtkpvs&_nc_oc=Adp3W6TE0qlfkzYKOboNV9cbdYLjlDxDDrmwmaT0454Kgc2SbKg4erIONuc5lCc3pJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IE7oYOsSxgilYpccZehv4-XzRqhkpSKSbpZS_MnGOzA&oe=6A05BE58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLN76Af9c3QQ7kNvwE0G8G8&_nc_oc=Adp7Zqmcm3xETwKBHeiSfu1OvxMvwbtFyyjVERYHvoy3Mlhn8SwX3jbYXTRMgG7D6pg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UT_Ke_vWJCfjSVJe6LixJvxU1stYyJREAkOjS77iP5w&oe=6A05C667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeGrJL0XLqIQ7kNvwH4xLqs&_nc_oc=Adox6D8S2JX9CqnL2lvSJ8xMQTAXVmlxlndG6sTuY7sVRqWBajYrY1zWEfrAlkV6zNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VQqmicMX_cHSXkUCB7-5UBAVHee8YRdznMKEFRhl_jQ&oe=6A05CA21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
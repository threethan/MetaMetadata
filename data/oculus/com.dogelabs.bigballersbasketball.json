0_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMbAsuSjXvUQ7kNvwEC0pub&_nc_oc=AdqNwSb1kYTXrdRSjO_5bo_kDt5J-sdH7wUAKDJVssaXz0xQJTHx2RH07Ty3pRYvyDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwdDJUld2702MPEXQdXioh4GCOslqSsTsXs0cBi5zGyQ&oe=6A9D5AD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkbQFd4dr2YQ7kNvwEa6Fzc&_nc_oc=AdrhUFVWwfTu3T8Zb4KZ5xutI9ZH4w1WNaHAzEI6pyMDkJ_WwRgZkDAhB9Ysygf5FN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNtDjm7OjbBzwCFAp7BTGxOQUJUxwWjmguKLYFNjnQUg&oe=6A9D62E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaoxspDhibwQ7kNvwEErxbN&_nc_oc=AdoJMdq2dUL_JNYZ4_z4uPbjF6aqxEaHZGYQmfpoQyqmPJNhvFomLTHceW5gtAMBKw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKkdUb-Fz-2TcMidWgcSb-Pney1N-YY6rGgSUxiU8dTQ&oe=6A9D66A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "
2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAT7RKcIrr4Q7kNvwHRHgxP&_nc_oc=AdoYT1AhLmI0eYo4-qLhjWF8quBomzddwNdDyUc74VfNK1HtNZihGY9fb8REdufp5lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ9JpCTHP7L5in2_8tGPH6gZKMMBR7FyKIJNvq-poCXg&oe=6A620758"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwxxfJWJP1YQ7kNvwHKSMtY&_nc_oc=AdpJi32WC6GPJbgMqwnIXzuLAKydBhG8CSF5qbSj9PllyghWFlkUUeRgqW4Ha2D1arM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDirQK7jvPBITyBsJlipFFdgA-le1pejI5XjXvsD1wKMw&oe=6A620F67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDlUvqCTzBwQ7kNvwFCRFVe&_nc_oc=Adq3cP4Y4blgE-wnb-qjIaneSLk9z6Zac1OWuGJ5953cjjAFSreSRIONlm8ZtVy4pWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGAqVCR6DOrz8cPExOYQHSw-jHfgMxz3NaJWP7W5YgpA&oe=6A621321"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
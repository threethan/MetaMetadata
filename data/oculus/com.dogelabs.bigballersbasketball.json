976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSvsM7HexSMQ7kNvwGAPAPz&_nc_oc=AdqRv4mwneWm99dbj5SdEwtUJxESdivkcXAwv0pYBDFePvAY22TGnGeiYFbU2oSioJs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl9GIHaPDo-QXLDLNo9OEZYFQ5h-kBDe5zqbUCUYKzlA&oe=6A917D58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOWCLR_R04AQ7kNvwH0qUja&_nc_oc=AdooxNRbmW0_LXAAHlkZJSh0hohvZVbYknrIdK9qCvbeDRd5eZmQ_evpnms1ld6IUmE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpGPeFngvCA5alzqq5MDRVcnD3rIjup42h2HmzBCMCxQ&oe=6A918567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUhUaouUp6cQ7kNvwEkyecr&_nc_oc=Adqq2Sxe95QNJ_WjerCJJYCu-w1Rz1UPGc6JBQiLcC5FfCfvITTz02X6RBk04TxRpXA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOQfBVgXzYcUIHWzbPZ3dQ6LoAeXLAMlEQri9zmyZzeg&oe=6A918921"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Ba
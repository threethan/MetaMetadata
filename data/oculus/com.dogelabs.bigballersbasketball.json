5tjz7wT33qgRZgWSCUrgQrCBTgK-bfL31FZ7V1ZOQTMloRFmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2JRf5j59iEGsQp630EII2DlKMRzOYr79SZDT9lBoN4w&oe=69B7F5D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdrt_c01ZqwQ7kNvwHDJM5I&_nc_oc=AdnagYDuEzevaAvV3TZN5QjItuMVV6ZDQK8KiX8RychQmjDjNA7Rxvq2Q8HV68jl5wc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEdn4VYLlID4wwx6NP5k3e4EoDi1hv42WBTcckOQls0A&oe=69B7FDE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vz0Q6glaO4Q7kNvwEpgQLA&_nc_oc=AdkeFc3XPJDp7bFHhgw4rtj_kfPwQY0AqvD-88Ht955-AXPillM8Y92y4Lou-fjKw6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZ2M0DK0N38mwLeLxk5l4WZbfcTGbmvGCc85w2f6jwXQ&oe=69B801A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot, sky hook
0_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv6J0wPKo2YQ7kNvwE35roL&_nc_oc=AdqotoxX5y29bW9OhbaYHYPA8AkRbsuQkz4WtJ7vuPRpg8tKyqS1V0Q0pbCJS9kmqjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqOk907r0KoybPn47GW3aFmwvOudk8d_H5OBRJnSPEdA&oe=6A984D18"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBKcz9w56xAQ7kNvwGR7EQg&_nc_oc=Adqref9cJB8Ji6X2y8z-I3MGk-72Za7wXDPIvCnSS8HSYQH3cFnRE0IuwPXvX5D9Veg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-KpweXeDdQJdne9sWs997logZnUs-z4r7pP_ywizJIA&oe=6A985527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifB13mgI-UQQ7kNvwF8V-XS&_nc_oc=AdppuCJMV3hMfsx6TQBt79HBcybpUROwORTv2Im4Si4SottVys8e6qllUwcenH0oqnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKre12PfY1Lr-zzM_m9Y8xX1vAaLPYXB2WyuiA0rqqt9w&oe=6A9858E1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "
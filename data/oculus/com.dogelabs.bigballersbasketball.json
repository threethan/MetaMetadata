nRF0tg5TVRoA_8BBzA&oe=6AEB4CE1"}, {"file_name": "dunk_screenshot.png", "id": "5271547479527124", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_5271547486193790_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce4SRiDKXncQ7kNvwFEfz17&_nc_oc=AdpLg188om_e3qJmxkaTEV0HNfd9rR1J3iQ8EF6J2_IfUyPU5wC1_d07XkXAWFiZAtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS2G-k5l-klqkyFkvMnjOE4RZOTc5zPJXNqvKz7hkKcg&oe=6AEB5B98"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMdreeWVeBwQ7kNvwE_sIOk&_nc_oc=AdpRZwhpZra7TVsmau5AhOJvFABBDxjmY54odKzw5YUJtW_WjlStH6N2Ekw-Rrqih1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtEtVjok1ckdY3dS3IKMarfNCqXU2h3VtUghj5zLi7Wg&oe=6AEB2B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndyx9v63GRcQ7kNvwHmqS2d&_nc_oc=AdqNkaU3UXPgXxLQcNK5615KEdniq31Gt36h3emcrS-4rw-T4eFGFpe8fiFMXZqJWn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhqiASp9iOkHVp24yd5iERb-Ns1DzheStHUH9xP15RQQ&oe=6AEB2F21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot, sky hook and your DUNK! Oh yeah, there's multiplayer too. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OJOSmAlYAxfsAdHu14Js2SWAe8pkr3AuREebGQ4Dh2g", "developer_terms_of_service_url": null, "publisher_name": "Doge Labs", "support_website_url": null, "website_url": "https://linktr.ee/bigballersbasketballvr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5071989819487711"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PENDING", "id": "694848165533347"}, {"status": "PUBLISHED", "id": "322898349536340"}, {"status": "PUBLISHED", "id": "428686062201362"}, {"status": "PUBLISHED", "id": "1349335335520112"}, {"status": "PUBLISHED", "id": "452680853106758"}, {"status": "PUBLISHED", "id": "356469582521060"}, {"status": "PUBLISHED", "id": "610104747353581"}, {"status": "CANCELLED", "id": "595992122730972"}, {"status": "PUBLISHED", "id": "796486178156150"}, {"status": "PUBLISHED", "id": "2320557041442548"}, {"status": "PUBLISHED", "id": "169864212872588"}, {
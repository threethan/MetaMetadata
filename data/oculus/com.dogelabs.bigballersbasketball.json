2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6CZtu2KCQIQ7kNvwFFBI79&_nc_oc=Adoky5w0q_Mosej8ykvW_8_JnVR5VQbZfMIJqPY3ZKZeHy_50_etm496sCCdzhY3Ork&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YnxyjwygrkNoVuZQBiR5pFDmOdhp4_hkywqwx-pvDOw&oe=6A2956D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fr1cnlQG1MQ7kNvwF_kesV&_nc_oc=Adoe5WwHUW-oJqSiNXxv6aJFPpnMFWdNryrNb14s_JbAANDOjeK_MyvZ9TY5cCHnJf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SzB3e4_urgwR9diQZGnZF6Z79L19wYK0olAHtiMSdig&oe=6A295EE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kgqec7aYMcoQ7kNvwH9hJRE&_nc_oc=AdqBcxXwsBB_CLwiz8s7cthF1MSX1UK9xFllkC1JmzpYAsplXk3yZmvE4tj7gqEoTUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EoiWP-Ghyr-nEmreft4tMhOI9sYcq8vCu1j07rZdBoA&oe=6A2962A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
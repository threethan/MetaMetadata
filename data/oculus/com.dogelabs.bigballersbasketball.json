76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fup8TUq3zBIQ7kNvwE3WXUp&_nc_oc=AdrRkrQ1oStjdPhIr_al89rWkvuCUEbkPoyqIxr8Zq9tmJDXKPF-DL43EW-ctzSnQyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GEWe1iW_vRnv42IltWAhHywjcOTFwiUEG-yDKB_nDMg&oe=6A1984D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPxX7z35CtQQ7kNvwGkROn-&_nc_oc=AdpnHCXLrXi0w-3BA3LZvVLMfccErSIzkYSV8vD7BjPaHhD2C-t30a2umjquCeOtOQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_RQgEAQt7Lt7WcOvJTCmU6v0nd3lH4x5oQyLWim8yCg&oe=6A198CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiytskctDpcQ7kNvwF3M0d3&_nc_oc=Adpj-EPnY7jrltihzckis255gsPYbfxX8e3MkeJlG2VqlxeQP4oeS4gns8BGG39NMCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ddddyhlj3g0Eiv8pm6uXn-SS8VEfFTY_M2D0eigG3vw&oe=6A1990A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
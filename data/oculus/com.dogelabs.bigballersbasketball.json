334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odsoinh7Bx4Q7kNvwEbsIyj&_nc_oc=AdqhXRB52yjG1NtRCDZobAis8j4q_rw-ffdbQKVpp_76QxAdLX3_f2RAET365mPrbL4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSIND2y7-zJcB6h2YikdArDRuikAHSzF9hFsOruK5jXg&oe=6A81AB58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6BX_i03YRkQ7kNvwGaOFiJ&_nc_oc=Adoq_GlHf3b42FjA2YeCcFWMNKV61iJV1IGJSSOZaI66l73wpYKrL-nAQ0mczp_-o4s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF76lAGtke6Kj5Iikeozezc9L4q7-73o8pYSmRYiC2nUQ&oe=6A81B367"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSIdjpZOR-oQ7kNvwGSCX38&_nc_oc=AdqIDDUAIAs2o2vNMF9jEKsmf5Q3rMzPZQleSXmmME2AWN-N_trukIznPZzue4UzFig&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtpULvu_yB08IQu0WAX-Q64zqgKByd1Gu-42EvKNIB7Q&oe=6A81B721"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Baske
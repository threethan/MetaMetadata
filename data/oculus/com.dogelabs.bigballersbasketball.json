2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXO-xnzHx4Q7kNvwH46WJl&_nc_oc=AdpnGt_MAP4uoARMhudoHU8k4h92gVqzaFvOzIoz1yhQNeXkwza0zxWAZF-oLIyQM6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB954Zix5gejsacRRhWLoUR3LWfkIeeVLiFaz8301uqCw&oe=6A4F9258"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P0WPLqe4XkQ7kNvwEQptH7&_nc_oc=Adq8zCWtnJz2mMcLSnVtYRpAX7-TJLkY-1l9QKN5oAvNoA3o0Q8-KpLpUGGJwICiNlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCahQiXVugRDPuxaPaingH-EGhxucKLMqrqAtr85ml2Wg&oe=6A4F9A67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYtilU1RjLoQ7kNvwG0rRfJ&_nc_oc=Adrn8KJH7T4W66jyG0lhdipHskMDjh1dL9k4R7w7njMhaGuG3ictyaB-D8r4FT8YErQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdyMYJSaLT8w8b2TE223aE8U5moz3Ed6QrC8emZaS9vQ&oe=6A4F9E21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
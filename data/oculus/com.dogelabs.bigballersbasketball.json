76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnX0YnIdBo8Q7kNvwHVcrt5&_nc_oc=AdpmguICKXJmNnKcPmQy1Sk71UJOzc92Nh5XS7v0YXZ3WtyYqYNhqz0bvqx5ewTNZdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XLZa-cm6XGGcTWzEwDis44oX8Ekk0gUGUPjono28faA&oe=6A1D7958"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qiccmLBwacQ7kNvwGxtchV&_nc_oc=Adr8acvOiYGYv9gcn9Q2HFohuZg0hPMrm0Ts8J_79CogDfP2A_kjKnBnkCmfbi00IZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bp5hJdgK4EH-GhokxLJCcxFDRAsDT6FlvyiFS0Wozww&oe=6A1D8167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhJe3GfQkp4Q7kNvwF5CFUe&_nc_oc=AdoP-K3r8yl3mtcLD8kMCd07WRVuKWFWmVwDdpsuwmIUvupIxIje1TtaSfUpl3xWfoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h-_GdFSY4GzXZyTEClnY2GWC2svxx_vipL4fXs2WNRQ&oe=6A1D8521"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
64.5771-25/499314351_883856534238893_6087869377855534704_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJBIM8lNQM0Q7kNvwHd4pXh&_nc_oc=AdooMUrEInTgmm6U1zJBKF94N84r3BL2w_whku_C9aJnDtkKw7IO9XkPJaEnkYJHZ0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfYg32a-L38TT1CnPrCyIu3W55d0-vOGOl89EU-5GLsg&oe=6B031FC0"}, {"file_name": "Image Sequence_003_0003.png", "id": "1218629390131689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01YFKNFREm4Q7kNvwE9CbjR&_nc_oc=Adox3H1ti7ErAZjPtUh6Kb4H4_Wmm6Fn0YQ_1z_uMpvoMN5EgptORQiFDhMfynSyqTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTTNHd294ir1rziyJOan17gfrCzGu5nPCK7rjaRiuWSQ&oe=6B03236D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers 26 Stadium Cover Art_09_08_26.png", "id": "1310094481075509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312310_1310094487742175_562578261052614821_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiMDS3wmglAQ7kNvwGj2Vqa&_nc_oc=AdryuMUIe73O6tqVHFdgYIsBUWdSaKA0ewe3FvKG95SbamxSZDIakiOPnkl6Yv-rq4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR-cjU8uHbMdNul-w1hfYP_ZHoxg9XaeJKGOzzgxDl7g&oe=6B032775"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "
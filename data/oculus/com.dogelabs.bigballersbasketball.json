2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S4MnJNYHQoQ7kNvwHOp7sa&_nc_oc=AdrBerFjTQk-wv0Rhcv0EKNil1zdkDfi0wTe0Hxw_COe6xcWkFgAVASOs_-CDpLn1S8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IybQxz9R3VGjTZoadJKUKngwKHTPa9z57qnVObYA4bw&oe=6A16E1D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSZ1FMEcZCgQ7kNvwH95tVH&_nc_oc=AdpOnCWpQRHl3i19r03n__HitDf-gJHu5WwCAmelXucsokP39W5hCbZjbgbhg9HAucE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Gn-PnBCtyLFW5V4aH20Hxpf6N-VRtlCk6IIjuB9zbw&oe=6A16E9E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow_n2xqkNDgQ7kNvwHrSKnM&_nc_oc=AdpIHvVPj5QsQ4InMOgblIw6Od9Xv7kKM4bnCxsngvw5DxGatu5G_Ng2iBw4PW8B-tE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54hCDrDE1UvEpICgDfJ8VfHTSwMPWdwmajh5iDi_neKQ&oe=6A16EDA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
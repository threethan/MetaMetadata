2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9c0JAblqD6cQ7kNvwGOcLxq&_nc_oc=AdooTh1dQD5gDYgK7LZxIJJwrdaYqeVcA0dbA1zXZdPmQ1fINhnp65KD64g0Saief6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCj_PQgdgJeowrdXtKlSfqXH5Sy7UOPobibs_72bzUMA&oe=6A5F6458"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smcH-6UwdDoQ7kNvwE5fYhK&_nc_oc=AdpMSoUWdTnkiYVEiHPm_TirNGFeU41aztf3U-Gm19bZRFBwcGc_8hFVqpK7fwB6DtE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2_0159mi5e1k32r2JAx4lIxGxdUJOqyQ5O8Hanf1J9g&oe=6A5F6C67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDlUvqCTzBwQ7kNvwFmOLxi&_nc_oc=AdomVBrWSXouajOWHROxngbWkHQqCeq3xwnuGeP3_KyAvzonxbyN_vQmjDbXQrZSOTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWJrARl3EEtrjsGa9kCTdYX2mBAeNCAPNO9R256mK07A&oe=6A5F7021"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
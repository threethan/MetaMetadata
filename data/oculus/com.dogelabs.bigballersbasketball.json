0_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv6J0wPKo2YQ7kNvwFgvrod&_nc_oc=AdoBBDYpZJt3arpCmuJeCdM5UUeFS7XWjyPgGIUJdaZ2BvJnffmcqATsn8ZnRJ4aiuo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJvL5SOFZ1emwrm9OVTR9HoLhcMyeBkOwIpmXF4Cxe2w&oe=6A9AF018"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBKcz9w56xAQ7kNvwHAcAu3&_nc_oc=AdqL-H28xF18buTpEAJ-Od3qgfk7sXu-lyBQVARoA9ZDlWO9vHGO0qedle7Wgl27Clg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXWAp_0MUU9gUDAs5OWYTp9P5CPGUeZ6bR-dvDKFTHug&oe=6A9ABFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaoxspDhibwQ7kNvwF07RVA&_nc_oc=AdqTLweQvQeZMdIhCrLAdEN3weiMX7TzERIdLi6zTbeZOYlfUR7DkAeZI9WIUJj-Ws0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3mObE0rbbc2F3S6ApVSGGPYGqKqtvivSmTV9BoqjVxQ&oe=6A9AC3A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "
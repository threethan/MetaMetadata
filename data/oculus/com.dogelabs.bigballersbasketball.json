271547486193790_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ui8BvHGYNFgQ7kNvwERd93O&_nc_oc=AdqGcAXl7gp37MqSeFInavEQdQ__hW03i5H6LQCGGmxKdsiMPxBWxqPs3Eh1J71bVF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4i6sUPJ2m1ap0RAc1ScgHlekx3xyUBj6TebcVEWm3lw&oe=6AA543D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwYVrZkelB4Q7kNvwEu2Vsg&_nc_oc=AdpFNu-Vo5Bta4fcL0usXRy4BQJTmrOTUy_nbBTt7o90cBNiQzAhvk_qeazqWYr3jJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrvCwrh6HZE0YWHv3CQArgl-ICa_TIPugEsovyg42IjA&oe=6AA54BE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_NrG1gPYuAQ7kNvwFmOFGF&_nc_oc=AdqIHHRQlLmWHGouD59cq9j3Y1CRnOMmdtfD66pyapjEUcjNtIBCMlrg15RAGFByAA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW4oSNzUapj1tlGZXD-jq9vcxf_TBJfw9tlyXcos8EoQ&oe=6AA54FA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_d
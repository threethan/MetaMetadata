76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOawi8FuzZQQ7kNvwE0GjqJ&_nc_oc=AdoAdkZLZyu5ou_2ANlrQwKpQp6fhe9J8gWppPSewqQJmCU-1xtAZdoeABY3qk-w_8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gje62eFkZB61gn05vRgXieJhRDPqB-4NoQdMrC5nYig&oe=6A0DA758"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNWkElEyQXEQ7kNvwEDjufH&_nc_oc=AdokqMxdN0Ev_NS_hxY8jEB7MRFNNvZPuzTmG-SK18vpAK4030apPiJVJW0cNrYt81E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SYjygWJSZ5y6q24OGlzOIR3r2YV9-ppMoQdCC3yw_KQ&oe=6A0DAF67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pftd_vktblcQ7kNvwEeiy5M&_nc_oc=Adp6uGv_sP6jLbSst69qQTxwxZ-1H1iOLSZ0gzIumH7Z6f_nVJ5fO8OxzcB7ytx6xEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af465xLY4acqFMegN3erUZe4pyqeMREoqOJ4Q-KOgKgXxg&oe=6A0DB321"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fup8TUq3zBIQ7kNvwFSmWJK&_nc_oc=AdovpTiDyaFyvbx3YfAg4Bz2tUlUywFKQcOAtUozrQC2kxyuHto1WgFJaDLlyQUbOhI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DhScDERvZHOhSONN89ZLlfn5SYsEzn387-LwJ_BSfhw&oe=6A1AD658"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPxX7z35CtQQ7kNvwEjhJfM&_nc_oc=AdpRbVh7ZEGQy3LGV3JFhzA4z2JPHEwCmd_Kr-7lJSdY27kNevZvJwSWj9QeWoJojTA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I4IxegHEzmgPq_sL-lEpHeP9SiA3R7F9-TCrJsLhrJg&oe=6A1ADE67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiytskctDpcQ7kNvwEn3ACl&_nc_oc=AdrUTfvYcGzchBJfZp2tA-OJitMr_9aJcIs5sWv6VDsROCzRs0QCVW3ffn_i175Na04&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P5hok2q5EJQjTkHHuOI6LAfMe1P_i_08xbQ0z3OsC8A&oe=6A1AE221"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
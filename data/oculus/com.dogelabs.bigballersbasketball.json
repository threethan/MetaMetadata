76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7x5E0i_hs4Q7kNvwEeOasF&_nc_oc=AdqrCVgaXcnqdTyRofELMNKrbjNGzP6TdRbxjhTFIH9WL_0gIJ0EHMjArR_HDYOJJ6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09FWK9ZrxFLWA5pQo6zC9XJ8_SfDQrvyVmULFV-5W17Q&oe=69ECB1D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfTVAuE9r-sQ7kNvwFuWVFF&_nc_oc=Adqx9g_7j_1Q_JZ_3VppkF5H9rgIJmBFRnKycxDHhh5bl0t9hX8R99-IA8EWK0dPG5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YIUGMOTvXESox5slRUeFC_z1JZtNrXJeOxIkiyHrLKA&oe=69ECB9E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSPnVJ30k14Q7kNvwEZB8rj&_nc_oc=AdrXoMKcvs8--Fo20p7nGQOyUWP7eDZTtfHQN_Bq2mDu3s31oNESErF4feXb_1VmEh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yMMsAD27E2Blvwb4wnTe8A-g3uzhmuZeY2TpKwa6tDA&oe=69ECBDA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
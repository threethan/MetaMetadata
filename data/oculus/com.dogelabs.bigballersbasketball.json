2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CqDenz7X1gQ7kNvwEM4kDJ&_nc_oc=AdpYJ5yHamOW__sX3ZowTiDIHI0c-5YTd3fsZeC6qrhnVj0WtZVu1aVn0jsHSM9MStU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nA_2RAM_905XAIGvfxD7I5J0DGan8eqOImeUIU5COPw&oe=6A426358"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyNUQYzlCigQ7kNvwEVXX9n&_nc_oc=AdqiWR-D5Du6QiXyDbSh5WURYMbDotsCm5H947dg0bIHIUZpa00p4Qz0Sy9g2B8EfGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81UdFIN1X4uUpU6m1Cf5nq7uZ1-Psvz1f31SsGxvcpig&oe=6A426B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ4gr3khKuMQ7kNvwHBDnba&_nc_oc=Ado9TdE43zAMZAmYP_hYSVq5U5Z1kD-PT0z1PGE0Fx1RFJmzSEYGdDFjAeJA1K4zWNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vj85O1iIfoLpK7bQtHIzKhovDdVqlEI0gqFKeWYAIkw&oe=6A426F21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
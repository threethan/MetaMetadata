2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_WX2xO32VwQ7kNvwGM23Q8&_nc_oc=AdoeRZwWI2z1Dh3ZgYeqqzrjDQYsNGA13Ov7XOUVQgWJ0JbITVgK_Png6Zw345QFueI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHqSps5_HOsKYwwP_7NMW1GZtXFdeJsHP7dkctZ-2eNg&oe=6A523558"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMc43fpa-9AQ7kNvwHZ2qEQ&_nc_oc=AdoP6bKbzdbh6YHMNtz3h7flQNIL0W7YyyQlSBallfg8HmF0nZD1RK5xAkgNcik959w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNIiituzO6apPyEpjxMXqGVE3h1vIRsa2Bg_sbKTfewQ&oe=6A523D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYtilU1RjLoQ7kNvwEgvXo7&_nc_oc=Adrc9eRz39T_Y5Ad8qBiGkKt4o3QQNz9hkiNjcwYdJ0v6OFlv92fMXVdrRpl2eT5zT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVHAC4vYz5LoV3ndiLYx874UcozEEvj3evA9r6yaQCeA&oe=6A524121"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
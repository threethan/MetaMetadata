76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c01n35Eb_K8Q7kNvwGpNeZy&_nc_oc=Adr4pFje2BtHaJ4oIGN-KoiBVJjo6YNM4_uv7nIpPgJm787jjEYW4ggyCF45tt-Em7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_b9CcuLommoLF2Wc3rTTEm41S_8mbrVldXpIalcrsmQ&oe=6A317818"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwGgqgmaeZ8Q7kNvwGw-Wn5&_nc_oc=Adr8hFMuZ8Vq3A4LoM-2cunZyu0hix6OGuVv1xUS4e0DLLH5MQ601b9HbKKKmZL8k_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fqxr0-_avAEVTEfen6TQLuWONPL59wGgSZasHLuIMpw&oe=6A3147E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFhD094F2uQQ7kNvwG2Ooyb&_nc_oc=AdpB5MyENP6S15w-ry5S0zBVOaZ2kQxbNkTP72rpnWEZvFkGEoMrkfieWWGAJ0ZJdGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99qQ9Xdw4GTW4PrVyS88fB72o8rdCVBslVYBejP5K7vA&oe=6A314BA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
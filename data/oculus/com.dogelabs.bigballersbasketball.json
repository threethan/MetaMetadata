2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLhW_KVTIaEQ7kNvwHGf-91&_nc_oc=Ado-gyR49w8-WLOYjEfaapFm4aOHgpGG55gzCohwYAVSasAck_GjXVhR6gY4ZMIIbro&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YTBe-2a3VUXPwfr8UufiwOvJycV_RYMpoEw3ZxhVh3w&oe=6A12ED58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bC1aJbNy5EQ7kNvwHucLYd&_nc_oc=AdqjX8blG2dNvYAfqQdbe2rcqxcI8Hws7-_vExbDosJOtc2WEH7RB_ZOI5vifd68ekU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65lQfa7X91FmIV47fKNxIOFM8U0XdSM6pd74gEl-anwQ&oe=6A12F567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xiE3YL_DCYQ7kNvwFbwzsE&_nc_oc=AdrCyKNVOTsKXzGeaYGB_zjj5rqZBEExtRjdHB6dLm9-ggUIwviN2siBRKbDjubrKEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F7h5JdGew0pcSGNGouDJbuhXe-xBFrA8UyD_aV-m2DA&oe=6A12F921"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
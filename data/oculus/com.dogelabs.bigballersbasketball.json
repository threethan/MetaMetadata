le_name": "Image Sequence_003_0002.png", "id": "2636265843401826", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300910_2636265846735159_8484722916592851842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_MtDduZA4IQ7kNvwGeXSFJ&_nc_oc=Adl_zr48HigZ3zeJs_4ENDEElAm6oeR7DXCbIpxtvQRuTWsODiUjxtZI9y6yUkKBjdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv7rFuvxM8-4h_LEcH-7iqXZ5lZ1qGuHLivNrsvxPWrWw&oe=699AF323"}, {"file_name": "squad.png", "id": "896631746167404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_896631752834070_4437646810570389216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKzqoMjVUAEQ7kNvwFh3BNm&_nc_oc=AdnBubLSnwHzSb1__KoJrAI26G089UtSCRGOb1ylrRWRGGDW_5CwoJEtxpxVvFdnhcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftEpZTtmmoCVklg5FTwoelADgvZZdoJLhPqfRtm0JP_Ug&oe=699AF6FA"}, {"file_name": "action-shot (1).png", "id": "1448982503229090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821194_1448982506562423_31654899059417498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0lkcEnvHRoQ7kNvwHqSodc&_nc_oc=Adkyvx_PJLkiXQ3nkDLubfEN4bwe7XJoDOoMUVVcA-x8kI4S7-SE71cXism2N3GQROE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftTtihedOstgLOXYpdyNNtq71ss2s6j807Sqylhx3hw8A&oe=699AE138"}, {"file_name": "football.png", "id": "883856530905560", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314351_883856534238893_6087869377855534704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubWPAxVOfm8Q7kNvwEZVk08&_nc_oc=AdltYk9nb1GfrAZq8QejW8bWraUF4QqDZN-YFlDYLJFf7Lr7moLOIlm_PRKubz9kG-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuzYVQ3Xuxu9pahJCnx6C5L6Agj6b_qnLvlDVu508BZA&oe=699AFE00"}, {"file_name": "Image Sequence_003_0003.png", "id": "1218629390131689", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEubp9eyj6oQ7kNvwF9pCYu&_nc_oc=Adl-BSlg-S2PM9_9T8kTx0UbANVVt89EC_gkcC8a06XZKM4K8zVafWyZJoE0TB3xjF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvOJ7LyZN778oaTpSdxcLtFuiu8VJt5OcIdBELDd2260g&oe=699B01AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers26.png", "id": "839686339048058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308103_839686342381391_5057831554818303431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQlS_o0QqmsQ7kNvwGJucf0&_nc_oc=AdkHmTcKXN5JBV__AOUOu4o6thjHUSMRoDAwx494UeaS_3vLyv1QNVVKUI0X-Qr2fME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsnWN0da3uEGgSCCrb6LTnqN415RQt3aPTTXXenhRYjaw&oe=699AF84C"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25635861269388850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_25580552911561167_7370385457210555593_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqGij7I_i60Q7kNvwH26N0g&_nc_oc=AdkD-F5etJXooMsdCPyZ56hnVPp4Ei4djFLRIqf
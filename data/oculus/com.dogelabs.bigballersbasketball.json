76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnhAxZbJ_L8Q7kNvwFeqQhq&_nc_oc=AdpWu7lcbs753lDoVX-yeuGUMCZwkQ_vxz311gNxESXiNb7d1QxIT0aqotPEwlbU-3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF95iJhk7GUTbB2W55APP7C93da16zSnt5jiZZ1uQIM7g&oe=6A7C6558"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbvoxpIb1n8Q7kNvwE1bLgw&_nc_oc=Adrw5-RbdW7W9OaNOqaQZrMyEl0OlABFD5XHtq-Ig92zqoRHvR83aaAy52wQ_w2FeUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEY6-vEdoQr85KnInvGtLjfpz-bwzzZ9oi2YDVBJPn2g&oe=6A7C6D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq0c9h9QK2cQ7kNvwGiQxG6&_nc_oc=AdqKCalbhsAMHNAtImxL9HZlCTcMJP71t4GJoGS1KqnPjmyl3ZRIxp9-OKup6M1ux-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfZoySGb63s4tYV2j9YVdHpA-8Hc81bYbmQ9I5udPEOw&oe=6A7C7121"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
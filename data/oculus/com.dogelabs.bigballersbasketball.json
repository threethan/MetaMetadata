&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBBVrJwqKNwQ7kNvwG9APki&_nc_oc=AdqMiD_COMHWW7r0If73EHP7vrhDWkrRhD37oqghZmPpuVKv7twOcAlTts2JYPML768&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWdd8lqwnSWtnt5TEP2CXakSybp-jlX4Nc9xdhSPv6Mg&oe=6B0C5CE1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot, sky hook and your DUNK! Oh yeah, there's multiplayer too. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OJOSmAlYAxfsAdHu14Js2SWAe8pkr3AuREebGQ4Dh2g", "developer_terms_of_service_url": null, "publisher_name": "Doge Labs", "support_website_url": null, "website_url": "https://linktr.ee/bigballersbasketballvr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
64.5771-25/499311613_1218629393465022_60069909768779232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ULkoXPs6y8Q7kNvwEqFQC0&_nc_oc=AdpwKmxzmzzfsfWRjFFdatB3wZhxQUHZbcfjIco4FztYf21eTBM03bSs4Py4_qE84vs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YuNU7U0olxqmHvaNVtOh2q3Y89WoE4gYkfFepStgHKw&oe=6A411EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ballers26.png", "id": "839686339048058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308103_839686342381391_5057831554818303431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-urqFdK7isQ7kNvwExhciT&_nc_oc=Adq_5_dUYYz_19b_H6lQlmA8zTNUJ34RGbyF-84eCEdDChubZgdiI5hG6bm_XIs14MU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l_QBhJ6EiTjwm4MwHs205lwa-DDKUgbiI2trzZjk09A&oe=6A41154C"}, "display_name": "BIG BALLERS '26", "keywords": ["basketball", "football", "baseball", "sports", "social"], "long_description": "# \ud83c\udfc6 The #1 fully multiplayer all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. It's a fully multiplayer game where you can play with up to 10 players per Park and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches. There's even an MR mini-hoop mode and a Blade Ball inspired game mode.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\udde3\ufe0f COMMUNITY RUNS DEEP \ud83d\udde3\ufe0f\n\nWe strongly believe in respect. Earn reputation by playing with good sportsmanship.\n\n\ud83d\udcaa FLEX ON YOUR OPPS \ud83d\udcaa\n\nWith 100s of cosmetics available in our shop, you can make plays in style. Customize with the drippiest hats, jackets, kicks, and accessories.\n\n\ud83e\udd56 FRESH UPDATES MONTHLY \ud83e\udd56\n\nExpect new content and enhancements every month, tailored to our community's feedback \u2013 that includes you \ud83e\udef5.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24\n\nGo big or go home. Play for free now!", "short_description": "\ud83c\udfc6 The #1 all-in-one VR Sports Game.\n\n\ud83d\udc10 BECOME THE G.O.A.T \ud83d\udc10\n\n\ud83c\udf96\ufe0f Begin your legacy in BIG BALLERS VR. Play with up to 10 players and perform crazy windmill contact dunks in basketball, slug dingers in baseball, and clutch it with game-winning touchdown catches.\n\n\ud83c\udfc8 EASY TO LEARN \u2013 HARD TO MASTER \u26be\ufe0f\ud83c\udfc0\ud83c\udfd0\n\nOur world-class physics engine gives you realistic natural gameplay while being easy to grasp yet challenging to master.\n\n\ud83d\ude24 WILL YOU RISE TO THE CHALLENGE? \ud83d\ude24"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bigballersvr.com/privacy", "developer_terms_of_service_url": "https://bigballersvr.com/terms", "publisher_name": "Doge Labs Inc", "support_website_url": "https://bigballersvr.com/discord", "website_url": "https://bigballersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25635861269388850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64
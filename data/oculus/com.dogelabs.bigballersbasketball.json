2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TygftMw8-qwQ7kNvwFqFLxr&_nc_oc=AdpKoE28H8Qbquu3JOPzrc9wCDNt33YKll0naSaJF9Q04zJXroPX1RNJNp2yz9Wj6rg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3-3myiWN5KJ0T1MgSefwF9LoMYc8iRGl45wx36zr5HA&oe=6A577B58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFfHsaLQ9KQQ7kNvwEUSjz7&_nc_oc=AdpF_bReNpXPR7FcMJC3oxUpL_wfvtHAqVTvM8y7ooQ2-TwH8sJbL6ocGawYSNAcq5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu8ydPo5qxN-WkcOFS0rXivJf3OSxm1lO5vJzSbnM9uA&oe=6A578367"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28L1seY6vD0Q7kNvwG7Gwj6&_nc_oc=AdqCe6DOkpygXK1z6Tdn4O4ud9Xbrn38EwcPY_OgAIng-51mXTbWfKQWgoKUqyP-Lk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4RodReKI_YDUvnes6lKX1zStGrMAkf3emIjRegZdC-Q&oe=6A578721"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
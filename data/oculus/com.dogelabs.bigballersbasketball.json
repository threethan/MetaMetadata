6334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lbl4vxH4j0Q7kNvwHII1DK&_nc_oc=AdohBbk_kdUj_SP-4xuNVl6dOrzFPz37_5FzMyPBfUlWGq9cmSzXohkDuv6GzXklccc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt3yy34pGLyHeBwBeLe5exfe-i_AGsi4juSkbLAFvWFQ&oe=6A8842D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-4sAr-zsv8Q7kNvwEOmKyN&_nc_oc=AdqK5kU767JcResZSTAfjm-OzczA82Bn6YzePgJovoyuWSXp2oHIyF7RAeoJ6trAEkQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3tByUle8RTLpG_pVpcs0GCvlVpxQcj4AlKiD4NgMioA&oe=6A884AE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6grwJDYx14Q7kNvwGYnk7T&_nc_oc=AdqA1O3I02K5OlFcZGrDPY8_m5TZa84sNkO7Bq3Yj51xDad7rg8bmNGJEq2a3oXsz6k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4WVKp2HyJO4uVrKYU8uK8lvVTLDjPm0HsWzXscDamsA&oe=6A884EA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bask
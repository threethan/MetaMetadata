2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXO-xnzHx4Q7kNvwFdDWi7&_nc_oc=Adpr3aKVvZHjabEmv_lxhSs6GG3_XpOJ72Fof-NeSSNdi2PcXl9w1CPQwuYrU1W_zRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD55xxGiRD94pJmGF_AgRAz_7rnZ4tfRMm-DRfAOxAqhw&oe=6A4CEF58"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P0WPLqe4XkQ7kNvwE3Ixxm&_nc_oc=AdovK8zrmVCXRk5Z9g9SRfytwyjsLFAUi3XGxhn6JHaeHkxxA5AEJXCUsq8JnnDixwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjgUxR1W7upGFrVmiO4vl9bZJ6Bs6qP6NiRlbgeovFgg&oe=6A4CF767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-77djPmyNoQ7kNvwFzD4vW&_nc_oc=AdrHvaji4InkXLCzTm2gSxJepreTU32jfxbtAaZkyYDyZgNkAIwYtivnlpsJhpzW2ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8xKdH2Tdp1B-SEnoK1DdJQkkj4DtENGwrZC5PUN2d4w&oe=6A4CFB21"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
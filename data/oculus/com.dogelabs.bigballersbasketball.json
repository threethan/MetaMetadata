2976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6NOl3dXqUwQ7kNvwHvcH4y&_nc_oc=AdqhFCNvEEgTZcCYnWsQ-D9K_6NV1sCPNL34dngbm2RLQUgcw4L3rPlr4BOnTP5Dp8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CbMDj2mJmqhaDQq7DGNpE4jm-R0q60mnDbp7qsJFJZQ&oe=6A070FD8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLN76Af9c3QQ7kNvwHwXTUB&_nc_oc=Ado6wvSNpJjg2A5sCJ21kV5kxaLmtpK34eGRkUW_Sa_m-9FXrREqxjZQDF4ZlVN5wg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Skk8x76mjsM8VPDmwE5gEwhJvdsGF-lXmhJ81mXjSvw&oe=6A0717E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeGrJL0XLqIQ7kNvwHHAe33&_nc_oc=Ado-_GIKGbfMyi5k6WBCynRwqfjxEMck1-8vtarwrGzCpErCavyji0E2VEECKst6wN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l89XbPXY1Tj_imVkOsfMQEw4aLWeS3vQ3Rc6mq7lFRA&oe=6A071BA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers B
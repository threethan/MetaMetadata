0_151222580142976334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjzK24qSK4QQ7kNvwGeIIk9&_nc_oc=AdrNdDUtUIcL8beuotPUnIvkRNcH1Q3tSFS5OLpngPDmpWKA62X0jQH0T9eMxoh5ZVM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvhXh0unqFrNT0ttOt14g56p4phBNZ3tF2VWv9dDDH7w&oe=6A9733D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQP9Nm-KTf4Q7kNvwEmFKAn&_nc_oc=AdrLfKrFV7yOsdFUGr_9kx6bBb87E-gW5fSxpXllYcIE3l4L7VHszit_3m1wEVIzsow&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi3MUhXEu3vB9w43X_Ee9Epc9pL-G4yPHpXrS-jDifow&oe=6A973BE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifB13mgI-UQQ7kNvwFvH1HO&_nc_oc=Adoh4pgsoCUtT3zSfFWPbc8jo1QlfRnZrnTOL-QXL23RT7HxILJznVVbNZsLABEUInI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH906vCzz6BDhcg0nonKZ-lUYbExZ0CYIPqutAmKGcIJQ&oe=6A973FA1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "
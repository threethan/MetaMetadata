76334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dRjD7gwBEMQ7kNvwGClyMu&_nc_oc=AdoNTIxCTAMVCu6WZIRv3iKN0rD3ZHt8etwR5Odj1dHHLoZ5dR6Vqz94Y7M5hJyJbTA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQahIMpbbcoTPHFPjpq2TTAwxygXBX-o6A5XfiA7n6HQ&oe=6A8059D8"}, {"file_name": "dribbling.png", "id": "565302594470834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568668_565302597804167_2403830162561096493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6BX_i03YRkQ7kNvwEkXUZL&_nc_oc=AdrlKLEOCHbbNnbnFO0L_fjiJ7MUKVIyhPjbEOFD4YGXo3xt59BtIc4qOfzl89OV5VY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE98oXGWS_ivcGz7oNxmnG6wBBHRY3aUNCYw_vSzXlbwA&oe=6A8061E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dunk_screenshot.png", "id": "854696385153934", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003271_854696388487267_8661722327325916084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSIdjpZOR-oQ7kNvwF3jh7C&_nc_oc=AdrmXdXkau7tqoTHLZz3N_p3FYR-ro7YReztvEh-TvpFNmjyYwiNmZWQhgampMqd1Lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlhVvMxLirB7Gbhm1bR-R_NlNYZBBsxru-gV0lpRlmTA&oe=6A8065A1"}, "display_name": "Big Ballers Basketball", "keywords": [], "long_description": "Big Ballers Basketball is the ultimate basketball simulator. Enter a virtual basketball court and practice your jump shot or even your sky hook! Use a natural basketball stroke and Big Ballers Basketball's realistic physics engine will do the rest. Make sure to hold the grip button until the top of your release. Try the 1 minute drill minigame or experiment with reduced gravity. The court is yours! Dribbling, multiplayer and even Shaq mode. It's the easiest way to have fun, socialize and exercise at the same time.\n\nAs you shoot enjoy the music from your very own Boom Box. Feeling a little tired? Big Baller's has got you covered you can play seated or standing. ", "short_description": "Big Ballers Bas
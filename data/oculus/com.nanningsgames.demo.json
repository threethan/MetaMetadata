43_6059803366373093288_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKw96FyewYYQ7kNvwGo-RVz&_nc_oc=Ado-s4dGNpcmd2plxbL69_aDlmMf2HzysN7S0C7Qk5AMWV1W5xFU6v7Vy-vv7zkw-ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzgXGstsSTvbKEWTm7YKnIwGpz-Tyzxj7MmS5zukm8HQ&oe=6AFDC733"}, {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1850827032473309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308010_1850827035806642_8062576495707158250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIdokNW9C2QQ7kNvwHnqXRb&_nc_oc=AdoCO6mnbU3vohJJsJ14mL5cj7e9MBpVrq7fhgwUqxOjqpnCBkMdLnqRFVCI_4VVEmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmHI8XtrZKciO-yIpYIzF2vJCGvTvXi_jhfilG65B1KQ&oe=6AFDD9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1216337873742142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308131_1216337877075475_333303783646243478_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YjzzCCyY64Q7kNvwGZTRZz&_nc_oc=AdqhtTreSTdRnax56ushCkmnCJE-OFyNQITUc6TWyGCqjeJyr0ewvEdVC7LOs4Ix0xA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Qy6D-kPNbBdmKqJHhfLSwHkouvK4icbUBqx7SRl_8A&oe=6AFDB566"}, "display_name": "The Gallery: VR Secrets DEMO", "keywords": ["gallery", "museum", "art", "puzzle", "escape"], "long_description": "Step Into The Gallery: VR Secrets\n\nIn this demo, explore 8 atmospheric rooms \u2014 each with its own riddle, stunning paintings, and unique mechanics to solve.\n\nDelve deeper into the galleries, each alive with mind-bending challenges tied to the art around you. Decipher cryptic hints, manipulate paintings, and explore at your own pace. There are no timers, just pure discovery. The immersive environment draws you into a narrative of intrigue and beauty.\n\nCrafted with VR passion, this journey awaits. Wishlist now and prepare to unlock the gallery\u2019s deepest mysteries!\n", "short_description": "Step Into The Gallery: VR Secrets - Immerse yourself in a VR art gallery where every painting holds a hidden puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nannings.nz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NanningsGames", "support_website_url": null, "website_url": "https://www.nannings.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25588299734203549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1555910315633709_7611379127910737047_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTqxyYmpUVwQ7kNvwFmMRlN&_nc_oc=Adqmd8k5dj3RInWzfQr3OPgDdGaqfV9dJhSfYP4NSV2h9I8JUonU7hnMjeEVa-2RHeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfRSRricdFIWL01R_BUZ9hn6kqG9wBHkuwaW-3zpaF8Q&oe=6AFDC249"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Gallery: VR Secrets DEMO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1763487960, "lastRevision": {"nodes": [{"id": "24947896594910536", "relea
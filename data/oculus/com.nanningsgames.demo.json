b5a28bbbf5ec1956ab26.png", "id": "1850827032473309", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308010_1850827035806642_8062576495707158250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISSn0MIrB1kQ7kNvwEmys7w&_nc_oc=AdrXbgjd43OQ78jEnFJARP96xDc2kk8toLHVZP0hYiz8-qxDh5n6zEqCIXVXOZ_-R2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2RKX6Vc6nbNaOqhaUGwa3Ko5k9Q06ahwAWb54NU67Y8g&oe=69F0AFBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1216337873742142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308131_1216337877075475_333303783646243478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slthzeOGYPsQ7kNvwFvfISE&_nc_oc=AdpOeLLSDWaEAkNsgjkqZJoStmwre5ln8GKXaPb6m58G6ZvBK_OmKEgE3NR2u5VwuL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Sfj4v6b7U1kY4KfpvOuqW-Cw86QOG2qikrq0k1YYqkw&oe=69F0C366"}, "display_name": "The Gallery: VR Secrets DEMO", "keywords": ["gallery", "museum", "art", "puzzle", "escape"], "long_description": "Step Into The Gallery: VR Secrets\n\nIn this demo, explore 8 atmospheric rooms \u2014 each with its own riddle, stunning paintings, and unique mechanics to solve.\n\nDelve deeper into the galleries, each alive with mind-bending challenges tied to the art around you. Decipher cryptic hints, manipulate paintings, and explore at your own pace. There are no timers, just pure discovery. The immersive environment draws you into a narrative of intrigue and beauty.\n\nCrafted with VR passion, this journey awaits. Wishlist now and prepare to unlock the gallery\u2019s deepest mysteries!\n", "short_description": "Step Into The Gallery: VR Secrets - Immerse yourself in a VR art gallery where every painting holds a hidden puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nannings.nz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NanningsGames", "support_website_url": null, "website_url": "h
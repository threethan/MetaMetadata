c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS4JG-PlaQgQ7kNvwFqCmUc&_nc_oc=Adr5VvHg_GAnAcDDw8TFWqTOcM2xPpTQXy5RyFFntaCZsJjH8fl7tUL4uX1lPRGo4PM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0om9zKFlmGQizr_I0gYTsB5yafdBguC81P_wJgx8HfOQ&oe=69F1EE73"}, {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1850827032473309", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308010_1850827035806642_8062576495707158250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE2FFmRal38Q7kNvwEMCva1&_nc_oc=AdpTg1vchdP7T38k78UE7-WJHiNeI8QEhmwUOL4JfkAo_1wlAUl6WQR0Mih8eDFgzo0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0XcoEaipCX_rzwUN9MhxCH-4cojrsuZlBYpweaufQDaA&oe=69F2013F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1216337873742142", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308131_1216337877075475_333303783646243478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slthzeOGYPsQ7kNvwGXZ8t6&_nc_oc=AdpzIBsKjdS5b1_EOiwnIvgK1QxxTLtd_8dGriiKwckOjFKJ9TzS-attxsZ5rxf9r_M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0jn_ufOwsRuxkOw5fJYukYC1wp35V-WAOHFX9Q19g3LQ&oe=69F214E6"}, "display_name": "The Gallery: VR Secrets DEMO", "keywords": ["gallery", "museum", "art", "puzzle", "escape"], "long_description": "Step Into The Gallery: VR Secrets\n\nImmerse yourself in a VR art gallery where every painting holds a hidden puzzle. Wander through 20+ rooms filled with interactive artwork. Interact with a varity of different buttons and switches to uncovering clues in a 3D world brimming with mystery.\n\n\nDelve deeper into the galleries, each alive with mind-bending challenges tied to the art around you. Decipher cryptic hints, manipulate paintings, and explore at your own pace. There are no timers, just pure discovery. The immersive environment draws you into a narrative of intrigue and beauty.\n\nCrafted with VR passion, this journey awaits. Wishlist now a
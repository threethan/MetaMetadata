scdn.com&_nc_ss=7f20f&oh=00_Af_h5zwX-k7J8NV1O1aErIv4394U97UvtKC_Uw-IYYcrCA&oe=6A3E9DB3"}, {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1850827032473309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308010_1850827035806642_8062576495707158250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC4inlDPVfsQ7kNvwEpolTc&_nc_oc=Adrp39ycQNbc5lfpTw90-mek8ML4D3mWH24hKitLOnA2t3JsWS7qt83q1QLizor0i1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OoQpu5V4dc7Pd4sNns1UydnYXN1TFu3NlTtbfVb9LoQ&oe=6A3EB07F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1216337873742142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308131_1216337877075475_333303783646243478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0xBBVGuHR4Q7kNvwHaxW5n&_nc_oc=AdqBwRueL8RPBPdUUTpoY8hiVKONZ13kXL5oaB_RzSTDiKmpVZmaocBk5hojJx2ZifQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OBGB9npISSLXJ4lYpjVNGQ5FJVoQRFQQbfhfYf2GJow&oe=6A3E8BE6"}, "display_name": "The Gallery: VR Secrets DEMO", "keywords": ["gallery", "museum", "art", "puzzle", "escape"], "long_description": "Step Into The Gallery: VR Secrets\n\nIn this demo, explore 8 atmospheric rooms \u2014 each with its own riddle, stunning paintings, and unique mechanics to solve.\n\nDelve deeper into the galleries, each alive with mind-bending challenges tied to the art around you. Decipher cryptic hints, manipulate paintings, and explore at your own pace. There are no timers, just pure discovery. The immersive environment draws you into a narrative of intrigue and beauty.\n\nCrafted with VR passion, this journey awaits. Wishlist now and prepare to unlock the gallery\u2019s deepest mysteries!\n", "short_description": "Step Into The Gallery: VR Secrets - Immerse yourself in a VR art gallery where every painting holds a hidden puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nannings.nz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NanningsGames", "support_website_url": null, "website_url": "https://www.nannings.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25588299734203549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1555910315633709_7611379127910737047_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unBCBr_HuxEQ7kNvwHTSCkv&_nc_oc=AdoTbUq4TjCNwGTDS-eV2A8WDgh6CL_aqlgocc3UtIHTyEVoNf2UhLo2GFRVgmmxx2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UTPCE9fVXojyIRN_iZYL_5Q4IOmkk-5XcVVIj9OOxXg&oe=6A3E98C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Gallery: VR Secrets DEMO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1763487960, "lastRevision": {"nodes": [{"id": "24947896594910536", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24947896541577208", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2380804679104659"}, "iarc_email": null, 
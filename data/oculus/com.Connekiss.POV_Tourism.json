Vc92R7dw&oe=69A2D924"}, {"file_name": "sc_01.png", "id": "6517520894967831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_6517520898301164_6395335735491374118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8EE_9pHrCwQ7kNvwHmNwb5&_nc_oc=AdmzVj7jH_J9GED10DtdMjlddKxHd26Q-MrmOHcoxyZvcUkZEP8xDiIfAdY1XybEEdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQkeCfDIynk5LXdyODlWoVMKL5H7oaPncsgRFpNtqIIg&oe=69A2EDA4"}, {"file_name": "sc_02.png", "id": "1518179132261036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974696_1518179135594369_257910132901749458_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6CJvIedfmYQ7kNvwHDvRh7&_nc_oc=AdkP_2DXtfLvxVTppnI1fAQtbSE8sXKsE3OUOv-a-GWTmXQzzu4XKQRUFyyL_MMH6xU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_iAyitAUnV0hif5jUQTuA0z3vH4hdTQ8rbXcs3Dqa1g&oe=69A2F43D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POVtourism_\u6a2a\u578b.png", "id": "265584256313637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429290_265584259646970_4393368837019640881_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gokPqZmVDt4Q7kNvwFL4vNn&_nc_oc=AdkO-neixVeuA4ZQNy87XzNDm_FnKm8FBw4jLrkH-01avz8uL7G9nq0lWpIRKko--_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvu6yAX_V0W_E3di0EjPBqbcUjY78ilC04G9Vqsj2SZzw&oe=69A2E11F"}, "display_name": "POV Tourism", "keywords": [], "long_description": "The Moveabout VR Tourism Experience \u201cPOV tourism\u201d\n\nWatching live-action 360 video in the POV tourism brings you a special tourism experience\nThe POV tourism is a  multi-viewpoint VR visual experience\n\nUsing the controller to shoot the floating gate or cube in space, you can warp place or perspective instantly\nThis is a completely new proactive live-action VR experience.\n\nThe POV tourism can be downloaded for free\n\nEnjoy an innovative VR tourism experience!\n\nThe POV tourism is an evolution of immersive visual experience. The 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the sights and viewpoints from anywhere you like. You can experience the same sights over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV tourism!", "short_description": "The Moveabout VR Tourism Experience \u201cPOV tourism\u201d\n\nWatching live-action 360 video in the POV tourism brings you a special tourism experience\nThe POV tourism is a  multi-viewpoint VR visual experience\n\nUsing the controller to shoot the floating gate or cube in space, you can warp place or perspective instantly\nThis is a completely new proactive live-action VR experience\n\nThe POV tourism can be downloaded for free\n\nEnjoy an innovative VR tourism experience!"}, {"images": {"nodes": [{"file_name": "POVtourism_\u30a2\u30a4\u30b3\u30f3.png", "id": "1265363657509762", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974494_1265363660843095_4753803327742316720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkRMqRA1IMQQ7kNvwF6RWWB&_nc_oc=Adkq4-IYVI24NLrhyd3a-bv8pjTLCLmIj7-Mnq2FVFs7MLH0xlKqUGtwyLgfS0j8Ulo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKsV96M3W7zLJXTnMHyBavjq7SAu0vajyCzSq_qb1tIA&oe=69A2E27A"}, {"file_name": "POVtourism_\u6a2a\u578b.png", "id": "1025737858425525", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974626_1025737861758858_7723958960188049080_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjed9ltVM5gQ7kNvwFbY6xY&_nc_oc=AdkkU2NXzcotyq1-saFa1AI2TUdpmLrPQA2XjwMpSkQ62_qii_dZ5oCKmVMPN54s9lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUD5tRuef6ChBqZB4oOqZ-cpQyOS7dawGlZqMXBsGhbw&oe=69A2DD18"}, {"file_name": "POVtourism_\u30df\u30cb\u6a2a\u578b.png", "id": "1021138572376352", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad
w2zRCENg&oe=69A187A4"}, {"file_name": "sc_01.png", "id": "6517520894967831", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974494_6517520898301164_6395335735491374118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ym12UPpiuM0Q7kNvwES9ddG&_nc_oc=AdmgoSILWicA3dHcUeurYFpMrrMSBiO1CBm3ALfhdeyUAitocjKaSv1rFbzEQprYPyA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuYJ9aLBNnqMUvgcGajGpYYPLWEzYrDxXnqQdZX4LFpXA&oe=69A19C24"}, {"file_name": "sc_02.png", "id": "1518179132261036", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974696_1518179135594369_257910132901749458_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6CJvIedfmYQ7kNvwHX_qkm&_nc_oc=AdnfEaQ0v5cuqbCGaZ8YQkiFC-B__zFxApwNuPX2-vxwKgQ06qbKyH5LI0DWMDc_E0g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfujVdT5q6evQ0U6BDBuWbubqAQT15QBR4n3gtdN0cS96Q&oe=69A1A2BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POVtourism_\u6a2a\u578b.png", "id": "265584256313637", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75429290_265584259646970_4393368837019640881_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gokPqZmVDt4Q7kNvwGLdkrK&_nc_oc=AdkM_EXeSvIEvsZ7D_QY9dF1iz6BlWqX9_scdfSco6v1F1b48eK6pY-PBS_m3oxPKnI&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsrDRCU3YlrUkX4gh0hFPbUIlFBJe37uYK3JIyYo9D3fA&oe=69A18F9F"}, "display_name": "POV Tourism", "keywords": [], "long_description": "The Moveabout VR Tourism Experience \u201cPOV tourism\u201d\n\nWatching live-action 360 video in the POV tourism brings you a special tourism experience\nThe POV tourism is a  multi-viewpoint VR visual experience\n\nUsing the controller to shoot the floating gate or cube in space, you can warp place or perspective instantly\nThis is a completely new proactive live-action VR experience.\n\nThe POV tourism can be downloaded for free\n\nEnjoy an innovative VR tourism experience!\n\nThe POV tourism is an evolution of immersive visual experience. The 360 video is recorded simultaneously by multiple 360 cameras. Viewers can freely move their viewpoints with the controller. You can watch the sights and viewpoints from anywhere you like. You can experience the same sights over and over again in a fresh way.\nIt's not just immersive like you're there, but you're able to manipulate the visual space yourself. That\u2019s POV tourism!", "short_description": "The Moveabout VR Tourism Experience \u201cPOV tourism\u201d\n\nWatching live-action 360 video in the POV tourism brings you a special tourism experience\nThe POV tourism is a  multi-viewpoint VR visual experience\n\nUsing the controller to shoot the floating gate or cube in space, you can warp place or perspective instantly\nThis is a completely new proactive live-action VR experience\n\nThe POV tourism can be downloaded for free\n\nEnjoy an innovative VR tourism experience!"}, {"images": {"nodes": [{"file_name": "POVtourism_\u30a2\u30a4\u30b3\u30f3.png", "id": "1265363657509762", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974494_1265363660843095_4753803327742316720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkRMqRA1IMQQ7kNvwGGE84R&_nc_oc=Adlba3juW5Km7YdqohJ9dyg6sIHqmXuHdtkqYTDZWF46fSKhMTDVHxmqbVsHDgZ73ak&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvgawHDk_OY_E7qTPhAZ_i5t1USsVtwUdfNxkur7TcJyg&oe=69A190FA"}, {"file_name": "POVtourism_\u6a2a\u578b.png", "id": "1025737858425525", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974626_1025737861758858_7723958960188049080_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt2_klx7HgUQ7kNvwH7sicg&_nc_oc=Adk6Zz-SYQ92R79AvJv0za1ni6EcrWegduy6eobYj0WZK12d9LWeeOxAaGLnIjY_Q00&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftfXa4GEjsAmM-v5jPZ3bPE6GQYh0J-4swp-fdrXka7rQ&oe=69A18B98"}, {"file_name": "POVtourism_\u30df\u30cb\u6a2a\u578b.png", "id": "1021138572376352", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg
uluscdn.com&_nc_ss=7f20f&oh=00_Af_zif11GrH1jpzinziQUSLFbcAu7xN_ORmLRrren2WUEw&oe=6A4501A2"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K93pphzmGBcQ7kNvwGXUuwo&_nc_oc=AdpTK9661UaBmas0DpFwewMQ5uj43xjH-AEnodivbR3ldKnE6_JCqARMYI7Zt0AomzI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4zs2xugh2stZT4aMzoWoOWBi5hZd9JwstWTSBqBYRng&oe=6A452337"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92nRs4oOPcYQ7kNvwHuBiMC&_nc_oc=AdoeLqjYl5a7aKvF6OCOjTl0SzjRdf3YQhuD32bCZDrRjh9_V_5MLGtTPpfOLvEyRyY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8veaxC4rkMoLd8yrkydTmZ7ZPw7oXMP7z106J5jlbEJw&oe=6A45380F"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QuFni62V7oQ7kNvwF7bAP-&_nc_oc=AdrEMGBHVV499g1Vai2uGmRrARiHb2rLlKb1u0hhEd4elAkOfuM4S6mtv2ElzRDN3y8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7F8tE1voBi-sQW1ZJ_l7kdRPc_Kw6LM5vpvhwpchxPw&oe=6A45103F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L7Wyl1PTDkQ7kNvwHzZNrg&_nc_oc=Adr2Urz7JzJTC2MfRImJ5YYTMxj5XtWNTt_CFpUktwQVE1e1bALaxacGVKIP2fcqIOQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kspEg6X5KPRlGCSsyMJCTnXPVoAOL7IwPCmwJUC21dA&oe=6A450803"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
uluscdn.com&_nc_ss=7f20f&oh=00_AQFOuuQZrzQFgzfzyDqRkTkULqT7q_XAKkSNJ73NESYTRw&oe=6A9178A2"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGF_T98GOYUQ7kNvwFYWZ_M&_nc_oc=Adq_Lz8KsvWIH5CnNvQB-ZM_MUWZiibd_MMbFvcOwgaGPme_npwK7zUYBWV6i_G42zA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELEAgoCfdikXcckp62QwO8goECw_S7yV6QjZbxILkTFg&oe=6A9161F7"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9QCT3TgANwQ7kNvwEdwB-9&_nc_oc=AdphJgL36K63gUsX_9cAnXDQCLi91EeFp6kDME1EDw31YDM75n_NX1wsmPWQirPIOFE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYDtPQ6vj2jWNYi-EzMEIwwis3kWl6alml7VWmZFYDlg&oe=6A9176CF"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhKqxNtJWj0Q7kNvwFEki0O&_nc_oc=AdozXIKJbexD_bNtxGPsVjlun_1BhMnCHAAbRU-ze3uEMtvghJxl8pxHUsSBtqk_Qlk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyYPae1qrzZvkPNRbDAc1xsuTf1vKOJGHonBSl8u4Kog&oe=6A91873F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ej3a5Q48joQ7kNvwFYIZoT&_nc_oc=Adpj761ttRxj79mPoT5hUTH4s2kLQQ3JvThdJFnky1Nvrq-LPxqteEOjZpykDgZYhMQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXayD-7QvMiHE1lWMjl7EW_Cz5JMGB_P2ivGeF5REZDQ&oe=6A917F03"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
uluscdn.com&_nc_ss=7a30f&oh=00_Af2VcBr7U2u2hCnUiaA4FbQeYTStLCGZEqYoHNNoci4MXQ&oe=69E22122"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoyyvP1rzvUQ7kNvwGxTtqo&_nc_oc=Adrp_HDD4Z23j8Z3NEfHn_GjhpcZ4tIDk77i0rMjlaHdCSzJqP3Phul5rfmKSqBBvwI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PPJEw-GiV2Uqaj_sS0s4wA-aDW95asZwZJhEXuyj4cA&oe=69E242B7"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVipQ7JYfG0Q7kNvwH9XZgH&_nc_oc=AdognvaA8Q7JEbRkDWl9NI23mL4jJ1ddk3l6ICgrIItvjbQz6mvsfZ9MFXM4jQc17nY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-1qZnqM_oVVpNhAIdUmBzfy1JEMDyv4-ZLN2cXw8j_A&oe=69E21F4F"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icULyhdqvhQQ7kNvwHxZ0Ow&_nc_oc=Adr-0eC79EDTWo21mkBxZMZnZgptA9hiSL64GVrjt8fKDSILpzxNtCKU_8owomPbm8k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0siCE1GMhWG2Ss1263J-JSlsOxuusoXwxAdm_qrfun0A&oe=69E22FBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKoXQCkG5pcQ7kNvwEeROJH&_nc_oc=AdqycU5d9go_rARoiXX-zav2LjvV0a_TLKb4B31JLQRov-sMauxb9gWY2fxqFE1WUK4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TSwZr8Bj2NRHauR3sr8eU1E81tF6CdiPVP0IwJgF7eQ&oe=69E22783"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
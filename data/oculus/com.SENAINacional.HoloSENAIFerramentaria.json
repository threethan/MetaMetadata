uluscdn.com&_nc_ss=7f20f&oh=00_AQM0T20H3CiMDBo_qQjIP2PsSkasc42-cKds10hSlkLs7g&oe=6AE0CAE2"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZyC2ODzIh4Q7kNvwEyeKiw&_nc_oc=AdoPkwIHdsNojjG0Vm9m1fVA6kjsS4q3azx7tk6jotXUifvSjVWynUK7PrvRVMbV9v4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn1U2rB8aSDxS4iZUG7be79Yu_CB8DnGPo_cvfpeoAyg&oe=6AE0B437"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-UYwoA5UGMQ7kNvwEwZHFm&_nc_oc=AdrPkUfk0qYnAr_kwxU_CPIxwj_gWCEVNZpTq5a8DOaE1kLkUttD0dV0LAjeyLih_uw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzPWvdWkij7r1EmACGukf4PSxUBBINQnXeiyaiTY82pQ&oe=6AE0C90F"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79GsCJ4GzxsQ7kNvwFhsZyK&_nc_oc=AdrQ2URNujRsaFsgSGatc0YG3Utz9UzZl-GCBVGxazgNckqYmt80wsISq-5w8w3FOnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXLhy1ig8HfvMpVOXfvGthLv8j0yMsWQVCDmn_vHl7Bg&oe=6AE0A13F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTAA1B3xWfoQ7kNvwH5XHfu&_nc_oc=AdoQuL7rHi8Uy0dvp0YGY3hWSaVXgFFOyJzjEKneF2rdRaOMsC805umeg8BTVIREqeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGZHo6m1ZDhLUFpqrq9Nl5rmIaQrauBBf_cJ7yXNg-pA&oe=6AE09903"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
uluscdn.com&_nc_ss=7f20f&oh=00_AQFEyPu1dBrgQ9WNWvyl1uiznDWbDYdWEEb1WNzrmrUJcg&oe=6A786C22"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRtSYuz46j4Q7kNvwH333zl&_nc_oc=Adp_H-jJ7uOA9_8Ek9ionr2zcWNH8kSE3W6CMiNOzw0kv88CJzlowYXugSvTz1KSlUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLAX1-ly57YD39s_LEwA76Yb98yw1e-E6FiaubDvHZ1A&oe=6A788DB7"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPH4txt8xlcQ7kNvwFukZAZ&_nc_oc=AdrVe4dHlNNCAp3vN8h2rlsataQhkWB267myzNkFL6VumiHmYE7UVed_kXnraA0iKqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF14pitY8CQRMecUVLn2RmfIno-YH9bAXqLENfNvc27Vw&oe=6A786A4F"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdOA7TFnr_YQ7kNvwFJZ7Zc&_nc_oc=Adr-Ch_EUNpMhdBKgFK89y7UYbwAgdax8dYxFX6wdU3TCSjEHzIu6Y39nuis4qaKDxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqAk-XBbppMwVZ3EMrXNjD9kNzipfsohVqwi0xzRSHaQ&oe=6A787ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKMvM9VmvqYQ7kNvwHu8qqM&_nc_oc=Adoy7O2hDNmNPyTkRJMcg7Q2dJdSXOPwE_xTDYv-4NwhXcT7cNWPh3VukP6nZblX-KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAE9erBWQAPQ3-89VBqagoTSWWeeliSw1twZgDvgUA7A&oe=6A787283"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
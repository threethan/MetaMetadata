uluscdn.com&_nc_ss=7f20f&oh=00_Af4Tdcw-U7FzY2458vcsTn94uS4vjKyTzYaR_HQz5pG5Lg&oe=6A15C3E2"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JRxDuWvJ_8Q7kNvwE1un1r&_nc_oc=Adp1guw_jJiO_PKF_om7RBNWg9e9tokJwpQB6XJ6Cqc6NF_5vBGiF_sP_UjHQoTQLT4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46xJ60HIDeuajS0URLqrZk8NmhyUbll9U88-5o8N6RfA&oe=6A15AD37"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYZYhF8EOZQQ7kNvwE70DVK&_nc_oc=AdoJPR33CwBtQdunRtyrw0Mu7daIB17Q2GAq61oc_ICy6oSSBpIjw498NZx9LIaOS2g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h7ruCzVYj0t2VNc9-SIV5HF-xhfABeMgjTyGWWiDpKg&oe=6A15C20F"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5TqlZtvcEMQ7kNvwFcxeQh&_nc_oc=AdooL0GE_e755Y2qXB1X5ZnnXVYoBHgWUGBbwUJXYBZPENYXUNWMagP3PXMGGHfLaKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bPtDnCFWU7kRU6f9NTzNT_fNXyjXuWfLcdauDadEuWA&oe=6A159A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgP21zxrwXwQ7kNvwFzjjDX&_nc_oc=AdoNRakQ2srRTCqfMqGyyZ5DpDe0seOkQLwL9VRLP2qGK3X5iDoOb9N6k-u3DyZzXik&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U8eveZmmhkno61JgaJ5n1C30ch8j4qX7NXQZRjFPW8Q&oe=6A159203"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
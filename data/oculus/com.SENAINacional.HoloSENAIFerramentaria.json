uluscdn.com&_nc_ss=7f20f&oh=00_AQLVqeJ5pCkZQY1jBIqfzLPnxYkI-b0jvxd54Sr9rOMVFg&oe=6AA2D462"}, {"file_name": "03.png", "id": "2136446170092327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_2136446173425660_660864580853784193_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD1CZbcz_2gQ7kNvwFpESSa&_nc_oc=Adooi3IHCaA5IdbWlmhAtDM_SMv1kQ6IFrUv0cp_vdfQ5qUnIfmzn-nwP1fGn-UGWuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuzXbL8GyUBCMc50MGpQjY5PHNH3hVr-I3UcRl2g3khA&oe=6AA2BDB7"}, {"file_name": "04.png", "id": "1475435596850698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820382_1475435600184031_3737378493875159568_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1FG8soHYIMQ7kNvwEtGvfJ&_nc_oc=AdpSdR7tsuUfpL5FfsSL3kmRvTbVChH9gTaCVNyGiPIrjaXJ6IwsNOVc20O5dy1vfW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNk3G7R1VZ356sHsHslwPLop1Z44bOGzPJivK5PwavYA&oe=6AA2D28F"}, {"file_name": "05.png", "id": "899622579057090", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_899622582390423_4515156378650581560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSnkgYlafNMQ7kNvwGpL4C9&_nc_oc=AdoqvExGwv0NCgm8DgrbyhvZePEwUDnSuXkStfC63BnnHjh45eu4M-ebA_llKGt7c4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh1D3AAHuIe-9Or895M48EkbeiiD886u_rETk3X3iIOw&oe=6AA2AABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1507724113771480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_1507724117104813_4947206231116667616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrJh_PnjeaAQ7kNvwFh35hp&_nc_oc=Adpa9Pr2YnDfsoGT6Npa4om1zvMHr-C0BMc_D3cU1OMG1sV2DzEOV8IdE_Lj9ogmkGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8GGUd9qptgfimnwpcDMry8RP5rrI2q3B2Rb9B3G6Pwg&oe=6AA2A283"}, "display_name": "HoloSENAI - Molde", "keywords": [], "long_description": "Explore o funcionamento de um molde de inje\u00e7\u00e3o de pl\u00e1stico em realidade virtual!\nEste aplicativo educacional oferece uma experi\u00eancia interativa \u00fanica, permitindo que o aluno visualize e compreenda, em detalhes, a estrutura e o ciclo de funcionamento de um molde de inje\u00e7\u00e3o.\n\n\u2022 Modo Livre\nExplore o modelo 3D em escala real, visualize cada componente individualmente, assista \u00e0 anima\u00e7\u00e3o completa do ciclo de inje\u00e7\u00e3o e entenda o papel de cada pe\u00e7a no processo.\n\n\u2022 Exerc\u00edcios Interativos\nIdentifica\u00e7\u00e3o de Pe\u00e7as: associe corretamente os nomes aos componentes.\nSepara\u00e7\u00e3o por Conjunto: organize as partes entre conjunto fixo e m\u00f3vel.\n\nAo final, o aluno recebe um feedback completo, com tempo de execu\u00e7\u00e3o, n\u00famero de acertos e erros - ideal para refor\u00e7ar o aprendizado de forma pr\u00e1tica e envolvente.\nTransforme o estudo de moldes de inje\u00e7\u00e3o em uma experi\u00eancia imersiva e did\u00e1tica com a tecnologia da realidade aumentada!", "short_description": "Molde de inje\u00e7\u00e3o em realidade virtual: aprenda interagindo com o modelo 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1EE7lD0fcJuDOY6ybyPjOFVu_c1_QnbK5/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SENAI", "support_website_url": null, "website_url": "https://sc.senai.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], 
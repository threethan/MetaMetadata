c_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAxPrt0CDuYQ7kNvwE5oiPf&_nc_oc=AdpV4R49L_EhurFFgvvX27J9iTuWwuXhwb13osExzE6rtdf_P2AyHlo-kuL3UZ6G3NI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpgxSnFxX7CpBj6md-a8PKaaQ30oEucWwdv9JMZsnqBw&oe=6B03374B"}, {"file_name": "sc4.png", "id": "1210550384367201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_1210550387700534_7726445718242270126_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kesJkA5QEIEQ7kNvwHMepa7&_nc_oc=AdrojaUImkIHUKCUhkiSgrnyU7UlF_iy004fkU8VQ1yLKoq5JQ6COC7buiDNdQROxUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiKi6eHud7nF8hA0HPkYGL7gux24SRoByqcUmg8qYhsw&oe=6B0313FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlopsBounceXR", "keywords": ["casual", "PhysicsGame", "XRGameplay"], "long_description": "XR BLOPSBounce is a vibrant physics puzzle experience built for fast, satisfying play. Each level is a unique 3D arena where your goal is simple: place panels, launch Blops, and create the perfect chain reaction.\n\nAs Blops bounce, slide, and collide through the arena, you earn currency, unlock upgrades, and access new challenges. Every arena introduces new layouts and interactions, pushing you to experiment with timing, placement, and strategy.\n\nStart with basic cubes, then progress through increasingly complex shapes and structures \u2014 with new levels added regularly to keep the experience fresh.\n\nDesigned for quick sessions, intuitive controls, and endless replay value, XR BLOPSBounce turns simple physics into addictive fun.\n\nBounce smart. Bounce fast. Bounce everywhere.", "short_description": "Bounce your Blops through shifting 3D arenas. Place panels, trigger reactions, and unlock new levels in this fast, fun, physics-based XR puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/blopsbouncexr/privacy-police.html"
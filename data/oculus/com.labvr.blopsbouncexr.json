18_1210550387700534_7726445718242270126_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w1uED6YnfcQ7kNvwHheXO8&_nc_oc=Adoep84CjYgPdAErd3IHBg3NNlR5rMAwpeX0WrsVxahBTbOTpTrfBsth1uK7xc8wsI0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgmi0zBvlNpVngaVApRz_MQqw5oEaciNRHVV8nzabHcA&oe=6AC7C07F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlopsBounceXR", "keywords": ["casual", "PhysicsGame", "XRGameplay"], "long_description": "XR BLOPSBounce is a vibrant physics puzzle experience built for fast, satisfying play. Each level is a unique 3D arena where your goal is simple: place panels, launch Blops, and create the perfect chain reaction.\n\nAs Blops bounce, slide, and collide through the arena, you earn currency, unlock upgrades, and access new challenges. Every arena introduces new layouts and interactions, pushing you to experiment with timing, placement, and strategy.\n\nStart with basic cubes, then progress through increasingly complex shapes and structures \u2014 with new levels added regularly to keep the experience fresh.\n\nDesigned for quick sessions, intuitive controls, and endless replay value, XR BLOPSBounce turns simple physics into addictive fun.\n\nBounce smart. Bounce fast. Bounce everywhere.", "short_description": "Bounce your Blops through shifting 3D arenas. Place panels, trigger reactions, and unlock new levels in this fast, fun, physics-based XR puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/blopsbouncexr/privacy-police.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
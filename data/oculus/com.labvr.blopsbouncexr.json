c_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXvbxIpf-XMQ7kNvwHrvSPS&_nc_oc=AdoXHDtWixm6z4Yzhqua3yBy9WHDD8CdbWk-AdvYQeUWpF7NUaFvaeYvFX6o9wJqUXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRMmpDXjp4mp1o44NLpkpeVqVbfRPz9x2EQayROxw1XA&oe=6AFDB90B"}, {"file_name": "sc4.png", "id": "1210550384367201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1210550387700534_7726445718242270126_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3xWQ0ACu0cQ7kNvwFAqndU&_nc_oc=AdoW5-IvU01x1QIHkZMB7IPPlDkBsPDjBpP0l0ic7u6JnMazs38-4KHr6XuMT-BrDfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi4rz47wKlbq_VHnuP5_usDBa6jYjLluUj9RvbekuEFg&oe=6AFDCDFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlopsBounceXR", "keywords": ["casual", "PhysicsGame", "XRGameplay"], "long_description": "XR BLOPSBounce is a vibrant physics puzzle experience built for fast, satisfying play. Each level is a unique 3D arena where your goal is simple: place panels, launch Blops, and create the perfect chain reaction.\n\nAs Blops bounce, slide, and collide through the arena, you earn currency, unlock upgrades, and access new challenges. Every arena introduces new layouts and interactions, pushing you to experiment with timing, placement, and strategy.\n\nStart with basic cubes, then progress through increasingly complex shapes and structures \u2014 with new levels added regularly to keep the experience fresh.\n\nDesigned for quick sessions, intuitive controls, and endless replay value, XR BLOPSBounce turns simple physics into addictive fun.\n\nBounce smart. Bounce fast. Bounce everywhere.", "short_description": "Bounce your Blops through shifting 3D arenas. Place panels, trigger reactions, and unlock new levels in this fast, fun, physics-based XR puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/blopsbouncexr/privacy-police.html"
: "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_902280349342148_6518079760688740189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODxiwRsszwEQ7kNvwE5k2YM&_nc_oc=AdqLc1txQ_l7ru38i9DDyySOkKzYYEaglmtck0qvgx06nnjrStguy1bmwAHXxftJggs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ_vsDAZijCe5YNZbAFwyRiGbU2oyh7UVyU37d0DGQUA&oe=6AAFE155"}]}, "id": "1514996536386731", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1.png", "id": "28429888769957349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_28429888796624013_739819007398586056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axQXKHuEx0wQ7kNvwE9GbTL&_nc_oc=AdqbF33GDsr6Vyfgy_GmMDaGX5-ROCmllTxWgLGlK2behXBmZEpbjTOnyMllBPNp8K8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnaZZ4nAP3dQzfuCeTXPVOz8sXE0zdycwPGHaI36ex_w&oe=6AAFFAE1"}, {"file_name": "screenshot-2.png", "id": "3494631380718359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_3494631384051692_6740257873300724700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmWMptriGT8Q7kNvwGUCp-Y&_nc_oc=AdrszF57sfSTObmZ5fcZ0Ii2PqzVqBiticZ7AN0FXitdFcIkWJZkdG-7pvh7N9nJ_5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkQNE_7KGHnKdp_pISa0OaVwZr9pOWsLbk19OhjWGdTg&oe=6AAFE358"}, {"file_name": "Bildschirmfoto 2026-09-07 um 14.22.45.png", "id": "2050246335662136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2050246342328802_4563525123913048679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFjdCZ4mYecQ7kNvwGpGvjM&_nc_oc=AdoqYGa3I6JwcTnTo7W92RLEYcl-RrAKQ1X1WbIRCY2NKMmN67Ac5TPEpgpwPbddvrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFITqg1zI6MYK6xE9tbQXSR_yr9Ye03_R7Km1O_sHydw&oe=6AAFE87B"}, {"file_name": "Bildschirmfoto 2026-09-07 um 14.23.05.png", "id": "1580229070228412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1580229073561745_4123546752174156444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDZYvztNJKEQ7kNvwFnMI9i&_nc_oc=AdrkTF13xjtIVNZjVSiigWwEvgnsqVDEgXR8zax-sVj4Mbm8SI_ZtJ5WIhZqYGc3mzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2-6X4j8LZgwnoxf59JQBxxeaWKXPoXnvIYrwH9k8SmA&oe=6AAFF73A"}, {"file_name": "Bildschirmfoto 2026-09-07 um 14.23.32.png", "id": "4451716808430818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_4451716815097484_3681828468398160158_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loVT-HUva4QQ7kNvwGdPrlf&_nc_oc=AdppecaOIjB0ah2eeHHM5j1ymoU8rCEUzr29UMVeYUyg0Wt1_9JSWzJyMajt8AxOu8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0q-bU9XiH99n4vpxYHe5TBhhxqxcPIaPkoiYTNAvQIw&oe=6AAFF048"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FeAR-Relief", "keywords": ["spider", "phobia", "arachnophobia", "exposure", "fear"], "long_description": "FeAR-Relief lets you practise facing spiders at your own pace, in your own living room. The app detects the floor, walls and furniture of your room and lets virtual spiders walk where you place them: on the floor, up the wall, across the ceiling. You set the pace.\n\nFour difficulty levels. From a single small, slow spider to several larger, faster ones that also climb walls and ceiling. Each level is designed to challenge without overwhelming.\n\nYou stay in control. Choose the level and the number of spiders (1 to 4), place them with a glance and a button press, and end the session at any time from the menu.\n\nReal room, real presence. Because the spiders move through your own space, over your furniture and along your walls, the experience is far closer to reality than any screen.\n\nImportant: FeAR-Relief is a self-guided practice tool for people who want to get used to spiders gradually. It is not a medical product, does not provide therapy, diagnosis or treatment, and is not a substitute for professional help. If you are in treatment, talk to your therapist before using it. Requires Space Setup on Quest 3 or Quest 3S. The app interface is in German. No accounts, no ads, no personal data collected.", "short_description": "Face your fear of spiders step by step, in your own room. FeAR-Relief scans your floor, walls and furniture and lets lifelike virtual spiders walk exactly where you place them. Four difficulty levels, one to four spiders, and you can stop at any time. A self-guided practice tool, not a medical product. Mixed reality on Quest 3 and Quest 3S. App interface in German."}, {"images": {"nodes": []}, "id": "1062471166558086", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FeAR-Relief", "keywords": ["Spinne", "Phobie", "Spinnenangst", "Angst", "Exposition"], "long_description": "Mit FeAR-Relief \u00fcbst du in deinem eigenen Tempo, dich Spinnen zu n\u00e4hern \u2013 in deinem eigenen Wohnzimmer. Die App erkennt Boden, W\u00e4nde und M\u00f6bel deines Raums und l\u00e4sst virtuelle Spinnen dort laufen, wo du sie platzierst \u2013 auf dem Boden, an der Wand, an der Decke. Du bestimmst das Tempo.\n\nVier Schwierigkeitsstufen. Von einer einzelnen kleinen, langsamen Spinne bis zu mehreren gr\u00f6\u00dferen, schnelleren Tieren, die auch W\u00e4nde und Decke nutzen. Jede Stufe fordert, ohne zu \u00fcberfordern.\n\nDu hast die Kontrolle. W\u00e4hle Stufe und Anzahl der Spinnen (1 bis 4), platziere sie mit einem Blick und einem Tastendruck und beende die Sitzung jederzeit \u00fcber das Men\u00fc.\n\nEchter Raum, echte Pr\u00e4senz. Weil sich die Spinnen in deinem eigenen Raum bewegen \u2013 \u00fcber deine M\u00f6bel, an deinen W\u00e4nden \u2013 ist die Erfahrung viel n\u00e4her an der Realit\u00e4t als am Bildschirm.\n\nWichtig: FeAR-Relief ist ein \u00dcbungs-Tool zur Selbstanwendung f\u00fcr alle, die sich Schritt f\u00fcr Schritt an Spinnen gew\u00f6hnen m\u00f6chten. Es ist kein Medizinprodukt, bietet keine Therapie, Diagnose oder Behandlung und ersetzt keine professionelle Hilfe. Wenn du in Behandlung bist, sprich vor der Nutzung mit deiner Therapeutin oder deinem Therapeuten. Erfordert eine Raumerfassung auf Quest 3 oder Quest 3S. Keine Konten, keine Werbung, keine Erhebung personenbezogener Daten.", "short_description": "Stell dich deiner Spinnenangst Schritt f\u00fcr Schritt \u2013 in deinem eigenen Raum. FeAR-Relief erkennt Boden, W\u00e4nde und M\u00f6bel und l\u00e4sst realistische virtuelle Spinnen genau dort laufen, wo du sie platzierst. Vier Schwierigkeitsstufen, ein bis vier Spinnen, jederzeit abbrechbar. Ein \u00dcbungs-Tool zur Selbstanwendung, kein Medizinprodukt. Mixed Reality auf Quest 3 und Quest 3S."}]}, "developer_name": "IT-Bloemer", "developer_privacy_policy_url": "https://it-bloemer.de/fear-relief/datenschutz.html", "developer_terms_of_service_url": null, "publisher_name": "IT-Bloemer", "support_website_url": "https://it-bloemer.de/fear-relief/#support", "website_url": "https://it-bloemer.de/fear-relief/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25183384091298134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827585_1092356716582545_3216484841618652718_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb6t1WNmqAQQ7kNvwFrlm3g&_nc_oc=Adrv6zb0_biozUkXT17rSp7m4YVjgjdsC99UEQbyeH6MX-XzQ8lbM8qdBP79
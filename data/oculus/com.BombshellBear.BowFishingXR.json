Q7kNvwGcltg6&_nc_oc=AdrgEQAASySETZhP2I4LFHXVOBZcKvkX7Xk02KIxerMltC4i-XwgjSc453_-iO3Q5nY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Jwb64AFa6-q6gs0_k4gIDIV66X0RZYOuXTGOHm_uQag&oe=69E22D3F"}, {"file_name": "Screenshot2.png", "id": "2724783697663547", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75234370_2724783700996880_7255601280408197370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zw1R4IEPqoQ7kNvwGqkq6Q&_nc_oc=AdoWzHvUbGCvzvnDhVQykBS5x3cFD0eGnQuhuDFcDfQ3027Ldmq-j8PdwNDbnCNj9X4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H4__tUJyX4BsF3rqo1hl1qdq8525JS2sNBnWWsXHX9A&oe=69E22409"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowfishing Excursions", "keywords": [], "long_description": "Hey! Have you ever heard of a bowfishing VR video game? It's a game where you can experience the thrill of bowfishing from the comfort of your own home.\nThis app offers a unique perspective on a sport that is gaining rapid popularity.\nThe graphics are stunningly realistic, and the game's physics engine makes you feel like you're really on the water.\nIt's a great way to experience the excitement of bowfishing without leaving your house! This new bowfishing VR will continue its progression by undergoing some promising updates and improvements.\nThis app is already amazing, but the developers are working hard to make it even better.", "short_description": "Welcome to the world of bowfishing VR edition! Here your skills will be put to the test as you traverse through the different elements of bowfishing.\n\nTo start your journey, begin with the boat and learn the mechanics of properly maneuvering the vessel to best suit the player's needs.\n\nFinally, the player must master the bow. To trace its shots and aim accordingly to successfully harvest those fish!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1NSO7LkRQTdot6PI6ChWsizScNpbYLneUcUjQOVKz
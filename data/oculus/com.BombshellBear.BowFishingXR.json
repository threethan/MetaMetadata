eenshot3.png", "id": "1060101408285618", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031582_1060101414952284_7176465252047409837_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKdT6SevYdYQ7kNvwGYVn57&_nc_oc=AdqYvZPGIrxh58BFcklfRD2etSfUnhiMmj7v2W75_phP-qMYB5yoT8tWbCrYCSsmGM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmlqRdkG2OoyFNynJtJ41Fbb2G0klcKGMDhK6DkJ05sQ&oe=6AFF08D9"}, {"file_name": "Screenshot5.png", "id": "1709505399490380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_1709505402823713_5281529742145109004_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP-OWljE4dsQ7kNvwEWz4oc&_nc_oc=AdoeiJIzEbWdJPqwGOaTe-UMUEoP5VYswLpQlzqj50VIDoLiesQVlqtye7HVKcF6zzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcqITya5evwxzMWoq6B6NpmH99YqxR-XRQGoIO5UXNaQ&oe=6AFF2297"}, {"file_name": "Screenshot6.png", "id": "961389701563433", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003238_961389708230099_3379996920228129676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmPVfMk7rf4Q7kNvwF7TU3a&_nc_oc=AdrWzjKWVji74QN9hTgEsndFyy-24sFZBMh3GT4r058FyhfA2VowtpKXwQpH_5jDysQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsqrvrv_UKd4HB6inXZOYS5NJWkbFgfwZPv6-rdze67w&oe=6AFF297F"}, {"file_name": "Screenshot2.png", "id": "2724783697663547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234370_2724783700996880_7255601280408197370_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU9HGO8s_KwQ7kNvwGuuNKl&_nc_oc=AdqYUcd4GRoJpwWl5633kQ6y7P3qUsKU8qFOvI8j93nRO5yrIy6FG-71LwhL3rJwlBw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO-Hqjgxb-tOouyYOGfFDOUCNRht56bzXKhy6znnlywQ&oe=6AFF2049"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowfishing Excursions", "keywords": [], "long_description": "Hey! Have you ever heard of a bowfishing VR video game? It's a game where you can experience the thrill of bowfishing from the comfort of your own home.\nThis app offers a unique perspective on a sport that is gaining rapid popularity.\nThe graphics are stunningly realistic, and the game's physics engine makes you feel like you're really on the water.\nIt's a great way to experience the excitement of bowfishing without leaving your house! This new bowfishing VR will continue its progression by undergoing some promising updates and improvements.\nThis app is already amazing, but the developers are working hard to make it even better.", "short_description": "Welcome to the world of bowfishing VR edition! Here your skills will be put to the test as you traverse through the different elements of bowfishing.\n\nTo start your journey, begin with the boat and learn the mechanics of properly maneuvering the vessel to best suit the player's needs.\n\nFinally, the player must master the bow. To trace its shots and aim accordingly to successfully harvest those fish!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1NSO7LkRQTdot6PI6ChWsizScNpbYLneUcUjQOVKzM8A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bomb Shell Bear Inc.", "support_website_url": null, "website_url": "https://bowfishingexcursionsvrapp.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "R
7kNvwHG5IFU&_nc_oc=AdogX_YCy3IQD6THKfnjniUipN1XNTzqr10SwAIdu4CMi8RyfUHsl4MWAvZdAUubgCY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cwVIOldh5p7wPHS5V4mcG8GNPfwEbZmwZDvKonyVwpg&oe=6A0F17D9"}, {"file_name": "Screenshot5.png", "id": "1709505399490380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031538_1709505402823713_5281529742145109004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmujxBfEO2AQ7kNvwHyceLT&_nc_oc=Adqi5RfIOO-5Uwhz1Gbr2K9rf7YoTNeMjomvarfgF8Tv7VC8Irl8CzvwZ6-Ec0HyLaw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jBHUfS33hpjXzw3B42p0Av6aagUtJ1Y65grrVOEtIxw&oe=6A0EF957"}, {"file_name": "Screenshot6.png", "id": "961389701563433", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003238_961389708230099_3379996920228129676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78CuF1C80r8Q7kNvwFoqSVD&_nc_oc=AdpEEQ38CZSAZvM2jW2uhqsF0XZXmSSSGdNtntR-hY8u8uQtTIhqjGlfaLClNmX-oTg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ee9QIVGjbONYMvQjHwpVlRdt0SZJxE1MFDfa3jO0P7A&oe=6A0F003F"}, {"file_name": "Screenshot2.png", "id": "2724783697663547", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234370_2724783700996880_7255601280408197370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTuTiYDm5-IQ7kNvwFmKQXl&_nc_oc=AdpUimlGMRU9oz162Arv16XGGvoqGthatCIte9GXk7jcpUzneiAQaTvutWPTpak40BA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jSBrgcMFy0efkwwXj-N5fG9bYkojnJaeYepEyQlKZFA&oe=6A0EF709"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowfishing Excursions", "keywords": [], "long_description": "Hey! Have you ever heard of a bowfishing VR video game? It's a game where you can experience the thrill of bowfishing from the comfort of your own home.\nThis app offers a unique perspective on a sport that is gaining rapid popularity.\nThe graphics are stunningly realistic, and the game's physics engine makes you feel like you're really on the water.\nIt's a great way to experience the excitement of bowfishing without leaving your house! This new bowfishing VR will continue its progression by undergoing some promising updates and improvements.\nThis app is already amazing, but the developers are working hard to make it even better.", "short_description": "Welcome to the world of bowfishing VR edition! Here your skills will be put to the test as you traverse through the different elements of bowfishing.\n\nTo start your journey, begin with the boat and learn the mechanics of properly maneuvering the vessel to best suit the player's needs.\n\nFinally, the player must master the bow. To trace its shots and aim accordingly to successfully harvest those fish!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1NSO7LkRQTdot6PI6ChWsizScNpbYLneUcUjQOVKzM8A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bomb Shell Bear Inc.", "support_website_url": null, "website_url": "https://bowfishingexcursionsvrapp.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1449752685850293"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031643_716115276935991_4123330346357119761_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=
7kNvwGYv4En&_nc_oc=Adr1SZJ8jjrSswEHY2VZH4GPNNrr4Zio2cTft0fuO1Yco5QGpmZocZTP9WqJk1nFnw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j60ws81f9tYOzyMEPSH_WOMEDU50U3fV8UyHNWwVqJQ&oe=6A3E8DD9"}, {"file_name": "Screenshot5.png", "id": "1709505399490380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_1709505402823713_5281529742145109004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVjalHW1ragQ7kNvwG495hl&_nc_oc=AdqYopubrFdfzBeoY6juxyELU-9JJDqGdi3y759x7_2JMKjIRjedcM6lVtZVIhA_YDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r3nY8jE5vUxJKVtO3o8Tf4n4OWeYJzBayg18NgEj5pw&oe=6A3EA797"}, {"file_name": "Screenshot6.png", "id": "961389701563433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003238_961389708230099_3379996920228129676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osyfivY1kD4Q7kNvwGST0GJ&_nc_oc=Adq0brIOmdAhZi_jgmPIDbSQNhWLYATYI_uuC0OU1gyhBU3tgTwBgZj8940kNRXqPrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OPL1Wgo67DW93Mq30LGntAzSRf7xXqe3yeRt-x9tcAw&oe=6A3EAE7F"}, {"file_name": "Screenshot2.png", "id": "2724783697663547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234370_2724783700996880_7255601280408197370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-qjjlaUJAAQ7kNvwGfmfX3&_nc_oc=AdqogPijImmY3M1ef26fRfksNsCaM2sCDfubkpdOx11R0jOBgZ22XYy7I4N58cWRtkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l2IXfkIESZHZBA0pSdrBjOgYswfVY8ShXQ3Z1kypSIg&oe=6A3EA549"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowfishing Excursions", "keywords": [], "long_description": "Hey! Have you ever heard of a bowfishing VR video game? It's a game where you can experience the thrill of bowfishing from the comfort of your own home.\nThis app offers a unique perspective on a sport that is gaining rapid popularity.\nThe graphics are stunningly realistic, and the game's physics engine makes you feel like you're really on the water.\nIt's a great way to experience the excitement of bowfishing without leaving your house! This new bowfishing VR will continue its progression by undergoing some promising updates and improvements.\nThis app is already amazing, but the developers are working hard to make it even better.", "short_description": "Welcome to the world of bowfishing VR edition! Here your skills will be put to the test as you traverse through the different elements of bowfishing.\n\nTo start your journey, begin with the boat and learn the mechanics of properly maneuvering the vessel to best suit the player's needs.\n\nFinally, the player must master the bow. To trace its shots and aim accordingly to successfully harvest those fish!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1NSO7LkRQTdot6PI6ChWsizScNpbYLneUcUjQOVKzM8A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bomb Shell Bear Inc.", "support_website_url": null, "website_url": "https://bowfishingexcursionsvrapp.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1449752685850293"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_716115276935991_4123330346357119761_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=
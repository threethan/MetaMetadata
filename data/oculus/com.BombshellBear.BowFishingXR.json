Q7kNvwEjaHbo&_nc_oc=AdopqGRczOy8M-lauox1dadCsE7yToTS_Q4OAeDLnN3bJQaxFxZcjOtjUhx0wQ0QlqY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW-tzQHuIsiKIP92l3adAqLAqalDnN2T5qBiEY7QURAQ&oe=6A92D63F"}, {"file_name": "Screenshot2.png", "id": "2724783697663547", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75234370_2724783700996880_7255601280408197370_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOE7MHJNCy8Q7kNvwEgz7Mo&_nc_oc=AdolGEHkp--_XGOM0IVoxjB73u7Pm6z05TjoAgr3vh0yLX_H7DbsVqGzRps7Rra0dss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBf7RXgJ_BkDrH9qMVe2UVGhqbG19VdUnfcC8Psk1ZjQ&oe=6A92CD09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowfishing Excursions", "keywords": [], "long_description": "Hey! Have you ever heard of a bowfishing VR video game? It's a game where you can experience the thrill of bowfishing from the comfort of your own home.\nThis app offers a unique perspective on a sport that is gaining rapid popularity.\nThe graphics are stunningly realistic, and the game's physics engine makes you feel like you're really on the water.\nIt's a great way to experience the excitement of bowfishing without leaving your house! This new bowfishing VR will continue its progression by undergoing some promising updates and improvements.\nThis app is already amazing, but the developers are working hard to make it even better.", "short_description": "Welcome to the world of bowfishing VR edition! Here your skills will be put to the test as you traverse through the different elements of bowfishing.\n\nTo start your journey, begin with the boat and learn the mechanics of properly maneuvering the vessel to best suit the player's needs.\n\nFinally, the player must master the bow. To trace its shots and aim accordingly to successfully harvest those fish!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1NSO7LkRQTdot6PI6ChWsizScNpbYLneUcUjQOVKz
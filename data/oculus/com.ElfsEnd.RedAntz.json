LNrdC7EpPk2wx7KRJFOcauSQ&oe=69C6966B"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2478iANzLDMQ7kNvwFg5yPW&_nc_oc=AdqnrraQitTy9BLgjbmqwS5aoG9RQ-AR6aH6uG7BwbL_WC5122KQH_rGHCeNmtxu9UA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhMlp9k5v1zwSBSt4i2_-KG5gdRbFF42WFL9KrY0m3Ig&oe=69C696A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oqya8qPSnFMQ7kNvwFj_l65&_nc_oc=AdosqWcU84wVsP1F7OHARjQ6p8k_tp7Fw1QqgV4AUloysdjz9QLPON5OQNxbYc5D1R8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg6pqMGmPxSBSP9D8EHm2_N2uIe6XyDSrWxaqT8cW1sg&oe=69C69435"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
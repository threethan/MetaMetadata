Ulhlna2rD7sssO-R14EywIng&oe=6A491AEB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRm6bgAgifoQ7kNvwHvUF9Y&_nc_oc=Adr0hAqI8RLBb0g47U8BWpie9nCQjKR91pL1aKDNSoDifYO6POBI8Gc4kdYNMOv5R9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkrVqNBNsQq_FUjU8AElI1pZ6UDPZnfI71YwoD5xa6Lw&oe=6A491B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZlZmpxMKgIQ7kNvwG5qMH7&_nc_oc=Adq0ElyxiBL_vhSA0icL8J3S7s-tNAM_GyTjSvvt5fWAzht0speiYXhohSQOSOw7cfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiX1lKY0k2gdwPmgHutpXsuUTfTPyWhOlCA6Q-T0LuVQ&oe=6A4918B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
nd\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5770593896377061"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5872949976141452", "version": "1.01"}, "id": "1036285134062234", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5770593889710395", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5872949976141452"}, "release_status": "RELEASED"}, "binary_release_channel
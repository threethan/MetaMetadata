kNIU7Ctw07SLvaTY1INSx94A&oe=6AF9C3EB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQMRUiaB1F8Q7kNvwEpLwng&_nc_oc=AdqWB6C2GjL0dVj4Es0JY-hMlZFH_f6L_9b6BFo6Msos0umMPIsGLab5BpVNpb5Y0dU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSei_LJaRVQlCLkOAv1I25sUHxJC6kWJJchCj1y1PcK3g&oe=6AF9C424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gtqnXOVQbEQ7kNvwFYquq4&_nc_oc=AdrFM-1tAcjgx_G-6nGmOHQ6_WlgsYluzwIMPZQ7YRnWq62PGzwaWAhyeh68tS9vllg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpWTNN4vFpXe9Hzsnurud98jNSTdxGvTdzlo0_YLUztA&oe=6AF9C1B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
6vwzyE-CtD5o2GUUuOLbc9Dg&oe=69DE516B"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7igP3khkmqMQ7kNvwEwNWFU&_nc_oc=AdoAydqI6t7Qfz2jZ_YidAoHC2aGmHDkz7b4QBg2-0A-8cJQHl0KiJkCJJLrtXsp_r8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CN5lpAnUlABHgxsO8WD9-M6LySbr9-ZdcI9Gfepf9JA&oe=69DE51A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoabdeankYgQ7kNvwG2_W9E&_nc_oc=AdqypwWuiW4hUm-kCI7sJBNgk2Go9QJtccDN5uZRs1S4TfC7lQ9kzXS11D4uAyw-KiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BS_jcOwcLV1vyZYepKW75jNvRyNRxTiMWvBPCHjZNZQ&oe=69DE4F35"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
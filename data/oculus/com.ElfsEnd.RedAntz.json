-SHkLKtoEtBDzEg4CC_pxOAQ&oe=6AEC94EB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3ptdu8sU7AQ7kNvwE0vwPb&_nc_oc=AdogXqHlgRIN9gpOjacyn323BPQ9ZPEo4-WMfkqJ3ceBQlaN9JXTj7SXIOLtw5oS5_k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThfTUutK42XtqGv0d9LiayvzdEo7vCtzsTm2rLKzfiNQ&oe=6AEC9524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lODVRjWC-YQ7kNvwFIhE_7&_nc_oc=Adrzl0Fx9twNPGTl7465udUtrmWmfnSejGaXlWhb7sRaZdgCiUUf23prPx6wXj_KflQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-0Jf2k1fgDdrXPxVgqzDsKAMma1HuTnusaQzylq9nRQ&oe=6AEC92B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
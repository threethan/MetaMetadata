GEzD5Mf1Ne6McM3j0beQB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv1S2oB-Pi5RvyGtwD8l1hSO9kw7za1DwmwHbFxhE0ysg&oe=69A568E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT8o-gfEVogQ7kNvwH2XTwS&_nc_oc=AdlDdqDbIcp2Q7jv-zdgwxUaOW4j5fhw6f7HUGxOzoD-4b59eutwsRjeJ8kWtQGh58M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvMvmNhZDCffIeigWhrTAnwRvRG7qGKYkmI9IxroiMU1Q&oe=69A59EB5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
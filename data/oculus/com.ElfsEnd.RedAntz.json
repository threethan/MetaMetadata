tCssEFPrxXwh9ugVRQvcbsTA&oe=69C3F36B"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2478iANzLDMQ7kNvwEk8kCq&_nc_oc=AdqgNAKKQhClJ5Hd-YT11_iE0rbXmR_sfVMt7Rtjn8ubmBLr0dRnFcUYWfa2LHDOX8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzl9TSFB5tKTHWL4ow3X2O1Ksab1vMDAZ48pdJOsJnYSA&oe=69C3F3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53dJmEMNnzgQ7kNvwGX3BvJ&_nc_oc=AdqH9s8S7Y1EN_r5t73YG7VSUw4vjkJnnBU8PtguI-EckeO3PBU-qUlD4QtUoI7WFFk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_3Y5VkEor6MbsAkGeDqVZjuFcCduC4AtgM8Z4yw75LQ&oe=69C3F135"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
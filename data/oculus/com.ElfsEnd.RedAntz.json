0GrBAsafJuRJGs7jE2A7A8uA&oe=6A661BEB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJlENiGQSxEQ7kNvwEbqSRT&_nc_oc=AdqSWyJ8j0VRpv-fCwfUi0x9AeDlKz-4t7sCtNN-BQe3b6-RGjOzmeQ13zMzXHj6n54&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOZO_iP9kBHE1fjWeZN6WCxs_6LGRJdgJR086vvzuxQg&oe=6A661C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NX9RqJmwrkQ7kNvwFPkuaT&_nc_oc=AdooZbKZHPjMcjyTsH7KT1telTDjPmfIsBc4l1-l9Zk1prtN3iD-zOsCMEIAoq-y2PU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyboJVt-bwWrHJqESC2xE7eBLgKNQL8QcVWDXeU8aIXw&oe=6A6619B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
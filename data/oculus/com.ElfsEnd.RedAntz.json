0_AQJHC93qCsNauicsPTukrm3W6BzuHD9ah0jFX3aTon1CQA&oe=6AAE9E6B"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woKGmJTyk80Q7kNvwHq7EWI&_nc_oc=AdrwTQAI4i64mxkhkUFoRNUSfcmzr4eLqS73WFnprs6HBtp47PDmpeNcjMNIQM99Dzs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlZACbnXs_8mCX8xqjbvur-GFI3iKBxgP9r_34fK-fgQ&oe=6AAE9EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkjumtvB9yYQ7kNvwE_SdE2&_nc_oc=AdoZISiLzmhf8g_eX3ZifeyLPH6xkktkyfh_yZbOmYU2woScxerCa64NCnXtjTjFnU4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrgfxdRRloVRo4X3JgvHNdDC5f2KLtTfTRouwUf_-TCQ&oe=6AAE9C35"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "con
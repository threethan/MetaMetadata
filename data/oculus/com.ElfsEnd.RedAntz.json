fP789Y-ZiJwkH93VxxXn62MA&oe=69DCFFEB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7igP3khkmqMQ7kNvwEU2Jmb&_nc_oc=Adr19aVi2MA8MMdDhirpF3zk1L0OppyXhvFBYmDT0l9Zyf0JMdFKc9EdPoR1qdhsr5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XmwMuZNZvEP2z78HzIDbUORKZ0ZBj5DegQPp_9jCYTQ&oe=69DD0024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoabdeankYgQ7kNvwFqnfS0&_nc_oc=AdojcvTZ2t4Zm7oxFCiNYLgafFE7xiBmOiPrdbqNzFJuEVoNX8tFZqnLsiMAnu-7LO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m344ZUv4y7CJdakECJPojpl6BSddUXFupx18ddYDaEg&oe=69DCFDB5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
AWjzFyq2I5QePwcFe9tWMp7Q&oe=6AC507EB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lriWQhwHB3YQ7kNvwHy7V34&_nc_oc=AdrDLq2bTyWKql3EA4DpvS191rX_BdEPVsXciRj5LGlQWRHfIDPlQZ0JEB8CMRXH07I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu3kDkjE_-RSrx11zCJ1K093KVIE4uVvKjUZ8ju3L1kg&oe=6AC50824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oKb58C58p4Q7kNvwGdvhGX&_nc_oc=Ado1l6Tc_Y_DN5GAxtD_CDkkhvevIow-gmGrVqXOh5VyaB4aRXISaM8YzTMwJ0wb73o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuBCu-Ia0WSA6wkyTNYgo8fK2aH-bGqJqszs7N-EpMkQ&oe=6AC505B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
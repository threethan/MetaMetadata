FyOtBQSFZI_UInYxadfKm7Tg&oe=6A09D2EB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5qSkxm4tmQQ7kNvwFlU0Pz&_nc_oc=AdrXaEPz1iuGsFij7bfBY0knU86TDtWyjF8Dco4aZur-YPfDz0DKVpgDcbEAm-gBqvM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rztTngRgPaR2eziGOK6Zh0i9wnXVyVXTKSsK_MtS3ow&oe=6A09D324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpKUwKPcD6AQ7kNvwHSI9A7&_nc_oc=AdqrYi98o0PZiJFkrwl1JkmqvEytuHh8WRb9zlNHbuOpcC2M7Y2QxyaEXXtG9guSSog&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42B6qlXVbpMgqvWRqxc3iXX8dElZNK8KpUuE5ahPOdUA&oe=6A09D0B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
b4CXWXHR64GwzjwQRLBjEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs9tpkXuxuC0MfSPWE4TZT6Q4ugIoYgG_UIixqTYUzGuQ&oe=69A44FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6Kjxg56iRcQ7kNvwHIDAWZ&_nc_oc=AdnHFgsBZbgFt8mqOlNSRwwYgnBcl6AJbHrg6FizT_ImFcSRijTeHVs58nAZSaRYDOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuH2HWeesgK_9ce3ChvR7blewoy8ZJFT9rrHUGaHNc0cA&oe=69A44D35"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
B9HETQcsDeXS2AUzBOHMh8IA&oe=6ADF65EB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvlVRU3587oQ7kNvwHZqB8c&_nc_oc=Adqoj9FsQRUEHucuAX9X5SpX7UyA4PI1seNEaT243KNk0nW3ErZO78hEfeutrvhFeN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt6eHMJlNZc-U0Ufg6iX-3vbC84ASxfw2Ms6tV59CXRw&oe=6ADF6624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS_v7kJIY4cQ7kNvwFACIbW&_nc_oc=AdpVtjctkC6EQkX1fwukyxMsFYH_R9PHa8Nu30ZeUnW99Py3e_u8AHLCq8D-5DXsIus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxdNAB-mP95VEsJfBJR71hShAwJ5ziWxMUQIp_sJyT4w&oe=6ADF63B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
TSRE0qNksnojuEou3q3Ce3Yw&oe=69E78BEB"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0twoM9A67nsQ7kNvwHxhbyA&_nc_oc=Adqp5W6uBJLe7Z3K6pYeA9ZaP351ntgyaBfu8nxlNi3Vs7PZ_KnE3fVsrTV6M6Sz_w4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38i_HdfCLyzjosjJtOWKw9YMOawey5wReRp--Ab4gASA&oe=69E78C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhO7NdHd6kUQ7kNvwE6pSJ5&_nc_oc=AdrfcEiCvu1CZlayktGdtXMgJ-wFpe44JD-KiyGE4t-5QbSE2WV9xJARwy8QOeUrg0M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06PMAJZQPyS_0mlL2SJRsoZVXUJsvpbEspOICqPx2HYw&oe=69E789B5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
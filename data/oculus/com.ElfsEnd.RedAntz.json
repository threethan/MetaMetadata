_xbhnqlWzSCRhgZqUUVHZTlQ&oe=6A897C2B"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_b39G5zIswQ7kNvwH4rnEX&_nc_oc=AdqbrApKtrTvvWwKcTeg7esoBev1Xjn0C53swjRUaeiOQIla0ECoO-aR8I0L1KVHk6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGfFvzX9Bg5AupNJdR7lfvNQpd7qyy0nTF4H-oCRcB4A&oe=6A897C64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rMxXHHhn3wQ7kNvwGxDps7&_nc_oc=AdrudynPi5Dckw_fsld59OLdyz-P2m8Cw8fs0fGBIojr2iZlTe_Ey2mBv2kha334IaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ7UepIKshGsc0L-1nm5o-IzC-DB3nAZ39hhj_3BalPQ&oe=6A8979F5"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36
0_AQJd9zKu8pzXU7dA12bxnsEKU95C_F23npSzra_5MvVhFQ&oe=6AA4126B"}, {"file_name": "Screen-5.png", "id": "285204130993151", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566690_285204134326484_7225346090292018698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4RWdJueytwQ7kNvwGpe_UD&_nc_oc=AdrEKtQUlAGTz3M6BmS5P-MIR6QMv2RLnjExYWllSgd7E2TfbzLERhw721HYECkEuE4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLMsCfIm4oXXfEKXXN5_apI3Uwb-rf4lhrSepBbOXrtw&oe=6AA412A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-6.png", "id": "1416541045594302", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974741_1416541048927635_167960599466487752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlsoCzPJ3uQQ7kNvwHUIVZb&_nc_oc=AdrBoUG8pMqPbNidqm1HlEH5gDLs2NgbrpFAlFuCusXYbQNopOpEu8Rzu67z6QJPr7U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRWPUnri7uCjnUHNYvDLd0lG3kaRL4Y7c8y7GXFw4Qkg&oe=6AA41035"}, "display_name": "Red Antz", "keywords": [], "long_description": "Red Antz is an interactive music video for VR, created in collaboration with the experimental punk band Palberta.\n\nImmerse yourself in an alien world bounded by the confounding logic of Palberta\u2019s songwriting. Interact with objects to generate and recompose the band\u2019s song. Discover other sound-makers to perform your own noisy solos. Do a weird dance on the big screen. No one hears the song the same way.\n\n*** This is a short, open-ended experience, without defined goals or endpoint. ***\n\nPut the ants on your body.", "short_description": "Put the ants on your body."}]}, "developer_name": "Elf's End Interactive", "developer_privacy_policy_url": "https://www.elfs-end.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elf's End Interactive", "support_website_url": null, "website_url": "https://www.elfs-end.com/red-antz", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "con
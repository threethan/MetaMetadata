m&_nc_ss=7f20f&oh=00_AQQvFHVsn1hB2mU2aoIiHwCFRYZ5xAMjnihlr-nL1SpIbw&oe=6AF892A0"}, {"file_name": "ChatGPT Image Sep 12, 2026, 07_54_20 PM.png", "id": "959847143072932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_959847146406265_4507371355040277395_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7FYMjlXx40Q7kNvwHIMCDd&_nc_oc=AdqxD9tgi0g6RI6sOzHM0WVTeYr7SR9Db14QDnynALaKz3FZC24z38q6TSTYu8IvHy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiuOMhptmU1afWnJg8v8DhjibclAWmOksDBqRk1ghizg&oe=6AF89852"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pinball VR: Classic Arcade Simulator", "keywords": ["Pinball", "Arcade", "Classic", "Simulator", "Retro"], "long_description": "Step up to the table and experience classic pinball like never before in 3D Pinball VR: Arcade Simulator.\n\nInspired by the simple, addictive computer pinball games many players grew up with, this VR pinball experience brings old-school arcade action into an immersive virtual world.\n\nLaunch the ball, control responsive flippers, hit bumpers and targets, activate bonuses, build multipliers, complete challenges, and keep your run alive as you chase your highest score.\n\nWhether you remember classic 3D pinball from old computers or simply love arcade games and pinball machines, the gameplay is designed to be easy to learn and difficult to master. Every shot can increase your score, trigger a combo, or push you closer to a new personal record.\n\nFeatures:\n\n\u2022 Immersive VR pinball gameplay\n\u2022 Classic 3D pinball and retro arcade feel\n\u2022 Responsive flipper and ball physics\n\u2022 High-score and score-attack gameplay\n\u2022 Combos, bonuses, targets, and challenges\n\u2022 Fast, replayable arcade sessions\n\u2022 Comfortable seated or standing play\n\u2022 Simple controls with instant pick-up-and-play action\n\nRelive the excitement of classic computer pinball, master the table, and see how high you can score in this nostalgic VR arcade simulator.\n", "short_description": "Experience classic 3D pinball in VR! Launch the ball, hit bumpers, trigger combos, complete challenges, and chase high scores in a nostalgic arcade pinball simulator inspired by the classic computer games you grew up playing.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1298706426664953"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1791176892118416"}, {"status": "PUBLISHED", "id": "1105854452385758"}]}, "baseline_offer": {"id": "1105854452385758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1791176892118416"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1299047536630842", "version": "0.1"}, "id": "1811875886618519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applica
/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623179_1150210727693331_7398497877038293939_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_ATVCFfSckQ7kNvwH3tDIO&_nc_oc=Adq41UkezrPStogekOE3oCjd0SlD0TLLxv8BtEHQgT7U_3zbjXvRfCmDs6prhn7kI9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqLJviAjM87vqCJKH04L7xnp6PlH5mzcvRkjoQJThbDg&oe=6AF8A1EB"}, {"file_name": "SS2.png", "id": "1651213106574063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622186_1651213109907396_1723186090025050417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9qVI_TIQEYQ7kNvwEDdSXp&_nc_oc=Adp0j-IpMkr8pAYhmMjJexlGm_xv9fptX3B_9hgBc56OSAfHao-hA1c-Efz7HDjnjIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgHn0W-IxOLZoCDH4TkQjIHZnvWSYecDhcN_LkTo0YQA&oe=6AF88D91"}, {"file_name": "SS4.png", "id": "1054301683901945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1054301687235278_6986386700065940283_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFtEy1qmhEQQ7kNvwEUIj1x&_nc_oc=AdrARuBEkU7GDGnXWzvt7qvNBOqcJDy4mk6960aeXwoIdwf_j5CA5NWd7cTVfj6TrLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-E1sl9p0x4FddS5_W7r03VbUvsie9fpixcSx9ynTUXw&oe=6AF8A32A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pinball VR: Classic Arcade Simulator", "keywords": ["Pinball", "Arcade", "Classic", "Simulator", "Retro"], "long_description": "Step up to the table and experience classic pinball like never before in 3D Pinball VR: Arcade Simulator.\n\nInspired by the simple, addictive computer pinball games many players grew up with, this VR pinball experience brings old-school arcade action into an immersive virtual world.\n\nLaunch the ball, control responsive flippers, hit bumpers and targets, activate bonuses, build multipliers, complete challenges, and keep your run alive as you chase your highest score.\n\nWhether you remember classic 3D pinball from old computers or simply love arcade games and pinball machines, the gameplay is designed to be easy to learn and difficult to master. Every shot can increase your score, trigger a combo, or push you closer to a new personal record.\n\nFeatures:\n\n\u2022 Immersive VR pinball gameplay\n\u2022 Classic 3D pinball and retro arcade feel\n\u2022 Responsive flipper and ball physics\n\u2022 High-score and score-attack gameplay\n\u2022 Combos, bonuses, targets, and challenges\n\u2022 Fast, replayable arcade sessions\n\u2022 Comfortable seated or standing play\n\u2022 Simple controls with instant pick-up-and-play action\n\nRelive the excitement of classic computer pinball, master the table, and see how high you can score in this nostalgic VR arcade simulator.\n", "short_description": "Experience classic 3D pinball in VR! Launch the ball, hit bumpers, trigger combos, complete challenges, and chase high scores in a nostalgic arcade pinball simulator inspired by the classic computer games you grew up playing.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1304059866129609"}, "revie
10722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY_SlB6QiBwQ7kNvwFkTrhr&_nc_oc=Ado9DAUYxULkofIxRKrLYQjounSm2TlC-yR_lOfcn6KZwjI8DGye3SshlPyvUpU2JtU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k85t5btduPZBy6N2wdwcm_eLauruu9gdJIhFkujEGIg&oe=6A3D520D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3xP2rbgGAUQ7kNvwG6ks09&_nc_oc=AdonPJQD0qnI9csrgcfmP8fiJUl7w_qk7NVuYlGvm251jNEeTpRLAyP390VRp-VmnaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v1houiH8ddWLZOChfHwhJnqNKQexD8hd6VsTe1y4cLw&oe=6A3D38FE"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjVlSg9iPd0Q7kNvwEOvAEr&_nc_oc=AdqeFyhsjX6YqssTBzXFevwT8nEuosGwZ0FLr6JYKiKpH0U8tpq21zVpGpN1AHzt3tM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YbBWk0eTDpV6JGwoz-DYOkU94hfWs5_hOlvEfCb5EbQ&oe=6A3D43FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoNRjYRCn74Q7kNvwHPCVgc&_nc_oc=AdqeiNgC3UHKCqBawxCjsqNoHUvWm3amaFO9YjpaEn1LMJFeetx6bWgIwWtZWe6Ra2g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P_LD85POcVqAjHuO0SiAMkSV4WB0Hwuzrk_d1FMGMJw&oe=6A3D3DB8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
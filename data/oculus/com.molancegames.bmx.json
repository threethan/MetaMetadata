1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nf3S_C8n5sQ7kNvwEiWGVP&_nc_oc=Adr93XRlYc-OhJkiW7j_oyy3OEuv7xIZcDMhz6P8lQ6dtmemli7wz6jaNAGxMgkLj6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyeP3LLjMeHh3zNNM5mYh_DvLDxcWHz6NR23vUnUKzNg&oe=6ABFB2B4"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-U4mwf1yu4Q7kNvwGoVmIj&_nc_oc=AdpRuv0H9TGKKisArf3SeAkWSZV-39-81drdXwxKE_3FodJ6EowinCkHG02ZxUqtmRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh4vwrTomObMP7AT0bk_KIipvvmS3DexwFsAGVpoaE5Q&oe=6ABFB457"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qwmpmPKL2MQ7kNvwGnvc3w&_nc_oc=AdrhMgpYVFRq7ZSKRnjWQQUirksFW-Bytm_u-suySTPJHWwiesbvRo-eG4E1Ln_LCvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrgttMXff0emLlTtEvAFTYo6Qid5viT4br-vTp4nCMwA&oe=6ABFD0B6"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8fIfXJq4UoQ7kNvwHip-ff&_nc_oc=AdpHJtdysUBLA2UTU5cqGW1hA4Vw9UbzP5FiS9JdZCtOXJQOtrjATK38EW88EfGmZDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtVLOUqaamnH_skbvXY9RzOIj9inNUm8qdIIhjXDosCQ&oe=6ABFB006"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WROZUkooc6wQ7kNvwGYi0o_&_nc_oc=Adp3DgW8s71R5NVSpcmSUQrFKkLOopCVOr9XGk1Y0gG2OnvlPQIR9SVWTx2hS2XPLps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQRWGW6xRAiJMqB92WujYAp9DHAR0LIGCn2OPSy-R7sA&oe=6ABFD68D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i28bCjO0pqsQ7kNvwHolzi3&_nc_oc=Ado9EQ8ZlsZQT5CPmjEfmggoYLZHudcfqzsBgDZQuTVzqSR8G8_JM23l2-zgj9RLUJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO21ITbci2qoxBEN0tcGxFwUfL_y1VPvhSNu_0-QP0f0A&oe=6ABFBD7E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxpGBeeVrM4Q7kNvwGBjHpQ&_nc_oc=AdplKyg-gyLCC_hSaAupbXYqVQu-j7cu_U88W2z85IZEu0CtehtM_S2o0U6Qc7KIUmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtVOEZodRodJYLK6KdHrA1ubwbdzo2EbsnmzvZD9VVVw&oe=6ABFC87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B97oq_-bYPYQ7kNvwHXONug&_nc_oc=AdrDKaYOystGAzuLA0lm3feiLvAuvcC2j-J7ktrvQX8pAfBnZ_Ujp3eiLkdDWi_LKmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHSIKMPsetQ3j2PSRwWeZ6VH3-faVuHlq-OTKK6Nf15Q&oe=6ABFC238"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
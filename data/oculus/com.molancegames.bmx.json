1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z6EtDEicNIQ7kNvwFZ3Uan&_nc_oc=Adr-1zFrKwn7rquPYagh5l3ZnXAmXwQBiqGcOZmETs-wDzUoiTjaWTiDs7l0AIURuCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElVzS6ECZmQVU6nPIidageZ2NOYBacBXHZ0cqwcmk_4w&oe=6A92DFB4"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43euiUKWlwwQ7kNvwEkRiKz&_nc_oc=Adrtaqnd8n01rHboheP1MktVZzdrhYyl7afdeGg83a3jUlLE_oNjbz54_oeHG_C_uJI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyHePPJkjPqsN0R5owI_5wylDyrQ3DZnh58qBrTAeMpQ&oe=6A92A917"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KLM6cdeFzcQ7kNvwF3MTQt&_nc_oc=AdrewJ53wjQNBJ5nkU4hiiHuC5YQMYwmCXCvuXUCEPwcD18t8JP4iftoOpVoat1IFEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPo-FDxw5-i1pnvnl79ngaE-cPaUjY6g08DIzwt7Isbg&oe=6A92C576"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wN99QdAPmsQ7kNvwHtZ1h3&_nc_oc=AdpTyg9xDUwa9TKcP0fZQfdg-wXL4x3htdujcJ7vJD5RHBz8e5SDWipqmqMzwiNkdkM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkRK8sWBxix2E1z24mKrG1uhaEeYqIQJSRnoPGYV2P7w&oe=6A92DD06"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjoVvb6J6kcQ7kNvwFQ5BRY&_nc_oc=AdrKBkZf0ZrdvOxX7NVsZEAWy7qKmHWLCCAthHcXmy6nG7nodGC1ncyaxIThY2UpaXY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF02jZNphoy40D7763b7CfmpnLy6bPy0CxXsww3DnuAFQ&oe=6A92CB4D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tz6JD72pGYQ7kNvwFL3K5d&_nc_oc=AdrpyejDRRiI0R1V7vr05b0SR5rU28ca-2Va5fRweAun_w6BM9uvMNwn3Jbi3L6MjfA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKyje70rOVx_V94nLv4_G5NV4iqIucGJPq2gn3lVIOpQ&oe=6A92B23E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozhw3phpt4oQ7kNvwEyndZi&_nc_oc=Adqh9Jfr3zUF1tXc-UCGkbgBbiGo5QrxZQZBhd5oYT1obCCX6mha0aEXccUDamKu9fk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1_cKFlXY9vcxO87ht6BdOtp4grzhki8ciqLF3F_-WlA&oe=6A92BD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VshQ2uhbMnYQ7kNvwH4W71b&_nc_oc=Adp96MHwT9m8kJ-5MfDOrBDLSv7f1skRBJw0ZNq8hpney0Yiu2V52j3GP42Qbv8LpWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWy4Qxf63y_OuX2ClzGytKecOqAPqSoHZGUGOmmtu99Q&oe=6A92B6F8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
10722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M2Idg6afI4Q7kNvwEeElkd&_nc_oc=AdpqCsPuE9Xj62hZy2c3xxbi2JT_7__DN7Bva3CdvLxeXZBcH-Av2ocNcDwnDHR0alA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y6zPaILOOjkYjmGijnl2Ss40RJh5Tl5Bq1TQo9yjZdA&oe=6A26E88D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zt_aAFl-U8Q7kNvwG5Nuto&_nc_oc=Ado42FE18jX2rYgjln6m1UljubfRylh4hvbDZaaegX4NFhgZkPbTutpAURixT-NMNHk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86LxumFcP515OuzduJVK-YeFubMj1bYUSg6uYwNq71Yg&oe=6A26CF7E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlLqMppMNEwQ7kNvwGfnanN&_nc_oc=Adq_KV7wkBucv2pMo7XdLRwj2maXPSkwl_x1v9m-7AK2U4CwKh2QMWw_mBaN-8Xfgmo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gRONpZOIfoi-SSNF4xAJnAWbWUR1PABk8wZTGFSxjKw&oe=6A26DA7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl08mOofIyUQ7kNvwEJYTdB&_nc_oc=Adr20plIrXAOspYc49x6rCXkMjpfJyPkCbzts7DBaJYCd2D2bq1goX92UEgVeGd6LlY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RYrxIFzMjHDUK3-5XBiS2Lm9XIPDRg062wnovBbGoAQ&oe=6A26D438"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
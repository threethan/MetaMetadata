=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8xz7Fr7PTkQ7kNvwEkipvp&_nc_oc=AdoEt5w6iinLnjeey-EQK2lUPgojanXLO0J_TjWlQ4PHS-h2wFaUH9fKvt6pepToZV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwFQ4rMSrWjAnGZyDH31QXdDgenqdcuevpPyPbgjGs9Q&oe=6AF88A35"}, {"file_name": "12_arena_fp_backflip_1.png", "id": "1100116489064285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1100116495730951_7938289003721343291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTDQu6ZnnOoQ7kNvwF0b_0U&_nc_oc=AdpsbDLvvjguxBW-8Ariw13mXcaJzVnrc97OEwTucweYXIdNddya_7iG1UdvqQzlkMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx70c76Bro6LtGXIOFcMJ9ti5vd-Ox_V9GWHT7FvKYew&oe=6AF8742E"}, {"file_name": "07_levelgenerator_sideflip_fp_air2.png", "id": "4810206899211972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_4810206902545305_6855690575694918248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wpKnWjUx5IQ7kNvwGvDNUX&_nc_oc=AdqHd_3dYlNjmcxTtNp5m0Au18W1nj0wWK6BcyRDUeo2M-rwn114DpjR8zu3c3wcAmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIt_VurocS1JBIncmir3uia-YbPCWlQlE7ZVOpwdviFQ&oe=6AF89B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shop_customize_flames_neon.png", "id": "895318080214410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_895318083547743_4575220457911898002_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8ULPS85ADMQ7kNvwHERWvI&_nc_oc=AdrrWCltN6swOiKRHMxmCTaO7njx39QUvVm7UIkwBOEf1TYNj4XT5dBIyeJxnexu_VE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcFfNyNvivK-WtpcS3ZOY7nHs7oBnNGub2x0GFyNzIWw&oe=6AF899CC"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Do fun tricks, customize your BMX, explore the skatepark and beat your highscore in Challenge Mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBMVl4kXAmgQ7kNvwHgq1Ci&_nc_oc=AdotN1BBdvmxZk00T-1hjjUGqiHXukKJ05Va4eX50xiSeARIqIwa9Y9PK-qH53qV5rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0Rq3VtePhHGeh-3NgSrljgSsu-fwCX-Rle5AAA2APxg&oe=6AAFE0B4"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TAJmDjNoDUQ7kNvwH3-Ti0&_nc_oc=AdqmakPzn9kLVSCv1bdPhKTRXsHLIBOKqAdhvgqLPNpnOoviZUGmKYa4AfNex1hxXGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ-HaTrVBbdGgmlUhWmhmw7kDOs6hilORC7z6CMOuDOA&oe=6AAFE257"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UojtjSb2PSoQ7kNvwG50FR6&_nc_oc=AdpeyDBdEXsGGD84NJC3F2I_I8_0DSSPTnyKXVDkzGVCuGWWOLRArPVAi_p5LkXDrgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl5E18PkDcZJBKko6qDgkifVEcAAfV7to2i26tw8InaQ&oe=6AAFFEB6"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24XIDulLozIQ7kNvwGDIZFZ&_nc_oc=AdpQWf5OHlkZ0Cz9aT-Gdp2D3y8VxnwrIs4AdeC5FedhNEtB0_C1IOJHIdpgKomS8sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYsfeBh50WyhNeTHYLO4ILebfvSO8LBA4pxr5HcIMsig&oe=6AAFDE06"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkfc1OTL7b8Q7kNvwELPt82&_nc_oc=Adq3hK8uBcBoWbUjEVaHyDSK6VnobDsPmdRQQeR3GOXFq6fCn8thu9MG9lrwWaOmOtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpCbqR_plw0CYoPbeVT73joX3Fq4VhsWZKDnc2lsDmzA&oe=6AB0048D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON1L1eNWGsQQ7kNvwH0Qr-C&_nc_oc=AdqN33ZFKWe-5YzJi3bvKZKrBWQrXA0P21aJzRo52MHCn-M9yLNgozyTk87m0KnR-84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc3XU8cgh38d0mwrkNNF39sdh7o0WEJQgIod_fEzSvPw&oe=6AAFEB7E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvwjSfbvxFIQ7kNvwGqDzWU&_nc_oc=AdqNAiFpluiMJ09aSoFUAfsLKVdrBA0_vB021zaMG_6hx2ig5ebqoIAclCg6DNsRgv4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiX2ACA8gnKuPi1kFAAHdYUzAIFjS6OGXfMLorbm5zgQ&oe=6AAFF67B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg1a-k4PgAwQ7kNvwGro-aG&_nc_oc=Adq8msrs5W1PnmDt1jCqSh3jztPwKfEFGsBI6WEkPM2NSbToLQBDVXYvcROt8ODqjgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9kbcl5N6iNn552fODSSeRXgGOM2fmW-ST45Jz0wPECQ&oe=6AAFF038"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
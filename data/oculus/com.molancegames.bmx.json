10722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq6WGisCGm0Q7kNvwFjvgx1&_nc_oc=AdqG9pIKgbxgNb-1KEJQBAHL8L2lJphB5-kviMZkO4H9hqMx7leCaQG0Va8EyHxA2xg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNA_8kICW-G9_C9zqGVZ0Bc1b-sVds8lvipo__tffu7A&oe=6A80564D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt1fD4A03mkQ7kNvwG0LXGR&_nc_oc=AdrpfFkkN0Br4ScUq2FjN16LtOMkwqB6dNy1qmGFOohQl72_x_flDyu4gNyFx7Spwv8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkpswEdXmZ2hK210ruuY2XBc0AIKRfTkTZcm32hMjTYQ&oe=6A803D3E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAkAwtlLKWIQ7kNvwEjtIx9&_nc_oc=AdrMDANJB2zVV6GNruDcnEjVBySvKO3_p85rsvbo3xpg2xaUiD334tSVRUcO3wGPVAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE92ZJdwNXKc6jEU1Bjauz3K5m7QW0WxpSCOg9dd1t2VQ&oe=6A80483B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSqX8yXUd7UQ7kNvwEIbOTx&_nc_oc=AdqqwiPb4ZQsIbXYAryDXIodXZL5Ey3MDJZo-f7oqRv2Ro452wPdDVulXhWEbV8ZIBk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3RDKBfHefhxJRvhGkLHmjxvU0O6gIuOeXP6BDrdLMKA&oe=6A8041F8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
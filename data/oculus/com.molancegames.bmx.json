=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8xz7Fr7PTkQ7kNvwE3x_yX&_nc_oc=AdqaTTxR6tK28J23bMPVgS_74AoGdoo5EKUrJU-1s3ny-Tx29bJWxQal6Rwoa9_zdoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjlouQ9FoVqXG_S3oJEybG1mFiCyUw1I7GZjLoJcoASA&oe=6AF5E735"}, {"file_name": "12_arena_fp_backflip_1.png", "id": "1100116489064285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1100116495730951_7938289003721343291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2aJjznZM4oQ7kNvwG6k6s4&_nc_oc=AdrUQlUexS1lx1sknAaJq0iJ7QG7ihv1KAdQWKYJjFOCHVNV-upzk6_FhoPfLItX3g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0KpRahscoNf26wI_hLUo1wUC61MnOmIBde4lcTJZsVg&oe=6AF5D12E"}, {"file_name": "07_levelgenerator_sideflip_fp_air2.png", "id": "4810206899211972", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_4810206902545305_6855690575694918248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ5faCAlN9sQ7kNvwE0mw1q&_nc_oc=AdoTOr_04bkUFHshuKb4K1ykNxJAXmvTcbN1FTEc03KldSHXH0qnQaLZt4dbsxe1XGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf1RPBy2kmdNYrfxcCPHIzvLVOx23hNLHPKo6SOLIOlg&oe=6AF5BFF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shop_customize_flames_neon.png", "id": "895318080214410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_895318083547743_4575220457911898002_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcqeVtoOer0Q7kNvwFFF69N&_nc_oc=Adqc1utC6DctyrouTdhUZMRvNUt6TMEQFYOXKgo4xZFdTI9XAzOEpVenywpJFX71hyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj05rNyxYA28U9RarJbw5_n20loQBQoJn7v-2BhhIl4A&oe=6AF5BE8C"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Do fun tricks, customize your BMX, explore the skatepark and beat your highscore in Challenge Mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
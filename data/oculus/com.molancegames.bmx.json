t_lVcHAeHMQ&oe=6AD24478"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX", "keywords": ["Bycicle", "Stunts", "Bmx", "Simulator", "Action"], "long_description": "BMX invites players into a lively stadium where realistic physics make every jump, spin, and landing feel weighty and satisfying. Each movement carries a sense of momentum and presence, giving the world a tangible, responsive feeling. The stadium itself hums with energy, a place to explore, experiment, and enjoy the pure act of riding. There\u2019s a quiet joy in the way the bike interacts with the environment, the subtle shifts in balance, the rise and fall of each leap, and the sensation of landing with precision. Every session is an opportunity to move through the space at your own pace, to appreciate the design of the world around you, and to find moments of unexpected delight in the simple, unhurried rhythm of riding.", "short_description": "BMX puts you in a vibrant stadium where realistic physics make every jump, spin, and landing feel weighty and satisfying. It\u2019s all about finding your flow, and pulling off clean tricks just for the pure fun of it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
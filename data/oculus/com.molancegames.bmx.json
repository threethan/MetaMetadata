=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgqN6c3xtRUQ7kNvwHsUPr7&_nc_oc=Adq-XN-YgkIikodnbVZFwG1YubJNLTppveALr9ptNXxM1ZF67Z4Dsf5199wP7hUwwd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKqqPhqEcDFD_a8wHnIfK_3sPrGO6UECZnWZcLEvDVoA&oe=6AF495B5"}, {"file_name": "12_arena_fp_backflip_1.png", "id": "1100116489064285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1100116495730951_7938289003721343291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2aJjznZM4oQ7kNvwGskTT8&_nc_oc=AdqhNJcX6XBnGVa9rpnjS_h2wACfu46MseCT52u4PUDagPsYJTbZsjMV-F7o6Evt4v4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzhKTKfqhHwYM6wRTDIltl0xWPWrWhz3yQvA9LRcveVg&oe=6AF47FAE"}, {"file_name": "07_levelgenerator_sideflip_fp_air2.png", "id": "4810206899211972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_4810206902545305_6855690575694918248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ5faCAlN9sQ7kNvwHIfNup&_nc_oc=AdqmIMQF4bx4cnSRcrOMGNtyb8zTSOmk5jBzbfDWH6XdWrGil84DoowIH62dmwAHJrA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNrkftwLT-mEQUxn1YDy06plS3mBTjvsQrZ9nmvI8iMg&oe=6AF46E72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shop_customize_flames_neon.png", "id": "895318080214410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_895318083547743_4575220457911898002_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcqeVtoOer0Q7kNvwE_K3Ey&_nc_oc=Adoj5mPAOeEgmqgT97GK9gvdw88bANna-fomnERRC0Q_kHxi-ECryyUfdZ_Za6rnE1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj1I148_e0j5LfM_SBjBEH5DuNCtALu4nkuNkIHqE6jw&oe=6AF4A54C"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Do fun tricks, customize your BMX, explore the skatepark and beat your highscore in Challenge Mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8yb8w3cXRkQ7kNvwGT-DaV&_nc_oc=Adr9AT6BlMgwim7Z36FXK6RNziOH-AWmiYGCQ-u0XR2joC6eHHaS6alx0ZtSABAU2PY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUj5BxTnujq04pk5ea9-cJQOXNRMR_jATS6y_cEF6nKQ&oe=6AAD3DB4"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTJUgRrvTocQ7kNvwFEP9j9&_nc_oc=AdrE06ZUH_VlicJJqz1I66e1Epu99wEYFA3E4dQqUWfWYHB_2oLzfLYoq21UuFcGGQY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUx973aPl2K1pPFaK7tPbX4tq6_vbq5_EKA86a63S1Dw&oe=6AAD3F57"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UojtjSb2PSoQ7kNvwE4B-pR&_nc_oc=AdrMrbnnkOtwf8F1ng9wi0ntOXeSSx3NHZe8gczKWW8xRYkEnfCNvvPiJjJ7110VFBQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpbqihGkufoSVgtEU3ZIXnaoSR3JNm2AOFrz_k-APKyw&oe=6AAD5BB6"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCrb7xhYpxMQ7kNvwHZHTt2&_nc_oc=AdqtxdvQAfzPD74vSwLJFL_eP1R3bi-2yJwtFCOP-7bcwxrd2fabCNvLH6Zxk7I9I9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSsuJxwtJFhPyuyuKLHz-dg1CEiF9GEgza_YjmjRwhGg&oe=6AAD3B06"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3cZzHPOqLsQ7kNvwERTiAx&_nc_oc=AdrzZu-9jHGwpQixgSQcu7vsaMslaH9YAocBPezKMBrGfxcY12lATISCw_M0DrUiIhQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKH8GgaPkiQstSh6O0_WdZH6Fz4n4hmDG33vWIUg2u1g&oe=6AAD618D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON1L1eNWGsQQ7kNvwEzaKcH&_nc_oc=Adrrzkx8zLA0U2uAY7hWil-uWAnD9Xs3rsmNMsjwT7GH1wB5d71AdAajd8WrTOZ9KZ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTS84WA4Qpz2_jnd0HkuVELiUmk-hJvq8KftWnJp-K1A&oe=6AAD487E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvwjSfbvxFIQ7kNvwGj-4bs&_nc_oc=Adq6js8kgOmv-jPP5ljwPbZRhkRmDpI42btRc2twlo1cZgVBBiEJPaA3bkvwCVgCFYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLreNVgDS6RW9b5js80EqbBtnee8RMEuOB_v4koJzfHqg&oe=6AAD537B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trJjyddURdMQ7kNvwF28FUG&_nc_oc=AdqhenA4ZWStwSJ7l5HFAfx7j6kLIOMpzx1Dd_AjhAbVYXRxKSJY-koRFh7Z2VsiRj4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9KdaX9HF9DUVSUpVpP02RJjZ_NFuAPr9GgDmgyNv37A&oe=6AAD4D38"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
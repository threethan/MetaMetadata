810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KyOR5p2GVAQ7kNvwG662IZ&_nc_oc=Adqn8XIeYIIxQlER0iC9B70PICSWPUc1LPLlNLaHyxyksqOh2e4-HhlUL02MP6S9DGk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWfmQYFsdMtcGw8oVM2mHTn-0sQKqpyzLTky4EHHboIw&oe=6A8AE24D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_X0TruALvcQ7kNvwFJJO9F&_nc_oc=Adr_8jwf8_uPwMBcad95L6SbfMBYYF6SjdATuS8pismWT-J_OF6mwro5QWqz0i0qcj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWIgplsvAlBuSt9w2G2CriIHYZbpxDHIUO5ZEqXw_vog&oe=6A8AC93E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeHHnQ7Mw0gQ7kNvwHg1Kyg&_nc_oc=AdpeBAemj981O6WG_TmfP-99OHFPrBkVDn8OlSulwYFUm6U5KbZF37Vk0kotLQNgYuA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcfyXePLToJg_gNOsx8A1azDXfNcZMNvdj0MqkfRC9EQ&oe=6A8AD43B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLganF6hfV8Q7kNvwG-2Vf1&_nc_oc=AdqmIU_ooPvI3whNBbCeuRTN-dXxdKtNRQ5cCzLs_Nswn_DrYG9W5Bsf_jimVqkklOo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgTDwaQZdRxWSbhKA6uqdgav_afV7_5MhhYIPNZqpD1g&oe=6A8ACDF8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
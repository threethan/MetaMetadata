1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nf3S_C8n5sQ7kNvwHN8AdS&_nc_oc=AdpMNG4Eq8gcWcoB81f493fQWbv8ze6RmnXP9dxSQ9RqWEOFGvMOEOeJW8phfc0Zl_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOd_lCy17so89BumTVUjE3Lj3QzUJxueFmx2698sN-_g&oe=6AC10434"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-U4mwf1yu4Q7kNvwHOSwc1&_nc_oc=Ado7uZFJfIN-O3vmh5obVSqhqbXt4IRCo605u0mFzZG2j6kSC7422FOWWCODq-pREus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMTkD2HRFyQB95ARUyRSVnAT3qFvBPCpftBS_uLR900g&oe=6AC105D7"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XptZUNPPIosQ7kNvwFu-s-q&_nc_oc=Adoa6YiDDQ13ztGFL6t1L-C4UpNlOvx4wl8JIR-QeUknlk93_bi2imceitZ_CRaQbEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuhfZ-X4F1yzWmlAYSU0LKxDIHzzCHPsrPcH03aEzVLA&oe=6AC12236"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8fIfXJq4UoQ7kNvwG8GAxM&_nc_oc=AdpNZgiSSVzPAHOef4HwWQDpcMYQXh75QqzS1ZpUAZj_AUqbdTuZkW9hec7bg1u6BY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNjRzk3zh_pd702uF0i3G3IaiEOLucNonvhUYiVpflPQ&oe=6AC10186"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WROZUkooc6wQ7kNvwEH5GwY&_nc_oc=Adolu41l1ATmdLx0JDwGqU4ndSMeim4UHW6098H4hyraMIVG7Wb4ZJ4hHwM9fuEmtXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPUjISsI0OMRV52B78zeUNOhSLm1PoBteVNca4lBoP5Q&oe=6AC1280D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcIH5NM6IgcQ7kNvwGnoEBr&_nc_oc=AdqFn9kH3_rcK1NJsqdjzMwXZLsYayoiIHtwfNneCeS4rLV7iWODyy8PnMaMZ10d2tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP04uv6v5CCbWwczJ9aM5STg0rUTDb4HgYFHfeBZ5qFmw&oe=6AC10EFE"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thihqpq8NzoQ7kNvwE2BpDJ&_nc_oc=Adr6J3IESF6Vz-DyQzoSz6OkzFlP-0ov9Sctqd9ANp0SqPldn51CyHpHEJLm6AI2Fnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPxwcydV7Q3DDHk-yoleQt35NT8QFDZjutbxLZfFOoYw&oe=6AC119FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B97oq_-bYPYQ7kNvwGWy2t5&_nc_oc=Adpsj7nAazeKQMuIRDgRA_r5QxJC-i2pVM7RU02URYc-j3n_4D9JonatT7I4z4UeyOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSZY1QZ74l_QXqBetYwMqCGAlArueoVxO3z9KtWA3A4Q&oe=6AC113B8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeGWBAtPEMoQ7kNvwG75LZm&_nc_oc=AdoGcnl_uWhC1bvB74f4-J4DLlYIs0uKk_PN5aLdVw6rzhtxuaZd-_ySAPEIrghiqss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ91D81MfjO2hHZEuolvPL4c1TRB3Dw1fQzOyHv7yQvZQ&oe=6ABBBE34"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URalt86iFoQQ7kNvwEg-OMU&_nc_oc=AdrpvwA-pMhmKktjUzjS1ldmtd0_2crrx2HsR55jS6FcCM_Z6yXnUS6Wj1qJs3Ch-YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR4bmCAhp3IT4-6HH8R-0w-zBDloUbu6VK2HM4J2uCng&oe=6ABBBFD7"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQQA46osLl0Q7kNvwH026C_&_nc_oc=AdpLU3CPvbX5zxJMsBs_eieAsxDflBx1LSEseg_GhPYbiDVLbAaEZNXl97WGiOSmHeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtHHprWhwpR7nnIApQ-CV2GQUbJpmqfVyr8Y0993ZIIA&oe=6ABBDC36"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_72ZbPpbcP8Q7kNvwGaM8wj&_nc_oc=AdrVInkF_VGG2t54fuHs0XUwGX3vjZEykEaekAu7INOjfYqR_hMjM9zuD8Q3PlGJ9gI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz7Rfxg5Kd8X5wlyhLyp6wh12nnW7qCLsE22AEgcr7DQ&oe=6ABBBB86"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhTcEsvEbPYQ7kNvwG2ohBP&_nc_oc=Ado5inToBxtSf3PY6Nxi5Ea8fXLlPsRIb9P6d9HUGJ8EThiVao5oaOEPi467V_zkCEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFRRj3z2oyDvOoClm2QGsfd-2GZ-BaTb6sWGIRtmMkFA&oe=6ABBE20D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32McqJpxXrYQ7kNvwErsJYu&_nc_oc=AdrKH1HRoWB1wPX9lqE3cLyv9EXX377ym2VmsMXuT3Se4xh_qgNfHazk8ME5RmodcDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeuiCI3hYJVNDzNEv37bslVW2f0rA2nXVAdkozoeTD3w&oe=6ABBC8FE"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaiG8tc8S58Q7kNvwHcUQsK&_nc_oc=AdqLm0zNCg2bQ26aOo7waAQ08wERHd4b2d6e1zWA-M-Gvwf8cNqB3ia2eONqg81qFYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_FZrB66qNS2RvdIoluF8pSyCjS5OwFVJWZjYiqWMSog&oe=6ABBD3FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XAF0jU1MbUQ7kNvwGxoXpv&_nc_oc=AdpRE4aXtDld7nGQVJcNMu3oxrIjmdr3-I5w6fhaCMBtYU1JRBIBp6n8Iz4oNegvKXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZoj__RY4XVrJHL5tB5nf-sHRa6LBdJsAEaCLgPmKUYg&oe=6ABBCDB8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
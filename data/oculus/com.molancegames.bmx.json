1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z6EtDEicNIQ7kNvwHGTHqJ&_nc_oc=AdpwWuQLQgWQqaKx-PkbP2-dLWGr-vn85lMsYXv5RJjAYazzmZ069_1NPcRMY0IvvdE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTgm7DgvOZLqcox52lJoxKAxxBEz4RQj_R-Bj5Dv-CKg&oe=6A918E34"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toYMxzsad4MQ7kNvwHsiLxN&_nc_oc=AdoN6ei2fasXoTW7RFZZjzvuST4k9WPKFBdlk7g5Apa-AxHeppdExumzJM7nzl_Pe3w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3xNMZ10a1uOZ7LWUuLykfR7EkvkHalHnQ8s0O0HLwqg&oe=6A918FD7"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KLM6cdeFzcQ7kNvwGAtwpV&_nc_oc=Adr7OhoG2Ivw64YfeR_yV0KlBoJ9qSi5dDfitoi56MEcRhURLCaXFJoEfmMBe7z7MSE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1hzrHoUKDy4K71MlVlV62FUdmOnUN1nK_VMnyGh6RjQ&oe=6A9173F6"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLHvO2_U_SsQ7kNvwG5xnsX&_nc_oc=AdqyiPoAcPnRoX1G6lDSkd51KSe_cpRNr3eBoEp3hW1_YgSXvj-z-LEFQr3qe-BnGug&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1FA5G5rdunAfjdd4EzCU7HyGtt4b0BSnNHJmWyUKXhQ&oe=6A918B86"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjoVvb6J6kcQ7kNvwGVMPlA&_nc_oc=AdqXEX3qGtxAHhDJlDj2zF3rFQAu8Gwe6XEcUvF_TACUvxOw-gnJqzps9gS_wnrMvU0&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEibGabyUCxiz8JlKXkVJarSRaONFU0-c1-_LO-_s6bw&oe=6A9179CD"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tz6JD72pGYQ7kNvwGs0qiW&_nc_oc=AdrTXrTNALKIHar8pWPZpnMbfZAZwBrenNMEyB9NHc1MOx7zMkSIjneZMnQa6CoKgsk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgacTO-jJ1_tHYjhVikXNzatH4tiRRCO3qlo5hGAiuhQ&oe=6A9160BE"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozhw3phpt4oQ7kNvwHubWd3&_nc_oc=AdqDoE2fhFdaMPqGeB5u4GvlqUaFjYNJNfa1NWQgO8q3pbMh_z-lTNBTguuJUrwfGFQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrkplRzVWlr1T0JlY0m-S8QZEBwAODYg655GqnYfnM6w&oe=6A916BBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMldQtpxH5EQ7kNvwHINy8w&_nc_oc=Adrq6tTTPfmZsnQ8yjAswGOC4kosKEsDiD8cJXsQDxN4XOAxlwCFyUqqpGNznRltuEA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG92Q4CUUp447rgf8QHh-hbUjpjWoOFKwfczPQNJrf5A&oe=6A916578"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
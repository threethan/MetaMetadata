3.png", "id": "982672497681970", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TJDNikCFgQQ7kNvwEV-vRw&_nc_oc=AdrrAKGEHop-1zJAq6-XlwdYaTwFNJ5YrprLMlSD-MzsGs36s24oYXzGc2-MI-SVmfc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfXaZ5t4kYS5p3niuyw6d_4a2F9bcPADPe5sywLOpy5Q&oe=6AC9110D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3Yvi-W3NCcQ7kNvwEi7oqV&_nc_oc=AdoHViNdPrFK44980-InSLzT8mwjTzt_tWm5Ax8LWshtzPXzN1djrwlNou7RnK5Jlms&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWZxFYFL22NkmsYV2yvd6nsaDMQAIB2qmLWXTedY--sw&oe=6AC8F7FE"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sfoHxNB78oQ7kNvwHUP0oX&_nc_oc=Adp2Z-d-YyCmFGDyDRWZ2_uzaD-XEVU29oW7FSWMjJOijG8ssy9TSVHZzfs9_zx_gSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO5MlN3frMFyb2Q7P4jtW81KbgFS8jN8YZlpk9rqTQ1w&oe=6AC902FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvJR51NP41MQ7kNvwH8SEz8&_nc_oc=Ado2-dLa281hmBz4o2DPOTVhR5EeuGliBc1bIG-VFFDWDwrfVSjfxxaRjg8QB6U-8Yo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTgICzC7e5WWnHKT5jrKQymYOGtHiPuDpnJZbbb0Du5w&oe=6AC8FCB8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
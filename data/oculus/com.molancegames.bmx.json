3.png", "id": "982672497681970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAz8dlCRzgYQ7kNvwGlpffl&_nc_oc=AdrbLGkwCJWpCtiD6_fWS9uVcyhX1H7AqpAWKWwSx8B-iggXE5Lps32cUN3ZEYCUWoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpO5-8b0TUJVHQEk7kObOo3jFc1W21KkAXqBmg80khvA&oe=6AC66E0D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9KJZ4DOHG0Q7kNvwHFRrtC&_nc_oc=AdoTz4xNX8fa8km8ZFjxgTDbpZFoCH59PAijRDplXeWrRCvgS5CYtEexdBJ6RmmLpME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS6E2jw1O9_mHI1S7b4pf75hf5JZ9XRmyHyAYWIzDvGQ&oe=6AC654FE"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9SI-LCyaYQQ7kNvwH3QJOX&_nc_oc=AdroyJzu8aa_6Hx-XFsTiw3g3GvZU6qxo8I4cwRLnjvySl55_ZAfhb5xMgX6z5oZBys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtXtzUtW0S5mBec6b1iz377puoO5aJcWft1qo87keWLA&oe=6AC65FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvJR51NP41MQ7kNvwF0hiMt&_nc_oc=Adp2NTr-P3oECauyVsivJ6Fyqev77ccrpHe1UVQQcMDBjHTn33IJaMIK19AY8mGxuoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYER1iaZJNZ7wtUgOYDR0BLL0-4asgx84804cs1SBhYA&oe=6AC659B8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
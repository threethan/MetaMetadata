1.png", "id": "1210862941214273", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824307_1210862944547606_1737297491856343710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZJSsT348cYQ7kNvwEPdWk_&_nc_oc=AdqEfD3cI5qvuBplhQbDkLw5TeHV4TDbh5z2kvSce3cbCJuAYQISbXRWy0GhKZV7ohg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF2iWBlpW2rbnNBbOvu6K7F2uWgru--LjjzJRSq55LqQ&oe=6A881B74"}, {"file_name": "Resizer_17714956863511.png", "id": "944747397897979", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820855_944747401231312_2008561924575602131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO5jvRQRw1EQ7kNvwFepN4w&_nc_oc=AdrMNlflJoq_RRwwJA40niiF89hd9_8MMh7xX_8Switc2SO-vqsYRbXNARenUvd-qeY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPG5sN_faQmsBO8Z8d_ByyYyeU3DHhVdUPaLNJsh4o8A&oe=6A881D17"}]}, "id": "3903667113275174", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1702482070749090", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828028_1702482074082423_5190699778263101159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4CHpZ6fFr4Q7kNvwGjkKQe&_nc_oc=AdogqSF1bgsCdVYuY-XRH2MTxR76E3xb5unxtadwnUNo7ho2iIr1kmauN_LJzsYLXp8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdPib1uE36kZHwXUcD_JG_DE7WFuTk40kXMFl2gzteEg&oe=6A883976"}, {"file_name": "2.png", "id": "1531445731655308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618298_1531445734988641_7869548348049258833_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4AVXbyewwIQ7kNvwHHdcRQ&_nc_oc=AdrAqU2QgSZzADhgqZjFZpKy3xtigGAWELm8viSTEcTtTueZxGSXG4lwGXdQzwDN58s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeoEVYpxNApmYORNvxcBnPciiM88GKpAm46OVimx2Iog&oe=6A885106"}, {"file_name": "3.png", "id": "982672497681970", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823279_982672501015303_2624461810722094702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KyOR5p2GVAQ7kNvwHWvSVY&_nc_oc=AdqlCTR7hftlo2ta4KM2AeZYrb9OBaCPOtXeJofKKTVvD5H5fzDO9V-0-2m2S-iMi4Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELsvCOdasmEFS3jDJUsQrh2Yq4LxbCl8urKfXAMy_Ydw&oe=6A883F4D"}, {"file_name": "4.png", "id": "2391871357957314", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491828028_2391871361290647_7647668589434990447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAq7pJrzhgQQ7kNvwFQlCLb&_nc_oc=AdreXGm7u8mU6BjqkyhLGWLzDvGJp33BY6W1rK7FFVvWTuM8uIWTjQR1Q9kpRiw9So8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdgFYAgeIZzMSnQAUIquiLVFnuASocQ7tYIdE4QNknxQ&oe=6A88263E"}, {"file_name": "5.png", "id": "1424464819712622", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822307_1424464823045955_8571596251178664757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RloS3VzBwpEQ7kNvwHC_5n3&_nc_oc=Ado-6toA5noy_b0W-l5dPh1caLSFN7gNI7GnLUW9dNHkRAE7RsHKHAqiimgz84bBJKs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC6Fdv4_hnnOmo8pKFFq6d2LWUvd3pPoJhokLZEVoM0Q&oe=6A88313B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1407788797770639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620341_1407788804437305_7874046518000179088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRv1Lcz38ggQ7kNvwGu9R_4&_nc_oc=Adot9PrhOxETHCT0DINHHyd71ccHKmS6q6bJ9e1K9D45gI3uNkk1NCA9p2SmzNJDTXo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwon1DXPd29SLzSCl_BcR4TqXEfCLQVuVIAh-robHShA&oe=6A882AF8"}, "display_name": "BMX", "keywords": ["Bmx", "Simulator", "Bicycle", "Bike", "Cycle"], "long_description": "Jump into a stylized BMX experience focused on fun gameplay, creative level design, and satisfying physics. Ride through 67 handcrafted levels filled with ramps, obstacles, and challenging jumps that put your control and timing to the test.\n\nChallenge yourself in a colorful arena-based Challenge Mode where collecting stars becomes a fast-paced test of precision, movement, and momentum. Chase high scores, improve your routes, and try to collect every star without wiping out into a wall two seconds before the finish.\n\nOr take things at your own pace in Free Ride mode with two open maps: a skatepark and an arena. Practice your movement, explore different lines, or simply cruise through the environment while enjoying the smooth and playful riding mechanics.\n\nCustomize your BMX with different color options for the frame, handles, and wheels to create your own style. Whether you want a clean classic look or a bright colorful setup, the choice is yours.\n\nBuilt around intuitive gameplay instead of strict realism, the game is easy to jump into while still offering plenty of challenge as you improve your control, movement, and precision over time.", "short_description": "Ride through 67 BMX levels with fun physics and intuitive controls. Beat your highscore in Challenge Mode, explore two free ride maps, and customize your BMX with unlockable colors for the frame, handles, and wheels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vyo_uKrKbsQ7kNvwGAf0-7&_nc_oc=Adr3mCJQlOTCvc42QJGZgQn_YBd974KNMvvqGtbo0dyYCLfu188zIxT18JO-bNMNAhk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC87DVDMDk-iDG7CoBeegIGspfhk_mxC9JafEmHTOIOkg&oe=6A5F6770"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abjm5SRfANYQ7kNvwEI_AM_&_nc_oc=Adpf6tFpbeMfjmIdKIyl6wOcgNMQjDyo55d-borGD2LkMxD7k9FsaFvYxo4zMQ3Ge5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRV6qX2td2wRBpNPrvdWlLj2xKbWYD2pJ6yLUYE28PCQ&oe=6A5F872D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzXszRNYiv0Q7kNvwHZBctQ&_nc_oc=AdpwwcJ84LdU1fmY4Ua0JsefaSJpVpb6OGLXKWGnvKX2o71GZPo20tKHpYVLOq9zsVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgOuOVr8dCzGpZYOJsnfHULxQCJrEEUaUddKwu6M5q5g&oe=6A5F6EAC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m11tCtK_fuAQ7kNvwEdE8Rm&_nc_oc=AdpV9RRazCuPhvgbzi_CFVRERpHv8WDuQ762mpf1PFOebQ8T9YUBVNrHwOKxm-6vVtM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFz_h4H5-NcatNHt85FkERCP3IK4dwES8CcS1mtwG7mA&oe=6A5F7D5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTgPQoPZZ7UQ7kNvwFdJL29&_nc_oc=AdpddYkodw5EuQ_caqnbBx5OpYDGjNN1xmpf06rpwTPLCpMJbDM3MO4HMqqXWhwJqgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuWzYgOmiHBu1xAId433QecFGEeYoroErFt1XgMubdmg&oe=6A5F5FE4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFzuG4L6V2EQ7kNvwGI0AmK&_nc_oc=Adq2GofTPsrtLUIOVkabRp9qOyXaDgXSftVO5U-Bc-EFAscqfcivRknWmFLCn7CVots&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hK_jQfNiIIrijTvNMg8OwcUciODREKEz5LREyf5CDcA&oe=6A01CCF0"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QN6rfdZX3IQ7kNvwEM4qhq&_nc_oc=AdqpU8NA-n4VM0vSFeJijtzxXTVjFivH5_-H5qGgDxTIKFAYMK8dHeWqSIK5a-b7_kE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45rgKYoZZDhUzxP2y-jDXToz7n6IH2hteh02IiLbm82Q&oe=6A01ECAD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDkOqAbHxKwQ7kNvwGre2vo&_nc_oc=AdqMeeueIyKEJDDmOFRQYMnkZDLBO1q0Gr2_SMIS4A4iLnFQyPHyOQlR8yn_1W2vYOQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66pchgBRTV0hVQA6dE4N3U1a1HhhXHJ3MXMIXWcLTUYQ&oe=6A01D42C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMMGHfUJvkIQ7kNvwHOWkKn&_nc_oc=AdprlJqiHp_GY893CkUkxmpZFXT2ACeaZup9RKPuHgEXdfw63Faplz_5X9CB-GHOfTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ij9iBxx4OttzFk8J6UZU8iCvhz_7PbkkBk6nvwToBdA&oe=6A01E2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtkzJF62niUQ7kNvwFkNJX4&_nc_oc=AdpcdprFFLnLLn1s_d7kplf2J-9MhVmjzFjbYGZKPYVPlUg-TfHr6mcni8phGBTwnlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7El9gKjP7Qi6tuCnw6Ug73Fi-T5LjZpjBgX1c4nWCFTg&oe=6A01C564"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
13333405222_2512720116299333632_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oyvmwSVJPoQ7kNvwEEZUaZ&_nc_oc=AdoazShwjT2hlZ0PnCHou3MEVgH8HpTJSSNi0a_g6YnyQWbPDjPa7xkOrNTZY2QGBcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE09g58oceDrPaRIQL2Eegsl2uOGY4eb6oN5Q83T8RHQ&oe=6AC25B0F"}, {"file_name": "migrated_image.png", "id": "145889513396929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_1903711136535900_2856710528141623296_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcOY8hEuPuYQ7kNvwFcoFWP&_nc_oc=AdorWGl3lRFKIpIAs7CGA6olHEPRst27b5P2eA73R9N41TOtT2tjwnK2d94ibHE8A9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0J6b5ZG9p1tl8gVYuq5SZMfEUeWSf4hZHx3MFrlx-AA&oe=6AC274CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.deepbrain.xyz/chase_n_hunt", "developer_terms_of_service_url": "http://www.deepbrain.xyz/chase_n_hunt", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_h
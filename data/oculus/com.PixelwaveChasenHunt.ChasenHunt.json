QHbiE6XY7IVqnv9iTKsHcE4MC4J8pOkAUHwLENA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfutdOFwj85tl4mKTMy5OdvBJrZr2qqOOepAI9MZl8xEUA&oe=699AF7F0"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot0WETxF1rgQ7kNvwEB9R5K&_nc_oc=AdmSyYpUUtfr3ZY6mwNyQI9dTrStVl9c564DqrdXvXeVPtIfkcIpFFrbJ8xjP57E_ws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftK3H8U_Mk--br0p-nRtF-pNrNGSt8oZ6PmbdBllZKaVw&oe=699ADF6D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc3jYHvRMVEQ7kNvwE1veo5&_nc_oc=Adli3OBxNrnmiZfN6l8QtsV2faIdhMGAeMpKz-lRz0xHdb86icOL26FC1LUKL3nfrCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvj8hhpW6q6dfJLc9Dl9IgG84Nf9Vw5FUYCjpVmDYGJxA&oe=699AFF2C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=231rZ3GIgH4Q7kNvwHNeYK8&_nc_oc=Adm3hYyhZzAmrBqynJMsrn8wC_sxlapqxE4US7sz5csPyRcQvgAL3e5XybVHqVttqm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs2SxzxPBnXuNxw-_xjZ3Bl6vodN3FrciOuNlpGsjJzbg&oe=699B0DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk0Tq9H69n4Q7kNvwFQFfCm&_nc_oc=AdkGZb9b3w869qFGl_IQwl1jeVazDhOsJqTAKdqjU-6YEi3y8pDucToyvV_ZdAT33C8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft5nlqHjteR_Sy-MclXo5PhoX16iliaauSp8Q__tcSBnA&oe=699AF064"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "616211903008281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410280_1925
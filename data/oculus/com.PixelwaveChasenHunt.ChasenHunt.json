AWBlEmB9tdu2s7nyMH1peXTbdDyaqLyU-nzeiW4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvJ39JcV7_NFqcS8r-BEF0uYvyOnYcAe687hMGAx2VD1Q&oe=69A18F70"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwHrD0kKBiUQ7kNvwFJ_vL6&_nc_oc=Adn8-2vLzqgjKXUFLwgYcOjqA-fwTI1Cs4aJ7DC7BPiFDudlp6g_yGkTyRNpm49YI3k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft8Ttnon1M7HfcaDZ1wg0GhUdMiKmZLMTtd8vevkrjVfQ&oe=69A176ED"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD_sIhYxeKIQ7kNvwGruDKq&_nc_oc=Adk3ri8WMGo7vkSZounmjnw8cf8Gfyqv2bT6NG96oILTz7QZmccgUhfg3xqAejva7RY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs_EMButnUgQWnas5cAUVh2W25nqFmiuOD8yRlQmkOYIQ&oe=69A196AC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cp7Ni1J4UYQ7kNvwEWoiYv&_nc_oc=Adm8A6vFANFH251l4CWPFGo9l9Wcfzgij54WDb7s_s9IsUp0DOLvUN5CKgIlabR7jW8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfstJf0kt4GdPSqYWxY7PlGdtuX1IHVUeAqD_U8MeLyLEg&oe=69A1A55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43Qewl4DkkEQ7kNvwG39w6y&_nc_oc=AdmplLh_xXna2pJYCIQTmVY20pUiOBgs-LfXEB5OfrN9oorPOxf4AxVAzmGYV-M4zsg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsHLHXikFrGZVYL3WaL3-4TR5J3Df_8gwvGq-jDadIQKg&oe=69A187E4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "616211903008281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12410280_1925
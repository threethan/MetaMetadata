g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBO_LnWMy58Q7kNvwENqWQk&_nc_oc=AdrhiVSPJo1mRPPp6gzYsrpQjUn51xVtWghxhzAHY8qNCYCRtxoxINPVvATD9DQFFmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFVkMPTIeRtqjy_3FO0YjcMz0JCM-h4v7hGvFDLdv3yQ&oe=6A635BF0"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdrPgVOWVsQQ7kNvwEujfCB&_nc_oc=AdqZn-tYJs0RahO5S0XPzS5pcTI7PJ_GKtmcykZjJrBAcUkpFfBK-TsT6OqtQ36MsD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg9XmBT9g7TS6GT2jiWxrELOr5NDNd-f8N3mUAaCmFaA&oe=6A637BAD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9745Gm8XDMQ7kNvwHREED3&_nc_oc=Adp0Eir2cpnC3cF3uT_E0RzxGewFit4yNWNYz0X2M2Tc_G1pEEjjf1LHm-SS7w5sqSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzMzUcdlpYJ5bbwwOPmlgkx17QOEd-RkfYbZ7Fw5-gYA&oe=6A63632C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fye6Z_A_Ac8Q7kNvwF3kZtw&_nc_oc=AdpHVoczi9ACZZfYKWSbqPJr9WIiXyEbMUxHIwlVZC7eog1oZTeHDGJ8lIGZP37_1yI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp5VxY0i3EEazpS_PZ6yHdd6XuNhK1BRyOheSrscQ24g&oe=6A6371DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqW4IiQUpP8Q7kNvwFU9R_c&_nc_oc=AdqBSAecyvHpxc8EtDoNrAWuaOh7qD2lrq3HQgipIagGni44_y6YvgB0J3LdJVQqD5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsLjVbOlQHh6pBsl-jfXSBvcfR8BHo5ZfqqXBzyeMRVw&oe=6A635464"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
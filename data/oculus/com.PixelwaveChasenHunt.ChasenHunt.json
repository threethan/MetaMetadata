g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB2JBcoPeD0Q7kNvwEVDjlo&_nc_oc=AdqIk5HqiHzd07aoQWt2PRCrznBH-KwO3_-becSYpbAlLfkSVlx8O3xbGAvmtUcNZ4k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReAJh-huwGNq3Uyj_6sqgOIqxOfOfb6_o7lgXa0-DaWg&oe=6AF9DF30"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnFvJEVF6DsQ7kNvwFyeycb&_nc_oc=AdoSK9Dxb3MLfTkXCoGDyB_vUpgp76ME6Qn7kh_B5sRGjsaVsOw8U4r4Jda1bkUTp-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTskIoQmf4kYTFWB1s0hveM6pDwVeuNe2yKSre7nADf6Q&oe=6AF9C6AD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8COpBHeWDQEQ7kNvwE1nqu2&_nc_oc=AdrQ7dKclrpysia6iZ5pl4CnbO_pt0LjrMcB-hPe4wEsF4aDkzMy2uf__wi_hZnrq4M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMzoFfnyILPsM8WFUL38f3AdiT5hzMQp5ehrOUbV8ZRQ&oe=6AF9E66C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtmxztvfkqAQ7kNvwHh8eqf&_nc_oc=AdpsT5Flqzl_GCpWvcOViw70XkcNDv_QOCErap5eL5gbQV3b1WZ6MCV57zCb5Wn6lyI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_XHTi5kUqdVUzZVO0QPMRP5dthNbTy3VTExZFFVxyig&oe=6AF9BCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j20hYVNReVEQ7kNvwERMVq-&_nc_oc=Adrcubgnt9AMHVR1nY1u8fO1RXQa5oDoDzEloQwwF5TrKSVgTTY9qsplVg7CCXpQMtY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGx638XVutg7x01e3eICOS_lWBUhyfDmWStkVuWkn4Ow&oe=6AF9D7A4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
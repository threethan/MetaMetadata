g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PI4-kK7lFQQ7kNvwFcQY9S&_nc_oc=AdrPRbanVDv8dSv5c6PguaUy85fv10AVTeGroMYE0usAdTlh1xDvBmxr1D7yez_EdvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmAt2IEewXaJbUQJpb8Ea5L9uEmE7S9j5vw8UGOV152Q&oe=6AEF5330"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksNQ3_-DolEQ7kNvwFbKkOk&_nc_oc=AdqGJFlIIuqedp7iuvxfXShQwR9uniU901BFK8hRjn9_JwuDnLjbJ9xE6S4kpAKghKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjczvMHU04Jd0fdm-jlnq7pNuLKCft2qpE6yq-VRX-Ag&oe=6AEF3AAD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkPA7Y0tkg8Q7kNvwFs2Dh3&_nc_oc=AdpFAsFV3b4fJshAlExjqCr49FdheVfVAMdzAkg7GGCMtP3l5o5X9k29JCgVYCoAbyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBmY7swZyovfUbpFgJitug2BoGFzOuY-HttNoylInMw&oe=6AEF5A6C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU2yfK2jpbEQ7kNvwF7a5Ux&_nc_oc=Adrvp37F88-W1-uaOHJBuJbPR8am_kVY0zmD_oHH0-UjOWKu0uJtIYXeGci4EAjXTCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN7pWdOhshqko4KAYuo0NXDQ8KyDAs0-kQ_h4BtFjOLA&oe=6AEF691C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=it8pNKiUXcgQ7kNvwEZQ7WC&_nc_oc=AdrIZQoIMCs8OPj10lwFPWOL7rMtebQlAX2ftNaWMfhZCJAHOxrYTdXJ8OosSOnd_xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf_vHj5rNNyCTW3EV0GvRVQqxOh7CSNqrCF2op9nAOWQ&oe=6AEF4BA4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
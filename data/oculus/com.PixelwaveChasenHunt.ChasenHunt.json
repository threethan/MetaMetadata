g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN-eWjMupaoQ7kNvwHtfnBg&_nc_oc=AdpP9mWUpecn0nBbc6Z44u_VAzTwlzDC2sMDqFax8oHRqiZ7tPq3nQjlwBZ_yDUivN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9x9NEoRgzxb1WZfdJ-H3GbMYHjCO1VnIKID21UDJR1A&oe=6A523870"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWUGg-dd_qAQ7kNvwHDySLy&_nc_oc=AdqPKCgWWPO_g8yT3nKhZlWMatVk1kTQCZw0kY8dzPjLDlXcJD_rUFSRusjJJC_SXSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEJanm51hD9NWw0rfDK9zWXlrw3O8EIuNiowsQC2-zNg&oe=6A52582D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJCpYd_T9kUQ7kNvwGTPFFc&_nc_oc=Adq32NtRJdGob93MU4_SWgjc0Es-u0yOthfB0Tw90ojU6CScRXlZA_mHrXStO8sovvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHi4IM8BLA1tDx3idv3tX_fzQqhDUke4uHo7yheUkFTg&oe=6A523FAC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDMdYlVIDhcQ7kNvwE5wZCa&_nc_oc=AdqzuSez3zia7i-AhPyMwkBSopuPgQEp9kahpRiljnCbbZm76VByOLBEY8W-CG2z7G8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACddXuRW0ODHvnFuG04_GsdQDEf6MMBSuuvQyAwMylXQ&oe=6A524E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnTNOPq2HZUQ7kNvwGVgffJ&_nc_oc=Ado8k090ZB0NxTgJsWLEo-Rw2Vt_oK9EsF43SpOacTeBsPkwbL4f_3uJ5PZpHdJ_KdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfq8GHBGVhKI6XhJHd5f3vmy90sYmixNFVYUFZIL4j6w&oe=6A5230E4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frjKmf4qefAQ7kNvwF476Ag&_nc_oc=AdqhnMPgVbRIWf1jrULf4c7j-0oUTixwq_cH-DBKsv0K3gFhRG8PifIB0tjxHnh0qxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcSZJyWqQ6zTNpPjdAt5eXJ7s4gBN4cp4coAuvBcXDfA&oe=6AAA8CF0"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYrRBIVVVHgQ7kNvwF47mGR&_nc_oc=AdpgB7GXhLYo1b-LdswyThD66zDXzSxwUqlgGz62lav03mjK2LGDjXl0ZKn-LC3RnkU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwrsTkvnMhlvMKCo5RuAQFY3uZRyMBG9eVp_3JuPQ_IA&oe=6AAAACAD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I98kTIw_gG4Q7kNvwGrRGc-&_nc_oc=Adp8f1lcqtSDCYnEouSioCGEEu7ueCJh5k3nabaR1YsapN7MpYICkt0iayOMgV_f67Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4HyLH2VWAR3DLXVAwGpBYwKTcdxzmultQPQVbCo85Fw&oe=6AAA942C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-9s9mlY9CcQ7kNvwEiUy0S&_nc_oc=AdoUNTB4xxCRTnWejNgaJP0Mkn1Q6iJNo77wrPB4FvrEig0hGNfhljvAVDHbC-SjFgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgapYD-mzxWALBDnObQGXHtqyocNFSGGVw8QL8x319_w&oe=6AAAA2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwnYmxLywcAQ7kNvwFl8UsH&_nc_oc=Adr3J4q5tWyRk1avQQEiJxl9-alpPmKwd1oE9A2LlXqlgxtE3BKEz61k3tm_j6cn_MI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7HBc7qgfuHSqxVnjCmjcMpk0XRy0as6ffP0g5Dyrvgw&oe=6AAABDA4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
fZZ1gA&oe=6B084E90"}, {"file_name": "migrated_image.png", "id": "608837236365980", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162687_1825073364475748_2854649270257057792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be8mAMzSwkwQ7kNvwHK3Hs2&_nc_oc=AdrW_IUuBtDWjeInEIElSoBggt4BehbxXML1LxG-RdbmiWbF-fqfjswQJIO_B-MnXdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ2MeQGJCSfvsiJX1Dn8sUNJYw8VmStNXc4bgTeV3Saw&oe=6B085B87"}, {"file_name": "migrated_image.png", "id": "160688871713812", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162688_270013333405222_2512720116299333632_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvMxsCw3R74Q7kNvwFA5eII&_nc_oc=AdrWnt1AWObzxG3-2GieomguQOBhrycyb23C4lK-RNRenWyRW_wPy-UmOaW9ugNHxsk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeDbwHotD7khODUQVSAkC_QTma8KaqJguMIPKcm7aAHQ&oe=6B0872CF"}, {"file_name": "migrated_image.png", "id": "145889513396929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162683_1903711136535900_2856710528141623296_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIEYqFGgAWkQ7kNvwHIg03Q&_nc_oc=Adp4wAoCwnAy2JnowRN2CztIePljSYhDPpKarY2jBuzYwHniljkshYMYxp2FY5PijKU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV-88raUcHsfWl9Z93OaF3cbfGKMRPg4x-6AzvjOT46Q&oe=6B08544F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.deepbrain.xyz/chase_n_hunt", "developer_terms_of_service_url": "http://www.deepbrain.xyz/chase_n_hunt", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SPORTS", "SIMULATION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "304260171682072"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "CANCELLED", "id": "151529848816157"}, {"status": "PUBLISHED", "id": "175954596581734"}, {"status": "CANCELLED", "id": "173234010084325"}, {"status": "CANCELLED", "id": "1981524225464179"}, {"status": "PUBLISHED", "id": "788598307968838"}, {"status": "PUBLISHED", "id": "346715349330662"}, {"status": "CANCELLED", "id": "173096380098630"}, {"status": "PUBLISHED", "id": "1874545192763010"}, {"status": "CANCELLED", "id": "1585236421530840"}, {"status": "CANCELLED", "id": "1916257825058822"}]}, "baseline_offer": {"id": "1874545192763010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "stat
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIID9H7bs7MQ7kNvwFTejBl&_nc_oc=Ado-yjlta5cxIWNbRwVV6LgdHTalaE4sSxCK9fLrNKwAsOKsQw77EEAUguP7x3rqn7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvZe8hYsW8h4L9J3c7n1ZZ2_rqCQu99dbfQcTH68kw6g&oe=6ABBB070"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlrRkca3WXgQ7kNvwGGNwqV&_nc_oc=AdpD-geEeJWRIZV8VMmTwLbwnLj-W4Bv1YlC3a6U5jHG1CkThatj1HlSD7eO28AXOEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLbn70xHTi5yrgCD91LcM3v6A3EO-PHDy5xLi_YwKHIQ&oe=6ABBD02D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrnsU221jFwQ7kNvwGCwkzi&_nc_oc=Adrk-XZNT2S25cPH0FDYcPt_U-2Aew5PAII6fZqtqtrShFcaGJ2xkQkiS5OQVXK0CL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9v7w40FztEWq_A4Lay8rNCTRhrhYUltVm0XBTeL5sSA&oe=6ABBB7AC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCKkqXmvDigQ7kNvwFpHJBu&_nc_oc=AdprYZuY-UqU1b1IP2DShJ_-TcbxDvyISEc3d8LgclIzug8JYWSlyleD_Yok5Ci8Jeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkELP9V-qxGzKR9VkkNcPDAywFwQ9ojrOn6vHN_Sk2KA&oe=6ABBC65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gpPw7YE8HIQ7kNvwE7g44F&_nc_oc=AdotMP3KNs0RpoxrM9jUmP7W0EdUxGOgHsRm6IvJpT0ffqsUru5dXY2TCt_5cA2I1is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJerCk7V8azXsE0oaK5zvqZWPZYcRfugIQDx5P83gm_Qw&oe=6ABBE124"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
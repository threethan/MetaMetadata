g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Npyrk268Y8Q7kNvwGOXwZi&_nc_oc=AdqFSrtjEYi_uRHq1FUTc2MoVO83sMqBygir6gl7SFdWcmM_lpNxOOO9grnwefKkXgA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yuiYyFH74S-PvZ003ZqisSJYtZxzKdDuGusjL6TyLlQ&oe=6A1987F0"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab2i3NcIk-EQ7kNvwF8GSYM&_nc_oc=AdrvKwVvhPU_YaJ7ArUsHaFzgTEBjsQd7RHXYazOeDC9UuAMfj9vGei75sN0BHTOk8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HNTB1c0yn-zdUlE4k3Fass2KwafaTyGjgKJFBybqx8A&oe=6A19A7AD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb7j6O_o3NEQ7kNvwGllHl2&_nc_oc=Adr9l-JcESeyWyeeIwdWNyx1_80c0dSi7iAaHgnNG92LfnmlWoTdKui2y6NsweWvl4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AuHyYhCow22QBIJEQPbT7eJYwlSy8ZECasVndaYXucw&oe=6A198F2C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEN7alhqRAkQ7kNvwGltdBw&_nc_oc=AdqIkT-fsBTrx56VoChBSqh2m9ztufEBLYJIFVWRHsoxhxsbR1QMp2NwM5-pxzExdVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-lq0NpvVlI2JVsIJDtUySqWMLjljTWA9FgW_Pa2RFqw&oe=6A199DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Qmz42t9BYQ7kNvwF6SgsL&_nc_oc=AdpGiN33YxA6Z5_e_HGX_rk-B8j67sJAfzoLeYtsKNaDIyRypPSEhlzAsJqyqex9TPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WK5DHWLSzMySN_kntFK4T2XyaKL6C6f3YH7GlkLbZoA&oe=6A19B8A4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
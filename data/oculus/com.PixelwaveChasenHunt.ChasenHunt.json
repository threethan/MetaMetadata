g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5tDSNqqDssQ7kNvwFbYAWz&_nc_oc=AdqZbh7eS24AhnsZb6sdIu0hAo3lg7XxeuFDOSuZIobgJ4jkEdYnn1BeMvg9K3mCBWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPcyZ08WFrROGtXFxYBNRapc9Lne_SnWW59csWkCejpw&oe=6A7C6870"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-T1HqOrQ80Q7kNvwE-hohh&_nc_oc=AdolD5IwtwvRFVHDnWLGSDHIPq4rsCOAC3kZypazY8NCRlJMM2t4TqqO01kjiQyNiHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXld610ceRfLrw9votHSLgJZ-pdy3-nw3OeguHO4VA9w&oe=6A7C4FED"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4H4CoG8US0Q7kNvwHV_t4E&_nc_oc=AdqU1SE5ni7pMZ1zsg9QFdNeDCG00UTRDdlKHiPzkdoJl1gGDDwOfy4ZGxx0w5dfNKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQvkcw1c1dde8I66e_W7_XG_tUAikBH98ZofxsavBOtA&oe=6A7C6FAC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xct41KMgJmYQ7kNvwHHhbG4&_nc_oc=Adqp8zinUa3nFhwhJPY26CR_lCskxNBlfXt3Ge2IDI4JDsto_050V1yS_rEYT14StWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcyNdQZb90PoYyM4TpERTXxCwN2ZczapFRFsv7mtWFPA&oe=6A7C461C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EXnQ7YFUBkQ7kNvwGd9hCh&_nc_oc=AdpRhHbSmxjYDRNSaqo40bWqZVLt9gfBbT76taVIUqlEpjb1UvXKNBhZpIgINalJhmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlsz5R1L6IYcIs0T9QC0M4AvWWLfgsbLISHu64I-dpBQ&oe=6A7C60E4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjQsUQWwQQMQ7kNvwFHUeKq&_nc_oc=AdpidQpIg9gtU-iCLnA1wMPV553P24XnRitW_R4CcbKy20VT73u9yUYznNjJL40x9Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9jcOO-TUyBdbpP2H3U7sZNEL_MaJwC3p1AuzlrFgLXQ&oe=6A577E70"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-XMkQs9sUsQ7kNvwFu47fd&_nc_oc=AdpRY6fwgYEeGyHrCf4jE2fXH343jLb69ED1UKxY_HaoAzjJWUULDxQuf2L0Xw57JYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVYEgW62vY_wpWRAHFIWBKvP315vKsReBZwRQrDgPbRg&oe=6A579E2D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGbkadBK6TAQ7kNvwHia0KI&_nc_oc=AdqSg7CVmmuTeRQmHxUs80nD0RDCwdutg-pkkmeHS9TeEeC6HUMY5a9CCvmHBboRtdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLK2SVYsWWKBiYdpftl852Ej-CaWa2CLHwGo6z3owufA&oe=6A5785AC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0WwLV5CTsgQ7kNvwG0J2zt&_nc_oc=Adqf0zw2liLX5bVgSL9hwNLrNPMQk-fU23PbiLWMr6z8h3ENRj09_Oit3NY_kQqQafM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuyzRSLZVMhu0w54QV_KK_YFLOWstQdvAKjKw6N9vJVA&oe=6A57945C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-_Au_bv4EMQ7kNvwGUoev6&_nc_oc=Adr_BLLHQscy1b5nc59MYzMItaMLOKF349eHa1H28pnRk1nCuK_5JAxZKvgla9Y3-Po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4bEYWUBXO6BW0v2JNlooCt5waqwz_YVQ2uApEWtlUrg&oe=6A5776E4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
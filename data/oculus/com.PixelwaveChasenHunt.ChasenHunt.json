8_270013333405222_2512720116299333632_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dfZvdIQ5FQQ7kNvwGq73mk&_nc_oc=Ado6cgMkbCPRWeF3AC--c_YrvOPhjTg1-99N3IeDhwMSlvMk0b_MuxmhUdgcSK9p7RU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d-LZR06_fOhBk9DMfkepdDqJAmAPkXJU0_YVgkfvX1Q&oe=6A11B20F"}, {"file_name": "migrated_image.png", "id": "145889513396929", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162683_1903711136535900_2856710528141623296_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi396JZdsaoQ7kNvwG-nvPr&_nc_oc=AdrXmtpuL4aWIAv4WdVkJcqTXIhv4nRSjCzzCvqJ82ug6lwqco_SbCkVQrq1FhD7BS8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U6hdQDBIFtj0Es9lA00zOK_8PuAZMe-ymN2_E5PLlXg&oe=6A11CBCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.deepbrain.xyz/chase_n_hunt", "developer_terms_of_service_url": "http://www.deepbrain.xyz/chase_n_hunt", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/cha
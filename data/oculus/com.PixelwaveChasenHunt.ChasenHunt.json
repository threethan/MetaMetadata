g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHdSbGA2CbIQ7kNvwGhOFfn&_nc_oc=AdoVyCCHBw0XmeO1PFmYQFE87eYFcu0P3lKHbwqSQdMDSD-OF2d8NieZIWeWLEuxkJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwC9q5o0vCbwOv5WmE4pqs8xfbtwF4QRQ09ez7HI6dsUQ&oe=69CE6270"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP4w6U1frRkQ7kNvwESueJ3&_nc_oc=AdpO8zePVi6oBmjdddyjgZSDsRSwPKGY5Q3p-u6mUJIQuXgecyah_jOY3cQmpqv6emc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKCE2C045Zf8aWFnjV6y0U48J-mvg9Ofrb78RTxKt7_A&oe=69CE822D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQLczJ-GKYEQ7kNvwG_PPfc&_nc_oc=Ado4-47zAC8NTTEHTU8tlJH310YtfpZPw0Po6ElI8RGmEdIgJS8X9-tHY6pAUAU-LBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNXFsP0_a0OyiFcSm5NmN67XAvUobw1Mu8RqJAFC0I8A&oe=69CE69AC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bCROcXsVQoQ7kNvwH6JRvA&_nc_oc=AdothG5aXAEqh13SuRC37FaZLnY10tNDu2zojgnCHCFaE04SdZSBRxVNMejGFIYp2CM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8ntCLyLGS4meKhBonFmkSGs0KCcn9hg7DryIlvWsM_w&oe=69CE785C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4rmKcfQKaMQ7kNvwHOVLks&_nc_oc=AdrpFLovhMURPMwtbKjYvMHq3WTvDcQ0UuEGVjsqaTFh3Hsvk_qMUnaJCQFsUqFMFpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBYXGuQIK97EkLxsy-eYXrhAKmBkhmMiP1MGf5ornK7g&oe=69CE5AE4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
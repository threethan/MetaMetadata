g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vyo_uKrKbsQ7kNvwHkxpJG&_nc_oc=Adpr9rpoMmWs-L3z5n4z9VB7aaAnrlwRUJxHoVBv1TrxJrKp3rqHepoROh-Q-C_uk_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcu-qj0cNVDzr8buPozhuRtmBd0yWZBe1QDlApoYBAJA&oe=6A5E15F0"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dozyf3dnULMQ7kNvwFG9l28&_nc_oc=AdqjDdREo_bAzh3ZjMk2xLhQBZ21gMfRXdgauPxLH9mhBPb6YMylle-pmEXPrR5T8Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqEM4JAW8zBrfXr8OHz-DZ_eXwx6fyheJdW_72nFYeeg&oe=6A5E35AD"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzXszRNYiv0Q7kNvwE3Tzhe&_nc_oc=AdppKqftjwagJ1R8xV2Ed8yw6_LY1-nFUpYdg3AD76Eh84q1hNt5iTvRRsiPI848W7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoEyScBCfF5m8RUq1T70eosGuCfwQFlqkmqMhArXSyXQ&oe=6A5E1D2C"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJKe411cgLMQ7kNvwEP31ET&_nc_oc=AdqRQTT2OGifswdfZZDg5ClCRzJzk9sE0tsXvkE_fxa0_xAzM3j1q8qAsGRZGS3gNrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDSTI28m2fWuPK1rV3O0-9yQnVGlIgWW6JIxC3OYKWOg&oe=6A5E2BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jJecSteUuwQ7kNvwED_Gzy&_nc_oc=Adpfxx8XntPtZZ95ZfgLl1z1o2-0kivpTi7VzHFGzhO_u5mqhaU-E6EaSaWjvc_ysPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARLLecN_jLIQFYY_UaBJZF0YJaybHKxhNzQqZTBNpSsg&oe=6A5E0E64"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
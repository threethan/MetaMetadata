13333405222_2512720116299333632_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmR3LZK0A3gQ7kNvwGKWAe_&_nc_oc=Adrx6xQWY43oQ-T50WUm2p6EKOwF0dvvfp4k3ijvx8r4NlqaYEwkzEjfGqWAPsXBcoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNuhN3mWF6BDPkLqgfRLOO2fnjGjUV8HAaHD4Bo6vDaQ&oe=69CE758F"}, {"file_name": "migrated_image.png", "id": "145889513396929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162683_1903711136535900_2856710528141623296_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_QPozsKJQsQ7kNvwEF8ynV&_nc_oc=AdqPjzn6UgcwVkoJT7Pgl0wvV_lxO5LVg9K_5zCJjvJ5nvJMUfHwL5_vzi3Z09oTcRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxln0grYzzW_KtALyhJckyLqqWleHKxOzoNHWmXG71F1A&oe=69CE570F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.deepbrain.xyz/chase_n_hunt", "developer_terms_of_service_url": "http://www.deepbrain.xyz/chase_n_hunt", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_h
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN-eWjMupaoQ7kNvwFrVZbt&_nc_oc=AdovTU8oWlHf-KMg5M0fHg2beHtL98bAMLTTRS_FxZjQhPKIJESugpNW0PjIOQX_nyA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1SA28lhfQDAsyjlkK7nEcyIIhOwp7YaTjkzVjK7JshA&oe=6A54DB70"}, {"file_name": "migrated_image.png", "id": "612226496022998", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162708_1734374423531939_7752073840775135232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfhoeJXg2a4Q7kNvwGkePQ7&_nc_oc=AdoAzG-L5D4BjntM8ze9o9mPNTq5l-sURN8tu21noejdwqWV8rY31wqhn7BHWDu3x_g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9YrfO_SKd-Kj2bT2-x0T8www6yGtDS6qgDpe0qxeNkw&oe=6A54FB2D"}, {"file_name": "migrated_image.png", "id": "286067112359003", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162741_1513149128721061_2303296097902133248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJCpYd_T9kUQ7kNvwHm3Tfb&_nc_oc=Ado8i_fceQ6bMgXcGXFjG1SKEvUxhU8JbV-vvwgq0sX-cV8QIZTCFq8EQWZVpuYEioA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC5_laLXE2FnexdYA4ilsHZucO1MPrSsIJV4cdj1kSDw&oe=6A54E2AC"}, {"file_name": "migrated_image.png", "id": "212993736778839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_113128252736918_120924812808814592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X7Hu5lQz7cQ7kNvwGyc_LP&_nc_oc=AdoploH-fw1bJJt1qOdOwuhsPE7_leYACSSYRt7_bvt6KDPjsvjiUs4QUMtyr2QNb5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOyGTCa8XYwwsN4HfOQTU1D5RAbbGQYXiXFoZusMIOYg&oe=6A54F15C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2Chase 'n Hunt___video Cover Art 2650x1440px.png", "id": "2424906467812543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75307245_2424906471145876_4523350578648896172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPtiu_ThU0UQ7kNvwGzypSd&_nc_oc=Adpsde7-7tRJ7PuN68nE9EKZ9yfmfzOgc4lJ63mr05t9MJ1SXhyv6LSJlb1h0Wq84Rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMGeK4azbYwBnYKf1SAj90SsOQpoTMvZ3qGsSMCJG2Ew&oe=6A54D3E4"}, "display_name": "Chase 'n Hunt", "keywords": ["Hunt", "Openseason", "Hunter", "Telescopic", "Gun"], "long_description": "An extraordinary FPS hunting experience in Gear VR.\nChase, Target and Shoot at the head of your prey. Meanwhile collect gold & ammo to level up your telescopic sniper rifle but always be on your toes, cause in this game there is a fair chance you might get hunted! \n\n*Additional features\nThe Animals have limited AI.\nThree different levels, and more to come.\nLow poly environment.\nOnly 70 MB free space required.\n\n*How To Play\n1. Tap and hold on touchpad/controller to WALK.\n2. Single or Double Tap to SHOOT.\n3. Swipe Up for telescopic ZOOM sight.", "short_description": "Welcome to an unique First Person experience to chase and hunt in a low poly VR Open Season. Don't go easy with the hunting habitat, There's a fair chance you might get Hunted!\nPlease note: ONLY HEADSHOT COUNTS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "developer_terms_of_service_url": "http://deepbrain.xyz/chase_n_hunt/privacy-policy.html", "publisher_name": "Pixelwave", "support_website_url": null, "website_url": "http://www.deepbrain.xyz/chase_n_hunt", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR8q-XAJMWQQ7kNvwGW-IAp&_nc_oc=AdpAP5BLU4JCZXlQ3VWudK2TwwJVhSUFd4Vn2QLzDfs11hogtIXoUVtJDUrcbqIqgh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af31wgPjd5kogWiH0FezTu-N_3HLMQMvwl4LVd464R6Ccg&oe=69F0BDC0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWl2y5ZJtd4Q7kNvwG3Z_g5&_nc_oc=AdrdAq5yb0-VaV-nDvbPjd3rv_K43nAH4YJqKg6rtpCZzGyn7Mx317f4Exh9rIuf7NY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2xNnmy3OvjYfCFwhI1K_ixKpR9ecgcOFLWC731KiRz9Q&oe=69F0C719"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIbFLuSmvHgQ7kNvwErQUP6&_nc_oc=AdpXPWp83_YCWQ_YjKojx94_oAAMkkx8syeWLsjzXYMGwN7xiLTnGWUorSr6x98H-Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0VQV8Twz43XQzGeQX5eQ483m4M1cDliZU0GDLgIArvig&oe=69F0C4ED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3PNhQpYFfAQ7kNvwFiKDR2&_nc_oc=Adq3AC_RZpWBMixb4Nmk_lopCa6bEotLzZj34r2rj7sDN1aTBKE0fyDGMTL7613GdUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2vRfxsZQoGHecd8q5TFHAFWymAb9km9mRthFyDSlU4zg&oe=69F0C07D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS9LOBRoVSoQ7kNvwF_L393&_nc_oc=AdqKgRCcHj3Z1hvsriI_660Fi8vK5WsEdV9EGuz5DjKzAqWenSFJR874z36ZrAb7YXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af050Z7nl3KuiTtHFWmbKIPb1xWwTcDtmb56LwEtpbJymg&oe=69F0B1FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
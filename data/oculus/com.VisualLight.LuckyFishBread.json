ng", "id": "4249616588409007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=httOhQnfOw8Q7kNvwGeWaez&_nc_oc=AdkGNBQ0MfqYn7JtbluZYPx-mKGP1iD88raIvLXu0Kq0ox2qwOOXMpkNiJjcXZg1Zx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFlOQiw2xiU4MR__A9nGSwZc-P59o7lbNnkNJW5TaqUg&oe=69AC2FC0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsGVeoGBR_wQ7kNvwEQdLiH&_nc_oc=Admhe36NJdSfQE5P7rVwqx2FMVGVtMKlmwtQQp6zAI1UIbFYKQyz8fTSnRtTnkk5MAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywNlp3fsuYsPz6SatZRJ4PpmqdTycg4UlZnB5cl9eWtQ&oe=69AC3919"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEKSpTLOfw8Q7kNvwHim2py&_nc_oc=AdmYo_2_sTB7e1j1Plhmd9q9EmW-OvHDWgOR5y-1OdFp1pEA0rMkne72vXkAMB0DHX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJzP98Qr3sxUy_7z9pRiAt1yrOu-89iLKoxRFnnlputg&oe=69AC36ED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC7fN9S0m1wQ7kNvwFt7oU9&_nc_oc=Adkya4OcQ9wmGCdGzGbLM5EzzClaetXz588k47Ex6eSAZVFZx6KOkubb5ZGapyBPf3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSneiReL339sNfKZNocVR9DXI9zjuaPRvl7URk_lPw6g&oe=69AC327D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtcgb5koJ0AQ7kNvwEWOS53&_nc_oc=AdmPWVVhMkKk6qVTEuq0NkYX2ztiPc0ywlbhjC_1x-8PTFRqEKFxnXNzaI0_XtTkn58&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDtAZ2rdHTowN2jH7Jb63v4DsTV-O-dxJNO8BfFyR4Lw&oe=69AC23FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
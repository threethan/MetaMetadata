ng", "id": "4249616588409007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBfU84J-NCoQ7kNvwG_hFdu&_nc_oc=AdmEnAC53das10jnBP2tsyUKznQLYkaGGvg2JtrKKz4JJ4Z7JAoVzqnwVbxAqTGrXFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYNosPeKi_fd_GtuEx7DuIJx0ZpHaJlaHq-cJ9dCw47g&oe=69BEA4C0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cVR1De9hkIQ7kNvwGC4TFW&_nc_oc=AdniQJZW3v2s2WExwtGHGxa3e4XVEsLJVLqEn7xKo4nADsLr4mdQ1-Pi_vi75WsBsPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoxO2zXi15T09VXCEw030xOsb8H6E9W99fxkp_e4Y2Tw&oe=69BE75D9"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGUjQcPspAcQ7kNvwFf2-qp&_nc_oc=AdnqwHBJth_JqRronc3DPMQs5c7vaQhwQ56dbjNzJ_5uYJpcGgL-doTdXys-b0wNyMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7Yd4BrkYR1TAMsw3vW0xw1T5DKaB5VI-c-EUq3Z2usw&oe=69BEABED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0gSyg5Ed0AQ7kNvwGuV_Mh&_nc_oc=AdmEurQGtXGbXHpE4Kjsd-lu5U0ya9ZDTsjhhnW-OkqaNrRCzQK7dZoGXgyxH-onHP8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJqNvUEVt1JHTt4zOXDTaf4k_-q6IZ5FcR-OLGOwICPg&oe=69BEA77D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCt6B1_xT6sQ7kNvwEaoIK7&_nc_oc=Adl0gEnDxWibDaFCn1_pi__SCNEWylTbJVC2-oWboO3_Y-kzkBVyKZp-J2mfl1WTi-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAQ0aMUHrQX4aTBIlF46BD6X1Wmofp4PMTXAJwwckupg&oe=69BE98FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
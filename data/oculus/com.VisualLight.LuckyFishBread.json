39ACE"}, {"file_name": "Shot17.png", "id": "4249616588409007", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9VCfmpXOpIQ7kNvwES_PEi&_nc_oc=AdpH97vjK9oKDUJHvW0Sfl2Gkuy5rp3YM3VIglss9N07ubNjh6bsIHIDtGkw67QaJzo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8YawxnCBGZgBNNBOMPUSdSCxeXHnyhe9AD82GFFPy9A&oe=6A539E40"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIOsqRAn868Q7kNvwGZ9ljV&_nc_oc=Adqk5BkGB5yczuF3xvv1qNESKbD3aUmN9aLj7U4krctHTv9g9acjuu2QM5ZU6fOcTNM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDmMtmhArsqn-L75PMO9LnXzrQ5HefqQBGznwUe1fvFQ&oe=6A53A799"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVa3I8DXsv8Q7kNvwHWi0Zj&_nc_oc=Adq_1oiWwp8os0edtnVdUKno5AEymfBKz_DHT5OeKK17wkYKFAg6YE0Q30eo7tA9j4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxtCxs0Nn4jWAXBRr3R19DP7NYCG5Y92jnzd0hdLwMmg&oe=6A53A56D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IJTJEBGdNkQ7kNvwErAKdI&_nc_oc=Adp5edQQxZbUuA6z1YHdT8PtQxTYg_ox8utoN4ZJcmKWAIY-nsRAcNpRYULk27m0dWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk3BlmIEVxa-R9KyINK2gkIKv7w5xSI7rUTV5aYtvCJQ&oe=6A53A0FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRRlSyYR2lkQ7kNvwHNf6KU&_nc_oc=AdqN0rMTaG84bQ8h_83Jw21bhsyICy3iYlT6pJUEKiDTRF7hOcBfUQO8YhiruL5NpGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD3tjmga7pFHERbLfTHo4lu20kmC-5TqHusGGRryUKCg&oe=6A53927F"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL
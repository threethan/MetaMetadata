36CCE"}, {"file_name": "Shot17.png", "id": "4249616588409007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCiouz2JjIIQ7kNvwFnOCjy&_nc_oc=AdqmK9RMXaTxTyTtM4jG1_VE2701JvO0ZKQbrvZbh2-iAajVKcgxQ0jUDtdKun7Ui8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK_6UCjUS0Tv74j3KoHOo5HpFUaC3IK0t6su0sfF7kwg&oe=6A637040"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFBh_Er7szcQ7kNvwHjG49E&_nc_oc=Adr2muOVqv0QwyZOMAIFK3nwpLr4motmvvbOj5LHP3Q__05uwX4ayL3GR8kq4BP3U7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFDpF6aSe0QvrSaqpWgyWfNjp0yTAMAQmw_0lnjdGrBw&oe=6A637999"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ7KFJEH928Q7kNvwF5X_sl&_nc_oc=AdqPR4hqP_juCidolAvuqaE823u0eqHGyusiLAfAh8Nmr53aTdRTEW8Zfv0FcEGCK2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLDKy_y8Lc8VbEH9_lrxkPyK22uLf0_oI3Y9fFLSk1Jg&oe=6A63776D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5aKHO9ehEYQ7kNvwFGAPvA&_nc_oc=Ado4iijaYGOiHY5gJ21TA-xF3L7VSw5MP-DGitkOR-atfxGozRURtf5Pu8BwHDM20Ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCHIBd8EjtFg-yWmFKjahGOQxiAuTJrlZFOst-xw5B6Q&oe=6A6372FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y9cS-pjlQIQ7kNvwHwlnMw&_nc_oc=AdqBxtHeLGVuJUBtPNODU6S_cA9OXaFhmqLKG_JZDxjRX-6uEw4NZboCJcHiq9igJrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOwykCOwfcNXZsisiG87eMGknMAN7Z7wVCj4fz1CeTPw&oe=6A63647F"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL
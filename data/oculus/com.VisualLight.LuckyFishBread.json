ng", "id": "4249616588409007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaN_LqmKPNYQ7kNvwENHlmF&_nc_oc=AdmDHnJs2KmeqVyaDJO6hYUUU2FCOGWSQpjQWnGZEU24-T-qdK6hgjV7pR4Tsti9T7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyseK-rR2oWoLfuCyJT-rfQyyeAjMHbQEOC_0T-PHZTDw&oe=69B95EC0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqjqdZROXbkQ7kNvwGY4V3T&_nc_oc=Adn9ukD_jp_LqRvkqmYhUKFkRMH9T-_5fqIHGFplr8waEbk4guvN1OGKgyvzBXS_6IU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJsa9GB4zfySi0mGAWnXvFdzbrXZ2f6u5tk9tp_wDQWA&oe=69B92FD9"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-5IK55nQQcQ7kNvwHkuA7x&_nc_oc=Adnstg4ka6kNQ6-azDfqI3WGb1Mph_OpT2W-xfZ-ICRxOvbX55cabubrOhkOiz5Gw0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIPY6sCxxmr1reMaP5ypnhO-NDxTFw8IjS-9iL6xF5OQ&oe=69B965ED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXmO18FqA_UQ7kNvwHucdbX&_nc_oc=AdlL0M-qYUkRgwZQ8Mq03p8pGTOB95CghUcwz1eHaH75MXnc4eBDl_-iMGoeK-pz32Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhRjF4vuO_nhbXQJBHkbW0-D0XQC5NOEnj3jylbQNqMw&oe=69B9617D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXqN33ZYQBIQ7kNvwGr_cTe&_nc_oc=Adk0xvHq_KKdGxNR2Nlzf15Gar5Pt-9wQ3GAT8HB4O4i7oK25O7FkIxr7-Si3iSRoMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxUvOa2vUqEl0z8abVvosYy5RYdz1R2ehNQszmKRi5cw&oe=69B952FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
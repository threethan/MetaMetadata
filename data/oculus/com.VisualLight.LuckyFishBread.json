ng", "id": "4249616588409007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynkXW1kZzNsQ7kNvwH5bLV9&_nc_oc=Adliel7OhXl2Fh1n_nBGe05wSbcL3DcJIgoiCZsD4xdM1GmDfzKrSt2-uF_O9tQ2SZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfymmZZ701cexf6Nv7-UtQtvqA_rH8U0V7eQJKEKnc3OEQ&oe=69B175C0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qGtE_V3cq0Q7kNvwE4kMV2&_nc_oc=AdmIoL_f0AN05p_p9zAmZP-YUzVhekgjfTAD8wL6uJJ4D2hVjrOC-KO6Rv3PFsJKYEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2nwEXDLuJqklNkjbmhwm61D6a0_XElbo5WAyZOXna5A&oe=69B146D9"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqU7aPlOxT0Q7kNvwGiekkx&_nc_oc=AdncB3TtOrHekjCv8lXjxx8VGkMhQgQVTlecLNOjK5Iu4yNtycq_guuDJD-1RlaSxc0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNFwbluKCG91ycjRxl2z5atoHdi-fyL3_1JUWHZO0AlQ&oe=69B17CED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnb1MoZcu50Q7kNvwE4kQgR&_nc_oc=Adkv7ybOXXzl_6aS8feDr_eGE9-1Uue_8OIdK6H0Af_bCJm7FWJ_CQ3fvQN5nLebJFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvPNtx8gSTEZQhRfuWczjGQuwumCLlPd2vObsoPM2p7Q&oe=69B1787D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jXDtVF54zQQ7kNvwGlLaAm&_nc_oc=Adk84aYWy6gfALyKE3-OEuppkB_uglsNmgKRoKtKBB5AFnzVXWgjen8julkWUtT2GD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyg8_UGyDBrHdeVtZXJmMWxFILz0sU6mknh0z6Zf6vDLg&oe=69B169FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
ng", "id": "4249616588409007", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBHl_eRVGNUQ7kNvwHoxiss&_nc_oc=AdmmDzDmOq6cUzTyS5IUNymB3b64bJm71r7XvBr1jhoWJDxiZfzh0MrlAV7RxZ6ZMIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx0mbThqgPOUa5Bvx5EPS9owF5FP6vKV_sEhz4BzOwQA&oe=69AD8140"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsGVeoGBR_wQ7kNvwFHd7xO&_nc_oc=AdlgYCKyvZLoRti5B5AfYavZJNLdmtwdU2CbaDC5wLXQGvbztHADLs_h-T9xITLPeO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV5Rg_NBrkOyJdOTNX-pyOoGIk7zB66za8tb8yVpA9pg&oe=69AD5259"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEKSpTLOfw8Q7kNvwGHKJv3&_nc_oc=AdmBxMsO8VaOv-jg28MpnY8ySmiaWvh0aIrX3m7Kt6XvSIeZVWWb7M_l19QohWWTeSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQuOvQFJm2pBBEkH5LCrYQZ2aAK0TTi4yyWqZbhlimKw&oe=69AD886D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC7fN9S0m1wQ7kNvwFdxfEH&_nc_oc=AdlDwgehy4XSBfessPd92vvRE9SYqwBHqy15hHufi2mXatwOad3lbOjeiYu_WmpHXhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz7OnnxrvC-pbn_KQpgE8Pjmg4e6tmnoeckZzA8gB5mg&oe=69AD83FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtcgb5koJ0AQ7kNvwGCwQ8a&_nc_oc=AdmKI7BlEbIfHzyDCqpwpgTzzMmZSnigbd57xatRNOlq37I9BtlJ02uyfA3rRWqU3mQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3dOGBefjmRFqN6aDu2PoCaQF_wmdHqWTPwbBQawtt5w&oe=69AD757F"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
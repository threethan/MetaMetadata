.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZTUtb8CIWwQ7kNvwFK2PWV&_nc_oc=AdnNZcal5BNwZNuHIdpKB0irp2sexqiShxAbm0T0Ex9cAgbbiW4dliMQsMZ9JY1iRAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftUbYMJcwp0jz6MDd22PaoiL8fZSZRUFsmHKX2oiXdaSg&oe=69A2F540"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1aU1byrLDQQ7kNvwF7Fm-z&_nc_oc=Adncag3FA6R7mTm8rLsvBr2-7L9cKQVoynP2O-5jKQlk2vmh7KIRep73o1BjWKW-W14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSOWpxgYYX6TLtEmZi2dsOLM5Nq2fo52LEIEDaTauvpQ&oe=69A2C659"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT8nhrJPnI8Q7kNvwHfpH3D&_nc_oc=Adm2zlPVAH7btcjP8gJZ6-w6fYFE3hho514CEWL2iqz1Sc5GY9VLfvroJvKFyqH9gpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvfp1LIUJyrAN3xbBp4fTYRr9ubUZzhOqt2kyuv64zeeg&oe=69A2FC6D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY4yY1zrXjEQ7kNvwFpa_XG&_nc_oc=AdmQq_V-Vr8knbaIVBTWjYoAAE2A-TCgy-Uoq2lKCqQkS_2M3WhtMZXbC0dhALRuZcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_vwDZQaYm8j6NGzDxsfCdsM2-ETyqeuvkq5C7MpYt5Q&oe=69A2F7FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53hmzbpVnywQ7kNvwGynpsr&_nc_oc=AdkX2KXlWxmwqtZ0MQfcwdfBdyqSjz8agk0GQGGWcty9Z_nTPsic5p1t1iWq-8OoQO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEaN9InEwYIC-GO5griO6RtIqCkxc3k9NAIcTwZX_m7w&oe=69A2E97F"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
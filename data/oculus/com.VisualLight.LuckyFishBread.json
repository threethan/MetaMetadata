ng", "id": "4249616588409007", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaN_LqmKPNYQ7kNvwHe909k&_nc_oc=AdnvCUHShuckmKF_5HriZgun-tNjcTo_dEAt2fbptJtx6d9KEKg5iXAy1wpZo5D3sTQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9uPlOxrTabUqw7sTysWPW5oMdpQZrAJa_EYFOrl4ceQ&oe=69BAB040"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kx1vSmuc59wQ7kNvwE-AlRB&_nc_oc=Adkb2BCQ6iW1dIVBI5yCAHghU7lQ0Qqep9BRMAR2hHyxfs0FeJQgsLtq3mqlhJqAB9U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzX2Uf0EosLhX9CEa29bg-IbSC85nDG2N1GqgBg0R-qfw&oe=69BA8159"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diy6pqvprAAQ7kNvwEZRHdU&_nc_oc=Adkk0bwcLNH531B4IvBSiW50TFyBzurBylLL9dAiZy1arYwh1clTFTxhq2kDqUGtdEE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9srd9OYzKcFOkCwWeXKbCZnQdvYbtAxQgcyBAjLk_6g&oe=69BA7F2D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXmO18FqA_UQ7kNvwFxkX87&_nc_oc=AdkuOy_X7-lAH1YEbtP3ADrZIhmZu7Ywcy8a8XH4VZ7qW99i3RA7wkykq6K4Lbr0xts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS7oqsoZAnG1aoErs20Eg-VapoFAnFSLyZZjA7gmTu4A&oe=69BAB2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXqN33ZYQBIQ7kNvwGl1Den&_nc_oc=AdlHM_0suN7tUmuACnoHIiHMLwI-ahxffQN5EqYBc0UKH3SnQjrQXyAv-67Z1nF2am8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkBBmkFNfmcOrjKQ6Tv6m5Gf6ZPCv24KbUjb_y2lbTKA&oe=69BAA47F"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
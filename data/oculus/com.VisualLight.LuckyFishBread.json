A7A0E"}, {"file_name": "Shot17.png", "id": "4249616588409007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gTxAwmHRkwQ7kNvwEMafxE&_nc_oc=AdoNR-uepFPt96wSUKE77zTio02t4-go7Zv8CT4zpI3CeaSD52GmtS5FHVf35cthNW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW-8T3ewZ7hTdJA1k3FrvOAkcdNI6WyeO9-HY6Wc_UJg&oe=6ACA4540"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2ugRHGsvM4Q7kNvwGfU3jb&_nc_oc=Adra4nW7Csr6AzY17oCoAfs09Mud9ieOdzGQGjGiXoI8OkZ6nrX1K_nHSa5PaysRA-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMt48zfp_6gJAouXjeRXeQ9RY5KZ1jI_cAIUlvvH5xZA&oe=6ACA4E99"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4bSixOMVXEQ7kNvwHfkbL8&_nc_oc=Ado0ncLVj1NT8oSTVmoEjtaWPVxMP8Ld6X0KXMmzwNvhyWDutGwLgPTOnqfKnSh9H3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS6FWkZTI_LMUXMIAaDSCFuwSL1ZOxtvXBI_lty7ZmAw&oe=6ACA4C6D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYE61l6umzsQ7kNvwH7EjVw&_nc_oc=AdqTfc8RamLdWOkrum0YYCNtdh_eHPH5Bku93HWEbHvqZmwWSlJ86Ye0wd5h0ONN8KY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvUm-ACJ5tG76xEOlxiRXWKNntuJykSLcgZTGRmtBSkg&oe=6ACA47FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzXO4Uf8K4EQ7kNvwFlLoE7&_nc_oc=AdpaJLWT1KqNC4CjNAR7_Dgn16xXKCkD7OVoWfBb-yGPkg9Cva6mqU8WJenoCNiu8Lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi7ej6MRzgbaAyWAqCKz4E0JYPtpLXoYS0PELLoKNELQ&oe=6ACA71BF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL
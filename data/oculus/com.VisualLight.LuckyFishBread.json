.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEu0zh9hODUQ7kNvwFKM0w2&_nc_oc=Adkkq1fp_dfpM8_CmmwNqS5Q3iUH3HDgmvnRd33y47gUQVSFhHTrdEvD8PqwrYx4vBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft7dfik7eY4SPlKJlD9_A0hRB93d4fUL3zR7uQNK2oGXA&oe=699F00C0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaHqkSRQr40Q7kNvwHbDbjA&_nc_oc=Adnff-mMfSHtQzgvRRB0xqVCjr-Nqh7azfSOWwnBQRFbdhDOgC3TwW9p6Q0Rzupa6-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvjN2dhCfXA6cgMHsGk8pdozjoCmLvk8ZzqbMzJRC1buQ&oe=699ED1D9"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe6oEuf-iwUQ7kNvwF2GMQ5&_nc_oc=AdmdwkpsA6oY6N_b64AxYMV8zIw4QWUQtuk0be9dhkRWBajuRQ46dv053f5qbs7S5SQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs0zLiR9QiEpmzdQr81nPpvtY5PkLh2Ap1Jn5UCSYbW5Q&oe=699ECFAD"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHa3qD5_ymMQ7kNvwFdkqCX&_nc_oc=AdlK1S8b7z5-lwbAPKDoxLyO3w2h_CAgeFKsbo8yYxmJp0_FYp4wDVg2ybVcloG5piQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftEdhlO_HV1temxMNWt4s0FlaeC2QN5cL5hXOU9j-MrOQ&oe=699F037D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zqg-LM8zdsQ7kNvwFiiUYA&_nc_oc=Adl5dSzFRjoSv-mIQ4prvO9N_l0yW3g9sXgrc8855sSW7OXuvEoahnBv-sUGNKHwrk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfusnKfYZJNyDsLhbu_f-luROvic-tZvrbp7FpmbeEdxWA&oe=699EF4FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZTUtb8CIWwQ7kNvwEvAIdi&_nc_oc=AdmTYFAxMHgXyoTlQ1FunSzeT11vt67PimzTUH8Zc7bcEXDICqxz_7iHeifJXgPbtEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvgybn6AeibJVbF6fyJdeefqxaFeWAJ8ObJOzBv07HYgA&oe=69A446C0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1aU1byrLDQQ7kNvwE_uz1y&_nc_oc=AdlGLmFaGClh1PBpPtO9o804rYPYpQLwgy8IZEF93NZK1L4b5y8_OML98dtixLBuP5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv0S-MB3SWzbJqHdoSVwngf4pVFdn2FZM1kiotk74SzCw&oe=69A45019"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT8nhrJPnI8Q7kNvwEy4p5h&_nc_oc=AdnJcC70MLRbRYMJS0aq2DkAHxuQUgB00OApOPHFCGd6hewzjaMP8rVaufSuYDBl8CI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu8UodkWKVd5m6miNwPi_hyvKvR7zloF-8zWvrAgAG-hg&oe=69A44DED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS8C-D4rNDcQ7kNvwFwuZY5&_nc_oc=AdmnWA_7zPv6OnzrUJ4QDBsCV-uX9q7K3Dvjf1QCiH52nFeOO1CQudxfH29TQjKRbBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afse-bmUjFhCYURRSd_uxI_ewigawIkRuMOxZD-9Ai29qQ&oe=69A4497D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2S98dZF7_EQ7kNvwHqZfKr&_nc_oc=AdniZMOh9AlnjvPiI5UbmOuyOtRKsAY2RhHTR9j34alxTP31De5KFcmy4BZ-Qdb8h78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuC010gxCqrsiQxiUfpDCskiLFXGFfd8ajdfCYxzcQ7TQ&oe=69A43AFF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
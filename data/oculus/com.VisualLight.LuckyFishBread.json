4Hghn4TqvAE1LEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv48C3_tgm_IoXTfU1OByx7JnHahpKbZSGh_ZDpzW41tA&oe=69998BD9"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ygP5KOKFm4Q7kNvwGRBvpY&_nc_oc=AdlO0uyvkMKPFJNRmSoalr8vhNSVqgHIAtooUuE2GpbEpQXwcTqS2taeWN3pMS32GvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2BzbA-SCqc7uEl2FwfzIILDXAjCT2mR2mPHJbcIwOCA&oe=6999C1ED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcOCPAQrWN0Q7kNvwEgDPBZ&_nc_oc=AdlbUNPlH1wNWMXuBs_QaOPekRelRfXhGyEY3m_zmcBr5qVqR1x003pD3OkJnPOKxK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu45nQtH-sVGaTMY63yzgaTWnenEsykJcgmesngMGe7Hw&oe=6999BD7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpwvjfwFfFgQ7kNvwF8EY1f&_nc_oc=Adn0bcJSPdW9ezR3NPBEKe1mgh9_1wdrJpAWYYpiwY2I18TuDj-cJ3aryAA5kXPN0B8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjhVErXi5EuWFk5FC-CvwlwM5Qs6u5gfy-BazmaczlDw&oe=6999AEFF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1574389679594685"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "353237596276858"}]}, "baseline_offer": {"id": "353237596276858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1642669200, "status": "PUBLISHED", "id": "353237596276858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": 
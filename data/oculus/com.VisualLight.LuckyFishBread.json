.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CbyrN_6YBUQ7kNvwGC5XG6&_nc_oc=Adk6xfuEkTRrRrHMcesM30mGjMOd0ht7GsKSh2MMWMfowu2S9fXIiQiaQhiBUaBg3zY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu4pxqesLUyr9ju9rnan1nMQoZBxE2SDj8oOMA0sq8WLg&oe=699C5DC0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Kac2f1NbcQ7kNvwHZihjl&_nc_oc=Adklw8ZRfPoaNm9J-XgCk_rdTfzrvuZpK9bpQ762Mhbffx1mfb6s1FowCiR5sbxOKi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftGm6mQg9V2rCXmhH3tzbGi6vdJWCKIFuxsMfLt4Fbiqg&oe=699C6719"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRj7u2HN0EYQ7kNvwFqOlTY&_nc_oc=Adn7xBypY5ca1M9oM433vpfrpe0j0ca3MNi5NZ-6ZyCSAvvHkmat1Dr1L_smN7hjmfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfueTIkba6_YiBdje5nepv1OGidwfLLLNxKqTvOVi9AJXg&oe=699C64ED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHa3qD5_ymMQ7kNvwHpLtzO&_nc_oc=Adl9AgeT5OBk5NnwDkWGwSiwFKJMc16JpRq8ARCQUBbBjnx-RTSLnb54Yf0GOuH8mY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuPyQpa4Q5Rqf2uyWgGVQI-3Y8oipLue24CgZWQOkjfOQ&oe=699C607D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zqg-LM8zdsQ7kNvwES9xzL&_nc_oc=Adka5s9m0EQGdib-7aeycdOtq0bjsuMVlwsbaG_etPScJWh8vKvQwzUO_EDM2FlooUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv9tOoAfk7u_W5NRvco84EFn9cjqHKD-fMyBzRZeX9kgQ&oe=699C51FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
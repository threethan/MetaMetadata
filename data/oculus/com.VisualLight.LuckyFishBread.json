ng", "id": "4249616588409007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynkXW1kZzNsQ7kNvwG4i_EE&_nc_oc=Adke1T6hmM7a1zV-mCU5zXCUzwuf3R1O4nFsPU7AsJUqBI5PMc7qrUEYh0AMTaqOmTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwsy9lpnWWmubdRFOjE-GHf_LoqEFAh3V4POsXrTMvpoA&oe=69B2C740"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6osXtQenAUQ7kNvwGL0zse&_nc_oc=AdkIfbKfTtJ1ORuVGUBx_TkNC7EZKXRcHPwGipQ3Yd_qFsu9JdScjyFqFPkLwO5EV2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfykN9mmBTP7rKGyW4CPqIRxOKLwsCipz4F5ZyApdKhbkg&oe=69B2D099"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNKN5eGZslAQ7kNvwH5zezN&_nc_oc=AdlF93vIvsxkFHJLASiTASXYfCIzQzMJtxJnp0ABLExoFJU95cT-8ikj2DvQaDYbEbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwgHEzIgQnvI2XtPNCqP7_fEkOCW5evbazhVnOQVfyRoA&oe=69B2CE6D"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnb1MoZcu50Q7kNvwHYNyVT&_nc_oc=AdltAKf9syXaecHvFbwbSU8d4OTb6lzKUgP4rq4sP9a9_kEL5SxCcxSzItVCzOdryRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGv7Z55wmNcticgHM2nnb5kZX96-qA3b3xWxdB3nT8Jw&oe=69B2C9FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jXDtVF54zQQ7kNvwEvw04t&_nc_oc=Adlaf1AUm9BCMXYNtvM7Wt45FHHRcVz4GEUNRnsl2blCt-wIgr3s-l31aFXzFtf7-JY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydNRJ34K8BnQczriU_ZDUq-bubm6PqVbBP_34zGZyNUA&oe=69B2BB7F"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "i
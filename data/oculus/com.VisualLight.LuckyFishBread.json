.com/v/t64.5771-25/39031571_4249616591742340_5583357473719965535_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZTUtb8CIWwQ7kNvwFSwUXC&_nc_oc=AdlcS813ORt8BTJJZmkyJujCRlb0wBzld8mD-acitFD9WNiotwI24rS0-nj98fHKUns&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsmtDR0VNcbslpTYza-HiBOL8QvM_rj2WZT1-q31xdGHg&oe=69A1A3C0"}, {"file_name": "Shot53.png", "id": "560353431771055", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031409_560353435104388_6126815472265665149_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaHqkSRQr40Q7kNvwGIXm8f&_nc_oc=AdnZHVvcOP-5CF7bHZp5xYnxrt0L5X6V9u06BvTfblNlKgrKuBg-ppUG7QSNxSUvmw0&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu51bnPbz1mLDYnrFRQKYvcBf22NbY5Pm58Zo6yhiPScA&oe=69A1AD19"}, {"file_name": "Shot55.png", "id": "541284177142637", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75236136_541284180475970_5326942898497813380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe6oEuf-iwUQ7kNvwFGfjj-&_nc_oc=AdnNVUYIB6lP2gIwPrCpg1aP0wUOixb899uI_c3epU35TzRz4ypISrMx3m77LRGiTvw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftkkaYpi1Ju5HoPRau1ks9UT7mwuOkk2EEyvArb7Pyf6A&oe=69A1AAED"}, {"file_name": "Shot41.png", "id": "1218613585273184", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035456_1218613588606517_2581843221913978408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY4yY1zrXjEQ7kNvwFvv2ON&_nc_oc=AdnO2i2rIFcjSxcmFuWTA5gMvtm1uabjyju6vsNxLu1f_PiRUplkUqVbKGhjgBtLXiw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvt8o8xUcnnyp99m7Zq1bXkWV3mYVCogOSnTjv14SfIgw&oe=69A1A67D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "190574249719254", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031540_190574253052587_1555672340047594305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53hmzbpVnywQ7kNvwENVTId&_nc_oc=AdlX1Ck2t5D7zid38_5GCPd5HLisGfIKWEBiGWrhWmOlNgDARmT8P1V0FAS7EUsxgZI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuwSuhht76ZaCF02-1VoujL74m8obYXHcZ3ah7v3nlJfQ&oe=69A197FF"}, "display_name": "Lucky Fish Bread", "keywords": [], "long_description": "Welcome to Lucky Fish Bread!\n \nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
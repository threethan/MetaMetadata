0-22.png", "id": "337739244568730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8SuS3h2kGcQ7kNvwFBROGX&_nc_oc=AdosEP_wiBzqLbDu4ntzz0DopxHKhJZa-ua0_0SHoS-uPSRb31e90R5C6c8u9PtWmWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_RI8xP_eUAXvkU52CpKJaWx2rqd39J-ZWhkFVkro1BQ&oe=69D264B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnUEQGALuo0Q7kNvwH_MqN0&_nc_oc=AdpR34F_Z-pAEBwO0Ee_4gdZtU6twL2pMDFcRks5lGD8L11iDNmKktmj0TMHs5Lr3fw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F0H6tXrXPW1D8fdWWdTt2mKbBWHUvJMjV__XBmN_Lvg&oe=69D25814"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV2Q-MmaIsYQ7kNvwHN657-&_nc_oc=AdoCTa8kDVvJ2IFOR-7JEmcaFv3dZL2eOA3YpIEwkDoxrn58fFvbV8X7wE3Ak3m7XGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LhtJImnk7GVy-N3DPJzeC5Rp4iGpJTaA6TtVvMx-Iyg&oe=69D25275"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgGfImeqoRUQ7kNvwFsWqIW&_nc_oc=AdqqEds3bFrI0-HQTEO8q6AlgQNypS5BJrCoQDxVhulJgfMMvRSQEzQzD67AQ41KRhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26mECc--hCvAl7bGg9GqFFGz_MS3dSBjv-TtR5tasFIA&oe=69D279D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfsUawfBQr0Q7kNvwE06Jkk&_nc_oc=AdorPrLvkiPBwCGS-DSSE-ltH5kE74A8NN8DdzXpRvh-tU7tkB6YQxrtHslSFRq6ZYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d6dxBR6jP0Bkmqmaz-AzxcI9LFiq3szglzbcyRNYPhQ&oe=69D2553E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
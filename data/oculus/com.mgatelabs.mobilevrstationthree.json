-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIJ4J9EXwMAQ7kNvwGsL_-a&_nc_oc=AdpIl_4l1q3Kmc7bI5R4fqR5hHxybwAJJK2JyPQRfTCHct0vUOd27c_0vGWFr0WVN-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaz-LAysE2rjhLt0w3E409QiVx01qXg5tCIYyqK-uWPg&oe=6A7B24B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlnRx0Myj4Q7kNvwHeKoba&_nc_oc=AdqQa0u2jEzF2L8cFt2c0L-pc50HXtfL29kHYkjU72WtdNbaHA5O7b4_df1GIqf4dCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_ErmNVPu_4ftc82pE8qSlkrijjRqpQBESZ-dBhn2V4g&oe=6A7B1814"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6sH48Sy8AEQ7kNvwFhR6At&_nc_oc=Ado5pHdvyrTKk2A2JmpxbIYnCQuU2xK4yEcvfGjGZFnrrQOdllpfcU7LMTGJ7UDUvIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoZHdoS6GTHAvdjqiSGh395F9AgFLLo527AOWjp4TmeA&oe=6A7B1275"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOfK4hQ41-wQ7kNvwEUiNMl&_nc_oc=AdrdFGadBrbwAjUyumw0U9ooSQj7F3bhlhlVTzk3Sqg-tDhJN0GQyyRs0JKUQv6F48Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVf3fXuN4CDqv1uOJ3YMf6jUf1knTmlmwLOeRzpdTIEw&oe=6A7B39D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5cSbwQkGe4Q7kNvwF89DJN&_nc_oc=AdpWTeUEfCF6v-ljkx9ITMPWiVD5bDcXQL5jldARX8PbGs4BAMx7ZhhYjyqBPV0PvYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8tR-v8pdu79LFI5ncb8TUQES0DvO9_eJ8-8IQNqwfVg&oe=6A7B153E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs_PRXqRrLIQ7kNvwHUTYIW&_nc_oc=AdqZulpqg-Ptp8kYToSekvm4FM9furYBoi6odeDvN2LMTqiQtBKtypqsm0NRiLDmrJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv5qlZq3ScVrtOoyWwfQuTKQz8Mf0PyD-C7wIGXZGJQw&oe=6A903CB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OIJP8qfMGIQ7kNvwFqnKWA&_nc_oc=AdoFoZuDP4r4pCumnfXgqRfVuICfNGGjBXwjC5XxxV8ttmNuesN2c5mrqyTI-x14GfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_TnSrqR9GVjQubCZKUjgdK6sE0tTq18GGfDRQhu7eqg&oe=6A903014"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqpKjML_OwwQ7kNvwGrxd_W&_nc_oc=Adr1eMaxLzmqAVAsoFaMiaNu3fYyMWibS_IpxOUsZW5aRwyr7ZnpSC2zWrrsH6l9KRk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu8KkbS9aEgsvKaNKK8c251hz96ELLI-NKah3UXUB5KQ&oe=6A902A75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3veajEq2xYMQ7kNvwGyTfmz&_nc_oc=Adp3ooXegjUIcwH4BGJu1hjCmY2nlg-wO-kg9J5velC2f1TAcFBxN3ANfx_4iYZaeTs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaWGWLDZhb8Tp1bXiLxgWqDZswU9RwZ0tP0KvDXwpbyQ&oe=6A901997"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wBriO2GdooQ7kNvwHd9hXd&_nc_oc=Adrl7F6dxaXP7ZvBGbxPsMltICWryXIE0pxSDWOksiB63rNWDG6AjG-0sZ_fmm6BuSw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHmLzxRdU028xmlQRyoCAm4PgpvYrDh8M40yE7B88Kwg&oe=6A902D3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
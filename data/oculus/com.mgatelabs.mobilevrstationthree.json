730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnGzoGmXHGcQ7kNvwGb2hem&_nc_oc=AdkHstfABChg_PMPuYwKtAXUTgm9yB45OBen0Z5pWXebBRkVgvZ-hOZGkH6IMsAItwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIic1rmaTFxDdJMaqyzMAjzVzdDzuFfF1yHoG9XJg3Zg&oe=69BFEFB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goUZ0weWtOkQ7kNvwECjoCf&_nc_oc=Adl3nQNAaCbTUjdhelnS9yeyD7dOK7tSRbmIbnMb1dE3aewcxuvnOGxzp29c6nDcxiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc_bWQoHXyLN-d2V7JztbN6BvBEBgTMwyqVhoMIr_IKg&oe=69BFE314"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Majpbn3f8WoQ7kNvwF7eI0Y&_nc_oc=AdnbEYCwQyYxcJShg_udiWqv6ixf1jsNvowLa3sGaJf9xqiVfeaH1eCS1aiGMqX_6lQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5gMDquFLfkMynEt5m_jic48NOD8vf46o6ToY0U7O0pA&oe=69BFDD75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5QWbhDEyuAQ7kNvwG18WMe&_nc_oc=AdnknjhL5WbAvM6AwEB-7wnYMHCVtw-9t3gRcgCnDgWBRFd-VzIY05fjlZIne9ww_Jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxThPScK9uXJi4ct0_rII-kNyIOizRJ7uwcoueMvl9R9w&oe=69BFCC97"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35neEl4SrrgQ7kNvwHfCN21&_nc_oc=AdnjNIO_T3O2SUD7Rgnkf2klJZ7t7Ls8ygRTgbZHCEiPzyr5CX7qhh_qO81fb6etafQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0UZ37qaSrdfR_9wWp0A1jFiq3PwzOT2lAUytf_LkZHA&oe=69BFE03E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
-30-22.png", "id": "337739244568730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abMjKtoR2-MQ7kNvwE7rz0P&_nc_oc=AdrKJuJL7uJl5lMCCKlje04hh_K8y8LH8N4II2QcEboJ8B1Nu3Ih3FSMAKFlwruW7KQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSUnk_tu3yH44IDI9yLfluI_SGRd75At29wtvxNQ2K7A&oe=6A9C1A31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dQa24OBIzgQ7kNvwH1ZKbF&_nc_oc=Adoik87c1DahJEk2kNno65Nb-uOqZ-Axs1LseIhLmW87IQpHeAAnECR5UPPMQDLDDKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPIKpPicchG4MV6WXwSvy9vPRkLaPzWrLF5qF6-g2lAg&oe=6A9C0D94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLG5duUJ9eoQ7kNvwHk8jNs&_nc_oc=Adrk-SHfUL1-nOYNEpMnYL2zBHay5R_XGmEmjQOTUPjcgaTjmOe9u67gsPeFo_C2PSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLojrWq8slkkXg-aY21eRIIJs9skzVLSVgQAN-VivkUGA&oe=6A9C4035"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5x8L3dvQmYQ7kNvwHYAwlO&_nc_oc=Adr_crlATMF0u-D711MC3KOsfecqXtpmzHo08A00QwhlEKFd42WxLu4HR90P3KpcNQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-K_v6CuZFs_TGzbk7FKX2FjGxURaIxnNeUrZ460xsIA&oe=6A9C2F57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRaELpMZPO4Q7kNvwGGhPvn&_nc_oc=AdrvAB5gFZBQrOi9RLIGQAFPnOm23Do_NAkW1mEfpRNRv0GNivuMMiw9ohaKtXaLeSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8f-gO7yUKErZ-eS246IJeB1ovhhn1J4AOnXsCFrj6JQ&oe=6A9C42FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQcp8gAURREQ7kNvwGbQFks&_nc_oc=AdoE8bS4sv6NUalqd5YUSO_wD7VCtJsl3m6pJVfi6c7aodKSLOQuMsVNfI8IemwUlqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6-KqpriRIQ6WbX9Qn9y_IWxCb3Z8deqHxyCtcBCfyFg&oe=6AF89B71"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CiU3PLszlsQ7kNvwFIxP2W&_nc_oc=AdpOqqDaApzdLhLOMFisRI3FZ9QQLU2wwOib17SBS33AsdW-RLBComC23Fx-VXjjn9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzdUAsSO8z-Ps_SSOiVKPV7M_-r1XmS-LnkVIowbRMgg&oe=6AF88ED4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOzSAcjtNGQQ7kNvwF1C0k4&_nc_oc=AdpDdPYxTMspLzLIw5M8VK_Ky17iYGMAV8klV20EEzaYdGBRn7H19KB4xbM8dXgjZao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1XItlmREIQN0q8Ce574V1V3ZzupvVKYJWswJKGh7ouw&oe=6AF88935"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbTLp8gpbXMQ7kNvwEoD_lS&_nc_oc=AdoEi5MtUj-BU0oGPIUrt9ZnHXBCFZYk8YV7lTe9s5QkFW4yYBsIJkjFlTGRJlQRrNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqYmXcolfGJKTEXEER_rJCGxXCwm7Qjb6aKzpZp4iw9w&oe=6AF87857"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u20S6lVwREIQ7kNvwF8AXPG&_nc_oc=Adp9G14_kpWIl67dpYz_NZJoc8F0FALYzWMH37PJOVSAfMJW8YTAtJO4Y9D-JFlyt14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC9pAqLlI2KBNUUBeFfF20X5IsqjeQwndzwSWDTE_ikw&oe=6AF88BFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
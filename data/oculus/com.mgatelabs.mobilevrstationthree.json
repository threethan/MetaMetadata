71_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej8LgwTMweUQ7kNvwGXgIsZ&_nc_oc=AdnVMlrCnqtiYW1xOOhU0kp_Y9reAS2U5JiygsTCNFzLZTLrERfIYbPGOVKHUWmU_LE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftDnDmPhJxjAx584uL6nI6tlcFExV_ok8Eu5Lo9pcFZbw&oe=69A591B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hYRhDqzpBoQ7kNvwGE1Qpt&_nc_oc=Adkf0azywd37wPiUt_bwiq2TDgsTFs4lYORA3oxOS2r_PPbon6w8WRFQzTgvqlaLrzc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvHUyxePcG0fVkGX-4GXwwDb9GSByAcNqQfgub77FywrA&oe=69A58514"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOij5gyciR4Q7kNvwEnSwYZ&_nc_oc=AdlurVkm3qLnL2j2sLwrM_ppA3BeGtM0lKfW31ERtNCwa0yHysPZccq7zlpj9FDQqM4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuUz4eWCsDYkbR-pfUg4075EFk87r4uBgFWKgTE2tS2Eg&oe=69A57F75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmaRowZmDjsQ7kNvwGvlwWs&_nc_oc=Adn_NPgXb4QrTV-p4cLW-mt8Ik_VhEjMgBXjMlKuXIjynv4fYVIxqulizsRSIo2GSaU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftGlXOJPnQ0X1LAYJ3LzKHex5biZ2Zbqk1ZKlJ1lg1RlA&oe=69A56E97"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0-0BplnHGUQ7kNvwF_YDn0&_nc_oc=AdnBfYLdSCV2wc1ymV4wkIi0yFjVV0vEQilgn8Y8Z9weww3jN44QIGghJe-4PGrdk4w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsQsHcII5sY9R0V9HROirqfpbZWPXn-GkERgCND9Xgu_Q&oe=69A5823E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING",
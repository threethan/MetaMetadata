-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CizGNZvcmSoQ7kNvwGzYfsC&_nc_oc=Ado2yEzgDRf2M5AJfYlKZ6qyehB0UFiiqFJJRKExwNKmw0bgyuNb8lQthXLlgioQrJY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJM95Ze1Mz0xxnX2cVvZs1Eq4Soxj5IMniMAkK8Iir-Q&oe=6A870231"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz-OHRieY3EQ7kNvwHSWwmS&_nc_oc=AdqAHUTKps7jHIG-N2QWVNdSgVMNqB1yOddP8p9akUjwnRenfHu2xeH5FAj3ETeZtJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQl2xLeF_xkT07WsTBsELbINL3ifI15Cj0JsdkFqJStw&oe=6A86F594"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiy7dqtnL8kQ7kNvwGzHg3W&_nc_oc=AdoKBxL92jbbUfNIDzQm1gU31_Eyt91u0ls9RYt6pglA1S9SC43ROfaQZcTb6orO3QE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFttIAe9rk8yHIFLCmP7O2BVgVCPwLE3v_LYhln1SumA&oe=6A86EFF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRJLu85T8CoQ7kNvwFtQv6S&_nc_oc=AdrozcnxCLoWouQ7giziwLq_i5rf6IAJM9sXYS1t8hbHHrbk1M0eFoRwRpksPtHzbiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgXNaQwpA2Np1t2ZfUR00UtTSIgfoaGqsP25k17aAW4A&oe=6A86DF17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaIZs-Bn5HQQ7kNvwGh0m0l&_nc_oc=Adq937eI8PbT3qLP7MDZWl0yZfuynevlazHOt1BVvSK36OlTmBU6ov5woZqA4kC5_Rc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoO08S2a_DK2itaSeKmZsyET7-mgKT8pVNGqiuvjGGlA&oe=6A86F2BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFnMsNDeYz0Q7kNvwES5SCb&_nc_oc=Adq0hDll42xX16C_4wtnOoCm_ScDu8FMYq0wu0EKxmTWBjPP4QKfaFaRCiXQU_pbi0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfkXMAbchTfSklvT904dxH-x7kEK2FZTdQ2rLZGKoiyA&oe=6A54E931"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImPUQO19vTUQ7kNvwEfmU_y&_nc_oc=AdrmMOexFOCbUS33t1MudewmnJDpib-zHCOqdLw0vbixug27C4z5GL_XBQLMkpQsYnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHN0WwBWO1GuC-NTIsbrD_dp8lLoLl1Gcn5zxV_bMtEA&oe=6A54DC94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIo-dNwjLi8Q7kNvwER4rwk&_nc_oc=AdpsSrUImiBFgPAKfC7RA1DMHlJHR4b1nLtsfybRNqHwEVVvUZpzSq7NxHRifwDPb7E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR5jFwX7KYoHva7dWEoGgcZsO9WGoD5hxzm8vgtYrBvg&oe=6A54D6F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPwV_EIcXUoQ7kNvwFevjRC&_nc_oc=AdrkPvJJ_w6-tADqVMr_HZWuPKYU0u11Mffzupbp0VVwdIO67TKXrymhswCFJ7MzWFc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUJzxjhLnzlSQ6A92b4HWE-S0eVX05WM6pMhYYYIHC4g&oe=6A54FE57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5t_Mpm_J3UQ7kNvwGa121w&_nc_oc=AdpcnM_Qc0UsgNQRhDLOMe7cbzTWJw-8t_mzzOpDAhvt5Hl-qKE33uslTbfth6usTOE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ7YMhrS44VFFatv77myel6MGzSO6u-xGO1V_5VneYwg&oe=6A54D9BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRWXoXBJ7ugQ7kNvwHXr6xr&_nc_oc=Ado3evrjlPzVwzr4_3e3mf25msUlLMWXnM02ixsAODgvdTlWyLp-uhmesrhPVih_OwI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzVXD6g9DnaGjQVa9fUH0tG6KrRcnpNtiEnp2lbGTXPg&oe=6A943131"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVpryusfoVsQ7kNvwGa_CQs&_nc_oc=AdqmxjNkAP2bywDrbP9eQo1wFEa66bUEw-PyYIBbFPlNoWOsqqcAiFdEXYuVPy60wE4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdZBM490RpQzflC82DZCWu_tT1u4LaUo4ydM8eefbVRw&oe=6A942494"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw8585cGuHIQ7kNvwEITS-G&_nc_oc=AdodROKzF_XZnsnWN5eq7kdC1f3cS0Qsr7rzfJL6m5OZjjaKshFx8elkLe3nDu0sIBM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHff0zMqxc7BjZydWFDUSovRf2CG8EGZuR3V2LaIqxB7Q&oe=6A941EF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W1cslfLfRUQ7kNvwFRWLgh&_nc_oc=AdrSoTqM8AN_0K_RhfOE_EMTT_deavA0QYCHOE-d6tsNHT3UeP9L3izIcPMV06TBmo0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUS74pP2TyEPd7HFdylEarE-tBBRrghIlTwBYUf64O_w&oe=6A940E17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GmNuUgcjzkQ7kNvwFxLP6G&_nc_oc=AdrISQiu9_Y2nzqSpBGGXTKuWzEBYNCJFFac0hHdcJz6zInUYtJQk3NBa3wJ9SEgpwk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEetUp4SEwLPdw2arLNhUdVOcg8vx3Q0b0C2XfbCzfCsg&oe=6A9421BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
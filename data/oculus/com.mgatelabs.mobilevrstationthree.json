-30-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dhd2VpFJts8Q7kNvwE9xoD5&_nc_oc=Adp_51u2EakAQWGGJioYA_phYTziNyXGI9gr2W3RX4EDTiGMHBmsfzFp9FqX59Oarbo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WrSMRGp2MOT9uzXs9w_M4-2TffeM62fTGX67AcSPP2g&oe=69E62B31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQHMjbJqo4Q7kNvwFjKh6b&_nc_oc=Adphi_RrkejvT3kM1P8daIOzukE7xjCaNgCmmJcmcGrYxPupAgapuB55hWMC-6xsUxw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19hKwViEr68a8kV7U79Z7esRNLgjlcDT_v3SQCkNaeAw&oe=69E61E94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM5iPoH8mxsQ7kNvwHqu4IW&_nc_oc=AdqX3GsBmrVVOzukiMMAbXaSdFpWVHyq_lmzdAJUF7E96W0Yq9gaDP5U5z9YrNGjxMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Yxo0N2i9slwZ61rmXhF1hZw8xAHmxxx8vJZ7cJ_vKlw&oe=69E618F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQkhnrMWuhYQ7kNvwF7mnzN&_nc_oc=AdqToWyVOsGbG50ORyjJgLElQq7kI-KHJMlsKzVpj2EVLOYTmQhtIk5mMwgzRPEv0Vw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c-t4vLgxekEoSjEu9BIX-39sZ7Q1ElqIyCSunC4OjGw&oe=69E64057"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQWeSmehbSAQ7kNvwH0Bz6M&_nc_oc=AdpjNYqjqGR5rS3TCr2ZZ3JoiQPgQRs7d3X6Tn2uDj5UZCnBgdWRKwO6HC_EEO61tVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lm-rGBVAeJOylN5uTqTJbIJ5lpJmfvX0zI8nAPeBNaw&oe=69E61BBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
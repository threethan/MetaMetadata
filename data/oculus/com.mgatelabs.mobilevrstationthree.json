-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bsvFzaIw_AQ7kNvwHfGVgf&_nc_oc=AdrWe_NfatvvA6e35HQ0A2DfARHnLwvMTTies2rSxvGye5r3qmLCAuAFkLBc5GSiGaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbLUsP_mPtJReP_0yxxpgtE-nwrNRQCf7KyMqC3TjWHQ&oe=6AEB3431"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kRZPkBzyOYQ7kNvwEEaPWr&_nc_oc=AdoEmjeroPpamLJF0q35_frpl99gBNnUY6tUIUwIXKoJyt7lx-hRiP1id6PwBwQcCu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWARAcpY_VxxMIbCNksaDvUEe1cU5BrNmwU38I1klEBA&oe=6AEB5FD4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1x5kLqw6CoQ7kNvwFN1mFV&_nc_oc=AdpD6M80S8QOUtz1GHNvcdTzSzyHRywld58Sb8XKU1WTralCafB7JOikPcKza-NMF-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ4nhY99Dw7hoSat9ZgFtr7ByPjUVfOhMt2IrMZLzuXw&oe=6AEB5A35"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIkRhkbOS74Q7kNvwHrEE7e&_nc_oc=Adp2MY9rPo5i3b9HrKboyN1x7LsFZRBOyhKf3aJhak44LXqWqJCyanyBXoOtIV0zjEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCaVDGJLsllBiXbcq-EIHQZ8Zj14y9Qe_oaEe3nl2kGQ&oe=6AEB4957"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2Y7qSnZbxIQ7kNvwGRWHhy&_nc_oc=AdpPnj5fCvJpE6rddWJnB0yHRV3WkHNU52k22wfeO10BHFtggKA5L_5sMvEpEIJeZHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHzFuJk5enOofpeW-IABE-4ggP7d3WAOw5k-r_ie5lqA&oe=6AEB5CFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
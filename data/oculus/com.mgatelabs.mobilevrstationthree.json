-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs_BfaIDtRoQ7kNvwHZ8NG8&_nc_oc=Adr4gW6HmF4Xu36pYbarESYdmxJ3T3xuHP1AVGp7KWJAvyEAxLx7ygfESJx1KqCrVKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6o33sXleOOBdDX4j6ZlTw8epiQItUfKWjBoOgSe_bsQ&oe=6AC64A31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFzmR-TGYEcQ7kNvwEDO0uY&_nc_oc=AdqqBz4YzH1GjEmF35bavNRRpX2-YYLJ8yrRX1NJ95xi6xQTSgYocD34IZAL87HOVtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPexaImAMlLMCQjRMmh95eVlPUtGzXFQ22p9lIMG1_3kw&oe=6AC675D4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQZRZf6YP8EQ7kNvwHZ3rAq&_nc_oc=AdrD3JgtuBFbFaUVULmlygkVHXy-0oUJcvj6xcHv6f5sP5lhG1xJk_XRDoN59HaHn2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvDT-wDC4TfZHaRUHUP3xPFa4wRsqmv3ucOHdfl8CN3Q&oe=6AC67035"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4hkndE52skQ7kNvwG6tGWT&_nc_oc=AdoWL2RsQqcxqYMOmh8IVXSdpJ7vcmsfHP5e2dRVYd1EJ1CY9HuxBQYwtKpzxISvJr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKE3YqQoV1wINqdTnNmZIkQghCEMQ-V19WCQrp-PW6Sg&oe=6AC65F57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ7pMk0DNzIQ7kNvwFBBHek&_nc_oc=Ado1Bp_KvpNNYBorj8zouuOc0Uj63KRXTFp4yOSLyzXek4XykTMtnEBoZpWA0DY9ZnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOSsZ7Jswm1-Nrs9c4hWL6VeKFe_azXggSqWMxUiXo4A&oe=6AC672FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKKX7ItD7IMQ7kNvwHRmrSY&_nc_oc=AdoDJ88vc2JV59kezl8wUdvCkakCs5t4Ih2uLm8eqvyq0CZ4jV05fCIyRu-rPZtw5uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtJKLN-cbF4o4u4e162w3eeEPyzacHh7bnKYqT7OfnDg&oe=6ADE0531"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8coPfkZu0gIQ7kNvwHWktdc&_nc_oc=AdqK38sNP6EItxdP2K9KUqD9HNHIDFEBN0McUMnO5Oyph-QxXld74S4ozCIYPNA0gOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXAfCW0H471TBNLpbvMQUEwEt9arfD8BR8EkCtoQjA9A&oe=6ADDF894"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6x_Tqi9P3sQ7kNvwHIhWj6&_nc_oc=AdrpMwn9GUwQ8CgoBUTrJhLKFJffZ0ba1yEtoRj1u9mV5GrqSQFPe3B2RBT9fZxFmjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONdjGeig52UkdgnJTRErpwswYwrHhXxcl21fWn3vOBtw&oe=6ADDF2F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q59WIlUF4QcQ7kNvwEalIAG&_nc_oc=AdpUUJZazxIxoHpKYxEoFcQ9sh2R1jAeu5UOuGRG0QQmO2ynG7q2rr75_UVQI_n4gqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPasXHuYdnhkrmbCn93Id6cDHTPr-Rgswhgb2MHV0I3sA&oe=6ADE1A57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIUQCLRgMOkQ7kNvwHt9BaU&_nc_oc=AdqOKNCrAvIVBAv9Cg1xUOJ7e7rLv1QLeRnBWqQu7pV2Jdk8-dSVncCfQRAV2Kk707g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP7mckSvGXRLSb8NgbkdHekiL0ASVrs2SGm-Qm8P47yA&oe=6ADDF5BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
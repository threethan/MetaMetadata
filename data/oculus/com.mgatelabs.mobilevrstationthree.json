0", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAaFwJC4U84Q7kNvwERIKuG&_nc_oc=Adl8rUHrrudIH1IJ43kBKWeix1TWMQWmHg3FLwpkipTH1pCd2v2W-l7kIfpCoZHzQUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGGt_sPG2IoJ4Smy5fmnF2SsqAEiEIqjyD4lKbigHkpg&oe=69BAA9B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4iPvEHWangQ7kNvwHznz7D&_nc_oc=AdlgZFn2nVwRliw6wOSufej7qu3k19aY5--qiH4AR0HSX7Jarp3SM8iCthdWi3wLwWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKwEuXIQZTK7pntaWLuQFpcFMYkBQOsUzs4_ccFCcNrg&oe=69BA9D14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imk1pkIOvVUQ7kNvwE5AC1V&_nc_oc=Adl1dd6GO0o00ztnbLUlqDSKEuaHbCBY6vdQWM68xprJA8a_VVFc69pck3WCH5jkdKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzP5w2n2B_AzIxHHTlRke8biaMHut3iPj5_bZvh1W_9pw&oe=69BA9775"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp8UIg9RRqgQ7kNvwG15jZ3&_nc_oc=AdmczQErQHlSPla-SKYr0eZDwEka7sCxk4SaMenDrlDTMgSpjVIBju8zKABFLFzHC9U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK1SkaqH5QhF1YX-DJPv0MAuPyr3gO9b9VObuy6M4QLA&oe=69BA8697"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2enCejR3WbIQ7kNvwGIp5ev&_nc_oc=AdmS-cUSktxcg0Csu5qi7FUD3JX_akEwr8X2LnfN765cmKK-_iKvCk2KjYyz8C1dgvc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfySCV4rFQanl5pFAS9bulbfQOjvAOQPrdF50dp3QkKXAg&oe=69BA9A3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
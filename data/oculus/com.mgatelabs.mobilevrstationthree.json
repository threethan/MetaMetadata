730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnGzoGmXHGcQ7kNvwGSbjNS&_nc_oc=Adrynw4fxrltYNN9Be-oh2g5YTVNZPKDTEo5HfVme5ScIt9CKN-FHJodGc3BSZzAgdE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLmi0kSGnQlV0n0zXUmxYjrrHAQD11zT6bLOppptUfJw&oe=69C14131"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ2D3kLhqd0Q7kNvwEJwjib&_nc_oc=Ado-2fsAFCT810ecEOdM9X3CqxNb38Ckr50B83C9ydRo9CwYxF8QCFmGkzGz7Sxlctg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQNm3R_hRHDK80TYBJnz84pLYc79kZDfMG6lIa7JlYGQ&oe=69C13494"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Majpbn3f8WoQ7kNvwGAeUxD&_nc_oc=Adrq-nUOjq7d4WY0T_HHKj_AU4V828-136pb0FgHmfbvI9oIz6raMqCi93uDTGt0gXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYloUcOQpfTEh3yXHCiiusxU1bfUrcNn6MmWM4ciX4NA&oe=69C12EF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5ZVOF6R7SwQ7kNvwGPky3m&_nc_oc=AdrS4vC6Ll6faAm1d8aar-SSG-t_9eyFJymaX_yWHkY58-2y_jeEP2G39fcoDFRIDRU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4PivRaKbt43a65AFIsko9MdRHxx7mk4ng6s1pfaSolg&oe=69C11E17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35neEl4SrrgQ7kNvwEqm6Qk&_nc_oc=AdqmjY8li66XEEUcluxvtY-Qvszo0VregUCB3Ut02kw1opCwfkZxYhcWbaq082rtpqw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwl1hS3jhM_YPSEAGfmyIcMrLxNA71hB5mgZysGcnQuIA&oe=69C131BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
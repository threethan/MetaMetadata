-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5DxuA-SDTUQ7kNvwGCaJe5&_nc_oc=Adp7ElG13zBKU_GQYdA_srjkDoOmbt3ZsKwK1MyFL6Q9D62v5cjixGknevo2UyNCeck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YXo6m0SRyHlSPdz0W_LtTBspUMHC962VR_tIUUeve4A&oe=6A217EB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfkN8WO23rgQ7kNvwFOueZC&_nc_oc=AdpXIzl2vgW9k_HzN6-TSTl7oHahRmJLNnndsWauRuoPNO25L2p7wh8rQpqEETEcggM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UySJfIli7g2Y1LtOqC4JUaqfCJABibUtB6ROYQ6GBOg&oe=6A217214"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE5DWN3Z0XAQ7kNvwETr3N8&_nc_oc=Ado0p99eXtb-UTBuvnkOGUsp_Q89KXRG2hxXXyatcCaSLDJ3n_kXM8pBB7lq5pWLs7c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I7sFay503ZvRYW-Zsx69n1BCuiAvtHcC_Glu2q06Eqg&oe=6A21A4B5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp8ZwHgSPKcQ7kNvwGXIao-&_nc_oc=AdppTMnD15p9Tqv1W6H0zzlkULSS2sCX0h_1iwTiZREl6CtEStsprs8FPwRvdJyZtAI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VTGxITI-yz4XQfpQLpMJisxQe_aj3t7yvsGQR0q5GBg&oe=6A2193D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjR0LDzBSpgQ7kNvwHS79L4&_nc_oc=Adr3Rhu2IIr5Qkyvur5TQaIT3YsdHe3nreF8caIi3osKTTB6fI3lsMq9eODzmB-y_lE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87aYFXvR58RKNuc9jdpUZ-JZGs7QT2d1p4CyA4mMFDdw&oe=6A216F3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i96p4gYtlB4Q7kNvwH4HJoS&_nc_oc=Adpyft_xc2RO3eGZE1_pSz6PjGsGTNp8YJ8aY6cKDIl2Oic-8-pCHZ3eUJ8cQJD_3A4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4hrHfCksCbCmg9hM6w4pJl37cfmBEnStyM1bBK4Pb2w&oe=6AE0A831"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8coPfkZu0gIQ7kNvwGli3mS&_nc_oc=Adp05j4wNNUidU7qaQDkpAsnDj7_mSQLujuOcioojSCP7uAhVwRdqZi0X58LBnB6v5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOljlcPX4fDpCWGIO87OV_hGYQ5EBl5K3GV_Y-fYQi7Fw&oe=6AE09B94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PszTiEkdEocQ7kNvwEzKn9Z&_nc_oc=AdqTlSNhBo_fjKpVniUp2K6KFLqvIbYttOUVY4ccIkr5bvFkFZK4rEV330-RIgmCKWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIvvRI3TbkHRmWs9IBsa_g5PIREijFVK6mXVGxRSFgEg&oe=6AE095F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUms6Dctr8cQ7kNvwGJ-NjO&_nc_oc=AdpFCrKbHb3vQYXqX-k7KACBbPvTlpInVApl8W12Cpz5LU4V6SR5FeJNwPajRvwGP_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHvyyMTJnk8g2Uupd7X4aajOn-dxNHGMQvY4FPK6ZVHA&oe=6AE0BD57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmIaekYkqekQ7kNvwH_ALvV&_nc_oc=AdokbKUMzZAO_4bS_e7Q0XLgZGtz9Dh3YRTqR51LuFyYFZUQwsxHpiVH7MpZo8UW29s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU3Fd-ZYCVYi5rYp1TjQObrDpgbabAHZufJs4mmTaRbQ&oe=6AE098BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
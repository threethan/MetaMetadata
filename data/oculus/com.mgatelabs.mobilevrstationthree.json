0-22.png", "id": "337739244568730", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgTOLtD8G6IQ7kNvwGZ9wRP&_nc_oc=AdrO4UkBJ38T9kgBdkZFng3XalndVuwh8XVsQDH9L9VadSojTlum_4T01ImIxFuh5sA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgTNlg6gKR7ExE5ZgrGgWh2JXGwlzXuZDvwrmL7Glqrg&oe=6A81BC31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB2RECgxNNkQ7kNvwEEhcfy&_nc_oc=Adq7Zu_kGQZ9u68rq55We03CGhyvsCixGIRQU59-gF7dnFA3RBKE0boPdAklNtMkbBo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgulssTyCKSl64GKNWdBxo-aku385HtybQD3st17vzDQ&oe=6A81AF94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSkvacZGipMQ7kNvwFyg82k&_nc_oc=Adr7Mnax_rxk5N7LmxM4V2A02_EchVbM29Yc2ssN1WiAOnYqud48RekodgH3WFyOd88&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw_c1aCLW3oCv6SUx-HFbH0qA1x2zD70DTjxmdha4Mqg&oe=6A81A9F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2ZoP2Y1v5oQ7kNvwEYBIjA&_nc_oc=AdrDq3oC5vFo-51RMbicZA9-KlJYOYZnwEe4b-wGePzdhUV7_xuTnBXseqLS52ZVorc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR4yyphAboTLkAxLw5jdfm0iZKyGiG8qJAfSi2MLTg7g&oe=6A819917"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTEGDQwJd1YQ7kNvwEZuGur&_nc_oc=AdpgkTy0HolkB2K_cjbxwtrlQ-_M3dIEoYkoyvgM_C_yl0nyT7F6vWd5gvi1dUfUTH4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_KPVGA6nbV1xeo31gqEcq5NyqM1RWn3fdnARaCykEXg&oe=6A81ACBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
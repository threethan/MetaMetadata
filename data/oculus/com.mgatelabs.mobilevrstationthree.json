0-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3zOzU0PKekQ7kNvwGSNPtR&_nc_oc=AdpMpWUhC9_REJOyEqn4-nurWHvG8EUzF7ZwfaLxsmQrND_4JeN1Ws_Uk_Alrd2m_sA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjY_pCNHM6zfli9j5ozLKoFh84G8g2Pj5U2bLV_PzgNw&oe=6A733BB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-po5osSW5IQ7kNvwFwjxQn&_nc_oc=AdrTAPApSteKuG4PeVgu9UIllQAZxcb9_L7-m3bVaq-eOkgtQU80qBK0zXXo8K55MPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmgqH5SxpIWUwqGmvuxoNHycvfm68Hvuep89EG8M5Zhw&oe=6A732F14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeooUY6wDWwQ7kNvwHG737j&_nc_oc=AdqjUrRSlngh5RIzqLq0pLh3848ToL-3gr4LFYlxlsMgIUbrIj_LQI2oeBhABMO6ibk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6oKZV1_cst3TeBXVAn_LNsz5ckcdRjp1lRmVx8ThTYw&oe=6A732975"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHfce_vX5mMQ7kNvwFYYsUR&_nc_oc=AdrkolPGdt9irxG6fF9_-ydwMgGiHvHhJO0skH-Rs-93tNGZHqd-2JslAwytE9m7MHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGap-FloBQ4G4NN_PbiPtb_TzNGW4PFokTLJ4Nx4CN5g&oe=6A7350D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgqZGWxK68kQ7kNvwF-a03f&_nc_oc=AdpSAN_N66OCkbMe4G5-SVVGKkrCI5b0eWK3pJ--ZKqbQN432Yu6UanNxH2VmzLzBP4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrVVd5EvwvEJa1cU4Zx7PQ-2tq82t_NSs__JFtaYnzxw&oe=6A732C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
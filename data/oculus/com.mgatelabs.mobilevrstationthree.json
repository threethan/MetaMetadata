730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIuTRWnS93gQ7kNvwEyInM_&_nc_oc=Adkw-KYxO8s1cCVQRJeXN9C9bTeIDisap7KdsTpDj_nQz38rriTMqnWOBEGCwjIf5xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwEGVp7ZHCsH3s-8rUux0b6Qb0cFvhBEMJaS2tTV2wuSQ&oe=69B41231"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVPI0dDcj6MQ7kNvwFL198q&_nc_oc=AdnBpNSMtl727J5vZQj0eoAu4OGIjTttkDZF8a0MDi8pvJF2ABnnuvy-s-9gLitVfdc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLN12yTC4JHof0lT-kMv04NWQtAWYUFWsO5IBLN3ceZA&oe=69B40594"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sneZBJGpSoQ7kNvwEu7hLe&_nc_oc=Adk4Qo_3VgYyps4o8UAMp5h3hcXzh0QpuYLEZ7GbsLYKtBS1hLmaIU_5sIL7zbBjbZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8Gg4XJSF5PZhtAwZpvXZXek6kp_ToRQ-m7Pwlr84Cuw&oe=69B3FFF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_uePGsyPEUQ7kNvwFSf3sy&_nc_oc=Adm5aAObzY5gCMBF34shKK3CqJ4fnvdiKPPz73cuLgpjB3znupQnGPVMJAe1XNTKDfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwl8DHczegdY-ULsdnhwzDD02D3UDopQXK-vzSkvX-K9w&oe=69B3EF17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcYzW6VKo6wQ7kNvwE6wleg&_nc_oc=AdldX6Pm1JLJVFDPqbQ_7QuCMhNvEG23uStAz_Ykwo60wGCE5eiF_dJX_o349dKhCU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMcoaZ_F2216WqaPyLBlsiYF_5Um0mSojLWtbKsY7Y6g&oe=69B402BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
0", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIuTRWnS93gQ7kNvwG0HUrs&_nc_oc=AdmoBE2GWvsmMFx65K3syNTrJ47-8BnwmLOsmNKFk8hK3upRouuqsbGOvx41mNC-dA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPq5ns4Kt_uUTbR0QrFasH6yiE8T8BBHSt2zni0f3iRQ&oe=69B6B531"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imbt5UuB3GAQ7kNvwH9PULz&_nc_oc=AdnIZ1bAFR-Ir6gL6jCCcVeJlEqxcc-hRC7uVebQAd7ythF5BoTon5rkguz-rLuPxzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzyDOS_rO0FnBKVYOm1zZ4-mcbcIuLAusQu1IeVa8HKg&oe=69B6A894"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRL_MHBsfNwQ7kNvwHFY6kh&_nc_oc=Adm_kSf65mR34bKXalER0PmaZVaqY6jx5xFa0QbpTo68PZGCphIvntOPy6SBLpY5gao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYqhGiAAWeFkh363gDMvO9a5Mx1sq5eyXn0UVdAEG6lQ&oe=69B6A2F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i1_R58nDWYQ7kNvwErKgmD&_nc_oc=AdkLtjX0SLSk7J4tRfZTVf9CHs-Crw_QKQMhFiTFcMArRXJ5hRsNzbs4N_3Kjzh4iDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPbi3B9Yi41GC-o-j9RyB8vxwrqbN0eTpX221vsfNwtA&oe=69B69217"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcYzW6VKo6wQ7kNvwGkUaIK&_nc_oc=AdnJd_NocZBplFljMaNBl__NxIZJFIy-2qWgjSkKTWjxU6egymNw7-ME1qO_C8kgRn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxU8AXl381uJnf6sQPSItyftqs_ld8bJn-j99AF7Jx2w&oe=69B6A5BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
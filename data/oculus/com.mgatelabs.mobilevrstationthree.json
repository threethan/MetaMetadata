730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3mfItMf25wQ7kNvwGmtEuO&_nc_oc=Adkum0q9jIK8rtJLL3Ew8Ow4f855U4t_WCDBllXkpYjFOVE93NF9IXQWQG42yVtuLrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afye3ssumcjJXWqzFjuxT_eIemV8GSFrRRneYNg_53Zzcg&oe=69AECC31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRU5geoXqVcQ7kNvwGdvsNm&_nc_oc=AdlnoPYmT3FD9RtsekI0NOKQA43rZ4mnmGHmPFX4vu9BjK9cZEGahgNjvhSBPY6gj6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbjNKD8ACPN2qxw3kHcFN1Njrmi8PmB1m84ApPVwOagg&oe=69AEBF94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G5hGRGeswUQ7kNvwHLzWoD&_nc_oc=AdmzifjDDsyXEuz-1xE-JVBtocN110xMN70lYE05iqtvLQyg8n2JzFqcejAqNpZP-pM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVh1DK9tlhRORRQ9oSo8jCH9jIEx0xzIcuitzQFYO_jg&oe=69AEB9F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWrbxPcfKnMQ7kNvwH1II48&_nc_oc=AdlyHcoq0V1UIiY-Lh6W-2H1T-DLwFXT7t_JOAhYM4mM41NL40dqEOxYqPSCfUsk0bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq0aSeTjYjvepaKrpLdy4wmXkRShvQfSPPOiLsGs_KuA&oe=69AEA917"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=056FuSp6xFkQ7kNvwGQMISL&_nc_oc=Admn7ypjSjWF-6FRPRklJK3NVKeWqHtZlULw3BH1nztIGLLjBjzzIS4sVeenYQc-p4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzr8fnUaT7xMDggHoDEEUuykxyn9W8uC4ZjA_z_-_Nzog&oe=69AEBCBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
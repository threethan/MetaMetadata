20f&oh=00_AQSlY1_iD1maZlDPBqeu55AHucYn5tnGYjBt71qib6zb7w&oe=6AFDBE57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwbQZ40nMJEQ7kNvwHz2UIw&_nc_oc=AdqpDXXn4HykQK9yc-7Dislozk7maVW7SfMMWlm-F1KBRXBsQKKW7qDCe8rkYbmm_z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK8jTsZFJrEtCtVZqQ_wdFSc9kc-trEC1C7Ill_7dWcw&oe=6AFDD1FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "
-30-22.png", "id": "337739244568730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCOVu7pwgCoQ7kNvwEd4mSS&_nc_oc=AdqTtu1aOmGpc94o1ocyKNS7MF6wVTNUtPxfXbRiVFO_bjyNsFiL9TAi0QVAPBf-0GU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKl0KWYkp3_H0UTeDXnqTd--PUt3Exou9LGZM_zbqiIA&oe=6AF0B271"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlkX31vwv4UQ7kNvwG-X__g&_nc_oc=Adpwz99hneGmp0K0et4FxPbcdY7c9H8TBFRfjtReCxyHJRtT6-CifZdm-2RQArihJPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg1XqBCEmtOsHqUDgYq6vJuqzXxT2t1_3hMJkRNVhAiQ&oe=6AF0A5D4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akPGSbFk6I8Q7kNvwH8BlV3&_nc_oc=AdpMuLDZDBD1UklaDcZfwQhjEjXov8FBe8TgtInOf6oF6q7ZT897Sxb0NDkKPtoTdw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5qCaONH6vbB77MrlquwxZSY853OK4M4uQY4GBbxZmXw&oe=6AF0A035"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUsmTpWWB18Q7kNvwGMrWmT&_nc_oc=Ado1C3cH9BqfoWGCrLzeGAR3hJDyJ-aNXhB32gLKFsDjNJW93ynpQWZkoIEqJmOfKHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9bFGOu7VXKF_--m6ZJWgr4YPXs_LjM76ZoBCcybquMA&oe=6AF08F57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVPNApXRDXUQ7kNvwGlI2rx&_nc_oc=AdoMxSrwFCL7hKWcsc8ekHRNoDKx9p5pIk7kOf_HOXCnLxN7n5EErVZi5Y3UVdpfvls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDW03lJr6AR3TXm-_eq1qtr3mI4EKQucOJNYbwSlt3fA&oe=6AF0A2FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
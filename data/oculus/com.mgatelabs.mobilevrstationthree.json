-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDKCTwbeeTQQ7kNvwGXY619&_nc_oc=AdrLJ2xhSu8MKdenPtBTzxWlOgtlVeFwAj3yt8eHHMtHUy-LumSKQbUAMHwrRcwju8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP43ZKBvR_0z3_2dTiMk5Iaf2_X9RXLapYGv94-aozTrQ&oe=6AC10431"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHkznufeCmsQ7kNvwF93oV6&_nc_oc=Adr31X7V6tIGuS11ph-YheHzo0Ym5hrtKP-SMkMCadBvnzaYPjf8SqG464pHi7Fqudk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPdAj8k7UDgGwXDzYbA9yr7hhZeoKvcM9eTv0I3RuO9g&oe=6AC12FD4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OehpK2USkXYQ7kNvwH7__DC&_nc_oc=AdoLGeL2VrUdHAFPdh_Ohx3Ce3H1YhNJXqzdvpb4qL98h7seAcyPmrw-zFUXgWPJais&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnWmOw0D92Z0wbJBKxd_6BjkKbF4AsSeo_a8ASjOnXEw&oe=6AC12A35"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TLe1eumzYkQ7kNvwG6e5G7&_nc_oc=Adq2DX_vRbKiffuj0mLXiXaHdkQIOSlrSeFKLyih-kuUf0CfOeIhm-gydaABRcePmgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5KKRyuzDGKC25OblZa-mAhCII4FHHp9kn9lnQAopDEw&oe=6AC11957"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsoFkJVCT44Q7kNvwHPCSM6&_nc_oc=AdphZanM-LGkEvvYrQfRCqDnw6jSDTCYwY5V3y9Ru8zX_H8S0NUSMYcb-YXd95WvEYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjxG0ema4hiwFbbNctvwxAE1fGacALZC5MYeTPWtBg8g&oe=6AC12CFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
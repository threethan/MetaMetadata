-30-22.png", "id": "337739244568730", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJmGxnulMZMQ7kNvwE_uVZW&_nc_oc=AdoSkbj5jQGxYmvz_haazlyGIg2Bt4I3NGrbgVCwtztdr2fhYDDBK0nosfNcs7k3CQg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIGcPcS9gXxO7gR3q11YHWWmx7NHR86h26b-R_h9jGrA&oe=6A563AB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImPUQO19vTUQ7kNvwERN5_-&_nc_oc=AdrfYPrnsoqSQWpKh4g-V8zzX8DC4wvP3tcKVFXTL0RDWTDvWlgDGGXLBfyuzl0Eep4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeej8FQI0lWhtAmMCURhIatYhONlUb-BoLaHXBEMBhlw&oe=6A562E14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIo-dNwjLi8Q7kNvwEIqNtL&_nc_oc=AdqvI54coi7WD8lfe_VgPP3K9VQZWsIhFGgMin_22gMB5ifRLvsQl6NlgCyOsD-MDnc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvyNs1eDMIIXZs0Qi3XAQlPn9EFYjskDW5sQotQTeynQ&oe=6A562875"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8A6_HEeqRcQ7kNvwH29DRN&_nc_oc=AdoNp363ATSN6RcVd2NMZMVT1fxAJi5z1MBftPcv9MmDohvHyoAzsNvPIBEM_hOeMjA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdGevp5vBdZlwyhGziyZmeY5mG_yzvx-FKkJZ7RvtzOQ&oe=6A564FD7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKeTG2pst8kQ7kNvwHHHumP&_nc_oc=AdqVn-4ah73SQ-NDjm5LUWk6U55bFBlVHdTF19pK5W62GNjLg50eryDV_-lXTlK6Mv4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHVO1-2QsXeNWeYVngEdSXb6t698EKL2T38XxON4IhNA&oe=6A562B3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
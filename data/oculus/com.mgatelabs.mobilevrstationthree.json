-30-22.png", "id": "337739244568730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bsvFzaIw_AQ7kNvwGB8l5i&_nc_oc=AdqmAkG_kOIdmQU5GyaaSwEj4vrD56bg5BfX824J7C6dgJIhiyGkqOND_Sdmz4ubgY8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXhk7Ac9w8KSP39mkJqQLAx_gyZlUP-_qaWtaPliElNQ&oe=6AE89131"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM9Z5nL_n7MQ7kNvwGmr7Wk&_nc_oc=AdrByfXlX2WSVTUyBTwBAutdHEB_YuNZug8qmk7rnbLbEFTFkKuabGOyn9O3k_7a00Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyvtanAd9jjI-RNrjlldTFlGWNPHQNM3OPzpRahW4nvA&oe=6AE8BCD4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eme4U_UKt5sQ7kNvwG4sH7Z&_nc_oc=Adr0e7mL1UyGrhGuVSP4PJC4f5wadS_dIN5rp5YiQ8a0d20-cbJuh4JnAOyr-MKGTHA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbIxHpkqs2kMdBWSMoQAcWs2njhQSkAYOoknYh_CUMRA&oe=6AE8B735"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIkRhkbOS74Q7kNvwHdsZOc&_nc_oc=AdqQoAoBJaAcR-7cbs5g1eVgT3BdaC2Nd5R21GqnVvsDCEvhg09ueRsfCN3NcsSqOOY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcswiqMx3AtNDy9M1-GPN_ZPAV7koWOcDMYXcgqVSv2A&oe=6AE8A657"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2Y7qSnZbxIQ7kNvwEB9A7n&_nc_oc=Adpj7fBN1hkzRLMvl-FkcY6wmy2DKS8BEbJVyFrM8aFxdjvqVpGkmE6eVBkHqDkEncM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxL9-Fxn0S1P-kYh6GGredQZp3IakEEwTlySXCu3PZzw&oe=6AE8B9FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
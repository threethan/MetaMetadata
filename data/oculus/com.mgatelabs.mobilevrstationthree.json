71_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Uh8MjGdv4sQ7kNvwGs9ycU&_nc_oc=AdlNfZl5hfm3x4Wj-5R7aR3h8WNSJJoo4shKDGeVdT5pkE7-5qVNU-xfY8H30cFXI5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afve9GaiT5ASEBUtFR9qzkALWHoW2lG8YQeRnIcrPIa4ag&oe=699C5731"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grXs0mMZqXwQ7kNvwHsbRvZ&_nc_oc=Adk1yF3Re_0GmBxO0QGqQka2lkt2KfPXUYl55rGcdHCI6C1YbWAms-1NhAHHvzIJS7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvclSdb_eAl7XLez-xKZWbBwVfuBqAGjSAAMcL4udeOdw&oe=699C4A94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKNIdnsIEoQ7kNvwGa36r1&_nc_oc=AdnpSfkG4b2bw_0rKtv3cFfcYWtyPOf5BhdvtFtKjYQsgc_jm7HZ5fuSuBC_iQHT0Zw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvgr7vdpH5RrZ-jmBaZrmePIUnzHh9wwB6B3qiZ5YfySg&oe=699C44F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQjD-s3GKtwQ7kNvwEiQ7QV&_nc_oc=Adm_ZIvUWiXpdOunsZosQUXMlnOFeEJADoQVPT7iDuDbxGmUPG86P2VXLp7ifZtizcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvkNESWJWCg5qIOC4sMsms00XVAKGEso9w5vTRylzFFrg&oe=699C3417"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BbPs83J_YUQ7kNvwGJ4jnw&_nc_oc=Adm9NDUtMwH6Lj4hJqUqmENIhSqH0-6MiESbqTWBPbIimKNn-GLMzi6cxlsi_GTXlIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvZo6H3hRqzFX7P8uIAY1_sEpCOinKv81FMTtO_I_G6g&oe=699C47BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING",
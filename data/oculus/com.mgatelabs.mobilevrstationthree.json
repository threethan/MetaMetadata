0-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZf20GSuYTsQ7kNvwFKTlAa&_nc_oc=AdqbFxEmSC4_0cPUySQCrow3n1qACl-eZPIm_INfe5xO5WWd25lj91J3yll_xA-fZc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZH_HAP-b-P2QtF-6_HZdeRd3AZG1kVh23CL4F2Ofl9Q&oe=6A60C6B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN4vnd3NUvgQ7kNvwE0_CY8&_nc_oc=AdohKiyCY0GeSUTu6wkelC7VyWvf3ZgoQ8uT-7e2UUI7WOetRzrfSD-GnHS9qek8QHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqWT0SkAsl9L496LG1MBE3qP1LKw_ZEq--oNzU0qLMJA&oe=6A60BA14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWMzs3KLGq0Q7kNvwH641Cn&_nc_oc=AdrX9ybNcq2r9pPNu53KQ2cA3JygHuSo6v4y11KDbiAu_QswWUNvSMd3DZ31vH7Jaj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdoGdOqSevbcoAi3EWzktRoN--TSbe6L54zj6dN5MYIg&oe=6A60B475"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59g2adau-dcQ7kNvwGh-YCq&_nc_oc=AdrBUJK44WeZF4x4HTQoSPiLF45CFWWOwITnB80OBOzWBWOfvD9eQ4OaJIZLQuJzwsY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA1dSwkJ4Y1XrBrH4VAWHKPCXUWMq7JLrMm81943wFQg&oe=6A60A397"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzPzxxGsAV8Q7kNvwGovcIj&_nc_oc=AdrZ_T5pqSBxlsNV2qtXNk7U8yiNKuq9p0cUiBe3E8swH9zs0Oyy1tFP35D4Cl9kYvQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL5hF-VBImYlub94Q4KzMwHISNf-E6eTmlH2nPX9x7fA&oe=6A60B73E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
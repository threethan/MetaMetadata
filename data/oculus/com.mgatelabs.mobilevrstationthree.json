-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RuBW-CfR3cQ7kNvwHPvRQr&_nc_oc=AdpdHRu3oeUpJ6A5kYxJ2TfhLEE2cfEP-OCgWWQ4qOu6c53b3sgiqZC-s6HvfbMM8PI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WhoNsXyd6dPuZ3-Q9DlR35uhsWgXbEWMwgetsdkdIHA&oe=6A16F2B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh2LGCRnjaIQ7kNvwHxV16y&_nc_oc=AdpCl3DWA1FFHF_bjxWdpckt7U1bw632B6Bb_W0Vp4e72X2RRol7REGC6s85MJXzEh4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zBd3OTyw83tkbmfUvwvbVUdYwfJzkX5-_DJCa5KkYsA&oe=6A16E614"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_7MJXSTPioQ7kNvwHSFAjh&_nc_oc=AdriLAh9pDFFxnyzT1U3XJnPleMiKbibdu_OnBLiKov0M3xa59mZNtFFybpeYaHeMzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JUodsQkyvjsnsCYpNmJg-BM3tuMT2xOH4yOPKtfdEEQ&oe=6A16E075"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3Rv6Ml7j1oQ7kNvwELdUko&_nc_oc=AdohCk_ekVveDeyrVgUUkble0UQD4O_u3J536rZQTgOYCaVxUN6N19cgBKj5h2Au230&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YddD4bCEAHMGCjijOZtbRJuNBVC0QVQbgrFlYE-YJUQ&oe=6A1707D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiT5qh7lGbgQ7kNvwFL6CmT&_nc_oc=AdrlVMCTcp-piniLNowCkk7VacC6NW9N8teh6Hsk_PxZtPnn7P2dgKfzGhJC2Q1XUGo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63X0EBNDRhNlYZk7rezXJZeHLZ5vfhtJwuiwPBs46u9Q&oe=6A16E33E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
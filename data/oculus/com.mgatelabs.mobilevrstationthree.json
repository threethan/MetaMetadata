0-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3q4zikZdb4Q7kNvwG2BHnq&_nc_oc=AdpnG_66gsYmWJ5Jf5rfYfpEfPqLWwUhk1KgPqG3ogNAPSxMWDI6BxGfJyxw-HEP3fQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b6LLhaxtzv768bhctpu7ch7AS4qeR03_lPSeUOUtEDw&oe=69D8FC31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccYueiDstqcQ7kNvwH2bzKd&_nc_oc=AdqtbPtScN01w6FRr5FlEMxWwDqny9kn_QrRCOvQkSl8akoFlGDknXZbGrImO3bCwc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H1SkKX2MSpvZCfxbAdEDDKJvg2cNw8igRiOW8oxNf5A&oe=69D8EF94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKIRKhnwKLwQ7kNvwHSMYnm&_nc_oc=AdrWvpYVxWcjbeVF22lTrAZEsKVLt5r0aqFKEm2LKDc_5MjBhGhdFO-_qI9YhewTMZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bqv5KosnqmmCNLsMrQwsM83JQDSeHrzO_tDyTrHdheA&oe=69D8E9F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvIiyfr_zvcQ7kNvwFrbhQU&_nc_oc=Adol86lKV9Db1UU6FE5y-1BjP3BcH97o4Z1_UFS36l5EFw6j2rr9XIZVDEGLlLxdVdk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af121i3FnJpZez5VaKCtxV6eDA4YTa98eg5opxJUVZdbAw&oe=69D8D917"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9Uh3nluyPEQ7kNvwErH0Ti&_nc_oc=Adpky5N1_6HgD-a_7ADBalbwIy2iwzjRcgklF7GOlKkKyqETjhInX4HkTtnUqj8t8do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JAk8xIgboP6Bg0SVkCr2RjE0Vrh0cUNtKUErvhQS8sA&oe=69D8ECBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
-30-22.png", "id": "337739244568730", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MeAnWPJQfIQ7kNvwFDCJiD&_nc_oc=AdpsRQiQlDav3iOb6SCDU3jYW6t43dY3jWRNKKfX5sitJhlE5X_7CT2IU1hpsElHWuk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gXMAIrh9NSlT5Z_pdy3HEEqtA4NSnVzoEzADODcz1Xw&oe=69E236B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT8eVRz-jEYQ7kNvwEQsMAA&_nc_oc=AdpjTt7QnLTVWy67IU4_jre4SRk5TTwEpNLntEnEQiyw791nnTQ3v1KsWanv-NhQ4Rw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UMBqXeItVrhWCCxegY8Mk0mCxavs1h4raxxhUe_NfIw&oe=69E22A14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcheTddBZHQQ7kNvwGsflwm&_nc_oc=AdpLcC0dDyUUC8XXPgeIYE7LOsrj5f40JbmGc8D9ftmpnXAHAEGFDCnCXJvIgMt_Qbs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Yu3N57Q70G3FhUHAmuBwEom2knoSap_Isvlwukr6ZwA&oe=69E22475"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8qymOpppdYQ7kNvwFej8Pg&_nc_oc=AdpCU5VQSoHCcDf7ogziKroH5NSzMZARGvmAt5w96I5huWPMxKTP6kELp6lGlZTXn_A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V5n_9Wg-f5uo7mLb0iSs7esfx4BX7M8VidBLCRwWD8Q&oe=69E24BD7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amwmOEIXjd4Q7kNvwHzAQzf&_nc_oc=AdqyhPP1IEzk2J8kYy8ZaW7IrnqXNbqpJ4fX-mEKWeRzHzPFUq2iNELmDVgObguqGd8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rEM1aXLEOBknhFNGy18alTBhDXod010rKT5x4S9t34Q&oe=69E2273E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
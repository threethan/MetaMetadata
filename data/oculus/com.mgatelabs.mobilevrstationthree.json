-30-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxj_BawA61oQ7kNvwHBY53y&_nc_oc=Adq7wrcz-yaQeSreRbT9orL4m7ROm6hsYxnhc2f5aSKDwmic4PRmlzF4SpT-qH6wctk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL99v4K6K9rF3a2QCM2IN2AY2k7GAwuKuh3OAi9-xPJtw&oe=6A9D6BB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dQa24OBIzgQ7kNvwHm3TA1&_nc_oc=AdqwSIMJcAg3littIYpnN8TX_kdRIr4lnHS5tPemCMGvV1Ai7Ctoa_Uk54B0c0F9_o8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkAuzBbw5bO4-NeJho2hxJl589bKF-RkKJUeLI3Z1fwQ&oe=6A9D5F14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLG5duUJ9eoQ7kNvwHPIhYt&_nc_oc=AdpbF1LPQdWCyzf-8GfDjAvHf7rYspEibKlE25EFmQRV0Wf532GIIpKIK7WbyBr8_oQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH9z696zROfj2Wa89gEimZsu_fyl3S0SG-jNgYHxqGUQ&oe=6A9D5975"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mahVCcH-bpMQ7kNvwEZd4-p&_nc_oc=AdqTome37IUiYwj1PP9AFQJeXIq_z5gi_zs3TfvVfqYCPxVWNAItWu-maexoES7T5AQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAFT2U1oQpEB0OIL0wAEDEgDijLVtKvzpJwkNX3Owajw&oe=6A9D80D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH6-emZN3OsQ7kNvwE0xw8K&_nc_oc=Adozfp9bkOR3mAiqq_Yds1-eGrDPaIPb4N4NPYMiZcHXfOEU2cWdOK0DqKuAv19uyjs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUg5GeI_ZA04-HsZF1em0yZ4WZscXw3g67_BvrZNg-yg&oe=6A9D5C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
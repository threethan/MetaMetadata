-30-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI39v89FyW4Q7kNvwFi87Qz&_nc_oc=AdrlKsjBQAJJR9w3j5HfwLBG2bXhZQNBD0DBqcVjgk4MZJsFvxn9iQMOTtwF6VwhQ0o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HFWoMA-Tj-uRQCEtSvEWQKJ0uBJ4wuz9lnAcXrZkY2w&oe=69EF65B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCGGLqTOUvIQ7kNvwFxsjDl&_nc_oc=AdpRL0f6pyxd_Avt0S4JAOmj7COKPPT0xKLWVvrokigr-AbTRKTetUwFqPn-uQk-hOQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Q5JSi0JyJtGPcyYYjnrJ2fVMgfnVZtzLRcgKEgFaJfg&oe=69EF5914"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuYCC2jW_scQ7kNvwEufceG&_nc_oc=Adpd5d3xEcPI7uVYZdIPvgEShjNg-6LV1-5cJlczRyJyvQfwqWO1OH4INaAb-vdWwA4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3H7lBP7-IFAp0Y7nZHR6KHkStsdMEtl6VbK97IyPcbyw&oe=69EF5375"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0SktAaDtQEQ7kNvwHVdUfz&_nc_oc=Adp1cdh-QunlGeG7byBU2dOe9wPumGVAQwGMwLRdAfwSFUxBHfYkOC0GoBhJpDCpvd0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CJabvmdGTOpFghgRWUfHLefDuuuJfMuWsvM9eVtwW7w&oe=69EF7AD7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc5VoiTYwhQQ7kNvwEY0WAe&_nc_oc=AdoGea2V58nKsvUYEL19kHdonfgaWkqx4PzfMgzHjzA5dCXKi4akizgXruOYjulTFak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XWf8B-qZrJlQA-cOo0ipYEgVYQcI72WrwowzdZEHbWw&oe=69EF563E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
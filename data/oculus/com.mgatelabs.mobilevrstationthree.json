-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-mKOwAnzH0Q7kNvwFopq9-&_nc_oc=Adq5CUYaOeXuPOvId9JENUuZ4RSA6gAeDgwFFFnKV4dgnLxUom_PdKrk5MERmBY9HBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuDlscwurw8yfb7-I_Iqgr6bpBQotmBilz_m7Zod2qcA&oe=6A64BB31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJQrAW7KdCgQ7kNvwF3-VgW&_nc_oc=AdoLuM3zEmNcDM5keEnhu2eFWPyK_lggMriG8tqYiAcl5K1gmEaulRtitkjxYS0nD98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCctcfHvxxmpawkKoz7J49pReBIE9qmhaH2CpMWEb2iZQ&oe=6A64AE94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rRSUnUz-yoQ7kNvwF00-Af&_nc_oc=AdqrzkMO-kKxP2QFO1eD5rf5KzTctSqhNXU2eDDtLN0U_UmPj52e4-6PpvKoyRZtqG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0nT2ZetwfbpopLvJu3QzLlBhxGt8SJxzcvqEhtMmPyA&oe=6A64A8F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaMtK7jktB0Q7kNvwEbmCJr&_nc_oc=AdpNXgjpfU12ccJlk6zSAjjE-7NfJwi3T4bKNV9WQ_01AjS6kjWcB7IxXkEtNpnZ468&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVHc72GbB_dxo2YZI44kDLB8fADO9nu9YGpwE5RbnQJg&oe=6A64D057"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSWfAgxmszoQ7kNvwFVnwAh&_nc_oc=AdpXqdiNhMt1Qj4jR-bbCT4XqKTiajF5mjm9luxsHBdPmPVHPgigtbq0t1DSPP-6hxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnVTSSCssgLvZ2PAj32pj_DtmobMPTR2sZdPnjiV9ePw&oe=6A64ABBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLFWLLm78xUQ7kNvwGCVxL9&_nc_oc=Adp2dLCOr2p-LcXnwPh7HaxFdYeNAwZW9hQommrD5-K67F0cLOg_jxOcY8PeS1dXGQY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SZrXjqFCJwdg2HDXOgfD0NmRHSKw-ViOMobGFmaTRAg&oe=6A3D2E31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OwlaoT9GV8Q7kNvwE_ZjsV&_nc_oc=AdqoNoJh5zSA4sc-Y88VfA14BJdNSowzsoQKACvSGsvWXFUU41o1I5C5bFoO8sTQsoo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_lN49cCVK70QcP7HxWCLtxU8Uu3_5u6S-xTWhARkOSw&oe=6A3D59D4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba21duFHe3EQ7kNvwGfrjFt&_nc_oc=Ado01GXjhDNqquOMqEsXiHVsdp_tj3PPsep0nVv4iZDQAKsUDnHDL8oObnJjm2vcbVc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DGfY-L067BOrIlRIwiFCRphTsFt_5sE1kV7ydvgEiOg&oe=6A3D5435"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EmpCo0lWUMQ7kNvwFa-4Mx&_nc_oc=AdqquCz1Z95_hxeLH7hMy5tQvV1l1gMRY9aMm9CDffQNpBUfeRAgEMoeTL86R60Pkeg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GfSnULiDgkJE7ANdfkzDIc4NKXCW-OTUA-bB-Ie4OgA&oe=6A3D4357"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-rC-be7kjYQ7kNvwHCB2gJ&_nc_oc=AdqeYG1YI02_9GGWKOn_0LwNiS596h1h_CVth4Nk_wbjGIu0Fmco3kVX_B5oHM5xGPE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XbWQEer2GoVpcRQp3NFlECi7wIhdTlN8rZTp_huc__w&oe=6A3D56FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
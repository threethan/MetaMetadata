_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej8LgwTMweUQ7kNvwEIj_Du&_nc_oc=Adl2WowKRpVSSL3_6TnIYz41rwR-C1jshZbAlCX36B-f_ZeQRCHIBesxaTNe472OExM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvHWVFXBDGaS7_CkihGq-pLV26qMeCnpaVEFYP0P84Pw&oe=69A44031"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vCUkgmyfQYQ7kNvwHk4H-L&_nc_oc=AdkeCKM0epTmT521udZYMfHQMkIJ6CT0ka3uYs_2LUQs3F7CEvv6fk16BXZOtYJXl7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfscL_Mhwlxd-uy8qXkvukv_hhxtTV9LB_m5LET4t2ou5g&oe=69A43394"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOij5gyciR4Q7kNvwGd3jFu&_nc_oc=AdkzyywxA9Md6KBPkisKSBYK9yf4dK4bzU6Onpfj1B0Dfake1-4FMv_ElRqbSRCLKis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvmcPcCbZybA5JBPkwdWsdR-NLwnmUG208sBw2Ye7dvyQ&oe=69A42DF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hpo3qqUa-IQ7kNvwHoNuja&_nc_oc=AdlMSpsOZ61CMqRthxCWcd3hoT_bzBkM0-svcpPq3qoqUmhh0et9e2N2HAw9LhuFMns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftULnKXt_ahfzVXQnGe7iMhEClRCnrGwRjz43W09w0E_g&oe=69A41D17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0-0BplnHGUQ7kNvwGhaQPz&_nc_oc=AdnWUnZ9obKsc97IaJGuMLN6BfneKVKmWqTEWaZ966Z1zrDmmvW89pHIOA3mSmyOU0Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvRm5cpHJcIOb3tR2rgw4ePmyU1VyJ9LSAIQ1V-LNVZYw&oe=69A430BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "
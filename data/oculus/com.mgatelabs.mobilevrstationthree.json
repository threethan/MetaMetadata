-30-22.png", "id": "337739244568730", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GylN2v4j2_MQ7kNvwFqGPSc&_nc_oc=AdrtuQKrl5q-9m84ENJ3VWtNl72CRKsbcrRmSNruKFR4C-SGdMCwFkjL2Fx3quHfazo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kGJClsCK5cZ_KifuwT3BZfBQ3a4mKGUbP5G7hO0Idtg&oe=69F5FD31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFb3EG17uTQQ7kNvwGJPdEB&_nc_oc=Adqzhpudmi9qjnUneyYgDZ_xtdL6Eo4e2yWZhbcuXkoG-84rCijsih_7a33eQ78qYsg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28SHTJGZcteIeGhuassEVsA60r1aU1kxptXv9D2Wl-0g&oe=69F5F094"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-7V-oy_Z6gQ7kNvwEg__F9&_nc_oc=AdoRchfUgjxKBoeLUMUZbZtqxUmYnmtO-c7DPfhdPpE3h029rWcRtyZoqvm-f0NeC_M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CnPmBQX067w_eYjwNhHqkvl6Vv0atpI4KJ4WLUsRqrA&oe=69F5EAF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqQWfwmGgBcQ7kNvwFQ1Rus&_nc_oc=Adr1Do5qqMS8X5sMPg51xyDTPmBqoFpz4z-xCVc4y0zcBL03kNmOxmgW2Xo5oAHuG3M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0klSRXU6ri4YHwuu5njs-Leqneposl2mRbosTday6Pjg&oe=69F61257"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK6CasmrVvkQ7kNvwGDm4iL&_nc_oc=AdqxqtaD6emHl8TgMAULnECRzBM5RKf16GY1amHwOUCo6sH5gUTdo84fOTnBwhuy6e4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wNVsTRrIByjsqa0Cx505uYd0pjzp_fNQsThcRJQtM7A&oe=69F5EDBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
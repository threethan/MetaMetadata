-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsjc5mog7DkQ7kNvwF1g6te&_nc_oc=AdpD3tYOw-htQauRFNpXoYnObuA_wvMGcK0mFSCleFKgHdjUtbWTVef4DeI_2PwKyHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1tCBcm_yPYb5ougxJ_txqGckktzaK5_fU38JgktK0rQ&oe=6AB3D531"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGJh00xWQEAQ7kNvwF0a922&_nc_oc=Ado8a4CtwO60AMIcsI3t7_BilTqL74_LK_SQ0cNL5AkDLoEp8VEyq1slk3P-WSmSua0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqgpykqzSb6x0wVha7D49yqxN2pOnfeFX6HpDydDtfxg&oe=6AB3C894"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54J5Z0GdzYIQ7kNvwHlq8pe&_nc_oc=AdrvfssfaXtv-ts2tUJeY-RvWAPKzV0s6AZQRxznJ2qt9-4wuZumRruV5n-HLCxM7Do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO7sQn43MgzXXf5n_owF9c1LiZa82w5LiKk2rmqWx31g&oe=6AB3C2F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnhekjD4FEgQ7kNvwEzYvBg&_nc_oc=AdpFwsn7E2kXIaLDUdQLqJAAB6ESA-ec90x0gi5dulere2JsI5Fbn5qKx5E5Ncc2DAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFuzWGS9l0y-gMAPadwh7sfnZFLu0SaiSi4_cOgYRuZw&oe=6AB3EA57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoI-0BLKsK8Q7kNvwG7SYcS&_nc_oc=Ado-YqH_sIDFy6oFXPTEPMzbYEz9VyM8SzhsMqIXb2tZN-6PnmrY9gj5gnvg76Cu-dc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIusUssgIH1jv-ZZwc8QGxGsX_sG9YUKqMKap9mIw2hwA&oe=6AB3C5BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
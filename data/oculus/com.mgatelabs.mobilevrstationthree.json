0-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGBkWXOHpfoQ7kNvwEYe1IN&_nc_oc=AdptWw_0tnwTCq89v3E-dihpfUN_2grW68mQhAaSN1nwqFZqJezwcHKu7KBlSXq7Fg8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJSUHtj5KEaohjXvv0gtdHkJcOxjSjcppQ5LtayjL0cQ&oe=6A8AF6B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm7pwvmQo5IQ7kNvwHxUBi7&_nc_oc=AdqlGB77DN9RFpGcqTMIDyPfvzO1g29D0-rztFhcUbxyJ7nLNPkdbulq1JnKG8J3CaU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVHyHW_O9J2CY5Zz2-BM9KSVVSgk56gBlauYJn1GsxAg&oe=6A8AEA14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnwSHT2eeNQQ7kNvwHOR5md&_nc_oc=AdpSN4IskQ24GbPG4YL_JyW8YTY2Pw7n_LUFk3-JfcwmLGx-AmaNGdenZkkFK8opjro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyMQCyukrWST2I0QEkxqH1FcHeKGGo6pyWrYlk12uX1A&oe=6A8AE475"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0x80n7dQTwQ7kNvwFDZHVL&_nc_oc=AdoqpErb4O99SV6oaJRZdX3FNUhmlYBv4FPoGAMitnaI0sWHdzmRsUxNUnk_udC9ZfI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeK1ERVytUHoxkBFkksajpctu09Xrdpkc62ZthFh8X1A&oe=6A8AD397"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LN-NcHxpICkQ7kNvwGfH8hg&_nc_oc=AdoovpMi03uiN-i5suO_dCi_fXMI6txEHXmGITC4nCe00Dgj-AF1V3cIZxDJEJufQYQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWco-xYBYkl0lOj1u3OwF1JbIho-khKue5WYa3-S6e5w&oe=6A8AE73E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
//scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI39v89FyW4Q7kNvwFYfY1u&_nc_oc=AdpDUiIukTpfO7FPcASOTGY6fa8K2ZAUbJaYR0-R0dpRb-rP2VDYr03rJ__6uEL5tO4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1suKCciiM-j2Iw5-KfjDzWKYtrdZxU66cNEeogF1Q9-Q&oe=69F208B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dSLDRyU4AUQ7kNvwENm7uM&_nc_oc=AdpBc2GBhz63MHchahmZFfZuYRy50uALvP9Q640YIGFh5a-gu7RpCT-2HNbNKl1_6vc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2dTNPQFdC5lHW1iuPbBSUkJIWy4t4tXhsVqf3N36_ICg&oe=69F1FC14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0sYxWLrGB0Q7kNvwGKWFz5&_nc_oc=AdrWoKEvPBZ_0tzUmAeH8ZwwJZugkOeO4vWX9LigOXgJ0B4_mt7RGPTUHDQcA5yTxxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01jSsnljahhrcS9CVgOwzR8jiAJNYkIo49ddNLHijQhw&oe=69F1F675"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b88V5N-N23gQ7kNvwHEtu6t&_nc_oc=AdoXwm0KbUIHnLS4wspsRN-InrczKLyg45I_TOkLhw9UM_1QfenYUS_0T44sE1vjQ1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1FYUUxlFcsvAch6pZuxVPretjOTKSAbnlBGjfqwnWutw&oe=69F1E597"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc5VoiTYwhQQ7kNvwEMtsji&_nc_oc=Adp7FUH-pwNQp7pICRAgdavmlrU_n71Ydchrw9TtAPsZGLIV0FBWgFGIZN7Fhf1JmLA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33dLHKmGXYPGn4FtRdnWomC3SZTwhtcrnB3dmxkN8yug&oe=69F1F93E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
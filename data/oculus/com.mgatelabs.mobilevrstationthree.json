-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsqWEeNEZ3MQ7kNvwG3rIIi&_nc_oc=Adp5XKAud2bXsDz-yam36vm7Uue7loVbAa1RPeJ5mOXLqriJj36uQVN5HB3aS_ca_wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bN5oqNbhmLD7-zEexWzXKsTBP74xLRqq9Xz9fO-vAdg&oe=6A1D8A31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90S4r954tdcQ7kNvwGxqeBu&_nc_oc=Ado2G_0Fb96-Vr4gGQrwl-CbVVzR6oPd2_0P7ybN7J-SBg7DfFP9cMgVxW7TdRUsVi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OZu3dQH9paYjBfMSvBBNxdYztK7jirLrA6IF9He5vJA&oe=6A1D7D94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQHvUee5fwsQ7kNvwH0UX-l&_nc_oc=Adq-vwF4tAdW8iBZFlK1ZmI2luek7KULyUvo0JvGlptrm9OgQM7jamBWOYH8oBILlSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CvOw4arekj1lUc_UQqsDCqTwZ1pPWWHFqBKBrHXobzg&oe=6A1D77F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpCy-v8e7sYQ7kNvwFYSqvr&_nc_oc=Adozvtgpi9BLqwRCR7WfM71vqobQy1ScxXDvTH1G0kpqCCZEPhmMUoB-q3wbx2qgERA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67VXbxeYPMFOvN6oPHf8Evjmp2DVLyP15wE9UlxgU89A&oe=6A1D9F57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXF-ajHKfHMQ7kNvwErGS-Q&_nc_oc=AdrBqd1CHxxPEN5R-FVVthkO5-N7POw2MdiBSt9pQArYnoipRFfgJIIYH_BuSd-rbuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hWIXw5zxeuC6fUBjIDRC4vshkkoQegydlLInrFFydDA&oe=6A1D7ABE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
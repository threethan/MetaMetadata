-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFKsS3pAyUUQ7kNvwHmgfwy&_nc_oc=AdrqssLcHRavrCrw-8LySLHKbm4ZYksaTjQEb2WmuS4Oa7rGEbfEARpOVaexxYzB15Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1EZL1JaCwzYNZer46gveOM6prvPM5RkG49JEGerd76A&oe=6A675E31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mG_EqqPymUQ7kNvwF0ijMy&_nc_oc=Adr4BHYhxkqg9ILdcqEa5t_5XWOEohZIase2IZYZxI9WrFFLtRZ8i3_cW0dMXnc86iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeiisEkbchU2_DCpRyHku0oVxxpqbD9mzQ86jYCzbcfg&oe=6A675194"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rRSUnUz-yoQ7kNvwHJp7nV&_nc_oc=Adq8o4IYYCqFWRuGhIJzo1J6qDfbE9qB2gZxDRmlCT3PleQP5ZSZLz2oNjy_ZpbJ5NU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV99bcvlKG_B7dynnwL2GUV2QF7W83_iMptNDtPpNgkQ&oe=6A674BF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4NBTeUsGUcQ7kNvwGbqUKs&_nc_oc=AdoP_eSDyjiuaXhxQjBsEweAby1IIxourgIrxnlUdsa8LrCuLwtyc_RE-fkzo3bqm2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzAkKZAQalNSj9bwXXIhl0dlPrzvQlj0_Nf2s1BAjtOw&oe=6A677357"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHh_CIcsGo4Q7kNvwGDZfOb&_nc_oc=AdojjciPiJ4TZq3EKVhmCHC8wN5qw5Mn1opd0eq48y2xp38B-EOSDOsYY9Gy_8DtgzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-VaFIYD-KBuTDPt86V48Y4xK0bhf5_0Jdgibu_RcCsw&oe=6A674EBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
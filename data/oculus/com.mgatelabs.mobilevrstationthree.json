0-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5DxuA-SDTUQ7kNvwFPPwus&_nc_oc=AdoWM_gz4xTj49Rz1h5xP4NCY8LtCUaCSuFbxydaTrEYRqfg1uxYnh6lO0IV1JDXV8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U1rVgYVC35dP5jgRVW3eX4OsBed90pE8YlINWnHzNFA&oe=6A202D31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfkN8WO23rgQ7kNvwGjT5Hq&_nc_oc=AdpWvPVs3XX7zJLUx7DbAL8AU5T3JhLeLg9ic9AqnMuDlRiGz2HXBoQ4o_w0JrlM7Q4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j6i_W5GsZaFYNHya7818qnQfpOJ0pN2M83G-rcuvCjg&oe=6A202094"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQHvUee5fwsQ7kNvwEHQdAB&_nc_oc=AdoUaUdsmqEHBV7xFvxHX80qVk5x1JMe3-JhJe-erhLqHBfK90QRE_XOJn-UzBRZ3kg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lDEhlRO7MzAdl7I4XFa-NMMCWZi9vNFsbh2HXR_VvkA&oe=6A201AF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp8ZwHgSPKcQ7kNvwEf4WnY&_nc_oc=Adq_SDTD0QDXVEdStNY-igSlNxxCgCX73f1qTaWCqtggblxUpCAo_OZEypbXYcxjIbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XcG8cEHQ8vGTn4Y08toG3RSUUrAgv-mMz5SFB6vlngA&oe=6A204257"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjR0LDzBSpgQ7kNvwGfTxX0&_nc_oc=Adqn5b2na71qzHVxdXQeTh6vLA_70s3J_utK55tnA-its-ZQoRSTmVaIHg20Y5a7FV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v_hW-Ky1imItte1Jm6dm2pH7vWO6GIc5jkGd6ysSVrA&oe=6A201DBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
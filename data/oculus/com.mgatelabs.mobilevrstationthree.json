0-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z_QkAu9wt8Q7kNvwEdj7M3&_nc_oc=AdrRFfM2Ee2uNkPb-5JYnPHVIi7Yqrbt3JUBED2HIfeYojj7Myub_VifSk4sv43W7RI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pCTt4rYTJPTIxKghw4YatXo_49QlzvYtE3WyF_lRqcQ&oe=69FDE631"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQWndDJ8ZgcQ7kNvwEk2ENb&_nc_oc=AdoPucB5Sf28iOgmkeMTMKEHcfOYvYh9hIFeUqjEDhg4yhCyYHISh2t2s2r3YJ7gP9I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DuTew0gb3qtkXca6ROHIDXBV0B3tlmPC4dP7ncPUfQw&oe=69FDD994"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqTPZLY4BBIQ7kNvwGQMvZ6&_nc_oc=Adq0tAGTNZBHoPXH1rpjsC2nh9085NSv9Pg4k0h-laLHvkM_lNTJ3uFnPZRRkQzRZp4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dLMVN5CUCeZX10VDnrsBf90jMZ8Lz3WXUExUisUBp5Q&oe=69FDD3F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJPzrE2c3lMQ7kNvwH-EVRA&_nc_oc=AdoT9jHyzOUzOrafdLtgpGSRJ9Sv00uTBVqqtTUuWMeAi7b7yn3GYb5PEN7A-Zj5f2c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cMxw8Otx1Wd_h6UwDFV3a3tKsky-XOzP27nu3GNOayw&oe=69FDFB57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8STqCZEwHFAQ7kNvwH9WoiT&_nc_oc=AdoYrp4TRdvHIg-_Kb2yqVzTXIkKhCtIvfpK5Cfyhb-2psWNZHzAYGKxaHa6ewdigQk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af563OUARdJIE2V8tGI_Z54-rtsZgPbBz_arrYPyBv5H0g&oe=69FDD6BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
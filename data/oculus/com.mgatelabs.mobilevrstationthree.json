_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej8LgwTMweUQ7kNvwEK6ajF&_nc_oc=AdmTEP11k125-MAtFvNbAPgme8KSKCjur1twW5VsI2eCG8K7IDIcmNzs7tUpi9o63jU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4ni47A2fI7mQgxcViHdAW4j1I2sVo5czBfy5oWPLrRQ&oe=69A6E331"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hYRhDqzpBoQ7kNvwHlr5Hr&_nc_oc=AdnvzuGMMblgSkdAWDfe2BvDBYbASSmp9lLWgTKLYts61WMRvuxrP8-83DxWjp9XKyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVlsF68PnX-Mz0VmWpWYBrqOXwKy-V9oX31ECm2-1beQ&oe=69A6D694"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GHdEsviwykQ7kNvwF-fZxc&_nc_oc=Adkhxb8W-AeB3mURq0tn7txwy438IxKv4CsqLgjMSUXEcOuw_0AMdLFGMt8ahBv_Dl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftebsH0w2S8bGfykS9kiAjjlZZZxMyiof9eR2ZReNgzTg&oe=69A6D0F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmaRowZmDjsQ7kNvwFnD5f1&_nc_oc=AdkaDVrRKuA20GztC9cdAhyKYYSyCIFpM4T1jWTU4v9qwALdpuBWCq4rVn5v_5kW98Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRWX7Qiz9SwGKqGfCiDjCgUpYLkmryJ96u3C-_Wpu1EA&oe=69A6C017"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0-0BplnHGUQ7kNvwG6hzG6&_nc_oc=AdmIUEvyba4P7osW0QDB2Fv798NAI2FzpHH6859CAtQp-LqWEWa__ifZax-fZENzwoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu43O5ZDRTzHnaOCM_91Dl3fIIFARJnLefv-Yg6erTM2Q&oe=69A6D3BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "
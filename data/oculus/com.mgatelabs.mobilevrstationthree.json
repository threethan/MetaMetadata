-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3zOzU0PKekQ7kNvwGFKOzv&_nc_oc=Adp-SY8P7XPLVW2ndEQYd6oIYdd50Dye6Ay2sw_sdalmvthL1jIr54BxNyOMXexx7Jg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8MNitOrIVwV_SKV1Q5IHVUOSpjyGExlKGWHL5DeAAKw&oe=6A71EA31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDj0N3SDu1UQ7kNvwGYiJWn&_nc_oc=AdrsiinBgHACKKeHyVshQxcDE_qLkMQEhnYnEbGnSo9XP-_XD1D_Pe_8PbPVuYY3qM4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCa78HlaPMfo8bNllgA1sCaAD-DlUaD8VGLyq6Xk7erQ&oe=6A71DD94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeooUY6wDWwQ7kNvwGLM5Ml&_nc_oc=Ado-BLHaOthHHGZCU5xuxBpjU0g0RGPH2p-2ZrNYokqdk2o9C34opEARfZtMrAQAHvw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNSWp1OK088hlvKh-lOgmToaqlgjHROzWvMf4Wap_uqQ&oe=6A71D7F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHfce_vX5mMQ7kNvwHs2Ist&_nc_oc=AdpxJxLBrkOYbghcZeWvq1IqsGZCviN6BJyLrsWs4g0qPC-2jZoaSUCYPlacdksXrQc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnxIENoZb-_PNj8KvctYHInvUXkvzT-KkcKrdSEI19aA&oe=6A71FF57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgqZGWxK68kQ7kNvwGYwsey&_nc_oc=AdqrU4DzBSUQ14SxGcWfuzPYvgLxdZAerSj0rq6bXUSuAN5QVX-9s4FfuE6FTJMd7ag&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh_uAip20hAnZk2kifPewSNuxaQmWW-NyfgnNEr6Io9w&oe=6A71DABE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
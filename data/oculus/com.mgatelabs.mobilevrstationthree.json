-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMpqhE1xKj4Q7kNvwGeoV-e&_nc_oc=AdqVV4Lqdkl28GsYCX1NHwuFEQEi5sRxuY8EVchTVClHG4wCVabbQEO3xgJzwH82t8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBndeoZ4yQifLBvB9BsYwJ08Z1vq_zmtpjZ3u_67iGFw&oe=6ACE6B71"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7l7xpo_SrQQ7kNvwHu_iIt&_nc_oc=Adp44mjsyHjTRl1O1wkKNtFxND-qpF-R5A0YbnbOFefycPhvC-ulmFOfNryUs5whgF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGkTAC-FWDr8U1uASU0z3HRW897WMaq8aT_0vB0HGcUw&oe=6ACE5ED4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJu0ONlA2fAQ7kNvwHVGOvE&_nc_oc=Ado0n8zsDsrKaPWkDyF8xfO3acEOOwY0V_lbiJkDD6l1Dlk441pOsr6oE3PyJguZC0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORP5UKVgxjI9BF6Lw2mzmgdJAO9b_1cCq2JYY2eZEOUQ&oe=6ACE5935"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G7RcipunswQ7kNvwGEkMGc&_nc_oc=Adq4OKljkI3R0MvWq5CdaM6hbTq-J5Wc_SNaK0ZX1vwHiSLtCcUz_PkdQorFN-sMCSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM19GWkLvJIpQpomk9LTrBnhAl9O7iYIYE02cxaHYZvzQ&oe=6ACE4857"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Nc5z7Pk24Q7kNvwEQiT2E&_nc_oc=AdpcjLtDK7zZnnmgngXFAlEHGxAcILzyS6zKJdfxjnUw2raJguddhzbsS-OBjz4UBM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3EcgrRYBIpXXQ_TVmQ3i2jKeoH1vf-IrMCDMi5frOgg&oe=6ACE5BFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
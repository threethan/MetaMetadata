-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxj_BawA61oQ7kNvwF24RJU&_nc_oc=AdrltDYSeDPK8mrx_VdC2EbxKjfqujTX2lg6Fl3pxTagdCAfrltN6m0p4mYWX2I2d1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYJ53sYyT4zIYMDi78reOrql8dsmLl7nhdI8qAlSrgZA&oe=6A9EBD31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVczmx_0fHQQ7kNvwFrjP7P&_nc_oc=AdoUgtSDTb9QbgzNIcPksY1HW3xWw29lX_EGJGNnPpFCVQGSRYPF1e1tdOTq08z0APk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnFrZwuo0Hgkz_h3cVRPePd_7CmsH1M0kdNECtzXp4OQ&oe=6A9EB094"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLG5duUJ9eoQ7kNvwHjF65O&_nc_oc=Adp0-JToSqeOtwK7kLUuIJpnC03cBWHMPWO_Fi-5M_ixgGC8aTzXqnl_sGe1VeZ1G5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPZMRX-3gkAk6Pishuq7MMxPienKcQ2GiVCMcNtWjEtQ&oe=6A9EAAF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mahVCcH-bpMQ7kNvwGC9Mfm&_nc_oc=AdpWDS9l2IOPSuU3LovBdKzFxEIOP99bzfti2CwxG4uNFDeSzP44GBhxnYuvE-pN9YI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8V3zVt1B5h6I8pOO2mJ2wQjCC_rRs6sDUnRwR0mQSIQ&oe=6A9ED257"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH6-emZN3OsQ7kNvwEEbO_M&_nc_oc=Adrmb0fhTETJP5bmoUzsH1dq48krpqjQbZ8qFZRGGL0oUvOOsiKGol54uk7GAw7kcmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK87eaKuRGpfBmkAorYxEc_Wtlp0QZMqLo_5t5kMxLSQA&oe=6A9EADBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
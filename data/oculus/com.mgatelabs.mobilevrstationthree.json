-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDKCTwbeeTQQ7kNvwHu1fPX&_nc_oc=AdqFDIRQCvg6cuMe01b1hSmEI0cbPjbKPkce6VzYmXBdsVZlrw9yBCsH5fJr6P3w2Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfggU_92a1Z9gGPTgiflka1ihYTzdCVboz1RXBf0y5Vg&oe=6AC3A731"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7cCmxtIPVkQ7kNvwEcpTVF&_nc_oc=AdpvA8dQpZohyOJ3f6ivb-5BzKznj1iNwEyJUW-nJtf4I0DlaArH3jNc8Sd1_5tK9Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrRHnyqfwTX32bXYklQeP6lVSkgH14lc0Znj9uTMrk7w&oe=6AC3D2D4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQZRZf6YP8EQ7kNvwGFaNSu&_nc_oc=AdoqMv3P2X4rfefRDitm_eDh3xEi0meyJx0G0ryzdg09jEP99cDwLXuvWWi1y_JDSYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxxnsHBiJkgfbqw7V4bz3vsSbqUBzlv-k3VVj0IilTbA&oe=6AC3CD35"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TLe1eumzYkQ7kNvwEbDChG&_nc_oc=AdpT5LtwSYSl0YotpnCBtsnCa3mBLfkqovmPlCijMhydtzdEgkjd3tIoiTtMVQsCa4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-FTyaz2_Bb1l2JpCRdr0o6x2mOZN9FhS-QivS4rbO3g&oe=6AC3BC57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsoFkJVCT44Q7kNvwEr72yC&_nc_oc=AdrLROfBnENR5IiCRNz0jlXXkDeO8GJ1eEFVH-LY6HfE_3uxWMl4ajFQKFolXiSB9Kc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8e9iTLqj1X7dNlD1cZ-YD1Zwg2Drl_tSY_vp9H0F-sA&oe=6AC3CFFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
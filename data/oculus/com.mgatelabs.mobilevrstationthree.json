-30-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMpqhE1xKj4Q7kNvwHXWGqC&_nc_oc=Ado5dzN8o19xv7AY2hC0s4yVgZ-d8N1xvQupbKvYHFVAAs5N3gYsEpWt37WMrKW9Uek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmHAhW0gMXAfjy5iYhCIqQcuekcBFDFHvfvB7Bvzz9lg&oe=6ACF84B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7l7xpo_SrQQ7kNvwEj3WsJ&_nc_oc=AdruP5M42mx2b1iWCINL0QMOIZ9xKhwkpYY7yTA1WlhsbLdJekNzVDQ8pVKsWHDgDVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFaOUDyhnJOMHPuVycuz71IEHOWyxqzMbyZT93DQGjLQ&oe=6ACFB054"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWhSjk8oZPMQ7kNvwHf35OW&_nc_oc=Adrpp4umEGvJwbTDoDkWCq_m8K-rmIjI8T8j8cVjtTDUs7Hs9_vJCLTAW7TYEfp9VCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPycMgYaFz7Ky73196F5h0FHa9uProOUdV61B6I5QCEBg&oe=6ACFAAB5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G7RcipunswQ7kNvwHt8Skp&_nc_oc=AdrduCf4OnQXisei_2o7stKaiBYc10gcSaDXJe0jxXeEf-z5CJPaaP_FHz2G3XFF4_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU93qnBVMeiULwhsRPbDLyOqa6ZfvqtDd6xftgbtGntA&oe=6ACF99D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHIlmjgXFdgQ7kNvwGfzNn3&_nc_oc=Adp3E0w6KnqM33Ga4Xq2aMVIRaTOMD3_6H8pzokoOJGI0VE9VnyuJhEdD7_Tb7VV65g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7q8Em8R6Tqf2aGQHHcg9fScU6ak_UfrpVrivufmLFpw&oe=6ACFAD7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
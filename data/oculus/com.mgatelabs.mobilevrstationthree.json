-30-22.png", "id": "337739244568730", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsqWEeNEZ3MQ7kNvwE75Yiw&_nc_oc=Adq07F-P9P4IIhJOKBei2-57TXmAPzMvJ7n0Py_j5_jZxmuymwhdx8V3bViSJBjwVIE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QutFHzuAcWcsfpQQV4DcywxYBi_UTQN25Za0P4lpBuA&oe=6A1AE731"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmArVPvbR0kQ7kNvwHJj5cA&_nc_oc=AdrYzECdIqLeF-TabWl2KqNyFGz54dqjlaju2yOyTudj_tVGeFYf7ke3LlOVBjijW7k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CPu8LVfwJOFBwanmpDjJfxZyBbQSpDlPCqrfWv4NJvA&oe=6A1ADA94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQkSj3yte7wQ7kNvwHIDiLk&_nc_oc=AdrWeP_tkafNPSl0IUPUm2KP51ldUk3aN5X2Lg7R9Fyglv4hk8nM5T39YdrwfoGjlBg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pE-sSYdiSDxvrlv2D7NJBtJnc9feqIiWa-kCjgZMaDA&oe=6A1B0D35"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpCy-v8e7sYQ7kNvwFRCQMf&_nc_oc=AdrvcTULDhAT4Zh7H0rDBHZKueIvldj4u23qC4XBEAlY5ermJIWhw5evkOaxsTlkKsA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JdMEVlN5ZI_VIu99QcOY7t7IAjGcsBOqwGhfh47cs5Q&oe=6A1AFC57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXF-ajHKfHMQ7kNvwFLHfz3&_nc_oc=AdpLPhJLb4quvveAuyHYwj2G8HrTz1780eOzp_Zc54rE_gCJeQH9Mfb23Y5w-ggnd2A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ioEm8K64avA1VtJftKqETJauPQvVM528glk7bQ9XzZg&oe=6A1AD7BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
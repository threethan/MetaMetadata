730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3mfItMf25wQ7kNvwEGzitP&_nc_oc=Adle8-E2e4nKjl8oYaQUxsldlu64kbYZPZBoKJW0h_TfGsq39vbzZIrvmcNe95OwITU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjFAO0v33XRymS4JzI_Egan0nGurJA-nm4nd7PrrEyAw&oe=69AD7AB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRU5geoXqVcQ7kNvwHbeNF0&_nc_oc=AdlIJtz9VcI1kVZFt6lWRCI8qTZrHTxxlCzKwAPZtW_my3d9fiVerKJ1CfGt9veKa0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzmfpY3YyYYJsZf7brotOOojlKB2JeaNqt8TNDEjXniw&oe=69AD6E14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBGIEyCqazUQ7kNvwGESgpW&_nc_oc=AdkG3n5eAUiLtjRWTbZrEQjvLudd4sz0W3bbwgxBzW16rUvIXP1pkto-dQmYhviB1HA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp9HYqWJ-l66EvhD34Y4szYgHtfjUD0R0H7X26z8cpzg&oe=69AD6875"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWrbxPcfKnMQ7kNvwHOqHns&_nc_oc=AdkybJg1M5Qv8QUNQe-Q4mjXfH2RpcvSKzldvv26EAPcY-NwtXY4ogAypRWurEQLiF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDiIZ9DFpEUhKis6pulmDqHIe7cQzreF4uED2_0jfHMQ&oe=69AD5797"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=056FuSp6xFkQ7kNvwEI-99i&_nc_oc=AdmrbTmcjnKFHf9KGYV_o0e5d-Gb1Ssl0Rrb-JexC9hoXMy7YSOqDGRp99jXyn2k3v8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvHLkdrF180oczkBYpKooqEV1HuPN0ICsoVkSZgGihKA&oe=69AD6B3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
0-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yfz3u6INeZUQ7kNvwHpYCPl&_nc_oc=AdqzqsZRoGfGRvyt_kVMxbnvVPo-_YeSDsnR6Lx-tZVPbZdsBjITg7jrc3xqy0dBiqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzw64DOO1_ErUBf75Kfe5i2xunQEhX5pLhQaILtDnScYg&oe=69C92A31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSy173Y35SgQ7kNvwEXaO0s&_nc_oc=AdpSke1ujS9P7VRLwFggFPO1R7hrJCIX6ACpqJECGp8qBJdXtI9ivuOJE1T6jMhQ6-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpBxztYZRws_yjZGhNzxlLv9IY4InBmDXtSevTvZ9OZQ&oe=69C91D94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6WFRL9c5N4Q7kNvwEyULAT&_nc_oc=AdpUzq4yQ6GOKTAM5WQCVNNou66PQ_v35Lt3m4yXJZep8vprSAEF52Pc8-YUxqCRtcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJXqcqYpIkJ0BgOYScLP4Zlv-yinCbrA8YUZc5V9ZVbg&oe=69C917F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_RIODfmB_sQ7kNvwFPcHzH&_nc_oc=AdrGAyZ0Awi3-I6UOsg-gVysxAr-uJDv24kYxFHYucKWaLD3a0jJ-fg2tEX72VOPWH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFiSxRX0ZaooKNQQ1JX8BpEV6eOnx1t3eMH3UMu3FgTA&oe=69C90717"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv70VRct9TgQ7kNvwEtUvLM&_nc_oc=Adr8RZ37YPeza1UAWe3CPUKtnIu7Hvp0ozwG2cuIXrn41b4TaZw78oTH-nJYfKU8Lm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxa8t0i0x8wnDnRUs0NRDQrniuokLrS9RQJA0CmhRcfkw&oe=69C91ABE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
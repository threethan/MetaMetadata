4568730", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyjP8N2mrl4Q7kNvwF3v9Vj&_nc_oc=Adk1ujwh2G1bkwi0hK3FDEvv3hSHHxUBVDoYXD8lJgzvJe5E4fl5NPH5RRJmoKaoorE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfycWG0M_HEF5yo2EWPUOJzbBVStztS8Pfp11fHgf0iIrw&oe=69AAD7B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OctZ7PG5beEQ7kNvwEJL7eO&_nc_oc=Adm10coTK3ft07pK37gfSaYsaZTdBRUxbQVMMbgnWYXZ5FNAGJH1hjkPR3OYps9E4YM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfmK2R1GqDCRR0LGMd6TizkVFyK6SnbESSXK6Wnp2KZQ&oe=69AACB14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBGIEyCqazUQ7kNvwENotTo&_nc_oc=Adl24P9yMPTrYYXbt3NGOAcWZBSnLFYQsTgKx_8ytcNYwAYJdZcLLjQj_Fq0yYTifmk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUA1uBno98zh6Pbkwpq16qKU_sZckV97F2hkuORALsOQ&oe=69AAC575"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bqYYo1-un8Q7kNvwGQX9De&_nc_oc=Adkfp1e6i4rJrCf4xKXpC0yWI0IxzbYDeev7x1mD1kmWpxuMrXUjFl4X1ZWjk3KrdlQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypFa0V3Fx8QL4Gs4iLI_UlpoRc1U2ga8WRQRWYyDvc4w&oe=69AAB497"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUPGHTTkZqMQ7kNvwFUq1XL&_nc_oc=Admu2sPVkbI6OH1NRFWBg8yV5Sj1u-u0T9R0nIys5nSL4xwatPDv3jJPd7SKYRhKBZA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWA4NCrmJcbVtjf94N-0QxHo6kjlM4xyXT-I-TLxRugg&oe=69AAC83E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
71_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Uh8MjGdv4sQ7kNvwEBE85D&_nc_oc=Adn_DrA6o65eHgZuYPCawKnyI_DrUkwFWhg2xWfsnxFZoq0Nwpi-z5ekOG1tvFeW1Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvvUqrMCWaw5FtAHc_mSg7A992VlT39L_yJTjZbyPoTrQ&oe=699EFA31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcXTqvTbAlAQ7kNvwGMUJUM&_nc_oc=AdnQ-fRZqOANbOENatqbarmNh69XrTj9GyNFJ4rCiMypYWx6LwGn_7PxL3Xnws0zVzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3P1hrRnxzC3WH9zmi3zyEM-17aPcUyfYttyTV_62bpg&oe=699EED94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKeiJtqen3UQ7kNvwFZ62iw&_nc_oc=AdnLbrhrXkZOe_TkvR6HoUTXbDEsf-1pIPYrXwDJvLwRdxWyr96deKh7Kh0zNoYxP-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvuv5LRIpBsw8RDdvpLVZNJJoa64a0u9IezvKbHNUVF5Q&oe=699EE7F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6Pi314MQ7sQ7kNvwF-W5tU&_nc_oc=Adm5FQfjnJHgIUrv66u7uIMLae0lHrExNW8xrPN5bcP1taClnaKiszIArFDUoF6falE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuWZ9mVUrv4kXWpIty0FNIlhXg4IZHdba30gdC2vz7Kfw&oe=699ED717"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BbPs83J_YUQ7kNvwFH2VGv&_nc_oc=AdlF8pQriXJzWa9jEhhqAF9wUW4fRzxKz6xbgD9GYjuaKQLxIFa5tNCq1l2CFujJlNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvVo8KWrEJs1snbGRN4a2XVGwhbWoeiPNOrqXsaga5qrg&oe=699EEABE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING",
-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qx-HSO87UAQ7kNvwFcDag4&_nc_oc=Adq_3wv_B806iwAeLUH1RjT0nP6nPP0Pcn8jXNDwUaXozjhr7otfqYghw-oGhWWVALM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWUVAR0DSptWyFscS67wxA_MapuJc9uQ5sc_XYWdPSHg&oe=6AB7C9B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrA4D-s408wQ7kNvwGxWv3b&_nc_oc=Adq9QLeD0cnm0zHeZGCpU9VTYPnXeyGl7qt8VAfkV_wyDso8BLFlOsr_LMKeXTwyL50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqNtdxSTHTmKQ53C25kocLezBrTtYDwGhcFTC96SoR8w&oe=6AB7BD14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS_j5x2I0o4Q7kNvwHEK3QG&_nc_oc=Adr-pOS5u2nl3c_oDORzG76sk-CZpUlx_ScPpz9mE-haMIi7GqsCsFSeaabyWvK3HAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7mHiYF7XXU6Mfn3hlmamV8dkWmhIY-VG_pnjs7015pQ&oe=6AB7EFB5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsuSKk4T-TsQ7kNvwG_EzBz&_nc_oc=AdqoKS8NRbAkBY6FdxY4ifBuTaaCpxONH6sJPi-vacoKosd5TPQ1xRbe64BX3_lPKYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1YkM6ljGJLEm8vXFyk_FHYeJIcTJsbLoX-oQPK2v29A&oe=6AB7DED7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaQBzce_fYkQ7kNvwHStECy&_nc_oc=AdoUdyIDM-oRKhGc-A9HaW7DtDiHg5L_-5MfdfJlh_jjlo_AKq3s7UfGjsAo68cGJM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgRwsAv6Ji_F5ef3Z_rWGYskhrd_D7hSEemie1QOsBiQ&oe=6AB7BA3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
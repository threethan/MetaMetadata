-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJsb6TftqLEQ7kNvwEJfRrz&_nc_oc=AdqCW05JgUBm6zarHkadiG8WsgqKZMCN9YUaDRsnZy3ti0e0hBPukwcZqqtPBaTw4h8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx36Nk7T-NpsIgFbOd31UXHDjbr4rmAWuvJRlY3veJ_VA&oe=69CE7031"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGxvYLIf_aQQ7kNvwGPRT6D&_nc_oc=AdqoS_eG_OECQj3eqcLk2CHb2Uv8wATa99ryg-_9Jp_lGo7DXyJuLcRtrMgfYOvKVuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFBV-7z1zWZwDM97IECuAyimSuj7M7Kmj7eX8HuYUAIw&oe=69CE6394"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjaBiVC_HEsQ7kNvwHZ_Qqp&_nc_oc=Adpib6SMoOOabM7WzUOtp4UOkZulyRWGE2OFKBbrHuAhH2w27n5pqU6EpyDVvMSsQz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO2mWiP2Lk68_nIXADxxbljHxgG6RHQxIvB9-XUI1-8w&oe=69CE5DF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9YIjUOFvQoQ7kNvwGHK1bt&_nc_oc=AdoktZnmFdq5N_srMhZiWWVT2hyYLOQ7mw_2ot4x789z556pPtzszzMt6PDXDEXpr9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaEE7KKvPwhzlTwo1AwzTfm2_jOx-sAlB887UhLZ3Xsg&oe=69CE4D17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS-09vzsDHoQ7kNvwGyLZJb&_nc_oc=Adr-gBF5ocXM-l98Frnzz8HRiocgr8U50301F5OMVKCvxdFpscGVn0FsQcP5fVm-OPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1TB-hqdfD5FiFnVCewfpW_1Jb9r-9P4YSNXbJJzixyg&oe=69CE60BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
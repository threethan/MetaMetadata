-30-22.png", "id": "337739244568730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4UDdTqZm1AQ7kNvwF1Sw-D&_nc_oc=AdqOrWkFFgwRpyrngyqryM5IAkYb278gUcSwlgFBSRIQzvPWJOKTVpEg3P6wSVtirg8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM56gKAIJZ-ymq9H12gFKc97W1vyotHvAgRf5fwiqJ7Yw&oe=6AD0D631"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7l7xpo_SrQQ7kNvwGzg4WF&_nc_oc=AdoeWA8nzazUK8_SDM2rE7jbHudUTiLx0lQIqiFyaMMLqANgg_CrVmKwXVR3rMtFPwc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7JA75QJeAWbZjYV-YSA_IB1MWXofBZU3iP38syP3bhQ&oe=6AD101D4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWhSjk8oZPMQ7kNvwFvEjHe&_nc_oc=Adpgxzf-rDhXXXDkKHLlfrIkW7tcWMjFZzYuvvQp2LkcfxB9259anh1FVaz0BtAp190&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmz_fa0O9V6kYatkQ7HQRqN065TorICUlE4Rc5E0Xxcg&oe=6AD0FC35"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epNrijzajGIQ7kNvwFItxxX&_nc_oc=Adq96C9Ds98AFOkOn01mowy7LVmAnoUHof6OubgewIJIT7N3SAtaIZ4HiCMw9-_nmF8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAq_Jf_tJC4JvpiuBSY6BBwrWvCspYc4EhpKtTe_N7jg&oe=6AD0EB57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHIlmjgXFdgQ7kNvwGAgzOs&_nc_oc=AdoTe6Iapt1vQutRkkafKbG1Dq925LoQIY5_gmai_DL3oGdkl1Ve91x8mBv1o7bN5v0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd93e6hiQYIfK-tkHqhU-h67UMnwxuMD-Klgrsb_Dlwg&oe=6AD0FEFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIJ4J9EXwMAQ7kNvwGg8ssv&_nc_oc=AdpjhmZpm2gKL2S-vvfZFgDabaQWDcGZhZzw0cyDzOzuA7y2PRTW9573wJ6rV7wmi_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkjPXDn6KSRwW_W-AgIkJb7obPHnd_Vyv4k4N3pgDmLw&oe=6A7C7631"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlnRx0Myj4Q7kNvwGJ9S1u&_nc_oc=Adrkete6JVHWewhd5q-xaDMvDzgM0f9cGnRycovJuRKBZ4xx1noEzlF9x6pUtrp3klo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6FAA54CZG90rKp2a6g7ajGQ9fx7HQr7pCOv7qiTQ6fQ&oe=6A7C6994"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKPudIl34I8Q7kNvwE0QsKU&_nc_oc=AdrsEfp03GDjQG_CniZSOY9h1rZ365JQ9dYSpMUfW_3VT7jPUEWERpNDCMqLf1dwGHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLwTwKkbMZqzKauScnmzdsr6JPnvQQmatWESM7pORGYQ&oe=6A7C63F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOfK4hQ41-wQ7kNvwE7oFOG&_nc_oc=AdovODvxib4pF-Geem6VaNu8UVlGisj3Zi1gtqEqu3krjHkgjSCUJqu7v20yBZtgKn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJkYWNq0R-6BC9JztvJhSbeh6QGStho7w0Brwrhd38fQ&oe=6A7C5317"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5cSbwQkGe4Q7kNvwFzWRc2&_nc_oc=AdrmCzDFX1Ct0Xp2y4nHbBNoRpSuLK69tEtogjkxdNF-16VtwBOPZD7v-cniBpeNG1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGknHwTw8NnN1Y2uC_J9NpgmkIfRD53zAzCMHN97SZWqg&oe=6A7C66BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
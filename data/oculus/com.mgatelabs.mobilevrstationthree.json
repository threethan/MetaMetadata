0-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0Iowk3oQdoQ7kNvwFzmBBw&_nc_oc=Adq81nqUOG3JtMAQwY05eL5pkSg_zbU_T0G3BRmaw-ptmCA5qCW1zv3fy8j52QqrBXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zKcdBXZcz70f0WMIvjWOhP401d4g-c9iakRGEUPBVNA&oe=69D507B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35NnMRUfHooQ7kNvwGZLFvc&_nc_oc=Adp3uZDVnnN7b-othuODkYaOOTtnd7ICLz-ia6HgUogSAmfUFN6mNfy0hvykm6VRXkk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O2XK4Q9ukiE3s5WIGSuK4zt0eedq5avmgEl1zPojdag&oe=69D4FB14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV2Q-MmaIsYQ7kNvwF9X5Kn&_nc_oc=Adpgtu0hhhBWlg74fDmyDDMhMuma2MTCFHwjS1zXWfEUxcHwTJ7TcLUkkqBXKUJiLqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1msJ7J41r6CzIFhWL_RXUJGxl_-G8ECNupENaomUYhQA&oe=69D4F575"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zMB9ZVwfAoQ7kNvwGtnBZr&_nc_oc=AdoUd0KnpBR0YU9dJyzA7TrbOGV_dSbJYnJjCotToHsl9btraSjG_ZgF4XeVGQDKi9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PzNsIyuo5DSSczCjj-610X87DILpWYMGsGi30W0JVCg&oe=69D4E497"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAoiyI1lsdoQ7kNvwGdxqw0&_nc_oc=AdpdsszULD9SPfjCgfrYBMfIG5K9NBGcDfXuAbdacpVXZXrRqA4_C97_OWmfTghKt4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PCYZ-PaT3RgQQ94YPkjlniiR88EnOwXd1DNh2EI6e0Q&oe=69D4F83E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
-15_13-30-22.png", "id": "337739244568730", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs_PRXqRrLIQ7kNvwHVd_CW&_nc_oc=AdpRvrXtsG45e2pzXd8LcdWsHFad9dqe12ocr94yNQWMDtOoqGMviddjTt-6JqLa_ss&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtlvi61KelOsDgL31Ias3vETO7g_xn6E2zkGXy3gqE4Q&oe=6A8EEB31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OIJP8qfMGIQ7kNvwHxT_tB&_nc_oc=AdrOGpYV4tqokIFAIRtlaLZGASh4rwXdw11N-I-Fjkr6d3GpxIVcFYY_RalO13vGntM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_HvBKcr7T_NmxQZ9ZRc4xHrrzLRArYdL-Ev1-25CfEw&oe=6A8EDE94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV9baufMGtMQ7kNvwHKdJHm&_nc_oc=Adr6geAVaUXk68vrFj_qo0yRRuEPVDGN_KGj7pDzOfrwXNgby1j1RVPg_3RIMxV1weM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGAv157Fu8XlhsfbIcIPQpG2pkxCSuMy-fqvryakXHpw&oe=6A8ED8F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3veajEq2xYMQ7kNvwHXTL08&_nc_oc=Adr8darNT0Ppm6oO4EyqNy17tbUlAy2aufjyCd6jBoKQXkLMzOUlhirUZZo5iqqBC0k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiO-6Qf0AgMhY3ikTgPbw5Gf3T6g5qNci4HJO6yKyMgg&oe=6A8EC817"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wBriO2GdooQ7kNvwGOc6CZ&_nc_oc=AdprwwZn5cDsWBFSWmCr3oJfnGbxGnprU6dM4IzyXEHU6N2T8PxMasLWnjgHzDvEAcg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECLB_LraXymZ6yQy9YcpOhM5ljc9-2wqmHjPox0am4gA&oe=6A8EDBBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
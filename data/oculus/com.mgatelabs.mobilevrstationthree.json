-30-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8tHqOn-XXoQ7kNvwEJsFPa&_nc_oc=AdoPHrHFbdal6fxfb3Ektr9bLb7JMCFh5q8rfx_iPEMH4qiP1IFS8fC4uP0duBiK7ns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzj-wpmmAjAOusRNjTb-PRuIv9HxBzsseZTl1NX3BiBA&oe=6ABE6131"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHkznufeCmsQ7kNvwFazHaP&_nc_oc=Adrwu9TBdMSMTnocVcRQCSDize72nn3I10SIj-jZQbRKfPrV0ZBUrXB7dnFY8IX3Fps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSLb9-69a8GHsO4k8H-VBxh66y7XlTdMzZNSiBaltC4w&oe=6ABE8CD4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhag0qkp6AcQ7kNvwEKolIq&_nc_oc=AdoOr-xlyiFo1Q_jXBA0BPKIiKXPwczt0HJFDhxl2F-xcICoNs6RMT_F6DhZ50o3NSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk0QuHdO8dwAKyoO7oIDjyv3OXl21a3HD3sxRC0RTFVw&oe=6ABE8735"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5ZEyhChWRsQ7kNvwHdFy_W&_nc_oc=AdqGqlY7UgTE3Fd-tszfTxtowS5naUNTNFjeZryDl4kcQclhiijQyZskWLN5aNKI2Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXbVoCiKPBcnIoAJBotHYq50q5Yum4tsPl1EpyPRZfZQ&oe=6ABE7657"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D1dUrfzI5IQ7kNvwHOnR4W&_nc_oc=AdrbkEpHxUU-V5CezwaA6WTO5TH63jzjahVgX83TGV_kEkVA-46V_FeYMgW7cJU5GC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS3WqMruuJKu71YaV1QOe1PEeOObG6d4Uunq2wd4txkw&oe=6ABE89FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
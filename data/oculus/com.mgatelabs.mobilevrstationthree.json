-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOEMKxbmaZUQ7kNvwHLNh8i&_nc_oc=AdoMu0Zznn5mCr-HYpNR5IEZ8P1ZRLSHXOjKfqPbojBocEV_vdzFhDI4cgSmK9RvTvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA3HalB3a1qt4FB7y5ql75ZafOipNbNTYnWgtZ5q5IzQ&oe=6A95BAF1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVpryusfoVsQ7kNvwFPnZov&_nc_oc=Adqjj64FY4aDQr5LVQtHK2ooUoVkf8oUoXUPR3im_zEz_U9xZdbrDdnrCX3Rv3A7kOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1Qzu7wtpmF-dvEyXF9dARgvw0sdtpb2FCmkaHt2aMhg&oe=6A95AE54"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw8585cGuHIQ7kNvwE2X0bx&_nc_oc=Adp5kcZR5-IhxB6I47fx6V91X5yn4N1bBU2vwSDxkbviAJf5WHp8OAhau5G4xQt_0sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwlNBYYkXw43uAGKoMFjn457FuqzjbkKB2WgSd71TbZw&oe=6A95E0F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDvtBXADvRkQ7kNvwGiDSds&_nc_oc=Adp9Lun3U6DHptXxkY0gb8ISuIWE21vqrjUj7By_82IZf8_JrsGbb3xsNEqwRkqbNHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlMHSryUCcag-8pnMqGVumlN0EElxJX4ev1Cpjt9cEBw&oe=6A95D017"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSKxsM0ltpoQ7kNvwE4Accw&_nc_oc=AdqXqVMn_YS2tEMKmc0YvxwAtlKShDdsjSRVUn5vfpPVlLpgBT276U_pQBW3ZascCyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbCH-smZAdX_jCLtckGwf3eiICH0SLnM7Y9B0wlChsxg&oe=6A95E3BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
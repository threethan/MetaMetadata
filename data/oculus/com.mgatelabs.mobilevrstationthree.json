_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Uh8MjGdv4sQ7kNvwH0n-kN&_nc_oc=Adk9TLPpqytSkGPmD5CNfZeXg5O12RI6g_UsSdOLp-KE2msR3zOHjD7fwIJMj6S4tUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvOiM6ItrHirAWBu5g2D9-hpM3P_Hr_IMVRta6A0PH0A&oe=699DA8B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcXTqvTbAlAQ7kNvwFlTp8E&_nc_oc=Adk2XFwFp-2WreRgZI_JMcbFQoO7yc-3Mf-BmDo882nxCGKiDbsmjZxH1gpa62_QKKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurPfJuNlyELld9RbBQWMVxsBVWEkNw-3LGJm6pzjl7ag&oe=699D9C14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKNIdnsIEoQ7kNvwEXyL9Z&_nc_oc=AdkioiMM5iHJA1l_U3j8bL7SwpXT9pPmy-iw53gaQQmGjtvm_91qLvwd2hZqOD7sD8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftg4ig9Ld5NRheOiaMjFvrrYDBNtNUyswYGMEuz_PP_-Q&oe=699D9675"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6Pi314MQ7sQ7kNvwFC3__n&_nc_oc=AdlEsRygUTjSCivS8nRIipyS42Km-QyAeJjU3z4NnApltOxzphAQUOtG2PAUWFenoyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4DWRH9P4sBgMUVIUaSq7xJ0Iqs6P60yXW-jCPdZSXgg&oe=699D8597"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BbPs83J_YUQ7kNvwH4U-li&_nc_oc=Adl-vmswypKTQR-GXO8NXvxcK48U23LEzmwewIDY1HiYCkpZlvvlVR0SmenigpT9Lzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUE2tIbHzlPChoc6wdoeM4dCkZYzqzeWAztyGRUIv53Q&oe=699D993E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "
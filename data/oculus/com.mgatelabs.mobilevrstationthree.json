-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiUm768rkL4Q7kNvwE5XoaD&_nc_oc=AdqOIuvIISBZZQ6Eo31iPqSbzk18UKqg_YAQIBrzx7VKAUhx6SfHhNt03HNFZ9Np9wM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqNxtiXPV1C9326U7Wg6Oeww1PZuYDFe4FIe9q10dCdg&oe=6A4D0031"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k95brxNo99gQ7kNvwFeAPir&_nc_oc=Adq-pjVeKO0ZTQdsd5XIjzT53nguTU5a2KgTuipHh1Bwtgptaw2R1jc58Xh5AAk0NqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADUOBwca57K4kDgzquJHuFjst7U4VO0AsNhNVV946J-Q&oe=6A4CF394"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRLglDaQ1CgQ7kNvwHaq5cb&_nc_oc=AdoyVsOnYOQiFInI9UYwDf2BHKiOzlZ3iyU469pO1rJva6R5zdIK-LqtMwlvwBfRk2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_RtWg2zs0wDWHun521q9C-0eB5XcaCWM2cTGbZFQa1w&oe=6A4CEDF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnX7jJs9CO0Q7kNvwHaL5uu&_nc_oc=AdoHhsHbsuB9PpCg4nHPAXO9i_QV9QyKVAuFHDX_lwC2N3jK3BSd2Pi4wXgpftTe8l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHAVa12zrqdL3qNNDQq3pc2fGHlu7qVpMXTwbP4T9Dfw&oe=6A4D1557"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnqfE-2VrE4Q7kNvwE_7Zo6&_nc_oc=AdrVfLfBBwb9P5GfTxRP0gEM8CaLY9UsZnnyFxePXjtpRiy91LL0N4_TeDFpvtl-iYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvDYNlO-axHtALJGjoaeejaWEEUbBz_yk_NHve9wz72w&oe=6A4CF0BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
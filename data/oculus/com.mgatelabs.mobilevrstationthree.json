-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axrvpnwgrwcQ7kNvwF4yd-B&_nc_oc=AdoMnSeBaNtmJ9hOP1cuKAA3o1luFHWVdTmxs-3UwwJyCmn3BN2ixQ_7sF9BQ-mX7X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk6lRt-8i257NtwaVgWG3YoAHlnT0-PyOmuEibKDRxzw&oe=6AF5C031"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CiU3PLszlsQ7kNvwEmIjaS&_nc_oc=AdpTJPrGLBo28r6aFCklXfI883t9GpFgVcN0DkIWooc6POKRUEAdE6uBfcshvIbQsVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxKhVV0nzGtzNcRyxmiw8NHBTUgDRAIRpuHy4PJrbQqg&oe=6AF5EBD4"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31evyzt4iPcQ7kNvwGX0eoB&_nc_oc=Adohto4ljBFEMqpzJLCB_WdqophDIijJvol_kBG1nt0SEV2qDpqPjLV_l_v8r1S7crs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHXG18VcAYeGHP6_XN67u1Qm-3A5cthV8GKMtnDwFhzA&oe=6AF5E635"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOfC5_WXvigQ7kNvwEobO3m&_nc_oc=Adq_ngww6EF1hVpON7mm7u6rA85RVFZCsRAyc5U6LwEqOJVe68HrTBtzUs6oev-M7H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjT6R5Vz4o2VDN-xR_6_McjffHl4PVjJZjrYKOvPsH6Q&oe=6AF5D557"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1dUzm7ZAk4Q7kNvwHoFq6q&_nc_oc=Adq4GFFls3rfBd8PXv7sLTldEIgtWGEPhWmk2nGHCW0q9BUOwEBuCA1JnU3n_WhfDww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnHsT9yPRmv8fFmH12ujTip16SBwOwOUqQw9Wi3Z_-nw&oe=6AF5E8FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
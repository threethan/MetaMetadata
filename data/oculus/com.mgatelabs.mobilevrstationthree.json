-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKKX7ItD7IMQ7kNvwEozhkh&_nc_oc=Adp6TTFk91ILnql7oT8hMoj8ZjPdOGmNoJ2L0pPCud_aBLO94ia0--rD3QsfL0sQZ0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTkJR1_uGD1AwFoMOOuzs5dXR7y2iAeXCZ_BonfiJo0g&oe=6ADCB3B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx0PogyhBQoQ7kNvwGeSKdq&_nc_oc=Adqvzx0HZni8cUylRc_fXS55lz8X545dUh0JZUtNcyLk4v6zkE__uvU5A9hd0mhUBK4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCox3VNbB6jBh7qNkCsa0ZlnpAUg_dECXjHWd0g1dBVw&oe=6ADCA714"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6x_Tqi9P3sQ7kNvwHgePvo&_nc_oc=AdrfElnKmCJ8aCHsos2UaJaOpLMraR2g5IuX4hzLW6ueDEDyTq3DQQYv4ZU1sYAIBkk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYAr8Pcz76QI8ZADWg0W3OXo-3JtPfDiDolv8iJq05hg&oe=6ADCD9B5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q59WIlUF4QcQ7kNvwHabaF8&_nc_oc=AdoG_2ER-vD4dOoU17G3KmthnP_tM4zR-SSal3xSbPikM7oHIKu5oratrxflBe_Qog8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwAEZY5vowj0j46kR1DM2hGVu-R4HOl1SHp19V5xADcw&oe=6ADCC8D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIUQCLRgMOkQ7kNvwHuK1PF&_nc_oc=AdqekOWEXmw48boL4PhLrkPAXLNJqM-0RzOGye8W3FEeWLHYEIaRGBOo7E3etmIJFOA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk0nQHuQuDIZuhl6DQtxo79EJ6Cus_03_8BmRBVB-K_Q&oe=6ADCA43E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
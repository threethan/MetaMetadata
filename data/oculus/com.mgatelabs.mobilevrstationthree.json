0-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqGzI437qcoQ7kNvwGzSVqJ&_nc_oc=AdpGudXdbztZiO0U42Hce5K4-v-MD4QdhBB_6b7klAmxBRSKUIQ6-CF9zIFNdqfGuJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1TqFz5nbtxqNdaMR8lwG8ZB_fm40KdOJEj75PiaH_Dg&oe=69C535B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHoDARyE-54Q7kNvwHfN_mv&_nc_oc=AdrJU1MrB-d07x32HzPBjwZZKhEKa7n69xyRS6QzvYgAsAAfS52stfL8d8aUM05-NNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2cLSIPMD7Mkp0dm3JQ9Ec7UpFef1j2qIHWH_9QJRmOQ&oe=69C52914"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlfXfXcP4LsQ7kNvwGjppeg&_nc_oc=AdraCK9kGAbkTDr0xx-3d_NsIFxprSrqM5cQpbFTpMPSUzmAqn_Tq3k8tT138WrzUTE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypsJ9g7ivVR0dNGKdW3AyzYyOFRa13s-ELIc2J03sZ5A&oe=69C52375"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNjK3NPLaewQ7kNvwGAMstp&_nc_oc=Adp33lnD4exsiRzURzOomcE2pDQg_nrAkZ-t6vWaQvkxaa04rUtWylYS9-iUF0JAi6g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzovRJig77OJJIIYyV26HtNoyRLXPpGbtVP3qCj5uUoJw&oe=69C51297"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAMC_2_62NIQ7kNvwEgmDmV&_nc_oc=AdrJ6Rw_LElfZL2FmVqFN2hfP1X7oB7TivYX72luXhrXDsHRa-IYEzPWb3ViCwcKX3M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlPJY6H9zeN_xQfEf63ajuOOrUpEc6feV4VNqFnNHc5w&oe=69C5263E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
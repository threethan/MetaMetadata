-30-22.png", "id": "337739244568730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuo0eU_Zu_wQ7kNvwGz3KXn&_nc_oc=AdqaXZmxYCNMAElSafr1YSGHxlak4IQ56heJ8kVmub_727AramcwmSvQwwsZJ7NvUbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XzE74rC_e2BK-UrLGMUXkKpis4SCv60rAV6CK0FO9Vw&oe=6A2AB931"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiLszUhWqQ8Q7kNvwFgw1IB&_nc_oc=AdoX7z4aKkdj6epgaAk_RR3s4TjMdV3Lgg0OfaNrJuHcySDttfcvWiikMX2SqRhPn4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ysbbvPL8evm4ylo9WSdwRSh-AjjqS1F2WqAv4rkqZkg&oe=6A2AAC94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAQdDORDUxIQ7kNvwHJEK1x&_nc_oc=AdqqSGg9LmKchBeNXaPgqo931gQEMAFB2gOGD1Hc8Yy4bfzVKHMqquKK8iXe2DKUEQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MVPuS8t6SqYDiCBpv5bZ0hmXqp-J7CFK8WEFAcB88ig&oe=6A2ADF35"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyeJGJOyWjIQ7kNvwFpPg58&_nc_oc=AdoGnmifFysheifbM6yHer-z-M1BFvwIVMgbVjfAhuxFVRv5KaWbqkqxtb8pyRn8QE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nITpHfBM3LOiy0V26yfAqQbtl_cCM_f5Y2AQ34f6OAA&oe=6A2ACE57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLDAzXMcZIcQ7kNvwEjWTVS&_nc_oc=Adp8vZoN8hwa4_FlZEz1qKJSDjcPbFCijhP__K5PgM6u4RMT6oXSBK9dSRCQgquXNpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Byy3csQXoNY3FNCDK14jcdvrO_7U9sTyFWOx59iMZOw&oe=6A2AE1FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
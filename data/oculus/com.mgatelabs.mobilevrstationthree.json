-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plYxyRRHh3gQ7kNvwHzRkjC&_nc_oc=AdrOSrFG9K2hylLH5vAcCDhzzsJengjuer93uQU7oGrBcmpUxPxE4_O0ORy6dSOimNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNzF28Ox-MmyO8RnvAzRyGOxhV1fE4YTSJzGkx_cQ2OA&oe=6AEF60F1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlkX31vwv4UQ7kNvwEihMlg&_nc_oc=AdpukgxtFPBQl2oSMXxoUPYrjOpMGDvshdl9UiVubxrrHapebd5UYsPbM1fl9Oyz2qM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa1wEMqGunfruGbtHUzhL2d4CZGzr2sSLOHELgZyd9cg&oe=6AEF5454"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akPGSbFk6I8Q7kNvwGYo-Xa&_nc_oc=Adoz6JxY0dLJkxGkIDShd_w1dNcKNc14dWUo3IESy7kVIpZ7VYCJzQwHuL7ikMTMKAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROCxmyKuUao38R6PRg5Iej-WTqaFCJ7aSUBOvKH3LWMA&oe=6AEF4EB5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3HkuhVa2tgQ7kNvwFsqlR_&_nc_oc=Ado4WsaquSxW9Jn7pmsc_rlbu1tgFWbAK0EOQMiFIOEHyYw1at3K9zd1O6nnqTae5W0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHeMmg1LjjYspq56GJOxgfuw8FK7iCV2UOrUWDTMx1Ag&oe=6AEF3DD7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVPNApXRDXUQ7kNvwEEBTUf&_nc_oc=Adpgu_p1u6fc3kLhDGdC6APMSo_XtuAGc5fd71dcolQU-QJsFtClvL-FlyLONR2v72A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl8xanV8db6si_hJOtj0c2r8a8B_r4TSnXe8KbYtbXIg&oe=6AEF517E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
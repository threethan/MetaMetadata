-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJmGxnulMZMQ7kNvwGbw6sL&_nc_oc=AdoX8BCjSq1q5CLF9lF06uwA5WmmS6jGMVVhIVZ6Fsp8-DEBZifVGk57pR6r95Go7KY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD326PQjlhxFlfKr9-X5xpR6SL_91fDQLXRYz7X_Jm2BA&oe=6A578C31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5NZDsUlS5QQ7kNvwF1PZRQ&_nc_oc=AdrSzNChRRoyrLxDWygU-Kjn8obeJY2Tb9iwEhrhBxgvqXRHH5T7ECp3m2oTAI6G15k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZm4maIPzSYHlrAVxwINozkHpriqOTE3UqyQZQuo_1Yw&oe=6A577F94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIo-dNwjLi8Q7kNvwF1Lj3b&_nc_oc=AdriQpPCOKmkngo1g8jIsTQ9c3hfNqx7uBcoyxJz-3GH_xepH79EbU_MdTtcqs_hXpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLG7ryoYAIRGLsnq2lnrxLtZbjsLNbxZswdlyvlGOcKw&oe=6A5779F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8A6_HEeqRcQ7kNvwHMKijE&_nc_oc=Ado9mnxvL67ROoOQsDaETVA6-NRCC-uN_WdWa5J3GK_lWJS-3NuIE1xjluUYJTWFMIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvGuCIYanAvXkiE62dS8-C3DytZuRYS1BmEddHg1FNxw&oe=6A57A157"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKeTG2pst8kQ7kNvwGLikoY&_nc_oc=AdpgsiB0VvSjNJ9Q03gybllQON80NmAKE0MTLp7OXRmP6ocUWSX1sLu_wjQflMm_Wts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOpCZQWMyUsuhDl_ps7w-IT4f9GS4RD3i2yQ-qgJC8_w&oe=6A577CBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
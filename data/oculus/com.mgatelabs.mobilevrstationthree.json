-30-22.png", "id": "337739244568730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J6y_pV1BiMQ7kNvwFK7Sxs&_nc_oc=AdpbN-syVyUFAjkbqk_Cyc5798kTgM-4ppFU-3ROi8bq0SdjF2C1JCsWqq37JOL_RWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qgKltc2AzmIxGSxFvnK9khOZP5iKfML-08MSdSbsF2w&oe=69E77CB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQHMjbJqo4Q7kNvwGMCXOW&_nc_oc=AdpSLjTdUbXCnbVtTk-95HyVzSITiy3BwE31s6yBq1O4uTM5Bgeh_NHGIB1e9ziRqSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LX_O5oShfJj6GQx5ci1zOXd8TqkfH9Qabb7rpgSBX1Q&oe=69E77014"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM5iPoH8mxsQ7kNvwEP2PpW&_nc_oc=AdrYgJ5Od57ya5pI1D2vJ4yQeSCmQ0XPno1GdZSLU4Yb3ay5rViVwT2ZYimd0PTsvE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37pXqUWqU6z6HhEltOiw1WEvXSStFqX3LDKnVu1Tmikw&oe=69E76A75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQkhnrMWuhYQ7kNvwEBgeOg&_nc_oc=AdpmJP4sIHaDKxENSJS1OBr5SANqbVPN_k66_Epd-0OqRqK34Hs8haiCQRvXJEk8Agw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FJg1V3Bzb2TCk2dhLjldXf_ln3Mzh8dEFN49yVwS-pw&oe=69E791D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F61qyOsaLBcQ7kNvwGYYmdn&_nc_oc=AdrgHPU-xFFN2rP1MuEv28eG-SdLA2RQzhEFxBt4ojhqviFc3xoMYQVVaiKh_c-VciI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af321MhKTb2YkxrrO4TUmvb5Di3Cyd7ZW8Ryxfl3eclo2Q&oe=69E76D3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
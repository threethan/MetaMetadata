71_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI39v89FyW4Q7kNvwG1KoCy&_nc_oc=AdqxcWRs8l3xqPCNrEmHdsMuQ_g-RNzJbGCP5MeLw66uoCMAsMy3kRou0_8fb2TpbC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1ZA5Ikp4Fvn3-kuz5AzL9afRxvl4s_XZT1EZnHUvaMjw&oe=69F0B731"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dSLDRyU4AUQ7kNvwEiPnkQ&_nc_oc=AdobzKlEpoUIpiRaSHidestrCCrpQhTQPJoLiVjBVxON5C2__gm-DOeDhirvImwYHAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af16_OeWYSN1Tx3nb1f0_dm7jAJHagHPjO93XPjUOQ9t6w&oe=69F0AA94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuYCC2jW_scQ7kNvwH3yPzc&_nc_oc=Adr1VRa4ul5PwJ10r6ObX_b9FXrUTlaSYeQQmWy9oGt1sTgjaYtaAJeiw-baK9j0mAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1rBnjfgk-uZv8PmTqse_dBJv3DqWFyv9KD9XvE5EEo_Q&oe=69F0A4F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b88V5N-N23gQ7kNvwHbz_e7&_nc_oc=Ado9sHaNk5mQT_jsYgxoQ4-SEGwzY_x-CpEkt61AUeclcywIL--DVBW3Qo8hmgkH_PQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3-nATw1ortPj8hLWL-9OEFwBVCYuq4dcdox7kFv-T00Q&oe=69F0CC57"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc5VoiTYwhQQ7kNvwGOnr2e&_nc_oc=AdonZlmryGBLW7-A3Nqypnb-glruVQW_B_Qnse74OXuW7_TRnKNee_OuBSH_pPXAH1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3vWLSaL7ex92Qv61dI5-SLFK1_ljntu3DIgdUqrqiIZQ&oe=69F0A7BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING",
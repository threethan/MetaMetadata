-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59ORsj7yd9QQ7kNvwGD6tv6&_nc_oc=AdorgdUVGlRkYBk7XtP11iGZeR3B1jFKiWNxqhLqKq0E6nw5lCHdxIHyXkJA8Qci6kA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgXOtQfAAerj-KjZbnvQkf6h8wXKo9i0eYpE_-LwsF6w&oe=6A7F1931"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB2RECgxNNkQ7kNvwGiOtrE&_nc_oc=AdrCre4SDTMSEwmQfYJYZ570pINx8uYapXpxyS1bXpzome4ftBh9Az22F8D7vGErbrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU-0wRxYO873tuJHWe_icKm4xvsBVu8NMrRMz5t9PdYg&oe=6A7F0C94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKPudIl34I8Q7kNvwFSQ_lr&_nc_oc=Adp0dS04zvt3J5xY71OKs5lsY3C2prcRIUj7dpvIVn3jDtUo8LtXRUHGc19dtwB99vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhf5A6fmoSCd02lSz-OReEhzEiW9dl6yxcr9JIpBCAIA&oe=6A7F06F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2ZoP2Y1v5oQ7kNvwFvbXIE&_nc_oc=Adodw9qMrUbDShE5-KqmC58ibwzYF4iQJ2pgZRGZ0qimv7-rvklq13MBHnUVtiyRy-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEydPxM5-Hnwo1FOaECN_eNuwOa9Eqfs_O8jurJMDjNkw&oe=6A7EF617"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEHATmivNgIQ7kNvwEh5aPS&_nc_oc=Adrh8yX3gxiHhdIupbd6sjeH7P-xN65-9F2pFb4beUWoR9-TL6ASb4E0GIXH0o9hGHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPKN2l7MyyLfymLUKiMxgN7eVZS9rsacBkeJIKyIGoKA&oe=6A7F09BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
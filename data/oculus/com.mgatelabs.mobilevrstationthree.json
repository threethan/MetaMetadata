-30-22.png", "id": "337739244568730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqGzI437qcoQ7kNvwHptYOX&_nc_oc=Adoz51G32FwOoMi017Ti0r9bbzkQYxW8jMboQodfbIPqID-rHrGMLBDCX8q1M8fJWfg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8EvMbbfhbyppncVw2j76v5KKJnvXp0UHMFO0lL7VIPQ&oe=69C3E431"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ2D3kLhqd0Q7kNvwGwjgqB&_nc_oc=AdrHJzlPxy-6wK9G8FcM2puHwdc-bpPObQv7RsRcta3n0FtaMoh-GL7kqnu_QtsggnI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH1o1-fP4LiXHCBBltBYG8zk6P76xSBhVcJGB_IV0Qsw&oe=69C3D794"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlfXfXcP4LsQ7kNvwHCfZPa&_nc_oc=AdolubKAtQL0fUeTz7yUXw5A0d0xqhHwYTQTT36xDCUiJ7IOUbMKoWQ-l7wvosYZMHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXXxUsUPkwpHfVlnai_hH8u2y4MSVD2HTrJZUJzYmc8Q&oe=69C3D1F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5ZVOF6R7SwQ7kNvwHRdk5h&_nc_oc=Adps8Z8nBdTzz_OiYGKmNpm1SMCE3PHriMum8pzETyiVONH4KYdOeTmzHTQRsVTlMhs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-eAOO4D0XjhUXg65yCPY-frayrL9tgUM16fGjgmS8xQ&oe=69C3C117"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAMC_2_62NIQ7kNvwFZYD0l&_nc_oc=AdoN0V-OMlPFPRFcqapk2f2HULw7yCLA692BglxsBCm7P01LEBRBdeGUo58otW6kSkE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUGjN0WhZWEaFxMv6TSCUPSAoP-WjYY5-aauvPs7Sr7A&oe=69C3D4BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
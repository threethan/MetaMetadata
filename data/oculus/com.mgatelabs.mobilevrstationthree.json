-30-22.png", "id": "337739244568730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i96p4gYtlB4Q7kNvwHd9Wfc&_nc_oc=Ado9MaPDyx_N7Y4KqfRqMiLzUt6UVLZ7IAi8h-PNegGvUUTW0iosfD5Wg1rW87_2SgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP718zUoWwobJr0YwwH2mrPI6-QAGay-rnJwmW75fm6KA&oe=6AE1F9B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT6-rTZ9utAQ7kNvwE9I3XY&_nc_oc=AdoY6IJRX7wTUd3XSr9ZFFzJFLccFTocjFERd7eoVxiI_HOOR6ogBslUSMVDL6f_p1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnfe8JGz6aNIwWckjUhjY6pLMWcdUvj0WOmXVesXH_Kw&oe=6AE1ED14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PszTiEkdEocQ7kNvwHvaFI1&_nc_oc=Adp0lfdzxPi3Mb3ooil3Rd88z_hZrwCh2EnEA5j7o6FSQotYXuKcNFM8s4wJvGaOBCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpHKO1KLZOIJPuubuF34KdMxPGZc_MN0Q1-H062t9bRA&oe=6AE1E775"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUms6Dctr8cQ7kNvwEiWzh0&_nc_oc=AdpIcyXZSx_RjdBXvU2XltsAxyCc2-qQk7VgmmgCT7URZvsF97Ut-gLr3tMH8UI4h8c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPunXOijuGm1vfYV2ElnzWTNFIGCtfRb5SGH5VPp-0QJQ&oe=6AE20ED7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmIaekYkqekQ7kNvwFwuD9P&_nc_oc=Adq6a8bfba-uOdU8r4X95oAKYZ53ZuX6y5XlETDWfxQ4XoG1UkPsC5YaObX77wmzejk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-MmaZItW1ln8Qvih_OjwCZwrpJLE1vu4bzlxVhDg6Aw&oe=6AE1EA3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
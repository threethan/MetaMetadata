-30-22.png", "id": "337739244568730", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOMji9u_NwoQ7kNvwH8eYJ4&_nc_oc=AdpdLRI4SA9BsPP-k13XWP6N3KdN1Xaq8Mq57XUTAdzQRctm5OlHRHWu7U5U9xdJaK0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W4mMvyf0AkSSXEKiowOJMboKygdO1F_nVr2RACyz-RA&oe=6A105B31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEORtElC0W4Q7kNvwFMC0Wy&_nc_oc=AdrcZ3zXVVbzHNuyaRO_7cSueIM4x7JeAAd4gWSx778wgkieWHD6nlnWrCntEsh5aXs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QZS9w-31jbcjKx6R0ednXOQn0tB6ZtgdSZuMQJIP4XA&oe=6A104E94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj2EKv9pN2wQ7kNvwFAqwNr&_nc_oc=AdpJzXZr5QD3wDE4WHRfGHUcoxAqYL2qEMSwFIN8pJC1SAbjkVqLDMFPEur9VGcW9QQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Nj4vlP4o04N46pjoEfBgkhKsL-YE7u_qJPc06tYZ9A&oe=6A1048F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QxSuPar_IgQ7kNvwGBr8lN&_nc_oc=AdqW0U_Xs5aOEGAoC4gVQQiERM-NHGQQBO3W5F6WMrYdapcNm0AiLHvpgPjtDsYfnSM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B_gT_0de4INlNPBX8s52gSphmJ-GxTpCkLpUHfgBn2w&oe=6A107057"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a9Y71PcAtUQ7kNvwGz12tj&_nc_oc=Adp8IKzb8lKCKn55v-hwyDnrsHqgf3jm3_dWQkA0x0NQpLxbTbedXQ3mUYeVdymsVyM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49gu9YVH-hxrbrZybpLcB4IHpjVgB0P6sFjFERUrJmhQ&oe=6A104BBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
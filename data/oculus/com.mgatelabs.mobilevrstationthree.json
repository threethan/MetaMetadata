_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjcIXBQ1gqcQ7kNvwE_tFqi&_nc_oc=AdmkLkkzZL0wXAi_GFMr3TBJl8gGNzUglK_ncLUQSIpDyU7IWP_KKCVkbGDCck4LvTk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsAsh72MFNzyhtyN0xB1UyujO_k6qmugwXexCIZ4CwsNw&oe=69A19D31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vCUkgmyfQYQ7kNvwGWOW83&_nc_oc=AdlNUO4Sgr2v6xhR1lgDWt0-NJvwJ-X13WvCuXLyG00F3FLTluYw7N2I2xLPpKQrxJc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfthqdUDvHyskeJhfg4BTX2KxwTvB4Bi5WsUq2rQXa0t6Q&oe=69A19094"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKeiJtqen3UQ7kNvwFtO2dL&_nc_oc=Adk5SM_0ttoQWTP2ylRohK3L-y6YLywC3o24fvv_lxeWZvp1aLO5QLkxnITtZKGuQDA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsQuw3_NgJQb2wtRCyp-hDgp0x70KsjXhinCrysucFoKQ&oe=69A18AF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hpo3qqUa-IQ7kNvwGg4A6y&_nc_oc=Admshw6KTuue3LDXeWW4WBihXli11yPzPMFm-OHoPXYybB_zlc_LYi6nRGdPgFmAPeE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv2gCk1f3VZxFc4hYDMBk4x1HU1wzZUAHbmb7fTNM-2vg&oe=69A17A17"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVj5KKkVy2wQ7kNvwH6jG54&_nc_oc=Adnmqq_Lg7d-CPHV7Pm6Xq-j4avWGmTClNC0LFIdXOwgpQmxmT7PEV18onl5ua9P4TQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuUAXQS5_jBQXMPzX6FxVf0JUL4LNU_Frpfge7oNlJNbw&oe=69A18DBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "
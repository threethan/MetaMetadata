-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hMdjm78zWUQ7kNvwGe8sPG&_nc_oc=AdrSiIuVjTgLHuQ5PGvN1Yabytt6-i0eClrUnvAsWm2N4qgz4F6DBRV-Ex4TDDJh3wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ozk6-1WrkwGMOiZXbRvRCdii6BmLyxVb7RxWoisDo1Q&oe=6A05CF31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0tZUfAjEvMQ7kNvwFFqKN9&_nc_oc=AdpOBmwYdF_BcHxm_X_rcF1BvVa8RHGM8FqBTFE4i3BVMG6hRe8P0cEsAdB8KtViMnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qsY4yKEDXkVMn0uYq0M0b4eQMKDML2gVmoocNuLFsCw&oe=6A05C294"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7nrobovYfwQ7kNvwHKCm4T&_nc_oc=AdqhgNEv1Q1_RRKdUMizcrxFinLtQQTryBTHOuKFW3QlLIc-ETiMz4rTeT_rrfWf4f4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZMaimCaJQowXfXlhRNAy9wr9Z-_K2Wx_yZh4sfUoTwg&oe=6A05BCF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha3P7MKw1SYQ7kNvwHfdjLr&_nc_oc=Adp9h_4n8HGSu_iRBkbcqT1xiT8yw-KvJlKgTUf9TZZT6NgqcUvw3ztZwWXGMS6B070&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UUkg-uXpqr3Fm_OWKPWRXTYcr-cPQaipOsRNDnfz5WQ&oe=6A05E457"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxDjGrKRml4Q7kNvwEexthJ&_nc_oc=AdrWkPONuPF3g_VgRyuvj06e_nsRYMLhJtkfflZLG0MSMfrPuKamNvKW8ZvvtX87jW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69ad-U2bQml4-Kge83Y5RECy5x0DsAWdN8R_Im_UPMlg&oe=6A05BFBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dhd2VpFJts8Q7kNvwGposw_&_nc_oc=AdrVlBb29eq4sWqrEIwZJKG4CtYlLnpfWNNhEB455kmCcQT4NcfFHjSavEEq3VrwXvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gWS-456-BOdr3nTxPnTa6H1IqvKf1V6IUUT7_CtkTxw&oe=69E4D9B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQHMjbJqo4Q7kNvwH20SYT&_nc_oc=AdoxBsTp_B3wQJdIWu8AIT_9wVMhp-Yxk9l0bW--N1IrL8nqTKQpB0H8IeIicvPBrxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05hUAuy_MuSVXEMKZVV9iPCYlFx1Cmw85XPpd3SlZPdw&oe=69E4CD14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcheTddBZHQQ7kNvwHgAh5i&_nc_oc=AdrGlQAYqCNNuHVsCo_N3oQfYziOkauPJQZvanGzQYdxYM1I1Ilrz8GoXTkPnrW1qek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f_N7KMH8_XODNC1spRqum9PWp47NAfayQWHRNsR0BMA&oe=69E4C775"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQkhnrMWuhYQ7kNvwF5joW9&_nc_oc=AdoDd88FjHw8owYW8jL_ZQpeiOq54h_NIvx3RtyIobbzV568jjfmdXDK9vJ2x-fuyDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Gt4PeXZDxBZXCu-VnRLpbxXfGw_hAS-hKw5HpMMlwhQ&oe=69E4B697"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQWeSmehbSAQ7kNvwFYtpu4&_nc_oc=AdrmdvpoKE31E1x0lQZim8YN2loJpAimX_YdD1cp9bNksVS8ODJ3NnzpndepVmHHdU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TL1135WvA_AKlaci50WZ2YTq0uOD5ADX4cgug6EPcIA&oe=69E4CA3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
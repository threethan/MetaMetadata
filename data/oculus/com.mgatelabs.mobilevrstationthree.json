71_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH0zdcd7YFUQ7kNvwEGxnDN&_nc_oc=AdnaE-6RshGCDiHz1uPxs5XPb8--cktLdr2r4-7uZuAQB35pYkPlIXq2dOQgXr4QMzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu13UYQj7f7FR1I-cxe_GgSp9ZiwENRJIAOGoOOr2-4qA&oe=6999B431"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grXs0mMZqXwQ7kNvwF0n0ey&_nc_oc=AdnD_UB95ucvWxiCebwdanVr0-dsb4DN_runi_Pp2TeMrGkBEw1nE-V8a5-avwmcwG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAT6oiJp3BwD0jxjyc_YThh9s4kCWR47OHSJwwkXG4fA&oe=6999A794"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edymSs8OC9oQ7kNvwF5xVP5&_nc_oc=AdloQSBfCCy8vVsj0Qkeyii2AIzj9hVEqXBagbpxuZnmTjiV5wc3CIoqTsaKVJGGb60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afty57v2EUT2nkeB-0at-dYwaBeUGl3_62KaCO3jbMIIbw&oe=6999A1F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQjD-s3GKtwQ7kNvwHEfMPO&_nc_oc=AdmugDxbGp0T2oVVUzocaoYYmJZxcMmBx2M-ShnNqAG6zMXRhbo_I4BePM6VP-YZBR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuvS_y6MnkVRJzQFJjqe5_snwBr6dKfsOLbKgSlxJrD5Q&oe=69999117"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjbRYENAvTYQ7kNvwEAcvgF&_nc_oc=AdkSJD7LFjkLl-ksJN5q4OVs7CWK5jOAAyjZiqx5olXw2_rU_Few5jkzpGIgk7AWcXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIHxX9i7Zc52W1kbBrhPQpFUrO4StTKyTeTCOWFH4sKw&oe=6999A4BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING",
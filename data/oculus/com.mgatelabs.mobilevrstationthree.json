0-22.png", "id": "337739244568730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3q4zikZdb4Q7kNvwFb-T8j&_nc_oc=AdpYab_0IBiYvBhNUvWSdg8Cb3UVqFe3DBlywqg0ZDLAjvVD3dLLuLF8msn-Pi0nZHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lljTJ9UYZe8UxDe8MBwcqsJJNhf6XcZcLLiTG-OnpYg&oe=69DA4DB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccYueiDstqcQ7kNvwEDjzJP&_nc_oc=AdpO_LIKKfTLeYBSbyib0coN-q2kFasPFqu4fgiEmZT9QAjacfEBT-qiicfWzu0HdUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SR3zeXgzpmBsZMDApuWiPdB7ENAoLklHPjucP0OV5Rg&oe=69DA4114"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGeyYKwtaZcQ7kNvwG0Hp4f&_nc_oc=AdqaVwIxje3Mtxa5m_-tEm22orZ99bZug2WL5LzQ9gWmX07mWD3QePh1RMdiZza3x84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wEd-PpJAZdRcX_I7t0oP3i9l-kqoLsHwtbjXFnmUL0Q&oe=69DA3B75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvIiyfr_zvcQ7kNvwEhOTJF&_nc_oc=Adoj5fngo59iAQyyvReYkXPpzKjfLSVLIAHnW1GLEQKsWjF1TEMn6GZSjDRmNiqP1T8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zBf7Vv83EXjlZ0mUCAhz9-bPJNUEEIQTRvw4KXmsnag&oe=69DA2A97"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9Uh3nluyPEQ7kNvwFn4OlV&_nc_oc=AdrJGqCIATuN_6BAdRTDlz6YMhjarnoYeRgdvGK6AivSss8rFxHzEm1xNO20Jnmn4T4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WGWVMzjmXAwgeGP3y3uAIf_ThjsXQmUa0EUNUTPOqBg&oe=69DA3E3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
-30-22.png", "id": "337739244568730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axrvpnwgrwcQ7kNvwH11kNu&_nc_oc=Adoj64mtK5QCaBroW7gDsMhFm0qjS5Oez2IImQUs0krI8Xf2wy42-kTmqXFTrTLfCSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDFnEZIYfXAGaO8TKWIs5TgPZO0N2jJB2SGPBzZvbyUQ&oe=6AF749F1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CiU3PLszlsQ7kNvwEBkBsi&_nc_oc=AdqcprmeZBc048dfp6yzNlznFYEdldmayglwEEW8FR7U0liu4Pg8qzkPgZ8JyF4_Cqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj8Y4O3EHfLE9oSgy2ihOmaC_DW9y6xE2IT4WVycikvw&oe=6AF73D54"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOzSAcjtNGQQ7kNvwGUzTOS&_nc_oc=AdoCXVsTBbeWdJA8iDxpMJAJiR1k6_kqJiEe-TFWSBI3O2WXxeOUCUxlw-jqqJgNa3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4aqgLz5CAzTE04jp7aIBujDLM9t5eL7tshrxFkYAQbw&oe=6AF737B5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOfC5_WXvigQ7kNvwEg-Lju&_nc_oc=AdofWW22uygt4GUoTCZyum3kd-7zqQgZ3LwWLwh7PjU8FKRZg8vOsG-GM0Fjfb9aSzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7i_IjdFxTCnYTDuapaOsy1HP8oXo_DzhehCmD0kK_8Q&oe=6AF726D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u20S6lVwREIQ7kNvwFZSzSr&_nc_oc=Adqc_IeYW5yqOnSiM7mzdR8FEERJuNTHKeSTwtQqmo7KHbVTOQhtZHaoQcosUIZc_Is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmYkGNZAt-5z_b1GT5y0-Xa5mt8pf6HLAi4yID3UsNPw&oe=6AF73A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
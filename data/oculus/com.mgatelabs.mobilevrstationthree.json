0-22.png", "id": "337739244568730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z_QkAu9wt8Q7kNvwHFUhfP&_nc_oc=Adpdg57G6JGYNKlkwldmRrfC7g5XM7jmTLGE-MiYZ2IduCRvbT-Zvt0dJIxycczo_GI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Je3ewGGjr41-mFLfTaPVtHJSs4E_0XYKgHC3NrjpB8w&oe=69FB4331"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb9YIrbkKBcQ7kNvwERhrql&_nc_oc=AdoCYT6FQSxIlCh4iFIKtj6zYEZpa-mM4AL0OSeP9WjBoQRnZmUnsoLS0WCxktzEN-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5llo2AfuI3KUi1hRccLyxYFBdqm7IRUnk5OVPe3Nc-Zw&oe=69FB3694"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyT4ISwmViUQ7kNvwGx_dP0&_nc_oc=AdraiUZDirtQWS6e1GGTCQQmbhimgSJkBqRFvQ3xhOZD7nw8ziYcZ8PY1gc8laSSPZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af669tr79Y_HywA5StHYx_uWSkEcPopO3QK-X9EjqA--Cg&oe=69FB30F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJPzrE2c3lMQ7kNvwGgRN_N&_nc_oc=AdrgbQhMFXZMv13M0CqfCtC2wHVPHSBAomDQAL5K8y1QkwaRl3ZZ-eiVt9RW-I8eIt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Lyq534qSxbX-RViGfpkPSDx8NLLE5vkH9d-vBCGlAA&oe=69FB5857"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8STqCZEwHFAQ7kNvwFsOjLJ&_nc_oc=AdoaLFDXuorSFHcaM4dSVQx7CzHckJvmFkXUnU3QitYwmrAO7pQ6l-gXzSCuMeA9Vm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YEqmZrw6sOro5BcmeWQXplcBv-4XOlNUDYXSG9ez8yA&oe=69FB33BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
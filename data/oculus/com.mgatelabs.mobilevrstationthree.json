-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U81tohu8ysQ7kNvwEQZaWq&_nc_oc=Adov23_JaEq-06-gVg9q46ReTZirnMaLFM0wbiiUOq63W794zOE9ROW_626h3Dr6niE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEcOF0EGpFzNBe80sJZLI40W7Tvk2iIHdF2-5rSQtq6A&oe=6AE5EE31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM9Z5nL_n7MQ7kNvwEyN8na&_nc_oc=AdoIFEqrxsts4412g0vKVBYKVwhIIrutKL8PYYztB2sv73m8o6xKSpXOrNPh1A5Euoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMk0hSk9LuyPnAitUURKjVz1v7dZX0p0A3Henz0Hc5bFQ&oe=6AE5E194"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7qhltAli_gQ7kNvwHokEHM&_nc_oc=AdrnoG1sftVcyrt6DlS32B4K5iPiMqlRfDkGnELfSGtVjefBg_f6d7BIcSLLjb2fsuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmXd7NOggMeb9PgTTySqAes7FcSA6ix0C_gJkfCpsJpQ&oe=6AE61435"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCvs4t3JjaAQ7kNvwFwP1FB&_nc_oc=AdqWEvIPaclCz5KhmjL1yS4DHdsIMq9tsqLPpkovGzN_l6wwq1BiFD_TNbm6F0U1q3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6nX68_o59bILPJ6l75tXr2ZTC0iAnRZWggvBrU4aLpQ&oe=6AE60357"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gsc2OVpGF4Q7kNvwHBoOa9&_nc_oc=AdqvGjoMazrvK6jvFzdQfPHRF40QTWHu35gJv24j0SilvKEYQ4QIKwyqZAzb1nFJ6oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv5tpVtU_gLNV5f8msDU6f0XOhWd5XQtOCFlNW1FHcDg&oe=6AE616FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-15_13-30-22.png", "id": "337739244568730", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs_PRXqRrLIQ7kNvwFslgVf&_nc_oc=AdpGeZdOE838_7lFbf8JSIH8PMEHE_yfbtI50JwAikIR27Eg1t_ShCbyxz4WNpRmBSk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1sP3F-JQB2co8YzqTf2kPkYOr0LUkdZuN0qIYDFITFA&oe=6A8D99B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm7pwvmQo5IQ7kNvwElgX1a&_nc_oc=AdqMWzJ-dOGhJsez_tFcWgFB5f50ns2FQ7ycLS8aFcUA6BFJDCQqnfGncQd6i7Y8vGQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb-Bupw_iUG24hmuEaLTIg9YiRGQgRYs_DdU7weplr0w&oe=6A8D8D14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV9baufMGtMQ7kNvwH2U9EB&_nc_oc=Adq6vMdJXPoMipeumRy41BlEsKHPwe7lIyQJppkCLgNCuewq-KELZoS7gOp3u3nSfbc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtLjXj3SlHkqwV0m4YoyJuedtTjOZUx0JvS6Hj_3BnBg&oe=6A8D8775"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0x80n7dQTwQ7kNvwFPPw0I&_nc_oc=AdrXc1sGF40dXz8uPrc0RavHKunUowBl-2jY5xACGoCfB1GRrJ_r6mO4htNT0VvGZWs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlV4I8stX7ifJdifK2W4cc_ViOSSsvgd3HToUYtX9lVQ&oe=6A8D7697"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wBriO2GdooQ7kNvwHkUT6d&_nc_oc=Adpu1ROwn-zKC31kR9iBwUjZgWdk8_E2YqLRoQFvlFsp3tMrUdZi3cLHK7n8E45qtMc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZo9WvP_VTqwZXl2MVv_g6LWjL8dkJkfW2AjRXOlSZkQ&oe=6A8D8A3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
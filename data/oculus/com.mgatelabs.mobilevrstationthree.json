0", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7FIUL5tf78Q7kNvwEa3VNj&_nc_oc=Adk7iUNbvaJ9xlBFXDGxSIfE9n4TrtgNSZnjaecuTH1XhTQBuIEtpI6WYb6kByTU59g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0n8IEZUgiX16fqSmWosweTUw_4QwIteR56_bm4jkDMw&oe=69B2C0B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVPI0dDcj6MQ7kNvwHdHdCX&_nc_oc=AdnG-caR1jxZKht_FfPssCIb5CRlpuhRVn1RtDExQZ__uxmxyTixpFm4ag5kOuy2ptw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNfIsRj-GXaRdm7qD1BX4hoJt1fQukpeJDqN-ccsXcmg&oe=69B2B414"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sneZBJGpSoQ7kNvwGtrkhP&_nc_oc=AdlU7Ym-ZC_KKEy8NQ7CKEInIk_HkAEEoNBwhxkXS8Pr5835eZ5k8rKVc4AfeTrMhZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJRmSBjHvuKLzKp3XNH3M-T77_c0psxfqdt22wy9l9Sg&oe=69B2AE75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_uePGsyPEUQ7kNvwEmXShA&_nc_oc=AdnDge_z1KBOKl4cCTlEquROows38q_dSxiXXOtdRBmDoMOppgT8Sh_WLIVEHuoBV8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz67j_cM7OfdwZdP7OMpdsc-b4nxIi59xqrlWbAmjfFOg&oe=69B29D97"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmE5RkBLUQMQ7kNvwEXB3cZ&_nc_oc=AdnoiNWOfO_Q77SEimx2n8A_GjBL9I20ZcIsDdd4I3mpFBKYJvaIOP-RxlBq6wKIUNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmwGghyOTRxlaDkg77W0vB8wMwyj71akDpZbZGSQUGmg&oe=69B2B13E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X9EuIOlMrUQ7kNvwESpPCU&_nc_oc=Adq3rN2kUZ40GzGDao2nnr4LLJslrpAo6ED1BHe_hyOZvwnJd6cRWFt30ZDzf0888s0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEluOdounapxoCMMaPaFWX_WIHU3r2I0oqopChje__pNQ&oe=6A7881B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlY3nEoZ5b0Q7kNvwFSWc09&_nc_oc=AdqcWbxPaRNlc4wfEy2fSGNS_ZMeJ6w0hkpTZN0WxefVhpsfRhe6ACEXOXQYWPnDY90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWQJDW8ifh_yWV-yaDi01cDSUS_WAhHH0k1oF6B0K31g&oe=6A787514"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6sH48Sy8AEQ7kNvwFE8KKJ&_nc_oc=Adp2nIn3ZDWFCaPWbotqh7N28Z1bG2npNtiLJblcTyVy0c0f_oyo1BL39mRXawMlsXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJcHJWv__N2SosYSd9nKLGz3i13fqJPIlNPtx419M9Xw&oe=6A786F75"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQhUxfqdR9YQ7kNvwGreka8&_nc_oc=AdqRE9U5zq7FXSEUvEho4wjNyJcUvrQUZNjKgbSW8zTCuxqYuTvZ1r9bewEJdsvHZoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAYdfa7P2DzaT4i4VOnRqrcaAPJqAdDT_TGX5LdEy98Q&oe=6A7896D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxWXWEqxUJIQ7kNvwEx6gcH&_nc_oc=AdqyKreoeAs2OoJ8WBZA39Bmln16TKXGkunSyeoVJhFttDwvpLiyQ0JiTtx47vvu8Yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5T0pFxiETgH5Nna0sz_HBtPAscj2Tm9CAzri2K0c42Q&oe=6A78723E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
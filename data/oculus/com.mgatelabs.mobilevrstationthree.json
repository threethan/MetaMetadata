-30-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GylN2v4j2_MQ7kNvwFawSOG&_nc_oc=AdrBtmFGK1p6FyOf6pW-gkYswD9AT1FLalPBt-vhzcmDZ5ZlbNwMyHfspk7XY2bjxXw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0k8tXf-Z7ny34LKxb0faZnSB12t8obLzCmM2vINZ1YHg&oe=69F4ABB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFb3EG17uTQQ7kNvwHbQ7nb&_nc_oc=AdoFSO1BI8f8fdWNCxGFPxnh6d5Fy6xgnORp2IxajnBBwICpwNjli13w3jnPbbGC2-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2V3S-NjAGzaCrwG2ylMWe6X9hhb6xMErjQy7uD3svIVw&oe=69F49F14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0sYxWLrGB0Q7kNvwF4oyQq&_nc_oc=AdqbuaV3pS-_kZm-zhe8XzbEpMz4LUS5baomUF6KcaQnqNVgLO68GN1qsfUo7s88FYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QHftZTvUKJzwKU19fxjF_eP7sm6JO9DFzQJQqER4Gaw&oe=69F49975"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqQWfwmGgBcQ7kNvwElTSbP&_nc_oc=Adpdv0D660f-w9SuxwYeTk4-wDd2E5IijzIPy8kvuL8lAeYWf2c-Xe_dOzNB0D27US4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ioCfI47Fs1koc8torwtoVUyIuyy43Vw8nkzdOk6jHqg&oe=69F4C0D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK6CasmrVvkQ7kNvwGAciRW&_nc_oc=AdptBvwemzAxF1ff8BeKXhUjzbom2yPusv9VwLrpwWea3cnEvMHC-1tOr94wcxffmts&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MdRvICZbgYVrBxuTCwr2e4w-OLD1q6QQ7kuJ-5chtng&oe=69F49C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plYxyRRHh3gQ7kNvwFhhpBu&_nc_oc=Adqks6b9W78QjhrFRr1lm0Tk2KyRQBoQDKvWLWT-Ev0YbfnUE9e0FurJJb9mc9BzpOU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLwhWQ0Ns1tei-HgBCcYfCTE6T98JC9EX7cCY-Xvl7mA&oe=6AEC85B1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kRZPkBzyOYQ7kNvwGqGe5S&_nc_oc=Adr-ACqZ1qjMm4y66b2YWrQ68qpeNRLkssXK4LQYYfe2Yo2Mrs9Ke9H3r9A3I-6xEPM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ0Vhg6o6UGoN0TbbeVnf8vW6UM8WoZtkNBngIutiEqw&oe=6AECB154"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1x5kLqw6CoQ7kNvwFry_eH&_nc_oc=AdpPN1R3f-RjnyHhcA5AmtQh7v2YpOB0BqV0kTzpRCxhz6wTpunI9_3y0Z8mev3xtGk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjyrB3fZivJ_lLh182lhNBI94ZNnAXYmPOkuJzJ1Pdxg&oe=6AECABB5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3HkuhVa2tgQ7kNvwHANDKD&_nc_oc=Adpb28oJXFzdb0MoPQLdEJTg7gz5ADdJ_9FHm5Z_yBn3KrUTe37uMLTxdYcrr5ONKMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4iiErnNqrO9qVfjLKqyzj-q2NRY2KoNG_dc8wKYs6Xw&oe=6AEC9AD7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUeHvKoWMBwQ7kNvwE75P4k&_nc_oc=AdrmFUR8TXex-5bR3Zv2YD54EjzGzz3ismCg6R6nBpqqFustjYNJ6Rmu40RPgx65KDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ68umjIBzxHBp-DCCInBCxAj1Xumiv_P1iZdd_P70zYw&oe=6AECAE7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i96p4gYtlB4Q7kNvwFww0mV&_nc_oc=AdpmkXQLnG94Znw3hoP1Bs_aW4Qz8dfkH6OnqP3C6q4KUaAhv4Jy0etDDnJFUdpGSRc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpSQXYvHJfREyZdf1qtOiMOjl5UrRqqOpQtPNwOTVZAA&oe=6AE34B31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT6-rTZ9utAQ7kNvwH9wDC-&_nc_oc=Ado2hXg3JgKkc6Sf5Q8j4lSu4ceqixwh9U6REova9I5iKumYRKtWN-18Y3GFKlh1U0g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxnlYtoev2tfTb1SPu3ZQm6fdrL_-e1v3S6BbTDeIcHw&oe=6AE33E94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7qhltAli_gQ7kNvwHPhYuw&_nc_oc=Adpi1NHzNDyzG5ul_lBA6QqmWMyrIS7hJe9kLNM1oHYwzBWxQep2OKJrDaBd6kLa7K8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPm1w_rmQRLKVAUkEe-P4N-eaEka3FTcaJV9audeY5Cw&oe=6AE338F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUms6Dctr8cQ7kNvwGWhXiq&_nc_oc=AdrX4JkALvndJO6T-J7-i_ylD48zWtTZh3CYcNwPNO3xHp0SsnfDELsPFKeclvXZKkc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi4EoHY93NKs43lO3qQfB8jrGBjZTxr9OVgnKHFdRQCg&oe=6AE36057"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmIaekYkqekQ7kNvwG9Q4nS&_nc_oc=Adr8b5RyQ58jaXPihVGjYgBXD2zOJlp6kr_TniYsZ9vsYRIrZPE-MpSOnr-5Zzh_wzY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM803tau69E7g7VZzqpgQsIMPaNERNI4az0VUazt__wbA&oe=6AE33BBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
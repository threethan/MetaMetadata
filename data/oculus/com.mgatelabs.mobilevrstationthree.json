-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yntwhm4Kuu0Q7kNvwHx6iVJ&_nc_oc=AdqcPp77s8ZNP4jGZl42OsCseJrKfbLbxn86vEHR6sMZcmZs2qA7EOZLEbn6kW0Sts0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl5T7IJ6z-iOr7vugafMpRiL_-mNZtOQUxhGGH_Hro_Q&oe=6A490BB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqkeL8oAdQEQ7kNvwFP5xaj&_nc_oc=AdpDSeJBYwPJOzol9k51V00db7oGZkZoE4Sq1mOLhaXTKervqv10ggmlYVKXNf8YrhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj9kOkrvrAPFjp-OsHavmhiESUZSJJAGgUUHyiEpLhnQ&oe=6A48FF14"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Wo5iJQt_F4Q7kNvwEUPxvq&_nc_oc=AdpVcg_BtfLxvmPIQdGcgzWIuiXLnwjMpve382u-CqlmbSWOL8fHmIITg2C9zqWx07U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-HSdnU65ekZxryPHQomXjpHNYaLskweFr2ABz-iOcqg&oe=6A4931B5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swmU4ssV1jsQ7kNvwHp-WEZ&_nc_oc=AdoYMiSryiT0eHeEMYc_J4GGTEap3ckW5pJxp0odHBS3NcezH1NNi_WbjgHGuPEWnLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6o43VItpIfL5k5nxcKO8MEXtVsxVFW3i76rvN1rysmg&oe=6A4920D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtLJIHNGXnMQ7kNvwH_eren&_nc_oc=AdpXuAC505MJCztiKxkywGSnpp_2un6o4at9sixxQIS3_tldEGIE6-f2-DQe1s0PQ18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcdIYA1iAhGUysRJxDNysqgtRKzML3uiOYKkc2fCB8xA&oe=6A49347E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuo0eU_Zu_wQ7kNvwG_6HuW&_nc_oc=AdoNvoW1VRe3frL7mWkZ-WP_jPeWp7EawPVY7qFwAhtq_cBKIkI6owTWj7EbpbkA6a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jnEpysCfLL3jixNw4qoP2sPVAaTymjHRbVQkLB_CZ8A&oe=6A2D5C31"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrHruN48UiAQ7kNvwGcGNa1&_nc_oc=Adrmypxk7E1nEgyBbrzFKbQiRcMegZT6Qs7S1P0cVtWbt6JATQRYyaIDjIsMhELK-80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Eqdjbq710gisTqGFUZyE-UchrqZuTn10cX6_Wu1STOg&oe=6A2D4F94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp6_Rus55i4Q7kNvwH0CTN6&_nc_oc=Adq5rdqQDNvGnimVPBoLs22GIeS1pnL3TQExPiPg8kqpFUso46SQjVWPYJmrJ1_s0Yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yf_DxgnCU1slUnPKJJw6LpHgh9Lglv7-CqgIgCy3CCQ&oe=6A2D49F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyeJGJOyWjIQ7kNvwFhjQ7p&_nc_oc=Adpx1xisgwQICF2--Feukw1JviPMyzgAdtO6hc3xRsV05fWyCZaxxqWrKnQRySXBods&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r5aJtNXewUMKW3D4kgU1rs4nRUV5BWoH8EPpCMXeXIg&oe=6A2D7157"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLDAzXMcZIcQ7kNvwG_3HeJ&_nc_oc=Ador4Mxv3giV2aN9d7ek-THhJwDKKZEv62OPpdXFZst7hHNnaBXJ7KWR3XxSPehaqNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uPTiv9F71MT0Xkhhx-z5YV_HV-fTH3E3WZmvQYIS3ug&oe=6A2D4CBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
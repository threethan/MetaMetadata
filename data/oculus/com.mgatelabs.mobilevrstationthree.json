0", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3mfItMf25wQ7kNvwHV7OA1&_nc_oc=Adk5rjd9sC8uclb_9gH9S5W2bkV6_i9In8unUkB2H5Gt3Rfs7I9UgtqfQEyVczjTaLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOTrD4C8Jt3jw6B6vsAPebyTvqU4COvghsuCZNFejtwA&oe=69AC2931"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OctZ7PG5beEQ7kNvwEGyNOe&_nc_oc=AdmMY4TW8QThX-Z2B2E5_kiSW9hO4yCk87xXcNAHOEy3XoBuklE7g_sbYBgvCm-cc-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMYnRCcOCsXi8p1_yr_yx4cjCh6GGpYNXGfioCFHib7Q&oe=69AC1C94"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBGIEyCqazUQ7kNvwGHqwPL&_nc_oc=Adn2BYZd5zPt2qf92ucxgl-SZEsNl460FzfBeBueTtQ8YEtvPgW25Zu_OkRiHTfgGas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRbePSZWQZtyZyinvPY-h6gOAAeI30N4nT69F0rc-qoA&oe=69AC16F5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bqYYo1-un8Q7kNvwEf9JJ6&_nc_oc=AdkmzDfEruzP5-3bKdIZS8dz_4qzzlyL3VvFvRjT43oh_VTOgmYx75WTaxYBSTX7vgQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMPLcWvpOGAlmKh4lzB-JeAue_jZpP-ClyDcdY2aopLw&oe=69AC0617"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=056FuSp6xFkQ7kNvwE09cyo&_nc_oc=AdnPXkLx06abCY5yM8dXrV0JHs8dO_hGWE6k8vbbYQdQmpqw__pR1C2SMvtd_TtxC48&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyC79SVXj0CcNilUgRpz8gGjpSo8uECstXIPTyD963Z4A&oe=69AC19BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
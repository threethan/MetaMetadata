-30-22.png", "id": "337739244568730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u82ALOuLw4MQ7kNvwFozjTX&_nc_oc=Ado0DQV7kWzMUxh0incLX0S2Jg4bJ7W1FXa7Eowc5NqzYib4shxSS8Za1oPT_7hyYso&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOzkOnE0zmRWekl9vZ7-PCb8G6ggaaVzF7pp-nG0KpyQ&oe=6AA16031"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVczmx_0fHQQ7kNvwG7ijJR&_nc_oc=AdrFVFYWJgYTZlrPx-cejFbRYqv1HfoIF3en69rJ0nZyYBptNdKEwxlNltZNJ_BeHwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAjc3AXhRZL-rl3pumX1e6mkXy-oyZH3q9IBRDV_yZJA&oe=6AA15394"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M41j9RYpkUQ7kNvwENj7pS&_nc_oc=AdqkbkTPipDziPNIh2_h5mgSVqYOfdmKkxtTRRiRzZSRS-C0E8_KWwRkJuu256626Mg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ94cqjhFFupfyQ3VH2cdqTEJcA61SsXMNHLvPiikhEmQ&oe=6AA14DF5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq997tIKqVsQ7kNvwGbzqXK&_nc_oc=AdpUlTJPdakTgy0u1o8gCKnpycLXLzYqHR-CGQE0a_tbSM5PhCteVrsHhbkIL_l3mkc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyi1qs8L_nve1dSXPxvbkh55nR6jTWVtgsnlh5_I-K2A&oe=6AA17557"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF6ioUyPdWgQ7kNvwFOEvEB&_nc_oc=AdoG5wKLP0sTOa-QHt0E8iwcktUJ5GVJL1XN94gCkMYZ-1-nZwwhmFa4uKBLFmhcP-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuM8ZvoHO3oAAPkCye4Kap4-mszkaW6bvmytJ6QNy1Vg&oe=6AA150BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
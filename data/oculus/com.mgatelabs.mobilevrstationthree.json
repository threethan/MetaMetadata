-30-22.png", "id": "337739244568730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001671_337739247902063_6721907822549814465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U81tohu8ysQ7kNvwHY8QRQ&_nc_oc=AdqisI45hDs7Ed1c-h48nVSKrrLSa6t6MQfJROwOnfMdK7eqLdRughi9m5_stBx6QdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkVW461pj_kZ4Gl53kMb8C0eKyLsoAJ7UOf_79NUYqHw&oe=6AE73FB1"}, {"file_name": "2019-06-15_12-08-17.png", "id": "1128484751234151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1128484754567484_4383932164145087368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM9Z5nL_n7MQ7kNvwErPl5a&_nc_oc=AdoXmrvvlQyGv5u_LXKX6ZAEbqKWr8h7sC0JQlxqDnLt6LBC4vHT9tDFhc4r-BXeV74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT82qx9-qxTPpWseD8dRXMs6B1e-EhhyExaMqWVRme1pg&oe=6AE76B54"}, {"file_name": "2019-06-15_11-51-39.png", "id": "936719776895822", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_936719780229155_2319144500103752663_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eme4U_UKt5sQ7kNvwHBYuYM&_nc_oc=Adp9bhQak2LKYozzi_8cg2qTy2VrN6vnrpiNhcMBeAkathWDGZahyQ4fa62NRZzd7LM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtDcgmcV2iS2xLZPhNOOODqmBfhWKpf6jE8RA-2E6UbQ&oe=6AE765B5"}, {"file_name": "2019-06-15_11-54-25.png", "id": "1445675765847474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1445675769180807_1042152137665252181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCvs4t3JjaAQ7kNvwGICKLR&_nc_oc=Adrnyeepl_HixAOoMuJktB3v5gGXdNBIimZogNjDWRnM7H0le7oSw4QhrsVkgyQ07as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVUbCx9Q4pjglcW8eoejSNMVkGzpMz2ZiZvpPSHlx-8A&oe=6AE754D7"}, {"file_name": "2019-06-15_11-58-13.png", "id": "450621576693685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036614_450621580027018_5690465298049970931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gsc2OVpGF4Q7kNvwHY6qtO&_nc_oc=Adq3vwQKwLGfppqC-e1LmdcR0HLSpFD8WVyXwob1vl3IBNqgWJq5ZIs1BAqkDZ165So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJzKGsqtZXydxMaOquRQrm2WyyxKVFOUfvyi8FyFknxA&oe=6AE7687E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mobile VR Station", "keywords": [], "long_description": "This is the third re-write of Mobile VR Station and was based upon the successful iOS/Android versions, but re-imagined to work only in VR.  The player has been built from the ground up to display 2D & 3D content on various projections such as Plane, Spherical, Dome, Full Dome, Curved and EAC.\n\nThe player will continue in its freemium tradition and allows you to try all features before buying.  The only limitation of the free version is it will only play the first five minutes of any video, but you are free to make sure it works with your content and has all the needed features at your leisure.  We offer support on our Facebook page if you have any questions and links are available inside the app to our various pages, online tutorials and the extensive help guide.", "short_description": "A highly customizable VR media player that has support for many formats such as 360, 180, Full Dome, Over Under and Side by Side."}]}, "developer_name": "Michael Fuller", "developer_privacy_policy_url": "https://mgatelabs.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Michael G Fuller JR", "support_website_url": null, "website_url": "https://mgatelabs.com/mobile-vr-station/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "UTILITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
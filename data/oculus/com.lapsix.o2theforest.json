667841437723977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_1667841441057310_4543060121423277484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_jy54i1WsMQ7kNvwFEJANk&_nc_oc=AdoyTUpdKK0a_bTJQxYixihGMSCQV4Y9sRMaf2DFilhGt83bd3bsKjfKDdlWLc1VA3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS_kwDJ6OUTjrRp77skrICQgTr_bzc2nnvO69WvRBB0g&oe=6AB9109F"}, {"file_name": "O2TheForest_2560_002.png", "id": "1580905783019832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_1580905786353165_6343792457209562545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F1bPCrxPToQ7kNvwGQtCxl&_nc_oc=Adr1wyHtTOoxJ-osUVG7SFuaqe9VVNjqcBQd15lf82DJnnrfUyYj6FK41ApqvIAMU7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaT2NpGsitvWaELau1VD2Wo4X2U0q9ls9SSQU3iSsYHg&oe=6AB9342E"}, {"file_name": "O2TheForest_2560_004.png", "id": "1420879036034297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_1420879039367630_9021314774930261935_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IguJNboxAPEQ7kNvwEhtd-u&_nc_oc=AdqKu8PsH74e9iS6uJdZ82jAeGrfc2pjldE4MxR3UagANGD1XTgiE16QoTEhdBR-MjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1eVt94IZCDKqYVByBEY0a_ze0bTeQPFaeWnVWPGasIg&oe=6AB91762"}, {"file_name": "O2TheForest_2560_005.png", "id": "1719545049472476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_1719545052805809_5838592348974803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDL1xR5Trt8Q7kNvwFMERRC&_nc_oc=AdohglJcneBSZgcYsOMvuChEUmiyMY43tlbyaezPyddJbickFOLoIBJDjjWlHLCpwM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPXX57-NsgBiij23wYyHmQWc80DVkLT6ZqR8nKx1KBCA&oe=6AB92C39"}, {"file_name": "O2TheForest_2560_003.png", "id": "944057961819961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_944057965153294_295800746682490873_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtAKaaM9YIIQ7kNvwExi65n&_nc_oc=AdpM62NeJ4KYIvr90BoUX2bMDP9mm7TCYdOiiXY6oHsguD6aUPkUCx80JF6W0XQADsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSvf9DrC32VaN-tJzn5mv3j7JnnKF8ijBmhDHVwI3TLQ&oe=6AB92F61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "O2 the Forest", "keywords": ["horror", "survival", "scary", "multiplayer", "free"], "long_description": "# The forest is contaminated. The cats survived. You probably won't.\n\n**Breathe While You Can** \u2014 Your campfire is the only safe zone. Step into the forest and your oxygen bleeds out. Starve, and it drains faster. Two meters, both falling. Always.\n\n**Daylight Is Borrowed Time** \u2014 Explore. Scavenge. Hunt the infected for meat and materials. Cook at the fire for full effect. Craft gear, raise barricades, reinforce your camp. Daylight is short.\n\n**Night Belongs to Them** \u2014 When the sun drops, they swarm. More of them. Faster. Stronger. They hit harder every night. Your walls buy time. Your fire buys safety. Feed it or lose it \u2014 but it can be relit if you're fast enough.\n\n**It** \u2014 Most infected can be fought. This one cannot be killed. It has no name. It stalks anyone caught outside the firelight. When it shows up, panic doesn't feel simulated. It feels like yours. You run. Everyone runs.\n\n**Move With Your Hands** \u2014 You don't glide through this forest. You pull yourself across the ground, claw over rocks. Every chase is a scramble for survival.\n\n**Fall and Stay Down** \u2014 You drop right where you stand \u2014 face in the dirt. Your squad can revive you, but reaching you means leaving the fire. Nobody comes? You start over. From nothing.\n\n**Nine Players. One Forest.** \u2014 Split roles. Share resources. Cover each other. Communication isn't optional \u2014 it's oxygen. Solo? You can try. The forest doesn't mind.\n\nYou'll choke before anything gets the chance to kill you. \n# Night is coming.\n\nDiscord : https://discord.gg/EYPxdcqZZT", "short_description": "The forest is contaminated. The cats survived. You probably won't.\nOne campfire. Your safe zone \u2014 breathe, regroup, stay alive. Let it die \u2014 it comes hunting.\nDay \u2014 scavenge, craft, fortify. Night \u2014 they come. Fast. Vicious. Won't stop.\nSomething out there can't be killed. Shows up, you run.\nGo down, stay down. In the dirt. Pray your squad reaches you.\nNight is coming.                                                                      "}]}, "developer_name": null, "developer_privacy_policy_url": "https://o2theforest.com/privacy.html", "developer_terms_of_service_url": "https://o2theforest.com/terms.html", "publisher_name": "Lapsix", "support_website_url": null, "website_url": "https://o2theforest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32802413119401893"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "966437442393045"}]}, "baseline_offer": {"id": "966437442393045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775163420, "status": "PUBLISHED", "id": "966437442393045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38535480299428451", "version": "0.8.7.395"}, "id": "834974545841029", "channel_name": "LIVE"}]}, "is_for_oc
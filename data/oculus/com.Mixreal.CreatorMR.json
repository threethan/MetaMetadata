Tg&_nc_oc=AdmBM_I2wZWEjolg7b2y3idc-aJXQf2_J4PbymCucnofk5faPi23qfoRqU0ECRSRsQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuvxdV3OjCx6pYHJEZbpe4Fx9rMiCOwD0WJf9VG0G-FXA&oe=69A83B8D"}, "display_name": "Mixreal (BETA)", "keywords": [], "long_description": "Mixreal es una innovadora aplicaci\u00f3n dise\u00f1ada para crear espacios virtuales en Realidad Virtual (VR) y Realidad Mixta (MR), ofreciendo a los usuarios una plataforma intuitiva y vers\u00e1til para dise\u00f1ar y experimentar entornos inmersivos personalizados. \n\nActualmente en su fase Beta, Mixreal se presenta como una muestra preliminar de su potencial completo, invitando a los usuarios a explorar sus herramientas de creaci\u00f3n y personalizaci\u00f3n, aunque con la promesa de expansi\u00f3n y mejoras significativas en el futuro. \n\nMixreal promete revolucionar la forma en que interactuamos con los espacios virtuales, brindando una plataforma s\u00f3lida que se expandir\u00e1 y evolucionar\u00e1, abriendo nuevas posibilidades para la creaci\u00f3n de contenido en VR y MR.", "short_description": "Mixreal es una App que te permite crear espacios inmersivos sin necesidad de tener conocimientos de programaci\u00f3n y en cuesti\u00f3n de minutos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixreal.com/politica-de-privacidad", "developer_terms_of_service_url": "https://mixreal.com/aviso-legal", "publisher_name": "Meta Global Creator S.L", "support_website_url": "https://mixreal.com/contacto", "website_url": "https://www.mixreal.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
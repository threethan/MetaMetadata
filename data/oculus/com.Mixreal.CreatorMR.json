9638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_310779198642971_4408116081412214783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQC1BL1Q_3YQ7kNvwGxlN_6&_nc_oc=AdnMe8D06W49FdXqO7-cYc-SAMO3N6ST8wDRzFyR0Q5YoIXI2MEKqQGwBGsoVm4iG8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsg-1NsyY-jdmKYePMLT17KxOjAV45NQtCu18fL5giMjw&oe=69A2FCB9"}, {"file_name": "Capturraa.png", "id": "332831819749319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982588_332831823082652_8663345789020570916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X_w2ZtqYU0Q7kNvwEraetp&_nc_oc=AdkWo-svNO-22j1dYHUI33Q8zgONdmu5MO-f8WwzyS-zJfkRcB1gyoWV2N7bJU4r-54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftt3zpjkKl0sMlAoiJ-3c5QD9N5PbdXaq4XoEzkiOqdSw&oe=69A2EC6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Dise\u00f1o de Portada 2560x1440.png", "id": "7105536996225776", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974820_7105537002892442_5237666721667655317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2PauAtayvMQ7kNvwHP9XT_&_nc_oc=Adn8cGdn41WJdavCnwjr6DG_2VLitbTGFuvgRctO1KO1irQyiOcuoBB5Ljv0D054ESg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft82yHmkjvdxwbxOnEvSXaXz2TFotuYS_sdocknTEneTw&oe=69A2F58D"}, "display_name": "Mixreal (BETA)", "keywords": [], "long_description": "Mixreal es una innovadora aplicaci\u00f3n dise\u00f1ada para crear espacios virtuales en Realidad Virtual (VR) y Realidad Mixta (MR), ofreciendo a los usuarios una plataforma intuitiva y vers\u00e1til para dise\u00f1ar y experimentar entornos inmersivos personalizados. \n\nActualmente en su fase Beta, Mixreal se presenta como una muestra preliminar de su potencial completo, invitando a los usuarios a explorar sus herramientas de creaci\u00f3n y personalizaci\u00f3n, aunque con la promesa de expansi\u00f3n y mejoras significativas en el futuro. \n\nMixreal promete revolucionar la forma en que interactuamos con los espacios virtuales, brindando una plataforma s\u00f3lida que se expandir\u00e1 y evolucionar\u00e1, abriendo nuevas posibilidades para la creaci\u00f3n de contenido en VR y MR.", "short_description": "Mixreal es una App que te permite crear espacios inmersivos sin necesidad de tener conocimientos de programaci\u00f3n y en cuesti\u00f3n de minutos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixreal.com/politica-de-privacidad", "developer_terms_of_service_url": "https://mixreal.com/aviso-legal", "publisher_name": "Meta Global Creator S.L", "support_website_url": "https://mixreal.com/contacto", "website_url": "https://www.mixreal.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24892022263779957"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24892258507089666", "version": "2.1.0"}, "id": "1095413035218987", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24791160847199433", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24892258507089666"}, "release_status": "RE
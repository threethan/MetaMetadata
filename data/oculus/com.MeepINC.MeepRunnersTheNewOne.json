lYHx6kKFWiFxoE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyENes0L7DKFGRLlLzUhXrE-R5ifmX2P2zM9Jjgt78SNQ&oe=69B40B05"}, {"file_name": "Untitled design (16).png", "id": "874465841257997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/428945069_874465844591330_8890758255998488844_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gfUJxAnIeUQ7kNvwFUuKWn&_nc_oc=AdnteWCdWCVEfkohQxQ7LmlovYkPdI-EiOJSySL_uquC2dwpXiIv9OVfjqoggON-cVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVwt7pFF_asHj9kqmu6mlEr_LPR-xHp8w3ZWK8j2FPsA&oe=69B40DE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners", "keywords": [], "long_description": "Meep Runners is an exciting multiplayer game inspired by Gorilla Tag, where players race through vibrant, obstacle-filled environments in fast-paced, tag-style challenges. Control your unique \"Meep\" character and navigate through a dynamic world by running, jumping, and dodging obstacles to outsmart opponents. The game focuses on quick reflexes and thrilling movement, offering a fresh twist on classic gameplay.\n\nChoose from various game modes, including competitive races, where you either avoid being tagged or race to the finish line. Unlock new skins, abilities, and maps as you progress, keeping the experience fresh and exciting. Whether you\u2019re playing with friends or competing against others, Meep Runners offers a fun, action-packed adventure with an emphasis on community and speed.\n\nPerfect for both casual and competitive players, Meep Runners delivers a dynamic, engaging experience full of energy and surprises!", "short_description": "**Meep Runners** is an exciting fan-made game inspired by *Gorilla Tag*, where players race through vibrant environments, leap, and dodge obstacles in a fast-paced, tag-style challenge. Use your agility to outrun opponents, navigate tricky terrains, and compete for the top spot in a fun, dynamic world. Perfect for fans of action-packed multiplayer games, Meep Runners offers a unique twist on the classic *Gorilla Tag* experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meeprunners.odoo.com/about-us", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners/home", "website_url": "https://meeprunners.odoo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27935573956087029"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29263647679946310", "version": "Newer Than New."}, "id": "460498333563473", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27934275302883561", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29263647679946310"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "460498333563473"}]}, "change_log": null, "created_date": 1748639717, "id": "29657714620539612"
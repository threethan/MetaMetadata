0073037", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036688_623970133406370_6653532217519083348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE0tl-d3bgcQ7kNvwE84F3E&_nc_oc=Adqsnln0x-B_CzseAMqJWEPZKv8XslWuO_2_B3k4QwF46zYtFQeeWjXI2LbNWYPzGcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTsduDz-JXC0sUuj0O0tdlYSa9C4dt1SZfBEX15J_x6Q&oe=6AFC9543"}, {"file_name": "Untitled design (18).png", "id": "977438627632972", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031402_977438630966305_235398677169603546_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It8fveWdMWEQ7kNvwG2-y1-&_nc_oc=Ado9-jqTcOvoTNlYbqxat45Ehf4Va0XoVQuARRMnowvYKPAezGYN17D60ezRGGswotE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvTcwj6VCA5M_nEYpTysHuYWI5Hx4HSFMhkxnGK5qouQ&oe=6AFC88C5"}, {"file_name": "Untitled design (16).png", "id": "874465841257997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/428945069_874465844591330_8890758255998488844_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxLXV9HW0KoQ7kNvwHSbpJ-&_nc_oc=Ado1lsxU51F-Ut6lJRUQlQ06ouZ2ypr2dkukMEEyGzoh3Gzl_bCVuoMf5bdHgVNSedw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8AJDDu6CHNzIRh8isl9EaIqzYjlI9n2y1GZi_b9yNQ&oe=6AFC8BA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners", "keywords": [], "long_description": "Meep Runners is an exciting multiplayer game inspired by Gorilla Tag, where players race through vibrant, obstacle-filled environments in fast-paced, tag-style challenges. Control your unique \"Meep\" character and navigate through a dynamic world by running, jumping, and dodging obstacles to outsmart opponents. The game focuses on quick reflexes and thrilling movement, offering a fresh twist on classic gameplay.\n\nChoose from various game modes, including competitive races, where you either avoid being tagged or race to the finish line. Unlock new skins, abilities, and maps as you progress, keeping the experience fresh and exciting. Whether you\u2019re playing with friends or competing against others, Meep Runners offers a fun, action-packed adventure with an emphasis on community and speed.\n\nPerfect for both casual and competitive players, Meep Runners delivers a dynamic, engaging experience full of energy and surprises!", "short_description": "**Meep Runners** is an exciting fan-made game inspired by *Gorilla Tag*, where players race through vibrant environments, leap, and dodge obstacles in a fast-paced, tag-style challenge. Use your agility to outrun opponents, navigate tricky terrains, and compete for the top spot in a fun, dynamic world. Perfect for fans of action-packed multiplayer games, Meep Runners offers a unique twist on the classic *Gorilla Tag* experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://meeprunners.odoo.com/about-us", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners/home", "website_url": "https://meeprunners.odoo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27935573956087029"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": t
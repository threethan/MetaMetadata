&oe=6A131316"}, "display_name": "Meep Runners", "keywords": ["horror", "scary", "hangout", "fun"], "long_description": "Welcome to Meep Runners!\nThis game has no devs, Just me!\nAll art made by @sunnyboy.14 on discord", "short_description": "**Meep Runners** is an exciting fan-made game inspired by *Gorilla Tag*, where players race through vibrant environments, leap, and dodge obstacles in a fast-paced, tag-style challenge. Use your agility to outrun opponents, navigate tricky terrains, and compete for the top spot in a fun, dynamic world. Perfect for fans of action-packed multiplayer games, Meep Runners offers a unique twist on the classic *Gorilla Tag* experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/meep-runners/home", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": null, "website_url": "https://sites.google.com/view/meep-runners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28694544363523314"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391899_641612921638761_5175076981694290784_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45RthCsW6K0Q7kNvwGts31c&_nc_oc=Adq-Mp0XNuG6Ko4Ib_umOBvNrFTZL8dizPW2WM4KYp6v8tWFf6nIWVpiRIUP
4681726595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75532179_3017544685059928_6507767898447402785_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC_gUfxEjYQQ7kNvwFq6XK-&_nc_oc=Adm5g1nVoJBkDvlAwUdE0MHrtS1adnKEmHzt2qEj_-567PQze_kZ4JqFcSaklc03HPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu87butCXssdTJ5vrWnZeChML1qP0XTtr6oxpn_vz7HvA&oe=69A81B82"}, {"file_name": "ApplicationFrameHost_LMRZH0cePZ.png", "id": "540076775442355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982658_540076778775688_551515139827310136_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09SERggAumsQ7kNvwGSVIKk&_nc_oc=Adk4k7d-uoC0uUFXOziZQAwdrACBrWEv5V0w0uSNAHzlidid20wdlZUUo0SQmpKHBZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftYcnCAqDam-Iu3ltXHi0vKaJL3ACwTDk0y0Ak_iGJ5rg&oe=69A8354B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Change in condition of hand warmers_Landscape.png", "id": "1049281976365425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1049281979698758_6121111919581427604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1GEaiE88YgQ7kNvwHs6FNa&_nc_oc=AdneA6fJADmJIphs7A8rkT5Sg21IPT2USySTr6TjIvEFwSLM91n2r5Tvptss-ku3YHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvceez47TNfXOhVlVjhkFiMCBLYUNr-iX14fLMLDgpjVA&oe=69A82893"}, "display_name": "Change in Condition of Hand Warmers - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "condition", "science", "contentsda"], "long_description": "1. prepare 100 g sodium acetate, 12 g distilled water, a Chinese medicine zipper bag, Zion ink, and a metal ticker\n2. Place 100 grams of sodium acetate in a Chinese medicine zipper bag\n3. place 12 grams of distilled water in the Chinese medicine zipper bag containing sodium acetate\n4. add 1 ml of cionic ink to the Chinese medicine resealable bag.\n5. insert a metal tick and seal the bag\n6. turn on the switch of the hot-flight with the heavy water bath installed\n7. Remove the zipper bag from the hotplate and allow it to cool. Be careful as the zipper pack is hot\n8. press the metal ticker to observe the change in the state of the material, which is solidified by the stimulation of the metal ticker and releases the heat of solidification.\n9. put the ziplock bag back into the water bath to liquidize it\n10. remove the liquidized ziplock bag from the water bath\n11. place the ziplock bag in the refrigerator\n12. Place the bag in the refrigerator to observe the sodium acetate solidify\n\n<Result\nWhen you shock the liquid in the hand warmer with a metal ticker,\n\u2192 the liquid turns into a solid and releases heat of solidification", "short_description": "Explore the chemistry behind hand warmers. Understand how exothermic reactions provide heat, offering a practical insight into everyday chemical applications."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27562029710079716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculu
nt-sjc6-1.oculuscdn.com/v/t64.5771-25/38982658_540076778775688_551515139827310136_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb73JiZqvo0Q7kNvwHjObcu&_nc_oc=AdkYfjfU-4sgi47uFr_DMYmXVt4405qkIOa79cdhuK81y1_BrTgBlOcEsh0enirntzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsOK3c4XPBLpTE04JAGfxjOdNYIew19vKaKl8FtEl5iA&oe=69BE9ECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Change in condition of hand warmers_Landscape.png", "id": "1049281976365425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1049281979698758_6121111919581427604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a41UIDe4TDMQ7kNvwFAsLau&_nc_oc=AdnXVNeXEqOhhvIcA1u0Cj8-UGjAwEpSI2YJhg_oN1A-uPONLY9cbV5n-p55Gz6Vn_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4fR9a_6k7qxwelug94rC8GSUBqTcOMNzeIABk6hpIKg&oe=69BE9213"}, "display_name": "Change in Condition of Hand Warmers - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "condition", "science", "contentsda"], "long_description": "1. prepare 100 g sodium acetate, 12 g distilled water, a Chinese medicine zipper bag, Zion ink, and a metal ticker\n2. Place 100 grams of sodium acetate in a Chinese medicine zipper bag\n3. place 12 grams of distilled water in the Chinese medicine zipper bag containing sodium acetate\n4. add 1 ml of cionic ink to the Chinese medicine resealable bag.\n5. insert a metal tick and seal the bag\n6. turn on the switch of the hot-flight with the heavy water bath installed\n7. Remove the zipper bag from the hotplate and allow it to cool. Be careful as the zipper pack is hot\n8. press the metal ticker to observe the change in the state of the material, which is solidified by the stimulation of the metal ticker and releases the heat of solidification.\n9. put the ziplock bag back into the water bath to liquidize it\n10. remove the liquidized ziplock bag from the water bath\n11. place the ziplock bag in the refrigerator\n12. Place the bag in the refrigerator to observe the sodium acetate solidify\n\n<Result\nWhen you shock the liquid in the hand warmer with a metal ticker,\n\u2192 the liquid turns into a solid and releases heat of solidification", "short_description": "Explore the chemistry behind hand warmers. Understand how exothermic reactions provide heat, offering a practical insight into everyday chemical applications."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27562029710079716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982706_1767797870373474_6888701215507580906_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeFHSfLKWUMQ7kNvwHNg2vA&_nc_oc=Adm3y9_jQp1U9iDxhhOjtppkBJfmrxPh42tI95OKoE1z_6JjpHujbLSLh3vymljgbTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxvm_Sb-4z_9AC7_nF-o-3v3avjnnTX2Hj3tWcM-SQvug&oe=69BEAAAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Change in Condition of Hand Warmers - Cont
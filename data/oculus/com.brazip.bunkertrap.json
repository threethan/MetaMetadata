at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeC7baxZQ_wQ7kNvwFD5mvN&_nc_oc=AdqlB6kxMAOGpIg_bJSB6-_B0BlaKZOUPvXOoJnXTaG3PYDVyzf39Ui5nfdhwu6Avb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEOcsTauwmXV5eVO3iRbdYxubr0-MMq5sBvmqTf8WfGQ&oe=6AB7EAEB"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTusuWLGZd8Q7kNvwGgwrd5&_nc_oc=AdrQ5HbhvJXBNnoX46H6nEBoB4epIKlbMMYKdbnE5T1oZ8OBZToOHCiQUuDSyFQr2kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFL3Q825Sn6-W5dYOow2GeFuZUqmYm_wjW4aZ3ejwYrg&oe=6AB7DFD6"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ppro0iZN6kQ7kNvwGTgeZO&_nc_oc=AdqA2684TO1x15v_k3UQi78KnYFtM-yK_iva4lJ6puG4tZ_eaRm74B38F3pielQw9f4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEqal1WfaKA2m9VY-7rdnT-RKwaJiGy9ocsjUiaSabHw&oe=6AB7E742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIUIPXgYqWwQ7kNvwFAf0MT&_nc_oc=Ado5TjX5gaiww9jMVt6WfX07aPV6augdFfsjd_DRf2dH-2SpGlRdj4lABc2BnpPh6d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnTBlo2jSFi3pa4atvBbp7UAyliHDPd_WT8G4gOeWLLQ&oe=6AB7BA24"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simu
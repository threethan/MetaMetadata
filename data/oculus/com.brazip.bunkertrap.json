tps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312310_1309092607981266_7733369548370073420_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVDimZmqrgQQ7kNvwHPhI67&_nc_oc=AdoeYG1CL0YsCOzCZsBcitl7NkZlXReaGmub8SlTScoK5ilo5ddrs4Qjb1SaY3iLAS0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNMw7R3P6qGkelv4gMxeBpYpjFv4tn0C1QWSihCE-EFg&oe=6B0B31A9"}, {"file_name": "meta3.png", "id": "1274317234436545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312332_1274317237769878_7370660503497987972_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76FkB2pg9V4Q7kNvwGR3Yrb&_nc_oc=AdrxyZglDAVAHdo9gBs0teJ1zPm40T-Bp_yMvDANEx2w4dnjLeZh3w37UmmgqzGIfnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2u039LF6pNlRWQP951ELVSIw_9_8mRpNnBwGnMUvHMA&oe=6B0B31AB"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sh0rmFyZ7T8Q7kNvwFswUS4&_nc_oc=Adp-nHra0PmDZXQkxSvjT5Dr1IbjcXv2wZde54N1CrUqFUd5oQ6jgN66SaThmj8UVDs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQigxhXNuLnRlb2QqpQVSLb16Tz0MfArBNiBGfL4-l9Gw&oe=6B0B2696"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Or-ZyKnqCLYQ7kNvwETFS8N&_nc_oc=AdqE2YtsEfk30swNLoqze7IllEtCoLHuf47_nVXyK1mvdnpg1f6_V81Iqgjz5PoTN6M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIJFmNmdN8mT9RCHlZpj8gw4q1sZSi5vMReD4DoeHOFQ&oe=6B0B2E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkPaXTw_6AkQ7kNvwFnMACT&_nc_oc=Ado3asVNWceeGiQjyZ-_zzmsNk4UCyLFg1P7mZ_3xF2aM9MEE8ykG3ryWpDo3YotPtE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-qh0YMHCazXrOyALvbbYd7aMV6Or-rkH4giTGv0WklQ&oe=6B0B3924"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "991480870068413"}]}, "baseline_offer": {"id": "991480870068413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780686360, "status": "PUBLISHED", "id": "991480870068413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29583077241305038", "version": "2.2.9"}, "id": "1738944914140691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29583077241305038"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Bug fix.", "created_date": 1795481084, "id": "29583077241305038", "version": "2.2.9", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29583077241305038"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Insana Simulator 2.2 \u2014 new discipline, new arena.\r\n\r\nPractical Shooting\r\nThe simulator gains a second family of disciplines. IPSC/USPSA-style stages with a voice Range Officer, official timer and scoring, 90+ classifier stages, Steel Challenge, community stages, duels and rankings. Seven new guns, each with its own sound and handling: CZ Shadow 2, 1911 Classic, 2011, SIG MPX, AR-15, Mini Rifle .22 and Benelli M2 \u2014 five of them also with a red dot. Paper targets, steel plates, Texas Star, swingers and no-shoots; move between shooting boxes with safe teleport. Build your own stages in the 3D editor at sim.insana.tv and open them in the headset. Join the beta at sim.insana.tv/beta.\r\n\r\nInsana Olympic Arena (new range)\r\nInsana's third virtual range: a full Olympic arena with stands, screens and podium, for Olympic Trap, American Trap, Olympic Skeet, FAN 32 and Compak Sporting \u2014 same ISSF rules as the Insana Club. In Compak, each layout now states which ranges it works on: tick the Olympic Arena in your layouts at sim.insana.tv.\r\n\r\nShotgun fitting: Static adjust\r\nA third calibration method, next to manual adjust and Auto-adjust: the virtual gun stays still in the reference position, you fit your real gun onto it and hold the trigger for 3 seconds. Works with the eShoot and with the controller. And the most requested fix: the saved fitting now holds in every scene \u2014 no more \"redo the adjustment every time\".\r\n\r\nOnline competitions in every clay discipline\r\nFAN 32 and Compak Sporting join Olympic Trap, American Trap and Skeet in online competitions. Private competitions by code, created at sim.insana.tv, with the range chosen per round; in FAN 32 the competition sets open boxes, sequence and distance.\r\n\r\nBest results by email\r\nNew Email tab in Settings: when you set a new personal best, you receive a card ready to share on Instagram \u2014 clay shooting and Practical Shooting.\r\n\r\nFixes\r\nCorrect gun when entering an American Trap competition from Trap. Name, country and language edited on the site are no longer overwritten by the headset. \"Show Clays\" is Trap-only and no longer records a session or counts toward stats. New texts in Portuguese, English, Spanish and Italian.\r\n\r\nAt sim.insana.tv\r\nNew Insana Clay Class (Rookie \u2192 AA), a Home page with what there is to compete and train, 3D stage editor and private competitions by code.", "created_date": 1795448830, "id": "29578642268415202", "version": "2.2.8", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29583077241305038"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794969115, "id": "29506970792249017", "version": "2.2.7", "version_code": 37, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29583077241305038"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794924247, "id": "29498866146392815", "version": "2.2.6", "version_code": 36, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29583077241305038"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794700487, "id": "29462546716691425", "version": "2.2.5", "version_code": 35, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
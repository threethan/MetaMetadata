03497987972_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RMXc_m2ocIQ7kNvwEqfK1i&_nc_oc=AdqSKeU_D20LOua09h5felnxMJhtubtc6IImD5WyimdXW7eZzF9rT3yONqAWt9m5de8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-941eKACiea_b609Kk6mFMTfty8YSmNgKDa-so5QE2A&oe=6A30206B"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH0BhQFeMZkQ7kNvwH69WkQ&_nc_oc=AdoxR3nudnhJDoZW9LSiJF7o8nYE34pmgzId9A0YKwRhCAXoQPBbhI2e7Zo7eHgsGyw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2_PGFQdhCv38Z9qdfxelocf7Kcae0w_g_bWL3SDSbmw&oe=6A301556"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgQfn0RzaXwQ7kNvwEdoLIp&_nc_oc=AdqxgEXe5LjvOPG9f42YIbXP4MfoqKUgSMU5BDRR_3V2l5qK1ktKj7uZBsJQaLUfBFc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__fGnOothZqa6xStF_SIFSaOj0wV8k0QrPixI7XrtSJQ&oe=6A301CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bmDr2f6L0YQ7kNvwHLWVQZ&_nc_oc=AdqWObTwFUVe-PYP73FpmGia_tpOKPXHHug8X-fdbCVi4TWZ0Ummc3c0_6B63hhCsyk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UWJpUd_rWJK8OhWjD_I2qJZWMLLVM0XDBOd-fw-37jA&oe=6A2FEFA4"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "991480870068413"}]}, "baseline_offer": {"id": "991480870068413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780686360, "status": "PUBLISHED", "id": "991480870068413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27451831677762949", "version": "1.1.7"}, "id": "1738944914140691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27451831677762949"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Stability update.\\n\\n\u2022 Fixed a crash when connecting the eSHOOT trigger on Quest 3 and Quest 3S.\\n\u2022 The app now guides you to enable Location when it's needed to connect the eSHOOT.\\n\u2022 Improved Bluetooth reconnection \u2014 it links up automatically once Location is on.", "created_date": 1781093017, "id": "27451831677762949", "version": "1.1.7", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27451831677762949"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Stability update.\\n\\n\u2022 Fixed a crash that could close the app when connecting the eSHOOT trigger on Quest 3 and Quest 3S.\\n\u2022 Improved Bluetooth pairing reliability for the eSHOOT device.", "created_date": 1781045855, "id": "27444581741821276", "version": "1.1.6", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27451831677762949"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "What's New \u2014 v1.1.5\\n.\r\n\\n.\r\nMore realistic clay trajectories\\n.\r\n\\n.\r\nOlympic Trap (Fossa): Target flight paths have been recalibrated to match official ISSF specifications. Low targets now fly visibly low, high targets arc high, and every elevation in between is faithfully reproduced across all competition tables.\\n.\r\nAmerican Trap: Target height has been recalibrated to the official ATA rule (8\u201310 ft / ~2.7 m at 10 yards). Targets no longer float too high.\\n.\r\nSmoother launches on the Insana Virtual Range\\n.\r\n\\n.\r\nFixed an issue where low targets could clip the launch platform right after release, throwing off their path. Targets now leave the trap cleanly.\\n.\r\n\\n.\r\nBehind the scenes\\n.\r\n\\n.\r\nTrajectory data is now served live from the cloud, so future fine-tuning improvements will reach you without needing an app update.", "created_date": 1780951489, "id": "27430560519890065", "version": "1.1.5", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27451831677762949"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "What's New \u2014 v1.1.4\r\n\r\nNew: visual gun-fitting tutorial. Calibrating your virtual gun is now far easier. When you enter Gun Adjustments, a clear diagram shows exactly what each button on the left controller does \u2014 and a live hint panel pops up while you adjust, showing the exact movement you're making (raise, lower, move nearer/farther, tilt, turn or level the rib). You can dismiss it and reopen it anytime with the \"?\" button.\r\n\r\nImproved gun calibration. Position and rotation adjustments now follow your point of view instead of the gun's tilted axes, so fine-tuning the rib to match your real shotgun is intuitive and precise. The live hint panel also appears whenever you fine-tune the gun inside a range.\r\n\r\nStability and polish improvements.", "created_date": 1780928017, "id": "27427446416868142", "version": "1.1.4", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27451831677762949"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "What's New \u2014 v1.1.3\r\n\r\nThis update improves first-time setup and content loading:\r\n\r\nSmoother first launch: After signing in with the device code, your shooting ranges, banners, and 360\u00b0 backgrounds now load correctly right away \u2014 no app restart needed.\r\nClearer downloads: When a range needs to be downloaded, you'll now see a progress bar with the exact size in MB and percentage, so you always know what's happening.\r\nBetter loading screen: Added a readable on-screen loading message when entering a range, so the brief black screen no longer looks like the app froze.\r\nStability and reliability fixes.", "created_date": 1780716357, "id": "27399171843028933", "version": "1.1.3", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
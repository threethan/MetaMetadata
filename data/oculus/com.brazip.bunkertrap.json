K3BAwzCQQOeo6_BKdQ5lQ&oe=6AFC78E9"}, {"file_name": "meta3.png", "id": "1274317234436545", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312332_1274317237769878_7370660503497987972_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb0LpHNakVIQ7kNvwFIFiua&_nc_oc=Adr9AhIOpACMi3vWDAGyDewzDzJtcL4eyJxg-pkBLX15IiuHH5HrcGcGHbg-cVJ_Rnw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiVJSS6ulQNJ8Tb5LqXPlL8KOQEXP6a4VaVx7Fx32LVg&oe=6AFC78EB"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b4MPIjQVokQ7kNvwHlKQhm&_nc_oc=AdphCSF2S51mYVb0eexP67Zp70mMeH15Rt9OTnlSaAnN_mJ_z-WserFdlLoHwqg1VFY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6itege9FYjxHwns7382qHQv-QuKxQYyzWIB3kqQOXyA&oe=6AFC6DD6"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IDxneFdqckQ7kNvwHlRYrc&_nc_oc=AdqEuDU74RkGqYu_EAGpYwPMz51a6prfde96z5phI4so1tfHzi9nrb-bMrHDPcsaC8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8bPgG_KfHR5D7ebBd2CS374wheyH1zXIdSz50fJCHpQ&oe=6AFC7542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6ICjZDDOyAQ7kNvwEDbt5x&_nc_oc=AdpJPVSO5uqJ8zlQ-j9sd5bz4TX-fLHVUw2AEJfEjbtOMGv1tW9-G3UGqIIp0r6fSm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCJ8qignOGHPI-o61S9ZeGNfDhRTw8waq05W_XnfI82w&oe=6AFC8064"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507829691_4410244125911124_5239468488646298260_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcjML4cvXpkQ7kNvwFMSxUx&_nc_oc=Adqf4bMWFvwNUdUPi2w_U0boAMmxD30N8XVT-p2smC2lF88VT4cgEzOZLCn8SbZrEJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhs_m1Fg9Df79TizV3QKOqpARbRyVWxrutF6A6VLUEwA&oe=6AFC79D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Insana Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1780686360, "lastRevision": {"nodes": [{"id": "27161898596756260", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp
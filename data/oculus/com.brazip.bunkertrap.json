317237769878_7370660503497987972_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwGGRmvtajQQ7kNvwFcyRaF&_nc_oc=AdrYtjk9CsdzO_oF5y28Kfr-_6wMKfgvzKyDAzEYFo3BIvE6bWNkTJh6dayi06yAcrY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSlNDJ9lk2WGoxcPCuFcSBHgMDWAMjQp0aJSrv17FIxA&oe=6A8ED42B"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bSXAd2NiD8Q7kNvwHJxx_s&_nc_oc=AdqMlWRew5e-87hycNzhm9jFdOkO-qTGWazMiEuH4e0Evz_1ZgSmlO4yQJx8vAgnZ7I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG360q3KaqE7HjKlhWzKLjsPzF3p6TGoQgXBmq7tLnhdQ&oe=6A8EC916"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1TBUKcQawMQ7kNvwG6gHUR&_nc_oc=AdoR32fi8lekDvEjt1kaibYnLKeXJjWTDcimxJIW8moBZMpFjIctc9EnrZbhJeuKFOg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE85w76dc6cPHEyaoZodCMNa0_mF8hhSbXo9ZZ7dETDeQ&oe=6A8ED082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2gNSXwOVVAQ7kNvwElmfKN&_nc_oc=AdrARZkWEGtBnFDRu9ngO9HBcJSmIUD17qdez4KJGTTqfvFHeNFIz7-T4-hlQEzm_us&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhAUby95WvA8hyvmsCeCj48DKYfvWiVgKxDPYijZxVxw&oe=6A8EDBA4"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "991480870068413"}]}, "baseline_offer": {"id": "991480870068413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780686360, "status": "PUBLISHED", "id": "991480870068413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28200773469535429", "version": "1.2.3"}, "id": "1738944914140691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28200773469535429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "New shotgun: Boito ERA 2001 Especial \u2014 official Boito partnership (for subscribers) \u2022 Realistic gun recoil on firing (adjustable in training) \u2022 Referee miss buzzer in Olympic Trap and American Trap (can be turned off in the menu) \u2022 General improvements and fixes.", "created_date": 1786627413, "id": "28200773469535429", "version": "1.2.3", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28200773469535429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Important fix: session replays are now saved even if the app is closed mid-session or the headset is removed.\r\n\u2022 Fixed: eye height no longer drops to floor level when putting the headset back on.\r\n\u2022 Redesigned Stock Adjustments: auto-zero with a 5-second countdown and free left hand, on-screen instructions, and a visible pointer in passthrough mode.\r\n\u2022 Translation and stability improvements.", "created_date": 1785326467, "id": "28016414361304675", "version": "1.2.2", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28200773469535429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "WHAT'S NEW IN 1.2.1\r\n\r\n\u2022 NEW \u2014 BROWSER REPLAY: review every shot in 3D at sim.insana.tv. Clay trajectory, speed-colored aim line, pellet pattern and reaction/shot markers, plus a professional analysis panel \u2014 for Olympic Trap, American Trap and Skeet. Slow motion, orbit, zoom and fullscreen.\r\n\u2022 Your last 500 shots are saved for replay.\r\n\u2022 Accuracy and stability fixes.", "created_date": 1784160726, "id": "27862122520067194", "version": "1.2.1", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28200773469535429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "WHAT'S NEW IN 1.2.0\r\n\r\n\u2022 New discipline: OLYMPIC SKEET \u2014 full ISSF rules (singles and doubles, official 8-station sequence, no-bird), on the 3D Insana Virtual Range, with replay and stats.\r\n\r\n\u2022 AMERICAN TRAP on the Insana Virtual Range \u2014 3D field with official 16-yard geometry, alongside the existing 360\u00b0 ranges.\r\n\r\n\u2022 In-headset account \u2014 sign up and log in with email + code, no password, without leaving the app. Free trial with full access; a demo mode lets you keep exploring afterwards.\r\n\r\n\u2022 VOICE gun auto-alignment (with eShoot) \u2014 say \"LOOK\" during stock adjustment: passthrough turns on for 3 seconds so you can align your mount with your real gun, then calibration runs automatically.\r\n\r\n\u2022 Custom trainings \u2014 build drills at sim.insana.tv and run them in the simulator.\r\n\r\n\u2022 Regulation chokes in series and competitions (Trap: Extra Full/Full; American Trap: Extra Full; Skeet: Skeet 1/2). Your own choke choice applies in training.\r\n\r\n\u2022 Replay and scoreboard on by default for first-time users; richer per-shot stats in the website reports.\r\n\r\n\u2022 Stability and performance fixes: eShoot reconnection, microphone, replays and smoother virtual ranges.", "created_date": 1783031298, "id": "27722881443991303", "version": "1.2.0", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28200773469535429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "What's new in this version:\r\n\u2022 Improved VR positioning: the menu and the range now always appear right in front of you when you open the app and when you leave a range \u2014 no manual recenter needed.\r\n\u2022 Dominant-eye gun auto-calibration: repositioned, easier-to-reach button with a step-by-step tutorial. Fixed the tilt that affected the Blaser.\r\n\u2022 Insana Virtual range: corrected shooter height (no more feeling \"sunk\" into the floor).\r\n\u2022 Training, Series and Competition now separated in your stats: practice no longer affects your score, and the app records whether you used the eShoot or the controller in each round.\r\n\u2022 Richer statistics: per-shot data capture for advanced performance reports.\r\n\u2022 Various stability fixes and performance improvements.", "created_date": 1781582987, "id": "27523899333889516", "version": "1.1.9", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
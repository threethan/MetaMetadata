03497987972_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTviL_gGj9cQ7kNvwGzU-kO&_nc_oc=AdrG-g8b4Uc7byJHgLaTtp5IlCTzr2XqDq3W99J0Kq91O76vPluDlQBi74smpTyAaI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK2tnRlElkq0DXNJq78hQt9bF7h86wrOLMKqmY920ISA&oe=6ACBB16B"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62a5jEzs7h0Q7kNvwGILy3o&_nc_oc=AdrrGp6fa1BxAshgGK_5JjHs-L_wJ7Fvjx5Dk_tqD04-npMc0uZDojiRVcel0yfbEZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3xW-VGNQosPIwTeRm2FGMfMGguFXJrZR7a29yOEOAzA&oe=6ACBA656"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQSt_oqdOEIQ7kNvwFpg957&_nc_oc=Adq_ODxWTgzt1QqC_bcgmCcqyHX_xfBii6pmbrXg8X6bfVjchBS8_71qrrw1r_W43S4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3QZMfJuQLP53oGq_T9qIlKdpD0TmCplwHjBlp2fE6YA&oe=6ACBADC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrj-QDs0c8IQ7kNvwEPU79s&_nc_oc=AdqGCAmtdeAWz4MyDyTkU4zRooCcmI5ftrqq6hVCNT3WGcJ9lyWxw7iLJ1z6e9NajuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTxVB2iYw02DgWjMGBNoWcXtEpA0zO2q-45TRwgYPeVQ&oe=6ACBB8E4"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "991480870068413"}]}, "baseline_offer": {"id": "991480870068413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780686360, "status": "PUBLISHED", "id": "991480870068413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28865679319711504", "version": "2.1.0"}, "id": "1738944914140691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28865679319711504"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Insana Simulator 2.1.0\r\n\r\nWHAT'S NEW\r\n\u2022 New discipline: Compak Sporting. 5 ready-made official layouts plus your own layouts, built on the website and selected in the headset. Singles, report and simultaneous pairs, 7 target types (standard, midi, mini, battue, rabbit, rocket and flash), a shooting station with the official gun-angle limiter, and instant replay.\r\n\u2022 Insana Countryside renewed: a new club setting with skeet houses, reworked lighting and a \"Background trees\" option in every discipline's menu.\r\n\u2022 Olympic Skeet per ISSF rules: targets cross inside the official ring and fly 68 m, with the houses in the official position. 40.30 m shooting boundary with flags, a dedicated station 8 boundary at the crossing point, a stake under the crossing point and 67/69 m distance markers. Targets broken beyond the boundary count as lost.\r\n\u2022 Magic dot: an optional frosted dot in one eye, like the sticker used on shooting glasses (Settings \u2192 View).\r\n\r\nIMPROVEMENTS AND FIXES\r\n\u2022 Faster start: the main menu no longer freezes on entry.\r\n\u2022 Smoother muzzle trace in the replay.\r\n\u2022 FAN 32: larger propeller on screen, and in AUTO mode the motors start on the first trigger pull.\r\n\u2022 Skeet: no more shots after the target hits the ground; in training, the A/B/AB choice works even with AUTO on; the gaze cursor only appears when looking at the menu.\r\n\u2022 American Trap: \"Restart\" goes back to station 1. Trap (Olympic): restarting a practice stays a practice.\r\n\u2022 PAUSE now freezes the countdown in American Trap and Skeet.\r\n\u2022 The simulator checks that a range's content is complete before starting.", "created_date": 1791033507, "id": "28865679319711504", "version": "2.1.0", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28865679319711504"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Inclus\u00e3o da modalidade FAN 32", "created_date": 1788975811, "id": "28548609698085136", "version": "2.0.1", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28865679319711504"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Insana Simulator 2.0 \u2014 shoot together.\r\n\r\nJoint Series (new)\r\nReal-time online rounds with up to 6 shooters: Olympic Trap, American Trap and Olympic Skeet. Rotation, timing and rules follow ISSF/ATA, empty slots are filled by bots, join by code or public rounds, live scoreboard and automatic rejoin if your connection drops. Create a round in the headset or at sim.insana.tv, and browse the final scores of any public round from the last 3 days on the site.\r\n\r\nArmory\r\nTwo new shotguns: 692 X-Trap and Beretta DT11 with TSK stock, joining the Beretta 686E, Perazzi MX8, Blaser F3 and Boito ERA 2001. Equipment tab opens by default; choke naming corrected, with a choice per barrel.\r\n\r\nRedesigned stock fitting\r\nAdjust by aiming with the gun itself: a laser from the muzzle, a position and rotation panel, trigger to confirm, auto-zero by dominant eye. Connect eShoot button right in the scene and a warning when the device is not paired.\r\n\r\nPassthrough menu\r\nThe main menu now shows your real room with your gun and controllers. eShoot status always visible in the menu, on the ranges and during fitting.\r\n\r\nNew ranges\r\nClube Mineiro de Ca\u00e7adores (2 ranges), Clube de Ca\u00e7a e Tiro de Guarapuava and FBTE Bras\u00edlia.\r\n\r\nFixes\r\nMenu selections (country, club, range, table, mode) no longer reset after Settings or fitting. Translations revised in all 4 languages. Permission prompts before entering a range and a safety notice when switching language.", "created_date": 1788395768, "id": "28460098993602874", "version": "2.0.0", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28865679319711504"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788287034, "id": "28442337425379031", "version": "1.2.9", "version_code": 26, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28865679319711504"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788271409, "id": "28439444685668305", "version": "1.2.8", "version_code": 25, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
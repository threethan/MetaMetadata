long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507829691_4410244125911124_5239468488646298260_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjQAxHeIJXoQ7kNvwHTVkhm&_nc_oc=AdqLpzffM9XBh4Vrl7Eh9deNMX7TmzFwtwYJ5rCuxYhTjtirBHeXz_6X65qemtkb1jw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9qWo5wASQMHdsKt5PlKYvGZ5lC5Am8az-yTZHZ6Tn5Q&oe=6B0B3297"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Insana Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1780686360, "lastRevision": {"nodes": [{"id": "27161898596756260", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp
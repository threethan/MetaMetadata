03497987972_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeC7baxZQ_wQ7kNvwFD5mvN&_nc_oc=AdqlB6kxMAOGpIg_bJSB6-_B0BlaKZOUPvXOoJnXTaG3PYDVyzf39Ui5nfdhwu6Avb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEOcsTauwmXV5eVO3iRbdYxubr0-MMq5sBvmqTf8WfGQ&oe=6AB7EAEB"}, {"file_name": "meta4.png", "id": "1470604968131068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507823984_1470604971464401_733091949474476674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTusuWLGZd8Q7kNvwGgwrd5&_nc_oc=AdrQ5HbhvJXBNnoX46H6nEBoB4epIKlbMMYKdbnE5T1oZ8OBZToOHCiQUuDSyFQr2kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFL3Q825Sn6-W5dYOow2GeFuZUqmYm_wjW4aZ3ejwYrg&oe=6AB7DFD6"}, {"file_name": "meta5.png", "id": "1307638290846744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1307638294180077_8298840943292730643_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ppro0iZN6kQ7kNvwGTgeZO&_nc_oc=AdqA2684TO1x15v_k3UQi78KnYFtM-yK_iva4lJ6puG4tZ_eaRm74B38F3pielQw9f4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEqal1WfaKA2m9VY-7rdnT-RKwaJiGy9ocsjUiaSabHw&oe=6AB7E742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner_meta_2560x1440.png", "id": "1716525962689611", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311582_1716525966022944_3607767146566041082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIUIPXgYqWwQ7kNvwFAf0MT&_nc_oc=Ado5TjX5gaiww9jMVt6WfX07aPV6augdFfsjd_DRf2dH-2SpGlRdj4lABc2BnpPh6d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnTBlo2jSFi3pa4atvBbp7UAyliHDPd_WT8G4gOeWLLQ&oe=6AB7BA24"}, "display_name": "Insana Simulator", "keywords": [], "long_description": "Step into the world of clay target shooting in virtual reality. INSANA \nSimulator covers the major international disciplines of trap and skeet \nshooting, with new disciplines and venues added regularly as the \nplatform grows.\n\nREAL VENUES, REAL FEEL\nTrain on faithful 360\u00b0 recreations of shooting ranges from around the \nworld. Each location captures the lighting, layout, and trap geometry \nof the real venue. The library expands continuously via cloud updates \n\u2014 new ranges land in your app without reinstalling.\n\nAUTHENTIC EQUIPMENT\nChoose from a growing roster of high-fidelity virtual shotguns, each \nmodeled with accurate balance, mounting geometry, and visual detail. \nNew models are added as the catalog expands.\n\nVOICE-CALLED CLAYS\nLaunch targets the traditional way \u2014 call \"Pull!\" and the trap fires, \nexactly as in a real competition. Microphone detection runs entirely \non-device; no audio is transmitted or recorded.\n\nTRAIN OR COMPETE\n\u2022 FREE PRACTICE \u2014 pick a discipline, pick a range, train without limits.\n\u2022 ONLINE COMPETITIONS \u2014 official tournaments with global leaderboards \n  and ranking. Tournament schedule is set by the organizer.\n\u2022 REPLAY SYSTEM \u2014 review every shot from multiple angles, with aim \n  path and pellet pattern overlays.\n\nNO REAL FIREARM REQUIRED\nThe Quest controller IS your virtual shotgun. Get started in seconds \nwith Guest Mode \u2014 no signup needed.\n\nOptional eShoot Bluetooth accessory (sold separately) lets you mount a \nphysical shotgun stock for maximum real", "short_description": "INSANA Simulator brings clay target shooting to virtual reality across \nmultiple international disciplines. Step into immersive 360\u00b0 ranges, \nmount a virtual shotgun, and call the clay by voice \u2014 exactly as in a \nreal match. Train solo in Free Practice or compete in official online \ntournaments with global leaderboards. No real firearm required \u2014 your \nQuest controller is the shotgun. Optional eShoot Bluetooth accessory \nadds real-stock realism for those who want it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sim.insana.tv/privacy", "developer_terms_of_service_url": "https://sim.insana.tv/terms", "publisher_name": "Insana Simulations", "support_website_url": null, "website_url": "https://sim.insana.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27161898566756263"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "991480870068413"}]}, "baseline_offer": {"id": "991480870068413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780686360, "status": "PUBLISHED", "id": "991480870068413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28548609698085136", "version": "2.0.1"}, "id": "1738944914140691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28548609698085136"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Inclus\u00e3o da modalidade FAN 32", "created_date": 1788975811, "id": "28548609698085136", "version": "2.0.1", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27161898543422932", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28548609698085136"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1738944914140691"}]}, "change_log": "Insana Simulator 2.0 \u2014 shoot together.\r\n\r\nJoint Series (new)\r\nReal-time online rounds with up to 6 shooters: Olympic Trap, American Trap and Olympic Skeet. Rotation, timing and rules follow ISSF/ATA, empty slots are filled by bots, join by code or public rounds, live scoreboard and automatic rejoin if your connection drops. Create a round in the headset or at sim.insana.tv, and browse the final scores of any public round from the last 3 days on the site.\r\n\r\nArmory\r\nTwo new shotguns: 692 X-Trap and Beretta DT11 with TSK stock, joining the Beretta 686E, Perazzi MX8, Blaser F3 and Boito ERA 2001. Equipment tab opens by default; choke naming corrected, with a choice per barrel.\r\n\r\nRedesigned stock fitting\r\nAdjust by aiming with the gun itself: a laser from the muzzle, a position and rotation panel, trigger to confirm, auto-zero by dominant eye. Connect eShoot button right in the scene and a warning when the device is not paired.\r\n\r\nPassthrough menu\r\nThe main menu now shows your real room with your gun and controllers. eShoot status always visible in the menu, on the ranges and during fitting.\r\n\r\nNew ranges\r\nClube Mineiro de Ca\u00e7adores (2 ranges), Clube de Ca\u00e7a e Tiro de Guarapuava and FBTE Bras\u00edlia.\r\n\r\nFixes\r\nMenu selections (country, club, range, table, mode) no longer reset after Settings or fitting. Translations revised in all 4 languages. Permission prompts before entering a range and a safety notice when switching language.", "created_d
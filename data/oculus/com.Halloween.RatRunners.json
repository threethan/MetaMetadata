urprises and obstacles at every turn.", "short_description": "First VR Game"}]}, "developer_name": "Halloween Strike", "developer_privacy_policy_url": "https://www.termsfeed.com/live/1022a09f-5692-4ab6-ad64-7709d53ba30c", "developer_terms_of_service_url": null, "publisher_name": "Halloween Strike", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vRzA1_srxY4CYs62_4NHd8X3xlrNvCeKokRgtSw4psY_dS5S6cfOMeA5O0-PDWCpPJF7aA_s8eqm0-c/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23875489372056281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391895_1689398188619860_4493548536810129471_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfnWC_wcBREQ7kNvwFFCQoV&_nc_oc=Adnd-cG1TBjmXpLyFyJpBf6rGG0RBn0WxkN9qQ6MX8UZlB-i5Im2cj8wMTnN4M6AQD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuZU517rc2vSZCml8RKHPJYej_8np9_NfS545RPzlYNJQ&oe=69A6BDE4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RatRunners", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Simulatio
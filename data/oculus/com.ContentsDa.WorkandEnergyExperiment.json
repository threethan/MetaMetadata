nce", "contentsda"], "long_description": "1. the relationship between mass and distance traveled, by starting a truck at the starting line of a race track with one, two, or three different blocks of mass and measuring how much it pushes against a piece of wood.\n2. speed and distance experiment, starting a truck at the starting line at a fast, normal, and slow speed, measuring its speed with a speedometer, and measuring the distance it pushed the wood chips.", "short_description": "Delve into the relationship between work and energy. This experiment illustrates how energy is transferred when work is done, a key concept in understanding the laws of physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8291265967650958"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031431_1352333012834949_4410695904174933263_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVlh5Yigm1MQ7kNvwGel4YK&_nc_oc=AdljrrgB_ykMNf80VOgvAGBpdzHcwNBAh0VJLeAV4nsGhhQd5YM
GGg&oe=6AF9D87D"}, {"file_name": "02-keyboard.png", "id": "2596971277438361", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628108_2596971284105027_4330288738900823285_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke1QDeIgmzMQ7kNvwFuUCVZ&_nc_oc=Adpi6sUdVxsLtOn6BDbIwCHQzK0LTxNIpiEaEbwypbyTzeR7rLBhMFN0w-C1WcG3Okw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyzla5criHimAU6_rDW4wAPxnxRJL4s3KFq68MqBG7gg&oe=6AF9C1CA"}, {"file_name": "05-history.png", "id": "1128591489874531", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499627379_1128591493207864_1054836328253233333_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDPxw0_5cNEQ7kNvwHCdpH9&_nc_oc=Adqv50-dnjOd4LqwNS8Fi-kHeaQXRxAJNHevSDDxfC5-LIu7_deABhbxlEWbkmpEndE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpAIr9vxSh52RaUfuDEdHJ_tc6-V8Tb5fntq6iMd2fKA&oe=6AF9D895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PC110 Atlas", "keywords": [], "long_description": "How did an entire 486 computer fit in the palm of a hand? PC110 Atlas lets you take a close look at the 1995 Palm Top PC110 and the research that reconstructed its electronics.\n\nUse tracked controllers to open the lid, turn the laptop over, or enlarge it for a closer look at its keys and controls. Point at a key, the TrackPoint, or the handwriting pad to see an explanation on the laptop display. Switch on See-through to place the model in your room.\n\nOpen Explore hardware to examine the mainboard and companion boards. Separate their copper layers, isolate a layer, and compare the top and bottom views. Open Schematics to trace a circuit, from the keyboard controller to the LCD, or visit History to learn how the machine was documented.\n\nThe exhibit and its circuit references are included in the app and work offline. The optional bezel customization accepts a local PNG or JPEG. Tracked controllers are required. PC110 Atlas is an independent educational project.", "short_description": "Hold a 1995 Palm Top PC110 in mixed reality. Select its keys and TrackPoint to learn how the hardware works, separate the layers of its circuit boards, and follow components through the reconstructed schematics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ahmadexp/PC110_MiSTer/blob/main/PC110Atlas/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Ahmad Byagowi", "support_website_url": "https://github.com/ahmadexp/PC110_MiSTer/issues", "website_url": "https://github.com/ahmadexp/Open-Source-PC110", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1495338120319371"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1774874573956323"}]}, "baseline_offer": {"id": "1774874573956323"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794063840, "status": "PUBLISHED", "id": "1774874573956323"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1495328906986959", "version": "1.2.0"}, "id": "1777493283282271", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1424274187425765"
-25/499622188_980352378461181_1278908084702284763_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRmyRHG77NMQ7kNvwHq7Ui3&_nc_oc=AdokBihQnhT3xPAC0J2gytkwV4nswhXFVPZzrLDjzaBIbY1OpS8uh9Z9xMkZjI1qf_U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6TrQCPjYCI9gmFDM8ZdGlfD-3W_LWsu0Ikv_SlHWFIQ&oe=6AF9BBFF"}]}, "id": "3775138132641966", "locale": "en_US", "screenshots": [{"file_name": "01-display.png", "id": "1419682046991545", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623512_1419682050324878_3851022573372393297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lChSaGwJhsAQ7kNvwFgCq__&_nc_oc=Adph4vPIXicKDUMZ6aN77fJrBDZJK54RyOacgz2XyHColzS__Y19dgV6maP4aU_pm8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5g5yZ6b4Ze5Av8-kaLjf1xTZPlBsTnbwj35aN5W9Ypw&oe=6AF9DB5E"}, {"file_name": "03-mainboard.png", "id": "1582024573728968", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623565_1582024577062301_3360678852357352088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnmAO8F4ofMQ7kNvwHtE1iV&_nc_oc=Adp5Upqf2jshAJ37NPbNgF1Ty14XFL3zO1bIZIUV8TXZ9seC4qptoPzBsvcwwbePlck&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHtI6GljRdV35R1ibD2ITC3x6yWcjDjtdHFoCJSLNk-Q&oe=6AF9BB01"}, {"file_name": "04-schematic.png", "id": "1111555551474263", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620669_1111555554807596_7499141824601695393_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8Ppn4NVcEIQ7kNvwFI4F0q&_nc_oc=AdqbaesQjz7MzI1KzEINUQmb4bi-ObACfJBOctFpBtfsfMIXh9TivJFFfb4f1c-FN50&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI8q7Cn-jFxSjeleN6Guv7SdvirLLq80rYevY7zBnGGg&oe=6AF9D87D"}, {"file_name": "02-keyboard.png", "id": "2596971277438361", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628108_2596971284105027_4330288738900823285_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke1QDeIgmzMQ7kNvwFuUCVZ&_nc_oc=Adpi6sUdVxsLtOn6BDbIwCHQzK0LTxNIpiEaEbwypbyTzeR7rLBhMFN0w-C1WcG3Okw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyzla5criHimAU6_rDW4wAPxnxRJL4s3KFq68MqBG7gg&oe=6AF9C1CA"}, {"file_name": "05-history.png", "id": "1128591489874531", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499627379_1128591493207864_1054836328253233333_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDPxw0_5cNEQ7kNvwHCdpH9&_nc_oc=Adqv50-dnjOd4LqwNS8Fi-kHeaQXRxAJNHevSDDxfC5-LIu7_deABhbxlEWbkmpEndE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpAIr9vxSh52RaUfuDEdHJ_tc6-V8Tb5fntq6iMd2fKA&oe=6AF9D895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PC110 Atlas", "keywords": [], "long_description": "How did an entire 486 computer fit in the palm of a hand? PC110 Atlas lets you take a close look at the 1995 Palm Top PC110 and the research that reconstructed its electronics.\n\nUse tracked controllers to open the lid, turn the laptop over, or enlarge it for a closer look at its keys and controls. Point at a key, the TrackPoint, or the handwriting pad to see an explanation on the laptop display. Switch on See-through to place the model in your room.\n\nOpen Explore hardware to examine the mainboard and companion boards. Separate their copper layers, isolate a layer, and compare the top and bottom views. Open Schematics to trace a circuit, from the keyboard controller to the LCD, or visit History to learn how the machine was documented.\n\nThe exhibit and its circuit references are included in the app and work offline. The optional bezel customization accepts a local PNG or JPEG. Tracked controllers are required. PC110 Atlas is an independent educational project.", "short_description": "Hold a 1995 Palm Top PC110 in mixed reality. Select its keys and TrackPoint to learn how the hardware works, separate the layers of its circuit boards, and follow components through the reconstructed schematics."}]}, "developer_name": null, "developer_privacy_policy_url": "https
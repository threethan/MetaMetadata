e7a0a&_nc_ohc=QgRo9X9Xmo4Q7kNvwE5NH4u&_nc_oc=Ado3AJGys5jjysYeOGb3uLLQVd8E0-yMT5O0SypFNo7kdxg4wY3CimyIeZAfiPAqU4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5ydZsH-7t6Nkx2BkEDO5INnTg69rNZFHQKA3uVgA-tg&oe=6B103C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNE6NrvbmPoQ7kNvwGI0cBU&_nc_oc=AdqaDyJVpj6FZNoIEw9Qow1LQMiCdpfVvD2eWuSzb8Ez7iwspFDnwq0p7D6nzmbxBFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNjgxAsStKBdIWJmuoRWbD_DmDTNYgglpdiODTeSWzhA&oe=6B1051C7"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wV8PP4yjwIQ7kNvwFNPULp&_nc_oc=Adp3LqQ3aEGqGR2hEsy60AIlHXxxkwTfPBd5PT9C2MdiFmrQgPb4dyZwPIFLHe
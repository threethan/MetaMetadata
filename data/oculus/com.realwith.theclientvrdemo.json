1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W_0op8T23UQ7kNvwHc6-3D&_nc_oc=Adn5TQGwEwvyc7C2zVk8ZfVIU3DoXItY9Cc8Y1GKhoYeJUjAYbEUc14aYHdq3792yVc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftD-emiSAe7RwyAKgrm4HKyntw-bVInZWt7GtSb5kShkQ&oe=69A59917"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt3Xt-eS3-IQ7kNvwFyfp58&_nc_oc=Adm7qxfpySFJTNE2InNIY5XOtPNgixYawKLGeLkg5qT1WP6mKyC8FG5Pzb-RK2p4FfM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsmsnl8S2TP41VI2vdOtyGRh5HOKV8FvNnyJ8I_dbLJXw&oe=69A57793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttO_9AH9TQsQ7kNvwE7_6uA&_nc_oc=Adl-MGCVtD9MjzmEOZM_BkM8I9gImpnaEdcrgzA5DhkYqug0ltVs-fs7-hYuNTWPcpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsuuvdG4_LOF4N_z9TUcbggEe6KdDKLuzx0cMFeyAN9aA&oe=69A58D07"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG7mgBJjMkwQ7kNvwEuyioL&_nc_oc=AdnbkeXhzlNaht4R7vK56cOLTqPO1VVKJflnb7yx_Vr_8lKyN-Udbe3Ts7LDA7DAlvk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftysrG3mauFk-IL9IFWuL37WRJkk5XIkgzlRvNNP-7ezQ&oe=69A57B2A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWrObvn8giYQ7kNvwEI319G&_nc_oc=AdnR7jxlUtVYbZ1tEs6sQT7zMLHzJCYNiMPNVHDnBaHSHDNj7dOdnAvK9J4M9mCEMZ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftRLL8YkranlKrUUV4tjj21VPj3tw8WEUiN9IFojIpMCA&oe=69A58DDE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gs9UQALPeQQ7kNvwFzEYrY&_nc_oc=AdkKWrMjySBGEqel2srlbQZi-OlHnBxIOIIt294RlZ1AaToxYGr4HedyXK5bQZAYEVs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsSNV_JRKF4S5NNj8deEIh8cmBAcQk3_1-8MPYkJoLY7w&oe=69A57CB1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EWo_8jO8qIQ7kNvwH04LYD&_nc_oc=AdmghKlUEc1UJOW6y3nS_c3LGzkwGmTyovIWE73I1JlkVNBTeayZs4VVPtjQ4tbkQX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv4pLW7xZX2D6MUOnMKPPds
1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPvkwgAqi0QQ7kNvwGnKjWB&_nc_oc=Adnkney8iMC__pwkh6MsB0m5P1EpCMpEMjuayMFBT6eGEoz6HGiGW0Z-LZgpnBNioGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6VWN_Dij4XsG5VGAYUwKZl4O4azp3d2UwlE6Mz1XqDA&oe=6999BB97"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEYmYBbeFgMQ7kNvwEGr00w&_nc_oc=AdnZLt7SahYzdBgoLAsy8LG3fC5fJNoMnkiYKqkSVnCceHZ4E17UtEaj0PhzQXkI4pI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvbtv47wgVAV5eyp-Gxg_s7qhs9S-pZ9D-vMbdUH0EcYg&oe=69999A13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjJEUsemYEQQ7kNvwFdZVt8&_nc_oc=AdlaLEMgUAiVzqQKQHTKY5iC30CnWXWKiF-SOz-TsKjzmW2nRFeCWsl4aXaV8SbE3Qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFA2lJJToK2ERgKple1zyGfILdPTZH2kC3Te8g-vIlug&oe=6999AF87"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txwzqL4D-AAQ7kNvwGMIdMD&_nc_oc=AdkmxBdvsXW1LhAbmUxf6muprzMZ4lVNbIXDdC9-7oVflzFoXmefNCeWkrHOMkqGE_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthjCJG5EL_GB-g9p3RvE7cSJT8U4f5cVDrxThau8TnlA&oe=69999DAA"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8Rxz9w4HVkQ7kNvwHOT_DV&_nc_oc=AdnFguPEIahc7-KTLp77XURARgZWoIEqh_UrlAMfjMguDd3IiSJwdLbSUizoIvh9REM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGDGscNc9kGBuVoFsEM32WDbpir6VkjYp3wxcU455K8Q&oe=6999B05E"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnMt3-knEl4Q7kNvwFVUyUL&_nc_oc=AdlpXoBmLWf0wi72z0jDU7pG8J5h2CmyyxrZmAqB4CR91FQEIU-zNM49uYLlXuKLKyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afth6EezDlKotDa5x9v_4ONPrFMcyucWNKlOiivbxHXPAw&oe=69999F31"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JiUdV9VI7YQ7kNvwHnrsPy&_nc_oc=AdlQpQc6vub8ncmY7aFa5cfwlJmlqJLSQ0DPaLpeJtlrNw3jUy9KEDn3muvXEI0KyP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5CrV72JX8DXhI5kuOoOF0
_ss=7f20f&oh=00_Af3kOAthZJwDN6bd2vs3e65pIDDBUTjhz8viyulFu4w6yg&oe=69F1E6B5"}, {"file_name": "(2).png", "id": "392736832379884", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974711_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=293SBtjtxAAQ7kNvwE_6Ca6&_nc_oc=AdoszJt1DG6k6mkQ54pfMUvzJmGLZBIe2Tojom82dvdPecZmQV9Gg06tmlj3DwMzWr4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0LZxSyBmvD24Vd0fs6d_L5h--95FyLb2sBGD7vaMVxKg&oe=69F21017"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syw6NJiH7YwQ7kNvwEDapA-&_nc_oc=AdoIcxa0eYtT29zhB0f_DFwI3_SuQy71AFufR2n4mPkqrzDamYRwwSi4ob18XOLCF_s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af37S79aXYVAyqN79qpmGSfHeDClTHwUsdO1dTIKjJpMqw&oe=69F1EE93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGz7pITicuMQ7kNvwEewACG&_nc_oc=AdoEunrXaZs7qpjScJKRLmN89XzwgkIjArbtSkQV-AiJd7Fj_xTYXCfnHHxPoDFOCuU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0e7JqqiRzym0Fvzc2lk3sypTixRbiNitl3-E72PQEQBg&oe=69F20407"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG-w2icB7O8Q7kNvwETUQQ7&_nc_oc=AdqBL0YVXTdkjPTTVRdTf8VdQA0GZ-tXzNVXsXBxTilHmgVYyAYM9NmNHKEgY2d7VUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af201CH3OBDJiHEcQ50sPiN1_gXx5NAlqkQoDzvsXuMmYQ&oe=69F1F22A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezo2_npjbmMQ7kNvwFoBkXr&_nc_oc=Adq3ZoPMKsfxJgrxkVFgWNcf_T5fTrQuq6agZ3uMZoEjxyQq_uXoFPVH-Qy2Ds2GGFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TYsIEB9U8GrNrwHAmBE6SPEHqR4WGZNzlU1S3H4Sz5g&oe=69F204DE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bnhgzZprygQ7kNvwFkB_Cw&_nc_oc=Adrt5yOJgBj_C1vUB6aHl3Iv-UauRjDr0XpSqpwNxlTZOksvsNNZwVRnWyoItlJN57Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DRv3bgbk9BHSR74bzjZJjF1CO4MqPVYNuPTLtMxD5fA&oe=69F1F3B1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019
1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZG-jXhUxUMQ7kNvwHaqa1i&_nc_oc=AdkU-OPNeU1LE508npD2ohnwNBLYJBK9OIAkcWWH3CbWwbn8P79wNZZqrgBZMLsYmcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6YYbUJ3pi5tHnltjjOnhQFlEaE0Oj9z2sHFNcCN7HLA&oe=69A05317"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FQu60jPcsAQ7kNvwE9d4yk&_nc_oc=AdkBjIFYQynSaP_iznlLAH4rKQjk4re6hnnd3YY1JOLwi4gTpQ5TqqLvCuK_5-OECjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuVi8nZ8fxuTMtF9xH0dytU3ug0huK0Vr8VwDqVbyUDqw&oe=69A03193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkQv-xWz6dMQ7kNvwHd49HJ&_nc_oc=AdnrpuFRrA7Lvx--r2fzUdC4MGjmW815-EgYzmF57A8Tzf1HVWRrl3zqS0Tq5nm5vNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuV29l_i20SDAAkWWuFJiqG65a-y5X8PCUujaP8NscSgg&oe=69A04707"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO5HLXzFjbkQ7kNvwF9FgFm&_nc_oc=Adli8eg2xUyan6FAuWKfj6OOAEs1tt1Sij2yjAFQEKKe8ZlOvnpsNp5XLJ8UWidOFPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYO_O4cphtRZNqcvIa1GU1hYzpKImFVaRSmL5TztEbog&oe=69A0352A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldgCar9RcPwQ7kNvwFYgdXW&_nc_oc=AdnbGrBYuwrEqdmoKJtthZtlb0EmNBxGQNbu320Mq0TmIrLFQQrCnECtqpcuBF5-WFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvg9oEtaqHFUY-a5YivzGuBdEXa3HYQ1dzvVk6QnNxBbw&oe=69A047DE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmajW8tEbm4Q7kNvwH9xCAZ&_nc_oc=AdmNiLqFoHetzS4MeymUXB6Dw75SJcLsVtxio5qpQczHxTYQPCIPE8jiUweJbXlSQlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDdj4fzzVyxVySi3GKf_4Os19TjKpR8Ua_lA-aegVzTw&oe=69A036B1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT3TpmMQVyMQ7kNvwFGRo1l&_nc_oc=AdlXRzGU0ms2ZYU6XtRzUEezqkfLza9n1ypHRGfgwX7EPwY3gqiMLYJMTzJIa58VCMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsvfs9u6H_O-_f1JtD8ZClf
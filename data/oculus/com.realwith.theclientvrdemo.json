e7a0a&_nc_ohc=u810rXQ8iOIQ7kNvwEd-SnM&_nc_oc=AdqVqzMUpPsdt3M03WIN-fIqD1oMZZf35xgHR0lNzQ7HVf88RjoXKD4YV8tDxdy3wCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFkddvLc8cv__8ptX8-4hA1WQyfX2vXc5uEOW7wL2j9Q&oe=6AFF18D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zukwRLZ1_FoQ7kNvwGqkO-b&_nc_oc=AdoXZL4XKe_lePT9wY4QVi47Zahr7wugLF9_iZJdq9FzK71fKlkZm0LN9Gz85U1hsbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwWQao8VKNmoS6bds6ILwr44C1IDmgrFAxlJSj_e6uyA&oe=6AFF2E47"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILgccdA6CcYQ7kNvwEc_mDD&_nc_oc=Adr2eAkBqTnwKmtv0CWhQPLT9WOaxGSOtpFyZLWLgCnQXdKqPFWzZ0mCpY91ZI
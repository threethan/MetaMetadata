1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZG-jXhUxUMQ7kNvwE01Cn3&_nc_oc=Adn5arXk6zx9O1yC9p5LGoq6XkS0RLBXBd5eweHLbPGfryzc_t-9VRhF4aAba_X0mfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv04J_tX_3RNz5emcCKBwvZhGFogFiouHX33m41QNNffA&oe=699DB017"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FQu60jPcsAQ7kNvwH0tov7&_nc_oc=AdlR-sxSOQ7JQN1p_KKUQNwaxFUBaj6HxZ_uZkESBt1yI1R7W7A4NTralmDD7yubfZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrhWQNw7Qibp3BP-5AQj34Qsu1Nf24fHDS3bWz54M52Q&oe=699D8E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zbypPiDqBEQ7kNvwFgxsCr&_nc_oc=Adn0a4Eo1b5WcmWpxpFMTRtjcNQ-e3pXfUnjscGJoKuogB_19JVCyU1lC3bsL97gzuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZSpkQY9QVq_RbvawKNiVE4y7VhGDg2vWuvS4pmAIgMw&oe=699DA407"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvMqwxpHhdIQ7kNvwH561ea&_nc_oc=AdkFDte8ERxf1khtW8Ky1YfBXtU783R6SLJ3frcmOTgYkZHHTJPilV3Sw2dFGp3BRZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsxh9bv5kal2hNMvM5ZrNaXEg18m1M5nsp1Zf3aXM4F8A&oe=699D922A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldgCar9RcPwQ7kNvwF8ALus&_nc_oc=AdlSbX-hbh-zQ6g2g0-0suqCotCLxAk_HW0vHy5DG5_IBxv4D9uqq_4zQisk0HE5YCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZ1ZRC6r3N7Tb1r7cBpvi5qHyZMM13JQCok5ZcC3x6vQ&oe=699DA4DE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLEEexjl0EgQ7kNvwFt1zVS&_nc_oc=AdmG-ZpJwnOVtNmTwdR072isPiJdczj0TOii19kg-Tbc_88eC25tBx2GYhgIODScdfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsfEjM-y5ZFUJiwJ5B7ppZpI5QHKdh7ZySe2urWC38TyA&oe=699D93B1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe8fcgwWBNEQ7kNvwGHKHgS&_nc_oc=AdlVGQFWA8biSclGoTLvnnYbTlB0YOVhSyfHhN7WNi1yST1fmBB6G3hcSOJxrGx3084&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaZC9QrBlafstNKBrZjzST
1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPvkwgAqi0QQ7kNvwGAAV1E&_nc_oc=AdnZB4UdGpLRYUYMQ_bADv_kCOBRJlYqIAep4XQ_dCEsXf8AgRwPEkyiYy3BSHe9UCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvJpOW3XNj2_mWU-7IXVa4oj1c1GhQV1W89FQKe213eGQ&oe=699B0D17"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEYmYBbeFgMQ7kNvwG09s1d&_nc_oc=AdmO4XWUGCiFVlvUziSwr9ULTFjgI1tM8TfwgRwicMtfCchL0slC4c_trqorrPEr-QA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu52h05ZNWh6PYKTvn86wnfan4O4FJpBg7ZO06zYqBAxA&oe=699AEB93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zbypPiDqBEQ7kNvwEkdWDA&_nc_oc=AdmrPskSOQOUadYEuZgc6VYDPxuIrTCe3cn4Pei8PZCtPqPY3UhyyAHDctbk1Jz_fE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvFRXvLcjS0zYPzqTIz7VbQi7QsDDsUF-hPkl71IH49RQ&oe=699B0107"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvMqwxpHhdIQ7kNvwH7U4bc&_nc_oc=Adm0Kv_uV4KzSdVybgc1Qp55Fzwtd6XwO-osszBQbkigEEro9c6o-m4mXZD2pUPsEhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsZ7U5R9xRZYncrXxj2e4BVrPlzkFGvIwdVF9c7WtvCeg&oe=699AEF2A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8Rxz9w4HVkQ7kNvwGw71v3&_nc_oc=Admo7cBoXO8qSDzn2eG9d49tVM0kaHdv2lgeOrvrfdcVT3Kl_Q259TTAN6zQR273lT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1jsfFmJJ7JQjLTeyM60kjPVTxK1a282AFD_04apMqTQ&oe=699B01DE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnMt3-knEl4Q7kNvwFvEGPY&_nc_oc=Adm_RRJ67LmYWUy-INZE9a1PqKTHcxb6-joFbS8M14WZVNFhHKLL8IhYDvUEhbfs7QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv3XzUqgQLbQs-HNZjc5IpyuLoY0tiu8XRRKwPRl-yGJQ&oe=699AF0B1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe8fcgwWBNEQ7kNvwEyOjpx&_nc_oc=AdlaBSX6AXdUeTToR5vTgP7QM8MUOoEwQ1ykUhTGfqZyahYNFzVd5PF0LRhweVCnx1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvYXGo2YfAtP1Jbs0mj2oCw
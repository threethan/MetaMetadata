1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNAFbZs5yDEQ7kNvwHWebKF&_nc_oc=Adk4KE7Q6aMO_GE3haVP_gttDoOSy7t-_vyp-lAnaYAPbsPb2KdlqeJi9_XKXm29_Dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuHTvVlkWytAlIbAokaCENrDicaV1CrCcyVjzfWv8vIOA&oe=69A44797"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPjj2mbPzBIQ7kNvwHn4bq4&_nc_oc=AdkzHgoO-f2kuwx7QaFq9WIkOTQ54R_lMPexW0oIw6KBeT2ASGZBVtjXBMX7xHqhqqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvSPyIxLCxkE-9pwUGLibyJBBIouAJuEIJJJTw6XY--yA&oe=69A42613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttO_9AH9TQsQ7kNvwGkxPJL&_nc_oc=AdmCDIbKuG4FZyrRE_IdeOnOZ1ce1AKMTYeStfMAs4q9Db4r97ls2p_KQtPF1gJDbaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuaDGXRj1YWlSX_X1OBji2Mf7uLWRpjqKsI2x6jdTbY0A&oe=69A43B87"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG7mgBJjMkwQ7kNvwGr9WIi&_nc_oc=AdnoikwTdQtOEoAlOHOTPwe1hcwmPTFT1ni4kTScFayS8nVdmLRv_RTFFMSozBHu1cQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftpr8E3aGatZlCiJEek0yXc6m7f-N0qiNrZzuewCTpcVg&oe=69A429AA"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U6cdRafacUQ7kNvwEmk0wx&_nc_oc=Adn3NvLblaBk_uEdiA2RrPBRsWWrLqEfzncZUC_17hPeuC_zdq-9jO-jlfAaPdk13j4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsTee8RB-nns5odx4xQJnzINJRhoEYPUGdVc6pJG2nO4Q&oe=69A43C5E"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gs9UQALPeQQ7kNvwH_RMES&_nc_oc=Adk-tnPhy446NmKZCJKGUKc6H2J9Rcm4f8cymS3eDf7QAIomwO7wvRODZDsMnes0GAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsAB965H4TsZ8s3GPscfx9x_ojwDi78cBGCPxIQKY2J9w&oe=69A42B31"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EWo_8jO8qIQ7kNvwFw6yEB&_nc_oc=AdkMOlhsCzedlXJdtwrIsWEC1iMTwB6d8i0mxFxZaRltJpekIVqVGksnfJ2bArknHTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftp7VLFMDHDAJwybohdg6YZ
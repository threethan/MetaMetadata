e7a0a&_nc_ohc=1A4eIjm38I0Q7kNvwFaoBMe&_nc_oc=AdrpqAxx9vJBCnWsCY5UyOEMw57jbGBLlImbC-u3UXxbhhN0ybtZdbQlSq-rN2pU2Ek&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE8HJAF5TsEG3ACcp3WhTY9TMpuL9wWLGj6Y_larlm2w&oe=6B09A4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gnPWgbek20Q7kNvwFCjUAI&_nc_oc=AdqrBOBEujrwYkkFCgW_UtLpRNekzVRxIbpMUZP6I4ONPHAs6H9b11bu1iuNj0V7IRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6uBAazoRSgDPknJJrkGwEokXb9SE1XS7Vr5-_ZveTdA&oe=6B09BA47"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8AwA69xA60Q7kNvwE460Yv&_nc_oc=AdrKfk0Za__qVhhV2uzep3INg3lk_Ftq4cniOq4MxK67qsqYofFCrCLLv3iFl7
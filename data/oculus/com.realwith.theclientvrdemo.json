1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W_0op8T23UQ7kNvwHbm1VA&_nc_oc=Admfdk8qKm18moyAA47ZWi0bDOTrMnf79eyR5oKZDDiqRYHC7nNiy9pGvNKjJQJsNC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-MLXPEKl0H-mYw9pPiV4bnP_-FPqwD_cb9F26efIGAA&oe=69A6EA97"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt3Xt-eS3-IQ7kNvwEzZ_jI&_nc_oc=Adnfc3XojkJWYtkYRIT4oMw59C8fL4nvx44qbmQSuPMY1kIxwfnel7Oo_a1N_iW9W-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuam5uuPCkvLeRpu-yK9yoV5Cj8iSrkS2TXZsbAClXtcA&oe=69A6C913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eH9uAgaWrecQ7kNvwE7JqIE&_nc_oc=Adm8ZjDABvHUVv_iY424Ve3IVJ0-meHPNlf1WTpLO_HgKziHsP40Xl7nG1nOdgWx6Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvx_iVvnDNL3GJhWhvOggKHKGRw00iyI8b_JcMzFltgFw&oe=69A6DE87"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-zvnqgrj6oQ7kNvwEEWb4a&_nc_oc=AdnEcJI1AIu45oT7ZVmgs8OUxri0QBvoxYN2oY1ICBalXCPtGIX3WnVoxBfA7a-U1FE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMgRevV8yenvZEUHDCmz3pX_9N9eGUVDNf5TnaVMRgmA&oe=69A6CCAA"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWrObvn8giYQ7kNvwGZ_w3q&_nc_oc=Adm95AWGPObvFI-R9KzMhuV_O-K-NIOgNksEs5xECPFiSXgDkxuX49rls7M46BguSpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCk6bazz7SolDufBpO3RBqVLH7IqzWQ3c-hYNA2kQdjg&oe=69A6DF5E"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gs9UQALPeQQ7kNvwFMQUQh&_nc_oc=AdmwlrtKk7bFAyLK28FTCimp_3_aKMIihMtIhaJYu3V1L15I0AbiTUigFA4hVIpmBOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-yAHAm0XmdxcmiEPFzAiXd4-uZRVMWc2xGZzEeHXjhg&oe=69A6CE31"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Duk8RkJqpGUQ7kNvwHh0Onn&_nc_oc=Adn5o4Ycc44XN5ZCxtfiY-v8krAyqrBGZwp20pjF_etjdBWxkpDn--RMeIzcwVEIjmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhYRIk7WPlH0heqcqDqNdh
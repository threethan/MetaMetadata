1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZG-jXhUxUMQ7kNvwE22ikQ&_nc_oc=Adl7Slietri7_lvJ-YoJZWhAnBd6iXnkEueghFPxpBYpGjGxjrs-D7e1kCF9XAKdFO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfviWnOQg8Hgc68wl2l0WPU3ANOdmEhPmE5eHFdS10Q4wQ&oe=699F0197"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FQu60jPcsAQ7kNvwG6R7MW&_nc_oc=AdmyDCBJ6KUqnvfPspo30mfJSwc3gvWdOWh7hBsPBGjoIuCQjnDA1PsiC_B7_Ge7Lhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfucsXMbSQ75_EzQ8sdS4udlH6xxEBBLOWqLvjEgqvDZnw&oe=699EE013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkQv-xWz6dMQ7kNvwFKpSRV&_nc_oc=Admqs33mIa1kMGPgJTvDkLDnSBLtj6cYyaFNB6lWeQE9Ov1ExxwWdKeRC2k7jYUjYmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuWSr9ToQbRGarQcSgt3X-pfa4geHnGFOco2fe8N0IWhQ&oe=699EF587"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hangin
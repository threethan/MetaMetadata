1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xg5TYGPTdcQ7kNvwHyZswW&_nc_oc=Adma4-ncLo1JKIC5CP74fcOepSiARn1lOMTxtVdtaGUxmtPilkBPtVJRn57rQuONPic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsJDoHqW-_8_f-eHh-DW9TISigczZqG_rRnF2PhoOx29w&oe=69986A17"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb7W5lfeEzoQ7kNvwHovXsS&_nc_oc=Admh3cGpfjyPeT4oAhdv14hTAwCDVB03m6qn4f55C5kXskuqHa3VloqSwxY_wF5OsQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvi7CYgJ2RN3kpih-f4Och9Yd07_DEkUze5-U8CUK1lkQ&oe=69984893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjJEUsemYEQQ7kNvwEkXAoT&_nc_oc=AdltDZXn13uOg7raw6nmxdsHG0k5e7-U672-ak62KCYyhlmtk7Fw1eMv_Q4GO5XwUZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRwWovMzAR2bGAeDYbY5O9GC_BwJI0pxnZUiv2aYQpLg&oe=69985E07"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txwzqL4D-AAQ7kNvwFozK5S&_nc_oc=AdmIvpFhfQx5B27ZO2PihNdKY-eTKX2tf3Ps3-94dy5WDc5PJqUXSRyQE7QIKNHV4p0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvVSiwhQumso8X7k9KGVdBzBcASKWcV_3gW1xwHjBcI4Q&oe=69984C2A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlRxOYh0Up4Q7kNvwHglTep&_nc_oc=AdnJDqkhSf2u6GY5igyvd5poddquJNuUggjH9JkYpAvOmzF9N27xqMQk_7pHTwr1W2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfulyamCLxsnYrklmfRC78SdOX_KI4Hbf26__XLc_VePlw&oe=69985EDE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnMt3-knEl4Q7kNvwHc4UBE&_nc_oc=AdmZoXwEm1kyzrLJ95sVGQVeboLQKlgRfrFnz6DvIiYV4n1Z191G5mALyQguEe6riGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftnzDMKLM_ZNWaaVQcDacajOpJVPeNF_Bw40yLROr4KUw&oe=69984DB1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JiUdV9VI7YQ7kNvwENP-ZS&_nc_oc=AdnUs25GhYVlPM0_Y87IsaDAvTz0HaG9rV3TWnKDvNZG_xW9ci7ccC3stsMjUm5HLfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftTXZhEOh-OApMGVm83LHM8
1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNAFbZs5yDEQ7kNvwE1hi8P&_nc_oc=AdkjWOMQIpMClg0DbQlfd3yq4mlMyZq6heey8Js1uvT8fNoEr4p_inPAiZnOdNRlmm4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuH09V-Th6GmII3_gMviGb9j_RNPi0H9Cr1BlcQIetjKg&oe=69A1A497"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPjj2mbPzBIQ7kNvwHmkEHp&_nc_oc=AdmX-YSIkeE5xom6wWkIU-nsuzAwULk0XfZZswiZnB_ESwdd8XFNRXSrZdt1txi3FE0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvOHZM3icgoXT-ui6yOAXAZwR95D4Da_TmPD5u7gv3cfA&oe=69A18313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkQv-xWz6dMQ7kNvwHS5d_B&_nc_oc=AdnE_yKNBJ_bKXoXCVM1eQR52C9UAxn77IX6paoLlezZFBYNUYBrUsjfhVafxMuAva8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afubn3fnCrc8cZ5OYJB7R8Icc35OHmP4sxiSLnvS9VnD_g&oe=69A19887"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO5HLXzFjbkQ7kNvwGossPt&_nc_oc=AdnRykPLa6Wj8crp0FGaJYBwo8Vh_wllaiQQQ4vBa1ZXR9doJcUXy4hV-GPmTOf6Jrk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afse1VhNA1ujAtlVsL-Z7ubnwPQeErxB7MdRqzBi5bn-XQ&oe=69A186AA"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U6cdRafacUQ7kNvwGxUyRg&_nc_oc=AdkwxultAzA4aRDmQC7p1A5ck6hAS1PvZYs-lWLDFdxzuT8eAw6wIG81rJ00hxJbIm0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfscReFYPIVT-yHEz0RbpXuTHPF6qiXAnMNBbr2Jy9qgpA&oe=69A1995E"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmajW8tEbm4Q7kNvwEnmcoS&_nc_oc=Adn50gOks1jQV9_tmo4MvmL8r6Zzfg7tncXb6QcMZcId4dmHxvY1qZ0U3DglQd-Oodg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuOL465Oro2QF6Ww7Du-WeGcuX_MjnMNKVIOjU5PbnAZg&oe=69A18831"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT3TpmMQVyMQ7kNvwFt9K5-&_nc_oc=AdkZjM6eBXkgq6V11QBzwhPYWIiCXZPjQO-JFD9itnfWcdeoFQfy5ltx3umZLggmCsM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvD3V97SWF2uDgcXnD0mTgm
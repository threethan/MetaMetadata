1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=293SBtjtxAAQ7kNvwHi8aHl&_nc_oc=Adr4dYN1Edc3C6ahMKt2yQ9DUopRaQPfj7FdIq5r3mIHY7hP5GNI1XYDFfoTusqshdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2H5CtItu_Xag7IcNz1w3vefYtoy0QhnFCH2XgmVUNBbg&oe=69F0BE97"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syw6NJiH7YwQ7kNvwEBi54P&_nc_oc=AdqiQkbdh3b876tDYSKj-tDSnlZ67F8xkhEGVRhYlOPT1CH0K6f54DVWwtn-L374zIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0mIVAuD3HlpLucpkOfKBpaRGOz2ohEYLGeboiQjO6Y6Q&oe=69F09D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZAg2yB---MQ7kNvwHgBare&_nc_oc=AdokoW_b2-AtI414jqteLNqT8KLw0ZjYFoA-svxdnPEkqOYutEBCwOCdr0GTQqJTons&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2XJ_u1LT2MacaDS3IlB376ejFeklp6Lcsyqhk9OOqmJg&oe=69F0B287"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycMAbJge2gQQ7kNvwHO8cNA&_nc_oc=AdrFDCikEuGUUNjwM8-f9gnx3QPG4_F903FKzP-aFaQSyrULNFaQ9cFFsYzQWBcbF5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0lBNTJaiKA6oXCSOAwd08Cv6khYhjldwQ3KOXBkkzg_Q&oe=69F0A0AA"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezo2_npjbmMQ7kNvwHhWgZa&_nc_oc=AdodzBMwQSHzmU6f98ndm_3tstbyjXrkVSWDdjVBhHsMFwZa6FB_3VvfewvMF2ylezw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af21sDLq7L-DpExitVq4cAVlndURmi_NchIjBRNAE38m1g&oe=69F0B35E"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bnhgzZprygQ7kNvwH7Yi6y&_nc_oc=Ado9mOH0Wv5FKUq7v8-4dkO0s1F4oyaTxI3egldvp-mJVPMAz1lFyTFckmgl78bwFmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2HnHps3Mtbf6V04DRKAoyDD0OUFXIdqDJioYHSVvtLWQ&oe=69F0A231"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRVQSUL3WDcQ7kNvwEotide&_nc_oc=AdrwYyxMliNZIbNOtu7YrVRBZbkzY1RGuFgUPqkmjGBLiitC8A5BnEVxNicLGSq99uY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af39LD_8HF00npnyWSb2rv2I
1_392736835713217_9091262205406837122_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNAFbZs5yDEQ7kNvwGZemXe&_nc_oc=AdnrqOgayoaC05PjSdxIAwADCQzYXGzfrxnBiICnzfFHx2fFykrv9b1tMbROKIJqlyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTdJl-fK8a8kYD_kCLQuTCju49TN8cMqU5oV1OSLw-Fg&oe=69A2F617"}, {"file_name": "(1).png", "id": "1885539654952581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_1885539658285914_1019396935637988106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPjj2mbPzBIQ7kNvwE7Vp77&_nc_oc=AdmNM2QzYp72AwPApTbdw5u0NKAcjSf9lo89FWmv2SXRE14w16DeLdT8CuMHqY4gOAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7tkNvxRutECjgoMAUTpGJLjrxoDJ-ILyNabY7tB0RXg&oe=69A2D493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "(\ub370\ubaa8)2560_1440(211006).png", "id": "3049660518656719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_3049660521990052_5013043365891433031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttO_9AH9TQsQ7kNvwGMwuTD&_nc_oc=Adlq3emWfvx6QlXbyouCNOPdZZD8ykPC5LploSMSOuivSL4gW78G8bPiNemoKdULLIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNAz4b3G-q_zA-pJ-ZCkJ614vK7X7xTnYlsWFx4NRIdg&oe=69A2EA07"}, "display_name": "The Client VR Demo", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "(\ub370\ubaa8)(\ud55c\uae00)3000_900.png", "id": "429007318575366", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_429007321908699_4258283118475983943_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG7mgBJjMkwQ7kNvwGvnjBH&_nc_oc=AdlaYEY3eWzp4ZM-qhC1uCPjV819GCIYiOkpvqDZjxBFdOLC-ePoDCWWTxaViMM_vnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDNrhnmU4KN8r-g7g-zL2UC6-lVibGvq92nAokhgJOIA&oe=69A2D82A"}, {"file_name": "\ub354\ud074\ub77c\uc774\uc5b8\ud2b8\ub85c\uace0(\ud55c\uae00).png", "id": "3213236945564295", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_3213236948897628_4786406447797518072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U6cdRafacUQ7kNvwG3SNqS&_nc_oc=AdkaTglwoh4Z7Jjk6Cw_Aw-rbtSOQzqbU65qa_cvAEs6Wam5Hesoay1TFdlTS_3m_AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvi67Vk1yOUD9-EfR942vR-VSQ5KjZyK213hL0Xj0g58A&oe=69A2EADE"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)2560_1440.png", "id": "1042171706627527", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429288_1042171713294193_695814847444454466_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmajW8tEbm4Q7kNvwE0a01c&_nc_oc=AdllVO_vZOMThitqiH6z3liKCOfmyVQvSvpGW66OmPUWAywTtnqFBt9qDIAI0kio1Gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftn1JEE66jLp51njF1KjNteUZ_VpcFtQancjSVyu0YyLg&oe=69A2D9B1"}, {"file_name": "(\ub370\ubaa8)(\ud55c\uae00)1080_360.png", "id": "938165583721864", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_938165587055197_7689133019531011071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EWo_8jO8qIQ7kNvwEn-_6U&_nc_oc=Adl3yYWRZu03rJOGY16HhZHSbH5gddYL9hr_rYtjQeOlAM2oCd9A1oTH4KDFaPI0wyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIRmFF2Sq7PZvgdr3AAdwR
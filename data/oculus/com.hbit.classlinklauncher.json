D324D"}, {"file_name": "KakaoTalk_20260910_182853414_03.png", "id": "1773561917119855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593727470_1773561920453188_5257105859006977388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvMgPJ2-c24Q7kNvwGysmbQ&_nc_oc=AdquUVOMlPKr4M0Y8b_niyb_UDOxl46a3zt6a6J6hYdQ6PcNXItVuYzmf_G6N1S-RHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGR_C_2MuDH7rYKzQLZvsDAP646Hq6R-d8I5RQcyM44w&oe=6ABD372B"}, {"file_name": "KakaoTalk_20260910_182853414_01.png", "id": "1072403255537908", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622162_1072403258871241_5826780204093508583_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu7CQmT6N1oQ7kNvwFtQqV4&_nc_oc=AdpGUBgXCsWuqJrAQbqDHMPVnPGOTtmdcqvpknWM2qHVreaoYcGj0ELHblG6_ZPAPRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFKaQh0ptXb3qWstFPMXUIFi66sjk60_cp7U2QomLMag&oe=6ABD24AD"}, {"file_name": "KakaoTalk_20260910_182853414.png", "id": "1756675789006467", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623565_1756675792339800_8651004016863498390_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pK_H6QlAXAQ7kNvwEgZrYX&_nc_oc=Adp-sT6KOrdt1mvtmCbUaqhU3sZbLNMpj0Aqfvh6WE4XBe6HmzJuXdMELIkBA62JGzA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpvSqR9UYuqez79zxKdCkCgj0D8pA-5JX59Pexg8M0rA&oe=6ABD0B75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ClassLink Launcher", "keywords": ["education", "launcher", "vr", "student", "school"], "long_description": "ClassLink Launcher is designed to provide convenient access to applications installed on compatible VR headsets used in educational environments.\n\nUsers can view available applications in a clear, organized layout and quickly open the application they need. Applications can also be grouped by category, making them easier to find during lessons and training sessions.\n\nKey features:\n\u2022 View available applications in one place\n\u2022 Quickly find and open applications\n\u2022 Browse applications by category\n\u2022 Simple interface designed for educational environments\n\nClassLink Launcher does not download, modify, or distribute third-party applications. It only provides convenient access to applications that are already installed on the device.", "short_description": "An educational launcher that helps users find and open installed applications quickly and easily."}, {"images": {"nodes": []}, "id": "1400311915501772", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ClassLink Launcher", "keywords": ["vr", "student", "launcher", "education"], "long_description": "ClassLink Launcher\ub294 \uad50\uc721 \ud604\uc7a5\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 VR \uae30\uae30\uc5d0 \uc124\uce58\ub41c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ud3b8\ub9ac\ud558\uac8c \ucc3e\uace0 \uc2e4\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud558\ub294 \uad50\uc721\uc6a9 \ub7f0\ucc98 \uc571\uc785\ub2c8\ub2e4.\n\n\uc0ac\uc6a9\uc790\ub294 \uae30\uae30\uc5d0 \uc124\uce58\ub41c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ud55c\ub208\uc5d0 \ud655\uc778\ud558\uace0, \ud544\uc694\ud55c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ube60\ub974\uac8c \ucc3e\uc544 \uc2e4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \uce74\ud14c\uace0\ub9ac\ubcc4\ub85c \uad6c\ubd84\ud558\uc5ec \uc218\uc5c5\uacfc \uad50\uc721 \ud65c\ub3d9 \uc911 \ub354\uc6b1 \ud3b8\ub9ac\ud558\uac8c \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc8fc\uc694 \uae30\ub2a5\n\u2022 \uae30\uae30\uc5d0 \uc124\uce58\ub41c \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ubaa9\ub85d \ud45c\uc2dc\n\u2022 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \uc774\ub984\uc744 \uc774\uc6a9\ud55c \ube60\ub978 \uac80\uc0c9\n\u2022 \uac8c\uc784\uacfc \uc77c\ubc18 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc758 \uce74\ud14c\uace0\ub9ac\ubcc4 \ud45c\uc2dc\n\u2022 \uc120\ud0dd\ud55c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc758 \ube60\ub978 \uc2e4\ud589\n\u2022 \uad50\uc721 \ud658\uacbd\uc5d0 \uc801\ud569\ud55c \uac04\ud3b8\ud55c \uc0ac\uc6a9\uc790 \ud654\uba74 \uc81c\uacf5\n\nClassLink Launcher\ub294 \uc678\ubd80 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uac70\ub098 \uc218\uc815 \ub610\ub294 \ubc30\ud3ec\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9 \uc911\uc778 \uae30\uae30\uc5d0 \uc774\ubbf8 \uc124\uce58\ub41c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ud655\uc778\ud558\uace0 \uc2e4\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud569\ub2c8\ub2e4.", "short_description": "\uad50\uc721\uc6a9 VR \uae30\uae30\uc5d0 \uc124\uce58\ub41c \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \uc27d\uace0 \ube60\ub974\uac8c \ucc3e\uc544 \uc2e4\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud558\ub294 \ub7f0\ucc98 \uc571\uc785\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hbedunwork.com/privacy/classlinklauncher_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "HBIT", "support_website_url": "https://www.hbedunwork.com/privacy/classlink_launcher_privacy.html", "website_url": "https://hbedunwork.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323445164192611"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHE
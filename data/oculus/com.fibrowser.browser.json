ck\n\u2022 Pop-up blocker\n\u2022 Search with DuckDuckGo, Google, Bing or Ecosia\n\u2022 Bookmarks, history and in-app downloads\n\u2022 Desktop mode per tab\n\u2022 Find in page, pull to refresh, keyboard shortcuts\n\u2022 Session restore: your open tabs survive restarts\n\nPRIVATE BY DESIGN\nYour history, bookmarks and settings stay on your device. \n\n", "short_description": "A fast, clean browser for the flat web: tabs, video, downloads and a built-in ad blocker.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fibrowser.com/app-vr-privacy.html", "developer_terms_of_service_url": "https://fibrowser.com/app-vr-tou.html", "publisher_name": "Michael Stollenwerk", "support_website_url": null, "website_url": "https://fibrowser.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082430434460865"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1707954140289249"}]}, "baseline_offer": {"id": "1707954140289249"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786128600, "status": "PUBLISHED", "id": "1707954140289249"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1156483483722226", "version": "1.3.6"}, "id": "4612229042387981", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes":
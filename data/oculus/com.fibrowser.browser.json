257_1582514376821341_1885589418518937397_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SoG54by9f8Q7kNvwFiiYrg&_nc_oc=Adp3ZT7AMFo7I4dRBvZdcSE2Drgfbz3Nj2pcQ9DN8XDUNrwb_Usu3aEiHPIUxfeCBiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS1UkojCjX5XOMU-HfgUABEJepKqfDRhyQuU9YzEk2nA&oe=6A95E498"}, {"file_name": "screenshot-4-history-2560x1440.png", "id": "1079010007897812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1079010014564478_1403238524400136366_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hijx9O-4HkgQ7kNvwEiy7BD&_nc_oc=AdokcQqtVtN14vo3wpEaK4jSWw3esGEQWRsiRBHguR-VrhWe0LaUgv5lW-w1f1m7Erk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeSQR11G7wZ2flEhOXQn2StKv4LaNPOqwGXi2Wht040A&oe=6A95BE6D"}, {"file_name": "screenshot-5-bookmarks-2560x1440.png", "id": "1082165881433776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1082165884767109_8451810117661691635_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AztiQ03nwZYQ7kNvwGrUxsm&_nc_oc=AdrlfXIq94r6x_HNeGbqgS90MtGVEW7HLQkGZpQrUQmhZ2XISOei2t4_d_iarwcDzNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3XFl3f4O5Cxd9gikoW97m73hHr9j5NFVoIZFrI7Z8ug&oe=6A95C508"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fast Internet Browser", "keywords": ["browser", "internet", "webbrowser", "adblocker", "video"], "long_description": "Fast Internet Browser is a lightweight web browser for your headset. It opens as a floating panel that you can freely resize \u2014 from a compact window up to cinema size.\n\nBrowse the flat web, watch videos and manage your tabs in a clean, distraction-free interface. Compatible with Meta Quest.\n\nFEATURES\n\u2022 Tabs with a smart memory saver\n\u2022 Built-in blocker for known ad and tracking requests\n\u2022 Fullscreen video playback\n\u2022 Pop-up blocker\n\u2022 Search with DuckDuckGo, Google, Bing or Ecosia\n\u2022 Bookmarks, history and in-app downloads\n\u2022 Desktop mode per tab\n\u2022 Find in page, pull to refresh, keyboard shortcuts\n\u2022 Session restore: your open tabs survive restarts\n\nPRIVATE BY DESIGN\nYour history, bookmarks and settings stay on your device. \n\n", "short_description": "A fast, clean browser for the flat web: tabs, video, downloads and a built-in ad blocker.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fibrowser.com/app-vr-privacy.html", "developer_terms_of_service_url": "https://fibrowser.com/app-vr-tou.html", "publisher_name": "Michael Stollenwerk", "support_website_url": null, "website_url": "https://fibrowser.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082430434460865"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1707954140289249"}]}, "baseline_offer": {"id": "1707954140289249"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786128600, "status": "PUBLISHED", "id": "1707954140289249"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1096356586401583", "version": "1.2.1"}, "id": "4612229042387981", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10
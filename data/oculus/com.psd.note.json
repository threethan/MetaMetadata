5JqORGUOPR6FK8HC1sdzDEJQBpugUGgB4kQN3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_kDBEBOIP-VL-znYBBCXUg7tIXXTVdWm-LkabCb3DWw&oe=6AF35622"}, {"file_name": "Screenshots5.png", "id": "976456841341345", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392129_976456844674678_2417479950853435626_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrXBQHh-00QQ7kNvwHBEj8F&_nc_oc=AdrKeVOM0V_zcH7pPK8EYlWYLlVDu66Wehagjw_dG3Wz4k0CxuGsAqp3X0HCpBWUv7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmeTUe7GAI93i7vBf95wrZ6v74AXmqgiyYv2YsT3fgcA&oe=6AF35915"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Note", "keywords": [], "long_description": "The Note App is a simple yet powerful 2D application designed for Meta Quest 2 and 3. It allows users to efficiently manage their notes in a virtual reality environment. Whether you need to jot down ideas, organize tasks, or keep track of important information, this app has you covered.\n\n# Key Features\n- Create Notes Quickly add new notes with a user-friendly interface.\n- Edit Notes: Modify existing notes with ease to keep them up to date.\n- Delete Notes:  Remove notes you no longer need with a simple confirmation dialog.\n- Organized Layout: Notes are displayed in a clean, grid-based layout, optimized for different screen sizes.\n- Customizable Controls: Navigate and interact using intuitive VR controls.\n\nThis app is perfect for anyone looking for a straightforward and reliable way to manage notes in VR. It combines simplicity with functionality, making it an excellent tool for productivity on Meta Quest devices.", "short_description": "2D application for saving notes on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1J1ybmCl2qpScyTaZgPgAwUaEodX1_EuWr9VHsPCsghA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": nu
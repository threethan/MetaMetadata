raoCIPg1AIfcMIXLAYEWaWSq4T0R1MsUDXopTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDL7F37Cf5PC5FhkT1NPpRH0v7Cl-6N2z3Zc62RqNWlg&oe=6AF46F62"}, {"file_name": "Screenshots5.png", "id": "976456841341345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392129_976456844674678_2417479950853435626_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrXBQHh-00QQ7kNvwEmpQA9&_nc_oc=AdoRBSgqaSIzg_2LnZGbF2ABSmwAwBvRPqSsTbDVQAYrzQB7K8DTF8gX_qVnolfZVDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzZLv8j8AkRl9BHaucq8b1PZxsn_acql14E86Psz_Fkw&oe=6AF47255"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Note", "keywords": [], "long_description": "The Note App is a simple yet powerful 2D application designed for Meta Quest 2 and 3. It allows users to efficiently manage their notes in a virtual reality environment. Whether you need to jot down ideas, organize tasks, or keep track of important information, this app has you covered.\n\n# Key Features\n- Create Notes Quickly add new notes with a user-friendly interface.\n- Edit Notes: Modify existing notes with ease to keep them up to date.\n- Delete Notes:  Remove notes you no longer need with a simple confirmation dialog.\n- Organized Layout: Notes are displayed in a clean, grid-based layout, optimized for different screen sizes.\n- Customizable Controls: Navigate and interact using intuitive VR controls.\n\nThis app is perfect for anyone looking for a straightforward and reliable way to manage notes in VR. It combines simplicity with functionality, making it an excellent tool for productivity on Meta Quest devices.", "short_description": "2D application for saving notes on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1J1ybmCl2qpScyTaZgPgAwUaEodX1_EuWr9VHsPCsghA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": nu
lMT4cko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG96WBPIFv2Z4s4HqHrNzDYkZs2j8CclLHA0gr0ineJw&oe=6B086B91"}, {"file_name": "Screenshots4.png", "id": "1182272190066527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473398306_1182272196733193_8714887730963934892_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK-sgf6znagQ7kNvwHqjuVd&_nc_oc=AdqGAJCcIZpoxIzIWWzpTSfQgNnnarBFXjb66aAdzY5cldsenWY7zOLPThxoIiamli0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC9liaUt3iwQRyP782J0efnOgMa162awgC4U8m72DO3A&oe=6B086E22"}, {"file_name": "Screenshots5.png", "id": "976456841341345", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392129_976456844674678_2417479950853435626_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLinuudUbLIQ7kNvwE-wtBt&_nc_oc=AdrJuqd77BhixkyA0mAOSHRWKhunYQnjAv8gYXqEUgkfn8YiIrPWjSDJKRDJUK8D7to&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTol9JNySP5CkmJF_pyZaAlFZWFEIYjYAhmu7N8j5nsSg&oe=6B087115"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Note", "keywords": [], "long_description": "The Note App is a simple yet powerful 2D application designed for Meta Quest 2 and 3. It allows users to efficiently manage their notes in a virtual reality environment. Whether you need to jot down ideas, organize tasks, or keep track of important information, this app has you covered.\n\n# Key Features\n- Create Notes Quickly add new notes with a user-friendly interface.\n- Edit Notes: Modify existing notes with ease to keep them up to date.\n- Delete Notes:  Remove notes you no longer need with a simple confirmation dialog.\n- Organized Layout: Notes are displayed in a clean, grid-based layout, optimized for different screen sizes.\n- Customizable Controls: Navigate and interact using intuitive VR controls.\n\nThis app is perfect for anyone looking for a straightforward and reliable way to manage notes in VR. It combines simplicity with functionality, making it an excellent tool for productivity on Meta Quest devices.", "short_description": "2D application for saving notes on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1J1ybmCl2qpScyTaZgPgAwUaEodX1_EuWr9VHsPCsghA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/note-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9014735568626791"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "709634088618799"}, {"status": "PUBLISHED", "id": "1453150569055007"}, {"status": "PUBLISHED", "id": "1029232039273781"}, {"status": "PUBLISHED", "id": "1504390487198336"}, {"status": "PUBLISHED", "id": "973128708364008"}]}, "baseline_offer": {"id": "709634088618799"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752181620, "status": "PUBLISHED", "id": "709634088618799"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9522150354551974", "version": "1.6.1"}, "id": "651842697638598", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
73247_8871354932731974923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l3X2mH6heQQ7kNvwFGT_Zv&_nc_oc=Adrf4zQErSD2bWfR6URGfbgOsdd2rBG392daPVi6ZzBBYXGOx3K8GCGAdtWNT15Rgog&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cPmDPjIPcFd9Hln_pasLFjE_6B7tRBmFN0FUUjQDwoQ&oe=6A1B0B31"}, {"file_name": "Polysketch Screenshots - Edit.png", "id": "1531679700583358", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982512_1531679710583357_3663528235175467094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfvxnhIvm5AQ7kNvwGkYmeP&_nc_oc=AdoLFSTFqk4oIz9cHPJZ6biS2XhfGkghYlCnWL-NxfQvaWOFYsdxeTu22WbarHiqOtE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dHzq6mDNzPDRLVsnmnaAaXtf2NYfKaW7FHbfubcI1kA&oe=6A1B062F"}, {"file_name": "Polysketch Screenshots - Colorize.png", "id": "5437871999636851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974748_5437872006303517_5435343237805984602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXdgHdJRaeYQ7kNvwF58umc&_nc_oc=AdqaBp9vlrnAwfyURfW1saTwtrXnPIju4I-4X37uuyaGp_1YNSG2gF04JuRYFHStbYw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nU30P_gImQ7dlQ_8Y6mmpjCuhmgv3yZ3iYdDT2S3H3w&oe=6A1AD67E"}, {"file_name": "Polysketch Screenshots - Export and Wireframe.png", "id": "691801208543813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348043_691801211877146_8980522485993272973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTd1-G5xkPcQ7kNvwG6-Bh4&_nc_oc=AdrcfohAOvZwPFeDfpt--E3nuX5XjoI8feVyyNs8RLaSObtmfBasugcZMX--Xvk_Fpk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wpe8pwdBlRWdyHrJJjhUuKeMbjJb-5bhqHP-AX_JuAw&oe=6A1ADD3A"}, {"file_name": "Polysketch Screenshots - Start.png", "id": "1111011563089422", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57575358_1111011569756088_3357208964593484758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrdKRRixVQoQ7kNvwECduLE&_nc_oc=Adp4Yblxm9XOwkQZVeBcXmNH4gpqC-7Bzd4okOIUaMQTzoWPqxSXp1KtG0sYFJoejwA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cF2RoVmODvWrUL_s_DXXdzlZaJARoGY1syN0Shr9Lvg&oe=6A1AF9F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1321779348663005", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974766_1321779351996338_5834683936165510706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dy5gTggXwboQ7kNvwHdqXCH&_nc_oc=AdrgppQJ8GJMan4vEWDqm13fEwHEXf3Ya5bypfwK_izGPzcim_DSQ8CppC6mHrIe-0w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lsoIBYMJXX0dlM7yOJDkTBz92GlCSAQWWSEoxu2DOqg&oe=6A1AEE2B"}, "display_name": "Polysketch", "keywords": [], "long_description": "# Creativity for All\n\nUniquely simple and fun 3D creation! Sketch out shapes, add color and style, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters.\n\n{429633749986119}\n\n# Export and Share\n\n- **Social Creators**, build custom world and avatar art\n- **Game Designers**, sketch levels and prototype objects quickly\n- **3D Artists**, enjoy as a truly awesome retopo tool\n- **Concept Artists**, screenshot your creations for easy paint-overs\n\n# Features\n\n- Simple, intuitive \"sketch\" 3D modeling. Just sketch the lines, connect to form surfaces. No \"relative space axis constraint gizmo handles\" mumbo-jumbo here.\n- Import 3D models and images for reference\n- Export specific objects, or the entire scene, for use with just about any other app (Blender, Unity, Unreal, Roblox, VR Chat, etc)\n- Multiplayer (Alpha) - bring friends into your creations, live!\n\n# Community\n\nJoin any of our communities to discuss new features, share your creations, and get inspired.\n", "short_description": "Uniquely simple and fun 3D creation! Sketch out shapes, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polysketchvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Polysketch", "support_website_url": null, "website_url": "https://www.polysketchvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25855734447345081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974485_944061617411041_3799735465128719340_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqdObclcoGkQ7kNvwEHdLvm&_nc_oc=AdqJ3Ie1QcNMUWTbOdEWg-ztvFsf1A04zICx1gjXKIWntXGQVQAT2DB_ZdDJ8-aXff4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43EP0L2cnuA0rX-aIDFb49yBe72JGEZbj47nsPdxVIVg&oe=6A1AFDCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Polysketch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1653413303, "lastRevision": {"nodes": [{"id": "5349380611761571", "release_type": "SCHEDULED", "administration_status": "APP
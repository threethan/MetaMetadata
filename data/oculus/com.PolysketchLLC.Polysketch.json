73247_8871354932731974923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_DlGWOJcjQQ7kNvwFK1_n5&_nc_oc=AdoGT8Ko8qNWF2zmfrK2AMeQptFn0IeiiUkkPyvz587znDnde1aVcZZdEfvOsqBUPBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77pIyEXlCxthxKeXg01iXAxYXH0jhvfx3NTI-QfFNPBQ&oe=6A089631"}, {"file_name": "Polysketch Screenshots - Edit.png", "id": "1531679700583358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1531679710583357_3663528235175467094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shWlD4E3NrQQ7kNvwEfoPLx&_nc_oc=AdrjCkt6MRbufpK-LuLAWbe5jvpNS40uZw7ZjXGRbb7MKRPU2oiJNW_-Lj9SZFsUWjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kSFaTPOdCuOaWMUDb8n53WuTmyBJ1RFbCEsQ17MN4jQ&oe=6A08912F"}, {"file_name": "Polysketch Screenshots - Colorize.png", "id": "5437871999636851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_5437872006303517_5435343237805984602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhZUFGoE0qUQ7kNvwFVV54J&_nc_oc=AdpK_fxzUkTLmTIr0MDVr_Ovl05aWIGhlEnU0Oh_LChA-CibRn5kU86J1k-Q23ejGcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YDfDp1WQfFeQ7GRQbAH5wdTzw1nq74yCOK0WduWB7Ug&oe=6A08617E"}, {"file_name": "Polysketch Screenshots - Export and Wireframe.png", "id": "691801208543813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348043_691801211877146_8980522485993272973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtQYQ5vSE-MQ7kNvwGwiF7T&_nc_oc=Adr-box8xY9Js3WU5wnih_D_lq01kzPdkfZEdKal91owaXqEzIB_D4x5EzLsMRh91SM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vyjI2BHdKJbdL9v1tO_GuuJ0yapwrMp17lyj32T8jzg&oe=6A08683A"}, {"file_name": "Polysketch Screenshots - Start.png", "id": "1111011563089422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575358_1111011569756088_3357208964593484758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhAcrIxWqlMQ7kNvwFJmDBG&_nc_oc=AdozO--1D1Zyy1HWp_6iLKb74a0_ZK4bMKQpmjnIaJhCoiS-6pKS-Uu9baD092YaqYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42J-druSSoDGI-GIeH81qeA4jkZTyknTMViHQHHD5Zhw&oe=6A0884F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1321779348663005", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_1321779351996338_5834683936165510706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BknzC7KsS-UQ7kNvwEuwBjt&_nc_oc=Adq0yVRcF-w4tJurvNABlRxZaL6kqQV0Ec1PJtDfy5-qbw0wnMSmYBL7cjj6n6mBUB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lache6JIQ-lyngeaQtAGOV1_Pfn1dmxd8qqLzy_oxmQ&oe=6A08792B"}, "display_name": "Polysketch", "keywords": [], "long_description": "# Creativity for All\n\nUniquely simple and fun 3D creation! Sketch out shapes, add color and style, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters.\n\n{429633749986119}\n\n# Export and Share\n\n- **Social Creators**, build custom world and avatar art\n- **Game Designers**, sketch levels and prototype objects quickly\n- **3D Artists**, enjoy as a truly awesome retopo tool\n- **Concept Artists**, screenshot your creations for easy paint-overs\n\n# Features\n\n- Simple, intuitive \"sketch\" 3D modeling. Just sketch the lines, connect to form surfaces. No \"relative space axis constraint gizmo handles\" mumbo-jumbo here.\n- Import 3D models and images for reference\n- Export specific objects, or the entire scene, for use with just about any other app (Blender, Unity, Unreal, Roblox, VR Chat, etc)\n- Multiplayer (Alpha) - bring friends into your creations, live!\n\n# Community\n\nJoin any of our communities to discuss new features, share your creations, and get inspired.\n", "short_description": "Uniquely simple and fun 3D creation! Sketch out shapes, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polysketchvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Polysketch", "support_website_url": null, "website_url": "https://www.polysketchvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25855734447345081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974485_944061617411041_3799735465128719340_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHVH_sB_vgMQ7kNvwEKIJEY&_nc_oc=AdppKx-Z6aN3VGQwH1pN2Q9OWe4XaOsI5vp9SRsNNaBaqq3CWa1sPTWv2VVH5gObK0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7idDXsjLGYbm5viqtCFJzTQ9qnzpHwFQBFAaF0EpXC5w&oe=6A0888CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Polysketch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1653413303, "lastRevision": {"nodes": [{"id": "5349380611761571", "release_type": "SCHEDULED", "administration_status": "APP
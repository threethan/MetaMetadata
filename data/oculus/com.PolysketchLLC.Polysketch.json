73247_8871354932731974923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMugUT7zITUQ7kNvwEN6r_5&_nc_oc=AdqgI5BOtnWTMGRSzhWs1fxzXTPLX3uCfAURvRrFDjsnsZKOzDj5rk4g6690iIIYY5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Rsr_vBv5XYeYh1v6_ikIj9osV2YEoqCiLkJPXEb39g&oe=6A689B71"}, {"file_name": "Polysketch Screenshots - Edit.png", "id": "1531679700583358", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982512_1531679710583357_3663528235175467094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ojseUcITyoQ7kNvwHRPkaW&_nc_oc=AdpqbZUbF5Es_132-rRLO1d3tpndfbKbBR4QGtnwMLIyMYzposBJjPf4KKq6C-TCidw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA09N-bbsDh-834lapPGfGSvdxsmdccO2slSDXpNghvqQ&oe=6A68966F"}, {"file_name": "Polysketch Screenshots - Colorize.png", "id": "5437871999636851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974748_5437872006303517_5435343237805984602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F589gLoNGHAQ7kNvwEANnNC&_nc_oc=AdpZbjIj4ix9idKj0eXirIO_zGz_b4x1-zNFQMsDzvbuxyqFkmeT4UYhbHw26899ZWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWZLCiM0RQU71w1LeaZcXZ_Nv2rm3fgpfV4ZvfskmG_g&oe=6A689EFE"}, {"file_name": "Polysketch Screenshots - Export and Wireframe.png", "id": "691801208543813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75348043_691801211877146_8980522485993272973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tN5kUXalCm4Q7kNvwG_a1Ea&_nc_oc=AdoNlMw6BLqP6jzWcXTysV6zK9aoFEV3VLnLWSNrS1WIo88Ya1CakR1KIeaSGxPqHf4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnan_zb7aidGAwHALd_p7uUBTRuBJLiG5NbHoDgPNzhQ&oe=6A68A5BA"}, {"file_name": "Polysketch Screenshots - Start.png", "id": "1111011563089422", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57575358_1111011569756088_3357208964593484758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbUiagRBWFsQ7kNvwGo4_ks&_nc_oc=AdoaZmmA5cIQZoBZzZGbjCEr7SkquYw3OZRBngEqtTJcOddK33bMJGC3TkPHz4sHv0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBntzg8L06Gw-D8LZLOQYYAQiymFU2yCPQVWV4vTbMv4Q&oe=6A68C276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1321779348663005", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974766_1321779351996338_5834683936165510706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaVkTAY5Zm8Q7kNvwGUFnJA&_nc_oc=AdqgizO_oolKQLDHvKqm7qIi3L1XO0gc_F71fyC1PjRv_Zl--ZBv2WlnyiZBxy4mGyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1juhGLn6m18bBuUvNFU-thKSzAzx_bsGaI0gg7IvFPg&oe=6A68B6AB"}, "display_name": "Polysketch", "keywords": [], "long_description": "# Creativity for All\n\nUniquely simple and fun 3D creation! Sketch out shapes, add color and style, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters.\n\n{429633749986119}\n\n# Export and Share\n\n- **Social Creators**, build custom world and avatar art\n- **Game Designers**, sketch levels and prototype objects quickly\n- **3D Artists**, enjoy as a truly awesome retopo tool\n- **Concept Artists**, screenshot your creations for easy paint-overs\n\n# Features\n\n- Simple, intuitive \"sketch\" 3D modeling. Just sketch the lines, connect to form surfaces. No \"relative space axis constraint gizmo handles\" mumbo-jumbo here.\n- Import 3D models and images for reference\n- Export specific objects, or the entire scene, for use with just about any other app (Blender, Unity, Unreal, Roblox, VR Chat, etc)\n- Multiplayer (Alpha) - bring friends into your creations, live!\n\n# Community\n\nJoin any of our communities to discuss new features, share your creations, and get inspired.\n", "short_description": "Uniquely simple and fun 3D creation! Sketch out shapes, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polysketchvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Polysketch", "support_website_url": null, "website_url": "https://www.polysketchvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25855734447345081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974485_944061617411041_3799735465128719340_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyWlV86frVwQ7kNvwGiDg14&_nc_oc=AdqTAwOfIeLNrVnnJizMi2_USJ1O1Y6X9AuvdIDZKQDj_NOyCBsNd7ccCbqBB31dUsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjJTEkBfnTjGEPNjw-KVyTbnzBx7u94B1rb-HG-uR4Ig&oe=6A68C64F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Polysketch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1653413303, "lastRevision": {"nodes": [{"id": "5349380611761571", "release_type": "SCHEDULED", "administration_status": "APP
xDtPJgIQLAT5OzG2HZ6zBd1U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eTYSZaCcCDKuQ_MFlPnimsjpHwu3cIYLAgG5FSoSO4g&oe=6A09D676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1321779348663005", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974766_1321779351996338_5834683936165510706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2lR6mC0ctEQ7kNvwGu0rLg&_nc_oc=AdpaLowCSVdtxTaoMS0pSFTpuyfKuLdjsbWQFaduR-d43zAJm7EjMpfJiYQ4LXWQlv0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71KHLvMYEx4_uZkx4fcX4-n6jJgJSv8OOixGodZKODYg&oe=6A09CAAB"}, "display_name": "Polysketch", "keywords": [], "long_description": "# Creativity for All\n\nUniquely simple and fun 3D creation! Sketch out shapes, add color and style, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters.\n\n{429633749986119}\n\n# Export and Share\n\n- **Social Creators**, build custom world and avatar art\n- **Game Designers**, sketch levels and prototype objects quickly\n- **3D Artists**, enjoy as a truly awesome retopo tool\n- **Concept Artists**, screenshot your creations for easy paint-overs\n\n# Features\n\n- Simple, intuitive \"sketch\" 3D modeling. Just sketch the lines, connect to form surfaces. No \"relative space axis constraint gizmo handles\" mumbo-jumbo here.\n- Import 3D models and images for reference\n- Export specific objects, or the entire scene, for use with just about any other app (Blender, Unity, Unreal, Roblox, VR Chat, etc)\n- Multiplayer (Alpha) - bring friends into your creations, live!\n\n# Community\n\nJoin any of our communities to discuss new features, share your creations, and get inspired.\n", "short_description": "Uniquely simple and fun 3D creation! Sketch out shapes, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polysketchvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Polysketch", "support_website_url": null, "website_url": "https://www.polysketchvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25855734447345081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974485_944061617411041_3799735465128719340_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHVH_sB_vgMQ7kNvwH7FJ08&_nc_oc=AdppUb-_hfH7V48poIO53Pw18tkiFCrJqwp2rfJVRcAZknjAlJvCFcMJZdiGSUHkgIc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RsTEENXc_y6KM5vFUKSQbxlAaAxF8XQljswsUg3mn3Q&oe=6A09DA4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Polysketch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1653413303, "lastRevision": {"nodes": [{"id": "5349380611761571", "release_type": "SCHEDULED", "administration_status": "APP
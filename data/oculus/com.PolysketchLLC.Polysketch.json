7660138673247_8871354932731974923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z65Fi63bG0Q7kNvwH97m6t&_nc_oc=AdrUeN7RcMsH3DAcc7UvzDiFVXDRriMf93jydO6f-UD02Y9WV8dfZLEA84o1aZwxx4I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmTSjPoJ2J7Rw6IisrwBwlm1mqpuLAl-on742irVrpPA&oe=6A8ED6F1"}, {"file_name": "Polysketch Screenshots - Edit.png", "id": "1531679700583358", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982512_1531679710583357_3663528235175467094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt3miPqtgfQQ7kNvwEz8OjS&_nc_oc=AdpSmg9tNZbx-la8AYTzYyzV80aSHkbPkWPUnmvH7GjlbPaL-qbeoPxDnCyGvtupQuA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpr1GGfRQgoZgs9LKFgOG9Ou73qxjL_Fr_uSAuHCgpEQ&oe=6A8ED1EF"}, {"file_name": "Polysketch Screenshots - Colorize.png", "id": "5437871999636851", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974748_5437872006303517_5435343237805984602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMnk7mqeAH0Q7kNvwFYEgzo&_nc_oc=AdpOmTpY8gFM4xwDeVyZKK6aAoJ3P2nsTwcsRYv8pegEkmj77-26-2KDLjIHYrQoW5A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH62r09Hzg1eQWRFUEjEFPZr5RVuDKd1OO_k7aW1GHy2g&oe=6A8EDA7E"}, {"file_name": "Polysketch Screenshots - Export and Wireframe.png", "id": "691801208543813", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75348043_691801211877146_8980522485993272973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnBw8Nb8A1YQ7kNvwGph6nV&_nc_oc=Ado4tGyLMJ-ZNf9xKzMIgLMg7GQo6idPw0_Jh5TA8sX4UdQKt37TLUW5433zYH7_3rg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIOaILWgDbR28Ecc-1Ea4krkf_0Ebl7QHRmTqAK10jLA&oe=6A8EE13A"}, {"file_name": "Polysketch Screenshots - Start.png", "id": "1111011563089422", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57575358_1111011569756088_3357208964593484758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozd9DefT7J8Q7kNvwFrhpn6&_nc_oc=AdrV3mbPXle1Fxj5OeAV6ZIoPsIz2sTU0Qm34kpK93-b5uUhKJrUCUm75k40fl45QnQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWTsuvv4pV6nSiK-OmVO_CP-d7xjKEZXTaLhu3ZZbW4Q&oe=6A8EC5B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1321779348663005", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974766_1321779351996338_5834683936165510706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLQG8MhQgg8Q7kNvwHPoh2q&_nc_oc=AdoH4gTycdpyKqMX_liGCT1iJPPLseQNpCRebpDf6jBIId36mHJMj1wMb6TXoEwtKcM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9Ljw2vaQyRtjdL5lqig9gDsk6YGJZdZcRo6rhdkJLVA&oe=6A8EF22B"}, "display_name": "Polysketch", "keywords": [], "long_description": "# Creativity for All\n\nUniquely simple and fun 3D creation! Sketch out shapes, add color and style, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters.\n\n{429633749986119}\n\n# Export and Share\n\n- **Social Creators**, build custom world and avatar art\n- **Game Designers**, sketch levels and prototype objects quickly\n- **3D Artists**, enjoy as a truly awesome retopo tool\n- **Concept Artists**, screenshot your creations for easy paint-overs\n\n# Features\n\n- Simple, intuitive \"sketch\" 3D modeling. Just sketch the lines, connect to form surfaces. No \"relative space axis constraint gizmo handles\" mumbo-jumbo here.\n- Import 3D models and images for reference\n- Export specific objects, or the entire scene, for use with just about any other app (Blender, Unity, Unreal, Roblox, VR Chat, etc)\n- Multiplayer (Alpha) - bring friends into your creations, live!\n\n# Community\n\nJoin any of our communities to discuss new features, share your creations, and get inspired.\n", "short_description": "Uniquely simple and fun 3D creation! Sketch out shapes, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polysketchvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Polysketch", "support_website_url": null, "website_url": "https://www.polysketchvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25855734447345081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974485_944061617411041_3799735465128719340_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKw0wqUxmHoQ7kNvwH0irJC&_nc_oc=AdoN7nuMnAZvgzkuB_1Suv5N-UX1hgV6EcNe4_dCM44v3WpBokb1HlRgyfk7m_R2KGk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhasS2LVAn8xv_EyMgmdSvlXxFWUzEDq7xNC6_6KjDrg&oe=6A8EC98F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Polysketch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1653413303, "lastRevision": {"nodes": [{"id": "5349380611761571", "release_type": "SCHEDULED", "administ
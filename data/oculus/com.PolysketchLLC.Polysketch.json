73247_8871354932731974923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niATxQj9Zk0Q7kNvwH5HuvB&_nc_oc=AdoI11r4IEAyiLhqDCXM06jg490GAbCDoFs7GHwclyGaNNb0Mi88AJUvcWGAdBsFUOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rrjEtE-SKk8D0vxJ7JkQXVw_ayPsG0A_0_KYMK7W8Dg&oe=69EA0B71"}, {"file_name": "Polysketch Screenshots - Edit.png", "id": "1531679700583358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_1531679710583357_3663528235175467094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv64LbPiZmMQ7kNvwHPiK22&_nc_oc=AdqB4k74KrtLZ9KfVrr96tvpaeuc9A2Uabf29hcbs3iG8togntMFauAgmQI2adoBNZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20Pe6oIJZsU0rEkDsN5pgArl5QqGMEwKW6KN5v8_wqSw&oe=69EA066F"}, {"file_name": "Polysketch Screenshots - Colorize.png", "id": "5437871999636851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974748_5437872006303517_5435343237805984602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UBgvsbOO9IQ7kNvwHvW3em&_nc_oc=AdqTKoj9PdG6lHb1jUSm-M1yUh-EwUd30DVcezLLUIapZmL6DJfItYYzob2OZhfR3lU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0icgopj96s_IdcbP7x-hnOVTVtqWJAugb7tHnQJwQBbw&oe=69EA0EFE"}, {"file_name": "Polysketch Screenshots - Export and Wireframe.png", "id": "691801208543813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348043_691801211877146_8980522485993272973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg_8ZkCwC7IQ7kNvwHZBqJF&_nc_oc=AdoGJpxkhoKt4YYTit0V8tmEbLbrbDJ6iKlk6LuweZUzjC_LtvYYO0F9I7RllmqoEak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C5yfDdyyHIk0R2ifJfhHp4wNTmwGz6vNBipUX5_wY3A&oe=69EA15BA"}, {"file_name": "Polysketch Screenshots - Start.png", "id": "1111011563089422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575358_1111011569756088_3357208964593484758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PddY7o8g1QgQ7kNvwEQUVTQ&_nc_oc=AdrWOzEOuWfMfyah8hpWPklx5OyWoeFh-ohe1-G9FaQhV7C2Hc8JxDOEyZS4cxwiFEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cGGXYRIe5aEk7OrsHjHUpEqpVzUHzndarWd-eA3UOTw&oe=69EA3276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1321779348663005", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_1321779351996338_5834683936165510706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPiG1G-sxSoQ7kNvwEpIEjM&_nc_oc=AdqGx3ASldjbYdWEMK-VY_mT6dWW6wlcmP-s7-xgaf4_zd4GnMFQjkUbSbC3mhiK57k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Pd1janmiDmDbfnKkqhE5vitKFi09rc4mAv_F8fV5fFA&oe=69EA26AB"}, "display_name": "Polysketch", "keywords": [], "long_description": "# Creativity for All\n\nUniquely simple and fun 3D creation! Sketch out shapes, add color and style, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters.\n\n{429633749986119}\n\n# Export and Share\n\n- **Social Creators**, build custom world and avatar art\n- **Game Designers**, sketch levels and prototype objects quickly\n- **3D Artists**, enjoy as a truly awesome retopo tool\n- **Concept Artists**, screenshot your creations for easy paint-overs\n\n# Features\n\n- Simple, intuitive \"sketch\" 3D modeling. Just sketch the lines, connect to form surfaces. No \"relative space axis constraint gizmo handles\" mumbo-jumbo here.\n- Import 3D models and images for reference\n- Export specific objects, or the entire scene, for use with just about any other app (Blender, Unity, Unreal, Roblox, VR Chat, etc)\n- Multiplayer (Alpha) - bring friends into your creations, live!\n\n# Community\n\nJoin any of our communities to discuss new features, share your creations, and get inspired.\n", "short_description": "Uniquely simple and fun 3D creation! Sketch out shapes, then export for game engines, 3D printing, social apps, or just for show. You'll be amazed how easily you can create truly original worlds, objects, and even characters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polysketchvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Polysketch", "support_website_url": null, "website_url": "https://www.polysketchvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25855734447345081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974485_944061617411041_3799735465128719340_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaYDuHQ_rpcQ7kNvwFDHvvu&_nc_oc=AdoNV4Gt67ZfPn3MXdMs-YrDxSv7lQvpNou9WHc6X5Vxs7AdI5U3i4hWkIl2k3T7Tqc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Q8bVx8lkvpuEPra-zyAPSAFONdRshK4SYLkL_XuLpw&oe=69EA364F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Polysketch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1653413303, "lastRevision": {"nodes": [{"id": "5349380611761571", "release_type": "SCHEDULED", "administration_status": "APP
c_ss=7f20f&oh=00_AQTB0qmUGXuKftkbgXU-kOHGkN4BWlFqktEa5evxQA7u6Q&oe=6B0712D4"}, {"file_name": "IMG_20250817_101013_2560_1440.png", "id": "783861691354896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_783861694688229_6658791601117731860_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDnmA1OOxucQ7kNvwF2fazL&_nc_oc=Adp-uyGOidW-6Y5UC8_DUApxj1rY1QTijhEKDsnrUVGtIH1JmZZco8J7E3FaEkjUe1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTj424Z24urwbx4jHF6B7QF7TzAz4VDvK9sWjD-yz6PA&oe=6B072769"}, {"file_name": "The_Nix_2560_1440.png", "id": "1820520415245655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1820520418578988_6935651680506316055_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSAlp03fmd0Q7kNvwHuwTSS&_nc_oc=AdpxbHGSKwg-Doxxor6DRVMbYg42jsSe7dOcrbFUK6Bz569tLsjaYNkk_NwvSOrVQS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTzqexu2rDqxzxgD73qApS07aaBvs8pSngm6_eP5X4Kg&oe=6B072130"}, {"file_name": "Madeira_Janela_2560_1440.png", "id": "784029654661986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_784029657995319_2597145200685558811_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Cuxg6BJTPQQ7kNvwE7zzkR&_nc_oc=AdprlTh-9OomDCLS0N7otvsoPkpQMmlekbJ3LFII5ed0iTg7dTyzUkcJjnYU53dgbg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxUaXyb1HoVm_4AVraVOQHHtswNHAvDdbCUk2MOeGVVQ&oe=6B06F1A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visit World", "keywords": ["travel", "exploration", "visit", "explore", "nature"], "long_description": "# Visit World\n\nExperience the beauty of five breathtaking destinations in one immersive VR app. \n\nVisit World is a **free** demo featuring handpicked 360-degree 3D videos from **Alaska, Madeira, Faroe Islands, Azores, and North Spain** showcasing some of the most stunning locations from each region.\n{873786671652318}\n# Key Features\n**Immersive 360-Degree 3D Videos** - Explore each destination as if you're truly there, with the freedom to look around in every direction and take in the full panoramic beauty of nature's wonders.\n\n{2020664361843389}\n**Spatial Audio & Multilingual Narration** - Enjoy realistic spatial sounds of nature that respond to your movements, accompanied by professional narrative voice-overs available in multiple languages for a personalized experience.\n{5122999327925622}\n**Accessible for Everyone** - Designed with accessibility in mind, Visit World is perfect for elderly users and those in wheelchairs. The intuitive interface ensures everyone can enjoy these virtual journeys comfortably.\n{691130093785823}\n**Auto-Move Function** - Sit back and relax with the automatic navigation feature that seamlessly guides you through all the locations without needing to use a controller\u2014perfect for a hands-free, effortless exploration.\n{863655036351636}\nVisit World offers a taste of the 5 full commercial VR travel apps, giving you the opportunity to preview stunning destinations before diving into the complete experiences. \n{1900651413864393}\nWhether you're dreaming of glaciers, ancient forests, dramatic cliffs, volcanic lakes, or coastal vistas, this free demo brings the world to you.\n\n\n\n\n\n\n", "short_description": "The \"Visit World\" app is a free demo VR experience featuring example 360-degree 3D videos from five apps called Visit Alaska, Visit Madeira, Visit Faroe Islands, Visit Azores, and Visit North Spain. \n\nFrom each of these regions, users can enjoy a few handpicked immersive videos, showcasing the most beautiful and iconic locations within each destination.\n\nAll videos were filmed with a professional 360\u00b0 3D camera, nothing is generated. The user can get this way the feeling of each of the apps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://npsoftware.at/visit_world/PrivacyPolicyVisitWorld_2025_11_26.html", "developer_terms_of_service_url": "https://npsoftware.at/visit_world/TermsAndConditionsVisitWorld.html", "publisher_name": "NP Software", "support_website_url": null, "website_url": "https://www.npsoftware.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25090608990568391"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "747074307643410"}]}, "baseline_offer": {"id": "747074307643410"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764592500, "status": "PUBLISHED", "id": "747074307643410"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25075961008699856", "version": "0.01"}, "id": "4010352179109022", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24958362107126414", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25075961008699856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4010352179109022"}]}, "change_log": null, "created_date": 1764178799, "id": "25075961008699856", "version": "0.01", "version_code": 1, "release_stat
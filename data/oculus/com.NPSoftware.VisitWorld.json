0.png", "id": "774852942235723", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823930_774852945569056_8387427753206330358_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAH2gmYfL7sQ7kNvwFnSIeb&_nc_oc=AdocoVJFnu_brENyl_6MC89nS0p_h7JWNb3Fi86pAKiMdWZSWyS20sEG4X5G7lNLJ74&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGkJdHD7InGw6X4E8x8k-cnL9gRPF6cOtr0YK1Tvs5Fw&oe=6A8D951A"}, {"file_name": "M_do_Ilheu_de_Rosto_de_Cao.png", "id": "691130093785823", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823447_691130097119156_756905241756585416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87R7YN-KZZAQ7kNvwECwrCy&_nc_oc=AdoXYov9NvA0Vt9n4CJo1tTr-gJ2YmriwkgG1UJuWiooOCgvoO0FJNCM5ZjVybqI9uY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdtEJg-ca2uvFvVzknb_tSjlv5sll-G-4fzuV_ScsVrA&oe=6A8D6878"}]}, "id": "1376959000878601", "locale": "en_US", "screenshots": [{"file_name": "world_ui.png", "id": "4226107070998810", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821115_4226107077665476_2494054412883516015_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjUgfMfm4C4Q7kNvwGNvnqe&_nc_oc=AdoXd0U9MGXgNgqstcesRYqPEP_oxmub-F9MuVhBwczja1pPuyMXi_B0UOJHjg8YL7M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-9Uhndh8yAiMgiuL6ArAIXg8VHgjs5bj2ikM-cNVyNA&oe=6A8D9D43"}, {"file_name": "IMG_20250820_101215_2560_1440.png", "id": "1112655657416839", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819281_1112655660750172_9039153198113001216_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKDldmHQ5-oQ7kNvwFGfHC0&_nc_oc=AdrJ4VBDWV2uoODh-jL5bcKHRWX-dQHXYMlXcWCWE5euIMlsNRzneXBMs_yOMXRmhY8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7-jeB84leISdR2snRumwQJ-8FELuvDAb1YtomltNK3A&oe=6A8D9094"}, {"file_name": "IMG_20250817_101013_2560_1440.png", "id": "783861691354896", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491818890_783861694688229_6658791601117731860_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAcr36YwzhQQ7kNvwHyPByL&_nc_oc=AdokmiFtcZnt3cffuZCVMmSNesPqosfegSdZPy4prn6Vkohd2fUrkGPVgGD6Ej_shHs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPrYTnrXm9C3iYFJOxLxyH_0FyJlVWBALS0gQ_BVANIw&oe=6A8D6CE9"}, {"file_name": "The_Nix_2560_1440.png", "id": "1820520415245655", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821099_1820520418578988_6935651680506316055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbI39wcJ7osQ7kNvwELcCCw&_nc_oc=AdrD1_Brzk7tIt4SV54lkbgpmwKWH3Swg6BoV-2A8wPBjRdA8eKtq_LgIdF66wNuEXU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF082ZU-YYjODbhW8bIVD6RfuWXcAy-w0yONExOpcStQ&oe=6A8D66B0"}, {"file_name": "Madeira_Janela_2560_1440.png", "id": "784029654661986", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818890_784029657995319_2597145200685558811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ6r9-wELrUQ7kNvwFULKxo&_nc_oc=AdrWe1MhuMaycY2e4Wj5clVxzedrVUKBNZPoJn9OUWH8lDqRoFqtOPCXqN6QFfNVGyw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqrceT-iA1C1D240iiI2n-iAANqrcafq9TCCxNoONsrQ&oe=6A8D6F66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visit World", "keywords": ["travel", "exploration", "visit", "explore", "nature"], "long_description": "# Visit World\n\nExperience the beauty of five breathtaking destinations in one immersive VR app. \n\nVisit World is a **free** demo featuring handpicked 360-degree 3D videos from **Alaska, Madeira, Faroe Islands, Azores, and North Spain** showcasing some of the most stunning locations from each region.\n{873786671652318}\n# Key Features\n**Immersive 360-Degree 3D Videos** - Explore each destination as if you're truly there, with the freedom to look around in every direction and take in the full panoramic beauty of nature's wonders.\n\n{2020664361843389}\n**Spatial Audio & Multilingual Narration** - Enjoy realistic spatial sounds of nature that respond to your movements, accompanied by professional narrative voice-overs available in multiple languages for a personalized experience.\n{5122999327925622}\n**Accessible for Everyone** - Designed with accessibility in mind, Visit World is perfect for elderly users and those in wheelchairs. The intuitive interface ensures everyone can enjoy these virtual journeys comfortably.\n{691130093785823}\n**Auto-Move Function** - Sit back and relax with the automatic navigation feature that seamlessly guides you through all the locations without needing to use a controller\u2014perfect for a hands-free, effortless exploration.\n{863655036351636}\nVisit World offers a taste of the 5 full commercial VR travel apps, giving you the opportunity to preview stunning destinations before diving into the complete experiences. \n{1900651413864393}\nWhether you're dreaming of glaciers, ancient forests, dramatic cliffs, volcanic lakes, or coastal vistas, this free demo brings the world to you.\n\n\n\n\n\n\n", "short_description": "The \"Visit World\" app is a free demo VR experience featuring example 360-degree 3D videos from five apps called Visit Alaska, Visit Madeira, Visit Faroe Islands, Visit Azores, and Visit North Spain. \n\nFrom each of these regions, users can enjoy a few handpicked immersive videos, showcasing the most beautiful and iconic locations within each destination.\n\nAll videos were filmed with a professional 360\u00b0 3D camera, nothing is generated. The user can get this way the feeling of each of the apps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://npsoftware.at/visit_world/PrivacyPolicyVisitWorld_2025_11_26.html", "developer_terms_of_service_url": "https://npsoftware.at/visit_world/TermsAndConditionsVisitWorld.html", "publisher_name": "NP Software", "support_website_url": null, "website_url": "https://www.npsoftware.at/", "category": nu
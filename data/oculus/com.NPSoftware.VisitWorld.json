2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CYni9z1THFdjlmD4G_lkK6Hj5ko2GcUgd8JGHAFZTeg&oe=6A3155F0"}, {"file_name": "Madeira_Janela_2560_1440.png", "id": "784029654661986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_784029657995319_2597145200685558811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMTK5WZeUW8Q7kNvwEQH532&_nc_oc=AdrvXzM1X61XY-14rd12w2ebD407eisT3J-u81uwr8G1bc8G8GN2zAffDQxxpP2e48Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i30fwX33QPEM7bUMR-0sCsZDpF7RFtPUwgrKRCC0Ijg&oe=6A315EA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visit World", "keywords": ["travel", "exploration", "visit", "explore", "nature"], "long_description": "# Visit World\n\nExperience the beauty of five breathtaking destinations in one immersive VR app. \n\nVisit World is a **free** demo featuring handpicked 360-degree 3D videos from **Alaska, Madeira, Faroe Islands, Azores, and North Spain** showcasing some of the most stunning locations from each region.\n{873786671652318}\n# Key Features\n**Immersive 360-Degree 3D Videos** - Explore each destination as if you're truly there, with the freedom to look around in every direction and take in the full panoramic beauty of nature's wonders.\n\n{2020664361843389}\n**Spatial Audio & Multilingual Narration** - Enjoy realistic spatial sounds of nature that respond to your movements, accompanied by professional narrative voice-overs available in multiple languages for a personalized experience.\n{5122999327925622}\n**Accessible for Everyone** - Designed with accessibility in mind, Visit World is perfect for elderly users and those in wheelchairs. The intuitive interface ensures everyone can enjoy these virtual journeys comfortably.\n{691130093785823}\n**Auto-Move Function** - Sit back and relax with the automatic navigation feature that seamlessly guides you through all the locations without needing to use a controller\u2014perfect for a hands-free, effortless exploration.\n{863655036351636}\nVisit World offers a taste of the 5 full commercial VR travel apps, giving you the opportunity to preview stunning destinations before diving into the complete experiences. \n{1900651413864393}\nWhether you're dreaming of glaciers, ancient forests, dramatic cliffs, volcanic lakes, or coastal vistas, this free demo brings the world to you.\n\n\n\n\n\n\n", "short_description": "The \"Visit World\" app is a free demo VR experience featuring example 360-degree 3D videos from five apps called Visit Alaska, Visit Madeira, Visit Faroe Islands, Visit Azores, and Visit North Spain. \n\nFrom each of these regions, users can enjoy a few handpicked immersive videos, showcasing the most beautiful and iconic locations within each destination.\n\nAll videos were filmed with a professional 360\u00b0 3D camera, nothing is generated. The user can get this way the feeling of each of the apps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://npsoftware.at/visit_world/PrivacyPolicyVisitWorld_2025_11_26.html", "developer_terms_of_service_url": "https://npsoftware.at/visit_world/TermsAndConditionsVisitWorld.html", "publisher_name": "NP Software", "support_website_url": null, "website_url": "https://www.npsoftware.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25090608990568391"}}]}, "scheduled_offer
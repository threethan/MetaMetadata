1821115_4226107077665476_2494054412883516015_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6XMgRFUvokQ7kNvwGzGFal&_nc_oc=AdnWTbRjj0zI6fGZ9-7V6BlrZyBhkeD30RQpK-cMVDNBVHZ34ikYV45CCNEEr1CZOdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvTL8CbZCpqHQPI3_0LphDaV9-a99XhEzXHg4khgDvcAA&oe=699EFDC3"}, {"file_name": "IMG_20250820_101215_2560_1440.png", "id": "1112655657416839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1112655660750172_9039153198113001216_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=768AUCsqmKYQ7kNvwFbI3Cq&_nc_oc=AdlEa1siJ51h6d6WHYOZOrNI49lm8mTE_gp-SOYw2eFEeMo-eJws_z2LzPbiA29ZLRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZgawflJB9U8Bv-wkf_CQqkyXu0NQ4H_4W3ojEJejDpQ&oe=699EF114"}, {"file_name": "IMG_20250817_101013_2560_1440.png", "id": "783861691354896", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_783861694688229_6658791601117731860_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZcxCni1byYQ7kNvwFZElsz&_nc_oc=AdnLcIkvw-l9ZqnR3wfxHT-lgecaNkBZZtHKVf93OOeTa8Fc_1jR3y40w6fPFizZWCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs8bZdsv75GKssZwlp-ezd2hk4ctdqGDIcJY9TJKozRQg&oe=699F05A9"}, {"file_name": "The_Nix_2560_1440.png", "id": "1820520415245655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1820520418578988_6935651680506316055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyickYoF3dUQ7kNvwHv1XN2&_nc_oc=AdnCSXE-Y35TAvNSLmwiuSZo0BdCOfqs2MAOBRvcrMTmHNCoxYSv4A2Znv269CuNS7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvGuav6Pv1zeykfxU54hEcfxRLrI898zzrhwMx-W5Buvw&oe=699EFF70"}, {"file_name": "Madeira_Janela_2560_1440.png", "id": "784029654661986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_784029657995319_2597145200685558811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuOzqiLtERgQ7kNvwHSNHjg&_nc_oc=AdmWI4Z8k05JFN2zMOljTMq9uoHA87KbNNHMA4Lv8cvFKEz0bBIVhQT_aLz1B_vDyKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfucwT2GPK51zmtjekWwUy10J4E6DrSMAsHFnJrCjXdyeA&oe=699F0826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visit World", "keywords": ["travel", "exploration", "visit", "explore", "nature"], "long_description": "# Visit World\n\nExperience the beauty of five breathtaking destinations in one immersive VR app. \n\nVisit World is a **free** demo featuring handpicked 360-degree 3D videos from **Alaska, Madeira, Faroe Islands, Azores, and North Spain** showcasing some of the most stunning locations from each region.\n{873786671652318}\n# Key Features\n**Immersive 360-Degree 3D Videos** - Explore each destination as if you're truly there, with the freedom to look around in every direction and take in the full panoramic beauty of nature's wonders.\n\n{2020664361843389}\n**Spatial Audio & Multilingual Narration** - Enjoy realistic spatial sounds of nature that respond to your movements, accompanied by professional narrative voice-overs available in multiple languages for a personalized experience.\n{5122999327925622}\n**Accessible for Everyone** - Designed with accessibility in mind, Visit World is perfect for elderly users and those in wheelchairs. The intuitive interface ensures everyone can enjoy these virtual journeys comfortably.\n{691130093785823}\n**Auto-Move Function** - Sit back and relax with the automatic navigation feature that seamlessly guides you through all the locations without needing to use a controller\u2014perfect for a hands-free, effortless exploration.\n{863655036351636}\nVisit World offers a taste of the 5 full commercial VR travel apps, giving you the opportunity to preview stunning destinations before diving into the complete experiences. \n{1900651413864393}\nWhether you're dreaming of glaciers, ancient forests, dramatic cliffs, volcanic lakes, or coastal vistas, this free demo brings the world to you.\n\n\n\n\n\n\n", "short_description": "The \"Visit World\" app is a free demo VR experience featuring example 360-degree 3D videos from five apps called Visit Alaska, Visit Madeira, Visit Faroe Islands, Visit Azores, and Visit North Spain. \n\nFrom each of these regions, users can enjoy a few handpicked immersive videos, showcasing the most beautiful and iconic locations within each destination.\n\nAll videos were filmed with a professional 360\u00b0 3D camera, nothing is generated. The user can get this way the feeling of each of the apps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://npsoftware.at/visit_world/PrivacyPolicyVisitWorld_2025_11_26.html", "developer_terms_of_service_url": "https://npsoftware.at/visit_world/TermsAndConditionsVisitWorld.html", "publisher_name": "NP Software", "support_website_url": null, "website_url": "https://www.npsoftware.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25090608990568391"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "747074307643410"}]}, "baseline_offer": {"id": "747074307643410"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764592500, "status": "PUBLISHED", "id": "747074307643410"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25075961008699856", "version": "0.01"}, "id": "4010352179109022", "channel_name": "LIVE"}]}, "is_for_o
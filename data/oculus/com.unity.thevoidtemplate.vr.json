ri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499300910_1183385743950873_1655641609417565142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJzwf5PSfJUQ7kNvwGARtKX&_nc_oc=AdncTf8e-pnHEJ_cX0hdNX9JdNimoSc8q9jLX-aGGbXtYdUsO8cjVKIAYycYH8QYseA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiUQL99JhiznTImsdKDr8AI9aJqx-5m2o8cZxppjRMhw&oe=69AAC226"}, {"file_name": "LotsOfTrees.png", "id": "1911541266125429", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618069_1911541269458762_1582378898536737820_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZmSz7OLBs0Q7kNvwFhpKUi&_nc_oc=Adm0786Wav9YxH4QOx0wtXaYICV11oU3fNeTphGr9ta9WaAkavO3zwEuTNYXQOk1i5A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGKhuTUvS7PUN62x28H7PgAb2cavrwoMzJim3C2V0aGA&oe=69AAAF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_20260105_181819.png", "id": "852672940898383", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618297_852672947565049_8808248607942532164_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtaYGkve8NwQ7kNvwHznmH3&_nc_oc=AdlVkf5t7ZzcqlPMpcrf-jN77XUeMulL_I94xDHq1bemfUJeAcQeathgSoyX4_pMVwA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUYiRtNGCDK7jS3kJY8279Tq5TEDFJEuVuhRe1rDqVhQ&oe=69AAB9F1"}, "display_name": "Umbrawl", "keywords": ["Spooky", "Fighting", "Shooter", "HandWalking", "Flying"], "long_description": "Umbrawl pits you against other shadow beings in the Umbral Plane. Customize your shadow character, and enter the Umbral Forest to fight other shadow beings and claim the crown. \n\nUtilizes a completely unique hand walking and flying locomotion.\n\n{1431595901973546}\n\nJoin a random lobby, or create a custom lobby to play with friends. Set your custom lobby to \"open\" so random players can join your forest.\n\n{1229153989144929}\n\nButtons:\n- Hold A or X and reach your hands out to fly.\n- Triggers to shoot.\n- Grip button to grab and use menus.\n\n{1410669757181619}\n\nWhy early access?\n\nWe want to test Umbrawl in a real-player setting to make sure there are no unfun bugs. We also want to see your responses and feedback. We do not plan on staying in early access for long.", "short_description": "A spooky fighting game played in a dark and dense forest. Features a one of a kind walking/flying locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soar.game/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soar Explore", "support_website_url": null, "website_url": "https://soar.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25482796764674672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619681_1438272460992652_2971066956153269137_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0igjLKOLjz4Q7kNvwF1dDPi&_nc_oc=AdmRYefGnanUAslrYfvwGoT6JkqnOOhBDn08MePwhHe5d7AsdvQrPK9v2cAb_fTg9co&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7Kt7igaUPTf4tZ6wu-AbNnbJFHQt0Gwwww7Sb-RSJGA&oe=69AAB0E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrawl", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274
55641609417565142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_UFf7X0aZkQ7kNvwGLZ60Q&_nc_oc=AdkKZIOIGLGtNKPcu_Rbdz9U1demCVYIs6IkXek3ga-kWjStiYfB4mkNlMQ0tVtmZPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJNPt0papWEd4f4tiGGrfd00N0Zpbi6qMj0l6znNdnig&oe=69A2D926"}, {"file_name": "LotsOfTrees.png", "id": "1911541266125429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_1911541269458762_1582378898536737820_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwtltHJSktcQ7kNvwEwYTXb&_nc_oc=Adm04nXTdQW4MIOoqKYtI69CtfVwy2si3k8x3RJx9FvsRCxInAQj-rv5ac8jPjLEE2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsj8F55y4hgzuUHh5j3N96gWNriul7xc2dKHFzf_Zl8rw&oe=69A2C66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_20260105_181819.png", "id": "852672940898383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_852672947565049_8808248607942532164_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2hMNLLkSVQQ7kNvwEdv0BS&_nc_oc=AdldseA_79_FPaQSW24hRqJtok_8OSmerTXPvnbnTTvIdMru1QBnGSyNS8T_kMPrlLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftShtpe1Y81LQ-_uNGhm_f82gYC8N97KwUg18OLKWLC4w&oe=69A2D0F1"}, "display_name": "Umbrawl", "keywords": ["Spooky", "Fighting", "Shooter", "HandWalking", "Flying"], "long_description": "Umbrawl pits you against other shadow beings in the Umbral Plane. Customize your shadow character, and enter the Umbral Forest to fight other shadow beings and claim the crown. \n\nUtilizes a completely unique hand walking and flying locomotion.\n\n{1431595901973546}\n\nJoin a random lobby, or create a custom lobby to play with friends. Set your custom lobby to \"open\" so random players can join your forest.\n\n{1229153989144929}\n\nButtons:\n- Hold A or X and reach your hands out to fly.\n- Triggers to shoot.\n- Grip button to grab and use menus.\n\n{1410669757181619}\n\nWhy early access?\n\nWe want to test Umbrawl in a real-player setting to make sure there are no unfun bugs. We also want to see your responses and feedback. We do not plan on staying in early access for long.", "short_description": "A spooky fighting game played in a dark and dense forest. Features a one of a kind walking/flying locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soar.game/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soar Explore", "support_website_url": null, "website_url": "https://soar.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25482796764674672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1438272460992652_2971066956153269137_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1Reo1BriDIQ7kNvwGIYnH7&_nc_oc=AdkMr2wWXB7qx1xveEivbnn5umVz5qsvqmFzM-_c-LD4gd_Y4VGoHN3JOkJ5jdbzGoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBTRLFeY0xYDKpQvIXAb9aRlO8e937b9aNBwKWNy17ow&oe=69A2C7E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrawl", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Platformer", "id": "52
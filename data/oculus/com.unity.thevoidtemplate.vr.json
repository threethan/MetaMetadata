, "id": "1183385740617540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300910_1183385743950873_1655641609417565142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33nW95Ny8UkQ7kNvwHOPwzC&_nc_oc=AdpfeAsH38e-5LJOJ9z76GFlXsthuXABl5O1Wnk--6bmt9m_IhdwvXiXWxSyjiAbKyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt2PPC6oLL469yYGw9RNG6nWJ34mgQ6GIAHO8BsaGfqg&oe=6A8449A6"}, {"file_name": "LotsOfTrees.png", "id": "1911541266125429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618069_1911541269458762_1582378898536737820_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpOP9gKJMQEQ7kNvwFUTXnG&_nc_oc=AdprVZahqQwO9jtt18GEr91OY89SVD0gqQxTEJHa2avgPmABpTCLafPPKTcEn4OTNfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP1iu4wv02URdNqlQqODiQFLxIgCkGEvk1KgOslEslLg&oe=6A8436EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_20260105_181819.png", "id": "852672940898383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_852672947565049_8808248607942532164_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXFcbjHxSJMQ7kNvwEJD720&_nc_oc=Adqf7xCv55LOdAdS41GjV6eLQbzaTRF2NnASTBMgzcmpoo2eI-X8NqY1bODmdfIaxPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB-4OIwkjrrGyu1lf3UpGXvgVHyQ-s1NJ1FGjI4XQRQg&oe=6A844171"}, "display_name": "Umbrawl", "keywords": ["Spooky", "Fighting", "Shooter", "HandWalking", "Flying"], "long_description": "Umbrawl pits you against other shadow beings in the Umbral Plane. Customize your shadow character, and enter the Umbral Forest to fight other shadow beings and claim the crown. \n\nUtilizes a completely unique hand walking and flying locomotion.\n\n{1431595901973546}\n\nJoin a random lobby, or create a custom lobby to play with friends. Set your custom lobby to \"open\" so random players can join your forest.\n\n{1229153989144929}\n\nButtons:\n- Hold A or X and reach your hands out to fly.\n- Triggers to shoot.\n- Grip button to grab and use menus.\n\n{1410669757181619}\n\nWhy early access?\n\nWe want to test Umbrawl in a real-player setting to make sure there are no unfun bugs. We also want to see your responses and feedback. We do not plan on staying in early access for long.", "short_description": "A spooky fighting game played in a dark and dense forest. Features a one of a kind walking/flying locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soar.game/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soar Explore", "support_website_url": null, "website_url": "https://soar.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25482796764674672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1438272460992652_2971066956153269137_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WMMTmY2ETwQ7kNvwFS1qMN&_nc_oc=AdpJDwpPA0Bo1EyGpKiUkjgAO811NMu0VMgeuljjgnnHLUZ9PgPdbDvjLIU3EnAsGBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXGmGt4x0c5MvVFKORpxA5BLeSRN0RkH6URewFD-Wvng&oe=6A843863"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrawl", "platform": "ANDROID_6DOF", "context_category"
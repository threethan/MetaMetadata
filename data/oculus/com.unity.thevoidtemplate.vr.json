jP4K42QM1fAzVDL0rbbOTWopRJwDDsOS9yk6A&oe=6B1061D0"}, {"file_name": "RD_Screenshot2.png", "id": "1362448185269803", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1362448188603136_2351515992436301572_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or4MNSWsqDsQ7kNvwHl5oZS&_nc_oc=AdooCyOGKIfTE20KN4bYvzR0pF4HFNfoFZ-bsZ0UjhADLE459pJpeEJYKa8WxeIBSSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfsbOZ46AtmALcAqWHKMjTql6lciH9WVl6vs1LYgTwLg&oe=6B104EAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Umbrawl", "keywords": ["Spooky", "Fighting", "Shooter", "HandWalking", "Flying"], "long_description": "Umbrawl pits you against other shadow beings in the Umbral Plane. Customize your shadow character, and enter the Umbral Forest to fight other shadow beings and claim the crown. \n\nUtilizes hand walking and flying locomotion.\n\nJoin a random lobby, or create a custom lobby to play with friends. Set your custom lobby to public or private depending on if you want others joining.\n\nButtons:\n- Hold A or X and reach your hands out to fly.\n- Triggers to shoot.\n- Grip button to grab and use menus.\n\n\n", "short_description": "A spooky fighting game played in a dark and dense forest. Features a one of a kind walking/flying locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soar.game/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soar Explore", "support_website_url": null, "website_url": "https://soar.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
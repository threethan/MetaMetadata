, "id": "1183385740617540", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300910_1183385743950873_1655641609417565142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NsM02sqTHQQ7kNvwET13MF&_nc_oc=AdoesA_3UDTRZJn7PpSduQWEV0rn72KiQxGG-o_JMjbpAm6fuMq1PbTPUoTYbYCkuqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKip0n1kbcXFnppeL6Zboeb3a46AoS5MSl5GvkYXS3-g&oe=6A8AE126"}, {"file_name": "LotsOfTrees.png", "id": "1911541266125429", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618069_1911541269458762_1582378898536737820_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtZfrhYCIzoQ7kNvwEvDnas&_nc_oc=AdpZA6vwddKr4OL1LwQrbhSVHDo2Jh9-AxqLilS2rNGiSWPI50ICjozfXZO6msgv4hg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG1FdU64wQ8ZAop_NUafiIHIe0RtqESTG1DUwp3UcyiA&oe=6A8ACE6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_20260105_181819.png", "id": "852672940898383", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618297_852672947565049_8808248607942532164_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U80YIxnRJBEQ7kNvwFCVjku&_nc_oc=AdpsGOGf1OW0eeH9Qc2Zu8x0t07FCVktBl4idXEo7wRH-v-gQBexhIlfe0z4bMvJ3-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIX4uvv9yWtAeWGw3VLRpvRoo05xiONF3SOiQat5kJaw&oe=6A8AD8F1"}, "display_name": "Umbrawl", "keywords": ["Spooky", "Fighting", "Shooter", "HandWalking", "Flying"], "long_description": "Umbrawl pits you against other shadow beings in the Umbral Plane. Customize your shadow character, and enter the Umbral Forest to fight other shadow beings and claim the crown. \n\nUtilizes a completely unique hand walking and flying locomotion.\n\n{1431595901973546}\n\nJoin a random lobby, or create a custom lobby to play with friends. Set your custom lobby to \"open\" so random players can join your forest.\n\n{1229153989144929}\n\nButtons:\n- Hold A or X and reach your hands out to fly.\n- Triggers to shoot.\n- Grip button to grab and use menus.\n\n{1410669757181619}\n\nWhy early access?\n\nWe want to test Umbrawl in a real-player setting to make sure there are no unfun bugs. We also want to see your responses and feedback. We do not plan on staying in early access for long.", "short_description": "A spooky fighting game played in a dark and dense forest. Features a one of a kind walking/flying locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soar.game/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soar Explore", "support_website_url": null, "website_url": "https://soar.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25482796764674672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619681_1438272460992652_2971066956153269137_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTmWWywPxLIQ7kNvwHjfpEN&_nc_oc=AdpeQA3h0sjVmYSxpXFuj0iJTe0UZp0Kq95Q8aqLV3h7OfJD24dCkNXS9sdlvo6x0Mg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGePhAW9Ek2UVQGT5YMZQL7IXISv0AU3NZag0zAaWj3QQ&oe=6A8ACFE3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrawl", "platform": "ANDROID_6DOF", "context_category"
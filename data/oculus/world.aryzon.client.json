 users per session\n- Be yourself through ReadyPlayerMe avatars\n- ..many more\n\nWe would be very thankful for anyone helping us improve our application. You can use the built-in feedback form, or get in touch with us through our Aryzon discord channel. We very much appreciate your feedback!\n\nThank you for being one of the first to explore Aryzon.World.\n\nBuild, share, play!", "short_description": "Shape the world of learning together! Build interactive experiences without any coding skills. Simply pick your environment, add objects and invite others to share your work with."}]}, "developer_name": "Aryzon.World b.v.", "developer_privacy_policy_url": "https://dashboard.aryzon.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Aryzon.World b.v.", "support_website_url": null, "website_url": "https://www.aryzon.world/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "7281242115269945"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "909148310914812"}]}, "baseline_offer": {"id": "909148310914812"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707763849, "status": "PUBLISHED", "id": "909148310914812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
le_name": "migrated_image.png", "id": "1033140443734527", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162681_898250266994309_3348360116029095936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvlykQcaidEQ7kNvwF43PlL&_nc_oc=Adno5FDzqsKHs6fPTi9TSZetuu0JdYc7Cda7akJ53p6AAzXjy_axCuHg41Eg81ECMcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3N0m-6Z-RVJdrmkx6sUvKtwQtkkm4dm3Dtb119GQD2Q&oe=69B95C7D"}, {"file_name": "migrated_image.png", "id": "604881603427885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_474893979552855_4116645523794952192_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-ynXysfIawQ7kNvwG8Ud4g&_nc_oc=Adluh5pwOJnrtY19RRAatNU1SoslzCOxcXzC0NF9TU3zdTmmpaZqEFf9dp3YNmdRfFw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzb_n9-_KfDDXbwRsUceze-dZ0uant0h5OPMf5S2g_F3w&oe=69B94E1C"}, {"file_name": "migrated_image.png", "id": "222205978967510", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162735_182258308983852_4141288847843524608_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgRzEYNkUtkQ7kNvwEi8h_d&_nc_oc=AdkD44gazRsckQd3AuEiVJJ3xkC2jvPoHWenFiuJj9gZoTxyI5vIJEhyFsW_oRaeD6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxto2MGP-qYS-D9G43XO9uPPxQ07CtQVFZYnvdfwctNNg&oe=69B964C7"}, {"file_name": "migrated_image.png", "id": "600920153795567", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFUYNmgJo2kQ7kNvwH1F1Er&_nc_oc=AdnYG56_jZb3vD_qdAoACcskCxraQ-XJHI-3KCAA29E5pKkzxd1Ag08egDn1dLtwwq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVWeb6mayLYxQGVobmaBBvEC6yGifdS_9fbL4RVBHtHg&oe=69B936BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fall In Love", "keywords": [], "long_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nFalling in love is one of the most intoxicating human experiences. Inspired by \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nThe goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url": "http://www.trenchphysics.com/MothAndFlame/terms_and_conditions.html", "publisher_name": "Tool of North America", "support_website_url": null, "website_url": "http://www.toolofna.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "NARRATIVE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "896152027731927"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_113786556002560_350672667990294528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4RQ8lyV16kQ7kNvwF1PyMq&_nc_oc=Adm0xwLdLSq5N7cF_ByPMvvyXv_v
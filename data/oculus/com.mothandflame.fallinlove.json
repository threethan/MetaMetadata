ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVZiOflGlwMQ7kNvwFCa5nS&_nc_oc=AdkpNSisrpvQ3EL7BOzfPOvL9emZ0EwHg8omM9XRvEulNPN7ZeLYjEgXYR3bQdaIvgM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhUq7vAqWBwG3oMBLuLv-tybTLWvK7aC9BwkQ1rEZjKg&oe=69BD2B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162735_1382411231877986_703980130912960512_n.png", "id": "724637034393048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162676_724637037726381_4170754093020610560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8rEBRQJupUQ7kNvwGkF0yT&_nc_oc=AdlXagP1NheogPMatMegdpoxsqb3-BUJdfyNfbWJh9URSporKRhSeqPRviqVPJ-2ubc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPsxXAMUMKmuePBYG16JlfWlt9BwXP0jlzbQVWE_SdbA&oe=69BD5EBE"}, "display_name": "Fall In Love", "keywords": [], "long_description": "Falling in love is one of the most intoxicating human experiences. Inspired by the \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "The goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url": "http://www.trenchphysics.com/MothAndFlame/terms_and_conditions.html", "publisher_name": "Tool of Nor
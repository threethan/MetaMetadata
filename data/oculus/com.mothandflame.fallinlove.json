vEXI0P2g&oe=6A5252C7"}, {"file_name": "migrated_image.png", "id": "150763392832348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tf4AZSh6poQ7kNvwHqyx7J&_nc_oc=AdrHXZVjm1WxXQSI5e1j9vcf9_wKZ_6AZ25PBMW2kvpfG4EMuZ2XEqQmy5mSptCoA4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAICGxvJuigYknm4eJ9AGHwA6nEcw4IuHMqPnE9kgzUYw&oe=6A525CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162735_1382411231877986_703980130912960512_n.png", "id": "724637034393048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162676_724637037726381_4170754093020610560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBL1iF4ri7AQ7kNvwEuoj4j&_nc_oc=AdqYU2_h1nq0sb3QZkRbWI1zkFL9pufHssErJ-GtwfGXtQLLpcvFd11_6-EUTuw6WxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAharg_jJUiOTUv3nBjplRaKti-ALTzryIVdI5eUH6ZUQ&oe=6A52583E"}, "display_name": "Fall In Love", "keywords": [], "long_description": "Falling in love is one of the most intoxicating human experiences. Inspired by the \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "The goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url
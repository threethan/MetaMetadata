nFvPRI_IVTl7SULIRKUmRA&oe=6A7D9C07"}, {"file_name": "migrated_image.png", "id": "150763392832348", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pQdXKi5WRwQ7kNvwH4BFpQ&_nc_oc=Adq3G0B5ixuezybegDS-a4GdVFdo9bwwrBGmfxJY8qBhgBXpqH9fkaK_SsCLcOEhawA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXhGg1OZ7hby59PJk45mhw7Hjjgk1oWZ19lOtAS1agvg&oe=6A7DA63C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162735_1382411231877986_703980130912960512_n.png", "id": "724637034393048", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162676_724637037726381_4170754093020610560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHdgf-vKMiQQ7kNvwEurz7r&_nc_oc=AdqeeNJ1qbyXGqafsCLHos--qC1wBU1FUFIyb4iCxvu5MHj431WQotG5o53KBhw1hU4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSm1Nel9_53i0B1-YOdBVg8MJFAtoQxJ-hRFvjozHaOg&oe=6A7DA17E"}, "display_name": "Fall In Love", "keywords": [], "long_description": "Falling in love is one of the most intoxicating human experiences. Inspired by the \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "The goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_te
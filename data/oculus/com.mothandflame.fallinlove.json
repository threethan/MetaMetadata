le_name": "migrated_image.png", "id": "1033140443734527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_898250266994309_3348360116029095936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZY_ICw-pzUQ7kNvwHFAJ4h&_nc_oc=AdnQCCa9m0x2u455XzUE3Q_a5dg3dtzirSJnn6Yd10g5y-muk-wLNc0NStAM1ruRHDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgGCH3dZFMMCTfNLQ1ZfOtSZPl4taaZ_7eULTroV6xNQ&oe=69AED07D"}, {"file_name": "migrated_image.png", "id": "604881603427885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_474893979552855_4116645523794952192_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HjpkD4AoZUQ7kNvwE_qWDF&_nc_oc=AdnQyCTiljJEuZ5MFUvoUErq9C9YwWVNM0VaX6RsPi34ijEAla-8qWM19KTsOwaLxWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSPvTWTwMoBnnMT5Tt6nvnlq6KGxhlLcKavqTcMZppyQ&oe=69AEC21C"}, {"file_name": "migrated_image.png", "id": "222205978967510", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162735_182258308983852_4141288847843524608_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5YBoCdV6aUQ7kNvwG29Z13&_nc_oc=AdnAbAE6UZa-WN55vYByIPeW57e86Xnz4xI77i8HTECfrkZhDJV5yCLqO_qZKFbus-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmwO6x-mrGYHWiIAIigXjE2i8RCMNEHgSK8SPEcET6sg&oe=69AED8C7"}, {"file_name": "migrated_image.png", "id": "600920153795567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxSkPdtTPfMQ7kNvwGzFU5W&_nc_oc=AdnGXNxmcw2FCy6KRj5LDfMngZGp8wtLlVk8E1nXTCCENTJbU-zRD_1buli9lhw3vdY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR3l_xPYXsw2gRudvkxotoexhNMWf9uVSlRFyWPHwBfQ&oe=69AEAABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fall In Love", "keywords": [], "long_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nFalling in love is one of the most intoxicating human experiences. Inspired by \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nThe goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url": "http://www.trenchphysics.com/MothAndFlame/terms_and_conditions.html", "publisher_name": "Tool of North America", "support_website_url": null, "website_url": "http://www.toolofna.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "NARRATIVE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "896152027731927"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_113786556002560_350672667990294528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgg78mweo08Q7kNvwG44DnZ&_nc_oc=Adl85hVz24Uhto7LEuHhRuVwl4tO
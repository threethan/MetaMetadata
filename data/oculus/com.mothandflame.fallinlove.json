ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVyKzFsztuIQ7kNvwHN5RfZ&_nc_oc=AdkQZ8xr29RCxTgdLlOqYBSC9nHH399sGmiQE7_4QWazT8J__HYbaFDHWnB5yL8RiO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE0uXImBhSujBcja3eCunt-S0gHygySFlG1j1ZU8LEnA&oe=69B5423C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162735_1382411231877986_703980130912960512_n.png", "id": "724637034393048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162676_724637037726381_4170754093020610560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFBYLVnMNk8Q7kNvwH1L8jZ&_nc_oc=AdkCEgYDVvkFsr0BXav08p-1R6hSEcIo_C7vBOCQW7KLTu8e4_FTIsQul9yXVCGPO0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5yQYSN8HaSWgDzWYtRn4TMqzANdGpmcatczVAR3MwMg&oe=69B53D7E"}, "display_name": "Fall In Love", "keywords": [], "long_description": "Falling in love is one of the most intoxicating human experiences. Inspired by the \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "The goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url": "http://www.trenchphysics.com/MothAndFlame/terms_and_conditions.html", "publisher_name": "Tool of Nor
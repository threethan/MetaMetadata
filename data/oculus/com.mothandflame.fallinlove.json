BlGxJS_w&oe=6ABD1C47"}, {"file_name": "migrated_image.png", "id": "150763392832348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdKr_0FuSeIQ7kNvwHzWT8B&_nc_oc=AdpC-rFofhlrplayp8ko_Zskpu_Of3gRN2ZiSDYz9GctSmFVh-z-f9kWG9UJmfEbwFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb2N1J8uuz24YF9hFLhLReoCQZnQPla-TC8EzXBvRXnQ&oe=6ABD267C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162735_1382411231877986_703980130912960512_n.png", "id": "724637034393048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162676_724637037726381_4170754093020610560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZAUMcENP_IQ7kNvwFwfoVD&_nc_oc=AdoLGVEfSa61CnZkBD9W1iO9JomRHq2TFRKIP6Rci_3ji_C5sq-p-sGIIeqL91zsD6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMhJb9VZHwHCP2MovaRm8fJjmpE6vSel7w_L7lmBKeGg&oe=6ABD21BE"}, "display_name": "Fall In Love", "keywords": [], "long_description": "Falling in love is one of the most intoxicating human experiences. Inspired by the \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "The goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url
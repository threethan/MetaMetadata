nt-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4mST606AQYNtMyuR2odclGwlY-PAb4y1d72rHuKwykA&oe=6B1034FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fall In Love", "keywords": [], "long_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nFalling in love is one of the most intoxicating human experiences. Inspired by \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nThe goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url": "http://www.trenchphysics.com/MothAndFlame/terms_and_conditions.html", "publisher_name": "Tool of North America", "support_website_url": null, "website_url": "http://www.toolofna.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "NARRATIVE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_mod
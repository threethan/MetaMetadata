//scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162681_898250266994309_3348360116029095936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F-2jqK0o20Q7kNvwFpsSZm&_nc_oc=AdkKThJSR57F78NmuqqlQzyqOu7ySUmC2zSfo3ugZ-YxzPhica9luS5tTS-os2yh9gs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsbCkuh82Ln2D7Ith2mcMZ8IPp7LUNMMS70j_Gb9luG8A&oe=69A6E77D"}, {"file_name": "migrated_image.png", "id": "604881603427885", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162696_474893979552855_4116645523794952192_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkLzE8LjGFUQ7kNvwEsGNvR&_nc_oc=AdmO92z1lXOOt7Tgdq21BW1H__QLaOw1ZWMX80G42tvvHeRRUGz2h-CDDxz4RLl--TQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhxHGzY4rKiFbaTYH4N5TzsM8aVEJS9lCDE4MQ-mX7Zg&oe=69A6D91C"}, {"file_name": "migrated_image.png", "id": "222205978967510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162735_182258308983852_4141288847843524608_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvoJrLgz0MQQ7kNvwFK8iHo&_nc_oc=Adm-dwWfJVFZqyrJ7h0mQWznASBI_xdoWSm2otFG84Dnqi1Sp5-GgNkX-xEvOH0F30E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujjfAJLRTLb58VWg3UA74zn2oXnEtNf-GAJRfXdcD_KA&oe=69A6EFC7"}, {"file_name": "migrated_image.png", "id": "600920153795567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_880211035466454_2379392434372083712_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db0kF3Bc0w4Q7kNvwHUkD7v&_nc_oc=AdkHKqmezIZUOS3kWKKkhH2JDzvo7vcxcOu8SPbUyN-BG-q-jb6BxX425Y9829iJdb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIkcZY7Fse2GpSZxXBMSGk78q2YXFz--R_IxbqVv_mkQ&oe=69A6C1BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fall In Love", "keywords": [], "long_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nFalling in love is one of the most intoxicating human experiences. Inspired by \u201cThe 36 Questions that Lead to Love,\u201d the goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. People will put on a headset and be transported to a whimsical forest where they come face to face with a group of actors, who they can then have a conversation with through voice recognition software.", "short_description": "EXPERIMENTAL BETA MODE\n\nHEADPHONES WITH MICROPHONE REQUIRED\n\nThe goal of Fall In Love is to foster authentic human conversation in VR and to inspire people to feel an emotional connection with others. Through the power of technology, Fall in Love is a groundbreaking new format for storytelling and the next evolution of virtual reality filmmaking."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.trenchphysics.com/MothAndFlame/privacy_policy.html", "developer_terms_of_service_url": "http://www.trenchphysics.com/MothAndFlame/terms_and_conditions.html", "publisher_name": "Tool of North America", "support_website_url": null, "website_url": "http://www.toolofna.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "NARRATIVE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "896152027731927"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_113786556002560_350672667990294528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ru8RwJkRlcQ7kNvwHZCcxf&_nc_oc=Adn_0Fi7lwp_GGd-4rJ4DWIyo7eUpjWl3H6xQWfxNkwKXfrtjIsAxaEc_5K33o9vLFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSsnXrMl7xF6pA
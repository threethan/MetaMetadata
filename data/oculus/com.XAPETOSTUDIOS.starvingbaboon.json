wgCJ&_nc_oc=AdpEbxMC4vrkajW3AY7shAUi77HWQ52VTOmK9Ig2q2zsPz59WOIJuKZUgo11uAJMl48&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af095FMWJAAwC2Tdt-67PgvmpXNbBOnTrT3yrinZVWrmxg&oe=69F5F94F"}, {"file_name": "Untitled design.png", "id": "1340136853975440", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391924_1340136857308773_5411550588644079025_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhO0fKbh3M4Q7kNvwGMA_eV&_nc_oc=AdpgdwmzoG_f701yKF9X408KeSSk0KiLTuETZnezwf8zbpKyXjxQn43ChbXwuZNW0pY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_vObA1t_hFeVzuPydKMw2YZphHLXtrFe3wdeD8Fk9mQ&oe=69F6061C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "STARVING BABOON", "keywords": [], "long_description": "STARVING BABOON is an up-and-coming horror game that immerses players in a dark and intense world filled with fear, survival, and mystery. In this terrifying experience, players must navigate eerie environments, solve cryptic puzzles, and evade relentless threats lurking in the shadows. With a gripping storyline, immersive gameplay mechanics, and a haunting atmosphere, STARVING BABOON aims to push the boundaries of horror gaming. Stay tuned for more updates as we continue developing this chilling adventure!", "short_description": "STARVING BABOON is a thrilling horror game where players must survive eerie environments, solve puzzles, and escape lurking dangers. Brace yourself for a terrifying experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/starving-baboon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRE", "support_website_url": null, "website_url": "https://sites.google.com/view/starving-baboon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "269189
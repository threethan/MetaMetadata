sJKyLGIVIjgnbtqSXNeaDXaGuN-Jwv3g&oe=6A33F81D"}, {"file_name": "5.png", "id": "1191323495290219", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974751_1191323501956885_1963514939111485112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M86xOpt_FXIQ7kNvwHTsEPC&_nc_oc=AdrR6AEulbkoLtgnmsrGRLrXNNRrN6_fpe1qyqT-aNEWNHl16ZOjUSQB4zXtL3o6Y0g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EodGpnoANAyDTNiplxmcXoJ2yXEaHE-0G9BTV8-V7jg&oe=6A340E98"}, {"file_name": "1.png", "id": "8664981633586958", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036669_8664981640253624_3241530834852619211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_CceJBVXWcQ7kNvwHfBIBf&_nc_oc=Adr5aktNGWwv25pNDic5enVwc3qrqpaqTQqzrxCKAuQ4KXqqnMCWzNE6syUKUSdYJ_Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pK3FNqBR9CiIWmLFCCHmIsMywlh-ocX9lPAp20PJ9Kw&oe=6A34173E"}, {"file_name": "3.png", "id": "1208853613508736", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003266_1208853616842069_1860812159738389408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHKIISV3GV4Q7kNvwH1P12M&_nc_oc=Adq2N76mSCjxTYBABZydT2aM8lBavLhymlMqIGMe7C77xn8SGEy1qzbTLjK0vuiTdZ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cBIJqrIXkaZk9fswAExmOF1Kn22RmiNftJI8-9nWbzg&oe=6A34015B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "1725762458275793", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001695_1725762461609126_4978057442117490812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1lzBoE1PLkQ7kNvwG-lfRn&_nc_oc=AdoDe2iL9W15QrPBr3sG-g9O3vQdoftqfihCv9ZGFmLEvTJDPqDSY7u4iNzY_LPi1Ww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G1ZEEHA2uS5qoS8Jpk-EW-9agUFK9QyE9AZ2qcZmBgQ&oe=6A33ECDC"}, "display_name": "Idle Life Horse Tycoon", "keywords": ["VRHorseBreeding", "EquestrianSimulation", "HorseGame", "VirtualRealityFarmManagement", "IdleHorseTycoon"], "long_description": "\"Idle Life Horse Tycoon - Experience the Thrill of Horse Breeding in Virtual Reality!\"\n\nStep into the immersive world of horse breeding and farm management with Idle Life Horse Tycoon, designed exclusively for Meta Quest. This VR experience allows you to manage a thriving horse farm from the ground up, all in a beautifully detailed virtual environment. Start with a modest stable, care for your horses, breed new champions, and watch your farm grow.\n\nFeel the excitement as you groom, train, and enter your horses in races, right from a first-person perspective. Customize your farm\u2019s appearance, build larger stables, and add unique elements that make it truly your own. As you progress, unlock new breeds with unique traits and compete in virtual tournaments to prove your skills as a breeder.\n\nWith intuitive controls and immersive visuals, Idle Life Horse Tycoon brings horse farming to life like never before. Explore the freedom of VR as you grow your dream farm, one horse at a time. Are you ready to become a virtual equestrian tycoon?", "short_description": "\"Idle Life Horse Tycoon - Build and Manage Your Dream Horse Ranch!\"\n\nStep into the captivating world of Idle Life Horse Tycoon, a game where you can create, manage, and expand your very own horse ranch! Perfect for horse lovers and simulation fans, this game blends idle management with the excitement of breeding champion horses. Start small, managing a handful of horses, and grow into a renowned ranch owner as you raise, train, and compete with your steeds."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/idle-life-horse-tycoon", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603
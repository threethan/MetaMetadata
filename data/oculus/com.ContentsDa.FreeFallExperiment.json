), turn the handle of the vacuum tube up and down to see how the mass and air top fall, select \"slow\" for a slow and detailed view.\n2. experiment with free fall from the Leaning Tower of Pisa, use the portal in the lab to go back and forth between the lab and the Leaning Tower of Pisa, set up balls weighing 0.5 kg and 5 kg on the Leaning Tower of Pisa, use the portal to go to the opposite rooftop, press the drop button, and learn about free fall.", "short_description": "Experience the thrill of gravity with the Free Fall experiment. Witness how objects accelerate under gravity, providing a practical understanding of gravitational force and motion dynamics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8560707933983112"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469629_1083620796171599_7546982782712080722_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JomWPxMvZ6oQ7kNvwH_Xup3&_nc_oc=Adn_JgFOAHBRoCvvCoqpC2ZhRjLgvRy8jSaSWZHaUz3ToiqgYjuP8JOa53mr6TG1U1Y
5/39031541_1069229464419738_2789796330285648637_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaCo6xs8yHgQ7kNvwGW5VC4&_nc_oc=AdnXm8GWEIbZ74sUHmdjCYOxNvvIKPFhfGYA2KcpDdNmg-IKxkM4BAPBBcN5S0Nrg_Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKMs40UaCiLAciNTsmgYeHjmZH032jys22IxbE_6y8iw&oe=69AAC0CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Heat and Energy_Landscape.png", "id": "914090700331938", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75330716_914090703665271_5745583449124777395_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R8m7roAcUkQ7kNvwG1WU4j&_nc_oc=AdnxxlI5rLG4LP9LSMnyfqq4Pjvg0djJCGtDbTIVYF8brBuj-bQ5vdaiiTHmYoCaiyo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyO3W71L6bAJurQnYV0zm-RTTJowodRMg9RgJHqy1ZJUA&oe=69AAAF72"}, "display_name": "Heat and Energy - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "school", "science", "contentsda"], "long_description": "1. Place a digital thermometer in a black aluminum cup with a lid.\n2. Place the wood film about 30 cm away from the infrared light.\n3. Place the black aluminum cup on top of the wood film.\n4. Turn on the infrared light and measure the temperature in the cup every 2 minutes and record it in a table.\n5. Graph the temperature change in the black aluminum cup over time at 2-minute intervals.\nWhy the temperature of the air in the aluminum cup does not continue to increase: Over time, the aluminum\n\nthe amount of radiant energy absorbed by the aluminum cup equals the amount of radiant energy emitted by the aluminum cup.\nradiative equilibrium.\n\nWhy the average temperature of the Earth remains constant even though it continues to absorb solar radiation: The amount of solar radiation absorbed by the Earth is the same as the amount of solar radiation emitted by the Earth. radiative equilibrium.", "short_description": "Delve into the dynamic world of thermodynamics. Explore how heat transfers between objects and how it influences energy changes. This hands-on experiment is a fascinating journey through the principles of energy conservation and thermodynamics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ConentsDa Inc", "support_website_url": null, "website_url": "http://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9978131432313713"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031319_1830221124088900_1098947645772776078_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VOP6FyOe3oQ7kNvwH5QXBO&_nc_oc=AdmcHQZVoH1Rq1tiNVIeMI-I5pIZ3fD-h78Ylevo7kqHh-UhJ1FdHUPDzaFvx5juf5Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYwXZLEmKrDlzL4YbzxktLmWe4J1STmj0gRozZt4opiw&oe=69AAD6E7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heat and Energy - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"
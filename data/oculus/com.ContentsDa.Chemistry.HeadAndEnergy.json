 substances, observe genuine chemical changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other", "short_description": "In this experiment, we will learn how heat and energy are related."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ConentsDa Inc", "support_website_url": null, "website_url": "http://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6343176082475951"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "733834515567080"}, {"status": "PUBLISHED", "id": "1989962534737944"}, {"status": "PUBLISHED", "id": "1507740989782282"}, {"status": "PUBLISHED", "id": "1497897411043597"}, {"status": "PUBLISHED", "id": "1363882777638392"}, {"status": "PUBLISHED", "id": "1172936187269521"}, {"status": "PUBLISHED", "id": "883824086625034"}]}, "baseline_offer": {"id": "733834515567080"}, "is_approved": true, "fi
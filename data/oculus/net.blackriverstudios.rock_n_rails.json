zuyeeSEIOfVuny3OQ&oe=699EF3ED"}, {"file_name": "migrated_image.png", "id": "565521627392598", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331199_254852041592663_5116647445131952128_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWuQFSLvAJEQ7kNvwHaTeL6&_nc_oc=Adm5WLIxoT7JMfJc0DldXJV3fxgwJjFx3kgosvu5xDJoKST_qcfBwaWbE6LrO4tqoSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfudN1r9hPA5Bz1pJtplrkiZ53lYb5_DSJXvzkRxGw8yzg&oe=699EE5D9"}, {"file_name": "migrated_image.png", "id": "500607237290868", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139051_383583982013500_2105011403604623360_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kflgRfwKVl0Q7kNvwH50C3g&_nc_oc=AdkCaEF7SKN59AVWuzZY-b_vnAvMrhPRZNPqwL8hUMWx-zNCs54CSsmc3Lsw3kMuvEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afukl8dArLscXh4A--klGhU8qH6W7kLZqi_kGvBaFnoNdA&oe=699EE851"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rock & Rails", "keywords": ["Rock", "Rails", "Shooter", "Music", "Cooperative"], "long_description": "The world of Rock \u2018n\u2019 Roll has been silenced, so it\u2019s time to get loud! Take up guitars and basses, and blow up the Silence Beasts with a BAAANG! Ride on rails all over the city, shredding riffs solo or jamming with your friends, and reclaim our world back in the name of Rock!\n\n- 9 levels full of rock and metal\n- 3 eligible characters\n- Metal Mode - harder levels for hard rockers\n- Local Co-Op Mode - jam with a friend*\n\n* Requires two devices with the game installed and a WiFi connection to play in co-op mode.", "short_description": "The world of Rock \u2018n\u2019 Roll has been silenced, so it\u2019s time to get loud! Take up guitars and basses, and blow up the Silence Beasts with a BAAANG! Fly over the place shredding riffs solo or jamming with your friends, and reclaim our world back in the name of Rock!"}, {"images": {"nodes": []}, "id": "248799673186091", "locale": "es_LA", "screenshots": [], "v
red69Vjhe1_aR59Sw&oe=69A0456D"}, {"file_name": "migrated_image.png", "id": "565521627392598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331199_254852041592663_5116647445131952128_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw03BnnbkSQQ7kNvwGUKl62&_nc_oc=Admnimug68tpLcag74Z7arQrl6SFYhGSRNxjXLNRGBGsuUEqdaKAETYJSetbOzjJq94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKLfjE4zjGmkLJmeQZ-uW-rOFZiSYmPH_zhjk3GikzfQ&oe=69A03759"}, {"file_name": "migrated_image.png", "id": "500607237290868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139051_383583982013500_2105011403604623360_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUrBqDXxHY0Q7kNvwHWcrGM&_nc_oc=Adk9axo_QZGrREzloQ54G43DAJ5FMPqZR4aS0aIgBCjWdoVAHnQ1tjkBeq43gdaIjYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHaZsCXJo2UOCzFU2fjVBOj2XnslJfkSfVOk1SytpVWw&oe=69A039D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rock & Rails", "keywords": ["Rock", "Rails", "Shooter", "Music", "Cooperative"], "long_description": "The world of Rock \u2018n\u2019 Roll has been silenced, so it\u2019s time to get loud! Take up guitars and basses, and blow up the Silence Beasts with a BAAANG! Ride on rails all over the city, shredding riffs solo or jamming with your friends, and reclaim our world back in the name of Rock!\n\n- 9 levels full of rock and metal\n- 3 eligible characters\n- Metal Mode - harder levels for hard rockers\n- Local Co-Op Mode - jam with a friend*\n\n* Requires two devices with the game installed and a WiFi connection to play in co-op mode.", "short_description": "The world of Rock \u2018n\u2019 Roll has been silenced, so it\u2019s time to get loud! Take up guitars and basses, and blow up the Silence Beasts with a BAAANG! Fly over the place shredding riffs solo or jamming with your friends, and reclaim our world back in the name of Rock!"}, {"images": {"nodes": []}, "id": "248799673186091", "locale": "es_LA", "screenshots": [], "v
_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoaAAwJSJAnHxeIXFS8KNL_nJlFxKnK1Rr1Gx9cyANuQ&oe=6AF357FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1677407823809408", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1677407827142741_4205875950156219725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoNXRJJFHHYQ7kNvwG1IPQ-&_nc_oc=Adqeb5K9GPGyLzq1fwdgZld0L0-gMbdENg_BUB0idr0nXPT1lQyTzFcSlQcgXhub4EU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9baRcB0QeTdLhyWj6k5xm_6I8sAzVqF3R4ViN0EGPpA&oe=6AF34944"}, "display_name": "House Mayhem", "keywords": ["party", "cartoon", "shooter", "melee", "action"], "long_description": "The party is in full swing - dancers on the disco floor, a band in the garage, karaoke in the basement bar. You walk in with a weapon in each hand. What happens next is up to you.\n\nA WHOLE HOUSE OF PARTY\nFive zones joined by stairs and doors: the main floor with its light-up dance floor, upstairs bedrooms and a home cinema, a basement bar with karaoke and a pool table, a backyard pool party with a bouncy castle, and a garage with a live band.\n\nA WEAPON WHEEL IN EACH HAND\nRevolver, shotgun, rifle, sniper rifle, baseball bat, axe, hockey stick and knife. Press B for the right-hand wheel and Y for the left, and mix any two. Swing for real - bats and blades land with weight.\n\nTHE GUESTS FIGHT BACK\nOne loud noise wakes the whole house. Brawlers grab a bat and charge, gunners fire slow glowing rounds you can see and dodge, and cowards run and hide until they come back angry.\n\nIT NEVER STOPS\nClear a room and a new crowd barges in. Walk into any room and the party starts over. Bright cartoon style, a soundtrack of party anthems, and no player death - just keep the mayhem going.\n\nControls: left stick to move, right stick to turn, B / Y for the weapon wheels, trigger to fire, swing to hit.", "short_description": "Crash a colourful cartoon house party. A weapon wheel in each hand, five party zones, and guests who fight back."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/housemayhem/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/housemayhem/", "website_url": "https://citiview-games.pages.dev/housemayhem/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253126811226625"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2133821187526652"}]}, "baseline_offer": {"id": "2133821187526652"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790346120, "status": "PUBLISHED", "id": "2133821187526652"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1255756454296994", "version": "1.1.0"}, "id": "1120619753837399", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1253126804559959", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1255756454296994"}, "release_status": "RELEASED"}, "binary_rel
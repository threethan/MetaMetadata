luscdn.com/v/t64.5771-25/491818852_2602828453452736_6785975572666494226_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXZhHTQV98Q7kNvwE-hbrT&_nc_oc=AdppE_jJ1LIiUOXIoT9s33B22rX5bRaAf0QIZ2kMD8MTpWbOnIvWV1yxjxTnUg2iFR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQd79-bWhlN-m2T3MoL7LnpaOsaWfIVqanWkqDmCPVMyw&oe=6B0C73E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Traffic Rush : Highway Racer", "keywords": ["VRRacing", "TrafficRacer", "HighwayRacer", "SpeedBoost", "CarRacingGame"], "long_description": "Get ready for the ultimate VR racing experience! VR Traffic Rush: Highway Racer puts you in the driver\u2019s seat of a high-speed adventure across endless highways filled with fast-moving traffic. Feel the adrenaline as you dodge cars, weave through tight lanes, hit turbo boosts, and pull off jaw-dropping overtakes to prove you\u2019re the true king of the road. With fully immersive VR controls, lifelike 3D graphics, and dynamic weather and traffic conditions, every race tests your reflexes, strategy, and courage. Unlock faster cars, upgrade your rides, and race through diverse environments from bustling cities to scenic highways. Can you handle the rush, outsmart the traffic, and dominate every highway in your path?", "short_description": "Experience high-speed VR racing through nonstop traffic! Dodge cars, hit boosts, and become the ultimate highway racer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"i
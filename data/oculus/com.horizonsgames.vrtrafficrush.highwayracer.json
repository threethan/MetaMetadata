5/491823341_2275658749905953_6007614207804611737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGoQM6sOfagQ7kNvwGSCHTW&_nc_oc=AdqPyJ8U8Umaovclw2I7aYo_Vm-7i0xFIwML5hJVQ8nxTFcVJLp4SZimymXRRSjHHHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35JjPrH8WG23_w8AxMEQWVFMu163KGi_kaMRdZE4rNcg&oe=69EA13E9"}, {"file_name": "Screenshot_11-02-2026_11-35-33.png", "id": "1968727360520638", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1968727363853971_3648450010088382895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLSVIPtHAvEQ7kNvwHPbvdQ&_nc_oc=AdoUvbsMItG6XPB3NIlB8xxv230zV71ILz_RXL2tmDVR68mgnids9mC2JIq45orG5C4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hZF4ODT8jbsyG1WAldYVw35oXbLucd6gzDfvWDOKSvg&oe=69EA28BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Traffic Rush : Highway Racer", "keywords": ["VRRacing", "TrafficRacer", "HighwayRacer", "SpeedBoost", "CarRacingGame"], "long_description": "Get ready for the ultimate VR racing experience! VR Traffic Rush: Highway Racer puts you in the driver\u2019s seat of a high-speed adventure across endless highways filled with fast-moving traffic. Feel the adrenaline as you dodge cars, weave through tight lanes, hit turbo boosts, and pull off jaw-dropping overtakes to prove you\u2019re the true king of the road. With fully immersive VR controls, lifelike 3D graphics, and dynamic weather and traffic conditions, every race tests your reflexes, strategy, and courage. Unlock faster cars, upgrade your rides, and race through diverse environments from bustling cities to scenic highways. Can you handle the rush, outsmart the traffic, and dominate every highway in your path?", "short_description": "Experience high-speed VR racing through nonstop traffic! Dodge cars, hit boosts, and become the ultimate highway racer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home"
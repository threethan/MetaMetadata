5/491823341_2275658749905953_6007614207804611737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK_mA5g63nUQ7kNvwFqsi4F&_nc_oc=Adp17CO6Je4hTbcyaX3Sc6UH4iQ5IEm-PkcKCbQd8vSYJ84MCkmQuDdJn_WZFv0bmt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YHlqKTaPeIGf7nCbnggtlwJsPT11kruRL6FPdbDgFgg&oe=6A2AAD69"}, {"file_name": "Screenshot_11-02-2026_11-35-33.png", "id": "1968727360520638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1968727363853971_3648450010088382895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_-lpoYZBHoQ7kNvwGLBuTl&_nc_oc=AdoBSpK2E07-PJK3fN4WIPW3phFlwHhUB9xH4zrAlCzbQvbM3lXfOXZPEN1db0ccdYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6SdW_bn9XOw0GgDT0LcgpIlANzzwC7DViW-fzdaAbew&oe=6A2AC23E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Traffic Rush : Highway Racer", "keywords": ["VRRacing", "TrafficRacer", "HighwayRacer", "SpeedBoost", "CarRacingGame"], "long_description": "Get ready for the ultimate VR racing experience! VR Traffic Rush: Highway Racer puts you in the driver\u2019s seat of a high-speed adventure across endless highways filled with fast-moving traffic. Feel the adrenaline as you dodge cars, weave through tight lanes, hit turbo boosts, and pull off jaw-dropping overtakes to prove you\u2019re the true king of the road. With fully immersive VR controls, lifelike 3D graphics, and dynamic weather and traffic conditions, every race tests your reflexes, strategy, and courage. Unlock faster cars, upgrade your rides, and race through diverse environments from bustling cities to scenic highways. Can you handle the rush, outsmart the traffic, and dominate every highway in your path?", "short_description": "Experience high-speed VR racing through nonstop traffic! Dodge cars, hit boosts, and become the ultimate highway racer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home"
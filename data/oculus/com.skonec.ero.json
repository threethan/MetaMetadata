1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHJ3NU8AJxoQ7kNvwHC4ZXQ&_nc_oc=AdmRigF3AyrmYj0HPEQYXfs2NPtpFEKgAOBDlKb66ZYn0X-LAHsBYp78SuhZLD5WSbQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQYif8E_bICA1FRRn-klL-QMsdBAMDzbUUONLYNExXtQ&oe=69BD3A5C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36-zGgz2OEoQ7kNvwGAMrOr&_nc_oc=AdmMMfGKvIVRm8CoAfkOSx7Tb6bm86r7Xd3vAPUTvbNpc7ZvX-pfZIaUKLoSWkCiXPc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLzdR7wqMKZFJpqIUwYPlkMUxoAuN-aRsWgCydxnvhjQ&oe=69BD380F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJylVs33qEIQ7kNvwHfUa-w&_nc_oc=AdkR8HJaUjdGbPzlSGIq0jIHrNSjdKaBGHA3_2rW_3CzfmV4Yov0aGa7fpTTdCkWdvk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4dG6Mc9w-8V3ngnrmBF6Qf45pDxODInhGPjFslJn5xw&oe=69BD369D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T27VMjag5ycQ7kNvwEj_2fz&_nc_oc=Adl6ex08nMfOWhkH7f67PM9NMPczlArkQm0MyCXZdvUXz9ZFf8AOi8J1hChA4PgTUkI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMKYUBw4qQ_lxMkSLN4eHpuNqMHDcDux_s84A8uSKFcQ&oe=69BD52C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufPt2g6gsvIQ7kNvwEeeAgi&_nc_oc=AdlDGy3gIDtkdq9JduMlGpxWbT2B-ZNxOaztDI42EOed_0iBaW9qvxv8n4DmkbH7Ur8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxczQy8w0ospV351tPIR-8MfvAE_-kdSwg5JOGPAQzboQ&oe=69BD2AAB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty7LlddaiawQ7kNvwEZl17T&_nc_oc=Admkw7Bqe-10625ML-x-YIBYDAbNQmFhkZ2YrM
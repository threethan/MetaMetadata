1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD2I4M6tRwIQ7kNvwFRW7NH&_nc_oc=Adk8DtOaZQAhF0GBP-WlJkY1qtmGWcE5qkeh6ROsMdd6zfDHBBj2CtxwmmjCkrcQhDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsiplIVPeebq6cA9VUhJhrhxNXYDmmfxUHuJftm2KsfOg&oe=69A8225C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4smxUVCr3gQ7kNvwEIwEHf&_nc_oc=AdlPtpodsodtCGMwZrHAstDf-1HXzXqZm2TuLRNUjqvFa27nwNZxFS-Y3P359DfqRpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs52BOTnVi73oZRNQhuCxOuVv-BCZ-yFjImzxrRBL_bFg&oe=69A8200F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLHJGAdqOsQQ7kNvwF0N9Xq&_nc_oc=AdlQCeq30T4VMH7yvXr23ybNlDCPkJE4fcKbG3IYIwNm9G8h3X0uF0a7L9mXVibvsDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2tWyFXLkNSMPpnBqzD9QQcIvt55Ub0HCfRecVEynx4g&oe=69A81E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywARpzctZQ0Q7kNvwHfVqzq&_nc_oc=Adly-bsBmbrq7XLbxM2oQnnVRo_Jlio9PaG9NRQ1Nx-KuWSzAeUmGIOqXuYuxOuJ6r0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftRJTEufMbBIiupyBjraUrTbw-HAZaI2x9fkZzRTWFwcg&oe=69A83AC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKWmI58cxl0Q7kNvwFR5Q9Q&_nc_oc=AdlqKa1U8qqOpfypkpael9rw-mIc9cX9OH77yELv7l7E_C0hQNTdInVSGYgi9X9atd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuRp97OwIU0GiMCoWrbgVgJLS-n_YHgF5b_KkWyKlXHgw&oe=69A812AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sajs3wZzsLcQ7kNvwGKyAsB&_nc_oc=Adl246Ov_NHnx-RBWZJ8O5zycXLPLiOmVvuBl6
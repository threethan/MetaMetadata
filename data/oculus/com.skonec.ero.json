3.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2K2sjg6IuoQ7kNvwGDDcqo&_nc_oc=Adkvm9E4wj6tlw5w2usteYH9W5C7AizS90TEw2gm2F4uztT66PIY5npZu8NC93OXuRU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxzVOIyWoPa_wkq57QgIKLfPKOH8CoMOZ-yq20mjF70w&oe=69BA975C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8pLb5wXMaYQ7kNvwEQGs27&_nc_oc=Adlw6NAui8Ah1TnGct6CiFFDHh73AJudeQToszuDIzohOC1NWNod5TZLWesBtpN4aoo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6fzDdeHN-ESGhGK2XW3eDZGL4DENT4zRJKDcM1S-0_Q&oe=69BA950F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJylVs33qEIQ7kNvwHyqO6H&_nc_oc=AdliBTq22DChh8Mp9n-nx19sq3cGAWqGa1yXwnjY3eoMkKvQOJbOkO6rpGzx0ND1pVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUkDZKKXAZtxFMPZcQvOW61011hoHPkuiBP3OsOBnF1Q&oe=69BA939D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XuMGGlsfTsQ7kNvwGY1bm5&_nc_oc=AdnA1pFEfqJbimOJ5nLeENiBk_KDr81QQnt2prnKcjoorRANgN5QXqQtq5pv2QHjDNY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdIFE50Lcb0g7pkcGP7u2Kz2T8DrORa1EhFmHxJYHDNA&oe=69BAAFC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-5uUK6amBEQ7kNvwEQzhqD&_nc_oc=AdmEwhqQ9AsWaOloc6t2Qmw3PC80YMfKPzcRqAQkrBaBx-sP6hC-sDUpWDbGBJoj4Vo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNvsSQyyltx_sLa6-ZIZYiFiMdUQJfibxx_Wb240FwfA&oe=69BA87AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty7LlddaiawQ7kNvwHLci-H&_nc_oc=AdlsuHJge_2QbjT03a7p3VLhTSX0sbfU1mj2VY
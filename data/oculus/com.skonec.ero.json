1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-azgKm8BBvEQ7kNvwH5r1bz&_nc_oc=Adn869rgP3l7cOktKelcp9qo-7o2Y7_RMQ2M8l2ExSZygKEgFgGW3XLfKwv7Bur2-mU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAof7_CXtsbgCgBh1o0NIfOy9qmttDPETNGdcBwH4wpg&oe=69B00B5C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwtSjAggPkIQ7kNvwG0nSod&_nc_oc=AdknCCkHXmJZWD4KmGqGdduUcpm-Ba-LS0S1GTY_3CVlffTrwuwHnXjxuDT47HHdIlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyPNkybnQ1cohskGIBFqxbtdCJIcvwKHTme9VwnAwGyQ&oe=69B0090F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiAXOBeWu2cQ7kNvwHcW7Mh&_nc_oc=Adkk8B4WR20tf4NX92QLNAS3sx2CGqN71N_daEILJGJVs9-nL_dytN5MRljfbz0QIak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7jkzUefyR1x0oVzSQKsngi6sIcN8cMtH_J49dYxSmUQ&oe=69B0079D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0jI2c0y2MoQ7kNvwHOjI5f&_nc_oc=AdllgYYBlymFISAHpLaD4zr3eR8mI7RKw4BFiAU74pNIpffPG6FruIrqV1okii9XeCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpJ7GySiL0U3M91Exjf7RYzRC4fpc0MVF4GEnUzPduvQ&oe=69B023C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=difiBb_Z7-8Q7kNvwEDRXxH&_nc_oc=Admf5inw2ll_7M_OsKjcvVSP7IhKlkCndulxr9yOf1fBPIhkvXNmHOgOJKB6Z8U27ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhSh_74MurrSU7CZmvVLiG__n09bXzRbr6N7gOCOu6Jg&oe=69AFFBAB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz8iKELa47kQ7kNvwFlY845&_nc_oc=AdlhsURl6XMR8g4EARilMEqICdmS6pqFoPBqdF
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD8xJKj8XHMQ7kNvwGwRpvc&_nc_oc=Adk3K7ik-6clTBY8fzbafOQ1GeKhibAAYYWmDkok7A_49AiJ2DFrfurrbNdxVH3WBXg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aftgzg7kfnTSVQR7kyResiPyD1I08brk3tFeRNVVigMB8g&oe=69A18ADC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVorFH0XHvsQ7kNvwH8XdiU&_nc_oc=Adn-SkNXoa4PKOZ08FCIpZlJK50aIaAmJtyGSSAzLjnE-RDX1HSxn39sy9Wh4kiqUhk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu5eFGqSpLkFAveyexyzfPoSG-r1KbBiUqUA1J7dn4ntg&oe=69A1888F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_siC2sawbAQ7kNvwFdbGp0&_nc_oc=AdlHeoMzWUBxwH3v_Ry6ULSkicAL7pPBwTuHmPsbCAXYcb4ZX7sPVKT0QJLHCqla8eY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvTkhRp2XhCvihn4Ram2OFLDzWMu6CWIUra6Q8V5B-KwQ&oe=69A1871D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b54BlmXeyJQQ7kNvwGIO9zg&_nc_oc=AdlVlArq2wmH0pXbyBbdxC3v9NptrofxvwYLTprnl0-pyd__jYY2ImPyVv3fQ7xo91Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftAjLb_HBWLSF2dYWQOGSSZ8Zc0n03ysHi-StoBu8zOCA&oe=69A1A348"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPDBGXL1VKEQ7kNvwGOMZw5&_nc_oc=Adn2uFOiU9GDWu9_RqHgh5OfDVSPhiimw0lAVIiLZIAfzoJRcb1b-r8JX3-9pC2h9mg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsF-HGU_ExyI6Z2Bw0X0DUTgfeNjlWlFfmBaGPp16kZyQ&oe=69A17B2B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A56edOShOEMQ7kNvwGL4w1j&_nc_oc=Adl7tuTBFeRfJYUrjvgxdIe4ekO3nbLFxeccPY4fPRJynNpY3yvEL8be0nma3pW6lXQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv8GwAf9XHI-vyxEC4xyw7Kr_epHQjHjRMkaRMTYOR5
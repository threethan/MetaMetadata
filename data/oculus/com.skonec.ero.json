1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz-Vv7-ArMkQ7kNvwHAKssI&_nc_oc=Admj_2LzbfvRtrVPu3J2Nez0SxNpxGVzS1O_6mpB4RCFbJ-OQtFCLwnDVIbvHY8RvMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1sjoqjw9MnXK22t_bxbhM9IU4ucIHXPJ_0Pu-ZMmMPg&oe=69B7F45C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8pLb5wXMaYQ7kNvwHz4Ufi&_nc_oc=AdmFrEMWNrU8y4RlA_IY7Hk-0QKFpYOqCCN3ki9_JALm7ocipNGG6zZkfTmrGvMtxII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7grALrQBMTg4cz3cv9FK0j1NmD5nFEk5gqFNm1nZLAw&oe=69B7F20F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP7KC4HmUxYQ7kNvwH-KE5v&_nc_oc=AdnRMpKntuTQEzOWEd2eVYySmrWsgUOFJUWbp-2bb03RmIJ-yUCzztRBdQZ8w1atX30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9n1NzUGNkiYqLoG2JWECrcCNBk-pbc_03mE6XLEBXnQ&oe=69B7F09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFWYZhHeLG8Q7kNvwHu58hV&_nc_oc=Adl0sidatp9Yn8RLsYUwDxxRHmxzFHxCtb-zAh9r_tJK4FBFgP-HBi5SPXdhJgXpbzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwerGai18qZyXAJrHNYx5kfhgb8zBJQ6RUmYcWSA1QLJQ&oe=69B80CC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM1-yawGLv4Q7kNvwHjcPiO&_nc_oc=Adn_GNluko-P5qkdVCH6VwIZrViAauOtHO_2uEyRTtpyxoA4pzRGQAR8Mb92SdO1vh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyciLxG0fCGqGpvNXQibScSagfy4wIrQo5nik0zrucGIQ&oe=69B7E4AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNhxNoC8n28Q7kNvwEcy_0K&_nc_oc=AdkM4FXAT_MrCDEf4w2hRnHzfjLG7TizrkvDVr
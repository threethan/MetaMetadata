1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-azgKm8BBvEQ7kNvwGyUOdm&_nc_oc=Adl17kCzrMTh6b2MLaTANUADt3m7LvWeShNT1ON5lyotfJyGdOsyv45uZoGGSaec16E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvLn9nNextzZqedXhB0CTGvtvrc8DfuOzZ5jhboIbQzA&oe=69AD685C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_OvUWOsTjoQ7kNvwFRonX5&_nc_oc=Adn7I3J9mP1WpN4KEjHOnHULfnojI5yhcxOYSRAQB9MYPK8HAepe44hAb0Iyq9JPTMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTGgGowDyZYl2fIEiQ2kse8akGwsudTbYTtuC28ML8qw&oe=69AD660F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyLECPDBtMQ7kNvwHCk7Qy&_nc_oc=AdlBU6jnaai4byF23gogseQRdRQZjxzI7assPlIEfK6QLG0qNreoBqvYUqtZl9zVOVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9E7WlrvdtXySsjzuMCQD_a1Ms72e6RUYbH_iTP3JV4A&oe=69AD649D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0jI2c0y2MoQ7kNvwHtisE8&_nc_oc=AdlT8pYkNXD-7RRCq3J7RokoFVwYW5D9sisCIEFtlYcAb5XqkC1ys0ixQ5PumO961Dg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPHRXMDk-zjpU8IXlwU7MkpEwD779AgJnomq6mC2HS8w&oe=69AD80C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=difiBb_Z7-8Q7kNvwG7FIBA&_nc_oc=AdlsNGyY1r-lwtMaTDFYZ1kL7MhpAv6MIrCgFjoXCQY505kS8JUZ2oNjOoXRkhBNgtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiShZfC7JMyQLqgDAgEIHXkBfh67M6-PEhkC31YIDPjg&oe=69AD58AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2OYLPVkwzAQ7kNvwG9IKpa&_nc_oc=AdlUORUbPGZZLIjhVjVSPcGKiiE6KKJ0f4TYKR
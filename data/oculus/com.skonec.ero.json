?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Lx8Auv7_gQ7kNvwEbil59&_nc_oc=AdkhBRb8EmsUok5qYAqWPaJU9WAGlerynxv3emZeApt_04FXM_XRxLQU-qZ9o7XySuQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsVc3MJLO26lmsy6_OUUCpOqB96ld7ZDd4k9PlpbWAHXg&oe=69A0395C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVorFH0XHvsQ7kNvwFCSwaU&_nc_oc=AdkPFvigKBsPQGHSqTe2P1Ik4qE7id3CCGx4913Vyub7W7s9LD4UywQRAI7avZDN_f0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubwoXankxsKwirJ-ebgYz6NLJfoIBr3b-2M5FpTPa9sQ&oe=69A0370F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_siC2sawbAQ7kNvwE-_OPA&_nc_oc=AdmRejewu_cdjdFILcBrygxVo3fUNAKGnVWn7Eko06D0VGt0Q-wrK9CHU53Jdu0Ogzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzZoPSp4L9ZJK79clwRBnFf2RlGJGseFVJNOQ6I2aS2A&oe=69A0359D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoEivWtNgIoQ7kNvwHOfczk&_nc_oc=AdnwUcF78jgp_paU07GouhqbfizAVs8rUWtcc7Grc2MziilfoySPTGyY5rk8Ol2CqdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9L4RCpou7Og7aMKpqPntglsi28pObPwGkK_wyYQDpZw&oe=69A051C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNL6e9vZYCcQ7kNvwG6A33i&_nc_oc=AdnqmOMrzW-Jie2rThcAyMoIkgs4MxPNwM0DkdvWfuwvvIM2fcUsaqMrHD--mDTk_Ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEwoURU92_duRnnUdy1EHX2BgtQI-7Nz3cx3SShj4qPw&oe=69A029AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A56edOShOEMQ7kNvwH5SaWR&_nc_oc=Adl4rxEMlhxv2uUXT26aXPh2iSGj2ndvf0di4xiIn6--NesnW_TaBtI1hXfSUPVGRic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveEBcAif_hYg7zhSz_S6LuPT4ZhKTdC_dEX24JbcKl
3.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0oy_bQyS38Q7kNvwGRKR2J&_nc_oc=Adpcw4Yo5woiOxh2kaHu-bEFviWK8AbrN_S76TGKv2r81u-T6gaC3eCMZN74YOH2FAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyM9Lq-amO94b0Tpm8R0QD5QzkN-6XwhsWbs55_o8j_GQ&oe=69C12EDC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64R2o6O_ML0Q7kNvwGRItpP&_nc_oc=AdqIEr8m1A2P-_HpMkVk_ou3ILwt0gmtjcdprP3m8AoTrAF0bqwo-C0bui8Pke7diTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_duRUKSH6aLSnzZxECoHU89e_3ZAPPr0LNmDCH4umyQ&oe=69C12C8F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKAOVAdtl2IQ7kNvwF3RnzI&_nc_oc=AdoA7tkOZfimBkednRFD5lMQ71UzjL0uU-oqgWLzuc6fB66I-5KfflxXELjjShpjYXE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOrN5cR10WOfmHka63wKQGIfbHSze8j7TkStQFrboN5g&oe=69C12B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ6VgL1I1e4Q7kNvwHca5LU&_nc_oc=Adp4MV-n-sRySV5k9vPgADYkwP_chv3S3ag1p5E8mcv_VK8rneg4WttdPtlXAGs09aA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afygn06TKrBJtv0-1KwnbkUfCEJ8u7bf7GbWXLUunLUTTA&oe=69C14748"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J4kBW4X7psQ7kNvwESwkLf&_nc_oc=AdrA-G6rFPJmL9sUycFDG4-5Dqcmeh0MdR4SBeKa0MlyrZ-qt2YlC6Glp66iEwPO2Nw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCdoC69C_ntNrVJDxekXvdwG68tOecc9lKJbGUwkxeow&oe=69C11F2B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmRPZMV3ATMQ7kNvwEYo3eI&_nc_oc=AdomJ54rFxcSqsiRR4bc50IK3nLbrzJQt68HWW
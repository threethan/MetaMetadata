1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLh6MoPFji0Q7kNvwHTsrC6&_nc_oc=AdmvemQ2ezQbRZg2XMcCgy6AF9H2Tu7mH3lqJaqJYulakFA_cFtLiMzRpuzboWjmvK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzvLaa6Dfpby3739DFXqPx6dmrp-0_AJ9Bus0P2uWAfA&oe=69AC16DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_OvUWOsTjoQ7kNvwEbgkl-&_nc_oc=AdmuS5D1sytab7edmCTmoTUdfDI8eqBvLhKwQDTS5opNvYmu6NnrQwRpgj1MamYvH9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7QyLIZ7q__7wX6ImPJ01bf6pztSyQ2aWAIIMNtA3rrQ&oe=69AC148F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyLECPDBtMQ7kNvwGABfyf&_nc_oc=AdnzA6tQEjAQdbZMd1UjIucXRrm2bbkKsoYjn2Pt4M_Np_eLwzb9_7mKSe1U3ns0AOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK1mejCO89ISKAfHIyu1ucWD0zTBlYVWH8hIByScH05w&oe=69AC131D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLMLiuaolRwQ7kNvwFBRCGb&_nc_oc=AdkAyP7H25nDmWkCdrhJxzLy2QYJOLjF85a48QVJ71GLhQAN_yJqAjeBPzaJjdSIZI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyN4_tNg97vkYEtFDka-hGgHZC0RjM8yJYtJYsmAuKKsg&oe=69AC2F48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnSGIM45RtMQ7kNvwHfJ1f8&_nc_oc=AdlBts1TuWKX7mkYY7XF_uemLHHkNvWmrsKWPbVGYySxgVXNANhHRNpiEK_6dw3et2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx49raRtneTEwIIqyY2L-IAPDwPZJ2d1ZqbcWhjzDHRzw&oe=69AC072B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2OYLPVkwzAQ7kNvwFNAP9R&_nc_oc=AdmUt93joaD9ULIV_SWTQ_eLdixPETWny4VVi6
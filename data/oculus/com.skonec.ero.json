zbuph5OnU93O7LnG2R0YiNl-FlSbgmPHXOdZRBUTQUV8_1ilH4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ca1IqTCl5JCFQQetp-4On369pDEMB1YssirXNlghrg&oe=6B005DA1"}, {"file_name": "screenshot_05.png", "id": "1575484332961851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yniVQCR8og4Q7kNvwFqLIhd&_nc_oc=Adov7GRQz6AypXO4PeTTsNtiY_T9pKFycL3b-2-Xz9gv1XT2r24P_32cxn6KHducJ6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU-IxXglACet1snRNPw7gqNfN3xJ61QlrnUNypXyTlcQ&oe=6B00721C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXWdvmFcUUkQ7kNvwFf4y7i&_nc_oc=AdqfylzoXH6yqxldK-fvURPJ7wA3wvL8xi1dPP4L2G-OA_4qjI77uIdIbFhEKd3JPZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPfLw_RaQdar1tiiojKldqgZLvi1kqD8hVXTJQHCgvwQ&oe=6B006FCF"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYfTyJJM4TcQ7kNvwH8e7N-&_nc_oc=AdreJeWSZ_mHcIqJ3LtZy0zJUEpBX3gKcbW9cT9eaTQ2Cwov18F9xnYYX0zyWuqTaR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLH0U6Srma5XJiwz-3q4SgEAuvzmnhXE5cxFD9KO0ubA&oe=6B006E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2KPOKYZ9OIQ7kNvwH_MQMi&_nc_oc=AdrmvUa70Ig5YCJifvdzkViYQxeJYEunep_VVQYsMmuRlWYIE5Pj-ZaHnU1pzA7RFgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScOSsjtaZOXBe3aLlhotM_jB23LHpSKsrWyFjzgB12KQ&oe=6B005248"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r75nejnn3xIQ7kNvwHR3hqf&_nc_oc=AdrYWpcGOaIstQQSxEZLs61ah2iNtCF42F7Ax2WfdlQMQS-0pKWU3vsR3ZMy5Y3BnfM&_nc_zt=3&_nc_ht=sc
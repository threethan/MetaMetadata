1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHJ3NU8AJxoQ7kNvwE2cOXe&_nc_oc=AdlPt5HkZkzlSWpA8dLO1lz5U704pwJx9H9yarwg8UyHTSTvCfikaF8LHZtqefcxLq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyflgqjwLABllfX6vkmoAIaQ0H8kXfm9zt_v-bvsp_44Q&oe=69BE8BDC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36-zGgz2OEoQ7kNvwHM1Qes&_nc_oc=Adk7tFylr76sEMdGW_rH_PMC9xTFtYjs7Af8oed7u7JG5jHOvrjDWGJCzkMbrm2spjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbNEuNnP-XbdhQyIden8taOUItRRpqjHn1QCVgkSFxxw&oe=69BE898F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKAOVAdtl2IQ7kNvwFIp6cs&_nc_oc=Adm53tYr_kkbWc7NgyvyW8wMGS_uNCl5usVqEfIXi2pKzqK0RiT3P1JHZQVwgiEHq6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwKKWXIh6fzJ3zDVRXl64jMJkDYj-z_TqJk4eY3CEGcA&oe=69BE881D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T27VMjag5ycQ7kNvwF4NnBb&_nc_oc=AdlFGKjT4otbYpNBVs_El-SsEWKFfgWoCKig8jEVUJT5WqV2lyMdYcK3iZ-VOLlIsFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxH1rckha8NfSi8--xwTwZj7XuBHEi24ERJaFuSLairNg&oe=69BEA448"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufPt2g6gsvIQ7kNvwHh1roy&_nc_oc=AdnV-78GRbtOpgYsvHcpMdugGHaUGqkbwvNt2s8s9HbIFclj-omctc7aM9i69zO0dDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3nvZzUg6ZYROhqJnAgu2paD4S_uNvCxgYRNrlrdXKpA&oe=69BE7C2B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmRPZMV3ATMQ7kNvwE3ooXP&_nc_oc=Adkd6gsGz9HhErkZJvbcOLdQtR1IhTz8uSYt9p
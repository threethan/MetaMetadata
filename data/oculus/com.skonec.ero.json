?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mQtycMQwHsQ7kNvwHhy_4y&_nc_oc=AdkQtvdZFCZZfT8St63E1jmD75CH9pSdee880mfpRcFJQD7FXLLdRXlCqnQjyCkxE7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsLmtt0FtPM0DutEu4BVe1WK8McjV_VlW5-_k-27UsIRQ&oe=699C44DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAADkD-h7zEQ7kNvwHFcwmT&_nc_oc=Adl1W5eCoDon-A0Ld_KwMLprzNw7gLuKaCU-HEPDsEIoi8g85Y9c1wAIg0hepjdZu7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afto0EIzrMfpS0gzJ6xm9TAYQvGLHFQZci9U7Y4F69EU-g&oe=699C428F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp6cV_TU-FAQ7kNvwFh_UT1&_nc_oc=AdmW4392igmEvfNCk4EGvPm9gpbY7a5RaYcT2MIiW-UM_cpQtHINAz9320VKGR6Et6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsXG6OiSir0uxrmfH1gI2NOLng5dbDch8LHB3FDl3AhhQ&oe=699C411D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvZIzJy1foIQ7kNvwHGPY2R&_nc_oc=Admz9lf9eR22zPTfYtZgCSUPFE1cn3DUvl7AZAiziXiHEeA24XOaL0N_BDyvYGrK_f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuilwwx2DBxSuVktx_CD0i0Xat1QtgQ7DNrH8j9GuN4ww&oe=699C5D48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8YncihETtoQ7kNvwETn_JU&_nc_oc=AdkrU4oCivdZuv0o-nIWOSGsK6BaRruRhkaSFoeHM96Hifjc2ZskYBcR2zY5cPtYdKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvSKtOt_q8wkR-lxUapJMHaB7LjyIM_6Y_y5zEpol9YrQ&oe=699C352B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIKGvsy_7YAQ7kNvwFYIGHz&_nc_oc=AdkCd1HJbfZn6kYYtRnVGZlMXpfwGRJSAstCVdL3t-BoCD6VWOmglJ74w97_TMNuqCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-Q7B7npUFZVdERJ2xmbabS8ReTsX4v6cW0J7t13J8
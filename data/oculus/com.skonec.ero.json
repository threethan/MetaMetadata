?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Lx8Auv7_gQ7kNvwHmMMiO&_nc_oc=AdkYpTNoWKKhohxkKlcqTWfgMqqj0ABp8vhKbVUA52CgYeTC-RZdPpoZ5wDeXQrMluA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfujToF7cka0Z8Vapt3hf6VFfvTvkjk9Pka-dMSs8QuI0Q&oe=699D965C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAADkD-h7zEQ7kNvwHSA1ng&_nc_oc=AdmOW1a7rADfynizL2GUpnmna2sAzlmnrH46za4pMjYHv7P27fAO47crc7aAw9uJzKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuY02Niplsn6pGj-26MDA-VYrzWlrvRjXACdmdFh2q_zg&oe=699D940F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp6cV_TU-FAQ7kNvwG8DE2b&_nc_oc=Adl64O5XTCdQX9ujr87qyntA8_2vXFaI1uwGdSQH8Jptda0afPkz2-2oqD_CCuYjxME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1BibEbHeIXlNKNP1chRBQWRUukkUuHhte85IJfotANQ&oe=699D929D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoEivWtNgIoQ7kNvwGI2Gqp&_nc_oc=AdkoYGPj8MhSy9Vu3sUfioW8EJCeUM-D0CpXPj0jL3zuU6WQ1y1ZQ0c7FWlkKmzo5s0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsweM0jot0-7k80O1JIkOeJ47PRErfWH3L2xHn-OX-FQg&oe=699DAEC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNL6e9vZYCcQ7kNvwFuxWZi&_nc_oc=AdmS9CMs3tPzynUenUiblaND5-saMc6MPzCfcVssLK6waMkNR4_8-O1uVW4DgbU0wJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft20QuG3TZqsaddxq3yARadpfm-ajvgS1xAumcqigz_uA&oe=699D86AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIKGvsy_7YAQ7kNvwFlLPUd&_nc_oc=AdlY6sLayECfN0Z3Jk9RcxmEvkrG96X1pKyE0O20SEbTChyMoMHryHLihP-MdUDOTEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHRpEUqAg7g_GcIvriSEbJiYhcwdWIgqKjrEqXTFPY
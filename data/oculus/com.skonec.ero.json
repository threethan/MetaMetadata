332961851", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIeV3FUI3lYQ7kNvwGb7L_P&_nc_oc=Ado3VEenXjjHqBJ9IR0QmA4lMkLay_rhkeLgk91c9vyqxEnWtaqPkQGwToPEaOuLyVQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jN32yRjq5Y_QOlmHGnmm4sUNKbqZ-ES8ldbSVdP68Ww&oe=6A395F9C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRV_jJNGII4Q7kNvwGEbgoV&_nc_oc=AdqNfiFty7O_IdlHvbOHEci4sur8scoxE-mvFjWJ7SH1UITMlkQ_7Ww9a1litAxE16Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vkKh-jpRcdtSZMSZazQgFxSpCnWuOC_-j1Z8KHiF5kg&oe=6A395D4F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckim6xtE0ugQ7kNvwGLOpUd&_nc_oc=Adpi-CgsF5HsQTMIQX05ATSbN8Y300aM_Xd6IlxyLt6Sfc4uyWEjoCaX8cjAOLkldFI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JN3z5BDHW9lyg0lmpG58x6rZK1sT1CuChlzAWWjPpAA&oe=6A395BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j63qoLbVFRYQ7kNvwFsDYJG&_nc_oc=Adp0_wV2d9mFXfJRhPKYN_wYcfW5QT5ESyFIBvlbYxU6-Bq7C6LHqyCncLxFucfS_qI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Vcvq6ktiIKNqCZUhpO2WLUclEMzBHZMJTeThv2tRaA&oe=6A393FC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD5TmU5kKccQ7kNvwEeTTvs&_nc_oc=AdpcH6IuIPYi3Ee0ZzUO62DXCSuveXE8RjvPTqiOjLrAlKlPGX6mAj_aeNv8tqcuM48&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QhJGB3lPzjkLaUE390Zq9tVO6aEXPTSdux7XJYmThsA&oe=6A394FEB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6cMS
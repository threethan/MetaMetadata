vmJwV7Y_LctlDFLH8glCNYvCnMX5Csk4lwXOdCjtO0FSkqs1v8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCjOa3QoAP9lM-NOVy5hLt2eUs0J7C_jpytJRvr26HFQ&oe=6AFF0C21"}, {"file_name": "screenshot_05.png", "id": "1575484332961851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yniVQCR8og4Q7kNvwEa1gDR&_nc_oc=AdpRA54X4OVs9Al6a6HZnFfOlfaKagJewZGBDfQYuHCKxKRx1ilqn-Kvp_SIq8eytOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO0soE4r2WqyZmjBGoiUBzjojqWPaExvtsDmGQS2QjQw&oe=6AFF209C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXWdvmFcUUkQ7kNvwEV6cRE&_nc_oc=Adq_9KOljHJxHxGBvgAedE3-A4LPnmQ29gr_vpTsyPwXe-gxXEkgVZ_ojN36nE-wZPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyXgnhBr2exMHF2v0SLblKXL8RD7MzLNzl0zeSwlrY1A&oe=6AFF1E4F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYfTyJJM4TcQ7kNvwG8F-7s&_nc_oc=AdrpbyRSCq_cCScG-K2i6DkPuvTWmNQ0sT124LYw1vkoY-8Pi64ik5r8XZSI5cmCsfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdb_aAaoHn-zRi3gOvI2vuAGWjwHMtXzA-NiJJRU6m_Q&oe=6AFF1CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2KPOKYZ9OIQ7kNvwHjPXmE&_nc_oc=AdoBuyqLHzq70wNEqyCnte4PHtl6RIfYuALmPP_aNduc4t-2-oNO088bEzO0M4pKsGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKaGgi6xeI6q3Bwb24v7DD3uiCTOHpw-bEldk7nPHknw&oe=6AFF00C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r75nejnn3xIQ7kNvwF_XWAV&_nc_oc=Adqp6j1wVCsxSYzdEuib2yuactjsQDhScyHjTxwbzoz3VinpMA0Vl7G3DSJ_ziVA1Qk&_nc_zt=3&_nc_ht=sc
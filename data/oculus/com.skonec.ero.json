?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD2I4M6tRwIQ7kNvwGS5YKo&_nc_oc=AdljUB0Woi0rtgp9qm6XwxmQtS7U9QjP7SmZSaPTif0ox8NdLAtOqK2GdIWgCu4g1BA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu9MjSpXWRZ1_uxncMUVAu8POrUFW1mgu_t_88mFAxkJA&oe=69A57F5C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUZSGJkDx5AQ7kNvwFZnnFg&_nc_oc=AdlAFwIBXKaOr4unw8EkgXpI2oHVYOr6xIYXm99b-EpKgP50tuCSCEUp70h7dujAqnM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs6Nokf9_RcNnfl_68S65Syzf6LaL-_CG8qISMfP7qKAA&oe=69A57D0F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C983YQ-J2u4Q7kNvwF-XXah&_nc_oc=AdkW55UeDT_OIy9rDyF-9Isj1nRdDeV7BmVnmPJd6fI2A8N7Xi2F6zF7Tf4WPU2rWJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuQ-9bt-Y-smPovnSC2PPCLa_-iW2bZUKWJQ_IZD4WRgQ&oe=69A57B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywARpzctZQ0Q7kNvwE3dox6&_nc_oc=Adn-KA3kSQoXxQw-Q2IOaYttuFpyRHGIxnIbP5CB1qkgVqvUiV2DI8h5_rn4VWFb0S0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft1O7Wj9VCnOMvBdrpkKaUNzSPWw2O6-WPFsJE67Fxpgg&oe=69A597C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKWmI58cxl0Q7kNvwGTkLB0&_nc_oc=AdkQI35QZWBmTdOpD9ThPGYOsY-2w6lXzNkGwifk0i-cQVj2h7v6aK52f8xHmPLYQKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftz_XtyAldzQSEMtHQ5DH_9WxEX4bTpD-Pibne8jHd83A&oe=69A56FAB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3knfqJ-u3kQ7kNvwH8n3G9&_nc_oc=AdlCYnXgHDPfdAgJp-spdzRoB8Bop34ssdX1fesfvTyKC_eS6071qrIPBFlFFjI3-wE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvHulUx1IjGMFxsMF7qublfoONZY-fLMIscicdfdup8
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aH4ACsiIJcQ7kNvwGtEPtP&_nc_oc=AdoRCV4FhckFfKenmBX3TNvJ1GoVRFh38aQ6-7-ZyZCEE3SMp3z_Zv7dNCI763JaWM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1u7TQRO8VGqGD7CnYSCHCEHdtkjHCtgO8PmFCzos8kKw&oe=69F0A4DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhW6JCpW34QQ7kNvwF3usTv&_nc_oc=AdpU8zATBWScPowbXNzY7R1hFMc3y-tY3kHsgvffj1K7K-zHtrKzY21hG3fzHPu6gSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2jI8jszhT5w6_5NqUI-q4_LZKQhxA4mYFwUTrh6XuJ_Q&oe=69F0A28F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfZ3NB6YAS4Q7kNvwH9WdKy&_nc_oc=AdrI9uNjBCBL7Xre8TgiT1myEvP6rFwscqjR-GjiLU5vqvhU0RnQo6VSov1LzUEMhw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1DwUh74x3RccPSs2ej7eQ2LswTX-qsKlxYb7r0y_VVfA&oe=69F0A11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W0N7jk6mC4Q7kNvwHA5EH4&_nc_oc=AdqL8MhmkCXvHJ3r5retvQaDXUyUMXCWU6gT0snOg9LN-0sjudjTsjOAWKG-dGIGOw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0L7aLbTCq6y8wgWMXvVZQwzGndav5iM7x13rpMWLXFiQ&oe=69F0BD48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLBKqAifz8oQ7kNvwEsg68-&_nc_oc=Ado0JHIdOl4FxP9vUKqZ6YUvjc9k4DgSy69nRiJfPb_zSs9cWzNp7EwopmA2BpZImDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3WYPZ_4f1ZNSjYzihxPv61ack8ebH_ekciFP143sDQ2w&oe=69F0CD6B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQVV11c966UQ7kNvwE9vpGE&_nc_oc=AdpcWnw_r_REZBX5jGmUqx6ZokpXxdxlkFPi9TQ7XnlTLOZ275TD03rTNcolqkdswOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2Ghj7y-D_wvSGw-Vv62y7lV0XDzL3u8btCt1Q9Z8DL
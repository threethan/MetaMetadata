?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnDVTqYmeZQQ7kNvwGL3ZUv&_nc_oc=AdkOkil5zjDO4xXI5Qbz3HAqtnMG7vNTIRhiZrO90HIp1GxzR-VmIRb5IyQNIjt4DyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftsFjoPrMH6VcqGl8E5UQtgfJlyQlVX21IyuFyBvKC4pQ&oe=6998505C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvrJnRnGJ8sQ7kNvwH7zCDK&_nc_oc=AdnWrREp3TKcEf_lUdxAuqWPHJVSiZonSComURNiHThPXaczoKgq_a-o_p5T0vg4ISs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRPJeTlsGQph7mUTErtMeLe5OYG2l0NPeMVkn-_YeF0w&oe=69984E0F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdOx3oKa_AIQ7kNvwEmdQmz&_nc_oc=AdndggD9M_I1e-Mlqj9_PqrJ2ndif-dw4IeIjAj9CoWgLnbK_n_O1Z56pcSMnPwSQc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftwcyeQS4xC5GAZGJYOEH05e-hfa9sqU8dEuuQh8A1m1g&oe=69984C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZMVBM9whTsQ7kNvwFlrRvg&_nc_oc=AdmLg3m3LnvVP3ij6zU8fsvpa98_dWmKY2MztuTToeSytkKjWnCjB4ziTV6MpdA_Yps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv5cpC_1BAhA3f1_AKrQ0vcmvAr2pKJsb8Pq4lzXB1I1g&oe=699868C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKsn9Q0-NMcQ7kNvwHp2aZR&_nc_oc=AdlHe_OGgOxfc8zo6JKf5DrVvIS8E3ihancSuK7lTyjWot8AZhZa_YSC7vfhVOtlCtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsAlFuI_yOQKISSmCiNdLhTgmd6gF9CxoK4LOCTrhOhUw&oe=699840AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PpH9dIlsikQ7kNvwGeAAVp&_nc_oc=AdlW_VB1XMb3cT_6K9BHuA1SDkcBB5IrY5tfkBeYhdbfXTVrFyJCw9TxOP8_W9P5RSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvsPQ6U-SaBb6onkoehL5OpPdJC5HvaUgYoN--pZv_Y
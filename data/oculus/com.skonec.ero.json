1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2K2sjg6IuoQ7kNvwEQzRM1&_nc_oc=AdnuuEZi5gpTA3jmjxWjwGU08qlJJ7psZChT-EGkH3SuCjCgBHzYA1YqhK_l-Mpalpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM1IIvVkhdP0bo2nBwwOVwCVrsXuTQJnkuw8aaZqlUZQ&oe=69BBE8DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36-zGgz2OEoQ7kNvwE5emQz&_nc_oc=AdlTjcyTN40ZwYM2uqTAPhQWDb95ISeFBioPh7lrij3rCnHIJxCFWiU9m4c0Rn08EpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQPpH3z95odlYvd_gKQAlNoEIGRPsjaNObnk4dlaCSyg&oe=69BBE68F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJylVs33qEIQ7kNvwHr6uvh&_nc_oc=AdkAb3IgP3rxgCd9k_mPziUZwTWFu5aeY4WSDzYjaPcuN_n_uVzyM5UTDQBeWnXrNfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI01mEjxmjRGdn3rfFNuBaVPOGF6TYfaxF_RAGnev48A&oe=69BBE51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XuMGGlsfTsQ7kNvwGjqJmt&_nc_oc=AdkPhNGcanF0PJAIZ_LXvuJh5UPOuoDdaUNN3JzFX597KvB0cqpY6vPhA3_dP7wN9tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPAey3n39kTAueXckeYWnXuQdmlBFKhGOb2o4oB2Yakw&oe=69BC0148"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-5uUK6amBEQ7kNvwHAAI0m&_nc_oc=AdlArzi5qFJycW-wkpOiw5jRjd4Vz4heDrE_M0-zs8XK6fnkfCiuQwzq2Cukq5AfYR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypDKd8XCdpbDOI1kmcHOZ2dFlEhVFZhsHIRaE_8W5bdQ&oe=69BC116B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty7LlddaiawQ7kNvwGbD9oL&_nc_oc=AdmETjmqq8v9cVqVBWx2f0cixJiCYHfnYfn4qQ
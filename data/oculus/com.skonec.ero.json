1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz-Vv7-ArMkQ7kNvwEz_M4b&_nc_oc=AdkvEdUY8xJBNxZHdb1ZdBJ-AILE9DnFtrE98FevAEXSNXq8_l6iGNyrYdVRB47GTvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr4zZDRTAZ-b-zl5PWox77BoO-WOWnbnLqyCwTpClrCQ&oe=69B6A2DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M71lb-kx1y4Q7kNvwFAKz5f&_nc_oc=Adl6NUfq62jvIXSdlpJlcPhKLlW6nHSo17aEAw1-FLG1ImrIlToap0WIPdErfOaVGgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzfAS8_A4Vy2pB9S3kPcsfmTdQjp1HJ2Ke1lmn4udfXg&oe=69B6A08F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP7KC4HmUxYQ7kNvwFyMGXr&_nc_oc=AdkYZo2tb4hZ8cNIFTmRlK4fXY8XKbh-J0d0KYdtfaMkD8O9LFEfZNP4UXqzlyXfypo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiHEf7G5XQGsd-geRSVvVqAXDZiUpRWlhLWDP7gPTOsA&oe=69B69F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFWYZhHeLG8Q7kNvwGr4C4I&_nc_oc=AdkuUDpw9X6PZSMmV-K-JSydp82vY8mqvGmlBt_ANLqAThlSrD5Vnil2qoCxD5ekhY0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFBTeiBJ1dWDFsGNG2LpMfUV2otTwA18wPLhJu4VREmw&oe=69B6BB48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM1-yawGLv4Q7kNvwFvwHaI&_nc_oc=AdkZ00B7zwpid389Go0pBTPR0cVw-c_sKyrP4LmiB9dCkYZ230Xhid_pp0_4t5KRVSU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzh0vn4g5UapThMRhsVtd0BkEgzIWPEP4VIIGgIGajhNA&oe=69B6932B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNhxNoC8n28Q7kNvwGosjLD&_nc_oc=AdkG-ElBLB-frA9-7fc3ttgY5_0VxPgzzretOL
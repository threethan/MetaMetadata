?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mQtycMQwHsQ7kNvwFDmXsR&_nc_oc=AdkIyhYlWy8eBQR-X0NoUE7_4ZZbz3-r85EaPEPDIwSfFcyk3_wwE4STT6c1JKofk1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLaoahYuPN6NigITHyU7SCA-4BW1GWQIW4HfFszlhTGQ&oe=6999A1DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvrJnRnGJ8sQ7kNvwHTbJur&_nc_oc=AdkEKN64ixXWRqU16YxHTE309b_PYMQITtLOreVoaD-jirOyjjflU0yUnK1M0FrQHTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGXCabej-TO3BtFPCFWgGqAAmSQgmBd72osDi7qxmh0Q&oe=69999F8F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdOx3oKa_AIQ7kNvwFfjKyE&_nc_oc=AdkNWIgv8rjTdzrEs2Fet1ivHY_HpjeIq1kbgl91MvrSl7CLoi6d3EY9fWGEw6tTvbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsoXwpxfZajU9ZkaMGSlKk-uxMAIgxZFpt3WZJKBSs3VA&oe=69999E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvZIzJy1foIQ7kNvwHopLh8&_nc_oc=AdmldncdwYJ9i7gDG0_QMpqsjVdatiKtcssea-1X0Qf2BKcHLXyLqnk3UKQY87GJxlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsssKl2Co37zCbbsHaKrz1JAL7L54-xmmhWoQnzoZEmbw&oe=6999BA48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8YncihETtoQ7kNvwG69bwN&_nc_oc=Adl1HQ40rZcySo5hr_W4NqENb088K66wcNNdn5Z0K3BfqxsrtVua9xXGSkAjBWqGpJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWSUstn2Ydi7V40RvFZeiFtyUe9qTLcLkueff2k8iRmQ&oe=6999922B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PpH9dIlsikQ7kNvwH4l3K4&_nc_oc=AdnUZMeHdnkmLmaaor7myTXeJ9Skpm13m04JJDofvysleqNTf0uJpvD-TrNWoKHuknw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxGE1k_ElTj3nGMbjj91s4aWnQaPiEoHS_9Xdufbmz
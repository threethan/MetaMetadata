?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD8xJKj8XHMQ7kNvwHfGs_X&_nc_oc=AdmU4YmButiyT1Y1ETIbPC1v2DUHxFnHCrl0G8Un5XGktuDWImmzyUz2SVlFOuoFWHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMR4ygv10z5mk5m_VjtABxGTAgZKZR_gpCHeNsDnZbwg&oe=69A2DC5C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVorFH0XHvsQ7kNvwH2Czj8&_nc_oc=AdlmrET_tbaroIGf_ec_DK4OsltibbFrCISW2RqrOA3ds6nR0RDWgDRxpFVApuqOq20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJWhgXDeZsibnG9Ptf9CXiLA710jJqsBsiuA1BwcUY0w&oe=69A2DA0F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C983YQ-J2u4Q7kNvwEJYQju&_nc_oc=AdloAHbXsYxi4d45ODWpKk3hwJGAR4Wlj61IREcvBtnn2UXE-SPhI_Rrrw30tjOyHkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsnLV_-tHjocjSySbiE_UkIOkbuqWw_h-6Khb3Uj9hWHg&oe=69A2D89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b54BlmXeyJQQ7kNvwEK_umO&_nc_oc=AdlGsadDWoEWM1YUXNTk9QCKfTSnD8acfDyyrYk_5X8MR_nJN7kopF2-W99ugKPBvck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftROGOlh_g3cgx_VVUFLLggzT1B6E8aTbb39GfxbkB-lw&oe=69A2F4C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPDBGXL1VKEQ7kNvwFjcDnf&_nc_oc=Adl7faqwoWH_JQ7xAZHpWPNa1jj7XhsIQpC6_zkFG8RURS8kaULm1WbQO7ZZvqrHVzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftew-1EvFDH5lV2_n-P6l-1IP9zqdf5wT8V-9sRWgFQsg&oe=69A2CCAB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3knfqJ-u3kQ7kNvwHiW8Hf&_nc_oc=AdlhM5KAwAAneETyq4d5q7Q1wpV7cwp3jOnlS_WL31H-JqvIBK4lH8Gufpg8xO-5m18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWVixribHq5P4rSePH881_XUhlr4fCawMW8HMYMJrn
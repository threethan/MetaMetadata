2.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLh6MoPFji0Q7kNvwHC9Qzg&_nc_oc=Adnm4BUqXfCCV0dXmlEjXI5btE-508zJ0Ewogf2OIeIJ2YQXezNaogOASsrX9uV0j_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuKUrueRqC5bRnVED_eLlBiv9DS-bRfqMjYrOI0PuBY0w&oe=69A973DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4smxUVCr3gQ7kNvwG4qAxZ&_nc_oc=AdnPdg0AywUPI-MHZI3cxN0unNwn-RpXAa_gwjNTOkutdfWZbZCmjg8JDGyHHtK7ans&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu97C5G99vTSZrExjcW1SWdadni0x5YCc9GKfvScUF9vg&oe=69A9718F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLHJGAdqOsQQ7kNvwFsPFTm&_nc_oc=AdkJQ502bFqUQy541mFiAsiE01p85vaWR3wor1BRGSDCZUJjvd2J4CGpYiSKUlpILAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuyVOh4_wW-hH4MxgpMDR6kvPQreU5XJhj_yuS9fkmqXw&oe=69A9701D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLMLiuaolRwQ7kNvwFa82ST&_nc_oc=AdlU1mxSAhq-k1kF60kgajAyUYjKZEAvqD2k8nlx6LZZvEIeoSNMqza2TJZuhnK6iB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftmIuHYcWNB4hiZ5Tw50pB3OFCOsDbijLyOnJGyf0UxRA&oe=69A98C48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnSGIM45RtMQ7kNvwGtrO6V&_nc_oc=Adl10knIrANUDBkfZuZYKvebq1LJnSKXyOESNamaZQz4vVw-gtCr2tcmY63az-GLHMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv0ttPbcO_K761wCyj2p4_4opYh8L2FtbrU4RJ0Bjw58Q&oe=69A9642B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sajs3wZzsLcQ7kNvwHseNwU&_nc_oc=AdlRjAmQQRU3bgntGkIfU5lMPKuVExa0o52NDz
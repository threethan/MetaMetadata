324vBirK34hd67hClXdCEvHSeHqlvTHq5s72iAsWKncYPlgAwTY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZSuIN1KyORI7i-RSCksxB_IAHXJuphi2WeB3wRnPRGA&oe=6AFC6921"}, {"file_name": "screenshot_05.png", "id": "1575484332961851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMkqAGdkAAIQ7kNvwEEUGTi&_nc_oc=AdrXr7tRBjhMTRL7qor5bzIBdYBwGBtxq_h47gfWFegqFT3vzJwt63f2Me1hSZ-LQ0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDkrKGAEOQSiMqJ7DyBURLKg7zqAz7iQGBX6DEaTuwZA&oe=6AFC7D9C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNiSi6_J7PUQ7kNvwHm0Uib&_nc_oc=AdpadpTLKDcAjvAGMJ4dQRs7z5Ah7E24DdUvBEJO2TyorFBUCnH50cOwy-tUCT3LlNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW00BSQnefCycUF3jtGBiYjU1GDjoQJSLaTH45rORhHg&oe=6AFC7B4F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r32M0221JkwQ7kNvwHM3Twc&_nc_oc=AdqrTXLN2Zn4UjPXIua_5KPFhC90rDbYMr9oxGGCEMDbEzwubI2k3KgdVxl6ihfmzLw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpVb3VkLyD8EtOzI2VhxRa5zF9D0goENpfmxdsqDn3cQ&oe=6AFC79DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwnZt-GkiesQ7kNvwG8nIk_&_nc_oc=AdoCNGZbpceD8T0PYWu3aCVIjhI8IY8vKFIK1WrZpr3LHsoB4UAOS1F2UhCXLlps4pw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjPanm0yeuXu1hLEHrLoeAbE69gBnQZHGmsKtccZ5MAg&oe=6AFC9608"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ85OmBndD4Q7kNvwEOMQoq&_nc_oc=Ado5ksFwcudNAfV2zfiCOwg-_ZMrxZRWpEiB-975Cmr4QSSdKvSJ1W07N_tp7akF01o&_nc_zt=3&_nc_ht=sc
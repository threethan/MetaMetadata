?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mQtycMQwHsQ7kNvwHdxXcR&_nc_oc=AdmZoMau5hZzy07SZ72Q_j2ayBFyYqrtT5cPjly5pQ435nriDXqq7fB4awlTTtP7xak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsqjFz9CTQvpmPH9BfJ0c1TdReqJF9CPdZmX85s75j2gA&oe=699AF35C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvrJnRnGJ8sQ7kNvwEljunh&_nc_oc=AdkMfLbzcFP2zJsAGpnTKraVG47AQjS0TotY5K8QoldjcBgz6E9cZYWT4_fO6sM33ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftv5oFsiBXai0GvGZGKziFr9PI1ib3W541X85ZRweoIzA&oe=699AF10F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp6cV_TU-FAQ7kNvwFJ_oHc&_nc_oc=Adke472QElU3FE6wC47cPbjjq3b3oajkxwlHkmVl-YFI7S5_Br387QtrD81lIFmv3yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsHZPhOqvSYqHcO2UGzW4iXMai6gwuqG9J4AX-T5XOmCw&oe=699AEF9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvZIzJy1foIQ7kNvwEMDD0b&_nc_oc=AdnGE3JkbO4bH79tThUe2JAMEwegW70H47qah5OtUNFG53vkSB_6EaWTobDvJRy6tQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvHxLKLzdJHwXV3vs-sAjz_CeTV7vLzwzlYQQwLoRqWOw&oe=699B0BC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8YncihETtoQ7kNvwESld-H&_nc_oc=AdkJEPCJbN-wrusKZ25JeW2apQ8DSmySmbGzLejABl0gYXJYyFJQK2o1SsB7vmIfO3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuQsj0jpL2DeQCTYbkTLDz_NaeJCsOKVn3iesHgeC9T8A&oe=699AE3AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIKGvsy_7YAQ7kNvwFrrjP1&_nc_oc=AdkD03LnBltJ1lfDdFzXOa4-R6s6ae39oXFgk2bWpsjVzHyZSAcl8RI6nnsMAEbcr6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvGeCROKun6OuUS3UPO6tsLYOHP0tvhImrYncqOPyVu
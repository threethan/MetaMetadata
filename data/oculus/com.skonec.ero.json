e_name": "screenshot_02.png", "id": "255320403658184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974852_255320406991517_7897575683643396095_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjXsdYAnGyIQ7kNvwGasAua&_nc_oc=Adps8VgiR0uHkGvMUMHAKRXsOVE3b-d-YNE3iUHK6PztF5I2G2GMP1eKbRHxP4kdM_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dYBqg5wGaJZBI970EZm26_81e1091sNRZN5QamJr2UA&oe=6A3FC5B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "168984949461724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982719_168984952795057_2362559546396233548_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP7W3HXTaVgQ7kNvwGYGADE&_nc_oc=AdoOnvpOgzg1V1z5t6DbXxqMjzSQrQcrlu3QUZecGJOtNuFICqiAc3j9RyniGOLLlyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jr_yBJ4K7bBMBVVo8RGgEbHVBRm3bIGiYVCiY5m4pgQ&oe=6A3FE830"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "\ub2e8 \ud558\ub098\uc758 \ubaa9\uc801, \ubb38\uc744 \uc5f4\uace0 \ud0c8\ucd9c\ud558\ub77c!\n\n\uc800\uc8fc \ubc1b\uc740 \uc778\ud615\uc758 \ubc29.\n\ubc29 \uc548\uc5d0 \ubaa8\ub4e0 \uac83\uc774 \ub2e8\uc11c\uac00 \ub41c\ub2e4.\n\uc2dc\uac04 \ub0b4\uc5d0 \ud0c8\ucd9c\ud558\uc9c0 \ubabb\ud558\uba74 \ub2eb\ud600\ubc84\ub9b0 \uc544\uc774\uc758 \ub9c8\uc74c\ucc98\ub7fc\n\uc774 \ubc29\ub3c4 \uc2a4\uc2a4\ub85c \uad73\uac8c \uc7a0\uaca8\ubc84\ub824 \ub354\uc774\uc0c1 \uc5f4\ub9ac\uc9c0 \uc54a\ub294\ub2e4.\n\n-\uadc0\ud558\uc758 \uc758\uacac\uc744 \uae30\ub2e4\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\n\ub354 \ub9ce\uc740 \uc5d0\ud53c\uc18c\ub4dc\ub4e4\uc774 \uc5ec\ub7ec\ubd84\uc744 \ucc3e\uc544\uac08 \uac83\uc785\ub2c8\ub2e4.", "short_description": "\uacf5\ud3ec \ubc29\ud0c8\ucd9cVR \uac8c\uc784 (\uc815\uc2dd\ubc84\uc804\uc744 \uc704\ud55c \ud2f0\uc800)\n-\ud63c\uc790\uc11c \ud50c\ub808\uc774 \ud558\uac70\ub098 \uce5c\uad6c\ub97c \ucd08\ub300\ud558\uc5ec \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4"}, {"
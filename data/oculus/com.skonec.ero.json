GWs0ywPza2zMkeh-u4JHY7LrR5Sx9tUc_ngjsWHCqy_EfwT3iaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaU4kcQC4ZwsnbqUZ1AHLtf52CY_21vD8iXaQjKHGHug&oe=6AFDBAA1"}, {"file_name": "screenshot_05.png", "id": "1575484332961851", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yniVQCR8og4Q7kNvwF3BkBr&_nc_oc=AdrkGLS6337xEctiOdRBSCzwFMMRkMLJ7clWB-TyvXmPFNCtpescrY7knMGVVceA6zM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiwzVpq9jvR-bzwaz-Eaff3YN0GLlZK7WNf6zDdWWKJg&oe=6AFDCF1C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNiSi6_J7PUQ7kNvwGdEJPT&_nc_oc=AdqlFAeNlEfzOpu4DEb75KIIkWCNv1XhY5_CfUrVFOsieAuW478o_CB5e65VdwdcALI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSefzjoKPt5KHL01n6o_8zKKASx5ygo81spPfD4u7NCg&oe=6AFDCCCF"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r32M0221JkwQ7kNvwF2z58K&_nc_oc=AdqnqrcFYJaoZte18KFkjAjw3kcO0X1h8YU_butdB8kz0EOd8b0x561qYOc-XX3AAlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkzl0CJEsX9SacYLDGmoY0ckP1TZ7IfxaveSAX620rYw&oe=6AFDCB5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2KPOKYZ9OIQ7kNvwGWm7BC&_nc_oc=AdpaxQ99aX8LcMv_FoW2mbBU7pXHfP1011Suw0Hq5lCdOwQvKed2H9Y8vnX_P0kH7B8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4EO485PNDoKNpj5UhaXGGdlA3Yf6q3evPWZzI33cf6w&oe=6AFDAF48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r75nejnn3xIQ7kNvwFJcPNa&_nc_oc=AdrBdu3do0Av5gutC8ROrwHcZ7S_3nn2fSva8wPH6_CliRcgiJXaxIjukcHLgTOJDT4&_nc_zt=3&_nc_ht=sc
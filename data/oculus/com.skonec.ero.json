?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD2I4M6tRwIQ7kNvwGovRfr&_nc_oc=Adm41wzknXtb6SAfOlXUfatmkFkyIJc-KdzE1VVu2IIEnkuLgryKTO75BIvs9POqDLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9fFOJO18uQIJRF7mjOhGH8jQ3tHfZv0kLXRStGSGGsg&oe=69A6D0DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUZSGJkDx5AQ7kNvwHCsALO&_nc_oc=AdnZIMGOqe81to-sciRLSCIvI7dm8LMF_Zg2tHXbba9kPIbmzB5E1G68A9wNX8JtgqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwZY0YBm0wosEWPvI3P4v8aqJbe2W5827fjMCGefn04A&oe=69A6CE8F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLHJGAdqOsQQ7kNvwFkeseP&_nc_oc=AdlUgcgRlwTjKXN22vk7isMKJDHOBJBstLwCglp4V9IQCqdsxvEorf3wAWwWx1eTTcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9Fgwv_h-SA-8SKK5PfoIPNk2JVBdDaPFj1O1X0UNCyw&oe=69A6CD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywARpzctZQ0Q7kNvwEi6KE8&_nc_oc=AdkLlt6BBO-QTU8WYoiTnFh4807mN16Wtj9Tb-1nvvytyGIwSWipgECeitYIQWqi04Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0-C-4LFiH6qK5QaZmvuRhU5A-gMzdTnGipLFBNLCwsg&oe=69A6E948"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKWmI58cxl0Q7kNvwEN1yFY&_nc_oc=AdkLIcB1jTh6dbKiOfq9e_bYytpE1DjbluJHmj1uwisSQu0PfdxBTd0G1RQydru39H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqkzLYvwr1LS-d3IJZwnkPFv3Yc1FwIFE1NI6b9PTT0g&oe=69A6C12B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sajs3wZzsLcQ7kNvwGA9y_j&_nc_oc=Adk4breMFTNbrbtmbS9iNnRW5VaznR37M6HoeYicuW2STdXzz0FB81OwYVLzDe12iX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSHYncUJR5aMTHeIi1epam1_Th79VEFF50xjJwFSkx
8MsB6NjpYrsqtYGb_zVtcg-wpQyaQ81z-axgbiSSjNDc9QYtaqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYaU-WyOunZto6ls5q54E1iar0dJoLeVc4--pG2T5w9w&oe=6B01E761"}, {"file_name": "screenshot_05.png", "id": "1575484332961851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymcgte2lfuQQ7kNvwEvPcEf&_nc_oc=Adq0id7H8HjM1PDnhTYiGs2B1u35j6cLDCfDT-Fkgjpq1W3jSzSzHTr6nJFUwUmPYlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-7zkD2O2mKNYY1UihnxFu3D-a4hrgMFARbM7B3y4cfA&oe=6B01C39C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXWdvmFcUUkQ7kNvwF9mH5R&_nc_oc=AdqN4i8Cm3J3ZIvg5fwsgqD6G8JmIfHxsRBpyJyCDG1OE10Bcl-idUnoFv6hOW6FDKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdUfGWtZQXeSOyErfuhrY_XK8R3-lP6fcJu0J79Lhnog&oe=6B01C14F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYfTyJJM4TcQ7kNvwGFvG22&_nc_oc=AdqZpj94obLMNOvHAX0SYRSSuOcU6s1B2V5rA6I2thL6sGrLanZLWg1IyV1M-zc0vxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsT4z8Ie_aoOzHMxujskCDBtoloOuM6GD6Ww_NV2c7hQ&oe=6B01BFDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtIu7QTmyO0Q7kNvwEzERmG&_nc_oc=AdrOPUVa--cIi-fNUJfhMxoBmy6_JzbGygB589dsQz4RgQbW5t-Xde4Uiqy17g2M8-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM1I4xofKuImkaIcm-iTmLz_e0aiUFgMmSkUBw9L_NCg&oe=6B01DC08"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1rVSTg7GSQQ7kNvwHrNkkJ&_nc_oc=Adpq29ydtiS7RUHdIY3xlz3vtRtkUpj6gqWVYwmuu7H7IYC0KHU4SBQMk9UvZyOamNM&_nc_zt=3&_nc_ht=sc
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Lx8Auv7_gQ7kNvwFjQ5RO&_nc_oc=Adm4Bk6tDGBTaCBdlL6FrFhGxhRcilpH--cKHWnxWvCu_yXFb3IbNU6Lbh_ME8BHX6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsYrtMj5GKDtCJfH4_HaGbHNt7soaiRZ9tdM_1ZJKTNYw&oe=699EE7DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAADkD-h7zEQ7kNvwF3Z1n2&_nc_oc=AdnipGgVeyJ0U-dbRfbquPWLK0mt5THF8LXF5N8G2tzhh0qUQpBs2a_38lavjjJWgz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuEY5aNQY465PJT8iD1Oo9xc5bBlIcBjmnkGa6OlZTU1g&oe=699EE58F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_siC2sawbAQ7kNvwHZ4nN9&_nc_oc=Adn4WP1VCwPt_wtvMqAtTHyqLmwqNzjNQHrnC9sscUfNoXdtKK5Ee8IQlUNezunKHpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftb5CwEMPbXVhLXO482K-B9jqBLX_6CprFNV3QynazaFw&oe=699EE41D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoEivWtNgIoQ7kNvwGuiHPS&_nc_oc=AdnK2LLvqjwmDHNGDQNGeR7rJxtJgGnxiwI1KdgHrRBRLMalppEuw9chE9zgK37mFUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDIxtR7MAOtmyKY57EMXvAm5pzjCqQcQSBsMT27mg1Pg&oe=699F0048"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNL6e9vZYCcQ7kNvwF-E5fj&_nc_oc=AdnhIu0IzZWIwGCv9zQCwAwlBzcD-eXni0BfvHN4xGRUmRH1cCHsK3-TkPndZkxYw8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvVzDUhEd344peK0YhvdVuKMBq8OaquM2xMigyjB2S1gw&oe=699ED82B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A56edOShOEMQ7kNvwEHCr8w&_nc_oc=AdnQI5JDgppppfvluqPhBEZOZPT-1tctUtmXdJCc_rvrIY1NxW6PixRrBXh9LBWAZDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft2J6m-P1wH4J9KB6XUY3jTDqbvUXcYJ3dua-0kEhXW
LZY_qyYsF1zDNiAhDQZioUiMWtQhtYCXPopdvBJ4DvGnlEt1A7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnOCxfpL6rf3vW5EiwMNmt7Y4Y_3RaRkCiFXxlMpUddQ&oe=6B05A3A1"}, {"file_name": "screenshot_05.png", "id": "1575484332961851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITUC3lVGo4wQ7kNvwFV83bE&_nc_oc=AdrSEzIBd_eBOvHWF8UkphFRGQxMcEZy2LD8xHpfrGCNBBO_JqAC8F4pKodszqhVXz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDEOoMqF6vVtnAcF-gt1qrwJkSehwAQupWOgKOK406pg&oe=6B05B81C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPdsMTTiM1MQ7kNvwEqcGUn&_nc_oc=Adp3yov5zsaL4cSKdVXLMZ6eBTAX_qcuKRJ-OnG7iUO6KYhWqTZnZth_8RWts9U5Yqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS0mVMGSq3CbpThagF5ATGS4xJs9bo7Yph1L0AT5W6CA&oe=6B05B5CF"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jS7C51SFjAQ7kNvwH9jtOT&_nc_oc=AdqjbleXTMiYOJ6UKjlWk_UCV-HRINLoF4t3aFRTqIWn8Xrc5ttvc3fjthT9Um5P6UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ9SIUy_VqQ13x0_lN9EFggk8qcu58ICMjGDsZriwMKQ&oe=6B05B45D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6ipwkoYd9QQ7kNvwEgBHjc&_nc_oc=AdppVB0nPU45rHZ0o8sPiPt1Ub6TWrSmPtd03oXVG_CWiRx3H3lWz5wm6leM_U4BhuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdfjS_7naXLQcRBrYpWFTl8b1XSs3ExwIZzWKIKTsLjQ&oe=6B05D088"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfUObTdwhyAQ7kNvwFj9aYa&_nc_oc=AdpA38ugzufQvYyRBQcEBkv1jLw52F2RtcO36S6oIzH88Wo83ez0Viz2CWBcN3VZcGM&_nc_zt=3&_nc_ht=sc
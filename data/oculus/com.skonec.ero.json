2.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHJ3NU8AJxoQ7kNvwGe0AmO&_nc_oc=AdnA_F7dBXjAjZq8KoB1dYv_b245wwCEoJzLrxu4eQB4EOpZpaFtwOgmz87FASgq2jI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxqm2uWSLTGWVLQwbazA3QAVWrx6AokTYQCaUY-vJgl0Q&oe=69BFDD5C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64R2o6O_ML0Q7kNvwGCwQBo&_nc_oc=AdkpR1BF4GgVP2fuRGA8FjdyBn-WyH8ArH44yVr4VfVUBCtaICwbE2OWbn_hHcY64u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzz3v3EDnwM5xa9IelhH0mzY4dLt5gDyoqW-TJi3ZdFmw&oe=69BFDB0F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKAOVAdtl2IQ7kNvwE-uG3i&_nc_oc=Adkfjqx6LR8tAHrJ-bQc5mICaAGlZKYJ-lz3ZMuTxVFrqzmVuE5J_f-k5T8ApK8TkcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQ_g2MKeKrE0Btsgj72VleyUXrKk3O01AEYdQyy_NPCg&oe=69BFD99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T27VMjag5ycQ7kNvwFiekHo&_nc_oc=Adl58K05RxQ9a-woRtyZTdwib0ERW1maR9hWk8csE8j7dLghnCdBSQYaDwAgB2Eu0F0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaRkUnGoqG9Ej1ydD6tbrWijAJXcpuYYAahzgd7N3MFQ&oe=69BFF5C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufPt2g6gsvIQ7kNvwFuAve-&_nc_oc=AdmVC_UdSpKNy9QZCrutY6Si6j9XSpfa4Phr8vA1P3EU2PQ9As267PsBiRMu2RYxCPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhbYIVSrW9uZZNke-LZinew0k0loFaNbXExOFEtIO1DA&oe=69BFCDAB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmRPZMV3ATMQ7kNvwEebQnN&_nc_oc=AdlolHfv4-Ibyd-dqH0-GMl0Ov0D1k2Mi3gxun
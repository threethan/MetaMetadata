-sin6-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLh6MoPFji0Q7kNvwH7Y9Ua&_nc_oc=AdlL7wdoBVOML7K_0AyxjTC7CAcmWtuc6GNy3TTZ5iMZtvnOLDIU_ZJglTWeW7CwMWg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXUMds0c11C923pp5NasfTCPw6oyKnZiMic8S_WddJRA&oe=69AAC55C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4smxUVCr3gQ7kNvwFh8sW3&_nc_oc=Adk7h54vvPtrYPtNT0BLQ6wAdtZ8FppueV8iQVrKSFBRPv4bDp5ERp57oHpVLDmetsU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzRT7G3ihMssPeFoFRbZwerFqejzmfHyAQJnKRABOSLQ&oe=69AAC30F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyLECPDBtMQ7kNvwGHOMfc&_nc_oc=AdkMH-UoF3Dkm-TpPAaOk7UBD6FnTnid5cXpEw8n_D0Mm0LRNMhWLJvhryWdQ7FUAa4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJzllA9D2kmQsC_UMxebKUDBuC0xp_raLjSjb3x7p33w&oe=69AAC19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLMLiuaolRwQ7kNvwHcnUDs&_nc_oc=AdlXOOtE4uuJrseHEq7eFNN2Ki4XvcyyPx5t6Kp3ht1FzZFz07BX3bBcXJ29QTfKdoo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0LDjjPgBab3k1ODTYL4_v8IP1rl7xMB4laBQE1SoMZg&oe=69AADDC8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnSGIM45RtMQ7kNvwHMpDGI&_nc_oc=AdmK1noKX_8nFswx2v8-RQRLBcyoMSvQrgb8M6nwlXcyKd4-Hvkz0UzG91I0cbX-eh4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA_4glTblyPAUi4ETnxZwY22iw9iFkfDkr6gCf6j-4cQ&oe=69AAB5AB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2OYLPVkwzAQ7kNvwE0WfdQ&_nc_oc=AdkZgNtoPSTme41lvRVJUd_vGLW8Se
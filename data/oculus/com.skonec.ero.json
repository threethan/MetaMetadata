1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7FnFs9hNFIQ7kNvwGU9yvb&_nc_oc=AdmsLNEFNWv0az-1MIupqPHvFnaQAnKO_satpOmfN028YHlRyDHFkDxZzgVvUtufwWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxR7_RzhLNJFeeB4qPZM7V3qK1whESbc-pC2BlPvcEKAQ&oe=69B2AE5C"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwtSjAggPkIQ7kNvwFyuxE9&_nc_oc=AdkFqVMxaUGdO9V_3GHMgaFlt_ZpP7ESLBAJPBCpV7bj7tHFGhz8BcMZvhVygWn0gFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDrmY8I5ZuBhHbsKnnfZ9eTXmceqHzb_O5HFScCC7rzw&oe=69B2AC0F"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBoo4WsvJtcQ7kNvwEzs4wL&_nc_oc=Adl_S0kGnehZfQ9PGTvTQdMHo0A4reUiOwIH0bpSEREUpotwY46rUnlI8Ui-r5UJbco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpfN8IilpZhsbJv281aIXHRfRgen53MpY97mfkSqmX7Q&oe=69B2AA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-U1CNzLg-EQ7kNvwH7KZ8P&_nc_oc=AdkezITQvNxbIt182s_JgT_RHC_OjdbpUMj9muk6Eu8FIW_TraQAzq_CLDhduMcIRp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpNZ5enl5OPmCzvMJOGji22ZCZulslCtgvBR6rIAww9g&oe=69B2C6C8"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdejgeraKmwQ7kNvwGjWWNu&_nc_oc=AdmF2MZZr1TL1kKw7MeQ94Yb4M6udUwSKhYso4aBc0YE5O-TRGx0Fy13O_y-pDUUpb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6MHzBW6Ylk4HYb30WNdz6EjXtgC5PZ0EULFHnClfjPA&oe=69B29EAB"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt7U7w1zsF4Q7kNvwGVVz4t&_nc_oc=AdmfpkWWXPemmkIm2kGDWnG6w79SZHvYPEZ_9z
332961851", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974624_1575484336295184_3731873507937996818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zL75rB6J9wQ7kNvwEXbjdu&_nc_oc=AdpLD63CjEiRYhmUnkm_X-ZBK4j68V63JzJnY7XTT2tc1iyVaquqDcoa92EP4y_wpt0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1K7SfxKvMMUM40KY4nzCCzI6MGAHXSiyOYmvlHAil2w&oe=6AA936DC"}, {"file_name": "screenshot_04.png", "id": "1386469365541116", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974891_1386469368874449_2457219569148898534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxKAcf1BNe0Q7kNvwFd0Us6&_nc_oc=AdqBoHKdGVdWL_ByBb7FZyn2Kv4GAoCS0-QLgkBYiQe-EpZqu1nzr4YA5_XkXKxuL98&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG3XMSl5GaPnZAZ4EZYKJ37C5C-E2-a7bJOvSmzMZBsQ&oe=6AA96CCF"}, {"file_name": "screenshot_02.png", "id": "1305994510334499", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_1305994513667832_1553642627453722891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS_JXKF3XPIQ7kNvwGvQZgS&_nc_oc=Adrw3u258gwCDTy5pxDfEeLu_PMWswXU0sNYTRBuJEwKRs43REkFVk2-NQno0pMcZRc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz7lQQpA_e0T31GaVwg0CJIF4eyvgKbHKyYBZfdHIrzw&oe=6AA96B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "974260513607698", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031561_974260520274364_8095202081499740686_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57uM7yUxRfwQ7kNvwHFaT8K&_nc_oc=AdoedUuYtBRtMm8-J9ljDJdNmyt5OgNoRZ7VoDrBY3UlmUOrCNjWU6cVsKsX577XHE8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJJkNBgJU23uuguOgxHgUhn6sOQ4u6rvWWsrYtzyHvjA&oe=6AA94F48"}, "display_name": "Escape Room Online", "keywords": [], "long_description": "There is only one purpose, Open the door and escape!\n\nThe cursed doll's room.\nEverything in the room is a hint.\nLike a tightly closed  child's heart,\nthis room is locked by itself and cannot be opened anymore.\n\n - How can I enjoy the game more fun?\nIt's fun alone, but if you don't like the game being difficult or scary, invite a friend.\nEven difficult puzzles are overcome together by sharing each other's thoughts and putting their heads together through voice chat.\nWork with up to 4 people to find and solve hints!\n\n - I want to play a game with my friend!\nFirst of all, I am contacting a friend who will play with me after a long time. \nIf the relationship is awkward, try [Buy for a friend].\n\nPlease tell your friend [room code] who bought the game after making the room.\nFriends who are invited as guests simply enter the room code and prepare.\nDone! Play the game [start] and enjoy room escape with your friends.\n\n - I want to play with my friends who live in other countries.\nIt has been updated so that you can play with friends from other countries. Please enjoy!\n\nWe look forward to your feedback.\nWe will gradually improve our functions by collecting various opinions, and in the official version, we will visit you with more episodes.", "short_description": "Horror Room Escape VR Game (Teaser for full game)\n - You can play alone or invite friends to enjoy it"}, {"images": {"nodes": [{"file_name": "mini_Landscape.png", "id": "1600719224081286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982584_1600719227414619_8259530618883852021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGhTJeH5PkUQ7kNvwFmfZ8o&_nc_oc=AdpczNzi5mPrmV5yUhcgpZPVyW4rFfHwzoxV31pfkdBo4OVUh-GeTHblRslS2lunQPo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXucitoz-ptibFTSHGMWAMbRv94urHlI3T7jx7Ttozmw&oe=6AA95F6B"}, {"file_name": "HeroCover.png", "id": "1381759549053127", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39003238_1381759552386460_2151333439904320506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEhat
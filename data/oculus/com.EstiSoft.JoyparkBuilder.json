w&oe=6AA0297E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1491980858559293", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820923_1491980861892626_2203149771160194695_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z8jj0bmZsQQ7kNvwES0v8g&_nc_oc=AdpyAyOn79NQjGE44eu6T-IJ9P6fTu0Bg8LmYQqwLvmXwd6TPXl1rUVyY1XNLa92GP8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Z8PV_eqnNEXrCpGAkazDTpJQCfYYGV1emEF3JtGR2Q&oe=6AA0124D"}, "display_name": "Joypark Builder", "keywords": ["fun", "casual", "comfort", "arcadeidle", "builder"], "long_description": "Joypark Builder is an immersive VR park management game that lets you build, expand, and operate your very own amusement park in a vibrant and playful world.\n\nStarting with a small area, you place attractions, interactive rides, and activity zones to entertain your visitors. Each attraction generates income, allowing you to reinvest your earnings into new rides, upgrades, and park expansions.\n\nVisitors move freely around the park, interact with rides, and respond to how you design and organize the environment. Smart placement and good management directly affect your park\u2019s success and income flow.\n\nThe gameplay focuses on creativity, planning, and progression rather than pressure or combat. Every decision you make shapes the atmosphere and efficiency of your park. As your park grows, you unlock new attractions and create a lively space full of motion, color, and fun.\n\nDesigned specifically for VR, Joypark Builder offers intuitive controls, comfortable interaction, and a relaxing yet rewarding gameplay loop that is easy to learn and enjoyable to master.", "short_description": "Joypark Builder is a colorful VR park-building game where you design attractions, manage visitors, and grow your own fun-filled amusement park. Build rides, earn money, and expand your park in an interactive and immersive VR experience."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24088784477451928"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1554484549720296"}, {"status": "PUBLISHED", "id": "1506105937681018"}, {"status": "PUBLISHED", "id": "1408251480549364"}, {"status": "PUBLISHED", "id": "1561967838562333"}]}, "baseline_offer": {"id": "1561967838562333"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "1554484549720296"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25464997936497235", "version": "1"}, "id": "759698199952858", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24088784457451930", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25464997936497235"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes"
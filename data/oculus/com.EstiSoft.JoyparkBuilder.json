671_712487524916312_4479753537941496069_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rt9Ji_qLKsQ7kNvwH2H86c&_nc_oc=AdoUnv4jY7AZ53d_zp3gMNXz2RoiRA6Jg150IAhsPCWtcFR_2SnwVERr96CHYspS9ww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIELSRFDoDyRFBrgtNepPprOmm6N7ZIUhdnBOrHQkSXgQ&oe=6AA00E77"}, {"file_name": "ss5.png", "id": "854314097328362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_854314100661695_8095522318493272888_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-neew4mY00Q7kNvwFx2EWQ&_nc_oc=AdoEtOoKtcf1sLVUwNjaf7kdltbY8-YROveP1m2DNtxTvZveZ_87CWw8RBIDDtmy__Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk7y6RFkHDdnqTYKFMd0yjcwVJ6BkfNSxVF0OT6F2mbw&oe=6AA0297E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1491980858559293", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820923_1491980861892626_2203149771160194695_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z8jj0bmZsQQ7kNvwES0v8g&_nc_oc=AdpyAyOn79NQjGE44eu6T-IJ9P6fTu0Bg8LmYQqwLvmXwd6TPXl1rUVyY1XNLa92GP8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Z8PV_eqnNEXrCpGAkazDTpJQCfYYGV1emEF3JtGR2Q&oe=6AA0124D"}, "display_name": "Joypark Builder", "keywords": ["fun", "casual", "comfort", "arcadeidle", "builder"], "long_description": "Joypark Builder is an immersive VR park management game that lets you build, expand, and operate your very own amusement park in a vibrant and playful world.\n\nStarting with a small area, you place attractions, interactive rides, and activity zones to entertain your visitors. Each attraction generates income, allowing you to reinvest your earnings into new rides, upgrades, and park expansions.\n\nVisitors move freely around the park, interact with rides, and respond to how you design and organize the environment. Smart placement and good management directly affect your park\u2019s success and income flow.\n\nThe gameplay focuses on creativity, planning, and progression rather than pressure or combat. Every decision you make shapes the atmosphere and efficiency of your park. As your park grows, you unlock new attractions and create a lively space full of motion, color, and fun.\n\nDesigned specifically for VR, Joypark Builder offers intuitive controls, comfortable interaction, and a relaxing yet rewarding gameplay loop that is easy to learn and enjoyable to master.", "short_description": "Joypark Builder is a colorful VR park-building game where you design attractions, manage visitors, and grow your own fun-filled amusement park. Build rides, earn money, and expand your park in an interactive and immersive VR experience."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24088784477451928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308131_1642690913017626_5878325100729434235_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEsH0b0nfDgQ7kNvwHs-P3h&_nc_oc=AdpXGETzHzM6bmOAQpS8PNQdzEbHj12vSalAbBXh
2.oculuscdn.com/v/t64.5771-25/747795579_1106196582336194_3969881172253590582_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK4Jn5ivzUEQ7kNvwETJcZK&_nc_oc=Adop1Ek1qLNRxoFsWkMsdOrXZ7FmonVWpkavADiNRYzi3VxTxK0WP3AxJuUbZ5pl7C8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVaRps7m5NYXGlpXVIqlqKIzTS3IGl2rWMnbZ9Kqvdvng&oe=6B0F0F68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vaultdoor", "keywords": [], "long_description": "Vaultdoor keeps private photos, videos, PDFs, documents and notes in an encrypted vault on your headset. Everything is encrypted with AES-256-GCM before it is written, and the vault opens only with your 4-digit PIN, backed by the headset's Android Keystore. A recovery key, shown once when you create the vault, opens it if you forget the PIN.\n\nThere is no account, no cloud and no tracking. Vaultdoor does not connect to the internet.\n\nWhat you can do:\n- Add photos, videos, PDFs and text files from the headset's folders, then view or play them inside the vault.\n- Write notes that are stored encrypted.\n- Scan paper pages into the vault with the passthrough cameras (Quest 3 and Quest 3S).\n- Browse and copy files in folders you grant, such as Download, Pictures or a USB drive.\n- Make an encrypted backup of the whole vault and restore it later.\n\nWorks with Vaultdoor on your phone (optional): link Vaultdoor for iPhone or Android to send files into the vault, download items to your phone, and keep encrypted backups of the headset vault on your phone. Linking happens directly between your devices on your local Wi-Fi, with a QR code (Quest 3 and 3S) or a 6-digit code. After linking, everything is encrypted end to end between your phone and your headset.\n\nVaultdoor locks when you press Lock, when the app goes to the background, and after three quiet minutes.\n\nYour vault lives only on this headset. Uninstalling Vaultdoor deletes it, so keep a backup.", "short_description": "An encrypted vault on your Quest for photos, videos, documents and notes. Locked with a PIN, no account, no cloud. Link Vaultdoor on your iPhone or Android phone to send files and back up the vault over your own Wi-Fi."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alma29v1.github.io/vaultdoor/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Seaside Security LLC", "support_website_url": "https://alma29v1.github.io/vaultdoor/support.html", "website_url": "https://alma29v1.github.io/vaultdoor/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1425615550631983"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2108531979780129"}]}, "baseline_offer": {"id": "2108531979780129"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795548600, "status": "PUBLISHED", "id": "2108531979780129"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1425790493947822", "version": "3.0.0"}, "id": "2212868146318553", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1425615543965317", "is_concept": false, "
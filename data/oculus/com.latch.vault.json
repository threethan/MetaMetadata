7f30f&oh=00_AQSluP0A7oGGdMJ0ZfF6D5kBGhe3t79BBdfH1VAlPsk-BQ&oe=6B0DC991"}, {"file_name": "04-unlock.png", "id": "1610567254438897", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299745_1610567257772230_2789986388822936123_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ideoH7x4rEUQ7kNvwF_0gRW&_nc_oc=AdrzDJDdczv6kE3irGe-NupQtoxEHRKDDlp2o0UX2ghqVn0P3rnODqDZ-j7x1QvO4LI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1nCC1tBJCRjembrcsWWKttj1HK3H7BOJK3inU22jrMg&oe=6B0DB6A5"}, {"file_name": "05-notes.png", "id": "1106196572336195", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/747795579_1106196582336194_3969881172253590582_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK4Jn5ivzUEQ7kNvwGvonUJ&_nc_oc=AdogtOilYw6CZ83BjgtQj5F9KuiBdtHH5CmueJ3y8MxrUo4iGHU21YgcF2EGxFb5aJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRqd8QuZDFflrNT6NGgJYK60tQgbr95Ai4rNTMNdxMHw&oe=6B0DBDE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vaultdoor", "keywords": ["vault", "encrypted", "private", "transfer", "secure"], "long_description": "Vaultdoor gives your Quest a private, encrypted vault, and a secure way to fill it. Install Vaultdoor on your iPhone or Android phone, link it to your headset once, and send photos, videos, PDFs, documents and notes from your phone straight into the headset's vault. Files move directly between your own devices on your Wi-Fi, encrypted end to end. No cloud, no account, no tracking.\n\nFrom your phone you can:\n- Send files, photos, videos, notes and scans into the headset vault\n- Bring items back from the headset to your phone\n- Keep encrypted backups of the headset vault on your phone\n- Type into headset text fields with your phone keyboard\n\nOn the headset:\n- Everything is encrypted with AES-256-GCM, and the vault opens only with your 4-digit PIN, backed by the Android Keystore. A recovery key, shown once, opens it if you forget the PIN.\n- View photos, play videos, read PDFs and notes inside the vault.\n- Scan paper pages with the passthrough cameras (Quest 3 and 3S).\n- Add files from the headset's folders or a USB drive.\n- Make an encrypted backup of the whole vault and restore it.\n\nLinking: on Quest 3 and 3S the headset reads a QR code from your phone; on any headset you can type a 6-digit code instead.\n\nVaultdoor locks when you press Lock, when it goes to the background, and after three quiet minutes. Screenshots and casting are blocked. Uninstalling deletes the vault, so keep a backup.\n\nThe phone app is free: Vaultdoor on the App Store and Google Play.", "short_description": "A locked, encrypted vault on your Quest, plus a secure way to get private files into it: send them from Vaultdoor on your iPhone or Android phone over your own Wi-Fi, encrypted end to end. No cloud, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alma29v1.github.io/vaultdoor/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Seaside Security LLC", "support_website_url": "https://alma29v1.github.io/vaultdoor/support.html", "website_url": "https://alma29v1.github.io/vaultdoor/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1459066370620234"}, "review_messages": []}]}, "cover_squ
, "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_1071752712250682_6195356680299064676_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKBjIR-F45UQ7kNvwFE68df&_nc_oc=AdrjHBKxmT88qa9_cRETj8c8hcTAgzFjUVUpKWBOnn9TFHatSodKFsf-eKdtrO438VY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVW8CKbRzHuK6D1ipVCPCB_ZZdgyhkkrEaF_5ALT2NXbg&oe=6B105845"}, {"file_name": "05.png", "id": "1350063860274097", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593749142_1350063863607430_3710475508064316520_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GJrZ3dJ_0gQ7kNvwEVgZou&_nc_oc=AdrvMi5DPckjz-6HExPrgHjI9ReycN0qt8aXQwbaz0VYL_OhoLQJX11IoCS-VNkdBj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFEAxvr1VRlIcCG0aPlElRt2rKeCFHCLIftOOYFnhdZQ&oe=6B103A35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aera Video Player", "keywords": ["video", "player", "picture", "viewer", "screen"], "long_description": "  Watch video on a screen that floats freely in front of you \u2014 not pinned to your head, not a room around you. Place it anywhere in VR space, reach in and move it, then take your headset off.\n\n  Flat video\n  H.264, H.265 and VP9 through the headset's hardware decoder. Play from local storage or any WebDAV server, and browse folders without leaving VR.\n\n  Panorama and 3D\n  180\u00b0 and 360\u00b0 footage, side-by-side / over-under / half-SBS stereo, and fisheye input shown flat or mapped onto a sphere with a 180\u2013220\u00b0 field of view you can dial in.\n\n  AR passthrough\n  Green-screen, colour-key and alpha support for composited footage.\n \n  A panel, not a phone\n  Everything runs in VR with your controllers \u2014 trigger to select, stick to scale or turn the view, grip to rotate. No reaching for the dashboard mid-movie.\n\n  No ads, no subscription, no account. Library settings stay on the device. Ships with a short demo clip so first launch has something to play.\n", "short_description": "Watch video on a screen that floats freely in VR space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://milin2436.github.io/aera/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MiLin Studios", "support_website_url": null, "website_url": "https://milin2436.github.io/aera/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1283789321494168"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620384_1763032401577911_4316351644534117045_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzyDrumS_V0Q7kNvwHwWzN0&_nc_oc=Ado7h-Jy0i8zotd9BRvJhnS3eHujogJVyQ_KFs8xXHbP_BZ6fp-oFxU55-EI3V22pvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdfFjgvYnuaERJTI84dGHT4N7SY26AxeTfssAOz4v6NA&oe=6B1043E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aera Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1790212620, "lastRevision": {"nodes": [{"id": "1283789328160834", "release_type": "SCHEDULED", "administration_status": "APPRO
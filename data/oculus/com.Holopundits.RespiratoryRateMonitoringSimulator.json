c_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HzOAllvgXz-_3ZjDtBsE2qM3KIF9QbbcK7KZCBy23Sw&oe=6A11CF54"}, {"file_name": "Respiratory Rate Monitoring Simulator_screenshot_06.png", "id": "367005485993481", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035412_367005489326814_7160952519256106619_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ1bnIQ5_EYQ7kNvwGLTH44&_nc_oc=AdrFgCbRvNeUj7p0iQ-_XmanUrnFkJH9CkwQUBgYkfWWKbmP0jAUxoGzSuBkSL5whnk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OgFOv5Q98ojF8k8RlUfyCrnPmoDAVOfmeFSUlM2Nrsg&oe=6A11B29F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1130584721390747", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75245823_1130584724724080_3393375799380002574_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPVEq-YAeLgQ7kNvwG_Jgl5&_nc_oc=Ado1CSvF7vYRNPaC-nlqxS95nU3s9GlIgsxgagkwScRaY22gVZqXoB7lXSZJ8aYdfVE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70kxH2EpeOuTR15gsxj3Qs_YA2HOOoj6JhKyctg5WnwA&oe=6A11CDC5"}, "display_name": "Respiratory Rate Monitoring Simulator", "keywords": [], "long_description": "The Respiratory Rate Monitoring tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the technique of monitoring a patient's respiratory rate using a stopwatch. This application guides users through the correct procedure for counting breaths, timing accurately, and interpreting the results.  \n# Learning Objectives:\n- Remembering the normal ranges for respiratory rates \n- Understanding the importance of accurate respiratory rate monitoring \n- Applying the correct technique for using a stopwatch to count breaths \n- Analyzing the data to identify normal and abnormal rates \n- Evaluating the patient's respiratory status based on the gathered data   \n\nThis comprehensive approach ensures CNAs are proficient in monitoring respiratory 
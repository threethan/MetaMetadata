t=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x0uGfJxw4giNz7jFjTeCgbg85___CNCbBpKjbNvBPOw&oe=6A0EF414"}, {"file_name": "Respiratory Rate Monitoring Simulator_screenshot_06.png", "id": "367005485993481", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035412_367005489326814_7160952519256106619_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ1bnIQ5_EYQ7kNvwE8qulU&_nc_oc=Ado0gD-xNizszOv1DGyTBS9p3UTgp661RyOWOab12kaq80aO-sZ9Q17wR933zWBUogM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lwqfpxvuKDVV3DqXWDxOXhjYIesHJRYEUz14tKNb0Aw&oe=6A0F0F9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1130584721390747", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75245823_1130584724724080_3393375799380002574_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NMV184aruUQ7kNvwFSTZkK&_nc_oc=AdqjMPI6NuwO4cUC86FGkfd7AbTeNfp5lgvEEdXUPt7-X6jwaEViAzANW3sH2vysiT8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HjAlF8dP4YRqpLPj819Kh3PoxUBjNCW82c7BeB6HV9g&oe=6A0F2AC5"}, "display_name": "Respiratory Rate Monitoring Simulator", "keywords": [], "long_description": "The Respiratory Rate Monitoring tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the technique of monitoring a patient's respiratory rate using a stopwatch. This application guides users through the correct procedure for counting breaths, timing accurately, and interpreting the results.  \n# Learning Objectives:\n- Remembering the normal ranges for respiratory rates \n- Understanding the importance of accurate respiratory rate monitoring \n- Applying the correct technique for using a stopwatch to count breaths \n- Analyzing the data to identify normal and abnormal rates \n- Evaluating the patient's respiratory status based on the gathered data   \n\nThis comprehensive approach ensures CNAs are proficient in monitoring respiratory rates accurately in real-world clinical settings. ", "short_description": "Designed to train CNAs in accurately measuring and interpreting patient respiratory rate using an interactive, hands-on virtual scenario."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7422961481160424"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10034948386628374", "version": "2.0"}, "id": "2420561618132474", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7422961464493759", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "10034948386628374"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2420561618132474"}]}, "change_log": null, "created_date
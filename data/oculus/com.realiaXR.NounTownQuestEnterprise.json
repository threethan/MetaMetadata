s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXZ4Jbm3qlgQ7kNvwEgjHSE&_nc_oc=AdpfRb8_PeSKzZh814CpuvWPF6gc0aJUEnkUq388yQm-lCNqd67INej0Ji3MCSw3-Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiOjiBHnTIGrYLMucTVSwCTXDt1BKyOLQTbK-hGrmS-g&oe=6B007CE6"}, {"file_name": "Screenshot_4.png", "id": "1119109833056287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468803171_1119109836389620_5409984900614964248_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojelFHB7cUgQ7kNvwG5QVPC&_nc_oc=Adrv-5e1sUN8YQA2koUMFaPZL1pOFXT7Rgaw4eDgwpYFkiVRJ2X8pV_hdTSHEQ7X-zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR8LC8LJ2zz0qceP8bexnaGa2CP2950_0ieMln0hvFyA&oe=6B008412"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOL9crzf6swQ7kNvwEjiNsp&_nc_oc=AdqZ2If9pzomS-sdpZp6vGaQ_bagucx7YtrKqDkwO3T9HLXTM5Ef95zdAJRGMDJLh7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRve16H_xWUNQUcHfdZj0wDE7rC2bDh9eizYA0exK_jjw&oe=6B007A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2VHyIePwjwQ7kNvwF0Rbrb&_nc_oc=AdrTKv7xQp4mCDZNf6cshb1fkEB62ul5Pvv7bL5iQn78qTGJlYGD5nW9mcrKoL3zI_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ-i0CbKSVlkGlKptgg_LP4erHsLEvYVhdvJRVW20j4g&oe=6B006C4D"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url"
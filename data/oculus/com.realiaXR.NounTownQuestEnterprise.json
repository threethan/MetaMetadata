s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdNZNT7DnBkQ7kNvwFEXmF0&_nc_oc=AdroQAKPptlHLi_jnJEtOsFNlu7t0hm36DZtgawEIw04M6SzjfeBqnPOIM9rO6Cnasc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt3QaS6GKlaE7fsoPp7T7m4Rfe5mz3yIzp__tWojbjqg&oe=6B047166"}, {"file_name": "Screenshot_4.png", "id": "1119109833056287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468803171_1119109836389620_5409984900614964248_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWZppHYtlVkQ7kNvwG0DmgG&_nc_oc=AdrDaGLQ-DDvBtzq6x8f9nnOwwSYeW_bqIdwZ8VvEkyJ_LtlBSEuxQ7Rn7l3sbgkv8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf52yygdtQZfSOAMjG68f1mLQIMhp4p84eFNJqXkgndg&oe=6B047892"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQR_UOjm_FMQ7kNvwEwsLNM&_nc_oc=Adp1URkt369MFwxl33lIO4cqik4jx8rUSEIjfiL6MD5fgSYKgNnu0QDMo4Rx6sbkIZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZiLqz2MeIReizU7YM_f4THonVxec5udi9q1rYUUcMPQ&oe=6B046EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZy2iMrSGxwQ7kNvwHJiEDc&_nc_oc=AdoTzvpBEsCuQBBuaj43V-9vC8yI0PGsLCQp79TPbSPX6AA2Vuag_GOii9QTPZ3mYWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrKuCWzNHBIRMyE3_9kq-ZYdn2RnqMpzHv9lNCuwdxsg&oe=6B0460CD"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url"
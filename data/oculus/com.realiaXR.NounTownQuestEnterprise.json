2", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1912663892475569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75608442_1912663895808902_1826778800280812720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEF8g-aLc6YQ7kNvwG6JU3E&_nc_oc=AdrkkQSKfhYx1TLVC2t2srjb4_h0ylkvBBzyuuKNr8D5p9o-xBLGmTGegfQ16xYpmCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af19hXCKQW81rCAbQIj9EL13Dmwz0tHTWUOINSDor52WOw&oe=69F0CCD0"}, {"file_name": "Screenshot_2.png", "id": "3556433861316388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269158_3556433864649721_8649313987559109796_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsK3P2Sa4m8Q7kNvwH8Scg6&_nc_oc=AdpjJk05YEfC9zU6xxzuq9cGtggwbBJoLP8Zw9HEIjdOrt-GiS8BjuVpk4B8cwa5FB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Bt1KMePkTwB1qfYw3AS-fqVjgMipikEf24NRJ3Zc5hg&oe=69F0A2C2"}, {"file_name": "Screenshot_3.png", "id": "1695229388065354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031487_1695229391398687_4926494555995495861_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGsJHi7kGf0Q7kNvwGE-0LB&_nc_oc=AdrO1iQ6Q_wVO36efeATCA8Ipi38nZvzGEnAP5CtdE4Afoy29uFlX3VHq7Eq94xyqGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1WVJil9WAvgZW6dEj3VXvLC1CaStMmk-WtnHIdkUe0yw&oe=69F0AFA6"}, {"file_name": "Screenshot_4.png", "id": "1119109833056287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468803171_1119109836389620_5409984900614964248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMY-SZnBgHwQ7kNvwEofSeC&_nc_oc=AdqKsRraal3FdMQQwOVdtLIOtoe6U5-XdcEU4HycxSLMxZYZvsYsQnhueh6TCJJF1Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0SJGG4aIYxEbnZAXD8pOahpxMgid6pmcYwyznhq68Isw&oe=69F0B6D2"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLI4tE8xvXsQ7kNvwH-BJ-m&_nc_oc=AdoreIRG0Ajd0MqI1aPNCmNTbGiKs9nQrICOUTNMwBWIdWSvslrBu1dwjNGVyrkwz8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2qcyY-FMyK8m3l6hsKkBqj35yrcqtAxqm0rjAXmf9CjQ&oe=69F0AD29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bErvBk4PGfMQ7kNvwG0J1PN&_nc_oc=AdqPNnBB_ZcMjJgIu20QBS4DhIQdpMxmn9-eMWEOIEJk7A9CjnraSNznl-uJXi4qpOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3L2pfWy38LGBpcJqtkIpVIJi4K3Nu115OgYxIYlPs4pA&oe=69F09F0D"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": "https://nountown.freshdesk.com/support/home", "website_url": "https://noun.town/education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "zh_CN", "de", "it", "ja", "ko", "pt_BR", "es", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28570896955857725"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3046657315540991"}]}, "baseline_offer": {"id": "304
2", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1912663892475569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75608442_1912663895808902_1826778800280812720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-xj6C94CpQQ7kNvwFM5fCo&_nc_oc=AdlwfwTSspi7RD4IJ587jmHr0SqENXZ4S4ec2klA_5ZACvf7uyJ2C4qhOXCfXpu5zgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftMOzbxzYkv5cAk2T7kx7aha4rmeY3mSwUs-itUrgLdDw&oe=69984010"}, {"file_name": "Screenshot_2.png", "id": "3556433861316388", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269158_3556433864649721_8649313987559109796_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mXKDqnfM4UQ7kNvwF70uQZ&_nc_oc=AdmJWkpNCcIAgDdntYPGiSC7O-kRjKUyFCEo6REaCRUxvrLV_V8Ql_C_5BMuWdsYGUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu_SKG6GumZplQP7yDFLLVgi0WBjsnFseNKBEY8mbMuEg&oe=69984E42"}, {"file_name": "Screenshot_3.png", "id": "1695229388065354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031487_1695229391398687_4926494555995495861_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chfcoV6wfk0Q7kNvwHz4ADM&_nc_oc=AdkRKUUOlHHD0CNLgH19amlXQlmVwPMtduaH-Ty791Pgc1bIrfMeRdlyA4WkH-6FRws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvrCyaMYwDRFZoY85nP6bpSNO3vRoms_cEKXQJ_oJr7rg&oe=69985B26"}, {"file_name": "Screenshot_4.png", "id": "1119109833056287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468803171_1119109836389620_5409984900614964248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD5PXXmdbKEQ7kNvwGc53jH&_nc_oc=AdlxTdrDA3EJ--8PS0U1Rh5Vose5uib-K-Q6oxHCpBLjkDAgxJkNKAOmB7lwXrrcSco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftTeiZtHuhntb0YWOmciNJCcZVbSQUeqL9jJfRCp68v6Q&oe=69986252"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j00_-nFZUa4Q7kNvwGLCrG-&_nc_oc=AdlZyUUe2-N6ssSqznDHMcAAyalWrxdOeerfGCU1ofQ3TkBCMnmM7V0LIFQbN-gsn58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsdQkoE_EPeJ4J2OoiL3VpNsbrNJVETcSADHFbkr1nRRA&oe=699858A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfRv6lMBJsMQ7kNvwFXrkmt&_nc_oc=Adkh3wqJ_sS49Cl5Z5_BxO33uAxF7bRCl67Ba8ilRdq1qEHRKxLw5eY3F-yAk3i1gHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvE0pK3XhhTtg_cTdAsEXtlm_W20wZISKw9Kx6nlfhnYg&oe=69984A8D"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": "https://nountown.freshdesk.com/support/home", "website_url": "https://noun.town/education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "zh_CN", "de", "it", "ja", "ko", "pt_BR", "es", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28570896955857725"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3046657315540991"}]}, "baseline_offer": {"id": "304
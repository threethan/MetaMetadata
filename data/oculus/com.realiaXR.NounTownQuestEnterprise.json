content-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDiMzNU2j80uIUp3JUfZJS0q5Z7pKUtMOUD8PN4zuSRQ&oe=6A857812"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8prOqqSmzMQ7kNvwFQ6VqP&_nc_oc=AdpV4fDkn-J250ZsjsA1X9qeHqGOZVGy07IJaFfi1m-Twaxoj6fAftJUIymimS27euQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmAYap2wk1ZU-66WjlrCehPfhxD7pJCHsu0Wi14KX3yg&oe=6A85A6A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zebgvXT6gUQ7kNvwEvgDm7&_nc_oc=Adqi6D3UtB12pIDngpvkdAdwIYklvNBXJY4nE49oest3oQyWdSJgbhR6kYUvO27kzno&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE43ZTb7k7pYBoSmSHtERZU1EJeRxh4SU1gNT9VBhiymg&oe=6A85988D"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": "https://nountown.freshdesk.com/support/home", "website_url": "https://noun.town/education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "zh_CN", "de
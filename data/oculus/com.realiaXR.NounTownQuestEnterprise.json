s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMU1QYhDppUQ7kNvwHKDzhr&_nc_oc=AdpYNwu7hF-uZKqUW9N1z6U0GwF4OB7Sc5wn6KEwZoENKOVi2iUtW2UXwetF4mf-PJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Tou8i8CHYfebmjegQHQT8AldqJ9egYRnzjJF-XUALg&oe=6AFDD9E6"}, {"file_name": "Screenshot_4.png", "id": "1119109833056287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468803171_1119109836389620_5409984900614964248_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojelFHB7cUgQ7kNvwF-0vPG&_nc_oc=AdqegMNG-74OgctSXG3XtvpqefmcjtAUhBxbDbHfI3zx8GrzsoPi9eDX-ARp3TbaxBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT01m5iOYfqXKIpmJKUIScQElf6qU6OJ2-DIbSaVGk2DQ&oe=6AFDE112"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOL9crzf6swQ7kNvwF9TxTt&_nc_oc=AdpXWAzb_6pckUQGGnxsY0RbJD551ok7E9Vn2n-oYctUBtQE5xCjLtGAAPLFCcO6E8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0TVwHimP2S-aDRcQKrQk6_q4hPy97oRypkTP3OOzimA&oe=6AFDD769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjFRVMDzi1QQ7kNvwFPMcno&_nc_oc=AdpHDKbZvFE0UZ6-bBsUTWcJiFuxY_DBgblWDInighm8aUN35sLy89lQ0HcZJa_i3nA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI4g3Yqy6hSlp2WJfX4aNDniX_OkBgCBoPEsLqRsMkEg&oe=6AFDC94D"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url"
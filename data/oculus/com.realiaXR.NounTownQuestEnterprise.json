s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXTrZ4KfJ4QQ7kNvwEewE0i&_nc_oc=AdpgGPe3t4FVs3UbQGGEjZiJbhGfejRks3dvet7_z8a5BIfTwovnGLUqspdbU8apPI0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx5Tp2jkHGcYfLXuWEGxHlbmPqhsTJqdzgBa6yS1Ofwg&oe=6B09B766"}, {"file_name": "Screenshot_4.png", "id": "1119109833056287", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468803171_1119109836389620_5409984900614964248_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApvV8tHn2mwQ7kNvwFPQFf9&_nc_oc=AdpkNLOytEbFRiYb4Fg1WMWI1ry9v50NP-zPshBOSdK1TIvMp2C1lzB4fZFFezIPkK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiR_QJ5_8TZGqmYJjRK8_7PHq4O--2yLEqxZyiac1OAg&oe=6B09BE92"}, {"file_name": "Screenshot_6.png", "id": "1151917306577950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031511_1151917309911283_9017173076893613311_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdVd_2fWa4QQ7kNvwGO281S&_nc_oc=Adrjwuav2mfVtHjdKjNHyIJH_umbGnUzzGyHnRsGlEWEzLBFs1lCasmkj-VAvY_wXh4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxxiPVpNqSzv_SupTvJGrtx--pkqDlXVTnH1wx3_fe2A&oe=6B09B4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XI0K06_q20Q7kNvwFYsD9m&_nc_oc=AdqlzYJ1ZM0kpwDqFI1fBLyN9NRYaXuhPtG4DtdwlEur3r1ViaT7o4TvfR6GK6wJO0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTE-5u6oCUfxHSxjsMxkaPaLTrP8cbXS97T_AuwkdZHA&oe=6B09A6CD"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools and businesses.  \n  \n# Visit https://noun.town/education/ to purchase licenses to be able to use this learning tool.  \n\nFor enquiries email contact@noun.town  \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  Noun Town has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Noun Town gives you robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development and opportunities for intervention  \n  \n**Built for student safety**  \n- user-friendly interface  \n- accessibility features for learners  \n- no chat functions  \n- no in-game purchases or adverts  \n- no multiplayer mode  ", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url"
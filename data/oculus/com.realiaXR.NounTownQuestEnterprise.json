etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdVd_2fWa4QQ7kNvwGO281S&_nc_oc=Adrjwuav2mfVtHjdKjNHyIJH_umbGnUzzGyHnRsGlEWEzLBFs1lCasmkj-VAvY_wXh4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxxiPVpNqSzv_SupTvJGrtx--pkqDlXVTnH1wx3_fe2A&oe=6B09B4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Commercial.png", "id": "925829306329875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974654_925829309663208_5610644407473050934_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XI0K06_q20Q7kNvwFYsD9m&_nc_oc=AdqlzYJ1ZM0kpwDqFI1fBLyN9NRYaXuhPtG4DtdwlEur3r1ViaT7o4TvfR6GK6wJO0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTE-5u6oCUfxHSxjsMxkaPaLTrP8cbXS97T_AuwkdZHA&oe=6B09A6CD"}, "display_name": "Noun Town Language Learning (Commercial)", "keywords": ["edtech", "language", "languages", "schools", "education"], "long_description": "# Noun Town Language Learning commercial license for schools & businesses. \n  \n# FREE TRIAL: visit https://noun.town/education/ to activate a free trial and purchase licenses to be able to use this learning tool.  \n\nEnquiries: contact@noun.town  \n  \nNOTE: for the consumer version search \"Noun Town Language Learning\".\n \n+++  \nNoun Town is an award-winning language learning program that helps students build their vocabulary and practise speaking in a safe environment.  It has been recognised by top educational establishments, as well as the video games industry.  \n\n**Features**  \n- Contains 1,000+ words and phrases\n- Learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Russian, Greek or Arabic\n- Play in Virtual Reality, Mixed Reality, or both!\n- Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n- Practice speaking with 16 NPCs using speech recognition\n- Play mini-games and use the auto-revision system to lock in learning\n\n**Designed to engage**  \n- Students are encouraged to explore, and interact, with learning just happening as they play  \n- Retention is maximised with our automated spaced-repetition revision system  \n- Fun mini-games make practice and revision enjoyable  \n  \n**Oversight built-in**  \n- Robust data to analyse groups, classes and individuals.\n- Instantly see strengths, areas for development & opportunities for intervention  \n  \n**Built for student safety**  \n- User-friendly interface  \n- Accessibility features  \n- No chat functions / multiplayer  \n- No in-game purchases or adverts", "short_description": "Engage your students in a language they speak! In Noun Town for schools and businesses, students can improve their language skills in a colorless world where they listen, read, and speak their chosen language while bringing color back as they learn. Test skills with mini-games and talk to the local villagers. Learn Spanish, French, and more..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": "https://nountown.freshdesk.com/support/home", "website_url": "https://noun.town/education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "zh_CN", "de", "it", "ja", "ko", "pt_BR", "es", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29058651260415623"}, "review_messages": []}]},
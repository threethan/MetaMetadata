rated_image.png", "id": "507579013262583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427670_531759543691625_309149623_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5YA74u3T3AQ7kNvwF32w5M&_nc_oc=Ado4uCMQjj4OpVjkO9CISYtvbEsDbMOi0pVvZ5SmaOak68k0mc8_WYgem86lTKQYCHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGTCxhWn7saOKU4k8weCE1vEWm0nTp2LNAgPk7rv1DwA&oe=6AFC8A1E"}, {"file_name": "migrated_image.png", "id": "319362739023585", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138835_492080730988995_381233958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dhy5H5q9v8EQ7kNvwF5YnW6&_nc_oc=AdoNRylpldDhAer3Ffx9eLbROI-h6lBhXEGROA_IOxyC_me5DFaBaP2m6jy0as-FMGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2mr97UpBuNMjWbd9S0kMnwZiClLoBB7AWikapjWw-uQ&oe=6AFC766A"}, {"file_name": "migrated_image.png", "id": "203208547647213", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449016_726753567463630_370054179_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7rPVoHFc4wQ7kNvwEWjTOb&_nc_oc=AdrgNS6xa1wi_CPf9sANor-YVLFJbD4QUt7t_UkW8ZAy0Z3OSdu1l4UKH1fsFstvuFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFd_IHn7g04rNagjSTJavB-bF0CKSLXNeT8F70ShN41Q&oe=6AFC7622"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "6x9", "keywords": ["VR", "Solitary", "Confinement", "Guardian", "6x9"], "long_description": "Our first VR piece, 6x9 takes you to a virtual cell, telling a story of the psychological damage of extreme isolation. Right now, more than 80,000 people are in solitary confinement in the US. They spend 22-\u00ad24 hours a day in their cells, with little to no human contact for days or even decades. We invite you into this world. \n\nFor more questions about the app visit our FAQ page: http://www.theguardian.com/solitary-vr\n\nHave feedback? Need help? Email 6x9@theguardian.
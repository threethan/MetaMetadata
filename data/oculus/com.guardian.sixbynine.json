ary-vr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "983216252279533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427715_104360296645899_1834293688_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoT6WI-B6cMQ7kNvwFKkpdx&_nc_oc=AdnuYWeX41Rvk-_XZAgUG8Hh40sAP-A7o-gg9L2vb6ZIyAk5jug_1utEn5u9jp4t2Yw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_6g-gIa3n_4vRbwxlttr3y13r1LVG2nYRxBpYUviSmA&oe=69B15782"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "6x9", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1462345200, "lastRevision": {"nodes": [{"id": "1723465884605996", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1073856559366835", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2809507515791494", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138832_539129402932715_1740980865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atmyiQn7k1oQ7kNvwGxtKns&_nc_oc=Adl9Gc1xXNIYoLQVmd4H3uuavlAMcHDDRYVATVvjGpW9uOW9P0JirWaabifX_rFkSzs&_nc_zt=3&_nc_ht=scontent-sj
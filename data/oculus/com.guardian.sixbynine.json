rated_image.png", "id": "507579013262583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427670_531759543691625_309149623_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qXjpcnYL9EQ7kNvwHJ28ip&_nc_oc=AdpuIue1Esgoh_Ie78CKvoN8cv5tBQkobFAYJvqdlqabvFNv5C4kFpDMQLQrfOErWmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFYjbg-UF2TJEV8iEmm12Y9QjcrcInYsO7jdgHf8mocQ&oe=6B007E9E"}, {"file_name": "migrated_image.png", "id": "319362739023585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138835_492080730988995_381233958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inLAU4RhpScQ7kNvwEQsaIo&_nc_oc=Adp6LCXe2HocsU8r2gQGkHFCBf4Ck24adfsuHxVuF4uHqQ7nSQzOHOJ86PtQML3F5Dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgv4jfBvLy-s2f3xSZdIJU-5TmP2rAfpUVpXWQ_k9czA&oe=6B006AEA"}, {"file_name": "migrated_image.png", "id": "203208547647213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449016_726753567463630_370054179_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lllI4La1PAAQ7kNvwEIEhFZ&_nc_oc=AdqFON7p4dDDFO64X2M_5yltwYhGBDLLBaQ1-hxExk_bwEyodAAGzKpDQO24BEt2hLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQrLuT7XpNYgnR7BgG7-xOq4E64qP8g39sqAUG_nCRuw&oe=6B006AA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "6x9", "keywords": ["VR", "Solitary", "Confinement", "Guardian", "6x9"], "long_description": "Our first VR piece, 6x9 takes you to a virtual cell, telling a story of the psychological damage of extreme isolation. Right now, more than 80,000 people are in solitary confinement in the US. They spend 22-\u00ad24 hours a day in their cells, with little to no human contact for days or even decades. We invite you into this world. \n\nFor more questions about the app visit our FAQ page: http://www.theguardian.com/solitary-vr\n\nHave feedback? Need help? Email 6x9@theguardian.
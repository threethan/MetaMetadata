xSZBBpOQyc92iZ2eRDEGXuTLdcD7zQGhH0KRYGEi8w&oe=69A6DD5E"}, {"file_name": "migrated_image.png", "id": "319362739023585", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138835_492080730988995_381233958_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql8FrJ1UM94Q7kNvwGoPOwu&_nc_oc=AdkhnxmVaHjoiG01aMuhoa5UYkIeqOHFynBz3phuq7EOV0zqIGOkUvFu8jZoIjOI88c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsuAtXXpayPQbU2nC-vKLBvaHLEy_QMXKlcYrNUey_ZQA&oe=69A6C9AA"}, {"file_name": "migrated_image.png", "id": "203208547647213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449016_726753567463630_370054179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5Sfpgm5kacQ7kNvwHm8yn5&_nc_oc=Adkhgz4AYh3vxDWquSGUkJCbD_bPi6b_xPXwHOw9SFKOxlaPvcpLQVx3-A5jivV2mXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR9yv4bUOU1bXtZn_gRQegF0F8o_MSz65Np8KBSUQwCg&oe=69A6C962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "6x9", "keywords": ["VR", "Solitary", "Confinement", "Guardian", "6x9"], "long_description": "Our first VR piece, 6x9 takes you to a virtual cell, telling a story of the psychological damage of extreme isolation. Right now, more than 80,000 people are in solitary confinement in the US. They spend 22-\u00ad24 hours a day in their cells, with little to no human contact for days or even decades. We invite you into this world. \n\nFor more questions about the app visit our FAQ page: http://www.theguardian.com/solitary-vr\n\nHave feedback? Need help? Email 6x9@theguardian.com", "short_description": "Virtual Reality from the Guardian"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theguardian.com/help/privacy-policy", "developer_terms_of_service_url": "http://www.theguardian.com/", "publisher_name": "Guardian News and Media", "support_website_url": null, "website_url": "http://www.theguardian.com/solitary-vr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
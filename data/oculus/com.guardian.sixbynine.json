rated_image.png", "id": "507579013262583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427670_531759543691625_309149623_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5YA74u3T3AQ7kNvwGHp2D_&_nc_oc=AdqDUDTaJUJrlbg5BaQsS76u5_mqm3yxMf3HvIM6Krpyd52vYydTkpxoV6qNPdZxGi4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbn3Npp2tTScFuJtE5l7VZTMS3twvchHFKC_n9oZ4GOw&oe=6AFF2D1E"}, {"file_name": "migrated_image.png", "id": "319362739023585", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138835_492080730988995_381233958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inLAU4RhpScQ7kNvwFzkoPD&_nc_oc=AdrALIFuyuZ9YMbJAxonZI-znptE3xjRfmWX6iMl5GLPWbPD_SAl1WNoCSxeQgD-TQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlJcFHzUXeLsazhvJmbwwIZVSHvM7ihr4qNRnLvwxKDw&oe=6AFF196A"}, {"file_name": "migrated_image.png", "id": "203208547647213", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449016_726753567463630_370054179_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lllI4La1PAAQ7kNvwFX1ucI&_nc_oc=AdpMmkbxSr0CL_73lmx9fjxguMOm84sPMDbErnNJ0s8ByfcPVbdZ3wGcXkyp4lfhkgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsuNXWBZIvZ52tgZvuWZKaJERqUqn3kRFBd9DOSXtq9g&oe=6AFF1922"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "6x9", "keywords": ["VR", "Solitary", "Confinement", "Guardian", "6x9"], "long_description": "Our first VR piece, 6x9 takes you to a virtual cell, telling a story of the psychological damage of extreme isolation. Right now, more than 80,000 people are in solitary confinement in the US. They spend 22-\u00ad24 hours a day in their cells, with little to no human contact for days or even decades. We invite you into this world. \n\nFor more questions about the app visit our FAQ page: http://www.theguardian.com/solitary-vr\n\nHave feedback? Need help? Email 6x9@theguardian.
rated_image.png", "id": "507579013262583", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427670_531759543691625_309149623_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm7DO1nqCToQ7kNvwHSu7su&_nc_oc=AdpgRU5K2CPlMnfZhVQ1A7bP2zEQ3I9qW7zYbqJ7ko-9ux7FfgiZ7SXf1AtgSjpLHFM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUvaiUgtSECqOrMGckPFkMhq1uerEDWoeOvdLPOVzHsA&oe=6B08679E"}, {"file_name": "migrated_image.png", "id": "319362739023585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138835_492080730988995_381233958_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7Uz1VbAiB0Q7kNvwFNdeoL&_nc_oc=AdpuRHlN8Reu4pUgOpN5ngKf2Q30zlh6KXBSREL3XW72H9KLSfLfySIhNEx_IqBaIBE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNpQT3YXGnB5n1jWfHLcAdXfNLT2FvBWpOaJjmY5tapQ&oe=6B0853EA"}, {"file_name": "migrated_image.png", "id": "203208547647213", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12449016_726753567463630_370054179_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TKlMyk9U6wQ7kNvwG1LoHy&_nc_oc=Adq63V1UKYx9UVXhr8sKkWYM-X_MFiuSZV03_GpjQzEgoNfdWzQ3jJ7W2LgdX3O9MEA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9ShrT0qidce8UHjk01aQz3W1TGLp386ghjlwnNeyZQA&oe=6B0853A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "6x9", "keywords": ["VR", "Solitary", "Confinement", "Guardian", "6x9"], "long_description": "Our first VR piece, 6x9 takes you to a virtual cell, telling a story of the psychological damage of extreme isolation. Right now, more than 80,000 people are in solitary confinement in the US. They spend 22-\u00ad24 hours a day in their cells, with little to no human contact for days or even decades. We invite you into this world. \n\nFor more questions about the app visit our FAQ page: http://www.theguardian.com/solitary-vr\n\nHave feedback? Need help? Email 6x9@theguardian.
0F22A8"}, {"file_name": "shot_2.png", "id": "1172687568738205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1172687572071538_8007503614821163462_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6YUOE_dXX0Q7kNvwEXSCyE&_nc_oc=AdpWfNeKXl0BVgty-VWb3dXPomPsNvgW_KH6LD_Cz2Nwh9le-Wv5K7jPe9Dp11wrtEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgQ4frx4e52oVP5rO_pnrDbO-NHdMRli5b-M85lz7YfQ&oe=6B0EFE57"}, {"file_name": "shot_4.png", "id": "1705055774556785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1705055777890118_9036108307745158833_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5V8JGaLMEYQ7kNvwGM5t2X&_nc_oc=Adpimmoy6lrB5ysQEuiUo9AXsvM-sQocMAW6TrdvCnBKEks0Quqnu5vCxwZmZcxheK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW44nQCnvtiXhDJyszh77W7oiHj9ODFwOJ9_79Py1twvA&oe=6B0F1C63"}, {"file_name": "shot_1.png", "id": "1589373846563700", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_1589373853230366_5016636209203658809_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf0Ov2egJOEQ7kNvwEuvR2J&_nc_oc=AdpoZkfD1RR90FniChlpB2n0JPjBocvPa656zu5fNrs0Mngs2JzQ4xr6tcL976YFh4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbmxmXDDKXx4EFtWCRcs5T0U_ijwE_-SJtVDevd6BK-w&oe=6B0F07DF"}, {"file_name": "shot_3.png", "id": "1639458707591643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1639458710924976_2892329821755058143_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1cgSmpeSyQQ7kNvwEz2FY5&_nc_oc=Adpl-xYuEzhcEIkmxQvcK8LnQM2p06NuzRA3AyXGunK6Ib75bLrOxS0JFHFqzpzgSdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNEyoQG0VIv-VdKVC_JYnjrj7Bk1F5LYku3QQYwVyY5A&oe=6B0F011A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Fools Club: Manager", "keywords": ["tactics", "strategy", "autobattler", "multiplayer", "tabletop"], "long_description": "Dead Fools Club: Manager is a round-based tactics game for your tabletop. You don't shoot \u2014 you lead.\n\nBUY. Each fighter stands over his own console. Press the keys with your fingers or a controller: guns from his specialist's arsenal, armour, a one-shot gadget. One squad bank pays for everything, so every round is a choice \u2014 a full buy, a cheap round to save up, or one sniper rifle for the right man.\n\nORDER. Attack site A or B, or split your defence and give each fighter a role: anchor, patrol, flank, lurker or push. Change the call live while the round plays out.\n\nWATCH. Five against five on fifteen boards, by day or by the light of their torches at night. The fighters see only what is in front of them, call out over the radio, trade kills, take cover and roll away from grenades. Plant the bomb, or defuse it before it blows.\n\nBUILD. Wounds carry over between rounds. Heal your veterans and keep their gear, sell a fighter and hire another specialist for the next map, which you see before you buy.\n\nPLAY. Against a bot opponent, or online, one on one, against another manager.\n\nFree. No ads, nothing for sale in battle \u2014 if you enjoy it, you can support the servers after a match.", "short_description": "Manage a squad of five on your table. Before every round you buy their guns, armour and gear, give the order \u2014 attack A or B, hold or split \u2014 and then watch them fight it out by themselves. Plant the bomb or defuse it, save money or go all in, and outthink the bot or another player online, one on one. Free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/dead-fools-club-manager/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": null, "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274
xk10i3JtxzesvU9ECA-4ygPTe6nwxKbc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGfwgdkoU8Uw6ipwCH1tFTjYq2-GOBI2_TzFRgAfYfCg&oe=6A7DCCED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfCplBt8MLcQ7kNvwFvNCXk&_nc_oc=AdrbW-cRNwMP0qv6L1H0EsU-sbPmPSqBFfjNxuot-ygBSyRxUteUgiRjs9rVRwUZCso&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuJ__a4aDxfTI3akJyXLJrIPvOo8D_7KM3zToqYNAGZg&oe=6A7DCD37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoIVIJSJu7sQ7kNvwFuJOcF&_nc_oc=AdqFO-_Wuqzw7bROEZhScinXA1mtVUxUXAooLcgMFQiukat03BR8IkHTM8HOjpV-Uso&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZTIJrVDTvrTIyrTZ7v4o8mQynY3CjGeGPDYO0jc2oIw&oe=6A7DA52C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also sele
aVaNVoPI-kGF0b7CE6qjwQls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oIeKzcbNvnkvjJ9u1pbENJNjUGTz4Xnq65OAk40PqGA&oe=6A008E6D"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CToQf2FGeawQ7kNvwElhB0B&_nc_oc=AdqKOTOA_T05tOzFtnhExeJooo1v2CCxgKCrA5L5WlOgwXsqXhh-SieEUx-r2KlQhe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XdcYVNCESRLQdOX_OsTR7j5UGY8fF1kbMkg1bIn3Fww&oe=6A008EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5VN1ewz33gQ7kNvwH160V-&_nc_oc=AdqzNlQehEug6Dj4OnzC-mVNTjbnenSjE3L1FkfnnweyWbz7x8cPnP38QNsKus6FLuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44gJwbR_Vma6TLC0ofUvQwTv7LuBHldF0QPZfoPzdTHA&oe=6A009EEC"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n# Download Today!\nAre you ready to embark on your adventure?\n\n{4291138197875017}", "short_description": "Novalight Is A Fun Multiplayer Game That Also Has A Story To It!\nPlay Through The \"Story Mode\" or \"Gamemodes\"\nAnd Choose Your Own Path.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/xdee1/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "XDEE1", "support_website_url": null, "website_url": "https://sites.google.com/view/xdee1/novalight?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9883238321789102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618440_1511883326805401_6765246246498395194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSu_wf-Xev8Q7kNvwGufSTG&_nc_oc=AdpfzpQCGjqpll0KT-67SmhAb1XaHD2QimRaVAJJFEwTCqRpfr8xZtAJ0IeEvXEakcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b4WFVUVw9RJlNPFHrCdRSAcHcYj2vd6DQMxKpw2Iqlw&oe=6A00A737"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Novalight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
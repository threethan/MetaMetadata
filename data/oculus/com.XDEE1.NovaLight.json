dn.com&_nc_ss=8&oh=00_AfzHRHplxWpbPDJdbVdjN5mGs-nJpZgKRtFT9fCjabh-yw&oe=69AD7FED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_HiQbhE6tsQ7kNvwE3f2kf&_nc_oc=AdlN8g6ZqG9bWXQhTDLp-XidhlU32lixcpGm9atU3xR2yDiMYfZrf3HVfdN8qixCe6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRvt8g_X33bgFidL0Hqn_n_7dwN5MMOQbh9lfkdjH-xg&oe=69AD8037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsCjAuOoHNsQ7kNvwFakfNK&_nc_oc=Adl34kJwOhTefsgQRcM1LA4P0BJ44Cs5rkifhVGv8TiyxGOX_kOP2TXp8UTlXqvztpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjkNJjVhV_0cSTjmM6p5wVItmM-Hga99MeNZAnI0FuVg&oe=69AD582C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n#
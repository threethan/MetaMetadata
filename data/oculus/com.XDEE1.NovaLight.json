dn.com&_nc_ss=8&oh=00_AfuCAAmifvjP8Zp5oSdwMMLaRe1nNMtwZ52gFN1VcyNzdQ&oe=69A839ED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZBcFw9erF4Q7kNvwG91UGX&_nc_oc=AdnMcYkIfGE6e6WPQF_SeHsIlGtvtGLo81Ymst1ofzLqoc1OSnD9Y0H6yYbrn4ALaek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDRT9GJ3FtEWwoHFFh9miRscLVj7gHMJ9t8eQiPVejtA&oe=69A83A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fz1tI5l0F6gQ7kNvwF2Molw&_nc_oc=AdnEaAIdfVn9RYJC9X8Cirhmx0gze2ZtlcxH6oBmBUSc4f0_fSPvRSB3fnw8XF3iaHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfusvgbN5EpaHTp7BpxlmNxbWQrVDLwvZTG3jq3rCRlDNQ&oe=69A8122C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n#
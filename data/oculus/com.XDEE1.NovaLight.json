S0NrcjxkxMHMGbV3U9mNQaEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVFq-bsqs79j9D3cXP3iVrJ8N7PrhRG4MOdtgy2BnJiA&oe=6ACA43ED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yt9oAA7auQQ7kNvwEQw1r4&_nc_oc=Adr5tAuYikdosefe9j5B6zx_t4Iu-4pHlDoMRUSlbz7xreZ_ptbvI-TsY5orLsSsdH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSVBG5Vge9nZg7e58AasBm5V1OuBTJT-kJdu4PYAVZCQ&oe=6ACA4437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgH6nF73NqkQ7kNvwH9am5e&_nc_oc=Ado3v8YsfV9wKpBqXNI3FFRkBmj0-nyK-mVZdCgLxURMWJBAin6_7yL_WEEooykvQ-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOUPUAWuIkkvI7lY0lyXy-wjTolB8NUaRcEsrcJnMOBQ&oe=6ACA546C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n# Download Today!\nAre you ready to embark on your adventure?\n\n{4291138197875017}", "short_description": "Novalight Is A Fun Multiplayer Game That Also Has A Story To It!\nPlay Through The \"Story Mode\" or \"Gamemodes\"\nAnd Choose Your Own Path.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/xdee1/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "XDEE1", "support_website_url": null, "website_url": "https://sites.google.com/view/xdee1/novalight?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9883238321789102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_1511883326805401_6765246246498395194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoORNpeuqswQ7kNvwG2_91I&_nc_oc=Adrd4GxXaD6a0WAYT_KHSIUtYeSnVHNp5-7_fyFhnCiXqfY7isQqA9bGdUe1KQbqe4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrdXu-u5h9xD8nr1y7CzBwNs66U8BnRzx9xm1QOSRxAQ&oe=6ACA5CB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Novalight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
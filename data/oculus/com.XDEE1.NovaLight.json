dn.com&_nc_ss=8&oh=00_AfxHFlVQ5xkR34-JJJuQBvB83QwNx3VGwTOj1B1cjg34jw&oe=69C1466D"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0-un1dsWocQ7kNvwFS-2eO&_nc_oc=AdqAgh8RGwTt2npAIxCS0j9f41QRbOPk0sFRWz2qY4IO05bmdZCGzEdGuijTHCPdmes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyb3hfwtwRQnj6IjRCFSd_RV6la6TOo4MGRwZEQgMaYjA&oe=69C146B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yZydAu6a2EQ7kNvwHkq_wF&_nc_oc=AdoeH6f4mshorSY-BybxzKCa5A1kbREXo5JTrb3tm-ye0d79IdjZT3Dd012VikpSzjE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0l-jYVo7P6O6FAddXTmSVN09GSlmvjWiIt27xcn73CA&oe=69C11EAC"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n#
dn.com&_nc_ss=8&oh=00_AfxT1LNf7lKqdckSDKgE3MZWax2KbAOSQHEahY2GerZoRA&oe=69BC006D"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYXLCU5oXGYQ7kNvwF3aQGP&_nc_oc=AdkVR2EhdLmQnqjugydqUPuL_6jvHPFIuJi0FOHHjnNaGbgltISyRYjMBpzlgAnen1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEPXmPw9JU0-uBWKSKS_SJUlNckbtA5RtisL1psn3a1g&oe=69BC00B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HE-5odq698Q7kNvwHEmUIh&_nc_oc=AdnWrSu-0b5OhxursVSpctXZGk8NsnK15cCZrYtP9Z__7vFyV2m6yy7Lveh4RrC1x3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxzpbtxjah2r9McJNrOkuf9WtD902TZ_c0Em_nzYePm4g&oe=69BC10EC"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n#
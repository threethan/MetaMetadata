dn.com&_nc_ss=8&oh=00_AfywN6AXml1PJIYyFO2DtIQzqr-KZ8Q_Gusg56AG7x8LZw&oe=69BAAEED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYXLCU5oXGYQ7kNvwHN-mmO&_nc_oc=AdmTYRmIFtAEgVCrrpMwk3PFtdTkap6ScYM4b5E1A2XGpGtzgx0x7NtlV5CzKk4TO6g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3qIX4Omtzjx9TlOrVu5LQFZcMCG41Kyrlo3VrsmNCcQ&oe=69BAAF37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L0wKsgrH8kQ7kNvwGBGb_t&_nc_oc=AdkAYk_D0MKOclxvnq9bj-49s7YYnyRw2iTA6f74LAGwtpnsv0NyeR0rtXRbwvseuxk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzg8pZ1ufb9mOiYj_UrUdB71MwoBKjOaJ9I9XiSY54gkw&oe=69BA872C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n#
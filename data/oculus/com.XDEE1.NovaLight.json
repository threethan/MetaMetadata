775_692955520537234_8717317090656428387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpNJzasQMoUQ7kNvwFJIE7F&_nc_oc=AdpW9a1uzJMEgxpJYg1B5QWXmWp7OerWKK_GTB21FV0ys_sUOwwwq7W5tclKMDmXRHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1D8hM7wnFceF1YbjcnKH_p8ChexHc1DkFr7LT0FYdZA&oe=6ACE6C15"}]}, "id": "1259072352453291", "locale": "en_US", "screenshots": [{"file_name": "PlayerBasePhoto.png", "id": "685667267932441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618069_685667271265774_7076961593481804634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEHjA-rVaTgQ7kNvwEPQdra&_nc_oc=AdpvT2wbeXaCyBk2SdtvbNG7-YlbtEQrDHwssHF18Qsm6Ix_z-cGccir5rw-wRry-DU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZhLk30HogC9SbIrhsCpbMFHP1g7kSYl2o0BMCYScfCQ&oe=6ACE3610"}, {"file_name": "CosmeticsPhoto.png", "id": "725174876540483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_725174883207149_5719700881540682466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6prr8mnzHJwQ7kNvwE24aqg&_nc_oc=AdroYL87e8xFtCv6NM3r5GEP-E7GEYS4-HoDnpE6TKOlLQz1R_VbpoRDglDyBBQ7clk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONIevxhoUf49mc66XUy0Dz7zGi3JmrkxsN7a5JhZLFQQ&oe=6ACE34C2"}, {"file_name": "PVPGameMode.png", "id": "1177377434496532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618252_1177377441163198_4068656652322895461_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7k1BvDAyYEQ7kNvwGaA9KN&_nc_oc=Adp71hrxaS2yQDQKMFP4zwUCuF4oxMdBUc9kE8gMWU-YzDJ7xNaCZABtfKK7wlCnZ50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCtaXewCnZmHwHt4TDy-q2wOwHiC1EQqZJlSK_VVueBg&oe=6ACE6589"}, {"file_name": "OutsideWindowPhoto.png", "id": "1182381363750248", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1182381367083581_8403279582652785227_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85ZnTDHzxgYQ7kNvwF_uSk7&_nc_oc=AdpePyK14tz_Jhd_tIFxagay4aWLVZ4PLbYCtlASraWNIhJAGnaRT3GVIfxo9vV3xhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtIzTfUGBiCpm3b8eQVC_UB1c06kImMZ6uZfpdkadGkA&oe=6ACE386D"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9cXLHcu6FsQ7kNvwGWsadK&_nc_oc=AdoYRrLukDf_fAFifNaqBGILZpJZAoxQ82ygIbavVS0nLwO8YTnOZVQepoHCw1xP87Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvve48V2vtcd3BeXjAkJCGb4ZBJr704eh9LxcRS0TUlg&oe=6ACE38B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mjheGwjAmwQ7kNvwEiDXrm&_nc_oc=AdoTTZnIWva_QL1MIqY2FLGcHL_xu_XzdnWH5MTuWByKhNkMfFtJ6qlSNJ-RV8EtlVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyp3raLFkrWybcAfyf7BefnfFCdKDvK2O2_P-BmG9ztA&oe=6ACE48EC"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n# Download Today!\nAre you ready to embark on your adventure?\n\n{4291138197875017}", "short_description": "Novalight Is A Fun Multiplayer Game That Also Has A Story To It!\nPlay Through The \"Story Mode\" or \"Gamemodes\"\nAnd Choose Your Own Path.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/xdee1/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "XDEE1", "support_website_url": null, "website_url": "https://sites.google.com/view/xdee1/novalight?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9883238321789102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_1511883326805401_6765246246498395194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caaY1yChI8kQ7kNvwEW5_zt&_nc_oc=Adqui-2fSehDOKSo1UBxufWV8yxmLrXRJTs0thgx7Rdw7WycSywEQbLhHarivdQBTl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVMwPIYNWILatLf2nhxR_phx_BDb9m9XTTrKBT1cKlZA&oe=6ACE5137"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Novalight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
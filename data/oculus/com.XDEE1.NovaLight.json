Uy5vEHqbpasts010rU4W9pXLG0Vd7Khw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zy_9h6L44e0_t2_1YlDAx8NYkRzFk0gwykyDtQC58-g&oe=6A393EED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5RzQIVGhSkQ7kNvwGxBN0h&_nc_oc=AdqYKrC6YrsqBfNB6vdR-2vDcQSQtzS_V0fVfvFfuOiVp7nr9lWsVoqBOp50l6wFAig&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QClk6B-WQWG08AsI2MwyqH3y8CETWgjkRMcwfZ4QWpw&oe=6A393F37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjaBS0lFSooQ7kNvwHxsDfs&_nc_oc=AdqR7Iv40oaNDd1iENmciV4IbWrhokGPylHSMJoPxfnaATQPsCctojp9MDJAcGfycdQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ac7FDPlyCkk_NAeYsnAA1gDCjAMJNTmyYh4UROk7QlQ&oe=6A394F6C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also sele
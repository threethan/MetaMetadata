bR1oxB3cl9_s5EcXyHvgsU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g4IbexGXbmg81sowQaQaR33yhEa3Lvae_418qbfxpZw&oe=69FDEB6D"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaywOTihjCYQ7kNvwFlF6HV&_nc_oc=AdrDdBACCwBfoIJ4jsqr-cD7ocmukyktl1xNdgJ26AUJ1JpbCM2IUgX0i_P73yjpnA4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ckthWktpbnwu-P4wUA8cBA1Xh43GKD0jpgnAyy1vIxA&oe=69FDEBB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpJJWCIwobMQ7kNvwHgWlL6&_nc_oc=AdqW1_u_LWHhn3sTg6eFRhJQZ3UpYRdZLBdO4GO27vfC3n81MYFLmz4C9i1rArvoLOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q60tIyda9lYbdo_Pux6PRnpblPYSg9De8lbFGiC3czg&oe=69FDFBEC"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the optio
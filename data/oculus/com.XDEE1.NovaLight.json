775_692955520537234_8717317090656428387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWPb1x4L404Q7kNvwEm85KJ&_nc_oc=AdrU-uzSeEnQ69o-FNQzYtty5rhuAq42IUl2XZJ9bdu1YT4YXVhBoXJcqe-pyPz0cLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bmNq5PDVwRllnx21DL5W8fOUrgfCQ4fcgRZHpSs4r7Q&oe=69DA4E55"}]}, "id": "1259072352453291", "locale": "en_US", "screenshots": [{"file_name": "PlayerBasePhoto.png", "id": "685667267932441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_685667271265774_7076961593481804634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VevIlSgDEjoQ7kNvwHT89LO&_nc_oc=Adqu_ycIF0hvSbd9LeldkXTWL8dmwYdhEnlFlRfOgctgPYEXe2OtDINf6jiCNDtaW_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wX2MUdjflT5jHS9BRpMHkhRjBnj09ADHL4f86vuHFCA&oe=69DA5090"}, {"file_name": "CosmeticsPhoto.png", "id": "725174876540483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_725174883207149_5719700881540682466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqjUMZZ08t8Q7kNvwEfYw7j&_nc_oc=AdprIk-ZsqZ1UcaCCcRGat5aWFR_tPk7WIWw8zabX18sVdOlSfDk8fzBXOZN_bCyLUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CuayputbxquQXFhCfUlSJUz7T88kKKXVoHSl3cyWaEw&oe=69DA4F42"}, {"file_name": "PVPGameMode.png", "id": "1177377434496532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1177377441163198_4068656652322895461_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJU4AXD-7XcQ7kNvwGxWcZ5&_nc_oc=AdrwmeCQU8mGYt4dM90WT-Mp_VdhwSrxc-9DfSgLmjen_GFQooXLPQXfRlI2LCxAH9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OyYiCE-ec9WNRs9sfBesb-yxc7Y3ZHYpLQWjUg6Bn3A&oe=69DA47C9"}, {"file_name": "OutsideWindowPhoto.png", "id": "1182381363750248", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619808_1182381367083581_8403279582652785227_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1avJ-oAkBM4Q7kNvwEBpD5Z&_nc_oc=AdrykEHDn-wxMuzVPBiwHTg23_6SD2mKFhQTgXXDQJZnudf9FSR0T_8f19dkGLmdd_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NB5qzv3AYdwpZBKNsyBtaaRmS95Zx0VApta2kWA6x3g&oe=69DA52ED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrQtrza_rosQ7kNvwEd0xD3&_nc_oc=AdpPLgFtZJOg3cACENjB5mwbBJ-hDbVMmOKi4J8EKlydW_LbQM6-tGhnJyzf6Uw-_lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pUpRElxTFJh31lfSi0kQMGO3g5uAzlG7nGy7uHg4tlA&oe=69DA5337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIimDazSis0Q7kNvwGG84nb&_nc_oc=AdoFtPSj1EDbSN4vkNVcKHdQRc_1xwauu6uwLK3mkjm_9DkAfFEb5y2kX2oBQqUUkbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SYwiO18Vhx5evjCN_qfbdoxVDaJXHwJBtliSutAPNUw&oe=69DA2B2C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n# Download Today!\nAre you ready to embark on your adventure?\n\n{4291138197875017}", "short_description": "Novalight Is A Fun Multiplayer Game That Also Has A Story To It!\nPlay Through The \"Story Mode\" or \"Gamemodes\"\nAnd Choose Your Own Path.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/xdee1/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "XDEE1", "support_website_url": null, "website_url": "https://sites.google.com/view/xdee1/novalight?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9883238321789102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618440_1511883326805401_6765246246498395194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9WSIRGR0QIQ7kNvwGbce_A&_nc_oc=AdpBjRCwMZ0Oh5nqaQuIJxlGvCv0cVNCwv6JUtfp2KS0HvDIaFI7R-tSDUvfPwnOaJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NMQAyDhQ7rrSOmsspdhoZQWa8KAh7O5lDKI5UrYrmMQ&oe=69DA3377"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Novalight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
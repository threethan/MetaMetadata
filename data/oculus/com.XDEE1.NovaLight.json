2DNmB6xwhXy6QATd8_akOQYyH0OeIwfRg9uBbAIyTLSw&oe=69F202C9"}, {"file_name": "OutsideWindowPhoto.png", "id": "1182381363750248", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_1182381367083581_8403279582652785227_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ2dzk8JoIcQ7kNvwGPzv1C&_nc_oc=AdrK7NP8P9c_RZO53ymyIa_m27g_EJZEyFPC7HGIdDH324vHcdqySef53MbY3IOTNOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1ghm5whJwaxfKSsODAZC8FFEaLJbPYFzrFbeNABCi5kA&oe=69F20DED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDrnrnaNvM8Q7kNvwEmm7DX&_nc_oc=Adq4ajEbiimHwEsmUAIs6URGKpw1suVrsMst39B0nmQ50tQgV_Vc8cHiH_4feFeURhw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3D22rxWhuUNCZ7HBnMNvFCbzGAy2T4tmG7vDXMchxGRg&oe=69F20E37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWtkQmaza68Q7kNvwGdiKR3&_nc_oc=AdqkETPKkTswGHen2RUrWDUrfKj_uucVn-wNc3Cqn1RHn7jP0BGv9m_E6TmfJdoC1j8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1x00lo5oGJYWNPd09RVlTQquLSJNBygebcLCUXAZuQWg&oe=69F1E62C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in t
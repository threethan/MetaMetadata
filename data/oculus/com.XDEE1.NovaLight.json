775_692955520537234_8717317090656428387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A--1nkMcF6UQ7kNvwE45COO&_nc_oc=AdoHPCri0BOL9berVweX8QvvQI3QLpX3Epf1b8hsF8ymImzobp9eIZJipgx-GYxmmK4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJBuGtzdKX_A1BHetKndK059-zpXpF7TBzpzhccABv-A&oe=6A60C755"}]}, "id": "1259072352453291", "locale": "en_US", "screenshots": [{"file_name": "PlayerBasePhoto.png", "id": "685667267932441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618069_685667271265774_7076961593481804634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B-SwDFkD_MQ7kNvwFFh3ny&_nc_oc=AdptpAVQEBTjZQOd6LJIIHiswhp8n10mwmU7T45hvR15UNX37zJdELjodh1GqIu5kfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8NqJ99KmVBruhslANP9zvmRtTpl2hF_qRoBHrTqpDQA&oe=6A60C990"}, {"file_name": "CosmeticsPhoto.png", "id": "725174876540483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618251_725174883207149_5719700881540682466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTdCZZ1mZ0oQ7kNvwGef0q3&_nc_oc=AdqYFdKraSH28ty7QIUaWTmdexQ45TSlvaCEvjS_Ui1Yh8NJqk1RIas3f1zvwAOO1LQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnUifUNa544ZJgyauiATcTs4oNDuYj0PEFDk0CFukRRQ&oe=6A60C842"}, {"file_name": "PVPGameMode.png", "id": "1177377434496532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618252_1177377441163198_4068656652322895461_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWvfDqq8Y9UQ7kNvwEncIvE&_nc_oc=Adp_jnqK14XeGlHoVTz8CR5QCBa6QYHU-fa59UxHuQId5mL6lAWKBFBSOYhMuQcLR2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8zWFpMXt829KE4f4rAIT-U4orLJy5ns0Vyg6XOmVuKw&oe=6A60C0C9"}, {"file_name": "OutsideWindowPhoto.png", "id": "1182381363750248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_1182381367083581_8403279582652785227_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kCXpkgjp9IQ7kNvwFgRqU6&_nc_oc=AdrP-WcUwjZMwNBW-3MRhZzJEM_0fcAAv0rGN6uiYm5Mr7HHeMTHsgxxyybejQLAmX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmicyIC7TyCu21QM96Bzp0d2wz_IpQerjxwIfBA45pFg&oe=6A60CBED"}, {"file_name": "StoryMode.png", "id": "32811313745133632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_32811313751800298_6861778986600558374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SWS551AQ8kQ7kNvwEo-hn1&_nc_oc=Adp9D90w0t-Q9YNkAUf7OjbqBsAZdg5U8tkWmtWGhYeyrLrhQ1thW0eawijRMw0pYUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7LUM19E1I6DI0YSKsKXYBOM3OT7hiA5bdRbIvDzbRQA&oe=6A60CC37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameThumbnail.png", "id": "864108156302774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_864108159636107_8140054702670079169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0NM0fq26RYQ7kNvwHAi13f&_nc_oc=Adp-nf_l7CSm2Oxguxjh6c78UYOzPwF-zNYmM8ZVycDpW6_X3yN93raETtKv5T4fMaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2SvsAA55zqtbM78VbHKeW-B7alWrhn8XzEmwykBLSvQ&oe=6A60A42C"}, "display_name": "Novalight", "keywords": ["Story", "Gamemodes", "Space", "Robots", "Adventure"], "long_description": "# Welcome to Novalight!\n\nNovalight is a free-to-play, hand-based movement multiplayer game that takes place thousands of years into the future where humans have gone extinct after a failed experiment caused the earth to explode.\n\n{2872839186238379}\n\n# Choose Your Own Path:\n\nJoin up to **20 players** in a public server or create a private one with friends!\n\nPlay through either the **Story Mode, Gamemodes** or perhaps just hangout & chat with friends in the lobby.\n\n{2244974466007548}\n\n# Customization:\n\nYou can customize your character with a wide variety of cosmetics!\n\nand may purchase them with **Nebulite** in the store!\nthere are many customization options in this game so you'll be able to create a great outfit and show it off to others!\n\nYou may also select the option of either being a **\"NovaCat or NovaBunny\"**\n\n{819769537341079}\n\n# Download Today!\nAre you ready to embark on your adventure?\n\n{4291138197875017}", "short_description": "Novalight Is A Fun Multiplayer Game That Also Has A Story To It!\nPlay Through The \"Story Mode\" or \"Gamemodes\"\nAnd Choose Your Own Path.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/xdee1/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "XDEE1", "support_website_url": null, "website_url": "https://sites.google.com/view/xdee1/novalight?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9883238321789102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_1511883326805401_6765246246498395194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbE7TvNBGXkQ7kNvwHZIBqn&_nc_oc=AdonXt961pYrFTL5mEdOq0QtL3OVVQjcTeNf0pRa3RjHXCDsC9t_mTpKezdVl1kvdqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8seqpEgNPg0Dx6YNEkbdX-bmqX8nWGky1zpuaby0OkQ&oe=6A60AC77"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Novalight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
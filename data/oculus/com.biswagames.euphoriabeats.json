6_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nHEhZvjEWcQ7kNvwGAiD6J&_nc_oc=AdolcjReJnItBPGGVfgOHXGCI5mWoBLs9wacaUxHRqzMEcluM8frZtT6lE3Z58ukCQs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_74xbzJYM3KySUReOrX4yrb61PNgeFh8dv9vKsWpmcPA&oe=6A467E56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fex0BR9XQQMQ7kNvwFRXpVu&_nc_oc=AdrhfWHuY85zkgtAjyV_fYF-uVhq-IvBfJvLTK9jyfq-gpkzUF8bvBGOtYrvryXeXVg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QWRzN0cokDIhE9Q2I4kTu3JUJ7KRFCVU4or9vemohEQ&oe=6A467FC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApmAXacCslcQ7kNvwFM55vv&_nc_oc=AdoBlPNkAd3cHdw19xeCfTWEnl8jQdR4E0sPcJuPFihuf2kjyX_gWZb9eAp5E6ycA54&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q2txe4HgJqo8GqyY7r7SUcLB6wxOIsc-KZxPKjIa4Sw&oe=6A468429"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egBzO_x_bREQ7kNvwH43Dvc&_nc_oc=Adr3Ja5VKBUV_gQhrtQQbtt2nKLNV0APvhDUNYAW2rZikWFtY17qScWos-z5gqMkP9k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MrfJhCFolcwY9M5-RaLZn7XHvz8QhKWsxTF0fTzEP_Q&oe=6A46647A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=focGeLnY05YQ7kNvwGZtlFL&_nc_oc=AdqY5RcIUt04lVSec_-jUnkUkM5FgJ_-rjXrmLLrYuQtUpwd6i2sRuSgoAGLwXnr5p4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mEPXOFy-n68CgjAMUgR4FyGSyUe90wla9RuL8zM76WA&oe=6A468B5E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_int
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3knynYlEpgQ7kNvwHtA9G-&_nc_oc=AdpAU2fjxJi8PHIRe4xFQaOGZpGIul7IHOnmecpkkZODoSxKWBZ6QBCF7hPYcln9mU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GqxU9-013zfz1ptEAcp0uwhVXASTo5vL1LMm0aUG7Ng&oe=69D63696"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkdmACEcNocQ7kNvwFRhcHS&_nc_oc=Adq4bXcn79m9ueC5WBtr9skABw9U1VDMWUfUfP0rIr-lV3Xj7YGUNH03YXd_7Rk6tBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lPw7W4xiVfpydSk-Oyyei2daZFxzl3CHmhON5pgrz7A&oe=69D63804"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahEp_ZUYMRgQ7kNvwEC-bFQ&_nc_oc=AdoVjl3Vw6I-b8n20V5tApez7igQuUAKPj40LUG5pSEVwr6hX7-6pKDy2i2tZmuyGv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_7cctfTMWsPGWCZGSulUs2FCiKH1jfznpmD182D8z_Q&oe=69D63C69"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnaWI27g_T8Q7kNvwHsJA7M&_nc_oc=AdrVrpgwRbztpNf131d7kznPg0dn7oj9qapwKVG2z3LH93EjWNn2kL4PW12qYx7SZW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wEHbk8ea6bBuTgvkQLeKT1iRwWiNAgWItmH7_cbNR-w&oe=69D654FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ7LGAZ1rJEQ7kNvwHKeifE&_nc_oc=AdrE0u8jpCk-XhgxHRN8N0ZJ_Y318MuDSsPzk6yLJ8eZ7W-YyuHLlivtiGDGzcene3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aWxxLESrO8MrlZiKKAchkTAejSsK2uBteEMQiFkfWQg&oe=69D6439E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
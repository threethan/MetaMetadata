g", "id": "1019730033163233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo9OpzWoLXwQ7kNvwGyIbWs&_nc_oc=AdrHPqJpXECjV8lugjeADQ6Ll3NkEtWyJyTfTjAhz2TnN4i7wmJ9sU47-OBaWvlZxS0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8sCLM9YrJuDkmhgU15hReI7cFPU2OXsgy3qMLDYP9Fg&oe=6AF332D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7TCDNqKYmgQ7kNvwEtQ5u6&_nc_oc=AdpBfZIz7zuu_Z9pMZ5Rx_uJQ4GIeoXkYWv5oTZqZLbgmdbG4-n2J09rpFPaj7pSI-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq7Y10xdZcrIdr4EnZu3zyXZCfXSFUtd4wrbdwZ4ueaQ&oe=6AF33444"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyX4VSCMfDoQ7kNvwEcW88I&_nc_oc=Adr9VOyM1bBkXd_eEeDOlvZYTiF6tZGlxJmqqaRzKDiEqv7Nc8FkyK7GcYwdK3rElYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV7T61jyReMvvzcoxUWu5__QZ8B9nNVvyYED7q-FWEfA&oe=6AF338A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecAXxcKGxcAQ7kNvwHU8Kfq&_nc_oc=Adq5IDwccZDMr3jub4Yh-BfXUucVNIoxWirNHUtYoWofdRPRK4H5u6MYmV7vg7wkfm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqQKayaNtOtqP1uRu26bKaIciUhkbD54MK3dxy7LBeEw&oe=6AF3513A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUAjHqQ6P-MQ7kNvwHXHG91&_nc_oc=AdrLOs7tV5ZyL0kHM6rb3fZMoHdtGhJXtFeKHyCUGsNd87RX-YiI1stVPk8Z1fsA5iE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvkmorzWVPB9C6VDpMGhQzS0a7mLfd2afBdXZXVagz2g&oe=6AF33FDE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
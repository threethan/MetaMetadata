6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxf91Gcdn6MQ7kNvwFC3n1E&_nc_oc=AdqvEQ67sEbK_qjTg5BQu_BCQYulqQRSn9xNB57xIGZUU2UxLeEcv-6HgSMDJuZwTFg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiQtxibDR09bABJeJEBUuIukmNZjIOWKcBp0ZUX18Xdg&oe=6A4E6756"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcDEMvgJ-vUQ7kNvwEIp1ez&_nc_oc=Ado9n6ad5LACZcuZRpCkhpzjUKoY4LjDsdiLANJ8fSQSzQDxYOdLCBtZn5xAekR5Oxo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbNdGduutYSE8arfaErgIMXIsW9mB08wA1QQ4XMGP8sA&oe=6A4E68C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5upKYMseDwQ7kNvwEGJ2nY&_nc_oc=Adr4PRQUqTtnb2B2O7pc_E7PVqO-gTFwALdfrJTOUjAb9BA4XHx8E4wLPkwFrQoK-Zg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNhv316WUJONxF_FpGXBu9PuqqxrBn75FrZydKOLssRw&oe=6A4E6D29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hi9a83Zz8sQ7kNvwEUWV-W&_nc_oc=AdrG0E03BECQpp3yPcTWM2r0goXPWfddn1LvcGYkdaAAhjHmtePbRZl4xHciFXcEUGM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTxjPUBpRY7ZgjoHGZr29iCiU_DDCJUpBCeWet6nJtew&oe=6A4E4D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz45WfVOFfoQ7kNvwFOqQnm&_nc_oc=AdrnsEhjXTRmkbGS4JsEi_m2AkhO13fAjnBBTMW68xWmN4Wi5XavWzTot3TjOl1c3nM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvbuj_mnOO5RD_dhNHqoc_-X497dWiGeHguXME7mFJ0A&oe=6A4E3C1E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
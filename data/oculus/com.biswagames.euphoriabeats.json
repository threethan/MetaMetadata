g", "id": "1019730033163233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1Mr0xygBLgQ7kNvwGbFm8N&_nc_oc=AdpmRwBWUna6ecdO1HkzGRWkXqoWGVBdPYDbfbEVwxog-InEy_om7Afqq7OQQavklgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4saSnar-Yya0cekzCpW_NQw3-A8udnWaJ3mVt-9L1vA&oe=6AEB49D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA52cnBPt9IQ7kNvwGqtZ9K&_nc_oc=AdqvSISUyt2Roy6bgK6i_9gys0gnOmQ0CNmJx5LdQONfK1Bv5BP_Bz3PIttjM0XTMio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRapW9EwNoMUfp-_xD32_2v-_v745ZxpozUo7G4xgIS0A&oe=6AEB4B44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DStudnG3MaEQ7kNvwHEiqB1&_nc_oc=AdpeGSbpjAtzTTzVCSDDpTjEeVbSMpqQcTT9ZckBj6I9q-bgqnpjl4YbbYgzSkSPFO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_v4QSYA8yjIrt4ZMP1voh2zuuHptuW6b54G9xoXIi9Q&oe=6AEB4FA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC_G_abPd7QQ7kNvwE9IpH8&_nc_oc=Adri6HnTINBxjxoDH4VakDgipit_7JI6n-MvGNFyqLqczt8ySv4OZmVHDwZ6GGgB_jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1txYfXa28JIfUHs963yqHTvkfw1yEsCZSIDWo4ajYKw&oe=6AEB2FFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwSbrlY-nxwQ7kNvwEuY0c4&_nc_oc=AdoKjk3n1VCWfUIOpT48MW9l_6N2uFBZytRjfBP6wJdcmdFM22cWv9_bv7iLZloylbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Brll2QPbdr9uQEYoZdr9EeWqcsGgr4p_hLvDGwvIDA&oe=6AEB56DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
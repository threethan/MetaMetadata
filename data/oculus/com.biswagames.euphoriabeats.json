6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VINgN5c_hHMQ7kNvwEBJZrd&_nc_oc=AdqPyDeh8LQbJgz9mMAImcvjGnWxKyusLvo7vaShWbtfQSUmaybocToCLh3jjEz44D4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xAIbOsp5_VHeBZ0flp-rY4IhraNvnDulazgKCEdY7Aw&oe=69DA2B16"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSTPXm8P-eIQ7kNvwG8dOUA&_nc_oc=Adr1Ow5eUKPLbDNPNmJjjv-B0fYozq81jd2fhefO0TqjNPEKZBWxmHRkijWpvbEnPSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iHWHv7fAY0N3nvdEPJsgGpduDkcwaLo3QN7wxTyyyqw&oe=69DA2C84"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K-2k7Kq1h8Q7kNvwEtTO-L&_nc_oc=Adql0nKht5cggWJn-pen2G-bd-Mpo71I9jqOgkw-tkeRZyCoJODbTOrUxnSf-i0dwN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XTS8uHw8b6RJt5JB9gvK4vif87jJALlMtI78pGHCngQ&oe=69DA30E9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3zujNHnOBIQ7kNvwFqwgoc&_nc_oc=AdrKbHDv5i0iWsAuw7qYWn2uVstX2IIweoevZtnbYk6pwoOsEJLYtTW_GN2FjvK7Xeo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YbGU9Xobx63yPoNrpgY9vChs5uKYUxaL5-AcaI6jwkA&oe=69DA497A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqKzjqsxf2sQ7kNvwG-fKGI&_nc_oc=AdqEHQHZhSDM2KMtgFB4m_er9lI1I9puZFjzVkN7Q9K9F4klw1Yscz7VPjDttKu-hH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05WCBY-O-4Is9BdjmoaaD_5s6dtUmoGrN3KGwWAIwa9w&oe=69DA381E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
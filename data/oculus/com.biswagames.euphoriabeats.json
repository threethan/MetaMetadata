g", "id": "1019730033163233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUfk5OQhIO8Q7kNvwEAhttV&_nc_oc=AdoLl34ADL61tYOnCAzgtOJILnO9jnyX_Fn-CtfZW6W0xeQ8E8mqbfHM4gH9Nt9_wdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpgpsJltBvGIT0EORhHj9lnnSs63MmN3-lLtHLETUXVQ&oe=6AEDECD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4gMpbkSb5sQ7kNvwHpwtvz&_nc_oc=AdpVxwGUFjNc4YwPmejD7Daid53b-ufg3yMOYeoMxMTBYKYH8AXcg1gRWPCkEAuSenw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgyxkZlObQeeSV5PbpZqWEMvHGRsh3se5QdHciwYo_1A&oe=6AEDEE44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WetNTH8rz_4Q7kNvwFL4wFu&_nc_oc=Ado0uVc6kT2ZWbdpEIA_tunEh4mSlDpUmKjEwOtr5vWxQ9hc5Tah5gpe0IIltZyLjho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRyUYZnDdJsm7Hr1jQTLCgi8Ev2gNtpvk1qxwJ-dZHyQ&oe=6AEDF2A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC_G_abPd7QQ7kNvwFiENBd&_nc_oc=AdpN2SBM57EBTDd-H6kuV4MIpMBW-nGQImDNV2rA67GmgEisoTIUUUKOcqsnZ04ByKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPaV0VsKa-c2iCi3kLu53M22iYKnyuNZJPuv0262wmNg&oe=6AEE0B3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TQEClda_E0Q7kNvwEyojVt&_nc_oc=AdqynZ8FAi7BdLj5n00bH-fYVQs2LFIK02us3mDHdThrLHrhywx7ZnMQsj5XbFwJTc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTga-zUjnLzGDaTiAjbrtYla4PJ0ygvWAG0x30xPK72JQ&oe=6AEDF9DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
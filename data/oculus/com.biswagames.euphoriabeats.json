6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n9sR_NVK8AQ7kNvwEfpYEm&_nc_oc=AdpXhjTARzF_IrYJhSnICWrvnASZ1XYkvJ5pDCRxBw4Yw1wmIMEqeK8dYxVKwtySznc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrSTiA-TJ4G51Ty7lJN7kqd1YPZrTCB41-O3vNHKF6tg&oe=6A9D8156"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgfbSocEDgQ7kNvwGylLO8&_nc_oc=AdorLOXjVigcoxJuZW3mKUf0_kLwzB1aNbMGjiWmGRrGjTTreGcml6HLeh0GTEH_qdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVtkj8DRukcrIBLtN08-ZP6Z4ndHTEgtHRSakpmkcx3A&oe=6A9D82C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEzyTQI8jWMQ7kNvwGieosb&_nc_oc=Adp-SGCItmfq1r6-Wg3TfomUyEluRJyEwSBvANrNYSeBWFduvAUS2a-GF6bIBTNo7XM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK80OzTGfPYPvvf2-V5VD-JrfKZ2LABab2T8wvqajlLFg&oe=6A9D8729"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9lQLuctgyQQ7kNvwEPG-MP&_nc_oc=Ado0EZIL136l5eoZpr_kdYIljYXRUPVQDYs-vCXbVR3urvdZomfHEQLi3_tPDPk2lC8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLENtnXjROTa1A315xgRcCnXMYQohi5ksuoJ7j-dCPtZQ&oe=6A9D677A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0e6tzjMyf8Q7kNvwGv5hNe&_nc_oc=Ado3MOgp1ijneHH9_V2XSm4d3mWBWyCTIQbrcmZ90nR8nhqYIIuPN33ub1NH5y6m-uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7TbuFfgECru30XJqDmOJNANxLDKEUD_TGqSgGsxT28A&oe=6A9D561E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
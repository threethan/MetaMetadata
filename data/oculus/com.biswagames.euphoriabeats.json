6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWsYDZz7AuAQ7kNvwED5S6h&_nc_oc=AdrACe4JFNvHKnd75pMsHsZbYzo8kJ7vde9jGLFLJJr4ulVoUuJdgG8lx3bcs5nxLeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10qxpnGjZLrTCcX_yIKwAu012onv9-ztWLa00JJs-1Gw&oe=69ECA016"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl_SvKAXPyMQ7kNvwHebnUp&_nc_oc=AdrVMvZNZCJgnO2ABcN5XFJ8rcEcSZrXc1vVieNNYkFO__qBshLryg1FuFhrewu8H3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oVuDxhx3wWeN0XISIaMKIsdtmN4rydBzUl040cU1MgQ&oe=69ECA184"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygJrWrm6UIQQ7kNvwG7pMaT&_nc_oc=AdrZdhgFFsrqzot3wQNJhXkI1TrXc8nw7R-TgNjmgMukaGSXWVSbx7XZLQgaNu9sv4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OicxLYkHKK00KOtAeOnSZvBLXIXwQeiPl-hlY4JuJIQ&oe=69ECA5E9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8daQfa-MHbgQ7kNvwG8FhWb&_nc_oc=AdrXZc4NJ59xlHYz5_v1ZAc7PbKyBEFb-ZXhUrqXVl2qbr2lVdxkypdExDgSkEw-nVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LiKQfOxvjWnrVKAE7Zqx5GJ8Wv5jP9BF0D8IEd3DwHA&oe=69ECBE7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Uo9Tq_3WUQ7kNvwFbzLjK&_nc_oc=AdrO9ottXdLH8diFQgC-N-AuRDkjFKZSm_LrmrF5VDNohQXkOs1ezLd5yhEzyzobsPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HF9JXzNrpEAxmKeAbhbJ9G8kOWwFlqVSYuvRDCIy_1Q&oe=69ECAD1E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
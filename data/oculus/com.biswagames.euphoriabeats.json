6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7rVzgdtC6cQ7kNvwE0lyle&_nc_oc=AdoWF2q_BEnCehD1dCBBfuF8DPtX1vaLmCl_oG6iqE9Ho7_3UtUWdzM5eaIbCoQfMUo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EJCVaLi2S6PUysrMzVgNbsKkW6fvuvErRPlZlJjum8Q&oe=69E24C56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkxE5Kk6jlkQ7kNvwHqVIez&_nc_oc=AdquIv2jjH8aGtSGT5WoCr2aQFph6vBWByQObdjxAQCrhN8I7sUpl1d0cVmbZoq4I_U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3slLplmU-LgnL4OZ4NCQvyjiGMHHvqzaS3iD1vdtGumw&oe=69E24DC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b288vEy9TUQ7kNvwHUymrh&_nc_oc=Adq00BDmUiuEYKdMYC8uX3z2Y8upzpvQnocRtffz569NRilkowqiUveYqOhs_MXxAVw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2226feVFxFPfRtPIDUz5lIHt8yVzs1JWjH465sLgH28Q&oe=69E25229"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgE54X_8ASUQ7kNvwHOh0hx&_nc_oc=AdrWJugpV-MZJMMxYc7M04u1vNODwe9dLXMA_xHIzlW-_k-9DfDnhvuHyRBvQFX0Z3A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17p6Er4h1lLPOwd4_SY7f-ThPxhUMYPSH45jRoTqqn1A&oe=69E2327A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uYig-FaEW0Q7kNvwHudoVA&_nc_oc=Adre9Wmn-Xfr4NxZCLENaKwG14qA-hiuC4KpylMJNEf2pV0SHXfYjKSZPuatYTkkd70&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35NJyYcvBWwk5EWWkvs-t6wkHgOASLBBetlqP0gu16QA&oe=69E2211E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYxsK-xavugQ7kNvwGFCexc&_nc_oc=AdrVjy8kviLYuMsaXYkHoe8RU-i8DutgTjJ5fzan4Fak987x-oyd6AIx70057FjE8uk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CF3FWNz8y59e2w6Mf1gHoDoTrLi2t6t5E169078w_cA&oe=69FDFBD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG63UdgHqCEQ7kNvwGoLZo6&_nc_oc=AdrS-B4QY3GvLeDyjBHjxH8FB-uPIjTmuYuHXEwpzclv55Xcjwsjo8QXcctbLmNHkrc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48uLxbK3NIIDJ0-rDpybnm7XYoJvwA5BnSnuOJBCKlhQ&oe=69FDFD44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqnMc6-5njIQ7kNvwF2efeX&_nc_oc=AdoZmbY94pOGGeykXXrWrjWr-nCbb2QRacbso78JhABN-DiOIWb15rv9YrEXew_dkvc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NYBt_mkfUXTU7IEh8YzH0ck8fVejOb0g9zk-R88vKCg&oe=69FE01A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8H9lsSazYQQ7kNvwG4vf9m&_nc_oc=Adr57ZRUSw-Lc6sVQoeH4QGCt82af16M6Uw0Ici9AVPqKWI53LVlUS-fV8o9__wcRuU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Fqw7uIJq-eYWnFnJmv-Sg4XITyaBGxhcS1PkCAa2Sw&oe=69FDE1FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gq-cwuos_H0Q7kNvwFP_EYP&_nc_oc=Ado9nEkFaqaJbdoF3zKI-YcnFoyUA-uZFSqMTPz_yZfXjXqXHGSOYpVKuqFduTA_UKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FUmkQzbduuwthh7HsNNU9KQhuyTENE0zqRURXRP8c7A&oe=69FDD09E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
tps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_1126328019189174_4885906980318045246_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKQLdnHaGHMQ7kNvwERs3So&_nc_oc=Adp-2Ak3Q6vS0k91Fw6Az1pY2KJVVZ--hjTofD3R3zXTgi5vQVBVwzbFNGSrNjvyG4k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDlnu6C2NdLL1FxFJX7cxOdYpLzBTQfcQYgcuTIdswOw&oe=6AFB3854"}, {"file_name": "3.png", "id": "910743867837987", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984443_910743871171320_2854827740121786623_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNEYLYB3fZQQ7kNvwH7PSpA&_nc_oc=Adq1kXM6hV46BLKgupUaYMSTGm8dgTX0wpiuQaaceLFrWhIoJ8BkJyOpx0GJ3Dn_6p0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_zZQaTIlfz59dJMCu67zGwRtC0lTtGwL-yjrAGXdmKQ&oe=6AFB445A"}, {"file_name": "6.png", "id": "1320544502313929", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75278189_1320544505647262_7322829517315090882_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkP7yr18n0AQ7kNvwEg1rBW&_nc_oc=AdplAuaNwKTTMjXTj7G6tkKLvsKYnOVurvqAp73VKTzXIJ0W5etL5r4vEeTeQBuQNX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNChaMyKbJOA7-9qAMfgDGCv9Ed-dY-OziAct4ZkpRmQ&oe=6AFB3C7B"}, {"file_name": "2.png", "id": "1734844490691892", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974844_1734844494025225_778535308743462438_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb8RZ1medh4Q7kNvwH24_Vd&_nc_oc=Adr8jhxBHL0vLxSuGRdBNcEVqS1xCw5r3iFeP-0krcnwNtIFz-CwkZZhrUIW0OSxE2Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzBnXJUFsNzrhKHFIkJ3dQ9FGunX-w6Le6KzYr5JcBYA&oe=6AFB1581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (1).png", "id": "473024245842426", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982620_473024249175759_566385611604994110_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JCVEAFhItYQ7kNvwH8HCsZ&_nc_oc=AdoigmRdSbRP61yZAKLhl7yGmKkccpQvL2mqWyYcXQGTCSv_ueUZi_SU16-T9sI_L_g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3dFZDwhL7AkN0Dr-MZJFuzeiT6pYfWsYQZTivd_n3eQ&oe=6AFB478B"}, "display_name": "Euphoria Beats", "keywords": ["Immersive", "competitive", "Music", "Dance", "Engaging"], "long_description": "**Dance Deep Dive**\n\n**Euphoria Beats VR** is an immersive rhythm-based VR experience that invites players to express themselves through dance and movement. Designed for players of all skill levels, the game focuses on its **Casual Mode**, offering a vibrant, low-pressure environment to unwind, groove, and have fun.\n\nIn **Euphoria Beats VR**, players can explore two dynamic and visually stunning environments: \n\n- **Pub Dance Floor**: Step into a neon-lit bar, alive with energy and rhythm. Dance across a glowing, reflective floor while interactive props like vibrant lights respond to your every move. The warm golden and cyan hues create a welcoming social atmosphere where players can relax and dance to the beat.  \n   \n- **Abstract Space**: Enter a surreal, dreamlike world filled with floating geometric shapes, glowing orbs, and fluid visuals that pulse with the rhythm. The vivid magenta and cyan tones provide a creative escape, letting players lose themselves in a limitless, artistic dance experience.\n\nFrom hitting glowing rhythm points to creating trails of light with every movement, the first-person gameplay ensures total immersion. Whether you're seeking a relaxed dance session or a creative outlet, *Euphoria Beats VR* delivers a visually rich and rhythm-synced experience that celebrates the joy of music, movement, and freedom of expression.", "short_description": "Euphoria Beats VR is an immersive rhythm-based VR game that lets you dance your way through vibrant environments. Featuring Casual Mode, players can groove freely in two unique settings: the neon-lit Pub Dance Floor, exuding lively social vibes, and the surreal Abstract Space, a dreamlike world of glowing shapes and dynamic colors. With first-person gameplay and beat-synced visuals, Euphoria Beats VR offers a relaxing, expressive experience for players of all skill levels."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27918529404428361"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30527732260174716", "version": "0.0.31"}, "id": "1134620181582156", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27918529371095031", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30527732260174716"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
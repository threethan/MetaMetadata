6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBREwvGf1jwQ7kNvwG4iD1v&_nc_oc=AdrzihkitXOZnpB0TCKgncTZG71WdlkIAufDASi_ZZ-W8vbOXMNms0QX2vgR7Dfz3Po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jxwtQYUX3zrrn1GK2ez8dnxcYlr4tGcRNeOTsKQDysA&oe=6A05E4D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRd3Ok6dnXoQ7kNvwGdpKhQ&_nc_oc=Adqy-3nryGmi9DW9ZYlHAHjrKtS-gr09HAnrmMTKb8_St1qoGsZElgZdhQy6vff6kkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ryQFwC4WIIwaCPfIxvl3f3wlJUBrn_0sifxQPqZcilg&oe=6A05E644"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myJmVKtPOTEQ7kNvwHEHObN&_nc_oc=AdoAqsV4Ovg_G_s_0RAH5kwzNQwtoecHyueELPr2Dgc7ZFvofsPoTHB3eSw6Q-1gxWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K-j-wgesUuA0Qlvm-b_CLFl4C7IfhhmxIOvw0vu_BsQ&oe=6A05EAA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEUQ03O4lggQ7kNvwGBEqSs&_nc_oc=Adp0-Xo8GB7nIfoGAy2Y8RTFoNvKz1gTBjUCXSIt9M-J7rb7lTfM2ueFDk0otfdMagM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oyz3x9vkyiFtvMvbFsph0nfenweLFirbHoPQhjktXdw&oe=6A05CAFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuvC533cGC4Q7kNvwGnKtpa&_nc_oc=Ado1vbcY_vGxK3Ssaibsgg3q_j7n4DJzT1noWnHrERFgbiV7fhbovFMU571j0HfZeGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e49Q0ReAGG7PI39xVQd78hHoU_U3zLF3j2Yu77VimBw&oe=6A05B99E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
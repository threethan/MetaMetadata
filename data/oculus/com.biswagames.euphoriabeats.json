6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3UreBff6XEQ7kNvwHQxgX5&_nc_oc=AdpVIFKgFwz5gdaj49uMhkDocikMuZjHX_HL7ryuZ71Rnsrh9BsVSSKX0HFGRhBrmtc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XYdkZPgtNfyjNvdU-3I493OECPkd7JHpyW1TzlC66iQ&oe=69E640D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EEXEK3dlgQQ7kNvwGhIyuZ&_nc_oc=Adr1zsyn8lpj_NiagkYtOQE_9P9KyYjMeJNsmDMmbdl2N2MgB8kJ5nc9fqzv43xKamg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GgLjlYlR1j0avsagavHu0aW_mqoWrQVoQaItd6Ig7Lw&oe=69E64244"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1LW9a3Z1boQ7kNvwFiNQbV&_nc_oc=Adq2aEUD28jzOvWj68D5Vr0U_QnUCFvewL7j7JDXK-262jFeyMUbUX0i-Zf29GV2uc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kUcr7cMd0FMoREIm8YblbLyEw0ihMrK-tCXCkDuejxg&oe=69E646A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JCyMMFtKaMQ7kNvwG4JAcT&_nc_oc=Adq7SYYid4ola5sOusqiCj90-BZmkClF-Hg-9v-VfuRSclpBq6Q5fL-FBJ24L5ys4_g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r9Iel8ck_HBaEfpCrJn3MpW0QRN8LKzeMeJfQBLxjuQ&oe=69E626FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hzL8CA3mw0Q7kNvwHC0K_t&_nc_oc=AdpmZGh2oKONMyYPuIB-dCcU0zfu-_ZGAfSQ1_ujSDdNrRWozIp4nXaiN0dW39DJJGg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ovDgf6htk9DGwKoxb50Cr8Dc97IsBiCSPp2nCsr17Hw&oe=69E6159E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STx40OnNrO0Q7kNvwGvxZvL&_nc_oc=AdqjKpj0D-Z3L5qG13EaCo9fq7iQxY7_W0DSvsv6eRjQDTU7m8rZOD4XLsve-UMD6A4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHF5wAj_gmDHYZ0kFBJeMmxBPA2ZJcE8KTN4J6aAMDtg&oe=6A565056"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuSMCdGVYR8Q7kNvwGuKHBp&_nc_oc=Adp8DhjqlKI54EO9jSEW0Sabwus940LL1VC3ma2N4JmPDPYIx0VPsN4Gdgbs-Bau8CQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB09GPR4fzYer7kfn8rjmAfHK-7if1oOMtAlsYXR-fGbw&oe=6A5651C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-qphhtlhhsQ7kNvwHcs-l3&_nc_oc=AdomzkgboUptGJD_igGm3hyK7crZkUlKo33RFXzqp2o79pT-5ZFDRNgeuXhkB0ABY2w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWADX_pumCHGuFBSgFlmuADPYmxPvyyaXDLGrtWrUmBw&oe=6A565629"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ibvzXOQKeYQ7kNvwFXY_Zv&_nc_oc=AdqCTfEkE01as5qoBHP27IeVXP00fPZKUTD-NvU7s6Y6rLxoPRFjp6Vr_dFtZOtPbl8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQVc8_qqIgl-xHSRhZYCb180FBecOTgMkbuZczhBNebw&oe=6A56367A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJaH66BqZ-EQ7kNvwHiYfqr&_nc_oc=AdpyDbFNsDFFu_isSHM3atyCthFrbZ-87udMhWxp-PFkM4AUeZzaLubuzOntWE4OqoU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPDy1cJJ-73dY_l6gg652GV39t_x9YpaFUHNWCkZA3oQ&oe=6A56251E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
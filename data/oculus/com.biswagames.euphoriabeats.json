6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk-gdr815I4Q7kNvwFH77_t&_nc_oc=Adp_6YGYmRD5ycka-mkBNaqsuM1Y-FROavuqBrIjUGbioHJHuCmYJBc23s6jz_l0XDQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS4B4j0oGbrHOWf0yFXXrNU6rvBV_8H3MvURVZ39w4Qg&oe=6A972216"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fmb0mk7J3UwQ7kNvwEfo5Rs&_nc_oc=AdqJ2NEPUI4edlWABkSJJsOrdpMEi5XUnc0x0ijKa0UkTIT10fUJvj5Aj7Y6D8m64XI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBoSRiPvydm1AkQBBSAvPGZn7cxc6NCxjvqXEgTDy-4A&oe=6A972384"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Kec6xJGZ8Q7kNvwHp418P&_nc_oc=AdrlgGi6V_YYu6fRLFWYZFi4vTFfn_07Zy6gHn3ZLI18qx5otbB0ws6YuxCsBa-DVqI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKHXRPbKpsk9Kq_b0UySutxvGNE5AaX4qiUF35tVXdTg&oe=6A9727E9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-5uyf0P3MMQ7kNvwGs2_ER&_nc_oc=AdqigLe_481FdmR0BYsCBRvj-zmVZ6p9w-Qnt_dSLu2BjWyiDcKYGXLgaQHrdr9OU60&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9WPuoXLYz6WEwuxKnn4jaHN7UMtqZqDNnaKKef_iKNQ&oe=6A97407A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f2UnAAHTIMQ7kNvwGWeOi0&_nc_oc=Adq3vIcEhRt6AO8-XokFicWJIiLiY7YBvyaXitZVO5IlnoaQZ1Ui-O9zVfxyk7nlO64&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAhTjTcell-q6102PeeyVwnsxW2aHT_weJ3H-_VRs6Pw&oe=6A972F1E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RchowhsHna0Q7kNvwEbO3oz&_nc_oc=AdpnEKydQgASd2bz0g8nLc_LaU_peXyHTOpvCUstbjcH9XiveElkdLD-rXvJVGsoh5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpcbdTUSVCPR1_JgGsRDus7TbMZI_Luhv4sdLYEOLs7A&oe=6ACBA5D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a3sS037XwMQ7kNvwGVtbp3&_nc_oc=AdrmRB2SmQpCWETPJUrseYZEfY9_TSoPeRH5Jp4Cul3o1TY_LPIT_GBHAHNqurzNjcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEOXbmgI8gG-haump6tglh30iwiQjOBHF5Jm2jl4afzQ&oe=6ACBA744"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZNKaLiEQL0Q7kNvwFQh_6v&_nc_oc=AdrAY9S3RXCPe6qlZv-afaX2vtkN_qXouFieGRNt0Se7Ry8tjf254RkhfYqgv5QdRvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDdve19WUIZxKUSlYglgCAwu6mVGSvuH913oonVZfrfA&oe=6ACBABA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6NFFDZcZ_kQ7kNvwFSBCBW&_nc_oc=Adr7GUyosFSrt9G8yGEbYtdzEvrMPYgbGIu2fGmarhepRB7fqWeTiZDQIzJkv1f9RkU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtEO-BYMhQ3rdkSGPcYli3sPeBG23WeKBisSt8fCCt7g&oe=6ACBC43A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IZUnMz3_gEQ7kNvwFHX8JU&_nc_oc=AdqbE_OuWwJMy2LwxJV9N_-lS1XGAFrjg5lwkVZNi-hwpSuqcfHXYZL6_aA1JgxV3jc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi6NMtsnl4Qg5qznWX0916gLEw47YOWByKRrChzV8Gtg&oe=6ACBB2DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
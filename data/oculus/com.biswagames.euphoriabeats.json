g", "id": "1019730033163233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUfk5OQhIO8Q7kNvwGLlKIw&_nc_oc=AdpCtBHL-4VZ1d4JHRj9XLo2kSAAQMK-KdPNkNn2krA-RYYZFtqcshuC9iHBQlZdO-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpahkWtvKyJSiPyiHT57fDqNwNLENXEsLtBrAJbUD5lw&oe=6AF08FD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4gMpbkSb5sQ7kNvwFFSu8w&_nc_oc=Adry4-6AEh-b9HwXbG9eaBUc8qXx4PvggF7GxVedOi03w4wq4lgCvVZfNSaW6VvFtwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiZAuA8BcRSpT3THWBrKIT_irLYBvWE6CkL_hS00Tk9A&oe=6AF09144"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WetNTH8rz_4Q7kNvwFnUDPh&_nc_oc=Adr3iYaO1Ws-YPKMYJi5bJC7nKrHeGtAhqfJiCiNucGdeYqJafOGp40oYf9IhXpCUX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv1vUkzxKIIepcibL1obN00Qd_gqMygCt_XtWX1ovq1g&oe=6AF095A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dShdkTCfsUQQ7kNvwEq__qb&_nc_oc=AdpINwwZ4SW-BVA9nEv3Iq5LexTVYv4ifcHSwdq-P6qaTB3p_naxsukEME5cNNQBs_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjIGgoPpJGb5WiU5nqlg7O-8DhGyARj87aJcpoBzvqpg&oe=6AF0AE3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUAjHqQ6P-MQ7kNvwHc4yV_&_nc_oc=Adp20oyopYCTuzPe03EsQkj-pti0cPd_4EsIZ_5YqWxuHo1DnaTvpGlCWu-9Vkbrc0I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy3mwowqQZQumADfEXfoGZ52HEXA8CF7mfkiZMP1rr8A&oe=6AF09CDE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
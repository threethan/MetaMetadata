tps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_1126328019189174_4885906980318045246_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJtF5mo-AO0Q7kNvwHVoEE9&_nc_oc=Adqif4o3hCBKSgVVSHrN-9ffhJF40s3ScUr94Rz_GGYiTy5yeZSh46D1k2nWxrFunV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA93p6j3VPSDkJKGhDTGhECbERqiUMYuWeJYUtMZFySQ&oe=6AFC89D4"}, {"file_name": "3.png", "id": "910743867837987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984443_910743871171320_2854827740121786623_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNEYLYB3fZQQ7kNvwGqzYFh&_nc_oc=AdoXjfaRoWa0Suty1eFKIimV4uGY_r5sLIyQukKY_BIltZlXnLHEyb23LYh--oni5kQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRuGNerCv9iyWMrtHsHWlogEfzTK0NkfvJSpgJyKYLRg&oe=6AFC95DA"}, {"file_name": "6.png", "id": "1320544502313929", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75278189_1320544505647262_7322829517315090882_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkP7yr18n0AQ7kNvwGMcXvS&_nc_oc=AdoALgmhfeAPJaZHXqz9E4kjCpyLJzcUNnE3eLtEDOXgdrFUvysnoJZ2wcDK7625vEQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTVbEHqI0aJ87XhnyJ6TsnY7JPtuMdh4CKglpKPje88g&oe=6AFC8DFB"}, {"file_name": "2.png", "id": "1734844490691892", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974844_1734844494025225_778535308743462438_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goZcMzrq2qgQ7kNvwFAHIky&_nc_oc=Adr1bCAfWJmnomtQyBMqXVXy1Ua1tnKKU1IQuBhl7vSyb_7lnkjlfeg-SqrXemojUKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBxcWSh5qir2RiO7UMQgWcWWLomJXTaJSCXREWb_nKaQ&oe=6AFC6701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (1).png", "id": "473024245842426", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982620_473024249175759_566385611604994110_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JCVEAFhItYQ7kNvwExV3Ln&_nc_oc=AdrNaWiYhufl00t662IYz_HbgCxbunUCavw-E0axqbW9AuSBPYCwsf4tC5odZdSXWmY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW1Cqj6SCXylco5Z-paeWsNiaJk7-Sq0LrsP2LN_lNZA&oe=6AFC60CB"}, "display_name": "Euphoria Beats", "keywords": ["Immersive", "competitive", "Music", "Dance", "Engaging"], "long_description": "**Dance Deep Dive**\n\n**Euphoria Beats VR** is an immersive rhythm-based VR experience that invites players to express themselves through dance and movement. Designed for players of all skill levels, the game focuses on its **Casual Mode**, offering a vibrant, low-pressure environment to unwind, groove, and have fun.\n\nIn **Euphoria Beats VR**, players can explore two dynamic and visually stunning environments: \n\n- **Pub Dance Floor**: Step into a neon-lit bar, alive with energy and rhythm. Dance across a glowing, reflective floor while interactive props like vibrant lights respond to your every move. The warm golden and cyan hues create a welcoming social atmosphere where players can relax and dance to the beat.  \n   \n- **Abstract Space**: Enter a surreal, dreamlike world filled with floating geometric shapes, glowing orbs, and fluid visuals that pulse with the rhythm. The vivid magenta and cyan tones provide a creative escape, letting players lose themselves in a limitless, artistic dance experience.\n\nFrom hitting glowing rhythm points to creating trails of light with every movement, the first-person gameplay ensures total immersion. Whether you're seeking a relaxed dance session or a creative outlet, *Euphoria Beats VR* delivers a visually rich and rhythm-synced experience that celebrates the joy of music, movement, and freedom of expression.", "short_description": "Euphoria Beats VR is an immersive rhythm-based VR game that lets you dance your way through vibrant environments. Featuring Casual Mode, players can groove freely in two unique settings: the neon-lit Pub Dance Floor, exuding lively social vibes, and the surreal Abstract Space, a dreamlike world of glowing shapes and dynamic colors. With first-person gameplay and beat-synced visuals, Euphoria Beats VR offers a relaxing, expressive experience for players of all skill levels."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27918529404428361"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30527732260174716", "version": "0.0.31"}, "id": "1134620181582156", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27918529371095031", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30527732260174716"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
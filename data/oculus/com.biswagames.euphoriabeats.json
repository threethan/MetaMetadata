6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ewz5sftHNcQ7kNvwEHnybl&_nc_oc=AdrjMZkYEnd0bj05dKEdu90Fw_zTaM9PLHmQSXwLN51TBJcIkQGh5lLeKmfsROy33R4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af899SPfkV5sFRU6jGslvDzoZdTHD_L11uh7ZJQXf8VqZw&oe=6A243756"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qmj0MknppMoQ7kNvwFY-N_d&_nc_oc=AdqFdIvXbk6PFYI75HhmXcxBLBSbmwBMI0Krc5mclRoVrqA0oHfNID6KHSpRGdMe8FE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85KGuWW1lKqU26j5dcpcM0aXpp1a1KWYD8jjXJc1WvjA&oe=6A2438C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfSvKgFqhKYQ7kNvwGFYcK6&_nc_oc=Adok2yVi3Yq6cxlNz4rqyFphXKNw7J5gXkae5RlKcZJPTkQH2C7X-aYhe_Xs6tRtCUQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7bp7fdiKBtiCoIqXD3h5ldkBOz07mdDGWkEbALaQpvw&oe=6A243D29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuCtz4JplkcQ7kNvwH3sq7T&_nc_oc=AdrtZDGl9HL2TqkeBbORuADQKusO90XGuMTrOOIP85blgHfThYotYsTNG3IRCLCz3R0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tMkBS87IMOS0yCHqA17x6ut_yWloLURaSTxSFt7hzyA&oe=6A241D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLnCb5WZSj8Q7kNvwHWlHvw&_nc_oc=AdriJFg7OJPl4OtmXoDjR45iyb_CQGq1Oz1plhTx7jPaKqd1R9H56pkOKJHHBmiGtoE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89_buPAgvBXxrJ0TnlKKGifMOJwIU1LLIM9z5F1kvRAA&oe=6A24445E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvQODn8nwZQQ7kNvwGWd-pN&_nc_oc=Adr-_CS1cRMfe0xmU1wQLZTW2iA0ED9bYttdCyqgKy_do35u_kaBUtWLvQKiLiU3TGg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaZ4YTJb64PW8DTFbxf2f6NOtTraCFwwweTJvcpgFPQg&oe=6AA02456"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujNwAnZutIgQ7kNvwGGdqkF&_nc_oc=AdqgEG79oca5TzdZZrhZQ2eTwhjRFl9GWTTcF0Y8yMHUiMx8CKTeQrmXwd5zgD1Zmcg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5v1J2ymIanM9oZCInfPvk5WCXLxWiPuQIk9muN1mryA&oe=6AA025C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFXLwfbG484Q7kNvwH3BvzP&_nc_oc=Adop-uxxVI3-8ysr1zt69hamEsn_WkaQjXXAPy6rmjRd9uFdVKyLgo0mpYJX-bGy97Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUw_LeXbjMatrNNRo2CyX--Q-ombbFBADpnknssD3F2w&oe=6AA02A29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZUut1jf8BwQ7kNvwGPlbtb&_nc_oc=AdqoiY5kQXciASWJHYSSLGeC7qlj8hBviOuj6japM42mheqaT5q7p11GVdcsh0pkHhE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqiyJFuxsWxnutVG3UzR2XxuoVfdyKbN4gjpBAWR1GAg&oe=6AA00A7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0e6tzjMyf8Q7kNvwGRvrMS&_nc_oc=AdpVYxDxe16yDdrEUjf8U7n3fZUnUDtB8cA_NBO5W45FL2Bmc1kzGhkozoxxZiuNmCM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4QIo5E9Wl3dR8enmk7R-JvuY41u7juiXTVxNvoauoA&oe=6A9FF91E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UakQOEemqAwQ7kNvwEKLkRn&_nc_oc=AdrT-5PMgKy4u0LB26vvrtxrAW-wtaz18i91gyOt9tDs2QDpI3zU2o2KtoTi2PCJPf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-au0iw1r96Cjx8wFXaOy71G9jWpVEZJLChOHUdVnjn8Q&oe=6A316656"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMFW2dXcxfoQ7kNvwGZ1f0V&_nc_oc=Adreb7BhuVstxJOnp8D5m9c4drdFWCfWjxsVEuTIPwWYOq38hyw3M_OyaGXrJjQISUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c1rK1ryPHPNNt2wjNz2MbVLQYUEgAz67HBmEd_aUWTQ&oe=6A3167C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxakOyZ8JswQ7kNvwH1QQos&_nc_oc=Adr_hM5tyZQbwPxGJbMUpwMHbbWNHkpdqGjVKeYdXrkPh3g2OK6AnOGdnyjZW67ONok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8REyiosqWsTENOpSP0Lltfc8ZHjeTG6xFckxDZK1Ij2w&oe=6A316C29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYs0L_3jAHsQ7kNvwGGngBh&_nc_oc=AdrjSyZLIIkxJ8-KdWtgq-FOt6a380mylo56oWk8o6kxN8Wwoi_4mVtaHjtUWYODMbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b2A56-NRPoAahyqQuqd6jF6DAJWxK-On2qtum9S97HA&oe=6A314C7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nsJo5zn3pUQ7kNvwFhw1UZ&_nc_oc=AdqS44SgUgAZKgZik0uzNavY-qqkP6qO-dMR1PO_oyd1JlgCVdldfDgsHmy0D9al2_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K2VU5HlXvBEKVpQWUyfSexRpXMpzyFCfjOABswghCGA&oe=6A31735E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRLgdqLz_-QQ7kNvwFOKrOc&_nc_oc=Adp8bBau9Aa5NQTBUJ86C4Xwo7GL7Yp1zY5uBDnQaPpz3IIt4RNMkqa9E_hU2Dta7Ns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrL-nzfspT4v0jFkNeM1kzfebB0adlDLEWjgeZBovd7Q&oe=6A5CAF96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lA6BfOvZlMQ7kNvwH9NmJ3&_nc_oc=Adpm9xF3ieHa-ZddmNmuwXByUkxPJIDVL2tNPDEhCAyn63bRvYnO3W7X8NEKl0hfgwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcj1buf4momdDW2djt-yQwZOxG3Vp0vSxtavYbUQa6mg&oe=6A5CB104"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RayR5m42PIQ7kNvwHUKnmG&_nc_oc=AdqkgyfiZZaVu31ImDDPH6qo40qGp8_HAZrYFuuoaxfxheTXZcvyVJgznDB2j3r7E04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDIDIolX2JlY0-hLdnqX0TquFWry_3fjeuVSPFeRpK2g&oe=6A5CB569"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N-st7Pi__IQ7kNvwFSQ62I&_nc_oc=AdrMvFdzThFcNrPQa9PRIXcjvDCM-VKtAznIK1mr75ue5fEowTsfnXvHjTghaK3EGV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqkNPDrt14gkC3SF5gy6yRc2C17omYjxrH6N_laDML1Q&oe=6A5CCDFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LExplZR5ZPsQ7kNvwHJJm4v&_nc_oc=Adp6K3cB27Zk5gW0NZjlZGyfXfCqyYAu_tiMZ8VqbCg2roK4UjFuDR9-uBrBklpLpj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEy8ghg2GwUmjWsMUnv4Lt9IeG0BpyGGJ3EHju3tqW2A&oe=6A5CBC9E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
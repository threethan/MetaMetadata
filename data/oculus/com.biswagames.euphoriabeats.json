6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mypo-AGaPd4Q7kNvwFU8QqS&_nc_oc=AdqFiDqBPjn2YpyDfMEikE0-P85UT-lk_zwYLqgBc47ePCk0S1GVxrBwfGM578FiAlw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB7FUySdrjlt5rbQlK2T8LQ27n4QnXxN5wIJ6mjjY6vw&oe=6A58F356"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyGBo2U3Sa4Q7kNvwEi6rdk&_nc_oc=AdoZfbUPuL11pCRzywX2CdzngxQCNLwdovtxaBei_cQioh8XfiKgtA9g7z1N1DLoCXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpTtL0nI5kPh1i6Eq2EUlEi7noPBabDjlffGnqcgEtxw&oe=6A58F4C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWPvXhO9UXQQ7kNvwEnadGT&_nc_oc=Adrtx9hLwqKjcKSi8stRI2W7sw9IvEu9z4T3_E_9P6H_TA1TBBZn8XYCbKHoysy1PhI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0jYYAFTP0FHUm_amE3nst_oJS7_aXAILMyND6nrtgvQ&oe=6A58F929"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koV0yLKg6hAQ7kNvwG6Vt24&_nc_oc=AdoIPbTFv8K4HNZPXx9thS8YUQZgpNGhAw9ELlT0r-zIxCzdrrFAdeI3phRbUU7CPzE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDITjJsqTmDtjxkcIDyG0iNw1xBejVV-6SlQr7-9X7z1g&oe=6A58D97A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJaH66BqZ-EQ7kNvwHWyK4I&_nc_oc=AdrO11XasP-CIXkqtKESTVOu_8_G4GtHePAg1oF8N-slRtRkf9wznoe2OW7WJDOeETA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC57kRyxFuL9DG8XFtBAnReHysqDV-bgU4rkDA79tB6dQ&oe=6A58C81E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
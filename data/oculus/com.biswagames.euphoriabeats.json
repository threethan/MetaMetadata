culuscdn.com&oh=00_Aft1_WzhUjhdpmTjOsF64xDaWhslqHQrJU-WC7eWVzo-BA&oe=69A43E3B"}, {"file_name": "2.png", "id": "1734844490691892", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1734844494025225_778535308743462438_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVpxkYxRHOoQ7kNvwEmLXXv&_nc_oc=AdlOngl1OaxJx8LAdlvn7rUfgbKdj86u-Uc_HW79Qx1SzqZOcb5w1-DUmNqIP8edLXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs0a0FGlyZ38VfyLs88wlZRd6p5zwPEqBnFWkUd84gNqw&oe=69A44F81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (1).png", "id": "473024245842426", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982620_473024249175759_566385611604994110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eejw1LDtMFMQ7kNvwFroAGu&_nc_oc=Adk7-2-YIjekSOmFUJ4iuY9G2LYplXccNPjA1wN8MoMVq_byNPSsyTEn4x_0nBUzHJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuqiD_FptW3F9VC7AcXACeTNWLBkEjWszrBxS1vZFxpuQ&oe=69A4494B"}, "display_name": "Euphoria Beats", "keywords": ["Immersive", "competitive", "Music", "Dance", "Engaging"], "long_description": "**Dance Deep Dive**\n\n**Euphoria Beats VR** is an immersive rhythm-based VR experience that invites players to express themselves through dance and movement. Designed for players of all skill levels, the game focuses on its **Casual Mode**, offering a vibrant, low-pressure environment to unwind, groove, and have fun.\n\nIn **Euphoria Beats VR**, players can explore two dynamic and visually stunning environments: \n\n- **Pub Dance Floor**: Step into a neon-lit bar, alive with energy and rhythm. Dance across a glowing, reflective floor while interactive props like vibrant lights respond to your every move. The warm golden and cyan hues create a welcoming social atmosphere where players can relax and dance to the beat.  \n   \n- **Abstract Space**: Enter a surreal, dreamlike world filled with floating geometric shapes, glowing orbs, and fluid visuals that pulse with the rhythm. The vivid magenta and cyan tones provide a creative escape, letting players lose themselves in a limitless, artistic dance experience.\n\nFrom hitting glowing rhythm points to creating trails of light with every movement, the first-person gameplay ensures total immersion. Whether you're seeking a relaxed dance session or a creative outlet, *Euphoria Beats VR* delivers a visually rich and rhythm-synced experience that celebrates the joy of music, movement, and freedom of expression.", "short_description": "Euphoria Beats VR is an immersive rhythm-based VR game that lets you dance your way through vibrant environments. Featuring Casual Mode, players can groove freely in two unique settings: the neon-lit Pub Dance Floor, exuding lively social vibes, and the surreal Abstract Space, a dreamlike world of glowing shapes and dynamic colors. With first-person gameplay and beat-synced visuals, Euphoria Beats VR offers a relaxing, expressive experience for players of all skill levels."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27918529404428361"}}]}, "scheduled_offers": {"count":
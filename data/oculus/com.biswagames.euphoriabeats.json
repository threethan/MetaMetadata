6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n9sR_NVK8AQ7kNvwGThDRm&_nc_oc=AdpT2_fT8-BfoLh8FlvqWsOaKcg9WGBoXQ_U-c1cQo2UXdmANb5FpKq6HHW7oDNCuVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjpFxM4UMOnsiPKZ6N5n8wj7WUyCaV7BgX5eXClR39EA&oe=6A9C2FD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgfbSocEDgQ7kNvwFjtJoo&_nc_oc=Adqp13ej747KDsU33iqIvECwC8vIcqWiitf5peVcYy7gZOq18N-CSmJk2E571OWHovQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqqKBh0yhbwZhsAskzRnP2pJGXOElvNagoNff1tWmCYg&oe=6A9C3144"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEzyTQI8jWMQ7kNvwF3dbng&_nc_oc=AdpWgFfR1B9JxEiGwQJmv6C4auxWNHyVahBVNTbKEeZIbJSC6Xe5GV9-jnHpa1oxurY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe0fDwikL6UEo6C-bQ11eK_Zm0PPkN9T2HHuazhClrQA&oe=6A9C35A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9lQLuctgyQQ7kNvwFqhPR_&_nc_oc=AdrqtiyWTGh0FlSlJtbCISCdc4JhdkGv2MiH37aXN4EOs43iByh1QIu0xEghcNdVIUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJreo8lf349P4Z7g4CPrBL3voPyA-vMeA0JMZ204yRDrw&oe=6A9C15FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvvVYWsedjEQ7kNvwF5BDY2&_nc_oc=AdqJWMu7rXZg1s1zs3uenCmPO86qKk2Z7TdINqh18FgbIFf3kcbnJ5CzluXuISMhL_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW1e-AHeK7nU1C5w0TA1AWyM8Y5LM5OR78ZkQ7o_sjDg&oe=6A9C3CDE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
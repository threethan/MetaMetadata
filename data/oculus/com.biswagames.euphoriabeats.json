6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUIZ0AOSKmMQ7kNvwFa_k7S&_nc_oc=AdpUWlx1HGWqe39XAhtJKN-kZ-pdCMGpZqI_dsBwo4kD7LAGDm_3wWqJCZK6BIONPP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-jBate0noCtFBEU9i2XC7xd3vxUKsDVf13AXsBFyyHA&oe=69CCFC16"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex6K5i1X62oQ7kNvwE4eCuH&_nc_oc=AdpLpEQNc3DrMkaeCMNDeMDt1FBrPeMqv0Q9YQa989MIIo_X8O_IYeXNlaGWol_g5dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw09k491ngnDUmNyYDO41Tk1ucOPRksdYnPji78mm5G7g&oe=69CCFD84"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=400M5nRbTF0Q7kNvwFIpXKP&_nc_oc=AdpCtVAVuqurnF91xc8ofnvturbT9Z2f68RqfO1NR5l72hz3RVSjg2oU0L3CWwqEzV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUtWF34DUIgnrHDRLYea1_ckc5RetFXqu1-UOBUXu5Gg&oe=69CD01E9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyfXRtb_KbkQ7kNvwFmQFLJ&_nc_oc=Adr19S667zoX1q2Fv40AtTnQFKEVyPLS6ciXJcnB794K5_B4UTzyU_f6_24RCj9-rls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzccIKlr1oZB2jwkboi00p1yiGZSCfWvvmlQlu1DPX2qw&oe=69CD1A7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjYDK9txbDoQ7kNvwGOsIR3&_nc_oc=AdoidFq4Le3u9hKAFByxr7GrNx5ktU2uo7dfwgTWIInIEU85S43bjY0WIolkvqAFawc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwuymt9JeyHZT8VT5DM8UAD4kDUQfFuxL_eg_qR3mAwcA&oe=69CD091E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
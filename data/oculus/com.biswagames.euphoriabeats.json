6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBREwvGf1jwQ7kNvwFWgZoS&_nc_oc=AdopoJvkb7wp5kkSiGswpPUqH7fYmc7JvVDxkvb94s-2Ykj1uqvE2xyN5VBL52ebe-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YGW9ZTbBC9NTG4e79qoXvvzvHzlL_Q6xatjsF4duxFw&oe=6A073656"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRd3Ok6dnXoQ7kNvwEAN1Yu&_nc_oc=AdpmS5o48b0ckzCfdtpJg3rpLva0cFQ19vsB7-scvAU25Sc1C3aE6OOLd_NViA9Es20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71LTtBpBfahV6G81uNfTpJG0Ez79Prhrn0ipH26xj2pA&oe=6A0737C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myJmVKtPOTEQ7kNvwHAY1Xc&_nc_oc=Ado1QGdpfuqXVRjWSAawj4znf_mf_nJ_v1sC6YOvgCuRxgDyvpy1G99y5Xs9Wo2Y2vk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4acYCbFEw-ES7ZNCFtVIsDJCy9vVUN4pEEqMpdZTX0aA&oe=6A073C29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEUQ03O4lggQ7kNvwGLf2Xi&_nc_oc=Adpejd8ktB3a8AvpVAioh5SVDkzMD1bx7Xn8tTj-K_T3JRi47JRkLDMpPW9CQVsp6xI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IMlcAbCGA0SEk1Q-MJOs7xOf7oBLhP_du9vWwFHba8Q&oe=6A071C7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9A9BaAuP0IQ7kNvwHVOoFT&_nc_oc=AdqZJVn5_qQ8gdtCCJG-L4c7O60yZfmDLTA9n67meYGlePWxIclERTkKycoEIqR5tlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ldbMNtnHZyPRj-MAkS13CXVRQJjCdbqhcibB4HSrqDQ&oe=6A07435E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
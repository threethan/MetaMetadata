6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBHrIzChCTgQ7kNvwHGpRLv&_nc_oc=AdoDUNFs3khdJso1kpITCS_OCnW3tOJxFdgDec1Z36hNv4gUgLRm6J0tjA3AQiQZktM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-idPvuR97GgZvPGw_8IXBc_KwEx7WdF02KaFPvQ7cCmQ&oe=6A3E9556"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAIqzwbTdC8Q7kNvwGu2quO&_nc_oc=Adrsm-LkyfT6CmI52bBZV0pFmKMVV24tk82MmXgumsU79Ydr2NJObuAk-PBwy-xIOaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mVo-DT4NqiTBuT-vZQbdsTygcAfRb34jvEdNvdyXtRg&oe=6A3E96C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjyYrutXYtQQ7kNvwG6QRZ7&_nc_oc=AdoWvRt5OHsDGX1Y3bwjgjGaHAUHesK-dUWFHSN0xUD9tJaE-2SyNcDatdlqaAHMZHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q6ejBKlmYxFrzO6EizRxJvsSCdfzGgm83ro6DKgiFpw&oe=6A3E9B29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSxOErwIh-4Q7kNvwFTk9RY&_nc_oc=AdrJzKMxyMGrBBZW63XfbBWBULNS-y8pHldjd9LfBx1Haz7o4dm33PsMBJpXVNbFmzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ajRZ-oXfcxUt6BUDD0D5Py9_OHESpUUy4ZXX6sDBn9A&oe=6A3E7B7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P34AldVDlIQ7kNvwEQBFZz&_nc_oc=AdpujOHmR87BSyUUE22DQhAwf8AskxTUgtY7ZE6ywBMYXcA9_liAvGFocloIO3VHRow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gk0KBruu9CQTkFCeI0Rh9QsRho7qABDZtR5JOJjNPfw&oe=6A3EA25E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
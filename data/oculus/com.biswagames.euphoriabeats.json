g", "id": "1019730033163233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo9OpzWoLXwQ7kNvwHOe7kw&_nc_oc=AdoLfRLeovMsV1Ljy3XdHzNgJXaDl20oxZar7FzYgHwczFIUE9ukFuUv4xksZ262LDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU-bxNkM7JCXIz90pBQet0hvd7K9UeaCHXawPjXdfUog&oe=6AF48456"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7TCDNqKYmgQ7kNvwHma3BT&_nc_oc=AdpcCrZC6m2IGLFyWjFjFua2a5-FCMZDnUm14XlHjZYi1UOny5DS0ucfr8qLbSIxn8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVW7cZ_GXJBJlymuYGjP0yR7e-4uUZkwCfVf-wYy1GsQ&oe=6AF485C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyX4VSCMfDoQ7kNvwEqmRCO&_nc_oc=Ado3s15jJspBzWHao3401VPDijZm5SBBHvQHeZPqEqHT_D-tWRABZ21pX-IUGJj4hbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc_5buS69pN51vr_yhEyVaA4vNqxkPBqILVGIEfDEtuQ&oe=6AF48A29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecAXxcKGxcAQ7kNvwGz0t6_&_nc_oc=AdpWz_L4YqDuwdsYvkSkXrRoV8z6ziElWU46aB2224NYZzPMDnaWQ61ws6yRNzFfEnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2mLX4amRBmWbJ2Hd01CUXYg0NrfVsEuYLU8Yh1pXm8g&oe=6AF4A2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY0uvFyEtN4Q7kNvwGsUTrk&_nc_oc=AdqwbLnwHZ3v-f1BYazm_P92Xl0HT_oYhsGqV6qnGMDqAeiEQINnpVarHvHR0d8Bptk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS34Xe567Kg-X26O00i5k48ubtks7FENRtPqUYMR0bSpw&oe=6AF4915E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
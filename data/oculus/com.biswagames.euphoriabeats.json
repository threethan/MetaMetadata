6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqjm1LW6m6cQ7kNvwGxZ3NN&_nc_oc=Adr5ON2FP9N38AP-QvHllDs_gD5DUImmmEt1r1Nzdeb388VpeBmA_tWTsmeHa_cu6Eg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVsqLtoNiVzFttoamwbzRoozSLEwpA53asYF0SZb1Ieg&oe=6AE20F56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI2Z8XmTn3QQ7kNvwEF2khu&_nc_oc=AdrYt-89I-UTBeXyZut-9UEgCVScbjdxfEwatGNZKn_1dwNJ6CdCGo52gDgo4tZrO7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVztGjAcUbzToq17DzgPD0imk1US1XD9fFYfWrqNv5Kw&oe=6AE210C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6z1F7ORbtgQ7kNvwFpl2PP&_nc_oc=AdpKMyCai32ucSAM3GYYINaBrF6lN5B2FHSgYmf61s3sXCg9JmJ4CDJ67EIKTFmm3U4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhu2hB-EK1a4oamTZTCoqbpjwJiLlZ5GLeBAG9rOkZ9Q&oe=6AE21529"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvVNt_a_hkEQ7kNvwF6CWDu&_nc_oc=AdrHKYvoKU2w_tMRPGUNI519Th8TWwC4cgIPE0seoY-4iRKvD0toB3fpsYgenMuXXSw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY8ix_WOMFTa01Z-8iAAqzBQXa08wbPqNnuHc-5s2YUQ&oe=6AE1F57A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0364eC7O0oQ7kNvwG9qYG1&_nc_oc=Adqz8ZTgC2A1bcJOwIPo111Ee-vqtSsbnIQqY4TBwlN4-pdn_MvO1D064-3_UuFHNCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUJLpJ9LoaEJ05S65MbFjx_e7Jrq1h3SlqOGwh1k79_Q&oe=6AE21C5E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
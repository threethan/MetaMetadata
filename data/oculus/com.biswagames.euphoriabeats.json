6_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36kPAsDZ6hUQ7kNvwG6adKv&_nc_oc=AdolFIs8lZrbrJySTO-8zgpYove5zthHmmjcnQcafesnzdjx0ajC3EG6TZN7RHzHEeI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRJC6d7sXdsZ83tt4oOiuhNtuiP8TmWplE6AT4-AU6Bw&oe=6A7DA516"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2gJaxB3z_oQ7kNvwGSO9FM&_nc_oc=AdpcP-E6xy4TtSxJTzBsRfRw329JUYaH7GMbjwSXfH8tfTpn-2Z9qDgSQtUxuIEWZ4I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPVB1DWmVnpIm-yMPlvyqOEMVQ5n5xSNpNvxTPL8JH_g&oe=6A7DA684"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UmERXVcR5wQ7kNvwF3lbSh&_nc_oc=Adq07wuwUVHD2Rf_or6ywGCvVSDnTeQelKDuljOQ5MAudEXV25IFMCMYD855dSJTvBg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7ya1USjKF2eWZ5fTRsyguQ3NHO23fLmSeoMkYPm9FLg&oe=6A7DAAE9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7HThOafap4Q7kNvwFjq4li&_nc_oc=Adpoct5aybUKHdDyRNCKuqnHi1oxK4PiQA7sdVcIQtUjs78MLIsR698LsTj5I91x3AQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQBbLJCl3v0HfoSZ2j698xVrQU9AP92cyoNKRz_ZrB8A&oe=6A7DC37A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ejNuB4axMQ7kNvwFor1JE&_nc_oc=AdoqA7wK72QBDdBCXoYq2e6fYK2235VAglHvESK0SyEZuKrE_SZLNuyjfPbiFxdOBCM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEisOxQB7jK3CxeRRrArsqNBkVS9wG7_2L5Rvs05iBRjw&oe=6A7DB21E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_int
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd8-SUi9EMMQ7kNvwFtX-DL&_nc_oc=Adrv52ty6hC8QMCeOcTeDgD7_s8MjtECCbZzhHsNuCdbER6Bnvlzj6HICpG5p7ktJ5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WxPuyaqeB1P8ovV8RPzU9uDEA3TJSrSKLfbTCb9bhqg&oe=6A297D56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFkIj6um1GYQ7kNvwElih33&_nc_oc=Adqoi2xAR0XxZMa7n8K9_rbSQeon9pHYH-gwSWIyBnsispOAq0DOU5Vy43tImf5Oi0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LpR9FUNcGUmUS1IE5w6Enp_J6PbPtYkdXyBbPhYSoeA&oe=6A297EC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgeGQiGxquIQ7kNvwFBHqwb&_nc_oc=AdqtHfaNaQ8CBnmOM5DaBTmm9hdZYjWpcHy5yRFb7OxPrizmMGih_kNEIY5KL6CKtZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UA1fTzlr7MvQhg_XzBaPx7RMWEZjY_bO0qfZ0y-4wwg&oe=6A298329"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBYC-jet18kQ7kNvwEPXu-L&_nc_oc=Adqt98rAT_nPx2gBNvwXqyWlLITsiQeId3JKqg4XrqrA405gCzipy6g-rTQgaMrmRbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mUS1lVcO3oy-PdpgNzLBUb_S__37mVFUz2MSl_8Qetw&oe=6A29637A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3ceTm7TaO0Q7kNvwG9bDND&_nc_oc=AdpHG47Bl-Th9soDYsucJpDRYLbxvfmxOZpV_gr7eylvfkhH6nyoRvrGuZiK7Dapqhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_NcFIob4rvi1ifafxF6t-X1ZnJBpCHXukGI2LZoyeAQ&oe=6A298A5E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
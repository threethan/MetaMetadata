6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eyu57NxGqgQ7kNvwH53d1f&_nc_oc=AdrM76ck2pXvKmuug7EgwHsqyXF3FTtJosojQ3rz3hN4nvup8rERe8550VBY4-v6i3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dQYmgWAuP7pI-9U_BQCF5DYdGbcb8rPew0CcxDjRp8Q&oe=69F8B5D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXt7nK__KTMQ7kNvwEkBtMZ&_nc_oc=Adr6MYub08tx6s5ZrhE7fe75ALx2WPjW_QwjS4VJmoAyU4DQdoJ24KkNXhDych9hruA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3B2fhxbEhphPRGbw3K7_0VvcngSO95r9o6MhNbWXo8MQ&oe=69F8B744"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K62_UPfNWOwQ7kNvwFBvqYA&_nc_oc=AdqSSLSVzRIP6YAMms1JBsyORLEEQ73rQBj31Dfb9z2cz2aGAZlfwlqfOWKi_2zt7N8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xDcE0qIbG4B8_xyDxFhqFd-EcZVE98cgUhkBASbn4nA&oe=69F8BBA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU-uE4uohrsQ7kNvwEKi3zv&_nc_oc=Adq_AKdygAgMb6W5GXqoxq7hyc65I9BtOJWaN2LDKCRkCulJU-q_r_ABwyV0bJIsuZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dkN31GjLsQ1lyPUp7rDwRnK9Ie9OZNIREL84VK22RXg&oe=69F89BFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73Ro7EQhnIUQ7kNvwGQfR2M&_nc_oc=AdpN2Q8kFREjH2JhA1dyfPbXmvyUPf3vZgfx8xDq2_yOaXA7tRd3BCCFAsI0Baakg3c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HvZ2gLsokeEKvPqczmtsqJ7x67e-b0VPElAzKDO4bFw&oe=69F88A9E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
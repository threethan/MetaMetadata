6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ak1HNAoBAEQ7kNvwEloCg5&_nc_oc=AdrVn-fYYAqmxBlMVAT7-dq2zPRB3PEQuoy5kXVT4YMm6fdHRK5V_oFgqHGh72JfWoI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dn6ie2x63yHsTae33zGQPI0uJlSGxQAw4Zeu0HRieIw&oe=69F4C156"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy7GnqdscNgQ7kNvwEkyUj-&_nc_oc=AdqmceikF5K53QqOilIl6D4wYipyyYoihSHpdNDrLKtzdbntCRFdGxccmkon_-Yy36E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3StYAPsC6rd-McZLmN10OsRZYEjytkJ4ZYIR1wz2yFkw&oe=69F4C2C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85Nh0zb1CWcQ7kNvwEtCw-p&_nc_oc=Adq8j6oMQpo3Y1qH4Dpav7-Nz-olAwKIw4zRAnFC5G2iuoNMoBzWn-qhVSSLjm0bUiE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GXazQE96K0jenov1im_Y-jFZc4cs4mK1ZGnGSPQGhqA&oe=69F4C729"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXp-VVqF5lIQ7kNvwHnFJxg&_nc_oc=Adrs--rOQ1ehNAJKHwF5ZWQDpj8cKD3_99Rk6xYI230M4zNrwSH3VUcTqN_IoDRzE2k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yq6YOdVWDu10BEWSjMRbvdLParZ4HebsqrTT9bQmxWQ&oe=69F4A77A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaSVtPStGvEQ7kNvwG5rW0r&_nc_oc=AdqenW_BqOdhMddhlPRqX_hFnJgIgYUncc-AYY0ru5S0VNFt9sRPgalB8NfFnJ-KCGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nO1sH0iDmPoophikP5q0iu_O4UJkZ2efd6cgmLTtNLg&oe=69F4961E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
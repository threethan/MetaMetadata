6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUIZ0AOSKmMQ7kNvwFiApVa&_nc_oc=AdqeuKd3yqRf49DwLVPLzPizg1iKBTgJq7VkYzgOGPMkaKbhASffwfGyeLR7gn3tyfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKInR4uoIGvQzacAtlbkwvpiGAMZ8XhiaHbpuAWtZgSg&oe=69CBAA96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEFQyfl-o10Q7kNvwEYypjw&_nc_oc=AdppSjRr4YMtJNLbO4s5773IxxkcB2MHusckhw1D_t43wZquzNOUWFAjmDTN5vrT_Fk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzstnZKCCp4dIvzmPlWae6-c4EHAi6CdntGbsRtA5qE9A&oe=69CBAC04"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8afCn6tbzMQ7kNvwEZ-CKN&_nc_oc=Adot4lbohn1_Lq8_q7h6ZuZB8-VueJAFMqnXU7cZjUmQbojGMDZKyqujnCGBI3XOBYA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoKTlbd6Y6vcVp6p7J4SRpoZetVWzuqL1JBi7emSBXpA&oe=69CBB069"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyfXRtb_KbkQ7kNvwHIMM1n&_nc_oc=Adqv6rMbgvlAwYr3koB-WjyXgJMXe1llHgYbGm0UlFMyWpEvQj7bBYHiAsSdXRJnOcY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwPPxrcat4OFc-ezJpI6XNMb2mq2F_kvMaIryFbfqCBQ&oe=69CBC8FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjYDK9txbDoQ7kNvwEFzjiP&_nc_oc=AdqR_-fPeySkb81_FvAIPhGMcID98RQifULTMX1xzVlyhf0EHqToi8-ZemAN-FL76sc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEfk7cjrYrOH_76IGwoB2VwV2yUdtxcbM4c7DUZhSE4A&oe=69CBB79E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
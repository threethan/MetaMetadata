g", "id": "1019730033163233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvl15MFCnJ4Q7kNvwGOSDPC&_nc_oc=AdpSJ53H1fazKBe-UianwW4QjfB6PcHQrorruWS_9OESOtw6EGibQ8kqc6fNge5DIAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEAZXXv0Vs4EcsaKZmDbnGxSh6OkAdpSC3Y0C6y4yDkw&oe=6AF72756"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCeUv-pFRasQ7kNvwFbHfAm&_nc_oc=AdoGg7xXW7ceyS-qTax03LwQlehBKCrlLwgExYgs3BRpKN3G9ux4D1_mflFqfirVCuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbEac7gvseRN7iZyqPCmrJEVerVhWh_6G8M442LrOcvg&oe=6AF728C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK1SHuuhHRwQ7kNvwGJqPtG&_nc_oc=AdoNeZBpsKRUvyWfxC-0O8DxtP3UdACX3fM2C-xVpvteaVSNx9tyA6qwv0-l_iupLIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM9N083yJq6iJNjpd1qCPWOVV09mQXjFlqkYKBywuC_Q&oe=6AF72D29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkycZ86z4pUQ7kNvwE7DHog&_nc_oc=AdrsXE5ubAB0yNolqS5gsuNWi4jhrf5_SHddmNx7gMjvY3wZ0zhifWZ2nU2A4QFcgpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqp25xeJCZqHNI_73pqENE9fWXOco2nlD5Bes6ylOhGw&oe=6AF745BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY0uvFyEtN4Q7kNvwGu91ty&_nc_oc=AdrdSN-Q-jK_3suKXf4pPgGMwXXPDcCsWvPS7YfmRirViEXxc97ZZNGLEe84I_ZJ2Jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMFhk9_R7AIiZ6YFhggIG-bqKHzrRj4vPK5pEDPQBIlA&oe=6AF7345E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
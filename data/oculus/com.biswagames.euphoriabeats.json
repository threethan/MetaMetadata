6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YNOjWBd0PUQ7kNvwHaYgcp&_nc_oc=AdrL23kHKMYQ1ZzTxkgh7iHXePoWteGiuJyO6RXH_XFeiUL69BYWiKqJovvoN_ZzEV0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sNWMAkM30_CrW4oTU1P7fYvYLGZv04427Nt5zSkhS3g&oe=6A1AFCD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=391wEO2jxJsQ7kNvwGlKqYl&_nc_oc=Ado4MlyvTqsvf_f2XEdF1vEL8FwNfiD6FUXHwQ9vt80_q8qDnVHEC_cvfqxcq6dL1z8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YstO94FGItn2O46zBm0LoQqw4TeHlvebEQ0654czlXQ&oe=6A1AFE44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebu-u1Zzi8MQ7kNvwHl5xAj&_nc_oc=AdoLkz4NJr7cqoxmZzuvJUpUH6xF0B2odXKdpUQxzzQaC9bc78x2sD15lbbkL1E6Z2M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40I8VYEthgNvUDQwTDjvluM9VAYAgCaB1UIzgvjbZLWQ&oe=6A1B02A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6MljryEsAUQ7kNvwFE76Au&_nc_oc=AdrR5cHwkQDSel4HjqcQAfYgBVpIK4bxK2PRhh7X4MD7wRdQXV-lBI-DTaxDyGXofLE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qpyZSIbNs2xj1kXf1ScZkaGm1bYXeje08KWjQ3GJaig&oe=6A1AE2FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa9y8uXKi0wQ7kNvwHuEXjJ&_nc_oc=Adry-BOmR0DYmho1iczZ465XbnalFpsKENUx6shzhF_Xdzl9wS-WRRfIvgaE0Oym-yw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a-93VSmKjOGNF27_nnWR-DiTVrEUxcbGrcTynXZlzaA&oe=6A1B09DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
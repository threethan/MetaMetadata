6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeiseU-3a_EQ7kNvwGTe2q0&_nc_oc=AdpfAp_lIXTmL6Y7tSwRkmMywTvrlrlKUvGM8ZogcQUdLwRPg2KKi8kSPJ1EO4mPew4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtprV3cvcTIJmkhHeUvLQHZXVNb5xR3HcFWAdwwxiOOA&oe=69CE4D96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex6K5i1X62oQ7kNvwGNE0LN&_nc_oc=AdopkE19ljW69l9u9Kav5YwtamKyV-AEr1R3TKLD4XC7b87i8tmV2fMK1gAls6XNdTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv-8CfaWTlppEVZ5Wz5jKDN90-F1EpXMX2v7csnTuxMg&oe=69CE4F04"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=400M5nRbTF0Q7kNvwGUew5p&_nc_oc=AdofU8WIEKb4RWxWVr4p9GeyWQwVs2rUXYPedtiXc8zhqUz0dr8zY8J_XpNL9NqpJ0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv1It1JJQa_vglp5LlHntQfCpRFHYELexCL9dwUDIBww&oe=69CE5369"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcJS5vRkM5oQ7kNvwGa5UXs&_nc_oc=Adp69xorkjEWogCgfZglCCPLzZ-aKBFOyxTRbALISmuhPCz93cFeXGqIwT_XBMw4rjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1GTDfttQ0CbVKUl-5rUO3SpctG38cUxhiv6DDdFGBqw&oe=69CE6BFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjYDK9txbDoQ7kNvwGgFNnA&_nc_oc=AdqFG_83Z6IAV4C6f5UNh4VOejlQRFXxiUjcrXPfh_J0y8KYTRmGG6fcNwVZSFF1jbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwx9D7bz0oGqJwlCyhkO2ZlBccnUB8fiRvV6r_qpA6Ajw&oe=69CE5A9E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
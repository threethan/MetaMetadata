6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPZCJHs1PpEQ7kNvwHSLh0v&_nc_oc=AdrYCw0ukZBvZifULdb3sDSUAsnkoW7lxV8Wym4RTpLJLjymGYsE2m0PR0_gnzuBGYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmq0afu8k6VVxTgqYVIhpkAk_dKr6P6-fgzwqSfhQb5A&oe=6ADCC956"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Bt6Z51RTIoQ7kNvwEZITEk&_nc_oc=Adq95LcdxDmsQiUPERwH3ImuaBue4JP0BUvDMUZNnFMXN5NhdbDOmHob5UfJQZGQGP4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPx0wGoKT8ijc2R4jldg1UiOjp5Nu8CDm5gsDmzJ61UQ&oe=6ADCCAC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1R0jhl_OTgQ7kNvwEoO1Ic&_nc_oc=AdoMRKeSfsLciyYGnpA3ZQS31642Z414bM90Mpa9AViD4tAJnT1dUvIwHmVo1xrhXhs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4Wkb7X70r6whcaBjluGU59cz2k7Xwals2AtskBFapAg&oe=6ADCCF29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Weu_RzdJvlQQ7kNvwEuH3fN&_nc_oc=AdpJedtgq1flo8K-9B4Sb7IFObzhxojsRmaREb83OmnxSsxLlZcIH3WrT7b1f22BQYY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz_LENcbe3RAm9IPjvgm1VxJ0ezRNokm0R6NBmafy4XQ&oe=6ADCAF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0txkRQcrBUQ7kNvwHUZ80M&_nc_oc=Adp1-N3oN1RwIIO-XkwZIe55Rqv2G91ojO_7glt9ZaBuPUZCQYzwcN_KHAaEubRAO-k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsuBELHYMInGiRuHo7c_HQopp5VKpoaYoJqqYVrGHP8Q&oe=6ADCD65E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
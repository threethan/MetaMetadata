hfQRcB5MHZSlcIBTtvhoZ5k-OOQ&oe=69A41D96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrMOrKx6l0wQ7kNvwGicwPD&_nc_oc=AdkJ8DPYrmqCDa2t_twoMwnENLhwF-hB0J99yH-B8p8xDSBg71HdMPiiU3RlSSwCsrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvK3lfyVMvn52WFNLhNzNETx9okQmI2URVQqX4qN_j02Q&oe=69A41F04"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N30P3GCEn08Q7kNvwHOg5u0&_nc_oc=AdmPZNO9ijKqOOLurCaUP56aE8qWIi9gH5sGloOdRivHGq3f9nE-jK54ux-hTLRIC5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv6rHYcX4OiH8auSv1jIcW3VbhRapX9x7YpbLO6AgDQ7w&oe=69A42369"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TEf65OwcEoQ7kNvwEmrfHT&_nc_oc=Adlnx8LYodz-6TaEoOusVHVAguPcusEYlJ1LtNVe-hgn4Wcy33XnaKQQ7vrq6C5vtYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfseZ3u_QpcOpTYjGvJ4tKjXHh6EIZpIH396bGfnlQ2eCQ&oe=69A43BFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-p2fVVcLg8Q7kNvwFBVYfn&_nc_oc=AdnHn2BYQPzGXt0yDZQCAYKZabCJ7HCo1AshDz6MMjn0eQl0D8N3rwJ0-5qL9XSvEc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs4122vn4nYfid3KFiyUrHlN4fAzvhH7I_hnxtgPeGY0A&oe=69A42A9E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29730423676572249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393380_686400474080081_8059097864906062732_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFfeQti-5uEQ7kNvwF
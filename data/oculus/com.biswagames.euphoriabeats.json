g", "id": "1019730033163233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvl15MFCnJ4Q7kNvwEQblvA&_nc_oc=AdoNMa8ICD3w1b97h7gNnw9rpH-HIu3Yp0M8IGLvSzOjx-924mjGXtKpy-J6odm4R5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdRQ5swxkBGqSui3ODSMbu7IHAJHxtjX3oJAnU5XuHbQ&oe=6AF5D5D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCeUv-pFRasQ7kNvwG54Xfd&_nc_oc=Adp1gQGG7lCyPT4ZDE_1z_D86d9dhCjm95FA0SCcmfZ2ETy8UWDxtl4ogG6b_zRcsuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfI8e3IRmRNLDo7g1OyjjH9VU4Q984EpgthAcXLNftxQ&oe=6AF5D744"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK1SHuuhHRwQ7kNvwF0otFI&_nc_oc=AdqnPndke5QVBtF7_yaYR5LETMM0azW3bajEqyVpknb_k6hJ9tV79LITc8erPmwYOW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNvnQT4MoWMbmvtXVlPfCC-g0IqEc3e8f8GkmI38Nyew&oe=6AF5DBA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecAXxcKGxcAQ7kNvwHxp1NG&_nc_oc=AdqqVraTEmAssYt3izos7-Mib2HW2qy_cQjdDiy29Ewlway-RHSUSoAec0cOVc2Z9qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk_8k1yl7tXZDjJDGCQ47cGVWyB_E5c0jvuwMM3pAXlg&oe=6AF5F43A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY0uvFyEtN4Q7kNvwHA5PZ7&_nc_oc=Adp4JliSbsSTUi70pvlopMclZLzXCIeX6OdemZRW2H0cLwclnDyGThRBnHb7Ay4PtQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtuPzvlx8i7dj2B-3d661j1yuBSl08IUV_KcQxNLSZdQ&oe=6AF5E2DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
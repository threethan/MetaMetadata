6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36kPAsDZ6hUQ7kNvwEohFJF&_nc_oc=AdreuidSHyoq1Q_snjgM6nmL7vlm3B0cGPpJcsTZY4bmBWbF3FyPds1dvzm6MYRO0b4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe07_cAthsZU94K7pUOGQRO6zAdZFlvyxpvOSd4NQBIg&oe=6A7B3A56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2gJaxB3z_oQ7kNvwFWwBJu&_nc_oc=Adr7RdG5twikeKUrLHxa2pWWytMZr0x1VMYDdQ_9LxsnwwBbWL60D2O7qutht_Iyzyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHGzvGETuXUq7DIeZoW7elcLV3ICvjl1GrUqveQC3_Mw&oe=6A7B3BC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UmERXVcR5wQ7kNvwH_z1E_&_nc_oc=Adqn8R174VJUgXx5v3sFKLHj4BiiPbsgyP--4z3BWL7KAfsFqTdF0UMjSvyVuPCx71s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx4o_D5ZH3buvfhBfEg6dV4CBoLcx7fOWvNCkUa_HO4A&oe=6A7B07E9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJw3GQDe4mAQ7kNvwGXwf7C&_nc_oc=Adr73-m5QvgPW2Gb00qb4o5OK4rW1XgVlenC1bh5OybbPB2HeynzHpTFR8B34zCDydg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkGoiNpmJ8Nq4GJRiJHwVFzU3cC4M4MVrlg8xGVOHHcA&oe=6A7B207A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlCviI3rnDAQ7kNvwG5vhtr&_nc_oc=AdrpGkQDkm8vTJbJa6nbLZfSXKtX8TDnMH4a4cI6XEYHpeV07reyGtKBsEh1KBwob2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgocP8CKmLAAO72ckX6bpoedUKPi6cpxPG60BDH9lqDQ&oe=6A7B0F1E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
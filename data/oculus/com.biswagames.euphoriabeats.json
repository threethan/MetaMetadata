6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ewz5sftHNcQ7kNvwG6Y7jO&_nc_oc=Adr-gbk8q_TNNXXZPerHNNI8gt-nzdHYhTAmMYc_PgXwQ8HW5-f9TOtn4r5FLUd0tAs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IxfGbxtNVycxrhtQOrR7o9C3Q7LWSKtWiD1zt-GV02Q&oe=6A26DA56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qmj0MknppMoQ7kNvwHwLIua&_nc_oc=AdputrxP6_wE7D5o05MMLJC9nQ20qiHvbhleW_tVCvL8KOQThro8aUcnCqyJEYmb5r8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91GZC6P5uiegyDdCF5KBK63awrnpnsTOHb7qjtvyhs7g&oe=6A26DBC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfSvKgFqhKYQ7kNvwH_h4hT&_nc_oc=Adri614WrY16zZz8rkL80nonjMfIXJGcJiUVyCkF2xQ3COWv9EkhNK_xS8YN9lR-RIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mIJbSlj6zpZwj1OQuw4zHRIBvYEhwdz7-JNzJoatBBg&oe=6A26E029"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdWl1o50CZsQ7kNvwELcS27&_nc_oc=AdqWDdMt0VC4OUFJzCzRuczcIperZ-z5Ex-iEKmQO-xHDcVkSk5a1Qs6kf9f-MvhmMo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96PY2qSE_RWwoz8K1cfvMPOfSHG0SN9c-DQf0fkdYL5A&oe=6A26C07A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3ceTm7TaO0Q7kNvwFqFwNH&_nc_oc=AdpjfnmmVNyRumMQINn7BzB8t1_iwrECDX6ZqoKa6kMRnqBymxBusc30bRLdsIGYby8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M7gmlY4UKa52l7rhcijq6-N0o1SPP4pVMMNXiMEWMwQ&oe=6A26E75E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
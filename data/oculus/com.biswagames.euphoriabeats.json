6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeiseU-3a_EQ7kNvwEwRSZe&_nc_oc=AdrbfGVKC_nKQc87IBPL3KvxH_cmr7grnnI_CHVNquFlaCNgd1coyiL0b8u_PEOZrmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNqVkkee3Ol1KG2cpkm7YBoI1th4XNb0FojO-hGMbYRA&oe=69CF9F16"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex6K5i1X62oQ7kNvwE5rWXd&_nc_oc=AdrtpHV4ySLCWPGi9H_voaQk1fkBGAaV_ruv5OKP4ux8Y77CUwFXxX_UfA46RPuIjds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMFIlHcFwNEH2zCom7Dl68x_E5Pk7i61QjBnUb6eiVPg&oe=69CFA084"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=400M5nRbTF0Q7kNvwHo8yUk&_nc_oc=AdpiVKAlkWMLbp6wqTc355rzAH5CmwQc9ykJMbmzZt7MpLClzODNhmmiGlFG_8Q66yo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0ESzXu4zmbKgYTZHWEvyYo7bWbufewvHJCCmOOQzzEw&oe=69CFA4E9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcJS5vRkM5oQ7kNvwFW7FKQ&_nc_oc=Adplx-EP4MT0trrlpAfvyiyoJpY7zLyuy2g6_D_yMeUabfVbpgHQQTZEDimVvgDOUiE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySrOzLQf96ZyJetT0mXp1dMJAUp3hDCv3H-oOUuAI2nw&oe=69CFBD7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdVz5y72A88Q7kNvwFsKItf&_nc_oc=Adq23Y_ZWwSv4eyVnsSretuxdFfXzMrKXeBcd6StCjt-4A-6v7mLRyhteDsSc3Vb7qI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRFhLccvJ7mLDAN3MGEZB76xmpNlg7qJg2k6CFT3jQYA&oe=69CFAC1E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
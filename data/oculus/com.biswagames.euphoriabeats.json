6_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwykd-zrbSsQ7kNvwGq8jb5&_nc_oc=AdqmWlgEHa7IslI_8jCJtamrA6PYAevAQNoI45VSCUmLgrMdJd66_IvgP2ot3E7H3ng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLBgtsTqG4_-56DqK-YKqsT7D9L0XQY4iK9XJyt8q1UA&oe=6AAEA4D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5WMlyUEoNIQ7kNvwEIbUVw&_nc_oc=AdpGIUZdlFRg83hUiWZObLcF_DcmbkYq1b5XMrNpAT_lYavGVBFP2VW16pA921yPBGE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6yvdpwXHBEuyA09nvYFesV1tTbEttMQX2Q6Hx4ID21w&oe=6AAEA644"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4132CVm6MMQ7kNvwH3pt_1&_nc_oc=Adok3fEFKjcTONgnkTnh9aej7Kpz7OG0hIWCS-9UAx3_A2Y3JfULsRxeZbjRN3m18u4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv1YevinQ3sRxVBcwhfyWL2cZYRs7UQqtSAKAEVPrJRQ&oe=6AAEAAA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqJqKw4l8ZwQ7kNvwEP9Qld&_nc_oc=AdpCEFFM1wGdvEaA0uEJFIv5w2ptmQNy6sFhtYriaXEN7EKTiMBNwUNa-T79glf3SuE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4yaem-m7fWevx9fUSOb2e5eU09Krs18fckl9R3138GQ&oe=6AAE8AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjo43T7C1KoQ7kNvwHRYVfj&_nc_oc=AdpZMN1EWO7iWQQKsGD3jaJ2dGl7ap0a7cmQr5xoPfSVvnAzuoajRo5umwkAsEXnQvQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1lhy21avlDTRb4_dpfX_-rp-2ChbX0cYIk-LoCaub9A&oe=6AAEB1DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_int
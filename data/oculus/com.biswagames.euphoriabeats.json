dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Y_CJQPlADmx6zL1K9nRR7fXnVcjedFPan9J9w4sEvg&oe=6A8AC45A"}, {"file_name": "6.png", "id": "1320544502313929", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75278189_1320544505647262_7322829517315090882_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id-F-eDb9BMQ7kNvwGXPqhQ&_nc_oc=AdqSI8b3kYV7KQVw-awvyeUQADqCxeGiUq7ToxyAsap_wpxcxVPGD6calFmW40_P7WQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj9yvj2UBBoyZ2qAJ7NNQPAWsNAUwN2Oj0dYUBuv2ilA&oe=6A8AF4BB"}, {"file_name": "2.png", "id": "1734844490691892", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974844_1734844494025225_778535308743462438_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80VDSj-sIQIQ7kNvwG1-m8D&_nc_oc=AdrshfEHzU-Ki_odGlB0Dr4cYrjZ9PeWbNtI23yJKkykcggfNDLOxYCyHUe3MBtlISQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT9iBvBN4yZjnk_nv-8gGYU2mvPGBp_iV7HZBczgEp-Q&oe=6A8ACDC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (1).png", "id": "473024245842426", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982620_473024249175759_566385611604994110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCUWViHBEPEQ7kNvwHoHIXq&_nc_oc=AdoQMpNVDsA9tepSnvGBYdNRTBY-JfaUjGYCJODN693eMPwx5O_84niCfC2EGuHfLC4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMLRJmjgVK4a5fag0hkpxhV8k-8Bj25U7X775mvsZylw&oe=6A8AC78B"}, "display_name": "Euphoria Beats", "keywords": ["Immersive", "competitive", "Music", "Dance", "Engaging"], "long_description": "**Dance Deep Dive**\n\n**Euphoria Beats VR** is an immersive rhythm-based VR experience that invites players to express themselves through dance and movement. Designed for players of all skill levels, the game focuses on its **Casual Mode**, offering a vibrant, low-pressure environment to unwind, groove, and have fun.\n\nIn **Euphoria Beats VR**, players can explore two dynamic and visually stunning environments: \n\n- **Pub Dance Floor**: Step into a neon-lit bar, alive with energy and rhythm. Dance across a glowing, reflective floor while interactive props like vibrant lights respond to your every move. The warm golden and cyan hues create a welcoming social atmosphere where players can relax and dance to the beat.  \n   \n- **Abstract Space**: Enter a surreal, dreamlike world filled with floating geometric shapes, glowing orbs, and fluid visuals that pulse with the rhythm. The vivid magenta and cyan tones provide a creative escape, letting players lose themselves in a limitless, artistic dance experience.\n\nFrom hitting glowing rhythm points to creating trails of light with every movement, the first-person gameplay ensures total immersion. Whether you're seeking a relaxed dance session or a creative outlet, *Euphoria Beats VR* delivers a visually rich and rhythm-synced experience that celebrates the joy of music, movement, and freedom of expression.", "short_description": "Euphoria Beats VR is an immersive rhythm-based VR game that lets you dance your way through vibrant environments. Featuring Casual Mode, players can groove freely in two unique settings: the neon-lit Pub Dance Floor, exuding lively social vibes, and the surreal Abstract Space, a dreamlike world of glowing shapes and dynamic colors. With first-person gameplay and beat-synced visuals, Euphoria Beats VR offers a relaxing, expressive experience for players of all skill levels."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscript
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6uhl4OcvqoQ7kNvwFHDE2p&_nc_oc=AdoXBYC1Vx9eF395s85fp-zbuejUAV1eIQOCCiasijhipclWOjEOEeuU3wh2wsGKmtw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGKyxr2MHN5YVM-cg1QbdEC220sDh75_vm51O54mVBtQ&oe=6A86DF96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGg0Kdv5-BkQ7kNvwHWdcoy&_nc_oc=Ado8nHVZX2zLeRVhAGkRZtzEkmUfBNrNjVrP9uMy2WGN1j6luJnYhb9iVqYQwTA9JwA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9OhXKjt8fi8DiVbaOG4u57oPNMy5I1iXj8xD9Bl4Dvw&oe=6A86E104"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzidQ9K4o5MQ7kNvwF4QgxP&_nc_oc=AdpZL4quF5GD6Bq4OPUW4rISXKcv8lJeCluIl1BzclZUFbYJgsrkHAp3JU5z39HbCa0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJAUamiwQWSHtctd8bG6Nb8RJgXTZ11hl0l3R80oJe5g&oe=6A86E569"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSw8Ea9SgOIQ7kNvwHAZJ8V&_nc_oc=AdpTnGhsyOi2KoWvpR1z5SLcofGBeXyLd2dhPB-DNAwb4SyadgqRmwEn9pLjfwYk194&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHnOYHNca5BrL1x1ST5wrT3EzzX6m1ATudgh0BRbUcxw&oe=6A86FDFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_OPOzyX-p8Q7kNvwHtM8ln&_nc_oc=AdrBwRhvZ_nWVsc7MDqEhEA_8WQ1NfEqU901wJvIETgXpaLPb-dmvJ8Eljqvl3lKnU4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZZS_iTQhE_DdZe7vv7nQeyG_9kGb72MNkRVqI6TJUDA&oe=6A86EC9E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
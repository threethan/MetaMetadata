6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEHvnXQYrcUQ7kNvwGhTWUC&_nc_oc=AdqeHtKuNu6YEvpd9e9KFczaYeg-QwwxfiyccuZxXsQorCYUH50s4-zNU0J5m8jbkqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv-zA7OmiPcIV1cXiP-hsaad6-K1U-xfInXE6gFP-ROg&oe=6AB930D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SF4E0bcDcUQ7kNvwEv0eD9&_nc_oc=AdrSDOEF200F9sVH-zkjMJ_H9TrbHmK0I66iRHoXQlHo54DDdoJgF5hgZnbL_XWPoJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX_zpDVEIQQZvHhOJkBsV82f4ksu5lUnwm0A5E1owDyA&oe=6AB93244"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf_G-gw-n1cQ7kNvwHI8bAQ&_nc_oc=Adok9HUQA12xJDU1boMnNEWCVOikKTA6KmIer0qys2EBLjRbzXXUjLMPT_VIkV1xkbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4YqMtTEgnzjxyLKK55d1Jd1HCeg9oZAaIT4hDTKkkwg&oe=6AB936A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ0twotYCXYQ7kNvwEsGQhq&_nc_oc=AdrJukJqBTMa2CvyLM8Q1_TEAilj4XIltGkyRn1mX4KcH3UfmbxFW5wpPqtZOj_iYe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLN6s43mjVaicok2wp-RRwPsrbNpzpzNj08r0wXUzEog&oe=6AB916FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5nedYSPXjAQ7kNvwET1g1S&_nc_oc=AdrS99J0-JWIl9xDkKPNW7SVqppR7WrnxJcqDIu1TabVvLGXaH0wyyS6Br2UMcVpXcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0wQ4EvmEKBHufiuh9l7L7CwRSv67mI5_Pfwf5507-eQ&oe=6AB93DDE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
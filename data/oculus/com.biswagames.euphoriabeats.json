6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6TPJc4r4nIQ7kNvwF5IbUU&_nc_oc=AdrwJQFuFh59wWO8e-dNkF5L6UqNACkOEVSFnAJJO5_k-nSFw_D-KV6DbLaSaygbX_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKvIsH1qHVQfbPrrH7DOIlfhg77vdoxUJifoQinZQoEw&oe=6ACE48D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s1lmY7D858Q7kNvwFp4I40&_nc_oc=Adr8ncXuqcYVewQzE-0g0kM23loisacVbqQYgRm-_cxmtvge3k9CozuCLLMyuqkbBXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYSY_wl5d93VCt7tgPRbmStNqRzabrkOHqsmM1AAeU8Q&oe=6ACE4A44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELbd1vxjt68Q7kNvwG45-P8&_nc_oc=AdqHeG4eMH0OlTvXscyEoFj3cbBleaFkL_oygZr9tv9j9y5xquoCYgiQdpAGYfSj1gE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU06gV7Xtwia_StH14mXegXk8UR3e8znrW9SjzbZ0xVA&oe=6ACE4EA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6NFFDZcZ_kQ7kNvwFpsdwI&_nc_oc=AdrjzR0xYVrcvGkE-q5ciT2udYn2oPIhi5dzY81DU_d0jBDHC4z5-QfAjietkVVu1M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUzBKN-eA8C9jR9WyBZLTnwW1hMebAEYBIVNxJ_PwhJg&oe=6ACE673A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLlmeHXGaPUQ7kNvwFhWsl2&_nc_oc=AdqD-3bKY6GNn0kaFZK7Bqop3e_56KvNG7BNtXoV30u28QtMK7112ocGgdkK8ObhhS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw9qgOjr30CMlEcqJnj4Y3ZkCHwaZlw-Dkaz0u1hJRgg&oe=6ACE55DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
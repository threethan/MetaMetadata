6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDw5yU81BaYQ7kNvwGLXW9U&_nc_oc=AdoFBIpmm24G7aMvuJCyFvIBEjIzv16I0A_VOYYbxxK-7yhYlMkJK7rq7ZJMohKSgfg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N-jEjEod9E3tNB2xfgztFWQGmehU2MillGhDe6ZdRKw&oe=6A1C4E56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUlpyrbVYsQQ7kNvwHUjvXV&_nc_oc=AdqqFmfM9y7qWflD_VQs_zVxMF4FFDWK1xPvtViLuSObkcE5YhJxUzKumDhJZjb8shY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BWT1yr3-Mt0txdQ40BTIut4sd1fFKL_fB9sX9b0R-IQ&oe=6A1C4FC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShCT7P1JF7MQ7kNvwFTPQ9a&_nc_oc=Adq5MDhxgJZhFOPVWa3L_PIU9zP2VTuY4lFvqIwzNQYAWgoRTb_9mLxJop54hsPakxs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JyJCpZDCD-36-oKK3bQtUEwRC-NXTuedX9usj4g6ktg&oe=6A1C5429"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6MljryEsAUQ7kNvwGrC29k&_nc_oc=AdoUSTDGRdViXIhzupdXcvs2gKFp2EzuNJ_uWLSDZqvxrZk0WFCIvmWMuTDQg-VTDvo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jjMqBmiELiLDgs2xy8jiLLevnWgUtGliz_R0FUN6TlA&oe=6A1C347A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa9y8uXKi0wQ7kNvwFkXFzm&_nc_oc=AdoAA5DWVDenEHcl78I1dzyRF5DNReJmRIWqhVC4ZjMDn-3gkSc9qKQ5lFWulimEPJY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UwEBGSho3V-tpdXddBqQZyAIU8jUJZecnGPlq-PaFhA&oe=6A1C5B5E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
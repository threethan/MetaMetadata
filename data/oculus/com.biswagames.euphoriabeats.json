6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcv-uV4OwKYQ7kNvwHRqZX1&_nc_oc=Adr_ZYYd0JEc8JRkRDVUo0c0AFRkuQlceNsJg8slG5W81SN5Hf8wmu6Pki1VR1SPRdU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GRLrKvZyug90YCtPES2Bpb6qwEqU2WFZTbgEmQraL3w&oe=6A1313D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qylPYPL56TIQ7kNvwEQqWg-&_nc_oc=AdqTW3HAGcB71IW0Bu0RlVKihwMdaZuJl74NNw1MRdsq9gFCkCbif6MTUo7cpPM6vwY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HrOX74_HvtoWCzosSA-3fhDVwJgLIvoYggwD2UOuUkg&oe=6A131544"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMGgJHPkAa0Q7kNvwFeP_qm&_nc_oc=AdojOtQHmZP6HCytTPZ6h5eayIUphhLDsyQqKUTuamO2lQAyaVG6jzj7RL9RTWcUV8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SLCgodUG9q97B4GH5fffDlLpNCx7n1dhD5Nx6g3iZjw&oe=6A1319A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsBkbm6tdbsQ7kNvwEIiMVK&_nc_oc=AdpRcfFgRX0XvfNdaDNgm88soDzm7ozboVWH-gadb4u60O18nG8NuO55DE_vJCXT89c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dfPCB1kMwcTNnSwNpA917aLZM__PzrVnuJ1-5ZVVqng&oe=6A12F9FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeJJNo5jViMQ7kNvwEHxvyO&_nc_oc=AdrStLor5a86Dp4GucCqK6QZODw7TACZjBtiFsx_K4WWCpxjG7iQv1a0zkwgs-gVQUI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HCI_fKwruqUyM8K0jax0AelYG5bJoZdUMrVrYVIaJyQ&oe=6A1320DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
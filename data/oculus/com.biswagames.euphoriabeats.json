6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STx40OnNrO0Q7kNvwERhP-9&_nc_oc=Adqs26uIC4tyL-9q1qn1QRCqYL4ctA7wXjsbVAer5deg_gHt-pnS-CCNw1XJaxcaL0g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTe13uDVCu01EZdlIqF0ha5fOQTwvYhNqoVSyTGfxZ8g&oe=6A54FED6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuSMCdGVYR8Q7kNvwEuGSTS&_nc_oc=AdpAp3H_REzJMbLZfJC3zPXQV7ypxAWVUV3rJydLlf9Tvv86U6klsWdFHIqFBln9Ook&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn1802WmxQk_F1orqY5B6thYxRS0DM-yQLC4PaNmghwg&oe=6A550044"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-qphhtlhhsQ7kNvwFeEuCn&_nc_oc=AdrJwL3_cmuUsvjGGX3RmNxP34Ugw6GnnWwbPEZM4HLePRaooAcPFhTlsYWMPFekkoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbgRFhGL7g-cy7laXpQpNd0p6eqsLig8qPGOiRgqnNAA&oe=6A5504A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ibvzXOQKeYQ7kNvwHrpjCN&_nc_oc=AdqGySjQufskgOjiW4Lyz7mJf32qUU_1M5C38XhIvy4uS7meBJF_T5MY7ak4_5X8HCs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOI0-0FoCC-5IXSYaESOgTRP_Q_Fae0_41bELKH0m6Qg&oe=6A54E4FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJZe1xvSDQ8Q7kNvwFC6JTd&_nc_oc=AdoUCZRx7levySlaiEekdO1muU5JEPBmQ1QGxNnu9X8oylkFMJ0ztPByUZjaqS5D0gs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD11ggbpSptpNAxvDgdrkCE4TP2ebwMUfgi5DipLDybdQ&oe=6A54D39E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
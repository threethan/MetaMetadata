6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq9XwdlZJb4Q7kNvwHjp3rQ&_nc_oc=Adqzy0r_NHOn_FlSQzbpAbGexrt9Bo7H2FeQJI_uUZ56Vy9Z_OkptvgCmQn3_AQKijM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr4AQ2FVxEeJYnazWLYQvwPktXIM0hjOD91mDxNdKldw&oe=6AC119D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK1SFJWMZqAQ7kNvwE2AD2v&_nc_oc=AdoE7pHAzdHCRf3AVKxIzahidxahzAMhlIQq1IniyDeTp4Zj4RHUzeHsHGtTPgJBYGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr228FxpVPMrP6RzWY3BhbnVl0bp3Cm4XpEWxLDRhA0Q&oe=6AC11B44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlxDq2LIxH0Q7kNvwGmQzAf&_nc_oc=AdpxWm6kL0rXXbeRHnsOnoSF4LYMgp72_4kSE8qKs6edDt0yB9RbpFiMP3Nxh2AsOPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGO6JIgw3LhhJOzIp74qA7tDq8WZm3nnKbeigTn_MRdg&oe=6AC11FA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG27u6bvEwkQ7kNvwE6_Nuu&_nc_oc=AdrRk7-ETxx6TtZG57Coc4ChtlMZVtk71aZuZknrThMyV1U6IWpXnyqapvZaDRkPkxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzWyXa_Tt-0KIC9w1iiYt47x4oB3kFA9t6n39gtBVHsw&oe=6AC1383A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSyFHUxqfegQ7kNvwE4aejj&_nc_oc=Adp9XbGk5i5pg2ULXa3GZTlapK3jGkXcRNLhXexcHEVCgjLM3YkP8H7UWAx39pyWeRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI2e8zUf25UYcAGNdEPLsj5NXQ6dFocFJWGt3DspJaqg&oe=6AC126DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
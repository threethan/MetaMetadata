g", "id": "1019730033163233", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1Mr0xygBLgQ7kNvwFqL4QI&_nc_oc=AdqSBGreCCKhHSfYV_GjUR-7QaqLkqZT7_Mu4gUZVw3PRbRuJc2S8iVZBTVj5DF0vzM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgvKn03co1SQmnY0KHjTVyAjMEvc9HpIvoLovhgrHg7Q&oe=6AEC9B56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA52cnBPt9IQ7kNvwF959mc&_nc_oc=AdrKYSjZC_xnW05GYjW1-EPRlZco3cff4JYtiswVl1x7exIlxvvoHskUDTu1bRv2hRg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaTW_7im2-uaDnMGi9olIfcIXsNWJoqG8tOVQ0JaeY2w&oe=6AEC9CC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DStudnG3MaEQ7kNvwHmj_tg&_nc_oc=AdqFvC6VgfeVjW_71ZOaScHjR9htKZJIG1Tz453xUC_mKLqwIt1zJnjx8VZNn1jo4qg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT25Huet9akQ55E66kmi8HKDRyv7bCGFkujvos9BORXJw&oe=6AECA129"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC_G_abPd7QQ7kNvwH9ECjJ&_nc_oc=AdpPKrUVOJm2rVlCEm75cCESy91aJth8ZCkS_JdgGFGACQUcHDxawBBPLRFvuan5H5U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgtMjfFO5BruTqtPzf-FEQVS75IffVcJ7N8Z7kX9YXLA&oe=6AECB9BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TQEClda_E0Q7kNvwEcFlvB&_nc_oc=AdpTuERBuvkQsOlbzHHsVmap5sCdAhw8NyzRs6YCEZV-s9XEllBVMue9wdgGyDse_CQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLNQT9bJrHwyesrC239sJd7zDg00IZg_RTzQF_7-m8TQ&oe=6AECA85E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
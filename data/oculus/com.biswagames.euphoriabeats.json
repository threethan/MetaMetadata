6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAesyF4zcs8Q7kNvwG9GhMp&_nc_oc=AdoVgvRjS7NQVcaJEXHKbq-UK_GbiDEqXZNbPUnPh4oyqcUXBXjYf-M2npXMuvnwVRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJpK9FKCk5lsdhrrxc25ViChOEXGLXC0raOn6l_5QVqA&oe=6AB53C56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WngXyMlkwoQ7kNvwF7hBeC&_nc_oc=AdqbA0tIaZIlnym6oY66lE8HIZ08bOqntfHoCwCs24dSzadoHXbXRUJE-afhTEV8t4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhujci_NZQ2VBaPa6aOK4zhVmYKMYBWRlrnuy4NWXmEg&oe=6AB53DC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jm_roFkKlr8Q7kNvwHiEozY&_nc_oc=AdoPdxw8zDeMdb7oUrdmeb42XNblemVjABaS-9pPJwQg3z3t6iPPPEjhCoiLF2jBO5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_P-y1K6Ox9a0q7r3y4E4MDhCjzVg0MygvJY08OAnmmw&oe=6AB54229"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBBylX59e38Q7kNvwHjg1vH&_nc_oc=AdqvqSJCSOsLYrq8UCPxfgUjLwkkex4zPDXdtU--NaIFEr3UuNMxWtKNu2my9MlN798&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBSrbchw_LVdEIIpZzq5q_b5Dol3fr6w3Zkm03ovqL1Q&oe=6AB5227A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RunlA2fhtzEQ7kNvwElIRg_&_nc_oc=Adpv0UKhv2CJ5MB3ONRA5JMZ9ojlWa8DilEpha_RJWo0EuxNNpLH6fLhO5mvRQBD_TM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTGFR1CoLVrCy-nNfdGDL_XtSJkwUy6kRbpSYsHIBbqw&oe=6AB5495E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
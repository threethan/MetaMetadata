6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcbtd0pE5r4Q7kNvwEpuVry&_nc_oc=Adp7vN9BwKkh2nMdzH39x4SfrLF6cBo69GPYLYIpTRNNJ_X05CEvoieONQsDk-vkXYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9UlwkWdTPEYP4E9a0qaECO3WfZxtm04K_OWPJFkO6xQ&oe=6A4A72D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTtdBOzGAUgQ7kNvwE-sGBh&_nc_oc=AdrcAiG-gp_ctNM7b4VPdEXY9RPnfaeYKkNRIi4_EEIHHG6yc-BrjxYCJXUg_aQrTW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCINpK25g10a76Kbzwlve6jhJLfAuvd7cnCXvNluVDhdg&oe=6A4A7444"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX0_o3Behu4Q7kNvwGmLWz0&_nc_oc=Adoy5qIY1PtOOawq9GiWkWOiZclt44qw_HI9S7ruAIT0QgaZkmPjmnkYx9A-6ag20Hc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnXH4qy_dY9oeNrq6ijZgrZsEWpas6tt_ebPsJzh5Xcw&oe=6A4A78A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7WwnsxCtY4Q7kNvwEIQkuR&_nc_oc=AdrLp7gUq8CETkrT1kYwkmgqhF24BKM14nvI-iGaBM--LoYw9Ry3pYK90G00QutHVOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKx2LnGVoXVzppl4R4f0qIJoqS3Oc2sny6kaCD8csc3A&oe=6A4A58FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL6g53uRoM0Q7kNvwG4kvxy&_nc_oc=AdrA289olUmvwxl91IBmt4IS3yrKcYltOe4AznXJII6rgqky_mon_LXmw9vBYizJU6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdyxoyimuuzfmzm3XUKmR4NZW9sUdTJr7Hq_pfTRmytw&oe=6A4A7FDE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
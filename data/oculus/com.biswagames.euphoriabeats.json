6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n9sR_NVK8AQ7kNvwFCbKju&_nc_oc=Adq5Pwnij4Jej0xAo_gZRYG6TFp8BXlmO-_S59K-bFuYX9cLCG7c0zEZxr5eeQaOxWU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpeZ1_3qRhSQGixlX2L1_9D_A1zsxVNx_Nx4QhrMsNCQ&oe=6A9ADE56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgfbSocEDgQ7kNvwEahWDO&_nc_oc=AdryTu6aKUga6OAuEDQ3TE7_KOEhQ1noSsaKGjkkpwqSI5SrRIKYiI5AfTqpbeqNtMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUI3KGUdHEPFZaROyYot1_wYsA5n_92WE9VFka5Cq01Q&oe=6A9ADFC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEzyTQI8jWMQ7kNvwHj_7lW&_nc_oc=AdpXOH33KRtVKFdEkIU46F04D8CCGfBJs7M0SQNPUk3XzatBcVxS5b21sDS9LHsbr8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQDgnQh6y1PPgFzIXgcclOjYxR5yT3nHlLiJ_RvDM32A&oe=6A9AE429"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbAn4wxsafwQ7kNvwFEVZsm&_nc_oc=Adr9bbss7e5flzxOQ8JK9lLf-oae18NpPznjd_qCFujwjNUWSrERMlsq50SRhI6if_Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxj-q5LYGVZHOw2ZzGlrDVWuIXHTF63JjLKEK5nr7GYQ&oe=6A9AC47A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvvVYWsedjEQ7kNvwFAw6Yu&_nc_oc=AdpmidwlbifMC2pXw5_OME6l9shj6Hcrbd28qvHd61OfNRbhTuoe1LMIHlB7Rqullsc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILbMafPNWZ_HsIXAMcQlTQMysDTa4sxGRdPB2VlNKzWw&oe=6A9AEB5E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENHxi1RwHDsQ7kNvwHBGD4H&_nc_oc=Adp4wk7ssRffsJbMwKqnWcyHnXBkiimhfjUZPU7gLSh4B-hoCVlSUjbVzF9NNCK1glI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlZbPbeteZr9XWiUgcMFNC6dtjx2ZLBGTX9w9xxHa4uQ&oe=6ADF6C56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6g8nMrqIZIQ7kNvwFob4a0&_nc_oc=AdqxJkfyrR_3Tm8s4oOUwSuMVERc1GVFM-Fg3xbQThwnmF5JS71DF29ht5l0F6U4ufo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8K7K5wmtVliu-hbKe3PhcIok9TsW21EaWgTGXCMcKBA&oe=6ADF6DC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18g5Zn8bpV4Q7kNvwHKIcon&_nc_oc=Adr0mXA9SJkXg3vISXS6ymky9ac3QLLYpJO2mrlNYL2kWk3BYqhmeqmT_UefYjr7p1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgrVEGq5oCtaL8RaIkAmMfFMzfeueHiXIfcKtXv5LDNw&oe=6ADF7229"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvVNt_a_hkEQ7kNvwH-vqt3&_nc_oc=AdqGGz76UX7bm3IQrNIOd0DUqvXYPd_QXrIWWrvTGjzlgHZThFeqvXuoFaDoub1qUHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9ZBsDpNAd_XxzUrBL6gvXF9CbtXqyuVBO8gtkeM97xw&oe=6ADF527A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0txkRQcrBUQ7kNvwGi6SET&_nc_oc=AdrXaOBzcH8jYbpBzjI97s_25ADLGuhNRChhxdsGhkDR9hx23feArqJ_0jhzZ0ZM-dU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnxN3KxF7FQQNV-fzDJm56XYxCyAgBoMo_gppgV7dLvg&oe=6ADF795E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
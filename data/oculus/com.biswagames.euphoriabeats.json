6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3knynYlEpgQ7kNvwH9D115&_nc_oc=AdqvDN5RDdWkv9JMSWsHP04eknViySdbBCFPdOIx1tzMaHRCB-ZXfKJnZS9nIxKlAgI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eJHP708krbhlPMB7GoNaCXYzdKLNqEg6WT_KbM1tytw&oe=69D78816"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkdmACEcNocQ7kNvwEwG0Zn&_nc_oc=AdrHrUpcDFkXyDkVaCkQzeQ6cKo3RBIOgugEOzQEna4XoM3vTFnGvM02y-2uIJgnSQM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JmI8_MKaucM3d0s34-kQ2MsISb2za0-iCK8MeszTfeA&oe=69D78984"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahEp_ZUYMRgQ7kNvwEsYS11&_nc_oc=AdrwH-ErSjFeN5SG0-JlGQRkNeey9S3gDLnppPlVntZeypcRPT2slelD_UeZ5tprzFA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26dC3kSms2i8Ll2E11a3jd7kNkmyJVSfDCVjBthzeNZQ&oe=69D78DE9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnaWI27g_T8Q7kNvwHeK3iC&_nc_oc=AdoZGm2ZkAeIhgoUwBxexGp-B71Z8DiizxBZvtcUd8qH5CyKkge3q7T1sFJiuYX0LBE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34ZAtmbXBt0GykBLtpO490Ft9Jw5A_DJt5C-kIVBuo1w&oe=69D7A67A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqKzjqsxf2sQ7kNvwEjTrUJ&_nc_oc=Adq-CHTfbRXNBmA-2C8UTfmtmbuoUbva5SXA-4TqavXnfoe9i55Ep09kwk4IwBlf5mk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1md_Q_EQ88-Cy2_RjqbhCOwGU1YsjYFGceXlu5ePYSow&oe=69D7951E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
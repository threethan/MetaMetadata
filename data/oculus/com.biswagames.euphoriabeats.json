g", "id": "1019730033163233", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fwt6m-_v-0Q7kNvwGQOS7C&_nc_oc=AdoTwwQ1wkFik2Myw5Tx6WDX1IQ1XX1evn6IJHDHsDFXGm6kmz1jzwc0_CoUidxFazA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8YrIH8Lu02noedHuoLKvIUcCK0gVYpcFcglfAiSTQXA&oe=6AF9CA56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAQ6LToDTtUQ7kNvwEYttHx&_nc_oc=AdpwKHhpe2ij--tqpGwGmgVpMMfjb9Q2hsG_bXZUiFbpZBxqazJpCCm8Ylhwh4E2u34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPicDbp7iODQM2ej-_n0rb505LTCoWjIwPJosE2IgYYA&oe=6AF9CBC4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coy_CHAKIEIQ7kNvwERcwkz&_nc_oc=AdoP2RaLt1n6nxu2gsDFjZQYHEXEFz-aQljhgJN0sRKmeZhaQzPTSV4z-roUlW1f5KY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmUNbxjhJJMOFS4k48wviDtrHsxD6ClDcA4uMCTVJv6w&oe=6AF9D029"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkycZ86z4pUQ7kNvwEHcp_c&_nc_oc=AdpFeCS18wH8N5iWc9rS_zxhCUPF5hchxXkauA0NzJkxT6LjaXgpKnD77RQTiPsymO8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0AXToqJXXEaQowE_4_ytc5NMRby0wyOyWWbObLcP4oQ&oe=6AF9E8BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WjR_7HqvrAQ7kNvwGgZPF3&_nc_oc=AdoxH6G5Yr7Z6EXcCDb1YZgNA4amLmpWylXDfF3zipnYpr0s24QgqfnNJPfO8MrGzwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9uMA8s5V_CG3oiMVvqCVXBR-13vDSUpcNZAuk-84SEQ&oe=6AF9D75E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
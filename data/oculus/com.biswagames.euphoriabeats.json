6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEHvnXQYrcUQ7kNvwFQ1Zmo&_nc_oc=AdoRQGvEP2GYBcTXc-PwfiQwTlazbC36WJ5Yxnm60iGCCYY_6OZraykRv1v7KDaHJ5M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpDFEPZ1PSEJvXjkT1AegFB2haLOuRDhyYQLYHjW7o7Q&oe=6AB68DD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SF4E0bcDcUQ7kNvwHENhUG&_nc_oc=Adr93KJEvIJTuG5tAFjqAljQU7x2SzQsat0Ck6cUqYslckZAb0BF7ce_ZgSJFR8Cqd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqr6IxZCy-3d6xrwR2GHLTaJEX3bWwgyEaxdiulQftLA&oe=6AB68F44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf_G-gw-n1cQ7kNvwEAZdgf&_nc_oc=AdofuZ5fCgxCGABiPYlRb1uyvf2SpLYQoGsv7KSSasgSnfgcghq38i-Ibz3odLd2mNE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaRVGI4TbL2ub7VC5a4ua4SqR6VzX5bIoEY18OQ32-VA&oe=6AB693A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBBylX59e38Q7kNvwF91ZLr&_nc_oc=AdrYAQKhpnhJU_zzq0j41sdVb_ZIqGAH05T7wz4BZ4Un4IcEzAGrkLIvmWwY5EI5P5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9wpJ5X6qi5XMretyvIk8RR-2t2tXXVS5L_xthRuBPgw&oe=6AB673FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RunlA2fhtzEQ7kNvwHTFPsl&_nc_oc=AdrT1ObflcsMMikKtmCL-Aob0ySN6nyOehwKZRat31FcpP1BFTKGonGauV9vtcGI6sI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeuil66O4i4agLQbdSmji07OlWphQRtEVD8_Wk5kftGQ&oe=6AB69ADE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
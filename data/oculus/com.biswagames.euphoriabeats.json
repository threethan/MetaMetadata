6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk-gdr815I4Q7kNvwFCI3f8&_nc_oc=AdpcrcIqSr-GGr1eZ_TRgkF_n_ce2N-2u0tOGsM3wRiR0dCPvLnJweKYVFusYYrx4mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9NCfoJzYgMQ5mgxdIXXPk3eb5Su1z2iE4TatpvGjVbw&oe=6A998CD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fmb0mk7J3UwQ7kNvwEEHoL2&_nc_oc=AdogikND_cA1bGb9TZSXof7Bd20OwGErRkSGwiNUfJwgIhYEU-FyWVcI9tz9ZsZ4D4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwL8edPUXxlUtXB1Xom3pIeMpJGgkEwMnjm7P_oFUpiQ&oe=6A998E44"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Kec6xJGZ8Q7kNvwGWpmZS&_nc_oc=AdoLFTwswvTI69MpUosavSKA6sJuLvyTPjqZW4Xi0Qa6RaWy_VtbLM2iU4rzr1-fOFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6gA76p-n66vqJj7ses-9j9hrXxbTM4WpyHe68KnUwMw&oe=6A9992A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbAn4wxsafwQ7kNvwGgDNJo&_nc_oc=AdpkcJmTlAtPI3RezTbpeOBa9BlK5x5kY_7FdEQDDholBjP27jGT2fBMZBZpRyUTQAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbf0rX4rhr1MC3gaeNT21K9PrPs2UjdT9lxpNUguQxsA&oe=6A9972FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvvVYWsedjEQ7kNvwEBKkQE&_nc_oc=AdpU898Rk6mHLj3D-v_O84oTs1YNzqodawuPEJuOfpjVCbip6xjOGUjCM_Mow2mnLYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnyMgLy6We7YEiLECOto4zZ9_I_YsO46mqWmchPYUr4g&oe=6A9999DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
g", "id": "1019730033163233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393827_1019730036496566_364942806511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo9OpzWoLXwQ7kNvwHtvX9U&_nc_oc=Adp33VXHRiCmJUAREK27ANGMQ5mdyEonrG1c6H_EbGcxs5RLTvNC0YRKBj3ix86VkTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTL267f6yDYy8bB1ePu8PqJWaK6C8Mq5muFoXviDtiBg&oe=6AF1E156"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7TCDNqKYmgQ7kNvwGhob5l&_nc_oc=AdoZrXb7W17zf---PwSTtJRWDwyiZ9Y0742Ht6U36n6TpxYOCAjnuyNyGJcZIUldOvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvyC4681ePe-5c7wsUCUdGiNljFtC7N3CR0fYlmUAxMg&oe=6AF1E2C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyX4VSCMfDoQ7kNvwGIEhtm&_nc_oc=Adq5b0d616pEkxMI5DcysBmegTWKPykfoyyUZDH9pHxpDSL-7905jAgtTLiiNOpIdEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjHQMkvVJXgBF_TA_Ig2XBrxxL6AZHV2pgF1fozOpKmQ&oe=6AF1E729"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dShdkTCfsUQQ7kNvwGJqgQ_&_nc_oc=AdqIah6pg6nxqFz5O5Z3cSNih6lPGbY43AAhuG3ebRG_fT7IxciXOQMXmJeCKx4Vs7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2IrtuF8DvVOyEcEkRmXizDZupqgGrCZT4G_rfxwCVRw&oe=6AF1FFBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUAjHqQ6P-MQ7kNvwFF9xt6&_nc_oc=Adp3374KjbIVeaPU8vIBXDh4tZ3JsBxR7uP_q6qPMaXhyTsazTB36ti2pa0YUzFRY0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREKzBI2o5bmjTLlC_oaG1WrNKFgxHu9girBjReHtC6sw&oe=6AF1EE5E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RchowhsHna0Q7kNvwGmJ1G6&_nc_oc=AdpCO1idtTbbvME5DcCGu2wfIZal4AECcOg68dRnSGGglk0xFHqNRaLRHRwInXM-gHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyScxAkA9yzhqPh2pf1k_bAGlpuW4h_l8f1tnhK3vl9Q&oe=6ACA5456"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a3sS037XwMQ7kNvwEQ9sO0&_nc_oc=Ado4q5fHKlJ8uJKifFDS0ered14p60WFe8IGhxEsSgcq02nDDdAitsSs6Gg5V7KRBno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyuxB32ji2m7QqdEI3aJ60hS0TgliHEcSiCoYXC24JWQ&oe=6ACA55C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZNKaLiEQL0Q7kNvwGOuP0_&_nc_oc=Adqt2J6WCFBtpIzxsei69YetqjiHvoZC-2AzaRJE36bn9VoqpBGqXogKq1a1nQM13ls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRK1VOUSxEIr6nI-ujLs085yddIPlOytx7gijmEQyyaQ&oe=6ACA5A29"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdHkTpnVticQ7kNvwEOkOzF&_nc_oc=AdrDRPMvnTHWt1jJEcc4uNgnQfzYnftRAWcOHPQ0vNKOGZPLmYGS2crp6HaIoxhTmQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjGazAcdDZPQEPUiEB4VS_VaXbURjpsaKed_KxkY0suQ&oe=6ACA72BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IZUnMz3_gEQ7kNvwGeYfY9&_nc_oc=AdqoD4_lY3SWO5VuLd78ugu54Hr7OmKPBoTOKzRjfehtb8TixImTWVKnmE3fqKHItsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1846ohNo3VIfFpakAM0hEtHrGK69cfiPkl5IzYN65hQ&oe=6ACA615E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
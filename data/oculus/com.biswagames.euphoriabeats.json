6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDw5yU81BaYQ7kNvwEHsj1N&_nc_oc=Adqyx9G3DXsamAvWI130cAWjjJy2AG1OmiX6C2yEViM9oiDiCvqaZnqcyU7g9K-wRiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40-IerDOWJSvHrtKeFgPpnUXvzcdQ2hYbyYBuK3YuhfA&oe=6A1D9FD6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUlpyrbVYsQQ7kNvwF3p6A4&_nc_oc=AdqRIfhvm5zEekjQ9m_Kt5Xt51gi_3tmVKJ8k3Kf232-RjKBwunm-cZxvW_1b0jRhQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63svu_b4415sBUFHaPcLswlkHZAKstV4QfXD-ScrA5ew&oe=6A1DA144"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShCT7P1JF7MQ7kNvwFRuZEI&_nc_oc=AdpXkGcVkUGLXC1xvXuOoPtRWMnrhoOW__SagDI8AV0DFOjGQn-o-_qPoVp8SByuCNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76IKUDtgRfZCZOpPv0RLPES-rBdR27sNDfFApHhaJpPQ&oe=6A1DA5A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEWoJmePOfsQ7kNvwH1NqdN&_nc_oc=AdoufTBRTiN_RND22gS9vQrTUUmNQDFuJZulBoNw0r2uyRnewGD8F1pFcCX4YjFa-QY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oxTOfhhvXcOHE31R1-55urDiPqBhBHe1vEy9-SsBKPg&oe=6A1D85FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa9y8uXKi0wQ7kNvwHUMW5e&_nc_oc=AdoErqSq_vVIM6VlwDGOr2-WptPL1woJU2tM3O38ruNnZwuIfamNYg_HfVGf-fl4Uho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RnqgRMsq6QVs4InRN-Gx2g1FeSrrXrMWG8v3fGUqFjQ&oe=6A1DACDE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
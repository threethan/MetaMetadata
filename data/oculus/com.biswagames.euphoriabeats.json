6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezwxWQww3-sQ7kNvwErAtgW&_nc_oc=AdqX3JoZ9VH7ZcPkHMJJRUQza3_Cw6-Exec13_EGzu4KjjLqBZvFZtLvSalfAQJBSFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI0nLHpeUy_636YOqgVw48WaSJAREEARW9OK06G6iifg&oe=6A637F56"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlA-XEqLCuMQ7kNvwFhLFcm&_nc_oc=AdoPpq9l-lH3Qv17WMlxUXojZjLr3LUt2jEjOKchMC3ncLYWhPy5Q8ffaoPHqT9hVwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDanKzQZOonK6n6zuBD38bp_88IR_mDdw-M35WWyNyeXA&oe=6A6380C4"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkbFKeYnXwIQ7kNvwGafRiJ&_nc_oc=AdorNDwwnIK1QqarC7haldDl7X3YmzL8JnTFNojkWorLkCJq6z0oJrgNSqXFv7ADb-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfr68P-0CKiPJnAYwOoxzAkB8SBkbs_FzXRAtflVQ7Nw&oe=6A638529"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UuS--kwxksQ7kNvwFBAHbw&_nc_oc=Adr0mRMtZq33-N5aKkAbNk6psJ9P-xf3GdlpF5EfXJWMpx_kRSN7cD-73fQ9QwasCHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXXDdE0XS47jtUcQ5ZguTgKPJch8m92kRab6zmM2FX8w&oe=6A63657A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p02Z_IT0sy0Q7kNvwExntMB&_nc_oc=AdquESl1kJN28R6KJnPqZcJJyESokWC5F6h45cCdWzMjHfXJvhpbkmu-es1i63Sry9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYMCDlhqkR0HQ_dOXZ7FNf2Qw0XmD8DEp5ULo3II4waQ&oe=6A63541E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
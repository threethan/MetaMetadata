6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6uhl4OcvqoQ7kNvwEaqOxJ&_nc_oc=AdokipMiabyZlhsFpBVQCG0EU6t3kRCZ4zCjLNenuOTFJl6QVPulsyM6GS_6xEH7I24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjOku_hEuPxBEMobfVd6u7eCsxLhAHd69xBIjx-2kUHA&oe=6A843C96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0r-SAjQ_pEQ7kNvwHmny8J&_nc_oc=AdrrWoSyGfOq0S8o1RL4OsmYl6EbIBYMRSsMBF0FZNIS-Uu9NNRYtOtNF64rSllWID8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOzsR-58y3xjvsXzt0ICyTnSebg0XjMBoq79IS6m1fmQ&oe=6A843E04"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDIuQFQbzWQQ7kNvwF4LXk2&_nc_oc=AdobuIb2hqeyvo7qCpaw9Ub103bAFSeQl9jW6Xjig-saRuWtZhOyykCl8nxWC__1NAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ7Nj2ZppJM8X7dA90_FsV4Kz9bhtl3WFDU6bDyiYtTQ&oe=6A844269"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSw8Ea9SgOIQ7kNvwGvN3PT&_nc_oc=AdrpY_xbsyg6ef1CGSsjzAl2HISYYtICjB-23U4H3ASDcpU397gITDxJ0lWS9cVTdyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzFHinOH9MLqlVtvDuAskyT0srcEnKxT9LaMW1T6664A&oe=6A845AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWFanKYoKk0Q7kNvwEMcmqd&_nc_oc=AdrHcw8HYLEn1jXLqy85Ill8Kzc0NfM87uvLr1Fk61vKmmGaccIV-1FLLCCX9gG-eo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQF2Pj5fj8SrgEmNX6u8UHPlWEFx6AUKNshPvmA6hRGA&oe=6A84499E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
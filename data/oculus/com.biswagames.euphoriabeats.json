6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhRwa9bqX6sQ7kNvwHuwjKO&_nc_oc=AdqIve5sIVs5aQZ4X9AFlyhYtuMj1QXCsHcfuaxcj_p0CczT0EZn2-3ejHXQmI2wPFw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDhTfsAl3sn8Y7X60OxLZowf43mnrINCOHGuzdsOJvEg&oe=6A916B96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLTumuk9aBoQ7kNvwFhYBDQ&_nc_oc=Adpyn4BrGkQ5FU6urb9nxXrfZgWmd1kV-jxAfRVeMM3g4SPuiI0qiG4YReZ3rjtDVFQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAGEIxpdEU95KYKG0zot4dqV8pZlE6GNl1O2ZiXMBzng&oe=6A916D04"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUzQrteDeJ0Q7kNvwG4lAJj&_nc_oc=AdpxJLG7Ld8qkNRXtV_37LJOm-qOTSP2SO6yeQEbCBAx6DkOA8uQkux6OYw0TxEBpl4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsA7f6fi_CN0D6X5e8b-A_t9QrduvoX4IR4BTQr2LGdg&oe=6A917169"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MPPw_zIaucQ7kNvwHTXA3F&_nc_oc=Adp3N1QZtb2-S9murbeDsPvsiA-XJDhYlHFeIpljRcudccBAgq1Vk00gvx2FQVfDl-g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIjFCS8UZ9aCevoHkQ5lj1bD2nuETjW0efrXCISQhaHw&oe=6A9189FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFxJ5a_WeDYQ7kNvwFtW4Px&_nc_oc=Adqb0t1NGw41OTh1JkgEEv39zkELLMsipWeRmwy3Heg-F8KEQcYbY5gv-QKejINURfs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcg6pMv352bcHfN0pPZ5c8OV9vEpvFAh94qZB18XVtVA&oe=6A91789E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
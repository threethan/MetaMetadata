6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UakQOEemqAwQ7kNvwFqjwnT&_nc_oc=AdpOtpywFvCOqky-y2zK6w5bJ9nG-TXJk9FUKGGtuCEBk6FEyaGilQjHR40qkMW4vhY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d5pspjc4PMhcwksRnB4JAwn8rXCwQBe1H77XwvZiLTA&oe=6A32B7D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMFW2dXcxfoQ7kNvwEMPuWQ&_nc_oc=AdohIy5HzOHRvDnwhsaO28gZQpfhiPvYKGx37iWImsd_hyyGcmtuJlOod8NxqRs5CR8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FQx6-ASMIyfJccuV6-Wy8Kf9iPdNPr5MtpkUOYJSUVQ&oe=6A32B944"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxakOyZ8JswQ7kNvwGRqhfN&_nc_oc=AdpZa6WWBrQlhXfbKHpnwVbk0EooxoRn_nESWUTLrmHTudNICsN2ivzyeqQKyHmn5ck&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RzOZzFCCwEsvMh7Khj718C5bR5KCKSyJd5ICCXYXajQ&oe=6A32BDA9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYs0L_3jAHsQ7kNvwE7tuB4&_nc_oc=Adpqllg1ORv4qgXkGZMwShPY_i05tDEpwAwTMjCLW2-n4JMI-Go2mLxOx8Qbno77caw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sehbquUphFYWsovEsr3qo6-6XSnV5ZGGYK-1sw-rSCg&oe=6A329DFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=my1kNZuJqNEQ7kNvwH4YkhK&_nc_oc=AdpAGNkVL6WeBONiyfeOX_AwMuSKPUcXGB-mc8j5xC5GLjq043l6Rppix-QSjt5RsB8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cjVax2Anyft7ZVDtaHiQsjbaZsYCUbdQYkcytZ03pEg&oe=6A32C4DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
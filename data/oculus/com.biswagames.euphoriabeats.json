6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glmYh8vw2JAQ7kNvwErXXGQ&_nc_oc=AdorUc2L1CXgSb5HE3YPGs1ZUE6biF6Kml23v6m7cvoyyNEulE6sHOsvmxCCdx1uKgM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGic1hs38lp9aRxi096EOXuoucvEAejSBRdFqVwBu0BsQ&oe=6A804816"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKuzyr5N_EoQ7kNvwGit4PA&_nc_oc=Adrhl_BkdAugi6HZn41nS_fCaODVl_5MwEqXR3tSKfv0xVHouqTBhm4qQWerpYuWDeA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiE77ZLOVt9LAbHcdzE1UHmkchM753LIcewuCh6cU_QQ&oe=6A804984"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE9dd0kHkE8Q7kNvwGUCvOP&_nc_oc=AdrnHbMJyNGT4-i9_VheUopRv-r-3m972rK9eLyhprvok21qgwAoftSKAGWCEXcU1wM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMKCys29THo7qsd0FlOpn2XnaFNr_r2oEpKXiCcxyqiQ&oe=6A804DE9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEL9XJmSny8Q7kNvwGxh2qs&_nc_oc=Adpig9H4dJvGyi2q3VeCU-0mZPWNiPAiYqN1Kc-yj4KCVu6jsj-uWJBc8-S3ds0akYQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzQsisywFqP88HgGoEtwFaU8NDslI38xGiuPNsnJL4Zg&oe=6A80667A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ejNuB4axMQ7kNvwHL3xcV&_nc_oc=AdoVmpKi2DihftdCBkj0qE-IaN2xz-ob4rch3kADg3VxZhVWqBXwwENIou3D2gd_d6g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs6DJvqGn5BrT6jn_smAbimE6RCVduZs29DjM725hv-Q&oe=6A80551E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
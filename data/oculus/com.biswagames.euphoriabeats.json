6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W3ELz-COYsQ7kNvwHC2K_z&_nc_oc=AdpMuX_pJqBM8PAridT2yr8saY1-cRRrnRG-0w2kxc-0BPsNXYpfDQPeIwNLhhSMc6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgWhjziaFR_hGoGVzyEU92KTycKYwrqgD_wa0MAOrk5Q&oe=6AE603D6"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlYDNDcI8D8Q7kNvwEe6aI_&_nc_oc=Ado3pseQPQCSivBM6Zr8fQkj42pUT59V-MN2YX2qqX_MzAqUNZaQg9rPZ7s6JpWH1VA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkbXqxSPXHf2_L41QS66UAchBCPSgtTB67d7gH6zsQ6g&oe=6AE60544"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sp2RtuHhA0Q7kNvwFbypUR&_nc_oc=Ado2DR9IIk1T-T4e5oNPU4nBD8tap_Hfx_jv5A0HU09-60CbGbqcb__hZu5A98yQGj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO99HM9ltsAt5HJAKl5YZO5X9i4b890yp1sx7stC7-3zA&oe=6AE609A9"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq_vmYknK_YQ7kNvwHW-U0H&_nc_oc=AdpFjGyYEqGAZ8VvSf_KSOZjhZMmwuH5QJcRbOkuk8cEBuIvh1DaszvkD8chxuG0p-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcId4-xWS-3vXg-xy2gA8R-Q3_L9ZM3wsrmFq_JZFX3Q&oe=6AE5E9FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQgTxm3ZzxgQ7kNvwEV52jI&_nc_oc=AdrQp0sGYbwdNebahoF3CNOFpi3nm9q8uFuqree96XMNCjGruQPDGAZ3YKyyJJkBsho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLnXeiGGJDDn-jysOtMgqgWoaRC9CHGbv6GdBrfrjTXg&oe=6AE610DE"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
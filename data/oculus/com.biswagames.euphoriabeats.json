6511030786_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDyNUzrCACoQ7kNvwFIZWmI&_nc_oc=AdopG-rwVL3ygEbGt5aVxfoHtY1ukPUuKlVqpeubBEoHpwYh_-4cAXsLEqiwoAIDiPE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI8nUaP4K24G6eL7yCoUtrjDW7eHpwcSJxoSkUiRYkKw&oe=6A940E96"}, {"file_name": "EBSS07.png", "id": "1358034548754357", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820372_1358034552087690_7742223009865070368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBOkt8rqMs4Q7kNvwHOb2k9&_nc_oc=AdrldeWkNb1dr-QtB9-iQNoSp5Msujs-XlhywkcHhtGGPLt_PBjrX2by0W1JYubN5qA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX2kiIb29IHOs5ygd99FBACEWK_vr3YlaJBXd6zAeFog&oe=6A941004"}, {"file_name": "EBSS26.png", "id": "712105054573339", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392175_712105057906672_2396837398204667784_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rkdyVYua2sQ7kNvwFS3BCi&_nc_oc=Ado691zZA9zX3CU5OgBKXji5Y-ErsBOfkTYRRYN-V0ARoK_iovrDlRzrKxeR3V_WECA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpfQ1wqSC9yAvsema-XQ_A7ojrPEL0nFL2LrFsiBkfSA&oe=6A941469"}, {"file_name": "EBSS12.png", "id": "665117346478244", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822410_665117349811577_8031786910336130847_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-5uyf0P3MMQ7kNvwEKgamg&_nc_oc=Ado7M-HfkH_x7yebhSEFHDf5TxPYFs0XeFbex9hrjkEnCTBNsLmpL6r9nww-RT4LRi4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjQnbneZyof0ywYLmVOVvvUoNQnTY9p1Y3cEcz3aSm3Q&oe=6A942CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumble.png", "id": "653843270616668", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491827042_653843273950001_3318244746014946578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFxJ5a_WeDYQ7kNvwHdD8MQ&_nc_oc=AdqVfr_fBtVtaYF6Df6n-qX2w0aQDu_uelgkzh2bbalHAQTKIn9o5Z5l5MaSNyvkKgw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrX7pQkNwFl-4BadXq-mcXgHLEvWVvXexVuLCqvM_v2w&oe=6A941B9E"}, "display_name": "Break Beats", "keywords": ["song", "Beat", "music", "mr", "dance"], "long_description": "Step into *Break Beats*, where your daily life meets rhythm-fueled dance floors. This isn't just a music game\u2014it's your playlist of moods, vibes, and after-hours energy.  \nFrom the **neon-soaked Cyberpunk streets** of *Night Shift* and *Out of Office*, to the **retro charm** of *Hard Reset* and *Game On*, and finally to the **weekend-ready floors** of *Friday Vibes* and *Party Mode*\u2014every level is inspired by things we actually say and feel.  \n\nWhether you're shaking off the workday or reliving arcade glory, *Break Beats* gives you the rhythm for every kind of break.  \n**Move. Tap. Escape. Your break starts now.**\n\n", "short_description": "Break Beats throws you into the groove with everyday vibes and neon flair. Dance through city lights, pixel dreams, and weekend floor-fillers in levels named after the way we live, work, and party."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/euphoriabeats/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
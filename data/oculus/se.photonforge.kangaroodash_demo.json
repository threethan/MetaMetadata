A27"}, {"file_name": "migrated_image.png", "id": "207417493820314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139291_1133089926779763_7647074607786098688_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRZGuC13da4Q7kNvwGqKF7B&_nc_oc=Ado8AK82kPlZmwpmFb3BL2vhX3WIMvyZUDtk9wLcjyU-dWgnmCd89v89aRbqT9zj3ZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj6WNtoJCJATMB1K09xdk1TKTlt_LYZNTMU_-LuG0UnQ&oe=6ABA7547"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kangaroo Dash Demo", "keywords": ["jump", "kangaroo", "dash"], "long_description": "Be prepared to jump your way through some of the most intense fun available in Virtual Reality! By using a physically based movement scheme Kangaroo Dash puts you right in the action. You\u2019ll dodge cars, ride the rapids and be chased by both fish and foe - and everything is controlled by your body!\n\nYou start off finding yourself stranded in a unknown world that consists of multiple floating islands. In order to survive you will need to visit four different islands, overcome obstacles and avoid deadly traps. Compete with yourself or try to make it to the global high score list!", "short_description": "Be prepared to jump your way through some of the most intense fun available in Virtual Reality! By using a physically based movement scheme Kangaroo Dash puts you right in the action. You\u2019ll dodge cars, ride the rapids and be chased by both fish and foe - and everything is controlled by your body!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.photonforge.se/tos/", "developer_terms_of_service_url": "http://www.photonforge.se/tos/", "publisher_name": "Photon Forge", "support_website_url": null, "website_url": "http://www.photonforge.se/games/kangaroo-dash/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "EXPLO
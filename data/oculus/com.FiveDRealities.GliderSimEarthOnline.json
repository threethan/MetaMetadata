dB_6z_fnZQ&oe=6AAE955E"}, {"file_name": "ScreenShot_Paris.png", "id": "2026404274818526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617729_2026404278151859_8407202974535144065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTv55nZATY4Q7kNvwHhERfa&_nc_oc=Adoks7noiMi7E1nwTZYdzMGwzZnP4c6-sjEpHGgTKcUSO5PEBcZkgeGVcxc5c-wmKsQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIcVIM8iewm0Ck2WEF7pTdyxGpr3MamsK0gc29hFwX8Q&oe=6AAE838E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1272283518332838", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619774_1272283521666171_7983948796814327334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqH_nDi7Q3MQ7kNvwEe0DTB&_nc_oc=AdqN2wn5T45Rch3lZ4ZdrdIxWs1uFmFKKwAqbymGyohpVK3cI46eFDMJ9aGhPqcW-f0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJamMUC2uMcZw-0-YPytgaW117oxxGAyOtoQtkwCxUXLA&oe=6AAEAD6B"}, "display_name": "Glider Sim Lite - Soaring / Flight Sim", "keywords": ["Flight", "Soaring", "Simulator", "Flying", "Earth"], "long_description": "**Fly Sun Valley, ID - Now Free Forever!**\n\nSoar over ski slopes, farmland, and scenic valleys in our fully detailed Sun Valley custom map - no subscription, no time limit. Dodge hot air balloons, watch cars weave through traffic below, and take your first flight with 3 guided paragliding lessons.\n\n**8 Aircraft to Master**\n\nParaglider \u2022 Paramotor Trike \u2022 Mini-Wing \u2022 Speedwing \u2022 Hang Glider \u2022 Ultralight Trike \u2022 FPV Racing Drone \u2022 Spectator Cam\n\n**Real Flight Physics**\n\nEvery cell of your glider is individually simulated with soft-body physics. Pull off wingovers, spirals, stalls, and swoops \u2014 and feel the distinct character of each aircraft.\n\n**Dynamic Weather System**\n\nDial in wind speed and direction, set the cloud base, choose your time of day. Watch thermals form naturally as sun angle heats the terrain, visualize lift with wind particles, and learn to read the sky like a real pilot.\n\n**Multiplayer**\n\nFly with friends in real time - explore the world together, share discoveries, and chase thermals as a crew.\n\n**7 Day Free Trial of Earth Online (Google Earth)**\n\nPowered by Google's photorealistic 3D scenery, Earth Online lets you fly anywhere on the planet. Launch from iconic peaks, explore hidden valleys, or revisit your favorite real-world flying sites. Subscribe to the 7 Day Free Trial then $5/month after the free preview.\n\n**Prefer to Own Earth Online and All Add-ons?**\n\nUpgrade to Glider Sim Deluxe with a one-time purchase for unlimited Earth Online access plus 2 additional custom maps!\n", "short_description": "Ready to soar anywhere on Earth? Experience the freedom of flight like never before. Take to the skies in Glider Sim, the ultimate soaring flight simulator. Fly 8 aircraft, including paragliders, hang gliders, speed wings, drones, and ultralights, all powered by realistic soft-body flight physics. Ride thermals, surf ridge lift, fly with friends in multiplayer, and explore the custom-built Sun Valley map - or start your free Earth Online preview and fly virtually anywhere on the planet."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BAqa7i5n38NI3LHQdANpLtsTEwJDHPIzWJJRG_iGr_c/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1HdN652xG33YJD36gWJ7kPlJH5GH4AqoRck0cszrO_ys/", "publisher_name": "5D Realities", "support_website_url": null, "website_url": "https://5drealities.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEME
hc=xYDIAZjnx1MQ7kNvwE2LU-9&_nc_oc=Adrat6Mp2sa_riZtjg77BQP-7D-1m8MKNOCsn0r2Yz-xWUklmjRczT2Mw3ty17elc6o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbvOGyVsNEYR9kglcv-ZJ4vB1ElmwHMGAA4c5o7lDTcA&oe=69CBC18E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail_Video.png", "id": "646644918442550", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303746_646644921775883_1067401139168162553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5VyMAUQBLcQ7kNvwElN9Ct&_nc_oc=AdrSh00kXq9AyVw1_yeu0dlyAuFwN7tXTqNZAfc2MtFYciOxOjCtjUxOtPudwK1fPIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBEO2PvVzrex5y01l9x-yg8Tmd1-KeUb0CeglgJVkyjQ&oe=69CBCC57"}, "display_name": "Glider Sim: Earth Online", "keywords": ["Flight", "Soaring", "Simulator", "Flying", "Earth"], "long_description": "\n**The Entire World is Your Playground** Powered by Google Earth's photorealistic 3D scenery, fly anywhere on the planet. Launch from iconic peaks, explore hidden valleys, or revisit your favorite real-world flying sites. Save locations, share discoveries, and explore together in multiplayer mode.\n\n**8 Aircraft to Master Paraglider:** Paramotor Trike \u2022 Mini-Wing \u2022 Speedwing \u2022 Hang Glider \u2022 Ultralight Trike \u2022 FPV Racing Drone \u2022 Spectator Cam\n\n**Real Flight Physics:** Every cell of your glider is individually simulated with soft-body physics, enabling authentic maneuvers: wingovers, spirals, stalls, swoops, and more. Feel the difference between each aircraft type.\n\n**Dynamic Weather System:** Customize every aspect of your flight environment\u2014wind direction and strength, cloud base, time of day. Watch as terrain and sun angle naturally create thermals and influence cloud formation. Toggle wind particle visualization to see lift patterns and master the art of soaring.\n\n**Start Flying Today:** Begin with a 7-day free trial, then continue your adventure for just $5 USD/month.\n\n**Don\u2019t Like Subscriptions?** Upgrade to Glider Sim Deluxe with a one-time payment and enjoy unlimited access to Earth Online plus Custom Offline Maps. \n", "short_description": "Fly anywhere in the world with real-time Google Earth 3D terrain and satellite imagery. Soar over your house, explore cities, or glide through mountain ranges - the entire planet is your playground.\n\nExperience dynamic weather, realistic physics, and stunning scenery as you pilot paragliders, hang gliders, ultralights, and racing drones. Fly solo or with friends in multiplayer.\n\nThe ultimate soaring simulator - powered by Google Earth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BAqa7i5n38NI3LHQdANpLtsTEwJDHPIzWJJRG_iGr_c/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1HdN652xG33YJD36gWJ7kPlJH5GH4AqoRck0cszrO_ys/", "publisher_name": "5D Realities", "support_website_url": null, "website_url": "https://5drealities.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24690232283988910"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2154467962027786"}]}, "baseline_offer": {"id": "2154467962027786"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766443920, "status": "PUBLISHED", "id": "2154467962027786"}]}, "liveCha
bQ9BRA&oe=69CBD35E"}, {"file_name": "ScreenShot_Paris.png", "id": "2026404274818526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617729_2026404278151859_8407202974535144065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYDIAZjnx1MQ7kNvwE2LU-9&_nc_oc=Adrat6Mp2sa_riZtjg77BQP-7D-1m8MKNOCsn0r2Yz-xWUklmjRczT2Mw3ty17elc6o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbvOGyVsNEYR9kglcv-ZJ4vB1ElmwHMGAA4c5o7lDTcA&oe=69CBC18E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1272283518332838", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619774_1272283521666171_7983948796814327334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L5woKdLu34Q7kNvwH1MN-h&_nc_oc=AdovyJVGV72IlSycbZmwn-E_hHPgHXrA0aBIhbodlVKsjMnWXnyCYDj4OOCpHuW4vZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFXAkBauRYruzhFvOMAVx-dojZEmoCJZoA_LhDmmw_1A&oe=69CBB32B"}, "display_name": "Glider Sim - Soaring / Flight Sim", "keywords": ["Flight", "Soaring", "Simulator", "Flying", "Earth"], "long_description": "**Fly Sun Valley, ID - Now Free Forever!**\n\nSoar over ski slopes, farmland, and scenic valleys in our fully detailed Sun Valley custom map - no subscription, no time limit. Dodge hot air balloons, watch cars weave through traffic below, and take your first flight with 3 guided paragliding lessons.\n\n**8 Aircraft to Master**\n\nParaglider \u2022 Paramotor Trike \u2022 Mini-Wing \u2022 Speedwing \u2022 Hang Glider \u2022 Ultralight Trike \u2022 FPV Racing Drone \u2022 Spectator Cam\n\n**Real Flight Physics**\n\nEvery cell of your glider is individually simulated with soft-body physics. Pull off wingovers, spirals, stalls, and swoops \u2014 and feel the distinct character of each aircraft.\n\n**Dynamic Weather System**\n\nDial in wind speed and direction, set the cloud base, choose your time of day. Watch thermals form naturally as sun angle heats the terrain, visualize lift with wind particles, and learn to read the sky like a real pilot.\n\n**Multiplayer**\n\nFly with friends in real time - explore the world together, share discoveries, and chase thermals as a crew.\n\n**Free  Preview of Earth Online - No Credit Card Required**\n\nPowered by Google's photorealistic 3D scenery, Earth Online lets you fly anywhere on the planet. Launch from iconic peaks, explore hidden valleys, or revisit your favorite real-world flying sites. Subscribe to the 7 Day Free Trial then $5/month after the free preview.\n\n**Prefer to Own Earth Online and All Add-ons?**\n\nUpgrade to Glider Sim Deluxe with a one-time purchase for unlimited Earth Online access plus 2 additional custom maps.\n", "short_description": "Choose from 8 aircraft, including paragliders, hang gliders, drones, and more. Experience true soft-body flight physics, dynamic weather systems, and full multiplayer support. Enjoy unlimited access to the Sun Valley custom map, or fly anywhere on Earth by starting your free Earth Online preview - powered by Google\u2019s photorealistic 3D scenery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BAqa7i5n38NI3LHQdANpLtsTEwJDHPIzWJJRG_iGr_c/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1HdN652xG33YJD36gWJ7kPlJH5GH4AqoRck0cszrO_ys/", "publisher_name": "5D Realities", "support_website_url": null, "website_url": "https://5drealities.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
n.com&_nc_ss=7f20f&oh=00_Af4ZNmMJNOShBM4KCyLLCnjKEd5Oz6HspcjUnq0s9dIBlQ&oe=6A1C39E0"}, {"file_name": "SCREENSHOT 4.png", "id": "1765241904142040", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822550_1765241907475373_161740962872590635_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8h3AKytPKQQ7kNvwEBNFar&_nc_oc=AdrhYwek7kTKaJ-Fv3CCJqipQhcUZtxtvPr4vaVZNr4YVi57BKmveQlH6CXn0ik6cTQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AjaC5JXh155yue6dNTS3oE-WfK7dkgGIJCH3Gx_puOA&oe=6A1C2CE4"}, {"file_name": "SCREENSHOT 5.png", "id": "871186708617520", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823802_871186711950853_2916978727201656771_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TA06BqoUw28Q7kNvwFE1vMM&_nc_oc=Adqf9886v8qAxgvNWPwh7pvw1D1AasL3l3tJNxjoL_kROJR7CTSB_tC8tfP32ZsT0mc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r9CZkq9X4L7otAVTpJAX4JE0ekNWhCGdGqhG8o36OTw&oe=6A1C3264"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Captain Cat", "keywords": ["cozy", "cosy", "relaxing", "cat", "vr"], "long_description": "# What if a cat\u2019s 9th life doesn\u2019t end in nothingness? What if, instead, it leads to a tropical archipelago?\n\nIn Captain Cat, the afterlife is a sunlit chain of islands, each home to a different cat with their own quirks, quests, and challenges. Pick fruit, go fishing, upgrade your boat, and explore at your own pace. Meet a whole cast of feline locals who need your help\u2014and discover the secrets of this purrfect paradise.\n{685082091144864}\n\n**Features:\nA cozy, tropical cat-afterlife to explore\nIsland-by-island quests and charming characters\nFishing, fruit picking, and boat upgrades\nRelaxed progression with plenty of discoveries**\n\nEarly Access coming December 2025", "short_description": "What if a cat\u2019s 9th life leads to a tropical archipelago? In Captain Cat, the afterlife is a sunlit chain of islands filled with feline neighbors, quests, and gentle challenges. Purrfect for a cozy and relaxing time.\nFish, pick fruit, upgrade your boat, and help cats across the afterlife as you uncover its playful secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/captain-cat-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://www.arianestudios.com/", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25359531400375770"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4216484228612883"}, {"status": "PUBLISHED", "id": "1386060723203849"}, {"status": "PUBLISHED", "id": "813291598380837"}]}, "baseline_offer": {"id": "813291598380837"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "4216484228612883"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25899137873081784", "version": "0.1.1"}, "id": "1814465259431848", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25204161362579442", "is_c
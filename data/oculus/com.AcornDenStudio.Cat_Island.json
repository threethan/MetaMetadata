90709206169396_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L46z6OPL1NAQ7kNvwFV4RRa&_nc_oc=AdriiiE-nLc-CRxWMyFHIngkZPnd8YtQMKPrqJP-zk0aLcLN2GpSXSgfMbSOAeYDgek&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRsTCFPECIYM9rND8dMrLV3jVJ8dP3t8LxLlSIu4hL_g&oe=6AFB2991"}, {"file_name": "SCREENSHOT 3.png", "id": "4120517551541009", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818885_4120517554874342_5539399795009961674_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsGnM1xws48Q7kNvwHTsuHh&_nc_oc=AdqAV9lFcw924-EO-Td8df5D89r17yLYsT_uLHNvIywPB6DA3rC82-HSYh5kuV080lc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNSE-_tEEu95ZNsA1fwmNARnF0MFQZn_F0aX-wwF7QEA&oe=6AFB3FA0"}, {"file_name": "SCREENSHOT 4.png", "id": "1765241904142040", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822550_1765241907475373_161740962872590635_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-HhnaScFSgQ7kNvwEIdC1F&_nc_oc=Adp0lobALWtm87nbIhG1k3pqjY_zEG2I94DAiwAx1DA3ghrvCWvOxdAyK3x7g-uVouo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf39BtUI-9HOQ5HrfrFbXOPn2Mc5PV24AAmke4bahGfw&oe=6AFB32A4"}, {"file_name": "SCREENSHOT 5.png", "id": "871186708617520", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_871186711950853_2916978727201656771_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqHWwtzhWSIQ7kNvwFRMCiF&_nc_oc=Ado9DKPrx1qwK1PkYDIzZ7OnobpVeRVyd4tRpTa3s29644-sQqMnx1EnTUv6uiGMNx4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG69xlNOB2pVtF91zM7Nob7UOS2gvfMh4tDKZ6Y9_QNw&oe=6AFB3824"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Captain Cat", "keywords": ["cozy", "cosy", "relaxing", "cat", "vr"], "long_description": "# What if a cat\u2019s 9th life doesn\u2019t end in nothingness? What if, instead, it leads to a tropical archipelago?\n\nIn Captain Cat, the afterlife is a sunlit chain of islands, each home to a different cat with their own quirks, quests, and challenges. Pick fruit, go fishing, upgrade your boat, and explore at your own pace. Meet a whole cast of feline locals who need your help\u2014and discover the secrets of this purrfect paradise.\n{685082091144864}\n\n**Features:\nA cozy, tropical cat-afterlife to explore\nIsland-by-island quests and charming characters\nFishing, fruit picking, and boat upgrades\nRelaxed progression with plenty of discoveries**\n\nEarly Access coming December 2025", "short_description": "What if a cat\u2019s 9th life leads to a tropical archipelago? In Captain Cat, the afterlife is a sunlit chain of islands filled with feline neighbors, quests, and gentle challenges. Purrfect for a cozy and relaxing time.\nFish, pick fruit, upgrade your boat, and help cats across the afterlife as you uncover its playful secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/captain-cat-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://www.arianestudios.com/", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25359531400375770"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUB
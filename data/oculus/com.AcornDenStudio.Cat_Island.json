n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gg__PUrl_EQ7kNvwGrvNO3&_nc_oc=AdrhxcKxHTX2wrmaRR7vLcZ5IYynXG_AoMTDxSsmE65YwzRXpVzkk05LfG6nD_hnlMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08Uc1aDF0HjJC0rJ_SOHxqPLcvPLjrt8nh7WI0eTvVtw&oe=69D8F064"}, {"file_name": "SCREENSHOT 5.png", "id": "871186708617520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_871186711950853_2916978727201656771_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJmgtM0jq_oQ7kNvwHzJHSy&_nc_oc=AdpyBFA1EJsGYIUEFtGWvO2VMoP9cCdxtS-arVsqIUrmuf2MJnaj1jxYdkboXKG6WaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gOjoaiFF9t-ikKEisLjAbQfyLphc-XesdCs_8izOy-w&oe=69D8F5E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Captain Cat", "keywords": ["cozy", "cosy", "relaxing", "cat", "vr"], "long_description": "# What if a cat\u2019s 9th life doesn\u2019t end in nothingness? What if, instead, it leads to a tropical archipelago?\n\nIn Captain Cat, the afterlife is a sunlit chain of islands, each home to a different cat with their own quirks, quests, and challenges. Pick fruit, go fishing, upgrade your boat, and explore at your own pace. Meet a whole cast of feline locals who need your help\u2014and discover the secrets of this purrfect paradise.\n{685082091144864}\n\n**Features:\nA cozy, tropical cat-afterlife to explore\nIsland-by-island quests and charming characters\nFishing, fruit picking, and boat upgrades\nRelaxed progression with plenty of discoveries**\n\nEarly Access coming December 2025", "short_description": "What if a cat\u2019s 9th life leads to a tropical archipelago? In Captain Cat, the afterlife is a sunlit chain of islands filled with feline neighbors, quests, and gentle challenges. Purrfect for a cozy and relaxing time.\nFish, pick fruit, upgrade your boat, and help cats across the afterlife as you uncover its playful secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
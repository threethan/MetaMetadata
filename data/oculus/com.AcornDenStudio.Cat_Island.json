ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvbSLMBREhcQ7kNvwGXT76H&_nc_oc=AdrefBXcio1ZsvaRrhG4v67f-rerTPyvOUMSufteV4Y5JW_jtHF3a6VeGPOw-kT0S48&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHIDAraSqujdxUoohew0MukvgIRkf8rThiRe6DREGXhg&oe=6AF9CB07"}, {"file_name": "7015855f15234258b4f411077b237c8d.png", "id": "1494507748314948", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824700_1494507754981614_7078245484279875318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kxn9NCpA_5gQ7kNvwHgBSfh&_nc_oc=AdpzyemxOykXVWdJcicyD72VCr9_omEp_nNZIFOAUOLz5IFmjLWyELrkr55zaWmsGGU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm1fO-p5To60wGiS7lMJiEhxeHGW0HpqHsE4kby4-Dmg&oe=6AF9D9CA"}, {"file_name": "4626486967eb4d30ab062717d84d4615.png", "id": "882592440978235", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_882592444311568_6972052041681766083_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYNRNtHH4LgQ7kNvwEJWGT9&_nc_oc=AdqMCY-2DLjr1YHLvbKYdeC9RThWIxqUj3qFVRPZfladZRVAiNfajFHP3IK3FUaox1M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMRg4ICFOYPZl_0oSaC34tPMzigHrR4lXN-3ciLpkrZQ&oe=6AF9DD7B"}, {"file_name": "d481b4815d364e77a84f8be511325d6e.png", "id": "2617704711896449", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827646_2617704721896448_3410199568627628119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZvIapNrXWAQ7kNvwFoXUrl&_nc_oc=AdqsfsxRC5Fm_nL-9KfOXLQRiTtPRfu90vLaa2vIo6SmYqClE6PQvGyAKkS-sMhyWnM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgWLFq9pRl2UZOMVlrb857Ame52NoOPPZgOjvtcXikrw&oe=6AF9CEBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Captain Cat", "keywords": ["cozy", "cosy", "relaxing", "cat", "adventure"], "long_description": "# Captain Cat \u2014 a cozy VR adventure in a purradise afterlife \ud83d\udc3e\ud83c\udf34\n\nYou\u2019re a cat who\u2019s crossed the Rainbow Bridge\u2026 and landed in a sunlit archipelago of tropical islands. Sail between shores, meet quirky feline locals, complete relaxing quests, and reel in seven rare fish to find your way back home. Upgrade your boat, customize your look, and explore at your own pace\u2014**no timers, no stress, just good vibes and discovery.**\n\n{2065773257554280}\n\n**Features:**\n\n- Cozy exploration in a tropical cat-afterlife \ud83c\udf1e\n\n- Island-hopping quests with charming feline characters\n\n- Relaxing fishing, fruit picking, and light crafting\n\n- Boat upgrades and gentle progression\u2014play your way\n\n- Chill soundtrack, ambient audio, and photo-ready vistas \ud83d\udcf8\n\n- Comfort-first VR options (snap/continuous, vignettes, seated/standing)\n\n- Collectibles, cosmetics, and secrets hidden across the islands\n\n- Accessible, low-pressure gameplay perfect for unwinding\n\n{856236683931871}\n\n**Early Access: Play now and help us improve our game! \ud83c\udfa3**\n\nSupported by TAICCA and the Taiwan Ministry of Culture as part of the 2025 Innovative Co-production: VR Game Early Access Production Program.\n\nDeveloped by Acorn Den VR Studio.\n{3200042670166800}\n", "short_description": "What if a cat\u2019s 9th life leads to a tropical archipelago? In Captain Cat, the afterlife is a sunlit chain of islands filled with feline neighbors, quests, and gentle challenges. Purrrfect for a cozy and relaxing time when everything else becomes too stimulating.\nSit on your couch, get a warm drink and help this little cat find their master again. Roam from island to island, fish, pick fruits, upgrade your boat, and more."}]}, "developer_name": "Acorn Den VR Studio", "developer_privacy_policy_url": "https://www.arianestudios.com/captain-cat-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://www.arianestudios.com/", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
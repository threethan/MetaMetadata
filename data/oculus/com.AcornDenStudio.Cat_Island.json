bQXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgy-MgdbDZRhce_oB0H7bAYXCt5_FT1nLgo5jOlN8qeA&oe=6A9ED387"}, {"file_name": "7015855f15234258b4f411077b237c8d.png", "id": "1494507748314948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824700_1494507754981614_7078245484279875318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD606feUrd0Q7kNvwGtIvKp&_nc_oc=AdrYPViKwiYvX1AMwPVOfBHa53ACfNCdZRpQLCTb-3wIvqSLW-ptTHdjD4fkFmLwN-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWrUyCxBDIsB1VJQ7_LLmW7FjEA4qHFslYc4BUQ2KKPw&oe=6A9EE24A"}, {"file_name": "4626486967eb4d30ab062717d84d4615.png", "id": "882592440978235", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_882592444311568_6972052041681766083_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WiIOWMxoBgQ7kNvwGL3oS_&_nc_oc=Adp2yCEfzN2Rig_ycS0rmKn9wAEJKNbkcf7QHD--YPguxZCpmU_YiykopHie8YEqcOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEXHIuaWmGg083eOKLpufbnCEex8kom_uu-8QZjfdXXQ&oe=6A9EADBB"}, {"file_name": "d481b4815d364e77a84f8be511325d6e.png", "id": "2617704711896449", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_2617704721896448_3410199568627628119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsqSB3Up0MEQ7kNvwG_L-xg&_nc_oc=Ado-t2g2AE_ko1nEqS8S2fmVw8sJ2DlbRAH_nS84EeGZKhXi03HQkgfgjmRMJePwEvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQrS-Blc41nnA4M8wxebF-Z9hX-XXdEic2_3UZfzDtSQ&oe=6A9ED73E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Captain Cat", "keywords": ["cozy", "cosy", "relaxing", "cat", "adventure"], "long_description": "# Captain Cat \u2014 a cozy VR adventure in a purradise afterlife \ud83d\udc3e\ud83c\udf34\n\nYou\u2019re a cat who\u2019s crossed the Rainbow Bridge\u2026 and landed in a sunlit archipelago of tropical islands. Sail between shores, meet quirky feline locals, complete relaxing quests, and reel in seven rare fish to find your way back home. Upgrade your boat, customize your look, and explore at your own pace\u2014**no timers, no stress, just good vibes and discovery.**\n\n{2065773257554280}\n\n**Features:**\n\n- Cozy exploration in a tropical cat-afterlife \ud83c\udf1e\n\n- Island-hopping quests with charming feline characters\n\n- Relaxing fishing, fruit picking, and light crafting\n\n- Boat upgrades and gentle progression\u2014play your way\n\n- Chill soundtrack, ambient audio, and photo-ready vistas \ud83d\udcf8\n\n- Comfort-first VR options (snap/continuous, vignettes, seated/standing)\n\n- Collectibles, cosmetics, and secrets hidden across the islands\n\n- Accessible, low-pressure gameplay perfect for unwinding\n\n{856236683931871}\n\n**Early Access: Play now and help us improve our game! \ud83c\udfa3**\n\nSupported by TAICCA and the Taiwan Ministry of Culture as part of the 2025 Innovative Co-production: VR Game Early Access Production Program.\n\nDeveloped by Acorn Den VR Studio.\n{3200042670166800}\n", "short_description": "What if a cat\u2019s 9th life leads to a tropical archipelago? In Captain Cat, the afterlife is a sunlit chain of islands filled with feline neighbors, quests, and gentle challenges. Purrrfect for a cozy and relaxing time when everything else becomes too stimulating.\nSit on your couch, get a warm drink and help this little cat find their master again. Roam from island to island, fish, pick fruits, upgrade your boat, and more."}]}, "developer_name": "Acorn Den VR Studio", "developer_privacy_policy_url": "https://www.arianestudios.com/captain-cat-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://www.arianestudios.com/", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
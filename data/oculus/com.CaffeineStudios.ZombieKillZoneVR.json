uscdn.com&_nc_ss=7f20f&oh=00_AQI5jw6VhRbCl4un-v6De06mBtmRjWhLBTK-OuCZLLrr9w&oe=6A9EB4F7"}, {"file_name": "screenshot_03_2560x1440.png", "id": "1726898418662424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623601_1726898425329090_1822003859347437066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Uvosjnx0rwQ7kNvwGPRMTD&_nc_oc=AdpdIzPWyohHgrNb_dd8-1GRcKBjxn1l7Ni3oseA2u-xr1twEess2-DtLqyOsDyUCW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSioAcpyXkNr6_8Lb6ALXRxnlRJLbhpvV7UuepPR_w0w&oe=6A9EE188"}, {"file_name": "screenshot_05_2560x1440.png", "id": "27049329081400540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619836_27049329101400538_6664868395687555683_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6syO1Z2NCoUQ7kNvwFLJdIA&_nc_oc=AdqAC_XB5-L-sdvl7PBl2fXTrn4VdIXEWcFcU8cdDcCPQByIDQo6fj1Yt6kn6kZHNlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuoQwrOvN119hT5OBto5H_gWhmo9gPQgUtuLMNzQqglw&oe=6A9EDFAA"}, {"file_name": "Covert art Landscape.png", "id": "2222619025201212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623601_2222619028534545_325183714427149993_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVLEmdcHFuYQ7kNvwHA5c1s&_nc_oc=AdpM6QS3QuPu9OGrMlEtH4NjB8gWfhrTUIvdcDDnseI2r14t1usANU3zG-0b8v3kl7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMk6tjJwM3mJEdF4YIfbR7eXuOU941-mEH9oYalBfXRw&oe=6A9EAFB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Kill Zone VR", "keywords": ["Zombie", "shooting", "Survival", "shooter", "hunt"], "long_description": "Step into Zombie Kill Zone VR, a fast-paced virtual reality survival shooter built around direct weapon interaction, close-range danger, and escalating zombie encounters. Explore the battlefield, pick up weapons, and defend yourself as zombies spawn around the terrain and chase you down using aggressive attack behavior.\nEvery hit matters. Your health is tracked during the run, and the game ends when the undead overwhelm you. Take down as many zombies as possible, survive longer, and compete for a place on the leaderboard with your best kill score.\nDesigned for VR, Zombie Kill Zone VR focuses on physical presence, responsive combat, atmospheric zombie audio, and simple replayable survival gameplay. Grab your weapon, stay alert, and see how long you can hold the kill zone.", "short_description": "Zombie Kill Zone VR is an immersive survival shooter where players grab weapons, face waves of attacking zombies, manage their health, and fight for the highest kill count in a tense virtual reality battlefield."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios.github.io/zombie-kill-zone-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1186947044500573"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2277162816375720"}, {"status": "PUBLISHED", "id": "1256808733184554"}, {"status": "PUBLISHED", "id": "1074064798442339"}, {"status": "CANCELLED"
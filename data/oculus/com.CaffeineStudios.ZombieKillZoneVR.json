"1109657078536662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835880_1109657081869995_6828711110071107451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=026en9K0YNcQ7kNvwE0vzPi&_nc_oc=Adp0w2L3a8Zxq6vYwZHWjjxe-Ogx2mg0yF-3-HdMr4EdNiYHFB-o9Zl3XuVnQpsfHaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi5BmBKIHUH6jCOabPFRZYHN6_VwWe5OA2_CQoL6Mv1w&oe=6B05CD01"}, {"file_name": "Screenshot 02 - Helicopter Rescue.png", "id": "1575047137782047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835849_1575047141115380_4888928018288505265_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLP2sdE6keAQ7kNvwFtNqU0&_nc_oc=Ado5th4vioOmcseTzPpfkN2jbFZemA_TI4CVD1jd29aKaucaHm0MT2n7Rbll40vBmr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeiVy6NdBwP-YYz4w7YPW1bfmEABGDrQebueU7nazf7Q&oe=6B05C0A0"}, {"file_name": "Screenshot 05 - River Firefight.png", "id": "970417095790994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835815_970417099124327_4538502865396504502_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lOoFNDXdfgQ7kNvwH455gN&_nc_oc=AdrDCeL8RnwKO_QUQzOnYgvm9pRp5NDDDZGmAtLmz6LaPpMgpCPXycYkkGAig9f98oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG_R-aLTSxQ3VJ2N6_C13qI02V7ep8NTc2J2P9dXferw&oe=6B05B47E"}, {"file_name": "Screenshot 04 - Jungle Ruins.png", "id": "1083030451418828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835903_1083030454752161_7815823206881420998_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdvgfHLr7oIQ7kNvwEbEcSl&_nc_oc=AdqZf3U3_cZiJEotR6l02Pdf_CguzVjs9G2lhhsZujFv1Zzo0je2lQTqmZgoUn7QDQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv-DGO1Wv6InKdCBQWVtL463dk18Mt9N7c58ZaY4KN4A&oe=6B05D4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - Landscape.png", "id": "29254384400889357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835821_29254384407556023_4431303191459514006_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrVwtiLGATMQ7kNvwF0zkeu&_nc_oc=Adrhf4zayY8V7a65TJDILhsXTHZ2NeRmuba5eIBekqf4sLi97sTGroOCUy_r3HC4wpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo-OZaDz1-J0TpFHnhPdh9qzYdl1zZM7_v-wnI82oF3Q&oe=6B05D949"}, "display_name": "Zombie Kill Zone VR", "keywords": ["Zombie", "survival", "FPS", "shooter", "Escape"], "long_description": "The jungle is overrun. The undead are closing in. Can you make it to the rescue helicopter?\n\nZombieKillZone is a single-player VR zombie survival shooter combining first-person gunplay, arm-swing movement and helicopter extraction in a jungle arena. Keep moving, hold your nerve and make every shot count.\n\nFOUR WAYS TO FACE THE UNDEAD\n- Jungle Hunt: Clear the area, then reach the helicopter. Chase a faster completion time on your next run.\n- Last Flight: Survive a three-minute assault, then board your rescue flight.\n- Horde Siege: Battle through seven waves with brief breaks between attacks, then extract.\n- Last Stand: Take on an endless zombie horde. Push for more kills and a longer survival time.\n\nCHOOSE YOUR CHALLENGE\nPlay Casual or step into Hardcore, where faster zombies and ranged spit attacks raise the pressure. Learn the controls in guided training before taking on your next run.\n\nMOVE, AIM, SURVIVE\nSwing your arms to move through the arena and choose which hand holds your gun. Navigate jungle trails, ruins and creek crossings as you fight your way towards the landing zone.\n\nBEAT YOUR BEST\nTrack local personal bests across the modes and return to improve your time, kills and survival. Whether you enjoy wave shooters or endless horde survival, the next run is another chance to outlast the undead.\n\nClear the jungle. Survive the siege. Catch your last flight out.", "short_description": "Fight the undead and reach the rescue helicopter in ZombieKillZone, a single-player VR zombie survival shooter. \n\nBattle across a jungle arena in four modes: hunt zombies, survive a timed assault, defeat seven waves, or face an endless horde.\n\nChoose Casual or Hardcore, swing your arms to move, and aim and fire with either hand. \n\nEscape alive in extraction missions or push your limits in endless survival. Beat your personal best and take on the jungle again."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios.github.io/zombie-kill-zone-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1495909900270951"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908879829_1140502908708644_7019394166051679229_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Hc7DjUM4WkQ7kNvwHSqli2&_nc_oc=Adqyi6kKwvKiuxiMLA7u9eR_bYHndULIQVzin1AByZ_gsHdbec9Be6XnCQqmEQFtHrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcv6SGjZOVJM
0_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9GoJtxHVZIQ7kNvwESGd7Q&_nc_oc=AdrXxRF-UdNNtN4EpPLE2jvIbKCJpoBFiU5I-TWwu1jR-E0EhtVt7U7KP0py7KN3Tt0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHl513KYrkaPm5e3hXP_fxlWaVERozafUDkxcsyH3mCg&oe=6A915F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "673522158_2079157762665334_530041650697970012_n.png", "id": "1018624113878399", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499304952_1018624117211732_4924158215342043173_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caH4C6zaAU8Q7kNvwFuMyV1&_nc_oc=AdpdYVjaeH5gLSPQp5OIU4izxj02bMxbqD7ribegs3qhKsPbAOOJgPjyAhdRbfd-PHk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENu9OnwCZAli_Ot2GmoOa16fFGyBh2x0MaV7JBtKSFiA&oe=6A9189B7"}, "display_name": "Zombie Kill Zone VR", "keywords": ["Zombie", "shooting", "Survival", "shooter", "hunt"], "long_description": "Step into Zombie Kill Zone VR, a fast-paced virtual reality survival shooter built around direct weapon interaction, close-range danger, and escalating zombie encounters. Explore the battlefield, pick up weapons, and defend yourself as zombies spawn around the terrain and chase you down using aggressive attack behavior.\nEvery hit matters. Your health is tracked during the run, and the game ends when the undead overwhelm you. Take down as many zombies as possible, survive longer, and compete for a place on the leaderboard with your best kill score.\nDesigned for VR, Zombie Kill Zone VR focuses on physical presence, responsive combat, atmospheric zombie audio, and simple replayable survival gameplay. Grab your weapon, stay alert, and see how long you can hold the kill zone.", "short_description": "Zombie Kill Zone VR is an immersive survival shooter where players grab weapons, face waves of attacking zombies, manage their health, and fight for the highest kill count in a tense virtual reality battlefield."}]}, "developer_name": null, "developer_privacy_
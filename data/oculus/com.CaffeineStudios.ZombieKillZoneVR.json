uscdn.com&_nc_ss=7f20f&oh=00_AQJgKUJmsvt09g6opeI8D1uwvjK20clfpqZSeklNgJ_V6w&oe=6AA157F7"}, {"file_name": "screenshot_03_2560x1440.png", "id": "1726898418662424", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623601_1726898425329090_1822003859347437066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcQHwM0v1XgQ7kNvwEHcMr6&_nc_oc=Adr6taLSL_W3ly9N5cEcx7vqxBKPXM49qP8iSWBRYkBZg9wlW18tWr21grJghShhYm8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTVp9kjbxfzMRfG95bhvm90UAxqz_w688z9ALzLrJw2Q&oe=6AA14C48"}, {"file_name": "screenshot_05_2560x1440.png", "id": "27049329081400540", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619836_27049329101400538_6664868395687555683_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUJmBPo4oXQQ7kNvwHWqrSP&_nc_oc=AdoWflysHJPJ0Dsd3FjKDyt5-RtaSOjFLh7cOgUR6ESTSxRBsmKUDklnXClgWCpbOQM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmLs4lpHwkz41wA0rYKeAkFWMxnm3ilHTIRBeHpusAow&oe=6AA14A6A"}, {"file_name": "Covert art Landscape.png", "id": "2222619025201212", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623601_2222619028534545_325183714427149993_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEK7EUZUX9sQ7kNvwFVLgaJ&_nc_oc=AdpwVDMDVPAl1Cy9fS4SuG0XyGcDBejAgu6Y8zyysucRc3b0seJbf3zIZ1y7vGPQIVc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ2I4SB6Bzxd6skhM7ogdl_a9S9J4kU0xjprmpq-jZmg&oe=6AA152B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Kill Zone VR", "keywords": ["Zombie", "shooting", "Survival", "shooter", "hunt"], "long_description": "Step into Zombie Kill Zone VR, a fast-paced virtual reality survival shooter built around direct weapon interaction, close-range danger, and escalating zombie encounters. Explore the battlefield, pick up weapons, and defend yourself as zombies spawn around the terrain and chase you down using aggressive attack behavior.\nEvery hit matters. Your health is tracked during the run, and the game ends when the undead overwhelm you. Take down as many zombies as possible, survive longer, and compete for a place on the leaderboard with your best kill score.\nDesigned for VR, Zombie Kill Zone VR focuses on physical presence, responsive combat, atmospheric zombie audio, and simple replayable survival gameplay. Grab your weapon, stay alert, and see how long you can hold the kill zone.", "short_description": "Zombie Kill Zone VR is an immersive survival shooter where players grab weapons, face waves of attacking zombies, manage their health, and fight for the highest kill count in a tense virtual reality battlefield."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios.github.io/zombie-kill-zone-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1186947044500573"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2277162816375720"}, {"status": "PUBLISHED", "id": "1256808733184554"}, {"status": "PUBLISHED", "id": "1074064798442339"}, {"status": "CANCELLED"
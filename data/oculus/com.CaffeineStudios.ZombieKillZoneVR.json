ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x14u-EVHdmoQ7kNvwH-lF_3&_nc_oc=Adr_VZETXncREC4iDyAnks48OA4Brm5r5w32OKgO2I8dmaaxgG3QWsoBkBQ1G44Uh70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgH242ICtFSAC1S-o8QgKnYNGlpoMJ10wq-htB9rjp2w&oe=6AFC8275"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Kill Zone VR", "keywords": ["Zombie", "shooting", "Survival", "shooter", "hunt"], "long_description": "Step into Zombie Kill Zone VR, a fast-paced virtual reality survival shooter built around direct weapon interaction, close-range danger, and escalating zombie encounters. Explore the battlefield, pick up weapons, and defend yourself as zombies spawn around the terrain and chase you down using aggressive attack behavior.\nEvery hit matters. Your health is tracked during the run, and the game ends when the undead overwhelm you. Take down as many zombies as possible, survive longer, and compete for a place on the leaderboard with your best kill score.\nDesigned for VR, Zombie Kill Zone VR focuses on physical presence, responsive combat, atmospheric zombie audio, and simple replayable survival gameplay. Grab your weapon, stay alert, and see how long you can hold the kill zone.", "short_description": "Zombie Kill Zone VR is an immersive survival shooter where players grab weapons, face waves of attacking zombies, manage their health, and fight for the highest kill count in a tense virtual reality battlefield."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios.github.io/zombie-kill-zone-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978
uscdn.com&_nc_ss=7f20f&oh=00_AQKHVx7cze-WnczjgzTw9MtdkIY958DDXpCqatuRiPimXA&oe=6A9D6377"}, {"file_name": "screenshot_03_2560x1440.png", "id": "1726898418662424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623601_1726898425329090_1822003859347437066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Uvosjnx0rwQ7kNvwF6pb_S&_nc_oc=AdrQoa_BonXvS_iLFbTkCPDghWTFETHEJ-gtdDEgK7YRuWv6tyvrvvIQOXlSdPxKQKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQfWzTxAs0ZjNHfHookJ10ejhGCi-SP1r8aybReQBE6w&oe=6A9D57C8"}, {"file_name": "screenshot_05_2560x1440.png", "id": "27049329081400540", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619836_27049329101400538_6664868395687555683_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6syO1Z2NCoUQ7kNvwGSH_gk&_nc_oc=AdoEaCvOl3MMbmhkmP9nrF_JZ65c4RPOKx2bOlcYczu2LvnMRMRwjVQ3VuNXMftUgdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKfLIdQk0GFr-pOaunFNq6wrtzVc8sdtb2xYBDky1nQg&oe=6A9D55EA"}, {"file_name": "Covert art Landscape.png", "id": "2222619025201212", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623601_2222619028534545_325183714427149993_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVLEmdcHFuYQ7kNvwHChZ-S&_nc_oc=AdoV0OQOEzMtTNui29C1QNU1gV09xnBDkkO4izeYl6TzrWNf_dbIQ0blOuCWRqz_yMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-gICY_0VK7OjUBdzq3LKJA8IIXDv3YNwx0JRjYg2m2g&oe=6A9D5E35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Kill Zone VR", "keywords": ["Zombie", "shooting", "Survival", "shooter", "hunt"], "long_description": "Step into Zombie Kill Zone VR, a fast-paced virtual reality survival shooter built around direct weapon interaction, close-range danger, and escalating zombie encounters. Explore the battlefield, pick up weapons, and defend yourself as zombies spawn around the terrain and chase you down using aggressive attack behavior.\nEvery hit matters. Your health is tracked during the run, and the game ends when the undead overwhelm you. Take down as many zombies as possible, survive longer, and compete for a place on the leaderboard with your best kill score.\nDesigned for VR, Zombie Kill Zone VR focuses on physical presence, responsive combat, atmospheric zombie audio, and simple replayable survival gameplay. Grab your weapon, stay alert, and see how long you can hold the kill zone.", "short_description": "Zombie Kill Zone VR is an immersive survival shooter where players grab weapons, face waves of attacking zombies, manage their health, and fight for the highest kill count in a tense virtual reality battlefield."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios.github.io/zombie-kill-zone-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1186947044500573"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1256808733184554"}, {"status": "PUBLISHED", "id": "1074064798442339"}, {"status": "CANCELLED", "id": "2620831705025289"}, {"status": "PUBLISHED"
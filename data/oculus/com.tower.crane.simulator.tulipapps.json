 professional looking to hone your skills, or someone seeking a unique and engaging VR experience, Tower Crane Simulator offers unparalleled realism and excitement. Master the skies, build impressive structures, and become the ultimate crane operator in this immersive virtual reality simulator.", "short_description": "Step into the high-stakes world of construction with Tower Crane Simulator, the ultimate virtual reality experience that puts you in the operator\u2019s seat of a powerful tower crane. Master the art of precision and control as you take on a variety of challenging construction projects, from towering skyscrapers to intricate bridges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TulipApps", "support_website_url": null, "website_url": "https://tulipapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26500298329561479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299158_436911642538709_8339304084625054186_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGcPXFr4N2gQ7kNvwFYuXiw&_nc_oc=Adm9Zjh6nBSF7AWh757WQOzx0IKD7uLHqicHeLMFA17jZHdn3LYt4zpAyfAZvwGdG1E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlYHKgk9aId1OmZNfPofhIjSGegF8MmywWHNr2mW1
=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClJnopOPY3TQh-G5ZL2CY6beH2Tn9KFp6JAajnh0-kRQ&oe=6A54E3B2"}, {"file_name": "5.png", "id": "1520340501853349", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75241696_1520340508520015_2631154399501728129_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAKHsvgZxGsQ7kNvwHfb17t&_nc_oc=AdrEKSvRK9yrDczQmB8GdC8ouNSZ6gDay-7XIA0tSh0my4ubLbqYznJtXuvORRTL_8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9cJxuDVI1__kc9M65aVFmHvwFEMWk7e3QcNAkH0B5MQ&oe=6A54E7F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower Crane Simulator", "keywords": [], "long_description": "Step into the high-stakes world of construction with Tower Crane Simulator, the ultimate virtual reality experience that puts you in the operator\u2019s seat of a powerful tower crane. Master the art of precision and control as you take on a variety of challenging construction projects, from towering skyscrapers to intricate bridges.\n\nRealistic Crane Operation: Experience true-to-life tower crane controls with advanced physics and mechanics.\nDetailed Graphics and Immersive Sound: Immerse yourself in a highly detailed construction environment with realistic sounds that enhance the experience.\n\n\nExperience the thrill and responsibility of operating a tower crane from the comfort of your home. Whether you\u2019re a construction enthusiast, a professional looking to hone your skills, or someone seeking a unique and engaging VR experience, Tower Crane Simulator offers unparalleled realism and excitement. Master the skies, build impressive structures, and become the ultimate crane operator in this immersive virtual reality simulator.", "short_description": "Step into the high-stakes world of construction with Tower Crane Simulator, the ultimate virtual reality experience that puts you in the operator\u2019s seat of a powerful tower crane. Master the art of precision and control as you take on a variety
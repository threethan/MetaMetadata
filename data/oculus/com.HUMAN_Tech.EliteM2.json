t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u_JnDzi9fsQ7kNvwHuox4i&_nc_oc=AdpmPSXi-BJW4X-JolSg0qsTJjPSeqgGOgjNkQ3ZP7EQLWHIRtUitRVG_UFiIbH2ixk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A6ipbgwsUkAb5-Xa7IMRBtvOBXH_AHHkLSNo4R5BykQ&oe=69F9EF2A"}, {"file_name": "56.png", "id": "3192831004188895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdwKuzT1veAQ7kNvwEg3uGR&_nc_oc=AdrhydhcReYVQoaThbKifXEXW0bagOYlX_3efBrmm7NxQh8flOTIthfqxTb5JllwwZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J89gjrA8Badsx3kMS3eKPu73Ku8gyBBpgYFgJj11Ccg&oe=69FA0D05"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9KlqwVDww4Q7kNvwEuJ5Yi&_nc_oc=AdrYDO_YlmjBXe0SbEQFZMa3z9qsicKugPzl-Ll2yIEyJ9b_ZxefFdu9bClA5Y3eNYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N03zLHJkAhLcnVjGxPbvzPJnAUArLYSVl8cb3TBfyzQ&oe=69F9E804"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXmsUNfekAYQ7kNvwEQ2VXt&_nc_oc=AdrkXsaxreSuBJKSkmAtC6q24exbf08uv55hYGuJb01sBl11fdqfuxWLySCCwWgDJss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_uxux8FgB9a3gTZem08hbN6hpfFqmbi_kFqLkYMT_Tg&oe=69FA0D28"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o239TqGV1M8Q7kNvwE0admk&_nc_oc=AdrBROh63O-i2DWpJnve53cZmpgzz3nBbjnViM3HdsevnO_Hh0vnWr-HF4Frw1IgjZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o0JAkLVo-Gw0IGKDJ8ZvSFmXW3ywWbUMZwZg4wGuQJQ&oe=69F9DE00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u
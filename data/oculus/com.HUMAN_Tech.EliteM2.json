31004188895", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB9P406BeFYQ7kNvwF7ufPh&_nc_oc=Ado43NYEAqG6UMHZv8LGkKFUVWPwtgYwneQYftM1YWWoxyDczwSz4mOLTCvQxcFDaYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKOZnMhxPIWP6V3aPOeRuZNCP01FOlD65BbTuLB1clOQ&oe=6A623385"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdltYzgME9cQ7kNvwFcv9oW&_nc_oc=AdohvtuP-4K52sAFXzFNLVfqRjL8H45Ep7s_sJQqybHmyYDFvBgn1_0j0GgAXZgNP-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrFsZ0ESucJZuvP2hqSGRQfy3abHUp2npY78Eh1_WMrg&oe=6A620E84"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ5y_jdtbt4Q7kNvwEnWqqw&_nc_oc=AdrUDgTICHRQ4I6hbnjsd-ITLCbwSfgM9eMfeg_eRXi1G5dC0BjvFiaAgb37HD9r65k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBNB9AH6ylETzsi5G2DGh4izkbbwB_g-VWeZE4hQE3mQ&oe=6A61FB68"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrkfaElI85oQ7kNvwF8t1bE&_nc_oc=AdoJgU_Hft1GkuIbbMqipGUM6F1jVV0Zs_DR7Tjn0V4GnbvmCYuX2XfD5mNKM5SrfrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGvMCQkewRQhDf6aeYyOm4YaNwWy4-Hy5FgiRF10YbDA&oe=6A620480"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u00f3n final."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_
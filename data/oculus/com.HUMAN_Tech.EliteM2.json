t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jabQoqPiDYMQ7kNvwF75EKN&_nc_oc=AdoLXYdYS1_xGDQ1x07SRSYvPBbL7js_kSHv30hxXaeNSKKOBTZsh-vYbE2vlwKGUCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06G-EW1NpYyzLHluFbNe02BokFzmB9KQ_1pEI9G_qSQg&oe=69E4D72A"}, {"file_name": "56.png", "id": "3192831004188895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5eT5xU9aicQ7kNvwEmhCi_&_nc_oc=Adoien2G-wGFC8n2oeKbwNSvmxeiVvs9RqLHW4Ad__HzJylEOfbuZ1ytfuLI_W0eGL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J1j_5JQqZJZvAsp9OlRbT8l94MsXepmyh3FwgOY_sew&oe=69E4BCC5"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URo55sFDYJsQ7kNvwFi1Ydn&_nc_oc=AdpAtrT7V9-4-eBxHBcUYkZ5OylioM2qidsamgn010IQ5fRGyV8La_F9jRakYOvNZyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DtVhLrB74WXMs0eVWQxaDaPH9ij9rEZNAxwynOsWa4g&oe=69E4D004"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRcyd9r2cREQ7kNvwGBojBn&_nc_oc=AdrTcDipCqGeXr4o91CrW1RE2i7yElvNTUCOnT6QZ1n2Gbv-35N5Tj-XBpTKNAn9c48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fwt0zq5qnwtjfNrNlMfZb3puMAw6guaYQoDkBpbafKA&oe=69E4BCE8"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEdkQ-H6sSgQ7kNvwHAaozT&_nc_oc=AdoTt1qrFFmTkkmGaATAnbjun8oYoD83Oc_qZhqmqNJ5ttRXXZj0WRR7kO73VPanNYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ke_EIlwiiEybkFwc26R98wkauL-CIdaXc0PBULWtDuA&oe=69E4C600"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u
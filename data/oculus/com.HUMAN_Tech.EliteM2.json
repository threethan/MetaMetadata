t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud2zX0uGN1UQ7kNvwFsu94T&_nc_oc=Ado2YsoMbZSJEh6ldiZP6mXupMiElwr4TZfvBv8RSAO1ezWyHSzPLlHcKnHHZz4BuWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3kYgcC_fJXRA2hrpcPXWKrFTKGF5LRSQNErPzW6eJyA&oe=6ABBBBAA"}, {"file_name": "56.png", "id": "3192831004188895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMWJNQ37WF4Q7kNvwE-68ja&_nc_oc=Adp8eE_nvubwgsYpTT22hsdbJoxrix0rnv8HNGqAu8jevsaWVTPeeMVaxECu-_e7ivY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIou74mXP105wjppVyzY_EgfJ-F4s3cRcdEHaSKmiNmjg&oe=6ABBD985"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALRX5btrxqUQ7kNvwED86fT&_nc_oc=Adr0-dj3VWfyoP8hJe_JbrZDeJ3K3X4TTbP28GAQnD4xcVS2IgKjvl5gIj5hZlA1ZKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBQGqfxk4BWB4uW3dgJVJCyXLodMdOL9o6Ly4ZYEcKVw&oe=6ABBB484"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_S40_QXw2EQ7kNvwG5HiO5&_nc_oc=AdoOlP48vak03GJzoHNyn2H7fs0pDFDDRJYFyViXxeWPF19a4UwLxjXkeg49i2tABGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFxy1f0eqm796Ve6scXwKhnQIkY14pU1RSymlax47ZQQ&oe=6ABBD9A8"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvYwTyZLFr8Q7kNvwFgtn1x&_nc_oc=AdpADxEFx_ENYCTZacz25wZpu6nMo36xPmMAHTHHI4W7X7-H5r97D-skdAVr3Krf-xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTt1MBeXpgHWWzOjXGrdLV7XaGB0yJfe76wShTckK4GQ&oe=6ABBE2C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u00f3n final."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7183063251706786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818938_636575942870706_5168055799188781492_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnxoKybfQL0Q7kNvwFY-V4Y&_nc_oc=Adq4HoRXaD3ar-fSYITgTnhwUsqAvNExHUc9SMvK6dcxBiVvZJf3q_hKG4dILsr1sk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR8tPwHBgkkgnKMyK5repzKkF4zYe-FMrT3cytWXRkmw&oe=6ABBBDC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elite M2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1746775200, "lastRevision": {"nodes": [{"id": "7183063261706785", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7183063248373453", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "AN
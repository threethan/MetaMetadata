t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_CVgAvjGM8Q7kNvwEanKCr&_nc_oc=Adqnr_YOKI2lCew_TFg2nqtTGmiW3i17L576r_6zAkDu0MEWSgNHRElEoeNJNIZ6IQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21iPftLVIUKm44WpbDhq5z2PZXpdCbbHKY6Bw5OrbQzQ&oe=69DF912A"}, {"file_name": "56.png", "id": "3192831004188895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-oN-hVJwGEQ7kNvwE3LrGt&_nc_oc=AdoWdG9e9LR07Ep1WmtfxNKO5pw-arWxq5oZCN7vE-GKm0JxKFUk03E_NqnykFBWZ1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MIjL8imEHz4mfyQ4Lr40vJXRWXPaLzJsRrOlI7t6jMA&oe=69DF76C5"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeCjGvTtM_QQ7kNvwHKPZoe&_nc_oc=Adq9CEqEO4qA6E1N4cflHChzo4VvXALF_gNw-hnpHtOo-XTTYSTZgdN-oowmGSMRZfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D9KZqtIgxZ4WboR2wczSZvj2VGT55c4jMXug92HFpBQ&oe=69DF8A04"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo_y1w37rRIQ7kNvwEdz-Gm&_nc_oc=AdpdPt796N2Q4lA7nQQ6U_btlLNuee0fhoaPYOXECEavLXN6k7O3LEk3xwqdoTCPp9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zkS0PFd39G8ND3n-CtClKw4610HCl30DF6-fvvt54mA&oe=69DF76E8"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh8_1WFsJP8Q7kNvwF2ZyR_&_nc_oc=AdrmxEkAzniXFhHqXit9fYrr7x3W2xCAVdxzAeI8uBFr8awQjUwsCcdglr-YYM5eALA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PVcfAQoohM06LR03PBroyYDCu_Nmi3BFqbvkoyA9nkw&oe=69DF8000"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u00f3n final."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7183063251706786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818938_636575942870706_5168055799188781492_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqIeZ_Jqig4Q7kNvwELs0gz&_nc_oc=AdrjS_YQQ5iqd8K-qBK4pepwipbtcS26FqLmLyKjEWfekCPEEE57RtL-cM_J_tHh5-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gSzXbBxzqbh14kwmnyNmdmlY1G7S08yKBYN_n5Yt6Jg&oe=69DF9342"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elite M2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1746775200, "lastRevision": {"nodes": [{"id": "7183063261706785", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7183063248373453", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "AN
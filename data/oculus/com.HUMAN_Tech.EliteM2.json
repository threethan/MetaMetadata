31004188895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UEnAdXXg4cQ7kNvwGQHqDw&_nc_oc=AdpwfQzN6G3pg_oZcjYNUV4tq02L_UvxsOiMOQkLQBRTCouOJhh5fjSxm0aRAyEhLws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17XV-osLbDOgU9kxYKQ0iQyAw3-YW6Yfj4XWocW32vLg&oe=69D39945"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkRZ6D_nX4UQ7kNvwEzARxn&_nc_oc=AdoVX4lILJfySeu2QFmFCyOo-HYHhal7njUmZ79uFw6R452TCnXjQ_0sYGPDJQTeceA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-OXG2uVQw1t75HUj6aP19EuVk8z_9hRf3XIGq_W5NZg&oe=69D3AC84"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5CsxHuwvQkQ7kNvwHFee5R&_nc_oc=AdrKJL8afTIKA8-d6qhVGGi7m9h8oN9AYPVIt4e36KDLWGuI3IL6Rx_cVMIPl8yBN8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fx_H4Uv6duG_8z48VmiU3QD3HlUHcKELKvBDPxRnA4Q&oe=69D39968"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_2R-1O0-mYQ7kNvwGQL03c&_nc_oc=Adq9J_7qX8WqSD8NLdshF3ihyJlWoaiY0x_o84uq_U8BEjrCqHl3k62BYMpeLF-9aJ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hXTGkvK7RE69rk6lZrdxq3ASk6CG3z_7jCGPODKbvrA&oe=69D3A280"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u00f3n final."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_
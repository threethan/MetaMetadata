t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XGZM5GBGqkQ7kNvwGK__zl&_nc_oc=AdrZrg8o8LfuB8G2oqJFOHRoES1t31ZRghscAPUbIesMWBBBgfxXPL9QVJnzQVeXE_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlzqA0yqaM5Ij2DZ8YhCjOLHVlZhpOrE5WneBir1oxzw&oe=6AB5242A"}, {"file_name": "56.png", "id": "3192831004188895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC8wg9f2WYgQ7kNvwFQkgPl&_nc_oc=AdrsF_7wIO4u3wK2iXJSWBWUf5-Vhr1j3njiLBnbVdKLF-lk7V925HgVIwXIQRv_cIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfBztjBBlnvzA0y69sb9SaZk0Wm3BhwUaI4sm327ggfA&oe=6AB54205"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lTSnX-iRhoQ7kNvwF1Y1Gb&_nc_oc=AdqO9zkSdJIoQ7ya-JYar_s-_3HbhF1_EUrd7u6F2OmEbDtUImvRMtq0t-ZKSCHUhgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH19kqSOWYUdjGLNY2L1utTCLD36b3ajmjJKpZu9UuRw&oe=6AB51D04"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_R3Jqpq1soQ7kNvwHikFS2&_nc_oc=AdoNW3_1aw6fH3BPsuviCBSJLnpaN0Ja01Nbhp5NvCi34VcBc2BN5j7jdzgsp3e7ybs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsYaGQuYpkju6z_f3Qe3_eAku2ABzuoeISo3KATKz_5A&oe=6AB54228"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIV8k_7IUagQ7kNvwHFjCw3&_nc_oc=AdpuWaoesa8l7FGa2mmoCCNTaS9SBiGv20KYza2hVW7gytf_-7Bzd-bcu-TiW4gTNUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUFHz4W6d_pAD5Jly_-Lnee-Sg_NBuhggGaDt9B1SFbA&oe=6AB54B40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u
t=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aacK0N9f94Q7kNvwFQbsnH&_nc_oc=AdqcgERDC7ikC8-JzDjJDiOcQI4oiEA5msaYWx5_g1HsdOWMUprvbqKiGXzwk3KPzYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lTtIH6tCk33D2lX13JXDGaQKts8rHecrKGq7IbLgREg&oe=69E77A2A"}, {"file_name": "56.png", "id": "3192831004188895", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825091_3192831010855561_4936191764635040575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5eT5xU9aicQ7kNvwFXbgHa&_nc_oc=Adr5uDPWkR1NZDlQjJliZmC2rO6SlgN712wqIt4mHHgp0kJBtukk415zZj2pO1Rp8JY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eMQA-d1lWUaTL7TO8PZirUc-d4p0ySCcL7QnawlTZwA&oe=69E75FC5"}, {"file_name": "55.png", "id": "653949614301641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818938_653949617634974_6147528582118108916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URo55sFDYJsQ7kNvwFjQ7rx&_nc_oc=Ado2MjtQufXLqxilw7wt1OO64L-XZW5K3c3ewvrYoeLDuThcSw7kH7Z1gqJM1S87eZE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VHawwuw_D_DI2mCQZ23IZPBHsQRUFsVeCwL-dkJfMGQ&oe=69E77304"}, {"file_name": "57.png", "id": "1185328162910619", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819980_1185328166243952_1407589883910908821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4DhAw6p5bkQ7kNvwHlGxaa&_nc_oc=AdqLeodL9JKVFK55yvmahcjZahcG_aAtJRPdoPe43EGvjjp2L9hNq6RxGuq5D6t27zo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eooQc8I5OaNMlb_OstLgIcp-S0yl4jUAIrytjlwt18w&oe=69E75FE8"}, {"file_name": "58.png", "id": "2127176631064606", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830590_2127176634397939_3343901205445722944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51y0Vga2CdkQ7kNvwGpXndG&_nc_oc=AdqiZe-hlCAbcldQPAlDnxyCHjvwvKUG3rVIJdwWkIzZFB62krszx466mOsUnhU3U7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21Jxa6A5A3fFP1Mtf5uRT8v64tzlnOnBf8Tkr8EBYmCw&oe=69E76900"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M2", "keywords": [], "long_description": "Liderazgo, comunicaci\u00f3n y estrategia... todo comienza antes de la presentaci\u00f3n.\n\nEn esta app, no solo deber\u00e1s preparar una exposici\u00f3n impecable para el comit\u00e9 de tu empresa: tambi\u00e9n tendr\u00e1s que enfrentar el verdadero reto previo\u2026 tu equipo.\n\nAsume el rol de l\u00edder o miembro clave de un grupo de trabajo que debe presentar un proyecto ante la alta direcci\u00f3n. El problema: el equipo est\u00e1 fracturado. Malentendidos, diferencias de visi\u00f3n, egos heridos y tensiones acumuladas amenazan con arruinar la presentaci\u00f3n antes de que siquiera empiece.\n\nTu misi\u00f3n ser\u00e1 reconstruir la confianza, facilitar conversaciones dif\u00edciles, tomar decisiones dif\u00edciles y asegurarte de que todos trabajen juntos con un objetivo com\u00fan. La din\u00e1mica se desarrolla a trav\u00e9s de conversaciones interactivas, decisiones morales y estrat\u00e9gicas, y escenarios realistas basados en experiencias laborales reales.\n\nCaracter\u00edsticas principales:\n\n- Di\u00e1logos ramificados y decisiones con impacto.\n\n- Perfiles \u00fanicos de personajes con motivaciones y conflictos diversos.\n\n- M\u00faltiples desenlaces posibles seg\u00fan tus elecciones.\n\n- Ideal para desarrollo de habilidades blandas: liderazgo, negociaci\u00f3n, empat\u00eda y gesti\u00f3n de crisis.\n\n- Perfecto para formaciones corporativas o jugadores interesados en din\u00e1micas sociales.\n\nPrep\u00e1rate, lidera, negocia\u2026 y conquista la sala de juntas.", "short_description": "Tienes que realizar una presentaci\u00f3n muy importante ante el comit\u00e9 directivo pero antes deber\u00e1s colaborar con tu equipo para resolver tensiones internas, malentendidos y conflictos interpersonales. Cada decisi\u00f3n cuenta: tus habilidades de comunicaci\u00f3n, liderazgo y empat\u00eda determinar\u00e1n el \u00e9xito de la reuni\u
332", "release_date": 1783930500, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1045778358393083"}, "id": "972619389105485"}]}}, "binary": null, "live_binary": null, "created_date": 1785936841, "id": "1075501815420737", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1055464810757771"}, "release_status": "RELEASED", "id": "1038072535830332"}, "id": "1055464810757771", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "PENDING", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310817_1726656131851650_7232688671893688893_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWN4a8kk6ekQ7kNvwEcV91c&_nc_oc=AdrFAs8WLIkx3ZZ9DxwblxbPJ5QyFPGtaWQX9k6NicD--WbaG83CirypWcnLfNah4Bc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0wGj5VNtPM6i7FYA_f0SsMupN7sEHShyF3sr50R32FQ&oe=6A80628F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HoloMoves: Package Panic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1783930500, "lastRevision": {"nodes": [{"id": "1038072549163664", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1038072535830332", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1926050191400444"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4327463220875914", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: Package Panic", "keywords": [], "long_description": "PackagePanic is een mixed-reality exergame die is ontworpen om schouderbewegingen en krachtuithoudingsvermogen te stimuleren in een speelse en toegankelijke omgeving. In een visueel sorteercentrum worden spelers uitgenodigd om pakketjes met symbolen op te pakken en te sorteren, wat zorgt voor een grote variatie aan therapeutisch relevante bewegingen.\nDe game bevat twee levels die aansluiten bij verschillende fasen van de revalidatie:\nLaag level: Speciaal voor revalidanten met een bewegingsrestrictie. In dit level worden bewegingen boven de 90 graden abductie vermeden. Spelers leggen pakketjes met een specifiek symbool op de lopende band en sturen ze naar de band met hetzelfde symbool.\nHoog level: Richt zich op het opzoeken van de maximale mobiliteit door hoge reikbewegingen uit te lokken. Spelers sorteren pakketjes in het matchende compartiment en sturen deze vervolgens op.\nHet doel van het spel is om zoveel mogelijk pakketjes binnen de tijd te sorteren en te verzenden. De ervaring kan eenvoudig zittend worden gespeeld, zodat gebruikers op een passend niveau kunnen deelnemen. PackagePanic is ontwikkeld in samenwerking met zorgprofessionals en is bedoeld voor gebruik binnen begeleide oefen- of zorgcontexten, zoals onder toezicht van een therapeut. Het is een ondersteunend hulpmiddel binnen een breder revalidatieprogramma.\n", "short_description": "PackagePanic is een mixed-reality exergame die schouderrevalidanten stimuleert om schoudermobiliteit en krachtuithoudingsvermogen te trainen met veel bewegingsvariatie waarin de romp ook wordt aangesproken. In een virtueel sorteercentrum pakken spelers pakketjes met symbolen op en sorteren deze, wat ook zittend mogelijk is. Ontworpen ter ondersteuning van interventies binnen begeleide zorg- en revalidatiesituaties.\n"}, {"images": {"nodes": [{"file_name": "PackagePanicCoverArtSquare.png", "id": "1726656128518317", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310817_1726656131851650_7232688671893688893_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWN4a8kk6ekQ7kNvwEcV91c&_nc_oc=AdrFAs8WLIkx3ZZ9DxwblxbPJ5QyFPGtaWQX9k6NicD--WbaG83CirypWcnLfNah4Bc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0f131dAVNIPKTR2NAOKpyyj8_WV7bJWjlpuenejnuGA&oe=6A80628F"}, {"file_name": "PackagePanic_icon_meta (2).png", "id": "1716411186216953", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304952_1716411189550286_3983758020634961508_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGY23bLoIN4Q7kNvwGsexuV&_nc_oc=AdrnoKO755PUcDxTOYp7Aq5NaHaGyHz02xr3QCxjmtwovd91x7_BcCVaHzme0vntVs4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo7L4Z-TOfevW4CsWnskuy2JGZXBzPeNUcK8199wp-QQ&oe=6A806840"}, {"file_name": "Portrait CoverArtPackagePanic.png", "id": "1528872592016216", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_1528872595349549_7115519770386982104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmhicFpRrfIQ7kNvwECzO-F&_nc_oc=AdrYQmYTkr1stEw7MESAETwAbvuTMRSTaxiv5WTC6uSv_Mm3QFiO-zDKoa8dhDku4gc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4keex-KfBzMoNvhhs-sZkJuyVslm8E7n9bsmo_eBBVA&oe=6A804D9E"}, {"file_name": "Landscape CoverArt PackagePanic .png", "id": "1323511856580387", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_1323511859913720_6367584695099555258_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KX4hUJackgQ7kNvwF0K8HP&_nc_oc=AdrkvBaL5wK0dOvZgU1MkjjaNJbbE4hWLFyxo07mdZk8Bx_vG2vX0fWMQEQJrB80yG4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY6NkFQqK4-Ee5e9NG5lo__ioy2zR8p3dD4PSBy7MGmw&oe=6A804CA8"}, {"file_name": "PackagePanic CoverArt Hero (1).png", "id": "1307029001415622", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507829686_1307029004748955_4600502309188043074_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKWb8U8OrDoQ7kNvwGCHS1j&_nc_oc=AdpnHPg3ExJIk8IDPxgEu2MYGoHbnsNw80p-a6YubBGfhybbPi5oarRHIFSo26JgV-s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkxQ30ltxTo6iBDx7qXXTuA_uhkeMqWKxsUfneIX4_mw&oe=6A80677F"}]}, "id": "1562147948841574", "locale": "en_US", "screenshots": [{"file_name": "mainMenu.png", "id": "1048238711219635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593761155_1048238714552968_9130850587839967253_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlZwSL3R-VMQ7kNvwFvMJb9&_nc_oc=AdrC63uPy-X9XbtZex8QtXxYX7hFi6zcvZH4BstT7C6_3rF2bHZ1_6WPy0D04mvGPtI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT49YkFEuLbnQYZmDbNoAnEfn9Jc-JpCbIeG3p1lFgcw&oe=6A805346"}, {"file_name": "hoog_boxes.png", "id": "1583202713174863", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/585720338_1583202716508196_5779086559950283760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYQ0HSA7rHAQ7kNvwEtlaSj&_nc_oc=AdrAaDZW9pWtF3vK9V1zzkBTgY2vzfXHZkjXZ8aN6CJYi4LuiJ-Js9aVsa6bPur8KqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP_TszCZkmsgo7Sn6vKRl0Chl4FIEsQKhgFjaBiJapxA&oe=6A8071C0"}, {"file_name": "hoog_full.png", "id": "1904964913526694", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_1904964920193360_5507676904572305542_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwME7uhNEBUQ7kNvwG8Za-s&_nc_oc=AdpxATMpb9xwoY5VByN3KFEuIkwfkhfoJLy0RiK3O2ii0MGb3dvxw-P6lnqXtv9FtGc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMrz2ARPpSQTxSm6KMOp2c1TkbjsFlPgthaN2GcJEwDg&oe=6A805BA7"}, {"file_name": "hoog_fullSide.png", "id": "1535829194602199", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824671_1535829201268865_864463026887219069_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4UJ0JH6L4oQ7kNvwGJsfTW&_nc_oc=Adr55H53G-UYtLJ5efkr02kD9rrKvz5hqhVZKlyEDu7RvWzZmlx3cf3yQg1EAHeuOGg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfCzejrBV9UqSTPWw46Zvues2EUbKuxWX-uAIw3XTEgw&oe=6A80470F"}, {"file_name": "laag_boxes.png", "id": "1512251410447735", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499315353_1512251413781068_9216900174359089057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl_foFSYIlkQ7kNvwH9MPUQ&_nc_oc=AdqGX2Q8cVPeyM3eLxhCcLzzuxtSoIasPne7ptAX4vDvW4WOAouVjGjk-W00-t_Yt-0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEETpQr7OMo5oBsWv-02mUuQQWP2Pycki-x19cmwS478w&oe=6A807353"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: Package Panic", "keywords": [], "long_description": "PackagePanic is a mixed-reality exergame designed to playfully support shoulder rehabilitation by improving shoulder mobility and strength endurance in a playful and motivating environment. In a visual sorting center, players are invited to pick up and sort packages with symbols, providing a wide variety of therapeutically relevant movements.\nThe game features two distinct levels tailored to different rehabilitation stages:\nLow Level (under 90\u00b0): Designed for patients with a movement restriction. All movements are kept below 90 degrees of abduction. Players place packages with a specific symbol onto the conveyor belt and send them to the belt with the matching symbol.\nHigh Level (full range): Focuses on high reaching movements to challenge and maximize shoulder mobility. Players sort packages into matching compartments and send them off.\nThe goal of the game is to sort and dispatch as many packages as possible within the time limit. The experience can easily be played while seated, allowing users to participate at an appropriate level. PackagePanic was developed in collaboration with healthcare professionals and is intended for use within guided exercise or care contexts, such as under the supervision of a therapist. It serves as a supportive tool within a broader rehabilitation program.\n", "short_description": "PackagePanic is a mixed-reality exergame designed to playfully support shoulder rehabilitation by improving shoulder mobility and strength endurance through varied movements that also engage the core. In a dynamic sorting environment, players pick up and sort packages, adapting easily to both sitting and standing positions. Designed for use in guided care and rehabilitation settings.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://holomoves.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1038072539163665"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1043809888164365"}, {"status": "PUBLISHED", "id": "1753030882803622"}]}, "baseline_offer": {"id": "1043809888164365"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783933800, "status": "PUBLISHED", "id": "1043809888164365"}]}, "liveChannel": {"nodes": [{"latest_supported_bi
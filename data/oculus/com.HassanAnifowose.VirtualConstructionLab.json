-akw8Rzz3KDWO1jqdDoMahafVBAx426NQWN0Oji-QNjU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqCYs4pVmVxMv3IktmqWJ3GpwXtxwy1wwW-dHkoCG8XA&oe=6B09AC0C"}, "display_name": "VR Construction Lab", "keywords": ["construction", "education", "vr", "lab", "game"], "long_description": "Go outside the classroom and get on a job site. Test your memory and matching skills. Get rewards and unlock new levels of difficulty when you assemble components correctly. Complete the assembly in record time and post your scores. Fun for anyone who is curious about construction assembly details. Full body motion, climb ladders, immersive audio, visual reward systems, embedded video instructions and more.\n\n", "short_description": "Go outside the classroom and get on a job site. Fun Construction VR game where anyone can learn and build different walls with varying levels of difficulty. "}]}, "developer_name": "ChronosHQ", "developer_privacy_policy_url": "https://hassananifowose.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ChronosHQ", "support_website_url": null, "website_url": "http://chronoshq.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8719574021429600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974824_894001615290430_8484006963622867032_n.png?s
nc_ohc=zSh6AYpMTqcQ7kNvwFaezVO&_nc_oc=AdqZoRZXmMlElttM74MWWAwDWUK3ymS_60H0JKbvIDD8zWnZcuY53zmUw8NxvzrIE8Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtmzdkKqg5AyDpB_XaDA11uq4mNopNtTnD8cmUif8ygw&oe=6AC50C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nBkpgx", "id": "379264256029288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974815_379264259362621_357678348060590080_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJuoCxPe8xkQ7kNvwF41aXM&_nc_oc=AdpCFUOpTX3_sQetTQGqdpBnVa3UVuyeQwBBBUKAAtn61re2Sgvo8Sr6zmkWk5Bqgb0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4efAxrRbn-uIiN4E3X3CEvdX3N_dC82EkYHpSk_EdeA&oe=6AC5210B"}, "display_name": "Metro VR - FPS Shooter", "keywords": ["fps", "shooter", "metro", "shot", "arcade"], "long_description": "Metro VR will be an oldschool arcade Rail First Person Shooter game. With its all gameplay mechanics and general style, our game will refer to the genre\u2019s classics like House of the Dead or Time Crisis series. In our production we will use virtual reality headsets and their motion controllers to reach the best possible value of fun, which this genre provided years ago with the light guns, and now is reborning thanks to VR technology.\n\n\nMetro VR will be set in the futuristic neo-cyberpunk world, where citizens of the N-One-City are terrorized by the AI controlled combat robots gang. Player will play as the underground secret cops forces member, who have been assigned to fight with the cybernetic crime.", "short_description": "You are in an abandoned metro station taken over by robots. Fight! Take new weapons! Stay alive till the end!\n\nDo you like to shoot? Shoot this mechanical scrap!"}]}, "developer_name": "EPICVR.pl", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://epicvr.pl/pl/metro-vr-fps-shooter-vr-game/", "publisher_name": "EPICVR.pl", "support_website_url": "https://epicvr.pl/pl/metro-vr-fps-shooter-vr-game/", "website_url": "https://epicvr.pl/pl/metro-vr-fps-shooter-vr-game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4669414656508738"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "359269824781613"}, {"status": "PUBLISHED", "id": "450265665580387"}, {"status": "PUBLISHED", "id": "871004813261148"}]}, "baseline_offer": {"id": "359269824781613"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1561568400, "status": "PUBLISHED", "id": "359269824781613"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2342173015862092", "version": "2019.07.11"}, "id": "356622405041141", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2278028978943163", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2342173015862092"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "356622405041141"}]}, "change_log": "We've added compatibility with Gear VR. Now the app works on both Oculus Go and Gear VR.\nPlease check if everything is correct before replacing the app in the store, as we are already selling app for Oculus Go goggles.", "created_date": 1562872859, "id": "2342173015862092", "version": "2019.07.11", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2278028978943163", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2342173015862092"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "356622405041141"}]}, "change_log": null, "created_date": 1560335204, "id": "2289936597752401", "version": "2019.06.12", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2278028978943163", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2342173015862092"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "356622405041141"}]}, "change_log": "1. We deleted additional titles on Store Cover Art. Now in store cover art we have only game title.\n2. We solved VRC.Mobile.Functional.1 bugs.", "created_date": 1560187851, "id": "2287081111371283", "version": "2019.06.10", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2278028978943163", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2342173015862092"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "356622405041141"}]}, "change_log": "We changed:\n\n\nVRC.Mobile.Asset.2\n\nStore cover art images must have a clear logo without extraneous text, taglines, or banners.\n\n\nVRC.Mobile.Input.3\n\nWhen the user presses the back button, the app must either go back one level in your UI or display a menu with an option to quit the app.\nPressing the Back button doesn't go back one level in the menu UI hierarchy, nor does it display a menu with an option to quit the app.\n\nt\nOverview\nResult\nCompatibility Tests\n\nOculus Go\n\n\nThis app includes x86 libraries. These are unnecessary and take up space. The following x86 libraries should be removed: libunity.so, libmonobdwgc-2.0.so, libmain.so, libMonoPosixHelper.so. In the future, this will cause the app to be rejected.\n\n\n\n\n\n\nTest\nOverview\nResult\nCorrectness Test\n\nOculus Go\n\n\nThe package does not implement the entitlement check. Please follow the instructions in the Oculus Developer Documentation at https://developer.oculus.com/documentation/platform/latest/concepts/pgsg-unity-gsg/", "created_date": 1559930454, "id": "2282105771868817", "version": "2019.06.07", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2278028978943163", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2342173015862092"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "356622405041141"}]}, "change_log": null, "created_date": 1559726325, "id": "2278132132266181", "version": "2019.06.05", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
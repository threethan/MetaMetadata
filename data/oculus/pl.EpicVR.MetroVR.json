1-7&_nc_sid=6e7a0a&_nc_ohc=L4dqJgBynEYQ7kNvwH4PiBk&_nc_oc=AdpRJm_vacQ1gRkSQjm9PPOyTO_BTkWNeYRLX35pOe1r3v_E0MsAGumcxIw61lQvI7A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hRBa1FBHmq7GN7XTQJ8MDLiAxt_tAaAf2jmA_7DQiWQ&oe=6A394D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nBkpgx", "id": "379264256029288", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974815_379264259362621_357678348060590080_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOOVhJ6VQ1EQ7kNvwGnaa5e&_nc_oc=Ado01Err-LJgN0sPUJG1JWPej0bwvsjkZrj7WlmnD9MJ_mWbhTVTOMNoMGP0h6LtZWM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HN2uOdjqfSkgBGmv1lZ2PEo_Z7yoIJ83GBmQS6ZWJdw&oe=6A39620B"}, "display_name": "Metro VR - FPS Shooter", "keywords": ["fps", "shooter", "metro", "shot", "arcade"], "long_description": "Metro VR will be an oldschool arcade Rail First Person Shooter game. With its all gameplay mechanics and general style, our game will refer to the genre\u2019s classics like House of the Dead or Time Crisis series. In our production we will use virtual reality headsets and their motion controllers to reach the best possible value of fun, which this genre provided years ago with the light guns, and now is reborning thanks to VR technology.\n\n\nMetro VR will be set in the futuristic neo-cyberpunk world, where citizens of the N-One-City are terrorized by the AI controlled combat robots gang. Player will play as the underground secret cops forces member, who have been assigned to fight with the cybernetic crime.", "short_description": "You are in an abandoned metro station taken over by robots. Fight! Take new weapons! Stay alive till the end!\n\nDo you like to shoot? Shoot this mechanical scrap!"}]}, "developer_name": "EPICVR.pl", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://epicvr.pl/pl/metro-vr-fps-shooter-vr-game/", "publisher_name": "EPICVR.pl", "support_website_url": "https://epicvr.
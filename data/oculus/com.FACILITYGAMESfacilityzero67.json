name": "499617847_747902328392979_5259839679722794584_n.png", "id": "1544902660711629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1544902664044962_6017200418908110065_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Jmi5nkgAWoQ7kNvwFyQVKd&_nc_oc=AdrFRqes6vDBuCw-wp6YPS6ChDDRtVRn5-M-5SKjDoRdVFhFnapW9rqibQC__3yuxRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2irkeh9XPFsIDKle-gWHDUd0EWvRDzOxt6KTelRinnw&oe=6AAFED26"}, {"file_name": "499298291_1378519817350251_302441501491262461_n.png", "id": "1910533376481412", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_1910533379814745_8507906783593671475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSSyrZy4yZEQ7kNvwFCWArV&_nc_oc=AdpiPyiT7M8061NFmbihHudI_ym7xA5pXxl0-vqxe5QIsHWO7LxkxwsB9GlEOi2oUVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGlvBsbS3ljIva8PPaAgmgy9Hvrep8dJzqDh6hQzzveg&oe=6AAFEDAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Zero", "keywords": [], "long_description": "Facility Zero is a social multiplayer experience built around community, creativity, and smooth VR interaction. Players can explore different areas, meet new people, and enjoy a relaxed environment designed for hanging out, talking, and having fun. The game focuses on simple, intuitive movement and clean visuals so anyone can jump in and feel comfortable right away.\n\nWhether you\u2019re joining friends, meeting new players, or just looking for a place to chill, Facility Zero gives you a space to express yourself and be part of an active, growing community. New updates, features, and improvements are added regularly, keeping the experience fresh and giving players more ways to interact.\n\nFacility Zero is built for players who want a safe, friendly, and welcoming environment. Moderation tools, clear rules, and community\u2011driven feedback help keep the game positive and enjoyable for everyone. No matter how you play \u2014 exploring, chatting, creating content, or just vibing \u2014 there\u2019s always something to do and someone to meet.\n", "short_description": "Facility Zero is a multiplayer social game where players explore, hang out, and interact in a clean, simple environment built for fun and community. Whether you\u2019re joining friends, meeting new people, or just relaxing, the game focuses on smooth gameplay, easy controls, and a welcoming space for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/facilityzeroprivacypolicy/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Facility Studios", "support_website_url": null, "website_url": "https://discord.gg/dfeqV8cF", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1219370937924017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1400219282154451_2283349537766588843_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNeKIcks0h4Q7kNvwFu7QAP&_nc_oc=AdoM2nQCXHk8ZrD5k2J8wbhWLrls7gXwKu5J0XBxM9HMiGvKz6G2j3HfP9aoLEetgEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ7TbOwnYvAULdauLbj-rpcRbIGcznZkx-mfhOWjTDaw&oe=6AAFE221"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
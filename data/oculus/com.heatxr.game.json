135_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO4KCXOqyTEQ7kNvwELmcYx&_nc_oc=AdoOg5EFx2gjKWS94QIWm5I7RaGHtIIidmqvjj2nOLrSxRPzXGzZ95lS3cIHmAo2wnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTfA6x6yvSTCBWjWPaxkA_XDMWEMrqo28g_n11lXjVIA&oe=6AE616D7"}, {"file_name": "3_pov_glacier_duck.png", "id": "1101003589452156", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1101003592785489_7934895282668503595_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viI5X0vacNQQ7kNvwHKs7xB&_nc_oc=AdqcTD1RG6rhXjKw5XLZ1B9vZg0_imPz3uXfYB2LvfSj0VTpZsHL7FK5HNTlO6tu_Nc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAX3rf33xLTq9dRRfx-QRLrbYPTQkpa9oSkdAWcKD02w&oe=6AE5F6B0"}, {"file_name": "4_pov_lane_double.png", "id": "1609142187512989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593714175_1609142190846322_3455532127574096914_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okPcmwqGO20Q7kNvwGzpIje&_nc_oc=Adp8mXjlZSFmW8Du1qlbav_PmVXNot0Ztk7HMfk3trUtSVkYx_icD2R9xlkPIz7hEOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoDatZkODedzm9wsppipGFySvz5pD0tfpFKhHGPzvfjQ&oe=6AE5FC63"}, {"file_name": "5_menu.png", "id": "1775986336672912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1775986340006245_2739520621366716411_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnuJx0pwdlYQ7kNvwG0Q9jy&_nc_oc=AdrSAJJq_jwYW6DfsQQdibWEDe-riWJNC39IfPE38QQS4U597huN-YF0BnoIhwwto0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN88V1tqQ_GMz9NkB3V2bhLUyt1QvLE7Ce05_At5759Yw&oe=6AE5E86D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeatXR", "keywords": ["boxing", "fitness", "workout", "rhythm", "cardio"], "long_description": "YOUR WORKOUT, NEVER THE SAME TWICE\nHeatXR builds every session new, matched to the beat, the phrases and the build-ups of the music, so you never memorize a routine and never run out of content.\n\nYOUR MUSIC\nCopy your own songs to the headset (MP3, M4A, AAC, FLAC, OGG, Opus or WAV) and HeatXR builds a workout around each one. Streaming services aren't supported. No songs? Beat-only workouts play on their own.\n\nREAL BOXING, FULL BODY\nJabs, crosses, hooks, uppercuts, elbows and doubles. Duck, slip and weave under the blades and squat on the beat. Switch between orthodox and southpaw as you go.\n\nFEEL EVERY HIT\nLayered impacts with sound, light and haptics. Overcharged targets discharge when you hit them hard, and your robotic gloves power up when you make a fist.\n\nSEVEN WORKOUTS\nFull Body, Boxing, HIIT, Upper Body, Lower Body, Core and Flow, at Light, Medium or Intense, for 5 to 30 minutes.\n\nTWO COACHES\nCole and Jade have your back: they count you in, teach new moves and push you through the last round. Chatty, normal or off.\n\nNINE REAL-WORLD SCENES\nSnowy forests, mountains, sea cliffs, sunset beaches and open meadows, all in true 3D.\n\nTRACK YOUR PROGRESS\nCalories estimated from your movement, accuracy, perfect hits and streaks, and saved workouts you can replay round for round.\n\nPAY ONCE. NO SUBSCRIPTION.\nNo account and no internet connection needed. Everything stays on your headset.", "short_description": "Box to the beat in real 3D worlds. HeatXR builds a new workout every session, timed to the beat of your own songs or played with no music at all. Jab, cross, hook, uppercut and throw elbows as targets fly in on the beat, then duck, slip and weave under the blades. Coaches Cole and Jade count you in, teach new moves and push you through. Seven workouts, three intensities, 5 to 30 minutes, nine real-world scenes, calories and progress tracked. No account needed. Pay once, no subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://heatxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "HeatXR Studios", "support_website_url": "https://heatxr.com/support", "website_url": "https://heatxr.com/", "category": null,
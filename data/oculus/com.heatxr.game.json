g", "id": "1091193763646363", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1091193770313029_8144588799220705005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6nZywl9qRkQ7kNvwFzebO7&_nc_oc=Adq8T-Z3jJzdutmIXa8J0_gpu7SA7g2YbEBpMLy66gFx4w04MPd5vLlTb8fkGRXwX9c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJItpDHWE7yQ_8GjEiCZkeSQi0KTuLVIF-ArFGn7Qicw&oe=6AFB4B84"}, {"file_name": "2_pov_rain_straight.png", "id": "1099970956217676", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624395_1099970959551009_3359577349931817135_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VBHTrzAEE4Q7kNvwEEBpAS&_nc_oc=Adpp_bbzsqeEZ9kGl9THGtzoAUHnOQwAAj6vlhVKcE-bn4Gz2x3p2CjiaJQ7SrBWgIE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtTnrm30OsSTLwdYoPaklz3kOY0vZ_2mDzWSoK9xnuuA&oe=6AFB2ED7"}, {"file_name": "3_pov_glacier_duck.png", "id": "1101003589452156", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823901_1101003592785489_7934895282668503595_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIIOVaAkIpAQ7kNvwGB9wPu&_nc_oc=Ado_fSQwFfu6vipjhBhQ__60LhVqaRdgE8lV8zhkMlVXvszj1J7mZt4OjDcAtaspqZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv8OSI07ssh7_vQo7CaQlICNNH_jjkVXWswsOnLHMr3Q&oe=6AFB46F0"}, {"file_name": "4_pov_lane_double.png", "id": "1609142187512989", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593714175_1609142190846322_3455532127574096914_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP83Rd4HFeoQ7kNvwG-I1Le&_nc_oc=AdpYFwwuaovRN8Ka4L85rnLZFCkGjc7ddbolFuPj9k1p6OEZuQMlLBHR3OVPGcJxmNM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVLgF_O43VUG5_2GGCLQr7hv80ZZ_nFB4Ehv_2YB1mjA&oe=6AFB4CA3"}, {"file_name": "5_menu.png", "id": "1775986336672912", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619059_1775986340006245_2739520621366716411_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp2RH242bQsQ7kNvwGbZ2CD&_nc_oc=AdpUuUuJBAws_2LIqiAdIkZKmUvkRwSsOIWMdc5nszC0ZBuyY3W-75kgxjEhxwMeVNo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMaqUbI0ItxTzJvciP279lohwYwnQCUI_oR4QVkpHjNg&oe=6AFB38AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HeatXR", "keywords": ["boxing", "fitness", "workout", "rhythm", "cardio"], "long_description": "YOUR WORKOUT, NEVER THE SAME TWICE\nHeatXR builds every session new, matched to the beat, the phrases and the build-ups of the music, so you never memorize a routine and never run out of content.\n\nYOUR MUSIC\nCopy your own songs to the headset (MP3, M4A, AAC, FLAC, OGG, Opus or WAV) and HeatXR builds a workout around each one. Streaming services aren't supported. No songs? Beat-only workouts play on their own.\n\nREAL BOXING, FULL BODY\nJabs, crosses, hooks, uppercuts, elbows and doubles. Duck, slip and weave under the blades and squat on the beat. Switch between orthodox and southpaw as you go.\n\nFEEL EVERY HIT\nLayered impacts with sound, light and haptics. Overcharged targets discharge when you hit them hard, and your robotic gloves power up when you make a fist.\n\nSEVEN WORKOUTS\nFull Body, Boxing, HIIT, Upper Body, Lower Body, Core and Flow, at Light, Medium or Intense, for 5 to 30 minutes.\n\nTWO COACHES\nCole and Jade have your back: they count you in, teach new moves and push you through the last round. Chatty, normal or off.\n\nNINE REAL-WORLD SCENES\nSnowy forests, mountains, sea cliffs, sunset beaches and open meadows, all in true 3D.\n\nTRACK YOUR PROGRESS\nCalories estimated from your movement, accuracy, perfect hits and streaks, and saved workouts you can replay round for round.\n\nPAY ONCE. NO SUBSCRIPTION.\nNo account and no internet connection needed. Everything stays on your headset.", "short_description": "Box to the beat in real 3D worlds. HeatXR builds a new workout every session, timed to the beat of your own songs or played with no music at all. Jab, cross, hook, uppercut and throw elbows as targets fly in on the beat, then duck, slip and weave under the blades. Coaches Cole and Jade count you in, teach new moves and push you through. Seven workouts, three intensities, 5 to 30 minutes, nine real-world scenes, calories and progress tracked. No account needed. Pay once, no subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://heatxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "HeatXR Studios", "support_website_url": "https://heatxr.com/support", "website_url": "https://heatxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1305104909362181"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4544655625810134"}, {"status": "PUBLISHED", "id": "2250005365779044"}]}, "baseline_offer": {"id": "2250005365779044"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "4544655625810134"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1356587057547299", "version": "1.0.1"}, "id": "1776948726850028", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
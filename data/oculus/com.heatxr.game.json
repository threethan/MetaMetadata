ontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoDatZkODedzm9wsppipGFySvz5pD0tfpFKhHGPzvfjQ&oe=6AE5FC63"}, {"file_name": "5_menu.png", "id": "1775986336672912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1775986340006245_2739520621366716411_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnuJx0pwdlYQ7kNvwG0Q9jy&_nc_oc=AdrSAJJq_jwYW6DfsQQdibWEDe-riWJNC39IfPE38QQS4U597huN-YF0BnoIhwwto0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN88V1tqQ_GMz9NkB3V2bhLUyt1QvLE7Ce05_At5759Yw&oe=6AE5E86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeatXR_trailer_cover_2560x1440.png", "id": "4452977968274780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_4452977971608113_7242965164107465381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMnrQzFLyXEQ7kNvwEBE9LQ&_nc_oc=Adrucw_zZxI9B1tcn3a1AsVLmsrHpDJVhHpQRH8EpBCp_NRTxPbP5JLVvKHrNg9KjzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX247Qtwppohc5Lf8bb3VfY3LyPL0DHCd9u2Xj0vj_Lw&oe=6AE60ACD"}, "display_name": "HeatXR: Boxing, Fitness, Cardio Workout", "keywords": ["exercise", "rhythm", "HIIT", "punch", "sports"], "long_description": "BOXING WORKOUT, NEVER THE SAME TWICE\nHeatXR builds every session new, matched to the beat, the phrases and the build-ups, so you never memorize a routine and never run out of workouts.\n\nFULL-BODY FITNESS\nJab, cross, hook, uppercut, elbows and doubles for your upper body. Duck, slip, weave and squat on the beat for your legs and core. Switch between orthodox and southpaw as you go.\n\nCARDIO AND HIIT\nSeven workouts: Full Body, Boxing, HIIT, Upper Body, Lower Body, Core and Flow. Light, Medium or Intense, for 5 to 30 minutes. HIIT works hard on the high parts and recovers on the calm ones.\n\nYOUR OWN SONGS\nCopy your songs to the headset (MP3, M4A, AAC, FLAC, OGG, Opus or WAV) and HeatXR builds a workout around each one. Streaming services aren't supported. No songs? Beat-only workouts play on their own.\n\nFEEL EVERY PUNCH\nLayered impacts with sound, light and haptics. Overcharged targets discharge when you hit them hard, and your gloves power up when you make a fist.\n\nTWO COACHES\nCole and Jade count you in, teach new moves and push you through the last round. Chatty, normal or off.\n\nNINE REAL-WORLD SCENES\nSnowy forests, mountains, sea cliffs, sunset beaches and open meadows, all in true 3D.\n\nTRACK YOUR PROGRESS\nCalories estimated from your movement, accuracy, perfect hits and streaks, and saved workouts you can replay round for round.\n\nPAY ONCE. NO SUBSCRIPTION.\nNo account and no internet connection needed. Everything stays on your headset.", "short_description": "A boxing workout to the beat, in real 3D worlds. Punch targets as they fly in (jab, cross, hook, uppercut, elbows), then duck, slip and weave under the blades for full-body cardio. Every session is a new workout, timed to your own songs or to the beat alone. Boxing, HIIT, Core and four more workouts, Light to Intense, 5 to 30 minutes. Coaches Cole and Jade count you in and push you through. Calories and progress tracked. No account needed. Pay once, no subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://heatxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "HeatXR Studios", "support_website_url": "https://heatxr.com/support", "website_url": "https://heatxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "support
&_nc_oc=AdplJgaFqHzhIBetGtaZ1HShYwD0LrqmEcME8m6Jgt1CHGKzvW8fIvacMonQ-e_vF70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20FxUv2M2-tRd8o4uEeGlI8xwLzWh-7nxE-JYg-9ovjQ&oe=69E4CC44"}, {"file_name": "12.png", "id": "959209742742285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820407_959209746075618_7289227509150126927_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z0dCHvP4J0Q7kNvwGFiPko&_nc_oc=AdpBxukGNd8fPDxdcGHTC8q6CSRu-fmwyOnWCEThrXNKBspEcFoi5T7B9a8QnsNDesk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CFB83PsEUeCyoczi5O6QMwH2_Hb79t8OZe5WRQSFm8w&oe=69E4CD82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bg1 copy.png", "id": "965097366181827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_965097369515160_2290310820538508919_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o334SmLJLfkQ7kNvwGUSK81&_nc_oc=Adqr7zJ-ad_2uMGXJpZsfQFwQ8Gt00kizbbLy0dsIc0q2rBHl5ghbuoeiBP3Hi82TH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hamRzWZDPhUdYdzCURnOyXxSU8ucKFfyZIUaV4-Uc5w&oe=69E4B7DC"}, "display_name": "Reach The Clouds", "keywords": ["eyetracking", "climbing", "demo", "free", "gaze"], "long_description": "Climb a living tree all the way to the clouds. Throw magical seeds, look at the exact spot where you want branches to grow, and shape nature itself with your eyes. Dodge hazards, react to unexpected events, and collect special fruits that alter how your seeds behave.\n\nThis experience blends immersive physical climbing with innovative gaze-based interaction, creating a unique connection between player and environment.\n\nFEATURES\n- Gaze-based branch creation powered by eye-tracking\n- Immersive physical climbing mechanics\n- Magical seeds with unique growth effects\n- Dynamic environmental hazards (breaking branches, small dragons)\n- Special fruit pickups that modify gameplay behavior\n\n\nWHAT DOES THE PROJECT INCLUDE?\n- One immersive vertical level\n- Two types of magical seeds\n- One fruit type that alters seed behavior\n\n\nThe demo showcases the core mechanics of gaze-controlled growth and physical VR climbing, offering a glimpse into a new way of interacting with virtual worlds - through sight, movement, and discovery.\n\n{1447198153454042}\n{902661155815742}", "short_description": "META QUEST PRO EXCLUSIVE\n\nA VR experience showcasing the potential of eye-tracking technology as a core gameplay mechanic. The game tracks your gaze in real time, demonstrating how eye-tracking can enhance immersion and potentially support real-life eye training, including therapeutic applications.\n\nReach the Clouds is a VR climbing adventure where you grow your own path using the power of your gaze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://carbonstudio.pl/wp-content/uploads/2025/04/Reach-the-Clouds-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Carbon Studio", "support_website_url": null, "website_url": "https://carbonstudio.pl/reach-the-clouds/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25664586939909074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393158_979760974265815_2604546414998995281_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-
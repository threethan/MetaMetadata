nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ydyq4ZYvmT1i8hT_j0DjjV7b1h9X8FDBKvTMBPM5E4Q&oe=6A0467EA"}, {"file_name": "2560x1440-screenshot.png", "id": "1157306802904561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824012_1157306806237894_4903733983941798751_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKKHXcA9B_wQ7kNvwHS12Jd&_nc_oc=Adpcor8mZzuyNZNE7KgogdS3PJTONVRrhaSG1hLK3btmnKuU1-WZc_SPG_QYcwAFTyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SaTE3CiXclL2KYbWnD92v54lAezoLyoAshDKHFLetZQ&oe=6A048B6F"}, {"file_name": "2560x1440-screenshot (2).png", "id": "1270937877850787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819980_1270937881184120_4779472473346430237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpqUMmAz1aQQ7kNvwE2AVG4&_nc_oc=AdpQNUUjS7ZrGH7aZDanU3p78eswZSco4jJQrCbTbqMTbGpIgd_-4X3t4psYPkOMZDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RCLIlwVshVX8k_mvvxCAvyIYtrU3SQKAsHSTOkZEo1Q&oe=6A0469FC"}, {"file_name": "2560x1440-screenshot (1).png", "id": "1252698876127119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822897_1252698879460452_5395329702246090549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woXU7cfW96MQ7kNvwEZx4EJ&_nc_oc=Ado2_cHatIOuM1ULSmu0HumlfxStsf_Uz8yHqU5b5RO7dEr8JRKZfM83h2TzpUT2KVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t4XAL4F3yKh1cWrtfc4m9_pJeDDPxG_epTBVH8wdLGw&oe=6A04658B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 2.png", "id": "1276006763971855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1276006767305188_6222745737269963335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjcyIRobWS4Q7kNvwGDvAEA&_nc_oc=AdqSHQHw6dtahGBu9a_vB2ucCwPo3xxbfoGe79Tn5N2OcFV6bB5QzpLl6dvFbAcoDXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DaGzzF8kW37Oepcvuu0_-24D8r6HJC0Mv5F_PUQBJQw&oe=6A048D5D"}, "display_name": "Drift V", "keywords": ["driftracing", "arcaderacing", "customization", "AIrivals"], "long_description": "Drift V is a fast, comfort-focused VR drift racer built for Meta Quest, blending arcade speed with true sideways control.\n\nBecome a drift legend across 12 adrenaline-fueled levels, from neon streets and sharp mountain turns to high-speed stunt sections built for clean lines, precise counter-steer, and satisfying tire-screeching slides.\n\nUnlock and master 9 drift cars, each made for a different driving feel. Tune your rides, improve performance, and push harder for faster scores, cleaner drifts, and better race times. Battle pro AI rivals, chase global leaderboard spots, and prove you can hold the perfect line under pressure.\n\nCinematic cutscenes make each milestone feel bigger, while smooth controls keep the action comfortable for Quest 2, Quest 3, and Quest Pro players.\n\nFeatures:\n\u2022 9 free drift cars\n\u2022 12 sideways drift levels\n\u2022 Realistic VR physics and weight shift\n\u2022 AI drift rivals\n\u2022 Upgrades and customization\n\u2022 Cinematic cutscenes\n\u2022 Meta Quest optimized\n\u2022 Smooth comfort-focused gameplay\n\nSearch Drift V on Meta Horizon Store and start your drift legend journey.", "short_description": "Drift V is a high-speed VR drift racer for Meta Quest with 9 unlockable cars, 12 intense tracks, realistic weight transfer, pro AI rivals, cinematic cutscenes, and smooth comfort-focused controls. Master neon corners, earn upgrades, and climb global leaderboards in the ultimate arcade drift challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r35WVquX-4OXJbqmcyLsfPidJtM73SGqeMj9R7QzW0A&oe=6A43B1FC"}, {"file_name": "2560x1440-screenshot (1).png", "id": "1252698876127119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822897_1252698879460452_5395329702246090549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJY8KIPL0XQQ7kNvwFkhSR1&_nc_oc=Adr1IBc3zVKbyWvJPLPJCTM4Mt4vI6mV9H4k7eTIicWI-IBihMZXwI1Y6wvdJH1-iH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_22ZRvZcQVZXoEA0QtoBB9ww7hU21cXPjcc2pWc6ja0Q&oe=6A43E5CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "761957226536712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303745_761957229870045_6502155357187005399_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph6kiitm4h0Q7kNvwHh0fI0&_nc_oc=Adpi0k0J-uJdQYNV8oC7_LYcDAIvQ8Idmt5D_gDvjra8qwh2fBbY8WYIANTjiqKvfGg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e7foj4eSuIWDyFZ6ADZRud0S7Pg--gRB-oMRxHl3gvQ&oe=6A43D21D"}, "display_name": "Drift V", "keywords": ["carracing", "carsim", "vrcar", "drift", "cardrift"], "long_description": "Drift V \ud83c\udfc1\ud83d\udd25\nBECOME A DRIFT LEGEND IN THE WORLD\u2019S MOST IMMERSIVE VR DRIFTING SIMULATION!\n\nStrap into the ultimate adrenaline rush built exclusively for Meta Quest. With hyper-realistic physics, 9 FREE high-performance drift cars, and 12 levels of tire-shredding action, Drift V transforms your living room into a global drifting arena.\n\n\ud83d\ude97 9 FREE CARS \u2013 Unlock & master hyper-realistic drift machines!\n\ud83c\udf00 12 LEVELS OF SIDEWAYS ACTION!\n\n\u2705 TRUE-TO-LIFE PHYSICS:\n- Feel every tire scream, counter-steer, and weight shift in VR!\n- AI drivers with pro-level drift skills \u2013 battle them for dominance!\n\n\ud83c\udfac CINEMATIC THRILLS: Epic cutscenes celebrate your biggest drifts!\n\ud83c\udfae META QUEST OPTIMIZED: Intuitive controls, smooth locomotion, zero motion sickness!\n\n#VRDrift #DriftingGame #MetaQuest #VRCars #RacingSim #AdrenalineRush\n\n\ud83d\udc49 GRAB THE WHEEL!\nOnly on Meta Horizon Store\nSearch: \ud83d\udd0e \u201cDrift V\u201d\n\nQuest 2/3/Pro | Comfort: Comfortable\n\nYOUR DRIFT LEGEND STARTS NOW! \ud83d\udca8\ud83c\udf1f", "short_description": "Drift V \ud83c\udfc1\ud83d\udd25\nBECOME A DRIFT LEGEND!\nStrap into Meta Quest\u2019s ultimate VR drifting sim! Master 9 FREE cars across 12 adrenaline-fueled levels.\n\n\ud83d\ude97 FREE DREAM CARS\n\ud83c\udf00 12 SIDEWAYS LEVELS\n\n\u2705 TRUE-TO-LIFE PHYSICS\n- FEEL every tire scream & weight shift!\n- Battle pro-level AI drift rivals!\n\n\ud83c\udfac EPIC CUTSCENES\n\ud83c\udfae COMFORT-FOCUSED: Smooth controls, zero nausea!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24913112468296225"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1795159695200590"}, {"status": "PUBLISHED", "id": "24843796601984170"}, {"status": "PUBLISHED", "id": "144274930072
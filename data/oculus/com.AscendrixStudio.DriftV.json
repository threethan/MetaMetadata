nt-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UErNITLjV31gq-zflvdDYb6UEvDz7K7FI-QVhHw0JaQ&oe=6A0AFF6A"}, {"file_name": "2560x1440-screenshot.png", "id": "1157306802904561", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824012_1157306806237894_4903733983941798751_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iwrQIiERoMQ7kNvwGzZWdo&_nc_oc=AdqAvHxfWagvA4JkvO_pljEq4jtL7m7FYNTdNgfMpnL-W1jOfZFekCbFBKJAuAflQNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UTUhYF0EHluuKT1XtK2i498_YEs2yV-eg3CBZ3xRsnw&oe=6A0B22EF"}, {"file_name": "2560x1440-screenshot (2).png", "id": "1270937877850787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_1270937881184120_4779472473346430237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwP0DQ9MKUkQ7kNvwFd9Y-0&_nc_oc=Adouqwe-ZZDLf8Uofg8RumIydsEW8coUIArr2i4r3ypZDeCRrrUIgJnC_hkvE1IPiP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jbTADBE_N-Wa3LAhWDlmpKYc0xwQDQwPJc9Eu_H-COg&oe=6A0B017C"}, {"file_name": "2560x1440-screenshot (1).png", "id": "1252698876127119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822897_1252698879460452_5395329702246090549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62UvRfSH-m8Q7kNvwHf2Mfy&_nc_oc=AdqiHBUUmrbcJVNRqWzwRI-lupFHub2WnpHlJPNZFdzGhsfFQVjVljuQQyLjf7X7eAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74_phsVZm4MerNLBAeQxM3sGc9IiBefFl8FuGnjgAgzQ&oe=6A0B354B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 2.png", "id": "1276006763971855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499309014_1276006767305188_6222745737269963335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v40cz4rDgacQ7kNvwFnJJZx&_nc_oc=Adpo3HqyvuxiZPMgpdeekhGN6lZZs84TNOwEZUZa2QJu15gBgsRHDCYv0-Y3GSAo-mE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jqHufLiqNYtMiJcQjbduGascYgXH2oGEnhkEmslLQ4Q&oe=6A0B24DD"}, "display_name": "Drift V", "keywords": ["driftracing", "arcaderacing", "customization", "AIrivals"], "long_description": "Drift V is a fast, comfort-focused VR drift racer built for Meta Quest, blending arcade speed with true sideways control.\n\nBecome a drift legend across 12 adrenaline-fueled levels, from neon streets and sharp mountain turns to high-speed stunt sections built for clean lines, precise counter-steer, and satisfying tire-screeching slides.\n\nUnlock and master 9 drift cars, each made for a different driving feel. Tune your rides, improve performance, and push harder for faster scores, cleaner drifts, and better race times. Battle pro AI rivals, chase global leaderboard spots, and prove you can hold the perfect line under pressure.\n\nCinematic cutscenes make each milestone feel bigger, while smooth controls keep the action comfortable for Quest 2, Quest 3, and Quest Pro players.\n\nFeatures:\n\u2022 9 free drift cars\n\u2022 12 sideways drift levels\n\u2022 Realistic VR physics and weight shift\n\u2022 AI drift rivals\n\u2022 Upgrades and customization\n\u2022 Cinematic cutscenes\n\u2022 Meta Quest optimized\n\u2022 Smooth comfort-focused gameplay\n\nSearch Drift V on Meta Horizon Store and start your drift legend journey.", "short_description": "Drift V is a high-speed VR drift racer for Meta Quest with 9 unlockable cars, 12 intense tracks, realistic weight transfer, pro AI rivals, cinematic cutscenes, and smooth comfort-focused controls. Master neon corners, earn upgrades, and climb global leaderboards in the ultimate arcade drift challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
-atl3-2.oculuscdn.com/v/t64.5771-25/491824012_1157306806237894_4903733983941798751_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrdeGSSV-WcQ7kNvwHfip5e&_nc_oc=Adp249kj_v6GpRwOd0oheitVrEEabSCYasY92Mw2g5MaKoBWtIpnruAgSmbXTKrQQLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsy3o4vRUY6y-dv71jUIpAVwBHMqbn4sUqNpxF0JDQgg&oe=6AAD4B6F"}, {"file_name": "2560x1440-screenshot (2).png", "id": "1270937877850787", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819980_1270937881184120_4779472473346430237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRFBKC4AXCUQ7kNvwHJbMYu&_nc_oc=AdoLNPE7ynv8rrzR3EbwcQpwN2seH5W5gUbI3F_cAZVzBrSgx-9Cb3ulyCqHoYJrXn0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbEZ6wfYR1kQik1usASu0YNn_ACA19BtJsLTW48MBrsQ&oe=6AAD623C"}, {"file_name": "2560x1440-screenshot (1).png", "id": "1252698876127119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822897_1252698879460452_5395329702246090549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9UbNBhYYk8Q7kNvwFtwIXg&_nc_oc=Adps2WON0TH3HcwxxdILZMNKoqDP7F3tOX4EFGOAOJne4YBaLCOCHI5BwhfSPYMvtj8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUoDUaYSgkDdd0RXtZ6gYH9KDhzbicsd7WeHQVGDUsww&oe=6AAD5DCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "3896694420638061", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305050_3896694423971394_1682483318853497418_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB0gCQ3xfW8Q7kNvwHhnFRm&_nc_oc=AdqPfE7LjKnKAvMuJJgiqPTUxRn8gPOnFFDNjN8Qezkkj6IinSbHYzhias4TohPylKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0FTDS2Ds4n_5OpXrHvrdZJqkhtE0iK1_IiYzoUbzSdA&oe=6AAD4276"}, "display_name": "Drift V", "keywords": ["driftracing", "arcaderacing", "customization", "AIrivals"], "long_description": "Drift V \u2014 VR drift racing built around real sideways control\n\nMost racing games ask you to stay on the line. Drift V asks you to break it. Feel the weight shift, catch the slide with counter-steer, and hold it all the way through the corner.\n\n12 DRIFT TRACKS\nNeon city streets, tight mountain hairpins, and high-speed stunt sections \u2014 each one built for clean lines and long, screaming slides. Learn the track, then learn how to take it sideways.\n\n9 DRIFT CARS TO UNLOCK\nEvery car has its own balance, grip, and slide behavior. Find the one that matches your driving feel, then tune it for more speed, better control, and higher scores.\n\nREALISTIC WEIGHT TRANSFER\nPhysics you can feel through the wheel. Load the front end, kick the rear out, and modulate throttle to keep the angle. Sloppy inputs end the drift \u2014 precise ones extend it.\n\nPRO AI RIVALS\nRace against AI drivers who hold their own line under pressure. Out-drift them, don't just out-drive them.\n\nUPGRADES AND CUSTOMIZATION\nEarn rewards from clean runs and put them into performance upgrades and visual customization.\n\nCINEMATIC CUTSCENES\nMilestone moments play out in full cinematic style as you rise through the ranks.\n\nCOMFORT-FOCUSED VR\nSmooth, seated-friendly controls designed for long drift sessions on Quest. Comfort rating: [match your submission form exactly].\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nHold the angle. Own the corner.", "short_description": "VR drift racing built on real weight transfer. Slide 12 tracks, unlock 9 cars, beat pro AI rivals and climb global leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
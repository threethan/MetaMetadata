ntent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HUNkBe-xJM24T_nNho5WY76ByJZPgYrpHyaTrXl_9FA&oe=6A0DC5EF"}, {"file_name": "2560x1440-screenshot (2).png", "id": "1270937877850787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819980_1270937881184120_4779472473346430237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr_QQjREZH8Q7kNvwGttTT4&_nc_oc=AdqnfoVOcpRXpcmfVXWSC2G71xs2nx3OToGTThF26oD0NZwGBY_JaDbDpWZ53SS9jhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64KULlL8lhKO9uNh5sL3YDjSuTIjs6CFiBonnOvS70GQ&oe=6A0DA47C"}, {"file_name": "2560x1440-screenshot (1).png", "id": "1252698876127119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822897_1252698879460452_5395329702246090549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UaNR3D_T_MQ7kNvwEpcW93&_nc_oc=AdppfMEGIOgiA-wfx9VSJb-U6v83_cYVdai5B3OOeOpaK9IZNNcFjVADpwKhNNtr9Mk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wx7vkK-0IDRvGtBjEbC5l4hybAtF3I-qxUaVnX7Dwhg&oe=6A0DA00B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "3896694420638061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_3896694423971394_1682483318853497418_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14nXlrdmVVEQ7kNvwEt-eOB&_nc_oc=AdpeYBwci-NVVn3YAjBFWKRuQpLP61krelA--2xreTqffy_T_4tFju5YZ3ag5DuLhTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ngRp3lm99KvprfTIpLnvIm2EBMV7DsMmvVNuD_oLLVg&oe=6A0DBCF6"}, "display_name": "Drift V", "keywords": ["driftracing", "arcaderacing", "customization", "AIrivals"], "long_description": "Drift V is a fast, comfort-focused VR drift racer built for Meta Quest, blending arcade speed with true sideways control.\n\nBecome a drift legend across 12 adrenaline-fueled levels, from neon streets and sharp mountain turns to high-speed stunt sections built for clean lines, precise counter-steer, and satisfying tire-screeching slides.\n\nUnlock and master 9 drift cars, each made for a different driving feel. Tune your rides, improve performance, and push harder for faster scores, cleaner drifts, and better race times. Battle pro AI rivals, chase global leaderboard spots, and prove you can hold the perfect line under pressure.\n\nCinematic cutscenes make each milestone feel bigger, while smooth controls keep the action comfortable for Quest 2, Quest 3, and Quest Pro players.\n\nFeatures:\n\u2022 9 free drift cars\n\u2022 12 sideways drift levels\n\u2022 Realistic VR physics and weight shift\n\u2022 AI drift rivals\n\u2022 Upgrades and customization\n\u2022 Cinematic cutscenes\n\u2022 Meta Quest optimized\n\u2022 Smooth comfort-focused gameplay\n\nSearch Drift V on Meta Horizon Store and start your drift legend journey.", "short_description": "Drift V is a high-speed VR drift racer for Meta Quest with 9 unlockable cars, 12 intense tracks, realistic weight transfer, pro AI rivals, cinematic cutscenes, and smooth comfort-focused controls. Master neon corners, earn upgrades, and climb global leaderboards in the ultimate arcade drift challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/driftv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
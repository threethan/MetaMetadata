uluscdn.com/v/t64.5771-25/39031313_743045398018184_1218810291694551795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot-fudiqiuAQ7kNvwEI87B-&_nc_oc=Adoz1QlH103O_fGz065ID9AM46mSkr_kEY7CmRRpBoaE-P0MDz746yxHXDHiHVUuCeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJh2M-g_LaAtiiVi7v-Sef5uZ2V1QdOgff8QZUNQv8Ug&oe=6AFF33CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "003.IP_T_coverImag.png", "id": "408852298449958", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003266_408852301783291_3866988320546917830_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lq_Fb9xhruwQ7kNvwH0zp4N&_nc_oc=Adp_V1DRgdEhjw79wu3eCbveuVNs2_zikRU7uMMcBDHICRkfefs39kZCPcpn-6nsLBk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH2v2G6lgusciy2tLVPenJP4I2K5S_lYV3l1ztXqxDaw&oe=6AFF1505"}, "display_name": "IP-T", "keywords": [], "long_description": "Note: You can experience full content if you register as an institution.\n\nIP_Trauma is an Interprofessional training simulator that allows multiple healthcare professionals to learn severe trauma management techniques in a collaborative, multi-player environment.\nIP_Trauma offers over 50 treatments from the ABCDE Primary Survey, including ultrasound, X-ray, CT scans, and blood tests. Built-in manually adjustable Bio Signal Simulator dynamically changes results according to the treatment.\nIP_T accommodates up to 10 healthcare professionals online, making it ideal for leader education and team training in medical and nursing schools, as well as hospitals.", "short_description": "IP_T is a severe trauma patient management simulator developed based on ATLS and ABCDE Primary Survey protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrad.one/bbs/board.php?bo_table=Resources&wr_id=12", "developer_terms_of_service_url": "https://vrad.one/bbs/board.php?bo_table=Resources&wr_id=11", "publisher_name": "VRAD
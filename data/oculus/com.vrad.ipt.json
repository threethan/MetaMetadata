"\uc911\uc694 : \uae30\uad00 \ub4f1\ub85d\uc744 \ud558\uc2dc\uba74 \ubaa8\ub4e0 \ucf58\ud150\uce20\ub97c \uc0ac\uc6a9\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\nIP_Trauma : [\uc544\uc774\ud53c_\ud2b8\ub77c\uc6b0\ub9c8]\ub294 \uc911\uc99d\uc678\uc0c1\ud658\uc790 \ucc98\uce58 \ubc29\ubc95\uc744 \ub2e4\uc911\uc0ac\uc6a9\uc790 \ud658\uacbd\uc5d0\uc11c \uc5ec\ub7ec \uc758\ub8cc\uc9c4\uc774 \ud568\uaed8 \ud559\uc2b5\ud560 \uc218 \uc788\ub294 \ub2e4\uc9c1\uc885 \uc5f0\uacc4\uad50\uc721 \uc2dc\ubbac\ub808\uc774\ud130\uc785\ub2c8\ub2e4.\nIP_T\ub294 \uc138\uacc4\uc801\uc73c\ub85c \ub110\ub9ac \uc54c\ub824\uc9c4 ATLS\uc758 \ub0b4\uc6a9\uacfc ABCDE Primary Survey \ub0b4\uc6a9\uc744 \uae30\ucd08\ub85c \ud558\uc600\uc2b5\ub2c8\ub2e4.\nIP_T\ub294 \ucc98\uce58\uc5d0 \ub530\ub77c \ub2a5\ub3d9\uc801\uc73c\ub85c \ubcc0\ud654\ud558\uac70\ub098, \ud2b9\uc815 \uc0c1\ud669\uc744 \ubd80\uc5ec\ud560 \uc218 \uc788\ub3c4\ub85d \uc218\ub3d9\uc73c\ub85c \uc870\uc808 \uac00\ub2a5\ud55c Bio Signal \uc2dc\ubbac\ub808\uc774\ud130\ub97c \ubc14\ud0d5\uc73c\ub85c\nABCDE Primary Survey\uc5d0 \ud3ec\ud568\ub418\ub294 50\uc5ec \uac00\uc9c0 \ucc98\uce58\uc640 \ucd08\uc74c\ud30c, X-Ray, CT, \ud608\uc561\uac80\uc0ac \ub4f1 \ub2e4\uc591\ud55c \uac80\uc0ac \uacb0\uacfc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\ucd5c\ub300 10\uba85\uc758 \uc758\uc0ac, \uac04\ud638\uc0ac\uac00 \uc628\ub77c\uc778\uc73c\ub85c \uc811\uc18d\ud558\ub294 VR \uc2dc\ubbac\ub808\uc774\ud130\ub85c \ub2a5\ub3d9\uc801\uc778 \ud310\ub2e8\uc744 \ud1b5\ud55c \ub9ac\ub354\uad50\uc721\uacfc \ud300 \ud6c8\ub828\uc5d0 \uc0ac\uc6a9\ub420 \uc218 \uc788\uc5b4 \uc758\uacfc\ub300\ud559\uacfc \uac04\ud638\ub300\ud559, \ubcd1\uc6d0 \ub4f1\uc5d0\uc11c \ud65c\uc6a9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "short_description": "IP_T\ub294 ATLS\uc640 ABCDE Primary Survey\uc758 \ub0b4\uc6a9\uc744 \uae30\ubc18\uc73c\ub85c \ud558\ub294 \uc911\uc99d \uc678\uc0c1 \ud658\uc790 \ucc98\uce58 \uc9c1\uc885\uac04 \uad50\uc721 \uc2dc\ubbac\ub808\uc774\ud130\uc785\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "007.IP_T_PDP.png", "id": "7582776878454404", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035413_7582776881787737_350081094049175447_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGqwkW1oOPYQ7kNvwF8G-9L&_nc_oc=AdrFJjwlOpdY_bxqdhHBw73vbuFLvUPcn-SbCQFxtyRNP624WzKlYUoSZ7riY82rYVU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfeXwWPhG8gpawFZ6V4AXTJTGHqKB-js9M3VFAdbO9Zw&oe=6AC8F765"}, {"file_name": "006.IP_T_Portrait.png", "id": "983027943185636", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75203623_983027946518969_7702250332292799809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nakhO-4MXuAQ7kNvwHQ2AKe&_nc_oc=AdqO10e6pXy6OM2XLWtxoaryVT7wkumoLFpkmIRXJmY0itYqW42rpRzGT3O41ri4AnI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-D28dpRHTIfEGJAwxCebpeS4SxHAMQZC95CdV6VhiJw&oe=6AC8F6CE"}, {"file_name": "005.IP_T_Square.png", "id": "957932452456270", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003281_957932459122936_9088497075398988506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK4sIXrCVJYQ7kNvwHulz08&_nc_oc=Adqc4Y19Q3HSOrRqxsU0ZHYF_gWs17dRfiMPTZdKmxb8vijz1j-EXnea-Bk8mrezOjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ80PZvxVUyygwnUtyrrNpJv_8q57ZRovR_k98Iuu2FA&oe=6AC919C3"}, {"file_name": "004.IP_T_randscape.png", "id": "889165376299748", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_889165382966414_460908823243778464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZwuvobAuAkQ7kNvwECBCjQ&_nc_oc=AdqqjPnzY-Whe7oqqyCxiYvgfd9byhts4ONQP_hLccvBjIxMbJzK9s6yzVXntlKj7_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGpWrkSUgvZD792qBfpre5VpqLxNru8vlRvX383as-ag&oe=6AC8F85E"}, {"file_name": "008.IP_T_Mini.png", "id": "404
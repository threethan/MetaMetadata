6AFC79B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Xploit_Tower_Defense_Keyart_HD_DEMO.png", "id": "27786474900993974", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312422_27786474910993973_9129956432965177149_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L59Nc25ZbMYQ7kNvwFpQ6Sr&_nc_oc=AdpDSyVntzisWSGpgJOn6wYm4aZWZFvS-zuwztW0oNdxLQbvdiQXZXk5SECf_XzIAcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8fL9hKOJGhSkAZbcIzu2GAKQL3oK6HYwPn7s18eROFw&oe=6AFC82C4"}, "display_name": "Xploit Tower Defense Demo", "keywords": ["strategy", "defense", "scfi", "MR", "tower"], "long_description": "A massive cyber-invasion is breaking through into your reality. Crawlers and Malworms are swarming your own room, hunting for your memory cores. Fortify every corner, deploy your defenses, and react in real time as digital insects spill across your walls and floor. No two invasions are the same, your space becomes the battlefield.\n\nThis free demo gives you a taste of the full invasion with Level 1, playable in two ways:\n\nNormal Mode \u2014 face a structured wave of Crawlers and Malworms and see if your defenses can hold\nEndless Mode, how long can you survive as the swarm keeps coming?\n\nEach mode can be played across two difficulty settings, so whether you're easing into mixed reality tower defense or looking for a real challenge, there's a fight suited to you.\n\nThink fast, defend hard, and reclaim your reality. Do you dare?\n\nLike what you see? Wishlist the full version of Xploit Tower Defense for more levels, more enemies, and the complete invasion.", "short_description": "A massive cyber-invasion is breaking through into your reality. Crawlers and Malworms are swarming your own room, hunting for your memory cores. Fortify every corner, deploy your defenses, and react in real time as digital insects spill across your walls and floor. This free demo drops you into Level 1  playable in both Normal and Endless modes, across two difficulty settings. Think fast, defend hard, and reclaim your reality. Do you dare?"}]}, "developer_name": "LENYA DIGITAL", "developer_privacy_policy_url": "https://www.aaagamestudios.com/xploit.zero/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Game Studios S.L.", "support_website_url": null, "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1788870248928857"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1332083128911566"}]}, "baseline_offer": {"id": "1332083128911566"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790002800, "status": "PUBLISHED", "id": "1332083128911566"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1825283455287536", "version": "1.0.8"}, "id": "2508262222960850", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1742570576892158", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1825283455287536"}, "release_status":
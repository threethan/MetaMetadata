g?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xILn938vYzAQ7kNvwEgwH8Q&_nc_oc=AdqhhP4RARjQioC8Lt9xyReaucPDTj2S7aXFAs5FAoJf1rrwOae4BKV0IR1TczF3rHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2pk7iQ__zpx7LMVtgBqOYcFxUKYThDViVVxPrCxXrIA&oe=6AFC79B1"}, {"file_name": "ScreenCapture02.png", "id": "1123910570605102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/742308944_1123910573938435_1630601176059072539_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGgu_kElulIQ7kNvwEoM0vi&_nc_oc=AdoLvfhl_-eHkDKDfmIW3lQ_T79aLUQTLBxrnTWE7cmPEGXo0tq96bcBxSMKSFqAJZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTH3nVzTuNgEmGNxJfk5MJd93XmbKrYaqlWJTK6YAmcg&oe=6AFC6F68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Xploit_Tower_Defense_Keyart_HD_DEMO.png", "id": "27786474900993974", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312422_27786474910993973_9129956432965177149_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L59Nc25ZbMYQ7kNvwFpQ6Sr&_nc_oc=AdpDSyVntzisWSGpgJOn6wYm4aZWZFvS-zuwztW0oNdxLQbvdiQXZXk5SECf_XzIAcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8fL9hKOJGhSkAZbcIzu2GAKQL3oK6HYwPn7s18eROFw&oe=6AFC82C4"}, "display_name": "Xploit Tower Defense Demo", "keywords": ["strategy", "defense", "scfi", "MR", "tower"], "long_description": "A massive cyber-invasion is breaking through into your reality. Crawlers and Malworms are swarming your own room, hunting for your memory cores. Fortify every corner, deploy your defenses, and react in real time as digital insects spill across your walls and floor. No two invasions are the same, your space becomes the battlefield.\n\nThis free demo gives you a taste of the full invasion with Level 1, playable in two ways:\n\nPlay with your hands or your controls.\n\nNormal Mode \u2014 face a structured wave of Crawlers and Malworms and see if your defenses can hold\nEndless Mode, how long can you survive as the swarm keeps coming?\n\nEach mode can be played across two difficulty settings, so whether you're easing into mixed reality tower defense or looking for a real challenge, there's a fight suited to you.\n\nThink fast, defend hard, and reclaim your reality. Do you dare?\n\nLike what you see? Wishlist the full version of Xploit Tower Defense for more levels, more enemies, and the complete invasion.", "short_description": "A massive cyber-invasion is breaking through into your reality. Crawlers and Malworms are swarming your own room, hunting for your memory cores. Fortify every corner, deploy your defenses, and react in real time as digital insects spill across your walls and floor. This free demo drops you into Level 1  playable in both Normal and Endless modes, across two difficulty settings. Think fast, defend hard, and reclaim your reality. Do you dare?"}]}, "developer_name": "LENYA DIGITAL", "developer_privacy_policy_url": "https://aaagamestudios.com/xploit-tower-defense-game/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Game Studios S.L.", "support_website_url": "https://discord.gg/zEUHTqTfa", "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
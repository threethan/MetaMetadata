84_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE6NN-AliOEQ7kNvwEFx_Dd&_nc_oc=Ado2pXYCJQJIZ8UPxPdkRADLXkvQdJwVZQXiE0Ngz7jfOdsUjcrNjN6g_7uF19SVL80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxaiGDui7hJ8RfuD6sAIGdIfwaoz4k9-hKHbOk_UYF9w&oe=6B105F7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-11-15-10h59m59s134.png", "id": "4612280119015757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593878539_4612280122349090_7815237173555193656_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTv_xHFc8CIQ7kNvwGE12aq&_nc_oc=AdosIPRC--K732nEYDHtJ9hS_Sz9hOdIJ2S6NApOqaroV4ejXCECWif9UweFuqgzuaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXEZM4f5riQLSR8m-nCtLy_aLySXlm3YDJGE5k0MzEzA&oe=6B104428"}, "display_name": "igloopy", "keywords": ["penguin", "family", "igloo", "handtracking", "cozy"], "long_description": "Penguins can't fly\u2026 so raise your wings!\n\nIn igloopy, your arms are the controls. Swing them up and your penguin buddy hops from ice floe to ice floe. Flap again and he soars into a high jump. Time every leap and keep your fish streak going.\n\nFIVE WORLDS, 25 LEVELS\n\u2022 Iceberg Channel: learn to swing and jump\n\u2022 Crystal Cavern: pauses, surges and tricky timing\n\u2022 Storm Sea: gusts that speed you up or slow you down\n\u2022 Aurora Peaks: flap for high jumps over tall ice\n\u2022 Galaxy Drift: light and heavy gravity among the stars\nOutsmart giant guardians like Old Tusk the narwhal and Blackfin the orca, and earn up to three stars on every level.\n\nCOME HOME TO YOUR IGLOO\n\u2022 Spend the fish you collect on hats and furniture\n\u2022 Place, move and turn every piece just the way you like\n\u2022 Watch your buddy settle in: he climbs into the armchair, twirls on the rug and sips cocoa by the fire\n\u2022 Build a whole village of cozy igloos\n\nPLAY YOUR WAY\n\u2022 Hand tracking or Touch controllers\n\u2022 Full VR, or mixed reality right in your own room\n\u2022 Active, simple and fun for the whole family", "short_description": "Penguins can't fly\u2026 so raise your wings! Swing your arms to hop your penguin buddy across 25 icy levels in 5 worlds, from crystal caverns and stormy seas to outer space. Then come home to your own igloo: dress up your buddy, decorate cozy rooms and share a cup of cocoa. Play with hand tracking or controllers, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ouirolabs.com/privacy/igloopy", "developer_terms_of_service_url": null, "publisher_name": "Ouiro Labs", "support_website_url": null, "website_url": "https://ouirolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1515623088290862"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2167061207351829"}, {"status": "PUBLISHED", "id": "1655650859272968"}]}, "baseline_offer": {"id": "1655650859272968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2167061207351829"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1516863058166865", "version": "1.0"}, "id": "1110757121769528",
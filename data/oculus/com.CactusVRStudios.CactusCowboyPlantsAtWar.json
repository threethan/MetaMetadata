 survive the relentless attacks of the bugs.\n\nThis WW2 themed VR story shooter brings your weapon combat skills to a new level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cactusvrstudios.com/about/", "developer_terms_of_service_url": null, "publisher_name": "Cactus VR Studios", "support_website_url": null, "website_url": "https://www.cactusvrstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9309095375771208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001674_1235012674403468_8837351151717175857_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQDkT8u38UUQ7kNvwFOV1O1&_nc_oc=AdlWYtQcPyjz0uwe1auNZst8BgR8eaQHvjCbRwG9Y7B8yNjDZFuxwDZRSCySbWJJQA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytvZ9pw3avDKbffxPFo9kAEXO5DNN5CD9CAITdzy1Mgw&oe=69B14E95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cactus Cowboy - Plants At War", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1650103200, "lastRevision": {"nodes": [{"id": "667530314474234", "release_type": "SCHEDULED", "administration_status": "APPROVED", "
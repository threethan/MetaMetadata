he throttle yourself or run automatically\nMixed reality on your own table (supported headsets), plus a full VR table mode\nToy-train-scale world (1:96) with stations, scenery and sound\nSingle player. Plays fully offline. Play seated or standing.", "short_description": "Lay miniature railway across your tabletop in mixed reality, run the train, and serve every stop before time runs out \u2014 20 levels plus a free-build sandbox."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tabletopminitrain.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Milind Brahme ", "support_website_url": null, "website_url": "https://tabletopminitrain.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372124812653661"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1607105523616735"}, {"status": "PUBLISHED", "id": "1144548421427945"}]}, "baseline_offer": {"id": "1607105523616735"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792451520, "status": "PUBLISHED", "id": "1607105523616735"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1370323869500422", "version": "1.1"}, "id": "1060127893724386", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
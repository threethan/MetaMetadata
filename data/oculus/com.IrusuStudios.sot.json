6924745299_5083697641526068332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYlFzLWxn2oQ7kNvwFXNefP&_nc_oc=AdqHK62u8Ih2rc__ozfdJK4l5SWxmJSZD2GtDvVa5rICYvBqKDbIQZAJs-GvMkIwdNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vh1DpC_IknmloklkYdnn9I7Z6k_Jw_T1rWETIA_ROLg&oe=6A0B03C0"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08INKvw5FoMQ7kNvwHLV66b&_nc_oc=AdrVzI9oH4kzLBmRxS4zMqPNgxkAQLlVBA9CQJ6vFvtqMiEuCxz_xL2xK6ONKXHIPCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vDcr1F-PFhRVEcLqJ5aYTrfVPBFXNqShWN6F-YIlwDw&oe=6A0B06F6"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzJWW05zXfgQ7kNvwEyV2CH&_nc_oc=Adr4WcaQjrJbZGYwIIEGIPkP1HrN4xTf34fvp0Mmz7C83oyAdbvAzsowQo2dEzhLzCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M52qNI2pd9Igltr5UkQ7Bh2x4KNFbbY5poAvbvWpBzQ&oe=6A0B2730"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFna15IOdbAQ7kNvwElqCI9&_nc_oc=Adpl6UWdJzWLZXRPlx-tHrviX1jnW4UKJjxdtfmTCQ2JsI9tRuyhhedRKsSNZuAypMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zobwLj2Ols63GiQi1JR_IWaDeFIggJ7F2Y9cu4JyH5Q&oe=6A0B2737"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fz9VvUv-I4MQ7kNvwFgpBo4&_nc_oc=AdpLuFVUGMlqmIrEFx-FDIy5kZuXmOvi4K2iiEuPMGvx0zdvvP7Ok8_lEemv1ChuQ8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a4STzz9gfe7MvX_bCY-IPGCev0iIDKN4u0rOCAeWVow&oe=6A0B23A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
0p-tsayViVVA2KUKuEBL-vnyguqQm81nQjrMaSaH6ZIGzTMMuvSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGAY-OrahADBYVOPLzPE21rg_0IhRQ-1AiNCfcEWR07Q&oe=69CFB040"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnMGbChxjfwQ7kNvwEre5BD&_nc_oc=AdpxTEWVuYY8DpnWO7dQD9xmi-dj8SI6rXqkwNC9OHk0J3R2cWKgOAWXi22y3b-9Kto&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwhqu70qYhRG93cuUrrwgY9MiWFkseHdsYVlb4xscQ-Jw&oe=69CFB376"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ACYB-CY1-kQ7kNvwEmDyqt&_nc_oc=AdpA_LFceZpIr7IGtqTKvJ3056XRUfRRmLO9-q7gqcAOsXq-6DZbGBtr7-MmH04HsRI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYs28lA1iz2cRBD5nNGp7x-hvCdZw8-D4cjwGIk-RDeA&oe=69CFD3B0"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh9_EEzRwjwQ7kNvwEcULYt&_nc_oc=AdqugpsyCX2C2bwE0QZjJpePvRsZraNokmTEGSOZ65JvwYXbs9DFLfT5DfV41VJo9KI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwRR0jFU0JlerdhERC6TNW-Rjqqw2NG7YT0Dw7Gif1JQ&oe=69CFD3B7"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G53K1R4eIggQ7kNvwEtIzte&_nc_oc=AdrhH0vrHXeS74M68rS7R-aMcrE1vs8abWwBuA7GYUfmX0AarTPVtVWST3gKpu9-x7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzosdqvaWQTXSCQfpf_DbxXTBc34s6GolfNg5Lu9hX_ww&oe=69CFD022"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUI
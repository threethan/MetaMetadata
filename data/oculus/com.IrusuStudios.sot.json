6924745299_5083697641526068332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XURhK0II3TgQ7kNvwFfLJP9&_nc_oc=AdqbUyHynxLWKBwz5zqRtbmdj3uWFg9G6BadC5mcbhyJinUYPaahuNQp15mZ_6VowsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0IJeGsWe8P8N1zQk2Bhue3oSr9cWK176jfQvzlLpY-g&oe=6A999E00"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J2KeW7F4okQ7kNvwG9OBuZ&_nc_oc=Ado_8T9uLBgmq6Pt80idFdEkuI2Q2r92j-I9yjQnC4wV0a_6xltqPAkFYdiRlhw7Z94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrCZoaHD37gQFUBRAAI5IruO-Z8I0yUDA5MVawJQncLg&oe=6A99A136"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3I7iKaO490Q7kNvwHs47z_&_nc_oc=AdpJhCPKASjol3mKeyMDyi3ZrVFtEeH2fPpyG1o1P4OLi-5v8boQpZ_FaqiBDT1O6tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfwmsBFlDNhhtZLL6F1DMxX1GP6zk3duZHICLnnjCBmg&oe=6A998930"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BH0v0K8U1Q0Q7kNvwF52o6p&_nc_oc=Ado1HzXZuuRh-X5O33ruBe4oqV6gMG9mihP_hZrUjqV8RrgX-6S_PRk3Kl5bc6KAXLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9r2AtezriFtZ38MQ5vaD-DF_-Tl5FdBND7bhmV-a1Cw&oe=6A998937"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8y9paZlkxIQ7kNvwEJpGC_&_nc_oc=Adqr4QyLXyV95UymqALD14eMvVz5DcMQb6bgoRuIXRcbn8WcEw-lCmflbKtX2lYGGos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa0cdENtWEB-c6d2HSHWJ_qORNflvLpA8zCWWJyUHOIw&oe=6A9985A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
6924745299_5083697641526068332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g8ZYkPGjHAQ7kNvwE5koR0&_nc_oc=AdoOTcY_QrEGaUC1f7Q56RJDsRV03WUTsolRYfMv2uyfdAWf8LDQJzUvYLYqBqlUVSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAiU7OIpE0nTBhUlbhfJA1vK62pyR3RkN9wXW3wb5S1Q&oe=6A79C1C0"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRBye9medSEQ7kNvwE9bE7t&_nc_oc=AdpvVzkO8JANaVyBY4Rp6y8kLkTQKGoZC1_pOj2a2XumSxrqp8dicXoZnUdF5o_Gdq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdJCPSFdUnOuHal1dZOeVGoo4q_0PUAhGWim0kLpgkkA&oe=6A79C4F6"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO0OVwD66QwQ7kNvwGTEivC&_nc_oc=AdplInX1VO47xCBwfCthqLDAMDDBVDy73kAJxxAuxxUBbZ5h14S5BDN6biaETqp85GA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm8mcDJBEi6CqH1f8zWCRexXz5UG9_q2e2Eyp99NoVNw&oe=6A79E530"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDCMqjR6AgoQ7kNvwGUmFuA&_nc_oc=AdrvpJuNaK2TvHSdrxB3fXPmSoEP4f5Be7VtNnRCSLfai4UFBjebPqCKlcy3ea4yJFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkvtOEEhtd5N54B1FE3-7bayH-raTq6q0niggY_g6asA&oe=6A79E537"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJxRya4FvOEQ7kNvwGnK_G6&_nc_oc=Adp0vF591mznGBh8wpPwXKlrhX5pQuKm-QlyD5AsudfWzoQtfAx0LTeIiBj15sQ0DM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA1L6qz0g2Vz-B4o3sghEbRnph2Vbjl17T61iwyF9I6A&oe=6A79E1A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
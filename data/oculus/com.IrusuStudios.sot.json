6924745299_5083697641526068332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pouswjm9l0IQ7kNvwEGB3Nk&_nc_oc=AdrYfSn95HAFk6Afi3YN6yWZmJU1zcjd9XLdShnO5O-wGp1sHEcvgNf-SsXW_Zp-4pE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LDwhdIhfISSFmztScN_MrLD2nat7fofpg4mpLe7_EDQ&oe=69F49A40"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N6vFC4b9GcQ7kNvwFV12_7&_nc_oc=AdpzCBJnasDk-9DaiNQ2CWsfpPLsU2xuQgp_4ks3vLpEBhZ16vMwnx1GZsU5_3FA310&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38IfsjKETJtG5LpUrZrCRszkNe9TLcnsjMNVKoCOe8ZQ&oe=69F49D76"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSYcuTFHqsIQ7kNvwHOd21K&_nc_oc=AdrVFGr5eTt15H_q64vmQInhy1gQD4J_31aacs-ef7LeF-98jGh9AfDKEH32xbFn-Ik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ipiWw14bIS501YThjMudmDB-hJEHGLSU6wZIF5qGH-Q&oe=69F4BDB0"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTcBhxMl8eoQ7kNvwEEiCux&_nc_oc=AdqtGgOF98rBPTvK6lto57PGEEQhdMXQZqiiGwAr2-8dE_PGpRkaTiJxrWonbDJ9RLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yIJxriSBHkdXAqES3OiDOL0liDPzcg_4nQwa00L1ZVg&oe=69F4BDB7"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzBpnqKex_QQ7kNvwGgNphy&_nc_oc=AdoKv57q54cs0_3KSg6fPx6QKWYeK9dJ5xhHCo9nmgDEfVWRJqkmzGjpn8dYlQIf2u0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0d5hNTrIPC1vOTNoufArAzv7ipdPUS3MovIrELuC4aOA&oe=69F4BA22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
Iq1-PumE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9qgqHeZ1-FRSNpOudeWn52zczTeHN5wGjtSX8-GkTiw&oe=69B400C0"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsouSOpS1qEQ7kNvwHpVAF8&_nc_oc=Adn2wYpK1UfOyH-E2LKUK1sOXtQ_favw4QFLXiNy3mGJ-BBbg_zTF8T8Tst2hWVAGXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-rjEEbRvw9G7UGIOJRfbhZG64wpQ0RCm-0EIiZ795sg&oe=69B403F6"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut0GPth1-TUQ7kNvwEnGKZK&_nc_oc=AdkPN_f6EoeyAtKAqnfVdefyoeBp0o8Fy8mGQ5QBBvevS3-_oAOgDDtrcgB8Cq2UJV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyl1OZnyNcbUUMvnMLVHKyjYLX_i26WbTpcq3lv8N7_jg&oe=69B3EBF0"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEaAqI9WClgQ7kNvwFf11sQ&_nc_oc=AdlVfmCCmAsG9C09Dn4ulO4UgwunbrX1ZTrM8SElrpPHprbt34EbuBdaCPSNAKt18XY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJQx3yhrd-bSe6TFfAu_L5gN2vOQQqvhlM8eFQeYdVQA&oe=69B3EBF7"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVsPp51hSMkQ7kNvwGpF6EC&_nc_oc=Adkkcd0PXyZVryy7pRhqy1Y3yLfmyE_3ad08BPHzoClTCywBvjrn6e0I9J0URCp1A4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXLQLuD3tAjsEkjfolqbCxXgtmFFzGSQR-_sKOxy_qUA&oe=69B420A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
6924745299_5083697641526068332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS_tHbSXGf4Q7kNvwHHI2rs&_nc_oc=AdouQC_13538W15I-DsPAa0BPZLK7odeBGfCPutoZz97LNhxKw6LsUFseyrh9mVGsWg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAMkkxyp_d43u0DXsbqK0F_UCp31DWIue-5kHTQfHHRg&oe=6A58CC40"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1I2ZVG-IgYQ7kNvwHhsQ0N&_nc_oc=AdohHnMQQUTzZi19BkopJKF4Ep-yp1d4-zB_RK6pnkg9cR6yQz5G6_dH9XGTm1MxgNI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyR0dTzho3-CWOGC2JcYun3kEw9UlYg-_gBVoP5Ns3Bg&oe=6A58CF76"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaoF_s0hJkoQ7kNvwGNuznu&_nc_oc=Adrma8lm-bE2b5OWuYH9GZiLnm4Kv6rq1cocCLjlKNmlKofCZXLp1z1uiYOhS9dmPqA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACLod8E6Xazud2wRh2S-kIGtcsa469KbxTzSJJnkuUbQ&oe=6A58EFB0"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuywTERCO_gQ7kNvwGMJux8&_nc_oc=AdqDStxr3W6lteznvOVAVYgNMHxS_B2o_Wup35Dkc0tmRwfBqR51eTa5MoC-H6aS86o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXb4V7J2YQ6A6TIvpaE8rJBQpH5HoCJTu1VGmd4ChD9Q&oe=6A58EFB7"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5yTmmWIFwUQ7kNvwGHinLv&_nc_oc=AdrKmBfWHeF1SFBSVOa1M4o8UW6a_LrOn33CJfrO7tfbUsPOmzRkIMU5E0aSuC1lrYY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5RIFyeWFO1KgoKQQ-yHEmkgBDBeSEDu9krGMSO-0YYA&oe=6A58EC22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGEQxvhgApOUbxCEPUn6zm96-IqNV_I3DPyA7pghZGRA&oe=6AFDBB37"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma6MPtNmQ0sQ7kNvwErnNC_&_nc_oc=AdoIkGsNl1lLwjJTA7_LoiS_sLuhv3W8Alh62k_kInLPbb9WjsELOpCu65PXNp0FS0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxS9qPLeyx88GqIwF2rOWeBrOt8_PUGHjQSZ_3WjYoMg&oe=6AFDB7A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8278500865611327"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1231736858907633"}, {"status": "PUBLISHED", "id": "961010203342804"}, {"status": "PUBLISHED", "id": "25739129385765834"}, {"status": "PUBLISHED", "id": "1973719899916923"}, {"status": "PUBLISHED", "id": "1607193260714592"}, {"status": "PUBLISHED", "id": "1541103303884079"}, {"status": "PUBLISHED", "id": "3902653256691405"}, {"status": "PUBLISHED", "id": "770579445757618"}, {"status": "PUBLISHED", "id": "687120924345276"}, {"status": "PUBLISHED", "id": "559330253646142"}, {"status": "PUBLISHED", "id": "983532157233936"}, {"status": "PENDING", "id": "9239997642745443"}, {"status": "PUBLISHED", "id": "4136294716601069"}, {"status": "PUBLISHED", "id": "1627636844515190"}, {"status": "PUBLISHED", "id": "1080758020098892"}]}, "baseline_offer": {"id": "4136294716601069"}, "is_approved": true, "firstOffer": {"no
AjvAfR6g&oe=69A6D1C0"}, {"file_name": "ss4.png", "id": "2137013040027987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_2137013043361320_8128834128134514227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqjUQziDRTMQ7kNvwFePFnZ&_nc_oc=AdnAO51QXpH3NP4f_W-gRm9_iwvSKxdOS4Mx3BJ4WdkreG20mdKeffwaMrEUGleSI7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNoGdSTrpY0Ydip9YJwfIeILNElJdsjE0IP3Ci8AKnWg&oe=69A6D4F6"}, {"file_name": "ss1.png", "id": "865545972447793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035364_865545975781126_3889018874071199161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JUTV3pUf_wQ7kNvwEQyk7v&_nc_oc=Adk5F_pii7TusEtZqEnHBtEFF4RlVVvqB07AlWREeTwJb8P8uBTMXcU9tSbPssdCBQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuB2eA45P1sCVW4nwFTWf-yHop3qXuOd4xJOyyY0g1jfA&oe=69A6BCF0"}, {"file_name": "ss5.png", "id": "405455469296330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035447_405455472629663_1956435798339009431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n60QgoKa80Q7kNvwG2P1rN&_nc_oc=AdkkXS6HUR2QLquYqRdAt1cRwgPlt2fmHEgiSipXG9yFV5VENc6Qvqdx6Ev_blD_aFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKloUL7Ugr89j9Mg8RLTMmoRvZSvQf5f1lG1jjkjWqdg&oe=69A6BCF7"}, {"file_name": "ss2.png", "id": "420199127811885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207244_420199131145218_8967430880202785390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCZUVJB5NK0Q7kNvwFgANm_&_nc_oc=AdktoBvTW4PcnMD_p3FrUZzixVikzP2oR6wwFkyRR0uLC8-zo8L3x_mt-xDlIT_4nSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5nze0c5yp4cNeE8KS4B7ARfpr2QB4vxd-nDtT6cFHPQ&oe=69A6B962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadows of Truth", "keywords": ["Horror", "Detective", "Adventure", "Nightmare", "puzzle"], "long_description": "Shadows of truth is a detective horror game where in each episode you are collecting clues, solving the relation of the clues and getting closer to the truth. Embark on a chilling journey into the depths of mystery and intrigue.\n\n{464812189481602}\n\n\n**Season 1**\n\nBegins with a detective's trusted friend, a brilliant scientist, vanishing amidst the chaos of his groundbreaking invention.\". Amidst swirling rumors, a secret society emerges, aiming to seize control of this revolutionary technology.\n\nNavigate through a labyrinth of secrets and deception to uncover the truth.\n\nWill you unravel the conspiracy and rescue your friend?\nOr will you get caught to the lurk around every corner?\n\nThe choice is yours. Dive into the mystery today.\n\n**Features:**\n- Photorealistic graphics\n- Immersive VR experience\n- Solving clues on a mind board\n- Hiding from enemies\n- Horror and scary elements\n- Not suitable for children under 10 years old\n\n{9624453247570930}", "short_description": "Be prepared to dive into a horrifying mystery! As a detective you need to find clues and plotted them in your mind and got close to the answers, but things took different turn someone is chasing you in your dark horrifying nightmares and it keeps coming! Back in reality someone else is also trying to reach to John. You need to escape and get to the answers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://irusu.co.in/privacy-policy-sot/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusuxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
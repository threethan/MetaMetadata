XgGnmqkBnpgOqfpv5mFwq_VVN2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41fKsyEpsrA7H-mGgdUJz0HLEjIDaGpiCkqHzdGYntSA&oe=69FA0D6A"}, "display_name": "MonkeTek", "keywords": ["Physics", "Multiplayer", "Hangout"], "long_description": "MonkeTek is a physics-based sandbox game inspired by Gorilla Tag, offering an open-ended playground for players to experiment with movement, mechanics, and interactive environments. Designed for both solo and multiplayer experiences, the game provides a variety of tools, objects, and mechanics to create, explore, and manipulate physics in creative ways.", "short_description": "MonkeTek is a physics-based sandbox game inspired by Gorilla Tag. It features interactive environments, experimental mechanics, and multiplayer fun, allowing players to explore, climb, and experiment with physics-driven gameplay."}]}, "developer_name": "Stawberryjam studios", "developer_privacy_policy_url": "https://sites.google.com/view/monketek/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Tevr,Marigold", "support_website_url": null, "website_url": "https://sites.google.com/view/monketek/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23905428115792448"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393320_1086555016820897_8369201232510290165_n.png?stp
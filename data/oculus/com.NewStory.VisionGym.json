&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJnD-XmNL_gvSpKtpVxYjb_kn5UzkjrP_MvLhWqlHB3g&oe=6A830D7C"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N-XUzx2lbcQ7kNvwGM7FYc&_nc_oc=AdptK-OskavhqGyM81XnrTSWlrMO-E6V5n16TkPUUCcBCv65r-ZiuvcwYN0Q_vAcoPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbzLQc4d7umyRvxHhBM8VtCr9h_I4omv--keVxjaq-zA&oe=6A82F21F"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfO3b8cvM-kQ7kNvwE_QW4e&_nc_oc=Adrvbmvd85qgayVheHPhDGFYSdr_lhXeB_bQOLlZ1qmm7yd7Fn3RkwZO8_hUPdAfg40&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDCyXubNbwtv7icyAujjxJBBu6LwyrzCTa-Xqo0yd6GQ&oe=6A830313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "4416579875275358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_4416579878608691_690005366641474910_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7QJi5jRTBAQ7kNvwGRqHKT&_nc_oc=AdqoUDl9le6WH_G3k-4Yk7yseWraaugga-bccfi3BWmU7r-yPysX5yT2IPgNR9Q6nWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoptG-1DyFmnynGhUuI7hq3_FOoG7TTGvrdvvIGGlaKw&oe=6A830A13"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27368189546175398"}, "review_messages": []}]}, "cover_square
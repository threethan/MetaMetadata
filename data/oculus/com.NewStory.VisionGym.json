028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1753979869289361_7256127440492580328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDEgKY7opoQQ7kNvwHuJSy3&_nc_oc=AdrAbqJmHca9b7ev0dDDk_sdDnFCUw9engtpnYVtvZiD3btomZmT5mNZp8pHmTFpi-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhP2rGgM-6hLnWNEjrAyLNM0_5wxfsd6sdjcZPOrMbRA&oe=6ADCB37C"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYYD-mK_JLcQ7kNvwGg5DqB&_nc_oc=Adryy1eTRifRo3fDNxUsEX2OFmuPpVXIBRMMBqb9WeuaOsWu_AmSPT6ndJku_aLGVcc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlCSNNPGJnJk50FlBtcOx1pX7v14s2c4N-kkqh5yOG9w&oe=6ADCD05F"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3BfuRQSF9AQ7kNvwH1pi9Z&_nc_oc=AdqR3XE8zIz3oXRKvn6UC0Y8Xn7Xvk9Q8SXharqcJlxwwYnXfb_QV-kb2xKMMWIaBng&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiSkzD22iRLCTRfVZQK7JsG4UQixGu7v1F7YYlja6RAQ&oe=6ADCA913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1087774327084365", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623131_1087774333751031_2664518515079207384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2zhOQOm5wQQ7kNvwF6RORz&_nc_oc=AdqMu8_aSdiGW6JA7pGKdjUUd78fWjkOGKd3pWFJWPnDfJr8F4-AQ-h9Nr9YDWPF1W4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv6h5iKLAGghwsBpoNEZdZaWOo8ElP3-jgBYpocT42YA&oe=6ADCCEA3"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
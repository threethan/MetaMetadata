=1-7&_nc_sid=6e7a0a&_nc_ohc=n8z_UCpnti4Q7kNvwEpCTyI&_nc_oc=AdpG-AEyuGB-oq3PJ5q6aOdrUu4EalAxYurFOdETUnhgUS50ffcSRE2mCEiM1YeGwS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh4zNTTAij29F7A9QhAH5omOChWXfZUBvvo2dwt9oeMw&oe=6A903C7C"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWXM8CvvbrUQ7kNvwHSflRa&_nc_oc=Adr4oK4vltIE529-bEDMFMNXNHYgXkxwanzP1npm3E4htrOL5DB5RP4k_Yja8NrXfFM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz9tIVv08h8fEIk28J7Kf0AE1gM50vne9WtE1t3BR2Cg&oe=6A90211F"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL70bgyaaRgQ7kNvwExsZsk&_nc_oc=AdpvwbbPG5qAZGdHw_NHRJgvO1r0CVv-7LRA8WfvWl6FikIxHZMBC86LwylqKO3EyfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU-5oqYq6GVZSGHbc7dWck7gHGivRo7zsolhWittmjcQ&oe=6A903213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "4416579875275358", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619187_4416579878608691_690005366641474910_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z88jQ5pKGhUQ7kNvwEKRwXn&_nc_oc=Adq1_yccgy24kkVo93xmAKOOek3K_yv1kxME0ZGhXJFC2SyE3ZOFAyd3woWfUJ2vmpk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkZAD2Jsu1rJVZN8GigpinLafi6G-ptKhyXSo0OSOvtg&oe=6A903913"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_track
=1-7&_nc_sid=6e7a0a&_nc_ohc=ed0OpsH-TK8Q7kNvwG9XRrZ&_nc_oc=AdpYiLTcj-Ti5qOgu0jOTrmdOJrktzDOrJLB7qaSNWK4c-PljMw0CxsEP3kaOtbhBwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRE6IF4rclSEuBs7vKkgu9lcZGyfSK5LLn0ToxscYXUQ&oe=6A9976FC"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2CH9G2Vqu8Q7kNvwG3qAFD&_nc_oc=AdrcDMuY5Y4lKBqvT3IsEGthmNCtWiV_sYjJCgaY_S5OTGLs3lkJfyjVKLlvLC06jjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJdk01t9nD_U8cwaB5pyrIQQMyoZbFAbZ1aY2c8_EdOA&oe=6A9993DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lNbIeM_HEkQ7kNvwFy5rx7&_nc_oc=AdrCX6ifOgYDfHAggVw1UlphKyqLaZEHyux5XvyuFKGBIlt9uSrIplmm_s_wMj4Dih0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvGgW9fY-ZzL5PLz5i--bgN3jw3G1rHlgtgtHOcvZS-w&oe=6A99A4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "4416579875275358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_4416579878608691_690005366641474910_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5KGe-MIsagQ7kNvwFrEXsh&_nc_oc=AdrPb--FhYzub5XBk7kv1kPsXcjq3StFhkWmw5pBjnqbO3zY63Aai3TiCvSCGdjwYHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe7B64gLdGb1S8tXJkDRylRXsmVBvtW4_nY3yiz3Jq7Q&oe=6A997393"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_track
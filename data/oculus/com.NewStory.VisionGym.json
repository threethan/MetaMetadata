&oh=00_Af8mpmP16uyyTZAKGu7TAJu2-lix0gW-Kp7JgoSwAtjb1Q&oe=6A3AA7DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5A22dBqBZQQ7kNvwExBHsm&_nc_oc=AdoMKhMEyDzmyEGOB_Q3rpJDD9JZM8UBUHqGqP9D7z-M37yx4dnI-xnUs-wpHSG7es8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xJdYuTTFUDPLk401zW58vruPf2_1f09LKghNl9RSn_g&oe=6A3AB8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1286768996867639", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1286769000200972_1653608254129367054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4kCTh8IYlEQ7kNvwGLfIWj&_nc_oc=Adp2i46dFnt7a70tBMupRuICZ2vz59weXSd7bGt-ZZ_L6itqJcGK-SnBsNthzMveS3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A9Bh96jwXN9Ak4bThjzQzXeS7tHGqj9t1HTowfMKrtQ&oe=6A3A9FA2"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26587884770872550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_991150560194375_268409806000775354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjg0qY_136EQ7kNvwEFMNB9&_nc_oc=AdrULHERf7cjWSnjcr5LKaHxO3fmai8gwJGsWYz7DHrYt6CQppmmbi9xFzQ5eYmFiv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bKDoykyI749SzAYsrmVT6rC6tpYQ0Tbxu6Pc8oyPtXA&oe=6A3AB118"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
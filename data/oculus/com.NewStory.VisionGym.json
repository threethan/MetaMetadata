028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_1753979869289361_7256127440492580328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ9kU6ZXHY4Q7kNvwEs8kqs&_nc_oc=AdqCLJNAvMtj7MP1l9bo74P9LF4tV6j3MywvLeKHi_C9ripnfMXtPQXmiYJJ58A93IM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwY4p1yXMPoryqf192UXCz7w5jJaBw7V5JwOQwCRJHTg&oe=6AF0B23C"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txrZXfM0VV8Q7kNvwFW1Vvu&_nc_oc=Adohjb6u_rOnTexwukZJLNytQMUG1xM_RCCp06agsKW4VdiEfYyl-MVKT3A0lq4MMnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUtEqla2_ZsAJ_GzKC5nYXsQWN1PHKl6E87Z2DXCwtIQ&oe=6AF096DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6pXFJuTEZIQ7kNvwH6jiw5&_nc_oc=Adp69_ndjA6mPOKF7HlJqc9g1hfVNCzVK0MmFmoZQbnwpZggkY_5RzsFWBqm0055N6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqsVtjiDLvdDI_uJYFmtzZVOlfTvSJ_oXT2GlEP-jPEA&oe=6AF0A7D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1087774327084365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1087774333751031_2664518515079207384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAA-RyjGPFYQ7kNvwGlOCgJ&_nc_oc=AdrkSjuLILr8HKIQxRJrkT8ZA9sa28MGjfJ9xPUruVflGfK6Ad3YdrL9mK3qlt4JITA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdVilaEwbSWOOEAVBfPz0KrOAduIz7HcM0gEa5kD6QCw&oe=6AF09523"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
IIxuKebTIhR5E56oB3EbHGgGyp-UPiJyQsbFa_Ldo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bW8ecTn9YtmVNFqxAUbIp_-1lzGtW5WKvbHmk-GAjSA&oe=6A4516FC"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olfSLYy0at4Q7kNvwHNsyU0&_nc_oc=AdrlnN8ke8XGBbru8va2Po8f9I0hR8vu3yVqAHVB4Mqil59osUWrXH9x1pITzfRHg6o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sV3qRz7secVxkNXgk9SYkQkvd9HIKoZ2e-aLwu1Sgyw&oe=6A4533DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhPKXSctAhEQ7kNvwHKqsL9&_nc_oc=Adqq86ALg9uNe7TMvbhd_l1oOzw17mzwzOad3c7RmuZi8Efh1MSY7OBDscZI_21cyN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pa-hfMqAVFSo6ScM8lIwNzajcidHrbabLXOSMZ4LDhw&oe=6A450C93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1286768996867639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_1286769000200972_1653608254129367054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pmr9kqM4lcoQ7kNvwF0wEe6&_nc_oc=AdocLYZMEzpyQzD4KrCC0ZFVOYftsm-s57jgGVR3nTL5Lg5iKz_Ol7LAkBg2NlbEQiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g_DKcN3sAPFy6ER-EWdry3i-HcZPArh-bshZyPYEnsw&oe=6A452BA2"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26587884770872550"}}]}, 
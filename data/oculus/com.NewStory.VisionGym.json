028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619677_1753979869289361_7256127440492580328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILKW__QxNJ0Q7kNvwFFDBn2&_nc_oc=Ado4S7IlVxeLP22jvRkLlHOkJUbkam9hUjRcLxJo_0m_QQjx3i3-fy2-289DoDms43Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4NMNZZcnf8Sxeie8_WIic_yF-g9-SzCEVAR5dA810rw&oe=6AE0A7FC"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSnoXxoRCmgQ7kNvwEvb5w5&_nc_oc=AdrOWOmNLmzgfl56nyflLPvOfuj-yY-QTsDGKBLnIqyL3z-_PAvl-xScCFXLfXxmsw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ4Oa812_fP66un9BWK8aXf7JATpbLbCffmWi61bIV9Q&oe=6AE0C4DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9BFpiaFd5AQ7kNvwF6p0hC&_nc_oc=AdpeCJO06bdqs9e-YIom7gKV4rvzgFsR9PVgooAquFIokC5jnQMTmk9XXAhtGclGv5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKoW9YA4REljTix9XVGq77OHJQl-pi9dl-zFVErsziuQ&oe=6AE09D93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1087774327084365", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623131_1087774333751031_2664518515079207384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5xQEoWbfn4Q7kNvwEViAF2&_nc_oc=Adqo_Auct_a0gfMRA55clSnNIhGTEq935yMYRVQnuRho90xTAsgw2n3Lbv8bHBP2I4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHdrAznFp9KqnqVzoiylr4cCouoCAUAaVF0FrYtO2Vyg&oe=6AE0C323"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
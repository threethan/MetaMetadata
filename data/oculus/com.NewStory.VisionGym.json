dhXJrcAfLTk24kGx0q3dQWbyrJSWJJ9AIBZHC_7C8wLnhI3VSXHDB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2sheFTmnqtxKph-iAPIOEZ7f872mnziaInvsw_Me37Q&oe=6A6234DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjxF4mdJHf0Q7kNvwEagoI0&_nc_oc=Adp8v50zIMINTOy9obOhSt89hL2GKaY6TvgUO7kuIeppUuXJDuJcGwbngABlYYszvo8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDdRW7wb2s2xHjskDuH9LceUH-oQjhzFLX0HXjMIQldQ&oe=6A620D93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "4416579875275358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_4416579878608691_690005366641474910_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pL2OlwtMVwQ7kNvwGKrd2N&_nc_oc=AdqNGhDCSP7RP9_FI7ngEtEuOn79pLFRrz1tn7_S6MgRkJzBAEdpEZuPFSmawX5JsiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-3zEOYvIbhKjv90wJgxsbe8FwmJmEdHdjokFiHtgPMQ&oe=6A621493"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27368189546175398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1676906300202915_783929729996441473_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6rSc7w1vBIQ7kNvwEnbGm4&_nc_oc=Adp5lg_ydQqD5m8PqkvNx4pCNb87sOcpEUDKm-9mBsQ697WQaPMwJT8St5bC3-x2Au0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmbvOcgm0s_uc4i-P3OaWzuyw2
I-4_Ym8SPhNU2XeX8l-LMFVZw1dhVLKnKiqHEw&oe=6AF48B5F"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKAepUV6l0YQ7kNvwGTrHdk&_nc_oc=Adqqyh33DAa9vArTlBvZn1LVG_AlASV9GlL3pj2nqi3zyf_ooykl3327h6lRJGQBxGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1i3Mz-NgkQ0W8O5otGfP3AZS2FcB7_bEWfQi8x3dKpA&oe=6AF49C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1286768996867639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_1286769000200972_1653608254129367054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsUw288nf-AQ7kNvwFNdslc&_nc_oc=AdqFTs3y8qRaVgXpX5c4I6v3g4wrjzxp4daqUXjOrbh-nmVilg_ovZN-QfezHlDEDoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzR1TR1My0JqGOGnvQl1Zzns-jAlVYm4Uxz1JkDMKehQ&oe=6AF48322"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26587884770872550"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4557702751183453"}]}, "baseline_offer": {"id": "4557702751183453"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781832960, "status": "PUBLISHED", "id": "4557702751183453"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27288283514166002", "version": "0.0.2"}, "id": "1285327206434430", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {
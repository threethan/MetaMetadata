=1-7&_nc_sid=6e7a0a&_nc_ohc=OJi9bWfE80IQ7kNvwES2Qnb&_nc_oc=AdpCK92xNrvRUtmnwKg8h_fR5dtHPktzEVfUfNN7NFefv7QducQ_O6-s_-UFoRl4Eq4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3QIBCNX4YanOWloptEKVBsJn7ghnoCoPEsgMwmVzU9w&oe=6AA00E7C"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSAE7dyvVEIQ7kNvwEy5pWl&_nc_oc=AdoFkmcb3Xf1YYqRtQ8BmCfQjArEJlNz_aqtqcyfN66DV8RgSRBcst7ia3517luplFE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLsPaMgS_JuNZo7Yo8Uzvf8jLylbka6Dh3ZDztjBJTSA&oe=6AA02B5F"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8aCng_UOfQQ7kNvwEumQnX&_nc_oc=AdoObknDKlpOniqmKS8518W8ko_AMim4kaKAHmsdhqfIVP6aU6xdIfhn7546ncPup-I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuIOClaNv0DoTWsdi4mNatNDqDLtI60WagBFagnW3ZDA&oe=6AA00413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "4416579875275358", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619187_4416579878608691_690005366641474910_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNAn5pklsokQ7kNvwGjxBOs&_nc_oc=AdqLUxwlXLTrncFXP3qG5CpY_rQwQdV5xOSMAVHyckK8IW9XRvU_25t19CiU_tuo5ew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnsnud0lOxTc_O7XiozYQWhN8ai5o9y9EdZwOzjl0n3A&oe=6AA00B13"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_track
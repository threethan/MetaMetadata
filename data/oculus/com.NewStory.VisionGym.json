e=6AB6869D"}, {"file_name": "03.png", "id": "1753979865956028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_1753979869289361_7256127440492580328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzxb_Pno3HwQ7kNvwHfsYps&_nc_oc=AdqgNqgJoMBIOLqPtWyzl6HnyQROy5RnZOjOgcAS5VGnuSYWo33UN7Y9-GlNVTtaf2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL1TUMN0fxxAEV5nD0q265O5B3DbLprCJU9FEaaS2R8Q&oe=6AB677FC"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGdEBWQzv7sQ7kNvwFoRZpH&_nc_oc=AdqHnskhgP1LJ5TVwho6HHdTOb5zVs5QL4WXZeJXr_HiOaaj29vYAIUjZhVO4E5-CKw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcQeDtY39KHOPdoovIceC8HPJ8MwqDc5aGKryx2buyEg&oe=6AB694DF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz2KF6Jk5KMQ7kNvwE0kXKI&_nc_oc=Adoq9PYqAPw5fNiwpiyPYsPl___dyAY-RBHj9Uc4OUFS_-AzJtnXXoLqa1JIFv47noo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKldmtN_TpFdf25TitoBI-43Z8AhRYzYFIHMhjZJlruNA&oe=6AB66D93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png \u306e\u30b3\u30d4\u30fc.png", "id": "1070229909202670", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619059_1070229915869336_7506106983606008078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa0C5exs5j8Q7kNvwESIHwg&_nc_oc=AdpNzKIPHMIFTvXeLFyvlmwIXjNepjwOyYEJsi9xh1ofcfg-rlycf5NLg3XDTANapvY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhhx_uZJyt1KmnaOmAYq8ykuT06azc5FrP7oPwDSH2Kg&oe=6AB68F62"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": 
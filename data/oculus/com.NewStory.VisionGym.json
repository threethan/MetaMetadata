O7PA&oe=6AAE9D9D"}, {"file_name": "03.png", "id": "1753979865956028", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619677_1753979869289361_7256127440492580328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7DUXjpfvU8Q7kNvwGz0ROI&_nc_oc=AdqNb6ANRM1Es7ofh1Cc45_RrKJxwhN0FpEyE5eDcGNz4NOHgQ3RvxNUQVtxwAcz0FU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXWbhZnSc7ZRr5CMzai-GujFuCimgVAM5Tu8KOuimhcg&oe=6AAE8EFC"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bl1LrbCt-IQ7kNvwHO733a&_nc_oc=AdqD-ZPLoSYUheu2gr34sMnkro5vf4IRIOo7dkEOsoyz7WY3nz2WUJ85X6e85dnHmX4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKxj_f9hk981HUf5aVA8EcUIjn-QC8a2ERoZ7wtSQSxA&oe=6AAEABDF"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgd-Pt-nDUkQ7kNvwHovuR3&_nc_oc=AdqJA5JgaYKybi9YYpTukSeaa5PKkXjEvwC7gb22cEeUwCHWYvouvaQzfbetrL7oHFg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEC3sryntMCjPlGaCmx_60v8X4uMTuor3N79BU0Y7htA&oe=6AAE8493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png \u306e\u30b3\u30d4\u30fc.png", "id": "1070229909202670", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619059_1070229915869336_7506106983606008078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpOO4CdvfZcQ7kNvwGlnCM_&_nc_oc=Adr5UugxNjkNYLqCNRQ1TANneLraUPvVbVdDOt9ZjlJBuebzIJbNXhgI9HqiOvmkZ6E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEQE-vkxfO_iAhxwvcA6k7ozdnrc84BIic-ZO3j1q2vQ&oe=6AAEA662"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommend
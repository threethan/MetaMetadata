e=6AAD4C1D"}, {"file_name": "03.png", "id": "1753979865956028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1753979869289361_7256127440492580328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM7_U9GT3-8Q7kNvwHcC1bn&_nc_oc=AdqhXF5tf38S8-Ut4jF2-uf9f5jgJB5KwNI7LIBPQ3FYkOSCJHSmdeuvZniQHvfK_aU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1OApQFrxskkfubvkhSiFldqT2SaRh03cnBD8I0GNmeQ&oe=6AAD3D7C"}, {"file_name": "04.png", "id": "2400470150430653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499625099_2400470153763986_8455831720823063715_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v5j0Hf-CHgQ7kNvwH-fuef&_nc_oc=Adp8aVYqKeVcRMKfY03qQZHXFhFwpYkyYT5MzOsBp4e3AIgYdzawE1FWQt4AzG01pLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzz9JuwE7bFbKSGzPJQXLdU1v8X1xZ0AWcdQVPFX2jfA&oe=6AAD5A5F"}, {"file_name": "05.png", "id": "1556255462550476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1556255465883809_8906725859735808408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfKVVlto7EUQ7kNvwEuh8Ay&_nc_oc=Adrflf8lAKniVVWdIi1tHEAB3EY4W-3iwSaaTaT091R8VuuMOSnIjyTRUoyyRMT5yhw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5gyHQSQi5kBbPcZHNryzklhSMk_LSp_mDEx3vZdGXUw&oe=6AAD3313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V5.png \u306e\u30b3\u30d4\u30fc.png", "id": "1070229909202670", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619059_1070229915869336_7506106983606008078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpOO4CdvfZcQ7kNvwG7qebT&_nc_oc=AdoJsIGicWkKuUrYutyKrjdgQwqST3Kk363hTyRDztfBl_YxKaja8khE02mBiBv-WyM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnXjI-PK9oRSwbUJWogLlla7eNjL1WNXjNgU0vplcz0w&oe=6AAD54E2"}, "display_name": "Vision Gym : Hand Eye Trainer", "keywords": ["Focus", "Reaction", "Visual", "Tracking", "Casual"], "long_description": "# \u26a1 Make Fast Visual Challenges Part of Your VR Play!\n\u3000\nLooking for a quick, active VR experience with colorful visual challenges?\n\n**VISION GYM** offers engaging mini-games in a vibrant virtual environment.\nFollow moving targets, react to changing patterns, and take on short challenges built around **focus**, **tracking**, **spatial awareness**, and **coordination-based gameplay**.\n\n---\n\n# \ud83d\udd25 Key Features\n\n# \ud83c\udfae Immersive Visual Mini-Games\n\nJump into VR challenges featuring moving targets, depth-based cues, pattern changes, and fast visual action.\nEach session is easy to start and fun to replay.\n\n# \ud83c\udfaf Timing & Observation Challenges\n\nSpot targets, follow motion, and respond as patterns change around you.\nStay alert, keep your rhythm, and see how well you can handle each challenge.\n\n# \u23f1\ufe0f Quick & Accessible Play Sessions\n\nDesigned for short sessions whenever you want a quick VR break.\nStart fast, play at your pace, and return for another round anytime.\n\n---\n\n# \ud83d\ude80 Ready for a New Kind of Visual Challenge?\n\nPut on your headset and start playing today! \n", "short_description": "VISION GYM is an immersive VR space filled with dynamic visual mini-games.\nTake on quick challenges built around focus, reaction, visual tracking, and coordination.\nStart fast, stay alert, and make every VR break feel fresh! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": 
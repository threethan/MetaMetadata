zbHoIJamG1-55gChIoSQ&oe=6B104090"}, {"file_name": "03_DodgerStadium_PitchingChallenge.png", "id": "2084268368882493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2084268372215826_661189954646180245_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvTMnzSqTcQQ7kNvwGUSB2a&_nc_oc=Adrm_HU9agjrpvywL_ZLuPL37PmYje1S8jitdyb8IEyIf_VVtJSDdUGcyMGQ6_uSHk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXI7pSpTiwJSt3W9RxQifZ18BiHFahfXDpFNMkBC3uyWQ&oe=6B105E00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Champion Pro", "keywords": ["Baseball", "Derby", "Pitching", "Sports", "Batting"], "long_description": "Step into the batter\u2019s box. Take the mound. Get behind the plate.\n\nBaseball Champion Pro is a physics-driven, single-player VR baseball game built around batting, pitching, and the moments that decide every play.\n\nBATTING\n\nSwing with your motion controllers and feel how bat speed, contact point, and bat angle shape the result. Find the sweet spot, send the ball soaring, and chase your longest hit. Impact sounds respond to contact quality, making solid hits and mishits feel distinct.\n\nPITCHING\n\nUse your own arm motion to throw to the plate. Aim for the strike zone, control your release, and challenge AI batters that react to pitch location and speed.\n\nCATCHER MODE\n\nReceive pitches, frame borderline strikes to earn points, and block balls in the dirt.\n\nPITCHING CHALLENGE\n\nTake on target-based rounds, aim at the target panels, and track your best score.\n\nHOME RUN DERBY\n\nRace a two-minute round, hit distance targets, score bonuses, and set personal bests for each ballpark.\n\nEXHIBITION VS AI\n\nPlay a three-inning game against AI. Bat in one half, take the mound in the other, and rely on AI fielders to make defensive plays.\n\nChoose your challenge, sharpen your timing and control, and come back to beat your personal records.\n\nBuilt for solo play, Baseball Champion Pro puts the feel of batting, pitching, and baseball competition right in your hands.", "short_description": "Step into a physics-driven VR baseball game. Swing for home runs, pitch to AI batters, get behind the plate, and take on Home Run Derby, Pitching Challenge, Catcher Mode, and solo Exhibition games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399408836594711"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624577_1146944507986700_813433156507407505_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAdSwoy2rmEQ7kNvwGABm4h&_nc_oc=Adr_xAxMVNDI1oPdpaITDLXKkmXGmQd8-Z7BtLgeWrKTnXkG3zozGgotjl76PjZ8RQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAFQ8aAmPqDeKFcA_pLaSf7QwLArbjTTVyiseU4cHLuw&oe=6B103A2B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baseball Champion Pro", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
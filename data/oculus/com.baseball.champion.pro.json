rf-jdQ2q4baHZJL2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1s11HifWHj93PiPS8lUzyg4f_vqcgBm86U1qr5b_XJg&oe=6B105B53"}, {"file_name": "04_Wrigley_Night_Catcher.png", "id": "1014912938295159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593875952_1014912941628492_538930303201432601_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag9g2amQzzEQ7kNvwFXUAGx&_nc_oc=AdrtJGFXnMhWuAQxuSdpTuL_xISHjzETtZZ9gW7QzelnAcIht7sKewumiUJrdURiUjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4btI_9IL4Vvls4kW8_MwetvCy-F8i5FSabj5gY5VdZw&oe=6B106968"}, {"file_name": "01_Fenway_WalkOff.png", "id": "2146452932641978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622153_2146452939308644_7684712560379167878_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmVYHLm_3zMQ7kNvwGrxov9&_nc_oc=Adp_iRqmN-SO3N8ocK2UmbUAsn1DjXhV4HepTJg69xmy8OiCJsKR2GNUTHluF7EanCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQNUqgmMQR2wvgryY4EO0mK7SDSR8lh943xzWSIPz7Mw&oe=6B103A38"}, {"file_name": "05_ClashArena_Arcade_PowerSwing.png", "id": "1151304917322241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622184_1151304920655574_122590520538086345_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytlP5L2wXIsQ7kNvwExQWqn&_nc_oc=Ado36WuBBpGTAwnI3yT6zL1mwa8pM0xTi-qVzQZJ6-jtPTV6IzepS-0uqy3OMmZmOEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZF1hjKJrAAIVrARXh1cNEuWzbHoIJamG1-55gChIoSQ&oe=6B104090"}, {"file_name": "03_DodgerStadium_PitchingChallenge.png", "id": "2084268368882493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2084268372215826_661189954646180245_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvTMnzSqTcQQ7kNvwGUSB2a&_nc_oc=Adrm_HU9agjrpvywL_ZLuPL37PmYje1S8jitdyb8IEyIf_VVtJSDdUGcyMGQ6_uSHk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXI7pSpTiwJSt3W9RxQifZ18BiHFahfXDpFNMkBC3uyWQ&oe=6B105E00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Champion Pro", "keywords": ["Baseball", "Derby", "Pitching", "Sports", "Batting"], "long_description": "Step into the batter\u2019s box. Take the mound. Get behind the plate.\n\nBaseball Champion Pro is a physics-driven, single-player VR baseball game built around batting, pitching, and the moments that decide every play.\n\nBATTING\n\nSwing with your motion controllers and feel how bat speed, contact point, and bat angle shape the result. Find the sweet spot, send the ball soaring, and chase your longest hit. Impact sounds respond to contact quality, making solid hits and mishits feel distinct.\n\nPITCHING\n\nUse your own arm motion to throw to the plate. Aim for the strike zone, control your release, and challenge AI batters that react to pitch location and speed.\n\nCATCHER MODE\n\nReceive pitches, frame borderline strikes to earn points, and block balls in the dirt.\n\nPITCHING CHALLENGE\n\nTake on target-based rounds, aim at the target panels, and track your best score.\n\nHOME RUN DERBY\n\nRace a two-minute round, hit distance targets, score bonuses, and set personal bests for each ballpark.\n\nEXHIBITION VS AI\n\nPlay a three-inning game against AI. Bat in one half, take the mound in the other, and rely on AI fielders to make defensive plays.\n\nChoose your challenge, sharpen your timing and control, and come back to beat your personal records.\n\nBuilt for solo play, Baseball Champion Pro puts the feel of batting, pitching, and baseball competition right in your hands.", "short_description": "Step into a physics-driven VR baseball game. Swing for home runs, pitch to AI batters, get behind the plate, and take on Home Run Derby, Pitching Challenge, Catcher Mode, and solo Exhibition games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_ter
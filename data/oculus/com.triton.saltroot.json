file_name": "screenshot_05-lumen_2560x1440.png", "id": "1154338860678405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1154338864011738_7473433053993296764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOoL_Iqs6RsQ7kNvwEaVLGK&_nc_oc=AdqKtlXKG38PlUvQ6r0nt6Hoewcf3O6CivimRiWsEhD7SliPVq7gNgJU_yrzI4ATC1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULVmyFwh0R5VJi7xkVhI5xDBgseI7qwQ0CTBAptp-fIQ&oe=6B1043C1"}, {"file_name": "screenshot_01-landfall_2560x1440.png", "id": "1141092561642986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1141092564976319_9140109488710479818_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5emLsL_x594Q7kNvwGofr4C&_nc_oc=AdryS5zx36UGw2sW1qExqNLijAwiVHeOZlf0kZaFjHEdBziD16G6KSwYPpHliAqdYA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUae8WzyGyfxiwR4OGNDu_QxFqcywfs0sb0gwvngvCBCg&oe=6B104C23"}, {"file_name": "screenshot_04-duskwater_2560x1440.png", "id": "1761360495662789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1761360498996122_6132456570793739995_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvEBOydfJrQQ7kNvwGlrvgW&_nc_oc=AdqArnLpm6iWE0G1grZDTjnMlg_KkO-YsVP2qdMa7lYA9B6d2KXpisKRhqdHTYY1VZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8RxP29n2SlI9vK264_Wfdf0xMPQx3Oo-YxUeGUjKKeg&oe=6B103C85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1125090396993655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_1125090400326988_3051018992998532920_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWSgrIjGhNoQ7kNvwHHtceS&_nc_oc=AdpAW1eSCGPRsEqzjfQAxp2Y_SyA0p2xT8N4lmlFElI7EahPrUifyuXVcp326jrTFVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhscOXXZD400EA-HjtRYBsCdalpbhknxtHTBms4q_2zA&oe=6B103ECB"}, "display_name": "Saltroot", "keywords": ["adventure", "planet", "shooter", "scifi", "space"], "long_description": "The relays have gone dark. Their machines still guard the silence. You are a Keeper, sent to bring the signal back.\nSALTROOT is a single-player VR sci-fi shooter built around movement, energy weapons and small worlds with unusual horizons.\nFour missions take you from LANDFALL's tropical cove to DAYBREAK on the tiny planet MOTE, then to its dark-side lagoon in DUSKWATER. In THE LAMP, fly through the Eye of LUMEN and land on the inside of a hollow world, with terrain curving overhead.\nFind the pulse rifle, scatter gun and LONGSHOT as you progress. Raise your energy shield, use the jetpack to gain height, swim for lost equipment and fight sentry drones, robotic Hounds, Mites, Thorn turrets and the Warden.\nRestore drowned signal buoys, wake the Roots and relight the Lamp. Completed missions unlock the next, while progress and discovered weapons stay on your headset.\nEARLY ACCESS\nThe current build contains four short missions across three worlds. This is a compact early-access campaign. Content and campaign length may change as development continues.\nChoose Easy, Medium or Hard. Play seated or standing with Touch controllers. Snap turning and a comfort vignette are available. Smooth movement, flight and swimming may cause motion discomfort.\nOffline play. No accounts, ads or in-app purchases.", "short_description": "Fight, fly and dive across small sea-worlds in this short, four-mission VR sci-fi adventure.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/saltroot/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/saltroot/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/saltroot/support", "website_url": "https://nebulytic.com/apps/saltroot/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603
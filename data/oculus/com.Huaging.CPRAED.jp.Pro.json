6e7a0a&_nc_ohc=P6UHYAUsWaUQ7kNvwHK8MD9&_nc_oc=AdrbgErpC19hwaVWSOkt6AT-1kKwS4GpmpzRLizN7qVa8jT5a30Zd4lzngNbsqEnB8Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uLuNMJgURSFUIWbTjKJglmdh-CaY-kKl2BHal11CLYQ&oe=6A4685D9"}, {"file_name": "\u6210\u7e3e_en.png", "id": "1671976803464492", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823431_1671976806797825_2001451916441531633_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYovc_ztJfAQ7kNvwEl6Usx&_nc_oc=AdptwtT6kdfW_kS0jCIMHADIha9ZfUufcBMqyP4X8VELZDEYLQVTjvMDvg-lWu-8gVU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_mBKPUsqpOlKrlCv4cpBw4E-pWuuVc5a95Oierqs8jQ&oe=6A466012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "2497467740588759", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491825052_2497467743922092_8706235547211159530_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrUZq7IFNHQQ7kNvwGXJ_mR&_nc_oc=AdpaLHBJTvJtyMt4n7AFeEfqgxjO_jqbkfG4KZVzlVnLzv7OIQxmdmGMtGmMbXr2LX4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IEFOfxd7qDVNlWbP14K1nUWJB5SrGanmOAcbCNC05ew&oe=6A4673ED"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, JP)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Advanced functionality for professional education and group training\n\nBased on the latest CPR guidelines from the American Heart Association (AHA), this version is designed for schools, corporate programs, instructors, and group training. It provides a complete system for learning and assessment with enhanced flexibility.\n\n**Enhanced Features for Flexible Training**\n- Advanced settings and customizable options\n- Supports diverse needs from entry-level to realistic simulations\n\n**Adjustable CPR Compression Duration**\n- 30-second, 1-minute, and 2-minute modes\n- Flexible planning for teaching pace and intensity\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio guidance only\n- Simulates emergencies to test CPR response\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring and online record tracking\n- Highlights weak points for targeted teaching\n- Auto-generates reports for progress monitoring\n\n**Supports Group Activities and Management**\n- Multi-user sessions with individual tracking\n- Admins can adjust content and view data insights\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com\n", "short_description": "Advanced functionality for professional education and group training.\nThis version follows the latest CPR guidelines from the American Heart Association (AHA) and is tailored for schools, corporate programs, and professional training. It provides a comprehensive learning and assessment system with enhanced flexibility.\nThis is a subscription-based service. For full access and the best experience, please use it with a stable internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com.tw/jp/collections/cpr-and-aed-PRO", "website_url": "https://www.huaging.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
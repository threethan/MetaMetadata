u30e5\u30ec\u30fc\u30b7\u30e7\u30f3", "\u7dca\u6025\u5bfe\u5fdc", "\u8607\u751f\u7df4\u7fd2", "\u533b\u7642\u8a13\u7df4"], "long_description": "# \u5c02\u9580\u7684\u306a\u6559\u80b2\u30fb\u56e3\u4f53\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u5bfe\u5fdc\u3057\u305f\u4e0a\u4f4d\u30e2\u30c7\u30eb\n\u65e5\u672c\u306e\u300e\u5fc3\u80ba\u8607\u751f\u30ac\u30a4\u30c9\u30e9\u30a4\u30f3\uff08JRC\u30ac\u30a4\u30c9\u30e9\u30a4\u30f3\uff09\u300f\u306b\u57fa\u3065\u304d\u3001\u5b66\u6821\u30fb\u4f01\u696d\u30fb\u6559\u80b2\u6a5f\u95a2\u30fb\u56e3\u4f53\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u5411\u3051\u306b\u8a2d\u8a08\u3055\u308c\u305f\u3001\u5b66\u7fd2\u3068\u8a55\u4fa1\u306e\u5b8c\u5168\u306a\u30b7\u30b9\u30c6\u30e0\u3067\u3059\u3002\n\n**\u6a5f\u80fd\u304c\u5927\u5e45\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u67d4\u8edf\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u5bfe\u5fdc**\n- \u4f53\u9a13\u7248\u306e\u6a5f\u80fd\u3092\u62e1\u5f35\u3057\u3001\u9ad8\u5ea6\u306a\u8a2d\u5b9a\u3084\u30ab\u30b9\u30bf\u30e0\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u8ffd\u52a0\u3002\n- \u521d\u5fc3\u8005\u306e\u4f53\u9a13\u304b\u3089\u5b9f\u6226\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u307e\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30cb\u30fc\u30ba\u306b\u5bfe\u5fdc\u3002\n\n**CPR\u5727\u8feb\u306e\u6301\u7d9a\u6642\u9593\u3092\u8abf\u6574\u53ef\u80fd**\n- 30\u79d2\uff0f1\u5206\uff0f2\u5206\u306e3\u3064\u306e\u30e2\u30fc\u30c9\u3092\u63d0\u4f9b\u3002\n- \u6559\u80b2\u30da\u30fc\u30b9\u3084\u8a13\u7df4\u306e\u5f37\u5ea6\u306b\u5fdc\u3058\u3066\u67d4\u8edf\u306b\u30b3\u30fc\u30b9\u8a2d\u8a08\u304c\u53ef\u80fd\u3002\n- \u77ed\u6642\u9593\u306e\u4f53\u9a13\u304b\u3089\u9577\u6642\u9593\u306e\u5b9f\u8df5\u6f14\u7fd2\u307e\u3067\u5e45\u5e83\u304f\u5bfe\u5fdc\u3002\n\n**\u300c\u30c6\u30b9\u30c8\u30e2\u30fc\u30c9\u300d\u3067\u5b9f\u6226\u306b\u8fd1\u3044\u74b0\u5883\u3092\u518d\u73fe**\n- \u753b\u9762\u30ac\u30a4\u30c9\u306a\u3057\u3001\u97f3\u58f0\u6307\u793a\u306e\u307f\u3067\u9032\u884c\u3002\n- \u53d7\u8b1b\u8005\u306e\u7fd2\u719f\u5ea6\u3092\u30ea\u30a2\u30eb\u306b\u691c\u8a3c\u3001\u73fe\u5834\u306b\u8fd1\u3044\u7dca\u5f35\u611f\u3092\u518d\u73fe\u3002\n\n**\u6210\u7e3e\u8a55\u4fa1\u30b7\u30b9\u30c6\u30e0\u3092\u5b8c\u5099**\n- \u500b\u4eba\u306e\u30b9\u30b3\u30a2\u3092\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3067\u8868\u793a\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u5c65\u6b74\u78ba\u8a8d\u3082\u53ef\u80fd\u3002\n- \u53d7\u8b1b\u8005\u3068\u8b1b\u5e2b\u306e\u5b66\u7fd2\u52b9\u679c\u30fb\u6210\u9577\u5ea6\u3092\u53ef\u8996\u5316\u3002\n- \u64cd\u4f5c\u30c7\u30fc\u30bf\u3092\u5206\u6790\u3057\u3001\u5f31\u70b9\u3092\u7279\u5b9a\u3002\u30d4\u30f3\u30dd\u30a4\u30f3\u30c8\u6307\u5c0e\u306b\u6d3b\u7528\u3002\n\n**\u56e3\u4f53\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30fb\u7ba1\u7406\u6a5f\u80fd\u306b\u5bfe\u5fdc**\n- \u8907\u6570\u4eba\u3067\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u6d3b\u52d5\u304c\u53ef\u80fd\u3001\u5404\u53c2\u52a0\u8005\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u8a18\u9332\u3002\n- \u30d0\u30c3\u30af\u30a8\u30f3\u30c9\u3067\u81ea\u52d5\u7684\u306b\u6210\u7e3e\u96c6\u8a08\u30fb\u30d3\u30b8\u30e5\u30a2\u30eb\u30ec\u30dd\u30fc\u30c8\u3092\u751f\u6210\u3002\n- \u7ba1\u7406\u8005\u306f\u30c7\u30fc\u30bf\u306b\u57fa\u3065\u3044\u3066\u3001\u9032\u6357\u306e\u628a\u63e1\u3084\u6307\u5c0e\u5185\u5bb9\u306e\u8abf\u6574\u304c\u53ef\u80fd\u3002\n\n\ud83d\udca1 **\u672c\u30b5\u30fc\u30d3\u30b9\u306f\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u5236\u3067\u3059\u3002\u3059\u3079\u3066\u306e\u6a5f\u80fd\u3092\u5feb\u9069\u306b\u3054\u5229\u7528\u3044\u305f\u3060\u304f\u305f\u3081\u306b\u3001\u5b89\u5b9a\u3057\u305f\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3067\u306e\u4f7f\u7528\u3092\u304a\u3059\u3059\u3081\u3057\u307e\u3059\u3002**\n\n\u672c\u88fd\u54c1\u306b\u95a2\u3057\u3066\u3054\u4e0d\u660e\u306a\u70b9\u3084\u3054\u610f\u898b\u3001\u307e\u305f\u306f\u3054\u63d0\u68
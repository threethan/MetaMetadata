": "284449944739034", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75568720_284449948072367_7528920689541978150_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad5exdRIpuMQ7kNvwFPoavn&_nc_oc=Ado53oGevqaqvAmknExNbem0kCcjYSA2TvTZ0cRDqhqWH7SJC87ZxgR7Tv85ia2-eCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3zp2Rn5DyBrst90CNMU9xHiXQJ1yQltQp8YtOzK-q20w&oe=69F0AB88"}, {"file_name": "Screenshot 2024-05-10 at 5.35.39 PM.png", "id": "2369945286543714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982533_2369945289877047_174829483547829698_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOpVjRzw2x0Q7kNvwF5RiF5&_nc_oc=AdqjeTENYug5eePpt8DOKvcAHWTssXpz4oWJF88lkHR8ni4VqMCnVODszLDBvuFPE6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3H8Ot7UFXti7eH1EgbetFYM9-eePbU0Qc1RJc7kd6P7Q&oe=69F0B246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-10 at 5.35.39 PM.png", "id": "751568443832436", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035344_751568450499102_2791546685194487866_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V8g1z9O-bQQ7kNvwFSUw1R&_nc_oc=AdqeHYZ1w16eJ9JeVCpViL1-ngAeiVPDuJ3i1e8k4G9_dcD2QwGWqgPwDvnlUJn7wPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af05rb5BiK9DoOArVKcFCB1OoFiJqRCHtmb7rhJTbDkyxA&oe=69F09EAF"}, "display_name": "COMIC! - Read comic books in VR", "keywords": [], "long_description": "Put your controllers down and just use your hands :)\nCOMIC! has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping with your hand open.\n4. Choose the environment you want to read in.\n5. Choose from 25 free comic books to read, with more coming\n7. Drag and resize your reader with your hands", "short_description": "Put your controllers down and just use your hands :)\nCOMIC! has been made for the p
": "284449944739034", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75568720_284449948072367_7528920689541978150_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJpk7wT13VEQ7kNvwEMqF85&_nc_oc=AdlS61PavaP4HggEFf9O-QSC80JJv0Jd_jEh9BcvxKf_auBnD8d7SE3NaACLH6nmFes&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftwfBLoA7uQowu5Zp1TsJ-E-zZFxOhbCb3p5lQmuETnUQ&oe=69A19188"}, {"file_name": "Screenshot 2024-05-10 at 5.35.39 PM.png", "id": "2369945286543714", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982533_2369945289877047_174829483547829698_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yinqDX_p5kQ7kNvwGCMPHm&_nc_oc=Adkl0TYvJp_Ts-9eKBi4jQs0LvMKETc22UXze1xNO5i1aTHF0_66wCT4_s2EDxPjAcQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs-dXFbbPmVmI0nlS5RCqp5CBqxIsIUGF3GR6L4e911sA&oe=69A19846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-10 at 5.35.39 PM.png", "id": "751568443832436", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035344_751568450499102_2791546685194487866_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlMqbRhFxB4Q7kNvwEX4Wu_&_nc_oc=AdkQOgd-4eGN3ZZ3eccbSryAG8nMDBmg28EDU2FhSVKsdcSEpk5FDXoPKJYqmXAXZI8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuYhKFpmOThympxkU1ID-kG3pxYXkqFuE7STkU2fUiESg&oe=69A184AF"}, "display_name": "COMIC! - Read comic books in VR", "keywords": [], "long_description": "Put your controllers down and just use your hands :)\nCOMIC! has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping with your hand open.\n4. Choose the environment you want to read in.\n5. Choose from 25 free comic books to read, with more coming\n7. Drag and resize your reader with your hands", "short_description": "Put your controllers down and just use your hands :)\nCOMIC! has been made for the p
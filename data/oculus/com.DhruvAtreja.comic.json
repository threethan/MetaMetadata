//scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035344_751568450499102_2791546685194487866_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzj0psax-ecQ7kNvwE8UGRE&_nc_oc=AdqlTwQ11l9CyvzSxfuF6RqAHFLHx576KnVKtOnD5s4JkGCPcmKudLRIdwayws0GCrM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe665Up-13Mv74qPRtXcG8zpnhH7QDFRH1PL62PHlZZw&oe=6AFC776F"}, "display_name": "COMIC! - Read comic books in VR", "keywords": [], "long_description": "Put your controllers down and just use your hands :)\nCOMIC! has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping with your hand open.\n4. Choose the environment you want to read in.\n5. Choose from 25 free comic books to read, with more coming\n7. Drag and resize your reader with your hands", "short_description": "Put your controllers down and just use your hands :)\nCOMIC! has been made for the pleasure of reading in VR. Now you can:\n1. Read in peace and isolation, without distractions\n2. Read while lying down or any other position you're comfortable in\n3. Sift through pages by just swiping with your hand open.\n4. Choose the environment you want to read in.\n5. Choose from 25 free comic books to read, with more coming\n7. Drag and resize your reader with your hands"}]}, "developer_name": "Dhruv Atreja", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m1Z9W-3vAL0fVlY_m5Kbez-wTn6mxyCmrLx-LSAkDtU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dhruv Atreja", "support_website_url": null, "website_url": "https://dhruvatreja.my.canva.site/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres":
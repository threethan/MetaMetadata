7kNvwFLV8-6&_nc_oc=AdoA9rqfW-2w_Hi8S3HUUK_ZEGaT5nQuGlqO5WPZAQPXi4UUDSARoeLGrBHww8hEypA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrAp-w7ik5sc6noiHGnR98x0Un6XGsyPpDnCYI4Sb3Og&oe=6A4A6757"}, {"file_name": "Screenshot4.png", "id": "1773812614005276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_1773812617338609_1557804588925817597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNuZxZ2uiPEQ7kNvwHbBfFy&_nc_oc=AdrX2AVA_dN2k2gou8OtygoS5QMZRgwzYVfAB3CT9iWi5GE32s9Mm9C6E4bU1A6fj3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5I0yACkihepBG6hL78Byhw4xTmGEMGkeOpKC7OkAEQg&oe=6A4A5952"}, {"file_name": "Screenshot3.png", "id": "1245522394351201", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293669_1245522397684534_5430883541102569873_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-rmVbgUrzcQ7kNvwEp2Hku&_nc_oc=Adogn__NsOGn1m3taNv26C6FbZDpO7FypfMDWgYbyUASgMC9EomfEX0IyDbCqwSKjTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzA5BGWA6dl4GLsibwjT7wNY8R3foUcy2XqAsvLYbFMQ&oe=6A4A7003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2016354412534447", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617775_2016354415867780_7586067622095076194_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq2CLVmzQy4Q7kNvwFqLDUC&_nc_oc=AdpzGwKgoAVMUTShc1a7Q6bpp71dtoAKm2Nd5fNlk9klkpvwCcaoCeFHWVDy0qgqSwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_DoUHc7b7LJyLd6KC574zX9WXlZQTLVv3oVhlOTGF1w&oe=6A4A6BF3"}, "display_name": "Solitaire.", "keywords": ["Solitaire", "Cards", "Klondike", "Spider", "Relax"], "long_description": "Immerse yourself in the world of baKno Solitaire, a collection of the most beloved solitaire games designed in the signature baKno style. Prepare to be enchanted by the beauty of the handcrafted card sets, showcased in a mesmerizing 3D view that brings the game to life before your eyes.\n\nbaKno Solitaire boasts a diverse selection of timeless favorites, including Klondike, Freecell, Spider, Cruel, Canfield, and Tripeaks. Each game offers its unique challenge and rewards, ensuring hours of engaging gameplay. As you delve into the solitaire world, savor the original and soothing music that accompanies your every move, enhancing your overall experience.\n\nSolitaire is not only a fantastic way to pass the time but also an opportunity to exercise your mind and sharpen your strategic thinking. Step into the realm of baKno Solitaire and discover the joy of organizing cards, planning your moves, and achieving victory. Whether you're a seasoned solitaire enthusiast or new to the game, baKno Solitaire offers a captivating experience that is both relaxing and stimulating. Give it a try and let the cards unfold their secrets before you.", "short_description": "Immerse yourself in the world of baKno Solitaire, a collection of the most beloved solitaire games designed in the signature baKno style. baKno Solitaire boasts a diverse selection of timeless favorites, including Klondike, Freecell, Spider, Cruel, Canfield, and Tripeaks. Prepare to be enchanted by the beauty of the handcrafted card sets, showcased in a mesmerizing 3D view that brings the game to life before your eyes.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bakno.com/Corporate/privacy.html", "developer_terms_of_service_url": "https://www.bakno.com/Corporate/license.html", "publisher_name": "baKno Games", "support_website_url": "https://www.bakno.com/Support", "website_url": "https://www.baknogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
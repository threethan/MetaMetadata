703165", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931338_3005405403036498_7358379697398184942_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hj4jdbZta-EQ7kNvwEtfvbw&_nc_oc=AdnGIdcvdDazHZ2sDSN8X-L4q2EIT15KRazw47bZntEW2M2YEqv6gw58l3C6nM0Wc-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftaJysus-CG29EDm0_GxqKkq_RPhsqWeZawkH5pHCGfwg&oe=69A6D37D"}, {"file_name": "Screen4.png", "id": "908490183090397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982601_908490189757063_3319645537483989071_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3_jTjGMktoQ7kNvwHhyQB9&_nc_oc=AdlwSxLMHYUB9r0cL1t-6bbhJuna4Gxx8iHScw6OAS8OnJcRbvTxTksVPaNZyT40e4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQGGkVl1h_5dLZ4Wd_wo2V1K4Rliz6qwBe7K1JnxCnFw&oe=69A6CB23"}, {"file_name": "Screen5.png", "id": "558944872024049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_558944875357382_5351134088631792205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN82kadKFaQQ7kNvwGB0iua&_nc_oc=Adn8njPurjHjWj8SrIxzZyTypIg0AxL9n7L_YiBIVgZVchPoSnt0rm00HUNRzHTJqmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft6wLsGWephKvLZ25j3qVBJkZDNpVMg4uUS2NNtQSyJow&oe=69A6EB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen2.png", "id": "377912957158275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_377912963824941_6368050802368167649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-vnp7C6He8Q7kNvwEyhZmp&_nc_oc=Adlla42Er2RuoljNVlAx3fb4sWK_CkYsEaZEeWeXsDOEWzSRQHTWRXUJ11aloFlaO-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlEt3OX5eWuLEpsg2LcfHiuYD2RrdTyjc2dalZpOmORg&oe=69A6D177"}, "display_name": "Yue's VR-FPV-Sim", "keywords": [], "long_description": "This an easy way to experience FPV and Drone Flights in Virtual Reality with Oculus Quest.\n\nFlying FPV is not easy and especially for beginners very challenging. So it makes sense learning to fly in the Simulator first, before crashing hundreds of Dollars of Equipment in to the ground.\n\nFly Drones with or without FPV Goggles!\n\nCompatible with a Gamepad.              \n\nThis Simuator has a total 7 Scenes including\n\n    Game Play Tutorial\n    4 Multiplayer Rooms - Freestyle and Racing\n    2 Maps that include Pylon Races\n    2 Arcade Minigames\n    2 Training Maps\n    Experimental LAN Multiplayer\n    2D or 3D FPV Screen\n\n                                                                           \nEntirely Physics based Simulation\n\n    PID regulated Simulation that can be tuned\n    Bahaves as a Physics Object\n    Hovereffect                                                                                                                                                         ", "short_description": "This an easy way to experience FPV and Drone Flights in Virtual Reality with Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-vr-fpv-sim/", "developer_terms_of_service_url": null, "publisher_name": "YueBeifong", "support_website_url": "https://yue-beifong.jimdosite.com/support/", "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "2403051929831854"}}]}, "scheduled_offers":
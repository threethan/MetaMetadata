.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3BR2OkuMWAQ7kNvwF30o7O&_nc_oc=Adpj6s4ZDHge6j8jECLiJ4MrmorvI8nyyVQnUwgrChwA5oZsuhxwh1ecPH6-EgG-oLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw2YtnF7dvdlQcNMnUakY1TsOXyu2kc9C-_i8ZUKjX7A&oe=6AFF0282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen2.png", "id": "377912957158275", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974878_377912963824941_6368050802368167649_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBg4XjrNLWwQ7kNvwGk9byf&_nc_oc=Adpc5wXDIMrwZtfjd492mNg7OgWR66EdUw3vHI41p5dzqTe0yexq_I7jwpl28zdaPBQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcwYVMnNus_tznx0KkMtobE0jsR858pbMfbP5h0__2hA&oe=6AFF2137"}, "display_name": "Yue's VR-FPV-Sim", "keywords": [], "long_description": "This an easy way to experience FPV drone-flights in virtual reality with Meta Quest.\n\nFlying FPV is not easy and especially for beginners very challenging. \nIt's save to start in a simulator, before crashing hundreds of dollars of equipment in to the ground.\nFly drones with or without FPV-Goggles in \"Yue's VR-FPV-Sim\".\n\nStart with the guided tutorial and learn all about the gameplay and how to control drones in \"acro-mode\"!\n\n\nTotal of 9 Maps\n\n\u2022 \"Industrial\" 1, 2 & 3\n\u2022 \"Secret Testtrack\" with a driving car\n\u2022 \"Skilift\" with a moving seatlift\n\u2022 \"Hangar\" with a private-jet inside\n\u2022 \"Super Market\" \n\u2022 \"Parking Garage\"\n\u2022 \"Mountain\"             \n                    \n                            \nSimulation Properties\n\n\u2022 Rigidbody Physics, parameters configurable\n\u2022 PID regulated simulation, parameters configurable\n\u2022 Hovereffect\n\n\nGameplay Properties\n\n\u2022 Compatible with a gamepad\n\u2022 Seated or roomscale  \n\u2022 Acrade Mode mini-game", "short_description": "This an easy way to experience FPV and Drone Flights in Virtual Reality with Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-vr-fpv-sim/", "developer_terms_of_service_url": null, "publisher_name": "YueBeifong", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7977855408925469"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569472_291967832337244_9072973615608413629_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQDvj16EIcQQ7kNvwH76ARb&_nc_oc=AdrhQev55EuoJAW22DSnvcLHe1u4ZuQg3iS5JgVteIZxc3BZGWHE8mo4eQRl0y-pngA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMA52WQW89Ky075y9p0qOwlh6aF04UO6RrYLUpzedwxA&oe=6AFF1426"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Yue's VR-FPV-Sim", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1635371047, "lastRevision": {"nodes": [{"id": "102187342225844", "release_type": "SCHEDULED", 
uluscdn.com/v/t64.5771-25/38982484_510598874883965_1955532416435314891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL3pxyOG6b4Q7kNvwF3K5cE&_nc_oc=AdrHe3ILFELAsOV2ht6vmlY1M8oZ7BVDSBNptx5yYXQ8WIC42w74p1VVproRiqnuqVk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSP7ZRpWz_q0_wx76jy951uY3eSydfPpe4Mve37xYI6fw&oe=6B0B362F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5bb9\u5668 317@1x_\u526f\u672c.png", "id": "750260607126786", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982483_750260610460119_8049027481302987210_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1w89kMtbjwQ7kNvwHR2OP6&_nc_oc=AdqeQx6hqRnM5gi7E3JfCyKGxJEND6x-fGCvTXlxyE_y_TceiImx-4BgsrA8zI8bePE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqERMisv3-wQNYzdIo1Cc1TQg-oDvM-V4J5Kq43B9Xkw&oe=6B0B40EE"}, "display_name": "Poetic Dance", "keywords": [], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}, {"images": {"nodes": [{"file_name": "20240805-155222.png", "id": "1696540241087677", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/54770914_1696540244421010_724349100188658269_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3HIWvxdA3UQ7kNvwH01A2M&_nc_oc=Adr2qAtHgZHDFDgHkTycIjy5e8KhrY3JTEXDsGdHaizYnJkbJMiqHM7HXV4QoSwyIFE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXhv3aLFfYVBNh52NIwo8MmKZvHoskb8TJ3kk0zjo6pQ&oe=6B0B3570"}, {"file_name": "\u7ec4 344@1x.png", "id": "1263677808416788", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974888_1263677811750121_5447872420596645171_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOdg4k_dtOAQ7kNvwGsh_NM&_nc_oc=AdrPM8p40c5mfzeEPl_8vcY6UKugQAcejGotjpAtDX5u0SKjh7lCLcULw_9Xj5BE5Hc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNnh9bB2Xupcd1NeDn4O52n5bKS_2m6o5zPLHmCZAQ7Q&oe=6B0B1774"}, {"file_name": "20240807-155627_\u526f\u672c.png", "id": "1035260088203075", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035308_1035260091536408_3276939169422989872_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SYd8MGFzukQ7kNvwEiOTor&_nc_oc=Adrbe6q6s6X2QxidPEV8MMYE-38TqrTnhSCkFQ566VEzTiCcuY1AIk5HXyXwFT9gUjk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxiTJuWujc0T1GxaWaQeHlzx3IeQBf_uPClGxIc44LoA&oe=6B0B174C"}, {"file_name": "\u7
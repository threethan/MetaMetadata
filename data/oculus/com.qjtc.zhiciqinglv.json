uluscdn.com/v/t64.5771-25/38982484_510598874883965_1955532416435314891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6hUFNGqykoQ7kNvwHrsL1r&_nc_oc=AdrgWR1YEYpBqR61phBsr0i6kwrgjkvXKp2Ejv_Pn6BPKGSn8E1_1UZNdvHMnKoVJVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOK0rCXRMcowWGVpy1yeD10XaSBiiWb-OGvriSe6I-TQ&oe=6B0314EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5bb9\u5668 317@1x_\u526f\u672c.png", "id": "750260607126786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982483_750260610460119_8049027481302987210_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFtSGHLe9-0Q7kNvwHP3Wsi&_nc_oc=Adrzk8xi4IrNgEDSASwqtrwWxtwOIC-_1VzXlzelA5I3IAacZi_EYD6lPJuTvKVj360&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTT7DiATrMgN7q3975DNfA9dgRO0vMKIwVM7pI2UnFTw&oe=6B031FAE"}, "display_name": "Poetic Dance", "keywords": [], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}, {"images": {"nodes": [{"file_name": "20240805-155222.png", "id": "1696540241087677", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54770914_1696540244421010_724349100188658269_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhjm3OcNINEQ7kNvwHWlPPW&_nc_oc=AdpCYmlI-WUhMuXvbBPsLcGrl6smB8q3gWpF8eYkx8amCzJQDqd1aMNIMASXDxph2xM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUtdR3DTODCoF6nEOTJXdveSJ-lGKP26PCOXKIzzKo3w&oe=6B031430"}, {"file_name": "\u7ec4 344@1x.png", "id": "1263677808416788", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974888_1263677811750121_5447872420596645171_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2_7KdDJGY8Q7kNvwFA10Is&_nc_oc=Adq7WE4PUDpVC4mHc4CuSF-h6-gSZUfZMpz57OH37BPs49FfFRAygrV_zRHabyo5Ypw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX7kf1oPFEgkBvg3kDE4cZVwCQ7S7F58D4yxguhJ1A9Q&oe=6B032E74"}, {"file_name": "20240807-155627_\u526f\u672c.png", "id": "1035260088203075", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035308_1035260091536408_3276939169422989872_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n6TbVUrcM8Q7kNvwGBC7t7&_nc_oc=AdoPuPBTY965Wq68TiwWO4Om106sGBdUjvRv3i3Hi-ItrIB2ZhcdLXUfK6XZ4rsq3Os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNYVbziJC1CGU4YFWQgD-wH2EGKBeyefdcGY7JF5vn9g&oe=6B032E4C"}, {"file_name": "\u7
content-ord5-2.oculuscdn.com/v/t64.5771-25/38974468_820892786859832_4080045266342485046_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SKoCcl69koQ7kNvwHuWrOg&_nc_oc=AdrGvGO2AR4sxJXHsPzgDptFEGTItUNZlIuTcRM_ScO4qOq7kq2mTLAY7Owyf1lN3rU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUYR3WBpFb98MbvdsLMVsalmD6qe_EwMgC0YOykEmrGQ&oe=6B0DB305"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.50.229_133_\u526f\u672c_\u526f\u672c.png", "id": "510598871550632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_510598874883965_1955532416435314891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A9gChFgPPAQ7kNvwHpWI4o&_nc_oc=Adr2uZdMstQN0ECp-ngLWuX0qCfnorbO_yEMmhAekrhq0YvBBOtjckq1_WaiXXSqRmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTejWrf2UeYThBL05pbgFOZlMOB5cUabqJ_VAO_clkrsA&oe=6B0DA0EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5bb9\u5668 317@1x_\u526f\u672c.png", "id": "750260607126786", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_750260610460119_8049027481302987210_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjEc1qySv-8Q7kNvwFQc9Rr&_nc_oc=AdrlJTRuF0jiVHK8e2CmuGlaNOsXMpLLa_DD-C8oY9P54qLWJLKsByCedFx8VGNFl1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRW26SaJ7IpvcUtbCToZf8R-tVyfiXRym02dUSUH2Lb1A&oe=6B0DABAE"}, "display_name": "Poetic Dance", "keywords": [], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}, {"images": {"nodes": [{"file_name": "20240805-155222.png", "id": "1696540241087677", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_1696540244421010_724349100188658269_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3HIWvxdA3UQ7kNvwHwhnyr&_nc_oc=AdrDMldTLfjni3psYrm_18-AzLRRgeHazbkuQw2mHhIgWXU13dKt9Cmeg-DRE0vjK6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS79ESnJtnzpO6g1Sm4Hbw6ohbnmKagcIHrQOqicctIYA&oe=6B0DA030"}, {"file_name": "\u7ec4 344@1x.png", "id": "1263677808416788", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974888_1263677811750121_5447872420596645171_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOdg4k_dtOAQ7kNvwHFD-h8&_nc_oc=Adp7JWq5zVtWeLtMgGtqQVTw5WoirQ8662oVzCjPFQyLKI3CsLgdCAYh-H5gaTwqia4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSc-oMQbDC3dzavA27Wbe02hf9B8VWeKxAyig
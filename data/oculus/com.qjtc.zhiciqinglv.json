uluscdn.com/v/t64.5771-25/38982484_510598874883965_1955532416435314891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6hUFNGqykoQ7kNvwEE6YCm&_nc_oc=AdonKT9IIcVL339ibpfWZoiEheYIrlX5aSBnUOSMnboB5NUARKAX56Vx1_CH-TXlVW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlIm4XQMQsuKLFapV-DOE95Jv0t2Il4J7vA3UJ4TET7Q&oe=6B01C36F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5bb9\u5668 317@1x_\u526f\u672c.png", "id": "750260607126786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982483_750260610460119_8049027481302987210_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFtSGHLe9-0Q7kNvwGMe-kD&_nc_oc=Adrd1s86ppA1HhfE9YeES0SoCziRfl1pWfvwdRJRFsAAkQoro9wcO84DzHS4W6E3qn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnxUNWe7GJQP_Nq3qBA7SJRiM14iFxpXq3ypGbQOeD3g&oe=6B01CE2E"}, "display_name": "Poetic Dance", "keywords": [], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}, {"images": {"nodes": [{"file_name": "20240805-155222.png", "id": "1696540241087677", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770914_1696540244421010_724349100188658269_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJzJ2hPG24Q7kNvwFVzDqc&_nc_oc=AdqYgEvMT97l11vF58VJh-RMbj5vprh0PGccjODyqpxPMq-SDjKp5VPLgXZl_IiTm34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDDkskX4uULq6aWPzYofHeQvzUr3Z5aQW7HWm8R2aUqg&oe=6B01C2B0"}, {"file_name": "\u7ec4 344@1x.png", "id": "1263677808416788", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_1263677811750121_5447872420596645171_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2DTw7rHQEUQ7kNvwFDj3i7&_nc_oc=AdrTHlhvq1HzoOQFY4INJkin9eF3eofayYK3XrLQf2uDZjeOdJJETrwxTO9ed1J9_dQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEEOo6JB5CQakgNLi_n2W1dsLFcdiF03aoUR80yyWLVg&oe=6B01DCF4"}, {"file_name": "20240807-155627_\u526f\u672c.png", "id": "1035260088203075", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_1035260091536408_3276939169422989872_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n6TbVUrcM8Q7kNvwHEiCcs&_nc_oc=AdovRdizJDojRQWNzqTyNCPFPxg1qIAJZ1z6eI_dALTlcfRLhFcG1N4gHV35IVmkvWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlm1Qh8_d9lKFvK8nrc4PDGdeQgXdrtIrY2NUbCABeGg&oe=6B01DCCC"}, {"file_name": "\u7
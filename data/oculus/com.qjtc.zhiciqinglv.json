uluscdn.com/v/t64.5771-25/38982484_510598874883965_1955532416435314891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6hUFNGqykoQ7kNvwFS_KU1&_nc_oc=Adrl-Yss0o_caIZl47tmUAx9wToSVcYBbzRm_WltE15O15GkDfoIqtBLqbVyjX5id9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-5cE3yDVzmCzaFUXU5V4dknaK-A9jqY4mbSjGEwjxjg&oe=6B0071EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5bb9\u5668 317@1x_\u526f\u672c.png", "id": "750260607126786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982483_750260610460119_8049027481302987210_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uMYreucH2wQ7kNvwEZcjOo&_nc_oc=AdrW0mOaqRZAQ6HGK3entjbWdVsXco2WH3dF-U8AeVRYwbNhV655q29MbWYP64C-328&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRAXHve0-FouvB_F5wtPOvAS87bodgHDl6KMSR7Hdhnw&oe=6B007CAE"}, "display_name": "Poetic Dance", "keywords": [], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}, {"images": {"nodes": [{"file_name": "20240805-155222.png", "id": "1696540241087677", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770914_1696540244421010_724349100188658269_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJzJ2hPG24Q7kNvwHfPXUm&_nc_oc=AdpMYPAZ-DHM4cjqkRKelgTUc6kPvxqjFO-JKDfZEWt2BCDezDAX0292gI3kFVtGqgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrJC9Fn6mvYuuW6NCVRSf-30Lq7r_5g2-DGeEGpoKfQQ&oe=6B007130"}, {"file_name": "\u7ec4 344@1x.png", "id": "1263677808416788", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974888_1263677811750121_5447872420596645171_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2DTw7rHQEUQ7kNvwEkrayE&_nc_oc=Adp0LoVCfuCN9Y4twJMWESZPN-9-nszFdorB4YgWcpf8op1nDMX5AGVFAMI09HQLDgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWQTwaU91iEmnjib7AjvQaFP_RJuh62niqHHc0upxxQw&oe=6B005334"}, {"file_name": "20240807-155627_\u526f\u672c.png", "id": "1035260088203075", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_1035260091536408_3276939169422989872_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n6TbVUrcM8Q7kNvwHAty-m&_nc_oc=Adp1pl2KEE5lu5qSV3FOFT2uBYfvvE8t7TdcZ9l1G3GakquUl8_tR9dq9yK-yHzmyEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOzHb3Zn1mB6IHyknzaMrkiqhyPPVYgaZlfeO6mWjNRw&oe=6B00530C"}, {"file_name": "\u7
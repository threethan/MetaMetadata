uluscdn.com/v/t64.5771-25/38982484_510598874883965_1955532416435314891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwFOdo85A34Q7kNvwHUNBed&_nc_oc=AdoBjvEeZ-GekehG8Ya8eJ89pXpMqraitGljNAzK2kN_2OxoO-eqlPZpyfwaZnxTMic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaZVarOXlZnlG7qDiob-4XtVINGPY8UXbr82_qo_IvbA&oe=6AFDCEEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5bb9\u5668 317@1x_\u526f\u672c.png", "id": "750260607126786", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_750260610460119_8049027481302987210_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGlv8s_uKx8Q7kNvwFLg-yv&_nc_oc=AdrfxX9XSvt1vMDxwK9-olEJApgBk5W9iudTO5TnDHUbc2yV2czGhIWOS4tou_di1EQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCCpuNZgdyjoG72TYCYdJvfMbxNkbizesvQpcIyM7asA&oe=6AFDD9AE"}, "display_name": "Poetic Dance", "keywords": [], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}, {"images": {"nodes": [{"file_name": "20240805-155222.png", "id": "1696540241087677", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_1696540244421010_724349100188658269_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_el3qc4OWI0Q7kNvwHuiV3O&_nc_oc=AdqNXt1Ui0AIdKEw8wrtUnbXGA0x49tt421ic1YMaBQfyiMR8iRjj8sXPv9KXygbMFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkF_ECOCvF02DYqjsqSLazfyf3_g1zKZZuZuDoVB9apQ&oe=6AFDCE30"}, {"file_name": "\u7ec4 344@1x.png", "id": "1263677808416788", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974888_1263677811750121_5447872420596645171_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8AME84xvskQ7kNvwFhgXIt&_nc_oc=AdpeMgqN2J_Tzn1aezE-rbFROTZlrBi9XbtSpYLC4KN8xeUScuQq2zYHVdoerKYiHhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEwp4x-Ozn26mDiZstAk7QznnL8X0hooNr3dBtGbUN_w&oe=6AFDB034"}, {"file_name": "20240807-155627_\u526f\u672c.png", "id": "1035260088203075", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_1035260091536408_3276939169422989872_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVAEEy1M9iAQ7kNvwFl8-uR&_nc_oc=AdpclArXU6FbOhSnRI8NFj4sMy9tMK5hBZCEXLhXFgx8G_T2gH3moAQpIh-7aOysrv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwBy9-YAh6Wp1Cm3rq_BhLT9EvOoDvpSTq5ebFYJNQRQ&oe=6AFDB00C"}, {"file_name": "\u7
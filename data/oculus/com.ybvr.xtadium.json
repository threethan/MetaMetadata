5_3164712617509391571_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mobKi-611EMQ7kNvwG3msXa&_nc_oc=AdqAO_cRrySIznS-9KjLqqmNX7H3Z5U6kNK5HGNL1pdWfVz_QblRLZakNL0s8m4XzCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bBvesOS-227alyysYqrKb5TBaUkz7r_c6HSLefBSeGQ&oe=69EB850B"}, {"file_name": "Baller League photo.png", "id": "3925783597730318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312332_3925783604396984_4319474383572474390_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGtWTEVMWKIQ7kNvwHOARKB&_nc_oc=AdqgjXC3l7n_pkQMDuhubzV3TKktWJzCjHgqe5pRw8dNpH6_hWN9xnLIOufNF2e0P-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MK5VqASdygW-_tqn0y-S73O0SjAhVbK5-5oHP-q_tkw&oe=69EB78BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Xtadium Hero.png", "id": "1513127173570823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305194_1513127176904156_1330446897711324522_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryZLlhWV7ksQ7kNvwGuY6gw&_nc_oc=AdrDsLo_NNvCauG_yQZlcHyxM1IkUaSYGSc_eFvsGraAThQU3i-O1WyATZ6Vvt5kW4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ISNw_4aBPbKsqf4zQUfcEuePTSZeGn9h7F5f_mdzKRQ&oe=69EB6D53"}, "display_name": "Xtadium Immersive Sports", "keywords": ["stadium", "ufc", "highlights", "sports", "vod"], "long_description": "**Xtadium \u2013 Immersive Sports Streaming in VR & MR**\n\nXtadium puts you inside the action with immersive sports experiences in VR and mixed reality. Step into tunnels, training sessions, and behind-the-scenes moments, or watch from angles you simply can\u2019t get anywhere else.\n \nExplore football, combat sports, action sports, and more through real immersive footage. Move between viewpoints, look around freely, and experience the moment as if you\u2019re there.\n\n{747987138226063}\n \nPowered by YBVR and featured as one of Meta\u2019s top Mixed Reality apps, Xtadium transforms your Meta Quest 2, Quest 3, or Quest Pro into the ultimate sports arena. Now easier to use than ever. Navigate seamlessly between experiences, discover new content automatically, and enjoy support for multiple languages and subtitles across live and on-demand content.\n \nDownload Xtadium for free and experience sports from the inside.\n\nxtadiumvr.com | @XtadiumVR", "short_description": "Xtadium is the free VR & MR sports app that puts you front row for the sports you love in stunning 180\u00ba/360\u00ba video. Watch on-demand with multi-camera angles and Watch Parties with friends."}, {"images": {"nodes": [{"file_name": "Xtadium icon.png", "id": "26388453830776116", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_26388453837442782_8864360868123682352_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d87qaC7-faoQ7kNvwHC2SFj&_nc_oc=Adotp7UWkXvYqhf8U7NJk4ucQG90MKYNtU4Uu2piE5xyvE7RyM3px7Mh0bXN8Vfc-Pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lAtgpS0wGaGgfI2SuHWNGE7mIZMF2o1OQFddkwlE6nQ&oe=69EB6E0C"}, {"file_name": "PSG in VR.png", "id": "2893349350849829", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_2893349354183162_3681274576793757264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqfvHai2kTEQ7kNvwGFjymw&_nc_oc=Adr_eClD9C5bhvJSQKsxdIPq_gj4H5AJmgSOj0eme-o0FseIo_RNHrtaHUm1lAlWBZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i-vL5AEKKObxKDrAZ5vQWf3oh_Nxhe_BvHa_WfGbxZQ&oe=69EB7B14"}, {"file_name": "Xtadium GER Layout.png", "id": "2069145450689684", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310817_2069145454023017_1403715563547547397_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QXTy63tLbcQ7kNvwEZT3TI&_nc_oc=Adr3ibaqOJN4y1rVMgteBrKAFZ7c_h8TO7xAOPPuiAT3D5USDqLfcyK1ztSBdy2Zb4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SQzN6PjkSrcgJzDndKTTYInIdv6E-nCb_F51V2mN
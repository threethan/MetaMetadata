/491823746_1740891306932701_2720747828707683196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DZA5B3ciwIQ7kNvwFA191A&_nc_oc=Adq3y-SJZPOzWAYiDUflF41BbUTLXMY2DuKbrGUIlApQUGb-rmHhY3nPASLN_UvV7NI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcWDcEL-cC7q8vLGh4yrWlyiULchiU5b2wO0aQ369hgA&oe=6AB13EFB"}, {"file_name": "unnamed.png", "id": "1428087645812291", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622162_1428087649145624_7810857192852993714_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9vMOpqQNjUQ7kNvwGPBY7v&_nc_oc=AdpoII_lJjXQhI3h2Xg34p_MFri8e8kHVt3yjnMcZEsayx1Gp0NGXKM97YIMwyJnS-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVSyr_o20oJFXpXF8PB5gaJBdLhUrhodiEyiLb70pSyA&oe=6AB12CD5"}, {"file_name": "pk.png", "id": "1536451554929687", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1536451564929686_4001465768231601674_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCq8Ogzk1vYQ7kNvwFFT4PK&_nc_oc=AdpoMlye9Kmj485tfr1g3DmdJFaUQRkdShOGZfKmCMl_SB3Z8XykI3rnLIpAqQYZOok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJptP9FLwx0qWY8fZFq-FGOQX0DzOyRxL44QeiFsa_lQ&oe=6AB15A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_lowered.png", "id": "1535027061680102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1535027068346768_618663689361832711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k-NrGwbUm8Q7kNvwF_Ehe3&_nc_oc=AdrziBfER-Z-_DQfdE7COFWNOry1h_wf7jp8GywA5n3VkjzBOLip-72SheEym7NhVcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk5vVbI0siaGLUiKnsItdjWHm_Rtf5q6QVSmFsKuw_JQ&oe=6AB15028"}, "display_name": "Fire Fight", "keywords": ["Fighting", "Boxing", "PvP", "Multiplayer", "Roomscale"], "long_description": "**Fire Fight is a platform fighter built for VR: your body is the controller.** Dodge like Neo. Throw iron fireballs like a boxer throws punches.\n\nBattle real people or bots in ranked 1v1s, 2v2s and free-for-alls. Test yourself against the campaign's bosses. Take up to four friends into raids against giants.\n\nShort rounds, fast rematches, a rank ladder with seasons, and a shop full of avatars with heavy customization. **Free.** Run the tutorial and the whole game opens up.\n\n# The Arena\n- **Ranked 1v1**: seasons, ladder, hidden-skill matchmaking\n- **Quick match**: private rooms, 2v2 and four-way free-for-all\n- **Aim training**: drills with a dedicated leaderboard\n\n# The Campaign\n- **Five titans**: each with its own moveset and weak points to master\n- **GOOPLIATH**: a giant gel monster that oozes up from beneath the scrap yard\n- **Gauntlet & Hardcore**: earn badges, chase the best times on the speedrun leaderboard\n- **Raids**: team up with 2-5 players to take down giant bosses\n\n# The Club\n- Take the fight to the dance floor: darts, drinks and music\n- Compete for high scores in quick pick-up games\n- Trade coins and spend them on avatars and platform skins\n\n**Gasket is waiting for you.**", "short_description": "Iron sharpens iron in this platform based fighting game presented by yellkell.com\n\nFire Fight is a platform fighter built for VR, with your body as the controller. Ranked 1v1s, 2v2s and free-for-alls, a six-boss campaign, five-player raids, social area and leaderboards for both competitive play and pve speedruns. Free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playfirefight.web.app/privacy1.html", "developer_terms_of_service_url": null, "publisher_name": "yellkell", "support_website_url": null, "website_url": "http://yellkell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
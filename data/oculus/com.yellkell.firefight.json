vLGh4yrWlyiULchiU5b2wO0aQ369hgA&oe=6AB13EFB"}, {"file_name": "unnamed.png", "id": "1428087645812291", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622162_1428087649145624_7810857192852993714_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9vMOpqQNjUQ7kNvwGPBY7v&_nc_oc=AdpoII_lJjXQhI3h2Xg34p_MFri8e8kHVt3yjnMcZEsayx1Gp0NGXKM97YIMwyJnS-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVSyr_o20oJFXpXF8PB5gaJBdLhUrhodiEyiLb70pSyA&oe=6AB12CD5"}, {"file_name": "pk.png", "id": "1536451554929687", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1536451564929686_4001465768231601674_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCq8Ogzk1vYQ7kNvwFFT4PK&_nc_oc=AdpoMlye9Kmj485tfr1g3DmdJFaUQRkdShOGZfKmCMl_SB3Z8XykI3rnLIpAqQYZOok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJptP9FLwx0qWY8fZFq-FGOQX0DzOyRxL44QeiFsa_lQ&oe=6AB15A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_lowered.png", "id": "1535027061680102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1535027068346768_618663689361832711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k-NrGwbUm8Q7kNvwF_Ehe3&_nc_oc=AdrziBfER-Z-_DQfdE7COFWNOry1h_wf7jp8GywA5n3VkjzBOLip-72SheEym7NhVcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk5vVbI0siaGLUiKnsItdjWHm_Rtf5q6QVSmFsKuw_JQ&oe=6AB15028"}, "display_name": "Fire Fight", "keywords": ["Fighting", "Boxing", "PvP", "Multiplayer", "Roomscale"], "long_description": "Punch and throw. Trigger to recall. Move your whole body to dodge.\n\nFight real people or bots in ranked 1v1s, 2v2s and Free-for-alls. Fight the campaign's five bosses; each with different tells; and the giant gel creature that lives under the scrapyard. Take up to four friends into raids against giant versions of all of the bosses. Between fights there's a club: darts, drinks, coin flips, music, and a fight pit to settle the score infront of your friends.\n\nShort rounds, fast rematches, a rank ladder with seasons, and a shop full of avatars with heavy customization. Free. Run the tutorial and the game is open to you.\n\nTHE ARENA\n\u2022 RANKED 1v1- seasons, ladder, hidden-skill matchmaking\n\u2022 Quick match- private rooms, 2v2 and four-way FFA\n\u2022 Aim training- with leaderboard\n\nTHE CAMPAIGN\n\u2022 Five titans;  each with its own moveset and weak points for you to master.\n\u2022 GOOPLIATH-  A giant gel monster who oozes up from beneath the scrap yard\n\u2022 Gauntlet and hardcore-  earn badges and compete for the best times on the speedrun leaderboard.\n\u2022 RAIDS-  team up with 2\u20135 players to take on giant bosses\n\nTHE CLUB\n\u2022 Take the fights to the dance floor: darts, drinks and music\n\u2022 Compete for the high scores in simple games \n\u2022 Trade coins and spend them on avatars and platform skins\n\nPunch your way up to being king of the scrapyard!", "short_description": "Fire Fight - Dodge like neo. Throw fire like a boxer. Ranked 1v1s,2v2s, Free-for-all, a six-boss campaign, two-to-five-player raids, and fun little games in the club."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playfirefight.web.app/privacy1.html", "developer_terms_of_service_url": null, "publisher_name": "yellkell", "support_website_url": null, "website_url": "http://yellkell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_
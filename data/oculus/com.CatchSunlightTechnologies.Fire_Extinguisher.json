7f20f&oh=00_AQJpoEbQzKL94LXzDYIEe2XsoLJUofL7NxQCOszV23R1DA&oe=6A9AF275"}, "display_name": "VR Fire Response", "keywords": ["Fire", "Extinguisher", "Trainer", "Emergency"], "long_description": "VR Fire Response is a cutting-edge, immersive training simulation designed to educate users on the effective deployment of fire extinguishers in  an emergency situation. This interactive virtual reality application replicates a fire scenario, providing guidance on  operating a fire extinguisher in accordance with established safety protocols. This is not a substitute for real fire extinguisher training and does not cover all types of fire extinguishers or fires. ", "short_description": "VR Fire Response is an immersive training experience that simulates how to effectively use a fire extinguisher in emergency situations. This interactive virtual reality app simulates a fire scenarios, guiding users through the proper procedures for operating a fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catchsunlighttechnologies.com/vr-fire-response-policy", "developer_terms_of_service_url": null, "publisher_name": "Catch Sunlight Technologies", "support_website_url": null, "website_url": "https://www.catchsunlighttechnologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27978439675105368"}, "review_messages
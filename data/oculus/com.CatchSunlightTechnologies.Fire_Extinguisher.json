s an immersive training experience that simulates how to effectively use a fire extinguisher in emergency situations. This interactive virtual reality app simulates a fire scenarios, guiding users through the proper procedures for operating a fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catchsunlighttechnologies.com/vr-fire-response-policy", "developer_terms_of_service_url": null, "publisher_name": "Catch Sunlight Technologies", "support_website_url": null, "website_url": "https://www.catchsunlighttechnologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27978439675105368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "555417233872893"}]}, "baseline_offer": {"id": "555417233872893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734533760, "status": "PUBLISHED", "id": "555417233872893"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27944994591783210", "version": "1.0"}, "id": "1477256839590426", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27374208355528506", "is_concept": false
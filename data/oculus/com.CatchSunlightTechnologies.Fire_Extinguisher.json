229", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036606_546980951519562_8659592429079311486_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhdA6YTGUfgQ7kNvwGpmX8b&_nc_oc=AdpDjBL0W_-j8KiyXMLURBNUUVhfpsUtZEydoKPhuEDmtgs6FdPh603irWLm5ZeQSQw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpJIpV0dMjzjG34rIl8lbWZL6XMcOEXeS5_qslA3d2yg&oe=6B09B075"}, "display_name": "VR Fire Response", "keywords": ["Fire", "Extinguisher", "Trainer", "Emergency"], "long_description": "VR Fire Response is a cutting-edge, immersive training simulation designed to educate users on the effective deployment of fire extinguishers in  an emergency situation. This interactive virtual reality application replicates a fire scenario, providing guidance on  operating a fire extinguisher in accordance with established safety protocols. This is not a substitute for real fire extinguisher training and does not cover all types of fire extinguishers or fires. ", "short_description": "VR Fire Response is an immersive training experience that simulates how to effectively use a fire extinguisher in emergency situations. This interactive virtual reality app simulates a fire scenarios, guiding users through the proper procedures for operating a fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catchsunlighttechnologies.com/vr-fire-response-policy", "developer_terms_of_service_url": null, "publisher_name": "Catch Sunlight Technologies", "support_website_url": null, "website_url": "https://www.catchsunlighttechnologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommend
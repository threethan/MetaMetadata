name": "store_013.png", "id": "1729982921992922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622184_1729982925326255_9192771696654913775_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPpG1ujcMVAQ7kNvwGhRfBm&_nc_oc=Adrlmrjgaf6SsSkjWNRh6p1f7Mv-h5rjW_cLppViHsEh5nzg_L74X3ERmEbX4jGj-wE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjyPyEZGj-8xb5RlBq84Abn6LOHo1_IP35XCcK6LkllA&oe=6B0C4FBE"}, {"file_name": "store_015.png", "id": "1001785522985822", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593727470_1001785526319155_5470106778883403771_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebjVgw1MtHUQ7kNvwHdiCVK&_nc_oc=Ado_xuyyRi2WM7Qyk-WR9Ln_3u41-ZSEk_tUGmoN0hb0Am8Q322xwc6P4NI9jOOP_Fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsWd3Rbbno9xVMhoRqesbVDfKML5UnNssMc1wSeWt-dw&oe=6B0C5F4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Train_Defense_Video_Cover_2560x1440.png", "id": "2326218841284128", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_2326218844617461_24067818582587506_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6Bs3cZRp8sQ7kNvwGv5Mn7&_nc_oc=Adqw_Xn1aliB8ISBIDiohSwQ3xISk6nmRrDvQhnhvArwsSQZFMSAAb-0w5LXHXEOxH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrjJHR7nyNE2TtiP1ssvi2zGs08JgTnB4FuNY2uiL8UA&oe=6B0C5A59"}, "display_name": "Train Defense", "keywords": [], "long_description": "**It's not tower defense. It's TRAIN defense.**\n\nA whole battlefield sits on the table in front of you, and your armoured train is its only hope. Draw a path and the engine rolls where you point. Couple up carriages, arm them with turrets, and keep the convoy moving as waves of enemies close in.\n\n# Build your war train\n\n- Arm carriages with gun turrets, twin cannons, flamethrowers, zappers, freeze rays, lasers and artillery.\n- Add repair beams, shield generators and missile defense to keep the train alive.\n- Fit a ram and plough through enemy lines, or toot the horn for a burst of speed.\n- Build towers for extra cover, or field a tank.\n\n# Four battlefields\n\nDefend the Watertower, the Bunker, the Radio Tower and Santa's Sleigh, each with its own objective.\n\n# Three ways to play\n\n- **Arcade:** a random stream of upgrades rolls in. Earn money and they arrive faster.\n- **Strategic:** spend your earnings on exactly the upgrades you want.\n- **Just 4 Kids:** a gentler ride for younger engineers.\n\n# Made for VR\n\n- A living tabletop diorama you can lean in and look around.\n- Wave your hands through the smoke and debris to scatter it.\n- Mixed reality on supported headsets.\n- Save mid-wave and pick up later.\n- 20 achievements and a leaderboard for every battlefield and mode.\n\nTrain Defense started as a hit iOS game by Mad Puppet in 2014. Mad Puppet and Squishylemon rebuilt it for VR in 2026.", "short_description": "Lay track, haul passengers and bolt turrets onto your carriages. Defend a tabletop battlefield from wave after wave of invaders in this hands-on train defense game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.madpuppet.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MADPUPPET", "support_website_url": null, "website_url": "https://www.madpuppet.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2014217845934653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_4820518884847449_349292286855746909_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2398t43LuQQ7kNvwG7CEZt&_nc_oc=AdrXBfaIy30315-ha5UFNyyvcBYgU_fzmMiB_YMQvr99BeaG-KZPAVBoa6UFafE88Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkVuJOkkZsg8RE5lk-hujyd_e5vOy6NQ5QHPsONIDMiA&oe=6B0C4DDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Train Defense", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1795106520, "lastRevision": {"nodes": [{"id": "2014217852601319", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2014217842601320", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "988221651015853"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Train Defense_ Armored Rails_SQUARE.png", "id": "4820518881514116", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_4820518884847449_349292286855746909_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2398t43LuQQ7kNvwG7CEZt&_nc_oc=AdrXBfaIy30315-ha5UFNyyvcBYgU_fzmMiB_YMQvr99BeaG-KZPAVBoa6UFafE88Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9CHmI2nAlfVfjAV5htXyNgYYKpgZ82RbGFLK3iJrGAA&oe=6B
://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvou-d_4CswQ7kNvwFbQM7t&_nc_oc=Adr9LEkBwn8_n0oCfq194KCnST10aWQ7Dhrzp6WMygCzHPk8q0_nHm_JUvm8YkEc7x8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzHH6i-xdz2lCwdgKAWd7wwU75fc1SQssTLXJ1YpCAnQ&oe=6AA169F7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkOO87eHpSMQ7kNvwEawBam&_nc_oc=AdoCyTD-AULpphooRGyXjhCNgWmuHT21wKe74RjKWJQauHWPapDGCgdXQ9DwVPc9LG4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Bvr0EnesA49MTNjQWSYvHq32nAhg7DIEjzKpeQudQA&oe=6AA15304"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axc9gNoyCTMQ7kNvwGwxGjJ&_nc_oc=Adpv1rTJutI6WOllupOEuiPqVDCXjqRk4_WXv4n-GGLa422IITOYmv84z40xiiGUNI0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFV0aWzUmOCZtyqEC-XdGbx1XYOd8NOLBJ9Ch_w0kZQA&oe=6AA1602E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EC0zIpzkgUQ7kNvwHCJ7S3&_nc_oc=AdrzfMKMxFbnVsBZSSzoGE3qVlE2GpNCpslDr--RNe0dMi4V7-gK_lpysVa55noJTxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLitbNhoNuUbxABeUkqhH7NXjmwFeXLUWNC3upM9CFQuA&oe=6AA14CB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_4TqNN3Aa0Q7kNvwFEBudk&_nc_oc=AdpIaTHvJCrj6xUkzFlAYeVlI7hmmc4E2eVgIpmh_bP5fN5mJRaJzlofcypsB6aLKI0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK18OUI2im39vF-lBjmN_URLUgVqNs4PJctvnjMjb0Fww&oe=6AA16D6F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSeK6BG72GEQ7kNvwHZBBTe&_nc_oc=Adp4c2BsbGejKM6XaXg4wCG2v26egpq5mJ_6cAfad_zZfIzRzKR-qv4fxduT50FtuPk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9U63ZHRzFgJXOeXesuLOBkkdXN6iQ7XfTs5xrIorBlw&oe=6A6F50F7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxcxuGYGHGIQ7kNvwGita6o&_nc_oc=AdpEzHpfH293x_v42O8UIKHV0u5fTv10bXUUhBS5qHEiYRoMEdTRWMGUgNNHyy8VJj0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx-DYLWGElxjPV_CT0DcnjL43mDEjkd63Hr1ZZBrtphA&oe=6A6F3A04"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0o518JRhhMQ7kNvwHNdXBg&_nc_oc=Adpr4aC0WxY7wZyx1j36Ihji5mhM2ZE_1ZB65RQaMaZAjjg1A9f15hgHhsnO-7qfEJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6fvahbsArXNOESCgraHpuGnum1PPRUcYcWvBc-ncAKQ&oe=6A6F472E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5J7IlzWIe8Q7kNvwEk5VwQ&_nc_oc=AdpO-setA89qYsbnxCNq-dI7LHuRBEPFEaQ9QbcKUTXyzkSj5i-9SDn9YRksmXIEr-o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqTM2yq8nLxWpnN07L-QVh3VyCcXbe2Cue1aZAhCHnEw&oe=6A6F33B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=364W6MEhzxcQ7kNvwF4dSzS&_nc_oc=AdrUnMixTglGrTLXjS8xIbyCZoqFmgil-2o5VtqlKwhS0tTMhR_clEACbj5DKm6k_WQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoGTpqF4X0op_ggbcxe6kkdtAF3RhvzxItAZrMUZxb6g&oe=6A6F546F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfs-bepyklQQ7kNvwFnK70L&_nc_oc=AdqKJsWxYLACwXwBDh5NSBIaPc2P1vth9IURjhn64TE5H_elvfBgjhviAR4mXSm5_r4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR-qg8X7AEjZh1F_EsDr2WNPe-C2dvm_ObvMN5w1K2MA&oe=6A8468F7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2mQsTihVFMQ7kNvwGISVnK&_nc_oc=AdqBChChjPoEsY7-qnmWwOcb13vdSN4tY97BjtYxTBvBRRP9RVr3msvh88Ykr-5RaX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0-iycUTXJJSeH9-kiGfIwGBJQb97Sie0S6l2wqhmcgA&oe=6A845204"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D34DsHDcL5EQ7kNvwGduWKO&_nc_oc=Adp81DCYeQIAF-Coy0u5dVCwu0v9JEOu2hXB7m9SlhPJqBeJVVhhIKAwscHUAZd5Bps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUdgQZakLhuF9yLps4sBTpBr_PZWiKZwq2K9K1EVM2IQ&oe=6A845F2E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAYUm3wfQ9gQ7kNvwGWxyn6&_nc_oc=Adriu1xmIECXP4GUKMfyauORhPGUr7vifR0qzm2q656DjWwM8479Q8teGvulE9Lv_80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPKtdyBQgII9gxLe8v1qtrZgjeHZSl8A1BBitJ6T9cRQ&oe=6A844BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkcAOyAzv24Q7kNvwHwG5VG&_nc_oc=AdqcUU5AbCW1leAes93SxyG49c2P_OUo-bnxemlQ-gcaP6O-qN1X9avcDw_xlPgd0CQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpHFZGxEcCgFWVRoIMn955gFXnJyDLcFP3642u6FXG1Q&oe=6A84342F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
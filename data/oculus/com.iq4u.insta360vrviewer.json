://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne0_siQl3vwQ7kNvwG3sSD0&_nc_oc=AdoUXXm7R2xVat5k5I0xH1bh4eAEoL5-rcDAZMFG2q_J1T2JF8J7Zdql2fubk76Erco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi8rZ3IUEqq4C36EAwJX9c3QxMawTmcUTfljCSO4bgmg&oe=6A8C19B7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2j1NlL2-ZoQ7kNvwGM304m&_nc_oc=Adoh6vlXO2Zrt5Vc8HfXJ44YfmD7fJzUvdN_88RfEuMpssDFUjpxBBHQG-JXwrrvaAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhku0hMnM9Vt3e-DCekoxepVQNh3L5ZrJRt1ekepCEyA&oe=6A8C3B04"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izQ6YavuA44Q7kNvwE-cxZC&_nc_oc=Adodn9jkG10A66VwAgQwFwjFSeBWMx81yMrxMX75jEZwqSuefdaJY6u0rDeuy7dLj4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJU5Cbrnsci75HANmUoHtSTJBprScqlSalSYg_fIJvSA&oe=6A8C482E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMXMDFicMmgQ7kNvwH2LtiY&_nc_oc=AdpMCjs_hrsgjELl393bbF7oL3Raq9DJSXxOrfH4pzbcMqQTnbXLbjybJAmgIs6UhGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2opGaWIaty7i4h_K_Q4LwfiTQB4kqjnUJ7xsvFL2a7w&oe=6A8C34B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldEBVrlhtiYQ7kNvwE-4qz1&_nc_oc=AdrRSKBO5fquKS4Q4aDXZNo-OeZK1dpOORDYRlyhmhiuewvD-4sk9Y8gfyADSnthQtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH15nQXJBqq_QfvxauiOsCiAG7BsQY3VpGatVA6oqBmjw&oe=6A8C1D2F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
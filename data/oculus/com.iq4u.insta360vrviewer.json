fers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1303251841701039", "version": "1.0.177"}, "id": "2084606089076778", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1248078937218330", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1303251841701039"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2084606089076778"}]}, "change_log": "What's new since the previous version:\n\n- Export files to your phone or computer: tick files in the gallery, press Export, and download them in your browser over Wi-Fi\n- Share links and QR codes from the Insta360 app now open 360 photos, not just videos\n- Zoom: hold the controller grip button or make a fist \u2014 the image zooms in where you're looking\n- AI detail enhancement while zooming on Quest 3: the image is sharpened for extra clarity\n- New 8K quality mode for maximum video detail\n- Galleries: jump to the first or last page, flip pages with the thumbstick, files sorted by capture date\n- \"Cached\" badge on files that are already downloaded and open instantly\n- The app now speaks 16 languages: added Japanese, Korean, Polish, Dutch, Turkish, Hebrew, and Ukrainian\n- Your background choice (stars or passthrough) no longer resets when switching screens\n- Stability fixes: taking the headset off and on, keyboard input, playback\n", "created_date": 1786649613, "id": "1303251841701039", "version": "1.0.177", "version_code": 177, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"
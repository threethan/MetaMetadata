m&_nc_ss=7f20f&oh=00_AQRB4rxr0bO9ORotCCg9XdOr__VorIacMgBgU8lljq7s8w&oe=6AFC82C4"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRHSuF9JJ4YQ7kNvwHrzntd&_nc_oc=Adq4PklRGiE2phpzCNpO4F29UlFAQxBB_W8J8S7BvtbQtzSFxVyCY6r4eE9zv5INxNk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7QKkBreAKXJEXr4dtOrua0410xeLQ8XNvEuOWnE0fcg&oe=6AFC8FEE"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHLlSEa1pTYQ7kNvwF2cwug&_nc_oc=Adq6ewyms50j08DpEuuO3L1vSu23RS7j65bNC8qh3bjbCTTqUNKjTXeuyXSqQNZS4oE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg2nFsppxEY1AWMbDpMvIpnX2D8Jn2DGDR4EwXaG7RTg&oe=6AFC7C77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W2avEUEY3MQ7kNvwGSrlZF&_nc_oc=Ado_bA-HDuIxEoOM2o2SnqN1HKXAygd0T2-L6Q8Z8xHGjC9y-RK9kNcEYMzdHWtrHQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKmgTbhlqwKWAo__FsLbmdaIQc-hyXPMPcTfWsl0_xzA&oe=6AFC64EF"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "de", "es", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "de_CH", "ru", "ru_UA", "es_VE", "es_PR", "es_PE", "es_MX", "es_AR", "es_CL", "es_CO", "zh_TW", "zh_HK", "zh_CN", "ar"], "supported_input_devices": ["OCULUS
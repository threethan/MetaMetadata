://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvou-d_4CswQ7kNvwENQ2cz&_nc_oc=AdqjEVbQVkx2JR3AiQb2nm-KuH_CCDo2LeCbQ3FEd6zLXOVqlXDbDA6jOqhRJ8_21mg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlq3rPUumKBT2gBBgFWqvP78Rf4hMZRUwk-vquR4sDsg&oe=6AA01877"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy2z9JhL3aUQ7kNvwG7qtsp&_nc_oc=AdqxVahETywJ0hIDn8Zh2cB40rrgqN0d_fhKr388gmlJ90X-zjAGdij4NuC8eH361yk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9O6qq_X55cf1W1UcvylkcEwSy4WPykrI_Nl-EA4UNWw&oe=6AA00184"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axc9gNoyCTMQ7kNvwEwBKXY&_nc_oc=Ado3axiYRFqLWeuF9x_h-YUJGDyCtJUpcd0SFIWYBqQjAluWyNUZditFQZuGkbtkS8U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhMRLTaARZEMJaFbeJDcEK_rVpqIM7qFFfM-XnpTXv5g&oe=6AA00EAE"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHztgEmdIUAQ7kNvwHj2DVf&_nc_oc=Adrbp-i7e8mrXu9isylpY_v2KLBGCoKHujPsvlmBZ6PlOGl0skh2DlSf09PSkGKZ_n8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXmLYfvTcH1EK7cSotWlxh4AE-mE9fedlV6wR45Mq9Vg&oe=6A9FFB37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_4TqNN3Aa0Q7kNvwErcman&_nc_oc=AdqPXFsDNjynmfYjqB1veDndmt0GkRrV5BjEuDo6ALKphXD5zLyX7R_UBAHXrMCQ-fs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1FsTaVhJ2kRdJ-LLkB1mf3TCjry5JQa4yGSRCJfcXzg&oe=6AA01BEF"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
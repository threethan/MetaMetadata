://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SrWYDF1JcgQ7kNvwFCjHzT&_nc_oc=AdrAoD5awcieCHUxopMXYTe92Dn-7PkjL4kiQ668EKpmk_E6DzhxRvVwN18zSjXXsaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUea9wWxUBruRjXYI6OcvXukhuVb6U-1-G5KvYFKubIw&oe=6AA6AFF7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_UI4q6-SI0Q7kNvwFQdSZ6&_nc_oc=Ado5v7dsu4SyKtAcxVuFFIXtaxmEySBElNk4aCvWw7_-PXf1fJyPPKwAHYX8VncmNMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7awYk3IalLWQju7_lLO6pNSpYWyW29wVvEbmtp5SssA&oe=6AA69904"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_XEVJnlrIwQ7kNvwF8nPYv&_nc_oc=Adrl3TbMPoBQK0TTCD0d2zdGSb3FlZB_3u0fQfCoKJRiMQ19M9KXtPvmz6UTLv-oLOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH6faTyp3dBIoNBPB2gVwQi8rTrDOoRF5Kw8RN_W20Ww&oe=6AA6A62E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg57bSmAR7EQ7kNvwEH2AkR&_nc_oc=Adqp11sc12KemqHOwql3n6854ZKMjJ4F0MlGMJ1jtkfNQPKWLBu4eZaDKAMOU_FPNr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwwWf51RZ5v6MJntJKnxjSRN1hyuT-G9CQrkQwKe-HbA&oe=6AA692B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzfUrIKXi18Q7kNvwHi0bL2&_nc_oc=Adp4duJYYNSxS1V40rA7Rm1Bhhj3Wp_A7zExKXja9z_nU_jDl6tC7odBOxF16G8DXj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHWzmCt8FIl3CWeerKsgwWx7x4gSPu07Sn8xdU90fCbw&oe=6AA6B36F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1248078937218330", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1272635338096023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2084606089076778"}]}, "change_log": "\u2022 New first-launch player tutorial: an interactive step-by-step guide to rotating the view, play/pause and seeking (can be replayed from Settings)\n\n\u2022 The camera connection is now reused: leaving the camera gallery asks whether to keep the link, and returning from My Files or Demo takes you straight back to your gallery \u2014 same page, no reconnection cycle\n\n\u2022 USB setup made clearer: the app now explicitly warns that the camera must be in \"Android\" USB mode (iOS/U-Disk modes are not detected)\n\n\u2022 Redesigned \"Disconnect camera?\" dialog with larger, easier-to-read text\n\n\u2022 Consistent labeled Back buttons across the player and all screens\n\n\u2022 More natural hand-tracking visuals\n\n\u2022 Fixed: black screen and lost UI panels after the headset wakes from sleep \u2014 passthrough, the star background and all windows now recover and re-center automatically\n\n\u2022 Fixed: cancelling a download returned to the main menu instead of the gallery page it was started from\n\n\u2022 Fixed: duplicate Scan-QR button on the web-upload screen; Back from it now returns to the previous step", "created_date": 1783198790, "id": "1272635338096023", "version": "1.0.137", "version_code": 137, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isApp
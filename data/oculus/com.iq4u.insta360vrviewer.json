9298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwwL9eJzxCkQ7kNvwFbj97C&_nc_oc=Adow-eW8UEvlpL89s4WGd8e7qVuKTOVWbA3u5RS0h9nd2YtDuKxa2suFkAb96MVFWB4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BQD0Rj1E514oFUntOr-XsjwT1Zxqg4B1XS5aX7x3UwQ&oe=6A3696AE"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29uC-HjU0VsQ7kNvwF3cbGC&_nc_oc=Adppm53RKtKTNs7DOoESVMSfbQpfEK2MjLbu2cxDN_1aJXm6UaRmimzkRDVWmuTf0nk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9goaNyNPJpKn9OVVhDyrRsYUMVZpovkVJTs9u51OwHYg&oe=6A36BB77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1HlkGpJNS4Q7kNvwE8QsZ3&_nc_oc=AdrpcSQx-Rv7XbK9ARhv0vK3NRBO2RD6qQM40NW9Z_YxlL2omM9isNCwKP0nlrMvZws&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6IbUFGyvzGoEID41G-TDQ9aLZNS_zNbisQaEf0KRyLA&oe=6A36A3EF"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "de", "es", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "de_CH", "ru", "ru_UA", "es_VE", "es_PR", "es_PE", "es_MX", "es_AR", "es_CL", "es_CO", "zh_TW", "zh_HK", "zh_CN", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1248078940551663"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1555107999607766"}]}
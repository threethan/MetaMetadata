://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdL29kGDsOIQ7kNvwFrdW0m&_nc_oc=AdpYUsI5yMMRI2FeNVxM14kNuJGoerEFb-Y5hDWD8Wtv_WJJgHGHoxLzKDIL43MC6y4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPjO01Wz-maprW-2KKaPvvGT_77aivm5ztppEE7zhfOA&oe=6A9C23F7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmZHt4zKcj0Q7kNvwFwCb_u&_nc_oc=Adqh_GyeCgzm9krk2z5la2yk95-8RQ2Tag54RaldbjidQeYQfzOP0_Sqr-1hQmmVXxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgfxZrNcQzc04uQ-1NtFqkg1Sfyrbvye1bi_teonXyxw&oe=6A9C0D04"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W84AVGA56yIQ7kNvwG7eYnR&_nc_oc=Adq3xVIU_sOqNmPyNc19dEvnXUfFBDo-vMo-w1Yvf4ncoSSeu-_lA7pi0OqKtSDSqJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIaspyYTZGBay38shUvEnSJRpMFk3u6MSPXsX5FkL0-Q&oe=6A9C1A2E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPCqdrs1iJYQ7kNvwHFzyj6&_nc_oc=AdoziGVCGOlk45Y2Uat62HX_Iiuv_FDP0FKOmusForsHDvMgcnGKJlIajondl8PrD28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5lPR9qG9Lf9nGfhnXXIO4qfIhSC0ssVTHJ791JfA9lQ&oe=6A9C3EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpHiAYxlNLoQ7kNvwE-fQnk&_nc_oc=Adqn6KO1fQyLIB02urBwY1x-6J0LMlNCejZnkWtG7H-bDSLpWzbma7ul0ForwExSgww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7wcyEnJ1lg-9LLnHyYbbsq52DtyJCJdzYE8dIlQ5xnA&oe=6A9C276F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
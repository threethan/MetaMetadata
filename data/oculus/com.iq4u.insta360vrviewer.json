://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJHmfQRREywQ7kNvwGR2FjB&_nc_oc=Adog23mdyjOMxw9idr252tghyRfFQT_dWXMPq_cpjx6_WG7_EWnaQK9Oqp2lERq430I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZAWD8rGGTT1ew6bc8L5Q_A09RS8xiOiklYDgcYvZylA&oe=6A9402B7"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkL2fwmu3XEQ7kNvwFbugSH&_nc_oc=Adq6o6a52FEjemy7IKO8xUtfQjFKkVy8ZLRT35hqYyizd0Rf7PZdfZrjl_Y7yfw_VAk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEULssCpj9MfaB__49kqRkBj1k-YGrEbmW9R9b_SprUqw&oe=6A942404"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN-uKSoSTKIQ7kNvwF1MXxg&_nc_oc=AdpJF-MOQlCGFGN6IBQk7hOzUyruRk4JizHpHMa_wpOYtY6ZCVdKlVJaM_7YZf6VZTo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6ZCgw0HR19Ao6UZ-f2I4p-wGaDK7jhL6fi2E8uXZ28A&oe=6A94312E"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZPSMJWGcHoQ7kNvwHvq7G3&_nc_oc=AdorIUIKpR8XUluXq9VlcQQ6L2ipqY0PomU8Zs42LntqqrM78JfCTQkCYmGZQoNkOsg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh00f_-BOpUljEUW5vRH6MDV3ObPytSGtcnDHhfgOqng&oe=6A941DB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWobsoZ6cSgQ7kNvwGbKHUh&_nc_oc=AdqlySLcFVAIS9S2ExHpxCNUtJqUdSazHpKOqKUCQO-zJhfoz-OW21ykI7RZgw5nS-k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxN7iGJV97NvTsteqLjN-chkuDwcAH3QJJXNby7aAYDg&oe=6A94062F"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_914620344969928_1119539500656132458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjcTy-sFHEkQ7kNvwFVlD4V&_nc_oc=AdoyGGSvKjuW5xBeBqArziR-xE8yy2iiBXXVKnp9X3yfLKj_PKOM0MJ5TJPg2Evve4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2W6YTU5i0MquhbNgztzdRdnHajcO7fwX8gWPr8n6Zkw&oe=6AE4A677"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-03-25-515.png", "id": "1526158575796104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507894088_1526158579129437_6624608086827266430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3vuUfE8sZkQ7kNvwGGmAoj&_nc_oc=AdpGVEhtcYVVwlh5H_37Ga7PTmwL-tblLe1bzjD8uyGA1S6C96kONAKTGn2TIjEPcqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLpS7svc9dQLCoF6u5s1g05gFkXpFzrVvb97laFhjvYQ&oe=6AE48F84"}, {"file_name": "IMG_3205.png", "id": "1664678894814928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1664678898148261_2846626970609825028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU4dcxzHwI8Q7kNvwFvLlyY&_nc_oc=AdpXckZJQmhWp_DUYAcE8PzoiehURi6EXOmPaCQyMVa4XcuIAmBtimrxO4g0lSfDt-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0sI5Sys73KuFJxSeiro8kQWrrguoLTBJjiF5RtM-G2w&oe=6AE49CAE"}, {"file_name": "com.iq4u.insta360vrviewer-20260613-235519-0_2026-06-14_00-04-31-683.png", "id": "1544571100702454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507819001_1544571104035787_3158544122444530973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awS9pd4_MloQ7kNvwG1BXzE&_nc_oc=AdqTiIemMm_i1LiXGbi15qPY-834dn4YYtLoOJC2mBrazqgCl-mLg9Gorjxy8IIPNJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOImg3WLDvd6lxdvMlSsiQnz_tUNxqXEDIxjDA5ygKguA&oe=6AE48937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2056833998595482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295279_2056834001928815_3978146616395585472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0GSz-ivtw0Q7kNvwE_EnRy&_nc_oc=AdqH0kDsaUZVsMdTWWjCf_AJLcKJuea0mcvkJ22a2aRWbvDUDu6lVgpAhg6I7j-Niv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmgdACgBzj29SMIq20jgvPfrabe-N9udR5M1d4VEboMw&oe=6AE4A9EF"}, "display_name": "VR Viewer for Insta360", "keywords": [], "long_description": "VR Viewer for Insta360 turns your Meta Quest into a personal 360\u00b0 cinema for footage from your Insta360 camera (X5, X4, X3, ONE X / X2, ONE R / RS 360).\n\nThree ways to watch:\n\u2022 Camera over USB \u2014 plug your camera into the Quest and play your shots, transcoded at the best resolution for your headset.\n\u2022 Insta360 Cloud \u2014 open a public Insta360 share link and stream a whole album in VR; browse a thumbnail gallery and pick any clip.\n\u2022 Offline cache \u2014 everything you've opened is saved for instant, offline replay.\n\nFeatures:\n- True immersive 360\u00b0 playback with smooth head-tracking.\n- Multi-file cloud albums with a built-in gallery and a history of opened links.\n- Automatic per-headset resolution \u2014 each device gets exactly the sharpness its display can show.\n- 9 languages, auto-selected from your system language.\n- Comfortable VR interface controlled with the Touch controllers.\n\nNote: this is a 360\u00b0 viewer. Single-lens cameras (GO, Ace, Link) record flat video and are not supported. Not affiliated with or endorsed by Insta360 / Arashi Vision.\n", "short_description": "Watch your Insta360 360\u00b0 videos in VR \u2014 from camera, cloud, or offline."}]}, "developer_name": "Alexey Plekhanov", "developer_privacy_policy_url": "https://iq4u.kz/insta360_vr_viewer/privacy.html", "developer_terms_of_service_url": "https://iq4u.kz/insta360_vr_viewer/terms.html", "publisher_name": "Alexey Plekhanov", "support_website_url": "https://iq4u.kz/insta360_vr_viewer/#support", "website_url": "https://iq4u.kz/insta360_vr_viewer/", "category": null, "comfo
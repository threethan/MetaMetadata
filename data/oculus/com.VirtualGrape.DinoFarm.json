1x2m-ukTgYGu-N4oldTrvWTd3mDW9tw&oe=6A74A3FF"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG7PkOIfhgIQ7kNvwE323yf&_nc_oc=AdpoLAuMYxjOhPwFoooskAqhn-3O91Yw3ZFbpM5-mfduHAPlM4z6O-2OTISDPPJZh8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoFbM-JyNoGGjzQbw3LNBujHOiB-ucDgmnYS4zp2kg1g&oe=6A7491E8"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idXsJUuCWbUQ7kNvwEsTTaK&_nc_oc=AdrVdbutd5RemAqOVESXxN3yKVV95lg1hFCEKQSO6C-MPsQIFPIxT0q42snbWI3tEQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUrIRNZ7GN6nTU0XqkgZt8R4t5WlrICAQlIVjWXbO9CQ&oe=6A747A23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, whi
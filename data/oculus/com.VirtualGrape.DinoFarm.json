ent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34OyB-GYY33AYKsw3ciSyZypDjTIPGWFb2zEMjO3DRvw&oe=69E23B68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osFoAtQ-eygQ7kNvwFpoWUW&_nc_oc=AdpGbIpHS4-W3ufbOlLjc8zLSB1KzVmjw5QzGLjnFFfrpkithm0WpKhxKRuNDZgnHWE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wJun7LZskrr5TYDWC1eKvG7bgNv0uSSNkEvIHAvfhFg&oe=69E223A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "traailer.png", "id": "1531149074626175", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491818885_1531149077959508_6093355839672949945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFw4Zi94gm4Q7kNvwFI_yR4&_nc_oc=AdrXM1ADEqIEvDbRoXIAmqz_b5uXxV4SZSq3tkS3onCpYXNPkUAHTsGyDAaB5hpWkG8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WFjCsSCoRFGUDxpiK25VugaQH1QfRJ5EkMakxWAuhYw&oe=69E23C80"}, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26217779454514630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619098_1414364887076575_5636214901544398028_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec6HJcz_QukQ7kNvwHbfoTs&_nc_oc=AdqGbcl164T8oWQCxKZnHPWy_Asjps14e76siWNK42rtZ1NSKw2wNOTbFiea-_ho8dw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yQY3wPF9RomJLoS0kl19ZAq5kmUHCXXCTGlrosYTW4w&oe=69E21CF8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Farm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_n
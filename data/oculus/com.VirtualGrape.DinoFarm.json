4m9SRUEsDUo7JVP2Z3RxdgTWAJ3Satg&oe=6A78987F"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8pflwLH7rIQ7kNvwEuQsbt&_nc_oc=AdoR2BJodxgwQLxaJGX1ktLOE6LnP2WHjVfoB-RlDDb_nwrfwVlGcWryDtmVFa31FOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGylLTQP0msTErSOj-zBaU2we7f6eu2D5surujStZ064w&oe=6A788668"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUIsN36IL70Q7kNvwE_vfo0&_nc_oc=Adr2yL16kkpch0SCIXbxl-WJ2RLbl-ydAoMov2oVeKZDfvTl3EGB89bbk1Ol158CSIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn0fsaDJVh8aYh6tgiIiqaFHyY04605BwWO99-0_xbbQ&oe=6A786EA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, whi
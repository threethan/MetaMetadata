_8288224741747368875_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUZDNVm4oB4Q7kNvwGlBPPF&_nc_oc=AdrSkIC4A07ZjPwD7Ek0QNNZoMnWS8qgMNEKpZscKy503PF01w8AFj2lSIwzz7Au-UU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdIusAhyYxJf-rvLuDHuS_BRf5a-uDwYvInCaG9A8-ww&oe=6AC4FF66"}, {"file_name": "ScreenShot1.png", "id": "906819708467854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825415_906819711801187_7502341965309564412_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pql8yo96fhsQ7kNvwHSGKhx&_nc_oc=AdrU5km47n0BUbwSjM3DgsIgyBc59crlZ8k3e2ab6K7XhthScWQGu1BEETxwh0lf_lE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpN77vE_dKB2E2GHK272qvq_aFpHoyl-hrRMJ09xTQKw&oe=6AC50F7F"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1rnOlI6J9MQ7kNvwHTTfrp&_nc_oc=AdqMPyGiiMAYlmLZxUYcH0h7K9kVqg-kedmEpWVV5Xhn3nIOWgNwzBXmJFQfkTyoqzc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK1MVTwGp-i2J7UvuzNFHl1MhRvrxusjNA70Jlg8DaFg&oe=6AC4FD68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygYYv0nNWmgQ7kNvwGe_Ews&_nc_oc=Adrtfr72IC9kDKop1QedXtm0_Kh_HYDmKuOen_wTpgloh2TFtfiHpAFwYkf3iBmpE2w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMph7W9XIS1xL0qZ6j3Xzxuq3RHi9jtv6axbvvGjl_tiQ&oe=6AC51DE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25673456675613580"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1465734502090641"}, {"status": "PUBLISHED", "id": "1329235205893794"}, {"status": "PUBLISHED", "id": "1223655933249124"}, {"status
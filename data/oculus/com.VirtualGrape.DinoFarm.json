tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xzATUTdP3FW4AGYjJOkGx1f0nEdK9t3kGdWw7pC_fOA&oe=6A01DF68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQQONUonRXUQ7kNvwHK9Shn&_nc_oc=AdoPxR4degqqvCeFuZ_jzr2cva_x0BNfbkYp5PcCoTQAbYYTmuteXY8OelOYSHeJpW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RuiJCyq4KZIOJG_i0GthQe6I8jRe2nD8RB1dTti-l3g&oe=6A01C7A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "traailer.png", "id": "1531149074626175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_1531149077959508_6093355839672949945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfLLIEf6E8MQ7kNvwGlCivB&_nc_oc=AdoTUdADwDgYfEcHvB5AMahZFQQpkw6mUN0-_VUb27N8dpTIM1wgu77Emgd77lUO7zQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CsphyOkX-bzQD2JSskQk90xbS8T3PDwa0rnWqV_sjxQ&oe=6A01E080"}, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-poli
I8LuFl7FJoX4MN753Qn_oQh7rCl5ABw&oe=6A43DC7F"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPQAMUiPnIUQ7kNvwGer0hk&_nc_oc=AdpyZvB5P0BVJ6jMKq-m7CD5btdW3c0QtPp8cjmseT3ntczdEqWdtUGbmC61D0sOOgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t6DZwKFyxv-rpOSvxtm366gqlrObKepSArktcETvzew&oe=6A43CA68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHaIaVGPl00Q7kNvwFrmGs0&_nc_oc=AdqaET9NL6XKJPpc4GD2dp7qGUV5HvuFP5lhPETEZYNxWZLk5lLpsGIf7cv5oj3nbX8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DfCupWJVJ-_Hx4L_qHxrS_meJxKZN3XzyvHSRXohGGQ&oe=6A43EAE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, whi
0f&oh=00_Af_5EU-sv-49fhx3D6Ar7HHf_m8nxRXEQnaSqq1UVQRoFQ&oe=6A39507F"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qNnDU7If9sQ7kNvwFaQgSY&_nc_oc=AdoWO-nqWKqBh_6-jHRlxpNOa1gjLEkBqKe-n1BxzC2C_8F3D8XKrpuPztz-uvpmH3M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e0MXp6_KfdYz_GWvyab7n70xkLFKYlZmHAxxqpvyy6w&oe=6A393E68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70zkBRCTctYQ7kNvwE3HfNg&_nc_oc=AdplcXAUCefiWEB-wcZhxG0d_TVLmTQWuX4YX2ejMALgfSDBvgUKldGq2rcGvfpycw8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d4fTfcTnhQkFFdShorEVaoMFeiWF5ckPpSyQCOiCwRA&oe=6A395EE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25673456675613580"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1329235205893794"}, {"status": "PUBLISHED", "id": "1223655933249124"}, {"status": "PUBLISHED", "id": "1536767330769887"}]}, "baseline_offer": {"id": "1536767330769887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782414000, "status": "PUBLISHED", "id": "1329235205893794"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26089111627381414", "version": "1"}, "id": "1842661089951475", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25673456665613581", "is_concept": false, "latest_released_binary": {"__typename": "Andro
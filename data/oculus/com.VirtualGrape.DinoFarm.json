ent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yVcEGTRBFtjAq8bBAQ_kT2x9b6trZvPmnJ4Gd5x-6fA&oe=69EB75E8"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3xyorby0mgQ7kNvwHGlZBO&_nc_oc=AdpFt2nV9s1qjythZ6aFp1Kc26hnaA_P17gzZ0SrqAiamjQAG1PXrfmoaAu_s5gZ4Z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PLnBKUb4gDl364holKZXkh_CcUIM0n09HpPCy56Vkww&oe=69EB5E23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "traailer.png", "id": "1531149074626175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_1531149077959508_6093355839672949945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LD4-cKxRW8Q7kNvwGhEIF1&_nc_oc=AdrxJW3XYRvyd4TH0kWiBqwN2fSo8k9whuniLrJHnf_Fh3GFA1kKI1d_g-G-lSjA3IY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YhZkz_kr_3ruDu_7DuI0QlAriqQtO1TtV3i0Ef8SfJw&oe=69EB7700"}, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26217779454514630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1414364887076575_5636214901544398028_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL6Ka8ahh8gQ7kNvwHHwtwC&_nc_oc=AdoUxzztzVC4uypGzT4lcMcZzM45RicdFKqBwCH9I-WneFV3Khz1eeXVlogz173oNZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qsAVq4FH1XN7tAzjp_jCojaPu6O7tc523snxN16IJPQ&oe=69EB5778"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Farm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_n
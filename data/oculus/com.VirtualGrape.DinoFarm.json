0f&oh=00_Af903zPKuatsFINN9lnk91GqEfS-m7NySMjTSkRaP8xe5g&oe=6A22E6FF"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2gxWxDbbiAQ7kNvwFhSHPz&_nc_oc=AdoLqxa24oTVMF_c3IAnFFlQPxEsWPK2iSFzTYsQaY3E3Ax79fA0mjULj9MZM6R0dkM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OWevfnzJ7RE-TZ1OKhH-ezrVal493HlylJXVkTQEFPA&oe=6A22D4E8"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okINVdVXQKgQ7kNvwFXKx9t&_nc_oc=AdrgjIzOyMXSufkIPA5_jYNp7kQFc0DUxv48zSZ-dFsZTlg2ZxT2AKXfOdkBoi13KMM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kpCT6b9nPdcA0oQPYk-wTmPkvAfsxp3cdLkdGFfhkFw&oe=6A22F563"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25673456675613580"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1223655933249124"}, {"status": "PUBLISHED", "id": "1536767330769887"}]}, "baseline_offer": {"id": "1536767330769887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771185600, "status": "PUBLISHED", "id": "1223655933249124"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26089111627381414", "version": "1"}, "id": "1842661089951475", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25673456665613581", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26089111627381414"}, "release_sta
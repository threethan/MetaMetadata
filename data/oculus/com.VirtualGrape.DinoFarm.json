FPUqSHyrlhTTw8cJcKuhWcRAL4TPNAg&oe=6A0F207F"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQFcbE0OQCUQ7kNvwHkSpjS&_nc_oc=Adpz-nA0Sb-r2qEUAlloue90_B5iyFRpjcpT_iYc8wmy1XCKEm-NFESOi274FikCt3M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69Xs_7DTAzJJcyXDoQWPFWMjbRjiLz6kHMqDijcElvNw&oe=6A0F0E68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkzjkF6G2NEQ7kNvwFotUyC&_nc_oc=AdrVIq3qdiITd9uYucHDjJ_SU-D2MDE-MDc2ew0dGgGe2RsC04WmK_fqUxNCvx3GHr4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U9gIywaXx9iNSETpJPv__pKpKJZWcWYVoLRQA5FVRVg&oe=6A0EF6A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, whi
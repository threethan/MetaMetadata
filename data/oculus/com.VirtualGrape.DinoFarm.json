vements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25673456675613580"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1223655933249124"}, {"status": "PUBLISHED", "id": "1536767330769887"}]}, "baseline_offer": {"id": "1536767330769887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771185600, "status": "PUBLISHED", "id": "1223655933249124"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26089111627381414", "version": "1"}, "id": "1842661089951475", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
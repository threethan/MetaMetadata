 ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mode
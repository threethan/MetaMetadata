_8288224741747368875_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tHE8oPqC00Q7kNvwGVkJbG&_nc_oc=AdraTEs-frL0SGUKF_Ai46RE2ExpYvBjY1L-27c1yuSFrsmNhMHrfmCofSf52OHEOrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb4UY8Zjs6ttG2esjgdgB5U6umt1YEj9fW0vwxumly-Q&oe=6AB7D066"}, {"file_name": "ScreenShot1.png", "id": "906819708467854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_906819711801187_7502341965309564412_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlAntT8mFS8Q7kNvwGS2lsU&_nc_oc=AdoXqc_6dcOg0uaM7VuQNtMg8GU4dEnT78NefThBd5oGO_LO6q0a23Bwx43w5sZYLXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkkoN6ao8bw_M4XewoUTOgUhRhCZD_LG20rTX049vxsw&oe=6AB7E07F"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jxB2dSFAg8Q7kNvwGRHcz5&_nc_oc=AdqKJ7ckAWuMUHPDIJPohgX1mvyo3L8bia0JD-czm76esZtevz8q-Yc3ug56rlwCeOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2WriG4NDc5FVCZB5U_v4bXOopYOBMsBKP-DRunQQ_pA&oe=6AB7CE68"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ttc2xuD4DQQ7kNvwFI1NCs&_nc_oc=Adox-eOm8Q2Uz8-2gzTypmKp6i1iJ8GhQr46BXicbZm1KobwhU99NXBm357P0DrXRcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlw2CoCrEuckrRFzEjnH6whHqEGIX4cMzBDIYovrQXIA&oe=6AB7EEE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, while defending them from zombies at night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualgrape.github.io/dino-farm-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25673456675613580"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1465734502090641"}, {"status": "PUBLISHED", "id": "1329235205893794"}, {"status": "PUBLISHED", "id": "1223655933249124"}, {"status
sftE5LvQd4srK6SxEouTbo-nGb3CNNQ&oe=6A1AFDFF"}, {"file_name": "ScreenShot5.png", "id": "1215595236677856", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307311_1215595240011189_6411190700816828157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKIJoPXaB_cQ7kNvwGd3lN1&_nc_oc=AdrR9GIpuTxnGgV4NjqVU804zfYDC52AfldmcAF_60xemhTru7JTwT8WysSq8nSvLSA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WwNNfQZY5ArLXQ-l6JdrvHlm3mOEz9HWa0KFnMPQKWQ&oe=6A1AEBE8"}, {"file_name": "ScreenShot4.png", "id": "5128565410700966", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491828608_5128565414034299_2457377931561176738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv_uAOnuU58Q7kNvwFz86Lg&_nc_oc=Adp-P2T1KFtIhdKd1ZRKwmAusAMZ3VNGV7QTH3exWfDWARpuwTZgfRlg2apIsN1yCow&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NnL7HIi6FwwU8ROXox-nLSX6INMRSKUPLEmX2ao3sdw&oe=6A1B0C63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dino Farm", "keywords": ["dino", "farm", "simulator", "dinosaur", "ranch"], "long_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinosaurs, while defending them from zombies at night.\n\nDuring the day, explore the world to find and capture different dinosaurs. Manage your farm, take care of your dinos, and decide which ones to keep or sell. Each decision affects how your farm develops and how well you can handle upcoming threats.\n\nWhen night falls, danger arrives. Zombies attack your farm, putting your dinosaurs at risk. Prepare your defenses, protect your dinos, and survive the night to keep your farm running.\n\nDino Farm is currently in Early Access.\nThe game is actively being developed, and new features, systems, and improvements will be added over time. Player feedback will help shape the future of the game.", "short_description": "Dino Farm is a dinosaur farm simulator focused on capturing, managing, and selling dinos, whi
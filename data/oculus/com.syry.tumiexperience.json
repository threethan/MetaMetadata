ning technology.\n\nAvailable in English and Spanish.", "short_description": "Explore the power and precision of mining machinery.\n\nImmerse yourself in a realistic underground environment where you\u2019ll experience the operation of the cutting-edge SBM 400 SR drill. From remote-controlled transportation to the final drilling stages, experience every aspect of this advanced machine in a fully interactive and educational virtual showroom.\n\nWhether you're a mining professional or simply curious about heavy machinery, this VR experience offers a unique exploration of modern mini"}]}, "developer_name": "Osyrys", "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-5f1ec4184bfe4c61a4db7de9bd4e1826?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Osyrys", "support_website_url": null, "website_url": "https://www.syry.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_PE", "es_AR", "es_CL", "es_CO", "es_MX", "es_PR", "es", "es_VE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7874700515980942"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "8268721639855936"}]}, "baseline_offer": {"id": "8268721639855936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726083240, "status": "PUBLISHED", "id": "8268721639855936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary
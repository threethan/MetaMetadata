oh=00_AQAaoUsS4TWT087qjV0F4lofcnnMilwUyzW0X21O7Xqx0g&oe=6A4A766D"}, {"file_name": "Screenshots6.png", "id": "1308037224147432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_1308037227480765_6150769064430671545_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX0AS9Bh1IwQ7kNvwGrS4pM&_nc_oc=AdrcuvSwhNE_HT5FNGNok1XsWoA4X6tNHGIOuOSdI4yR6-PqKCXH3jIlyM441xKwYZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw1-EMRbwAdc_sXUaLKecc9LcPFWXeSFlN8ZoEfZJHYg&oe=6A4A596B"}, {"file_name": "Screenshots2.png", "id": "1480678826416892", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822446_1480678829750225_2916013389054407609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew6fOeJ57fEQ7kNvwGSzTt_&_nc_oc=AdpmD_zNouWYvUqaBNnuC1m6Z4mdw_fjcQh4gqU3V5oTRR9fZ-niK3Gmj08J24hsHjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZj3epCVayLBJzj-mJtGhqeJkpHVp2NdVHOFKV3sXvuw&oe=6A4A4FD1"}, {"file_name": "Screenshots7.png", "id": "1099725389015121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823427_1099725392348454_5764243020441939547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p637T1o4PMUQ7kNvwGu37eZ&_nc_oc=AdrS7QGCE89okX3M9hTDSzSLHVR_-vEWP7WsX3M4J-RQNEr9JKWSqwyyV-wxgfr1bEU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTUstQqKEfu5UPpNA9R54ZTfRrR3TWSpkIzJnx1usp_g&oe=6A4A512E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshotsscene06.png", "id": "1728339961936604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619594_1728339965269937_308560245182797276_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPxmC_6WWJMQ7kNvwE5T3XE&_nc_oc=AdrxxuZURvkMp25UiSzsc0iIB0fHwT7Ga1BixxHzeyDKbE0XHOpT60wrT2wOm2vi1VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhW0PkxWNoEvOIOO9r4PSu0mj2AIJ78OfVbCTG2bd5bw&oe=6A4A4EEF"}, "display_name": "Leap Guys", "keywords": ["Leap", "guys", "leapguys", "party", "royale"], "long_description": "Welcome to the party-platformer battle royal where your hands control the action! Master intuitive gestures to double jump, glide, and interact across dynamic arenas. Race, outsmart, and outlast others across multiple modes\u2014Challenge, Competitive, and Party\u2014with more coming soon. Progress through a rewarding system of levels, quests, and ranking as you play.\n\n{815510794388489}\n\ud83c\udfc6 Physics-Driven Worlds: Every item reacts in real-time. Swing from chandeliers, launch with springs, ride carts, trigger traps, and tilt seesaws\u2014use the environment to win! \n{24922601070724224}\n\ud83c\udfc6 Team Up or Stand Out: Play with friends or rivals. In competitive modes, cooperate but fight to be the finisher. Supports up to 30 players per match. \n{1918522885676316}\n\ud83c\udfc6 Express Yourself: Customize your character and share your style with the community. UGC features will roll out over time\u2014create, share, and shine. \n\nPerfect for parties and quick sessions, this game brings people together through laughter, competition, and shared moments.\nEarly Access launches with Lobby and Match modes. Additional experiences will be added in future updates.\n\n", "short_description": "Guys, welcome to this thrilling VR party royal game! Leap and don\u2019t fall. Outlast others using intuitive hand gestures to double jump, glide, and navigate dynamic, physics-rich worlds. Fully customize your character and share your creations in a vibrant community. Perfect for parties, it\u2019s a fun, engaging way to compete and connect with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cnnetwork.cn/Privacy_Policy.html", "developer_terms_of_service_url": "https://www.cnnetwork.cn/LeapGuysTermsOfServers.htm", "publisher_name": "Kingnet Technology HK Limited", "support_website_url": null, "website_url": "https://www.cnnetwork.cn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category"
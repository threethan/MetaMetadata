culuscdn.com/v/t64.5771-25/491821704_1495773078284718_4902062968586037665_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rix2MSL6u0sQ7kNvwEDapVR&_nc_oc=AdookV09MxwdFxykguYOjZF1m94kHiNyX6yqskHFqFWuzhaV7fc7Td2in799PD6BzJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Ho5YFN23kp2EqxhXt3ilMhdPvq_C7xUVv08q2f06Ag&oe=6A4A639B"}, {"file_name": "Screenshots4.png", "id": "755447110735930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_755447117402596_3327248462212670692_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm1R_2ZxEvoQ7kNvwH_YCFt&_nc_oc=AdqQCP8bUO_eAUcL4OIFCrqrhCiKs0fp4--sbLMY5SF1-jvECS6p9pbcBPHckdmTXOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn22WFWQZRY7r-OWX9UPCc29MG5EnYxwH8FuozH3MGXQ&oe=6A4A83FA"}, {"file_name": "Screenshots5.png", "id": "2840462773023137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_2840462779689803_2241543172334676596_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY_ltQJLvwgQ7kNvwGcOvS7&_nc_oc=AdpQaIK58wxmwrivmfmbJSa-QzyiqSpyx4gBI5-wZp53JO9rFOdPueSBwWoblMhWIzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaoUsS4TWT087qjV0F4lofcnnMilwUyzW0X21O7Xqx0g&oe=6A4A766D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover2560x1440.png", "id": "2178819932592277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823934_2178819935925610_3831945784811405331_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y7PA-SxzV0Q7kNvwFrheFH&_nc_oc=AdoeinSqI_ygVa3VzfQNcssb-7FE1lDuhJqAlQJR-6u0G4G66sufdsHzIneAOK0j2hY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqZfgcHwvOBZDKx3YiUkbt-4OYads7bvjBWkr17rjVSg&oe=6A4A6A07"}, "display_name": "Leap Guys", "keywords": ["Leap", "guys", "leapguys", "party", "royale"], "long_description": "This party-platformer battle royal game centers on intuitive hand-based controls, allowing players to perform quick movements, double jumps, and interactions to achieve diverse objectives across multiple game modes. As you play, you can progress through a rewarding growth system that includes levels, rankings, and achievements. The initial release features Challenge, Competitive, and Party Modes, with additional modes to be introduced in future updates.\n\nThe Early Access version launches with two basic modes: Lobby and match. More modes will follow in subsequent updates.\n\n- Physics-Based Scene Interaction:\nLevels are built with fully interactive elements grounded in real-time physics. Manipulate objects such as seesaws, carts, chandeliers, pendulums, and windmills\u2014or activate switches, buttons, springs, and an array of mechanical traps to navigate and outsmart opponents.\n\n- Cooperative Competition:\nDesigned for social play, the game supports both collaboration and rivalry. In competition-oriented modes, players must work together yet strive to outperform each other to secure the best rank in level completion. Supports up to 30 players, depending on the mode.\n\n- Character Customization and UGC feature:\nExpress your style with a robust character personalization system. Create and share unique designs to stand out in the party. Also UGC mode will be updated gradually.", "short_description": "Guys, welcome to this VR party royale game. You can control the action with intuitive hand gestures\u2014double jump, glide, and navigate through richly interactive, physics-driven environments, but don't fall. Whether competing or teaming up with other players, you can fully customize your character and share your creations in a vibrant social community. Perfect for party settings, this game offers a lighthearted and engaging way to connect with others and enjoy shared moments of fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cnnetwork.cn/Privacy_Policy.html", "developer_terms_of_service_url": "https://www.cnnetwork.cn/LeapGuysTermsOfServers.htm", "publisher_name": "Kingnet Technology HK Limited", "support_website_url": null, "website_url": "https://www.cnnetwork.cn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24045350988478013"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1364731905272783"}]}, "baseline_offer": {"id": "1364731905272783"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762448400, "status": "PUBLISHED", "id": "1364731905272783"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25629802253366204", "version": "1.0"}, "id": "1272237470778658", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23935472212799225", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25629802253366204"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1272237470778658"}]}, "change_log": "auto submit for Leap Guys package", "created_date": 1773816314, "id": "25629802253366204", "version": "1.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "b
h85WKfoQT3cAC1NIaf-6jJy1EEfziLUg0vUQvw&oe=6A3550B9"}, {"file_name": "Screenshot 4 soundbath.png", "id": "1214899389903140", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820574_1214899393236473_8821545736345454299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs-x131jdHoQ7kNvwHc7n7w&_nc_oc=AdrL2U4bujZXisIFvEPB-Hrb_tXu8RW0bS1LH0RZblWF4WQRCdp4VWOxDHg9nj1W338&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pYUafkEhOLrBfA9du5cwPsjvhJGhHG2uWKuzckI4ZJA&oe=6A3545CA"}, {"file_name": "TRIPP_Screenshot_2560x1440.png", "id": "1422660415743750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824592_1422660419077083_2120275037635617437_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiK3upCTsMgQ7kNvwHnXfz7&_nc_oc=AdoXfbN8MGsR2tu63LcNQYs7qQzJhEPl_hS9iMwdJiOZyWac4g-mJIfKGfWyckKK1Tk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80hO3a-XHhb8u4BdSOqjY_YTJ0yYKu1FdPmuRWEn_eMg&oe=6A35587E"}, {"file_name": "TRIPP_Sound Bath_Screenshots Bowls Fish_2560x1440.png", "id": "1567762020861259", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507818746_1567762027527925_8246139963255701258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksd0GqYM8qcQ7kNvwFWV-BZ&_nc_oc=AdoOIFDn1iY3lDAntyeDHa98nKpFp_FFdoWyoeYhM001MJhMtSXnuOXCWJJwCdlJWXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mrMVzcyVrm2RoN3PESKVhbcqEom2z9i0m1VO7g_iDbg&oe=6A354C1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRIPP_Sound Bath_Video Cover Image_2560x1440.png", "id": "1241952427408769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301403_1241952434075435_3015933361298508862_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El16BP4XAT0Q7kNvwFunuTx&_nc_oc=Adp-VgA4l3WzSZVx6jaHWYbHxlOczLopgZtPUYNk4JemB29Xkh4fq5YGDlrzzAw04nc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BxUSoz55vhuSeuhiCqNAdcyZw7Xy9KAvw81zKIDMxGQ&oe=6A3559FB"}, "display_name": "Sound Bath by TRIPP", "keywords": ["Music", "Rhythm", "Meditation", "Sound", "Soundbath"], "long_description": "FROM LISTENER TO CREATOR: YOUR PERSONAL SYMPHONY AWAITS\n\n{759779279809918}\n\nForget passive meditation. Step beyond rhythm games. Welcome to Sound Bath by TRIPP, a revolutionary VR music experience where YOU are the composer, the DJ, and the artist. Immerse yourself in a transformative audiovisual journey designed to unlock your creativity and guide you to a state of deep relaxation.\n\nCRAFT YOUR OWN SONIC MASTERPIECE\n\nAt the heart of this experience are incredible, interactive singing bowls. Each bowl is a unique instrument, a gateway to a different sonic texture and visual wonder:\n\nBecome an Interactive DJ: Mix and layer sounds in real-time, creating a generative music soundscape that is uniquely yours.\n\nBuild a Mind-Expanding Audiovisual Journey: Watch as your musical choices paint the world around you with breathtaking, reactive visuals.\n\nDiscover Your Flow State: Lose yourself in a seamless blend of sound, sight, and interaction designed for ultimate focus and calm.\n\nA WORLD-CLASS STUDIO AT YOUR FINGERTIPS\n\nThis unparalleled music creation experience was born from a collaboration with the award-winning team at TRIPP and a curated lineup of world-renowned musical artists:\n\nTi\u00ebsto & 7 Skies\n\nDavid Starfire\n\nLiquid Bloom\n\nCloudchord\n\nWhether you seek boundless creativity, a powerful tool for mindfulness, or simply the ultimate immersive music sandbox, your personal symphony for the soul is here.\n\n{725462406891111}\n", "short_description": "Become the DJ of your own mesmerizing audiovisual journey. Step into a mind-expanding VR music creation experience designed by world-renowned artists Ti\u00ebsto & 7 Skies, David Starfire, & more. Interact with amazing singing bowls to mix your own unique sound bath, creating a personal symphony for the soul. Unleash your creativity and find deep relaxation in this immersive musical sandbox. Your sound, your sanctuary."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tripp.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tripp.com/terms-of-service/", "publisher_name": "TRIPP Inc.", "support_website_url": "https://www.tripp.com/support/", "website_url": "https://www.tripp.com/soundbath", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30962323110082288"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827286_24530419129909058_97774182403776404_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9KJkSlxEFAQ7kNvwEzRJBS&_nc_oc=AdoiFISc-rUNQiLSWwU8F3G8RyWwQGHej9RlRHSqVWvqtJCcu8GveQbpdc_PeBO8GuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LbdqbphhhnLGfCXN2uBRGRz433HIJliz9GTLfz_pvTQ&oe=6A35592D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sound Bath by TRIPP", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1752524580, "lastRevision": {"nodes": [{"id": "29862488896732387", "release_type": "SCHEDULED", "administration_status": "APPR
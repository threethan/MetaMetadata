5/491821200_678681581711820_7284210595731449312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTMZgkgUPDIQ7kNvwHA6HpY&_nc_oc=Adq6XUb4G4sfqyrbuR6W1H0oZ5VYsB6GWZZSugu6e_HlxxN2RQg1vY7IYSEv70byvx0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uUkgBr3Hph6Y1edRQfpvDRDCUiGakmOuwObMTRdlupQ&oe=69F608B9"}, {"file_name": "Screenshot 4 soundbath.png", "id": "1214899389903140", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820574_1214899393236473_8821545736345454299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcCLG8FIzC8Q7kNvwElnE9K&_nc_oc=Adr7tfcBku13n07rC_B-Y-RgTkLhwEQyUaPRnaScfgdrwkVMToAFttVQ64Fnk0ATbUY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iFHJ4AOQpwwoKtk-Fgc0R_ob_YZEgO06ktAVTi9Chdw&oe=69F5FDCA"}, {"file_name": "TRIPP_Screenshot_2560x1440.png", "id": "1422660415743750", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824592_1422660419077083_2120275037635617437_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNtj6RvSmdQQ7kNvwE_Wkxt&_nc_oc=AdpEnwi9uDSEgtQLjIyc5XD6Vw02yjuVT4jJQRCMCJEsgOWHRsxOvp_RPaUj5mwnPNw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eMUBguBG6lZbh8HI-MTX3GsP2gi3IB9zjMDbkGj3Z0g&oe=69F6107E"}, {"file_name": "TRIPP_Sound Bath_Screenshots Bowls Fish_2560x1440.png", "id": "1567762020861259", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507818746_1567762027527925_8246139963255701258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt6D47VD3fsQ7kNvwE-GRCi&_nc_oc=AdqOCJsKBMy5jrcNj62_4_dGf-8V6Y3EFEa3P0BymUSKDzGhCEHYEHk8Wvls5BeQEDI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NbACAT6hugHjKz4Q0CM4jPcWZc-_CQWct4mH0bUvG3A&oe=69F6041C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRIPP_Sound Bath_Video Cover Image_2560x1440.png", "id": "1241952427408769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499301403_1241952434075435_3015933361298508862_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8agsmnC700Q7kNvwGVotNs&_nc_oc=Adr4L0lNXNqOTL0Ii5dGmQ8UH20hsemXBDlNKMu6LsQO9Y86imyWM30ZYPQg9wHI0qk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RtCuJk6-BZoc6LUq5yNudJzfM9jkJjjk-zqDAPIJ2Jg&oe=69F611FB"}, "display_name": "Sound Bath by TRIPP", "keywords": ["Music", "Rhythm", "Meditation", "Sound", "Creativity"], "long_description": "Step into Sound Bath, a revolutionary VR experience from TRIPP, the award-winning creators of immersive wellness. Sound Bath invites you to become the maestro of your own audiovisual journey, where every sound bowl interaction deepens your connection to calm and creativity.\n\n{759779279809918}\n\nWith two intuitive virtual mallets in hand, explore an array of unique, resonant sound bowls. Each strike unleashes stunning immersive 360\u00b0 art and meticulously engineered soundscapes from a stellar lineup of renowned artists:\n\nDavid Starfire\n\nTi\u00ebsto & 7Skies\n\nLiquid Bloom\n\nCloudchord\n\nEvery note you play dynamically transforms the vibrant, responsive world around you, crafting a personalized, ever-evolving audio-visual masterpiece that's uniquely yours. Witness breathtaking visuals shift and evolve in perfect harmony with your sonic creations.\n\nSound Bath is more than just an experience; it's your personal symphony for the soul, designed to:\n\nInduce Deep Relaxation: Melt away stress and find profound tranquility.\n\nSpark Boundless Creativity: Explore new forms of expression through interactive art and sound.\n\nCultivate Presence: Immerse yourself fully in the moment, enhancing mindfulness.\n\nDiscover a harmonious blend of deep relaxation, boundless creativity, and profound presence. Get Sound Bath today on Meta Quest and redefine your reality.\n{725462406891111}\n\n\n", "short_description": "Immerse yourself in a transformative VR Sound Bath created by the award-winning team at TRIPP! Interact with sound bowls to create your own mesmerizing, mind-expanding audio-visual journey. These amazing singing bowls have been designed by top world-renowned musical artists David Starfire, Ti\u00ebsto & 7 Skies, Liquid Bloom, and Cloudchord! Shower your senses in your personal symphony for the soul! Experience deep relaxation & boundless creativity. Your personal symphony for the soul on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tripp.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tripp.com/terms-of-service/", "publisher_name": "TRIPP Inc.", "support_website_url": "https://www.tripp.com/support/", "website_url": "https://www.tripp.com/soundbath", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30282627291385210"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1168962545333506"}, {"status": "PUBLISHED", "id": "764489976445815"}, {"status": "PUBLISHED", "id": "1747007719521476"}, {"status": "PUBLISHED", "id": "1242287380683484"}]}, "baseline_offer": {"id": "1242287380683484"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1168962545333506"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30485897467724857", "version": "1.1.0.39"}, "id": "1043817781226339", "channel_name": "LIVE"}]}, "is_f
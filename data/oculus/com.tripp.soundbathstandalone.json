5/491821200_678681581711820_7284210595731449312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D02QHwYrgNcQ7kNvwHfoJ3d&_nc_oc=AdqV-wj7TUccotEt9PK53z-68hIkUvHaF-qIMpDnPxUb3LFyxuW7tF4cAMr3uVnIK74&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XJB_0jCsZxluYUP0CR3uwpyX0pQydvRvu_xWQxKA2vw&oe=69EF7139"}, {"file_name": "Screenshot 4 soundbath.png", "id": "1214899389903140", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820574_1214899393236473_8821545736345454299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3mhljBHBaUQ7kNvwGzVaXj&_nc_oc=AdpaCQtp2iCW2n1UacB4Sn-ZBxm02BoL606pG8r6wPfsw5i25VY7ZaEsBw_sMlxNxsU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Esh9Trnrh86K1uLtyk8zMRYLHOY4oXoRg4csXBBo5Qw&oe=69EF664A"}, {"file_name": "TRIPP_Screenshot_2560x1440.png", "id": "1422660415743750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824592_1422660419077083_2120275037635617437_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r3T2kLaAMAQ7kNvwFS0pnZ&_nc_oc=AdpdlQx0RXTE5mKRyUqGoa1oBXVC07GvUIzn0Vn5qlu4860d2McvMLjWbVzTQaLI6mA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vBmTIEkYvVvl5F2Jioi_vfv_glaMjhJzfo7xfaVjJUA&oe=69EF78FE"}, {"file_name": "TRIPP_Sound Bath_Screenshots Bowls Fish_2560x1440.png", "id": "1567762020861259", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507818746_1567762027527925_8246139963255701258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEtncHHx_-gQ7kNvwGf8srf&_nc_oc=AdozTQ9K6hCJYEnJScRhZ0eCsbR9H-qzUMPg4RlATBawUX1G85IL09Q4PsqUNcWnyOk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2j6_xUPBnGQc7QtPGIerIkiYqTpvxHeHufl2p5t62Bng&oe=69EF6C9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRIPP_Sound Bath_Video Cover Image_2560x1440.png", "id": "1241952427408769", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301403_1241952434075435_3015933361298508862_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIo2tawN9JQQ7kNvwGjuM2d&_nc_oc=AdqIaRScLiW5LocxNQHPPmtqJ9I7FUiYy6eaQ9DJKtl2keu_ijulNHu8bTzuiJOdz5I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HHRlMaiuQM1zpPL_9gIr5gDq8r_3a6bD0tVfhjWQCEQ&oe=69EF7A7B"}, "display_name": "Sound Bath by TRIPP", "keywords": ["Music", "Rhythm", "Meditation", "Sound", "Creativity"], "long_description": "Step into Sound Bath, a revolutionary VR experience from TRIPP, the award-winning creators of immersive wellness. Sound Bath invites you to become the maestro of your own audiovisual journey, where every sound bowl interaction deepens your connection to calm and creativity.\n\n{759779279809918}\n\nWith two intuitive virtual mallets in hand, explore an array of unique, resonant sound bowls. Each strike unleashes stunning immersive 360\u00b0 art and meticulously engineered soundscapes from a stellar lineup of renowned artists:\n\nDavid Starfire\n\nTi\u00ebsto & 7Skies\n\nLiquid Bloom\n\nCloudchord\n\nEvery note you play dynamically transforms the vibrant, responsive world around you, crafting a personalized, ever-evolving audio-visual masterpiece that's uniquely yours. Witness breathtaking visuals shift and evolve in perfect harmony with your sonic creations.\n\nSound Bath is more than just an experience; it's your personal symphony for the soul, designed to:\n\nInduce Deep Relaxation: Melt away stress and find profound tranquility.\n\nSpark Boundless Creativity: Explore new forms of expression through interactive art and sound.\n\nCultivate Presence: Immerse yourself fully in the moment, enhancing mindfulness.\n\nDiscover a harmonious blend of deep relaxation, boundless creativity, and profound presence. Get Sound Bath today on Meta Quest and redefine your reality.\n{725462406891111}\n\n\n", "short_description": "Immerse yourself in a transformative VR Sound Bath created by the award-winning team at TRIPP! Interact with sound bowls to create your own mesmerizing, mind-expanding audio-visual journey. These amazing singing bowls have been designed by top world-renowned musical artists David Starfire, Ti\u00ebsto & 7 Skies, Liquid Bloom, and Cloudchord! Shower your senses in your personal symphony for the soul! Experience deep relaxation & boundless creativity. Your personal symphony for the soul on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tripp.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tripp.com/terms-of-service/", "publisher_name": "TRIPP Inc.", "support_website_url": "https://www.tripp.com/support/", "website_url": "https://www.tripp.com/soundbath", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30282627291385210"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1168962545333506"}, {"status": "PUBLISHED", "id": "764489976445815"}, {"status": "PUBLISHED", "id": "1747007719521476"}, {"status": "PUBLISHED", "id": "1242287380683484"}]}, "baseline_offer": {"id": "1242287380683484"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1168962545333506"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30485897467724857", "version": "1.1.0.39"}, "id": "1043817781226339", "channel_name": "LIVE"}]}, "is_f
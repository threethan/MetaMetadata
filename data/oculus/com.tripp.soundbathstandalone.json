5/491821200_678681581711820_7284210595731449312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3ZWVfXH8QgQ7kNvwEjoE76&_nc_oc=AdoYghSiioo6ydD2c_gOfS5b1ro9qJT38jeOGyXAkc0gfj5XZFXn2F18XyCY6jYJDG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw7EURXt5KJOefBRk0farzqee3DX4uNm0Wc5g9pB3JaQ&oe=6A4BBA39"}, {"file_name": "Screenshot 4 soundbath.png", "id": "1214899389903140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820574_1214899393236473_8821545736345454299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF-xNlG1VT4Q7kNvwGGVUWt&_nc_oc=AdreZNmSwCHNuxOdmORWt4lcuY34jGMFmRL4i9eVu41QakznQ7okETWX-a1xzOkE1sA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBldEpZ9ABjwS1ZFzc-AZ14JTQeVfUtBoLUzuaS9_23fw&oe=6A4BAF4A"}, {"file_name": "TRIPP_Screenshot_2560x1440.png", "id": "1422660415743750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824592_1422660419077083_2120275037635617437_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUzYO0BFnEAQ7kNvwGmsVQr&_nc_oc=AdokLEKeMic421nqm0mdjxzAIc6VOMulIlqGD4e1siaZ8oR8SdIqJ46x-7rwThxmS9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGJKMNuS5hcN7cacLrAr-dki2oa75XR9RAoc0vCm03xA&oe=6A4BC1FE"}, {"file_name": "TRIPP_Sound Bath_Screenshots Bowls Fish_2560x1440.png", "id": "1567762020861259", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507818746_1567762027527925_8246139963255701258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9vX0Sl_6NQQ7kNvwGask6Y&_nc_oc=AdqF4ph41J8DG2n26kyH5_rgkoLY0GUVanVqwdZl3VaNWinPr7YOOP2qjXve8N0grp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiprPnJrGyYsvHB4FUClnmonzqv6ODrLdGrx6UHOvl6g&oe=6A4BB59C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRIPP_Sound Bath_Video Cover Image_2560x1440.png", "id": "1241952427408769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301403_1241952434075435_3015933361298508862_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZgbI3bVdFcQ7kNvwHYI0BF&_nc_oc=AdorWPeZ5M09L6qGH58sdwBmnpE6wI6zI8a2iyJVeW7UQjwfu1u1hM76suZZuPem8Ow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCON71q7ZU0RoK5Z0YvFW1CLGUU81KDm2TxmWL2m_F_GA&oe=6A4BC37B"}, "display_name": "Sound Bath by TRIPP", "keywords": ["Music", "Rhythm", "Meditation", "Sound", "Creativity"], "long_description": "Step into Sound Bath, a revolutionary VR experience from TRIPP, the award-winning creators of immersive wellness. Sound Bath invites you to become the maestro of your own audiovisual journey, where every sound bowl interaction deepens your connection to calm and creativity.\n\n{759779279809918}\n\nWith two intuitive virtual mallets in hand, explore an array of unique, resonant sound bowls. Each strike unleashes stunning immersive 360\u00b0 art and meticulously engineered soundscapes from a stellar lineup of renowned artists:\n\nDavid Starfire\n\nTi\u00ebsto & 7Skies\n\nLiquid Bloom\n\nCloudchord\n\nEvery note you play dynamically transforms the vibrant, responsive world around you, crafting a personalized, ever-evolving audio-visual masterpiece that's uniquely yours. Witness breathtaking visuals shift and evolve in perfect harmony with your sonic creations.\n\nSound Bath is more than just an experience; it's your personal symphony for the soul, designed to:\n\nInduce Deep Relaxation: Melt away stress and find profound tranquility.\n\nSpark Boundless Creativity: Explore new forms of expression through interactive art and sound.\n\nCultivate Presence: Immerse yourself fully in the moment, enhancing mindfulness.\n\nDiscover a harmonious blend of deep relaxation, boundless creativity, and profound presence. Get Sound Bath today on Meta Quest and redefine your reality.\n{725462406891111}\n\n\n", "short_description": "Immerse yourself in a transformative VR Sound Bath created by the award-winning team at TRIPP! Interact with sound bowls to create your own mesmerizing, mind-expanding audio-visual journey. These amazing singing bowls have been designed by top world-renowned musical artists David Starfire, Ti\u00ebsto & 7 Skies, Liquid Bloom, and Cloudchord! Shower your senses in your personal symphony for the soul! Experience deep relaxation & boundless creativity. Your personal symphony for the soul on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tripp.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tripp.com/terms-of-service/", "publisher_name": "TRIPP Inc.", "support_website_url": "https://www.tripp.com/support/", "website_url": "https://www.tripp.com/soundbath", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30282627291385210"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "3120173628169686"}, {"status": "PUBLISHED", "id": "1168962545333506"}, {"status": "PUBLISHED", "id": "764489976445815"}, {"status": "PUBLISHED", "id": "1747007719521476"}, {"status": "PUBLISHED", "id": "1242287380683484"}]}, "baseline_offer": {"id": "1242287380683484"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "3120173628169686"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30485897467724857", "version": "1.1.0.39"}, "id": "
{"data": {"node": {"__typename": "Application", "id": "33237479149199538", "organization": {"id": "615890594948544", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1151306484740283"}]}, "id": "829652800097902"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1144833202054278"}]}, "id": "1461679019326686"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26736770856017797"}]}, "id": "840480441980074"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26666357279716565"}]}, "id": "806097815671237"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26059156970405219"}]}, "id": "2795115880842715"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "33237479149199538"}]}, "id": "2817405925132435"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24137501455945594"}]}, "id": "1073471151623860"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9833104433421266"}]}, "id": "1715631763165835"}]}}, "firstRevision": {"nodes": [{"application": {"id": "33237479149199538", "release_date": 1768487700, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37947277831552956"}, "id": "2343670089411540"}]}}, "binary": null, "live_binary": null, "created_date": 1786037098, "id": "37814028561544551", "is_initial_release": false, "name_with_fallback": "v10", "pdp_metadata_with_fallback": {"version": 8, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "37921197314161008"}, "release_status": "RELEASED", "id": "33237479149199538"}, "id": "37921197314161008", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "33237479149199538", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1217580693685023"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "28360139910278064", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Border Patrol: Checkpoint Control VR", "keywords": ["Border", "shooting", "security", "patrol", "smugglers"], "long_description": "You are the last line of defense at the border.\nEveryone looks innocent\u2026 but some are hiding dangerous contraband.\n\nScan travelers. Inspect vehicles. Catch smugglers before they slip through.\n\n\ud83c\udfaf Core Gameplay\n\nEvery decision matters.\n\nOne mistake can let a smuggler escape\u2026 or stop an innocent person.\n\n\ud83d\udec2 Document Verification\n\nCheck passports for mismatches, expired data, and forged identities.\nSpot small details\u2014because smugglers rely on your mistakes.\n\n\ud83d\ude97 Vehicle Inspection\n\nSearch vehicles, cargo, and hidden compartments.\nFind illegal items, concealed goods, and cleverly hidden contraband.\n\n\ud83e\uddcd Traveler Screening\n\nScan travelers for suspicious behavior and hidden threats.\nSome will lie. Some will panic. Some will try to trick you.\n\n\u26a0\ufe0f High-Stakes Decisions\n\nApprove, deny, detain, or escalate.\nYour choices affect security, efficiency, and what happens next.\n\n\ud83c\udfae Built for VR\n\nFully interactive tools, immersive environments, and intuitive controls designed for Meta Quest.\n\n\ud83d\udd12 Disclaimer\n\nThis is a fictional experience created for entertainment.", "short_description": "Scan travelers. Catch smugglers. Stop hidden threats. Verify documents, search vehicles, scan travelers, and enforce checkpoint protocols in immersive VR. One mistake can let danger cross the border. "}, {"images": {"nodes": []}, "id": "27842926748703548", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Control Fronterizo Atrapa Contrabandista", "keywords": ["frontera", "inspecci\u00f3n", "seguridad", "simulaci\u00f3n", "control"], "long_description": "Eres la \u00faltima l\u00ednea de defensa en la frontera.\nTodos parecen inocentes\u2026 pero algunos esconden contrabando.\nInspecciona viajeros. Revisa veh\u00edculos. Atrapa contrabandistas antes de que escapen.\n\ud83c\udfaf Jugabilidad principal\nCada decisi\u00f3n importa.\nUn error puede cambiarlo todo.\n\ud83d\udec2 Verificaci\u00f3n de documentos\nDetecta pasaportes falsos y errores.\n\ud83d\ude97 Inspecci\u00f3n de veh\u00edculos\nBusca en compartimentos ocultos.\n\ud83e\uddcd Control de viajeros\nDetecta comportamientos sospechosos.\n\u26a0\ufe0f Decisiones cr\u00edticas\nPermitir, negar o detener.\n\ud83c\udfae Dise\u00f1ado para VR\nOptimizado para Meta Quest.\n\ud83d\udd12 Aviso\nExperiencia ficticia.\n", "short_description": "Escanea viajeros. Atrapa contrabandistas. Det\u00e9n amenazas ocultas.\nUn error puede dejar pasar el peligro.\n"}, {"images": {"nodes": []}, "id": "4655928124729323", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u8fb9\u5883\u68c0\u67e5VR\uff1a\u6293\u6355\u8d70\u79c1\u8005", "keywords": ["\u8fb9\u5883", "\u68c0\u67e5\u7ad9", "\u6a21\u62df", "\u5b89\u5168"], "long_description": "\u4f60\u662f\u8fb9\u5883\u7684\u6700\u540e\u9632\u7ebf\u3002\n\u6bcf\u4e2a\u4eba\u770b\u8d77\u6765\u90fd\u5f88\u6b63\u5e38\u2026\u2026\u4f46\u6709\u4eba\u9690\u85cf\u7740\u5371\u9669\u7684\u8d70\u79c1\u7269\u54c1\u3002\n\u68c0\u67e5\u65c5\u5ba2\uff0c\u641c\u67e5\u8f66\u8f86\uff0c\u5728\u4ed6\u4eec\u9003\u8131\u524d\u6293\u4f4f\u8d70\u79c1\u8005\u3002\n\ud83c\udfaf \u6838\u5fc3\u73a9\u6cd5\n\u6bcf\u4e2a\u51b3\u5b9a\u90fd\u81f3\u5173\u91cd\u8981\u3002\n\ud83d\udec2 \u8bc1\u4ef6\u68c0\u67e5\n\u8bc6\u522b\u5047\u62a4\u7167\u548c\u5f02\u5e38\u4fe1\u606f\u3002\n\ud83d\ude97 \u8f66\u8f86\u68c0\u67e5\n\u641c\u7d22\u9690\u85cf\u7684\u8fdd\u7981\u54c1\u3002\n\ud83e\uddcd \u4eba\u5458\u68c0\u67e5\n\u53d1\u73b0\u53ef\u7591\u884c\u4e3a\u3002\n\u26a0\ufe0f \u9ad8\u98ce\u9669\u51b3\u7b56\n\u653e\u884c\u3001\u62d2\u7edd\u6216\u62d8\u7559\u3002\n\ud83c\udfae \u4e13\u4e3aVR\u6253\u9020\n\u4e3aMeta Quest\u4f18\u5316\u3002\n\ud83d\udd12 \u514d\u8d23\u58f0\u660e\n\u672c\u6e38\u620f\u4e3a\u865a\u6784\u5185\u5bb9\u3002", "short_description": "\u626b\u63cf\u65c5\u5ba2\uff0c\u6293\u4f4f\u8d70\u79c1\u8005\uff0c\u963b\u6b62\u9690\u85cf\u5a01\u80c1\u3002\n\u4e00\u6b21\u5931\u8bef\u5c31\u53ef\u80fd\u653e\u8d70\u5371\u9669\u3002"}, {"images": {"nodes": [{"file_name": "icon new.png", "id": "3131436580389519", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310731_3131436583722852_7863798906073153301_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_hy7rdpHhAQ7kNvwEhZVoW&_nc_oc=Adokdwdao7_72ItxiN0ZcN_7JhkGzhKmGoEMzhOCRK9O7PV3isE5QeIlV2XeuRuY7ag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUijDzJodDyc9y-FjIdTMDpQZ4u9eFOWYM80enhb5XbA&oe=6AA15B1B"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1920551612258549", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312332_1920551615591882_5920452420334165844_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x05bVL9jggkQ7kNvwHsuz4x&_nc_oc=Adooh4f05gwhuMpjxr_F5s6HoB2t8yPueqsoKGqWkuHNAHEzwsCyWaGtrigBC5aNfCI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKctGM2I5i_21AW7dZIY6BQvRzun5izC54_YFk_cedqtg&oe=6AA1542E"}, {"file_name": "Portrait - 1008x1440.png", "id": "1536313210990445", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t6
5771-25/499307346_1202833178616447_3057763622131564050_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byADImRDkU8Q7kNvwGCbqy2&_nc_oc=AdoCTVNoZcRw_lnwg69P0-dacS7pwDBGeGA03S7OSdOyre2v1NmXc7t48KMoxGGol30&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO6kwGE7kU342xayA7-rw-4Z53cdZW0jFtO04MbbYR7Q&oe=6AA15A94"}, {"file_name": "1.png", "id": "4382060558786343", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_4382060565453009_1581885410517495199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3uS7MqhmYcQ7kNvwG1xZdb&_nc_oc=AdrZyqEBF1Um8GfdpAeaVROk7nm6Dd-N6uC_XEBuJBhRHMgp7PxfnL3_9zV7Dyab4GY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHz2lHdRL3oRrcJ18TByLIWVA5NWBfCz9vwecSOjvXLQ&oe=6AA16E3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Border Patrol: Checkpoint Control VR", "keywords": ["Border", "Security", "Control", "Quarantine", "Action"], "long_description": "Border Patrol: Checkpoint Control VR is an immersive VR simulation that places you in command of a high-security border checkpoint in a fictional world facing rising security and public safety challenges.\nEvery vehicle that arrives must be inspected. Every traveler must pass clearance protocols. Your decisions determine who is allowed to enter the city and who is stopped.\n\n\ud83d\udec2 Document Verification:\nInspect passports for identity, photo match, expiration, and authenticity. Detect forged or mismatched documents under time pressure.\n\ud83d\ude97 Vehicle Inspection:\nSearch trunks, cargo areas, and compartments. Identify illegal weapons, restricted items, and undeclared goods.\n\n\ud83e\uddcd Traveler Screening:\nConduct professional, non-intrusive body inspections using scanning tools. Detect concealed items and visible indicators while following proper procedures.\n\n\ud83e\ude7a Medical & Safety Checks:\nMeasure temperature and oxygen saturation, and perform full-body scans to identify contamination or bite marks. Decide between clearance, quarantine, or observation.\n\n\u2696\ufe0f Decision-Based Outcomes:\nGrant entry, deport travelers with invalid documents, detain suspects, or quarantine individuals who fail medical screening. Each choice affects border efficiency, city safety, and public health.\n\n\ud83c\udfae Designed for VR:\nBuilt for Meta Quest with interactive tools, intuitive controls, seated and standing play modes, and comfort options.\n\nNote: This experience is entirely fictional and created for entertainment purposes only.", "short_description": "Inspect, decide, and control the border.\nVerify documents, search vehicles, scan travelers, and enforce checkpoint protocols in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33237479215866198"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2618451198557815"}, {"status": "PUBLISHED", "id": "1635370414488282"}]}, "baseline_offer": {"id": "2618451198557815"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781184540, "status": "PUBLISHED", "id": "2618
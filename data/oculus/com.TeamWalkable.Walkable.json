imizes the benefits of walking, enhancing refreshment and focus!"}]}, "developer_name": "TeamWalkable", "developer_privacy_policy_url": "https://github.com/nshigenaga/walkablesupport/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "TeamWalkable", "support_website_url": null, "website_url": "https://github.com/nshigenaga/walkablesupport", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10069147899826068"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1005827077335469"}]}, "baseline_offer": {"id": "1005827077335469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1697142036, "status": "PUBLISHED", "id": "1005827077335469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23911434231837534", "version": "1.0.9"}, "id": "846674020396922", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10069147866492738", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23911434231837534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "846674020396922"}]}, "change_log": null, "cre
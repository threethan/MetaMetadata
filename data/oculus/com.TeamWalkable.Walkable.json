!\nWith \u2018Walkable\u2019, reap the dual benefits of enjoyment and health. Maintain anabolic energy in your daily life, balance your mind and body, and enhance performance. It's sustainable even for the busiest ones among you, keeping you lively and proficient throughout the day.", "short_description": "Walkable\u2019: Your Ultimate Morning VR Exercise Routine!\n\nTo all the accomplished professionals brimming with energy! \n\nIntroducing \u2018Walkable\u2019, a VR content that elevates your anabolic state through quick morning workouts, rendering you full of energy with the ultimate outline all day long. It maximizes the benefits of walking, enhancing refreshment and focus!"}]}, "developer_name": "TeamWalkable", "developer_privacy_policy_url": "https://github.com/nshigenaga/walkablesupport/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "TeamWalkable", "support_website_url": null, "website_url": "https://github.com/nshigenaga/walkablesupport", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10069147899826068"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1005827077335469"}]}, "baseline_offer": {"id": "1005827077335469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1697142036, "status": "PUBLISHED", "id": "1005827077335469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typenam
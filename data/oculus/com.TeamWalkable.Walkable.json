98791275413_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8BIk8OGKPcQ7kNvwFbA8n2&_nc_oc=Adkv-ijk7o38mkGvwJk94Thyo2uJTXG8kjVLDkkmlqXeUiQ9PnBn34wPrtGjeQFkmKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft2PsQoCXjcW-4NJFRkRHnL06tSJcz4IrzcUrNkDTZmjQ&oe=699F05E1"}, {"file_name": "pv25601440d.png", "id": "324000593543904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195908_324000596877237_1892223511648733278_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue3b3Fy31X8Q7kNvwH0gIw8&_nc_oc=AdnVFSUaizEHiixoTfvsR3mANqNXSP30S9Qm0nlpUAPZs4WYsypFbw08loiOd_dDx0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuOU80CP4vjV1zLGKrueK37p0TgYdvJEWcOUxM08AXnQg&oe=699F0708"}, {"file_name": "pv25601440e.png", "id": "254449407099694", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974622_254449410433027_9005952085110027868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ztd_WKVRIqIQ7kNvwGtIr2_&_nc_oc=AdleWXhq1C5YLsKaUomF84T6DmOO-yv00o1RlPneMRymlpnhTgFrvTEFqtZIXjfqg8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsuJ6850PMZkSvO7PJiBtQyzD1HEgIXNef_bAxcMwDkHA&oe=699EF040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizontal25601440.png", "id": "199280769849623", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974589_199280773182956_2321753383928087363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctMUbg0fL7gQ7kNvwH8HRpj&_nc_oc=AdnkexnLR2PvBsURp5GiOLcx-Okle2-BdYFXyzi7cpn2-mvT4XX5_o5-5-ej-6AuEXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu_m5JgM12PEwstrz7Ay6rcvpZS6rp8KFzG9gZOSRox7Q&oe=699EDC5F"}, "display_name": "Walkable", "keywords": [], "long_description": "Walkable\u2019: Your Ultimate Morning VR Exercise Routine!\n\nTo all the accomplished professionals brimming with energy! \n\nIntroducing \u2018Walkable\u2019, a VR content that elevates your anabolic state through quick morning workouts, rendering you full of energy with the ultimate outline all day long. It maximizes the benefits of walking, enhancing refreshment and focus!\n\nThe Allure of \u2018Walkable\u2019\nDesigned for busy workers to maintain mental and physical health efficiently without being bound by time, \u2018Walkable\u2019 eliminates the need for gym visits and changing into workout gear. Even the most accomplished individuals can easily incorporate exercise into their bustling routines.\n\nSynergy of Beautiful Outline and Effective Exercise\n\u2018Walkable\u2019 incorporates short workouts before your commute walk, refining your body's outline and elevating walking to a more beneficial exercise. Through engaging VR content, exploit your muscles effectively in a short time and enjoy the anabolic benefits.\n\nExperience Fitness with Fun!\nWith \u2018Walkable\u2019, reap the dual benefits of enjoyment and health. Maintain anabolic energy in your daily life, balance your mind and body, and enhance performance. It's sustainable even for the busiest ones among you, keeping you lively and proficient throughout the day.", "short_description": "Walkable\u2019: Your Ultimate Morning VR Exercise Routine!\n\nTo all the accomplished professionals brimming with energy! \n\nIntroducing \u2018Walkable\u2019, a VR content that elevates your anabolic state through quick morning workouts, rendering you full of energy with the ultimate outline all day long. It maximizes the benefits of walking, enhancing refreshment and focus!"}, {"images": {"nodes": [{"file_name": "MiniHor1008360.png", "id": "2248312642019042", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_2248312645352375_6326906984838481725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P_BZRR3vUYQ7kNvwG5TIDD&_nc_oc=Adll0SGfhmoPMsvPGIqlMCMs0WCYn6IIiSxaGqtiz_rKo6gpq0Rbf09Plz60WbDkLa4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu4DY0dMpdQBUwRmkQVMMrF30Vc3rgOajfGXRtBo3zijQ&oe=699EDAF7"}, {"file_name": "PDP3000900.png", "id": "1086292042534564", "image_type": "APP_I
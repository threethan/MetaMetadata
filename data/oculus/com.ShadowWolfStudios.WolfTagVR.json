&oh=00_Afwmhs8P6pxPrzm7ks7CTK0gVSOlgVti96r79-tbb9btGQ&oe=69CBB2DA"}, {"file_name": "4.png", "id": "395517892895324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984472_395517896228657_5375493590523898550_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orq-wxJnSuAQ7kNvwEt3cmW&_nc_oc=AdrxQXGzlerVksllgkkgDHxiLkscqyXINyFbvxUZZGfERZ8VGqX1Qn4SbIhEECurqxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY_AixiFCUFwKtt9Nz0aDYwy1kF18ak7XCHvtS5CPvbA&oe=69CBB470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wolf Tag VR", "keywords": [], "long_description": "This game was originally going to be the first project for me but I decided to make it a full game! This game is like gorilla tag but with more Maps, Cosmetics, and more! The game is a Gorilla tag fan game but with wolves!", "short_description": "A fun Gorilla tag fan game that was made for people who wanted it to be mixed up from gorillas to wolves!"}]}, "developer_name": "ShadowWolfStudios", "developer_privacy_policy_url": "http://wolftagvr.rf.gd/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShadowWolfStudios", "support_website_url": null, "website_url": "http://wolftagvr.rf.gd/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8163429090348287"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "285963634010325"}]}, "baseline_offer": {"id": "285963634010325"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1721875229, "status": "PUBLISHED", "id": "285963634010325"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9507010935990089", "version": "0.4.5"}, "id": "1890976404631088", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6676585659032645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9507010935990089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890976404631088"}]}, "change_log": null, "created_date": 1739558644, "id": "9507010935990089", "version": "0.4.5", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6676585659032645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9507010935990089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890976404631088"}]}, "change_log": "Hey Gamers! Just a patch fix!\n\nPatch:\n\nPhotonVR\n- When you join a lobby you start flying uncontrollably", "created_date": 1738807068, "id": "9455371037820746", "version": "0.4.4", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6676585659032645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9507010935990089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890976404631088"}]}, "change_log": "Hey Gamers! This isn't a huge update but there are some cool features that were added!\n\nPatch Notes:\n\nLighting:\n- All Lighting is now baked! That should help with performance quite a bit!\n\nMovement:\n- Movement should feel a lot better as i went through some optimizations for it\n\nShop:\n- Promo Code Kiosk! Follow the socials and join the discord to get codes!\n\nGamemodes:\n- I think Tag has been fixed. Unsure at the moment still need to test but am unable to.", "created_date": 1738742965, "id": "9451149514909565", "version": "0.4.3", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6676585659032645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9507010935990089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890976404631088"}]}, "change_log": "Hey Gamers! Welcome to the first update of February! Not a big update but it is important!\n\nHere's the patch notes:\n\nGeneral:\n - Added optimizations for Quest 2 and Quest 3 as they were under performing compared to the Quest 3s.\n\nDen:\n - Trying different lighting in the den only. If you guys like it and I don't see any bugs with it I will keep it.\n\nFloor is Lava:\n - Fixed it being unplayable. It now goes all the way down so you guys can play it.\n\nShop:\n - Added more shelves so that I can add more cosmetics over time without the hassle of expanding.\n\nRed Light Green Light:\n - Added Audio Cues now\n\nGlass Bridge:\n - Fixed the fall teleport. You will now teleport correctly.\n\nColor Game:\n - Fixed the teleport. It is now playable.\n\n(New!) Tutorial:\n - Thank you everyone for your feedback. I have added a tutorial that will only need to be completed once.\n - Has visuals on how to move\n - Has Audio instructions on how to play.\n - Please note you MUST restart your game upon completion to play online. That is a bug that I haven't been able to fix.", "created_date": 1738387724, "id": "9429905730367277", "version": "0.4.2", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6676585659032645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9507010935990089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890976404631088"}]}, "change_log": "What's up gamers! We're back with \"The Wolf Games\" part 2! Now I know there were some bugs in part 1. I apologize about that and I have been hard at work fixing them all.\n\nWith that said, here's the Patch Notes:\n\nLighting:\n- Trying Baked Lighting out, email me @ wolfbromail@gmail.com with your opinions on it.\n\nThe Hub:\n- Fixed not teleporting to the color game\n- Added the Bridge to the games tunnel\n- All buttons now have \"Join Room Triggers\" since they all require you to be in a lobby to play\n\n(New!) The Glass Bridge:\n- Based off squid games glass bridge where you have to get to the other side!\n- Reach the end or fall through the floor, don't take a wrong step!\n\nFloor is Lava:\n- Fixed getting suspended in the air when you get touched by the lava.\n\nMod Vents:\n- Kick Hammer now equips\n\nTunnels:\n- Following tunnels now have \"Join Room Triggers\": Floor is Lava, Mod Vents, Color Games (Buttons)", "created_date": 1737838768, "id": "9396944060330111", "version": "0.4.1", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
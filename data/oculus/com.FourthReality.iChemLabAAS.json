 (5).png", "id": "430517786295583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443247_430517789628916_3299789398074769530_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqkowTCI46AQ7kNvwEPJMts&_nc_oc=AdpE-um__pgZTU_meoiTHWldNTuv5FC_SlwUSJIDTvisRz6nS2RyeKh9Y4s7_sAPc1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2GBc2qhqK8YGyVV2KYWrTRgGVixsEzMs5ZoXIZaZ08w&oe=6AA6C55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DCU External Cover Art Landscape.png", "id": "453677160332938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86684226_453677163666271_6361345266614506979_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vO9i8rManQQ7kNvwGpuoAT&_nc_oc=AdqVQJEV9Gm9g_vn_B1nKM-ZFfgXs1AuvUR7icld9OnvkiOzS7vUVeb2byr1_bKtEr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSvghxG6Ur9CJZTFr8eYV7KFwb1hWVN942-PdTE3-5Uw&oe=6AA6A358"}, "display_name": "Immersive ChemLab - AAS", "keywords": [], "long_description": "The Immersive Chemistry Lab is designed as a virtual environment for training in analytical techniques for quantitative chemistry experiments. In this module series, students get to perform metal analysis using flame Atomic Absorption Spectrometry (AAS) to get \u2018hands on\u2019 experience operating lab instrumentation, optimising conditions and undertaking quantitative analysis. \n\nThe lab environment has been designed for training third level chemistry undergraduate students at the School of Chemical Sciences at Dublin City University (DCU) but has great potential as an immersive experience of an analytical chemistry lab for second level and even primary level students. \n\nThe Immersive ChemLab project is still very much in development. Feedback, suggestions and even compliments at this stage are particularly welcome - please get in touch - aoife.morrin@dcu.ie\n", "short_description": "The Immersive Chemistry Lab is designed as a virtual environment for training in analytical techniques for quantitative chemistry experiments. In this module series, students get to perform metal analysis using flame Atomic Absorption Spectrometry (AAS) to get \u2018hands on\u2019 experience operating lab instrumentation, optimising conditions and undertaking quantitative analysis. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fourthreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fourth Reality", "support_website_url": null, "website_url": "https://www.fourthreality.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7434364653316334"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "697508676716797"}, {"status": "PUBLISHED", "id": "794306630105484"}, {"status": "PUBLISHED", "id": "4457880724538651"}, {"status": "PUBLISHED", "id": "4027301850917979"}, {"status": "PUBLISHED", "id": "267397396438573"}]}, "baseline_offer": {"id": "4457880724538651"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773060660, "status": "PUBLISHED", "id": "697508676716797"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28253462070979955", "version": "1.0.9"}, "id": "901667945033176", "channel_name": "LIVE"}]}, "is_for_oculus_ke
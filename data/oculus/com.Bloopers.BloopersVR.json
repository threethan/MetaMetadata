n.com&_nc_ss=7f20f&oh=00_AQTyNHTQOVZFgAuESVt0rLO7W1JQydP5jRfaC4qOmxoJtg&oe=6AFDBE6B"}]}, "id": "1649192050319359", "locale": "en_US", "screenshots": [{"file_name": "Bloopers multiplayer lobby.png", "id": "1105551165505709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1105551172172375_2114836483273602969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIyrPa6Itt8Q7kNvwE--Aq4&_nc_oc=AdpgiTRCGOAMOdUo3EFsGM329o7THYpGsGIZm6Vk7kbYzoBpNIQ4OrvooRoQIbz99eY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOWewDfKeyKKsTpzvJWe_SsJvhfI8E8xWy6bIXYfLdzQ&oe=6AFDB569"}, {"file_name": "ClassicLevel1players.png", "id": "1964580971557239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628411_1964580978223905_8195160644881487430_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vB1YpONGg00Q7kNvwGN-9in&_nc_oc=AdpS4PqXoqi6YqRpSfZ9bPWfZLQpZ_ZAg_H4ui7gDJWY356rlSp5rTor7bIPGP0W3FQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0oN1aLccbS6slTtQHhVuP7liOdb0HL7B-ro0etpB19Q&oe=6AFDC79C"}, {"file_name": "UnderwaterLevel1.png", "id": "1492913799348089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628447_1492913802681422_3603945301372072065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdq0ZQ5294AQ7kNvwGOld8E&_nc_oc=AdrApmwyL7PJmgXQ2dbBU8E73KZPRw_3_M-IkBJWKDWLbS97kQYjijchCeFF6LTaRCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQITQeMkw9klr7Ca_aHB5vPX2zjp1cEqkOn0b_EwAfw_Q&oe=6AFDB4BC"}, {"file_name": "UnderwaterLevel1players3.png", "id": "1484903320161106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593858738_1484903323494439_3927866950523508663_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niqrK7mfxxoQ7kNvwFKnoHb&_nc_oc=AdrHd887kwGYLFh_bDc-IQWXF783EUhFtQUv2y9brYSL6qtd0sREVsB_nGXvfPdejVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkpdNV6VWVr0TajkBO4gMh0xU6--UkCE12d1xTESsHIA&oe=6AFDC9F9"}, {"file_name": "ClassicLevel1players2.png", "id": "4666897716913378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628446_4666897720246711_271661554039611454_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvlkerynescQ7kNvwHpGWq0&_nc_oc=AdpoMMUrY3zO97t_yzMDfjjgg22mxyC6boihq21izbOsnvA9XBILF8O2YW5ouC0t52s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-1UpjkCklP1fojqxp5vtveOYL6epYDiu8pEs8Xdl8sg&oe=6AFDB8A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BLOOPERS", "keywords": ["party", "Obstacle", "battle", "funny", "multiplayer"], "long_description": "# Race. Jump. Fall. Laugh. Repeat! \ud83d\ude02\n\nWelcome to BLOOPERS! You're a wobbly bean racing through crazy obstacle courses. Jump over gaps, dodge silly traps, and race your friends to the finish line!\n\n**Up to 10 players. Tons of chaos. Endless laughs!**\n\n\n# \ud83c\udfc6 RACE TO THE FINAL!\n\nCan you survive all 3 rounds?\n\n- **Round 1:** Race fast! Only half the players qualify.\n- **Round 2:** Dodge obstacles and make it to the final!\n- **Round 3:** Go for the win! Only one Blooper becomes the champion!\n\nOops, you fell? No worries! Respawn and keep racing!\n\n# \ud83c\udfae PLAY YOUR WAY!\n\n- **Quick Match:** Jump into a race with random players.\n- **Private Match:** Host a match and race with your friends.\n- **Solo Practice:** Practice your jumps and master the courses.\n\n**Ready, set, WOBBLE! \ud83c\udf89**", "short_description": "VR obstacle battle game where you race, dodge and survive hilarious challenges with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rangesh06.github.io/bloopers-vr-privacy", "developer_terms_of_service_url": null, "publisher_name": "Spawn Bridge", "support_website_url": null, "website_url": "https://rangeshxr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comf
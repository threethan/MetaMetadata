sid=6e7a0a&_nc_ohc=yUg0Y6YP204Q7kNvwF7WnCs&_nc_oc=Adr7Er2tZzOUIz96QxFCLQbVD8l59xIOKMJAqnU6g-nKwQCs_NWrGqTdOiWeLBaIL30&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrB2xq9bQYbC8VWo5KimAFhc2R2Q9Qo2lSXdVtOJWBJw&oe=6B0B1926"}, {"file_name": "com.Bloopers.BloopersVR-20260925-224930.png", "id": "1711912673244287", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499627379_1711912676577620_3663516242675906829_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmMpQ_6K4ssQ7kNvwG4X3bD&_nc_oc=Adrjm4gfsn2oCaVD6yF_ying5Jy33A62tFtcv4NCBigW1dAbpN4OEnjm04cLdoakWEQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZpyO1lUQaqpTUJjWu0LByac1-eCA0cSwtlwWhRplM9w&oe=6B0B45DB"}, {"file_name": "com.Bloopers.BloopersVR-20260925-225342.png", "id": "1387943301065678", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619404_1387943304399011_1549951615576152691_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nUDcSvlmAEQ7kNvwFOqc8l&_nc_oc=AdqfUxUoG0pwfneuypNVwwrAK2aJbWmvYxftbeVWaGnjrmT3i_aghiPDnDftrslvCzg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGq6v1u9RnLz2pDwI6-pmXuKLvMyQ4xkW37qrCJ8ZQBQ&oe=6B0B18AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloopers", "keywords": ["party", "Obstacle", "battle", "funny", "multiplayer"], "long_description": "# Bloopers VR \n---\n**Welcome to the wobble! Race, trip, bounce, laugh, repeat.**\n\nBloopers is a chaotic VR obstacle battle where YOU are the wobbly bean. Grab up to 9 friends, dodge ridiculous hazards, and sprint for the finish. Winning is great. Wiping out hilariously is almost as good.\n\nNo guns. No gore. Just playground chaos in VR.\n\n**HOW IT WORKS**\n---\nRound 1: Big, wide and messy. Half qualify.\n---\nRound 2: Tighter paths, trickier timing.\n---\nRound 3: Full sprint for the crown. One winner dances.\n\nFall off? Back in 3 seconds. Knocked out? Jump straight into the next match \u2014 no lobby jail.\n\n**WHY YOU'LL LOVE IT**\n* Your body is the controller. Lean, dodge, run, jump\n* 2 worlds, 6 courses. Bright Classic + bubbly Underwater\n* Party your way. Quick Match, Public or private code (3-10 players)\n* Solo Practice offline + mirror Dressing Room to style your Blooper\n* Fair cosmetics only, comfort-first VR, proximity chat with mute/block/report\n\nBuilt for 20-minute bursts of laughter. Strap in, pick your Blooper, and try not to blooper it up!\n\n**See you at the finish line. **\n", "short_description": "VR obstacle battle game where you race, dodge, and survive hilarious challenges with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rangesh06.github.io/bloopers-vr-privacy", "developer_terms_of_service_url": null, "publisher_name": "Spawn Bridge", "support_website_url": null, "website_url": "https://rangeshxr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1302771966257343"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1813379639576217"}, {"status": "PUBLISHED", "id": "1734306820962796"}, {"status": "PUBLISHED", "id": "1647820353565317"}]}, "baseline_offer": {"id": "1813379639576217"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793642940, "status": "PUBLISHED
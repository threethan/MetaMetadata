n.com&_nc_ss=7f20f&oh=00_AQQ1272CUJ2nxNtAkqZk-Y98Qhtf4YOivYXsEpTxEGhEQw&oe=6B01EB2B"}]}, "id": "1649192050319359", "locale": "en_US", "screenshots": [{"file_name": "Bloopers multiplayer lobby.png", "id": "1105551165505709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1105551172172375_2114836483273602969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMF0fzn5vWUQ7kNvwHeTCQa&_nc_oc=AdprbVVTj_JgaRismwvPoME-gOJsTo-xq1qJVJSOA_Az99VCoDVzccq4KeOj57Mhy0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5hvDQeqxuAlWe1Uh5IIOqrOPd7de473JCgZsCAG-cQg&oe=6B01E229"}, {"file_name": "ClassicLevel1players.png", "id": "1964580971557239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628411_1964580978223905_8195160644881487430_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQGO0zdJwNUQ7kNvwG6Qy3l&_nc_oc=AdqMPkIMViP-CA9IpOHhNg0aP4mk7PSowLQYIAUAd7rOUGjaNzs0deZluE27t8ugHXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSah8B6f08SphWMp6IdplUqP96gMIb7yUjGFvCdqXUb1w&oe=6B01BC1C"}, {"file_name": "UnderwaterLevel1.png", "id": "1492913799348089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628447_1492913802681422_3603945301372072065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnpKVnNWop0Q7kNvwG46drM&_nc_oc=AdqXQLhlGMHcpWbXchL5371NkIB7R-1ZdKsCQRMyzED3b5bn-RJg_48p3-btwt5jW7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGnO0JBJwfI2hlf8pnP-4-MHlK6-6VO8GjHf1L0T0Y4g&oe=6B01E17C"}, {"file_name": "UnderwaterLevel1players3.png", "id": "1484903320161106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593858738_1484903323494439_3927866950523508663_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATHt7xinFVgQ7kNvwF8H0GL&_nc_oc=AdrasOxhMRYBey-5jELWUiTazMb-B3wQHF5rchSiJOM5yNSCILChkNf-VHwlAlLR0R8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBnAK4ZipZU486wDzITvDzvHkBpQCz7Voeq7zsyMtEKw&oe=6B01BE79"}, {"file_name": "ClassicLevel1players2.png", "id": "4666897716913378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628446_4666897720246711_271661554039611454_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ7XKR2sB18Q7kNvwFbAYan&_nc_oc=AdpB5f3vVTbsnNv0pnKHuI6HaZDLXTRaxLg-3Kb6sW_l7DPI_zD_Vp1FvBEIGjVK7Ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQriu1hGxWjBLw8SdbwUPZtmFomnBGlkej_f4sHfcOk-w&oe=6B01E562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BLOOPERS", "keywords": ["party", "Obstacle", "battle", "funny", "multiplayer"], "long_description": "# Race. Jump. Fall. Laugh. Repeat! \ud83d\ude02\n\nWelcome to BLOOPERS! You're a wobbly bean racing through crazy obstacle courses. Jump over gaps, dodge silly traps, and race your friends to the finish line!\n\n**Up to 10 players. Tons of chaos. Endless laughs!**\n\n\n# \ud83c\udfc6 RACE TO THE FINAL!\n\nCan you survive all 3 rounds?\n\n- **Round 1:** Race fast! Only half the players qualify.\n- **Round 2:** Dodge obstacles and make it to the final!\n- **Round 3:** Go for the win! Only one Blooper becomes the champion!\n\nOops, you fell? No worries! Respawn and keep racing!\n\n# \ud83c\udfae PLAY YOUR WAY!\n\n- **Quick Match:** Jump into a race with random players.\n- **Private Match:** Host a match and race with your friends.\n- **Solo Practice:** Practice your jumps and master the courses.\n\n**Ready, set, WOBBLE! \ud83c\udf89**", "short_description": "VR obstacle battle game where you race, dodge and survive hilarious challenges with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rangesh06.github.io/bloopers-vr-privacy", "developer_terms_of_service_url": null, "publisher_name": "Spawn Bridge", "support_website_url": null, "website_url": "https://rangeshxr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comf
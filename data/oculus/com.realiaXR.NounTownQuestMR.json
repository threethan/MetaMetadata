jg3l0BXt42gv5o7dHLuTsw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUJGitdv4cHQIW-ZxVbROrvhKd8EZ_EyTQvsQs-7SA_A&oe=6A8D72EC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UM4ZRKWVmi4Q7kNvwGX1QX3&_nc_oc=AdqvxQ4E3Xr--3gfSjhaK5bmUFl3wfyJp3oMrTB921_OUtGLmJvE_lYWsjmB3-W2eys&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEADoJzIwfbSAlsDelGfNLHoYkc8lNBJG1ODBRAEKyoaw&oe=6A8D7C1C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0LKOgxJ-8UQ7kNvwHh2REI&_nc_oc=Adoa6pFNPP9J7HgCfZwb8A4cBpObgAV1iP-9CHPXM8ropR8xR1ZuknpW0LfV11HQWKQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaYNQa5ilYwXdMJERuPPld8bxnpsfAvLb7Dze3EGuMRQ&oe=6A8D8E92"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rczJveWIqmgQ7kNvwGkF-AT&_nc_oc=AdqYVYt_dZK4lc7hTe62-WH53XNY-rxCrJ1jIEviylXO1kYlAibRDNXsgGnbWSR3NeM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1vJdRvwUqluEdhUY4JTPcIDrIaeJAjoz1vOnWH9aIhg&oe=6A8D811A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psKGiv9bLbsQ7kNvwFXNWbv&_nc_oc=AdqCK-uxdZQTOJylwewhDDTueYZWF8piFaG37i5CaE1U73EcrPcytu8T4bAa5vm2XNQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEANO927zyF7vRD9DSq7CmNV-FJGO5a4GUz_VTleRIwSQ&oe=6A8D730A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "https://www.noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "377978390272490"}]
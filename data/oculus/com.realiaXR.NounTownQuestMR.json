content-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsVqO8cSFoq2hLhcXOOGiCLv0f67iL5Abv-wZfeXhKP3g&oe=69A80DEC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PqRIAK0njYQ7kNvwHK_Q1X&_nc_oc=AdnIZyMEufNnajyPDOGScJ3tCuxKv7uIu8aLtofuQc905V5RjtPd-wHfsQTq9vk06vQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPMsmPoO-3MTQ4BNQ-3JVIT2zf7ZUMIV9xiNVuASASzQ&oe=69A8171C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN6NYB2LO08Q7kNvwFjjtM1&_nc_oc=AdnULuWgx41C8r6F8BNg248GNe3i-1k7UXkMtnjXiwG_OXzKn5MK1r1-NaiBxIE63ew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftnpG7lDmP4_p62Q2OIQr8-6AvkgXSE7M1JxxRWomcJTw&oe=69A82992"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8su2ajjztoQ7kNvwH0uE0p&_nc_oc=AdlAzR1JiMqPR5Yz0NeoHx5y8pYfuFUZ1l2z-DhMd4Ll3wGeT9hyJhlCiFwTFn7iQb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftl6clbh9n7unMPOELRqyDfIIRiLvYVy4pqlYgWdO6pAg&oe=69A81C1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I8BP2gAuJEQ7kNvwH9TVBn&_nc_oc=AdkrWo1Si9mntUzFmn9HuKlg8od0n5q3Tbl5soMrMLJfskAyQpfezp5-yf9OOoisBy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfumHy3Ia1vsMkdRUaHOwoXF-8dxXkrs6PKodz3sdKeFVQ&oe=69A80E0A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "https://www.noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
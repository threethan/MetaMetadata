fzZ0p-_UJE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WqJ9FVSBvZGKkTmqO_PAVU-NN9JBMA7n-Pk2B7_PIFQ&oe=6A26D62C"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huYW8kij_ZAQ7kNvwHSBjge&_nc_oc=AdoW0Q4VSgmfreol0YSksnBPMRz8oCEQsypZoAkB3YWP2r1-DCobHSTa9tiMNenZPxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cESini4_DU81B223ut4Fh0R-r38emdZCVNs-OmNhVzA&oe=6A26DF5C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nfCzFTuVI8Q7kNvwHUMIxi&_nc_oc=Adq1DZeSt2T4_ADu7nApp2vLpxmlpi69OYb0OjNYqICv_GaEpXV7hDSPSZvhAChWpjc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X1QyEyQHT2fixem9LRlLJdQmltD7YrS2_VRZ4elUfVQ&oe=6A26B992"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPkbEwYD9GkQ7kNvwFeLv26&_nc_oc=AdrFGVdVS4-RZjjG9H44Z9rew4dSNWCA0VuCPFXp8p7sfNx-lTlIrsrlkYofvW4UqnA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7ceDKwsowwW2lr6APM2Wumz6grQgSbMeIaCNbwYCYPg&oe=6A26E45A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZZZAUeNDGEQ7kNvwEpe2xF&_nc_oc=AdqO3V-TkaeZZLeQfmuNLjSzv_r81WiiN-sVMh3Mwsd7WzollRMZLQdrsu1P1q7HpDQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9atw68SnyR2SifVoLiaeNfTb3yp8rsg4X6pXPd8EyIsQ&oe=6A26D64A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "https://www.noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_
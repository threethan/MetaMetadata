9035448_1093268579466054_5458339740950772587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxLnJfHLmKwQ7kNvwGXPZON&_nc_oc=AdrI7E-yMBKC3bW2zyibgq9iB0naqxtx0J1tPIIkgIqp2R6NUGC-e_hBciV2XZNjq-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvJeqCRXuyfq_UTCvNomwfPuVLBTKoQu3AYsT5eoKYiQ&oe=6B0338EC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Sttbca1tAQ7kNvwFYg9b4&_nc_oc=Adp41s36ivu6lx5ByDq3zmVj1M2ebUmMa6H5NkviRKWzkq0OgY5OgdCEQB1T5nFoJkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_rKuEkZ3kqnvT98M53iErfc7jHV7Nq9Lzm3uO8vwyAw&oe=6B0309DC"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPrEL-uh2LIQ7kNvwHXvI1b&_nc_oc=AdoN7S2luA-wzupp6bQOyRkq9lIcgRCyOhS1WvDKkKuBT2wNgM1Y_VcjQJ29e6cYO1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_0NG0Ga-U3PyS8HRypgpRFSq6j-kARLttHTqEct-MQw&oe=6B031C52"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AM9oQ4Ly2P8Q7kNvwHfpior&_nc_oc=Adr0Fz9yqNaINyPt6hdxsogV55wZCA6fEUTDMU123H1NsXAYKFXNnYo6QrPTLbA2Upk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyBNh4j6iUCgzrWWE0_LbQrLnR2_MVf-4DsGcmQotWiQ&oe=6B030EDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CqPEwH8JdQQ7kNvwG4HR7T&_nc_oc=AdrVaw8K0xUuj4m8d6id0CTVhjlEFw9DSAk_mxc4anzYoLOGMzD4sXZ7S11Sp72sHVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAAkAB052x5Wu3jM8zyVFKv5nqS0JFsFvWDMuEvndtsQ&oe=6B0300CA"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null,
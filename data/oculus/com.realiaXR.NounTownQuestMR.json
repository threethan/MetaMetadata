9035448_1093268579466054_5458339740950772587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9PBE0ZDKusQ7kNvwGZN6Rf&_nc_oc=AdoF6aol0jAoC6ZQ-FmSpr_Blr1PA_EC2LXrF5kw1UztNhLRFgdovpmuZ2ZUk6Lw35A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZV8OaX35XImKs4LmYfDL4ZPNDOLoKUrpauwY9UYpNew&oe=6B05A3AC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Sttbca1tAQ7kNvwG6maqt&_nc_oc=AdrPkAYH8myvLsil-uFW5DqodFiE6cvm4Y0JDvhRTv9qoed7t5Cpvmo0wwm5Xx4DWEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTnOiZju3OnAUX_0Yx2Ok2GywCMkyYrnvLWDvPRYHDqg&oe=6B05ACDC"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC9gHrgKdIQQ7kNvwE8Llny&_nc_oc=Adp9-U_DoE8WYajlSNV5u8ilih25GELLsqrFW9ABs8tEzE-ssUMW1gcyyerLfLDHpHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4A0sEo6WSoa5CwQ_tdeV6YPGnL5teJF5ODbCZvqcyuQ&oe=6B05BF52"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AM9oQ4Ly2P8Q7kNvwEEO8D4&_nc_oc=Adqp53ajerNSon4HrcZRdGKB0zSrQkhrvixPHogkvAc7iPPU6_J1MPJSrTKS06ieyO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYFw8ClBWrYPogsdQ-7r3DEK1Tv8256E48FzdSJdxvPw&oe=6B05B1DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srZPvIcCa4gQ7kNvwGMHq8u&_nc_oc=AdqLnqEfbJZ1j8cOth-easB43nUovQV2iTdl8MjnQenq4qC81ax4826fVVRdp4jlHVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC4zThInexvOSKkXQ3GnHy1w1XtzC_PKZ8lkX6YR1f7Q&oe=6B05A3CA"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null,
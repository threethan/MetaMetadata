D2uR7Qpjirsn-ahR7A&oe=69A2C7EC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3_IFeeyTKgQ7kNvwH4Y-g1&_nc_oc=AdkQ9B34ILBxF7JtXi_NbjWhVsRPneXWZKq59mr83n2tz4RiY2AyuZViwxLpaOX20ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft6v__GEXp5VHuXi8KxxKZkwGkxTsU_iL1DI_5PyE-PBg&oe=69A2D11C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVYA577oy60Q7kNvwFRYleG&_nc_oc=AdlSPJppda_CX4hxl8Vf_VKL-x-jB-1J5VN2-mMeJl8ragMrA3eonWVywB4qnkDs1B0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttONoAs9HjUewHadH7dETDtZ3Hz22N50dhfmZVlW2pdQ&oe=69A2E392"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QTHJIZI0owQ7kNvwFqmlmf&_nc_oc=Adn5YbcVPFXvm0nXfDVgchlBTLjlGjuYGOylqv567ngXFfWzocBXOLNdTaDbJlkRe5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsy3ytDpXZsYp3Mc7_9WivZWGMXDzQGK8e1Md6-kwR6Yg&oe=69A2D61A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmM1JavEI-sQ7kNvwHi8GiR&_nc_oc=AdkNbYUqz8ASOmhHrecnUc_0_n4YbjSJHRmNcMDp5irbVif9LezWJRsYV2ZTugU4nxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDoV-EuBYn-qA23NPpcLTCxpXK_YyV1RkG7BsS3weFTw&oe=69A2C80A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "https://www.noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics"
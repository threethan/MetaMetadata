XFbCHWwK8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fQGKHTlZIMnH0vjsi3sRb332blTAmb1FSFY7z2RqW1w&oe=69D2762C"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9p0vy1-hMUQ7kNvwHd6KVY&_nc_oc=Adp2nnLeedzzud4OMZFiGbppjkfU0V6_FGOqb_askQPgG3gE8D7FS3GFRJu1poYr1A0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TYByS2iNEg5MLM-yzxUkCGuMZAjs8bi5V44K8Sk5heQ&oe=69D2471C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij_htTakBFkQ7kNvwGY_Y37&_nc_oc=Adqa1V5oNYQyLvnKmOnTt-CLMRW5YSrRMtuaBNJIbfJ6vXNsVoalHFUmT4xn9pv8mUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lwjGHJSBMUgps63dkbknzCy9X250FYA1XmI3I6zTKSA&oe=69D25992"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPJ1_bFIzh4Q7kNvwHq_wT4&_nc_oc=AdodF4ABZcc_fY0RneghxSooMMJLzXUB0TONLr79F7jcCKWHztUurELsmz5EQ2HUZuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GKXs5uTmKYXNYer4F8wBziZLTg22Z3bmHmczccp5FGA&oe=69D24C1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2U2-fuZaPQQ7kNvwHJ7g__&_nc_oc=AdpiQiXDjap7Z9GPR-nHiFqUarWpJPSLx7gt5_ZFAsaUXKFmSL1X_okw1nYRGsMtUZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zAV3uvLl7lzP0dA7NqF78AXQ8C0ClN0bIGrIPcA6fDQ&oe=69D2764A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "https://www.noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_
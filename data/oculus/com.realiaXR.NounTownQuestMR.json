9035448_1093268579466054_5458339740950772587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06GEn-M625MQ7kNvwEjMpq7&_nc_oc=Adp7c40-Kr1ADRcyfsBs0hv1CUEzv5FKv82Qqp84BKvMjJfyMINeuhj50rp-s1Yby3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvOOGVpF6qRP0SpJlRbFCElCHyzQ1mkOcPZvjPFeR3Ag&oe=6AFC692C"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZFVayrzjhEQ7kNvwH45Wjs&_nc_oc=Adr1YqonUVG-Tu2ZVVOnzpT4mPK9oGo79lm-EN_EzE57oSd6LIs6XX_WuWhnri8g3Zs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwES7HYLy3XFLFMToEJnVs_bLRcQaoXbA75VjhA4LqLg&oe=6AFC725C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsSdjh_0HxoQ7kNvwHWoAVn&_nc_oc=AdpD2rZ8vtBecN2OTI95dHj9onC0WNVKy48l-Ww79SthW5A4T5s8ml_8JtF5HjkFIiw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-PuLKO5ZJ7pByT-ZazU3eBk8Anp0kcF9aB9eJIZWWDQ&oe=6AFC84D2"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3RCsbekNUAQ7kNvwHsHuL2&_nc_oc=AdohAJu9a2e3v4VkDs8PPmJuLerEm47fBYAgNttnvdW7n8nArRZauv1jDlNJ8kHrtPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgmRzKkuZsJtgkyOvzVeHOg4KRggqlTHMXWni0BDMn_g&oe=6AFC775A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjsGg6kY1_oQ7kNvwHawMI1&_nc_oc=AdrfuiS8kzQ7kVpDv0Begzuh27BfH6YdCj-6-7yiSJa2AdxIrHP4VvB6g-kdhWTrS4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ6eWqlBLE0wrBhqulrRcjIgGSIyAhpmUk46S2imiRiA&oe=6AFC694A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null,
9035448_1093268579466054_5458339740950772587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06GEn-M625MQ7kNvwHZuiGK&_nc_oc=AdpFD7Lfh-TVdO8W__K2YSJf1UhWnOI6jVoKUGYJikBP2K9hmj3ZgamTYFSPek85Yt0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRunnrFLeqtcHZPshEaKLuextFEH0Z9siPdiqClgZL3lw&oe=6AFB17AC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZFVayrzjhEQ7kNvwGKYRGb&_nc_oc=AdqnuQsRmu2F4fQVHDYA9mSZo56W2MPl5-lg35ctYIgkT4xstHjRrICY6HcOJDQg588&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3KHn3g6BEjm2Em-tDN0QuDor4GTGGXSHIaGjFMAhAwQ&oe=6AFB20DC"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEnNe6YFcdMQ7kNvwG3QXTm&_nc_oc=AdqNYW6bWEO7cJQyJrnRufDO9qIYutQGQlH2fi5fTZy04F-0ah7Bhs7D945gdAbl7K0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBvSj8JcBe4Dm-0QfTp1jI119kQD_UwMXIiY4THWx9ew&oe=6AFB3352"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3RCsbekNUAQ7kNvwH9_8vK&_nc_oc=AdpimkLDN-Wv1KCYxhMrN494-tZ2nlZRy40Ccy4MtaMij2NBubG0YyvjJhi2iQh7J-s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYh1C7ri2g2K4WqLoCBG5A1H3yEd-k57yRn_4whE4JnA&oe=6AFB25DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFftZuuL3AgQ7kNvwEn7A9o&_nc_oc=AdpAy22vUh90pMbUogLTN4uDYo8duCmvJq-aHSLmo6PjJOtGlHi27IojHu5ni5skLQ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNUO5M73Vmyk6isG9sUoMN8I3ckmaBT7V6aofAz5eeQg&oe=6AFB17CA"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null,
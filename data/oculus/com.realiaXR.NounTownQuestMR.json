bJfZAAoU6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToAT1k57RTNasAqk3n_-ncvAGw0Qoagerf-tmJGw99eQ&oe=6AF08BAC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51A0lf8g1O4Q7kNvwFFzI4p&_nc_oc=AdphiY854qqlHXk0VN0rtu3YWYgjDHLSIPA543hZiLyaXJfxZPKrL5rbRWztzN8Ndaw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBv2-v3laXy3Eusgjxi2uwUurrFm8QuSRdOQB3aUd9AQ&oe=6AF094DC"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F_n29Ffg6kQ7kNvwGqiCzp&_nc_oc=AdqV9O5Q2j-pZkNopK-8OUSVazj7sHRd9C-1fIi6JUetj2tSaEXJYP5ggqPKbfjBLWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAmCv8VUukfFiE6Ve8GTWjxohTWIBLo1LCLDzE-j-DWg&oe=6AF0A752"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNVSXr4UXdYQ7kNvwEtiwHg&_nc_oc=AdpH0_llW3nzJHr9XxlKG4LkjtKCyNpIHUcv70LCRaue0NudYfdKQbTRnhuJW-VM7-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyldPc8zHSdnXLAjzYNr_Vjiai1qPFQfBTQ44c2-kHjw&oe=6AF099DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEDsEvrXCWcQ7kNvwF1RZXz&_nc_oc=AdrGEvAijfYt744qUf8S0N7SC0xFcdzrY0ModVN69-Lc4cgAbd5ewN6YjbrwB-lflUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5H3SMg_lSOXbcyIHaRTZ8DZ_87-9Pkob4x1tEP4-_Lw&oe=6AF08BCA"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "https://www.noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_
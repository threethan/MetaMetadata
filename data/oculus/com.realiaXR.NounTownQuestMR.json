-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPtoaAHOPwdiSSBWw4dfifiRedAIC8_YTI9qq6fB0SlA&oe=6AF32EAC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMy42wkbyNIQ7kNvwFQyVRB&_nc_oc=Adqwg5yIiXSzQI6EuNAMXOTH3aLxo0y1grPD8geAn_rjBtTZDlZiLbgAgb82NC9OFw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTncpxTqTcwXBkGtwSV_Y9dVw7IxGfehOxoxbUOwiYJuw&oe=6AF337DC"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F_n29Ffg6kQ7kNvwEPhR95&_nc_oc=Adp-_JNELYeDn6hj8rv2YrlJyepPgjkp5s_jQzCY7QATwNbapIVOS8O8E5QxYhJVFrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxMX1LtyJJWmMoFIqm52tkN6CtV5rKaabD83gF3OzVcQ&oe=6AF34A52"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDe8AWHIaV8Q7kNvwHzGfwI&_nc_oc=AdohI5G1RoIIVyjr0G9_5eFU747G4-7KVQYPWZU15IlOetMWRZH_F-rLcQJd18rmvLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH2g_BsnAlUWv7ncBsLwp855SGF3otbSbkwfdg4wXqmg&oe=6AF33CDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEDsEvrXCWcQ7kNvwEqbqG2&_nc_oc=AdqYy2noCvfDsf9mM6sRyUcMOAavJLESxeUvonoHhQBKeFNhIUbSI9IlPwDTkndJg-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSEMEuZJupPsYe0jcbBX471tvILavHYi69W0c868L1Ug&oe=6AF32ECA"}, "display_name": "Noun Town: Home", "keywords": ["education", "language", "MR", "duolingo", "fun"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages..."}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": "https://nountown.freshdesk.com/support/home", "website_url": "https://noun.town/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
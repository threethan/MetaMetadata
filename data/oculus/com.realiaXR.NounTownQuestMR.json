9035448_1093268579466054_5458339740950772587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7Sb99335Z8Q7kNvwEwM1yH&_nc_oc=AdoEFj9IXY48iwSN1WwXZntMnQHN3BkedlhGFr2DfdTUbotzPwhBl0luEFK56VPtlHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXb9nFdJteS1CdoAxYhxrf6JnWrNp6djsrOeGgRb7vNgw&oe=6B1067EC"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oabPtEV8qx8Q7kNvwGNpqSg&_nc_oc=Adr5WsyLznYnfBozSm0pUhaTKDyTflOVP3mAc6l43GIyRGtCQEPnmqzDByDT5kSkcyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDP3eM7boQG5Ev_FS3AQJ5rc3eWiV9K6W0qh1Fos9JrA&oe=6B1038DC"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKg-RDe4IhUQ7kNvwGvwWPn&_nc_oc=AdpKC5ondBRTo8Z7acmx9tzM8d8TCot2uVs6dFVboK1pmyDLpZifWZhcrBUs5fJevPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOhuAg5-UnMtjpOkRLjD2DaqYXqRFHASt52vn2DIMEEw&oe=6B104B52"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L8zbyeqZG0Q7kNvwF-b1ON&_nc_oc=AdpogstJ-vKzFL5kVZ_DV4XpRVMR8GTz9D6NaSAbsisjAppZBc2rUsG-g54XgF7g1Yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVLLHMlZhfV68WizUneaYbU3E3UVh6XV7pqBqAJAFEbQ&oe=6B103DDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B5sBC65Y64Q7kNvwHrqyXb&_nc_oc=AdpCr4VYaDbBuswsxvwNMvTXsgmgfrAVAu7mhp7ZtmiBJxZ60vFABEShL_uHvnh0YXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFu1RciljUSng81V_DkokkwwCPzXHRY2YdLphWadv39Q&oe=6B10680A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null,
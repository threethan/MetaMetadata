9035448_1093268579466054_5458339740950772587_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7Sb99335Z8Q7kNvwETwvvN&_nc_oc=AdoZBmdZS03mQJrKBBu5q1OB9-iwU5QHtTJt8lXjbyMBzVT15Lm4Bd_bSG0HIwViqAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFzo6ggBdQEjsiffBdzDScaN6yfZubNVXl4C_2ZayF0g&oe=6B0F166C"}, {"file_name": "Screenshot_3.png", "id": "2311957889157977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_2311957892491310_7502529992194542603_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oabPtEV8qx8Q7kNvwHqCKEc&_nc_oc=AdrDwoiIx3V5A0z-NibZfvCW0LzCRSDGUmE1MsUi30GlEVleqo0iOEcTa964GG16V-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0XCuqBfgOjy2yMUEd-A16N-gWx98MjDZ1l53LPhAaYg&oe=6B0F1F9C"}, {"file_name": "Screenshot_4.png", "id": "1119767196158985", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75245820_1119767199492318_3798500756352791956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EBY3wqoOgUQ7kNvwEzCADF&_nc_oc=AdoX5mQy43UuTRjN8t9KyTV3u7D-9pOd8xy6LUv92mmP7nOd9m9MJMwpgsBwngDRdWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpqNtvpMJdCnXFn3jKJ-Za7wH2uOPrBMWLD6VMjwajzQ&oe=6B0EF9D2"}, {"file_name": "Screenshot_5.png", "id": "1495580497764393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031491_1495580501097726_1196866140773167282_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L8zbyeqZG0Q7kNvwFCjQCn&_nc_oc=AdqXinI128nfYkaRf-EkMWsSySWD-jHV72i8k4g88oT8zbQtEN3pKI-xEnijCd6iH7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXMPgKiqQNy5PWhm7KmqoaYqkMdB8bC-MPdkQXm5tc3SQ&oe=6B0EEC5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MR_NounTown_Landscape.png", "id": "1229003341643815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476754_1229003344977148_2909509994452516837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymM3SJQQxVAQ7kNvwFACWs3&_nc_oc=Adp-7kaRuXWSob6y5IalXPR1FTO83k6lXcoH9IZ5WoWlmU6mHz_F0Ehp3WeDJyxhde4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX603fYsuCy2IYkDYjOV_vVKijqpoKqMXil6PQtYeRwEA&oe=6B0F168A"}, "display_name": "Noun Town: Home", "keywords": ["education", "edtech", "languages", "learn", "travel"], "long_description": "**Noun Town: Home is a standalone Mixed Reality version of the award-winning Noun Town Language Learning game. If you already own Noun Town Language Learning, you don\u2019t need to grab this one as it contains the same Mixed Reality gameplay.**\n\n{1108665530823608}\n\n# Your Home, Your Learning\n\n\u2714 Learn 800+ words and phrases\n\n\u2714 Choose to learn: English, Japanese, Korean, Chinese, Spanish, German, French, Italian, Ukrainian, Russian, Greek and Arabic\n\n\n\u2714 Stay motivated with \"Daily Goals\" and \"Learning Streaks\"\n\n\u2714 Play the Superseeker and Alpha-Bash mini-games and use the auto-revision system to lock in your learning\n\n\u2714 Customize your room, label household items, and create your own memory palace to help you remember\n\n\u2714 Practice speaking with 16 NPCs using speech recognition, preparing you for real conversations\n\n{1302404137427276}", "short_description": "Improve your language skills by listening, reading, and speaking your chosen language at home with Mixed Reality! Test yourself with mini-games and chat with characters. Learn Japanese, Spanish, and 11 other languages...\n\nImmerse yourself in a dynamic learning tool used by thousands of learners. Practice languages in MR by speaking words and getting feedback on your pronunciation. Noun Town is the new way to increase your learning productivity in Mixed Reality!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://noun.town/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null,
t=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8CZMqyoRf4Q7kNvwGmFFwt&_nc_oc=AdoqtPxBKNwde2sJc6bb5a5ZeyHo1uLl0TUH5aZ3u7zr60DhDpgMID8xmRnuSY_w4OU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOHK9c0mDOzT_BQYNK9Mpk6ZU2u4SGTmrjMH4VSBUp_g&oe=6B0B32CA"}, "display_name": "Alien Squatters", "keywords": [], "long_description": "The aliens have landed! And they've taken over our houses, buildings, and monuments.\nWell, if we can't have 'em, neither can they!\nUse your trusty rocket launcher to destroy the buildings they're squatting in.\nWhen they try and fly away in their UFOs, blow them out of the sky!\nThere are five UFOs per level.\nOnce you've completed all the levels, play again, but now your rocket launcher will have increased fire rate, and the UFOs will be faster.\nQuitting the game will reset your play-thru count.\nUse the trigger to fire rockets - hold it down for maximum fire rate.\nUse the menu button to reload a scene, quit the game, or switch handedness.\nHEALTH NOTICE: This game requires substantial head and neck movement, especially when playing seated.", "short_description": "The aliens have landed! And they've taken over our houses, buildings, and monuments.\nWell, if we can't have 'em, neither can they!\nUse your trusty rocket launcher to destroy the buildings they're squatting in.\nWhen they try and fly away in their UFOs, blow them out of the sky!"}]}, "developer_name": "REED GameWorks", "developer_privacy_policy_url": "http://jras.us/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Jim Reed & Associates Inc", "support_website_url": null, "website_url": "https://www.facebook.com/REEDGameWorks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "
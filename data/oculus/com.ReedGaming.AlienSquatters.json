uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974703_505394530657308_356920994726852345_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO36ist5RLkQ7kNvwE_AFFD&_nc_oc=Adpxoa6m9lkujCAf7oHX70ok5ypmORQ1p28zJqqaBl21-lDtkBDC61cVeW1raQIZdA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFH0-zFElGx1JvUp5Oj7YEeprROwGDiE7L9_zSmErxPA&oe=6B04630A"}, "display_name": "Alien Squatters", "keywords": [], "long_description": "The aliens have landed! And they've taken over our houses, buildings, and monuments.\nWell, if we can't have 'em, neither can they!\nUse your trusty rocket launcher to destroy the buildings they're squatting in.\nWhen they try and fly away in their UFOs, blow them out of the sky!\nThere are five UFOs per level.\nOnce you've completed all the levels, play again, but now your rocket launcher will have increased fire rate, and the UFOs will be faster.\nQuitting the game will reset your play-thru count.\nUse the trigger to fire rockets - hold it down for maximum fire rate.\nUse the menu button to reload a scene, quit the game, or switch handedness.\nHEALTH NOTICE: This game requires substantial head and neck movement, especially when playing seated.", "short_description": "The aliens have landed! And they've taken over our houses, buildings, and monuments.\nWell, if we can't have 'em, neither can they!\nUse your trusty rocket launcher to destroy the buildings they're squatting in.\nWhen they try and fly away in their UFOs, blow them out of the sky!"}]}, "developer_name": "REED GameWorks", "developer_privacy_policy_url": "http://jras.us/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Jim Reed & Associates Inc", "support_website_url": null, "website_url": "https://www.facebook.com/REEDGameWorks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758
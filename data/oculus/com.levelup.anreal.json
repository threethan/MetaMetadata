BqtwndIXaKw6_LLa1kdTQVlcI756l7ZsqwkxhBF6BLkop-N_ErmY9g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFazGZdrZj5J1RZrrY0-233-ujBkaCQv9X_UgxEubjuAA&oe=6A859066"}, {"file_name": "2. Lab equipment.png", "id": "1419707653540295", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499314648_1419707656873628_17789818017134465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDhSI1rm9F4Q7kNvwG_g0b5&_nc_oc=AdrQIdeevNrwphVOCIy0cdru0Bi2GWXGNO_KP1OqaQ7wkwkiINvONje4Q1AcI6cE-uo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Xmg50NfPXfO-hnvkeA7bpUcV62tB0c-WK8DmQrh_8A&oe=6A857DA6"}, {"file_name": "3. Multiple objects.png", "id": "1428328062456474", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312310_1428328065789807_992551954977950811_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ4Jfjod6iMQ7kNvwFQO_Aj&_nc_oc=AdrGOJwxd89uOunvwKGX4tPH8Wq1S6xn2p4QbNuroYMAVFMo0ZrOC1QH0vqjLFfNyzQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFZ5nf-z_YlLhVla6Is6HuWhDHpjoBZWa_O-sZAC2sXA&oe=6A859EAC"}, {"file_name": "4. Real world.png", "id": "1922107141792839", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312422_1922107145126172_5366505462221434181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2nQLTvJCJwQ7kNvwH8sY7C&_nc_oc=Adoa8IdgtldxbPj1Rjn-YfCwVFdGc78FQkCFmkYTdTDimUBoLImSM90zZsuU5iBajd4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3_i-p3HHlgnWz3trI3cErjZ8Otjv2-sJI8pA6pOzTqg&oe=6A85960C"}, {"file_name": "5. Everything is Physics Enhanced.png", "id": "1027638790056326", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308050_1027638793389659_4201558936886013077_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ3iZeHEL9UQ7kNvwFpbdaX&_nc_oc=AdqCB8XQATTtg-RFfqdLd5pIod6-FPo0NEXn6OXlqVONXC76M_1fk8KSE47KBhsUolg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeYwHoyT6AWxb_3butMM7LRSdECspDan3O0LmAO3sJrA&oe=6A859829"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Physualize", "keywords": ["Physics", "Laboratory", "Tracking", "Motion", "Measurement"], "long_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\nIf you have a lab, AnReAL makes it richer.\nIf you don't, AnReAL becomes the lab.\nhttps://www.physualize.app\n\n\ud83d\udcd0 Real-time graph reading, interpretation, and body-matching challenges\n\u2197\ufe0f Velocity, forces and any other vectorial quantity as live 3D vectors\n\u27a1\ufe0f Uniform, accelerated, and complex motions\n\ud83d\udd04 Pendulums, circular motion, and rolling \u2014 energy and dynamics\n\ud83c\udf00 Conservation of angular momentum in circular and linear motion\n\u2699\ufe0f Friction coefficients on inclined planes and Atwood machine\n\ud83d\udca5 Elastic, inelastic, and 2D collisions with centre-of-mass tracking\n\ud83c\udfc3 Walking, running, jumping: the physics of sports\n\ud83c\udf10 Complex 3D trajectories: conical pendulums and precessions\n", "short_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\nIf you have a lab, AnReAL makes it richer.\nIf you don't, AnReAL becomes the lab.\nhttps://www.physualize.app"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leveluptrento.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Level Up", "support_website_url": null, "website_url": "https://www.physualize.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "104310754736
Nq84CvPWX7ngR5mBAhCw51UTTcl2_Q41t5Z6DxlGTSQIcMQDNejg3g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpafxajOMpHI34_wKqtHXqRAGdzgzB8l8MKjcn9jaAsg&oe=6A8ECAE6"}, {"file_name": "2. Lab equipment.png", "id": "1419707653540295", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499314648_1419707656873628_17789818017134465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MAOuyFKzm4Q7kNvwF79wYa&_nc_oc=Adpa0bqHdrwCOBP1spk5n_ouTCpsZoJCiO17O01U0BGgO8gWs7dzAsQp3DrAX_ZlcxQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoT_TKz8tCQolM3oceewbINNE8q3-pHxbdqxMHL3zPdg&oe=6A8EF066"}, {"file_name": "3. Multiple objects.png", "id": "1428328062456474", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312310_1428328065789807_992551954977950811_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qNgCh3RwpoQ7kNvwGPyPt8&_nc_oc=AdoOvKPliw0cpAB_OoAZKgAteqF7NJ_h3WAL8kNYVud5qEn2KATTOvzP8NtBiALaulQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4nDwzaqbk7zMpSN8GJ626-eLO-IHHt9QHY1eDwDD8HQ&oe=6A8ED92C"}, {"file_name": "4. Real world.png", "id": "1922107141792839", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312422_1922107145126172_5366505462221434181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0mWKHmAhN8Q7kNvwFsBbsa&_nc_oc=Adq0rab0eBoT8ufe7OUe0j1oyNG1UfzG5aPqRVNbl_K6e9R3MkmzWQIr8xPSRb6t4aI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVPEuTd-qFtHIYPem7j5n7WsjlqjMc3gGzsXw3TBK4YA&oe=6A8ED08C"}, {"file_name": "5. Everything is Physics Enhanced.png", "id": "1027638790056326", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308050_1027638793389659_4201558936886013077_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xk6NoVhbAzwQ7kNvwGweOnh&_nc_oc=AdqRezcTXFUPsGQAa3d4bAHlwYr_hUnZlHZ-ddPrgu4nkmytcKp2hkD9kAAgz5wUHx0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJymv-hDpLV6tMLhV02nK2IVp0BPkZSNSzzqux9hj45A&oe=6A8ED2A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Physualize", "keywords": ["Physics", "Laboratory", "Tracking", "Motion", "Measurement"], "long_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\nIf you have a lab, AnReAL makes it richer.\nIf you don't, AnReAL becomes the lab.\nhttps://www.physualize.app\n\n\ud83d\udcd0 Real-time graph reading, interpretation, and body-matching challenges\n\u2197\ufe0f Velocity, forces and any other vectorial quantity as live 3D vectors\n\u27a1\ufe0f Uniform, accelerated, and complex motions\n\ud83d\udd04 Pendulums, circular motion, and rolling \u2014 energy and dynamics\n\ud83c\udf00 Conservation of angular momentum in circular and linear motion\n\u2699\ufe0f Friction coefficients on inclined planes and Atwood machine\n\ud83d\udca5 Elastic, inelastic, and 2D collisions with centre-of-mass tracking\n\ud83c\udfc3 Walking, running, jumping: the physics of sports\n\ud83c\udf10 Complex 3D trajectories: conical pendulums and precessions\n", "short_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\nIf you have a lab, AnReAL makes it richer.\nIf you don't, AnReAL becomes the lab.\nhttps://www.physualize.app"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leveluptrento.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Level Up", "support_website_url": null, "website_url": "https://www.physualize.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "104310754736
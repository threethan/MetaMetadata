{"data": {"node": {"__typename": "Application", "id": "7721639864555280", "organization": {"id": "2293208210806868", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8721448347965638"}]}, "id": "907734334816387"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7721639864555280"}]}, "id": "3706829782971015"}]}}, "firstRevision": {"nodes": [{"application": {"id": "7721639864555280", "release_date": 1714170360, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29482845718008048"}, "id": "2796960043802170"}]}}, "binary": null, "live_binary": null, "created_date": 1794826230, "id": "29483252434634043", "is_initial_release": false, "name_with_fallback": "v11", "pdp_metadata_with_fallback": {"version": 10, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29483939647898655"}, "release_status": "RELEASED", "id": "7721639864555280"}, "id": "29483939647898655", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7721639864555280", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1513641909541129"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1173976488465746", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnReAL", "keywords": ["Fisica", "Laboratorio", "Moto", "Misura", "Tracking"], "long_description": "AnReAL - Augmented Reality Active Learning\nwww.anreal-lab.com\n\nAnReAL \u00e8 un software che trasforma l'ambiente circostante in un laboratorio di fisica immersivo in Realt\u00e0 Aumentata.\n\nGrazie a questa tecnologia, consente di acquisire misure relative al movimento dei controller e di altri oggetti tracciabili dai visori, mostrando in tempo reale grandezze fisiche e oggetti matematici cruciali per il loro studio, come traiettorie, velocit\u00e0, accelerazioni, forze, momenti, energie e altre grandezze altrimenti invisibili ad occhio nudo.\n\nProgettato per offrire un'esperienza interattiva senza pari, AnReAL fornisce strumenti avanzati per analizzare dinamiche complesse in tempo reale, stimolare la comprensione intuitiva dei concetti fisici e favorire un apprendimento pratico e coinvolgente.", "short_description": "AnReAL - Augmented Reality Active Learning\n\nAnReAL \u00e8 un software che trasforma l'ambiente circostante in un laboratorio di fisica immersivo in Realt\u00e0 Aumentata.\n\nGrazie a questa tecnologia, consente di acquisire misure relative al movimento dei controller e di altri oggetti tracciabili dai visori, mostrando in tempo reale grandezze fisiche e oggetti matematici cruciali per il loro studio, come traiettorie, velocit\u00e0, accelerazioni, forze, momenti, energie e altre grandezze altrimenti invisibili."}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "4532596116994928", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311582_4532596120328261_3727583030961292161_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3--MhytDpoQ7kNvwGggXKD&_nc_oc=AdrzoRompv6yYg7fFZAHUW-oAjgoqvqa57_i6pEezZyZ6T2rmtYfkhEVi5_U6ofA0Mc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2c6Ceb-FonLYMLKPvo_D4KIFti58zvufIYfTxOYQwrA&oe=6B0329A6"}, {"file_name": "layered_icon_composited.png", "id": "2228118944790975", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828608_2228118958124307_2
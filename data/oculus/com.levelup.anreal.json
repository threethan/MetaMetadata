ffer": {"id": "4152096245052253"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773669060, "status": "PUBLISHED", "id": "4152096245052253"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29211602878465668", "version": "1.6.0"}, "id": "2796960043802170", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29211602878465668"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2796960043802170"}]}, "change_log": "Physualize 1.6.0\r\n\r\nNew\r\n\u2022 Continuous tracking: record with no time limit while the app keeps only the latest seconds of data. Ideal for pendulums and periodic motion. Charts scroll in real time.\r\n\u2022 Units: choose metres or millimetres, radians or degrees for charts, axes and CSV export.\r\n\u2022 Linked charts and trackers: tap a chart to see the values at that instant on every chart, with the matching tracker highlighted in the scene; tap a tracker to find it in the charts. Point the ray at a tracker to see it highlighted, with a gentle haptic and sound.\r\n\u2022 Two-body system: new option to show the paths of each body together with the centre of mass.\r\n\r\nImprovements\r\n\u2022 Tap a menu numerical value to type it on a numeric keypad.\r\n\u2022 Larger, tidier menu in Physualize colours that you can also grab with the trigger; app version shown in the Info tab.\r\n\u2022 Gentle haptics and sounds on interactions; softer vibration while recording.\r\n\u2022 The path appears from the exact moment you start recording.\r\n\u2022 No more stutter when you turn on vectors or change merge frames.\r\n\u2022 Sharper chart lines.\r\n\u2022 View reset: hold the left menu button.\r\n\u2022 Main menu button to go back to the start screen and begin again.\r\n\u2022 Up to 300 trackers per series; when they run out, recording stops with a notice.\r\n\u2022 Passthrough dims while the menu is open, for easier reading.\r\n\r\nFixes\r\n\u2022 More accurate data at the start and end of each recording; velocity and acceleration correctly aligned in the CSV.\r\n\u2022 Position vectors now reach exactly to the tracker.", "created_date": 1793184133, "id": "29211602878465668", "version": "1.6.0", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29211602878465668"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791284502, "id": "28904671529158806", "version": "1.5.65", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29211602878465668"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2796960043802170"}]}, "change_log": null, "created_date": 1787149471, "id": "28277641278528504", "version": "1.5.6", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED",
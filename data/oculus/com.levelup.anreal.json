Z3L4_zg97C6zWM2H4F8pJpkswta_ijl5JLgKLU4JenrrHTIKhg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRpYf1w-XcT0y9UoRgh6tXK6w4Pb8ZbrTO4XOaDQ4yag&oe=6AE0C026"}, {"file_name": "2. Lab equipment.png", "id": "1419707653540295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314648_1419707656873628_17789818017134465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yszh9fI2yh8Q7kNvwFN7oQi&_nc_oc=Ado8omb7XeLgut54j43-7XdIULKICR7wdYIUa9f1FQ-OK0yXnZHusL7xlZo01ZxxAQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgJ9SCPJL8J_45J8WE_VlecxktAePidHFnhf6k7Hbr_w&oe=6AE0AD66"}, {"file_name": "3. Multiple objects.png", "id": "1428328062456474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312310_1428328065789807_992551954977950811_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BeF1nVPdtkQ7kNvwF7JBJ0&_nc_oc=AdrkOArNtz-6sfOkHPE0_yes1blR_AHI8OwqpZ86TWLvORv9bO1vxonO2AvSckn4euo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW3AlY1dSf2RBweCtxWLLXhnfpQpAciQiIOf2uDVCvzQ&oe=6AE0962C"}, {"file_name": "4. Real world.png", "id": "1922107141792839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312422_1922107145126172_5366505462221434181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODlN9v-e7g4Q7kNvwFr9Jzk&_nc_oc=Adrujr12g-SaIdLzJFeUTevOyl2yfu5tQwiF1ES9NJVQsrU-0ZTEepfRMJDIMzKu2GY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2z5HjKIk-IYmflehPqMKfsnVww2x1cx-2alyHSTgJHA&oe=6AE0C5CC"}, {"file_name": "5. Everything is Physics Enhanced.png", "id": "1027638790056326", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308050_1027638793389659_4201558936886013077_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcqir-Eg0f8Q7kNvwHI3usJ&_nc_oc=AdopKnNcNxvejV0tVH6cCbWAwG68gElPoVl7qc2Bp--ELUYi_gN-u6gPZbJ6jjRnAKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQProeKkVtFYrZ5zBQtcf-Qx9m0Tnj-f1xJZRK-geDot1Q&oe=6AE0C7E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Physualize", "keywords": ["Physics", "Laboratory", "Tracking", "Motion", "Measurement"], "long_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\nIf you have a lab, AnReAL makes it richer.\nIf you don't, AnReAL becomes the lab.\nhttps://www.physualize.app\n\n\ud83d\udcd0 Real-time graph reading, interpretation, and body-matching challenges\n\u2197\ufe0f Velocity, forces and any other vectorial quantity as live 3D vectors\n\u27a1\ufe0f Uniform, accelerated, and complex motions\n\ud83d\udd04 Pendulums, circular motion, and rolling \u2014 energy and dynamics\n\ud83c\udf00 Conservation of angular momentum in circular and linear motion\n\u2699\ufe0f Friction coefficients on inclined planes and Atwood machine\n\ud83d\udca5 Elastic, inelastic, and 2D collisions with centre-of-mass tracking\n\ud83c\udfc3 Walking, running, jumping: the physics of sports\n\ud83c\udf10 Complex 3D trajectories: conical pendulums and precessions\n", "short_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\nIf you have a lab, AnReAL makes it richer.\nIf you don't, AnReAL becomes the lab.\nhttps://www.physualize.app"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leveluptrento.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Level Up", "support_website_url": null, "website_url": "https://www.physualize.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "
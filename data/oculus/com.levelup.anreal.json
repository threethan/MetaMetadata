ord5-2.oculuscdn.com/v/t64.5771-25/499313063_3278061682366081_4157810765363769335_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoNOdObeok0Q7kNvwHR5RIv&_nc_oc=AdoH5FEmgUpZD-ATWwVUnHpXd76-i2Fnr0GsqRdoPq69-eYMpCI2gb96gpv6qdN6-es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOP5Tu7oEq9D3eTnxEgJNi53_XdZ4aRSOkkY_bDVTs3Q&oe=6AFDC126"}, {"file_name": "2. Lab equipment.png", "id": "1419707653540295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_1419707656873628_17789818017134465_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyTgbdN4YsMQ7kNvwFe4WPs&_nc_oc=AdqPRofx_pW_NbgiAvp1IsUSNAmYXvY6rYv8x0DhcFkk_FRvbeqpgliJT6VPEDX-meU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtYKimc_urwPx3OeEosx1ABnt3i6XvwdT75VUD1tXrAA&oe=6AFDAE66"}, {"file_name": "3. Multiple objects.png", "id": "1428328062456474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1428328065789807_992551954977950811_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rBmDwAX2s8Q7kNvwF2CxbR&_nc_oc=AdpfpB7tQp_TQ60bnHw1xClvpEA-CdxTZy1iVOQW7Ihd5kSXKto_2QUXWNbiK_RQviI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTojoDF6urAvKTnc9ZljeHE-liE6iFlrwQjB6-dk0MMzQ&oe=6AFDCF6C"}, {"file_name": "4. Real world.png", "id": "1922107141792839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1922107145126172_5366505462221434181_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iCMwZy5_XQQ7kNvwH3qOvK&_nc_oc=Adqfo-01OMeSslcKeHPFXTiPi9Zjx5onDO4pg-2oBdeUl96p0GrxEQhyfEaRGcffOCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6d8sco7ein81-c3UWURdkj8OKKGaaQrcCEDkEJEOY3w&oe=6AFDC6CC"}, {"file_name": "5. Everything is Physics Enhanced.png", "id": "1027638790056326", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_1027638793389659_4201558936886013077_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krfOcYWbb6cQ7kNvwEWIUH8&_nc_oc=AdpuxzrUYxDC77nPbFwL987FEGj4kREua2JmzDfWUSQ0408-U-afi_BIwJW1ZhB5X54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Pgtk7r4b6kBeWMBhMMf1U9SejpgmhDL_DV8raPWDgA&oe=6AFDC8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1342887244479858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673676512_1342887247813191_4767663214116612189_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7Awkbwzj5gQ7kNvwHzNjAb&_nc_oc=Adp6JyLHvZmvmXJ1zlARV68L02PqAY2zqSY04ieCyH5kCZboASN_fklapSd7450Ajys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScD3HTNFEQrj1jp0gQBONt7vLWUMYO1ZZ7PXO0GFvG9w&oe=6AFDDB40"}, "display_name": "Physualize", "keywords": ["Physics", "Laboratory", "Tracking", "Motion", "Measurement"], "long_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\n\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\n\nIf you have a lab, Physualize makes it richer.\nIf you don't, Physualize becomes your lab.\n\nhttps://www.physualize.app\n\n\ud83d\udcd0 Real-time graph reading, interpretation, and body-matching challenges\n\u2197\ufe0f Velocity, forces and any other vectorial quantity as live 3D vectors\n\u27a1\ufe0f Uniform, accelerated, and complex motions\n\ud83d\udd04 Pendulums, circular motion, and rolling \u2014 energy and dynamics\n\ud83c\udf00 Conservation of angular momentum in circular and linear motion\n\u2699\ufe0f Friction coefficients on inclined planes and Atwood machine\n\ud83d\udca5 Elastic, inelastic, and 2D collisions with centre-of-mass tracking\n\ud83c\udfc3 Walking, running, jumping: the physics of sports\n\ud83c\udf10 Complex 3D trajectories: conical pendulums and precessions\n", "short_description": "Physualize (previously known as \"AnReAL\") lets students see and do physics.\n\nPut on a headset, perform a real experiment, and watch forces, trajectories, and energies appear on the actual objects in front of you.\n\nIf you have a lab, Physualize makes it richer.\nIf you don't, Physualize becomes your lab.\n\nhttps://www.physualize.app"}, {"images": {"nodes": []}, "id": "1773302087224511", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnReAL", "keywords": ["Fisica", "Laboratorio", "Moto", "Misura", "Tracking"], "long_description": "AnReAL - Augmented Reality Active Learning\nwww.anreal-lab.com\n\nAnReAL \u00e8 un software che trasforma l'ambiente circostante in un laboratorio di fisica immersivo in Realt\u00e0 Aumentata.\n\nGrazie a questa tecnologia, consente di acquisire misure relative al movimento dei controller e di altri oggetti tracciabili dai visori, mostrando in tempo reale grandezze fisiche e oggetti matematici cruciali per il loro studio, come traiettorie, velocit\u00e0, accelerazioni, forze, momenti, energie e altre grandezze altrimenti invisibili ad occhio nudo.\n\nProgettato per offrire un'esperienza interattiva senza pari, AnReAL fornisce strumenti avanzati per analizzare dinamiche complesse in tempo reale, stimolare la comprensione intuitiva dei concetti fisici e favorire un apprendimento pratico e coinvolgente.", "short_description": "AnReAL - Augmented Reality Active Learning\n\nAnReAL \u00e8 un software che trasforma l'ambiente circostante in un laboratorio di fisica immersivo in Realt\u00e0 Aumentata.\n\nGrazie a questa tecnologia, consente di acquisire misure relative al movimento dei controller e di altri oggetti tracciabili dai visori, mostrando in tempo reale grandezze fisiche e oggetti matematici cruciali per il loro studio, come traiettorie, velocit\u00e0, accelerazioni, forze, momenti, energie e altre grandezze altrimenti invisibili."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
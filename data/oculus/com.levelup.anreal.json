-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRywQMmIPDafAl9JqpQYSoixbyfxtH-Ed8ib0KQDEjhkg&oe=6B03190E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image 1.png", "id": "412904831495449", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75416838_412904834828782_6915972940103480808_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGc04vtVHaUQ7kNvwG0zXlZ&_nc_oc=AdoSpGXXOFXvxi_ra9r74vx0aXGOrNvr9KFQ_VWqAbP82D1x_EoEgENS4MJD0LOl-Ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG0Y57BwFQ6K-Dt47RQ8HjF2_5eYo86ymReLRXqLb3EQ&oe=6B031FDF"}, "display_name": "AnReAL", "keywords": [], "long_description": "The first Augmented Reality Laboratory to study the motion of physics!", "short_description": "AnReAL - Augmented Reality Active Learning"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leveluptrento.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Level Up", "support_website_url": null, "website_url": "https://www.leveluptrento.com/anreal", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7721639911221942"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4152096245052253"}, {"status": "PUBLISHED", "id": "985285809870270"}]}, "baseline_offer": {"id": "4152096245052253"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773669060, "status": "PUBLISHED", "id": "4152096245052253"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29482845718008048", "version": "1.6.2"}, "id": "2796960043802170", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29482845718008048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2796960043802170"}]}, "change_log": "New: Curve fit on every chart (constant, linear, parabolic, sinusoidal, damped sinusoidal) with parameter values and uncertainties.\nNew: Search in the Tutorials tab; the Tutorials and Experiments lists now scroll.\nImproved: More accurate velocity and acceleration, with cleaner vectors also for fast motions; fits use all the samples in the trimmed window.\nImproved: Charts follow the trim handles live, and \"Idealise motion\" fits only the trimmed window.\nImproved: The playback panel sits under the first chart and is always visible.\nImproved: The first recording after launch is as smooth as the following ones.\nImproved: The Home opens in front of you at eye level and offers the guided tour the first time.\nImproved: Colour-blind friendly colours for the data series.\nFixed: Tapping a chart no longer blocks the Y-axis + / \u2212 buttons, plus other small fixes.", "created_date": 1794823688, "id": "29482845718008048", "version": "1.6.2", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29482845718008048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2796960043802170"}]}, "change_log": "New:\n- replay and trim your recordings\n- save and load experiments\n- axis scale controls on the charts\n- smoother velocity and acceleration\n- new tutorial lessons", "created_date": 1794388615, "id": "29410919278534026", "version": "1.6.1", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29482845718008048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2796960043802170"}]}, "change_log": "Physualize 1.6.0\r\n\r\nNew\r\n\u2022 Continuous tracking: record with no time limit while the app keeps only the latest seconds of data. Ideal for pendulums and periodic motion. Charts scroll in real time.\r\n\u2022 Units: choose metres or millimetres, radians or degrees for charts, axes and CSV export.\r\n\u2022 Linked charts and trackers: tap a chart to see the values at that instant on every chart, with the matching tracker highlighted in the scene; tap a tracker to find it in the charts. Point the ray at a tracker to see it highlighted, with a gentle haptic and sound.\r\n\u2022 Two-body system: new option to show the paths of each body together with the centre of mass.\r\n\r\nImprovements\r\n\u2022 Tap a menu numerical value to type it on a numeric keypad.\r\n\u2022 Larger, tidier menu in Physualize colours that you can also grab with the trigger; app version shown in the Info tab.\r\n\u2022 Gentle haptics and sounds on interactions; softer vibration while recording.\r\n\u2022 The path appears from the exact moment you start recording.\r\n\u2022 No more stutter when you turn on vectors or change merge frames.\r\n\u2022 Sharper chart lines.\r\n\u2022 View reset: hold the left menu button.\r\n\u2022 Main menu button to go back to the start screen and begin again.\r\n\u2022 Up to 300 trackers per series; when they run out, recording stops with a notice.\r\n\u2022 Passthrough dims while the menu is open, for easier reading.\r\n\r\nFixes\r\n\u2022 More accurate data at the start and end of each recording; velocity and acceleration correctly aligned in the CSV.\r\n\u2022 Position vectors now reach exactly to the tracker.", "created_date": 1793184133, "id": "29211602878465668", "version": "1.6.0", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29482845718008048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791284502, "id": "28904671529158806", "version": "1.5.65", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7721639864555280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29482845718008048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2796960043802170"}]}, "change_log": null, "created_date": 1787149471, "id": "28277641278528504", "version": "1.5.6", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
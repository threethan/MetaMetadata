QPL2VMUm6L7_58iz8KtgbkJmBKHeDzT2nkofKaqYQG5fdL4ZZgL3ml-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNOf-Yfljti-96GE-7QKqKe70TfvAUn_CnW7vCseanhg&oe=6B01D29D"}, {"file_name": "4.2noblur.png", "id": "723699449885360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031606_723699456552026_1112298933121507473_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YksbMtEljesQ7kNvwFl_Jzg&_nc_oc=Adrd4GfMMZepeK_FBHEl_8lL9SDazRGVGO0nmyDWeCUK9PmFzI-5adoEWL6OvPzM1LY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaWZLGw-l_NEVL8FNsNk-p7nDvWn3jK076X8bj0VgSYw&oe=6B01CDD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER-COVER.png", "id": "384213234374260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984471_384213237707593_3342460111573913850_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cbGS_cNLEQQ7kNvwHoJXIl&_nc_oc=AdqV4d_2vIMw7VIj2HJQO89iaaNxuhyLn4v3YSnaYNFqeT6FXqvz3XNTPhO2wuMplrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREZiLauNsjrVhvP5xTxozzs5f7s_9gySq5TlpBMr4opQ&oe=6B01C3DF"}, "display_name": "Exercise Your Demons!", "keywords": ["fitness", "game", "exercise", "demons", "boxing"], "long_description": "Let\u2019s get PUMPED! Unleash your inner beast and battle back hordes of demons and beads of sweat in Exercise Your Demons! With the finest fitness trainers from the Infernal Gymnasium guiding your every move, you\u2019ll throw down in your living room to save the world from an untimely demonic demise!\n\n# Single Player Workouts\nGet your swole on as you battle through the netherworld. Clash with the Doomer Army across 9 distinct stages designed to push you to your limits!\n\n# Trainer Huddles\nForge unbreakable bonds with your demonic trainers. They\u2019ll motivate you, challenge you, and keep you coming back for more with their unique storylines and devilish hijinks!\n\n# Competitive Leaderboards\nCompete against your friends and rivals in fierce leaderboard battles to climb the ranks and claim your seat on the throne as the ultimate gym warrior.\n\n# Unlock New Equipment\nCollect the latest cutting edge equipment from the netherworld and crush the opposition in style.", "short_description": "Fight back hordes of demons and beads of sweat in Exercise Your Demons!, a mixed reality fitness brawler!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infernalgym.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Vyersoft", "support_website_url": null, "website_url": "https://www.vyersoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ca", "fr", "de", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "685521173423682"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1682487919633268"}, {"status": "PUBLISHED", "id": "2602881106775209"}, {"status": "PUBLISHED", "id": "1576938696864338"}, {"status": "PUBLISHED", "id": "1878779312797594"}, {"status": "PUBLISHED", "id": "1445514693772689"}, {"status": "PUBLISHED", "id": "900818579130705"}, {"status": "PUBLISHED", "id": "1855097655366172"}, {"status": "PUBLISHED", "id": "25674248792194764"}, {"status": "PUBLISHED", "id": "23982470298089652"}, {"status": "PUBLISHED", "id": "1535869877821651"}, {"status": "PUBLISHED", "id": "1848868202346831"}
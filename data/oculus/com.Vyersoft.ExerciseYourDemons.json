5/39031606_723699456552026_1112298933121507473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXX2JUR_f7YQ7kNvwHBTMm5&_nc_oc=AdqB5tWUh5av47OK239GRQmmEyYf7UwLU2gFHV_dGRdhOSAQLJuV_HeWZOTDD7u5XJ8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnaf_YWOXQxSP6f2Bp7NeQBJaztB_s6uZDGR8rhyLIpQ&oe=6A8EE314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER-COVER.png", "id": "384213234374260", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984471_384213237707593_3342460111573913850_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV_23UQQsRUQ7kNvwGyULjV&_nc_oc=Adozs_Wbpcn9wxBcTJ5vIq0JbtbLQyZVlTA0Ju-omdMSWwGhPVbo5xy21-_GcJMjfmA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVghF1PyYRJsPHYVREaryg-WOG3Zns_RaRL7JMeBNWmg&oe=6A8ED91F"}, "display_name": "Exercise Your Demons!", "keywords": ["fitness", "game", "exercise", "demons", "boxing"], "long_description": "Let\u2019s get PUMPED! Unleash your inner beast and battle back hordes of demons and beads of sweat in Exercise Your Demons! With the finest fitness trainers from the Infernal Gymnasium guiding your every move, you\u2019ll throw down in your living room to save the world from an untimely demonic demise!\n\n# Single Player Workouts\nGet your swole on as you battle through the netherworld. Clash with the Doomer Army across 9 distinct stages designed to push you to your limits!\n\n# Trainer Huddles\nForge unbreakable bonds with your demonic trainers. They\u2019ll motivate you, challenge you, and keep you coming back for more with their unique storylines and devilish hijinks!\n\n# Competitive Leaderboards\nCompete against your friends and rivals in fierce leaderboard battles to climb the ranks and claim your seat on the throne as the ultimate gym warrior.\n\n# Unlock New Equipment\nCollect the latest cutting edge equipment from the netherworld and crush the opposition in style.", "short_description": "Fight back hordes of demons and beads of sweat 
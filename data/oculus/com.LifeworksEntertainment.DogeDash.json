7B"}, {"file_name": "Screenshot 2023-03-27 123227 (1).png", "id": "956990358663266", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974709_956990361996599_8714836251392745668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHThmwTtzy4Q7kNvwHDT9ZE&_nc_oc=AdrpX1E5E6jO30BWQ7kmkpSbjiejETPzO2wSzisXnIxKwyxBDs-5RGuc_n7httFu8fc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn9aXTBeGMeKObUZX836zgXllQNlSx8h4ks7xA0uaaAg&oe=6AA40472"}, {"file_name": "Screenshot 2023-03-27 123057 (1).png", "id": "2055122738027261", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982703_2055122741360594_2634591880983387851_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gp2LMedO4MQ7kNvwEujbV3&_nc_oc=AdosZf3He2fgYDMQK2h0pedC4-GbR0w8YCRTlQg_ytiFwwi78VpAtKn2ZjfYtt1nj5E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-lPaRj-Z--Vt1Gbjwc0gP-RGlAguAz2D_LFYhc9Sr-g&oe=6AA3F8B4"}, {"file_name": "Screenshot 2023-03-27 123304 (1).png", "id": "2559398800864462", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75485573_2559398804197795_7632348446689205350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9i2MNB7IGMQ7kNvwFvGn3M&_nc_oc=AdqDVW2EeFi9iFwXQKQ4sXczcB8cHzap6ch36xa3A3Hlsjv6sjsSqDbkT5eO18AhUsM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYoiWhlZR0klEB0vlMglvs_e6U6yrD_3PwlLU9FsEaUA&oe=6AA41252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2023-03-27 100746 (1).png", "id": "1283113655945863", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974715_1283113659279196_2083987246601336658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRBunFu1t7oQ7kNvwFk6dQV&_nc_oc=AdqiBq8wXqmhXGSXGf4Q39baNo7GXgA2nrKxAMi1VnT8BdewF_s4CR6SrBYbnyyU0yI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHHgyENR-v10ZsS9qCebkNLNjzL2ywYA_kK7_afEU48g&oe=6AA40D39"}, "display_name": "Doggo Dash", "keywords": [], "long_description": "Doggo Dash is an up-and-coming game that focuses on fun and quality. In this game, you get to explore many different maps each with a unique experience and adventure to have with you and your friends! In this multiplayer experience, you run around and play as a cute dog you can dress up and make yourself the most fashionable dog there is, show off your look to other people or chill with your style! Treat yourself to some virtual food and roam with a new virtual pet you choose at the pet shop! play around on the main map! We are devoted to making a fun engaging experience that is frequently getting updated and better. There's only so much you can find in a description hop in and find the experiences and memories that can only be found by trying for yourself!", "short_description": "In this multiplayer experience, you get to roam the world of dogs and feel what it's like to be a doggo yourself! Explore many maps and modes with you and your friends! Dress up however you like, and buy virtual food and pets to enjoy! We want to make your experience better than other similar games we want your experience to be memorable and significantly over others! You can experience the best VR doggo game today if you play now!"}]}, "developer_name": "Lifeworks Entertainment, LLC", "developer_privacy_policy_url": "https://www.lifeworksent.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lifeworks Entertainment, LLC", "support_website_url": "https://www.lifeworksent.com/help", "website_url": "https://www.lifeworksent.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
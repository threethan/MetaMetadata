6914171218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982622_306386917504551_5836106551699786237_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAob9XZXOMkQ7kNvwH-L8rh&_nc_oc=AdoRsjm6tq6uoqPKd2l9Q5XL_U_l8fNVPAu0n-uP-7iB8-yAMskn10sA2TCKCfWht5w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs2OqwVfDvmAH3XJHe80rfsIgRa7wdowUC9PDadRhrqw&oe=6ADE20A8"}, {"file_name": "Quest-VT-05.png", "id": "278509010432418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_278509013765751_5310274236062343564_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrDFp2hEaGYQ7kNvwEYAdg0&_nc_oc=AdqPOdEE6efALKAPhqgesDKQezJOojNAC6_FoiI7DBwmt-k7GJ-1vzom0DF3tC7ZdMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNru_yloLszoaMoYdHV6dUs-ecPPndsHSMNOv_uJxeeWA&oe=6ADE1EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Virtual Traveller-2560x1440.png", "id": "470486867556532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65395359_470486870889865_3898455474082987970_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GowddAYCKAMQ7kNvwEBTx-7&_nc_oc=AdqA7tGP-b2v1WERvDeoa52dF31H_vXJ75zul48gxAEilt59aJutLl44PLVa1AYKQ70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7UqOUTKbKKZvUN7QRDHNpsMuPqFTPft0DeRGPSqb7GQ&oe=6ADE0BFA"}, "display_name": "The Virtual Traveller", "keywords": [], "long_description": "The Virtual Traveller is an application dedicated to travels enthusiasts.\nIt allows you to view selected 360-degree photos from Google Street View and their contributors. The photos are grouped to create travel tours of the most interesting places to visit in the world.\nAerial view Video clips created with Google Maps and Google Earth Studio, connect the visited sites and atmosphere music makes the trip more relaxing and enjoyable.\nOnly one controller is required (left or right) \u2026 your choice.\nset your boundary on the Oculus Quest to stationary, \nA swivel chair makes visits more comfortable.\nEnjoy it and \u201cBon Voyage\u201d.\nNote: Oculus Go version is available under the title: \u201cLe Voyageur Virtuel\u201d.\n", "short_description": "Whether you want:\n- choose or prepare for your next trip, or\n- simply let yourself be transported to the most beautiful places to visit in the world,\n... you're in the right place.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.levoyageurvirtuel.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MBprod", "support_website_url": "http://www.levoyageurvirtuel.com/", "website_url": "http://www.levoyageurvirtuel.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "EXPLORATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476395747259511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "361788642035466"}]}, "baseline_offer": {"id": "361788642035466"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1625153820, "status": "PUBLISHED", "id": "361788642035466"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4116198461780955", "version": "4"}, "id": "125334449499691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBi
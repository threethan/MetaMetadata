f_20YyIsZ0Jf56DfIbQfESwLwjRH2P6B1-urdRcF37rUQ&oe=6A3D5C5F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rps5273ZWrwQ7kNvwFk_0x1&_nc_oc=Ado_ZuCdsNrvj-ZiYUFB4ew44viYN_HDtIEGZRQlaSLo7TDXScD2A0FsmGsJRMiV07k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AYYgqpxmvwNCO-E4Lwtmvf2B4CdGaHaNE_fP1wv_vKg&oe=6A3D3737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-y4qrzWRaUQ7kNvwFcY9_t&_nc_oc=Adq1x9aR2IkbwyksjiGZJJ-daiz2AOdUEndCu0IUA-wfCXod7-C59Zk3DkxLNJzR7v8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nWADkp5RQFdoCeHqDcyIs8ONMPvQ-F3QGpSpyppzhCA&oe=6A3D53F9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5
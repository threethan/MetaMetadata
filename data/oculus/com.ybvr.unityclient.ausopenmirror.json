f1pl9mb8L6JFuQUMxPZLDtljckOtDFcRn2XwUldn2WSpw&oe=69E22C9F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwxUFlyJCEUQ7kNvwHoNrxc&_nc_oc=Adr3KX5AURxd9lYEMUQNv8O57lN4RNUiohqU8bNvPJbdurhZ7tA7TDXK6JJ_S4V50tI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17dcnOqtqdMVeQMzQjwcce0zAhaO9kVI7rLc7HSVwtEA&oe=69E23FB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnNQlGk8NokQ7kNvwGmDYQR&_nc_oc=Ado10NdZjuZY-F5LFEFj5mTaJW-SiF1yKVLMvey6vopD-tTPEDtYE4JBL91pmHWhSZk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1euqXHu4t0QkWe1-YCa1esWN6o8-_N8W0MIJkHArbA7g&oe=69E22439"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5
g&oe=69BE941F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJkaFsEvmpIQ7kNvwEyTQiK&_nc_oc=AdnzWuQhS08BzckIlWNV3YTidDhkFAi-A8jlqL17JZeXUa5MP2Lz8QtbKGhYGpXTh44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDNfJKzrxhV3ap1Z_4mI7xjfX3EkJORsYMgBM86X3dJA&oe=69BEA737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2_A-62D220Q7kNvwE8upaw&_nc_oc=AdnOPGwDr1UbI3wU6gWmyLu80xDK_-rrwE6hpuqAA1bGlMYpg8t2e4eCulOXeiGxGqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpEW2IYeuDAIMP988Dcqh8Wz1qVXROGCMyM2JW_uFzcw&oe=69BE8BB9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230051_704643833753490_981048534016631306_n
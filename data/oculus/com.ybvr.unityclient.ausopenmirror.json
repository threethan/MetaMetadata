A&oe=69BFE59F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJkaFsEvmpIQ7kNvwG6Ey-V&_nc_oc=AdlB8bZ2SgbgrKz3esn-DAjbKXEnV90Adtk14f00EjnnwtkSZ9HI70ss13WKTuP4zQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPd2viCwCfegVcjndgdYxm4kDa9mQ8fNt9EGLH6ivcfg&oe=69BFF8B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2_A-62D220Q7kNvwHhhs4H&_nc_oc=AdnyxBUBDjFfbW7ZzUVLKG8wgmn1c5wY3h5F7LtvwEIMdv51xwTQfrgVZnW93wG_vo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8Dr3DFOGBef3BquhYkntATbhXJCsQ64ijFx_nihrdRQ&oe=69BFDD39"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230051_704643833753490_981048534016631306_n
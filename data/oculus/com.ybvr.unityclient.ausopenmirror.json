6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hAMivuUXt8Q7kNvwG6uTPB&_nc_oc=AdmvO3t_ZQOu9UD08K0DpuRls5Y9l8FKLeb5Lw0WxXkm6VLBo35AoX6NhVWbYbDdhpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuXdu-2DJqLlhv_0JUXq9EoS71RVzldPiFa5ocSiNpVqg&oe=69986BB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gatB3Z14G6UQ7kNvwGBwmX1&_nc_oc=AdkV-u9HeQ5SXteFoZtSR0C51jTvf2nSx1itlPJ3H8kVTYaWPqdKsMJOt6pzQXtVyxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvgI0KF66lC8QTakEcekQxzAiH9t27r8rcWpqZq_lrpGA&oe=69985039"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230051_704643833753490_981048534016631306_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS6L7t-mChgQ7kNvwGF9jFq&_nc_oc=Adk4dlrS-lgMM1EC1IO-rC-lbil8MxdZDtld-A
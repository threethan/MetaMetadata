QKO4JYTW1zwPezh9GF40lfB6oGbQ4LHTOOYC0E5GWFYGA&oe=6AB7BF9F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdUIPqcwsBQQ7kNvwEiIa_7&_nc_oc=AdqOLeo0fOdx_bSsSKuUBS7P_4pGqnLX6Q46luiHlmJ6VqE7Ad8i7eZLxWuARykODxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5cKExGUtfP32GrKhf8rVsi7VS6ZDcwdjp_J1TtzYBmA&oe=6AB7D2B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwid48s8BT0Q7kNvwFGhErX&_nc_oc=AdqfwFVYzTHzknMV_68cCuvRoHEREy6-_Dt2LmK3vi4KAXthBCUgZ6PWYssgZGX6Up8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQdhyXJwlauGGhLyD1PumGV30WCsl9w6evYtBKuY7srg&oe=6AB7EF79"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5
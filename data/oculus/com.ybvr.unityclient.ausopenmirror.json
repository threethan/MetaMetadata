f-3XViDbAdxnO2RWYC4jN7EbrJDzP6P10wIMQKcm-gbRw&oe=6A3421DF"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY0VnegRz94Q7kNvwG1jyTD&_nc_oc=AdpquGmAcrJrgnTftXqbLF6s7msd59v2wwL9nKKRIJ-5ycjOcGe36biNHfKiZhlJxUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KMKZAEOcTKowou_9uw7gY7CoV2Fgh1jtMqqRPcmsq7w&oe=6A33FCB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaMBjcEHjyQQ7kNvwH6_1nb&_nc_oc=AdqPuUNmpNkVIYkebRtI1EktHaN7qLqz6I9plskDbIPB4O8yBvDI81KsRllUJ2vIc2E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zi5B09rweRf8OUOexvR_8mrcUXzfDotQ-o1N-U-6AGg&oe=6A341979"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5
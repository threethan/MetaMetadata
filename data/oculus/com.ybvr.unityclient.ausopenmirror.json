fzEaYkKB6y3BANT3Jxq8sCVRX8oMSd7SNgZmoJD_SwaIA&oe=69D1091F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LI0xW33YK0Q7kNvwGcpseN&_nc_oc=AdqNe5icj3l6rT_M1a-9-hwUeIf3EDISiJzRrH8FibfD6VymUIhw-InhUhMA7E3gNow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlRnfM6dV2jd_yLW8u-hSlsgSUGPHdhra2VfTDkVzd9Q&oe=69D11C37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kolSrN7FVoQ7kNvwGwnYv-&_nc_oc=AdqiiJF1HtvI0fRa9_uXXSI9syJMrQ5pNzuP1Vbczq3a6YWFUnokluMedsLNS72mquw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWhB482nxa1ajc83eNAInMeSP8_i4mduE6ZAuqV__pKA&oe=69D100B9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5
f2qrZbUZhJK17QAAa3BK-QVix2L-BwHAPQcpsPDbpnTjw&oe=69D4FD9F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD3URhV9g6oQ7kNvwFXE2lt&_nc_oc=AdrtznkQFNhxLM9a2e3u0XUDzRaxjva6_jQcnrihrRXRJ24o9ULpuK3Yxs_j7dFFfvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17m5C_L90slPRQbJSEIt90AIGaHsViJawgS_UBaACpYA&oe=69D510B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCe_ffQxBBsQ7kNvwH7jd4Z&_nc_oc=AdpHj_8DNjLsuZ7Va5O-pwcT619e8N2vn5bDB5129F2TLWtLm_Eu2cQDmQafvQ2ad14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VW8pDS1eDRjRChG5hCbUnQlHE1_hjOh-qCnYpO_u8iw&oe=69D4F539"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
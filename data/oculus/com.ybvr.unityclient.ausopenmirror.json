f4ZKMJ6yk_3dAIr9OXfb3fkeyhNztM2GSsJ2KCLw732Sg&oe=6A007F1F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TECyZpM-B0Q7kNvwHqhde6&_nc_oc=AdrLikwTAgLsUjUsn8aRsd6ZFAQo1gU8a6iJqyT_fRhYwZZx9rXb08yhvAeQUMsl48Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UMX61WcmAa94UADqerCMmzB9FMD3054r6gGmcf1mFQA&oe=6A009237"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3acQg6LGnIQ7kNvwE9VEpD&_nc_oc=AdoPSl25U7OgmulDrpz2LPbvQu7epH1Izrm47PwNknSU302L-xJQYQhViCCepkT_JX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PkvCbsUO4jBqbS4Fdn4sVqTj5onMCkq96zllG5aREjw&oe=6A0076B9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5
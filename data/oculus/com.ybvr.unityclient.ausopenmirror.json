 Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9N7s3CWnG0Q7kNvwGUUDcq&_nc_oc=AdkIGOt0pPzSS6shTBydf0uTbX0ct3iX2fha4rzTvG57gBV058M5aUrxhv9L7Xqdgck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDSyRFp7fSTYEiqzUC0SS501yHJnmBYrk-NHFqEc59ZA&oe=69B2AE39"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230051_704643833753490_981048534016631306_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjZjYOPsTCAQ7kNvwFj6nyM&_nc_oc=AdnlclSTQ1h00m_Q81Kxo4ymZz9oVBgcIKFmhfJwTiLHyLhIhXwanjG6N5yZuUtgQNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRKMKt-iq9aSUPlq9ZgYPScbkNQ18gw1gdRpFYPjPByg&oe=69B2A0C9"}, {"file_name": "Square.png", "id": "483520132656129", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75666286_483520139322795_3526818540801169626_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSeOhoPWsIwQ7kNvwFTp6jP&_nc_oc=AdlCBP4B-E8Dc6f2pcS4t7nZ5lx8WiNcBTEG4QS3Sl4Zc2mWEWh980FHPeIuLd0_MEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_hZRC_ysOeZH4VAYYsKb3a948-tLrnFraFt2FN-TOIg&oe=69B2A4AE"}, {"file_name": "Icon.png", "id": "426648561976328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272208_426648565309661_6996016450691187172_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBN1O5Is2lgQ7kNvwGDpKRP&_nc_oc=Adn45vpODYixJQYZBUP59rUQp_MUfOj_GYNmJsSZ-tVn8GMjkax_CYTEIk6cF1dZbIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxoN2Skl4DF1_gpIUwzAHOk0TsypUu6BMQjTHkvLJ-4hA&oe=69B2A8DB"}, {"file_name": "AO Logo_1440.png", "id": "420012769266507", "ima
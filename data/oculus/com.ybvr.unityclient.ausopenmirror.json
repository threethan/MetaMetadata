f_H1DvBrgEcVBtdL-dz7JNuvDJ0XqwmNy1PbiguMsTxlQ&oe=6A38165F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuevbrBRbtsQ7kNvwEgrOGX&_nc_oc=AdqvvMkaN7pS2mtonPhh36_BcCAuaKiPaDrqJnjBn8RgBY8yBUj1Hn1F9MQC092NbRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UNeEh9aoHOA_A4JWdgnMPtGSmyVT_QOGKzyPE6HzuhA&oe=6A37F137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Irx3iIa5YQ7kNvwEj7gmR&_nc_oc=AdrW_C5ctB1Rg4EtmJrG0rxWV7loJi6kTPG8uxGn8xnAaPkSnhaLbkKGoFBsRMku6qQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KfTKK8_1-9M0RAjxuClR-MgNQWbHWl7Bz6SdhBQgfIQ&oe=6A380DF9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5
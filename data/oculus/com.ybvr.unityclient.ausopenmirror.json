0f&oh=00_Af-yH6xQIw3RuZIad2EarBAopWORxW35ExZVTi6MTb-R-Q&oe=6A392F9F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuevbrBRbtsQ7kNvwE9oQCb&_nc_oc=AdoWJPLRuIJBVtMBODnnTbTPUYnMb2rGeEgdD-Ap1jANq6MEM4q5Onl-ChQfL8TSfSM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_soRw3E8zwdWlI9ymzSZ7TvcOyhtnQjnkgTtddymNMqA&oe=6A3942B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Irx3iIa5YQ7kNvwGSxeXJ&_nc_oc=Adr_bfikafJ2vfwAVEsRvJ3tG1F5t0jvs1_DaeqgBwh3s4EnZoljcso9fIRVveie9Rk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WCaZVv9zaZtvR19hawStN7O_LR9keO0-6QNilINueVQ&oe=6A395F79"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-3.oculuscdn
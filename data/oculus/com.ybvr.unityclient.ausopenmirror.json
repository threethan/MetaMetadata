0f&oh=00_AQJUQZex84JvvEM1zYzZjKB8YxuJZut7m7tkwMjAzHzuzw&oe=6AA93F1F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd0AJ1iq_DIQ7kNvwESMBDf&_nc_oc=AdqYtufrg4WD45QJXsnuJEUCD3_0_eP4UrBJVJ1-4qBPxir63MVeRDa9_-pfq35bX0U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw8bek2aIwR0XD-PIkbNcN2SgyiPZTb3wxz_geWOjdhg&oe=6AA95237"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIt7tSLm4jYQ7kNvwFduqsO&_nc_oc=AdoQgSqfB1T8NvrdNl8At4-Gu7zNH3UeL6iCjkNRR2E-lBC_tzKj-SNZeTRLQe3o0-A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxNbw835ESdQUJMp5hVhRBLbGz3RbhvEJpqURqDBxyBw&oe=6AA936B9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-3.oculuscdn
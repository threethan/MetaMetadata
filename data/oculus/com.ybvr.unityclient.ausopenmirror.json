f-PECOZSJwn1UpY41Ayr01JQgtDWj3bKPx1eqqVriGdYA&oe=6A2FF51F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKdjAGlXWBoQ7kNvwHe7jMc&_nc_oc=AdrX8WV1hMmZ1iEEPD3eB5xHzLlcAONfsxwXCEihYnsciNTeX5vmTGUivzev_57zZJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m5WJ7MD0vdNKTIY0PjD3o0XUwKOBbJCCwzCyIj87c1Q&oe=6A300837"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAbQcTUdBBgQ7kNvwEBnfiD&_nc_oc=AdrysSdlDNaxrSQhCzzrEZE8HwNg3USnv8pcgwUIo_lpBtbe3KUCVQ7BoMaw6pvj7Rk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C5hcJji3hEunwBnu1No-0S82Z1va0hiD0T0oqNKspBQ&oe=6A3024F9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5
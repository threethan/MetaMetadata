f221gFerl3WrMKrXMcVVw5nNP2PmSyZP4yo9COFOh5sHw&oe=69F4A19F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H1vxOeWm-wQ7kNvwFjWFwm&_nc_oc=AdrJ934Szs_ZTnU2Y4IWiPcft0mwQdsSUpenMBUUPKkVO6NkFUO_F3Be9LJ5_N_8wi8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fpkiygwyNKoymk5NFMjUmolYJceQM12TC55F0yV24mA&oe=69F4B4B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMsuXTbvzL0Q7kNvwHg0YWE&_nc_oc=AdrX5J29Be7M3AG_2gMok1-cFo-y7teBGwrpK9g3IoxERrsSrye3N1BOtnzRxWiQB4w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2f2N3pTwVGJZA5OJX4JRtcXrlO1WO_JToHbOQCr1_aZw&oe=69F49939"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5
9A43F59"}, {"file_name": "screen1 (3).png", "id": "910638853098429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_910638856431762_5453290446117192308_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbEDIcdD-yEQ7kNvwGwWqri&_nc_oc=AdmKBlDFCdeyVylqmlqXKnFGHiEw7dCzfj2JSDRpcLbXN0bSZe60aYtwWhOc_m2YhpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6KjaTc-PWNHCc_QR2wvTNmbt4aZK2p1poCdbHD6plKw&oe=69A4361F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpNgbzSe8vEQ7kNvwHF0xiP&_nc_oc=AdkkFWoDWFMDrQBE5u6pNdLpTtnI3_g_MVI24Jq2tpcnPnLMEGUiC_7q2mojePcp83M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvDHBEzNcFoDf6LVpglhIfJj39phRCFrx1QeA1WK1LrkA&oe=69A44937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOOI
f4RsZb4j-EoHjphdfHvMdUUaI_ncWF6xh3A31fg9ztGsQ&oe=69FF2D9F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NXgvmCNVvIQ7kNvwF3JsT0&_nc_oc=Adp8972Pu6o-ojeUOffMU27eg9lkuWjpdTVjhG9hVtLB9itAPjsarm9AqBrcH44F3qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MhVNgkl_xOGrU-NfkmeeSFUJVML3m1hLzKBTwkOAhLw&oe=69FF40B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rUZGm4SA0QQ7kNvwF5T_Kf&_nc_oc=Adr17NfcGR8yuwEE1pmtgnr91BE70Nm0AMGFmU7qnvUWgEqjKnBgpMSxLNTVL_ols9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CPajwhSwTL3aP2hs91dJ6MvigmfwJAqqWNtM5LNxpkg&oe=69FF2539"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5
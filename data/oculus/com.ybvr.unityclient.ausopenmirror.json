f6rWOjm2DqxloGUQHZziTMT6JMJKkMwvlMRS8dx65tyQw&oe=6A0C5C9F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKRKtyFP0ZQQ7kNvwEhH2yL&_nc_oc=AdrEuuWzNMbKs64d5tPgZ20xKqlimjuaUIzvHpsb3tmaye2Dq0Vjr520gQdXCpCczD8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af670Tmpl0f5mmeyzLCPnIV3dnVo7rbSTU2oCBH6jKOYSg&oe=6A0C6FB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9X-TMft0R0Q7kNvwEaqCxG&_nc_oc=Adr3rpIz_ZgiyBguVSQkqOx-wOLD8G4_OI_At3kn0rp2NTzfRkaeKE2ifN9t53bV_Q4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vNlYuYXUGitLyHOnXm1kRn5XK9QPcjYnXxzMwvnposg&oe=6A0C5439"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5
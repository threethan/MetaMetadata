f-puYk7Ku_TNf0phTgawy-q2V7XiXc-seWeA7uNAEfFyA&oe=6A3FC71F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqGk1yX6WckQ7kNvwGqSBv-&_nc_oc=AdrZEjZwZuEvceIAbHIL9g3tKhkWuUg4aGxy_8aG08O3UBZKdjrFxjrsSSXRkg1T5PA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uKOE95t_24qiK_dYtQzycVDR6rgIE2p9tSN7o1txjsw&oe=6A3FDA37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5Ah7NFUo5gQ7kNvwEHckKn&_nc_oc=Adp0cP_BsIG_X-T2XidHjAA-fUOE1ibi62b4cluzLikOB6pLWxdRKek3pR0D48l4SEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s7AXtZ-3MF645xwbQ9pp6atrHDpqWtJZXuZrNLA6tmQ&oe=6A3FBEB9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
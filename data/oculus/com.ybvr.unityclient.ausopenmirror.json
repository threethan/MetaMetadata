f6D7apRle2GOyK7nVC84iIL7ajbHCkozCM88iCFALgx5g&oe=6A03221F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TECyZpM-B0Q7kNvwFOomP5&_nc_oc=AdqxS03b42WZY54_8sFeReXOfGW75QubDMhAoyxSf9xvQVBm3NZcAM7Y-cNjUrL_Xaw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rnmqlPrRzIlQDi7knQVx2_npCy-lV6X3VgBYgSOMOIA&oe=6A033537"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3acQg6LGnIQ7kNvwHsPz2l&_nc_oc=AdpOrJpx_lelpML5n35KLc2tMHm3K_yr4vUa4eOy4jKMr_tLrYYSC5ex6ja6FDJ1eew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DoJuuESLX_tollyxoBQCNusiruJ6qX0NnUNsun6GcXQ&oe=6A0319B9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
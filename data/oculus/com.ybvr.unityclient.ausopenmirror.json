 Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5vcjnUcQaAQ7kNvwE2u-yl&_nc_oc=AdntucCPOIQe-cPO4AdFsQpGvRdYRLFrH4tC6s5-XX_ufcaCmRZd31pAcV15ohW1lb8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEHD4XKLzw2EcuinMtueszkTY-3K5ZQtDSdEP7cdRpVg&oe=69BA9739"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230051_704643833753490_981048534016631306_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWbKdWdGbCkQ7kNvwFogL0g&_nc_oc=AdlEkk1vm5Hy1g-BYTgHmSsc0ngSmjp6MdjP8YfitKBNXDvq6iH1Q_0N3gskC5R-qZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwR_WVSO3ONiFaiVj_BE0sWXboAzzGIOyHU8kw5OwO5wg&oe=69BA89C9"}, {"file_name": "Square.png", "id": "483520132656129", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75666286_483520139322795_3526818540801169626_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZcPtAinJO4Q7kNvwF1v028&_nc_oc=Adkh_-m_VJNg-kkQqtHdrandjNvqX9sHf-MLhSXegCJWAE3KEENqxQIfXY_N5Xngs0g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzP276V65dgwbn1Fqx4t2iEGS_6FL0uy7RZ9ZWCnaYJWA&oe=69BA8DAE"}, {"file_name": "Icon.png", "id": "426648561976328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75272208_426648565309661_6996016450691187172_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7S6uYYF16EQ7kNvwHjZR5A&_nc_oc=AdmmB3BwULmHN6bXZYYXbXUzif5JFmlNhZfoyXqrpmxkl_2i-Vm-okmexPpzX60mWhs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKmLEElqnLjw_CXG2ReMCOcvEgeyatgN-7FWa4Y3W3EA&oe=69BA91DB"}, {"file_name": "AO Logo_1440.png", "id": "420012769266507", "ima
f6r2AN58pSrFjcyV-U-gRMHyzM0Du69_C5oIq24kwK_4g&oe=69FDDC1F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NXgvmCNVvIQ7kNvwF9kaxp&_nc_oc=AdqQ4PPE6c1jk1GQQFIvT6AMDUgcRuuIBNuW8cQqWa2kNY_VlYjVYoy3Rec0z80Jbeg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LZlZM1XibgQhvUJnBEa0qmLk8xW8XRz2y6lM8KwpdHw&oe=69FDEF37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rUZGm4SA0QQ7kNvwGCbHmH&_nc_oc=AdqSlI1XvIfd0CkX1tDIFNCgAU9mpK4bVQCsgcgJoODjgeuKPIOkgSWM-Jw2uq1-VVA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oQ0cFxMObBN90yfR3AfPK_OA-9AAUpeNHxcr4rbAaag&oe=69FDD3B9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5
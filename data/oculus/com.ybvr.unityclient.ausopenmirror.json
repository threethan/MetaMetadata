f2cUPUCmYBbGRVknGqJp-aAzv1wm90hV6NRJo2b_nQJIg&oe=69DB951F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAwh0CLSPtoQ7kNvwGSuAN9&_nc_oc=AdqFRw-73dV7j63N44XkXh6X2Dz2-LoIXsxeVKvfNJMVtSevYq2AY9lFiCMZWaaPXdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04zlsu_6R7ANlgja4wA_F6TFpGXQy5DMLc6pQqAaBS7A&oe=69DBA837"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilNK-0MC0zEQ7kNvwGkhEU4&_nc_oc=Adqo9oo3vnwnddXTJ4R32OwnWs7cqq7Bm_XAXYrPBtKQ0Jh2oyU_qXAZ82O6L6tom38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZufJyfxEEFGHKS7y5G3W0wPz4aw72WzofOl05YfPdHg&oe=69DB8CB9"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5
f32RDg6td9-dJDbmwLMGnunzfyPcGJJz26dZwU7fETI8A&oe=69D7A09F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD3URhV9g6oQ7kNvwFR4kjR&_nc_oc=AdqmotSXsQ_ZpswzphkyuEZZugwDAeqDgT-Azu51-uDT9Pe83p5DD07yypAefWTP96k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cnc6skwy0XjPr9Akl4u1bA1jMOrISIwCZvnEnXgLfHQ&oe=69D7B3B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCe_ffQxBBsQ7kNvwEWVQkZ&_nc_oc=AdrlCgFTrzK1uLEDUqVI5F-9Mn1-UwgxRpBCGl_RE8Ku_vjYs03xywQOM89QH0Alxbc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dNyPXUndH1w3lJsHTVcjnpLwJeAaw-KSGVhh4RG4pXQ&oe=69D79839"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5
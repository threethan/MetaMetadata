 Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToJYIICg2pcQ7kNvwENxlyQ&_nc_oc=Adm_LTT60mKTWpBJ3FEXKSiOoVN22MjdbJyXUDuFXJ4OIiFBay3Ye1vvtOU2tyXVflI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIog_EYvfbTLScunVBVgtk_M9DAU494h2nTcL-L80ZBA&oe=69A82239"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230051_704643833753490_981048534016631306_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDiFSsQaAYgQ7kNvwGNNS5v&_nc_oc=AdlBCNaicNoGlL8aPgD4UticxXicoo2XJrikK325CUqlAC9Y19x1QEIrMutB4i1LOuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuO7FEGMYsRPJe6vvY7HCgYR6opasigtBSCgrZzihr06g&oe=69A814C9"}, {"file_name": "Square.png", "id": "483520132656129", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75666286_483520139322795_3526818540801169626_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F7E8zYWzukQ7kNvwGjud5d&_nc_oc=AdmfMIijyDo0RbdBM8dY4lAPtBJAzEPmBsBntFzLllg3ZuE1Mzs630DUmZRYMUe2j0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSKCTXwEvTKvmtwyyudtSzlfkeArJ8w_LGqMWLaBTwhQ&oe=69A818AE"}, {"file_name": "Icon.png", "id": "426648561976328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272208_426648565309661_6996016450691187172_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMjWw-PXFGIQ7kNvwHVC0nU&_nc_oc=Adl9cH0BkSgxGVUq5g2rMdi_UCZbsX7foaNPnej7h4f1qZpkI1ri13aZjggdwGTdKBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuyUiAMprWb83jjKRHdn1I4L39iUb3-016mCwPfWWq7SQ&oe=69A81CDB"}, {"file_name": "AO Logo_1440.png", "id": "420012769266507", "ima
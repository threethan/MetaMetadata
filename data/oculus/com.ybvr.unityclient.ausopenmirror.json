QDW4NtrXZRkcKO1DaKVFMrimeuIqSq6rA5E83FCcQklLA&oe=6A4E479F"}, {"file_name": "screen1.png", "id": "143470387595693", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003242_143470394262359_7112974016275905666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC7h0UfpoCMQ7kNvwGG6E5U&_nc_oc=AdqUlOYjWQw-NaSUGYWtxBVO9-8E46O8UTWzdlye8YAp9qG-G_W6_ZV0WGncIx9XYjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-mFUlxpUduhSM3m5F0kDw7Gcn1AmbbcdzE1QIcA2Mw&oe=6A4E5AB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Australian Open VR", "keywords": [], "long_description": "Who says the best seats in the house are court side?  The Australian Open VR app gives you unprecedented access to the very center of tennis action: the Rod Laver Arena. \n\nWith this app, you get:\n- Immersive multi-camera action from the Rod Laver Arena for all matches.\n- An interactive \"Director's Chair\" , where you get to select the best camera from the AO2021 Rod Laver Arena TV production to follow the action the way you like it.\n- Highlights and featured content for the tournament.\n\nContent available only for users in Japan.\n", "short_description": "The Australian Open VR app is your ticket to the best immersive and interactive experience from the Rod Laver Arena. Content available only for users in Japan.\n"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "748208292787655", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568674_748208299454321_9199275796024111845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSQPykXGjGQQ7kNvwGv83Vm&_nc_oc=Adr59_nEUgOSF_2oVWtBCrECIfcdyjQnyySH5HSGfldzgyryEIWD9xuML2ARn_ccVHM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAViZh2VRUt5Ek6-ytjp5z0o2dg9KkrRu1J7owV7fZM8Q&oe=6A4E3F39"}, {"file_name": "Hero Cover.png", "id": "704643830420157", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5
44_7451609668342097733_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2PZIT901l0Q7kNvwGAA7bk&_nc_oc=Adq2MTDnzqPpnmH4CWT_i_vbpxIF-GwgthyIrvfPJXbNA8U0kDcZmFa5MZq7a_-W84Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQutZhhXDbTGnS-U93IHv854H2okQIJDCEW4T4GSGeIA&oe=6B007279"}, "display_name": "OVERVIEW 360", "keywords": [], "long_description": "Elected \"Best Education Experience\", OVERVIEW (a Walk Through the Universe) is an awakening experience that will leave you humbled and in awe. \n\nUsing scientific data and featuring spectacular cinematic sequences, this 360\u00b0 documentary can be enjoyed by users above 10 years old for education and entertainment.\n\nKey Features: \n- 30+ min of cinematic narration taking you from Earth to the Cosmic Web\n- Photorealistic imagery using accurate data from NASA, ESA and other agencies", "short_description": "Elected \"Best Education Experience\". \n\nOVERVIEW (a Walk Through the Universe) is an awakening experience that will leave you humbled and in awe. \n\nUsing scientific data and featuring spectacular cinematic sequences, this 360\u00b0 documentary can be enjoyed by users above 10 years old for education and entertainment."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.overviewexperience.com/eula", "developer_terms_of_service_url": "http://www.overviewexperience.com/eula", "publisher_name": "Orbital Views", "support_website_url": "http://www.overviewexperience.com/", "website_url": "http://www.overviewexperience.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
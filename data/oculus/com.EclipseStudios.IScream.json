0a&_nc_ohc=G8-iUy7-doIQ7kNvwH9JGFA&_nc_oc=AdqQvAvpSCtmj6T8tRyOkXDh2PZ7sISx_2hKmnf3iw4Tm5rH96uh-5-cxoRFJyHGN1Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0-ZhFCGkt-cbzWstGWUn-eUYj_oUOSP7xRCHKNYTqxg&oe=6AA0096D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Scream", "keywords": [], "long_description": "I Scream is a thrilling VR horror experience where you must rescue a small monkey named Milo from the clutches of the sinister I Scream Man. Trapped in a chilling nightmare, you'll explore three unique maps: the eerie Cafeteria, the abandoned Playground, and the dark, desolate Parking Place. Each location holds secrets, puzzles, and dangers as you fight to survive and uncover the truth behind the I Scream Man. Outsmart him, stay quiet, and don\u2019t let Milo down.", "short_description": "I Scream is a terrifying VR horror game where you must save a small monkey named Milo from the twisted I Scream Man before it\u2019s too late. Outsmart him, survive, and escape!"}]}, "developer_name": "Eclipse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/iscreamweb/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/iscreamweb/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interactio
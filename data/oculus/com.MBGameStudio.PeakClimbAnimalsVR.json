f&oh=00_AQEfu0hpZPdU_AaaP2JOZrLCb4t8liC9by6x-oasPd189w&oe=6A8EBFC9"}, {"file_name": "54994e17-f52d-4fe6-9eac-6319528183c6.png", "id": "1162942015677998", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303116_1162942019011331_8013898298535639188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvMuIpLiTN8Q7kNvwFaIyi0&_nc_oc=Adovno63mNvuD4JlJpDE-PvJcTdM7owJ3TpmypxIokiUZ08ud9aGHt1gw-iCw6Zh4cc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfX_3YWEpHvb-xYQy1c6JZp7LF8121CHSOFrRW-5FVTQ&oe=6A8ED6C3"}, {"file_name": "Image4.png", "id": "736826996018470", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499305027_736826999351803_1093154096377010491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D8VpqfvOAAQ7kNvwEEnpyQ&_nc_oc=AdqhITfrVlgoZY9zdej9Y83TwPsT9MXdKXhtHfhAAdPC5Ilr5ryTJy3XmS4Yl7mdB-Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFytJLf46W9keyhaYArjROf4MedHug53lQsTEZj8GlEqw&oe=6A8EDBF8"}, {"file_name": "Image2.png", "id": "2468285953572730", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824560_2468285956906063_7090864661479986172_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_s-BeXTB4gQ7kNvwGtDkKk&_nc_oc=AdolSitVn-dLlWVBL9ZE4iWvS7ZBaJJLvj4WF9BC3pkEDYDd-EV5LopAG6dAaZ5p2Ig&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHus38rBCipdE1SfkXJEDeiUdJmPRSP6zJ6xL5z1iFthQ&oe=6A8EC2B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PEAKS Climb: Animals VR", "keywords": ["peaks", "climb", "Climbing", "survival", "funny"], "long_description": "PEAKS CLIMB: ANIMALS VR is a heart-pounding mountain climbing adventure where the challenge is as real as the view. Step into the paws, claws, or hooves of a single animal climber and ascend the towering cliffs of Peak Mountain. Every handhold matters, every ledge tests your balance, and every choice brings you closer to the summit - or sends you tumbling down.\n\nDesigned for VR, this immersive experience lets you feel the strain of the climb and the thrill of reaching new heights. Master the terrain, embrace your animal instincts, and uncover the hidden strength it takes to conquer the peak of the mountain.\n\nAre you ready to climb very high? Hope you are not scared of heights! ", "short_description": "Embark on a thrilling VR climb up Peak Mountain, where you take on the role of a single animal adventurer scaling dizzying heights in PEAKS CLIMB: ANIMALS VR."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24605101202453654"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2059205431362000"}, {"status": "PUBLISHED", "id": "1358068253022912"}, {"status": "PUBLISHED", "id": "1486468385800424"}, {"status": "PUBLISHED", "id": "3910830905875939"}, {"status": "PUBLISHED", "id": "769266345719405"}, {"status": "PUBLISHED", "id": "678078991980336"}]}, "baseline_offer": {"id": "678078991980336"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "2059205431362000"}]}, "liveChannel": {"nodes": [{"latest_support
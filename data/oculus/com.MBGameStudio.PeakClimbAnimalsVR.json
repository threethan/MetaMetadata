9C3"}, {"file_name": "Image4.png", "id": "736826996018470", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305027_736826999351803_1093154096377010491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVEkuqivaeQQ7kNvwEK12Nw&_nc_oc=Adrru7LqFy3wumseyFjnAN3is0f-R93k8IIDZlo5af1_BRwkVr4vJFvx-_wJKQ_PxmA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GiD7kHiCQcyuj9ZK6s_v0JstqX23rPpbOjVUm3Juqag&oe=6A12EEF8"}, {"file_name": "Image2.png", "id": "2468285953572730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824560_2468285956906063_7090864661479986172_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulrHFK8dQ70Q7kNvwGxpzrB&_nc_oc=AdpM85gYlN9dM6fVqXK3tqKl2dcpnhIsLuK3Eg3nQdpC_8MhV4hVCFRWF-QJ9i-7Gsc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FdUTzkZUHA1WNtOczaAmPUs6Wp3kawLA89f-p73xpjw&oe=6A130DF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PEAKS Climb: Animals VR", "keywords": ["peaks", "climb", "Climbing", "survival", "funny"], "long_description": "PEAKS CLIMB: ANIMALS VR is a heart-pounding mountain climbing adventure where the challenge is as real as the view. Step into the paws, claws, or hooves of a single animal climber and ascend the towering cliffs of Peak Mountain. Every handhold matters, every ledge tests your balance, and every choice brings you closer to the summit - or sends you tumbling down.\n\nDesigned for VR, this immersive experience lets you feel the strain of the climb and the thrill of reaching new heights. Master the terrain, embrace your animal instincts, and uncover the hidden strength it takes to conquer the peak of the mountain.\n\nAre you ready to climb very high? Hope you are not scared of heights! ", "short_description": "Embark on a thrilling VR climb up Peak Mountain, where you take on the role of a single animal adventurer scaling dizzying heights in PEAKS CLIMB: ANIMALS VR."}]}, "developer_name": "MB Game Studio", "developer_privacy_pol
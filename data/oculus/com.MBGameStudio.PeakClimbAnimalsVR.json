4kUwQ7kNvwE0mhMK&_nc_oc=AdoZ_TxoeKxP6_Zms_lZ4CjFT8XjHGn2x7yTpq8Lxi2hQsQE1ttnAxigKQGrX4adJdI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_58UrP_4f4Bnwv1xAWlejT6UbGHDDz5tICCBqvQxDig&oe=6AA417FC"}, {"file_name": "Image2.png", "id": "2468285953572730", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824560_2468285956906063_7090864661479986172_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5wNqeCqUucQ7kNvwHiapiO&_nc_oc=AdogtnoUKhko1ONtueR84FvxCMVwBlTNeLk3Y9aX9oc4VR0LHtbaqGYnS6QWv7lwU1I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSvwKqQR8ew4No0LMtEEc7RP87RA7St0HOkMy3fDuf6Q&oe=6AA412F3"}, {"file_name": "UnderWater1.png", "id": "2143747129725252", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820141_2143747133058585_9099135541247965171_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdSo5zjp9EIQ7kNvwEsmWEf&_nc_oc=AdoQxfZ5xBhTPWYYFCKYh8yZ7SygdXamuO8CG-I6CYw8CUZFuNESps-q6ecKZskAbdA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCEF7LzUYeUYzDzhpQp8d6DWZzPdTo10cSm-a0iiu8Mw&oe=6AA3FA51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PEAKS Climb: Animals VR", "keywords": ["peaks", "climb", "Climbing", "survival", "funny"], "long_description": "PEAKS CLIMB: ANIMALS VR is a heart-pounding mountain climbing adventure where the challenge is as real as the view. Step into the paws, claws, or hooves of a single animal climber and ascend the towering cliffs of Peak Mountain. Every handhold matters, every ledge tests your balance, and every choice brings you closer to the summit - or sends you tumbling down.\n\nDesigned for VR, this immersive experience lets you feel the strain of the climb and the thrill of reaching new heights. Master the terrain, embrace your animal instincts, and uncover the hidden strength it takes to conquer the peak of the mountain.\n\nAre you ready to climb very high? Hope you are not scared of heights! ", "short_description": "Embark on a thrilling VR climb up Peak Mountain, where you take on the role of a single animal adventurer scaling dizzying heights in PEAKS CLIMB: ANIMALS VR."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26146007085029717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823310_939249385711894_8281788564002573960_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2EvbwzxMiUQ7kNvwE3CC4C&_nc_oc=AdoS9Kr0vFgDBrcR99-bfx1SPcDchmKuqjsHNkaCUFWRm0nokr1oN2y1k35a26wpuQw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHxNHuTSWcelH84Ihr_MqPUgzasfrH1K0txBvtI8GMcA&oe=6AA420F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PEAKS Climb: Animals VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1757715900, "lastRevision": {"nodes": [{"id": "24605101235786984"
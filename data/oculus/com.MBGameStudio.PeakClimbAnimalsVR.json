GK_89EOsJA&oe=6AE2050E"}, {"file_name": "UnderWater2.png", "id": "1599809827724043", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_1599809831057376_4388324988139519039_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR1kR0ZshDIQ7kNvwG6hry1&_nc_oc=AdqAYCf0X2FU3E532TQpMog-wwKpfxy3rTEqmgCioIfNN7xQBKQUVvF-ikRaiXpKrxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYtKvma9TQ6K1hvYxGqtbxtXdskpcY-tOyVtPkwXc15w&oe=6AE20E7C"}, {"file_name": "Image2.png", "id": "2468285953572730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_2468285956906063_7090864661479986172_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZHeKCGSVgcQ7kNvwFXtdKm&_nc_oc=AdpSYvNC7aRLuPh6o5MKcs6V61HPMNQTj4BiEhMUdYXbve9iDm6CXQnwLc5-9WqNNxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLsx3m531U5E88DSXmTyP2uapP6-qlR8_bBYku8a4sKQ&oe=6AE20973"}, {"file_name": "UnderWater1.png", "id": "2143747129725252", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2143747133058585_9099135541247965171_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVtuKooYvroQ7kNvwHtA3YX&_nc_oc=Adpb70hMRKLPcA-EH4JDazTkJh5QToCHjwo2ByQKIErM61T3Zx6qYnQCIq-PXujP-d4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4GtbaczYtcV1kLdIkru537cEbTvKP9ph0r6ukqDx-YQ&oe=6AE1F0D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PEAKS Climb: Animals VR", "keywords": ["peaks", "climb", "Climbing", "survival", "funny"], "long_description": "PEAKS CLIMB: ANIMALS VR is a heart-pounding mountain climbing adventure where the challenge is as real as the view. Step into the paws, claws, or hooves of a single animal climber and ascend the towering cliffs of Peak Mountain. Every handhold matters, every ledge tests your balance, and every choice brings you closer to the summit - or sends you tumbling down.\n\nDesigned for VR, this immersive experience lets you feel the strain of the climb and the thrill of reaching new heights. Master the terrain, embrace your animal instincts, and uncover the hidden strength it takes to conquer the peak of the mountain.\n\nAre you ready to climb very high? Hope you are not scared of heights! ", "short_description": "Embark on a thrilling VR climb up Peak Mountain, where you take on the role of a single animal adventurer scaling dizzying heights in PEAKS CLIMB: ANIMALS VR."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26146007085029717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_939249385711894_8281788564002573960_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiV35sgThTkQ7kNvwFMASop&_nc_oc=AdpNSLmv-_CXRLPM8RYUnFIbyXZCNNTuO8WYWjIHGmL1PrIqqJqkO6UCH2wiB3oYOxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO52w6H8XwxGw3SaE_ya-PfFYnnwPBlDPXqee0tQkPBoA&oe=6AE21777"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PEAKS Climb: Animals VR", "platform": "ANDROID_6DOF", "context_category": {"context_category
3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVy2JkkGYaHioX2pO79tVp3Nw9uPOu1VKnLnxNeZgFKag&oe=6B0EEB2A"}, {"file_name": "screen_meta_05.png", "id": "696531469495527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830425_696531472828860_3712266024071866604_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQ1n6Wx3tbYQ7kNvwEzd0yd&_nc_oc=AdoI2LUTV_4xh9X4S7ovGjS_gKOnrzfBte8NAFGDIVFPNTgcRDZVHRrOWUNpNe8OcFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxb3peMK9Wa6HCBupylHRx183A4IQrerQH-JKFlnFjZQ&oe=6B0F1E48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RevoCure VR", "keywords": [], "long_description": "RevoCure represents a new standard in enhancing cognitive and motor skills. Choose from a variety of exercises to train your abilities, including concentration, reflexes, memory, sensory balance, and motor skills. It also allows for relaxation practices, and when used with a dedicated HRV sensor, it enables interactive breathing training. You can work independently or with a caregiver who, through an additional mobile app, can monitor your progress. By recording results, both you and the app user can track your progress. The product has been developed with top sports industry specialists who ensured the proper configuration of exercises. ", "short_description": "Discover the virtual world of cognitive, physical, and relaxation training\u2014and become the best version of yourself! Train independently from home, together with a coach, or remotely thanks to teletraining capabilities and integration with an external mobile app. Track your progress and analyze vital data using external accessories. RevoCure is a revolution in working on both mind and body!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b2bc9c9d-f568-4872-b89b-95bde47ed126", "developer_terms_of_service_url": null, "publisher_name": "Roman Kadler", "support_website_url": nu
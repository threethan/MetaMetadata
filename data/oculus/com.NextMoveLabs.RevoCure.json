bIwUqQWsBMq_FI3DE3iFKPnOpiS8R__e8Yg7f4PgH7H8sTH_my8eJG60Km8NAvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWmj6qreQR4vUYeELnIrBJnA0bkXbYwpH-B17LpEdylw&oe=6B0F1D62"}, {"file_name": "screen_meta_02.png", "id": "1774366610155124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831289_1774366613488457_2409357860970080766_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyT74bM_3RQQ7kNvwECkYb9&_nc_oc=Adr8ZX4n8VdIGrhDVVkleY1rZLgvAftBxUkAn0di5yEPQ6kXoQvr3jQYcoSR2hmsM7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSMAFn7ZaQJZeILFHaBBFY00Zph8WzApgKjxAkxyHp_g&oe=6B0F0FC7"}, {"file_name": "screen_meta_05.png", "id": "1026388790178005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1026388793511338_4274180803814672178_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7AatdU_uZIQ7kNvwGJf_V4&_nc_oc=Adr2eqk4IWheAB-Sbpxqneb1I4PrT2Uqo8unX-KCVtUXRLKjONKWOKy9VccjUPRJPxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoXp479jvktnK06f_DbNhYAVarbCFz9-kh8SKQnm2Rug&oe=6B0F0FEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RevoCure VR", "keywords": [], "long_description": "RevoCure represents a new standard in enhancing cognitive and motor skills. Choose from a variety of exercises to train your abilities, including concentration, reflexes, memory, sensory balance, and motor skills. It also allows for relaxation practices, and when used with a dedicated HRV sensor, it enables interactive breathing training. You can work independently or with a caregiver who, through an additional mobile app, can monitor your progress. By recording results, both you and the app user can track your progress. The product has been developed with top sports industry specialists who ensured the proper configuration of exercises. ", "short_description": "Discover the virtual world of cognitive, physical, and relaxation training\u2014and become the best version of yourself! Train independently from home, together with a coach, or remotely thanks to teletraining capabilities and integration with an external mobile app. Track your progress and analyze vital data using external accessories. RevoCure is a revolution in working on both mind and body!"}]}, "developer_name": "Next Move Labs", "developer_privacy_policy_url": "https://revocure.com/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Roman Kadler", "support_website_url": null, "website_url": "https://www.revocure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29404589762469632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_558691823971229_5773706339672339313_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE21pW-WpsgQ7kNvwE1Pq4I&_nc_oc=AdoRg7DvY94tFH-mntaGFWxJ28fBL3S5H8DLc4tidjI-14XRn-jFshwSwo8yQ5fuO8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRtcKLqFdeuPRF4uEtT7d_A3T_1nBIRt_ZsMT94zyUBg&oe=6B0EEB8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RevoCure VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442
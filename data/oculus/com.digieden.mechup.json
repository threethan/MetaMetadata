SAULCpg3xeMnw_0HuE9v9dxQBZmXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwnh7VDInrNVh8C_1keTxpQLj08fg9vpsMhlQZdyLErg&oe=6B0472BE"}, {"file_name": "3.png", "id": "1516967849738893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620817_1516967853072226_8375415462106339160_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-WGpyusqsoQ7kNvwHBkcqY&_nc_oc=AdrNTxGlJ6IvEIJoFVTjurnFIruoUkEm5qATWcAl_2H8lvGT-njrF1s5rGyH45ps-eQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYpt2EjfJrCC73N7MSbh_3hs5Wt2MbJXL9BZgYcKsUyg&oe=6B045656"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MechUp", "keywords": ["mech", "mecha", "robot", "multiplayer", "battle"], "long_description": "COLLECT & BUILD YOUR MECH\nCollect mech parts and create a unique mech of your own. Mix and match different components, customize your weapons, and upgrade your mech to take on greater challenges.\n\nPILOT YOUR MECH\nStep into the cockpit and experience what it feels like to control a giant mech in VR. Move, grab, and fight using your own hands as you become a true mech pilot.\n\nFUSE WITH FRIENDS\nTeam up with another player and fuse your mechs into one massive fusion mech. Work together, coordinate your movements, and unleash the power of two pilots controlling one powerful mech.\n\nBATTLE GIANT ENEMIES\nEquip powerful weapons and take on massive bosses in action-packed VR combat. Defeat enemies, collect mech parts and upgrade materials, and grow stronger with every battle.\n\nEXPLORE THE WORLD\nExplore a sci-fi world filled with secrets, resources, enemies, and powerful bosses. Team up with friends, discover new areas, and uncover the mysteries of the planet.\n\nJoin our Discord community for updates, events, and playtests: discord.gg/mechup\n", "short_description": "Become a mech pilot and step into the cockpit of a giant mech in VR. Control powerful mechs with your own hands, fight alongside friends, and experience the thrill of piloting a massive mech. Team up with another player and fuse your mechs into one massive mech. Collect mech parts, build your dream mech, customize your weapons, upgrade your gear, and battle gigantic bosses across a sci-fi world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digi-eden.com/page/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "DigiEden Studio", "support_website_url": null, "website_url": "https://digi-eden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1717061242672422"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1027442196988167"}]}, "baseline_offer": {"id": "1027442196988167"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792237620, "status": "PUBLISHED", "id": "1027442196988167"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1831194831259062", "version": "1.0.104"}, "id": "1471176978030796", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBina
-00jZZXzuJvhEniNK_4hrntnb9wL3VyC5qgO7QHi-kbUQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhDNPu5t7JFKKr-j0gMq57N7UwhR4JibuwxToJN1cPbQ&oe=6ADCBC7F"}, {"file_name": "0.png", "id": "1560371472222183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619668_1560371475555516_3413427298281459881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsyT5RkHYrcQ7kNvwEO_4Fe&_nc_oc=AdqGt_CUSF2Ds22kBMg7s8hUvFWg8o_FjpXRRKKp7KB2j-vwlH-ZPJRN1fsvpgdRYbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSDVrakxfq7IKOAcLn5bps5zEwbiSooZci6TfkibJPmg&oe=6ADCBA10"}, {"file_name": "4.png", "id": "1051920607585212", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1051920610918545_5216172318510073908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPXLiSY92O0Q7kNvwFsW0ON&_nc_oc=AdqgmLzc1_Daj38a53KMHwc2zflcrjDtiwnvA1YSVRaU12MAfp30MDIUu7BSiVDTfbw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmvzXjbSn4P7mORK5wpU-FCpy3w6R2swuIL3F3HEvVDg&oe=6ADCAD7E"}, {"file_name": "3.png", "id": "1516967849738893", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620817_1516967853072226_8375415462106339160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr82Nq7LnNgQ7kNvwHeaEEh&_nc_oc=AdrvfgDb-IXtKCuzwrJTG6_oTwhJOCxcVWQRI0kiaWhLZZGpPsxjjpfh_e8DU7-_pKQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuqSn5dRvxU_qyVzwlZl6JVai5sV8ZbzOe0rnXROJCGQ&oe=6ADCC956"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MechUp", "keywords": ["mech", "mecha", "robot", "multiplayer", "battle"], "long_description": "COLLECT & BUILD YOUR MECH\nCollect mech parts and create a unique mech of your own. Mix and match different components, customize your weapons, and upgrade your mech to take on greater challenges.\n\nPILOT YOUR MECH\nStep into the cockpit and experience what it feels like to control a giant mech in VR. Move, grab, and fight using your own hands as you become a true mech pilot.\n\nFUSE WITH FRIENDS\nTeam up with another player and fuse your mechs into one massive fusion mech. Work together, coordinate your movements, and unleash the power of two pilots controlling one powerful mech.\n\nBATTLE GIANT ENEMIES\nEquip powerful weapons and take on massive bosses in action-packed VR combat. Defeat enemies, collect mech parts and upgrade materials, and grow stronger with every battle.\n\nEXPLORE THE WORLD\nExplore a sci-fi world filled with secrets, resources, enemies, and powerful bosses. Team up with friends, discover new areas, and uncover the mysteries of the planet.\n\nJoin our Discord community for updates, events, and playtests: discord.gg/mechup\n", "short_description": "Become a mech pilot and step into the cockpit of a giant mech in VR. Control powerful mechs with your own hands, fight alongside friends, and experience the thrill of piloting a massive mech. Team up with another player and fuse your mechs into one massive mech. Collect mech parts, build your dream mech, customize your weapons, upgrade your gear, and battle gigantic bosses across a sci-fi world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digi-eden.com/page/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "DigiEden Studio", "support_website_url": null, "website_url": "https://digi-eden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
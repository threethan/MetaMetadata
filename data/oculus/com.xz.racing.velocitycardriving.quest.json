", "screenshots": [{"file_name": "5.png", "id": "815533893749319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982626_815533897082652_8474212108926040041_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvGYeVEoz7oQ7kNvwHlnw34&_nc_oc=AdmGxl0Cxp0_7PddhrHhnUMRn7LpQkS6Uld0BrfUZGyC7U5h3QjhEpKw-CsrhJvHRSs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCzbvcq3_M2axpqSak2HW0gFJBmbxvJ9xZF_An2VuoDQ&oe=69B56429"}, {"file_name": "4.png", "id": "386889304109503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570301_386889307442836_8020409381728465161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG8wsh_3eZoQ7kNvwG34Nce&_nc_oc=AdnJB9S-ZRXRWkEQgu3j9wxWxcI-URBBrQIbAezkqZsdH-dbKGCS0rGBCzDbHpO0QMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9gtVS7EgSgGJnGCctI1ZaVN7TL7YrMkzTpl3wdMUW0g&oe=69B53B28"}, {"file_name": "3.png", "id": "2211024162439008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974468_2211024165772341_3723666187956196288_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZMy3uonTgAQ7kNvwGXeohf&_nc_oc=AdmDH6TuUwLjFsb-P239bCQXMqvKpvEbVUXXhtNAA7BzKDjnfG32UJ7EXjMmIK96SSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLZxsCbv26lLCouFYpT5UoTIrR5DPyRFcLrgG08afvNA&oe=69B566AC"}, {"file_name": "6.png", "id": "434223259076021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_434223262409354_4338271883602423781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgJpcrhpNWYQ7kNvwGnE9yx&_nc_oc=AdkJNLOoHqKCPr1WIu35nGGPQ4E1XT5uH_mP7SsQRgUqjuW32AIEoSUC-Qe_8kBbfkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx08NGDUtVuOYOmEA5HbhEAw_d7vqGuam_20Fuey2bG4A&oe=69B55AE7"}, {"file_name": "1.png", "id": "959141248914407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_959141252247740_917842555609860014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnOb1XMFRsEQ7kNvwG6fRon&_nc_oc=AdlPFmZs7g5dZ7qYJyDA4ia2J2PzRqXmhidFOd8X_4zAfGIDYWxNh4GvTE1nEpFxSEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzakTXRuyWTUclDI3Bs8vpMfCsJthMKFGqW3NioM-wxQw&oe=69B55C0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Velocity Car Driving/Drift Simulator", "keywords": [], "long_description": "\ud83d\ude97 Velocity Car Driving Simulator - A Tranquil Driving Adventure!\n\nImmerse yourself in the art of driving with Velocity Car Driving Simulator. Unlike traditional racing games, our simulator focuses on delivering a serene and realistic driving experience that allows you to appreciate the beauty of the road.\n\n\ud83c\udf04 Key Features:\n\n\ud83d\udee3\ufe0f Dynamic Environments: Cruise through meticulously designed landscapes and cityscapes.\n\ud83d\ude97 Realistic Driving Physics: Experience lifelike driving physics for a true-to-life sensation.\n\ud83d\uddfa\ufe0f Open-World Exploration: Explore vast open worlds with endless driving possibilities.\n\ud83c\udf05 Day and Night Transitions: Witness the changing landscapes and city lights as you drive through different times of the day.\n\ud83d\udd79\ufe0f Intuitive Controls: Enjoy easy-to-use controls designed for a relaxing and immersive driving experience.\n\ud83d\ude99 Customization and Relaxation:\nVelocity Car Driving Simulator lets you customize your driving experience. Relax, unwind, and enjoy the therapeutic nature of our driving simulator.\n\n\ud83c\udf1f Download now and embark on a tranquil driving journey!\n\nEscape the hustle and bustle of racing and embrace the calm beauty of the road with Velocity Car Driving Simulator.", "short_description": "Explore, drive, and relax in Velocity Car Driving/Drift Simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xzsol.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XZ SOlutions", "support_website_url": null, "website_url": "https://xzsol.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": []
ore features are planned to be added to XR Manga in the future.", "short_description": "The provision of this app will cease on or around 22 December 2024.\nYou can continue to enjoy the DLed apps as long as the programmes that make up the apps run.\nHowever, re-downloads, version upgrades and support services will cease with the end of the provision of this application.\n--------------------------\nThe masterpiece \"Fist of the North Star\", "}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-manga.com/privacy/", "developer_terms_of_service_url": "https://xr-manga.com/terms/", "publisher_name": "MEDIA DO Co., Ltd.", "support_website_url": null, "website_url": "https://xr-manga.com/item/hokuto-no-ken/?utm_source=meta_quest", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9268729653249422"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348039_1241682393612848_1405788366257502503_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_qhAZo6ZswQ7kNvwHFfqWd&_nc_oc=AdrCV5aN9Ogs4P4hIjGD3xNphe1Atlf4JcuIZYLwwqki5GnBm-J_NbBvbxwpyMEPkyY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1DQzeLSreJxc1a2SAOOdMiXdwFtu9G_3NqsJSi_vsYQ&oe=6A81C73D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
HmqNF31tYQ7kNvwFxmHBa&_nc_oc=Adow5JjJzmmaCZFXEJb27yh1xEDEBBDotsud3znubvgVjUV2HIIdVt08XgW93U0XFxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2_WKuIy5l5_RVFRJq0z9Kr-26ByLs2I_M5uNnIRZj6g&oe=6A6B3900"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLTH7VWg-QEQ7kNvwGgTDle&_nc_oc=AdqUyaEHBDZqGk4BIyFaciZpVNaW477g3m-2BqY1ULaVYFYGJm9UhY9ln_xqwyiSkJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwTqv9JW0bCAV1S5p6fawCk9QiRlJUo0Bv41oKGz063Q&oe=6A6B633E"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRfFlHGOHZMQ7kNvwHgxRUL&_nc_oc=AdrbiDKr3RDwg7NWGjoBuiWVZu1ILP3Xft6l_r81YN9w1kHnR0JpKdTdVkEAvjwAVss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgw9j00daG_3Sko_mNRxpwxZgf1LU_Pl4-cvGN1GM73g&oe=6A6B47C2"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ_TZIJj5jEQ7kNvwFGdU_v&_nc_oc=AdqSXBvSU61ckaEXtCBFwSj8mmD7Bi4ya-j_FcarXj6A8LhPfKUlKryH_61D_e4wLYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaMMWmpbudn3vyGrW7ASSAIW_8dUa-9bnEIMPO3_F1zg&oe=6A6B448C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2s8UENrfwwQ7kNvwH6xyT-&_nc_oc=AdqCy5r60STtYWXyFam2KrTnFuTWqHIXEM6Vv8xtWZ0w7cqFQur16T2wK5qk
3RgGp07xEQ7kNvwGcqP8e&_nc_oc=Ado8IxfpKtUKWnNtRaneqvVEYSR-H-XUDwcQ6gIayvv0geyXUP6_YEePcIu25GmyR8w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zZjQFXNdASDAXj0-sUUUMmHIfMecBGaMCbTndjmZ2cw&oe=6A32C0C0"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCY9CgJhoV8Q7kNvwF3T5Hk&_nc_oc=AdqCBfRxwZrcZOZAvYM9t0HPsvkMxxePB6nPed37OYDXhZkPFisNrrrR_-45-yW6nVU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95xUnxyN0lfHm6XEBfGgIFgu5rLcXL4cb3cmPQtO_4uA&oe=6A32B2BE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhRDjb6nS8QQ7kNvwGp784E&_nc_oc=Ado6qr_x0X0mmN4xoUILtC9Y8h8ZrsJxnqxEklOw5sR0AkzAZLKHxKNv9trjdwtlGOA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8176GBwP0NaTUI3fW2ltecfOys0Bd8EhbjunCRb7lKuw&oe=6A329742"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It3zY_I6-Z0Q7kNvwGKAxE8&_nc_oc=AdpNpVPwmMnI_NKqpFpJK3DYI5hMd_BkMKBB-ad5HGn5TDmM8n1U0USUYPJhV3KIt8A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cCbptUX35z08bAiIVY2r3K5L-yvFJd3RVHNUOKYxL6g&oe=6A32940C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8aqxeREn60Q7kNvwGB_xNb&_nc_oc=Adoud-qNAtMpGjXjtZ2IP7X0fQWqILbWZcWvz96D5B5HQOSBs66PxvQuvp29
-1vDe5v58Q7kNvwFrPk62&_nc_oc=AdoYgF0ZjOXfyv-ur_k0y5NunWeiF72Dp-XVGeHYNdBMlp9VDeC46QfRHhcmDsMK28c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ALD9gdDftfD-rJLQzPpcmbMcp3irxpMAGXYqssdpHKA&oe=6A47D8C0"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcjS1WhAww0Q7kNvwEAHYz4&_nc_oc=AdoEU97omxXPaoxnSPshPub6mnh5tJ1uH9vDtZnT84nbHbaswg_9jbaLAlqaoas9i5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gzC19BPXnMSVJRHmh5Voir_vhmWbAfZDNN874d2pfgA&oe=6A47CABE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW4Al9E8WfsQ7kNvwF5kMyL&_nc_oc=Ado-u-7Qx6QblbW3o6cD6jqJ5gQxubmJXiK_6_NpRbgzeRUjZ8HumPm4OD1QtKmL1GQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--nfer8BVj1jBvs1FLB3m1OiICX3JXN7dM4rJewoHWgg&oe=6A47AF42"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLDz33sR6B4Q7kNvwGaMgPe&_nc_oc=AdqZ0IMOuKRvZsGM52GF0hUc8g8gma3JQc2H5FkxFK2F-tPuuB3BYmk8Oh8h8zXW6j0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4V1QZBm2vzePn7UVi9hrjlBduBOzGfGopFK-va5nzYA&oe=6A47AC0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAFm6P_CvO0Q7kNvwFu35Yf&_nc_oc=AdpY3aD2wlEzPLCcCAfv8imoR1HQe2FFIIdlvbvB4OEqlcI9-njqUcuNTajG
aBKBmpR4EQ7kNvwHyVCty&_nc_oc=AdpHQnvcxEjd1SvJPaHOw6veGwBfp_SaoitIl7MrUVKUmTjn7azVNDUJJBvwc26FVnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IdVXZwEUnVHnW8Lx7vH9jORhwnFogCRF7c_gNJRYkrw&oe=69DE2880"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTq35hXaEtYQ7kNvwE9z6o6&_nc_oc=Adp6azlo1xkbwl60rVlXfOuRMBdkE_e9FfS6CmI9Y35-MY4Awmiwe3U-9RbZ5afUaqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uUs7unc2CpC_xRssflMwNZJeDN6Vx1W9ej_CPgnfC9g&oe=69DE52BE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD50skvrqRoQ7kNvwFTPrFj&_nc_oc=AdrA8svQA5vLCNlwRA1XYcrUH59fq_nL86LEQ2wxdagI-ZRgmiLH9pQQQEz5R6UvXF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pyP4qDlwdXoi2jsIe5rPwaZp2YJTZUkO4-SbvV6DjsQ&oe=69DE3742"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUr0H8OzvF0Q7kNvwHHrau1&_nc_oc=Adow4CV_5Mmpv5Fb8HQunwNQIfoc0g_1mYrKk7P_UmsNmmBF9to64kaEo_pfDS-vweg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Iy0ZNsC0UDeljZxFXqo9i7ouMzfGv75aK4TT0iNSIvg&oe=69DE340C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tND6vHTQT4YQ7kNvwEOEmhH&_nc_oc=Adrk32RySxWN50jwfbcoAhiijfRi-CHaOLPJuHwufXW9B0IKWLVxiPM8dA9C
aBKBmpR4EQ7kNvwGzsYct&_nc_oc=AdqtCBzOzhGfEbv8Qq-GdHNzQwvE17zw0JsoatEOt7RNzAdBcC8phH3Uxrwe0Fn0AWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af323hZfHrbMQuRNGPbCQR3IWtzi8yUU-k7FWYZ64YmF7A&oe=69E0CB80"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF2A0IN2LR0Q7kNvwG9vcFC&_nc_oc=AdrTs7xse5Sf79pml3iShz3TheMeRFmXKxWbZSp0-uEOB-pqpYh61ynwwhnSGlzqEYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xajQt5nbdTQK_6_Wtk74bd77pl78v_yp2Oq9sG4Whig&oe=69E0F5BE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD50skvrqRoQ7kNvwEz7f5K&_nc_oc=AdpJHc8HiusDGC6ZCft0gnTowhD3DmgE0DM7K5ywcF2n-WodUMjEYoaBt_nWYIH7Kvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KZRU9J2aW5BN-nDFcn0E6NMNvnCLLV811HM_I0tUnOg&oe=69E0DA42"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkA709A3G7cQ7kNvwG2J1f5&_nc_oc=Adr1Ru3VkrYAn3Y7mR7Gtd52EEaV8ZLgocZDgmkcOR8jo12Dt0rsV19rRZxva46xK08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3spMc_gabdhAXg0jdoB7IJzSW3B-Bu9FmNwrRSzpk0pg&oe=69E0D70C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2_2T8TL9ykQ7kNvwGiZiv-&_nc_oc=Adqrq7tG_X7JZCek5pU7WQ1PDs_tIyVr7VYR74dJU8JFoQT7NGNXXF_-BIjg
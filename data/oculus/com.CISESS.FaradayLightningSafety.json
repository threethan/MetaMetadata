EJv6_AlvsQ7kNvwG5cjpF&_nc_oc=Adr_0cZ5VzKed9ufsQnHvV98-9VDxViKcwyaEkGqcey3wGkOc5O07WawLgJybzV_hBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RHmku52rDSGbyBLmOb4yiosY2SjgKY3DbfF6ZBg0u_g&oe=6A2AD7C0"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7AWZ2uadp4Q7kNvwHOrF2e&_nc_oc=Ado_ZXhA_o-gQ6_e28EvmZrsjSeNndUc9I25BKlBeTqjgi_DqpTBlxOdS2LR7PLizug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84YPpZUupdQwsQ6HCcR8DfJFfwezB0IP8qBeSLqArTww&oe=6A2AC9BE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqKjP2GIwXQQ7kNvwHxDQge&_nc_oc=AdoAsfsaHIwhz4BznJPz8ndVz2eBi7goe9V801k4e9NaL5dLgOsbv15WKeNR_EC41RU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QNqrvNjMsnmYPovsULSDWgZoIcw5NrEXKddq0IRNAnw&oe=6A2AAE42"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl2dxOI-bS4Q7kNvwER9J3O&_nc_oc=AdrgQ3D2olC0yDextAV-eFr7g_TmHZA2cTP-N6C1KYXC9tSOAcjKlXjiCw2xooz-xYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cUx9PRInbcxfkgU2uFzow_hl2xJyHg_e91S3aCEVRQA&oe=6A2AAB0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-19g8ntMkYQ7kNvwFnVXGz&_nc_oc=AdruG7bL45yY2fkNwZQQof6jDEuKmj3C54zFJGLlTiOnJ10y5St-6uGWRaeV
gIyxiZ9w8Q7kNvwEBWKbG&_nc_oc=AdrY0qeDyoPo5PaWjGXU0wMJ4b96ilcbz_a_U0Prdg99tpQc6PejED8W-U75s57wrkc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iXp36jQCmdpUmmdEZHldNb4F6EIiB5EGiWS2rIvcv4Q&oe=6A1079C0"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcLpZ8x3xd4Q7kNvwG3hPPM&_nc_oc=Adrkh2Pb8GA2TuTjw3wtp2tw_oB4HU4ZX9aIva13exSxFdt-OsJZf-LOZqsY_Zt2PO4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a6NxTfC8x341ogujWJgqL2Wzh2ztS6NhW4XL6TAE4qA&oe=6A106BBE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIcbUnObq6oQ7kNvwHPeW2J&_nc_oc=AdqfKQPB8vKfGY8gN1ptA3Eq0-anv5W7JIL1IPDecqlMF5nnI-P6YNhLyMc16pE8dQU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CQmGclhoVZvOCJ1P7YCrEDseBcHg2O3bSTF8umIg3wA&oe=6A105042"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqN8GGLm8_kQ7kNvwGCjT9b&_nc_oc=Adp2LsnU65pqcBMKMG6eBYgUUckTyT38LlWOncRrXESccj4P8xxuON5pJ3qzPTt0FZs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af420CB1uqk6aY3y_ae5E0WMSQzE5GtnktyURrbPLtx-Jw&oe=6A104D0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rxom3c-33NkQ7kNvwGwnKTq&_nc_oc=Adrd7HtFuE-x8ifIVDwje4ZzbHRPzvsFtItzYviltby6DQJFRIwX99H5OkCk
EX9QPaACwQ7kNvwG9qhrS&_nc_oc=AdocSAqqzVycDqNyIzJH2NlU0kJJoUvEipvcjSFT4Ftdzgf808cLyBNauU5f_EUFLW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e4yM96LCimkxM-si2f_n0oieTSUPqDPnByYh9l8uTqg&oe=69EB5780"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsnYBB1CHVUQ7kNvwFX0J6b&_nc_oc=AdociBlKCiukL9kXUGmJQgxaWWOzCgmGqfw4twf_mJM2KaaPAnGc1htTNzF3_-Sf14k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oOF606XgI5U6CuBIK6PSbWU09Fw0fI3zU-kMUBVZE0g&oe=69EB81BE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wbbx0ZKro3EQ7kNvwFKjBvx&_nc_oc=Adr3WHBiEhr63Ij5Wu1hS0-GHNu2asCC9kmGh9LL9D2kJHuQZaNFsaqcKSluBUUIEyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tYpGI7Lyov8S47zJbniIteU5uWjzehpodh8luF6Z3ew&oe=69EB6642"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GdIhxTCqyEQ7kNvwFtv9vs&_nc_oc=Ado-tdCbtkEN2zjrs0qaqfKKi2gACoUCaEw5-GDYl3-LM_EWG7BH5LUaTg_RVK68W0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fN8p2Rxo6btndr1pdL0Jw7c1d2bc0k_90OSSepN1TSw&oe=69EB630C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW4jjLnRyK0Q7kNvwEhULve&_nc_oc=AdoUrJMk70fXeQJR-4qUcnkMTXLUzjfpNMET9IbTEVAbOHjoNK6J8UgaPIAP
8_502583149519519_4228562402501640354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsksFz3ub9sQ7kNvwFJxofE&_nc_oc=Adqh4ml5eNSOB0HdcvaO1_HEILpN_HPlx3vTwnSh8csKs8YBGX_M2xcT4Z-zM3bSLJE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFJVU3k5BS3m8laWDIGwTf6SfYzXeotyarT-wfz9dwjQ&oe=6AAEA222"}, {"file_name": "Screenshot _1.png", "id": "2766583900180150", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473397701_2766583903513483_3498888133715114506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSAwvPrfl8IQ7kNvwFYWpkL&_nc_oc=AdoOpkSJiGgolVLMMUVrIfsuaVcCOf8Q-wgHxcegAkHepf91VqoV07yh9e7L1Y1my1k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJleDHy4szMNvb9xpIxiY5MTqaZxrnQxesTMEozMdjHdA&oe=6AAEADC0"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsoHBlLZljMQ7kNvwFujQMV&_nc_oc=AdoORLrhCWxLRt6San2l9tX9s80GsW9pLO2nkzCEhVU5f1LZo8QOKazRBCulcbisg80&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWTfTj4RIdc4DXnPlQCJGa1egSPVohJwZcOlxDWdj1oA&oe=6AAE9FBE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d19oJbEP19kQ7kNvwF-j_Vo&_nc_oc=Ado76f3wXIbw138CQTM35Wjb0Ks298ypHDEzN1PqculWkwwFmk4MLyQ_pwe5tZIpBQ0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZWlmsVTlbrYG92hJmXpGHel2gR_6acCIv_nM6Z8JjPQ&oe=6AAE8442"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EtMjZOemL8Q7kNvwFexRdb&_nc_oc=AdrNUQ1vXZUOmZ4h2ghvkWThuZ6nMtoNfRsD0oZZRdn5T2Wi1z4sMTcKz9JStCNxi6c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1xsNKEuS6Eeh99AyO9qp8opI1ST25x0HmMCW22vsFRQ&oe=6AAE810C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
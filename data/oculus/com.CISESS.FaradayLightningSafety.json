reXnxOIhgQ7kNvwGTf-hw&_nc_oc=AdpiGVeJC8HXXfI6vbV405bC-dn_M0Oc1e6kQ_GJ-RuG-QEuh4DB79SARaHhd0b3mrg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RST_hU440Gf359fOMYRzY9yMujrtVF10KiX3GpxMR0w&oe=6A26E340"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Uo7sy0nQ8YQ7kNvwF2xGHz&_nc_oc=Adp_Nz9QRupEc6v9MvlIMuyz9JsyMDFk0mvUSI1VHlfecfjKaWMg3UvWFu5qg754Wj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-pRHJXIx25AEtRh4vIrbmcqExif6CCt2afLvFzvN7DA&oe=6A26D53E"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Tr8UsNQlPIQ7kNvwF-Viu_&_nc_oc=Adr9eAEtTY3qBoWMGhgEMNC0eYpuucZbujp6ovozIjFlOk4HiuaSrb8erE-xrdpaXeE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1PtkWJRrGiEZYN41qs6xFk9FYZnrS5Pk-z5oqhUwQYQ&oe=6A26B9C2"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HoZCs0CLRMQ7kNvwEg4FM4&_nc_oc=AdozWrbQokdwfpMW6V4JgF7TTbv300e-FU08EMvk7_ypQ4wWRyABGYhuZoKVdvVd-o0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZlHYsiW4_GGG_zPXYhXg4-BkE7AnDNmNcqWGTIgeFlA&oe=6A26EECC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_pH5tBGTFcQ7kNvwFeHHCR&_nc_oc=AdqP11NfxekKmZHNuTVoH-yFYlEvfev8Tfd63TXJ_ZIkKD3NJao_dlsxT9Rg
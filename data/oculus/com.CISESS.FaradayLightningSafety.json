_Af2FY0ICGNp5FYarNVEq31JglkUCq28-1sS5rSeNOIBTAg&oe=69E4CEC2"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tYBOEcz1zgQ7kNvwEsSKTS&_nc_oc=AdrXhiPDol5JjdMp-QGIf26nqbt_zKG6XM1mKrRYftp2bD396U0UmCeUxdKxvM8wQI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09GoGXcWrY38iH5B5KSDgzG0lOwKbV1_5zfoB5p5DoFA&oe=69E4CB8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTAB
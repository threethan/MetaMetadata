gIyxiZ9w8Q7kNvwE3EMAQ&_nc_oc=Ado05VNnb3ve4kE5014K7UHRwuoHvR4AanKxTB2loQ5LCVhyrYpHThwhWO-aiMDalMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q32zzrNkliI0r7HrWGq6vKEn-G8uYT_X04NJmjkG2yQ&oe=6A0D9E80"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJpUvUhgTFMQ7kNvwEvnrUu&_nc_oc=AdrlJ6oobDHtv9UjEVjPEW_W-3XVc3VMiLCGzAM0acfMmmK-Pkq9gyobMAroIL7_WaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZcUfXc8PgMoFhzVwUpmAIQtQtNx5DSHN-2Ktq7-425A&oe=6A0DC8BE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIcbUnObq6oQ7kNvwFVvDd_&_nc_oc=Adq94GvLHgKKCX95sYBoJdk8trgTkCet-nfpviBkh_PUCJB1WttqCpJz3bRpv-2vGgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6igT3cxDop9ZBxY3EgjgpaTHl-B3qv3MtETwutM38H-A&oe=6A0DAD42"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTuU6H-l1rkQ7kNvwHBAkdB&_nc_oc=Adq2XWDQXaQD8g4q3AwR_AoN3vkIgn3sqhnH1acXuBQYM2VAMirPyoPaz_zoCqfClmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GjPlv2Ytw5N_1Y9jAJkg38ZgGE5ZHVXIDGufV-T2DLQ&oe=6A0DAA0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke3gWczn10IQ7kNvwEQ93wO&_nc_oc=Adp8eD0cLC7c7eEEPBaGl7Pko4tIfIRM4su8pOr4ygolYhoLA1Ds5vGVNi2s
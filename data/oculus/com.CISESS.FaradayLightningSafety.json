dvkDz3SJkQ7kNvwHpJB4B&_nc_oc=AdpPrk0jpy9TsNKCkeQSeBvrjM0J7coMl80YAHak6JlQ5o7hdmOW0KYQtdW_sbn6CNk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFpQObQX31Ptgj0W_wjhYKeBJUE8L2jLWBt900Ozcy-w&oe=69C7BF00"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7Dd0Crxs4gQ7kNvwEU7DnV&_nc_oc=AdrxxfLgE2Mv1Sa_PmIl4dcrKpgoy7OjjvQX0dcxsZff7ZdcQyU0EAEzVYX52r9LSBQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJmfwRYX5yg5cbIz_X9C8Gg2YM3GzFngtY3j21bbFR_w&oe=69C7B0FE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcPEYtEADmkQ7kNvwFB92m_&_nc_oc=Adr1B10aravKCuqr6QHQnrl5l1C9u2Z1ZAC7c9APmLw4-dEAYt600W8QNZZ3gj-027s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3cO29MUvS5EKAdg2Y6EKFhnxBw2v_DR73W_rfIFcqRw&oe=69C7CDC2"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJaizcJARzUQ7kNvwHmUQrL&_nc_oc=AdpeY67hSZiMG8KcMTRBWLoEnRSgDdFuzIVl-4DU09KNTLvLA685-San2Iq6vxL51ow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydIDDfGksBU3sJed_6y8LsMOkscq-iCZ-zt0-lob_urQ&oe=69C7CA8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRWMmSmP5ZoQ7kNvwFZkwES&_nc_oc=AdoQbp4re58s7Iw3HSYNbByuNZr4ufjUcYHuyYv3wbK8_-gNe2dJf3J5O8FQ
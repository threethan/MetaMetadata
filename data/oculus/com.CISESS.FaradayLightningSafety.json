0f_vXHJY8Q7kNvwFuH07y&_nc_oc=AdreRuFuf4ynt7_e00kN-OnjvcePeWHRPbVDMx-FFGFMpAsmxPhqI8yPoA4QF_7V7rA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZlsN5MfSdev-bB8W7MAd73Ndx3krJl5LGyqQnNuniBg&oe=6A341240"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCY9CgJhoV8Q7kNvwEDVue8&_nc_oc=Adr_S5IXHn9KcL7-Z1Mb36tV9MW3sTGvZDjKT4B4magaw5ePMOuJaWgibpmCae9l3ig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pGec8kStnipbiYIOBPiW4lnCdE9g-00Ed_4OXDFCrcg&oe=6A34043E"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhRDjb6nS8QQ7kNvwEFfzZs&_nc_oc=AdqAT14QzwJFadmtk8Zm62vEkl4a3yF11hqneW1mIKyAFNTlK9sqlrb-394l9z3188Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vKOL1BmivKLqRackjy2QRNKP-WB_Sq3Zp8TvD7O3GXQ&oe=6A33E8C2"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNazGs1VraUQ7kNvwHNE8nN&_nc_oc=AdqY_KDGlFi_ZrRED5kxWD_75fGSacdcqrGP-D12sPzGAfg_Azs9AWOqOp-Yde7NDKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qrVdRuvFIpgdUf3wYD7fVYGZNGI6F8R_cQ5hqNb1e8Q&oe=6A341DCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8aqxeREn60Q7kNvwEtbmIl&_nc_oc=Adpm-lSKIIp-GYDOBh5ExH_fIq9rAY8p-LPZ2VwZnmY6oEpSKRgFEQHqHRHG
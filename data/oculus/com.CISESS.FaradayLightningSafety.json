3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftS1xc6OTefYPjRWSrGGQh5bCdYqSBCMtO9N0tmQRNeZw&oe=699D8F00"}, {"file_name": "Screenshot _5.png", "id": "441340395599232", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392008_441340398932565_6827811955155713364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saS1osAGE70Q7kNvwGwLr1D&_nc_oc=AdmYInA15dAvHwd6TcYb2rIQrlUDYmrtoTRZumhMpjoWrLbQd38IQ0e-FLh_7Eh9Des&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvE01ETHPsJ2Vu8IutlhzcHF-wND4x0Q1Fl60NZawVQYw&oe=699D80FE"}, {"file_name": "Screenshot _4.png", "id": "1007576651209145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392317_1007576657875811_2210271833755947008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlCkJY1HidgQ7kNvwEmrPzn&_nc_oc=AdlpSmT8SmqVGuQnnziOY41teL7352p29WpsIEaCy67ooYYd7_NdjWjUEa_x3mwWl4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsEit2GHg_j66nwDLK0GkWRve6yTo2I7L1hhgPmhiZHuQ&oe=699D9DC2"}, {"file_name": "Screenshot _3.png", "id": "1065101658637869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392066_1065101661971202_8671880089624563394_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W46x_Eu2T2cQ7kNvwFKkLgC&_nc_oc=Adlwpt8dv2p07BeqqUtPgT3IHQ85zPa_FFDOBLEoCLpPz2aZoXjgZupCDI2iiyLm6oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWwrlwdrRXoGX4QyymzQFVfmsjPD9z-8C1VrpquYGOyA&oe=699D9A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faraday Lightning Safety", "keywords": ["geoscience", "education", "lightning", "faraday", "STEM"], "long_description": "Created by scientists and students at the Cooperative Institute for Satellite Earth System Studies (CISESS) at the University of Maryland: College Park, Faraday Lightning Safety is an educational game designed to teach audiences of all ages about the Faraday cage effect and its role in lightning safety. Players guide Spark the Owl through various hiding spots, learning which locations offer the best protection and which are the most dangerous during a thunderstorm. Engage, explore, and stay safe with this fun and informative game! \n\nThis study was supported by NOAA grant NA19NES4320002 (Cooperative Institute for Satellite Earth System Studies-CISESS) at the University of Maryland/ESSIC.\n", "short_description": "Explore how the Faraday cage effect keeps you safe during a thunderstorm! Join Spark the Owl on an exciting journey to test different shelters and uncover the safest and riskiest places to be when lightning strikes."}]}, "developer_name": "XR @ CISESS", "developer_privacy_policy_url": "https://sites.google.com/view/xr-cisess/faraday-lightning-safety-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XR @ CISESS", "support_website_url": null, "website_url": "https://sites.google.com/view/xr-cisess", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8916168035099284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392317_2112837822479267_3635824785730470265_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcH59vTc0F4Q7kNvwHo4klb&_nc_oc=AdlTaXAL-iS1TT8BExL8lJ2PtRF3761RZJVtwn5tjNQ9S8jFAnV-9mOnxkwUnMgfSls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4UCipRR8a04_6K1c3-YqFgSt9hcVV-DXND3BzxmV0rQ&oe=699D8AD6"}, "is_concept": false, "is_test": fa
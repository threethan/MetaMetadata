nail": null, "display_name": "Langur Run", "keywords": ["Run", "Horror", "Monkey"], "long_description": "Welcome to Langur run! Run around and explore the maps in game! Or check out the other game modes like Nextbots horror!\nLangur run is similar to Gorilla Tag, meaning you move with your hands. Make sure to check out the shop with multiple cosmetics you \ncan put on to style your Langur! Or, if you are basic, just change your colors.\nLangur Run is still brand new, so expect bugs. \n\nHave fun!", "short_description": "This is Langur Run, an experience similar to Gorilla Tag! Check out the brand-new shop! \nwith a whole bunch of cosmetics to put on and style your Langur, be careful don't spend all of your money!"}]}, "developer_name": "star.mp4", "developer_privacy_policy_url": "https://docs.google.com/document/d/1QurlQWMRUzCsKiDm8TAioVnUPAja2EDaUWmd-ZDEzKg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "star.mp4/Doritoz", "support_website_url": null, "website_url": "https://www.youtube.com/@LangurRun", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8619702564787381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001705_2470195483176943_3388188711557977575_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6uuic-w81QQ7kNvwH
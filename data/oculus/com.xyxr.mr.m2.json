Wa&_nc_oc=Adr1QdyNJZHurjy6nGXkQRWVSPXkwAz0ITWUA97wvmDjm2vZIh4XlSApfPILtlZWPks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9ksjUb2nFFwEphQ-mJWQrjed5A7LqbRq1UQLfkNpavA&oe=6AA17018"}, {"file_name": "\u6587\u4ef6\u5206\u4eab2.png", "id": "1658265588196407", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823271_1658265591529740_7354394518818376601_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x96ZRvbe_2QQ7kNvwGj1qfY&_nc_oc=AdpGR-jPXjkbJeaT37sHE17sN79-c5bWMz0EACfgSW-rvkT4nqoSp9fT2XloWlbphcI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKslW2Gg5Kf-BYyetI7zRF5AHmQiN2mf1JyAz_BQjdGbg&oe=6AA1778E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RELIGHTYEAR", "keywords": ["Tool", "communication"], "long_description": "\u25cf Cross-device file synchronization\nSupports uploading common format files (such as pictures, videos, PDF documents, etc.) from mobile devices, and the content will be automatically synchronized to the VR-side database. The system will automatically match appropriate display methods according to file types, such as document page turning or video playback.\n\u25cf Content display and interaction support\nThe VR side is compatible with multiple content formats, capable of displaying high-definition pictures, PDF files and playing videos, and supports virtual screen projection. Users can view materials in the space, which is suitable for demonstrations, content reviews or daily sharing.\n\u25cf Multi-person space collaboration function\nSupports more than 10 people to enter the same virtual space at the same time. Users participate in the form of virtual avatars, with voice communication, basic gesture indication and laser pointer functions provided.\n\u25cf Lightweight interactive experience\nBuilt-in casual interactive items can adjust the rhythm during use. The system will also add new interactive content from time to time to enhance diversity and user experience.", "short_description": "RELIGHTYEAR is a content sharing tool that connects mobile devices with VR equipment. Users can conveniently upload common files such as pictures, panoramic images, videos, and PDF documents on the mobile phone end, and the system will automatically synchronize them to the VR end for display. In the virtual space, users can participate in the form of virtual avatars, view materials together with remote partners, and conduct voice communication and basic collaboration."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xiaoyaoxr.cn/privacy.html", "developer_terms_of_service_url": "https://www.xiaoyaoxr.cn/Service.html", "publisher_name": "unity", "support_website_url": null, "website_url": "https://www.xiaoyaoxr.cn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9689541931149364"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1901983374050155"}]}, "baseline_offer": {"id": "1901983374050155"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757556900, "status": "PUBLISHED", "id": "1901983374050155"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9881142915322597", "version": "2.0.3"}, "id": "671262691908285", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
213757329_1731325673375742951_n.png", "id": "1151980689660887", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623124_1151980692994220_2647476217124037011_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJLp96S_2FoQ7kNvwH7jB8c&_nc_oc=Adm5gwhhSIc9-KzdykqJ8PmPnjNdU7BuJh_2325MHXe7kOT_ht80soyInACh8nLGkj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftN3My9OAoalGkTqRLGWZkzzvGd2-CFCSxc6BDhUnPXlw&oe=69985A1C"}, {"file_name": "499310840_817379770694039_529508138529059491_n.png", "id": "825720733137533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830620_825720736470866_1812893296656415182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v789mO3bKn8Q7kNvwF5hTqd&_nc_oc=Adl2G6KFBkogjusTiGZ8Pw-JMnrOVMa5qlJ3DgvwFLv5doDfRu38f8bkIQIcaSPY_lw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsTyZREV5SySI7jausSZ1yDzi6zQ8FKxTo4PotwkbqXcQ&oe=69985A1D"}, {"file_name": "499624592_785128817639363_7563222439993150732_n.png", "id": "25113425274919046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298290_25113425288252378_6424485001572371590_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqHBGJhhbREQ7kNvwHy8pLV&_nc_oc=Adl5Unt7tq-RIhg3wHHViaZI_X0SfBmhPoMpoYnfdksj2fqVsSJJro338zoQcpueWJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftoWDomfp567ZDs2uk7GjIfgBVfdj0iFOJb5WGlD0PEiA&oe=69985718"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nugget Projects", "keywords": ["Nugget", "Gorilla", "Project"], "long_description": "Nugget Projects is a fast-paced, physics-driven VR experience built on the foundation of gorilla locomotion. Swing, climb, and launch yourself through a wild variety of chaotic environments using only your arms \u2014 no buttons, no joysticks, just pure physical movement.\n\nSet in a quirky, experimental world where you're the test subject of unpredictable and often hilarious challenges, Nugget Projects combines skill-based traversal, obstacle courses, and multiplayer madness. Whether you're scaling walls, dodging traps, racing friends, or solving puzzles with creative movement, every session delivers a unique and energetic VR adventure.\n\nWith regular content updates, community-driven features, and an ever-expanding roster of challenges, Nugget Projects keeps you coming back for more \u2014 all powered by intuitive locomotion that makes you feel like you're really there.\n\nDo you have what it takes to become the ultimate Nugget?", "short_description": "Nugget Projects - Exploring the boundaries of GorillaLocomotion and expanding them further."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/f2e706f1-4737-4145-b653-326c7efecb0f", "developer_terms_of_service_url": null, "publisher_name": "AsteroidLord", "support_website_url": null, "website_url": "https://sites.google.com/view/nugget-projects/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24950308094580335"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314623_1508293513541643_6914837885938901019_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlYGAVfvZFYQ7kNvwH5IuFX&_nc_oc=AdnqGsd8UtW8ZJfzOw1dbzl_UWduMkorTrJkqVMwgJZ1oUl1T0rASIFBbAMBmYqI2TA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfszTkmW3ZtgRwf_EZUP6_D0mPquFPkADf11UEpr3
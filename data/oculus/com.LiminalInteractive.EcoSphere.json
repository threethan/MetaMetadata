238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_895315502898904_254951462354963553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhMYdCG_0-sQ7kNvwGMcl9x&_nc_oc=Adp0jI-OUZcZ7AA-PalAoiT4EwlbpgSDIvQfQikpAJLCuJ5atqPRZ3c-W4bdASKWGJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MP3faENblpVWjcDSUwI-IvwCQj7T-xpm71naHvreoAg&oe=6A37EC99"}, {"file_name": "Screenshot_2026_01_27_203818_V1.png", "id": "1915289452527795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_1915289459194461_7449632332768131162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE1ulXmNw-0Q7kNvwF50Rso&_nc_oc=AdpSk_YN0lYJZYZR2DMwZaCXBjJLmuhQNnbwVejuZJGso288DfFBIHp8EFbSo181vj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Baz87gmNfMrOaOizOXhJjpiallQsQQSrjuowA_5ALTg&oe=6A3815F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_1_V3.png", "id": "1950798478807203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300678_1950798482140536_7887888194729868798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPlNpFFvq90Q7kNvwGyrlh5&_nc_oc=AdruAwADaGo31RAMnvzz270ZAPBVnQqj-LCK7Cc1dUYi7qvmNLK42DM0lcAX9z29njg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9_59qqjBR1gTTnb4YVdTWSFWrpbV-h2L6g7KDN7zEZQ&oe=6A37E324"}, "display_name": "EchoSphere", "keywords": [], "long_description": "EchoSphere is an immersive experience focused on presence, interaction, and discovery.\n\nPlayers engage with an atmospheric environment designed to encourage curiosity and intentional movement rather than fast-paced action or direct combat. The experience emphasizes spatial awareness, rhythm, and interaction with systems that respond to player behavior.\n\nEchoSphere is designed for seated, standing, or room-scale play and does not require rapid physical movement. The experience currently does not contain competitive co-location multiplayer, but may in a future update.\n\nThe main application is intended as a self-contained VR experience and does not require an internet connection for core functionality.", "short_description": "An immersive, exploratory VR experience focused on presence, interaction, and discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalinteractive/home", "developer_terms_of_service_url": null, "publisher_name": "Liminal Interactive", "support_website_url": null, "website_url": "https://www.liminalityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27139724538949275"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1217488773849156_351498846160449232_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9xmyDRAi64Q7kNvwHp_O-O&_nc_oc=AdonB9IQfAbC3fL250AmTp11hllwJm1vU91Zh8PMfXGQNMvYymaLr0FjIL3nfrFhpt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ucLwBXjr4TjzUZSfdVFDMzbA2aoCn_VfuCT9rhC-uiQ&oe=6A37EA70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EchoSphere", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1770054540, "lastRevision": {"nodes": [{
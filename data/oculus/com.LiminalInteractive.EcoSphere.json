238", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_895315502898904_254951462354963553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duZFtKME7-UQ7kNvwEFN3Bo&_nc_oc=AdqZlGE5NOxsOT4IOwyyM3hHdrqyG2xDjlOFJ9Qv62jYWoFP9W6txG_uJUcqy2Rtt90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYuRLeqOajhpK2vXw-T5kO5dW1ucw391GRBFfXWZ3OAQ&oe=6A4A6199"}, {"file_name": "Screenshot_2026_01_27_203818_V1.png", "id": "1915289452527795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821674_1915289459194461_7449632332768131162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f6NjKZvzDoQ7kNvwGxGctd&_nc_oc=AdokLh2LWhQWxttu422MEjM_KlUhO9iV7t7TBM62H-uYFA19sZ92UaeWfpTpXye6QVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5tKw29lsaDdgkFIyqKIL9mrtkOaKLxozD-xxKFw29aQ&oe=6A4A52B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_1_V3.png", "id": "1950798478807203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300678_1950798482140536_7887888194729868798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxOzjqpkv10Q7kNvwHDAZAj&_nc_oc=AdqqLtkb6jns1eJN88b1odDGs6-J4e5FBdFz2rcQ8lz6XC0dMdhnBJSCZE7kX56ycyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxc1llgvJJcIOtfLjC1tfJjiBIWx88hryK-UwR68L9gA&oe=6A4A5824"}, "display_name": "EchoSphere", "keywords": [], "long_description": "EchoSphere is an immersive experience focused on presence, interaction, and discovery.\n\nPlayers engage with an atmospheric environment designed to encourage curiosity and intentional movement rather than fast-paced action or direct combat. The experience emphasizes spatial awareness, rhythm, and interaction with systems that respond to player behavior.\n\nEchoSphere is designed for seated, standing, or room-scale play and does not require rapid physical movement. The experience currently does not contain competitive co-location multiplayer, but may in a future update.\n\nThe main application is intended as a self-contained VR experience and does not require an internet connection for core functionality.", "short_description": "An immersive, exploratory VR experience focused on presence, interaction, and discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalinteractive/home", "developer_terms_of_service_url": null, "publisher_name": "Liminal Interactive", "support_website_url": null, "website_url": "https://www.liminalityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27139724538949275"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1217488773849156_351498846160449232_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUWpnVaXa2gQ7kNvwFW4B_w&_nc_oc=Adp7_MBVxuiIN9mRKUEWYbiSj8h11qUcyOODlmy-c0yKdV_EH-v9G4N8TPlMZW1rres&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQIGqpdXlE4KGHtvKJnB03nVLAKeFh8_5qguyfE1menQ&oe=6A4A5F70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EchoSphere", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1770054540, "lastRevision": {"nodes": [{
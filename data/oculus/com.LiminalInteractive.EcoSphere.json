238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_895315502898904_254951462354963553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpWyoA2zWPwQ7kNvwF9JBTJ&_nc_oc=AdoBit5ihiauY6yh_3rxITFYtGZVZfqJwx1cb9YQV4QQEWYs9hkgX6sqcjgEDrSO9Cc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qVTyqMOYiz8m7Br5a6Oi-3DdtX8S7SGZ-IOTdmFwCVA&oe=69E62F99"}, {"file_name": "Screenshot_2026_01_27_203818_V1.png", "id": "1915289452527795", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821674_1915289459194461_7449632332768131162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uF81VBJkN8Q7kNvwFoxnMs&_nc_oc=AdppD_K0Tqb_GIaZ5aXiCGIzJZyXfKJeupEuCvzpfMv3ZsY1m4LHm2z21wiqhCA6nRg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dk2UmtWlPx51saaD-64hz-MxTsB9lPKOAedEYFcTFIQ&oe=69E620B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_1_V3.png", "id": "1950798478807203", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300678_1950798482140536_7887888194729868798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ONhKh5Jxi4Q7kNvwFLWS5B&_nc_oc=Ado5uhdS4BxPfzd8gO8imajVk_N9h1CZck9GnON1Tdz3jbK_eMtEJsD63JNy9ypoRic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af399wZC5KSOI66QTerrO5d3Kcqa5T6lWyyq3FAT6xL7mA&oe=69E62624"}, "display_name": "EchoSphere", "keywords": [], "long_description": "EchoSphere is an immersive experience focused on presence, interaction, and discovery.\n\nPlayers engage with an atmospheric environment designed to encourage curiosity and intentional movement rather than fast-paced action or direct combat. The experience emphasizes spatial awareness, rhythm, and interaction with systems that respond to player behavior.\n\nEchoSphere is designed for seated, standing, or room-scale play and does not require rapid physical movement. The experience currently does not contain competitive co-location multiplayer, but may in a future update.\n\nThe main application is intended as a self-contained VR experience and does not require an internet connection for core functionality.", "short_description": "An immersive, exploratory VR experience focused on presence, interaction, and discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalinteractive/home", "developer_terms_of_service_url": null, "publisher_name": "Liminal Interactive", "support_website_url": null, "website_url": "https://www.liminalityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27139724538949275"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819356_1217488773849156_351498846160449232_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP3edgWovIEQ7kNvwGFJlya&_nc_oc=AdqWox33pBGRtXHtc-jA6W_G4S4uQxdbo68dg7Ri0lY_O3Bn295k1FdskEh_6jm-d8w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15XSGcb3QJjPqvNfo4WjSE19uf1nnR-fybAPHPS5olCA&oe=69E62D70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EchoSphere", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1770054540, "lastRevision": {"nodes": [{
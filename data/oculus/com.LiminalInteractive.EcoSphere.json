V50TOvAJMHcwD5lwp0NjdqGEoRM6TyIP-E_SA&oe=6A4FBD80"}, {"file_name": "Screenshot_2026_01_27_203645_V2.png", "id": "895315496232238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_895315502898904_254951462354963553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Az_rJCqwn1YQ7kNvwEaO3vf&_nc_oc=AdoOr7sy4Hh3Z8-e5FPWK-eBdanHZZp8LH1cziTVRE3cDZhGri0pBXHOxr_rANHg7JU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFcaaoH4_Wg3PWGDZ47vyU8pTg2TuXIKzF2UwMZ4BsNQ&oe=6A4FA799"}, {"file_name": "Screenshot_2026_01_27_203818_V1.png", "id": "1915289452527795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_1915289459194461_7449632332768131162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWIpC8NOWYkQ7kNvwHK_lQH&_nc_oc=AdpHbWEvGB4NL0F4pQZEa9-EcdkPLjhpWlkYLu9hQR6MzjNLwwbRD50vCZmr4LQ6DuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYK87epeNyqz3g85KCaMn8_SOkD5-eL-BRF3A4G7036w&oe=6A4F98B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_1_V3.png", "id": "1950798478807203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300678_1950798482140536_7887888194729868798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY4DFgwyxogQ7kNvwE-pWZ7&_nc_oc=AdpB4KGV0z226OrKFxeu5b-Kgio3ry7qv89MEnCB01LKNB54CBX4zJffT3KQpBrggWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwkKaavzlN7nEXi1gXzgE7Q0OvA24P29u626ELJByD2w&oe=6A4F9E24"}, "display_name": "EchoSphere", "keywords": [], "long_description": "EchoSphere is an immersive experience focused on presence, interaction, and discovery.\n\nPlayers engage with an atmospheric environment designed to encourage curiosity and intentional movement rather than fast-paced action or direct combat. The experience emphasizes spatial awareness, rhythm, and interaction with systems that respond to player behavior.\n\nEchoSphere is designed for seated, standing, or room-scale play and does not require rapid physical movement. The experience currently does not contain competitive co-location multiplayer, but may in a future update.\n\nThe main application is intended as a self-contained VR experience and does not require an internet connection for core functionality.", "short_description": "An immersive, exploratory VR experience focused on presence, interaction, and discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalinteractive/home", "developer_terms_of_service_url": null, "publisher_name": "Liminal Interactive", "support_website_url": null, "website_url": "https://www.liminalityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27139724538949275"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1217488773849156_351498846160449232_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Easre_6PWhQQ7kNvwGvWa0H&_nc_oc=AdrRquKPa4Ntf_5CN4hIdY9taBipw3LPHqtOX7RX8FBagxIlgngyIFtygZ03uygkr_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiRvvCOlq31HX8BidRyYRYfza5Vq78qeAYLIBQ39cIiQ&oe=6A4FA570"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EchoSphere", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
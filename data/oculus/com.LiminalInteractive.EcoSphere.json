-y5GJqrLTzsS24uafGK5MQcNS0cztMplGxzrw&oe=6A58F800"}, {"file_name": "Screenshot_2026_01_27_203645_V2.png", "id": "895315496232238", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820387_895315502898904_254951462354963553_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90rqLc1KL4EQ7kNvwH3ZH4G&_nc_oc=AdpRo0HLpcmZtdt6igvFTLw5WW9u8U3c_mkYl5ebl9r4ysdQq7jQJ7WMO2K41wzcPSY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzLRmWRYykqn8nBX18lQ_WXSLxTSojjnjRn0coZPxTqQ&oe=6A58E219"}, {"file_name": "Screenshot_2026_01_27_203818_V1.png", "id": "1915289452527795", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821674_1915289459194461_7449632332768131162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8APvzmJ1GisQ7kNvwG9d-sS&_nc_oc=AdpaO6K5aqudn90Wvts4eBuer2c5J-3I9hxNS_u12CnKKof8P8K9pc8FBLXnDsr4pLE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEQwl9q_TFFkqbBhz0wu5YICHNvc9U4MQXwUd2lCFwXQ&oe=6A58D330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_1_V3.png", "id": "1950798478807203", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300678_1950798482140536_7887888194729868798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6eIXD1R6uQQ7kNvwES-joa&_nc_oc=AdqL7xolvDanQ4txZ2yA9yogni169lWnaIPKykL2PQ9ING3rGWwCePqCuv3W3H7S5lw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0EEXwre6Fv5sgRsel8c2Aa5rpu-7EdbjZEGCLiohbJA&oe=6A58D8A4"}, "display_name": "EchoSphere", "keywords": [], "long_description": "EchoSphere is an immersive experience focused on presence, interaction, and discovery.\n\nPlayers engage with an atmospheric environment designed to encourage curiosity and intentional movement rather than fast-paced action or direct combat. The experience emphasizes spatial awareness, rhythm, and interaction with systems that respond to player behavior.\n\nEchoSphere is designed for seated, standing, or room-scale play and does not require rapid physical movement. The experience currently does not contain competitive co-location multiplayer, but may in a future update.\n\nThe main application is intended as a self-contained VR experience and does not require an internet connection for core functionality.", "short_description": "An immersive, exploratory VR experience focused on presence, interaction, and discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalinteractive/home", "developer_terms_of_service_url": null, "publisher_name": "Liminal Interactive", "support_website_url": null, "website_url": "https://www.liminalityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27139724538949275"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819356_1217488773849156_351498846160449232_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMCJpU3rFDEQ7kNvwHGV9kt&_nc_oc=Adqu4Hw4Nu0LIA25_gJhKszseEAcc4ol_7uLwFganZyOU-heab9rzoxxnMdriwIq1h8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5TPKMMt47J-1gbCBrT_W2fHV053YjtZBOvBpTH0RW1w&oe=6A58DFF0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EchoSphere", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
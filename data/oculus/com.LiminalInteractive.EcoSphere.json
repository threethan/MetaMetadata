dqq4w8fJvNF444SKCFan7HC6qew2y9vOoaQO-AMjftj7fH-u9Bq-0CItZecQj6RMow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J1PK24ObBJ0TTMukYtzJcoHpQYw1gYAWCBb_eNNNF1Q&oe=6A032724"}, "display_name": "EchoSphere", "keywords": [], "long_description": "EchoSphere is an immersive experience focused on presence, interaction, and discovery.\n\nPlayers engage with an atmospheric environment designed to encourage curiosity and intentional movement rather than fast-paced action or direct combat. The experience emphasizes spatial awareness, rhythm, and interaction with systems that respond to player behavior.\n\nEchoSphere is designed for seated, standing, or room-scale play and does not require rapid physical movement. The experience currently does not contain competitive co-location multiplayer, but may in a future update.\n\nThe main application is intended as a self-contained VR experience and does not require an internet connection for core functionality.", "short_description": "An immersive, exploratory VR experience focused on presence, interaction, and discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalinteractive/home", "developer_terms_of_service_url": null, "publisher_name": "Liminal Interactive", "support_website_url": null, "website_url": "https://www.liminalityinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
31675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CU7NdKAg7MQ7kNvwHaQJ5W&_nc_oc=AdpEU9TAetgXp091bW1ZYAyKndwwkerP096g62axd4-3G9Diq6FLfk9xaaPO8oTa1D0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMB1lk19iro9OcswculPb4a8vxnHFol6ZbOn48crkx8Q&oe=6A5A3AA6"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCmvtb8HU4UQ7kNvwGg31-8&_nc_oc=Adq2YgUtuy6t8PEPyHiIRKTSPb7pMCNi_mhIoDgmGGMmUTSdL3Cv8p9N5TM5jcWHXsg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG1G0b9eQEL0SSUHT3Ym3n0-9ILAbGS_4x8u1ZD2CTyg&oe=6A5A3852"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEO7_QBeAMgQ7kNvwHBcn88&_nc_oc=AdrYbPLLdHEUqPPHIbPcG7Q5C8FMJfdXeutArE0S6lAXMCfj4IS8I30oL7pCyT0JyLU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT_t8YDkADoWZBUGNpub2Z58sb3mvouKWUMz_Q_XELAQ&oe=6A5A1C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUcYMSvMyKYQ7kNvwGC0NlN&_nc_oc=Adp29m1eImDUTVuoLcS6sZfct-I5VyU2LiKffyniNMxsBlXJNELO1cvM2BTurg2nE4E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmA3eBXTkj5Jd_eXM1iRqUlZM41z2kE5cTdPM8-1lx6g&oe=6A5A398A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_292192226
47088231675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFzitOG_XmYQ7kNvwG9lqDV&_nc_oc=Adq5Oe7x3pMcyjiYFxRVEq4yEt6aNQjnYGtqis_dedTliy2UlYulXQ5G8eQf2xE2USw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XGGPq4T72ZGSW02aal29-Jx_6GlGlb-1VWTPyO0lprw&oe=6A467426"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFMcm8FvQx4Q7kNvwFLj3sT&_nc_oc=AdoJFehJOGwVa8eYG2zuQ1NZg-KmwWABeh_CbRiKItOZHc0DQy_bf9I0NC6JiEQM07Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YiW5UXCJQpAiLB9KxlxLbEuh7W_wvMGZdKiNKnPmL0Q&oe=6A4671D2"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv62lOQjWzIQ7kNvwGvQHFu&_nc_oc=AdqeuzCGjgf0u-eEJNomiHY5vqQrW__YRjqhYgmjB-abdL00I8kwGiU3hRaSW4_fyzo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dCQUKCZ7a1c8cQKMMq3lcQkDnahrcIBGd5nnzKAA23g&oe=6A468E06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGVhJv8tHoMQ7kNvwGcqRy0&_nc_oc=AdqXmrbeXrWB-RMebBGqUZKhhJH-OkFvcHfC93UKkXTocZmtJ2E5PTtLAbJGOL199eE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5p26Qiv-tNS07AAvaGkP48NzLJrD-cRfTnoiCMtEFew&oe=6A46730A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982488
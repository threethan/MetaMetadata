31675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGhxrH5TDs4Q7kNvwGGeqs0&_nc_oc=AdraQdThu_P3gvc7qRcgkOIh6s7ZtcNTWj4WrW7Pp8D82mbYrDmsqu_ovYejor2IYOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5dEQdkAxR8E_HLO9KmYmKQbkuBKPnnhm39P1exO87cg&oe=6A7F24A6"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWYJyipEmAsQ7kNvwEB_tew&_nc_oc=Adr0xixDRUZ-4n1Iv3zWzchZJ6lEXU-IbovcQq9h-rk_Y7tZxSpCSgDvx4KePD3_VRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx_V16EFJdgtnNJr9wHzSf2I4SQ7w9MAFr6S6VV9HGEw&oe=6A7F2252"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wODhpKE7HdcQ7kNvwFQFPwf&_nc_oc=AdpwJvtXM3GKHWp6nzodOBeaEtWf8bXsTY2_0S2vb15PoCDzSGl_XK9erd5AX7Eg03E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8z4nU9H1vSFMtRilaaQfnyRXEdDVycSodvmJTicFMdA&oe=6A7F0646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=810ZCzN4YO8Q7kNvwFyZ_pW&_nc_oc=AdoDF1GhQbCmePoN0p9NVUYM_k1VMd7JqHZVE5H-8_NGgdglfb0v6KmVy2BOHnWQRQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsOFLEwymZUI0VFSXOLdnR2T9ZpDX2mlGhR5erSW0Shg&oe=6A7F238A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982488_292192226
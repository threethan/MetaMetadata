31675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rYGKCemcEkQ7kNvwEsfiR3&_nc_oc=AdpSL5VK1hJKKf8m9I5u2ARUUhaIGIik6wZhsE2yrJ1C69gALIqOmC_Z3j7ZFHy_3Yo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk1cTw7g9a-fAgHvSBFjXHBKb_sMPLrBzVPBJwBAflwg&oe=6A53A326"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg8Du7SJkcUQ7kNvwHaZ2EC&_nc_oc=Adrb5C5CQFiibeymRAk1QSFnuo0XuImgcYkb3U48bepD6Seaf2SCrC4gBQIZBRaZOJo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnJ8W9XV2g56aXiMLPjhf2bj7zAruv4kTMmg5yyoX7AA&oe=6A53A0D2"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2zZDke7PscQ7kNvwH40vX1&_nc_oc=Adp_1c0i_jJPF6T5-6_nHXCwno6wR1nwWc3bQVUy-DM15bxJzP1hz-h50Vnn-TzUthg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAib_hpKySRKaRbcrWlWVqoM7xujHMumCFTtbYYT92jIw&oe=6A5384C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZFpZQ-oSVwQ7kNvwGqnP97&_nc_oc=AdpVxj0cI_fimpjsR82XYFsCq6Tx5drImsTQf2gkz47mFcuXc1SZcmbtBdMRiAhj3Sg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzjfHAIz7DD392f6tMYTuz4IUn6lNLsD3H1CGzeFocDA&oe=6A53A20A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_292192226
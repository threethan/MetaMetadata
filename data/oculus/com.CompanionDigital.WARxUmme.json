31675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBJeGCjawrMQ7kNvwF1FTFp&_nc_oc=AdqQ3bQSa472F-3DX0P-0XKJGw67WdcTcee8QWr2fcrP-Y2HGSCJLmEdEaDLe8lQH5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qDy7IfvJdkA09bk_K7c5GFU2F67OiZFsX7zoobg47hw&oe=6A412E26"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3BiDqP9IvkQ7kNvwED2PR4&_nc_oc=AdoGEjMU601Maeoswbz45qrcYQ7hne_jTullkneHPvA7clJDGGjo4N1bJkOYltkXKm4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-stwJBbiZ0O2F8dvBBx15JqnBOOflKL0_0tUvF6Q02yQ&oe=6A412BD2"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUiidIti0OMQ7kNvwFFOAHv&_nc_oc=AdojSpE-iu5NTGNhhMEZ6hshPNFZDP3Bn4rfXHZo6OJEoQr2rzbCwde0XgZwOdqtwEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bsEeLDvyr2OMYhC14V_r4I8QyurgZLb4KZXb-q9dL3A&oe=6A410FC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu1Xn3ziK_8Q7kNvwFtPAFg&_nc_oc=AdqP32KcG312JSCoY9EfwXCd6bxhJ6cFADEa_NVi7zFsN8SV3aG_LjmCvttxkSmGNxM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T3IwXEJOTsKYWJTIQzHgt1LkPfD0R5WyL6_IxzlH_mg&oe=6A412D0A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_292192226
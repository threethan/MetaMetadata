31675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmkWVt8EEbQQ7kNvwF_hFKN&_nc_oc=Ados8DKSnl23xh5neVafs_zoN4uAKsMkIn5GNhUZSVKCnrLMbfteoZ--Qoy7F74dC-g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKqyl5oqgs5kej6LcK0VEci6rZdUWh51t8FgjW_0O_3g&oe=6AD0E1A6"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRYzPww-U0AQ7kNvwFYRV38&_nc_oc=Adpqrt8gMJAbvzRgJk8YouAi665xF9Pm9ymQci7eIX5YCgX0I79qdBFoHCv-M2P5tM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBNIYKeZBP_xLSy0BaZiecsWJfbN2dEQt0iQUWzS8vGg&oe=6AD0DF52"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMNl8CEOY_QQ7kNvwEZnk12&_nc_oc=Adpq4sfgED5TX6VxuJOd1QMrd4LpYS9w6j_Ndt9fG-nr0137PuoeRhTwlZy3ZkfLl8k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmgHgF1oV3LfEf_zk_1a7lOJbj19_gUUtYbO5kujSndg&oe=6AD0FB86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJDTM-07-boQ7kNvwHq6QdT&_nc_oc=AdpU9MhAh1favOox8K1OMPjoHomu2W7lnr924iyzv31HuCnYC_6Hrq392RINxbLc_GU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSKSbHsK2WsxtMsSQbFopg2h6OA5pCPrPQ0-ANQAGzsA&oe=6AD0E08A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982488_292192226
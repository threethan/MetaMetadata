31675942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EujG7rr468Q7kNvwE2H6hS&_nc_oc=AdrkH5UqWDFZV6f8WxAD1SZ3PU4H8D4LHnxYIuHZDsJRpegfxu8pYCKC9qPiwzWpD14&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rv1cZ2jTtXG772ZWWN0A55fghzf5Scgh4jy7U3UgY3Q&oe=6A16FE26"}, {"file_name": "screen-05.png", "id": "421839640469052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982463_421839657135717_1074832849597683540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z26iArQtfQQ7kNvwGhYoAU&_nc_oc=AdoI7pbaHwJMEaTjb2GtOmDu5-B_ZV5-Im3PCU0Yvmqu1xCiHQ4yTfVDJDRl8wLY2h4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U_l3qrVcuQNfWLZbmeCK5xDQATIntZJU-HXFqYjN4hA&oe=6A16FBD2"}, {"file_name": "screen-01.png", "id": "1117622622777725", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K9vG4W4J6kQ7kNvwEbgGBz&_nc_oc=AdqymU3am27FlZsVt-9a1Riy5X_zUfmfVfJXqIO11mM8XYFjIC3u1rwbFxPCst83e5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M3QdmrrOhnqyLw4HigHWZxVPw9JBmhpxXnxDd6y6AKA&oe=6A16DFC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vRLmz83ZIYQ7kNvwHXlIeE&_nc_oc=AdqGC8moX1muHKjJR6FRL4qVKzKqWinkbgSzqLRrILa0H3b9TnUYrRf8mXTgj7ZE1io&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n4z-FjGwSB6EPPlz_u7hLPNrMiOCnd8vN3YouxnwJLg&oe=6A16FD0A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nThis app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_description": "\"MUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session"}]}, "developer_name": "Sebastian M\u00fchlhaus", "developer_privacy_policy_url": "https://www.companion.digital/privacy-policy", "developer_terms_of_service_url": "https://www.companion.digital/privacy-policy", "publisher_name": "companion.digital Inh. Sebastian M\u00fchlhaus", "support_website_url": "https://www.companion.digital/muxr-umme-war", "website_url": "https://www.companion.digital/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8238064289541325"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_292192226
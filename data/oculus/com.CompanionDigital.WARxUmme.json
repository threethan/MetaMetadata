5-1.oculuscdn.com/v/t64.5771-25/39001733_1117622626111058_3805883782844647266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zP1tjzOMO_8Q7kNvwG19Ecv&_nc_oc=AdlkuoAQqK5WUobyHvzDVkd4pFkGKuCbGcF7ljekScgaLX1NaBQTmX2S1qfWtjHlc58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuu4oyVec-W74pDNQvjVWnl2zeXlk0TpXKXmx__d3fdEA&oe=699AF2C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-01.png", "id": "1400905847283487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203621_1400905850616820_2665291355757939808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlPHrKXrj8QQ7kNvwGwDA2L&_nc_oc=AdkHQwhZcN6ygVS_OjNi74_BG8qDi3Z5Csk45PVZvHu8y6D5jwYVtEADt_7Ve3Xrrdg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbiJfO3ryDke0bQLnjQv6Bu-qtJIQDl9CO_yc7t6phfw&oe=699B100A"}, "display_name": "MUXR - Umme x WAR", "keywords": [], "long_description": "# MUXR - Umme x WAR\nMUXR - Umme x WAR\" is an interactive (social) XR music experience accompanying the recording of a live music session of the band WAR performing their song Samsa. This app was made to provide a meaningful audience experience for the original 360 degree live music video of WAR performing their song Samsa. All efforts where driven by friendship and our mutual passion for music and extended realities.\n\n# Project Website\nwww.companion.digital/muxr-umme-war\n\n# Usage\n\nThe app will start in passthrough to teach you the basic controls, which are:\n\nOne Handed:\n- [Any Button] Select (keep pressed for grab)\n\nTwo Handed - Spell:\n- Bring your hands close together\n- Press and hold [Any Button] on both controllers\n- Move your hands apart\n\nYou may want to watch the playthrough if you require further guidance. You can find all related material on the project website.\n\n# Local Multiplayer (Requires Windows Server App)\nThis app supports local multiplayer sessions via a custom server. For the related server app and setup instructions visit the project website.", "short_des
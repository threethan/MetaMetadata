3.oculuscdn.com/v/t64.5771-25/491831299_1471093030606894_2998370474169492078_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SfCrC5015wQ7kNvwEoho4j&_nc_oc=AdrlFyowXF4taUP9tL5b3RJIHy7dZMaVyCyHT0ftTqDreikoRQAnjedFqAmYbIu6k_g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-Bng4rI0rgJTUxkkRhMdkII9EFBBz6hXXDC9hzvqvsQ&oe=6AA14D07"}, {"file_name": "7.png", "id": "1290093476148235", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618270_1290093479481568_6335165851727418962_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE_K2aXgnjQQ7kNvwG9DnRM&_nc_oc=AdpY8ICdohIjY8HEuph8jOvePBMA7j6QNV5tOFOJ4Ju8-6Po1eao1F7dCnS7uuxXvyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHeqzUXuPN1UwKDfGMXp5wMsw11qCkqkziPG40MX-BAA&oe=6AA17264"}, {"file_name": "10.png", "id": "1480085223252418", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617991_1480085226585751_5914513819489219210_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybWlKc7BwV4Q7kNvwFJHA3F&_nc_oc=AdosIndAxJyGNOz31vIDNViUdWAhCKceaMS4u_Yoot6F40SRwmUZnC-GqKfXzf5POf0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA-zlCJypeejhVYx0KsEPzQqDUSzYSOq4ga746zJkHxA&oe=6AA170F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey_Banner_Main_2560x1440.png", "id": "1296020988320420", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820470_1296020991653753_488194597730201984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfNBZvTZ-t0Q7kNvwFcyAXp&_nc_oc=Adpwsw6iwyFSuodTG-ipyR2rCTMXPjxo3kHE9RaSKPxI8cHBL5SPv-_I6dt1OhPrrfM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzUox1p4ASlMw9ARNX5SFnYc1YqBHPs_SPDPz8OzBblw&oe=6AA1598B"}, "display_name": "I Am Monkey", "keywords": ["sandbox", "gorilla", "monkey", "simulator", "survival"], "long_description": "\ud83d\udc35 I Am Monkey is a VR experience set inside the cage of a zoo monkey. Visitors arrive with different personalities: some are gentle and generous, others are noisy, mocking, or aggressive. Each encounter changes the atmosphere of the cage, creating moments of comedy, chaos, and tension.\n\n\ud83d\ude49  Zoo space becomes an interactive playground. Bananas, cameras, and random objects can be grabbed, eaten, or thrown. The bars, the floor, and every gift from visitors are fully interactive, making each session unique and alive.\n\n\ud83d\udc12  With fully interactive objects, unpredictable visitor behavior, and a mix of humor and tension, I Am Monkey offers a sandbox experience that blends playful fun with thought-provoking encounters.\n\n**Gameplay features:**\n\n- **Be the Monkey** \u2013 fully immersive VR perspective of a zoo animal.\n- **Multiple play styles** \u2013 charm, ignore, resist\n- **Various visitors** \u2013 humans who can be cute, friendly, or aggressive.\n- **Sandbox interactivity** \u2013 throw bananas, grab visitors\u2019 objects or the visitors, manipulate your environment.\n\n\ud83d\udc12 **Play as a Monkey**\n\nIn I Am Monkey you live behind bars, but your world is full of choices. Visitors come and go \u2014 some gentle, some cruel \u2014 each one shaping the story of the little Monkey.\n{25456596400609650}\n\ud83c\udf4c **Physics based interactions**\n\nGrab bananas, snatch cameras, throw objects, swing on cage bars \u2014 the cell becomes a playground of interactions.\n{2074562389619832}\n\ud83e\udd8d  **Visitors Behaviour**\n\nVisitors behave differently: some try to be friend you, others mock, tease, or provoke. \n{3597759130358772}\n\n\n", "short_description": "\ud83d\udc35 A VR sandbox where a monkey lives in a zoo cage, grabbing bananas, stealing cameras, throwing objects, and facing visitors that can be kind, cruel, or unpredictable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https:
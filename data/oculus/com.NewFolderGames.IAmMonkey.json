c=F1rpi2fgYZsQ7kNvwEmcYSi&_nc_oc=AdpH72ZxeFNCMjpODe2j4vzuzGFBSUkxEwLS2EwSqQRf-3Jgk8_FGSta4D3oBWSmAkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SN-79-6wLNRcSLREMmZqEwNjNa5O9xMSi2ZvksXhi1g&oe=6A19BAC7"}, {"file_name": "7.png", "id": "1290093476148235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618270_1290093479481568_6335165851727418962_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG6ZLWSX0moQ7kNvwEp_61F&_nc_oc=AdojaYC9lxU3xQ9TD_IXzxRujmlKfB9LsG-DSiKf6xRcFVS625G2U3ejl1G5Ey_r4fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4beYd55QaDeIOUY3PHm_HGFo7z-M8wanWRaDk38-TJnA&oe=6A19A7E4"}, {"file_name": "10.png", "id": "1480085223252418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617991_1480085226585751_5914513819489219210_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWqDRaBMF3MQ7kNvwHlOqZT&_nc_oc=Adom7rSckSZ9YExbWqhtEcH-dL8c4-cOJHst02xtblQ1kLv_D3EF71uqpP7l-vejCXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wYG4pakjQ-gjfFo16bWdvcw1GETGhvG3AeCJRPju1-A&oe=6A19A671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey_Banner_Main_2560x1440.png", "id": "1296020988320420", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820470_1296020991653753_488194597730201984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRdG0-RVuc8Q7kNvwFtOY-f&_nc_oc=AdrPks9aSNAWMgEoZcPUZTxHnP0teCbWZ4lEtmP46c1Y-ueM-yHWQgkuHoi_yRuN4Ug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W_nQI0RObjc2EOTPQSz-epptZa7maoRPdq2Lmn4ccHw&oe=6A198F0B"}, "display_name": "I Am Monkey", "keywords": ["sandbox", "gorilla", "monkey", "simulator", "survival"], "long_description": "\ud83d\udc35 I Am Monkey is a VR experience set inside the cage of a zoo monkey. Visitors arrive with different personalities: some are gentle and generous, others are noisy, mocking, or aggressive. Each encounter changes the atmosphere of the cage, creating moments of comedy, chaos, and tension.\n\n\ud83d\ude49  Zoo space becomes an interactive playground. Bananas, cameras, and random objects can be grabbed, eaten, or thrown. The bars, the floor, and every gift from visitors are fully interactive, making each session unique and alive.\n\n\ud83d\udc12  With fully interactive objects, unpredictable visitor behavior, and a mix of humor and tension, I Am Monkey offers a sandbox experience that blends playful fun with thought-provoking encounters.\n\n**Gameplay features:**\n\n- **Be the Monkey** \u2013 fully immersive VR perspective of a zoo animal.\n- **Multiple play styles** \u2013 charm, ignore, resist\n- **Various visitors** \u2013 humans who can be cute, friendly, or aggressive.\n- **Sandbox interactivity** \u2013 throw bananas, grab visitors\u2019 objects or the visitors, manipulate your environment.\n\n\ud83d\udc12 **Play as a Monkey**\n\nIn I Am Monkey you live behind bars, but your world is full of choices. Visitors come and go \u2014 some gentle, some cruel \u2014 each one shaping the story of the little Monkey.\n{25456596400609650}\n\ud83c\udf4c **Physics based interactions**\n\nGrab bananas, snatch cameras, throw objects, swing on cage bars \u2014 the cell becomes a playground of interactions.\n{2074562389619832}\n\ud83e\udd8d  **Visitors Behaviour**\n\nVisitors behave differently: some try to be friend you, others mock, tease, or provoke. \n{3597759130358772}\n\n\n", "short_description": "\ud83d\udc35 A VR sandbox where a monkey lives in a zoo cage, grabbing bananas, stealing cameras, throwing objects, and facing visitors that can be kind, cruel, or unpredictable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categor
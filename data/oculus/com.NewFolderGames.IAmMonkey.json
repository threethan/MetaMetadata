dG78yNbfT4V02qpCJBWiJIhUaj7P6ztk5e7DhHaY5uNw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc4bPyyvYTSL-qXEQrmwconNpH8Mmw7mbNXwmKg9EDYQ&oe=6AF9DAEF"}, {"file_name": "2.png", "id": "1471093027273561", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831299_1471093030606894_2998370474169492078_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbqoVAEEQ6QQ7kNvwG9ePyD&_nc_oc=AdprLBam3rruErO3k8IXN4hBVWOX-pnp_L9f3jHFvqZZaKplHXMD0GHX9wSxy3xiX8w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKcIOdb_X04UOg521huqt-S8_Q1z5pRPJZ0U8yO4qCaA&oe=6AF9D9C7"}, {"file_name": "7.png", "id": "1290093476148235", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618270_1290093479481568_6335165851727418962_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCQxavuA1SkQ7kNvwGoubrV&_nc_oc=AdpoX7Kjyo4_QIXq_F5suL5931EP40m7qyMtI9dDdRHMzPXV56hHnU4vGXyt_VLAHr4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbwTasoZHGidLrW1495j8zHN7x7JSS5pDPi8Ojhyhung&oe=6AF9C6E4"}, {"file_name": "10.png", "id": "1480085223252418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617991_1480085226585751_5914513819489219210_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnORxdVu0R4Q7kNvwGEFQYt&_nc_oc=AdpaNfvrMkAS7_pbBIcW_PapdeNE-XibTnx0ZfQKNpp60GS-Z_P-CtWI0ZNvtPU-Wuc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkq0pmT82iEkLjYkzuqsPfYzZhzZ519YOAENwC5TGSmg&oe=6AF9C571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey_Banner_Main_2560x1440.png", "id": "1296020988320420", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820470_1296020991653753_488194597730201984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJonOTYPdJcQ7kNvwG8FSFh&_nc_oc=AdpBCmJ34R6jqIar9J6w5cb-fTg7zkNUVNW5kciMgJppY0JBGdoLTpifaKNXwdwCFx4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYlPFKBRBBGfOTNbqtkMFdxTZcHYUXD0dBzoFn01iYZw&oe=6AF9E64B"}, "display_name": "I Am Monkey", "keywords": ["sandbox", "gorilla", "monkey", "simulator", "survival"], "long_description": "\ud83d\udc35 I Am Monkey is a VR experience set inside the cage of a zoo monkey. Visitors arrive with different personalities: some are gentle and generous, others are noisy, mocking, or aggressive. Each encounter changes the atmosphere of the cage, creating moments of comedy, chaos, and tension.\n\n\ud83d\ude49  Zoo space becomes an interactive playground. Bananas, cameras, and random objects can be grabbed, eaten, or thrown. The bars, the floor, and every gift from visitors are fully interactive, making each session unique and alive.\n\n\ud83d\udc12  With fully interactive objects, unpredictable visitor behavior, and a mix of humor and tension, I Am Monkey offers a sandbox experience that blends playful fun with thought-provoking encounters.\n\n**Gameplay features:**\n\n- **Be the Monkey** \u2013 fully immersive VR perspective of a zoo animal.\n- **Multiple play styles** \u2013 charm, ignore, resist\n- **Various visitors** \u2013 humans who can be cute, friendly, or aggressive.\n- **Sandbox interactivity** \u2013 throw bananas, grab visitors\u2019 objects or the visitors, manipulate your environment.\n\n\ud83d\udc12 **Play as a Monkey**\n\nIn I Am Monkey you live behind bars, but your world is full of choices. Visitors come and go \u2014 some gentle, some cruel \u2014 each one shaping the story of the little Monkey.\n{25456596400609650}\n\ud83c\udf4c **Physics based interactions**\n\nGrab bananas, snatch cameras, throw objects, swing on cage bars \u2014 the cell becomes a playground of interactions.\n{2074562389619832}\n\ud83e\udd8d  **Visitors Behaviour**\n\nVisitors behave differently: some try to be friend you, others mock, tease, or provoke. \n{3597759130358772}\n\n\n", "short_description": "\ud83d\udc35 A VR sandbox where a monkey lives in a zoo cage, grabbing bananas, stealing cameras, throwing objects, and facing visitors that can be kind, cruel, or unpredictable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24848290161527221"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1641659653618927"}, {"status": "PUBLISHED", "id": "1339749218039282"}, {"status": "PUBLISHED", "id": "1666974207830368"}, {"status": "PUBLISHED", "id": "1477271706658351"}, {"status": "PUBLISHED", "id": "1536124220715896"}]}, "baseline_offer": {"id": "1536124220715896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1641659653618927"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26714804878209064", "version": "1.0.5"}, "id": "1981399925995440", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24775738222115749", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "267148
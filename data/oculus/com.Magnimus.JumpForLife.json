c_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OXx8-RqXhvCHL7STK4gdgkyec5L8V1BnHvuv4DH5RyA&oe=6A43CB05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump For Life", "keywords": ["arcade", "mr", "fitness", "retro", "action"], "long_description": "Jump for life is a first of its kind mixed reality arcade game that converts your floor into a lethal arcade jump machine! For the first time ever, a mixed reality arcade experience that sets your hands free. Your legs are your new controllers.\n\nThe player needs to reach all the numbers in the correct sequence before the time runs out. All the while avoiding the red zones of death. The zones of death keep coming in increasing complexities with each level. Set a high score and compete with players globally.\n\nJump for life is the ultimate test of your agility and presence of mind. \n\nTo play this game, you need to attach the quest-2 controllers on your feet. A separate attachment need to be bought for that. It is available on Amazon as Quest-2 trackpads.\n\nAmazon Link: https://www.amazon.com/Trackstraps-Meta-Quest-Controller-Compatible-Immersion/dp/B0CQ7KNXP2/", "short_description": "Jump for life is a first of its kind mixed reality arcade game that converts your floor into a lethal arcade jump machine! Use your legs for an action packed mixed reality challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magnimus.com/privacy-policy/vital-knights", "developer_terms_of_service_url": null, "publisher_name": "Magnimus ", "support_website_url": null, "website_url": "https://magnimus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommen
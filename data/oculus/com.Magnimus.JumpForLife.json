832945064431", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375769_1356832948397764_2959936533384511725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgXy1LBrCbIQ7kNvwFcSUyj&_nc_oc=AdpHBN7WK2RVnvuv4FPiL54qHeObNrxA_fvXCve2XPU8zz1NrQJ3Y27JvG7CnwOLu9o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IJXgvVjkIRuTVfgqMND7-CxrOQ52xQeSDVDTT0v-4ag&oe=6A11A41B"}, {"file_name": "GP_3.png", "id": "1181986666432322", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035394_1181986673098988_1472503440268034685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7L5C7L7lHAQ7kNvwH8szXg&_nc_oc=Adp0BV-OfMKBDPqeitTOBJyGvIy3QL9gvRfeqpfs1KEqcqBcLMS5F89SdoGVzT0uzgk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iINzqfQTvoNejVM5CUolHeETbmOGeRggCDj8G01S_Dg&oe=6A11C6D8"}, {"file_name": "GP_6.png", "id": "536221632419118", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974547_536221635752451_4853644413624356969_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhEPaxxbANUQ7kNvwH8-eHv&_nc_oc=AdphpXaAIjSkVYR4kb-d0b6XDNYuU2_jsI4ZiOZbsirmS5MyXV7mffjclencgvCH8Vc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tw4-4AFEL-jTGuCagxjmMQ-As-AthMezLQg8o7IY8pQ&oe=6A1199F3"}, {"file_name": "GP_4.png", "id": "544074484618501", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035344_544074487951834_6646070699915706266_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTkWDO-Sj8wQ7kNvwEerfs5&_nc_oc=AdoOWeD5B1nBsJb5K84l_aCwo6DLFMJkdiOKgKiPMJQ2nz7bF97p4O-UAkhonGFBKVI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BoB-jfwK4Fg5bHuF1PVx-YtLbW2w0iHQs9YbSJX-bVQ&oe=6A11A4BC"}, {"file_name": "GP_5.png", "id": "481067531585307", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974889_481067534918640_1631627096528002565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXOPd1wvHroQ7kNvwGRBdXX&_nc_oc=AdpYS5oIFBN5K3lhpWZ3Wq6uwV4iU7qgD965m4EA4bDXDrD5-87N55EvQlEmdgT5f-c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HHGGv7cDw4HVx7XHQVLyzTiFP06Vxd8f2XfrhpbiMoQ&oe=6A11B205"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump For Life", "keywords": ["arcade", "mr", "fitness", "retro", "action"], "long_description": "Jump for life is a first of its kind mixed reality arcade game that converts your floor into a lethal arcade jump machine! For the first time ever, a mixed reality arcade experience that sets your hands free. Your legs are your new controllers.\n\nThe player needs to reach all the numbers in the correct sequence before the time runs out. All the while avoiding the red zones of death. The zones of death keep coming in increasing complexities with each level. Set a high score and compete with players globally.\n\nJump for life is the ultimate test of your agility and presence of mind. \n\nTo play this game, you need to attach the quest-2 controllers on your feet. A separate attachment need to be bought for that. It is available on Amazon as Quest-2 trackpads.\n\nAmazon Link: https://www.amazon.com/Trackstraps-Meta-Quest-Controller-Compatible-Immersion/dp/B0CQ7KNXP2/", "short_description": "Jump for life is a first of its kind mixed reality arcade game that converts your floor into a lethal arcade jump machine! Use your legs for an action packed mixed reality challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magnimus.com/privacy-policy/vital-knights", "developer_terms_of_service_url": null, "publisher_name": "Magnimus ", "support_website_url": null, "website_url": "https://magnimus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT",
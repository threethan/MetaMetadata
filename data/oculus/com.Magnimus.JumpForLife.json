-25/75375769_1356832948397764_2959936533384511725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYjXj0AtlQ4Q7kNvwHs4WIn&_nc_oc=AdqsqbV6SVsImv3CWhH6jrsTqNTm7cK88tqySxDsohl0JROaxFLKP_TExiWCf4uFckw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0J-Fnq0Z2lqZi6cxIds75WfAJlgtffKZKPhqyOFm7lGg&oe=69F2001B"}, {"file_name": "GP_3.png", "id": "1181986666432322", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035394_1181986673098988_1472503440268034685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7iSTq9Xx34Q7kNvwGJHK3F&_nc_oc=Adr9k7nlzP0bWcfbp4Zk2YaMdWxD5tvzxmpyJftfPZ1dmjaAdzGNT7xJAnIeVuIaStA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3wznQ9DtnOvQbYaEF-L5cUBdrLQxewWETyg8o9LRZcXA&oe=69F1EA98"}, {"file_name": "GP_6.png", "id": "536221632419118", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974547_536221635752451_4853644413624356969_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUfjQmVnb1MQ7kNvwF-jkar&_nc_oc=AdqLJYn96UZRpEOZhVKbHvgjrHsYIXhz_MQGvWDgwDPuypy_i2pUxaE5KG6yB9U1Jio&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ClRAXM50TI1UcKuG72QuRe7Y7hyH_w2jvFyU1lr6VEA&oe=69F1F5F3"}, {"file_name": "GP_4.png", "id": "544074484618501", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035344_544074487951834_6646070699915706266_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4mUnSo6D08Q7kNvwFv1oO0&_nc_oc=Adq1YJjeX_GwSTxHkKv5P6uiFg8AZmIMJkgNTJ-jLcWUHxZFqvqT2x43OyUOARjyPZk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3F7xK167fP46PaBmJBp4jVIkiw6xdl6IpFUXHduKYWog&oe=69F200BC"}, {"file_name": "GP_5.png", "id": "481067531585307", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974889_481067534918640_1631627096528002565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwAEEwlC95kQ7kNvwFDLXrp&_nc_oc=AdoSjaEQ0Njv8htNxYZO9CXA8Ej0k3fAUhZWrrQxL-ZQpnvt1mPC29zsxcHjBAxlnC4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19JiKni3tG1sqgQs1WCHv_TqHQjIig1t0K3JfGUuByhw&oe=69F20E05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jump For Life", "keywords": ["arcade", "mr", "fitness", "retro", "action"], "long_description": "Jump for life is a first of its kind mixed reality arcade game that converts your floor into a lethal arcade jump machine! For the first time ever, a mixed reality arcade experience that sets your hands free. Your legs are your new controllers.\n\nThe player needs to reach all the numbers in the correct sequence before the time runs out. All the while avoiding the red zones of death. The zones of death keep coming in increasing complexities with each level. Set a high score and compete with players globally.\n\nJump for life is the ultimate test of your agility and presence of mind. \n\nTo play this game, you need to attach the quest-2 controllers on your feet. A separate attachment need to be bought for that. It is available on Amazon as Quest-2 trackpads.\n\nAmazon Link: https://www.amazon.com/Trackstraps-Meta-Quest-Controller-Compatible-Immersion/dp/B0CQ7KNXP2/", "short_description": "Jump for life is a first of its kind mixed reality arcade game that converts your floor into a lethal arcade jump machine! Use your legs for an action packed mixed reality challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magnimus.com/privacy-policy/vital-knights", "developer_terms_of_service_url": null, "publisher_name": "Magnimus ", "support_website_url": null, "website_url": "https://magnimus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
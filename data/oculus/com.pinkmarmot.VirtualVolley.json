{"data": {"node": {"__typename": "Application", "id": "3910010955788003", "organization": {"id": "514462403203330", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "4486563551434692"}]}, "id": "295311585777083"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3910010955788003"}]}, "id": "886090098646518"}]}}, "firstRevision": {"nodes": [{"application": {"id": "3910010955788003", "release_date": 1627928575, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24229983703364096"}, "id": "1457488524585046"}]}}, "binary": null, "live_binary": null, "created_date": 1726579801, "id": "8035330193256038", "is_initial_release": false, "name_with_fallback": "v11", "pdp_metadata_with_fallback": {"version": 11, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "8106559496133107"}, "release_status": "RELEASED", "id": "3910010955788003"}, "id": "8106559496133107", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3910010955788003", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1259746821094145"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "PostOculusStore_Volleggball.png", "id": "1682716595888004", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035315_1682716599221337_7075827842099927230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ghbPVKYC_kQ7kNvwHbVbiq&_nc_oc=
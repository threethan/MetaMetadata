1A-gU8x5MKOmLa9kRXmagxfcDZXwDffB9FU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcBdb4kT9wkp7enpasuAmPXTc03BoVjcUXTpmh65D6jQ&oe=6B00819A"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok_TXpPNFEkQ7kNvwH4SWM-&_nc_oc=AdqVqzyzMWgZqiyHMjLoVfdw2eaRXucFBuOipKHcR1JJnOVx6q3wEx6Q49wcbelqISk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS3FigQDl9DFEJ7-jU7hbDE67mQLAK2Pfh0XfYJdWRcg&oe=6B005C7E"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeyuFor9f2wQ7kNvwEKd--i&_nc_oc=AdpaxwMqDJkpIqxe6jAbD5hkFv29SwtHcFqeeI0OPi1WTkdj8-gSilP9AKCllXvqmFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROl9TjU78RgGNikkuM-iRLEsud9FUmjJjs7JEMWJYC0Q&oe=6B008056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQYRhg1TDmcQ7kNvwHUgkFQ&_nc_oc=Adre4IZDKmHX8Eo3rxLSJdhLNrAygEIjlVNy-A4RTIxH8Jav7gBD4ANVOBjuTPR3mRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRs6woiXzMB67XrjIr3HoFU7er0BAYJ71-9fN0EI6B_Q&oe=6B00559E"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://www.outsidethelinesvr.com/privacy.html", "developer_terms_of_service_url": null,
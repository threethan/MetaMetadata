g", "id": "912341601271324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljfypp7iWH0Q7kNvwES0U9N&_nc_oc=AdoMJfmjIe72zdsVQG5swv_feETxgGvUgO6iHWw3IYjMjV63U48uPJ3z41mY6ro0Ze8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82lrpcdHSN5eMl9mKmokuSE8-eSlPv6tM9l1jvAVSsxA&oe=6A2D7CEE"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2zJHoSL0GsQ7kNvwEY-ba4&_nc_oc=Adot9JZTli2-jX69UlkfgDTIWMkxMAXgmKG4vk6hRMMNlORwYtVOWHl37NuKJDqRFrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AcO06A82A73_D6Vy9b6yfZjjuzYlk2Xm2q99rTRnhJw&oe=6A2D5692"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg8c24scGSIQ7kNvwHcBOnl&_nc_oc=Adouwu0Bx17fdU6XiJugl-gwx6H8JMZXO6NPz1sAm0S0O4T_8ix3cXbHzaLhORdXqJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o8tG2g-Ahu-Le3-3wtTmqlPwL3n5lJlO3JbBaWvtepA&oe=6A2D6EA6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tib4vL2JlswQ7kNvwGoUdq9&_nc_oc=AdpG0H9LI6vKJbtjoDmJL9TdV82XufgY6fo_6EFOPwoaVoxIvfbuITH1ESXfQ7L-9pI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NnO8fYmg30m3NPLPn42SW6094kaqg06ViPK8f6ZsjCA&oe=6A2D6836"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPOdpCNi9oYQ7kNvwFU0Rsz&_nc_oc=Adpcmm-mCUFHZ2WLweY0gY8dJIc6KpHX-uIiJJ6qs_HA9-a3D4Wn1zF68hebJhpZCpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MHg2c8hT5JV53YDiGk4EmXF0FXKExuZxXsH1mChu7Xg&oe=6A2D6FC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeGofb3QsT4Q7kNvwF8YcWc&_nc_oc=Adox4d574wfEjHt1xKYvO9lxNTtGqYvxVM6z-BoQ5lCMxlANVqtTqb3buP_dWwViTSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90H_q9lD5mocHA3RIwQV9nPYf9WB_2puCnvweEzxivuQ&oe=6A2D7339"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "2127446141409325"}, {"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}]}, "baseline_offer": {"id": "962957456171722"}, "is_approved": true, "firstOffer": {"nodes":
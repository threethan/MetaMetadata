aSrSnTs4JXFdJvbq8aI9n_I-pGNWNW0HrGRiuZ5ZqjyDsr45VkL94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZXE0CMqwUrm1LCR0N8an1VsbxjMPNBgj4H-5CEFwUJw&oe=6AFDDBD2"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgCI6KbR3p4Q7kNvwGbPNn-&_nc_oc=Adr_fa-YeLbqVzU8QXnBP2bE_mhKHfKkFSapaVbSGpRC_HkOs7diahbgA7UtKlN9nnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgS3r57_R_8_VmKJRmRRQO-_siwy5fWCTKlKN28nyEwg&oe=6AFDBBA6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhLsnB21Z-oQ7kNvwF7gF4H&_nc_oc=Adr8WSY1vvyjMcbEE5gpqMmhWA7CjNMCKmJ7IQGe2K6nqj5NjVplLJ65CdRJc8yL3nM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH3QZsvKYMYUJZ-jH4WuHcMawNgyonLFRTMIz8ePs1WQ&oe=6AFDB536"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmgOgezxKqEQ7kNvwGS61RV&_nc_oc=AdpSX1EE6aPqUbhN_Zwzp_l6fSEmo2NzMjCXQLgfvPz2T5ZITX1heSUv4uz73OJEzuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB4GkXlvigbH8qOZEIGD8zkoKgbq5sk2YWr7J1Uj-U6w&oe=6AFDBCC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obtId84kcggQ7kNvwEX38hH&_nc_oc=AdrORPETqMOA4NREELAXwWrbHUOkZuoeqhwDf30XRtfvDLQfhbIBZ9i2iOEOo8yFS_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjaYnAXacrCwTIYZd_ykjppefgy16eiO0IjpQ3zkxsMQ&oe=6AFDC039"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
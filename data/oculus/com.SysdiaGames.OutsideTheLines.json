_AQR62m_BqttTCbPt3Xqe2ND-L72kpcIxG9f6PcC_kC1xAA&oe=6AF475A5"}, {"file_name": "CoverSquare.png", "id": "827458779784416", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_827458786451082_5694307483525517215_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW2bNzdPk4oQ7kNvwEWpoav&_nc_oc=AdoGMLjr6Eb3mXxx4LqhF9nzwh6j413yKFdwvAPws7JYuSfETpbeByrcWFDrz7wu8Io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg5899y8MZtCztEBDPKH08pO4FtHAJFqm_r3JsMDrovQ&oe=6AF48B22"}]}, "id": "1521262213367593", "locale": "en_US", "screenshots": [{"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34Sp2X6x7qYQ7kNvwEuDl7b&_nc_oc=AdrCGRrWriNtnea3ibdAmhuQFOdIJpuk47Lb6DaUIsWG9MSGX3LAYDYuqwUeErPgVOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR32ODhoegxo7uF8_lPuOLdmiRTx5JFcQwZSILPze8SVw&oe=6AF48126"}, {"file_name": "easel_angled.png", "id": "903830355768155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_903830359101488_5804598342544490810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3WsmucbKeQQ7kNvwG64QZ_&_nc_oc=AdrCVuixj2-4-N7Rh7aqwdjtgY687TBQxi26eFniogUO85l0bZXR74E6jsB2O5CZgsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZZ5qNoePjxPnaRqiDBfcvuoB9ZkN_3YuRlM51cCdRHw&oe=6AF473BE"}, {"file_name": "pen_types_alien.png", "id": "2303716183437103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_2303716186770436_8912560277330926798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLCj4l6BxpcQ7kNvwEgaI5X&_nc_oc=AdoY-6nsqQXSBizvmbu3-qn-J2-1BBfaPUrUU4vCSe9_mv2IdBCoDa2-NuLJsi2O8Dc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT87fQIQDvhIkQjma37eCJLWICf7YKG082OE9GXL1VJCA&oe=6AF4A41A"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7Su6VZJ-34Q7kNvwHDWWb1&_nc_oc=Adob06bQ-9plyi6cjq9w9MyLLP3NtKd6Be7tCEgv6tlR65UgUzv5uj_aXdTXhYowdCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7TUnxnetf9Yipvo98_3EWhUeXvbKCXcW2d16pan7_xg&oe=6AF47EFE"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DnZ3hiqdbQQ7kNvwHxwxsz&_nc_oc=AdpEtnrB4_blwSa2GS4BrjtqbHF7ENUXiO5DI3SFUy_vB-LAnqr4RtIindJAKi9J__M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDB_k1cwsO2J5zB-nc3Z_niRknxA1B5J5uelyzaqSIAg&oe=6AF4A2D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJYrmsIrg6kQ7kNvwF440Wy&_nc_oc=AdpeVpg51rqUXBSZpe4IhzsjuShTmKnGAlpRqFdYM-f1FudZUL-y_JG5PPlDZoHovBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK7uUhDuEfzatxJTyTaLAEg7FgtqntMtN2tZr4O1BsIA&oe=6AF4781E"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://www.outsidethelinesvr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": "https://discord.gg/dGaVFEZH", "website_url": "https://www.outsidethelinesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
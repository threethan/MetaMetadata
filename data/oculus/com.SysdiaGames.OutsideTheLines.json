dBU_bwcE-ai9kDN6FiOoI4AUbKTUaMHr_yeg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyeyDmvVymSx5GXxFIl4W6rCSx4bSLYrfL3ZaI-D7Y6w&oe=6AFB3B9A"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvZN25F1vcAQ7kNvwEV6_bG&_nc_oc=AdrS-x1fRTmVOZ-9PXKrOWadSz98LcCBGfzfs9QSfhHbwcHT3cygvf5mS35nh7g4L7s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFt-ynvGCJwPgLkRAl78GHzMpEKQzchddLqxJ3rY29xg&oe=6AFB167E"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jpsu9TFg-YQ7kNvwEz3E0h&_nc_oc=AdpzA9ivHqQ0mmT9R4CSINe4-VvGJsyH8iN1zChkQCdHD2W3WeyUwSwoq98-BqFNJkg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXTU8v75IrHHMPNQuqBcAdvCKb6o4XynFUTAdoIke_sQ&oe=6AFB3A56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eaz-A8SWwgQ7kNvwEwudTH&_nc_oc=Adr8bXWcVfyY6yN4XL0ADM829vJZ2jENZf66B1IaGxoKcp7t3tuM8kO7gSk99Cfr8lY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThlnpYx0oEyZUVfm5zfJOjeYNE-KGDyJvCp0Pm-ptlkQ&oe=6AFB47DE"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://www.outsidethelinesvr.com/privacy.html", "developer_terms_of_service_url": null,
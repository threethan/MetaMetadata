_AQPU8uBu4Q0GeXVm4glvG9Tp7Pq9sO5Lc2VeHZYOPNAuMw&oe=6AE4A3A5"}, {"file_name": "CoverSquare.png", "id": "827458779784416", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_827458786451082_5694307483525517215_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hG4vjvA55cQ7kNvwF8bd-D&_nc_oc=AdrTg_9bRAyFN-pMQPMs-Z3uUFLQuwJ4BHGDjK_6BA0WyVvg7Mw5ykvIN8rZPSmVmzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd3G9yypmAje7-YKk9qUh9Adqru3QKz5ICnGD94uBF0Q&oe=6AE4B922"}]}, "id": "1521262213367593", "locale": "en_US", "screenshots": [{"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA_FADchHGQQ7kNvwGU8kj4&_nc_oc=AdoUDugXIMGUAIeNswxRLyoKK8RKZmok09oft9lK4TobdeUCr_LntcRS2-yahyyUdCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgouxUnYZ9MA8Pt41oSU049Iaf1F4L6AwFJI_iPfAm4Q&oe=6AE4AF26"}, {"file_name": "easel_angled.png", "id": "903830355768155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_903830359101488_5804598342544490810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APT6K4ALRDsQ7kNvwG4R1P7&_nc_oc=AdoFajFDVOnO9Zu7T_3wbBfzfLAG2xbQgjEr4DpjSwk-8bgBDbmyEfNtq55Ji9jHmc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw1ok1LF2sWl_9V0TO-peoMOOrNsexJXjEO21eHwHL9w&oe=6AE4A1BE"}, {"file_name": "pen_types_alien.png", "id": "2303716183437103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_2303716186770436_8912560277330926798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoGz2eAp3c8Q7kNvwE7vN9q&_nc_oc=AdoIRZV7Igt_cQk-gQFaIYPCXoCtnHwOlOJTHEWc_uY_41WruqPaelvyqZ61LZeFYVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuNE8VdYqF7ehidhkclhOvkHRWuCODSdf9Nsom-GuuMg&oe=6AE499DA"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTtlK1Ie0HoQ7kNvwHJnpa6&_nc_oc=AdqExRn6RwzZYUqlzQFOPJcfKzOLzZQBI6omTtMAjtS955_O-9wUsIobBvNXrRuBil0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZEn4_ULn5pVtZk5zQGl_4D0q1O1oSYekFoc26yK-Wwg&oe=6AE4ACFE"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Wtj_qdNkMAQ7kNvwGBByLO&_nc_oc=Adpi_ezPMUfwt0sbU2TUzVImKTWfuYUZmsw_nSiU4KsxO9j6Nvgj8mO6ReAKN6N6TxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR_99JV2DyGJbQlA3lDzG1JbuGwgkiu_ByZZQWCvU4rA&oe=6AE49896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqgCwdMXHZQQ7kNvwFa3I1s&_nc_oc=Ado_sjzll7Y8ZWZlQ-mlfWVlJDZfcwwZaYxtD6fMxW0tJZbFibJKZIbEiNeETbF8fm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhNsz2noeoS86K573PPoFXJXpTeZwqNoZ1IASYl3Fu1w&oe=6AE4A61E"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://www.outsidethelinesvr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": "https://discord.gg/dGaVFEZH", "website_url": "https://www.outsidethelinesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
nshot01.png", "id": "912341601271324", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiXUxmhOQSUQ7kNvwGc0EIm&_nc_oc=AdqoODshTTpWq0FqN6iF2l7UrDXWbknzGUR-M5Rwxo9h3R6jWDgSAjadRuOc0MC6uMg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx3OTyjfuBOydDVKdnPtnQJnulPyBsc9qxK97Lr_eJdg&oe=6A85992E"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHFmOwgD6FAQ7kNvwGI_u9M&_nc_oc=Adqp18rbMwYuPmbaFwMcROBLr94Ae4Vdc9vqYcaBVi2V6BmLJZtCVx8UakPj1R0F7gw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYH2X-C4noBctJJwI3h8p_PYe5yiIKiInMYqLhoWew0g&oe=6A85AB12"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsqAkQaePj0Q7kNvwFMdXWV&_nc_oc=AdoroB7W0QmpgB8LPXHNlQWWcdNh1I1_-2gheKInkSUIb5cQq82hTxb3hRpM_ZU7sUk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7JD14P9afj6dnoacHqXpTac7jw96jrZeHreBaH2kWGA&oe=6A858AE6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSpUvoVrc0UQ7kNvwGugt-Q&_nc_oc=Ado0Si_S-TJ-7a4BJN7Ov5XE3p9Gtm-ffEOpfXI4yrYRBWkvWDh9bT3A6b6kO-ZJ5p0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIUBylnoM5euV0lV5fsyoqYev6XpejEYPGYsyKWkx_2g&oe=6A858476"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOD9UYWEDxUQ7kNvwHD6Va9&_nc_oc=AdovhcKmdb2xXjJlWS4Moq0gtSNiMByQdOE2GlMPy1htPx_PeJWFK7YuH27I7x-5K9o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyNEA5v7zM5DFpG1dJWcegDhwZZNc6uUJRtxEsD_xbhA&oe=6A858C08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf0MZgtlQOYQ7kNvwFfuKd5&_nc_oc=Adq2SOzlZXuoDjsGZjPeSM_WO59xx-7Hr1ZY-npk8xyp1hKEx1Qt5PNNfEOBV5oIXuQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETZYWv7XtDxwYREaovGS1KZjrMWFcTfK1p63RUI-BxgQ&oe=6A858F79"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "857140727079094"}, {"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "2127446141409325"}, {"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}]}, "baseline_offer": {"id"
hot01.png", "id": "912341601271324", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOZaOm4WE88Q7kNvwFlxvMe&_nc_oc=AdrS0m-oRwymev6hjXzTImeXIakxN6lHa-NNVJdohKXvirh3tSTlWevm2vJ8YLFxN9U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MzAyaztHBa2KKscaS2QnJq-c0rrrhUY2AA4hQCu0hFA&oe=6A46896E"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAKVLPhbnYgQ7kNvwE8F4v9&_nc_oc=Adoih69pQBn5PaVJJKp_nTv-r9rU1i2h0Vf394b7qBek1TbuLoMpxRFKdOml-_uIHEw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EKUoEYPbiquJlCZgbhkUz-Zta4UwlA3aDMFt5yL7pHg&oe=6A466312"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Fk17EIMpOwQ7kNvwHepiwt&_nc_oc=AdoZomSG8rcDDlxfLWcaTcE3azWt_YIsczMqmvuJZX60gjgE5cqj49ze9VKiGIUctFc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Wh6U9Rc-tuv9RtlLkOrPUWPox2YVlaMKY-l5L31sZg&oe=6A467B26"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26oEM5I4tBUQ7kNvwHQx4UF&_nc_oc=AdroI0jFOI5Iio3W48e7J-acK9i1PeTZ1EvGebDJlEWzZZ_nB1F6pM3OW1CdyMyLNtw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gkC033ptXb3iqS4psOYNzxkM7qekTQj2VWuQmJeuCOw&oe=6A4674B6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX8el7msCdwQ7kNvwEKIu4F&_nc_oc=AdqDgQNJt95mjqdMe0mFJeHTWj5cplVemSAAFjffAgqlzcbOrkzm-QHSou7TxOQIbAs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a63qZankZUDpuoZqJn0orGPJIMEcKg1d4Tel0vT896w&oe=6A467C48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR2Vi8XGSJ0Q7kNvwHd_c0m&_nc_oc=AdqeB02XbfzisLQUbhvnt9nDOeNm1SGqK5sFsKFQXtR3qrjKnyPHeS8JwD97_KRpBYo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VSBas0WOD47BY7KavRHHIZxhZ28Nnb_1iZDQeRQXSzg&oe=6A467FB9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "857140727079094"}, {"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "2127446141409325"}, {"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}]}, "baseline_offer": {"id": "9
oe=6A1ED612"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRshY5yUIiEQ7kNvwF1lzK_&_nc_oc=Adre0pAAO0OBnowewAjUtikmI7uFb_-WOOgzwnVTuhtxaylSvsKJ7x03HxNuqa0H6Z8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h-irjDonnPQsuxmE3dkAQ58y-TlRfSfv1H2o8rxqefA&oe=6A1EEE26"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0keaaJHZjIYQ7kNvwFqqWWO&_nc_oc=AdokXzohoYb-veWzoGkUJ5OK6zLyEGrkxQ9xMsw1omeWZ4Q9wE-P2Tx4UY5h335htjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XI1g2c5mII2o7-4Uy96ZAYPgjYRuBQrl6hXScmWcJ1w&oe=6A1EE7B6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oczfLoVMTWcQ7kNvwGmV1Fd&_nc_oc=AdoFwrR3bNJHVUoQxwCdxW9TqFp8BVOoFe8SndlvDKOUOB25miS2Z_2K1xgF9yXsaw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gu1ti2Ha4_AWlFCHSH14EiRNMcflawqZG3OYCqaoR1A&oe=6A1EEF48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xC321nmamYQ7kNvwEkXd-y&_nc_oc=AdqdHL1UgJ3OL0rmcr2i17Ac4NXyfq920S_nW31DeWLqacI2uIt8Fg0KwQ8nbCW8xgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42sud8NBqxqX6fxds36CY-kYU08uDobunbfoVidiUXwQ&oe=6A1EF2B9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {
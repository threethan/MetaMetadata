vcO8Djx1aHeqpb0p_TKa0rqrSbNXBvp1uJJzPFlVV491NWdnk26UA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYBUO5FVPJRw6E0dJUKViAwc8dYYbBcPlA4nP2uM0Ieg&oe=6B007ED2"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zzJ4G_4K5MQ7kNvwFP3vM_&_nc_oc=AdpZTnmy3_9hz35QQEPlUhEnAIIYwr18_FSwdziUfiHbw0IRKs5WnwY3nZurivtkB-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSti1I25aurW1MPRuJLWhZUxA97swRReV_HFWB8xInmwQ&oe=6B005EA6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bum5KF9ReBMQ7kNvwF9jf1g&_nc_oc=AdrEL-PDhP7djNsZVoHfd8IfpuG3osDSYATjcpvCvUTp2cFVFANobfUniC7AqwmafQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMgUj0DnDm3igfeAJtDLoX8Rrnl2lWBdWtbHOrJzF72A&oe=6B005836"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_8TUw08Q0gQ7kNvwEVS-2A&_nc_oc=AdoMMOVy_021p1GX5J_1u-qtFmdxZhxLieL0krrzPKk8lyzHWMBnvFOPXcmsKUntELI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQayhw1lRfP8T4oMQ1Q8so0FiDw0Dn0DRQs96hsJfC8Tw&oe=6B005FC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obtId84kcggQ7kNvwGCqc9R&_nc_oc=AdohgQO96Cj1rf_EW3sH9PF1_2iTZZUx3dlXcuGapN-SYukn6WPgaljeQNtIboOc8WM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDkIfXCIbacD3qIgw1yrAQVX1PEESZpWWyAH64YrAow&oe=6B006339"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
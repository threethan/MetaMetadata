q5vIUXi25V9lMCKAKCBbEHummSF_464LMO18yX14rZDecB_lNe3wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUR0EFGHXWhnixs-p7g4Iz9Zfchybr1aO5hV6PBedTWA&oe=6B0C5C52"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6ACkzXG-ocQ7kNvwGF1f4-&_nc_oc=AdpBu4SzYC6ojQWjMmZu_qSA2ZeKYibFm-dzdvzKWgdhOhgi_iEYJIQ3XJ1pfSK7DYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSM5pqDGLmdN8fZHQoJAbc5-aXf-kKQWdn6A8Jr_FbWnw&oe=6B0C7466"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRa-Vioept4Q7kNvwEw22Ka&_nc_oc=AdoXxn_z5LLHI0gFplDdoD7YttBY0tN5cvQ-mRRT_SKC8f1KW1MTs3Vh1mxJhQmJnMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvdYe7qat2xJqrJoT190JIhi0IXHbzOvcqaHM1UvAwyg&oe=6B0C6DF6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gmJmo0kZDgQ7kNvwGw8oUM&_nc_oc=AdqzFtxSgw2pWK-03QlcpJjZMa6cLf4DFhCY5YVGSoW29jX6MFO7jXnGtXqY7y3tDBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqHlTJmBMotr6rpWX_IZpf97DJlFU_hufGifDsW8vIGQ&oe=6B0C7588"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9v_AYVCw8gQ7kNvwG_85eT&_nc_oc=AdrK-uIvdmix-7HwUodGHQavPBsB9lLOo51UloNSv92K6-BJrSCaBJqvMeLt6DLNMkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSG4zgZlW_mzCoNaPtEORndEtdnPCEfDP2Ew8AaqkuKBQ&oe=6B0C78F9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
_AQQd0vq5u9JozPN3XlGPOaFpVfnZu89ourXnsbcpv24Chg&oe=6AE746A5"}, {"file_name": "CoverSquare.png", "id": "827458779784416", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_827458786451082_5694307483525517215_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9sEI4PczdkQ7kNvwE357bK&_nc_oc=AdrMnVpzl77isVSs3eRKSgK8m1Ns4VkcihgfAjI6UjiBie9nHKjrgDP5zkHjEZNv5ig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYRJ5OTztLOZwhzFcygWdDNfUFVqt-TLPscZarg61qCg&oe=6AE75C22"}]}, "id": "1521262213367593", "locale": "en_US", "screenshots": [{"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA_FADchHGQQ7kNvwFGEdsY&_nc_oc=AdqKvycRa4BxeOAuB4SmT4sQyztjUO9IemnVPDrmLX5xJpNwVJwO50b6M4Km_gH8WtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ6-hOaVZGT2wobhCP5b1przFhdj-yweLIgomYvWQtbA&oe=6AE75226"}, {"file_name": "easel_angled.png", "id": "903830355768155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_903830359101488_5804598342544490810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APT6K4ALRDsQ7kNvwH60hWN&_nc_oc=AdpnxjbLIj_3qbjZLvRYZNjCverhSl9CY4JHxSApI2H13sXyNq30TDlvq74awhowm44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL3ceHZHsJLpgelHzX9lYX3lVZ2PhX5Cs0-dFdaut1Ow&oe=6AE744BE"}, {"file_name": "pen_types_alien.png", "id": "2303716183437103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_2303716186770436_8912560277330926798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoGz2eAp3c8Q7kNvwGDYrS2&_nc_oc=Adree8kKGD0BXl1z6Rr2Eailk2sdsnQ8eCJrMr6p7wgB2DC91d-alQHKFFYHll4yw5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaAXYIkYDrbMZvu4KCX90sqovpKaf15HeEcfgWSWWFAw&oe=6AE73CDA"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Irc8r6EnCmsQ7kNvwFhn_wa&_nc_oc=AdpCBPfGOQAB77ijIjDGKLRLEZzMg-2hGNtQx3NRhhazKpWhsq5Om33L48Qkm3IGDv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_FIdcl0UfXX4qLQ__coeT2PhBFVji4ecC9f5-b-1LYw&oe=6AE74FFE"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvVUredKeNIQ7kNvwEf36Uh&_nc_oc=AdrWzjsCFxnyCwWJBNL8vhepMJ6lB4JstNruMSLAPd2B9VDkvMQ753i33J0SRWMTREc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXc3CYDCA77-8rRJSModkQJ6xKeAWR9F8Xnejmu1UjcQ&oe=6AE73B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzVLkXNYggsQ7kNvwGYNZHa&_nc_oc=AdoS76DIE3Wks6DGtO3GrJhNhymYux0VBzR1tq4ctufdLp6A8bmkFUwLh0yiurRTSD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc7L0QO7EItu-iw8gLiHKnmFcPPWHPauURiEaupMNXlw&oe=6AE7491E"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://www.outsidethelinesvr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": "https://discord.gg/dGaVFEZH", "website_url": "https://www.outsidethelinesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
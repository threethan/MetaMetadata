g", "id": "912341601271324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfWCfBNvkxEQ7kNvwGWKoVi&_nc_oc=AdoPErdMriD4bPakoj0spLbhXW4ExDZpgV8b-i8PtNzy_JaukHnw-Ap7q7HV3IFQTWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AkLvp_59vnvtTTdeK3mv7s1C0JCngX4zNVPQFZcDrIg&oe=6A29886E"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSGWtoL2OO4Q7kNvwFiXIdL&_nc_oc=AdqQVCmt5WC8yTnbji7t0ythb2k3rH8BbUUNpf6-J2X4cb7xpSFPfAjkQA7niyV5NRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EdzqmKRQvp8sbQ2ZCcl7-y5iYeod5h3sTO8jDrpN2Ew&oe=6A296212"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvRrC13dArYQ7kNvwFRmDaS&_nc_oc=AdpbXt3rXAlhX6r2cdbZxfhNe0HQU0-8F48VOeOov9iuZa36wtx5OgLq5DyQOZtJHd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qqr_g0iM8-rmKK31_wlJyBVgL6OwMhAKx4MwNbNYvOQ&oe=6A297A26"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybWlpIegyY8Q7kNvwEqr85M&_nc_oc=AdptYWZ74VP8BEqL_LyCz5X8gRADGVemToavueEZwQHvBr7oBQA4O755ki6DROvmEpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zXwb1nZTouNuwzp7elbFnHBTpqzNKqiZmsZ6QSgRAyg&oe=6A2973B6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-mU0jHN_hQQ7kNvwF_putY&_nc_oc=AdpUWk08q-AzKrd9W22-dkmTOV43L1v4YYD9o13a74vjQo0rJwUoAZYw5Ma5eX6xiCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96SqIfnfOjzdhwOACR0wItb-AArqW_Zf490URy59P6GA&oe=6A297B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVBdvO58LQoQ7kNvwELJAgg&_nc_oc=AdqIIx4vbIPRRc6IBDn4Z0Jbu37ZTjkuXaWAQC0qlTEqgVfVL_m2SauVa7Jhk108z44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5EFCiojAGUBg_ecOR9bL9-3aVTfdzYPCzwaVeV5-nyQ&oe=6A297EB9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}, {"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "2127446141409325"}]}, "baseline_offer": {"id": "962957456171722"}, "is_approved": true, "firstOffer": {"nodes":
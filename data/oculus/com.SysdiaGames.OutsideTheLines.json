g", "id": "912341601271324", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E9n0shii4YQ7kNvwFCAkQI&_nc_oc=Adrbc1BQEGovIkAQz-cmra39XtZSg5_cNZMBmFm49BjeurAOBSpkhCBSLKx2jmvIkGY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq0_Wn9QcEor5zA_AqWLYqIh5zh8fy31qQ3fsGNBQ8Xw&oe=6A8ADF2E"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeIb414TNIkQ7kNvwEyet71&_nc_oc=Adr0-Xme3gzSGsLuEBp4zeBGru3Msq9oiO2M2kLIoVwdb5cVQbJnKEeOGd-szT_iU5A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuH2Sj4Mzs8-06fHfbta_RMhR6DTl8IBq6-Iu17d10Yw&oe=6A8AF112"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duTDvRV5ZLEQ7kNvwHhdii_&_nc_oc=Adqr3cjnwAzK0goWxRjPmXi3PFMRJkAmRp9IrSX1ffbG7xK2IfxuTROuQhc-BtnwZp8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEheD4W4P3OzqPYoqTASlQAK5KqBh3tsUz3A6kTJpECIQ&oe=6A8AD0E6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TEt3g8hrlkQ7kNvwGXQQl0&_nc_oc=AdoUIUfkU6HBBXy8A0iwCxgY87r0IuyNRCq9SX5kGkFr38hZ06W1u_ILUbKPvx_SQmQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfjJJ1q9hSfZVu6tl-bS23ibTlhZaWEAK-TNcu6GJAHg&oe=6A8ACA76"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb6LjvWxg6YQ7kNvwH7J7kp&_nc_oc=AdpEuILvT0CiGMIB5fyQL8iVWvEqRmTAgG1JMEva_I6LIDLUMTO8p313_3icT9jhZSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgnLJTCu3NzsCe11ezJGV8fsJQazv7iilnkHX_Lu4GKg&oe=6A8AD208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRYBb3kfROcQ7kNvwGjedYG&_nc_oc=AdoqbuZBlNjnnkg2ap9FefDA5kuqzX_E1yUiAu5gjJ48Krz_O2ffCiFyKbj7FUHmi78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF9LoMyajVEPaAd7xlph-JgRO9TQSYpPrrTmdNG7QAGg&oe=6A8AD579"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "857140727079094"}, {"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "2127446141409325"}, {"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}]}, "baseline_offer": {"id": "9629574561717
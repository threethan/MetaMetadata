1ASUwqIYCS6JCX47tSiktU1gXegnLKGdJjQvwT2vH-zOXopo8uB7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXnRCTDuVadisIK9AttZFCCLW_uFUbsvo-ALvnftPUUqA&oe=6B0EFF52"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6ACkzXG-ocQ7kNvwFvLHM4&_nc_oc=AdrTtX4almiMsUosW_77aGrPHoWEy1_I9JeVZqaaTFZWC3r0vgClA2ek5NGfz12nXyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUtfslGHL7yNu-NGV1VqOx9ZTlHGn6cCfV6eXIvwKU2gg&oe=6B0F1766"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRa-Vioept4Q7kNvwFfpiQB&_nc_oc=Adoq0uxqRZAsj7sdDQWylslWKaBWueS9bfCxY36lPKMAPigHo-OjGBAH1UtkMhwb_2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWl1yvCq-3vbBctfirXD982i491F6C8r8IuCvNVK66m6g&oe=6B0F10F6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87ZuziKb7Z4Q7kNvwFyZwKR&_nc_oc=AdptU3dRfbl9G6rVScn6qL0zILkQYMDIQzc6R2YKkgQ0JAW0qD8KeTIihkNo4Vi78QU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKny3veR82O-GZXCZsX5MqwTxQsAIUPIogpqY2aoYxKw&oe=6B0F1888"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4a7lOhbgZ8Q7kNvwH85klS&_nc_oc=Ado9wL-od6OkGVYm1nc7ku-v40buZim5OPlkyeLRY5PQ9A6bepvJ09_jIgFLyAKsBo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX87-rWNut_-TdeVV5bORnBiKXKr4e_XdqBwDMcN1k9Nw&oe=6B0F1BF9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
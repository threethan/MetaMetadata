gUlTDw4u-p2-raFYa5zYVgbWjpXpXy84WmwqBj-xspa-_mfGZ9zgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMOHCNzldK21mY6Kef-q-hR7z917h1yg5i4w6pC7rZrA&oe=6AFF2D52"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgCI6KbR3p4Q7kNvwGv90EH&_nc_oc=AdoV_hYCqc8ty2kwfTOY_qyCLqKLP5APE8ysGUH0u-eXx7_6g2dJ-mzTC4NMZhjscKw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe819hMb9j8NY8cb4W_CeiMhFeMRLqhJbe5TH4qVfqYg&oe=6AFF0D26"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhLsnB21Z-oQ7kNvwFCXF4J&_nc_oc=AdrFRiPa7o9aFCWgvm1MKRbWWhDbOSfDxP303jVMFNP86T1O9Ecnah6hduuElKkwcCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJJjQV_tT5WTHsk33f_IRQGJ1muv7PDUcHfeK4rK_lXg&oe=6AFF06B6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_8TUw08Q0gQ7kNvwHoMryU&_nc_oc=AdpBsyFpgugZmvwhvKAGa0U5iwm-s-KTogVXjbBUVJW-w6KZ0NnJh9o4LZcEtfIJhJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeMU9yJZT6f0rFCj5O_NYzAbd74rN5oSqgyOWcfuG6Bw&oe=6AFF0E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obtId84kcggQ7kNvwHIs9iX&_nc_oc=AdrdgyxygGjEM600zLpZtdSUkFJnkwxVh0VXuogyfF6s2RpWSBd-bwPjqduFwUnvMO8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhWsW2iwwntgUodOMjVpg7nkLXpvY02We_9mWbytfYUw&oe=6AFF11B9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
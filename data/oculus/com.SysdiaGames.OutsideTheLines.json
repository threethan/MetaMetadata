6dx-Q_SMPExvsLOIio4ApFP1fWX8EGMhwC70LJoy9WCI7hSJZkY8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPz0n-gUSiYDHAVWIcnrTbuBfC2VaXLLMwjwNY9CnlSg&oe=6B0DADD2"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6ACkzXG-ocQ7kNvwGh2hhy&_nc_oc=AdoHj9Ab8-hl2PrK8ezE0PSz6brdtj3jfSbKo8BkyWx_MR2A2rLKLa680iTyVM4lFMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROiYrpWuQTwU9WTOWG9yb0YhSP0g5BAfo4jFSZqj3x9A&oe=6B0DC5E6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRa-Vioept4Q7kNvwFsMPZl&_nc_oc=Adpmskh9o8J0oVXlu7oaQjgCONwaCXKW0nIcKqw2jz1PihB7n9KksdQ9gSk2ZzUjZM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1svaztZxhr7itP9uVntQ0L6wdgWj1c4yADP2NvlXeiw&oe=6B0DBF76"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87ZuziKb7Z4Q7kNvwEgQzx2&_nc_oc=AdoEc1yewBOD3iOdhaqC3LB_O83Tm5sZdbhlutTuPaews8Ij7XMC-BmyQwmr9tZjsL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYhWA_nVZbyqgdqu7qPMm-YJ-DzTcmI4LY8Di6F3Cl5A&oe=6B0DC708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4a7lOhbgZ8Q7kNvwFzKncc&_nc_oc=AdoI3zqirGo8TqItxQiT3MBc1M6J7mgpQx_LFc4YKafFjG0ZHz71uIrUbJb1yIycd5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvayEGtUSwgJQ3Fdinmn2MsbKPmELTtwLNp2HHCsYoeQ&oe=6B0DCA79"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
hot01.png", "id": "912341601271324", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTTScfhYjxsQ7kNvwGpHRQ-&_nc_oc=AdqY6NFey21jiRWla_beeizHayRYrIdDQk5mJmdbxqsnMuM62apujwHs9AvmXImjMS4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVJndduzI4oJWuAo7Hk8V3MbIc4TS4NC5xhQb92NZsmw&oe=6A7DB02E"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQEoFENNJb4Q7kNvwElFiUA&_nc_oc=AdrjyZV_UDmIQEFfgRbl7CE-I_UlJi0kkfjK1GoYhZEd4AsbRJiXUjLXtl7UHO992So&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEILDWWDIgIvn95TUi7KRTxkzgFramqydkbjbv2Q1pmuA&oe=6A7DC212"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewA6k0gVxpMQ7kNvwEXKlAM&_nc_oc=AdrP5cl0-SOQqA9aDsUJJFKBofLSLwS3BNIXI77_dmV-C59oBc8cSfoW7-SkCsJcz80&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMwOOyQIlUNOdmHpYoBRAfm1j0WTglVmZMSBQlUidL9A&oe=6A7DA1E6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BR1ckAZ2V0Q7kNvwEqZ5Zm&_nc_oc=AdoECSLdSAh4_TIokEHkmTHv_GQDz-z0WI89SxHSy8cNkChn47_bG9MKEBMR76pzGMU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBnqXaWvc61QQ7q7PXa-ik1fTB9uMODwnmn9lAUHJG1A&oe=6A7D9B76"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-lz_22qL5QQ7kNvwGdg9U8&_nc_oc=AdpxQr5LK34FSoZuUPRYmhIJNI-whu-ANjB14GG5R-QDPDHSo8TyQvklKpvSsH78jtI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXe542x0Tz0w6XQt7bNkbGS0WhzPzI4k8ZBJ1HX5M0uw&oe=6A7DA308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqjof066694Q7kNvwEb0UCm&_nc_oc=AdpScTyHfJfq6iW2iN4vKXpwl4AyGKmXq8zdZGIxRueRJVBUQhtLLh_hK7FZV6ajyLY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpcq3Cve7Nx7rV-dViO4hVa0NG06d7IzJPiysez2r8wQ&oe=6A7DA679"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "857140727079094"}, {"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "2127446141409325"}, {"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}]}, "baseline_offer": {"id": "9
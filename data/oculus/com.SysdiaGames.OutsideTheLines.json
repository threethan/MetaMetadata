ss=7f20f&oh=00_AQM_CAYNRZ64xX2-AKw7TYiokzgurBxIltSx-K4W3DQMXw&oe=6ACCF426"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqxtShPkfUgQ7kNvwErbarP&_nc_oc=AdrqmFoEa_VnJpIzzVlTl6Qg4U2C7vDwKTbY7jcdOnXiujDZS-K_fQuu9lfZvFNQEbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1ZjSY4xMf660pZ8bYMSdcMl7c8R0iMqnoq6SihQIqmw&oe=6ACCEDB6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTsu6639pxYQ7kNvwEBqXSr&_nc_oc=Adq6WMh27e6inw9Cayv8ei5GGIeYHoWtLLA0YprN2ehkNUZtFArvGvERpf-ooOX3XCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxkHlFsP1ZiGNRK1AQ1YGefBmzWPzc30w6y3y7Iy8iAw&oe=6ACCF548"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUO8Yqf9ot4Q7kNvwHBXsIn&_nc_oc=AdrUyKolOj5LEEevyAQC9qR8NNLr1Mo3gl8EJAfBwG2bwvibmeyb1n3vJO8gQVRCLw4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd6ySBBL3hD_mw4cyKkJ9C1fCLQtGoZH1TmZsLjFOn9w&oe=6ACCF8B9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
1-25/491821702_2303716186770436_8912560277330926798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCxofjlgQCEQ7kNvwHAUsIR&_nc_oc=Adpcg2hAxjJFB_uR8mjgMmC25nCcz8OAQpiKWFOaVlJB8LvZPZ-CGYI_bWGdiJxnghM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q4A26K8iNu3xXxU4NuPbgf5uJD9K3MPhmc-eDkDlM4A&oe=6A1D875A"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ0-Wx0UpaAQ7kNvwExQpOr&_nc_oc=Adpkf-4sM0Zg1YLKw9pWeY-tvnzK55HTF4ifun4rPqea-vpkgPv5ECQcYW33ZbHQ-W0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BvDr37NUn4_bAjpC9teBiAfMxxlMqPrmeVqsDOJw-gw&oe=6A1D9A7E"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF9w3CrYtHsQ7kNvwHUAw__&_nc_oc=AdrJHHvV3Wp6B09p4_N9XP8R85Xr6x7-m7GnToDMeXZw4EjuLGOYZmNT1r9Avq-Syso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42VoalceCLfB5GTWU7lGPEyDH-T4sO0te3Vs0dYuW15w&oe=6A1D8616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCHM-lQILjgQ7kNvwGbY_SR&_nc_oc=Adro8GbB_kDLSWQUwUmswiPlTr5JMjfl6W09aJQFXDFyMc10wnWHF79qJ1LF1ePLTzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m0VG5uSqfehXknNxwZn6Q4Iwvnxgx2glza7shykk_7A&oe=6A1D939E"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "htt
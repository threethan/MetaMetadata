_AQNAhhqinePSKe54pz1OEPVFIcfTFcxUHGCkGd1HVn9L4w&oe=6ACA45A5"}, {"file_name": "CoverSquare.png", "id": "827458779784416", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_827458786451082_5694307483525517215_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlFn7qKDROQQ7kNvwFBQ9H1&_nc_oc=AdoxXfkZ648_4gKmUoo7i2nsVQ5F-MsfkZ__6Tx8uR608czlFK5_ASgcG_e7e_5agVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy2Ug36yU5nScIUlpJ9xxaxKWQoKmC8HWVrBrmegGK3g&oe=6ACA5B22"}]}, "id": "1521262213367593", "locale": "en_US", "screenshots": [{"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Anh-QqstMtEQ7kNvwFdjmZ6&_nc_oc=AdpL8AtbGU4NxAOlU8Xb52aSL3C1VRnuUZp6qjRN0WlwLjyD9UjtuMh1CWVf7autN9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvMffZ1BDJnTij3ldZaUCOHvXd-UIkYBROoxsWGpgTDQ&oe=6ACA5126"}, {"file_name": "easel_angled.png", "id": "903830355768155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_903830359101488_5804598342544490810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arJe2A4jhqgQ7kNvwFip0o9&_nc_oc=AdpVr078b_zlb916tAUlabKpdsf5X8MovSs-mxGRgY_x0RYvOQLKArNo-16R0uw5CZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIMbX43eygrNn3TmsozENqgjcu0E-t0CzXKGG4JWSzVw&oe=6ACA43BE"}, {"file_name": "pen_types_alien.png", "id": "2303716183437103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_2303716186770436_8912560277330926798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw5BvBL1kisQ7kNvwHjsuU7&_nc_oc=Ado6NLkT3G1rW_HHlVDuNisNsteUPHLw1HybQGdDK_mAzR7vj1at3JdFf5hNjs7JDyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwzgGSBqMb6d7VOqP56dxWgbnIXSH6wW-eX_-Z5xS0lg&oe=6ACA741A"}, {"file_name": "artwork_selector.png", "id": "1936670550571076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1936670553904409_3095900818839658849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-LMWnymHBgQ7kNvwHygJ0O&_nc_oc=AdqZ0p-RCLe7oowtVu1Rc3-yqPAifCjOVsYwhLRHTNJssAkfJ8bqtpq-DvJh2UImAWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm-To84AFyIbiTRscPjHBaL52PgM4Gs6Chamm5ZTbUVA&oe=6ACA4EFE"}, {"file_name": "Layout_16Pen.png", "id": "962411509543361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821799_962411512876694_1338153850265494808_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9SFlSmp5g4Q7kNvwFEwW5q&_nc_oc=Adq-sptDMjIKZkayOkRdkTOyS6Uq48nXzKgHfxk5xCcgFsBgRZBAI4oLsXq75avFnvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT4rYJcoLfhEVLDHmdDsiA28B1sP03zvO7tf6dccCGkA&oe=6ACA72D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "793355710132540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_793355716799206_1595297034518211331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4lNfHK3ShAQ7kNvwHkEOur&_nc_oc=AdoCvFNBPNf2AKIo96iAXa9NdFcHKzw68ehTXwrXuRSWGLyfgSd3_EKgYlQsMor_UZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlD8YE43-vHQ2oJVzWyJDa04Dl8tJfLq-XvozUsPscEw&oe=6ACA481E"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n# Use a wide range of tools\n\n* **Felt Tip Pens:** For bold, vibrant colors\n* **Pencil Crayons:** Perfect for softer shading and fine details\n* **Wax Crayons:** For that classic, nostalgic texture\n* **Chisel Markers:** Ideal for broad strokes and filling large areas\n* **Erasers:** For getting rid of those happy accidents\n\n#  Features\n\n* Use any color you can dream of, save it to your own personal palette\n* Activate Passthrough mode and color away in familiar surroundings\n* Save your work and carry on with it later\n* Canvas History lets you step back to undo your happy accidents\n* Export your masterpieces, share with friends\n* Color in with just your hands using hand tracking mode\n* Full support for the **Logitech MX Ink** Stylus for Meta Quest\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Space and Fantasy:** Imagine your wildest fantastic dreams or your sci-fi adventures.\n* **And much, much more!**\n\n---\n\n**Zero Pressure - No timers - No mess - Just you and your art.**\n\n---\n\n\\* Features a library of real artist work and original digital illustrations assisted by AI generative tools to provide a wide variety of coloring themes.\n", "short_description": "- your virtual coloring book -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines VR brings the simple, tactile joy of a physical coloring book into your own personal virtual reality.\n\nChoose from a variety of pens to bring illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess. Just sit back, relax and color in!"}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://www.outsidethelinesvr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": "https://discord.gg/dGaVFEZH", "website_url": "https://www.outsidethelinesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
TmxjNzqY3HavP1aplj64HdfUhQfe-tsoKDEjl2YYfywkA9Fajy18c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKfYFBz71AunHigEvyW2L726k7qXShTOUQVBITwmtt-w&oe=6AFB38D2"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4uVdvC9lZ0Q7kNvwFJNq6y&_nc_oc=AdqseOmfd_6q3mozvWkVD6aYxAbrtv7KpLbXAwdL32fIy6pz-aO6YTbFNmwhGRINItc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAKfm3DC6bAPzvo2fGhs9fk2iQ0DUlUizlFXmt2GQyAQ&oe=6AFB18A6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJOdHZA3h9sQ7kNvwHvFauG&_nc_oc=AdqGDfv-iZIqIl0S3StK0HGFMqR3UO3llqB5yIjpdzU-SzHi9-5fN4slT-qPJux5QzQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjxIxeXc283ZIXriYdok41Y1miRmubmFE8qBVU5w4D9w&oe=6AFB4A76"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmgOgezxKqEQ7kNvwHGrs93&_nc_oc=AdoLdUAz1LFeX8zyoWDnya859aAO9k-ycRnBfbPCjNa9a1HFkS_cZOzMMNgW-VcUAqw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxwrCw6XZ3y6IG8Uhm_pta9nNDzBe1KqKSoVc92VBcFQ&oe=6AFB19C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt4BGH7C53kQ7kNvwHFRodr&_nc_oc=Adpp26v96aK8b1zaDp3dlD-RAi9vQVVnF1AvOK5x3cj2gTe9PsR1WoRpnCBWxuvkvgw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbmfBDIrbwzgbIYpYl7WDzBM-0bkoVa-52ElYurCvhWA&oe=6AFB1D39"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
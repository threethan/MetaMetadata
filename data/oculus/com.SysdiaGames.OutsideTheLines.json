9OMkbIqw4kcDD6ZGtfNzOf1U_cBBkvDQon0lkoyzDfGbEId6j5GMA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCZOeq2ZjCT5A18VX1PjLK0iT3cULzwjTDEs_GJIwfzg&oe=6B0867D2"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI2IvOhuYkIQ7kNvwHUztzI&_nc_oc=AdpkZbT1Q5dJxZRpF-ACkddicm-lZM6kDZoNpjC5p7WVfAujKgj6RZT2oLBS8jKs9vk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGmHN6fYn5cxlzE9fB6V63Hx2oL3AC94LIkMNAuuUadA&oe=6B0847A6"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQssGI4VbawQ7kNvwEn8YIl&_nc_oc=AdrDriaXOdKYjWYps5WOcLNlXuzN2SIIzrQw6C0HSkoDXL4XgY1hJf5-Pe82X1Qfqbw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaPhG-FolyM4Lc9sMyxdeIZ-xF3klH1onUKQmwfxN6Ew&oe=6B084136"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylfhbnFkk_kQ7kNvwH7UKMS&_nc_oc=AdrfzdTAcPnWUBxf0qs-XdcWtcsH1VUulRuvP0NuPX1ONudud9ptf2GSc-q2P73rDqQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrbKNqkMN-5HgZxf_9rMm0pI_6yY1y2js5BVTNuIQn9g&oe=6B0848C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55VpJ3xnIm8Q7kNvwG5du5s&_nc_oc=AdryUUKW-MkHb9J5KlZdnccxukbHn3gtKIFK7n-UTIvom7MubsWOdHyvNfPumBdNJ7Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgG0gPtkC-lSCldvI-VU_ST_Hm3si37AZrWKGTGbTRiQ&oe=6B084C39"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com
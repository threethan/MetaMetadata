ng", "id": "912341601271324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_912341604604657_135601968542956892_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeTQdailgYYQ7kNvwEInvKl&_nc_oc=AdryX4ohzgmIqGiUWrSoufDogVc5fVtw4Nh7fN3Ut8hbSK6PX-z49DKBOUl1ya6l-a4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMBo3p-5k1JzykQAnmnPdonrKQP4ohd66uSo3FoRQOsA&oe=6AB0016E"}, {"file_name": "Screenshot05.png", "id": "1128282089336249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821954_1128282096002915_1581094155199347286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxDeImqXvA0Q7kNvwHSlXDf&_nc_oc=AdqWlXrah3MYt70XxKxSDPwIlGvX_1px47Q6oNwq0wwyEjUjP1A9_6xHdFFiGEFf72s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr5irUe_DScI2s8IJrgxc5S0dwMNW0qj5b6abUHJZqvQ&oe=6AAFDB12"}, {"file_name": "Screenshot02.png", "id": "1663125131530181", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1663125134863514_2822870837997484080_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qzls2euLxYkQ7kNvwFvCnCW&_nc_oc=AdqwL4OfLTbFDywPr7ia-waBPJ79v3eWz_dQlPuu1Z_SwECRdBJR-YJtryRbsqbuwf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKkAL-IG-p_CuaNzDFSczb-4vwOCVnL8wu6CWID3HqPA&oe=6AAFF326"}, {"file_name": "Screenshot03.png", "id": "1414762276856783", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_1414762283523449_5787424686372126765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIQPNgjAMOMQ7kNvwHzvs2Y&_nc_oc=AdpXVEJulXt_w5mcLXiQqwrqgfVeJ6sWY2wRc3rhPQGwVwduC4zRJn_VdThIkBE78D8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKspIJavMTorkh9NyQOIVWrRdHBPZDbjlSjuEfs8Mx7HQ&oe=6AAFECB6"}, {"file_name": "Screenshot04.png", "id": "1232726475615799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_1232726482282465_6773113397662992916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCH4VPPZa84Q7kNvwFxj2mQ&_nc_oc=AdrF6f2o7FYvDW-HscLNc0cnVmnz7eD8_rlXR29HPMoIn_mZATOfrHL8xKspZp39F7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHKFOtJH9oN3oAdagYbgGG6FjqbxFh7v6Jk9Vp9qNeRQ&oe=6AAFF448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2389276628253142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_2389276634919808_1832821445621529686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIu2jC_7wLMQ7kNvwEm735Q&_nc_oc=AdpJYpGMyZQKuxLjPehGuttm-3xAz01XRd31PH4F6cjMS_-AdrNuein2-Up9mwQQxPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR52B8ge_76q6SzRjEVYaGB4dbB3__DD4ILL5nOOGRiQ&oe=6AAFF7B9"}, "display_name": "Outside The Lines VR", "keywords": ["coloring", "color", "art", "relax", "calm"], "long_description": "**The Simple Joy of Coloring - Now in VR.**\n\n**Outside The Lines VR** is a tranquil experience designed for the simple, nostalgic joy of coloring in a peaceful environment. Forget complex mechanics or high-stakes gameplay. This is your personal sanctuary to sit back, pick up a pen, and let your mind drift.\n\n#  Your Virtual Studio\n\nStep into a quiet, sun-drenched office that feels worlds away from the daily grind. With a view of rolling green hills and a clean wooden desk, you have everything you need to relax and create. \n\n#  Authentic Creative Tools\n\nColor with tools that feel right at home in your hand:\n\n* **Felt Tip Pens:** For bold, vibrant colors.\n* **Pencil Crayons:** Perfect for softer shading and fine details.\n* **Wax Crayons:** For that classic, nostalgic texture.\n* **Chisel Markers:** Ideal for broad strokes and filling large areas.\n\n# Diverse Artwork\n\n* **Nostalgia:** Color classic arcade cabinets and race cars.\n* **Nature:** Bring life to farm scenes and forest animals.\n* **Total Freedom:** Stay in the lines or color right over them\u2014it's your world.\n\n---\n*Zero Pressure. No timers. No mess. Just you and your art.*", "short_description": "- color your calm -\n\nEscape to your paradise office for the ultimate low-stress coloring experience. Outside the Lines brings the simple, tactile joy of a physical coloring book into VR.\n\nChoose from a variety of pens to bring hand-drawn illustrations to life. From nostalgic arcade machines and race cars to peaceful nature scenes and cute animals, there is a page for every mood.\n\nNo scores, no timers, and no mess - just a tranquil space to sit, color, and chill out."}]}, "developer_name": "Sysdia Games", "developer_privacy_policy_url": "https://outsidethelinesgame.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sysdia Games", "support_website_url": null, "website_url": "http://outsidethelinesgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25980307791635709"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1452095893177955"}, {"status": "PUBLISHED", "id": "833198073124365"}, {"status": "PUBLISHED", "id": "2103444580509602"}, {"status": "PUBLISHED", "id": "1257200636369665"}, {"status": "PUBLISHED", "id": "1693842811702116"}, {"status": "PUBLISHED", "id": "857140727079094"}, {"status": "PUBLISHED", "id": "1287766879617211"}, {"status": "PUBLISHED", "id": "2028241151451257"}, {"status": "PUBLISHED", "id": "962957456171722"}, {"status": "PENDING", "id": "21274461
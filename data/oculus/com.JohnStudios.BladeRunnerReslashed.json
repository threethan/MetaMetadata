A&_nc_oc=Ado0JxDMkoUT6xXH4GpLA_JE8r1MLfiofl06BIe1hV4D2-zlLohlZTpZ7LQcvoWJHUQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfZcjJy-upFom00pg19DWG53cdd5-kQk8dDLsgqnC6ww&oe=6A902482"}, {"file_name": "screenshot4.png", "id": "1731390677937203", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823790_1731390681270536_8684416570812256141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=746TZfU-clAQ7kNvwFbTziT&_nc_oc=AdrN3McC_48LVYaPXSzub2xNq2nC0hVNcsOeMKLv-Pzmx93oZ1GUlaV6VUPwAjV3n0M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdg9ZKYcFP_qFT4wuiaczYOcKQ-ShPU9DY4THfPeBS2g&oe=6A900BF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blade Runner: Reslashed", "keywords": ["Sword", "Yippee", "Blade", "Runner"], "long_description": "# Welcome to Blade Runner: Reslashed!\n\nThe world's dominant species are cute lil' creatures named Yippees. You follow John Slayer, an Olbi cashier working a 9-5. One bad day at work is all it takes for him to finally snap. Brawl with your sharp sword, hard-hitting cricket bat and trusty lever-action rifle in a stylish, fast-paced combat system that could easily make a devil cry.\n\n# Features\n- STUPID enemies!! they're weak yet overwhelming in large numbers, making crowd control vital to survival\n- AWESOME weapons!! each weapon serves a unique purpose, encouraging frequent switching throughout combat\n- INTENSE movement!! move with your hands and take fights to the sky with air combos and parkour\n- STYLE!! get rewarded for stylish kills, diverse weapon usage and moving fast in an addictive style ranking system\n\n# You brought this upon yourself, John\n... so slash 'em, bash 'em and make 'em POP to prove that the name \"Slayer\" wasn't just a coincidence.", "short_description": "One bad day at work is all it takes for John Slayer, an Olbi cashier working a 9-5, to finally snap. Brawl with your sharp sword, hard-hitting cricket bat and trusty lever-action rifle in a stylish combat system built around diverse weapons, intense movement and enemies in overwhelming numbers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-runner-website/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Olbi Interactive", "support_website_url": "https://discord.gg/WBBmjzfd6m", "website_url": "https://sites.google.com/view/blade-runner-website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25983637161229985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823279_27473394519015804_4081111917326004652_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arOzkgWXjTkQ7kNvwGl_ncr&_nc_oc=AdpSd1qByINrUW-OgqrOZ4a3bc_Xg9u_2uC50SSB3ig_7nRXQYVadbQcjBFfNW04bfI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLR9_4NG3WjqhYQGUs6OWq_OgQ5qxuXME7bN49_xPC7g&oe=6A901903"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blade Runner: Reslashed", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Platf
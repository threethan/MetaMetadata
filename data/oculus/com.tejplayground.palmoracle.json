nc_ohc=QUrlpvXLKGgQ7kNvwFtu1Bg&_nc_oc=AdpshE23njIIf1_6d5-XHgkCKIjui4RO9V7x4D82SIWLILYbOdloTHa3rP1B-FZo4-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVnrffRemeC3i_p1khj1oysoLnlkkRGLmhqz1q2kcJxqQ&oe=6B1050A4"}, {"file_name": "4_menu_2560x1440.png", "id": "2130486887594679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_2130486894261345_5917058688759185971_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdXG6E1mY_8Q7kNvwFUNK0h&_nc_oc=AdqtIG5_qvQwsouepTzuyC9eEwpy3HJJV7SI8F0FL2Gn6INdrLds0i5nenvawrX8NHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVlu6t_TrCSDJGT8hjcASEL7H6AqITUkBKpSbKToOZn8A&oe=6B106928"}, {"file_name": "5_tarot_deck_2560x1440.png", "id": "41006925638906772", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_41006925692240100_7626826760492392018_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSdGb6clCzIQ7kNvwFnMREN&_nc_oc=AdpSkY_Vih7sD7YEPd34Te6WZnA2njq5shxDz7YoVXBHurbUL7yRRMTPljOJ4-rfuwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0oDhzjG6jm32YpvsbjRG6JROgE_m5czQzwAYV9lxaOg&oe=6B105EAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Palm Oracle", "keywords": ["palm", "tarot", "fortune", "horoscope", "passthrough"], "long_description": "Hold out your open hand. A ring of gold forms while the oracle studies your palm, then your real palm lines appear on your skin in light: heart, head, life and fate. Then the oracle reads them aloud, from the shapes of your own lines, your star sign and tonight's moon.\n\nHOW MUCH SASS?\nFrom Sincere and kind, through Playful, Snarky and Savage, to Unhinged. Or let Crooked, a charming fraud, read you instead.\n\nFIVE VOICES\nSage, Madame Zora, the Siren, the Deep One and the Ghost.\n\nYOUR DAY IN THREE CARDS\nPick a theme, touch three of seven face-down tarot cards and hear what your past, present and future hold. A new three every day.\n\nASK THE ORACLE\nSpeak a question and hear the answer.\n\nREAD A FRIEND\nHand over the headset, read their palm, then read your two palms together.\n\nCOLLECT AND RETURN\nForty-four seals to earn, a painted Major Arcana deck to collect, new looks for your palm, a journal of every reading and postcards to share.\n\nMADE FOR YOUR HANDS\nNo controllers. Trace a line with your other hand to hear it again.\n\nPRIVATE BY DESIGN\nYour birthday and journal stay on your headset. The oracle receives one photo of your palm with your star sign and does not keep them. Offline, the headset reads your palm on its own.\n\nFor entertainment only.", "short_description": "Raise your open hand and watch your real palm lines appear on your skin in light. Then the oracle reads them and roasts your future, out loud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://palm-oracle.tomerregev.workers.dev/palmoracle/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TEJ Playground", "support_website_url": "https://palm-oracle.tomerregev.workers.dev/support/", "website_url": "https://palm-oracle.tomerregev.workers.dev/support/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1676485315806614"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "es_MX", "fr", "de", "pt_BR"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1425422527322357"}, "review_messages": []}]}, "cover_square_image": {"ur
9_2902685360959613076_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnKzDK82U3EQ7kNvwG7auLD&_nc_oc=Adpguq__XCDH-vEcdfEZ-mZ1kLB5j5AR4ktWQ3C-Rs_j7ptR9sdsZPEAYY6rvaADtdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLrz3s1pDLaAgz4glLVZ0-vDkIl4js_NI-bWkreN6pDw&oe=6A62242A"}, {"file_name": "caves.png", "id": "2430746977394165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295992_2430746980727498_7061109944920804783_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUcX13C4F9UQ7kNvwFJLDxN&_nc_oc=AdpmsD3-TPKE6INynUSHUZVoD6hTZdp4inTLdVfWIXuh0wtLHQum4wxYnHoHKDfeQio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUzd1O92zDHXfZAc5Bn4ZQtXlToxyX5jRgTelgU471DA&oe=6A6209DB"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVmlb2fbNVYQ7kNvwFC_WeZ&_nc_oc=AdrVfDPH5JomwGQQb3jQG88DNsxiXqNG3WtL7RYw10hj2GHWW8UFzfVvtYyPkRi53gQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCslhPQqVvTQV_4AlpCAAQ4vEgQzcPmpq8XDMBSMP4spQ&oe=6A621687"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEXpPh_Gn6sQ7kNvwHZapwb&_nc_oc=AdpiI-o4WY_qN13Eva_8cvujB3yW5m8Z3Y3OzfWeM2P0s1_kehT2qivvyDRLK3NyxEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK3crrEXXmvWCUSgM_0XeujtJ6XLt7wsbTR5YwuwCUjQ&oe=6A622BAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binar
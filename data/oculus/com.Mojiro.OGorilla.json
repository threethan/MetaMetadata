3II7a8rb5jH8cKSlVYsZUd6a6OguuoomjTUwao4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_USkwwIoRVte3pFwFczOYXiGgmxwPisnxdbwfudc2Ztg&oe=6A4508DB"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r-Qg0M3uYsQ7kNvwEObABF&_nc_oc=Adp1Ax1qDjtSGpX945rbCg-KyG5p1gwzrgAzi7l43qg8sw-3CoWQivmj76fZlRihv6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZvxAaYhUmkDPa3S7xTkXd1mQXxnCkUHWkaZxfHc7jcQ&oe=6A451587"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP8GOj5-yhwQ7kNvwFv7AGZ&_nc_oc=Adrpg3sZahPylXGpstuhapcyIeAikdQeF6ROoi_wbYUVi2g45Q2uS8JRU8i8gJwU3vM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wRilUHJ5ZKYx4YtVQDMM6B49TRYouudfB18K0N0t0iA&oe=6A452AAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308998_2096457597880635_4085949622162510422_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqD_VU0aVmEQ7kNvwHKK368&_nc_oc=Adrd8drEGVrD-d9ayToCPM5VjJXvUwe5RMaDaZRkdtmj8UMofCxwGZSrGB_q_nLfg2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HBouPIesMkVPkrR1DeFTFYxFwGilkiW_6ha1IxZS5-g&oe=6A450E07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OGorilla", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
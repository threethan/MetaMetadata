eTKPQLSnKcUQ6pXAqBrR70HC9sSq0jSSDDY-SrQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZE2iQ8BnVu4vjtceYKwsP-l0INVGhV9bRqbFUFL2gYg&oe=6A917FDB"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhwQKw52GEwQ7kNvwGgbUr4&_nc_oc=AdoV356p5tK40uLIfIP67lxNQ0ZwFRQUu0RRWZbhylBGSTN2KWdzGya2qCBMQwC2jQ8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQN-7V5L7aJTqTBB4aiYNGIbPS2X_gvNoZKatSO-MMKg&oe=6A918C87"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEoVqn6f158Q7kNvwGI7XeD&_nc_oc=AdqXcnU_xcz2ZpWq1kNQPwNlLbn-wv5v_Ssr5AZwRNIyQvlxdxk52ffTTZswLz3Tvr0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_pdS8IFnYkS1eWCDfCgWYeFoVe7IU18RgOBqG3M_BNQ&oe=6A91696E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499308998_2096457597880635_4085949622162510422_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfWykiXFbFUQ7kNvwEI5h8A&_nc_oc=AdqQuLWCxAyr9MGeli2GqQr6DELStCIi-tBrlfeJgW-wu2TD-ptWeBoaOMzDZErpsSw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtLCrGfgkZ6jeHvXlHYm_FNLXYdEu15tRhg1f2Vv885A&oe=6A918507"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OGorilla", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
"https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_2430746980727498_7061109944920804783_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I_rIqEEUaEQ7kNvwFTd_MY&_nc_oc=AdoRRTDuHqIeBbVaybCXqwVRxzhnweCjy59jEH_GTVD7XbG8GD7V9X5sBlW_Kzg5MeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvrjkz7leH9uSxSt9lGlDUHooodLnPDfW-hQTuJbVT4g&oe=6B0DA51B"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSlSPjETj5YQ7kNvwGnrRLh&_nc_oc=AdoS5I0to5JmQdelkvWXnwmNltlD55xwpOGZFNo0dRS_O3eFw6H5dKLsJM_Rtuwv6Rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_FpqDAroHWQWZMBHXYNB6J909Y9wDeSb4h9osJFwRaQ&oe=6B0DB1C7"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODiBx1uV6r8Q7kNvwFlsEV-&_nc_oc=AdoEiJjyGoqmmC3XDY95KnGnesMFhUNz7QdJcaAti8nhY8QlRoaQAWZPo2EQpCszMhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQMrx0aNTulzAw_pzLFcqhaRt3lAYl6ttpy2_3Bf93Ow&oe=6B0DC6EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308998_2096457597880635_4085949622162510422_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UG2EhfBDLMQ7kNvwG_BTzg&_nc_oc=AdrzOISMIy6spp6rGdPothmwjkbP7LTI7QAi2S1yOHZrumQkPrrcTj_KM1xmVMqNeM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkMuRY4DUe0Szbm1mSSsvWPIUEWfEA6bewA
9_2902685360959613076_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS-DCQt3-noQ7kNvwGfV3-p&_nc_oc=Ado_4SqTXrKFxNncc3RbtpJR1nOe3V9RCdH5ZNreJZvUJinnySkpHXiLDAEYTdUcMT0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94S6B4Q6DbbjXDfqCvE4dRL6Frm8im0t-myxyM8x-XHw&oe=6A3D3A2A"}, {"file_name": "caves.png", "id": "2430746977394165", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295992_2430746980727498_7061109944920804783_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmh1ylhjWW0Q7kNvwGlxAei&_nc_oc=AdrT5vBsaE0xNQRVlFz1GadtG0Yjz2mPoS-2O0eMBiYcgBdEZMNkHjtkIHVCEFSbaKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TdsRBKbPsYp8aLoD7wl5aT6CZsn8oT6aSvPnkwdsHpQ&oe=6A3D581B"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ9HndNwpiAQ7kNvwEeDgs4&_nc_oc=AdpPpcG9tw7AGdTxjB7vsaUjKk4gA2pI6RgjfWwAxPuSDdFqJu9ArRYSEp3nsptm6UM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wc6H0ETAGgB41kJmFfAuc66KQQ9ujuNLr7IGeoTaHyg&oe=6A3D2C87"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1v2VGKdfBS8Q7kNvwH5S4h8&_nc_oc=Adqvl4H0hDd3B2j5g8kKfCFQOYrOCAeV3I0paYcEtY_Lx61VLXbvtgX3yv9yFwDWJQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZGCBRzYz4HDGeTxpv9YMCmDm2pZsaL4BSLJi4OP6BFw&oe=6A3D41AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554707182755042"}]}, "baseline_offer": {"id": "1554707182755042"}, "is_approved": true, "firstOf
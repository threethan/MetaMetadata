YtDzxJtJZD-9sF9rRmDIExZ50Kj_-Ct2_P5GyMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO80-yZbLqXoCJJ5X7ascUI8SJ0Fzn7X6xfbXbY4kyn7Q&oe=6ACD0B9B"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjUKYf_B1w4Q7kNvwHMj-2e&_nc_oc=AdpW-UJ0Mi9FKUv6TPneybndVPqNrw8vfXJIWaZ1cG8hsEveHPAJTw7x5IsMAPjXZ3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGIazNHSbYMlNNAtPViuOWsWindJKz8-kgAE2db-qW4A&oe=6ACD1847"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xtLwFeRo4YQ7kNvwE1uRGq&_nc_oc=AdrsF-v0Y_vhAXeNtV52rk9MockKc6Wg9_PjqK5ib7GbO6vCeY2t9KWM15mJmkQbKUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH-Q36oZOH--Ne0NBEvtQIGQ_Peu6EJLh8fHIsEx6ELA&oe=6ACCF52E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_2096457597880635_4085949622162510422_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c43EcVBZcUwQ7kNvwEtwQ0X&_nc_oc=AdqczLL4viUgqjmCCJ8FaQPOwvaqJrWbX0iE1eFz7kxK5VGPJ_vMMSfPlOBIBOFz7x4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf5bGIx59q1JkGKT4LpZXFBdNmyomu87ik3MPUNW-2mw&oe=6ACD10C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OGorilla", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
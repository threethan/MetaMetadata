9_2902685360959613076_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UliJ1TMu5SQQ7kNvwFBCvqN&_nc_oc=Adrz0i46lIrG8Jg0g0n1pp2b5uehSrGzGr1zlJ5Ll724oddzW8prKVK2-UzRI8CAKBc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgqL7URnyImQEEk56BLk2yoprdGnHGU-lQSJ1W5YOerQ&oe=6A8ACA6A"}, {"file_name": "caves.png", "id": "2430746977394165", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499295992_2430746980727498_7061109944920804783_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-9wnNNI8C8Q7kNvwFLMQ-w&_nc_oc=AdoUUHKmmEl5LaMGbqqi_-Q81ODLPT47NrwozICH36H24h4x9lRBOfMlKmz4-ioJGhU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUfm-8dUsF3zt9KgzHp50ELzQA3biKB_eovtfYgdLCMg&oe=6A8AE85B"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKy-1fAKCGgQ7kNvwGQQ1hk&_nc_oc=Adozn6dlQElT4XD8NT8HVsOi5G_GHBfre5zqZ2KbAMayiM0_uysBfkO8g_Sx7mZv_g0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH9SgDrcK_OCXJemh7-WmfY1hCblXXG5dGrOZSpvnqRA&oe=6A8AF507"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTH6j4Q-w_0Q7kNvwEoGHfQ&_nc_oc=Adr7T0RXJlG3tqoGBe0P3SW3-cmXtwAwnBi8-pP2U7NJgQPfIMf6RgJw8BuCd8zHqoU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOS5hgUwLhfqftb87O9M7XRfY7mm1Bmdgsau9NQbdbfw&oe=6A8AD1EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binar
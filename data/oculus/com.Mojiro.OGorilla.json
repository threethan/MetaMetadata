9_2902685360959613076_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRPpJY8GQE8Q7kNvwHO17fC&_nc_oc=Adp4eXoPcRWS5-z4K0H2xtatBZxnxoeEmZDrRb79NYbClr6YwQyctimssg7F7kM-yqQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sTnngnEkpKLJ81b9Kk5Ien3sMKzrWC_t-kzftfkX8vA&oe=6A32AE2A"}, {"file_name": "caves.png", "id": "2430746977394165", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295992_2430746980727498_7061109944920804783_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0_2PqwDbbMQ7kNvwHcGaIR&_nc_oc=AdrJF4UBDt_0VF0cdo4n7q96NvwplhN9m5j7z5wiCVbbPZEDz_ARWYfShhOAmkT52jI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_px2bdTV_ooyiqBmmxRLNLSOO-XRXeE92tEzwlrEBWfA&oe=6A3293DB"}, {"file_name": "forest2.png", "id": "1744079120111904", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303606_1744079123445237_1357455754314875737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_3E5ucGmd0Q7kNvwHVzQVH&_nc_oc=Adq7CIZ-OEoB8np5KiWMu8RSkH9zSASQvNnCU9ZBKj3GLXsqY-oq126N34h-MpcWMJY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VZvsaJ3fN--5ssQ0AErcC6sutVEsx0c11n3-gPU3npQ&oe=6A32A087"}, {"file_name": "stump.png", "id": "1320832140245964", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499295992_1320832143579297_8892062139741146974_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pMsbFKZv7cQ7kNvwExqoLS&_nc_oc=AdoiRjxUvSY_1YGKLyqgOttF4YFMR1XY2g1WkmgFehNDilZAnX6hYR4j8PGbQr2hs4k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MiGRj94ymkU6Xp8NVOSM5dJye27RQIEM0ggwI2-v28g&oe=6A32B5AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OGorilla", "keywords": [], "long_description": "OGorilla brings back the feeling of classic 2022\u20132023 VR hand-based locomotion games. Move exactly how you want using only your hands and arms, zero teleportation, no artificial movement, just pure skill-based locomotion.\n\nRun across maps, scale obstacles, launch yourself through the air, and master movement mechanics that reward practice and creativity. Whether you're looking for competitive gameplay or a place to hang out, OGorilla offers multiple ways to play.\n\nJoin friends and players from around the world in exciting game modes including:\n\n\u2022 Tag\n\u2022 Infection\n\u2022 Hunt\n\u2022 Casual Hangout\n\nChallenge yourself to become a movement expert, compete against skilled players, or simply relax and socialize in a fun VR environment. Every jump, climb, and escape is powered by your own movement and technique.\n\nIf you miss the early days of VR locomotion games, OGorilla is built to bring that experience back.\n", "short_description": "Experience the golden age of VR locomotion. Run, climb, and jump using only your hands while playing Tag, Infection, Hunt, and more with friends in OGorilla.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ogorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mojiro", "support_website_url": null, "website_url": "https://sites.google.com/view/ogorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1223008664224063"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554707182755042"}]}, "baseline_offer": {"id": "1554707182755042"}, "is_approved": true, "firstOf
e7a0a&_nc_ohc=CnqJU7JUICQQ7kNvwH9kO7F&_nc_oc=Adk0PNviDgqoXg6pQtR6ctgYUYB-PSKXtQsDtet0oxXKyMOsPV8ug15M-Xl-Z9bDU2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfweOplexxQzUglQB-MdJ4cDesfkxxILupCxIXP3mK_EPg&oe=69BE9DF0"}, {"file_name": "migrated_image.png", "id": "521236628814477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzuqdu4SSAAQ7kNvwE3GhiX&_nc_oc=AdlSCwPXUULQqpI4awpFAjsH5wAEfLOK1vdXpVrhUPp3rvS5gSj-inVmR968y8VT4sg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUWzGNojLi_8R5HE15drJ41E1jx5_VSR0Qpk1p2YRucg&oe=69BE7C92"}, {"file_name": "migrated_image.png", "id": "203584484257503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5ygyy-NTOkQ7kNvwHfkKvd&_nc_oc=Adntel85Gzu-2DSIu4l9S6gfLYLh3T2e1-qL52zLPtKqLcCVTN7OO_wHkP3HKtSyL5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJB09p45NkdExqy0EOkPlAC7G7_hgJ_SdlU3r47TPOTQ&oe=69BE9D6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!", "short_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364763448403512"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_250851755787804_6117847666639503360_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L4iklHhX2kQ7kNvwHyEWDD&_nc_oc=AdkYeowboxYqoV-_zzq0M2awJ4S8qUBbYTRPpgBFyvvbgA-IbgNpsTuYf16NBeOoxqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzL04F_N8H47zyIOSd5AH7JcBo9wczEIAG3HzLJq0JhHg&oe=69BE8D75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Minotaur", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1202169136531410", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1283593541663549", "is_first_party": false, "enables_in_app_ads": false, "is_concept": fal
_AQOm8SFLq6jGFCLrWU40stxMO9bTV8PW5unuPbsWU9oinQ&oe=6ACBA7B0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANG9-mtrtNwQ7kNvwFhtO_V&_nc_oc=AdpNRSKjCW8jEUQjGKxLrafAPF6vi8qopVNVd1D9YMcK_OqUQmt8l6eH_lqNtagahb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEa2vp9tK4ouuZIrqfXd4r5kQv5wJMw5t_7ItOW106Yg&oe=6ACBA6D2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KV-o3ZR0XgQ7kNvwH6JCcm&_nc_oc=Adpn-LeuB5qJwF9gEpty-MRjO6Xef9llGlI7WlX2oyQzNRC_NsZwhofMgkAWHtbkU5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-UWe-_rK1pdJpBreKOwDDkQvC0Cf2oYTsX4qclPoVuA&oe=6ACB8F6D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT3fjz6p8RYQ7kNvwHmplOF&_nc_oc=Adq5ka-D0AX5GN01OCoE7QAGu6XBXmD3ALrl0S7OQliT9bhFWCyFThvGo7lDovm41no&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOjj5mO3iAESKxbDSechAPzjxG3w0PvviytD1fS8BggQ&oe=6ACBBCAF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ems-YxRZbIQ7kNvwGIMs9h&_nc_oc=AdqOtVb3H6d-xci5ORRYKgQjoHJptdndcorYzwwczur-aTo_oDh2QNzCW6PwlQWBFJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM71CWzZ0-QO6raKoUw5nSLT8pdgUot-s5pZGgckSvF_g&oe=6ACBB430"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
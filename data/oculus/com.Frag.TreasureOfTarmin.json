_AQTy-xRRrnGbDWr0ON0-JMXan6Cwr-vD2hqyHmub-4Ygvg&oe=6AF48630"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUeNam_2y_AQ7kNvwHE8elu&_nc_oc=AdqLlY4iWHF_dG9MWeuWcSTkHNOtSbyo367vhwnzfInfpr-xVBVu2CC0GuYBeT1FX7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ94fS9BYlrBswBce9fLyLoEf4Pks-cqw_Stl6WNESvdQ&oe=6AF48552"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXGhb-Ifla4Q7kNvwE_ffpX&_nc_oc=AdrYCxl-Dnao2CjQLx9_10M9CSnUX6N_UGKFIPyVp4lmHiSp9N1ImxxuQxFLsd2YtfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTFJMcWzRLFMIbHp7ERoz6Rg7NRYnn6j4r8E4SiKC27A&oe=6AF4A62D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w-BDWF5zw4Q7kNvwE_18lE&_nc_oc=AdrjUBolmp_w0dObw8x7wdy7Dtg_Byu8LEL-HC5M6EC0tQt8hJMS1qDPcxncRBtp_Vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAK2BC6bsyb8EWx5pymSepyA4HGijOfE3gy3xSR2RtSw&oe=6AF49B2F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fodda0kpscoQ7kNvwGyvGQX&_nc_oc=Adoe2SFcOkz0SIJ1_NZ8RjBa-66Nt4XyYuIDElFRsZ4nVq7Xk083T4mvORV-_SDWnFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRoTuP1WIWToKixSY7QmYBosCo84IGRM6yyFApZ9DtYQ&oe=6AF492B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
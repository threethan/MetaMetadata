_AfxnAsh6Ots312h9mKg5fWwWpjI_d6UWTx9VIyntKMQoGw&oe=69D0F270"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkTrxyaqsq0Q7kNvwHqpRel&_nc_oc=AdozrDU45yeTO7QWtpFWqptZmyHobqYabTHKtJZ5AdrPhWxJwtKRI9SpY3sH8n97fRw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgqsLNMk5-qmwWaWN_yCpOXTfdZtiBbd6cI9Jen8DnzA&oe=69D0F192"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0xJoqh14MIQ7kNvwFikz-p&_nc_oc=AdonsLoIBBVZurFdgAed173YKVSi7n2tO1JtCy3p0pyYZEzGq2-8vuBd6cvLsdQTmfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlYNHfagq2yPUWiGZre0snB1m2EoyvQb5mnSOZ1kEVkA&oe=69D1126D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFu9mWCfXRAQ7kNvwFLxjni&_nc_oc=AdrtUei0PyMUi9flvXykACL2vE5NWkNcLntvoSBS8l7A0YXaEbrWe06yl2KwQvXPULw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGm2SBTvWJl9Wa5zvaEGeDR6q6otTybTIdaZkB9vUvdA&oe=69D1076F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AkpEzu47nQQ7kNvwEEVGXI&_nc_oc=Adp97Zq_Je7vZfwGPcBoEmAhBJntsqnFQsnutzn2PSYJu-oR2nzwL889yj2M8oPB22c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZCaKqA_uyoMz9NOMrag09Fc2ukTog7x1MGjqJZoKe1Q&oe=69D0FEF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
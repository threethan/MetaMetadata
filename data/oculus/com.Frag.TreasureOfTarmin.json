_AQK0SGGlaYXFfp0PdyBS9TdguZIJaDNdgL8xHMgz73rM2A&oe=6AA177B0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MVFvhYbv64Q7kNvwHAIpp7&_nc_oc=Adp8Gr4LjfkereEginqzuEcQ9h_Y4QfvaIe0kmYC-jBKdj_uefJPOZzyS319Cv9qoLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSBch5znRETEbQym5lJx4dgfeIGRb8KD5AkFQK1iivgg&oe=6AA176D2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlW9JnaRYcoQ7kNvwGXX_iA&_nc_oc=AdoSuwQ8f3MUSD9mkymtCvoDbTOvZocce22fGJR-OwjhEdwylVlqqENh82RggoOeHTg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDO19FlMFy_kjBN2ErmdI-eGNyC70Kc8jXkfvuWn6eaA&oe=6AA15F6D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd4yj1srXwoQ7kNvwHGh--j&_nc_oc=AdoargDsTeBKAqRpIzpOIE-LrKvBCzq8V_DWoTRlpJXQ195VZWBFmcGoYF6Xr1WeeLo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjsUo4J_e_1fT7FPiKQdhWcDLxndcaSW90x3_OmkgwoQ&oe=6AA1546F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx-n6-PREEEQ7kNvwFS3YqE&_nc_oc=Ado02A2-tsMSkj13FgT9Vmjoy_a3wEN52WYnM7GWlgBMnPZ_AlCYVQvmH3_vOYFZ714&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLQwWg_nmHJqSE50YffPoAln1HLH_gR--xPb-be8hNJA&oe=6AA14BF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
045888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geVwX2sdkloQ7kNvwHeEYwi&_nc_oc=AdrCBg2DQPQfVR7yJEAnOY1TIN_Z-JibQCtQ0yfNrqp8uAzIgPZAtDnQLYx1hUk1qOw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CpKAmXU8kSQNtKQdCMWp-jWEe4FL2eAEDDOEZld-xNQ&oe=6A393970"}, {"file_name": "migrated_image.png", "id": "521236628814477", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXjtiQe2kRwQ7kNvwE2aY02&_nc_oc=AdoN3LaYGaHna73F1g-Ig_oyQHXy4Gs1NeekF4wBOy8AwHih1ThYIEvSaRfpMvqjueY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1hw8RZ8zSMPICo-U2jcndeqmtJ36iTTF64GDNvgdNhA&oe=6A395052"}, {"file_name": "migrated_image.png", "id": "203584484257503", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSjSWyd5WooQ7kNvwHKOaKt&_nc_oc=Adra53HQZi4nD9AtlrW2ftwqsX4E3mkxQOvZ6ZXabEL0K8q49ub7QAqTgzZDU00nQnw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uru4p5BxBEK5X1uKpb1nmsrbOwFCNGbLTmCWhUorMqQ&oe=6A3938ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!", "
_AQCM6mcRHp5HrpgJ5QpJQ9taxIhpm6-n99SR-GpmvjaqHw&oe=6A53AF30"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb8isZr-MgAQ7kNvwFC6mUM&_nc_oc=AdoBaO5BSqaFchH9c3LUH1ysqCA_dBpREKusfKwW3eHSjrqsRSxwXYJ8tryXQutM2HI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWS_t2evJDv_ud16dlBygWPjRTK0jLesRa7gpRn60Jog&oe=6A53AE52"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwhDLo3x6QQQ7kNvwG16J6g&_nc_oc=AdoQ7_0_WCrrbAZkYKTw44zu4tiQ1P3-zd6ylwgJHEg6KhmmYc46_XpFoghzONYMHyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2Ln69e9JIw6oe_kKz8ljmhoJ440-o50FZDEYLeISA3Q&oe=6A5396ED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwZbQQqBszoQ7kNvwG8pLEl&_nc_oc=AdqtMbjTwUqLnJcReW1hS7P8g8Bv7qk3gXTqwoZt_rBMDpkCGKHe4Z1gEzgEfZV-o4s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlpP8S1qxcJLC83KmNduTalcBgD3nZnbV0C1092KEmPA&oe=6A538BEF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLfvAv2hIvoQ7kNvwG0V1EU&_nc_oc=AdpyNsLUt64mYe-14HI-udQUbaIkZm3UVeE0gIn7xCyyKz-5PQJdxNLNa7YE1OqpWwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHHlkck5hez1JQhk5ka1VG8pktsQlwF6DPnINoRwhlQw&oe=6A538370"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
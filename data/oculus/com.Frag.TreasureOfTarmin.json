_AQIxcZIu3pmPH3ci21GaFMO-Rt1oXplSxjoVGLav3v9yXQ&oe=6AAC03B0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srL5nlYYnPkQ7kNvwGBL_2Y&_nc_oc=AdqcXpQpWZe0HFLw7LzNHnn6WRMxv9mL-p34pRJojTDagnZpA-4uiGrp2DLCmgMdZSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzw0mF9-DeoCm53aT2wcSb_s06PQ6Q0Lay9-ECS6QecQ&oe=6AAC02D2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JD2ix2FIHUQ7kNvwFnMw8D&_nc_oc=Adq7aZBzh_5LJeI2wzEvizqNYW290QThmYz9g_B25fB1UhZWfnp_54JvlA1u3C18ifs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp4p4fMBKQ43IkdWCqurD9KyeJZFudMaUtH7urEdEtdw&oe=6AABEB6D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD8Z6Xt5gBIQ7kNvwGGrfp0&_nc_oc=AdrLaps-geGX2HLLUGnp65-6g68HLuDyrvsllUjqnL_mu4xmehiXm8F109JoO6G0hag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBCRy_vQ3mP3iO-swqeVsAwvnzKDC8-g8hQJRJV_5QoQ&oe=6AABE06F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FDhaklafPAQ7kNvwH8rc2w&_nc_oc=AdrYrGNeRES80LhU7vvR4IaOFGR-swQenEJ9XwZA9iUJgLttqj9sZNOeDZwkJQ8cEK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrwBnXJmPwJPJ7E93dMatzFT48jSDd7QkDx2pzDOlZbQ&oe=6AAC1030"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
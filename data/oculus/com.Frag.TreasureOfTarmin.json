ESu3Wiyw_Ca4Dq2sV9gyxhLkJaBcEac&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftv4vN-HcOilAIR6ZT9AIMf3c1ALkf4_WIBuEafBwtDww&oe=69A19CF0"}, {"file_name": "migrated_image.png", "id": "521236628814477", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvEWqRTQE_YQ7kNvwE58HCO&_nc_oc=Adl77cd_OetKZRbcluATsCBiEPwiHZOrbfnxCskjbi7SRhUqtTfIzXrBqzDpQTtV0K8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftFUj8De6A7W2S-hadF6o4y6jmzJXbQsRNiv_S2T-UuBw&oe=69A17B92"}, {"file_name": "migrated_image.png", "id": "203584484257503", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmphXFxWhN0Q7kNvwHyIuus&_nc_oc=AdkpP2BAIH8B99BHSMuq3k9dmkSgMbxW8YM2Mn9bCVUv00i8_ch6SrJWhRLsPoY2YdM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu1_rQwSCYhDq9hDUNPsmQp-IXPuB-BKx1sLuPl7MWcVA&oe=69A19C6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!", "short_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364763448403512"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974783_250851755787804_6117847666639503360_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjQhgxtD07YQ7kNvwEfhj90&_nc_oc=Adn_S0xvEnP8hmp690GgddJmfxTe5asuYTj0_Xg4dtv0h3qAowLv8ousc72cHZFe9Qc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu4r_IT_gTB4hT4HlcnC2ExVLEf5pnJftTCRsDfmFLVVw&oe=69A18C75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Minotaur", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1202169136531410", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1283593541663549", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1131164643648696"}, "iarc_email": null, "msrp": null, "translations"
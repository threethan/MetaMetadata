_AQDkrP2uA0TzFDhV4m2XOnFwpU5oJmYqmsbHLlnquz8Bfw&oe=6A5500B0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_DQbtyFzRYQ7kNvwGS6_1P&_nc_oc=AdpZfp1MOyK6u4IcZjjxbBC5jrk4md4Ar6uuM9WMS-AY3d_9SINJgoGyFlXfK2_LEIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDyHexbZhub3at9A5i3mIf1KFaE62Yfc1iRTTkEAZRbg&oe=6A54FFD2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwhDLo3x6QQQ7kNvwGUgGKi&_nc_oc=AdqdE2t-39xNw37pBK9iMUASnok_T0iL-7TfCsIfzeyeUbGCZygqLer2HwjOOxrL2js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMxwdJPEHHU6Epq53QmbnCf6ZNcz8VGXdguXG3Vs-j5Q&oe=6A54E86D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwZbQQqBszoQ7kNvwGVkBz_&_nc_oc=Adq4OXzX8dpptu5Y81jx40ysqNjD4-JzmIdYgy7AvQBeyAsj0Ez3BaBnq4cd08g2ApQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbip6zjxX2CG-B4_1AlQjb2x4vXyjhOPTnxTACfwAiCA&oe=6A54DD6F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m5CUult7usQ7kNvwFMqFL4&_nc_oc=AdpwP9UHo6IrHl5W-fIwxMhDMXmXed2ltGrU-Z1v3R0ux5KFTzAxnQ3CFddLrgR2iFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkgXrMeGJi88WMVRXeb8h0KCfMtJdU1BRKGpJtNqWw3g&oe=6A54D4F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
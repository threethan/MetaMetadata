_AQF9DMGu_dxZqjEIeTfdNFf0ngSt70n59nYEC_W1Q2n7eg&oe=6A941070"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_R813jkvw4Q7kNvwH45Szo&_nc_oc=AdrHcr7j20-WJ7Mj8UovfjYiZYrqgxPb7UZMrRXIrpAb995qUBYUQlSQIZFw4QsjCJg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLl3nASCzuwr4-n30kilAaUcEClYIUa2pcCzCW9gPvAw&oe=6A940F92"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6-0cPepKLMQ7kNvwE5Eyjj&_nc_oc=AdqohC1SGd_A82LrEE1RhZqWDpSrwQndHSHBnafgFDZr_0qX9KaM-f4y-2VJ9CiXbWw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3ue7aY7qzM0tvZIAFxU09qiiIF6S6i-qMrEpPfTmBCg&oe=6A94306D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9utdy5n8wsoQ7kNvwGWleDN&_nc_oc=AdrYOs242LfhQ4YJGpSfGvT4gyGtEVe0jNG_CNHzDOgP6mErq26L-a04l-NG21eEtKM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlQMzNLfGgSur0PNY_4LNOIa5qxFnYwqyr8W88gTAofg&oe=6A94256F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B8Fm0E4vzMQ7kNvwGa2wTm&_nc_oc=Adqm9_3fmlxX9fBbPU8Ij17chc8CNk7Rz9J2MRxvzRkP-jdzTTg68K574EpsnigGvhA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEw63NHkNEohbqyzfk1X5YphB9-6QJpZG7QTGvDNHxBA&oe=6A941CF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
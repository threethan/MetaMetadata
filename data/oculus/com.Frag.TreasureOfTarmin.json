e7a0a&_nc_ohc=nklYpVtbZPcQ7kNvwHT2lJc&_nc_oc=AdmX6PYNkx_ElMJykBjmPawGrMFpfq8SxJhy17cLJZ3sa2hAPlZIZM1XLzM40taYLdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvScqsHVx1Gh6h75jlhMtXLvlYeoby3RpBrKWLSSyaMsQ&oe=69A985F0"}, {"file_name": "migrated_image.png", "id": "521236628814477", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnBH586L2KAQ7kNvwH55XVD&_nc_oc=Adn65MHhoSBDTDTnzwZJXkaT-WpH4Rx23xoLXQInPc_z7nQKj3yzQ0gBZJgqN-UPis0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft6F5eVTPmFnAiaGU0gH43espssF0V3FIZTUFZ8F1oLbA&oe=69A96492"}, {"file_name": "migrated_image.png", "id": "203584484257503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8axYgLu5gIQ7kNvwGQM1Jv&_nc_oc=AdkqSr4V6PyiVyMIsLUNHRJWnz1kt7Rvsq-MLcbI0s49vKcBPrpAVFsQoTSADgpNB-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvH6hwYwp6sx8GlE2Yk92rRqv__Mv6B6ahpLRjo23ZdPQ&oe=69A9856D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!", "short_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364763448403512"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974783_250851755787804_6117847666639503360_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsxhqq0zRjIQ7kNvwEvPcg6&_nc_oc=Adl-36ZyJBNzvflgbfhUUMh_uTS0xjkhDpWq6AyZ5vWhAWpC3Ea-N_InI90IcX8Ihss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu91_t_gNr_tXYCW3AbqJrFaH5VtXtG2XvYzvA86w40Ig&oe=69A97575"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Minotaur", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1202169136531410", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1283593541663549", "is_first_party": false, "enables_in_app_ads": false, "is_concept": fal
ed_image.png", "id": "685233455617798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnBH586L2KAQ7kNvwH55XVD&_nc_oc=Adn65MHhoSBDTDTnzwZJXkaT-WpH4Rx23xoLXQInPc_z7nQKj3yzQ0gBZJgqN-UPis0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft6F5eVTPmFnAiaGU0gH43espssF0V3FIZTUFZ8F1oLbA&oe=69A96492"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8axYgLu5gIQ7kNvwGQM1Jv&_nc_oc=AdkqSr4V6PyiVyMIsLUNHRJWnz1kt7Rvsq-MLcbI0s49vKcBPrpAVFsQoTSADgpNB-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvH6hwYwp6sx8GlE2Yk92rRqv__Mv6B6ahpLRjo23ZdPQ&oe=69A9856D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK-rjrrbPNoQ7kNvwF14Ugn&_nc_oc=AdkfWj8LKui2Pok3m_ig3oas_HysPdbBQikqhdIbiFbRYLgx0W1Vd1-ElZ6T_Kgq-MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKa0ePmLLfycnNxmWXWMexFsL6DKFgrtqNS-FFeaz1xg&oe=69A97A6F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-h965leVd0Q7kNvwEgqkEj&_nc_oc=AdlFJUlti0TKGUWuMsElgFBvI-4t_zIn_7kTQXrUPtrVEMq9vrAPvAGyjSFS3imKp-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJcWbbCbOKzCrQJZXbHjpggzttMi6dSCm_2iUBX8dbHg&oe=69A971F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
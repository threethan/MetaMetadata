_AQSZmKt6BVPdbyesJoaf1D9mpOCJq4TiYM3woYYh8o2qkA&oe=6AF9CC30"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8NGEgDXKKkQ7kNvwGtEw_R&_nc_oc=Adq_tYU9fVS8Y4m_t6RlEg7EM764nxNF64mP-zedYfrj3casn0tO_eyqZwQjwaMA8yk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLcG93-DnFpM-KIZJoxMVnZgA6QMEYwaibJnYBG4o09A&oe=6AF9CB52"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bm8siVduTIQ7kNvwFsQhx6&_nc_oc=AdpiOEmgJDoWolgZbUtGsA1Pj7qvgvzT0yP7zOf8bxX-dUimDNkRLxidSLqr4rlu9cY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMgfMx22OfiCkdFKajfIVmQKpKLBFuognU0_JZlCEvQg&oe=6AF9EC2D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRujYKJpU4cQ7kNvwEpCUQY&_nc_oc=AdqAnhDZBj_qR8ove0XAUcSI1h0czpN0Lce6xuBy2OsCTDn6zlXHRZVvuR-AUeZgVJY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN2ZSG5BTP7XG5AcXYTEvQz5C1oP47Uy_6qV3iiHafew&oe=6AF9E12F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oczKuOtOwu8Q7kNvwGBkgwW&_nc_oc=AdoCWwIfHqM0Qyacbl_RXA-3g3FN6T55yzK4qn6jkpQ0qQGvn3i7RXFhOO3apdJT1ZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEMS65s3tUq6SUaC4_ao-iHYmAolnMUa9MbwXiBddbhw&oe=6AF9D8B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
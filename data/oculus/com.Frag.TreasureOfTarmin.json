ed_image.png", "id": "685233455617798", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOvBW9_Ae1wQ7kNvwH-sgVD&_nc_oc=AdnuU8lOud9bkNhPasiKenuQm4GxPblVGtgeKv6LRh417fKBwQjRAzrp4I3ItiL3ZyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwIqxpmVmvSfXHSm9OQZohl1V0RAaDeiIdJcMfx6SoBcQ&oe=69AC0792"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8axYgLu5gIQ7kNvwHRkTSm&_nc_oc=Admpy4xXO9FlwOwQXcRktCTG6NrhzFCdfcPtPXmCTFPXXByrDlTTFLk1HrF4w9wPS0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeV4922aAPhtCoxILLNr-vQk0tUBgLv99PVtALUVSSIA&oe=69AC286D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK-rjrrbPNoQ7kNvwEcg09U&_nc_oc=AdkRl7Fge95PdG1wEVDJvpx3Z3MQ5aN7L-JYCzv1CrHSpqpf63DJMr4vM7ujVPpZuog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjjGVTXO7QJoPn69oHx2cZDBiFHAycNqX898tSD7nAZA&oe=69AC1D6F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3LVqy-lKCkQ7kNvwH8jcQc&_nc_oc=AdkF3A4vgVmMorZJOrFsej-6AeE2WZJIutRynZnlOny9SnqpX9xEhRNDksupYxMy9cY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycG1lVfenTVD3LYk5U7xVHTcjZ2LH4SB7VDjgG--t8Ew&oe=69AC14F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
_Af-FW_VsD6pdJIWixhZsWl8OiKXrTuXPzfB2ohyHFpMXig&oe=6A243930"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuiS5C8I88oQ7kNvwEIp8Id&_nc_oc=AdrD3tVSYM65kKjX9ZDeLLsnZIbmhbhOe-6IVzxxIfuCiPuO7qahZTRMOw48iiVYybg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PuDNxc542NsDKPc-l7nJ5bPSCHWGRlZQlCp4BPXWIJw&oe=6A243852"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5ukXDDIEGUQ7kNvwH4jo9a&_nc_oc=AdrO0q43BFPdefFlJI2OGDSmZfwisWFMLBYkHv7Yt0hSNhWbI7jQGlvJ1FczUU9Z7Nc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GN4iXjs0V1V2rcgwHTxU98em2L0RrMu4xV-iZBr-ZCQ&oe=6A2420ED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pAAK3bN5L4Q7kNvwHRQ4a5&_nc_oc=AdoUOojsy2lmKf_-diPuae7IBi1wQHQzO1UHRAE2wA4daybsMvozsfEnJP9DI_ja9Rc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bojs8jRDPBg5yGUnOqDhkwom9RfxCpYHGe-f2Y-lGhQ&oe=6A2415EF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW4-VBcPOxAQ7kNvwEZzg7n&_nc_oc=AdoBJfa4SE6Xg2mAoPLyZYQDb9_rMvcvsuJteXxQL6dRkjpR6Xcwgr37d_y8igDJZR0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b350YePNNkqYK5_r997ar1VotAkXY1cXVQinQFQaFWg&oe=6A2445B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
_AQHG16JKJAwq601WaEwt7U4lLqXaUjwaxvqCjLAz3kw76w&oe=6A7B3C30"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PotmZLwGxsQ7kNvwHjnR_R&_nc_oc=AdptNWHM9AqadItzPYP78mf4zYxc_ad5LXV63w2FL1HxsrF5NGybJGlLnfhyvl00t_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcrpzu9-edTWoD1zXmu-Rz7jfgO7Z4ZW0x9gjEaJlqVA&oe=6A7B3B52"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKpns7Hdgo4Q7kNvwFIDQ6N&_nc_oc=AdrdwYF5UpH9Z-x1ylTcVfk0UPqbgvmdEfg5j5V0WSEVpQydrVT04K-6DU1RDQs9mMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGocMzQRaB3vofhVa0xEyn0FuMV1-YczgwXtiK4WJrDyw&oe=6A7B23ED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy5siMWHOo4Q7kNvwHB205f&_nc_oc=Adq3tki2A-LpJJ5VibGCaWdLjZyxb-_M4NTq3CAP7TvlVBflLdpUPYVKniSLFa__7tU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE07biulLYkWiWtyboL8Qq_iB2Wn2Atvr3Smdm2GObvnQ&oe=6A7B18EF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0zi3TCMhrIQ7kNvwFGabf3&_nc_oc=Adrv0Xz41yrzTbpLyaExFCcpuXG1nvb0PSFNIXQ-waUNI4KIc5fwlGr8iUQmildeC6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUcV8jQ0_DVmcjn0Lx4KcXbDwlkCv7Jq95h49gl3TZ1w&oe=6A7B1070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
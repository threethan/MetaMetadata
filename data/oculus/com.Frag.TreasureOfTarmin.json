_Af3GMMDwNeNXQPrbYnMNrYYQ20FTKtzRWFVM_du9kucQfQ&oe=69EA3730"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQwC-GA9R90Q7kNvwGFhF_d&_nc_oc=AdqCU80obFsjHB--TicEWkkchtXFRs_NIQRILj8tPfj0_z0-UG6yZZ0gM689gPAHflQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CekjuJUxci2-vVEFBAVHAWWXv57xW0gMukeKti9M6Uw&oe=69EA3652"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAqlXZ2s4eIQ7kNvwER88DQ&_nc_oc=Adod28IpbQY7ruUIFq-8KdE39VvhpGXNcbfHVQmKg6e-203Jg4bW2hiLGLi0YtEF3Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e-Y_-A6Dvmac0Bb--07qn-dYFzvbGLLRxPktSnUWEZQ&oe=69EA1EED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtNYO5jiTe0Q7kNvwFWZGt4&_nc_oc=AdqjyG0wnl2dYuaVCs5hi3hkCpPFUas3zI6BCubzOQI4leu8uvizA2Xb8s90E7kOKJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SpqPKwex8LOtr1iNfNYGerBN9bb1k7BWG_TyP4k1_uw&oe=69EA13EF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1h4348LMGsQ7kNvwF6cEac&_nc_oc=AdpBq6p84bHcPa-DkgiA753bAxq8j7vqpOJqfauDDR3aGKS_x47oK7o7LAPPJ_KpPaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2azWvEjlgf0YgtIkSOD59C1058CCEXOVkeaUBoVqEVyA&oe=69EA0B70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
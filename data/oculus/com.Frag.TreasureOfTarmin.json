_Af1a1UeWuV_QfQiezeJSIxPoeNSFGTsOu76M_qDWrv0Cdg&oe=69F371B0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O9CX_jm2dAQ7kNvwHfoxJc&_nc_oc=Ado5y2dUtUn38A_AwSIeEq-5IzZoJIB_gNsukKGme4bBg_X5jPgDzpgnHfm2tF-mwmw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gXqB1vjqamHyB_ubAOIqc1q3GPqtmG_BzP31BMbO0Lg&oe=69F370D2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3mjndN8qSoQ7kNvwHagS5f&_nc_oc=AdoB_YlwQrKD2c4udvECcgJLx9uN3vH9RlD7Ewh8-WWVgfdP0lIe8iXqPrYCqe7iAEs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tA99ziOMEtoIXggpdJq8X9z3LtjTG5wScHH5tROjAWw&oe=69F3596D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEyi2sCUfssQ7kNvwEbXPgb&_nc_oc=AdoEgOQdNYCKF9OYu71bxXeSYB1mvuE7DfEhiY2mgqnGR5hJM2LyU4dm7cU2ptTF_20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sy4oarJVxBynYwpb9-Mfx48q1YMfemLNSYt1mjbI2FA&oe=69F34E6F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiZTisUqZBYQ7kNvwGSgGWh&_nc_oc=Adq8VTQ1Gf-S3opsV1-ltX0EhVzQU1mzzHwDX5G6uR2t92J8iEJASz8m5EAuZIwvjJI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0enRz6nTC8lg0iCIDYn9Q0vKptN-Zl89XSnFXn6ALjNQ&oe=69F345F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
_AfyKAITmwI-ASazlzDPI3vcR_53YZaZjr4mS5P095LDSYg&oe=69C271F0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RyCN5dHzBQQ7kNvwHZVoak&_nc_oc=AdrhkZ8ZTKwd067C3r6CiKsFYc00IPjL5cm1iYQ9kO9jCpiaPH2ueE1r3yupL-eS9-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyd6wlwhme36ZmaFHTJTiuMDbDIPoYt7EqRpgPnDVRDQ&oe=69C27112"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIJhQlz4CNcQ7kNvwGEerIn&_nc_oc=AdrTSf9j6BHBbeeE4IIr0VkxphkaoF81uDWPpqsNa6Sdbsv88lRed5Npt17-f0tNB48&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJRH_IY3cBWDh4Ji3YCCrheLCQNRxFT39lY8sWYszZnA&oe=69C291ED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff62D6CzIM8Q7kNvwGCwobe&_nc_oc=AdodQysNIL2KQIZDfUa_OVtj5JkN-sSrfDkjYkYO7QWx3FZMT8FLTGwf5hFnsZOLolw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLJT4gjX-45-L9UjRuB6Wlytvn0bDB4S3GqxchTdCBPg&oe=69C286EF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFsC_ExGa8sQ7kNvwH3xgVz&_nc_oc=AdokysvEmuqjFpthAVDXdf9SKX2Vx8didOvJ6adZ5g0GdpbN0_3TKIBwP0vJl2Y58J4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRKwPvgQFPi36NL5GJnA1kEq5jZSnDHYhhk_TNOO0yFw&oe=69C27E70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
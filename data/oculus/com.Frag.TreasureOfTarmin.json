kV2fNICRtoMWKDvRs-LLeLamZIr_Uuw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftVnZLKjJtbCX4N93kOBEmLhAUhwRZCLCtaftx5x0QpvA&oe=69A59170"}, {"file_name": "migrated_image.png", "id": "521236628814477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_2F7M2r5lcQ7kNvwGhi2Q3&_nc_oc=AdkiEWslInrF9DwGa5YMJlZRSWFSzrJZS_0yhrAji1MhYp6StH8bSEn27jjB-iQejY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afujnx6sf_OWFUB01MdrLf9S_Kkeb6_iqe1wemgqt0KErQ&oe=69A57012"}, {"file_name": "migrated_image.png", "id": "203584484257503", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iViX2V1wgWMQ7kNvwHKLPLI&_nc_oc=AdldTBcHD4NnzfHNRJNZuKeRmmoU78Cllh7baFHzpREZH1iGp_sZK35EpDxO4mqJrEI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftkBMhEwNLabOnHZpHgmdtlumC8i1qFtBW3hAZSzdaRSQ&oe=69A590ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!", "short_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364763448403512"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_250851755787804_6117847666639503360_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTV4Mmdq_v0Q7kNvwEU33MX&_nc_oc=AdkdR0mLNd9VqvNVpZC2Brg_tQBaqjhWXgb6D6rIf-Yzr07aN1GSGVBRexVTg-MBZ9I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftIa1QvUGBll1CaFvOojxF0aUlipK8fDm40wSBroX1SxA&oe=69A580F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Minotaur", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1202169136531410", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1283593541663549", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1131164643648696"}, "iarc_email": null, "msrp": null, "translations"
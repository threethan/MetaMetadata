_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0j5HbLCtE8Q7kNvwE4odu8&_nc_oc=AdrBNXMJUVjOxnzwTIiGvpFyu_UvPuT31SGpAZmqZDkaJJMULLfFjs8ku-tydkJ2GfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GsvVRAGr0xP4h6Xad-1jPofGdd5ZUML8_SZBL1mwxWA&oe=6A199570"}, {"file_name": "migrated_image.png", "id": "521236628814477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60ZuZ0o4l4oQ7kNvwG2B66Z&_nc_oc=Adr4pZuVdhjGbtiEySNzlzClGDRcbcnY6ReF3xag-TN8Pyo3S1pT5d2Oo0DVgEMgNqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Do7yrO7Z7Lc67oVObl4y8Vx3LgzFNJjXjbfga8_wDhQ&oe=6A19AC52"}, {"file_name": "migrated_image.png", "id": "203584484257503", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFGYtzsK1TcQ7kNvwF98jKH&_nc_oc=AdrNUNjhUhCSCayEyzkKxqKde427S7iKb4D7BAdM3cKI78G9KuEgq1Ga0Idqareo0XE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DmR0aVtFYl8zhW5kYmXLt92IiW_Ac-wI1Gv0NuCNdpQ&oe=6A1994ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!", "short_description": "100% Gaze Gameplay. DO NOT use a controller for best experience. LOOK FORWARD when STARTING/USING GATES OR LADDERS or on death. Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364763448403512"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974783_250851755787804_6117847666639503360_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_rE0Ei2GusQ7kNvwEBSj3N&_nc_oc=AdrZJgT8Ze90C61Er8KL8sS7LCfC7DQRlyAxhnav7p-dkKOA-kb7rD5HRhtWNvfTERI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qbvJaaf1I14o0j3H3TEzgmQSWb8lkV4e2v5Ww0E3cbg&oe=6A1984F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Minotaur", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1202169136531410", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1283593541663549", "is_first_party": f
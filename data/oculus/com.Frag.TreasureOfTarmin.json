_AQIqgE58dveLEa8HrcLB6FM7K0CItWm8mQcMh-hjA_4J-g&oe=6AB932B0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUc2vmSKoREQ7kNvwHf-sxR&_nc_oc=AdraRNwC2bE6CW5iCW5ViZEzCrtb9mJgxDd8OTrh6BsY9vqw3gJ9ib4pW9pbRHEH8B0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkdZ1eDcoGnOx784iExVWJ_0p8honj_x_v37NbcaTijA&oe=6AB931D2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlhOtl-2ByUQ7kNvwGMSe2A&_nc_oc=AdrWppzGwTf7AYRo8GS4SRvQFQBM4YqeUJPnb8GRBnT9_vv3rrOUvdAfUjEaFXQruAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmgKvKDVZfpItQU1_o-mdPittrPab6yvNkKjFpUMiT1w&oe=6AB91A6D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wx81oZI29sQ7kNvwF1o0ba&_nc_oc=Adqrc6DwMsDZQpR1RvTTR8D8-H1MEAG1_GJPuPwQ7Px-d3ukDS97e2a6gFyNdl8kBto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2UJqUJk4utbY2sTIQSiPU4PwAnqOp1FDateio18-uaw&oe=6AB90F6F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO0ljz9DtvAQ7kNvwHa4OqT&_nc_oc=AdomUMRmF76CQE5eS7nCy1ELC1hRp2Zn_GGZb7Hya0xVxHljRpHn6MDTD_euGSC55nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK26baCLUlIdlTfjpe1lk9XQQ0C6kmEGgqJLShkByWHtg&oe=6AB93F30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
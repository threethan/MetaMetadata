_Af-Y_UNwgNmuYqYV5lHPOiWF1G-ftcp9kmDbjAAeDVw5bQ&oe=6A219630"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuiS5C8I88oQ7kNvwEb3Bnk&_nc_oc=AdoqEkmO4w7mMugIvNUNAHCtwAKoPEUTuP3csZKPzxgA47I_MbpLoYxnxVAmmCJgaU0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u4F5wnAryIo-vlwwrP7P7XqnytWg8Juy4iW1PPj1isg&oe=6A219552"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Ej_n_MxugQ7kNvwFwz0cy&_nc_oc=Adqw7-J5JJJJS3Qvq7sFIsr4nQm--Fx7Y6eyspD1uxkHX2tm_4njBzVgr2_fGUy5lOY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tBezwI25Oa2aLnyB8BW2c1CHSiwD8KRw2XtNvC0YxGw&oe=6A217DED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-j_7PFhjtEQ7kNvwEXfZhY&_nc_oc=AdrycRxWqqT9MG_j1ImenwMce4eGdN4ErZJMTV_YPZvsl84Vak-cmuVW_SUc8eDhbNA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8EX67EDLB96DYv8_XqNGnIKZWw2tFG-1NCmnUaRhPOw&oe=6A2172EF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW4-VBcPOxAQ7kNvwEC6CNY&_nc_oc=AdqFSKGhtjbSrHEUDrTdjFluiUsDZ5dkCA0j1KJD0ZHbngFOWB0Ny_67h2vPzT0SNSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b4kWm9oDVh0rH4pXVrLUDHhlRZMtGSLU4lczOaE0xyw&oe=6A21A2B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
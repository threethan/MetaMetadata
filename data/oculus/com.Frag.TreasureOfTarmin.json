_Af53RRW5VAkQ84ZgugvZ2b7JchZ-6NGlhOTZcxh70ns4eg&oe=69FB5AB0"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPg-xvpYz7EQ7kNvwEeheQr&_nc_oc=AdoKHzSc-LTVkYnF4gugqMNpvnpXmqDB5yZ5V4zJCc_lC1w9f8G_2ZSuI93V1ZlE20w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tz8BjKl7Zpf90loPH-A3Hxj4A0peogeZHK7o1pIsctQ&oe=69FB59D2"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86e37LI8oL0Q7kNvwHWE8Lv&_nc_oc=AdpxLb2dInF9uOYzs3KXYUi5a1Eq3Z4cS_dwslPoUkEmYJFUjiuCsYKU8PxDMxiKya0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UXc-icJNB5lwRthjJCxTB8f7Nz_rM9wLd9n88ifN9Pg&oe=69FB426D"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26oJI9_J_5IQ7kNvwHLfSrn&_nc_oc=AdpbcK2ApGVw6vK2zs6UYQNIZJPOPs4VXTY-p8FsiRXDYtaXS3bW5g1iMzOtjjpJ_mI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UF2Du6mvdP5NRV9h3wp_DpT6mmNBlob6mzJmGXmOGyQ&oe=69FB376F"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry0WzErDWqQQ7kNvwE8japM&_nc_oc=AdpCBRm05S63gp4hUcUXA5SmC3vTfKdqP8eT-1jGwkbIridq00_u_Rr7BaHSvywumrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yE6_7MfL9yB3NDPMmu5iZs7lX7JpkU9vGVkDuwfkh1A&oe=69FB2EF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
_Af72agnKdOfzFmphdOxjAGRu-Q4NbMzTKvZpqp6uf99Uag&oe=6A09DB30"}, {"file_name": "migrated_image.png", "id": "685233455617798", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12727760_1275128329201073_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2dp4yShwAUQ7kNvwHOvD6B&_nc_oc=AdqVCN5O5F_ESyQwZk0A4PNEnxJ2ankdwxm8FmwwsW-yUkJyrXSK5mlg96uYyscWTZQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JMiQ3N8VG7NPPp01yeIH-B0wCI_vlmjSEd0t6Y-SSAQ&oe=6A09DA52"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQLNOAn5TIkQ7kNvwFYrWRR&_nc_oc=AdqerVGCUvgCxbC_PK_cUEZGBz4CRIHyWFqt9luwiERa2Hex0-n6bfd6w5o8ikxNi10&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b9Ore-Gy16wC7VMK6n01pZLzmAQYbRzn_Ob_7lyCBrw&oe=6A09C2ED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1ljHQ3gyG4Q7kNvwFNFmM6&_nc_oc=Ado2HEahp7n_H3dbZqXub_H4K_7qsP5f3UoU8rSWoMWqwvM1m0hpIKzIJVvcG96TGP8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gIpv-7IAmVLsYfHfHPEjq2B1FhbWzicnyGIkBPQ13DQ&oe=6A09B7EF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIly_JFeW-MQ7kNvwERFCDH&_nc_oc=Adq10Wio394VJOPhRvTCaptA8PVPuVBnyXGihHBx3umvpuf_StxC8HkZKk9EtS0A5NY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GGqHjPr5dhsCEqRvsA2qZbxq2ZxpYFtlwNR1bM2PJvQ&oe=6A09AF70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
3_8477577083600502784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O9CX_jm2dAQ7kNvwEgr9gz&_nc_oc=Adq4Zp84870JBIdEY1oa1oAYfJ2Ws9hntCDRZ1RTEDYNL_L0H8xh6yCX1Mq1l2BPF_g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1LoX6SFA256QWcgBwu_CqFAtMJFO-Mi3rCTRSDL8lCgg&oe=69F1E712"}, {"file_name": "migrated_image.png", "id": "673153123432514", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427564_1790770681250039_3982797704148287488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3mjndN8qSoQ7kNvwENs3Ft&_nc_oc=Adpf1Re3A7W5lwcuqQv0RCnolUxhuaNIpZA2tGzl5ZMJm6pnpVnnO7njyzuHgc5meho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2ptT53M-w5AhpZqgYh8a-O1G07uTEWMPXQaOR3PpuEPA&oe=69F207ED"}, {"file_name": "migrated_image.png", "id": "255756955430744", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12727760_235424126929311_8023777436174909440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEyi2sCUfssQ7kNvwFk1JHN&_nc_oc=AdoGWEdASvTdRVm94ZcFgSss-18xdxTWQw_OWednMljRIPZaF3JySQN4E7MzLt0zIJc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0wxJ55Zvlv8JITcCXRDMF4vJXMQN-Tdb8HNtaixfAg_A&oe=69F1FCEF"}, {"file_name": "migrated_image.png", "id": "203453367551291", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533842_398864420484992_553361065270837248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbpPJ971hR4Q7kNvwEAfBYj&_nc_oc=AdrWhBOIp545dtLbkgKRvOCAJJha-6vdcvKYDU_90frj3Xr18s9FMj7iDMQbwBfqWIk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af36pln7ArUCR4bSk4k6khJuJKri7imRt-OBSjvUQO4a_w&oe=69F1F470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Minotaur", "keywords": ["Retro", "Intellivision", "Classic", "RPG", "Adventure"], "long_description": "ALONE in a deep web of endless rooms and corridors...you move on toward DEEPER PATHWAYS...beyond which the TREASURE can be found. Yet you know the DEVOURING MINOTAUR awaits you...at the end of your quest. You proceed cautiously through ILL-OMENED GATES and LADDERS and even HIDDEN DOORS. You bump into all kinds of combat and spiritual objects, some of which give you STRANGE POWERS when collected and then used. Your pack can only contain up to 6 objects. So it's up to you to OUTSMART the EVIL FORCES...and GRAB the LOOT!\n\nTouchpad Controls:\nSwipe Forward/Back/Up/Down = Move Forward/Back/Left/Right\n\nController:\nRight Joystick to control movement\nSingle A or \"1\" button to pick up/use/swap items or attack\nDouble A or \"1\" button to use doors/ladders or gates\n\n* Keep you head straight when starting game or moving between levels or mazes. Updates every 2 weeks.", "short_description": "Remember the 80's? Enjoy this VR port of a classic RPG from the Intellivision console. We have licensed all your favorite titles from the CLASSIC Intellivision library of games & will develop VR ports over time. This build has unlimited procedural mazes for exploration, exciting combat & cool treasures. Due to translating this title to VR, gameplay may differ slightly from the original.\n\nPlease provide your feedback to improve this title and all future Intellivision game development."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.solomonslair.com/privacy.html", "developer_terms_of_service_url": "http://www.solomonslair.com/terms.html", "publisher_name": "RetrovisionVR", "support_website_url": null, "website_url": "http://www.solomonslair.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "FIGHTING", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported
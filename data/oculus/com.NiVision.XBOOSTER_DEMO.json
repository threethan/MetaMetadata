g3c2UX0ii2gBvyQBQ&oe=69A02EAB"}, {"file_name": "scr_2.png", "id": "478084063581508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_478084066914841_7574135440889036949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiQ4IJNCYkcQ7kNvwEDSC-j&_nc_oc=AdlfsS6ksuNXC9AzsQq5BkLoqln2Xdx6stTitboBd7Ep-QbUDdIudB-dUs3---eIzZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBdEVDO7X5d7b3lq1NIiO_o9ZDnA0WyhY2b-s1wqSpYw&oe=69A03A5F"}, {"file_name": "scr_1.png", "id": "2062074523923454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_2062074527256787_301239079180693449_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejvAZnUBSfgQ7kNvwHqzCzY&_nc_oc=AdlIFo7pMtT84JlkipaCU1ElK28wcrX7GJtd_X308IWMCLHte-3fuaN2LWWg3fMEm8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6CRIfXNoAheQVEy0C4J389Ih5pDn1CJcKd_577kka2w&oe=69A04DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_splash.png", "id": "2385733884896368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031609_2385733888229701_1887006760644483219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNwfN9VKOl4Q7kNvwE0o9L_&_nc_oc=AdnHfjn1fszpibm8Yu-xpa0CQ_pmcxt6KILOkScnrqDQse8HdnYsjQhYIyLueGDZT5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuh53MCcI8YO9VvUNLUWTRTiBAaP9IO8-RsyjmctEXwaA&oe=69A0435E"}, "display_name": "X-Fitness DEMO", "keywords": [], "long_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout!\nSelect any of our handcrafted original tracks to get your groove on to and start burning those calories!\nWant to jam out to your own set of tunes? \nNo problem, X-Fitness supports your own MP3 files as well. \n\nStand and fight off the pounds in the virtual arena! \nPunch, cut, block, and dodge your way to a slimmer you.\nHit all the beats by moving fast and aiming precise blows with your gloves.\nGrab projectiles by using the shield. \nAvoid obstacles by bending and dodging.\n\nSpeed and strength are also a factor. Punch as hard as you can to get the highest score!\nExtensive statistics show your results and progress. \nMatch the training level to your personal skills: \n - warm-up or train with your favorite workout, \n - for challenges choose the most intense mode, \n - or create your own training and go at your own pace.", "short_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout! \nStand and fight off the pounds in the virtual arena. Punch, cut, block, and dodge your way to a slimmer you! Start burning those calories with handcrafted tracks or your own MP3 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/xboostercommunity", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "zh_CN", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1590330961319455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001686_1004619550399572_4255360142482291152_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhELfVVPblgQ7kNvwFWMmpd&_nc_oc=Adlesb1wn7dgJ_w_DjhHsnyNDwgMThijU-t1Cv9RqDrWChtTL7uCH880gKE0WMYeuhY&_nc_zt=3&_nc_ht=scont
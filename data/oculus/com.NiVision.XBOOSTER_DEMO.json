07107946700595", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031322_907107950033928_2161283847196508593_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWGuHVseftwQ7kNvwGHLrEY&_nc_oc=AdpKO05t2HUuzb7-r2M1cwzrteMp_Z96IjkZj_G8H4a4w2OfbUegeq4heuf3NCiVE4A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc9FcJddsfeJGtSB8stFCSkFmR1Pi-2MElYqWsvjBs2g&oe=6AFB216B"}, {"file_name": "scr_2.png", "id": "478084063581508", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031316_478084066914841_7574135440889036949_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69yspUBA2NoQ7kNvwGLpLxs&_nc_oc=Ado2MJpWKoWWgFc8HXqJxURvUKW6DD2xSi9YO60s8aCfF9UWHaEHaHDsZDOSmC-hP6M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3hnKjMptJqvOwsAtdCj1rIn8h5T_PHYQp7bp9ZJ0jSg&oe=6AFB2D1F"}, {"file_name": "scr_1.png", "id": "2062074523923454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984464_2062074527256787_301239079180693449_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDKK9b3CPh4Q7kNvwHf9bXM&_nc_oc=AdodCTjTYB8UxeS3x5CR7QPoD41kHWAr_xKHXK8ivBmqSWJptBXQwpwiOJij_x2jnGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGLQOcKxGhrgI7AS4zCRfj0vWAyaUUWya21jkvIJwMtA&oe=6AFB4068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_splash.png", "id": "2385733884896368", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031609_2385733888229701_1887006760644483219_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_KMJGh9iwYQ7kNvwHAdtRE&_nc_oc=Adqx1u6CLrsH5nYhsU_fgIcnepnN0Hgo2vRamKotAWYs28lUI6yy73UqxTAAaxbrolo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7IcZ0S9TUBSnR4-7Em_GEkrian6DHWtjSzZq4X92org&oe=6AFB361E"}, "display_name": "X-Fitness DEMO", "keywords": [], "long_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout!\nSelect any of our handcrafted original tracks to get your groove on to and start burning those calories!\nWant to jam out to your own set of tunes? \nNo problem, X-Fitness supports your own MP3 files as well. \n\nStand and fight off the pounds in the virtual arena! \nPunch, cut, block, and dodge your way to a slimmer you.\nHit all the beats by moving fast and aiming precise blows with your gloves.\nGrab projectiles by using the shield. \nAvoid obstacles by bending and dodging.\n\nSpeed and strength are also a factor. Punch as hard as you can to get the highest score!\nExtensive statistics show your results and progress. \nMatch the training level to your personal skills: \n - warm-up or train with your favorite workout, \n - for challenges choose the most intense mode, \n - or create your own training and go at your own pace.", "short_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout! \nStand and fight off the pounds in the virtual arena. Punch, cut, block, and dodge your way to a slimmer you! Start burning those calories with handcrafted tracks or your own MP3 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/xboostercommunity", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "zh_CN", "cs"], "supported_input_devices": ["OCULUS_TOU
cdn.com&_nc_ss=7f20f&oh=00_AQRzMHNDZf_tDwQEMD27wK-86j-zGD7Js7bO3JI4mubmhw&oe=6B006D1F"}, {"file_name": "scr_16.png", "id": "907107946700595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031322_907107950033928_2161283847196508593_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4D4CshwfmkQ7kNvwH-YjZv&_nc_oc=AdqY066gsQq8wErFqTirOheg7LVmoPoJrxYz7V6uVutySf79yQCW-H_KwKv-Lm32Xq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQognO_7uQBqg2-a_KYv5GdJUZuJskQ0wsG9ca_ZJ69nQ&oe=6B00676B"}, {"file_name": "scr_2.png", "id": "478084063581508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_478084066914841_7574135440889036949_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZmt0fg-yEYQ7kNvwE4yen1&_nc_oc=AdqWYjmdtwjkSfq4NaGDzqd4JyESd7VCuI3KvurP1uQ70gYcCQ4Osyf-YElmp8aPLNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-2WJOYb-S7JpHf4vIdNd-JhQysK8m43T6BjgD0Xk8Sg&oe=6B00731F"}, {"file_name": "scr_1.png", "id": "2062074523923454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_2062074527256787_301239079180693449_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK2D_S5oJgAQ7kNvwFcQXDN&_nc_oc=AdqAfh1BnjZLiSdmYNEqu8twW0O4De7myAShdpGRmfC0nVmPrE6siBcSwIlShJboQqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwSPRmNUhCiX5o_ZyZE2bnzr8Fkt0LatAamVZXujXlbw&oe=6B008668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_splash.png", "id": "2385733884896368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031609_2385733888229701_1887006760644483219_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMRfyGP6uPgQ7kNvwENcEvc&_nc_oc=AdoOijYviqzrpd1WH_1V852mEULzZZn0C-cRTyp5Oh8orKiZZ9Z4-hyrZqsIePIth2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvm4-UR8fmK4nS2OC0rSKUJV7KuVAlmMXXVDdjyFckDw&oe=6B007C1E"}, "display_name": "X-Fitness DEMO", "keywords": [], "long_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout!\nSelect any of our handcrafted original tracks to get your groove on to and start burning those calories!\nWant to jam out to your own set of tunes? \nNo problem, X-Fitness supports your own MP3 files as well. \n\nStand and fight off the pounds in the virtual arena! \nPunch, cut, block, and dodge your way to a slimmer you.\nHit all the beats by moving fast and aiming precise blows with your gloves.\nGrab projectiles by using the shield. \nAvoid obstacles by bending and dodging.\n\nSpeed and strength are also a factor. Punch as hard as you can to get the highest score!\nExtensive statistics show your results and progress. \nMatch the training level to your personal skills: \n - warm-up or train with your favorite workout, \n - for challenges choose the most intense mode, \n - or create your own training and go at your own pace.", "short_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout! \nStand and fight off the pounds in the virtual arena. Punch, cut, block, and dodge your way to a slimmer you! Start burning those calories with handcrafted tracks or your own MP3 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/xboostercommunity", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
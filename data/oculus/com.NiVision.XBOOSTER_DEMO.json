cdn.com&_nc_ss=7f20f&oh=00_AQQLuLBIB95wEtp4__Arr4wACjCBjmLz6c5etrtUjRnkCQ&oe=6B05B31F"}, {"file_name": "scr_16.png", "id": "907107946700595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031322_907107950033928_2161283847196508593_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejPcWJr0tFgQ7kNvwHRBg-2&_nc_oc=AdrTthBm9lmkLHkvHGKp0D-ovk6g5A1aUBTF4ISaL-674WEhbCr1n-16ESw36rNhZCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3alEr4377h8NvDiYrcI8iUWypVGV7-aR5jQ1OCkUrqg&oe=6B05AD6B"}, {"file_name": "scr_2.png", "id": "478084063581508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_478084066914841_7574135440889036949_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZYPIfBkqDQQ7kNvwFV_hBp&_nc_oc=AdqvKv6OuRJUgIfXzPsGLK4QosYdHVuEjX0oIdBV7kn2_eL76g6fjPHUnnkHlcdXbbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6UQGuofvUz-HTvpLxwQDcVM4LARM5OF1-YB8DUbfylw&oe=6B05B91F"}, {"file_name": "scr_1.png", "id": "2062074523923454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_2062074527256787_301239079180693449_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMwgfVKhcvUQ7kNvwEVSoml&_nc_oc=Ado4LCw5PLL217m6q_2AfJ7Yt7puA7tSxeAyFs0j_mjoFXKBO5NsNtGwvIT5r2-l_lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThWTJl7lSO4gX1qU34lHkNynkuh_Ft0AZisr2Q6Q966g&oe=6B05CC68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_splash.png", "id": "2385733884896368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031609_2385733888229701_1887006760644483219_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5D0z9LphjwQ7kNvwG7jdAt&_nc_oc=AdqdJpVAM57J8NPlULHsAo9QTMrjgIy9Iam9CwIiqB6biVfhawED3KknbnCcTDi_H3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJNIEBI1KZKRNl3khdV61A5NSZTlL1Hbrzo1y9PVvKyg&oe=6B05C21E"}, "display_name": "X-Fitness DEMO", "keywords": [], "long_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout!\nSelect any of our handcrafted original tracks to get your groove on to and start burning those calories!\nWant to jam out to your own set of tunes? \nNo problem, X-Fitness supports your own MP3 files as well. \n\nStand and fight off the pounds in the virtual arena! \nPunch, cut, block, and dodge your way to a slimmer you.\nHit all the beats by moving fast and aiming precise blows with your gloves.\nGrab projectiles by using the shield. \nAvoid obstacles by bending and dodging.\n\nSpeed and strength are also a factor. Punch as hard as you can to get the highest score!\nExtensive statistics show your results and progress. \nMatch the training level to your personal skills: \n - warm-up or train with your favorite workout, \n - for challenges choose the most intense mode, \n - or create your own training and go at your own pace.", "short_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout! \nStand and fight off the pounds in the virtual arena. Punch, cut, block, and dodge your way to a slimmer you! Start burning those calories with handcrafted tracks or your own MP3 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/xboostercommunity", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
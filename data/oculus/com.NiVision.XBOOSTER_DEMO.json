content-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8HDu_LBBXyWidLh5FYdn6TluQVkNat6ZTPw8K61ANsw&oe=69BD3B5F"}, {"file_name": "scr_7.png", "id": "1077721782639922", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86615257_1077721785973255_1881847905213356415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhWWl7rIUMcQ7kNvwEAvxKg&_nc_oc=AdkMPvAdiC46JKSuVb0_aIQUW7AIai5HXvgPcmil4HE61DwWF43BQ2_l_VRzFZ_zytA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwvr83fjixztC6JGYToSdJ819BBf1QGDa6i1jsolwrJqA&oe=69BD3D31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_2560x1440.png", "id": "3890773997620942", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974677_3890774000954275_6999002797222852641_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ousqxpFc244Q7kNvwHC0iXC&_nc_oc=Adn5Rru9i79rOe_RoorMuyNnl12Gs0HsDUeDuCG9Q3cjCrI1vkAPmUA6Vl1z9k_EYrA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8KtPHXyjo-Fb-t7IheBYyZqK9PrSbrl-1gTe6026U-A&oe=69BD29DB"}, "display_name": "X-BOOSTER DEMO", "keywords": [], "long_description": "X-BOOSTER is a fun and innovative way to enjoy an intensive VR full-body workout!\nSelect any of our handcrafted original tracks to get your groove on to and start burning those calories!\nWant to jam out to your own set of tunes? \nNo problem, X-BOOSTER supports your own MP3 files as well. \n\nStand and fight off the pounds in the virtual arena! \nPunch, cut, block, and dodge your way to a slimmer you.\nHit all the beats by moving fast and aiming precise blows with your gloves.\nGrab projectiles by using the shield. \nAvoid obstacles by bending and dodging.\n\nSpeed and strength are also a factor. Punch as hard as you can to get the highest score!\nExtensive statistics show your results and progress. \nMatch the training level to your personal skills: \n - warm-up or train with your favorite workout, \n - for challenges choose the most intense mode, \n - or create your own training and go 
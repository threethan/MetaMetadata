07107946700595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031322_907107950033928_2161283847196508593_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4D4CshwfmkQ7kNvwFNeuZ9&_nc_oc=AdoRvTKdk2nW0Ks_zkLXe2yWzXMlmqHJ1WFPgpa0TQUpvQBvxpAF8-ewXHlUPvl0reY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-rc6xOV9flCttUR8jipQoU4g_PnxjGqSEy_ZSg4gDvw&oe=6AFDC46B"}, {"file_name": "scr_2.png", "id": "478084063581508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031316_478084066914841_7574135440889036949_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69yspUBA2NoQ7kNvwEQiBDG&_nc_oc=AdqXrOzY-ZNOazmVXm7YJzH_0lw9OOB5JDf9RcTpwTQOQfbYA5CvVZLTprFNqhNEIsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3slJ1v2Bm4nnbh2_5iY9r_DodeYqYxPEFy80NOcyKCQ&oe=6AFDD01F"}, {"file_name": "scr_1.png", "id": "2062074523923454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_2062074527256787_301239079180693449_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7Zwbr9WTH4Q7kNvwEHWrmF&_nc_oc=Adqy-Hu9OIajUVMqgSKE7rHk-t3YUwzJiBdZQWqfQ_VYZla7OltIsSxMpJV_u1x-VW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZyyddprBmn5Iy0tlhefzXFls9xVbCzvpKdCL7u9J1Ig&oe=6AFDE368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_splash.png", "id": "2385733884896368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031609_2385733888229701_1887006760644483219_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_KMJGh9iwYQ7kNvwGRubzO&_nc_oc=Adq0ubeEwb1z0lckL-8q2MtVJvb089P-JtR7wejg_GVVJeP2d7tOMqc37gmcWd3XPfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQGmjWrpDNaRCiQAB9V5VGIFDkZZ-zTQcjae6cRLSnPQ&oe=6AFDD91E"}, "display_name": "X-Fitness DEMO", "keywords": [], "long_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout!\nSelect any of our handcrafted original tracks to get your groove on to and start burning those calories!\nWant to jam out to your own set of tunes? \nNo problem, X-Fitness supports your own MP3 files as well. \n\nStand and fight off the pounds in the virtual arena! \nPunch, cut, block, and dodge your way to a slimmer you.\nHit all the beats by moving fast and aiming precise blows with your gloves.\nGrab projectiles by using the shield. \nAvoid obstacles by bending and dodging.\n\nSpeed and strength are also a factor. Punch as hard as you can to get the highest score!\nExtensive statistics show your results and progress. \nMatch the training level to your personal skills: \n - warm-up or train with your favorite workout, \n - for challenges choose the most intense mode, \n - or create your own training and go at your own pace.", "short_description": "X-Fitness is a fun and innovative way to enjoy an intensive VR full-body workout! \nStand and fight off the pounds in the virtual arena. Punch, cut, block, and dodge your way to a slimmer you! Start burning those calories with handcrafted tracks or your own MP3 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/xboostercommunity", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "ko", "zh_CN", "cs"], "supported_input_devices": ["OCULUS_TOU
7C"}, {"file_name": "IMG_0846.png", "id": "2317379522111828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_2317379525445161_8565004302111210250_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF_rxmLLht0Q7kNvwGoPxw9&_nc_oc=AdpaYjjYo-HXlGM-elJN983Fh3Ygrra1Ef9lfBSOY8kYsD1dPLddb892iFQB3L-Hirs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlex639cLdYgVlzEpdbkLz5VNwSWH-u8aNSXeNiSJIaA&oe=6AFDC9D9"}, {"file_name": "IMG_0834.png", "id": "1188780155953052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617729_1188780162619718_7737772226155969021_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YddbMJcARgkQ7kNvwF9uxW7&_nc_oc=Adr8nebn2kpXJhxHj6ISp1FK7Eq2kvDDrl9_tzdR_qseetqR-hJxujkAYAg34_yecjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWG6FEXbAk7fFQyZIBoDlaO70A86rFm3SAhPhSb8FJzg&oe=6AFDD6BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_0835.PNG", "id": "1375968417240746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_1375968420574079_5889172505408540695_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1OX3JMQCR4Q7kNvwHZ4sHy&_nc_oc=AdoulBKeTy6oUKxqPSaC_SOjQQaoLjYpppY-a-vQeD1sWX7UgZKCvgMLi_06P4g86xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHNSiSooouDhv5aoASZtkQ9ORC25reSrU4murHEPWhmg&oe=6AFDCBF5"}, "display_name": "TAXI DRIVER VR", "keywords": ["taxi", "simulator", "driving", "interactive", "physics"], "long_description": "# PICKUP PASSENGERS\nStep into a chaotic taxi world where the ride is never simple. Your job is to pick up passengers, let the autopilot handle the driving, and deal with whatever madness happens in the back seat. Every trip becomes its own little sandbox mission: chat, poke, tease, calm them down, or just watch the chaos unfold as you try to earn ratings and cash.\n{4276355149318522}\n\n\n# EARN & BUY\nUse the money you earn to unlock items in the store. Clean your car, upgrade your tools, play with multimedia features, and deal with random events that keep every ride unpredictable. Some passengers might even bring\u2026 unusual challenges, like popping pimples or dealing with their odd requests.\n{2125602324513611}\n\n\n# NATURAL PHYSICS\nPassengers run on a full physics-based ragdoll system with advanced reactions. They dance, fight, fool around, interact with the car, annoy you on purpose, or surprise you with weird behavior. Sometimes they\u2019re friendly. Sometimes they\u2019re a disaster. You decide how to handle them.\n{1406670521100844}\n\nThe tone stays silly, chaotic, cartoonish, and fun. No serious drama\u2014just wild taxi stories and unpredictable characters in a city that never calms down.", "short_description": "Experience the full vibe of being a taxi driver in VR. Clean your car, earn cash, and interact with silly passengers through a satisfying physics-based simulation. This city has never been quiet."}]}, "developer_name": "MANERAI INC.", "developer_privacy_policy_url": "https://vasilyok.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://vasilyok.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2592492991720
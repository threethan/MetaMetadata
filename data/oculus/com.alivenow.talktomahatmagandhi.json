er": null, "video_trailer_thumbnail": {"file_name": "Mahatma Gandhi MR Video Thumbnail For VR.png", "id": "1498715480712874", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974657_1498715484046207_2554084250182696926_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgzbruC03bMQ7kNvwHMYiez&_nc_oc=AdphBz_UV8fndHg7jMHPx2k0ou5HOrev2oJ6-nOviY31hhq-Y2k2TAdu2JoqY0A2TvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RyVF_UlM9y35DkrVQ1n0yUW7ZdYWnxPwIFd7Ez05y3Q&oe=69D25BB0"}, "display_name": "Talk to Mahatma Gandhi", "keywords": [], "long_description": "See Mahatma Gandhi come to life and have a conversation with him! In this unique mixed reality experience, talk about Mahatma Gandhi and ask him his point of view on anything and see him reply to you with his voice. Look around the 360 environment and explore some facts and tidbits about Mahatma Gandhi. You can ask any number of questions and see both the question and the answer transcribed on screen as well. ", "short_description": "See Mahatma Gandhi come to life and have a conversation with him! In this unique mixed reality experience, talk to Gandhi to ask him his point of view on anything you'd like and he replies with his point of view. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alivenow.in/MetaStorePrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "AliveNow - Creative Tech Studio", "support_website_url": null, "website_url": "https://www.alivenow.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
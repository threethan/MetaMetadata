er": null, "video_trailer_thumbnail": {"file_name": "Mahatma Gandhi MR Video Thumbnail For VR.png", "id": "1498715480712874", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974657_1498715484046207_2554084250182696926_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofl_zV4vjGgQ7kNvwFeKQd8&_nc_oc=AdrWQorDwsQkMI8H1DcjjA9EaA3bQW8DFT0rzXhLkPHKw2LBHcZjtjxhO1RemnOUIHk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACRkeKHKb0WONbmiOYnMYf4v-m0DV9thoUSP0X0q2nbQ&oe=6A6603B0"}, "display_name": "Talk to Mahatma Gandhi", "keywords": [], "long_description": "See Mahatma Gandhi come to life and have a conversation with him! In this unique mixed reality experience, talk about Mahatma Gandhi and ask him his point of view on anything and see him reply to you with his voice. Look around the 360 environment and explore some facts and tidbits about Mahatma Gandhi. You can ask any number of questions and see both the question and the answer transcribed on screen as well. ", "short_description": "See Mahatma Gandhi come to life and have a conversation with him! In this unique mixed reality experience, talk to Gandhi to ask him his point of view on anything you'd like and he replies with his point of view. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alivenow.in/MetaStorePrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "AliveNow - Creative Tech Studio", "support_website_url": null, "website_url": "https://www.alivenow.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
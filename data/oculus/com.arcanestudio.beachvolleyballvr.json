VER_PORTRAIT.png", "id": "1064445309725856", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604317775_1064445313059189_5545310531667402358_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yra57Z5wnV4Q7kNvwHeayQc&_nc_oc=AdrgSygyBZSTdEYjbgMT_VE-wAX8AdJ547EQ-MsIBAaHvwIYswQ80cmeFG-d8fX5veY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO6mVuBi9SsR6ddKzKSfZXLl6d84t2TIyEYUd64sAANA&oe=6AF9D5F4"}]}, "id": "1058711913808922", "locale": "en_US", "screenshots": [{"file_name": "2026-10-10_12-53-16_untitled_preset-net-level_3840x2160-2560x1440p.png", "id": "2093160881293634", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604370996_2093160884626967_5467232416627332394_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=327xfhPtFcYQ7kNvwG08vao&_nc_oc=AdpbCLVJ680tDg73Vaw-BgQIUlE57bsp0NVeKyEk9ZhTYvVG82Tj52sQ6OAE83eoxJs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn-LWYBC1DjS6UmXEH4hMKPKZtDh_oZmLMsPfPNoXibQ&oe=6AF9C521"}, {"file_name": "vlcsnap-2026-10-10-16h20m08s236-2560x1440p.png", "id": "1531118739078436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830576_1531118742411769_3825905231546676084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTtUgzH9q2EQ7kNvwGqo6Kj&_nc_oc=Adq6DE_TQR5FEFBiwUB2YHYpM1H8-uTwsmjNDB-g6REVMyhkrdUqh5qEGSnPNf74hGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi4iy5KCibHAFD9Cc0bgOrzoOzmhgBF9ey4ZCgCxdAPA&oe=6AF9D61F"}, {"file_name": "2026-10-10_13-13-23_untitled_free_3840x2160-2560x1440p.png", "id": "1642842204041817", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673645340_1642842207375150_1005602473917718132_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOmTzaYZlvMQ7kNvwGgNPBX&_nc_oc=Adqkj1QBfZEUcQQ0ILOjbbApe713Ur9IunpRGTkmH9zcKO_BA7i2aiaHU3fPtBAELV4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqSw41UsvdhT36yBzn93KAMA8fXSkGu6xqD1MXER55Pw&oe=6AF9BEBE"}, {"file_name": "2026-10-10_13-09-48_untitled_free_3840x2160-2560x1440p.png", "id": "1775497641049052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_1775497644382385_8496860034804260521_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3R0yixC-q8Q7kNvwEKSL6J&_nc_oc=Adpjvlrzc4snwL1rBMoBe9zhnUAfw5eq9_8pCyhgz5t_226nSkVMa2mTfjUwdR0Tp60&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST2gnOAcfjDoyRnPu8ohIrFID-EsdQBovSKGmPb4N9ww&oe=6AF9D675"}, {"file_name": "main_menu-2560x1440p.png", "id": "1788969235745590", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596168449_1788969239078923_6650770270035869239_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lERvqbQVQIQ7kNvwFhQO4l&_nc_oc=AdrJvF05TKIVpdH267l-3wcX1Acqk_MwliN0nICkeMsERE1T_xts6A43BxIDAfFBKp4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsjBKfgQp-Ey6kvrPWVlXMYVIR9RTvdSpHTzeb9brLcQ&oe=6AF9D7AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beach Volleyball VR", "keywords": ["volleyball", "beach", "volley", "sand"], "long_description": "Step onto the sand and experience beach volleyball built for VR! Receive the serve, set up your teammate, unleash a spike, and fight for every point in 2v2 matches. Beach Volleyball VR puts your movements at the heart of the action: pass, set, serve, spike, and block using natural VR motions. Precise timing and smart positioning turn a good rally into a winning play.\nPLAY YOUR WAY\n\u2022 Solo matches: Play complete 2v2 games against AI teams with three difficulty levels. No internet connection needed, so you can play anytime.\n\u2022 Online multiplayer: Join public rooms or create private matches for up to 4 players. Team up with friends or face them across the net. Bots fill empty player slots so matches can still go on.\n\u2022 Cross-platform play: Join friends across supported VR platforms.\nLEARN AND IMPROVE\n\u2022 Follow a guided tutorial to learn the fundamentals of movement and each volleyball action.\n\u2022 Train your passing, setting, serving, attacking, and ball control at your own pace.\n\u2022 Enable optional assistance settings for easier movement, positioning, and reaching the net.\nMADE FOR VR\nForget button-triggered volleyball moves. Read each play, get into position, control the ball through your movements, and react in real time. Whether you're new to the sport or want to challenge your friends, every serve starts another chance to land the perfect spike.\nFrom relaxed training sessions to competitive rallies, jump into the action whenever you want. No two rallies are the same.\n", "short_description": "Beach Volleyball VR brings 2v2 beach volleyball to virtual reality. Pass, set, spike, serve and block using natural VR movements, play complete matches against bots, or jump online and play with friends."}]}, "developer_name": "Arcane Studio", "developer_privacy_policy_url": "https://arcanestudio.dev.br/privacypolice/", "developer_terms_of_service_url": null, "publisher_name": "Arcane Studio", "support_website_url": null, "website_url": "https://arcanestudio.dev.br/beachvolleyballvr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es", "fr", "de", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "1376538412202079"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "869361436233082"}, {"status":
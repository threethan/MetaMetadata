7a0a&_nc_ohc=AI8nkEL8f38Q7kNvwGqTCxq&_nc_oc=AdphpsvEspSex_dIU0vbi3pC3TGZizMzpZr9at2yQ_ry_d7jjn6WmQKptd9cYF0bnBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQtpr3pJ2o68DKdnBCLdnmcA5NLL9rHz7sARVYEyWibA&oe=6B10607E"}, {"file_name": "2026-10-10_13-09-48_untitled_free_3840x2160-2560x1440p.png", "id": "1775497641049052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830822_1775497644382385_8496860034804260521_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCMXy5pA-psQ7kNvwG4SMuJ&_nc_oc=AdogqBa9Ejup0zh_gQ8W8zNekfywk7jx_f_dz085faAlJwto8YBPicgJXPpb3Y61aBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSh9Vc855mGP35HzODWfZoyfgMcnrJvKHoLRftfDScSw&oe=6B103FF5"}, {"file_name": "main_menu-2560x1440p.png", "id": "1788969235745590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_1788969239078923_6650770270035869239_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFSjBln1hvkQ7kNvwHtiIRy&_nc_oc=AdqPF8a4YLFzwjH8pyV7pi9OfOdgPgbfgmbt5ZqlcrjKKdaV4MqVRZo4SiZFUSJbAeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVBZTXXP6bhnoI7sKy6QhfjmB4wdGybqhFCJ_scjGrFg&oe=6B10412D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beach Volleyball VR", "keywords": ["volleyball", "beach", "volley", "sand"], "long_description": "Step onto the sand and experience beach volleyball built for VR! Receive the serve, set up your teammate, unleash a spike, and fight for every point in 2v2 matches. Beach Volleyball VR puts your movements at the heart of the action: pass, set, serve, spike, and block using natural VR motions. Precise timing and smart positioning turn a good rally into a winning play.\nPLAY YOUR WAY\n\u2022 Solo matches: Play complete 2v2 games against AI teams with three difficulty levels. No internet connection needed, so you can play anytime.\n\u2022 Online multiplayer: Join public rooms or create private matches for up to 4 players. Team up with friends or face them across the net. Bots fill empty player slots so matches can still go on.\n\u2022 Cross-platform play: Join friends across supported VR platforms.\nLEARN AND IMPROVE\n\u2022 Follow a guided tutorial to learn the fundamentals of movement and each volleyball action.\n\u2022 Train your passing, setting, serving, attacking, and ball control at your own pace.\n\u2022 Enable optional assistance settings for easier movement, positioning, and reaching the net.\nMADE FOR VR\nForget button-triggered volleyball moves. Read each play, get into position, control the ball through your movements, and react in real time. Whether you're new to the sport or want to challenge your friends, every serve starts another chance to land the perfect spike.\nFrom relaxed training sessions to competitive rallies, jump into the action whenever you want. No two rallies are the same.\n", "short_description": "Beach Volleyball VR brings 2v2 beach volleyball to virtual reality. Pass, set, spike, serve and block using natural VR movements, play complete matches against bots, or jump online and play with friends."}]}, "developer_name": "Arcane Studio", "developer_privacy_policy_url": "https://arcanestudio.dev.br/privacypolice/", "developer_terms_of_service_url": null, "publisher_name": "Arcane Studio", "support_website_url": null, "website_url": "https://arcanestudio.dev.br/beachvolleyballvr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es", "fr", "de", "ja", "zh_CN"], "supported_input_devices": ["OCU
035365_456461633447464_6216329453701295156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGow_gOKESsQ7kNvwFhSqbl&_nc_oc=AdoWIWWNgaSbucS83G6XBI4zX_oE6_1gIqPPX2dmJ53hqhILQxHtWi2ZowZ-gEsQ1DI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-4dksX6acAOMjmsODrm6h6Pl6mMvGwg9q9-elbOVsIQ&oe=6A5B841E"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_2.png", "id": "324483673986862", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221317_324483677320195_6488563078065665144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61jtvzK9EfUQ7kNvwGqkSDd&_nc_oc=AdqESJJ6zV9_oeGRbsoSYSrWkQWVWRyPTalO4frLhvhHn2dYtfNh-BR_HuGj9Ny7oZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6-KcjaOC8N9E1Yc75MsfGgeMq8k41WugcU_I7ORWsBg&oe=6A5B83E7"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_5.png", "id": "435278552440195", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035403_435278555773528_5366474972145561825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKy7t2CHNx0Q7kNvwHr-GCD&_nc_oc=AdpG_4f3RBgx7TzVNTpOiT_jLWcbeyU6KZ9fSFruZT9JzC0oC2-L54uuuug25aqpSfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmkpXNW4_7t0HUEPuhvZ9DXK1xp66-A0o58cSY6r3DOg&oe=6A5B63D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "959091469101214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_959091472434547_3203908596338855349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9dwev1yEoUQ7kNvwG1RKiv&_nc_oc=AdpUrLMLxnqpRprJzBaSRbU9mc-1m0rEtwFlWBISkan0bX1VD3rm97SAOXNrbSaZRXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi_XOb3nTjzGfAI0wSnTKFrFarBI12I71SSk1tffMhzw&oe=6A5B7C12"}, "display_name": "\"Comrades, We Have a Mole Problem\"", "keywords": [], "long_description": ".\n\n**\"Hear me comrade, lives are at stake here.**\n\n**You are to take matters into your own hands, saving yourself and your comrades from spies from the West.**\n\n**The party appreciates your work, but don't forget, the party will not forgive incompetence.\"**\n\n.\n\nWeed out the mole in time to save yourself!\n\nEmerge into interrogation room in Eastern bloc during Cold War era.\n\nYou only have so much time to make a choice, a kind that determines life and death!\n\n\n- Look for the **clues** of the traitor and make a **quick judgement.**\n\n- Don't even bother the trial because you are the prosecutor, the judge, and the executioner.\n\n- One wrong move or hesitation will cost your own life, and there is no time to waste!\n\n- **Do not overthink it because you can't afford it!**", "short_description": "\"Hear me comrade, lives are at stake here.\n\nYou are to take matters into your own hands, saving yourself and your comrades from spies from the West.\n\nThe party appreciates your work, but don't forget, the party will not forgive incompetence.\"\n\n"}, {"images": {"nodes": []}, "id": "1248498269505642", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\"\ubc30\uc2e0\uc790\ub294 \ucc98\ub2e8\ud55c\ub2e4!\"", "keywords": [], "long_description": "**\"\ub3d9\uc9c0\uc5ec, \ubaa9\uc228\uc774 \uac78\ub9b0 \uc911\uc694\ud55c \uc77c\uc774\ub124.**\n\n**\uc11c\ubc29\uc758 \ucca9\uc790\ub4e4\ub85c\ubd80\ud130 \ub2f9\uc744 \uc9c0\ucf1c\ub0b4\uc57c\ud558\ub124.**\n\n**\ub2f9\uc740 \ub3d9\uc9c0\uc758 \ub178\uace0\uc5d0 \uac10\uc0ac\ud574\ud560\uac78\uc138.**\n\n**\ud558\uc9c0\ub9cc \uc78a\uc9c0\ub9d0\uac8c, \ub2f9\uc740 \ubb34\ub2a5\ud568\uc744 \uc6a9\uc778\ud558\uc9c0\uc54a\ub294\ub2e4\ub294 \uc0ac\uc2e4\uc744.\"**\n\n.\n\n\ubc30\uc2e0\uc790\ub97c \ucc3e\uc544\ub0b4\uc5b4 \ub2f9\uc2e0\uc758 \ubaa9\uc228\uc744 \ubcf4\uc804\ud558\uc138\uc694!\n\n60\ub144\ub300\uc758 \ub0c9\uc804\uc2dc\ub300, \ub3d9\uad6c\uad8c \uacf5\uc0b0\uad6d\uac00\uc758 \ucde8\uc870\uc2e4\uc5d0 \uc549\uc544\uc788\ub294 \ub2f9\uc2e0. \n\n\uc0dd\uc0ac\ub97c \uac00\ub974\ub294 \uc120\ud0dd\uc774\uc9c0\ub9cc, \ub2f9\uc2e0\uc5d0\uac90 \uc2dc\uac04\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\n\n.\n\n- **\"\ubc18\ub3d9\ubd84\uc790\"**\uc758 **\ub2e8\uc11c**\ub97c \ud655\uc778\ud558\uace0 **\ube60\ub974\uac8c \ud310\ub2e8**\uc744 \ub0b4\ub9ac\uc138\uc694.\n\n- \uc7ac\ud310\ub530\uc708 \uc78a\uc73c\uc138\uc694. \ub2f9\uc2e0\uc774 \uac80\uc0ac\uc774\uc790 \ud310\uc0ac\uc774\uc790 \uc9d1\ud589\uad00\uc785\ub2c8\ub2e4.\n\n- \uc7a0\uae50 \uc8fc\uc800\ud558\uac70\ub098 \uc798\ubabb\ub41c \ud310\ub2e8\uc744 \ud560\uc2dc\uc5d4 \ub2f9\uc2e0\uc758 \ubaa9\uc228\uc774 \uc628\uc804\uce58 \ubabb\ud560 \uac83\uc785\ub2c8\ub2e4.\n\n- **\ub108\ubb34 \uae4a\uac8c \uace0\ubbfc\ud558\uc9c0\ub9c8\uc138\uc694, \ub2f9\uc2e0\uc5d0\uac90 \uadf8\ub7f4 \uc5ec\uc720\uc870\ucc28 \uc5c6\uc73c\ub2c8\uae4c\uc694.**\n", "short_description": "\"\ub3d9\uc9c0\uc5ec, \ubaa9\uc228\uc774 \uac78\ub9b0 \uc911\uc694\ud55c \uc77c\uc774\ub124.\n\n\uc11c\ubc29\uc758 \ucca9\uc790\ub4e4\ub85c\ubd80\ud130 \ub2f9\uc744 \uc9c0\ucf1c\ub0b4\uc57c\ud558\ub124. \n\n\ub2f9\uc740 \ub3d9\uc9c0\uc758 \ub178\uace0\uc5d0 \uac10\uc0ac\ud574\ud560\uac78\uc138. \n\n\ud558\uc9c0\ub9cc \uc78a\uc9c0\ub9d0\uac8c, \ub2f9\uc740 \ubb34\ub2a5\ud568\uc744 \uc6a9\uc778\ud558\uc9c0\uc54a\ub294\ub2e4\ub294 \uc0ac\uc2e4\uc744.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://pp.gladpark.kr/PrivacyPolicy_eng_gladpark.html", "developer_terms_of_service_url": "https://pp.gladpark.kr/TermsOfService_eng_gladpark.html", "publisher_name": "Gladpark inc.", "support_website_url": null, "website_url": "https://gladpark.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
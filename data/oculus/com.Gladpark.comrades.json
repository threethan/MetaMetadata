nc_oc=AdlkNiezgbcc0_VnUgqfktOPT5xKzjn02ErahFwPzvgWQSaEvM4KGHPVvOCu94hpzQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPdwVqpl55lkAqqzMC0jExZwMH9cAb4SvkUYw7ugbzQA&oe=69A2F21E"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_2.png", "id": "324483673986862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221317_324483677320195_6488563078065665144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1p-pLzx4XEQ7kNvwEcEU7d&_nc_oc=AdlsEfFkNqjITIaxpbadsECZ2pA8UIKZj4L_Q7SjHKQHcmzjHAhdOxsKRii_ReTu9ac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1E2TBCqPyoWafD2pfTSpdRgYy858j-BqJpEOdgVFgew&oe=69A2F1E7"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_5.png", "id": "435278552440195", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035403_435278555773528_5366474972145561825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCDIFxTVs5MQ7kNvwE22nN5&_nc_oc=AdlrdCCBMa4p9fQ33yLWsQc3mFvgLatiWQoEpHIl5ThiGxm4eg6KN7oZHmQDcaDJtfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsoIuTu7JvqJZ3uilNu7GsSGFvjCfP52KTiR5l6td6WPw&oe=69A2D1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "959091469101214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_959091472434547_3203908596338855349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHgs90eIniMQ7kNvwGArWUx&_nc_oc=Admei8l_UB5Rn4sPm9fq9OUjTGGWKZem39mT-enqFtODpInmDJ_YfMGJpX2CTz3lR8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLNqM_9nBj0tBK1SXDH7UYhPEikIy0_Kemg9BjNNh1DQ&oe=69A2EA12"}, "display_name": "\"Comrades, We Have a Mole Problem\"", "keywords": [], "long_description": ".\n\n**\"Hear me comrade, lives are at stake here.**\n\n**You are to take matters into your own hands, saving yourself and your comrades from spies from the West.**\n\n**The party appreciates your work, but don't forget, the party will not forgive incompetence.\"**\n\n.\n\nWeed out the mole in time to save yourself!\n\nEmerge into interrogation room in Eastern bloc during Cold War era.\n\nYou only have so much time to make a choice, a kind that determines life and death!\n\n\n- Look for the **clues** of the traitor and make a **quick judgement.**\n\n- Don't even bother the trial because you are the prosecutor, the judge, and the executioner.\n\n- One wrong move or hesitation will cost your own life, and there is no time to waste!\n\n- **Do not overthink it because you can't afford it!**", "short_description": "\"Hear me comrade, lives are at stake here.\n\nYou are to take matters into your own hands, saving yourself and your comrades from spies from the West.\n\nThe party appreciates your work, but don't forget, the party will not forgive incompetence.\"\n\n"}, {"images": {"nodes": []}, "id": "1248498269505642", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\"\ubc30\uc2e0\uc790\ub294 \ucc98\ub2e8\ud55c\ub2e4!\"", "keywords": [], "long_description": "**\"\ub3d9\uc9c0\uc5ec, \ubaa9\uc228\uc774 \uac78\ub9b0 \uc911\uc694\ud55c \uc77c\uc774\ub124.**\n\n**\uc11c\ubc29\uc758 \ucca9\uc790\ub4e4\ub85c\ubd80\ud130 \ub2f9\uc744 \uc9c0\ucf1c\ub0b4\uc57c\ud558\ub124.**\n\n**\ub2f9\uc740 \ub3d9\uc9c0\uc758 \ub178\uace0\uc5d0 \uac10\uc0ac\ud574\ud560\uac78\uc138.**\n\n**\ud558\uc9c0\ub9cc \uc78a\uc9c0\ub9d0\uac8c, \ub2f9\uc740 \ubb34\ub2a5\ud568\uc744 \uc6a9\uc778\ud558\uc9c0\uc54a\ub294\ub2e4\ub294 \uc0ac\uc2e4\uc744.\"**\n\n.\n\n\ubc30\uc2e0\uc790\ub97c \ucc3e\uc544\ub0b4\uc5b4 \ub2f9\uc2e0\uc758 \ubaa9\uc228\uc744 \ubcf4\uc804\ud558\uc138\uc694!\n\n60\ub144\ub300\uc758 \ub0c9\uc804\uc2dc\ub300, \ub3d9\uad6c\uad8c \uacf5\uc0b0\uad6d\uac00\uc758 \ucde8\uc870\uc2e4\uc5d0 \uc549\uc544\uc788\ub294 \ub2f9\uc2e0. \n\n\uc0dd\uc0ac\ub97c \uac00\ub974\ub294 \uc120\ud0dd\uc774\uc9c0\ub9cc, \ub2f9\uc2e0\uc5d0\uac90 \uc2dc\uac04\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\n\n.\n\n- **\"\ubc18\ub3d9\ubd84\uc790\"**\uc758 **\ub2e8\uc11c**\ub97c \ud655\uc778\ud558\uace0 **\ube60\ub974\uac8c \ud310\ub2e8**\uc744 \ub0b4\ub9ac\uc138\uc694.\n\n- \uc7ac\ud310\ub530\uc708 \uc78a\uc73c\uc138\uc694. \ub2f9\uc2e0\uc774 \uac80\uc0ac\uc774\uc790 \ud310\uc0ac\uc774\uc790 \uc9d1\ud589\uad00\uc785\ub2c8\ub2e4.\n\n- \uc7a0\uae50 \uc8fc\uc800\ud558\uac70\ub098 \uc798\ubabb\ub41c \ud310\ub2e8\uc744 \ud560\uc2dc\uc5d4 \ub2f9\uc2e0\uc758 \ubaa9\uc228\uc774 \uc628\uc804\uce58 \ubabb\ud560 \uac83\uc785\ub2c8\ub2e4.\n\n- **\ub108\ubb34 \uae4a\uac8c \uace0\ubbfc\ud558\uc9c0\ub9c8\uc138\uc694, \ub2f9\uc2e0\uc5d0\uac90 \uadf8\ub7f4 \uc5ec\uc720\uc870\ucc28 \uc5c6\uc73c\ub2c8\uae4c\uc694.**\n", "short_description": "\"\ub3d9\uc9c0\uc5ec, \ubaa9\uc228\uc774 \uac78\ub9b0 \uc911\uc694\ud55c \uc77c\uc774\ub124.\n\n\uc11c\ubc29\uc758 \ucca9\uc790\ub4e4\ub85c\ubd80\ud130 \ub2f9\uc744 \uc9c0\ucf1c\ub0b4\uc57c\ud558\ub124. \n\n\ub2f9\uc740 \ub3d9\uc9c0\uc758 \ub178\uace0\uc5d0 \uac10\uc0ac\ud574\ud560\uac78\uc138. \n\n\ud558\uc9c0\ub9cc \uc78a\uc9c0\ub9d0\uac8c, \ub2f9\uc740 \ubb34\ub2a5\ud568\uc744 \uc6a9\uc778\ud558\uc9c0\uc54a\ub294\ub2e4\ub294 \uc0ac\uc2e4\uc744.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://pp.gladpark.kr/PrivacyPolicy_eng_gladpark.html", "developer_terms_of_service_url": "https://pp.gladpark.kr/TermsOfService_eng_gladpark.html", "publisher_name": "Gladpark inc.", "support_website_url": null, "website_url": "https://gladpark.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_trackin
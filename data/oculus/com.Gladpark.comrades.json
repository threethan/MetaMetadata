_6216329453701295156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YXSOFN2VIIQ7kNvwHhGYqp&_nc_oc=AdqpVMXhiovJ-JjXyyt4wQ2__MaSUXZNa3tWSqjqu1yGTr_u5gUhM6il7EcbqUTGuY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dvo3Z7ZGEHYeG5_17kzcrWW3WiMsrS8ftqdGrB5OTaw&oe=6A04811E"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_2.png", "id": "324483673986862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221317_324483677320195_6488563078065665144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9BW237O_fcQ7kNvwHh9Lv8&_nc_oc=AdqozQlf8oUProJTUqjbLyIB88gBVOWXfys-ri5JTDcPnKp0XV2mX5eMgYsCuYWFcfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c_dpmqqGbeohbwwKkZuo4Ldx8hu2Lw7IEpZi7j7j_kg&oe=6A0480E7"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f7_5.png", "id": "435278552440195", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035403_435278555773528_5366474972145561825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZAgsxKMYqYQ7kNvwE1AwN7&_nc_oc=AdoGu5jGRVNz50PaJwrIug0pKg9EQ6P5UUdL63Si1IqZwgN-QyTmAr2bqRBoVIJ-8Y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A0SmcEWW1mZHT7OviVsjhikl7nuLjqRvfHLwzUEiunA&oe=6A049916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "959091469101214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_959091472434547_3203908596338855349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORvilz49OLkQ7kNvwEk_36-&_nc_oc=AdrVtYfb1-NRYOH_m5vlsUkKd1-_tw8zA-12d_5J5qOPVn5niw-ArGxO5q3QiK_p3nU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DTMXVa3LLF7T_ZZhqmCZhjh5d9JXDZzmYnCvQgMYx1g&oe=6A047912"}, "display_name": "\"Comrades, We Have a Mole Problem\"", "keywords": [], "long_description": ".\n\n**\"Hear me comrade, lives are at stake here.**\n\n**You are to take matters into your own hands, saving yourself and your comrades from spies from the West.**\n\n**The party appreciates your work, but don't forget, the party will not forgive incompetence.\"**\n\n.\n\nWeed out the mole in time to save yourself!\n\nEmerge into interrogation room in Eastern bloc during Cold War era.\n\nYou only have so much time to make a choice, a kind that determines life and death!\n\n\n- Look for the **clues** of the traitor and make a **quick judgement.**\n\n- Don't even bother the trial because you are the prosecutor, the judge, and the executioner.\n\n- One wrong move or hesitation will cost your own life, and there is no time to waste!\n\n- **Do not overthink it because you can't afford it!**", "short_description": "\"Hear me comrade, lives are at stake here.\n\nYou are to take matters into your own hands, saving yourself and your comrades from spies from the West.\n\nThe party appreciates your work, but don't forget, the party will not forgive incompetence.\"\n\n"}, {"images": {"nodes": []}, "id": "814196360774181", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\"\ubc30\uc2e0\uc790\ub294 \ucc98\ub2e8\ud55c\ub2e4!\"", "keywords": [], "long_description": "**\"\ub3d9\uc9c0\uc5ec, \ubaa9\uc228\uc774 \uac78\ub9b0 \uc911\uc694\ud55c \uc77c\uc774\ub124.**\n\n**\uc11c\ubc29\uc758 \ucca9\uc790\ub4e4\ub85c\ubd80\ud130 \ub2f9\uc744 \uc9c0\ucf1c\ub0b4\uc57c\ud558\ub124.**\n\n**\ub2f9\uc740 \ub3d9\uc9c0\uc758 \ub178\uace0\uc5d0 \uac10\uc0ac\ud574\ud560\uac78\uc138.**\n\n**\ud558\uc9c0\ub9cc \uc78a\uc9c0\ub9d0\uac8c, \ub2f9\uc740 \ubb34\ub2a5\ud568\uc744 \uc6a9\uc778\ud558\uc9c0\uc54a\ub294\ub2e4\ub294 \uc0ac\uc2e4\uc744.\"**\n\n.\n\n\ubc30\uc2e0\uc790\ub97c \ucc3e\uc544\ub0b4\uc5b4 \ub2f9\uc2e0\uc758 \ubaa9\uc228\uc744 \ubcf4\uc804\ud558\uc138\uc694!\n\n60\ub144\ub300\uc758 \ub0c9\uc804\uc2dc\ub300, \ub3d9\uad6c\uad8c \uacf5\uc0b0\uad6d\uac00\uc758 \ucde8\uc870\uc2e4\uc5d0 \uc549\uc544\uc788\ub294 \ub2f9\uc2e0. \n\n\uc0dd\uc0ac\ub97c \uac00\ub974\ub294 \uc120\ud0dd\uc774\uc9c0\ub9cc, \ub2f9\uc2e0\uc5d0\uac90 \uc2dc\uac04\uc774 \uc5
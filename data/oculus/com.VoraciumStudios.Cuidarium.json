oculuscdn.com/v/t64.5771-25/604370996_1456641113273390_5104706182466908379_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxBm8KPvaocQ7kNvwFJGTx_&_nc_oc=Adp0aNzuwOjlmS1urGJWOeOY9TOo75Qlr4-0ITKjrRwD1o4wl64hDeUHARio6z1RRZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFLnuwQ_uO97JBH4qviM2NV5FN9wdxUOZ1F2eHM0GobA&oe=6B0C7A8B"}, {"file_name": "C1.png", "id": "2384732575671939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842183_2384732579005272_4317969415464376390_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfEQBAqYSj8Q7kNvwHev90Q&_nc_oc=Adq-Gcdi5rCS4rx1L418B5aVPZrht6cMy_WyACKCFbpbkPO8X8k-7zRRuFTicoIPCEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRA14oxp8FHh05GcpbNgUM-CTJk0IoL-yx33mmmE-WgqQ&oe=6B0C6CA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cuidarium", "keywords": ["scifi", "simulation", "management", "care", "pet"], "long_description": "Welcome to **Cuidarium**, a tactile sci-fi creature incubation and care experience designed from the ground up for virtual reality.\n\nTake charge of your own futuristic bio-research facility where every button, screen, and machine is physically interactive\u2014no intrusive menus or text-heavy tutorials.\n\n### Key Features\n* **Incubate & Raise 8 Distinct Species:** Select eggs on your main console, nurture your creatures from juveniles into full-grown adults, and watch them thrive inside specialized biome chambers.\n* **Tactile Hand-Feeding:** Operate your multi-food dispenser to generate 5 different types of food tailored to each species' dietary preferences, then feed your creatures directly by hand.\n* **Bio-Resource Economy:** Once your creatures reach adulthood, collect their harvestable bio-resources and process them in the Bio-Extractor to earn credits.\n* **Expand & Upgrade Your Lab:** Spend your credits on the Upgrade Panel to unlock new incubation chambers and expand your facility to support rarer species.\n* **Comfort-First Seated VR:** Designed specifically for relaxed seated play with intuitive Touch controller interactions and zero motion sickness.", "short_description": "Step into a cozy sci-fi bio-lab in VR! Incubate 8 unique species, hand-feed them tailored meals from your dispenser, and harvest bio-resources as they grow into adults. Upgrade your chambers, unlock rare creatures, and enjoy a relaxing, tactile simulation built for seated play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1bnij-8II_bfYE5e8l1V5q9GZT1GODIg3kTkutyOXk70/edit?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Lagatti", "support_website_url": null, "website_url": "https://lagatty.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1386608597873641"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_2314683905768789_8447174986144770092_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNynVDyNRKIQ7kNvwE82Vgc&_nc_oc=AdqPNLDzWvNG5AjgVth0uQH1MXJtf6_zss1mgRdW0odhLipLIp6ySDf8xPr0_djD4lQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxI9SG7cZS9QutgU_UtzHNpbR-0xb4qEKVtvBeU1H40Q&oe=6B0C681F"}, "is_concept": false, "is_t
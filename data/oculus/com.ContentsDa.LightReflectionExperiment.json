c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybHcZIfvhkTirN51lcC3lSnrjWwlvol-dFbpNCqLUxZA&oe=69B68ED1"}, "display_name": "Light Reflection Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "physics", "reflection", "science", "contentsda"], "long_description": "1. in real life, shining a laser beam into your eyes causes eye damage. Please put the safety glasses on your desk directly over your eyes to conduct the experiment.\n2. Turn on the laser by pressing the Start button.\n3. Move the mirror to check the angle of incidence and reflection of the laser.\n4. Set up an obstacle.\n5. lift the first mirror\n6. lift the first mirror to adjust the angle of incidence and reflection of the laser\n7. Move the second mirror around the obstacle.\n8. lift the second mirror to adjust the angle of incidence and reflection of the laser\n9. hit the teddy bear\n\n<Outcome. \n-Understand angle of incidence and angle of reflection.\n- Understand the law of reflection.", "short_description": "See the world in a new light with the Light Reflection experiment. Explore how light bounces off surfaces, leading to the formation of images, a fundamental aspect of optics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "s
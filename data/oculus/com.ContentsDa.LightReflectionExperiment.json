1071687726292685_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWOzu0jyetMQ7kNvwE5Y5Yr&_nc_oc=AdmjiHKoFvJYuZT9JPs7oEKJaSEZmi8pFf3fXqfgcIZee0bLIOKvTyZRxm93KFesKP4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhGrlCTGK9nGuh7AWw4XnSssn7X_afVFdw91toPERUmA&oe=69AAC287"}, {"file_name": "ApplicationFrameHost_Rg5SicDQhc.png", "id": "1124456625741101", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974882_1124456629074434_3428304107224073731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-JfQDIqGjYQ7kNvwEtvTku&_nc_oc=AdmMsYX7vWWGLDRGiTbmaHIqGpVyw7iaSbTuNFcbADayh6M6Xn2ZLax80LoWy4QwR_A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0M8Ta1Ibs-STTyfHM0w61ba58hM0I9SToCbkVyRYguQ&oe=69AABD13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Light Reflection_Landscape.png", "id": "1036922294079469", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031566_1036922297412802_6760304073352035624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhGv71uwICgQ7kNvwEz5Mp8&_nc_oc=Adnel5m13u1Zx7WZLTMUYIANDvj50xkTo2aGt1lxDxLHUN1qx50GqiFx0037v04tVQw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx3QrC_5B-ZXCEz0VKcxAW3A-NuRRrHMVGZkDZx4B1IA&oe=69AAB151"}, "display_name": "Light Reflection Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "physics", "reflection", "science", "contentsda"], "long_description": "1. in real life, shining a laser beam into your eyes causes eye damage. Please put the safety glasses on your desk directly over your eyes to conduct the experiment.\n2. Turn on the laser by pressing the Start button.\n3. Move the mirror to check the angle of incidence and reflection of the laser.\n4. Set up an obstacle.\n5. lift the first mirror\n6. lift the first mirror to adjust the angle of incidence and reflection of the laser\n7. Move the second mirror around the obstacle.\n8. lift the second mirror to adjust the angle of incidence and reflection of the laser\n9. hit the teddy bear\n\n<Outcome. \n-Understand angle of incidence and angle of reflection.\n- Understand the law of reflection.", "short_description": "See the world in a new light with the Light Reflection experiment. Explore how light bounces off surfaces, leading to the formation of images, a fundamental aspect of optics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8957990714252858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031544_976539797227775_5182379645048025809_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqXxGW3ZDXoQ7kNvwFjR3o0&_nc_oc=Adm8t-8-DJPsWkeGoVOU8CXsB-84jGTLy-TH1WmK91NFcsLf4_8aeq2RhrM3LFdPebs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNzP4Va3l8WafHSraHrBNx1UBbjocWAux6dgofdndjNg&oe=69AAB42C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Light Reflection Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category":
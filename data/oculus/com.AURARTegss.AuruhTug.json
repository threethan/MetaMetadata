MnEwgR4uQ&oe=69E22C64"}, {"file_name": "asasdasdafsd.png", "id": "864482358951503", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57569436_864482362284836_454426749649107642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM3DmOKcuEkQ7kNvwF9xZXw&_nc_oc=Adpi_xL62WHLF-NWuApO8XogStVH88Q4t_dz352TIE5Zt-zzq05SMpv844eF3xqY-Rk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19NtjBQHWD8AKi7ltLWTvYmT0rSj0KM2S8cdEYs8j-Uw&oe=69E23704"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aura Chasers", "keywords": [], "long_description": "Embark on a journey to explore the serene beauty of nature by traveling around tree huts, nestled high in the branches of towering trees or tucked away in lush forests. These cozy, elevated hideaways offer a peaceful retreat where you can reconnect with the natural world, breathe in the fresh air, and escape the hustle and bustle of daily life. Along the way, you can communicate with friends, sharing stories, laughter, and experiences, either through old-fashioned conversations or modern technology. Whether you're gathered around a campfire beneath the stars or lounging in a hammock with a view of the canopy, the combination of nature, tranquillity, and meaningful connection will make for unforgettable memories.", "short_description": "Fun Monkey Locomotion Based Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacyatagsss/home", "developer_terms_of_service_url": null, "publisher_name": "Coast", "support_website_url": null, "website_url": "https://sites.google.com/view/aura-tag-3/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
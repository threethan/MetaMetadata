-7&_nc_sid=6e7a0a&_nc_ohc=2kIro_WAG0cQ7kNvwGB5rhi&_nc_oc=AdpfFT-lgaf8aauIQnZ7zbEgizAr5gWk1GTbQWIy1FkTDGFJeoxrdxVK4rMVdwc9ZHA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3ilG4joTOzMCFtHYuTnweTsO6h8l0UiQeFnjm57e9Ig&oe=6AFC8185"}, {"file_name": "screenshot5.png", "id": "1714145073240724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298137_1714145076574057_5024615935954745180_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5_aVeT6AREQ7kNvwG7vjcs&_nc_oc=AdoPqFePw0UzXnjvhvxhFIVhTtBf_FHcFddrb9SvmGG0EPQtQcrEr70Sx7jvfnKmRrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxj3bSyLMOhj-iS_G9CxzwokkIBt6ELWNNPdgqy1XTyg&oe=6AFC862A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ascend Tag", "keywords": [], "long_description": "# Ascend Tag\n\nWelcome to **Ascend Tag**, a fun and exciting multiplayer VR fan game inspired by *Gorilla Tag*! Master arm-powered movement as you run, climb, jump, and launch yourself through creative maps designed for fast-paced gameplay and endless fun.\n\nChallenge your friends in thrilling tag matches, practice your movement skills, and discover new ways to traverse every environment. Whether you're climbing towering structures, escaping from tagged players, or racing to improve your movement, every match is a new adventure.\n\nExplore a variety of unique maps, collect awesome cosmetics to customize your character, and enjoy regular updates with new content, improvements, and surprises. From casual games to competitive chases, there's always something to do in **Ascend Tag**.\n\nOur goal is to create a welcoming and enjoyable community where players can have fun, make friends, and experience exciting multiplayer gameplay together. Please be respectful to other players, follow the game rules, and help keep the community positive for everyone.\n\n**Features:**\n\n* Fast-paced arm-powered movement.\n* Multiplayer tag gameplay.\n* Unique maps to explore.\n* Fun cosmetics and character customization.\n* Frequent updates with new content.\n* Friendly community and exciting events.\n* Practice areas to improve your movement skills.\n\n**Important Disclaimer:**\n**Ascend Tag** is an unofficial **fan game** inspired by *Gorilla Tag*. It is **not affiliated with, endorsed by, sponsored by, or ass\n\n\n", "short_description": "**Ascend Tag** is a fast-paced multiplayer gorilla movement fan game inspired by *Gorilla Tag*. Run, climb, and launch yourself through fun maps using your arms while playing exciting game modes with friends. Customize your character with cool cosmetics, explore unique environments, and test your movement skills in thrilling tag matches.\n\n**Disclaimer:** * Ascend Tag * is a **fan game** inspired by *Gorilla Tag*. It is **not affiliated with, endorsed by, or associated with Another Axiom LLC**, t"}]}, "developer_name": "Ascend Tag Development Team", "developer_privacy_policy_url": "https://docs.google.com/document/d/1st8ySRBy5zHCgwlNo5D2wl3lj4_HctTU-VVtP1DMcsw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Justsplat1", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1U_7fUtRN2a4tH6d9c0D3BlKetrfaStUTkZjTxMzNstc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "i
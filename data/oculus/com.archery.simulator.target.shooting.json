6_7930173225512695800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlGEOxUmNvMQ7kNvwGPjRis&_nc_oc=AdrnsiNrRa3cLRNwzfAhJ26H4vlIao5pkgzjo901LSV7WpLzgnlg4dDIQ_UoMlL8eeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNSo82_AKjeeJBZugzkg_kWwHcZBgguV529FBBWlFxcg&oe=6AF72A12"}, {"file_name": "screen_2560x1440_2026-09-18_22-06-15.png", "id": "1806621894018620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1806621897351953_1315447642663320257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPa_lSyjFYEQ7kNvwEqZRkt&_nc_oc=AdrfCgOiOmcW619r5pmOH467-Xue2eVvDbpTsF-bF0YnuZtq-Tsb2Ipz9vkYnhPBwxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTKH6agjOLbgfPbHClg0w5ozfrldFswM2NEj3FPds7ZA&oe=6AF74196"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery Simulator: Target Shooting", "keywords": ["Archery", "TargetShooting", "BowAndArrow", "TargetPractice", "BowShooting"], "long_description": "Step into Archery Simulator: Target Shooting and test your aim across 50 handcrafted VR archery levels built for precision, timing, and satisfying bow-and-arrow gameplay.\n\nHold the bow in one hand, grab and nock arrows with the other, pull the string, judge distance and wind, then release naturally to hit the target. Every level introduces a new challenge, from longer shots and moving targets to limited-arrow objectives, timed stages, score goals, and special missions.\n\nTake on:\n\u2022 Target shooting across forests, islands, stadiums, rocky ranges, and city environments\n\u2022 Moving and animated targets that demand accuracy and quick reactions\n\u2022 Wind and distance challenges that make every shot matter\n\u2022 Limited-arrow missions with a visible physical arrow rack\n\u2022 Rescue objectives, locks, balloons, fire and water targets, ice, lava hazards, and helicopter challenges\n\u2022 1\u20133 star ratings, best scores, coins, trophies, retries, and progressive level unlocking\n\u2022 Practice mode with unlimited arrows for relaxed bow training\n\nDesigned for comfortable VR play, every stage keeps you at a carefully positioned shooting point with no forced locomotion. The bright stylized art, readable targets, and arcade presentation make it easy to pick up, while tougher levels reward consistency and mastery.\n\nPerfect for fans of archery, target shooting, bow and arrow games, precision challenges, sports games, and VR simulators.\n", "short_description": "Master the bow in Archery Simulator: Target Shooting, a colorful VR archery challenge built around precision, timing, and satisfying bow-and-arrow physics. Take on 50 handcrafted levels with moving targets, wind, limited arrows, timed stages, rescue missions, balloons, locks, fire, ice, lava hazards, score goals, stars, coins, trophies, and a relaxed practice mode with unlimited arrows.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1321496024386100"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099170676445835"}, {"status": "PUBLISHED", "id": "1850774362
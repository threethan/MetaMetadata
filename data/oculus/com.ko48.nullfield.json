0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxeCmARDVk0Q7kNvwGR-UHS&_nc_oc=AdpQZCEwy8Z3BVdyMsVo0Ahx0jnxHrQMugOmkENzRAM2An_FUqlUG_v6OCqNSMMknAo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9OjW_1L9nBDV43fCWa4Z_8VOlcL5G9XIpf5CWDpaBcg&oe=6AF3374F"}, {"file_name": "screenshot-1-parlour-hands-2560x1440.png", "id": "1781441903088603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1781441906421936_826828372084419731_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxaSjBUmdmsQ7kNvwF16CLZ&_nc_oc=Ado7XtWDSoKkIPgX9BigSATlMtylhzKZri1cOeSONTPOohz7_6m2d4HUEGHRZsg_VmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLEla-81hXMdV55Fsp-ls2feMRXbPAtBuUsVGvlhDzMA&oe=6AF345E3"}, {"file_name": "screenshot-4-tutorial-tablet-2560x1440.png", "id": "4619427168338685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_4619427171672018_3225923890645739704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CeM9I_kZY0Q7kNvwHR7WMv&_nc_oc=Adr_GdUwYTqAxS_q3lrgYpSNBQGeDDIYoZisGmqPU_c3430SSjFT96VBFv66eGbNMrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_skoyylwfIP9RllqTvtgzDJbbvmVtE97S85mtUMvyKw&oe=6AF32900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic-asset-2560x1440.png", "id": "1739698957096402", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_1739698960429735_5141962641238202562_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ahP7gy73BsQ7kNvwGEcXz4&_nc_oc=AdreKirNxIm8uEQ1T2jZ3HAe51SDNXZ92cqQk6oxX6EhZaJS-g7IaExZxSRvDRg3xYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBsWJkGxfJUpXFv_IWY-dLn7kqoLDmtT1T7sinlMuG8A&oe=6AF34D21"}, "display_name": "Nullfield - A Theremin Simulator", "keywords": ["theremin", "music", "instrument", "synthesizer", "handtracking"], "long_description": "Nullfield is a theremin you can play in VR: the electronic instrument you play without touching it. Your right hand sets the pitch near the antenna, your left hand shapes the volume above the loop. No scores, no timers. It is an instrument, and you get better by playing.\n\nREALISTIC SOUND\n\u2022 Real-time synthesis: every note is generated live, no samples\n\u2022 A true theremin field with zero-beat tuning, aerial fingering, vibrato and a gentle tube drift\n\u2022 10 voice presets, plus piano, guitar, harp, organ, flute and violin sounds\n\nTHREE ORIGINAL INSTRUMENTS\n\u2022 Salon Cabinet No. 1, a 1929-style wooden cabinet with glowing tubes\n\u2022 Ether Desk 2, a modern desktop theremin on a mic stand\n\u2022 Nullfield, a near-future slab of aluminium and glass\n\nYOUR OWN STUDIO\n\u2022 Delay and reverb pedals, a four-layer loop station and a tube amp\n\u2022 Record your takes to WAV, keep time with the metronome, put on headphones for a dry sound\n\u2022 Play in a 1930s parlour, a modern recording studio or your own room in passthrough\n\nLEARN AS YOU PLAY\n\u2022 A 12-chapter tutorial guided right in the room, from switching on to your first piece\n\u2022 Optional helpers: note rings around the antenna, a volume bar, a tuner and guide hands\n\u2022 Play along with public-domain classics such as The Swan (Saint-Sa\u00ebns) and Clair de Lune (Debussy)\n\nMADE FOR VR\n\u2022 Hand tracking first, Touch controllers fully supported\n\u2022 Seated or standing, comfortable for long sessions\n\u2022 English and Turkish", "short_description": "Play a realistic theremin with your bare hands. Tune it to zero-beat, shape notes in the air with your fingers, and play through effect pedals, a loop station and a tube amp \u2014 in a 1930s parlour, a modern studio or your own room in passthrough. Three original instruments, a guided tutorial and no scores: just you and the music."}]}, "developer_name": "KO48", "developer_privacy_policy_url": "https://github.com/eedali/Nullfield/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "KO48", "support_website_url": "https://github.com/eedali/N
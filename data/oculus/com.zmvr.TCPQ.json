9217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlTH3iAu1f8Q7kNvwH6arya&_nc_oc=AdolvUU1i7_CVHOe4_ocbo6kt8dtD85Up7dS201rdW-saknQ6dypIhYaQtWA5nhIfAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX_dfjT_IV6uz8MNHJZweNPjaUGUZLX44fzrFSiiFmpQ&oe=6ABD19A4"}]}, "id": "1516727610178844", "locale": "en_US", "screenshots": [{"file_name": "22.png", "id": "2007695566789254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_2007695570122587_7204963322755721350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zUS-5bYJLEQ7kNvwHnxwJj&_nc_oc=AdrIfc06pbWCpjCUheDi5Zkp5DN80mqchfin3QEaudMkcOR_nP3RgV5TXqEUWlG83pA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb6T4aTunXxNHDsZLJhjQ7h-LRo1TcWf7boa5BQghWzQ&oe=6ABD1E06"}, {"file_name": "Home_\u526f\u672c.png", "id": "971962338806456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593983210_971962342139789_6284654514358579128_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtUrZ4wM8f4Q7kNvwEJOk3f&_nc_oc=AdqIeTifTFgsIaOp6LfD1QcCxpAeKEhTmJURT9AtD93oaIm2_En1nRwtQRCtCBPoq6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIbLT-XZlmHPrOq1L1GVX1nnB9gH78NqBrkAd5HQp0LQ&oe=6ABD1969"}, {"file_name": "2klobby.png", "id": "746508168524115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623384_746508171857448_8102463208116555955_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUA_WJtXWeUQ7kNvwHjVHSb&_nc_oc=AdoXEG1xbIZBv3F8_NOx-DQ7I0EkIgImNUgcK8iI6wwwRO7qjAHxO2x7BEbSE4tv2WM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW5hf0hGV1dfYahl1PHzcgGfqzeeLqfc0QiTTytcceAA&oe=6ABD28FD"}, {"file_name": "2k19.png", "id": "4525495801067091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620965_4525495804400424_803385464731135205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbzKNVzFrJ0Q7kNvwFCgBN9&_nc_oc=Ado2yVMOt0UXD1OfFGbx7sFyZ7Q8fjlM-YvSxQyYf9RNHPEyeAkY08QYlFhJpEoWIto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdcXwXQhRiiWOtfOqOxcEKCvetgLyZ6qaosxjdSu4qVQ&oe=6ABD1B3F"}, {"file_name": "2k27.png", "id": "1022086527023546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595143057_1022086530356879_8176922957643609569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSMtTpJisGIQ7kNvwEL4kY9&_nc_oc=AdpmIXf0cigK9fm_EkbDDckIy7ndMvlULR6JEpZt2nsSIRurIFYsYoIQEaOyXuTlhRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBHeh_rGMlNz-oU7VPaetZ3WLS6cO4nO5YYW-wMRR7Mg&oe=6ABD3336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Cinder Pact", "keywords": [], "long_description": "STRATEGIC CO-OP RPG: SURVIVE THE HORDE\n\nYour journey begins with intense hold-the-line battles, quickly opening up to diverse theme dungeons and complex mazes. This is a true Class-Based RPG where ranged firepower, class synergy, and mana management dictate survival. Team up and bond with players worldwide in the ultimate social dungeon-crawling experience!  \n\nTHE FOUR LEGENDS\n\nDefine the battlefield with unique primary attacks and two active skills:  The Armored: Frontline DPS with heavy firepower and raw physical destruction.  The Healer: Team core. Channel holy light to sustain allies and turn the tide.  The Mechanic: Technology master. Deploy tactical gadgets and unleash stunning electrical arcs.  The Summoner: Void commander. Call forth loyal minions and manipulate dark energies.  \n\nCYAN CRYSTAL JADE & PROGRESSION\n\nConquer deep labyrinths to harvest Cyan Crystal Jade, the core material needed to ascend your character. Customize your build through 7 distinct attributes: ATK, Max HP, Max MP, DEF, Movement Speed, and specialized Skill Power (Skill 1 & Skill 2). Manage your Mana (MP) wisely\u2014every cast is a tactical decision.  \n\nZERO GRIND, ALL THRILLS\n\nFast-Start: Complete the 10-minute tutorial and jump directly to Level 5, unlocking your first core skill.  Epic Scale: Brace for massive, multi-wave assaults pushing teamwork and social coordination to the limit.  True F2P: No pay-to-win. Only high-quality, full-model Avatar skins are for sale to showcase your style in social hubs.  ", "short_description": "Dive into a 4-player VR Co-op RPG! Choose from 4 unique classes, master powerful ranged skills, and conquer evolving labyrinths and dungeons. Experience deep RPG mechanics and a vibrant social hub in this 100% Free-to-Play adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheCinderPact.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "27278368948467899"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1591324455300906"}]}, "baseline_offer": {"id": "1591324455300906"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780624800, "status": "PUBLISHED", "id": "1591324455300906"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28626061860365261", "version": "2.6.5"}, "id": "1893533334488674", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary
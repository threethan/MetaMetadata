qoabplm3QSXUFM-ysyq7R2eJooVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsIwOMroZ1svivWNio3j4yMwpC_y3KoQzJqMFKfc9vcw&oe=6A6CB286"}, {"file_name": "Home_\u526f\u672c.png", "id": "971962338806456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593983210_971962342139789_6284654514358579128_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrjSdbrmFH8Q7kNvwEIbe7B&_nc_oc=AdpvQlrfqPEXSrXZSxCw6WWa-bngVj8WMSz8jGdYcMJvYRceDcEolvSUtJnuId2Ja9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-9W1uW7lUKb5GIsoWD9nJ98pJqLboFi2yeAI94HYwJw&oe=6A6CADE9"}, {"file_name": "2klobby.png", "id": "746508168524115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623384_746508171857448_8102463208116555955_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y76Tbvjp3UUQ7kNvwG1Akml&_nc_oc=AdrKcZEeUA7mCTq4zr0CSuTP4gqNfuSnKdLA_A9GnsF99GY2mxlInKUyWYbBZZVapq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr3tnjJiBsqp2DM0OWj28u2Tf45JexnntxEhz99o1aqg&oe=6A6CBD7D"}, {"file_name": "2k19.png", "id": "4525495801067091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620965_4525495804400424_803385464731135205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1yYEwZdqKkQ7kNvwHky6ZH&_nc_oc=Adp1WVtDntICOS74TXkR0ihjU6KVW4-rMSPida8bu7Na2wrTEPtptfamt5FC0iHt8Eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzT2VAb59_9bh46UAceHIwlTQda7Qt80PWplliDIYLrg&oe=6A6CAFBF"}, {"file_name": "2k27.png", "id": "1022086527023546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595143057_1022086530356879_8176922957643609569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnEyHrzAOQoQ7kNvwEeLHI7&_nc_oc=AdoOuj4hjfDtJMyL0S24AfNGjgeFQv1GOc5S1q3ZBC3MqaDDKOk3V7kFB5cO1fn79c0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkqZzpoXYGLX3KTlx7SNzh8zphI4A3j9aPK4IUT9lLvA&oe=6A6C8F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Cinder Pact", "keywords": [], "long_description": "STRATEGIC CO-OP RPG: SURVIVE THE HORDE\n\nYour journey begins with intense hold-the-line battles, quickly opening up to diverse theme dungeons and complex mazes. This is a true Class-Based RPG where ranged firepower, class synergy, and mana management dictate survival. Team up and bond with players worldwide in the ultimate social dungeon-crawling experience!  \n\nTHE FOUR LEGENDS\n\nDefine the battlefield with unique primary attacks and two active skills:  The Armored: Frontline DPS with heavy firepower and raw physical destruction.  The Healer: Team core. Channel holy light to sustain allies and turn the tide.  The Mechanic: Technology master. Deploy tactical gadgets and unleash stunning electrical arcs.  The Summoner: Void commander. Call forth loyal minions and manipulate dark energies.  \n\nCYAN CRYSTAL JADE & PROGRESSION\n\nConquer deep labyrinths to harvest Cyan Crystal Jade, the core material needed to ascend your character. Customize your build through 7 distinct attributes: ATK, Max HP, Max MP, DEF, Movement Speed, and specialized Skill Power (Skill 1 & Skill 2). Manage your Mana (MP) wisely\u2014every cast is a tactical decision.  \n\nZERO GRIND, ALL THRILLS\n\nFast-Start: Complete the 10-minute tutorial and jump directly to Level 5, unlocking your first core skill.  Epic Scale: Brace for massive, multi-wave assaults pushing teamwork and social coordination to the limit.  True F2P: No pay-to-win. Only high-quality, full-model Avatar skins are for sale to showcase your style in social hubs.  ", "short_description": "Dive into a 4-player VR Co-op RPG! Choose from 4 unique classes, master powerful ranged skills, and conquer evolving labyrinths and dungeons. Experience deep RPG mechanics and a vibrant social hub in this 100% Free-to-Play adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheCinderPact.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "sup
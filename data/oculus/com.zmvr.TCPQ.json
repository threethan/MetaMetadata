9217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPv-szHiavEQ7kNvwFvnYj5&_nc_oc=Adpz_gX0GMr9FSn8TuPuJXfLW8278RCYhUyp-ZhEDTyZ0Y8QyRc8lDykF5fpoWi_v84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT62FwmAr4tui1zlTZiLJKTTrNKhumZ0WwXTW9e6tum2w&oe=6AF32724"}]}, "id": "1516727610178844", "locale": "en_US", "screenshots": [{"file_name": "22.png", "id": "2007695566789254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619159_2007695570122587_7204963322755721350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM302JU7eckQ7kNvwEEBXE1&_nc_oc=AdowcQ777JQqKGHAuzWOHowUoRHawmea2WIqhUnAwNECY0Dvi1IJa8WoeM6y0qtuKso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcUODlVRkZVMLAF6yQY9WlzZxPylrCvLHDPw3v5XfEqQ&oe=6AF32B86"}, {"file_name": "Home_\u526f\u672c.png", "id": "971962338806456", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593983210_971962342139789_6284654514358579128_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q_lsy1BSnYQ7kNvwFLSqRr&_nc_oc=AdpVJzhp0Hqn71I1a8X0vkSuoGpuBV9Smyf1ZY-yj6FyXRQj2TmaNAUfQ24XBdt49Nk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMfxVp9vohT_TYHrn6ORJmcH54FgpXgSPmkZoZdvcSfA&oe=6AF326E9"}, {"file_name": "2klobby.png", "id": "746508168524115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623384_746508171857448_8102463208116555955_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ziK5ysK9t8Q7kNvwEj1I21&_nc_oc=Adqo1PLU5CUjjOpspdQ-tgAnRTF1Gn9hQetJ56Q4EEcw1mVmdjsY_KqAa9xBtfiVpXk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIBX20KLKmN_T3kFOPaDbFOymOW_xLY84svZBKX4EvZw&oe=6AF3367D"}, {"file_name": "2k19.png", "id": "4525495801067091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620965_4525495804400424_803385464731135205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zBfNO2T0N0Q7kNvwFe21ut&_nc_oc=AdoUzx5fs63FYopyAED2m9mhv71RfP430xwKYG7rly-ifmpnjz_HThhZG_K3_QmzvA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFjgK2qik7yddly5TNwo7F_Bbh8B6MaxcpnIsH88-eLw&oe=6AF328BF"}, {"file_name": "2k27.png", "id": "1022086527023546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595143057_1022086530356879_8176922957643609569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFWv_4xLZVoQ7kNvwE3nwYv&_nc_oc=Adqwi4SuZJqBI3N3bft3W4Fd2G7vjA38omK-9kzdW9cqCNt9mtBs8vQr578obnWpo-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjuM6ypxzNR2qEXfmhAc20BNamzvhp_KKioVsGwOlDlQ&oe=6AF340B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Cinder Pact", "keywords": [], "long_description": "STRATEGIC CO-OP RPG: SURVIVE THE HORDE\n\nYour journey begins with intense hold-the-line battles, quickly opening up to diverse theme dungeons and complex mazes. This is a true Class-Based RPG where ranged firepower, class synergy, and mana management dictate survival. Team up and bond with players worldwide in the ultimate social dungeon-crawling experience!  \n\nTHE FOUR LEGENDS\n\nDefine the battlefield with unique primary attacks and two active skills:  The Armored: Frontline DPS with heavy firepower and raw physical destruction.  The Healer: Team core. Channel holy light to sustain allies and turn the tide.  The Mechanic: Technology master. Deploy tactical gadgets and unleash stunning electrical arcs.  The Summoner: Void commander. Call forth loyal minions and manipulate dark energies.  \n\nCYAN CRYSTAL JADE & PROGRESSION\n\nConquer deep labyrinths to harvest Cyan Crystal Jade, the core material needed to ascend your character. Customize your build through 7 distinct attributes: ATK, Max HP, Max MP, DEF, Movement Speed, and specialized Skill Power (Skill 1 & Skill 2). Manage your Mana (MP) wisely\u2014every cast is a tactical decision.  \n\nZERO GRIND, ALL THRILLS\n\nFast-Start: Complete the 10-minute tutorial and jump directly to Level 5, unlocking your first core skill.  Epic Scale: Brace for massive, multi-wave assaults pushing teamwork and social coordination to the limit.  True F2P: No pay-to-win. Only high-quality, full-model Avatar skins are for sale to showcase your style in social hubs.  ", "short_description": "Dive into a 4-player VR Co-op RPG! Choose from 4 unique classes, master powerful ranged skills, and conquer evolving labyrinths and dungeons. Experience deep RPG mechanics and a vibrant social hub in this 100% Free-to-Play adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheCinderPact.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "27278368948467899"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1591324455300906"}]}, "baseline_offer": {"id": "1591324455300906"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780624800, "status": "PUBLISHED", "id": "1591324455300906"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28626061860365261", "version": "2.6.5"}, "id": "1893533334488674", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary
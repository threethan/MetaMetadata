/499618254_1502942281428364_4184699933371625427_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41Tlf6YF5dQQ7kNvwG11eyg&_nc_oc=Adr7mPMYsYDEiEnzwc_N5F5U9fnhOPbF870geFmDjakJIauFOoMaM2xxPLjkgner4Fs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFNZ8ZSaiJorM8JJesvX5NZGYr6vQyhePdN4SOja0gqw&oe=6B05D486"}, {"file_name": "3840X1240.png", "id": "1448323549802908", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1448323553136241_7038101436254029217_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoP6RYm-vWIQ7kNvwECuolQ&_nc_oc=AdrffaqBcqd4jgB2alK-kUYODHJl-Pwf7azI35CCb2McfuE4iExKUSjQF-48-8EfyCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5msbaAVnLD-HYDtODZXmbt09qtRL4-68QBj8FYmYGyg&oe=6B05D464"}]}, "id": "1516727610178844", "locale": "en_US", "screenshots": [{"file_name": "22.png", "id": "2007695566789254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_2007695570122587_7204963322755721350_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DAB67INvyYQ7kNvwFmoybE&_nc_oc=AdrZYstTul0bc0bImNO6v9hVBQkI0rZyLV3NuUyO6SdxEdB3cN9w2i4n3p8JvFaTF8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnNGcybnKHOBewxcM5ZsVSrbEoeaLFMiMWhbNq54v2cA&oe=6B05D8C6"}, {"file_name": "Home_\u526f\u672c.png", "id": "971962338806456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593983210_971962342139789_6284654514358579128_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH5nzi_EwnYQ7kNvwG6YuSj&_nc_oc=AdpBV78bWkv5N66lUH_ZYrT3OMs7wzk-ZHXvSt0xCzxyqfBplhLA5PutyvZyKqsir4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoA_Z95vFU7qwndzYRT6AW51IQhAGnSz6o0B8DFIKB5w&oe=6B05D429"}, {"file_name": "2klobby.png", "id": "746508168524115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_746508171857448_8102463208116555955_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXl9IBMHq-UQ7kNvwF_imQf&_nc_oc=AdpRBnCcVxS0COpLLh1OIeQVvYTYwiD8r1epKPOGgE8CUQ3iM8CCheLZaiJ2zyGf0so&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpO3Xp-abe2NDF9Pi7m7iozkaCEjRCsMM-r8G2TbhGnQ&oe=6B05AB7D"}, {"file_name": "2k19.png", "id": "4525495801067091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620965_4525495804400424_803385464731135205_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdS0jPD1O1MQ7kNvwGGMv41&_nc_oc=AdqB2Aw0AtpWZrsxhCvvrsxvCD6vVXGBvZd7Km0Imqzzq-rxkTo1GFI7V5RwqUR_shw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_w88ijpwBVKDH3oBgsKcP3qQPrjX8N1BU5WXWlWWDw&oe=6B05D5FF"}, {"file_name": "2k27.png", "id": "1022086527023546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595143057_1022086530356879_8176922957643609569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMTVDRcRizcQ7kNvwGLm2wl&_nc_oc=AdpAECObaJlz48nyIAit1W74tnlJ-FBJijeV3_KhfCjlT22zudyOYaz362c9nmqH2I0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI3t7Kcuo_NBbuKutfOP1uvQnZfDnsUyqz1XY0YdSXsg&oe=6B05B5B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Cinder Pact", "keywords": [], "long_description": "STRATEGIC CO-OP RPG: SURVIVE THE HORDE\n\nYour journey begins with intense hold-the-line battles, quickly opening up to diverse theme dungeons and complex mazes. This is a true Class-Based RPG where ranged firepower, class synergy, and mana management dictate survival. Team up and bond with players worldwide in the ultimate social dungeon-crawling experience!  \n\nTHE FOUR LEGENDS\n\nDefine the battlefield with unique primary attacks and two active skills:  The Armored: Frontline DPS with heavy firepower and raw physical destruction.  The Healer: Team core. Channel holy light to sustain allies and turn the tide.  The Mechanic: Technology master. Deploy tactical gadgets and unleash stunning electrical arcs.  The Summoner: Void commander. Call forth loyal minions and manipulate dark energies.  \n\nCYAN CRYSTAL JADE & PROGRESSION\n\nConquer deep labyrinths to harvest Cyan Crystal Jade, the core material needed to ascend your character. Customize your build through 7 distinct attributes: ATK, Max HP, Max MP, DEF, Movement Speed, and specialized Skill Power (Skill 1 & Skill 2). Manage your Mana (MP) wisely\u2014every cast is a tactical decision.  \n\nZERO GRIND, ALL THRILLS\n\nFast-Start: Complete the 10-minute tutorial and jump directly to Level 5, unlocking your first core skill.  Epic Scale: Brace for massive, multi-wave assaults pushing teamwork and social coordination to the limit.  True F2P: No pay-to-win. Only high-quality, full-model Avatar skins are for sale to showcase your style in social hubs.  ", "short_description": "Dive into a 4-player VR Co-op RPG! Choose from 4 unique classes, master powerful ranged skills, and conquer evolving labyrinths and dungeons. Experience deep RPG mechanics and a vibrant social hub in this 100% Free-to-Play adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheCinderPact.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_m
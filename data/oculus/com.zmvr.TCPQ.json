9217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlTH3iAu1f8Q7kNvwFj20pH&_nc_oc=AdopdDHp9tDr_E78KN7N5Ohf5iPcuhe4rq-jq4AASbsOuz-O70A5weeAd9XPWmxWzAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKto-IrMtiaaDbSk_dmaVi9YUXu-vTlmnDeGm8NSFZNeQ&oe=6ABBC824"}]}, "id": "1516727610178844", "locale": "en_US", "screenshots": [{"file_name": "22.png", "id": "2007695566789254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_2007695570122587_7204963322755721350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWbhLeBTjMEQ7kNvwGk8tyg&_nc_oc=AdrjDVGjVYiWK5S1u5DhH7Vuu7f0Q21OGDDryvqyuhN6WXGTuGBAVfYRGWEz9sU5eTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_jXZNYot9okbGvXYaqPeeRnULd9QfaStg9kq36y-INg&oe=6ABBCC86"}, {"file_name": "Home_\u526f\u672c.png", "id": "971962338806456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593983210_971962342139789_6284654514358579128_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtUrZ4wM8f4Q7kNvwEvbBt4&_nc_oc=AdpLpsiTL1KSSZUngWf05ktuEcPz003NpJKKKWDaBE0meXYy_QhZ3yuyORVSExrbTxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4euontdpQRHRfP4qftJQ5JSMXj_WGmDssJDZ-3yvSNg&oe=6ABBC7E9"}, {"file_name": "2klobby.png", "id": "746508168524115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_746508171857448_8102463208116555955_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUA_WJtXWeUQ7kNvwHeMsu_&_nc_oc=Adpb39_j-Pap3dCXYX_FyBmKrZ9AnDppPf1zrdXsjfVC_24Nr4sG2bc-Ckd70xXiwyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAzLq1GzuyIthX2Pj120cGv6kR3VGKJcGcVz5YsJm0tA&oe=6ABBD77D"}, {"file_name": "2k19.png", "id": "4525495801067091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620965_4525495804400424_803385464731135205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biLI-HFWvEsQ7kNvwFNpbxX&_nc_oc=AdptkbmF-U1X334hpS3WH22fyl51IGsRkc9bWBh5wjrpUCeVRhj2DVm5rjtlsZlMaXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcyCfayYDXNHRqIWl6rLKFKVHH3VrSyoSBExfMUR9Ynw&oe=6ABBC9BF"}, {"file_name": "2k27.png", "id": "1022086527023546", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595143057_1022086530356879_8176922957643609569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSMtTpJisGIQ7kNvwFdAkKf&_nc_oc=AdqsawYRYA_y_Be2UaOQV8RGHaySEYZE2OS8OpdKRpCdh2IXRSGG_TEyfiZuTlamecM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_wZf0CdkNT36hkrWPvaUeVnsqpmvJltWOPU4JGI6RAA&oe=6ABBE1B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Cinder Pact", "keywords": [], "long_description": "STRATEGIC CO-OP RPG: SURVIVE THE HORDE\n\nYour journey begins with intense hold-the-line battles, quickly opening up to diverse theme dungeons and complex mazes. This is a true Class-Based RPG where ranged firepower, class synergy, and mana management dictate survival. Team up and bond with players worldwide in the ultimate social dungeon-crawling experience!  \n\nTHE FOUR LEGENDS\n\nDefine the battlefield with unique primary attacks and two active skills:  The Armored: Frontline DPS with heavy firepower and raw physical destruction.  The Healer: Team core. Channel holy light to sustain allies and turn the tide.  The Mechanic: Technology master. Deploy tactical gadgets and unleash stunning electrical arcs.  The Summoner: Void commander. Call forth loyal minions and manipulate dark energies.  \n\nCYAN CRYSTAL JADE & PROGRESSION\n\nConquer deep labyrinths to harvest Cyan Crystal Jade, the core material needed to ascend your character. Customize your build through 7 distinct attributes: ATK, Max HP, Max MP, DEF, Movement Speed, and specialized Skill Power (Skill 1 & Skill 2). Manage your Mana (MP) wisely\u2014every cast is a tactical decision.  \n\nZERO GRIND, ALL THRILLS\n\nFast-Start: Complete the 10-minute tutorial and jump directly to Level 5, unlocking your first core skill.  Epic Scale: Brace for massive, multi-wave assaults pushing teamwork and social coordination to the limit.  True F2P: No pay-to-win. Only high-quality, full-model Avatar skins are for sale to showcase your style in social hubs.  ", "short_description": "Dive into a 4-player VR Co-op RPG! Choose from 4 unique classes, master powerful ranged skills, and conquer evolving labyrinths and dungeons. Experience deep RPG mechanics and a vibrant social hub in this 100% Free-to-Play adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheCinderPact.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "27278368948467899"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1591324455300906"}]}, "baseline_offer": {"id": "1591324455300906"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780624800, "status": "PUBLISHED", "id": "1591324455300906"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28626061860365261", "version": "2.6.5"}, "id": "1893533334488674", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary
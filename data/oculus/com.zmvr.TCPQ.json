y7PCPwMj2jpQFdkpPX6D2OM3nOmtgZShLRW-Z5Ko4yp9xeaRN5tPO_vA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyoJG96_o3tpuYQjEcEHE9oGqTEw3vnfuOr-hNAi5c1g&oe=6A6382FD"}, {"file_name": "2k19.png", "id": "4525495801067091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620965_4525495804400424_803385464731135205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDVAjnxnkLMQ7kNvwFePS2r&_nc_oc=Adqli00NkGDHqcRYFHMaGTsLJuNsIhTanoS9VGVBMrLEPbHvl7QbBJ2GyyU28Okb9vQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ1zUZfvZa91Sg84BGHD7L_OGrvSJ3lpWU8ZKmUXQvcQ&oe=6A63753F"}, {"file_name": "2k27.png", "id": "1022086527023546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595143057_1022086530356879_8176922957643609569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qesBZVyhGsoQ7kNvwFK_DTQ&_nc_oc=Ado4hZ-UhITH3Ysfv1e_apMnAjW-WnlG4xybuK9zDLkFJ-VdUQn5E_x8kCGG_mZ3QV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLP8x97uMCTV5tN6KUWFWxDfHj8uzELgqJN2WfNTFz8Q&oe=6A6354F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Cinder Pact", "keywords": [], "long_description": "STRATEGIC CO-OP RPG: SURVIVE THE HORDE\n\nYour journey begins with intense hold-the-line battles, quickly opening up to diverse theme dungeons and complex mazes. This is a true Class-Based RPG where ranged firepower, class synergy, and mana management dictate survival. Team up and bond with players worldwide in the ultimate social dungeon-crawling experience!  \n\nTHE FOUR LEGENDS\n\nDefine the battlefield with unique primary attacks and two active skills:  The Armored: Frontline DPS with heavy firepower and raw physical destruction.  The Healer: Team core. Channel holy light to sustain allies and turn the tide.  The Mechanic: Technology master. Deploy tactical gadgets and unleash stunning electrical arcs.  The Summoner: Void commander. Call forth loyal minions and manipulate dark energies.  \n\nCYAN CRYSTAL JADE & PROGRESSION\n\nConquer deep labyrinths to harvest Cyan Crystal Jade, the core material needed to ascend your character. Customize your build through 7 distinct attributes: ATK, Max HP, Max MP, DEF, Movement Speed, and specialized Skill Power (Skill 1 & Skill 2). Manage your Mana (MP) wisely\u2014every cast is a tactical decision.  \n\nZERO GRIND, ALL THRILLS\n\nFast-Start: Complete the 10-minute tutorial and jump directly to Level 5, unlocking your first core skill.  Epic Scale: Brace for massive, multi-wave assaults pushing teamwork and social coordination to the limit.  True F2P: No pay-to-win. Only high-quality, full-model Avatar skins are for sale to showcase your style in social hubs.  ", "short_description": "Dive into a 4-player VR Co-op RPG! Choose from 4 unique classes, master powerful ranged skills, and conquer evolving labyrinths and dungeons. Experience deep RPG mechanics and a vibrant social hub in this 100% Free-to-Play adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheCinderPact.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "27278368948467899"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1591324455300906"}]}, "base
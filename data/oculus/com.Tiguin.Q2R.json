ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usgxc-2BydEQ7kNvwFqIkXx&_nc_oc=AdobX9nxTzaQfi5I3ujUugw19g2nZFfaQgW36NMe48CBjEtlOKmdE6ejH2nAk_W6xYY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCALvS_XPqdFSw_mxIVwtFczLpEZYwVIx0xNC5DVmcAwQ&oe=6A58CE58"}, {"file_name": "com.oculus.vrshell-20260424-105807.png", "id": "1633685807681461", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824741_1633685811014794_2772133140230544362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEp5wUWFSzAQ7kNvwGnkTkr&_nc_oc=AdpxyFxCk0Jut_RVDuypRTXRmGDkmFFB1LCpEg_FYmGFpDX2cg3ydBvQ3P8qaVrd2KA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBflMXM_ppLmfmUDjZfv9jtY8KDn7f8UQzwMAEMxuvUSA&oe=6A58CF79"}, {"file_name": "com.oculus.vrshell-20260424-105902.png", "id": "4346981092187935", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820875_4346981095521268_409495172829305211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI-WII0iUN8Q7kNvwF2MhqY&_nc_oc=AdqjkJ9EeSYKRDGWtxxbITkk_2vr3RlgskaklVGVbRZCpIBKWxT4QEL-6wHze9mLv34&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBinOi8VXdqSPzI1FUrQvY7a_MRl8qK6k29a4qr0qUPgw&oe=6A58DE1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tcover.png", "id": "931138445287885", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974893_931138448621218_6545389767262455564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42dRmagGnlsQ7kNvwF_5IGr&_nc_oc=AdobjHpENWRb1M2CZqV06gzxKlaMrJqrBAGYcS-bVqpzfTQyM-1p7_NBRElv8pcgNFM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1krvlzL95g84vpmTCLyzgKP80u3zMRO4cIki1M9qHzw&oe=6A58EC11"}, "display_name": "Quest2ROS", "keywords": [], "long_description": "Ideal to set up a teleoperation for robots running ROS.\nProject website: https://mcwelle.com/q2r/\n\nThe relative frame for each controller can be set by pressing both buttons on the controller respectively. For the best intuitive performance line the controller up with the robotic frame and press both buttons (A+B for the right controller, X+Y for the left controller)\n\nPublishers:\novr2ros_left_hand_pose\novr2ros_left_hand_twist\novr2ros_left_hand_inputs\novr2ros_right_hand_pose\novr2ros_right_hand_twist\novr2ros_right_hand_inputs\n\nThe pose is of ROS message type PoseStamped(https://docs.ros.org/en/noetic/api/geometry_msgs/html/msg/PoseStamped.html), the velocity is a Twist message type (https://docs.ros.org/en/noetic/api/geometry_msgs/html/msg/Twist.html), and the inputs are via a custom message:\nbool button_upper\nbool button_lower\nfloat32 thumb_stick_horizontal\nfloat32 thumb_stick_vertical\nfloat32 press_index\nfloat32 press_middle\n\nA haptic feedback can be provided by sending a custom ROS message to the controllers controlling the frequency and amplitude of the controller vibration:\nfloat32 frequency\nfloat32 amplitude\n\nSubscribers:\novr2ros_left_hand_haptic_feedback\novr2ros_right_hand_haptic_feedback", "short_description": "Quest2ROS enables the user to set an IP and PORT to connect to a ROS node via the ROS-TCP-Connector via a VR interface. \nThe app publishes the relative position and orientation (as PoseStamped), the velocity (Twist), and the button presses of both controllers (custom ROS message). It offers a subscriber for haptic feedback (frequency and amplitude of controller vibration) for each controller.\nIdeal to set up a teleoperation for robots running ROS.\nWebsite: https://mcwelle.com/q2r/"}]}, "developer_name": "Michael C. Welle", "developer_privacy_policy_url": "https://mcwelle.com/q2r/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Tiguin", "support_website_url": null, "website_url": "https://mcwelle.com/q2r/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26794164823533227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982548_899969825033617_4877983937045092345_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWzAP9UUgO0Q7kNvwGiePeK&_nc_oc=AdqHQXWQyiygTTjPLCo0qreU4RGwbT_3hgelbDBFFjhxiXxtpFsDnluD_HZiRtecO6I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo8W1fme2yOj3zDwJpdULCUoMLQhPPTK-xUYJN3x1mtg&oe=6A58D08C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Quest2ROS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1778151600, "lastRevision": {"nodes": [{"id": "7012450932131243", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7012450898797913", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "717671896881609"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "q2r_logo_portrait.png", "id": "1019105195982264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031370_1019105202648930_1071940613867598735_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIF-oDEdJ_kQ7kNvwE8-J7G&_nc_oc=Adq2GI0b_VKR5_kqyazUdkbmtIF8mY68YXDS4hzi6ZyBoWrZR74Ubj_uX2Gg3TG5M-g&_nc_zt=3&_nc_
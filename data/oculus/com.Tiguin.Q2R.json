ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIfBo0ie8a0Q7kNvwHYRi1C&_nc_oc=AdrVkPW5zVmR5YUoYY4YbiELcfDzdJNXc-yhr74PHX-4GglZHH-V6Wh1qtAjk8bnQFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFupOpm7KZxOIGUKKa4fm78xAaO9wTpbSGCKB33n5i2mQ&oe=6A95E3D8"}, {"file_name": "com.oculus.vrshell-20260424-105807.png", "id": "1633685807681461", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1633685811014794_2772133140230544362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShwwEM0Y_DsQ7kNvwESlMFP&_nc_oc=AdrrCMHZBWtyjAor4rjVmjf_hsIWyo1dH1kgzuCtBLzP4fHXG3yNFocHGTKacf7TkP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWJTm1uqNk7Kge0yKg1smqqqSERcESF5nhz6-DqLic5w&oe=6A95E4F9"}, {"file_name": "com.oculus.vrshell-20260424-105902.png", "id": "4346981092187935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820875_4346981095521268_409495172829305211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifqv-oNT0uIQ7kNvwGKh0uM&_nc_oc=AdrRMlfm-zhBSHfL4tCCPorrep1oRAkn_dX4b3h08_AUa5j-6bcv5Zs0Hvt1sSIuG0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOUP6scHoPE0l3-zROK6YDA12DxbiPYjgdn58vVfAEug&oe=6A95BB5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tcover.png", "id": "931138445287885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974893_931138448621218_6545389767262455564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFkgZrinbNsQ7kNvwGR-aiq&_nc_oc=AdpF-dyLGM5hf0IkVj8nI1l3H1HGwfJGbpWgjAyvtwWnRn-OrPhDWzY0ci0iLvaatBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0oxIi9vN_wji7sCA41NC1jTRwBdWI_AHFAEJrvhajbw&oe=6A95C951"}, "display_name": "Quest2ROS", "keywords": [], "long_description": "Ideal to set up a teleoperation for robots running ROS.\nProject website: https://mcwelle.com/q2r/\n\nThe relative frame for each controller can be set by pressing both buttons on the controller respectively. For the best intuitive performance line the controller up with the robotic frame and press both buttons (A+B for the right controller, X+Y for the left controller)\n\nPublishers:\novr2ros_left_hand_pose\novr2ros_left_hand_twist\novr2ros_left_hand_inputs\novr2ros_right_hand_pose\novr2ros_right_hand_twist\novr2ros_right_hand_inputs\n\nThe pose is of ROS message type PoseStamped(https://docs.ros.org/en/noetic/api/geometry_msgs/html/msg/PoseStamped.html), the velocity is a Twist message type (https://docs.ros.org/en/noetic/api/geometry_msgs/html/msg/Twist.html), and the inputs are via a custom message:\nbool button_upper\nbool button_lower\nfloat32 thumb_stick_horizontal\nfloat32 thumb_stick_vertical\nfloat32 press_index\nfloat32 press_middle\n\nA haptic feedback can be provided by sending a custom ROS message to the controllers controlling the frequency and amplitude of the controller vibration:\nfloat32 frequency\nfloat32 amplitude\n\nSubscribers:\novr2ros_left_hand_haptic_feedback\novr2ros_right_hand_haptic_feedback", "short_description": "Quest2ROS enables the user to set an IP and PORT to connect to a ROS node via the ROS-TCP-Connector via a VR interface. \nThe app publishes the relative position and orientation (as PoseStamped), the velocity (Twist), and the button presses of both controllers (custom ROS message). It offers a subscriber for haptic feedback (frequency and amplitude of controller vibration) for each controller.\nIdeal to set up a teleoperation for robots running ROS.\nWebsite: https://mcwelle.com/q2r/"}]}, "developer_name": "Michael C. Welle", "developer_privacy_policy_url": "https://mcwelle.com/q2r/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Tiguin", "support_website_url": null, "website_url": "https://mcwelle.com/q2r/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26794164823533227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982548_899969825033617_4877983937045092345_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huC2cxWmi2gQ7kNvwGk6Qm1&_nc_oc=Adq4bc3KXdESgfuncTjt26ScpWlcTEzf_ibF492Ub2vFy8il9fhVm5WfYLDUlGNjC0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjDZ1NEAUWcytP0N9OVhcVfAbG9oS-lezceCDr7fOY0Q&oe=6A95ADCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Quest2ROS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1778151600, "lastRevision": {"nodes": [{"id": "7012450932131243", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7012450898797913", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "717671896881609"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "q2r_logo_portrait.png", "id": "1019105195982264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031370_1019105202648930_1071940613867598735_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-MB5Y7cDUEQ7kNvwHdia7_&_nc_oc=AdqYecJpklzSAyLkcZ0ekdCAjI09jpvKFhWkTnsGKcnn0R8broknrxJMNeEA4Y48fD8&_nc_zt=3&_nc_
KXa3tbm3s5zbxu4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_KTL2W01CqSQGbwgy_avPSpDPA3I6fWL3vFAS0bZRqA&oe=6A2FF82B"}, {"file_name": "vlcsnap-2024-07-26-18h03m49s591.png", "id": "454320890749453", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974790_454320894082786_707571771440452654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iDYYHhlnQ4Q7kNvwFOsOG2&_nc_oc=AdoDCRuuPSRIsOe4nO7oucp0F7a03gZroQterRzql-t7bk5Q-7XHEy0x0ynJJkkpmzA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iJLiHlBC3Pr40C5VU7tar6la_UPSMj_SAlNgtgYTFdw&oe=6A3009B0"}, {"file_name": "vlcsnap-2024-07-26-18h06m56s734.png", "id": "1015866550329656", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031656_1015866556996322_7240666593516287157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68zUHMsSXsgQ7kNvwFDgRLy&_nc_oc=Adq-TW1WNfrzPscL7Yu_6wgKvlvwqxZ_ZTJ4XyAK6_-seF4aDbU9ZydRGNF-tS0RDeM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wRTw063zUGYq--jiPps6WcYiLuo4QZEjmN-QBM2RBdg&oe=6A30001D"}, {"file_name": "vlcsnap-2025-12-18-14h52m05s723.png", "id": "4185474071770816", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819417_4185474075104149_4003894709593372408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vh6V8SASoQQ7kNvwFlLSvB&_nc_oc=Adp2f4gfI5BUY5rdJJLRrAk2DgoiITuzi3tj1M5ut7yx5WpfM5weGYGkE9QaEhE-BOc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G9thtFp124JGqDnHMVOUk4io1fEV8GAmbEAqE7T6Byg&oe=6A301F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master comp (cover_art_landscape_2560x1440)_BEHIND_vB-02 with logo.png", "id": "1320764112426735", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031450_1320764115760068_1122392115874745582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7AckZ6vuqwQ7kNvwHnrctQ&_nc_oc=AdoKmcv2MfDq_xB3bbDIOwFVNXh7hMJkjvLYfFLMwWWDNRGDKqZVTCfJmpMS7OXXHuI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dXo2htMY2EAAiRI0L0dkVcRNcicW6M95iTIQ8eQLQ1Q&oe=6A301A16"}, "display_name": "DodgeALL", "keywords": ["Action", "Dodge", "Physical", "Social", "Fitness"], "long_description": "**DodgeALL** is a high-intensity VR game that puts your agility and reflexes to the test. Engage in a world where the only rule is to dodge everything that comes your way! With immersive 3D environments and physics-based gameplay, each level presents a new challenge, offering endless replayability. Dodge, duck, dip, dive and crawl around in this adrenaline-fueled game, where your skill, speed and stamina determine your survival.\n\n# Are you ready to DodgeALL?\n\n# Features include:\n- Mixed Reality Mode: Now available via a new campaign or in Party Mode.\n- Party Mode: Play against friends & family using Android/iOS smartphones and tablets. Choose to be naughty or nice (or both). To join in, simply download the companion app \"DodgeALL Party\" for free from the app store.\n- Room-scale & 360 degrees: Where you can move in your room is where you can move in the game. No fake movement: **No VR nausea here!**\n- 3D Spatial Audio: Gives audible cues where obstacles are coming from.\n- Abilities: 5 unlockable abilities to help when things get hot.\n- Endless Mode: Play any unlocked level until you drop. Each iteration gets progressively faster.\n- Leaderboards: Compare your dodging skills to other players.\n- Twitch interactive mode: Let your viewers throw things at you!\n- Bonus levels: New crazy challenges released regularly.\n- Custom levels: Create your own levels (SideQuest required).\n\nJoin the Discord for questions, bugs, feedback or to give me ideas for new bonus levels: \nhttps://dodgeall.com/discord", "short_description": "DODGE ALL THE THINGS!!1 \n\nDodge, duck, dip, dive and crawl your way through a nonstop onslaught of obstacles coming at you everywhere you look.\n\nNow supports Mixed Reality!\n- New Mixed Reality SciFi Campaign\n- Party Mode in Mixed Reality\n\nNow supports Local Multiplayer!\n- Party Mode allows your friends with iOS/Android smartphones and tablets to interact with you using a free and easy to use app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dodgeall.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "GlennerooVR LLC", "support_website_url": "https://www.dodgeall.com/contact/", "website_url": "https://www.dodgeall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "24301520222856229"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974439_946695660655669_4162065645042705343_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWFr3IM0zTMQ7kNvwFMfeZ0&_nc_oc=AdrlX08L90MZnSuvfS1sY7zLGHswi5R_uqin6G0bssrOwVE1Gizfk6pRNwKcyNyYAB8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87GBR_aJScNp7IBZO8jIeR9WF2sU0aHGwClrgHaSv1HQ&oe=6A3007FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DodgeALL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Arcade", 
uscdn.com/v/t64.5771-25/43931328_826788746237659_6323518299540582494_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raCZeyXLMqIQ7kNvwHBo0d7&_nc_oc=Adq2mmj4Zb1IBrkQT2ed595kfcWWuQnTZ92FM1-cBVAz12R4F0m4McqN46Ya2bLMHhU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGFzlGvN3uLXteJyml1Q6BPExzq689GaZQOlmA9ICF6w&oe=6AE8BE82"}, {"file_name": "vlcsnap-2024-07-26-18h01m22s032.png", "id": "1256791399035235", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974562_1256791402368568_5082179921216078745_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gKMqz_UnkMQ7kNvwF5SEgX&_nc_oc=Adp8s-4elCqmdsnLqP75hWr8_DYyCpHrB6taXOWV62sODp0mzAPazLsIf-0yA2UBto8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCrl11136FITIWG2Qp2_avu9UMV4cZp1d-ob79D6uqLw&oe=6AE8C26B"}, {"file_name": "vlcsnap-2024-07-26-18h03m49s591.png", "id": "454320890749453", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974790_454320894082786_707571771440452654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbnQtXTtycIQ7kNvwG9NbJs&_nc_oc=AdqUTWRJekqlc8hef0RMfWsQmvRm7ksqL5NfMs1dph8TxLmD7IO28Zq_diSiY37NhQ4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA6Ph3k-RMUlsGaAm1obvgzq1tlihCYyIHGbFwwxmJug&oe=6AE89BB0"}, {"file_name": "vlcsnap-2024-07-26-18h06m56s734.png", "id": "1015866550329656", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031656_1015866556996322_7240666593516287157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhXQaiE41FgQ7kNvwHqmgbO&_nc_oc=AdqbTzdFTJG6WHQVUtuj9yKfzAK2Iq_kBqKrVsXxQmAbBD97UsYp_MbEXIu-8cFzXsw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjUUEO6Kd8Uuh4v1HaOweR8JwWV9c0qpsVN_m4Qm1AuQ&oe=6AE8921D"}, {"file_name": "vlcsnap-2025-12-18-14h52m05s723.png", "id": "4185474071770816", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819417_4185474075104149_4003894709593372408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHezIerdGC0Q7kNvwG0uky1&_nc_oc=Adq9fhKdPVpALvGvT2XSUJ0nr-nDQucnq6sMZE1WqZOS4Oaz9vQbuFIh2YHLsu1NNnA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdCmmX3CMfu2PFmo3YqyzFc16F3PE6NNs1c8mFojZkEA&oe=6AE8B190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master comp (cover_art_landscape_2560x1440)_BEHIND_vB-02 with logo.png", "id": "1320764112426735", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031450_1320764115760068_1122392115874745582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y-Ahr5ZJsgQ7kNvwFambZY&_nc_oc=Adrsc6AeX5eDEQMk97np7YAsDlGYQsrYSmbEM593h2tpQloVl4WXG0N4D80UDKdYXHo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtlnyV5flImOsHgHEYynf-mlPH2u9HK2I5MI-5YcaPIQ&oe=6AE8AC16"}, "display_name": "DodgeALL", "keywords": ["Action", "Dodge", "Physical", "Social", "Fitness"], "long_description": "**DodgeALL** is a high-intensity VR game that puts your agility and reflexes to the test. Engage in a world where the only rule is to dodge everything that comes your way! With immersive 3D environments and physics-based gameplay, each level presents a new challenge, offering endless replayability. Dodge, duck, dip, dive and crawl around in this adrenaline-fueled game, where your skill, speed and stamina determine your survival.\n\n# Are you ready to DodgeALL?\n\n# Features include:\n- Mixed Reality Mode: Now available via a new campaign or in Party Mode.\n- Party Mode: Play against friends & family using Android/iOS smartphones and tablets. Choose to be naughty or nice (or both). To join in, simply download the companion app \"DodgeALL Party\" for free from the app store.\n- Room-scale & 360 degrees: Where you can move in your room is where you can move in the game. No fake movement: **No VR nausea here!**\n- 3D Spatial Audio: Gives audible cues where obstacles are coming from.\n- Abilities: 5 unlockable abilities to help when things get hot.\n- Endless Mode: Play any unlocked level until you drop. Each iteration gets progressively faster.\n- Leaderboards: Compare your dodging skills to other players.\n- Twitch interactive mode: Let your viewers throw things at you!\n- Bonus levels: New crazy challenges released regularly.\n- Custom levels: Create your own levels (SideQuest required).\n\nJoin the Discord for questions, bugs, feedback or to give me ideas for new bonus levels: \nhttps://dodgeall.com/discord", "short_description": "DODGE ALL THE THINGS!!1 \n\nDodge, duck, dip, dive and crawl your way through a nonstop onslaught of obstacles coming at you everywhere you look.\n\nNow supports Mixed Reality!\n- New Mixed Reality SciFi Campaign\n- Party Mode in Mixed Reality\n\nNow supports Local Multiplayer!\n- Party Mode allows your friends with iOS/Android smartphones and tablets to interact with you using a free and easy to use app."}, {"images": {"nodes": []}, "id": "2253332868564303", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DodgeALL", "keywords": [], "long_description": "**DodgeALL** ist ein actiongeladenes VR-Spiel, das deine Beweglichkeit und Reflexe fordert. Eine Regel: Weich allem aus! Immersive 3D-Welten, physikbasiertes Gameplay und neue Herausforderungen in jedem Level sorgen f\u00fcr endlosen Spielspa\u00df. Ausweichen, ducken, abtauchen, hechten, kriechen: Geschick, Tempo und Ausdauer sichern dein \u00dcberleben.\n\n# Bist du bereit f\u00fcr DodgeALL?\n\n# Features:\n- Mixed Reality: In einer neuen Kampagne und im Party-Modus.\n- Party-Modus: Spiel gegen Freunde und Familie mit Android-/iOS-Smartphones und -Tablets. Sei fies, nett oder beides! Zum Mitspielen einfach \"DodgeALL Party\" kostenlos im jeweiligen App-Store herunterladen.\n- Roomscale & 360\u00b0: Dein Platz im Zimmer ist dein Bewegungsraum im Spiel. Keine k\u00fcnstliche Fortbewegung: **Keine VR-\u00dcbelkeit!**\n- 3D-Raumklang: H\u00f6r, woher Hindernisse kommen.\n- F\u00e4higkeiten: 5 freischaltbare F\u00e4higkeiten helfen, wenn es hei\u00df hergeht.\n- Endlos-Modus: Spiel jedes freigeschaltete Level bis zum Umfallen. Jede Runde wird schneller.\n- Bestenlisten: Vergleich dein Ausweichgeschick mit anderen.\n- Twitch-Interaktivmodus: Lass deine Zuschauer Dinge auf dich werfen!\n- Bonuslevel: Regelm\u00e4\u00dfig neue, verr\u00fcckte Herausforderungen.\n- Eigene Level: Erstelle deine eigenen Level (SideQuest erforderlich).\n\nKomm auf Discord f\u00fcr Fragen, Fehlermeldungen, Feedback oder Ideen f\u00fcr neue Bonuslevel:\nhttps://dodgeall.com/discord", "short_description": "WEICH ALLEM AUS!!1\n\nWeich aus, duck dich, geh in die Knie, wirf dich zur Seite und kriech durch einen endlosen Ansturm von Hindernissen aus allen Richtungen.\n\nJetzt mit Mixed Reality!\n- Neue Sci-Fi-Kampagne in Mixed Reality\n- Party-Modus in Mixed Reality\n\nJetzt mit lokalem Mehrspieler!\n- Im Party-Modus k\u00f6nnen deine Freunde \u00fcber iOS-/Android-Smartphones und -Tablets mit dir interagieren \u2013 mit einer kostenlosen, einfach zu bedienenden App."}, {"images": {"nodes": []}, "id": "1987924488553197", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DodgeALL", "keywords": [], "long_description": "**DodgeALL** \u662f\u4e00\u6b3e\u7d27\u5f20\u523a\u6fc0\u7684 VR \u6e38\u620f\uff0c\u8003\u9a8c\u4f60\u7684\u654f\u6377\u8eab\u624b\u548c\u53cd\u5e94\u901f\u5ea6\u3002\u8fd9\u91cc\u7684\u89c4\u5219\u53ea\u6709\u4e00\u6761\uff1a\u8eb2\u5f00\u6240\u6709\u8fce\u9762\u800c\u6765\u7684\u4e1c\u897f\uff01\u6c89\u6d78\u5f0f 3D \u573a\u666f\u4e0e\u57fa\u4e8e\u7269\u7406\u7684\u73a9\u6cd5\uff0c\u8ba9\u6bcf\u4e2a\u5173\u5361\u90fd\u5e26\u6765\u5168\u65b0\u6311\u6218\uff0c\u767e\u73a9\u4e0d\u538c\u3002\u95ea\u907f\u3001\u4f4e\u5934\u3001\u4e0b\u8e72\u3001\u4fa7\u8eab\u6251\u95ea\u3001\u530d\u5310\u722c\u884c\u2014\u2014\u5728\u8fd9\u573a\u80be\u4e0a\u817a\u7d20\u98d9\u5347\u7684\u6311\u6218\u4e2d\uff0c\u4f60\u7684\u6280\u5de7\u3001\u901f\u5ea6\u548c\u8010\u529b\u51b3\u5b9a\u4e86\u4f60\u80fd\u5426\u751f\u5b58\u3002\n\n# \u51c6\u5907\u597d\u6311\u6218 DodgeALL \u4e86\u5417\uff1f\n\n# \u6e38\u620f\u7279\u8272\uff1a\n- \u6df7\u5408\u73b0\u5b9e\u6a21\u5f0f\uff1a\u5728\u5168\u65b0\u6218\u5f79\u6216\u6d3e\u5bf9\u6a21\u5f0f\u4e2d\u4f53\u9a8c\u6df7\u5408\u73b0\u5b9e\u3002\n- \u6d3e\u5bf9\u6a21\u5f0f\uff1a\u4e0e\u4f7f\u7528 Android/iOS \u624b\u673a\u548c\u5e73\u677f\u7684\u4eb2\u53cb\u5bf9\u6218\u3002\u5e2e\u5fd9\u8fd8\u662f\u6363\u4e71\uff1f\u4e5f\u53ef\u4ee5\u4e24\u6837\u90fd\u6765\uff01\u53ea\u9700\u4ece\u5e94\u7528\u5546\u5e97\u514d\u8d39\u4e0b\u8f7d\u914d\u5957\u5e94\u7528 \"DodgeALL Party\"\uff0c\u5373\u53ef\u52a0\u5165\u3002\n- \u623f\u95f4\u89c4\u6a21\u4e0e 360\u00b0 \u5168\u65b9\u4f4d\u4f53\u9a8c\uff1a\u623f\u95f4\u91cc\u80fd\u8d70\u5230\u54ea\u91cc\uff0c\u6e38\u620f\u91cc\u5c31\u80fd\u8d70\u5230\u54ea\u91cc\u3002\u6ca1\u6709\u865a\u62df\u79fb\u52a8\uff1a**\u544a\u522b VR \u6655\u52a8\u75c7\uff01**\n- 3D \u7a7a\u95f4\u97f3\u6548\uff1a\u542c\u58f0\u8fa8\u4f4d\uff0c\u5224\u65ad\u969c\u788d\u7269\u4ece\u54ea\u91cc\u88ad\u6765\u3002\n- \u6280\u80fd\uff1a\u89e3\u9501 5 \u79cd\u6280\u80fd\uff0c\u5728\u5371\u6025\u65f6\u523b\u52a9\u4f60\u4e00\u81c2\u4e4b\u529b\u3002\n- \u65e0\u5c3d\u6a21\u5f0f\uff1a\u5728\u4efb\u610f\u5df2\u89e3\u9501\u5173\u5361\u4e2d\u73a9\u5230\u7b4b\u75b2\u529b\u5c3d\uff0c\u6bcf\u4e00\u8f6e\u90fd\u4f1a\u66f4\u5feb\u3002\n- \u6392\u884c\u699c\uff1a\u4e0e\u5176\u4ed6\u73a9\u5bb6\u6bd4\u6bd4\u8c01\u7684\u95ea\u907f\u529f\u592b\u66f4\u5f3a\u3002\n- Twitch \u4e92\u52a8\u6a21\u5f0f\uff1a\u8ba9\u89c2\u4f17\u5411\u4f60\u6254\u4e1c\u897f\uff01\n- \u989d\u5916\u5173\u5361\uff1a\u5b9a\u671f\u63a8\u51fa\u5168\u65b0\u75af\u72c2\u6311\u6218\u3002\n- \u81ea\u5b9a\u4e49\u5173\u5361\uff1a\u521b\u5efa\u4f60\u81ea\u5df1\u7684\u5173\u5361\uff08\u9700\u8981 SideQuest\uff09\u3002\n\n\u6709\u95ee\u9898\u3001\u53d1\u73b0\u4e86\u9519\u8bef\u3001\u60f3\u5206\u4eab\u53cd\u9988\uff0c\u6216\u6709\u65b0\u7684\u989d\u5916\u5173\u5361\u70b9\u5b50\uff1f\u6b22\u8fce\u52a0\u5165 Discord \u544a\u8bc9\u6211\uff1a\nhttps://dodgeall.com/discord", "short_description": "\u8eb2\u5f00\u6240\u6709\u4e1c\u897f\uff01\uff011\n\n\u95ea\u907f\u3001\u4f4e\u5934\u3001\u4e0b\u8e72\u3001\u4fa7\u8eab\u6251\u95ea\u3001\u530d\u5310\u722c\u884c\uff0c\u8eb2\u8fc7\u4ece\u56db\u9762\u516b\u65b9\u4e0d\u505c\u88ad\u6765\u7684\u969c\u788d\u7269\uff01\n\n\u73b0\u5df2\u652f\u6301\u6df7\u5408\u73b0\u5b9e\uff01\n- \u5168\u65b0\u6df7\u5408\u73b0\u5b9e\u79d1\u5e7b\u6218\u5f79\n- \u6df7\u5408\u73b0\u5b9e\u6d3e\u5bf9\u6a21\u5f0f\n\n\u73b0\u5df2\u652f\u6301\u672c\u5730\u591a\u4eba\u6e38\u620f\uff01\n- \u5728\u6d3e\u5bf9\u6a21\u5f0f\u4e2d\uff0c\u670b\u53cb\u4eec\u53ea\u9700\u5728 iOS/Android \u624b\u673a\u6216\u5e73\u677f\u4e0a\u4f7f\u7528\u514d\u8d39\u53c8\u7b80\u5355\u6613\u7528\u7684\u914d\u5957\u5e94\u7528\uff0c\u5c31\u80fd\u4e0e\u4f60\u4e92\u52a8\u3002"}, {"images": {"nodes": []}, "id": "1738604240568381", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DodgeALL", "keywords": [], "long_description": "**DodgeALL** \u2014 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u0430\u044f VR-\u0438\u0433\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0441\u043f\u044b\u0442\u0430\u0435\u0442 \u0442\u0432\u043e\u044e \u043b\u043e\u0432\u043a\u043e\u0441\u0442\u044c \u0438 \u0440\u0435\u0430\u043a\u0446\u0438\u044e. \u041f\u0440\u0430\u0432\u0438\u043b\u043e \u043e\u0434\u043d\u043e: \u0443\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044f \u043e\u0442 \u0432\u0441\u0435\u0433\u043e! \u0417\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0435 3D-\u043c\u0438\u0440\u044b, \u0444\u0438\u0437\u0438\u043a\u0430 \u0438 \u043d\u043e\u0432\u044b\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u0438\u0433\u0440\u0430\u0442\u044c \u0441\u043d\u043e\u0432\u0430 \u0438 \u0441\u043d\u043e\u0432\u0430. \u0423\u043a\u043b\u043e\u043d\u044f\u0439\u0441\u044f, \u043f\u0440\u0438\u0433\u0438\u0431\u0430\u0439\u0441\u044f, \u043d\u044b\u0440\u044f\u0439 \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0438 \u043f\u043e\u043b\u0437\u0438: \u0442\u0432\u043e\u0438 \u043d\u0430\u0432\u044b\u043a\u0438, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0440\u0435\u0448\u0430\u044e\u0442, \u0432\u044b\u0436\u0438\u0432\u0435\u0448\u044c \u043b\u0438 \u0442\u044b.\n\n# \u0413\u043e\u0442\u043e\u0432 \u043a DodgeALL?\n\n# \u0427\u0442\u043e \u0442\u0435\u0431\u044f \u0436\u0434\u0451\u0442:\n- \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c: \u0412 \u043d\u043e\u0432\u043e\u0439 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u0438 \u0440\u0435\u0436\u0438\u043c\u0435 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438.\n- \u0420\u0435\u0436\u0438\u043c \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438: \u0418\u0433\u0440\u0430\u0439 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u0441\u0435\u043c\u044c\u0438 \u0441\u043e \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u0430\u043c\u0438 \u0438 \u043f\u043b\u0430\u043d\u0448\u0435\u0442\u0430\u043c\u0438 Android/iOS. \u041f\u043e\u043c\u043e\u0433\u0430\u0439, \u0432\u0440\u0435\u0434\u043d\u0438\u0447\u0430\u0439 \u0438\u043b\u0438 \u0434\u0435\u043b\u0430\u0439 \u0438 \u0442\u043e \u0438 \u0434\u0440\u0443\u0433\u043e\u0435! \u0414\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0441\u043a\u0430\u0447\u0430\u0439 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \"DodgeALL Party\" \u0438\u0437 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439.\n- Roomscale \u0438 360\u00b0: \u0414\u0432\u0438\u0433\u0430\u0439\u0441\u044f \u0432 \u0438\u0433\u0440\u0435 \u0442\u0430\u043c, \u0433\u0434\u0435 \u043c\u043e\u0436\u0435\u0448\u044c \u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0435. \u0411\u0435\u0437 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u044f: **\u041d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0443\u043a\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u044f \u0432 VR!**\n- \u041f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 3D-\u0437\u0432\u0443\u043a: \u0423\u0441\u043b\u044b\u0448\u044c, \u043e\u0442\u043a\u0443\u0434\u0430 \u043b\u0435\u0442\u044f\u0442 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f.\n- \u0421\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438: \u041e\u0442\u043a\u0440\u043e\u0439 5 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0432 \u0442\u0440\u0443\u0434\u043d\u0443\u044e \u043c\u0438\u043d\u0443\u0442\u0443.\n- \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c: \u0418\u0433\u0440\u0430\u0439 \u043d\u0430 \u043b\u044e\u0431\u043e\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0434\u043e \u0443\u043f\u0430\u0434\u0443. \u041a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0443\u043d\u0434 \u0432\u0441\u0451 \u0431\u044b\u0441\u0442\u0440\u0435\u0435.\n- \u0422\u0430\u0431\u043b\u0438\u0446\u044b \u043b\u0438\u0434\u0435\u0440\u043e\u0432: \u0421\u0440\u0430\u0432\u043d\u0438 \u0441\u0432\u043e\u0451 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438.\n- \u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c Twitch: \u041f\u0443\u0441\u0442\u044c \u0437\u0440\u0438\u0442\u0435\u043b\u0438 \u0448\u0432\u044b\u0440\u044f\u044e\u0442 \u0432 \u0442\u0435\u0431\u044f \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b!\n- \u0411\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438: \u041d\u043e\u0432\u044b\u0435 \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u0432\u044b\u0445\u043e\u0434\u044f\u0442 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e.\n- \u0421\u0432\u043e\u0438 \u0443\u0440\u043e\u0432\u043d\u0438: \u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 (\u043d\u0443\u0436\u0435\u043d SideQuest).\n\n\u0417\u0430\u0445\u043e\u0434\u0438 \u0432 Discord \u0441 \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c\u0438, \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c\u0438 \u043e\u0431 \u043e\u0448\u0438\u0431\u043a\u0430\u0445, \u043e\u0442\u0437\u044b\u0432\u0430\u043c\u0438 \u0438\u043b\u0438 \u0438\u0434\u0435\u044f\u043c\u0438 \u043d\u043e\u0432\u044b\u0445 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0445 \u0443\u0440\u043e\u0432\u043d\u0435\u0439:\nhttps://dodgeall.com/discord", "short_description": "\u0423\u0412\u041e\u0420\u0410\u0427\u0418\u0412\u0410\u0419\u0421\u042f \u041e\u0422 \u0412\u0421\u0415\u0413\u041e!!1\n\n\u0423\u043a\u043b\u043e\u043d\u044f\u0439\u0441\u044f, \u043f\u0440\u0438\u0433\u0438\u0431\u0430\u0439\u0441\u044f, \u043f\u0440\u0438\u0441\u0435\u0434\u0430\u0439, \u043d\u044b\u0440\u044f\u0439 \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0438 \u043f\u043e\u043b\u0437\u0438 \u0441\u043a\u0432\u043e\u0437\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0439 \u0441\u043e \u0432\u0441\u0435\u0445 \u0441\u0442\u043e\u0440\u043e\u043d.\n\n\u0422\u0435\u043f\u0435\u0440\u044c \u0441\u043e \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e!\n- \u041d\u043e\u0432\u0430\u044f \u043d\u0430\u0443\u0447\u043d\u043e-\u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u044f \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n- \u0420\u0435\u0436\u0438\u043c \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438 \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\n\u0422\u0435\u043f\u0435\u0440\u044c \u0441 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u043c \u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0435\u0440\u043e\u043c!\n- \u0412 \u0440\u0435\u0436\u0438\u043c\u0435 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438 \u0434\u0440\u0443\u0437\u044c\u044f \u043c\u043e\u0433\u0443\u0442 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441 \u0442\u043e\u0431\u043e\u0439 \u0441\u043e \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u043e\u0432 \u0438 \u043f\u043b\u0430\u043d\u0448\u0435\u0442\u043e\u0432 iOS/Android \u0447\u0435\u0440\u0435\u0437 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0435 \u0438 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dodgeall.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "GlennerooVR LLC", "support_website_url": "https://www.dodgeall.com/contact/", "website_url": "https://www.dodgeall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FE
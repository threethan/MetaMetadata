NPGw9ALFbQ&oe=6999AD2B"}, {"file_name": "vlcsnap-2024-07-26-18h03m49s591.png", "id": "454320890749453", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974790_454320894082786_707571771440452654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Blne9J1GL1UQ7kNvwHFIR9u&_nc_oc=AdlYpibZwjKtESNImPFgwl38gQrda6oWx5C5uByF89zQzcoxYol1Lz0zJCDTaR_fKvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCxz1mz48Ag90D4NQGSy2SDdX0kSKQ0cB352NrhnSt-w&oe=6999BEB0"}, {"file_name": "vlcsnap-2024-07-26-18h06m56s734.png", "id": "1015866550329656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031656_1015866556996322_7240666593516287157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdmKZQDetXkQ7kNvwEJuBfe&_nc_oc=AdnnzJ1Ql-jUOfDJ1oniUIxVGylRXG80HQfWBFdXryNTUAPcCVpW13c6DIe1oe04nJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzSVSJ9lHjWmXODo6zcRMGEc3l__7Fi579b21mdsFc1A&oe=6999B51D"}, {"file_name": "vlcsnap-2025-12-18-14h52m05s723.png", "id": "4185474071770816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819417_4185474075104149_4003894709593372408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh_-4UfEgH4Q7kNvwELVSqT&_nc_oc=AdltIWRvr8DOOkFdozkfVSiVNhjToq9kZOzBdKT0k3h3KJSoqBmWdY53siyoyx-5ndE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucY3ovqeuxcdCN4NpJAqtOgOY_evkIRmTYYlZQ_smGMg&oe=69999C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master comp (cover_art_landscape_2560x1440)_BEHIND_vB-02 with logo.png", "id": "1320764112426735", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_1320764115760068_1122392115874745582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJG4xHCZjSUQ7kNvwGCjufh&_nc_oc=Admw4QuYahbRLo3ZvAuTzAevZ-QYmFqIJDnMTHAbmeDIAOBGDZSSkRNeaL69wqOBYLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsnWFjsQ8oEAnvMdHB0WSDYK3R8zC0dm8SlLWr-lW8MgA&oe=699996D6"}, "display_name": "DodgeALL", "keywords": ["Action", "Dodge", "Physical", "Social", "Fitness"], "long_description": "**DodgeALL** is a high-intensity VR game that puts your agility and reflexes to the test. Engage in a world where the only rule is to dodge everything that comes your way! With immersive 3D environments and physics-based gameplay, each level presents a new challenge, offering endless replayability. Dodge, duck, dip, dive and crawl around in this adrenaline-fueled game, where your skill, speed and stamina determine your survival.\n\n# Are you ready to DodgeALL?\n\n# Features include:\n- Mixed Reality Mode: Now available via a new campaign or in Party Mode.\n- Party Mode: Play against friends & family using Android/iOS smartphones and tablets. Choose to be naughty or nice (or both). To join in, simply download the companion app \"DodgeALL Party\" for free from the app store.\n- Room-scale & 360 degrees: Where you can move in your room is where you can move in the game. No fake movement: **No VR nausea here!**\n- 3D Spatial Audio: Gives audible cues where obstacles are coming from.\n- Abilities: 5 unlockable abilities to help when things get hot.\n- Endless Mode: Play any unlocked level until you drop. Each iteration gets progressively faster.\n- Leaderboards: Compare your dodging skills to other players.\n- Twitch interactive mode: Let your viewers throw things at you!\n- Bonus levels: New crazy challenges released regularly.\n- Custom levels: Create your own levels (SideQuest required).\n\nJoin the Discord for questions, bugs, feedback or to give me ideas for new bonus levels: \nhttps://dodgeall.com/discord", "short_description": "DODGE ALL THE THINGS!!1 \n\nDodge, duck, dip, dive and crawl your way through a nonstop onslaught of obstacles coming at you everywhere you look.\n\nNow supports Mixed Reality!\n- New Mixed Reality SciFi Campaign\n- Party Mode in Mixed Reality\n\nNow supports Local Multiplayer!\n- Party Mode allows your friends with iOS/Android smartphones and tablets to interact with you using a free and easy to use app."}]}, "developer_name":
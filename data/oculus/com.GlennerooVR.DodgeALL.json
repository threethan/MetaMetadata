NJUAO2tWvRuc_Aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGRwlLZu1qXxhfUe3YTBQxIK7x1SDVxZIsQjLF0Nsp7w&oe=6A67572B"}, {"file_name": "vlcsnap-2024-07-26-18h03m49s591.png", "id": "454320890749453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974790_454320894082786_707571771440452654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkMlp_vhwL4Q7kNvwEBOFaW&_nc_oc=Adrq5qOuXf91HSN14uMt39K-byIzD00__ticx7mF3AwZlFnQRV5cShOCXNeZfW5avfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1FTLaWYVBoKuAZ9JuYjspRENUHPD-2SeEj0I6WxEy1Q&oe=6A6768B0"}, {"file_name": "vlcsnap-2024-07-26-18h06m56s734.png", "id": "1015866550329656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031656_1015866556996322_7240666593516287157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRBpJPBF9wUQ7kNvwGzcpKW&_nc_oc=AdqTxy9P5tXopgqYwtqWDRMXjlbj23mGxAwRLcni0VZSs69rLt9-xf6WYZZX8eJuZ38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7Mjs--Wp5_zA6em9Aq7AMnjWnc7Lyf81L-54iuJQ_Yw&oe=6A675F1D"}, {"file_name": "vlcsnap-2025-12-18-14h52m05s723.png", "id": "4185474071770816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819417_4185474075104149_4003894709593372408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQWVWw1g0hgQ7kNvwGX3GU3&_nc_oc=AdpEZostb7M1cmLok2ucmmZP47ff9dlvqQKJjvUbDGJvqqz5cj3GiyeSE5taGcs5vO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEscTFafWc6OwpOFACD4_wSKg9ImJj6byb0-66xza1Vw&oe=6A674650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master comp (cover_art_landscape_2560x1440)_BEHIND_vB-02 with logo.png", "id": "1320764112426735", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_1320764115760068_1122392115874745582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCukB7LWKe8Q7kNvwEgDoiK&_nc_oc=AdpyOlVbrt1pM8QPB70Tc6UrtWupMhaZyssuumAXVjTVf4E9qWBlRiQSTYa2JbetRlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo4_YxwG7bSXMcJ8dFOTYPXeLVJMP-6uTjE6mDrfPL0g&oe=6A677916"}, "display_name": "DodgeALL", "keywords": ["Action", "Dodge", "Physical", "Social", "Fitness"], "long_description": "**DodgeALL** is a high-intensity VR game that puts your agility and reflexes to the test. Engage in a world where the only rule is to dodge everything that comes your way! With immersive 3D environments and physics-based gameplay, each level presents a new challenge, offering endless replayability. Dodge, duck, dip, dive and crawl around in this adrenaline-fueled game, where your skill, speed and stamina determine your survival.\n\n# Are you ready to DodgeALL?\n\n# Features include:\n- Mixed Reality Mode: Now available via a new campaign or in Party Mode.\n- Party Mode: Play against friends & family using Android/iOS smartphones and tablets. Choose to be naughty or nice (or both). To join in, simply download the companion app \"DodgeALL Party\" for free from the app store.\n- Room-scale & 360 degrees: Where you can move in your room is where you can move in the game. No fake movement: **No VR nausea here!**\n- 3D Spatial Audio: Gives audible cues where obstacles are coming from.\n- Abilities: 5 unlockable abilities to help when things get hot.\n- Endless Mode: Play any unlocked level until you drop. Each iteration gets progressively faster.\n- Leaderboards: Compare your dodging skills to other players.\n- Twitch interactive mode: Let your viewers throw things at you!\n- Bonus levels: New crazy challenges released regularly.\n- Custom levels: Create your own levels (SideQuest required).\n\nJoin the Discord for questions, bugs, feedback or to give me ideas for new bonus levels: \nhttps://dodgeall.com/discord", "short_description": "DODGE ALL THE THINGS!!1 \n\nDodge, duck, dip, dive and crawl your way through a nonstop onslaught of obstacles coming at you everywhere you look.\n\nNow supports Mixed Reality!\n- New Mixed Reality SciFi Campaign\n- Party Mode in Mixed Reality\n\nNow supports Local Multiplayer!\n- Party Mode allows your friends with iOS/Android smartphones and tablets to interact with you using a free and easy to use app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dodgeall.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "GlennerooVR LLC", "support_website_url": "https://www.dodgeall.com/contact/", "website_url": "https://www.dodgeall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "24301520222856229"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974439_946695660655669_4162065645042705343_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9id_nH_Tc0Q7kNvwHwTiY6&_nc_oc=Adqm_Nl3vui2M4anWZBhJqol3yWVOrgG_8CCwpc7sCitAEaSvUwTSYURNzP5AHMnXDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYEhf39mMAUss2wWsz_YVut29KhbAIsNnZVtDsGKOivg&oe=6A6766FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DodgeALL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Arcade", 
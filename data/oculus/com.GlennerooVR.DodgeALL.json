RYDYy4R5zfdXkJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzLCCvrJ7_C-zLFGazGkQH0PTsUS2j9UWI3jurEZGyOA&oe=6A9035AB"}, {"file_name": "vlcsnap-2024-07-26-18h03m49s591.png", "id": "454320890749453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974790_454320894082786_707571771440452654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUh7QX-eTSwQ7kNvwFyO7Rc&_nc_oc=Adq9k5NibrStjRQEwi0QmaX2ffamQcUOnOpdm3VBXBBcBKVQtdR8nDGpeOvZhnq0CNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESno4TcGNjAKqmfhnN1G9vJSfUWDJT-gH9UvETANO7TQ&oe=6A900EF0"}, {"file_name": "vlcsnap-2024-07-26-18h06m56s734.png", "id": "1015866550329656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031656_1015866556996322_7240666593516287157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OC2lS4mpHEQ7kNvwEv8s2S&_nc_oc=AdqTWFtdk_jgKgg1Kx6eByOZHhpuqsgWt_eFMRkBWhTj-_3DXvTn9q61qLhWhxx4bGo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQOSPSUvu2Z2z8cvV3dKcDd25-EMMIspct05Ut_DSuhw&oe=6A903D9D"}, {"file_name": "vlcsnap-2025-12-18-14h52m05s723.png", "id": "4185474071770816", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_4185474075104149_4003894709593372408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp-55RSahGUQ7kNvwH4wL4Y&_nc_oc=Ado3hR28wEWOuFupZy_NpG5Sncux3zeqLmA8O4J3Q7miWwuYizZOch3Ktn6X959Q-qI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJgqkHXTEknLqacVaW--xRJf3Y3O1akN6V0xlIgD90Zw&oe=6A9024D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master comp (cover_art_landscape_2560x1440)_BEHIND_vB-02 with logo.png", "id": "1320764112426735", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031450_1320764115760068_1122392115874745582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGKsLJSQ5n0Q7kNvwEJpFQK&_nc_oc=Adr6l1IF-byontIXXBXrzxsoxNhVEz8CacM-0iqJ_e7l_krzPhAqdKZFTCiGH7rZfhM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEndHw3xSrzee-91l2ggj9zGc1yuGL5QDCgBS8NHMuHSQ&oe=6A901F56"}, "display_name": "DodgeALL", "keywords": ["Action", "Dodge", "Physical", "Social", "Fitness"], "long_description": "**DodgeALL** is a high-intensity VR game that puts your agility and reflexes to the test. Engage in a world where the only rule is to dodge everything that comes your way! With immersive 3D environments and physics-based gameplay, each level presents a new challenge, offering endless replayability. Dodge, duck, dip, dive and crawl around in this adrenaline-fueled game, where your skill, speed and stamina determine your survival.\n\n# Are you ready to DodgeALL?\n\n# Features include:\n- Mixed Reality Mode: Now available via a new campaign or in Party Mode.\n- Party Mode: Play against friends & family using Android/iOS smartphones and tablets. Choose to be naughty or nice (or both). To join in, simply download the companion app \"DodgeALL Party\" for free from the app store.\n- Room-scale & 360 degrees: Where you can move in your room is where you can move in the game. No fake movement: **No VR nausea here!**\n- 3D Spatial Audio: Gives audible cues where obstacles are coming from.\n- Abilities: 5 unlockable abilities to help when things get hot.\n- Endless Mode: Play any unlocked level until you drop. Each iteration gets progressively faster.\n- Leaderboards: Compare your dodging skills to other players.\n- Twitch interactive mode: Let your viewers throw things at you!\n- Bonus levels: New crazy challenges released regularly.\n- Custom levels: Create your own levels (SideQuest required).\n\nJoin the Discord for questions, bugs, feedback or to give me ideas for new bonus levels: \nhttps://dodgeall.com/discord", "short_description": "DODGE ALL THE THINGS!!1 \n\nDodge, duck, dip, dive and crawl your way through a nonstop onslaught of obstacles coming at you everywhere you look.\n\nNow supports Mixed Reality!\n- New Mixed Reality SciFi Campaign\n- Party Mode in Mixed Reality\n\nNow supports Local Multiplayer!\n- Party Mode allows your friends with iOS/Android smartphones and tablets to interact with you using a free and easy to use app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dodgeall.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "GlennerooVR LLC", "support_website_url": "https://www.dodgeall.com/contact/", "website_url": "https://www.dodgeall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "24301520222856229"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974439_946695660655669_4162065645042705343_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=699nQPKeaIAQ7kNvwFUYCzH&_nc_oc=AdotPs1LP5k023COX7gmPZqBDTl0Sp2GC-ZcLIHVhcu86p7n9a_CsHL3Cy8Mfyr4sRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnTRTQH59DQSCcJzX5FvXkRXetlQ0bPJrkdthKU7hnQA&oe=6A900D3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DodgeALL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Arcade", 
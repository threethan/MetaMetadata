eAnomalyMonster.png", "id": "530392576457481", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393469_530392583124147_2423048576521156698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WsdG64W184Q7kNvwHTwwW1&_nc_oc=AdqO4ngpeAlxkwJikVIutjLE1RMQPX-GzVT3s61S8t2N25tKDF2YobuzoK7SNaIfTeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfmQdGIK5PxH25E_HUynRKxzQY2tfPbwaSLgmvGdRk-g&oe=6B033541"}]}, "id": "1177552676744984", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot.png", "id": "1328946598341996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391955_1328946601675329_2159119267985039015_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAl_EiZz60EQ7kNvwEMBF61&_nc_oc=AdpQDDUKVh-pXfRhTUnE9HPOSxL41Y_tMBuNPw6Awiqd9LtdEO2djEQPl2NfR1OpPT0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4XtM0ppb5nk5pD31gH5Edbe2iIEEIKxHUphYoA-jfqQ&oe=6B0331F2"}, {"file_name": "ScreenShot.png", "id": "648261064514061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391852_648261067847394_7698794737004577716_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmD-caPzge8Q7kNvwGTRXVi&_nc_oc=AdruAI_rolsBuMaJzDGCjpfbDYPjj6fkoj2u6810i_58hU21In0MUzbFVrcRZGz0iBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4grz9L0uL_-agM-F2VtUqo_7GZ3HItfECdB2JVbYBHQ&oe=6B032959"}, {"file_name": "ScreenShot.png", "id": "9368108643270106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392185_9368108653270105_5903522276814069457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nHKCjBczpAQ7kNvwFQkKXx&_nc_oc=AdqxAA5bWmuLVC_Y0zHag8O8KeK5wbAucynNDaIROXmSjXya3HGUaYM4DYjXITH0B3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSywXfwZ2ia7XSjaTB0-DOIXBZAB_yXJhtEssdpSdkkGQ&oe=6B033757"}, {"file_name": "ScreenShot.png", "id": "1007767241360696", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391885_1007767244694029_4884811497528496583_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVk80dPXzegQ7kNvwGGDzsd&_nc_oc=AdojYXCIs-jHgozCNyA9mbGorDQ0Kue3VuV07WYmCYKY7LglufVCbHyPpgdHszStVN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvksY7AP5aWMoPs1JwSTF2giwxuS0d-1oXx6kDad1-jA&oe=6B0317F6"}, {"file_name": "ScreenShot.png", "id": "1233142171562884", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_1233142181562883_7329468837487136315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIbcDH0tOPcQ7kNvwGWjElj&_nc_oc=AdoyvaQ-U1ElAH-tbUhNsAC2hZ7pBlBPNxgT9DbYjHznpDtWIKjLB2NWXzXyYGp9xlk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRRb3kVyCaGnYv7kMCp3_ChfbcrtB4o3NKTggPca4yOw&oe=6B032316"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Anomaly", "keywords": [], "long_description": "Ape Anomaly is a terrifying horror VR game, designed to test both your nerves and your survival instincts. Set in a mysterious, distorted world, players must evade monstrous creatures and navigate dark, eerie environments filled with strange anomalies. In Ape Anomaly, you\u2019re not just playing to hangout\u2014you\u2019re playing to survive.\n\nThe game retains the fast-paced, horror-based gameplay you love. As you explore twisted maps, abandoned structures, and haunted zones, you'll face unexpected threats at every turn. The anomalies in the environment don\u2019t just pose physical danger\u2014they distort reality, making each corner you turn more unpredictable than the last. The world around you shifts, and the creatures that lurk in the shadows grow more terrifying with every passing moment.\n\nWhether you're playing solo or with friends, Ape Anomaly challenges you to think on your feet, outsmart your enemies, and work together to survive. Uncover hidden secrets, avoid deadly traps, and try to escape the horrors that have overtaken the world. Will you make it out alive, or will you become another part of the anomaly?\n\nStep into the nightmare. Ape Anomaly is now available on AppLab. Are you brave enough to face it?", "short_description": "Ape Anomaly is a spine-chilling horror VR game, where survival becomes a game of wits. In this horror VR game, players must outsmart eerie anomalies while evading dangerous creatures in a dark and mysterious environment. Every corner hides a new threat, and only the bravest will make it through unscathed. Are you ready to survive the Ape Anomaly? Available now on AppLab."}]}, "developer_name": "SwicchStudios", "developer_privacy_policy_url": "https://sites.google.com/view/ape-anomaly/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swicch", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-anomaly/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9498140116920385"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9521665187901211", "version": "SwicchStudios"}, "id": "597544753303878", "channel_name": "LIVE"}]}
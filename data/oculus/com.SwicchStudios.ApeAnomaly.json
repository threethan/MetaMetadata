eAnomalyMonster.png", "id": "530392576457481", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393469_530392583124147_2423048576521156698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8JuNNHAWDwQ7kNvwF9edKO&_nc_oc=AdqBCahDhSOXp9tMsD9_5xPyfEOwhuA_DV1FrpsmxxEdsPUsAiUYTUc81WkpOotkchQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdg5jSM3cNleO96Drja48jsPL_TXYX9Yblx6_k_u6qDg&oe=6B09CCC1"}]}, "id": "1177552676744984", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot.png", "id": "1328946598341996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391955_1328946601675329_2159119267985039015_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8tfIVw51XYQ7kNvwGiEztX&_nc_oc=AdpSzKEHJ0E1RPjBrlRirgGco9484LB9ot7x8Bb54bTT6prb8ALU2wUpegjT-7ggOFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVTSu1LAUOv9SWRjRWa7hZKcq9n-p56vuXeGyfj4Ce1Q&oe=6B09C972"}, {"file_name": "ScreenShot.png", "id": "648261064514061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_648261067847394_7698794737004577716_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMDzOEkLcJ4Q7kNvwH7hXJV&_nc_oc=AdqM1-KdLqzhbMTsKapyjOWFmkOMmJcA8tvQBx8J2BCirLGp2t6UqG3WRgEUkm_TTHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQowk4CaxtFgx8eRVfgBB2Q3y0-R5j2qzb7exCGIMvIYA&oe=6B09C0D9"}, {"file_name": "ScreenShot.png", "id": "9368108643270106", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392185_9368108653270105_5903522276814069457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUm07LJ5TVEQ7kNvwFOkKie&_nc_oc=AdqpnnMBwnHxhyCUGV6clq7K6bra4-qNlq9zaSpRael8FwELz3TKDDwLEfHDoksmXso&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0xEMSKbk72_IuVQFJaqjR6pW3apiKi5RY4Trql06dSQ&oe=6B09CED7"}, {"file_name": "ScreenShot.png", "id": "1007767241360696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391885_1007767244694029_4884811497528496583_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNSY2KMGkMMQ7kNvwFTqK_n&_nc_oc=Adp68etK1XYjE4NomO-oJbiGpZXyvsoKbNT5qIYt_NGCAdpXf3im8T7lV_hwrQHrmSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUerzUeFblUIQfqAH9v0omtdn7kEBDU5aT9J4Yb3onAA&oe=6B09AF76"}, {"file_name": "ScreenShot.png", "id": "1233142171562884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392057_1233142181562883_7329468837487136315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y8pzEU--b0Q7kNvwGExCII&_nc_oc=AdqzxNRKRjUDr7pwJHIvzOrDggKWtB0FSvCVukLW1U5bcCEBsUH1GTZ6SK27YEjgpiU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT42upqp2Ac6rMLrlkNMJ8bokqvXAFK84PiPFUUn-VKOg&oe=6B09BA96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Anomaly", "keywords": [], "long_description": "Ape Anomaly is a terrifying horror VR game, designed to test both your nerves and your survival instincts. Set in a mysterious, distorted world, players must evade monstrous creatures and navigate dark, eerie environments filled with strange anomalies. In Ape Anomaly, you\u2019re not just playing to hangout\u2014you\u2019re playing to survive.\n\nThe game retains the fast-paced, horror-based gameplay you love. As you explore twisted maps, abandoned structures, and haunted zones, you'll face unexpected threats at every turn. The anomalies in the environment don\u2019t just pose physical danger\u2014they distort reality, making each corner you turn more unpredictable than the last. The world around you shifts, and the creatures that lurk in the shadows grow more terrifying with every passing moment.\n\nWhether you're playing solo or with friends, Ape Anomaly challenges you to think on your feet, outsmart your enemies, and work together to survive. Uncover hidden secrets, avoid deadly traps, and try to escape the horrors that have overtaken the world. Will you make it out alive, or will you become another part of the anomaly?\n\nStep into the nightmare. Ape Anomaly is now available on AppLab. Are you brave enough to face it?", "short_description": "Ape Anomaly is a spine-chilling horror VR game, where survival becomes a game of wits. In this horror VR game, players must outsmart eerie anomalies while evading dangerous creatures in a dark and mysterious environment. Every corner hides a new threat, and only the bravest will make it through unscathed. Are you ready to survive the Ape Anomaly? Available now on AppLab."}]}, "developer_name": "SwicchStudios", "developer_privacy_policy_url": "https://sites.google.com/view/ape-anomaly/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swicch", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-anomaly/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9498140116920385"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9521665187901211", "version": "SwicchStudios"}, "id": "597544753303878", "channel_name": "LIVE"}]}
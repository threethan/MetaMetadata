eAnomalyMonster.png", "id": "530392576457481", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393469_530392583124147_2423048576521156698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG7MekccObwQ7kNvwGzJyaG&_nc_oc=AdoyFqCy_IKiNOTVVlsxnJxU1oO2agL1GNY7iujbE-o_QChG_f6p1qKkGRRUn_U_JDE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPEbLJ7zlsTz38ZPJUS8eFmvGs4ejiq8n3grlp9F6u-w&oe=6AFC6581"}]}, "id": "1177552676744984", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot.png", "id": "1328946598341996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391955_1328946601675329_2159119267985039015_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnsLLJ5j-QcQ7kNvwHWqf_C&_nc_oc=AdrU6rrlB20FWPL3cJ9FN4BBcaSohKBJ_C9_m5WVPrXgrNsvvNK2_hHDSKfM6_HqzPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI0TuGmKrxP5ibYcdaTpw2SK9gXjkDfTH2w3drqaiRlg&oe=6AFC6232"}, {"file_name": "ScreenShot.png", "id": "648261064514061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_648261067847394_7698794737004577716_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y94aa5FrLUYQ7kNvwEC1Wk6&_nc_oc=Adpqgy3qWvuj2FTWtCJGIMYe_1X_LkdfMkm0wvV_YM1nyOlov3JKE5ho_KhifRKSjDE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzAkGYmhAf7rBt-cP-f0diCvhQg-yUJhosgzRc2RNkgw&oe=6AFC91D9"}, {"file_name": "ScreenShot.png", "id": "9368108643270106", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392185_9368108653270105_5903522276814069457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlkvmocqBh0Q7kNvwF8D4cI&_nc_oc=AdpmKUJapVnRCLxKwZa8e7vCPWKturCop3P_2fLgar57w7qSpYBb2axM6kdr0Fw5poI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG6ZzxEnNYEM80uXpw11mcCwQQRBzVcC2Btjs9ubLHcA&oe=6AFC6797"}, {"file_name": "ScreenShot.png", "id": "1007767241360696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391885_1007767244694029_4884811497528496583_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoHPxXBRozwQ7kNvwEDsabN&_nc_oc=Adp8yLj9CmvvrjGAaOUbzG7uk9FB1LPbnqEyZgjw_zsJuU5VKp5POG3Qjeyt_9OyUL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz6BP6Fv6EcPcg3OPhN14SDViRzRPG-5tnzxV9kHLDEg&oe=6AFC8076"}, {"file_name": "ScreenShot.png", "id": "1233142171562884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392057_1233142181562883_7329468837487136315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICha04dh240Q7kNvwE_M6AU&_nc_oc=Adpz_9FBHKPCZgFVnkUl8aCmlcDI-bLHRLq13kimoKvc-O-NNc1PMpZRgEzz4EhQYk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5tvsBycZfDOBgCuEktztsM7dHrzxygcF6N-kdE43Zow&oe=6AFC8B96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Anomaly", "keywords": [], "long_description": "Ape Anomaly is a terrifying horror VR game, designed to test both your nerves and your survival instincts. Set in a mysterious, distorted world, players must evade monstrous creatures and navigate dark, eerie environments filled with strange anomalies. In Ape Anomaly, you\u2019re not just playing to hangout\u2014you\u2019re playing to survive.\n\nThe game retains the fast-paced, horror-based gameplay you love. As you explore twisted maps, abandoned structures, and haunted zones, you'll face unexpected threats at every turn. The anomalies in the environment don\u2019t just pose physical danger\u2014they distort reality, making each corner you turn more unpredictable than the last. The world around you shifts, and the creatures that lurk in the shadows grow more terrifying with every passing moment.\n\nWhether you're playing solo or with friends, Ape Anomaly challenges you to think on your feet, outsmart your enemies, and work together to survive. Uncover hidden secrets, avoid deadly traps, and try to escape the horrors that have overtaken the world. Will you make it out alive, or will you become another part of the anomaly?\n\nStep into the nightmare. Ape Anomaly is now available on AppLab. Are you brave enough to face it?", "short_description": "Ape Anomaly is a spine-chilling horror VR game, where survival becomes a game of wits. In this horror VR game, players must outsmart eerie anomalies while evading dangerous creatures in a dark and mysterious environment. Every corner hides a new threat, and only the bravest will make it through unscathed. Are you ready to survive the Ape Anomaly? Available now on AppLab."}]}, "developer_name": "SwicchStudios", "developer_privacy_policy_url": "https://sites.google.com/view/ape-anomaly/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swicch", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-anomaly/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9498140116920385"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9521665187901211", "version": "SwicchStudios"}, "id": "597544753303878", "channel_name": "LIVE"}]}
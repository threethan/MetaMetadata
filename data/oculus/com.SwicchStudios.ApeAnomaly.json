eAnomalyMonster.png", "id": "530392576457481", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393469_530392583124147_2423048576521156698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG82zDjbN8MQ7kNvwGXXx5d&_nc_oc=AdqVPfAvZo6EwffmXbnctF6VcaCGrQKe4Rr69U9eyLRl-ltjJ4gkF-bF09ksbbandQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_EWXHse-VKG-W2W-FGcpkulnFU12-7_VVJdMmI0hsUg&oe=6AFF0881"}]}, "id": "1177552676744984", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot.png", "id": "1328946598341996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391955_1328946601675329_2159119267985039015_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC2v8VsRaJsQ7kNvwGQFN9u&_nc_oc=AdqYFCTJ-s8thjGYqcOd1Z-lQTScIB6NzTJX_kRphUfBrAl0HN2Jp3ortKQ-vK3Y3Cg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44cpC-Sa-xQQ5m9OzF_C1H4J07TJCi82u1jtTydeX-g&oe=6AFF0532"}, {"file_name": "ScreenShot.png", "id": "648261064514061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_648261067847394_7698794737004577716_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkj0RL2sp4oQ7kNvwHZKC3f&_nc_oc=AdqFLuwtvUZx_IXePQhudvFH2q_jo3ftICDjzCU31uehpMH-n4BkbFo1LqioHZf3Szc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMNdOM4PJ6SBiyLAZnIMtExPF0nZw01_pSzdAuF87Nlg&oe=6AFF34D9"}, {"file_name": "ScreenShot.png", "id": "9368108643270106", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392185_9368108653270105_5903522276814069457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZHFiMIMuPcQ7kNvwGoRYDP&_nc_oc=AdrW_DmtpwhSu3XU0nbVhK6gRLtecLxgr6tZQJEsEo6pQaaPTUL3z9nsZ83PX6gdmTA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWqtnzX2eZDmwvLggX_4q6XwlQDzxSs9jDIc3lYfV0jA&oe=6AFF0A97"}, {"file_name": "ScreenShot.png", "id": "1007767241360696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391885_1007767244694029_4884811497528496583_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoHPxXBRozwQ7kNvwEDex1v&_nc_oc=AdqQ6Vnhe1R6vjkp5PHYmW6DtJGHcaNMElGG-PI9HyFRCQUx_kJ9K5b-bq7myw0mzRY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQzFNS2N6sswnA7lvl9V3YadBWeJGOyXUAwwTnI6skhQ&oe=6AFF2376"}, {"file_name": "ScreenShot.png", "id": "1233142171562884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392057_1233142181562883_7329468837487136315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BzqFJ7Q4BsQ7kNvwH7wCUB&_nc_oc=AdoMRYyET2hCsFX82S3WZhr_Fp1eJAsOFaWbRj5xOwbL9M-h8UtvNEgF4ME3wJCfYa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMIoHfPmA2przEWlXrlqOAgyo2rvXABiuxT4oMzqY0eQ&oe=6AFF2E96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Anomaly", "keywords": [], "long_description": "Ape Anomaly is a terrifying horror VR game, designed to test both your nerves and your survival instincts. Set in a mysterious, distorted world, players must evade monstrous creatures and navigate dark, eerie environments filled with strange anomalies. In Ape Anomaly, you\u2019re not just playing to hangout\u2014you\u2019re playing to survive.\n\nThe game retains the fast-paced, horror-based gameplay you love. As you explore twisted maps, abandoned structures, and haunted zones, you'll face unexpected threats at every turn. The anomalies in the environment don\u2019t just pose physical danger\u2014they distort reality, making each corner you turn more unpredictable than the last. The world around you shifts, and the creatures that lurk in the shadows grow more terrifying with every passing moment.\n\nWhether you're playing solo or with friends, Ape Anomaly challenges you to think on your feet, outsmart your enemies, and work together to survive. Uncover hidden secrets, avoid deadly traps, and try to escape the horrors that have overtaken the world. Will you make it out alive, or will you become another part of the anomaly?\n\nStep into the nightmare. Ape Anomaly is now available on AppLab. Are you brave enough to face it?", "short_description": "Ape Anomaly is a spine-chilling horror VR game, where survival becomes a game of wits. In this horror VR game, players must outsmart eerie anomalies while evading dangerous creatures in a dark and mysterious environment. Every corner hides a new threat, and only the bravest will make it through unscathed. Are you ready to survive the Ape Anomaly? Available now on AppLab."}]}, "developer_name": "SwicchStudios", "developer_privacy_policy_url": "https://sites.google.com/view/ape-anomaly/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swicch", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-anomaly/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9498140116920385"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9521665187901211", "version": "SwicchStudios"}, "id": "597544753303878", "channel_name": "LIVE"}]}
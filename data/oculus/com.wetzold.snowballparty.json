m&_nc_ss=7f20f&oh=00_AQQ7yyboQTWIv0ARGIFaa-c3HspNRlYIo0KmmkNn2oVH1A&oe=6AF9B726"}, {"file_name": "Cover2560.png", "id": "726849849361696", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_726849852695029_4861595195868331697_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MI4V9uGRvH8Q7kNvwHDyvx6&_nc_oc=AdqRBXpgSN8ZqNC2TwAh98RWw8P7O_FoBE4-b7rNA_QueeClEf-lmZJF_pVjaFYv15c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0SWNKLDdelEWi8crJCiyRq0OEuKhHvoWZ_-aXPztnrQ&oe=6AF9B65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560.png", "id": "1062510154889211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974575_1062510158222544_8538039428887926533_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJDZlsGk4hMQ7kNvwEf_7-h&_nc_oc=Ado8LCy1cBDrjE-5CdzBg8L36rtcGY74vfAh3QaGJoEZvXVdHo5yuIfYSW4sGpTRwe4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpE3eIsn4Xd5VCMJi66-n7fwF3r_QaEYTjPCOfl6taLA&oe=6AF9C17D"}, "display_name": "Snowball Party", "keywords": [], "long_description": "Welcome to Snowball Party! Immerse yourself in a magical snow-covered world where fun meets fitness. Armed with a snowball gun, your mission is to hit the dancing gnomes that pop up around you. But here's the twist: the gnomes wear the faces of your teammates, customized with real photos, adding a hilarious, personal touch to your game!\n\nAs you play, these cheeky gnomes toss snowballs back, challenging you to physically move left and right, ducking and dodging, turning the game into an exhilarating exercise. Perfect for parties or team-building, Snowball Party bridges the gap between virtual and real worlds. Non-players aren't left out; they can watch the snowy battles unfold on a TV, streaming live from your headset. Whether you're aiming for a high score or just a hearty laugh, this game promises a blizzard of fun for everyone!\n\nIn order to have your own faces appear on the gnomes check out the guide under the support link!", "short_description": "Enter the whimsical world of Snowball Party! Don your Oculus Quest 3 headset and embark on a thrilling mixed reality adventure. Dodge and hurl snowballs in a frosty landscape, aiming at playful gnomes bearing your friends' faces! It's a giggle-filled workout as you duck, weave, and laugh, bringing your team into the snowy fray. Stream the fun to your TV and let everyone join in the winter wonder!"}]}, "developer_name": "Impossible Robert", "developer_privacy_policy_url": "https://www.wetzold.com/snowball/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Robert Wetzold", "support_website_url": "https://www.wetzold.com/snowball/", "website_url": "https://www.wetzold.com/snowball", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24237545799193220"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "6852574904832708"}]}, "baseline_offer": {"id": "6852574904832708"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1702585243, "status": "PUBLISHED", "id": "6852574904832708"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39765716173042694", "version": "1.0.0.44"}, "id": "873447570886369", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24213755908238876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39765716173042694"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "873447570886369"}]}, "change_log": "* Play with your bare hands: scoop snow from the pile, throw with a swing, catch incoming snowballs and throw them right back. Push two balls together for a big one that knocks over every gnome around it. Switch between hands and controllers any time.\r\n* Your wall frosts over and melts open into the winter world, with snow blowing into your room.\r\n* The table stands at the wall you face and stays there from round to round.\r\n* New snowy score, points that pop in, and a frosty Game Over with a countdown to the next round.\r\n* A Christmas card on the table shows how to put your friends' faces on the gnomes. Cute elf faces are built in until you add your own.\r\n* Fixed: the boss gnome at the end now reacts to your score. Before, he always cried.\r\n* Meta Quest 3S support.\r\n* Privacy: the game no longer sends usage statistics or error reports to anyone.", "created_date": 1794238398, "id": "39765716173042694", "version": "1.0.0.44", "version_code": 66, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24213755908238876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39765716173042694"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "873447570886369"}]}, "change_log": "Improved compatibility with OS versions 70+", "created_date": 1734368339, "id": "27740344695579962", "version": "1.0.0.20", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24213755908238876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39765716173042694"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "873447570886369"}]}, "change_log": "Make reaching positive reactions on game over page less demanding", "created_date": 1702746962, "id": "24255051310776002", "version": "1.0.0.19", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24213755908238876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39765716173042694"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "873447570886369"}]}, "change_log": "Improved support of custom photos for gnomes", "created_date": 1702644166, "id": "24246362541644879", "version": "1.0.0.17", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2421375590
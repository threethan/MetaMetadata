: "image (31).png", "id": "2060461201416512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_2060461204749845_5273623581985870455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-Yo0vf7v0oQ7kNvwGNdCoU&_nc_oc=Adpu7_sgd2TVZls04bg7EwvATgbYH7xtE1duF3P8zRNx3Tjaddw2eQ9O7luQ7BQn8qM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MR472UINLhZ1KSMJaufBFWYwaQaQSnRIK85CHdQi19w&oe=6A01E987"}, {"file_name": "image (32).png", "id": "25472089859119438", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_25472089872452770_8565455325497000574_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwfrZoPEG2EQ7kNvwExNZyJ&_nc_oc=AdowfBdQQMScdCi90183Kq2bVkLqWH-JD82ynIUpnAuXo4S-ArBYJljClXkwiOYEMMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sPkAXBl72pU7MGIV4bJRmn7xMYoJren0kS1g038Ujfg&oe=6A01DB6F"}, {"file_name": "image (33).png", "id": "723007617215974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_723007620549307_5514160401971111873_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSsYWxxBx3sQ7kNvwE0xbJs&_nc_oc=AdopjoESvNgbpM2Yn-US-vOnFzw_mvWLaG4jHgkUfrsqz0Nx4vsya0oF4gNen6Sh6jU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7veoUcERxOgXwKQ3w0_wblLYtNDP3mfqVTD1AbfswB9g&oe=6A01DF7B"}, {"file_name": "image (34).png", "id": "819478847747032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618069_819478851080365_4720305003422566077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAIIf5BBCQAQ7kNvwGezal7&_nc_oc=AdrF7eLbPeFDjFosy1dreIIE38wBdIr3QApMuZKPR_uqMP3JEUjrSmEhs0YsneXtXKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-iPMuiCmQHmKeJgIzXE9FOrSypAGDaE1UJ1RCxUT53Q&oe=6A01EC27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Hub", "keywords": ["Horror", "Monkey", "Funny", "Tag", "Gorilla"], "long_description": "Monkey Hub is a physics-driven social VR experience built by the two-developer studio Axis Creative, featuring home-made locomotion inspired by the energetic movement style of Gorilla Tag. Designed as a lively forest hideaway, the game begins in a cozy brick hut nestled in the center of a small, stylized wilderness. This hub acts as your base of operations\u2014where players meet, socialize, gear up with cosmetics, and launch into the different game modes Monkey Hub has to offer.\n\nJust beyond the hut lies a mysterious descent into the Horror Zone, an abandoned underground facility filled with atmospheric tension and three unique monsters waiting in the dark. These handcrafted horror encounters mix suspense with fast, physics-based movement, creating intense chase moments that reward skill and teamwork.\n\nFor competitive players, Monkey Hub also features a well-structured PvP mode built around the same fluid locomotion system. Dash, dodge, and outmaneuver opponents using momentum and agility in arenas designed for fast-paced, skill-based combat.\n\nWhether you\u2019re exploring with friends, pushing your movement skills, surviving the underground horrors, or customizing your look with cosmetics from the shop, Monkey Hub aims to deliver a fun, social, and endlessly replayable VR experience. Axis Creative continues to expand the world with new updates, ensuring there\u2019s always something fresh to discover in the vast world of Monkey Hub.\n{4146134235649767}\n{846524221481836}\n{1395680298840238}\n{2251552465341486}", "short_description": "Monkey Hub is a social VR playground built on smooth, home-made physics locomotion inspired by Gorilla Tag. Swing, scramble, and explore eerie environments with friends as you jump between light-hearted hangouts and thrilling horror experiences. Customize your style with a growing lineup of cosmetic items and discover a lively world designed for movement, creativity, and community."}]}, "developer_name": "Axis Creative", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-hub-privacy-policy/home", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-hub-terms-of-service/home", "publisher_name": "Axis Creative", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-hub-vr-new/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25628067813485682"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298900_2112514062822953_7731649254308054711_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWDM7bnq3KsQ7kNvwFi6X32&_nc_oc=AdpSGHGdM7fb1hd8w7cCSrGiUtTDylq9p5ObpIXJZcp_bic8hTN0TRMnaasu9hDT_dA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TA7Xbq1SjV7Sz3XvqKgvjHa_qR-Sg1c1r7axj5T40sg&oe=6A01EA2B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Hub", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1768015560, "lastRevision": {"nodes": [{"id": "25628067836819013", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_
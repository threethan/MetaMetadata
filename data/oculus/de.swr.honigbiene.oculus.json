d5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_DogXKOmYJmTnDlAQGWkfEUpbOLLBqlUMT5peXAakUg&oe=69EA1981"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHlav2rk7VYQ7kNvwFTeNUa&_nc_oc=AdqwbGOdNzM0gvQffA5zljz7-ckLyVAHAhbwKKNb3uAYm7VM5YK62jBoqqvmuf9e0fw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01B6cPH7FiE3-4FZnagwCnQNf8_JmGcFJo3qwYxLCokg&oe=69EA33D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVGkoMfqHSYQ7kNvwEjMZJX&_nc_oc=AdqjI5quxtSrYpn4Gs2oaliCB3ySj7WMzWCD0V21WQqXgXSsubjSgJCPx_N0Wc9ZTAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pz2x6YM3UYnAOYdnlHZfw-K2bUy-s3qnT9axKhKd5sQ&oe=69EA1A14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
a3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw044J_ikxrgTFUlzZbUMTlWQ_AhCdmK0Or3upSV2xmA&oe=6AECB7C1"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xii7eYWlzAQ7kNvwG40tiL&_nc_oc=Adr5dizV9FiCd6qWc9xBZFqpBlnSU2i8hm-8yL2jbk_cGYzXTSNJ8kjD032XEogsrZA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS73OsR9eZwZtwbSAjHX-uu94UuWwXD0sgzriyh9Ms9Cg&oe=6AEC99D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfHXPP53Ij0Q7kNvwENiuLv&_nc_oc=AdpWgn15dY7U8-Qq7HuikLQKTziffbTJKRsSblZAu_gNCHiHZoZLeMBVpuaifp1fQqc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhX7ikQ8FlL9QtLaR_JfvCRieCLRKk1gDjIXobEO8V7A&oe=6AECB854"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
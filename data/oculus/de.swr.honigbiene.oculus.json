q9ewQ6o4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uEfQotKvUq2FvdnLH8DPDxcPSu_6ZiwDczGuGFPDlyg&oe=69F9ED29"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y4s0v17XTEQ7kNvwF8Xcw7&_nc_oc=AdqKwhIK21kU0wJZ5o_d-mV5M4jJvzlqcD4uo-XbfECQHxdA1t_am1PYXzurfOtlBNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64yOfuFCKax87e81_PO2f1fBc4cPQNiul20DZaxGq2zg&oe=69F9F9A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPtKfWi3bo0Q7kNvwFLHv0c&_nc_oc=AdrTdfKdYzb1de3I86JBnkXFL29Rl6sao_IdbtQLsOQuX_6WAnNB1a5VGvaePyoi6bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KGUKEDUQfTcdXPOHXzPVD_Zjv86xE9XJE_cxK2_Iw-w&oe=69FA1265"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.
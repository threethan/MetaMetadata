pAjbkDSY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCtGqtoDDI5VcG5S6_M8OuzDxWOFfs75V7OHsjkSHBNQ&oe=6AE8C4E9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRGdPgnB5dMQ7kNvwEOWYwn&_nc_oc=Adq9AlSNVxU-AVGejArT1HaC1gFI-AqRRLb-l7jqreL-NV8mV2gwzF09WoPHGxqigNQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNXCKOQ8FhQer192FIz4DMrGEne5LEMPHj9rsNbXp_KQ&oe=6AE89927"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpuReY82ClcQ7kNvwFfJQiJ&_nc_oc=AdpLyV5dn8aO4t-1Ff4nZsvbgvOCzq-HAucwtZBM-2AxJVxma1Dh0VSUIvFOrITeQ9g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeF2nNiqIWCSddJj61enYliYXyudK17tQrrafQSo9cfw&oe=6AE8B1E5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.
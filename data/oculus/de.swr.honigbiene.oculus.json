d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM06teFYj9ME47kx3PaPHH3NNrI9ORETyIQu4BMQWFcDA&oe=6AC3D941"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg2DU1jkX_YQ7kNvwFWo_oQ&_nc_oc=AdqnEELr6QRN6y8pHaLdfiMEzT3L0MPUMT_Ic-pVhqDgDzuY12YY-TLqP4H8ZzF1Hn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2rTVx7fBzbyJVzGBmUCvhUcRiRFg1WlTA9nZiu6-eYw&oe=6AC3BB59"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l12L9Av1AoQ7kNvwFgmlU3&_nc_oc=Adrt1hD7GHsp-Wc2A8p9A3QwdBk95kxfI9sdySM6kgE4dc3RjfTfx8YlJk3GB84OI-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Dcr89W-jW_WwZV50GdN-X0M1lFDabX9kNew-2TC7TA&oe=6AC3D9D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
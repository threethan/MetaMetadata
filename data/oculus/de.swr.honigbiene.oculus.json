kAV0x8r8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHl_TG53CUDTvAporookjIKAh2PXMMIFTU3PjVdg9Mbw&oe=6A79CEA9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-cv_Ff0cxcQ7kNvwHY3s4O&_nc_oc=AdoDMsvsF4sHIGkIZPLYVnWiCwiyNJX8BmyV10GD4rxc8UwYUlaBeilJXMvdOYWLhbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKAyPKyLgzpX7rSTs-1HjXl65meTbAekKb0H6BjxGsCg&oe=6A79DB27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IYKFN-vEZsQ7kNvwGlvXpM&_nc_oc=AdqsQ5gbyK2pedM3mtivz_6uGh7r-UGRBI9gLqYaEkAkMpcc39zSTPfSn6vx3c3NWIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLJ0cW3ywHdUIPqLZV5FvJA_xd5Ez-BSR0FVCCBBSsgw&oe=6A79BBA5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.
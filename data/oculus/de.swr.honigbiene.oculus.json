c_sid=6e7a0a&_nc_ohc=eHPJM6zD8CYQ7kNvwEEFwSW&_nc_oc=AdlfmMVAkHPsF7gLOto6u2HypKlWGoDhdS791r0CI3J6qy_2JzKuhJ1igaiv4Q9nrGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftljFPzE0KtBcpsBHChrrrj5LJ_FpS4TGbdcz1-Hu9LuA&oe=69A2CA99"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaAkN6B91C4Q7kNvwEriyGj&_nc_oc=AdmVDVD6YhwP-qhhWVcRGqN3wFd2MKcgiYQl8BdvsNWil8YD4xUfysckmS2dzGvYvCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjBqt3gONxEVo63pI7xSObsWqB7OMjK1zqoV6_5Rs6LA&oe=69A2E914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of_service_url": null, "publisher_name": "S\u00fcdwestrundfunk Baden-Baden Planet Schule", "support_website_url": null, "website_url": "http://honigbiene-vr.de/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
w5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18Yu0B5g5YWMGyv_gKM6ouXq_kOj79lN06pN8X1E4QfQ&oe=69F4A581"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utec7Qd9UjUQ7kNvwFT53N-&_nc_oc=AdppGum6db_sOurHCHQIwNpGN1w8kmd0ZS3Ml-iA-cGcA9i6ybacsoljlr7cQssLsSs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1m-1wN7zWYZXQQTFrLDyXS5WJd_LFcpW0Y2RPoOmc7DA&oe=69F4BFD9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilVk5E4D_JUQ7kNvwE2sx7t&_nc_oc=AdoCfh2zUHO5XT8FqOS5vgIUIHH6CyLjYMpvzLIdFCNT--wmhmL7u8pr4rTBu4aJXmg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1muG1VygI2B6x7RuG-NEu4LrpX_LK7ENCmBfvhuLnfLg&oe=69F4A614"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
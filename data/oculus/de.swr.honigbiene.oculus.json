luscdn.com&_nc_ss=8&oh=00_AfzPb1WFRBHRlZP0wifP1ZfXnBrgyzQm7qxxr5LheQ_TLA&oe=69AC24A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLxusWlB764Q7kNvwFYq5qt&_nc_oc=AdnSPKpxwjK5qzDf6Ib6Zp53YU-ObQ-EHlZt39aw5i2W-XzP9YTh65PC725VuncBw0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEGwCiHkuTPihg9S08LSvqtmHFYDtfwPL07Bscj17-_w&oe=69AC3127"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zso5HNZ_aEAQ7kNvwHp6k-B&_nc_oc=Adl4CAysx-k6ZMioy6P0DuTMh16SHzmukS9jQRZdbt9E4mJOGhR85GhLYk9VwAzazCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwfy_fW7pymC8oEtx56FYr6u1mabmISUp8UfJjHnPZTMA&oe=69AC11A5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003277_1214340982323513_2758100496016181285_n.
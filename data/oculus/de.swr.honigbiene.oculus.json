jndzH5H0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ib-P1kZPY_RHxSmiZGuQKngMxMBeR_OmW2q-Ar8DqyA&oe=6A2AB4A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IXV78Yq5QIQ7kNvwG_6eo8&_nc_oc=AdqgBUc3Bx7rJBVL-u1PwDAKRkYxvGPdfFlbRVyNxEznagtuRiUy-lUrBsx4Xk26jFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bQh4OxIZBk7TixxJl9ok1pEYWY-ndGD3Bw-KlQhgmQQ&oe=6A2AC127"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3zz47e9PwkQ7kNvwH89Mip&_nc_oc=Adrqsvqi5s1u75OzfMmeIonM_MvfRHgN0jiMjURwkdSshG6pgHV2qR1ehlnaQ2YuUzI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PJJAZ6_HBKDeSzaEgKqWTPNppqj-C4in1qLhATRFg9Q&oe=6A2AD9E5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.
a5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExP3B5wT0gwMrJ_nLyUXhul0nInw6NjnoPXgt4sPWt0w&oe=6A81B601"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuFmPG2xf84Q7kNvwGZlJzo&_nc_oc=AdrpmMZkiNAScXtqYzHPgk0I8IAeFLiRljvYyqIo1poASL6WY0ywSyiwjgp_m6bzSxg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3n2gNTFIY3mWQ6ig8DbxOOtcHliVT93Ia01UqN1A9Gg&oe=6A819819"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJRewbncJr4Q7kNvwFh-hMq&_nc_oc=AdpYrbSgK7-Si3WccyQV1WiofBAi6xlxXpjb_0F_g5ZmBXaLkAQm8v_YPM7mlGcvokY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8nN_JeX9_LQQlfeCLqQZQ-VTvaHHbUFiCMjKdnuKFsA&oe=6A81B694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
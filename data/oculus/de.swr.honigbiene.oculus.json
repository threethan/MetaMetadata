a5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBConSX-3mRNxqFRndwFJ-NBxbF0LwobOTY3k2Q45uGLA&oe=6A539181"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3GpjcYr4NoQ7kNvwHWsZf3&_nc_oc=AdoRrIqTt9Hf783PrtkJu_pc0NDP9OhSSY_gmn3QnUI3bJldk1xHiPHh4ffyfZCPjCE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsJnM7_swV1t1QOKxpDp6D7jAtDCVsVy2mEMhOJLqwDQ&oe=6A53ABD9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0UXOIVlzr0Q7kNvwGJ0h9J&_nc_oc=AdrrPscARpkPMg_yuVWdD9CfUIzpIkaYeCWHRok6Rd8Qs2KHt7cfwEAL5YSxnJDqQis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIP4tB4TfSiRd5P1TRRAm5h0tqR0yl54Yfv4ZMMyPriw&oe=6A539214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
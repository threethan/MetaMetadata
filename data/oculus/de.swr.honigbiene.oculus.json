qhoWYlDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPdcXxBeC_cmNACa6mXQB-O-aI1_QH6Mdxxs7dw5FGRA&oe=69CBC8A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBG3oCMusQEQ7kNvwHuHjos&_nc_oc=Adp4N3aZCpT4s_e9yquy0CrWC7Zc7QnHprzrOVxPCOQ2eKxcgWRT4-68L5ioGEyXPKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaD_WxdwolOMoAyHll_CIia4Ux1jkoU7TKszDKG_FY1g&oe=69CBD527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ki1F37E794Q7kNvwFpOx7l&_nc_oc=AdpW7_zJqblgo1wS49nMfpBMOXTKvLG95ZZZ50BHYfBZrKGc32JwNKPQS6bZm5_P5MI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFjGiCcP3alzqbInMnFvwL9kxFltTP7dF5H9-bgAq_ag&oe=69CBB5A5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.
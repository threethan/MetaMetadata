s2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A1S0c5cNrzznsRloKipbPj9Ab-1vaVgUeIlJobsTFWA&oe=69DE3C01"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fDcfxh5p4IQ7kNvwEqhuXW&_nc_oc=AdravYcQE0XWgZPUErcr2jsEITKmPjNwv7yFaCx3OD4KkS7jkFr0ZeZcoMn7krcVKpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qla-gw7pFJENRE3v3I9gStt2no2Hdmvpdz_91VSb5Vg&oe=69DE5659"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYHWnkPnYjYQ7kNvwFbGq8O&_nc_oc=AdpaV-HMXiU9fUYkUt50dNFEF4Kaos93bP75lyKSxgaIB8NsoiIJV5TxWzZ-rbVsyco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LMi08uhFj49Ozs6SZHqFTb0LI5zFnwvi7pHSmfjM1zQ&oe=69DE3C94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
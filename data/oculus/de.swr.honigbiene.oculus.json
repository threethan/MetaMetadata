0DvSqPMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABd0iKKfcuC09HXRC9TYrL--6JiGUuQ_ZQ9IMZRMnafw&oe=6A60C229"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG9SYAoKVB8Q7kNvwFbf-dO&_nc_oc=AdqAdNU6JAI_NzISsTOTrr6ybRpKDLqTaqWj04xwFMWxWCP5xanSyG8tDG-IiGy1R4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA3E97liXMpRPQo3CXE1WhnDDR0lNLaXcmINrW48YVVg&oe=6A60CEA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQXameWniYkQ7kNvwH9RH-q&_nc_oc=AdpDhAT-MRjv0-l-W1tSJYH-B4wTAEtZ1AIe6pQIG1tTBIB7B_vOu4mneOdhY2cMKCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIHkyKl98PD9Klacm30hiPU6lt680pd4QE4rwS1ojKtw&oe=6A60AF25"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.
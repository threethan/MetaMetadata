c_sid=6e7a0a&_nc_ohc=Z6Xb1QxOxm0Q7kNvwG4oOZo&_nc_oc=AdqYJsAh_7ltHvVjYWkJ0Sbf15c5QZO2JYsqBiXQ6TgCHfMcae2QUcY5ew2z-f5QZvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3j9eT8Lv3XKaFsZFI55bLvLrd-KSgAIGm7HUQfQlDr0Q&oe=69F0CB59"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFKtpopFlaMQ7kNvwEFXS0C&_nc_oc=Adp4pg_5g2N-PRHG6ZlQIWb-fPjU3kiHCdHD7-GMnHZqScA_G4NexcfT6cPSt0UL7yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2bKzfw38hfwrAWtMdx93OOy5IS5qJFzedYMoAMMCNaHg&oe=69F0B194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of_service_url": null, "publisher_name": "S\u00fcdwestrundfunk Baden-Baden Planet Schule", "support_website_url": null, "website_url": "http://honigbiene-vr.de/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
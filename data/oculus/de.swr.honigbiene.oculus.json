Gd8HgZho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8IO6RD2IH6ukKtd7Mg0mJ3trgX7gIFaWhlwrMNLqnLQ&oe=6ADF5229"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBWHDf46K44Q7kNvwFbVXoW&_nc_oc=Adp2A3WfQowpXmVbqPUgQbzcScRNhP4wshTZ2IO3gHT6tciEsxRlZaJEy8jU5Hmx5lk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe9xiREDI1BumncRcxeF8-KGSbZHKjgbjSxt-QLp2iKg&oe=6ADF5EA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL69ktNG0kMQ7kNvwHuSA-3&_nc_oc=AdodHx35lO6yFTLdATFA79QIS-V_x6_dk6Ef63nMSyzSAR3NB0D7wKoSKzPWWaeD1Ek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhv7NsiBoHEKhMVccF0cPYUbibFZrWYDB-bnewmRMqug&oe=6ADF7765"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.
l3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1U3hwlq7zAzAa7Y75AitxxP2IHq52y9t0UVHAc-T-Ug&oe=69CFBB81"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCIMXxiWcjkQ7kNvwE1BcxS&_nc_oc=AdrdriFJd2qufz3gFNy-WqCngkIY2dhlqeFLwi72OY7IO17IVn3zAe6o4gxFqHF5HHk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTuCEpuRP-HQqZGp1xyz0HXN8xVUwucSbQWLgB7ACNHw&oe=69CFD5D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4v04wsaAiIQ7kNvwEIc_8K&_nc_oc=Adq0ig1JOS4E3CHL3mJYpbSAOJC9DmRazuwcE1YwxZBr8GoLPowd0B10skz9KhyAoCU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsPnUKK0mxxgkSdBIl8IIirV4rA8xXqtDcOZpIXE0jkQ&oe=69CFBC14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
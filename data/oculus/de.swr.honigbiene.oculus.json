g1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa0929KnJ3Vh4DMSpzDeJ-xHKBH7AQJihC2Tsi55annA&oe=6A918801"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up-PX9c26JEQ7kNvwHFA-W0&_nc_oc=Ado4jQfgFbcg1uTxYCUeWbn_-0uyE7REjJ3xCHkU0B9_ZwgjAoIb9feAqglxfAJTZ0M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvfVb6-5qJRU5um6UoyhCUUngS1pZsNxlRy2yyJfzaJg&oe=6A916A19"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuXSqMH4JTYQ7kNvwFaoh0y&_nc_oc=AdrucJJBDSYX7kUh0Ny7rhY-l29zDJb-tbmL56QnPKEa9R41HpZ9YWtlv46n7zjl8kc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5YVFj7wRWJcn7ZFSbj290cvbNZh_0mvNj_NkymiWRPg&oe=6A918894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
l3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tIlvbhkLcls558ufTDpS4_FjdecTutFvoFCd90hi4JQ&oe=6A3D2801"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abdoiLLbMGsQ7kNvwFFgU_l&_nc_oc=Adp2khzt6pBwaVCK41chHddOyfHOVbOuTALTP53LmnCM1MllrDdIjzIyEkLdfbr0evg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Q4qD8ThvqgJNTA8M2mhDjvInSdB-OAR2txeZu8BITA&oe=6A3D4259"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prj_2obiBiwQ7kNvwE3IaF7&_nc_oc=AdqY4shnsS21zpWiERXNFxpP_ZDx-q_kbQHr-jWebqhIZj2XvWJmCq3Rpsjnb98QjeY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YuiGwt-YOoLO-hkSlZAcSQCYMu7vH0B6DGzgffTGycg&oe=6A3D2894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
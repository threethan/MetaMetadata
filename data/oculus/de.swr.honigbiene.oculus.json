d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLZmdEYGuANmTTwJF0FjT2tjGurv3JgVfRXaw5hnn6lA&oe=6A75D881"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EARJzOkADMIQ7kNvwGrRg4O&_nc_oc=AdoV2DFKSJ02gM8n0fVCCu957Pct-RVOGkl8YfGqvL_qLqpW3pUkc7wlnqUQb7xBa74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNssxnStpOJJL5U3iExNDtRyuDC-9KxzOWe8bHJ-A2fw&oe=6A75F2D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhw_Ebl6uW4Q7kNvwH_8GZP&_nc_oc=AdoLBrEm_01M27iknT2W6hNs74eqC9f2icP9NuR7jB2x0kidnIzumMh4Rjsd-doXjbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElYLPxuqBOhIN276vWT7q1OwO9FtLcsN53Bn0w17kF-Q&oe=6A75D914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
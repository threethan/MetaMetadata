a5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA28-tiWW2jhrlCpqV1kb0y3spshjHFTuPUmBkOg-cbuA&oe=6A58D781"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7BNpWBPyH4Q7kNvwEqVaHO&_nc_oc=Adokyg1cl3EKHnuS21xCRarRzufeNxG3cQJQ4zFjeb4iS32vzEyRgiM48hTSSwxRnAk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpNO0hunRANjA4Gv6_b0JmMb2IvjPhOp1AOE4wk_hJ9w&oe=6A58F1D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeSW6ucjUu8Q7kNvwExe3MX&_nc_oc=Adpm1wSV1y_GCC8_9OZTNLAeIDF5T-6bSWA7_0F4BT78xVQI7seMOmFm5EABatibJxs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiyM8kntrB2OCMGh9IOXVgKFDPFzyrQ7sCcujfyFgopQ&oe=6A58D814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
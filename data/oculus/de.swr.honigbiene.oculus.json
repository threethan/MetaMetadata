jLgHDWoU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lDuXNhKEI4UNFgcDHEwkWtOCawJf3v6eMFO5lxWbG4w&oe=6A1056A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp38iPdl3ZEQ7kNvwF7nfsk&_nc_oc=AdoX0uGWbYO-GLOBdJLxJ1GoqzB8TW6U_dWRYoPj1iW0dK-zM0WyvRs1NT3MFDPjfmE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oC0QPOzAVOJCp7TR-CLV44D8fFtCa6jOMNSvdIAnQOw&oe=6A106327"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBGPX4V7BecQ7kNvwGX5nJa&_nc_oc=AdoCezBR9bgmuIYrPmHplVWTcIpN256TGt5b8LMwH0V3_57Mrlbps3f5YJEYeG0e9fA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68pJ4xji1a36lErXX_VAbWCt7jdIc_iA8Tam_o71Cg-w&oe=6A107BE5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.
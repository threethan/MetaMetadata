a3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zj4akT3isC8HHBMJKk83h_cy-QfiNy52dO6u_o7_Ksw&oe=69E77681"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REEAmSTu1rIQ7kNvwH-RZq8&_nc_oc=AdquPn-3LoasvGsgCIjjtDchi2ivruRfxQNIhIfUQZYWPn_KIDYHomUptS0vHIsjX3E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05-TnnOiV_03MACt3BsR-QCfwQ163_vIA--sU5fvCPqQ&oe=69E790D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M52f7G6_PgIQ7kNvwEOrBCv&_nc_oc=AdoSjOxKRPuUAApGVd0lhhKXlderptCKw2LG3p6yXVt6c3cDXFYZsXYFNZ1AnbLZzsg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37xZXuLAUTiyAUDZt1xrdrAY4eLmQmLHmnKB3s8i2kMw&oe=69E77714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
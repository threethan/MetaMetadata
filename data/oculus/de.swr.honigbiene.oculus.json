luscdn.com&_nc_ss=8&oh=00_AfxauGw2u0mnKjHJpC4Q2S0CQ2nOEJWyPqGsVictPZRVLw&oe=69B16AA9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt7Ag2g8fc8Q7kNvwFSqAKk&_nc_oc=AdlRDZIM_xT-W1uZYh2UAkieFbp6jJTEIH8SIWUct9EzZE9EJmnAsjwpb4vB9i8AVGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYDUQFSR3mz4WZu1be5cAGQ68osOSs87luCj7P_795UA&oe=69B17727"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuhmGcX419gQ7kNvwGfjD7y&_nc_oc=AdlxO2vicn3G1dZi3zTAS21qErTl8mCX6jIGoA0RcL8vAZ0EbtqLM9-T3mRVGav0RgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5CmP56Yo4WHAvrhmsMl6_uBJnzhHoPHAw94tyeVYlCA&oe=69B157A5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003277_1214340982323513_2758100496016181285_n.
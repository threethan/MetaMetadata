d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn70u3uSyadAYgq5uKtgdDQ-x7zp99hG8ebFNuMCtnDQ&oe=6A8C4201"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQA0RPNeaHIQ7kNvwH6sPEv&_nc_oc=Adr8uJwp2iLV_G9d-0NUFrfGTWWZAXpvAcmQWXpRThhdDJeF75Xsi0qUWbIZBbh003M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAGYqoRAaoQV9ii9ryDEsTX_FedQvYR-RlonOZTLtl_Q&oe=6A8C2419"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGY0ApBcqZQQ7kNvwHmB3N4&_nc_oc=AdrFyfxs6fSjb_T24wh_5qZ1cJkmbdVaaNBRJA3T57zNWqRkoG-Aa0JWXjy8GKGz-Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHhBtOdMgswMm1R9KE87mQ3oPIlXtglQkIPTtGieVj2w&oe=6A8C4294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
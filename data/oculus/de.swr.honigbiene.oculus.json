l3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k5BMbkTvMhNCT1HYai887kwHr-dcO5Mbk-COjuvvm4Q&oe=6A411C81"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXRvyBDAMUYQ7kNvwFrZiRU&_nc_oc=AdpAqZc-UC55HCa7U33Yp8Ksb66audJgVrWBBSEkbuLCKWqB0YFKlYuUe4UB7-ihoB0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-51gZ__yK77x5uV8mU0OU5iscEaS1HfMNBn_HGIYe_FQ&oe=6A4136D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMqy39sGOFkQ7kNvwGTk9xK&_nc_oc=Ador-R7_ynAw6yMTN12IBLL6h8Ttglq7XxJJImSbUrWcs8Nf0_UmPff43vUKMi19w5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dOOYAurnZC8QgDYt_1k3Fi0KLudH7t0je6TwRKaRC5w&oe=6A411D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
luscdn.com&_nc_ss=8&oh=00_AfwyeuBnLJ78RCMRbFsCSAbit76JUsMwbd173f_Mn7tLMw&oe=69AEC7A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kle9woeaYg4Q7kNvwGaAhnE&_nc_oc=AdmaIBPiigfXlPHLiqVKjryVV87NBUaQL4PcAMTKq8nUnRunxwNwZLsop5Ujukh4XYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afybl8nr9h_2ARmc36_WLIidw8f3-1edy72WfpY8lY_7Yg&oe=69AED427"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX2Rz-jCYXgQ7kNvwG3c3iS&_nc_oc=AdnQ1xm34PDf4A4K-vqzR03nWFzM71VqdDiL_BQbRoNePEPF-bXJmYKaBGaRdScgZ8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygFzAUxSi82z_iDo_pQBgXktp9FoG_ayb_YTftUS-yCg&oe=69AEB4A5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003277_1214340982323513_2758100496016181285_n.
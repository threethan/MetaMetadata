bwVaWOtA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZplLOCyGhXjltlyrhSEc8v_LJVkX57uXpgyUk4yBq8w&oe=6A884F29"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWYzZbTFZvQQ7kNvwH15nlo&_nc_oc=AdpBud80t5Qp2FLXexBWPLXj0CPyernl8nKjm_Z-TBFPKLvLmN18WS0DnnIyRaVCaaE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBN2KearlpHv2zk-PQr2oPR_SQGqIeqqukscAfUUOCyA&oe=6A882367"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RiBJWmddUsQ7kNvwGh6Zq_&_nc_oc=AdqtMCbPRwfg4Ivg26F20uzKR50CzBgRrYhOiiKDNSlLPRtPajwssosSWTjRS6uwDvw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_lqgzZljFFI7_t00LAN8zYxS8t_Kyj-bctf5HONlxZg&oe=6A883C25"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.
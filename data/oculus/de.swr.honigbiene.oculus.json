luscdn.com&_nc_ss=8&oh=00_AfsIc34V6aOFnjOnddNvrHOu4Xqzvi0cSumvzXPtva0K5Q&oe=69A981A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLxusWlB764Q7kNvwEJtD_h&_nc_oc=Adk9eNvRTK-gcnWmxBfqzeRcqPPxkL9VgY-4JY9OKS5HpExMcttGBY75pt8Qn6jOPOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsubskWXOoPDnNHOYFjcWuKWWFNA_7l242SJRQdbYjqoA&oe=69A98E27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zso5HNZ_aEAQ7kNvwH3Fddr&_nc_oc=AdlqnJQ-Z5LH7cd0Yv9y5CJzzbMjGdJe7gFvZmRrMIwnqRTfU5Bcmk4P7X43Lzv-C24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afse-Mg9c4XMLU_HK4RPpuGEuDMhYyCBvja5uF3-0uGSTg&oe=69A96EA5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003277_1214340982323513_2758100496016181285_n.
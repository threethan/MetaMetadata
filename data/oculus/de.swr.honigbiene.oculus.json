a5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG10uL3J9YItIu35pLnh3XahYpJQJ0cmPIYvLfRT08p1A&oe=6A884D81"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpbB9KJ8qjAQ7kNvwEY7Obs&_nc_oc=Adpvjnn_BamAb2QJdd9Eui4k06ZKmcGO7eUqos8_9c55Q21_Bi1J6gYbcR_O2xZGPLU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkVkDHbH4c3ZSwip8gb-gd-acGYQeLct9j7orMP8ACRQ&oe=6A882F99"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsGNuOrXtcIQ7kNvwHFqP2c&_nc_oc=AdppGZtKGqbHxuG5IPznOknmBzK3q6mw0Qli8SHLsBBa1IrNk5OieyN4oGBUnQIgDvo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_8cpKT2d9FisuxZYK14kvSVC7w7GDo_eIfDHvs1o_pA&oe=6A884E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
nt-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTYW0p4OQ_Aa_CWMxKNgddzN2Z4ms86mhccE_bGXJEhA&oe=69AAD329"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLxusWlB764Q7kNvwG-sal9&_nc_oc=AdmkL9qSijvCOR87sQNX8BZvcV5mgaLp6dBYwnCrzUXh0V5va24pV9nq3xPWxyuzpaw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgfZjdpIuwZRHtCwJOhRav6RGa_OuUC-GTDme00PvpMA&oe=69AADFA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zso5HNZ_aEAQ7kNvwHlo0Hi&_nc_oc=AdkwJekOdSm2HrAkGJzlFWIZ6LdUoRsPS2TqZQB0lSlHC9n4FkgxWTGTs6z9X2wn00o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKcNaIKXpqAjGTKin_WqyTUKGWXR1_bY1wnLjUsqKAvA&oe=69AAC025"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003277_1214340982323513_27581004
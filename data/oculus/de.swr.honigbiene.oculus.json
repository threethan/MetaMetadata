TyONATgyqLQ2bk28&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSCIQXHC04UL_03ujMjcZHvV2l6t3k6-ozigVSy5EsTw&oe=6A8D9529"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgzpCjDoFAcQ7kNvwHBDW3a&_nc_oc=Adrn8eB8oJSZz45XmnW73awLg9Op296X9vNUNpHlfEmKW-BW7srr7UFv-bo11QNKcyQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFDdYBtbkaQ7KJtdjL80hN1UxmprHdeDkF_tPz5_cmDw&oe=6A8D6967"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGByYHwF1rIQ7kNvwEUfwIf&_nc_oc=AdpSQAAcdlJqHiii2j-1tMD1HYWhe3i93Ud2NKCPcy5Db1xAITz2b-J3QvV-3ohAC1U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWXYnId8TdCB0DaKM2FYom305EvaFoQg3ANAE4LFgYwQ&oe=6A8D8225"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscd
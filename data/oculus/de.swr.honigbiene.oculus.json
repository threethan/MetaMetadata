d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0bL4FlYfnhGMxc5dLhc_msgWTCLFaMTuG9QUT7UvH2A&oe=6A2D5601"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZhcxcWp3gMQ7kNvwHUgvmf&_nc_oc=AdoxGNuBszHEzqnBDYV92imuoKrWYFdYTkbnxkLvX7loKVR7QGqhdJlxoXz8LOVb8Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gMaJRuR4QbO_zQ3obrX_ZAmkWkG4T6_rQyLfkWVdAYQ&oe=6A2D7059"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NszmFK_-FJQQ7kNvwF6Ix2T&_nc_oc=AdrPuLbY0ewFyswTfa1T8Qffgn3O3h1PklHwEiMqcIOstMo2PTTFz07RFMvgI7AgvDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pjgTgiRWlmNU0atnxl8OvR-P0BJZR6c2bkcGf6YnpkQ&oe=6A2D5694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
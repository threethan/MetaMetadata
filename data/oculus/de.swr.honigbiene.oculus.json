://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982543_579262379266611_5423918394854342656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RXiubbykeUQ7kNvwG1ml6g&_nc_oc=Adoz5LVkpD8Id2-ZQTYPC9YMhbYFMx6xLIFzit6T3BEAjtqBO1W8WOx1qyt-NnvAvDM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uk83arwk5sZ2nhN3tZkrD2HXiXpRXRubW7M-oDVpp2A&oe=69F1E9EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": ["Honigbiene", "Bienen", "Bienenstock", "Insekten", "Imker"], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \n\nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \n\nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.swr.de/datenschutz", "developer_terms_of_service_url": null, "publisher_name": "S\u00fcdwestrundfunk", "support_website_url": null, "website_url": "https://www.planet-schule.de/sf/multimedia-interaktive-animationen-detail.php?projekt=honigbiene-vr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended
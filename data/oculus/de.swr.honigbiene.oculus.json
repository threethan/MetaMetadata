Pvko1JEo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0980pmd26vAxhxMwTFaXdBvepRbV3Y5gM1Sxsucx1pA&oe=69CFBD29"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VzVT83g0ioQ7kNvwEtCapA&_nc_oc=Adq1yUoQo2WYR0cGLOwusI-yqErmvV3f-t-3J4wca0zKrch7_EovOH-RYegA5W71-mw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybDEuOoTjY3Foa9kH2AlSNur8McvfiA-BgddXXcMQulg&oe=69CFC9A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rea5dOK4OIQ7kNvwHTLVNU&_nc_oc=Adqs5zdzDL6gpbYaAG2ktXFM8LAvUVKE4E0VmDZevIZXBV10qmhYZ28rCjfyuFaeBH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqLbnZvHg_wMF9CgfRoakBoj84eDOYMJeVTfg4UN0BCA&oe=69CFAA25"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.
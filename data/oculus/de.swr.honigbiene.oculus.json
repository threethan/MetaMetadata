ES9L-vxM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73-rODtax1RI81gq_Ham_RMsbcz9rSr2WZjflWOFUYXw&oe=6A16EE29"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCQN1tvJAAwQ7kNvwGJ3aeX&_nc_oc=AdqihdM77MZIEjqQH8ezFS_DJSHA3ed_HzFe_siGO9JEl9befZ_Uc4blQz1V8LHVyKE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uej0ZnQR9NoTSZHMCe8zScn7uT8F3IhOEB45H_4DXLg&oe=6A16FAA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdHQrfg_0KIQ7kNvwGsko2L&_nc_oc=Adqm9PlDOGpt7ZuiqhFjYzw8JW8P3SQQR4TT64ZUy3S51W0r8iKow7cUKxZxx1Yv3qI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZfexmQf2soAcqP_ghyTVWc5fbK9V_MFMdZOaV6ZY80g&oe=6A171365"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.
t Oculus-2.png", "id": "226562636019062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984464_226562639352395_1967606249256931752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXEYWbuiJW8Q7kNvwHPI8Q6&_nc_oc=Adof6mdr0puPGghlcca-UBSmde_8blL9s6H9dxAvd_U-nSMCxrw9KBf6qQC58n0ndJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLT6a2Ou0C9HbyGV-Fjv1_3OX0OvXD2HPHjnPMm-D9gg&oe=6B0C5D69"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtPTKWQD8bsQ7kNvwHdRhJ0&_nc_oc=AdrVey4trSxcEShZkHNclO0L0VAXU0aNFBdCNA5QLTOgv-wXIl61eVw2dkgIaKQKw30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2T2KQUV_lKT_LcbMkw1C38obbBDomW4MVQOPRgy73vQ&oe=6B0C69E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AtGD6IY2LsQ7
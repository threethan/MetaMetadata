c_sid=6e7a0a&_nc_ohc=o30quanAsCkQ7kNvwGCziYd&_nc_oc=AdmLMOyVlrtl6eGSpYb5KtFD1OeiWiz8QKz0UT81-OFlSVl_UOKYyKLYxRNVCceF7Lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuAwfvWpIB6-p-Vbhq3kU6iSGxTYscKDwEX70AbmyinDA&oe=699D8499"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nEhwndJiVIQ7kNvwFUWrHX&_nc_oc=Adne8-lCY567NkGsOqCnzWsZyueeBPz9BvxBeHzvS1OqWTPxjk-DSuCPw0tm-kaZgC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGJqGH7XjATFIwzEjvvzwNzOghYYftgLlkHucT5e6LHw&oe=699DA314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of_service_url": null, "publisher_name": "S\u00fcdwestrundfunk Baden-Baden Planet Schule", "support_website_url": null, "website_url": "http://honigbiene-vr.de/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
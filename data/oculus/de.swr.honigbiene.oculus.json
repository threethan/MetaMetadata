c6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtw-KW5IHcxljZNW3X3B76XzVp5UyinoPQ-cQPTTu0tg&oe=6A9D6581"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbf0-E7lCJgQ7kNvwGpL68L&_nc_oc=AdqvZWGJHXZP8-Wa3IEBqyznJh7WGvKhgishd45PYinBK4opgeLzr3RISznO-WoeJ_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVFOTdgOe5nfTkgxNuJdTMDdhShOe0ePfIalYCKPAw9g&oe=6A9D7FD9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ahS7mLVuT8Q7kNvwH5vaXK&_nc_oc=Ado1buDT5-p0tEs2jvu4QFSW9kIcvlUQCD6BFPo2u94bLsQ5WKf9MJKrP63jYFF5P30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZpiEE3LkN20VQCOWozmFWsFEDMhWokgoG2C2AwZrycQ&oe=6A9D6614"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
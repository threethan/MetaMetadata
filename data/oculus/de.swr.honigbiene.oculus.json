45jRG6Gg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhDcGa3okaw5z96OWUaetSvkIBbXPgfbWfnAjXF7gSXQ&oe=6A95B669"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=divRBzbc6GsQ7kNvwHpn7Zw&_nc_oc=AdpGAIXuQ_PsQ0bxljdqbVeJWK-djn9RlFv-v9-bkzdFSFOllPTBdFZJ2K4E0PWND_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1mhLciyH_ymQMc5521-Eby1F4_auOE8MpEL57A0_LnA&oe=6A95C2E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_iWqWuKvKsQ7kNvwEzws4K&_nc_oc=AdoMH_kZcWc0rFCSCWNT4df3wXM1Dn9KKLpCFX_ac0sk6MTPE2WU_MUOkpIffUogDDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ8FvXoppKo6B9ZmAhyuxhl2Jl9xaQb4TZT2FmIBGPlw&oe=6A95DBA5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.
FO4aRrUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPoOCrxRw0Knus3mLumqtuOcU9E2iXkN24CNwT_4snHA&oe=6A709429"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxV4QC6ov08Q7kNvwH6qUIB&_nc_oc=AdqZXMOO_jqd7OA9DgyPzSJFBxLftuuhHSFtZlJbFp52RrLTg0qu9XzDFLawsUBw1hQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0I_BqzYJxCptSvgka6rZzN8ywrxtRuJTG7f-WQhKjng&oe=6A70A0A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNCQO6oQe4UQ7kNvwH0jEqL&_nc_oc=AdooUZbazzeuoRaq2P_M0o6ZTwCvOuz4OqICE7mU2NYsBPACnDF_M2u1q3Umin1QAcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Rriyq37WvCF5DpQGomO0debZmxMlyFnTUadT19AQ9w&oe=6A708125"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.
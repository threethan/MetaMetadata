l3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUFOkFbLnnmGNts2EOi5LvnDxd6HyqJJXaKmCjd06tyQ&oe=69CBC701"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrK2Cc1jDjIQ7kNvwFDlEiQ&_nc_oc=AdoOIovOyj0wUwgl5C8vVaO4V7QeecYZ_zmN6epqNs-UItaM-wadGEASFyOxISVwS5w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVzVGXk4LyH79ar1TPZ-DMsMPXa4aNfrbTfo_mIWYS1w&oe=69CBA919"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfT53wOVNYYQ7kNvwFd4wcK&_nc_oc=AdpuCfxRv0JIUWZKtUiiGF91dVGdLmFBE8IGqmWVCOrCPsTJy30VoBKHtQh7MQCvv6c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAeUgtkyXTqCwcePzyWbzs9-NEkgJ-2YUvKarUlZQ_lQ&oe=69CBC794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
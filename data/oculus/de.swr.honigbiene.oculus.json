TJCN1nOI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGieqTZ9NMkoM5tzpZuFD1amtdtR0fZrfmJBrtxzXU0Iw&oe=6A9189A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUdHCfCyK08Q7kNvwE2fM3l&_nc_oc=AdrGWx0fDhs6d5io9s-lURBF7TkN_XebT-5DEzNzLm1cjcOmnY3NS2E2Fqmi2aDyZ1c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPlrwkYZFIYqPZF6IYACuP8nKAX0ODBJXwztEQH0Sj8g&oe=6A915DE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfNGwH9eAWMQ7kNvwEd1Bb5&_nc_oc=AdrhUtS8fPSRx8cxBQ5ske61E8gEN9Xf8LmyOMCO7pvw4_rLSSB6dZLEVXgB7JvZmIU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvXRW0K2JRoDEVXGvYafKKcT7xstcvCb70RsNaSdVKPw&oe=6A9176A5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.
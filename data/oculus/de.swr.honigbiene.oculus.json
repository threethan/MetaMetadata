d5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6_9ewqUEqsCK9z07MwyDTXX6RbPRbf83H5aQXz5EhSg&oe=6A7B1E81"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDqS68ALY58Q7kNvwEahrfu&_nc_oc=AdqbBKJa3U3QH9X8b6acqLJkNRD0uQ6mCPS8ag34DZ5TueF7PbodkRtQIDt-CBIBxiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPRN5EELP6NMiBYGtdQbsX-oOgaqTnB18p5qEJesF1rA&oe=6A7B38D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66adSfGli7UQ7kNvwFviCbr&_nc_oc=AdrMtmKfvPRUn-QzMJoqiJl3-BlM8XBUOJRA9n73HEdID08Klc7MFkTE14l9fefiq2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSMMPhDvQ7_U0EYB_ghhZo0YLD7VryaRnlpI7JwfzJVg&oe=6A7B1F14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
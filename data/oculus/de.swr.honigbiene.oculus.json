JhAsloNIi2jC_LM6PJ7-c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SFaL1ErD4kRF59LsI_xs0IbFc7p38mrp1XGykj-Ylpw&oe=6A369229"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3vCgGhGSuMQ7kNvwF85AUn&_nc_oc=AdodEALJ3MJdayezDT6JxSGl3p07XiynUAmCm_TZrSo3Tcrkkb7FkqAv3FcZnL5PubU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0LuXWQlEH8MQGFfrpYF52L447mAYTEpTo7ncp1BT16A&oe=6A369EA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfe49NyDqvQQ7kNvwGwEGap&_nc_oc=Ado8mUfdhXIQ1-a8HXU4Yw5hnm0f4C74zTRxi0rtvIMYlVTZQJg7f96Cf1gA4wQu3NI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TMxG0uouJDyaSU-CdgJ88k9y0DNkvq2pBUu7jsDpJPw&oe=6A36B765"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-2.oculus
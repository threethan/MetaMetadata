HUQS8pnE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmmqK9PsEX4_zWRRgPyisGHtnIACVFxebL8vTbT0lTQw&oe=6A81B7A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzPplEPHz1gQ7kNvwE3T9eT&_nc_oc=Adquy0fG8auPzuiIU9hLmsoLD93ayyHQGvqsmnrkf9KfLO-3wxLNeswvpuSOcACHdvY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs5K-W1NQiEP24bamyUD13JJite1a4zfT2QOowZfNuqg&oe=6A81C427"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EMVmbPhNjAQ7kNvwEqDang&_nc_oc=AdpEwNVX_s0gOZPYojTrJtrLnI1-GH6uM28RPyfTcqrs3bxiNLjFBvzt9QlpyuoMIUU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl1bE9Ab94WpK9fO7ITJ0cFJ6JgKdDILv4TaCCiUB3nQ&oe=6A81A4A5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.
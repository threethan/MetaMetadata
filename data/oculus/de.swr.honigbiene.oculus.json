a5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQHKjY0nJTyfTA6577gSks97sPZm4UFsdGP7Zaj6rHbg&oe=69C7D281"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxhIxXRYUfoQ7kNvwFQjiU6&_nc_oc=AdrN3BnFTnRWpdrfA3Ki66rSLMId2dgKRay4bX1kAC9VIP9jiAKFAkckMliQmsOLnH0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1xn80KmcDo-icbz-cEt5G8fha4FfwMGvFVC4pu7K2Sg&oe=69C7B499"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxVChq4dm2cQ7kNvwEC8OXR&_nc_oc=Adp1dUqr_t79OEGdKNsqUSL0-YiyvrERoxKTc8ZLbzA3gEjWX1ArOndLcj2QMZ57QUc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKcE9uXlznqd-Zqa_mdi10vX8k242u656TJO4wSCBLEw&oe=69C7D314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
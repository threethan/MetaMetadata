9pixJu24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB3gyUZHN899LZKeaRjwwNG9uhL91UeGZZ6FS2wbkWdQ&oe=6A4BAA29"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeFJ28Rac3QQ7kNvwFIiQMt&_nc_oc=AdrkH_YAGWa7uUeIbPG-1b98K8UoceLs8bKlZ61AWiGhxcYejy9BTneJpazq2QWpwHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHsyxXO4PY1H_EJX7Xpb6PC78P74Bsr5xH0xIVC7mevQ&oe=6A4BB6A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efidOvSmcwMQ7kNvwGtYP2_&_nc_oc=AdqWQR_PEbJ9sjTC-Vv7ILO_EJsgbL0Jf9UFct21_vytKPPZH1_xdrNPaNL-bKZjLc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArjUDczNSJJ8rDHoHSBbjwf1ISUkRODaRfH3RfHaVoug&oe=6A4BCF65"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.
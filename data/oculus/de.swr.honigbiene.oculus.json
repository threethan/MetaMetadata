t Oculus-2.png", "id": "226562636019062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984464_226562639352395_1967606249256931752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UaIsz-gtzEQ7kNvwHD6PpQ&_nc_oc=AdqhzH5Uvb8SRLz_Q9jt_D2A-m3NWhAgXwsB8MpN4F-jJBZ_KrU41WvOcuIkNf9Sc60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYmqkSOFT_5EDDCtWbbzIN-Cf2d5Q-FVKZuBcA7oGxFQ&oe=6B047469"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cbrtGopkCQQ7kNvwF0G2YH&_nc_oc=Adrq5JLdI1B4Vh1YuEUyPoSlo0DPC5BwCYIpze97Ndx0fRePh87r9kAi_PpTQiiddiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjgHYPMVqkbr4pcchiExkN-UnoRDnLJaI_jPjaPXjrnw&oe=6B0480E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9uFeH3F7PEQ7
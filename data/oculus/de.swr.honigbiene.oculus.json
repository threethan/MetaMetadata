BGh-ihcQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWPGg5iYIK6_886u8xe_kLW_tYF2D-sXx4CTsydrXhuw&oe=6AC79729"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFlU1ZtQzVwQ7kNvwGhY89q&_nc_oc=AdoA6PqUJd5bd9mwooePriPkJFbHCx2SE9ufo4u-or7GfGUc4D_ed7IbaLlM7RuhEHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgCHjSFWmEACgHtM5WTiqxJEv1kZ8JjXPyuw27W-LOUw&oe=6AC7A3A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpO78dm9_6YQ7kNvwHJVZWO&_nc_oc=AdpSXxt6Y8e2Lbd8C5st3N7L7bpKQVfIEUUIKFbKfReD6UzPK0HfatMQPjyxGFbUsps&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQyut_3-eYWG5XOmoga_CUHNDXKJkJyxorWwI06OKfTw&oe=6AC7BC65"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.
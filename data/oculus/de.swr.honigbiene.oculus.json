0Sh7vgbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5OHSHZunjDsC8GDKnCt4uHJuDSY1T91-7lKa1OxJknQ&oe=6A9D6729"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVBOvZ1VeCUQ7kNvwEBuldi&_nc_oc=AdoFsMEJBPOZMSNCE5g2Tnyj5_FvlrsIJf8KILNnIgijBzZFU3CQaGBXeiFZF4xzr24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz0ja_yrWd1xsFD4Y4_OFCIeoQZhbty1SfGxd2d6J_NA&oe=6A9D73A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gR7w-BIjb_cQ7kNvwFZ_5ZB&_nc_oc=Ado0KDCmkLr0_npkLBOpnPXQqpjiV2Os5J9-7uEjSN1i07uie9yZ7a2Cv1LzY9bUW7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbYPztjn6wu_fqKudEYLYAyBLVUdeiYcYwOOdKm6RA2w&oe=6A9D5425"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.
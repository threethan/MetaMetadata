d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbm_lyw0KmW1b61GIwH7JVo9eRbh4hf2HdWLwU1mejlg&oe=6A5E1D81"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwC57x2H3NYQ7kNvwH3syAr&_nc_oc=Adp5uCPqW3ZltbL0V99wXsRg4aTnga8WP0r34fYVcAMbnXJLGbpQWQtaTkX83OMH67U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRBSPsfn31g5Wwg_ANctMBW6p4-oAA5Hms-y1lFhnqiA&oe=6A5E37D9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdQc_GOiamsQ7kNvwGvQYLb&_nc_oc=AdrBsy6SKbZO7G3hgkPGv7P49wifYa3yUzZERKKyKs4o_BjnI6VUsekAYIOpOhjRQLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZfUfa_tbMTCQojdca35sa8TGLNyL9wKvc-lN4Jogj5g&oe=6A5E1E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
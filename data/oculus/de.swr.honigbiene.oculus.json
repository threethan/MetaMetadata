t Oculus-2.png", "id": "226562636019062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984464_226562639352395_1967606249256931752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqMC9NYbTtMQ7kNvwEkpsXP&_nc_oc=AdonoB3QYH86uYkLy_NC1d6IqwNAMEMKbIIb54a3xE1AjZqvtjjZavyZ8M9COICBupY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmN55StMDSISlOEkf172rZS-WcgdWDKRkVsp6fL_mpTg&oe=6B071769"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKKFOuwaIh0Q7kNvwFC-Qt9&_nc_oc=AdpacZSgFCtOblB8C92NKugQ3wIngCsfaA8vGPz-Xi8wKVhsqe4ZMxYk0q9syNFtv8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-FCjhiYQHGCqBuZHFXTSt_fYZa4i8WSkhY1kXWzavdw&oe=6B0723E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iqGLFNcNqQQ7
s2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4fUOTe_U3nKFkUDEv71KHUErSDciFamw-18szUGkz9w&oe=6A9C1401"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbf0-E7lCJgQ7kNvwH7rPwv&_nc_oc=AdoW7SO_5IyfCZeSSCfoVWIe8pmBAI5WxzoSczbLwLUyCS0qZtm6tLBwz9mY9JXHjdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVySbBgoMW3TCvF_zDhc51srtPazXUIVDmxbhmpi8LBw&oe=6A9C2E59"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ahS7mLVuT8Q7kNvwFja3bE&_nc_oc=Adr93TiJ0f8NtFcQSqTubpWC5yqvfIQVWafR7hhTHLF00Fgv3Zfw40iB_YS7EGPXDdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG14OArHFybvX2NSB6EeuA81tFSF-6OBHTLyDQ5IH96g&oe=6A9C1494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
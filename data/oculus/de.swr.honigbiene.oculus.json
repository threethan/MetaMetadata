s2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aFu58WfJMCcJ-dAzz7hEF_0YjqqmiJJ5oFp9e_CKvMA&oe=69FB3D01"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFLri5jSPzAQ7kNvwHPMu3t&_nc_oc=Adqecm0jaNJQTe0mfzcinn10XAF9DPQciR1nAN3Si1Lf5LoBPDcZZRZc94FDQ6dfZlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YBuG-68jRF1BMnC25s61pg-vRtf4hd_XmENK-iBEiiw&oe=69FB5759"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FzXdjR0-oIQ7kNvwGh250P&_nc_oc=AdrykfTafdUA8deSXnSBS8DaGBiAZLUTzp9keLFcIHDMGl36gAwT0Sf-fv-CgieUl3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OV-11mjAd_D0Pq9XhudlNAh-uEFkfUou1kPd4Z1jHtQ&oe=69FB3D94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
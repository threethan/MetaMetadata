vyVFJADI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_b2APkHv9P_LBV1AdnEbSgBw2xwJUznkWgPoChJoG9w&oe=6AA15BA9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlD0ril2wp0Q7kNvwE2yvoA&_nc_oc=AdravJhu4qgWlk39Earz8kW6trliTvtMea0HXeZ_hHKiwKSat57-djzwQnkvnURfzmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsaunZN4oyQlITfQ-URuj48hZFMknCLuPUI-u7j4gOAA&oe=6AA16827"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yarectlIWmsQ7kNvwHBVQjS&_nc_oc=AdoBKNfhZziV8-pv7KPAzQoLw5qIWkDp2-1pNk3tAq4D8R_sgs6h4Xqb2vyxqSMmnEA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB49eUFFFNAqYSD7YZ0ctmFJNJTim6hI7YG3l8_rvbPw&oe=6AA180E5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.
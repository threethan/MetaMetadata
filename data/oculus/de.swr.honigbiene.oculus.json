k2p_gp7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2Vgx3Oq_1tzoNv7Yh4S0O3XpdC-Pk2A7PwnUl_cUUTA&oe=6AE1F529"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7dJJAYFuKIQ7kNvwGHQhCw&_nc_oc=Adquna28dKqC4MPmJSceGwlsEbRoQtrFko81_OxXbncKb8Mb6eJg1GuCiz0LQ6XopH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhMXBi0VCWD6e2U5A7YH7DDkMdUNONYFiVGQ1HZYR5pw&oe=6AE201A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g6taXUqzY4Q7kNvwGQYIk-&_nc_oc=AdqSafGDEt1kIrkWGCbQWVsP8uBkOIy7tZ6Ulpp7IhVBPTyruqoQTrfNCH4swu_8Cx8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbPc9T_BxHK5itnu1oDTWmXako_cI4A72lEgGCzJzqrw&oe=6AE21A65"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
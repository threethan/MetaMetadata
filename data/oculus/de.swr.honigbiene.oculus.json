d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo-dK-O0XsHHLFiY56jEP6jsbaaA_e4Heq1B-q_U2uSg&oe=6A578601"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjSLMmSfTHYQ7kNvwEhqYaT&_nc_oc=AdqJ0vDUv9Ezr6KMusCcimMiXulcCgRtuTh2VcalCWYSGm5tXHWZ5AZnstYA8GjkSIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1Cu7gEiTNdbqhC0URaTjQlykat494Q7ePu1ORJ9rRbg&oe=6A57A059"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ruPbY7yqqMQ7kNvwGA1I3c&_nc_oc=AdpHkEH9D3FZ7F8_e0VYriykeBZiwws7hmXQuS14b8_8LEVLA7IKWW2wRf27xWNmZqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa8kuJannUkcZtGPXKDX4XXEsIC_6W4SUYvUaVgUrKsQ&oe=6A578694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
r8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46t5b2D1M_XD2e64tzDJO94e7TW_Gw4_E5uxV3qrof2Q&oe=6A105501"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FVRmvbg12wQ7kNvwH8pB7E&_nc_oc=AdpGi5rSVpQ0K1AzFepbgJn9DYGpoYk8ZbSBY67UzeoxiB-7LirT80ObBD12sU9TK5I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nMecchI3qM_AuFhzCA6veshrB-QzIlMqRWUagoyD7EQ&oe=6A106F59"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKqznkFsQL8Q7kNvwFbJm5J&_nc_oc=AdqxrG7Cu3m9wOqkal2uvFO3raQN3WWpjiJFaOSOhlGYBmC9c5nE2bI0s-EqquZaIdU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ogcxUAHKv9qeBC1aXdCrQfHaG8TObYjy-0ZhAbRIirA&oe=6A105594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
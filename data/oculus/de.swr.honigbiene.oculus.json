a5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFUlTOLgjUO3v7XNUGLvztgB2rhAS8-joP72T1QfRD8g&oe=6AF34F41"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG32fZmqlycQ7kNvwHzeUzd&_nc_oc=Adr8aLR2mVTMFGNqECQKQMKvvJnxEmv10v4GOakp57a7q1AQs1YDX2Rs6GPneSvGygY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ1071lsbQu2l5nyjnvWP1nHfbZNS57xcP5mLL7DEqfg&oe=6AF33159"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2xkpCiW20AQ7kNvwHx4KFO&_nc_oc=AdoRk8YOOgPmwrzsUqN4TE1csG7TU-YNUMrxdgnVzeRnUXMuxQOCjiIoq5BKIGDiJcg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkyr5Cgf3GTiIQeWdkNvISYSINbdttQLq9smCHpW5Ncw&oe=6AF34FD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
6V9xkOvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFREcWEe6TsaDul4RU-uOlvrGx4mNXJ6EVmSg8TTZLenQ&oe=6A7C71A9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx0qSfoU9nsQ7kNvwHz6ddG&_nc_oc=Adp3eyvx7M2Z4WNiIF6cWHo7RDDu7azssJY3XKwBHIuNqc4wyUYJ3qz8QrBMzAolwPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwlvHRpWR5_UNQdz7UXa2XE5b89s1tiYVIHGSp6zrnww&oe=6A7C7E27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2Rx8j4YJOMQ7kNvwEs4LYl&_nc_oc=Ado7BZ-2vgAsVInHwvXk742zpJ1ylvzIKnwHYKqPqnIUu7oUve0bwDJT26XmRVvTiiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrlG5K10fl8qF3cCBFiwsdWnuDV74y2Xvib3To5wYSqA&oe=6A7C5EA5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.
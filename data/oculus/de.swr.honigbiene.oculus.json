t Oculus-2.png", "id": "226562636019062", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984464_226562639352395_1967606249256931752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXEYWbuiJW8Q7kNvwGG4238&_nc_oc=AdoUyIzH1MY2I4RSwE_k1rkieVsXB3YVhbGNOtpQroL5r3jRhgYBbZVWgFN_KK-E1xc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmr4704g3z6aSHaCF2tPJujcoPmHy80PpFPJYDNc1NCg&oe=6B0B0BE9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtPTKWQD8bsQ7kNvwHakjQG&_nc_oc=AdoW5DrMH5siN8TRW60txzTHv8_-80DdmDItjsQmVW9XlBCufWZz6YJ47Xfv9YRHhbs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEYD-ppC1lBZA4DZ4TwxbsW7gYVjlpXZgZOW47wcyA1w&oe=6B0B1867"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AtGD6IY2LsQ7
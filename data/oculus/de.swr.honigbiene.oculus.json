a5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-DIoVmseWOs_GCLk2tN2pPrqQAjvhBpSWLqpaUf9QoA&oe=6AE1F381"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLSxAcCvuPAQ7kNvwF0ao_Q&_nc_oc=Adqva4HRhLM1Yq8VVWFPYzqFWVFqVB_fII0zTQvlibd7RLROj6BuIz9zeb-BevwUuI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPU3I02c_i_egwbOhYurIA9i_Umep9APjlPjaVLyLE7g&oe=6AE20DD9"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qywuBPO9OwQQ7kNvwG5vM8f&_nc_oc=Ado7wP92ZZPCBdvYep3etjUMdGqML7FyU2g8H9cZoGo0X3S33wKUF1koSHSHlwR7U-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGlLT-4_uSqcbT1RXmXebWlBE-_UDPkJ_KzzXcS7Hb0w&oe=6AE1F414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
2CGCFHAzX_uCQ2hmuqo-4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMxZQ2a5Mk5Cfy-OInvlU2H2qsrevY7ZoTbumu2jlJoQ&oe=6AA3FEA9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51fWmdZjPvcQ7kNvwGN9Mi7&_nc_oc=Adr0uvgCXuThhxiP2BAESJUNZJVnRMCM-wky0FGIdpjI_usuOS4O5GVFLXE2D-8LOJ0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFl3zWOD8tDxPxUk--nq9KsakmmODUCeUrysBpDKtBzg&oe=6AA40B27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBfyhivJhXwQ7kNvwFXnJox&_nc_oc=AdoIhzFg51BoQxq4yFGWEPunp9PZCb1sRkovbE-UnRlpCoBmlHFV1an9tlkxiS6zKaw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI-HlIeoqUzD8KoF_o54oxk6GHP40NjV4oe5DZZcO7bw&oe=6AA423E5"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-2.oculus
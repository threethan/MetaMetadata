O5GtXegM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyB2sBDUoZu0P98F8m7kH3oR5NfYZ5y4VT_JveouAQJQ&oe=6A9AC429"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVBOvZ1VeCUQ7kNvwFXnsj0&_nc_oc=Adq-7A7lOfdoLzUTIv81r0tIoTxo6eFirarH1fZHqr3gRtA5RMGcNkc2NLaEtQ0ROAM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeiprjGEnN2_FQf1dwFaSlgwTOlvr7NCGws4TOfEIh5g&oe=6A9AD0A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gR7w-BIjb_cQ7kNvwE0lmZk&_nc_oc=AdoS714wRqpL4tj8ZDfvRpDIrtjWfvkPU7g9-saCmTZ9t4NYkjYtytWtpmv8HoeTO2s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6FlZr4dJbbOgvZl1ni5Skg1p-_Qo6kcQEYnM8Gb8b6g&oe=6A9AE965"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.
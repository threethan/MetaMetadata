MNUsR8wg&oe=6A858D4E"}, {"file_name": "migrated_image.png", "id": "208731883684291", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982543_579262379266611_5423918394854342656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPnjKeFqPfAQ7kNvwEtKhAA&_nc_oc=Adori11nGFUKZGKQ-MDk0JCrUQksy06Sprtu-ciNjP_FuyVL6S95BZzg4LV06UIAUY8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVSfXUQw1lpg_833DXmw7gaStkrg5oWLveLkWVb-SBaA&oe=6A8591EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": ["Honigbiene", "Bienen", "Bienenstock", "Insekten", "Imker"], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \n\nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \n\nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.swr.de/datenschutz", "developer_terms_of_service_url": null, "publisher_name": "S\u00fcdwestrundfunk", "support_website_url": null, "website_url": "https://www.planet-schule.de/sf/multimedia-interaktive-animationen-detail.php?projekt=honigbiene-vr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, 
eSA1CyLk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi980EVF9SljzL85Mo8Hx56L25GkQ_83GMs1f_JqzydQ&oe=6AF9E869"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efuuRhJ4DfsQ7kNvwEhI59v&_nc_oc=Ado1YJ2JGXWPfkEYsyJJ8u7wGfwp4J8ERALAoplKpvmW-DkagcbzwxGnMvAmdvQxJG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZE7gNoto6qqTQGUqEnXFIx9jJMlQtGakGrcsjpsc2VA&oe=6AF9BCA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4JG3NuDaX8Q7kNvwGoOuut&_nc_oc=AdrXliuWqptEWn5s_s9uYjE3M3DcR0am_cWyl4mPwtVo_f_RXzR6368KpI5taXjKuUM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA3BaG9hDhZTWMDEcuNovW3B-WW4Hx4RM5IMMnDGzeMg&oe=6AF9D565"}, {"file_name": "Cover Mini.png", "id": "1214340978990180", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.
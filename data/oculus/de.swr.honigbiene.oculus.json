l3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbN-ZnhlRRCJjQbSm2zKYEXNc8Zl0oHOW1a2fT67BJRg&oe=6A71E401"}, {"file_name": "Screenshot Oculus-5.png", "id": "318958459959530", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982489_318958466626196_2941193193162895986_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0-46MJDQqkQ7kNvwEMHSim&_nc_oc=AdrctAmzBxMrqt9qGLnQ8JqgLZRRJgcs66k1PGms7EBYPf7G1Z9v_I1uMXRjCd4u8Zk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSCAwCtURGgJw8CXzclBFmTYFGRCy274Snr7c7cEg3Cg&oe=6A71FE59"}, {"file_name": "Screenshot Oculus-1.png", "id": "250337703599320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031617_250337706932653_170814685682016706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXxmGP0RenkQ7kNvwF0V2oF&_nc_oc=AdonWEBqJwKGXKtq3ymryxfXEX9CZ74qVNRvKRMjmeuJgP5VFSSGW-2OsAdWnU2aESQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG68Qy95S3I1OYpb1RNMpSkP_v94-787-Yxesn3e_9G7g&oe=6A71E494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honigbiene VR", "keywords": [], "long_description": "Los geht es auf einer Blumenwiese. Sieh dich um und nimm dir etwas Zeit \u2013 es gibt viel zu entdecken! \nAchte auf die gro\u00dfen wei\u00dfen Kreise. Sie bringen dich zu einem weiteren Schauplatz. Die kleinen wei\u00dfen Kreise starten ein Szenario. \nBlickst du nach unten, kannst du das Men\u00fc starten. Hier kann ein Info-Modus aktiviert werden, der dir w\u00e4hrend der Erkundungstour weitere Informationen gibt.", "short_description": "Mit Honigbiene VR betrittst du das Innere eines Bienenstocks und erlebst die Welt der Bienen zum Greifen nah. Du begleitest die Stockbewohner bei der Nahrungssuche, erkundest die Waben, bist bei der Brutpflege dabei und erlebst, wie die Bienen sich gegen Eindringlinge zur Wehr setzen."}]}, "developer_name": "STEP-ANI-MOTION GmbH", "developer_privacy_policy_url": "https://www.planet-schule.de/sf/datenschutz.php", "developer_terms_of
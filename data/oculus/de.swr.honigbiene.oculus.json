t Oculus-2.png", "id": "226562636019062", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984464_226562639352395_1967606249256931752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5SFN93rLggQ7kNvwFh2slc&_nc_oc=AdoDs3jhLmRyNxRb38_SQJX5KTtI89xtWr21yWBBWPBJb6uMB6tj0UBZLSkEtlQx7MU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdrD75_GWUTn_kUkcC2AiZajWsIIVWuyG3PV8KGN8Zhg&oe=6AFB39E9"}, {"file_name": "Screenshot Oculus-3.png", "id": "198645888944422", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031323_198645895611088_2828208261402888010_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efuuRhJ4DfsQ7kNvwGV1NdQ&_nc_oc=AdoivJ_-zJl_nSrD26nLaYEeQHc2EWVmt0fsYgLo2n4EOw7Lb332hGwIcFO7uXk-FIA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI79UGIiF3AqzAPeU4vP_1HrSwFffZfjkRmWBmdosbTg&oe=6AFB4667"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Honeybee VR", "keywords": [], "long_description": "We start on a flower meadow. Look around and take some time - there is a lot to discover! \nWatch out for the big white circles. They take you to another scene. The small white circles start a scenario. \nIf you look down, you can start the menu. Here you can activate an info mode, which gives you more information during the exploration tour.", "short_description": "With Honeybee VR you enter the inside of a beehive and experience the world of bees within reach. You accompany the hive inhabitants in their search for food, explore the combs, take part in nursing behavior and experience how the bees defend themselves against intruders."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "6319611948056921", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974720_6319611954723587_1684885781948890868_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4JG3NuDaX8Q7
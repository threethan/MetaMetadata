less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeO8T3cqGWwQ7kNvwHeni6P&_nc_oc=AdpiKaV8k1pB0d5H8JBqsmI9KwwrBYKw44UzJzpGukoCeijqqJEYqBKWt8WOV7-VmqE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSATstxdQN_8H-VQFJSfIlCqG-gsYy9JzN5gYPe0QRVqw&oe=6AFB3DF2"}, {"file_name": "New Project (43).png", "id": "956639424061691", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_956639427395024_6232325729365250528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNvS1vuTPG0Q7kNvwECGs5J&_nc_oc=Adq4S8miVV_eTXyUQZ7L21aWg1NwRzqoQkToYAdyyp3ibj0yAJxl4d6bUbWttwBcXJs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP1F1qp0GPsDo6zLNUy5YQJzH9BMh7OFshJ46_J4xHKA&oe=6AFB3C7C"}, {"file_name": "New Project (45).png", "id": "2239203373566973", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604298355_2239203376900306_839184989314942732_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZZzjY2zZusQ7kNvwHO-Yd3&_nc_oc=AdpUG3tpgnHbW1TmuDB5TrJrOqsOK7EPDdF1icYsWejq_C787bR1L6pWyLjG1rMmd8k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcOTM2B8iIgSmkIotBZ6JSXxDr4y08sK16UzsNZMIQ0w&oe=6AFB32FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gc.png", "id": "1352810063712426", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622325_1352810067045759_1125287728770398782_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh0T69_D1d0Q7kNvwHDgPvO&_nc_oc=Adpv48uAhHxigEEPE-9_tlmc_K494xlP1GigprUrNl-EVxzB1PcJ4_2xtdzXM8d68Mo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWLT0opcdiOkp8Wxf0YGJDratFnzWI3CLrCIj0BKt5UQ&oe=6AFB3110"}, "display_name": "Grass Cutter VR", "keywords": ["lawn", "Mower", "grass", "cutting", "Mowing"], "long_description": "1,498 characters including paragraph breaks:\n\nStep into the fresh air and transform overgrown yards into picture-perfect gardens in Grass Cutter VR, a cozy and satisfying lawn-care adventure made for VR.\n\nTake on a 30-level campaign filled with backyards, gardens, winding paths, flower beds, trees, fences, and lively details. Every job brings a new layout and challenge, from carefully trimming tight edges to clearing larger lawns while protecting flowers and garden decorations.\n\nUse a growing collection of realistically controlled machines. Start with the quiet Manual Reel Mower, upgrade to the Powered Push Mower, master the precise Backpack Brush Cutter, and take the wheel of the Ride-On Mower. Grab handles naturally, guide each machine through the lawn, steer, accelerate, brake, and feel every successful cut through responsive audio, particles, and controller feedback.\n\nComplete objectives, improve your score, earn stars and rewards, and use your currency to unlock equipment in the shop. Choose the right tool for each garden and build your perfect grass-cutting collection. Your campaign progress, rewards, unlocked levels, and owned machines are saved as you play.\n\nWith relaxing music, gentle outdoor ambience, cozy visuals, and satisfyingly reactive grass, Grass Cutter VR turns everyday yard work into an enjoyable escape. Whether you chase a perfect result or simply enjoy the rhythm of mowing, every lawn is a fresh opportunity to create something beautiful.\n\nStart the engine", "short_description": "Transform overgrown yards into beautiful gardens! Master realistic mowing tools, complete 30 satisfying challenges, unlock powerful machines, and enjoy the cozy calm of every perfect cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FU7HkjLMWm3I2z_iR44bHwGUzqoMdKeMGUblT5o70rs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433
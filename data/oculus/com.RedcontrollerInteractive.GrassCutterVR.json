uluscdn.com/v/t64.5771-25/499622214_956639427395024_6232325729365250528_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGVNcCnp1-0Q7kNvwHTelje&_nc_oc=AdokOUxEfopSmCvKMlczBk-Fmo0cR2szmhBDNBUXl1U2WFegGjrT0onxInbQoT-mPrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLUmcG3QyIRF81bQ3JZNxIO5gFFTcj_mGOqUcyn1Np6g&oe=6AF201FC"}, {"file_name": "New Project (45).png", "id": "2239203373566973", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604298355_2239203376900306_839184989314942732_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz5AimVk3U4Q7kNvwH5gCKf&_nc_oc=Adojxj-A8X3S566kfJsBHKIVUfn7ukRRD9YiNtboi5VbBkkjOrBtzw0Aql0Tgeqcaiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRucLj1SZ1PZQBureZB-tPWnHh0ZSoCF8bCfjQuTx-SNQ&oe=6AF1F87F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gc.png", "id": "1352810063712426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_1352810067045759_1125287728770398782_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hlMQucMdkAQ7kNvwE3ssJs&_nc_oc=Adp-5n8PQDSrUP_SL07zGLdZq6Y6g5V5ScVMZLJaa8n9Y0CY-xTJBEH44eMzZZ4_mls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGW_nyY6la8weqyz_DEhRnLQv8zVmbPGwt7GkuyGRR2g&oe=6AF1F690"}, "display_name": "Grass Cutter VR", "keywords": ["lawn", "Mower", "grass", "cutting", "Mowing"], "long_description": "1,498 characters including paragraph breaks:\n\nStep into the fresh air and transform overgrown yards into picture-perfect gardens in Grass Cutter VR, a cozy and satisfying lawn-care adventure made for VR.\n\nTake on a 30-level campaign filled with backyards, gardens, winding paths, flower beds, trees, fences, and lively details. Every job brings a new layout and challenge, from carefully trimming tight edges to clearing larger lawns while protecting flowers and garden decorations.\n\nUse a growing collection of realistically controlled machines. Start with the quiet Manual Reel Mower, upgrade to the Powered Push Mower, master the precise Backpack Brush Cutter, and take the wheel of the Ride-On Mower. Grab handles naturally, guide each machine through the lawn, steer, accelerate, brake, and feel every successful cut through responsive audio, particles, and controller feedback.\n\nComplete objectives, improve your score, earn stars and rewards, and use your currency to unlock equipment in the shop. Choose the right tool for each garden and build your perfect grass-cutting collection. Your campaign progress, rewards, unlocked levels, and owned machines are saved as you play.\n\nWith relaxing music, gentle outdoor ambience, cozy visuals, and satisfyingly reactive grass, Grass Cutter VR turns everyday yard work into an enjoyable escape. Whether you chase a perfect result or simply enjoy the rhythm of mowing, every lawn is a fresh opportunity to create something beautiful.\n\nStart the engine", "short_description": "Transform overgrown yards into beautiful gardens! Master realistic mowing tools, complete 30 satisfying challenges, unlock powerful machines, and enjoy the cozy calm of every perfect cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FU7HkjLMWm3I2z_iR44bHwGUzqoMdKeMGUblT5o70rs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
r6-2.oculuscdn.com/v/t64.5771-25/38982639_3149688088669621_3821633717754530877_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVF6mGXB93oQ7kNvwENPDNJ&_nc_oc=AdrmD7_gVpk3tWWwr5r8dx7HLvmAhxfiGzjxGcYbugAleT98xjk854Ex28QSzbzGoMo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhkOoZxHABrl0BBpDn77CCCr_c5z4X8Dr_1GWEzEJ4vg&oe=6A8ECE0D"}, "display_name": "Rat It", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
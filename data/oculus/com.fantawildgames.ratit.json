bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sBY2drLmPEQ7kNvwGKdliy&_nc_oc=AdpGcxwHkvSAYFj3QesyqN8y-NMixxy3ao_DjosPweLQhIuDzPeNMY83-znd6m9nlkM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDXHEQNeLyYDgLFAWeXdlXFffczdAN_IiZtB8jrZFi6A&oe=6B09B8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u4e3b\u5f62\u8c61\u56fe2560-1440.png", "id": "880867906766806", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974788_880867910100139_7937224826596175256_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8-wwo1Nh1cQ7kNvwGhX9OR&_nc_oc=Adr2dNm2hDYym2QOyEBzLheyssQD013N-VY23tO-p6djMaWGIjkrRZKc39hCRhFwHMA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi3ZHzp4W0Sc7oYdPhUvOOBtob6_v4tDS1vg_sItA99A&oe=6B09CB7A"}, "display_name": "Rat It", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}, {"images": {"nodes": []}, "id": "892301399187643", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u706d\u9f20\u4f20\u8bf4", "keywords": [], "long_description": "\u964c\u8def\u9003\u4ea1 \u8be1\u6d77\u8ff7\u8239\n\n\u7531\u4e8e\u638c\u63e1\u70bc\u91d1\u672f\uff0c\u4f60\u88ab\u6050\u60e7\u7684\u6751\u6c11\u8d76\u51fa\u4e86\u6751\u843d\uff0c\u5728\u5927\u6d77\u4e0a\u6f2b\u65e0\u76ee\u7684\u7684\u6d41\u7a9c\uff0c\u5728\u604d\u60da\u53ea\u4e0b\u627e\u5230\u4e86\u4e00\u8258\u505c\u6cca\u7684\u5e06\u8239\u3002\n\u7a7a\u8361\u7684\u57fa\u677f\uff0c\u65e0\u4eba\u7684\u8239\u8231\uff0c\u71c3\u70e7\u7684\u6cb9\u706f\uff0c\u5403\u5269\u7684\u98df\u7269\u2026\u2026\n\u8be1\u5f02\u7684\u6c1b\u56f4\u4e0b\uff0c\u8239\u53ea\u7a81\u7136\u9a76\u79bb\uff0c\u5c06\u6beb\u65e0\u9632\u5907\u7684\u4f60\u5e26\u5411\u4e86\u5e7d\u6697\u7684\u6df1\u6d77\u3002\n\u5982\u4eca\uff0c\u4f60\u72ec\u81ea\u4e00\u4eba\uff0c\u9664\u4e86\u60f3\u65b9\u8bbe\u6cd5\u7684\u6d3b\u4e0b\u53bb\u4e4b\u5916\uff0c\u66f4\u8981\u5728\u8239\u53ea\u505c\u9760\u524d\u963b\u6b62\u90aa\u6076\u7684\u8513\u5ef6\uff01\n\n\u00b7 \u5f39\u5f13\u5c04\u51fb\n\u914d\u5408\u7075\u5de7\u7684\u8eab\u6cd5\uff0c\u63a2\u5bfb\u5b8c\u7f8e\u7684\u53d1\u5c04\u89d2\u5ea6\uff0c\u51fb\u6740\u5f62\u6001\u5404\u5f02\u7684\u90aa\u6076\u8001\u9f20\uff01\n\n\u00b7 \u5143\u7d20\u5f39\u4e38\n\u719f\u7ec3\u64cd\u63a7\u706b\u7130\u5f39\u73e0\u3001\u9677\u9631\u5f39\u73e0\u548c\u8ffd\u8e2a\u5f39\u73e0\u5e76\u5229\u7528\u70bc\u91d1\u77e5\u8bc6\u6765\u5bf9\u5b83\u4eec\u8fdb\u884c\u5f3a\u5316\u3002\n\n\u00b7 \u5173\u5361\u8bbe\u8ba1\n\u56da\u7981\u5ba4\u3001\u6c34\u624b\u623f\u3001\u9910\u5385\u3001\u697c\u68af\u95f4\u3001\u706b\u70ae\u4ed3\u3001\u4f11\u95f2\u5ba4\u2026\u2026\u4e3e\u8d77\u624b\u4e2d\u7684\u5f39\u5f13\uff0c\u4ed4\u7ec6\u5730\u63a2\u7d22\u573a\u666f\u91cc\u7684\u6bcf\u4e00\u5904\u7ec6\u8282\uff01\n\n\u00b7 \u72e1\u733e\u654c\u4eba\n\u88ab\u90aa\u6076\u529b\u91cf\u4fb5\u8680\u540e\uff0c\u8239\u91cc\u7684\u8001\u9f20\u4eec\u5f00\u59cb\u53d8\u5f02\uff0c\u5916\u5f62\u4e0d\u4ec5\u5947\u7279\uff0c\u751a\u81f3\u8fd8\u638c\u63e1\u7740\u4e0d\u540c\u7684\u80fd\u529b\uff01\n\n\u00b7 \u73a9
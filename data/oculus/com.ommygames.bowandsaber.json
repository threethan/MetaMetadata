t=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHUbDxnuqGUQ7kNvwF68vLI&_nc_oc=AdoodqX0MiVc2e3_jmyvfvLc1E75-_-p2afevMc0WpxELF4GfBAKrrGaYyMeSixNdF8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CsZht8oZPncJn7uL7MFvFo3iG67Ei0JvFhQs0ph4A6w&oe=6A369991"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bow Saber Wave Defense", "keywords": ["bowsaber", "fireballgame", "bowcombat", "swordcombat", "highscoregame"], "long_description": "Enter Bow Saber Wave Defense \u2013 the ultimate VR combat experience! Arm yourself with a bow for long-range shots and a saber sword for close-range defense as you face endless waves of fiery enemies. Challenge yourself to set a new high score as you master the art of survival.\n\n\tIn Bow Saber Wave Defense, you\u2019ll test your skills against relentless waves of fireballs. With each wave, the pace and intensity grow, pushing your reflexes, aim, and endurance to their limits. Can you rise to the top of the global leaderboard?\n\n\tFeatures:\n\t\t\u2022\tDual-Weapon Combat: Use the bow for precision and the saber for close-up action.\n\t\u2022\tEndless Fireball Waves: Survive escalating waves and reach new high scores.\n\t\u2022\tHigh-Score Challenge: Beat your records and compete on the leaderboard.\n\t\u2022\tImmersive VR Gameplay: Feel the thrill of VR as you defend against fiery foes.\n\n\tDownload Bow Saber Wave Defense and put your VR combat skills to the test!", "short_description": "\t\u2022\tSurvive endless fireball waves with bow & saber skills. Set new high scores!\n\t\u2022\tDefend against relentless fireballs using a bow and saber in VR!\n\t\u2022\tMaster the bow and saber to defend against waves of fiery foes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ommygamesvr.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ommy Games", "support_website_url": null, "website_url": "https://ommygamesvr.blogspot.com/", "category": 
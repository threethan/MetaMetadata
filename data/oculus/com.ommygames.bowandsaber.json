hd30QV4Q7kNvwEJYeSJ&_nc_oc=Adomrhw1Vu3JvAlKpsbssiyYbiJkWATaR0Qf6kS5AO6b3QGkpZztF8YuVK1kf-U1N5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0N1pc9WdpjfEMSkFCtLYlD4VXlkDXyovbqeS_S_tNMQ&oe=6AFC93ED"}, {"file_name": "screen_2560x1440_2024-10-28_16-28-51.png", "id": "442445611813199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_442445615146532_9094481879864553355_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5O2urG6jNMQ7kNvwFlxny4&_nc_oc=Adpe7YH-QBZ1tO0vhd7w4kj_76eDeRgRL3JSKemjw57tRY1n1ryKf6vHF96zCmgr634&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuctS9fw-lH6AfDm4dgUv5Bq96b3cW4oDvzWl3pSKrIA&oe=6AFC92D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bow Saber Wave Defense", "keywords": ["bowsaber", "fireballgame", "bowcombat", "swordcombat", "highscoregame"], "long_description": "Enter Bow Saber Wave Defense \u2013 the ultimate VR combat experience! Arm yourself with a bow for long-range shots and a saber sword for close-range defense as you face endless waves of fiery enemies. Challenge yourself to set a new high score as you master the art of survival.\n\n\tIn Bow Saber Wave Defense, you\u2019ll test your skills against relentless waves of fireballs. With each wave, the pace and intensity grow, pushing your reflexes, aim, and endurance to their limits. Can you rise to the top of the global leaderboard?\n\n\tFeatures:\n\t\t\u2022\tDual-Weapon Combat: Use the bow for precision and the saber for close-up action.\n\t\u2022\tEndless Fireball Waves: Survive escalating waves and reach new high scores.\n\t\u2022\tHigh-Score Challenge: Beat your records and compete on the leaderboard.\n\t\u2022\tImmersive VR Gameplay: Feel the thrill of VR as you defend against fiery foes.\n\n\tDownload Bow Saber Wave Defense and put your VR combat skills to the test!", "short_description": "\t\u2022\tSurvive endless fireball waves with bow & saber skills. Set new 
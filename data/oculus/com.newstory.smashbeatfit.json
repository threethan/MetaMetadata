AdqMu1-hYwyLgtYN3_zEHH1iLD2xYZyxhsbDUxygztDGaNjfc6EaL4smnp1Loq-W3PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQXg0jZq3H-4RNthBj2_0nx-qb0jEEVch1r2awX0-IWA&oe=6A4BA03F"}, {"file_name": "05.png", "id": "943972938665918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673522158_943972941999251_4116356525904259089_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVdT2ZwVN5wQ7kNvwG0so5l&_nc_oc=Adpi3Zz1gGkgzMzrYv7ALlWPhDwPoJhNpe5gBlFHnJQthTwMHeC_KVaSXSsXlX-vVOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC4rq2VP6sRuojINlnA3CBWAI81BMCrGHPgnKgyfarhA&oe=6A4BCFE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "2584717145316213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_2584717148649546_5924912513038422851_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYCzilQiDK0Q7kNvwG7TQGd&_nc_oc=AdrQVkMiqNb9OFGC__R9vqf3iX6DBdb2oGS6KQg373PibsG55yI95pOqJZSPsxRRvBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmaHNcbs4ljJD6x4wKe_uNB1daBjLhTkjegHpTCOQcmg&oe=6A4BA166"}, "display_name": "Smash Beat Fit: XR Cardio Workout", "keywords": ["Rhythm", "Boxing", "Fitness", "Music", "MR"], "long_description": "# \u26a1 Punch to the Beat. Break Through a Virtual Wall!\n\nLooking for a quick, active VR experience with music, motion, and satisfying visual action?\n\nStep into a rhythm punching game where notes fly toward you from multiple directions.  \nHit them to the beat, stay focused, and watch a virtual wall in your room crack open with every punch.\n\nBeyond the opening, a different world begins to appear: scenic skies and natural landscapes waiting just beyond your room.\n\n---\n\n# \ud83d\udd25 Key Features\n\n**\ud83e\udd4a Rhythm Punching Action**\n\nPunch incoming notes in time with the music.  \nFollow the beat, react fast, and keep your body moving.\n\n**\ud83c\udfaf Multi-Directional Visual Challenges**\n\nNotes come from different angles, creating quick, active challenges built around timing, focus, and coordination.\n\n**\ud83e\uddf1 Mixed Reality Wall Break Effects**\n\nTurn your room into part of the game as a virtual wall cracks, shatters, and opens around you.\n\nLaunch notes in your targeted direction and aim for a **100% wall destruction rate!**\n\n**\ud83c\udf3f A Different World Beyond Your Room**\n\nLook through the openings and discover scenic skies and natural landscapes beyond your real space.\n\n**\u23f1\ufe0f Easy-to-Start Play Sessions**\n\nJump in quickly, play at your pace, and enjoy short bursts of active VR gameplay anytime.\n\n---\n\n# \ud83d\ude80 Ready to Break Through?\n\nPut on your headset, follow the music, and open a new view beyond your room.", "short_description": "Punch to the beat in this quick and active VR rhythm game. \nNotes fly toward you from multiple directions, and every successful hit cracks open a virtual wall in your room. \nAs the wall breaks apart, beautiful skies and natural landscapes appear beyond your space. Enjoy short, satisfying play sessions filled with music, motion, and visual impact!\u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_i
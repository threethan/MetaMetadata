_T0pwUd7Og&oe=6A8C185E"}, "display_name": "RHM Shumen - Demo", "keywords": ["Shumen", "RHM", "History", "Museum", "Pliska"], "long_description": "If you are a history fan, this is your chance to dive into the history of Shumen, Bulgaria and the surrounding region. Explore numerous, well-presented 360 rooms filled with artefacts dating back to 100-200 BC. \n\nBeing a demo version of the full \"RHM Shumen\", this app does not include the full 3D simulation scenes. If you want to experience them aswell, stay tuned for upcoming release date.", "short_description": "\"RHM Shumen - Demo\" gives you the chance to dive into the history of Bulgaria without even leaving the room."}]}, "developer_name": "Love 2 Design", "developer_privacy_policy_url": "http://love2design.org/?page_id=1600", "developer_terms_of_service_url": "http://love2design.org/?page_id=1602", "publisher_name": "Love 2 Design", "support_website_url": null, "website_url": "http://love2design.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "386012379993269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162753_330460030781177_3170622472261206016_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgWVYemgECoQ7kNvwHWeHpZ&_nc_oc=AdoNhmnJHebUFccXWycAJsLyd2K-xRI0084VbyUpTSGoSqhhg79zsDG_FDKtRwEAH78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFra8fj_HAKkAmi9MEda8ZH
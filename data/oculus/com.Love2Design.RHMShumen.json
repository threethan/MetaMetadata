5333436939829248_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxW_gXQvUtYQ7kNvwHlexwB&_nc_oc=Adou3p6BQ7VEOnNg1mNGHdB8UujFuTEfvbHJNaR7SqhqPo9Llj6UK7t6jCxfXoFvGAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YMEYM5dosCwhB2TGWzRguPGn67Qsqb1N1YNcaw2Yqqw&oe=69DA57A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRIFON_PNG.png", "id": "917553798410460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448944_917553801743793_6160548231496335360_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d35_9WbPGPkQ7kNvwGeYN9q&_nc_oc=AdrPa0ZMkHoAef0ATtS9Pptr7joTqFrtcV9IDG9pyYRXg0gC7gEJk3Fo2KDj76uP8nI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11h56XobbMl00KJ-uxADtlojJEobT3odP3yNQUpBCzCA&oe=69DA561E"}, "display_name": "RHM Shumen - Demo", "keywords": ["Shumen", "RHM", "History", "Museum", "Pliska"], "long_description": "If you are a history fan, this is your chance to dive into the history of Shumen, Bulgaria and the surrounding region. Explore numerous, well-presented 360 rooms filled with artefacts dating back to 100-200 BC. \n\nBeing a demo version of the full \"RHM Shumen\", this app does not include the full 3D simulation scenes. If you want to experience them aswell, stay tuned for upcoming release date.", "short_description": "\"RHM Shumen - Demo\" gives you the chance to dive into the history of Bulgaria without even leaving the room."}]}, "developer_name": "Love 2 Design", "developer_privacy_policy_url": "http://love2design.org/?page_id=1600", "developer_terms_of_service_url": "http://love2design.org/?page_id=1602", "publisher_name": "Love 2 Design", "support_website_url": null, "website_url": "http://love2design.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
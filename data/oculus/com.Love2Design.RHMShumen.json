5333436939829248_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XseiOWZnEQgQ7kNvwFnhD8w&_nc_oc=AdprZbKM3B1Uv9w3MyP711HKrXq44c4dg85vbnWY3xDt-xX0vRsJkqrt-MHD0Y5Vqjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDjWurBNyATnZkdo7BMNA8L09tO1t1lCeP0KOtjbrIgg&oe=6AF32722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRIFON_PNG.png", "id": "917553798410460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448944_917553801743793_6160548231496335360_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgsWm6vVIXQQ7kNvwHGjoME&_nc_oc=AdqeGgsr67bwI9yRb44G-ng2BDdCLl8sKuJq5X5c3vy1n1HXPPLEs3zVWJKbx8m5f2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdurdVPZus5qkZD8zh29RRCoGIp2NZAhPaVTrKVbjkVQ&oe=6AF3259E"}, "display_name": "RHM Shumen - Demo", "keywords": ["Shumen", "RHM", "History", "Museum", "Pliska"], "long_description": "If you are a history fan, this is your chance to dive into the history of Shumen, Bulgaria and the surrounding region. Explore numerous, well-presented 360 rooms filled with artefacts dating back to 100-200 BC. \n\nBeing a demo version of the full \"RHM Shumen\", this app does not include the full 3D simulation scenes. If you want to experience them aswell, stay tuned for upcoming release date.", "short_description": "\"RHM Shumen - Demo\" gives you the chance to dive into the history of Bulgaria without even leaving the room."}]}, "developer_name": "Love 2 Design", "developer_privacy_policy_url": "http://love2design.org/?page_id=1600", "developer_terms_of_service_url": "http://love2design.org/?page_id=1602", "publisher_name": "Love 2 Design", "support_website_url": null, "website_url": "http://love2design.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
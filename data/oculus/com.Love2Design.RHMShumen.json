5333436939829248_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OImJarPbTrcQ7kNvwGWCeta&_nc_oc=AdpYMrff_NqFQIIla3s9sVCAIEkgmn40yGTG9RgcNA4aOYs2Xjv6skKRDj33OBgfU-Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yOjxYADnCjk0KDxYTWhM1ls01q4ZOsNSIb_loFM9EWw&oe=69F60722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRIFON_PNG.png", "id": "917553798410460", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448944_917553801743793_6160548231496335360_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3mOVMmbwkIQ7kNvwHlVlbC&_nc_oc=AdqutIpgjNeTo8l1CQ5OUfNrQbUlfnj-C8LKcwUJayFK9vVnb8HcsbujrSCOznaBvwU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qSbhI66dxp_vbTV2XL23Oco02yDH4W4pzTv148h_lKQ&oe=69F6059E"}, "display_name": "RHM Shumen - Demo", "keywords": ["Shumen", "RHM", "History", "Museum", "Pliska"], "long_description": "If you are a history fan, this is your chance to dive into the history of Shumen, Bulgaria and the surrounding region. Explore numerous, well-presented 360 rooms filled with artefacts dating back to 100-200 BC. \n\nBeing a demo version of the full \"RHM Shumen\", this app does not include the full 3D simulation scenes. If you want to experience them aswell, stay tuned for upcoming release date.", "short_description": "\"RHM Shumen - Demo\" gives you the chance to dive into the history of Bulgaria without even leaving the room."}]}, "developer_name": "Love 2 Design", "developer_privacy_policy_url": "http://love2design.org/?page_id=1600", "developer_terms_of_service_url": "http://love2design.org/?page_id=1602", "publisher_name": "Love 2 Design", "support_website_url": null, "website_url": "http://love2design.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpn-7uyGqOQQ7kNvwF-vKU1&_nc_oc=Adr5ysRK36hb4ShKgmhfoc6uSkQy37EyDSfskdbo0knXKnxtEUp8o63YQRwJmW1CJAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfv49Vtv9swnBwFejh-e7Y3V4MmRvp3zYWcnUTcENiJw&oe=6A6896D4"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ehc7u_Cao8Q7kNvwFZSRGM&_nc_oc=AdoFGEVbYaR4xvN8l6G9TY_gkW89kG7q7XAWKkXF27gtZO2nz1IrLfgGWRvITprPTpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhWRG1o-PkrtSatw7YssBG6UjXlSk1RudFCK7hUeok4w&oe=6A689E6F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-HMfSNseIQQ7kNvwGmkVa7&_nc_oc=Adr0P-PSxTLjZHjgyUPrr9hiHC-oYcW8TLL_lLeuI7-ttnNU6QFGmjOXkQhC82Sr-hI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcJw1Vibh93ZlT5v_Aaw72O1NxvHK7D8RpUCeSw2gvig&oe=6A68AAC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsGXR_GTPiAQ7kNvwEOE274&_nc_oc=AdqS64VG9TVYPRl8oF6BSAOo01rAQRgvsZUoSgmLsGojE3SQuzYqmA82oZng0ap6el4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUkLdCMaFFDJTX3h5T989UQyBu-m7KN6Zw_5MGytYdwQ&oe=6A68C4FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A26VjyrhvNsQ7kNvwEhwT_R&_nc_oc=Adqf68CMMEjqg8XU8l38q-ZFYB0H4MMT5uZyKfxX6Xag5nmxTikrFHnYVr
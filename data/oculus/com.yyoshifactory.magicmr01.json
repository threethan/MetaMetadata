blE8ksY_TkbKVINRGP4MIZxHDj7iSYy1j84iqH8H7_cf0jaYFxRBj-3MY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32WC4ruqfSo17MDXzRQoLf4NgmJcdjHGxDCmI-zsr4dA&oe=69E8B554"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DItbGNanm34Q7kNvwFCti4r&_nc_oc=AdqO-p0gSNI2cq2k0vYkYfAQir6TuPohsZAUXF9K-PbCP0-srBigH5C1VMQTQDSz3Ys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aS9BYmPV3TBkWX8eJvmg6ff3wJk3ILlyi1V2XfZaWoQ&oe=69E8BCEF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvriXw2EyMgQ7kNvwHs2ano&_nc_oc=Adr9cz1HxantMlnYhcymouqY8_ZONsgqydIA3R3w9hca-BtKq6OIrLJjYUl1MGI7jEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lRW1bO9D2duHKWZ839JSnyS5UAUf3ZynqPJp7boSTtA&oe=69E8C946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8gtxX5qcygQ7kNvwEslk7G&_nc_oc=Adq4p-qRiJj1jTUvJMH8s5MbJ27IBsSnvbvK2PJvpDr0xQLCnnvp53Q4w_ryhpvA1TM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j1zb5KMjEDf09rzG9RYntwBGuo5W4eDmnmmK5RrM6MQ&oe=69E8AB3C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSpIkDPB_VEQ7kNvwG__2IU&_nc_oc=Adqcotj-QjyajrK0rMMnPoOaQg3St-NcgrFbjrGODzLzXDVyo73gLJlXSsJtx7_KdCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l_3mAjd4uN67Yuk8IlkMtw59wREFzj5CKxJBu69pCQQ&oe=
24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAI58nZKP9AQ7kNvwFLEH5-&_nc_oc=Adrwpi4ZQOdazjVlGK0W91NXbSbzf5WLeICDAXjVtuU2P_jyuGVxcATZuUObIxWcsiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzjs_BhIrUBAGWvsNHIRFvs2w6S3wxxOcT4sYD83T-MA&oe=6A4A7C94"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E17robnTIAUQ7kNvwFSpyx3&_nc_oc=Adp0m6Tb57X-DO1aQWiiaYm8mNyLpvxHJuvpOpJmltgZhbgHg9hgCwL0n9CtHcYLZ1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjTWxVJnRYxaPfC_dYnflAvfaMkQb-XuE9Nfkq0wv_mw&oe=6A4A842F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSxO6qNx06wQ7kNvwHHeq_p&_nc_oc=AdpuO-vbZb9H_TzC1q_3vU5zKQQ-D0NyTb3Z3GI6KYfdMYuA5ptqhyJ-s5z5mTyPE6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy-xWDILDu91IW51_caVtx9rZfEcANNcZ_4PGc4Ju0Ig&oe=6A4A5846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJOyQDoroyEQ7kNvwHIuttP&_nc_oc=AdrsG9RH3JCSY0tL3TX729LPfk20lINW3mYb6WwpkuOOr8uzEz0tyde3Wh_eoomE5jk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHlPEXJgknikskwxwwR2uBqS45d9Nv4JEAHip2ir9lDw&oe=6A4A727C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdo32AxD7Z8Q7kNvwEf6kdY&_nc_oc=Ado8T-jLJEIVR9N3dWqmLFy0V3Y4LTA8b1vcVhdO9vehgBUZhx6SLaGhBD
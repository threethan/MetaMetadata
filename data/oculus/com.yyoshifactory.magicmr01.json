24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2SCtvA_TUIQ7kNvwFDDqKs&_nc_oc=AdpLt71yq3kiB5c0rzYEvuvyWLCAui3qQid2Aj3CB_7uqtnFKGjpzF0NV9rjErjXakw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSze7UymlZTwU-uv5W-6tf7qWSnpRXkuIjFcjR8AWt0Q&oe=6A9C3994"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAlEZ8ebfDgQ7kNvwGFDI-9&_nc_oc=AdpsZyW8MiH2F7YKh_2eJy9yU8k-uyIYR5D-SgVm2dOmdelw19ygHC-xEsi5Oey69cg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx6FzD-rCul2gtOD6okIZ3irIMzXzUVMzC6wghtpOr9g&oe=6A9C412F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUFIIBeChzQQ7kNvwE6fxRT&_nc_oc=AdqIXkwJJVXFTC0wRuu6mdHfNba2u35S26UvIAtNIR-5Oxas7dxr8zZni3hU68C5X-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8XA2jpWjIE0nmFlotsjnOpF1T1fdW2N79kbD9wTRyww&oe=6A9C1546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fubAJk2q45kQ7kNvwEaEuqC&_nc_oc=Adpk3GJn-2pL0-ueO2UvnehdwX-W-vB3tWR9qRlScaFSQJyr-OiUuwXCqm8-ZbjL9k4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0wN4S1XldCdYqGWjzynHPimSW-u-v4clFn2Cd48pBzg&oe=6A9C2F7C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdBuMQiuVMEQ7kNvwElD5ZH&_nc_oc=AdrwGLefS1QpRKZ39g7u2BUzKIt-UCQMtPqEoo7asOUcShfSGuM7JZ7GMi
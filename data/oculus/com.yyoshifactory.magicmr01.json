AmLrc6JNz5Py3V_ShwIO808Pjvhji1-TcNMGgX8ISe47gEHrR-A39Fd64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60XlIXVzm_YeqOysLE5z-7550xNE233B66cR3OBDf5bw&oe=6A1EFB14"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbsmYthKBbYQ7kNvwF2ZnGy&_nc_oc=AdoH0b0FOlgmXgLzhC7_eYm97PTywKI-iOEn9AIZe9twrqNHtGnhNBlnsBbvNeVgdq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v8YXhRlnI0fBWcYcN0H-t3GaRnvB-8Y_OYIJK2ecxxA&oe=6A1ECA6F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7o_Mw4YbPEQ7kNvwEqE7ys&_nc_oc=Ado0mNRgQ1CZoshKkCWiXLVDUivwdozbgkSKfK7ihwERDX7BcGFBInV1zak2ryMOR30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IefqNo5Q5Mbo1S3lqBVTUfM0nT3KDNarhgOd1Z-WBZw&oe=6A1ED6C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8luqb4Dn2oQ7kNvwEvicM3&_nc_oc=AdoDurJ0-JaRp2K7Py8qMcyTAMy0jVM7fdjRPPBsNbVe6FjJGMFcuEbX1WnsVOCwIqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gx1ix_b3L4SVKCx_-D__XVfU2JneLZlw7bdurAo77Fw&oe=6A1EF0FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tc6Zqk7HBgQ7kNvwH5GEvR&_nc_oc=AdokZDZVRW85G3QeDmN5mOo2tA3u7HauVM-rFFIupNMHfHryXyBv-waXP7gHNLmjmqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i83m4qyttoz1rFBypFTxLdBMSuN3nO2kNjZrJyFt9Jw&oe=
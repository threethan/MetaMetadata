qSWT549OU7seAhGRNJ5hbq6wXcMehwM34zHwRS3Giw3ygWJo3ZuAxdU9w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88UvfOxFxD5j3Q2e6R_uuWuBB0h1uqNejwS0l3-OJXCw&oe=6A219E14"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbsmYthKBbYQ7kNvwGKbEfS&_nc_oc=AdoCtRrbh6VP6ftWtffsiPAOAnguthH0xwT-qNvGMqw54ELkS_toZBf2Y-Ky-tHENnE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sBC8IHBdM3Y8s4UVKR0W1xFaLfHmc1vE6cSMD5YJwNA&oe=6A21A5AF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPhxA6glRe0Q7kNvwEbpLWb&_nc_oc=AdoleDC1MN2nt5lqpu8H8sESfErcD9xRb8Z99qm4QvJyD7p9JT_Lv3ORZiwRYL-5JA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ShneLXPdhanTGgB7mlan6F-RI1YAsuLYrRIRcs1dUQ&oe=6A2179C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7EgAoK_urgQ7kNvwGRz5CO&_nc_oc=AdrPQf6h78sruGawVIKuRvvAMuehn_z1cL91MATyD6fUbcG-kJlBS6gJaTb5IyHAsWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9DoAbLQLyaqdvJhY4vhMD7h59BfUh3ilotHZEgSeY7A&oe=6A2193FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tc6Zqk7HBgQ7kNvwE-XaLF&_nc_oc=Adqo_RQd2VLwD4_P9VASe7Du2m8ejBYP6sxdcyR8dG5OJCWIuHtmLedptZyYIiakPqk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hYXTxMHIMslwm0HBvN9hL0FmBISo7WY9fM-mSwsuhEQ&oe=
24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THLwCjr3b04Q7kNvwGM_Yrm&_nc_oc=AdrFVDDkx6fI6gq_R-o7_eegr9e5xktiVyyBcOOOuxUoXOja_L2kJqQgDn47GW9UbAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ILxjDX5gTR_6dtsC6DYzcstVNBnn52OjNEyosBj9fA&oe=6AB00014"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb9uAraOjFAQ7kNvwFOvbfh&_nc_oc=AdpJIYKgHTCuM58rBv0WuMCGJzuG0jzmK3fQRTPYJDU9oMP9cGU65EjYf1DjhIaKPCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR6V6ZjYZwaHrtfniZzgJNG7x7_eIXrhNtX2E1uWawVg&oe=6AAFCF6F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6-mtHNRFfIQ7kNvwEYO7BP&_nc_oc=Adq_rZIji02zV4NYYi-fZKBqvxrmHMXrM7v8RKMT-pbLlCkS_VKOOzqI67A0YY9SjMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfzi7HAS45UpHM3LgHCk8BlLj4DV2wddNFm8NfI-DhjA&oe=6AAFDBC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edch3c4Qk2cQ7kNvwHXydyK&_nc_oc=Adqrczkh8xG1J0iG2UTOKcygUl4F7ASY8pxTkABp-NHPG8IJTwyKRs7eGcfuU0B3jow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs7MNRuoHUVelGlAgXniUjDOVCSVcIVqekCaDOzhU3xg&oe=6AAFF5FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8IaZzaL8bIQ7kNvwE92LZc&_nc_oc=AdqFt8RdBal5uOD6AWs4fChe3V4IGoVtQWxcG15_KUullYNfKQ2k_Mj0IY
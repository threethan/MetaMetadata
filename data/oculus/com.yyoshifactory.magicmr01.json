oabu-HzS4-0G0qnkJkCDvVC0cV1MobZwea6Or0p-CstTh1CdJr1dYaPOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4esxa9gnov9DKRRVAB7ubJWu--TPTxC4VP2LZCHP5UMg&oe=6A15C094"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLzVN0-1dIEQ7kNvwH0DYyF&_nc_oc=AdoGsKGON3iebC-Z0b-ZxO0n8rjwmn3FNM_XXz7z8F8D36ePlBoiJ4WlDIsnDWFLQuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oq-VAHQnjZoX7KGHh1qSQadk5gimYm1_ZjQszb4eD3w&oe=6A15C82F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP32CwxGSi4Q7kNvwGta2si&_nc_oc=AdranUQMg9AOpFElvsKYDc2d2kvr7mwry7KKLO4fwGp8GATqUJWd_MlOOegbFy-0X7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_lnjThpGhimxya5CbB1t8nLARe6mFA9JvaN52UZUj2A&oe=6A159C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5juVIxsmGYQ7kNvwHAPQ2O&_nc_oc=AdpzPO-ghTDRpPV6B_HTeE8AV3ySmNvgQJPAfX8Gt7uKus9ZwWF1XNKKtTxBsX_Uelo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7laO4d_j_vVC3cvZnfxANP2yBQ0nDZqCcB974g38SZtQ&oe=6A15B67C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9coYkLgmLsQ7kNvwHwlvDp&_nc_oc=AdoQlA_2ZTHoa3xSxw_jcu0WTrmWcmSVX4gluljOdZxlPJ6JleDma-_DRQhvA0MBs-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qJYeY_VcbljPHpoGp5AeZi0WL5kQvGdGzXmVG6q6EVQ&oe=
3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0c96D8HDH6GYolWDiA4lzvPB18YrbtqWvn_Ht9kJjvYg&oe=69F1EFD4"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I72dC2i1FYAQ7kNvwEGOUR7&_nc_oc=Adr9L8jRQlMPrRIv571QQmhe5aFDudGfguvIqT3YnrbfUin6M6Q3OlmlX_G70tlHiZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j4dCrh23sT7TdGdF8-u1GqBIDX7ZuTSGpbqrJG8kr7g&oe=69F1F76F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Silxskp33MgQ7kNvwHwEy0J&_nc_oc=Adq85LI-H1xlVNdMQs5sqO3ExRIBUNEWWEIYvX1Uq8XwD9gbzsn_53ZSKcFlNzvxl_E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Asp2l2MHMSNYXnPnSd5H1dRlNWVQ4VGAVQdOJ4yDOAQ&oe=69F203C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctuwO5Tvl88Q7kNvwHshBpu&_nc_oc=Adpmo3DyDSVdnZ-cXRRR6_IuDnXiWAmeZhd9EQj-fgSjgrAN3dakNZMu_ngLDpXIap8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1R486aSX3lDRHyYuOrSI6xTNOKrhWCP7Fkl4QhSBKHog&oe=69F1E5BC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Npd9C3q5dYMQ7kNvwETKdIr&_nc_oc=AdpjdcmJoxZAe994sCPfmPRJVNSUhgPc6hhjJYywVmW2tgNw9MlXLjKaoEoz2x1s6ok&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2xY-iudNLTOb1FZH2Ne5KOT-WmSFlSLGujKPjkHGMaPw&oe=69F20B78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
sUc3Uyc-OhWYTKf-Rutg1HXI1mlqQ2ciJt2cPf_hfcn6G_RJrKmAa_2eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tau3L33b9muu1ZW1OnVPUT7op7q1zagp-P807i2nEjg&oe=6A19B514"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahb4ar46T9UQ7kNvwG0zTSR&_nc_oc=AdrvklzgNYp_7DlW9yLnV6InxNuIK6Y5491Xp9kVP1V7UcXTO1Q3xcMYx-X3x6iakO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64gQDr0iVY98t3PBCZMxhy_wYB7QEGperGw2Pik9USmg&oe=6A19846F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8dAf1UHaCEQ7kNvwF0fxn_&_nc_oc=AdoD0un219IWrCG12_t1UQjNtOj3O8lJGxYPtTjm9MPaYTZc_Gex2a-IWirPsoGZsas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WUDmZF-iT06UbrjX6dtQENQqovaboA6DiYRv0bhl2pA&oe=6A1990C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfIXZ3TvyPcQ7kNvwGFbeDu&_nc_oc=Adpi3FJ6uOQ-_hGWK0ZPMyEgGZOkajltDrM2-X3nVDpjk1AzamM4gk93a9NufguBBn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UGfnDNfk56v0E1C4frQlP60r-_3apLeL06Ov8aCrkcA&oe=6A19AAFC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT43SKWAe-IQ7kNvwFcnptt&_nc_oc=Adow26rQUyyRtoXaZLtulXHLF027d5xxS038Hrqesg75IEQScrSbtkDp59QTxyRfaFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YT2J82oLivToq-TfYY5bJc2Erout4uJ0FfPfwj6JCGA&oe=
24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MqGy7DlFH4Q7kNvwFIpq4s&_nc_oc=AdoBUeUpgvgpIuY3LNnA_ZhG0nuC1tjAS-nrJVHmmY0dcZjxtweXZ5HG-LESgCx5CEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vounNJDWmDmVWjvvJNzMLMVeJIWoVDzjP7BvtT8jgHw&oe=6A283594"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-qpYbsqGqEQ7kNvwHzK77T&_nc_oc=AdotKBU6qPhB1JQ6osS5P5oNQv05jimMhKsr6X7VNwB76zRelw5fq9LUQK92siVtOAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-K9ZrgNRuzyVfaS2RJJSUrvb6_sA28r6O92gGmrw3Ig&oe=6A2804EF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3sar92SXhYQ7kNvwEZlgxH&_nc_oc=Adrx7P8pOMN4mPhlnBEVEu7n_Vld9yHqL1qy5rFe2LgeCK4Tj0fBXFg3fAj2RNWkRms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eP2rog5G26u0GFRI0lRJB8WIPqkCBhrbOB9Kd5EARrA&oe=6A281146"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knIY7-xdaxYQ7kNvwEKXJAB&_nc_oc=AdqF_X_BSdIWLiTZeGnLjkUCL7X4i2ALB10IHIIh3CB3Qse8ZzO2mZuSt6kISMIcQ44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vhP3tAkjdQmcDSwd6bXWxu2Ho8IxAlBDdyuENirw4cg&oe=6A282B7C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IlBQi8R-IgQ7kNvwHVv5RZ&_nc_oc=Adq9o7-8cAzCwg-R4BcizhNGBp6nImIe9qy2Vuh9CxOGMJPF5CUyz3hZi2
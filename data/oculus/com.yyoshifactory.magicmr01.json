24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6cD0NvQXaYQ7kNvwHXKdtB&_nc_oc=AdrnBW03WBwGsz2uYfOI7BHI_n5o_5JS72Gd0P8DBUhq8a1WNLpLpEP6vBxyd7gTpEk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMgGHYh-S7UzL_bTeS_0oGanI77p8d6NyTSDdzzoJZcw&oe=6AA17F94"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RV6IVw91DwQ7kNvwHhlNOx&_nc_oc=Adqgm6eMHxqpQ_C5CFyqD1MYeRciWBRGkZQEzA4XeEeMTcIUvC3DRscrgQhcTkCftz8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1rxJ2C_0KjnpI1cLSqziuaQ8mOsEy0aTMTTyGyI3AWg&oe=6AA14EEF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PphKeuqlz38Q7kNvwGGoAVq&_nc_oc=AdpA6QgQd0mIu53uNDgoO65IAJiZcO1gPr7ZvXmGIRuXIAdNcEXcPvZyCYH0ZGFfqP0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-dAPgSZWCJVQT1KUOdFzOOzwYS0OzhGOiYKLBSUAhRA&oe=6AA15B46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fmwk-jqg6zcQ7kNvwFUd63j&_nc_oc=Adohct9qs_ed-DmS_Y8TVdG5JmOU4AeuL3s6nkqIHO4T1mqZkpXyyL45As3YJ2QVXH0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnTGPwv3jC7moqoNlfAG9f9Mun3UN_4cIllKrPwd7oLw&oe=6AA1757C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnUdIyYkUpgQ7kNvwEbE-5_&_nc_oc=AdoZcuq2y4fRR0gw9Ov4EISKZkensVnpV08Ql-zlnM0k8_0jpuV9Cwjdau
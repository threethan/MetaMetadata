4_2324351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9Z_AS9RtAoQ7kNvwEViYFW&_nc_oc=Adrh1fmqUVb5U5G7hHjAfI3fRcDHFrbcF-c8mNh3b2AbpS6xpVqHEXhPC0wJE6UGRXg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2v54-j-AV66G4n6PI5Ydcg9VJq5geQGX1vPZec_j9Sw&oe=6A395914"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbQS2SfzZRMQ7kNvwEe2ae8&_nc_oc=AdqsUizVh4fPhVlGWNsPbPAUU8a6zWMxa6JGeMiOV319JJ1avB8owNRdTr1M-oZ7QUw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SPZ8TV6W-BX2IkkMP62a2eOkBAh_5hl7fpMvPFhzmnQ&oe=6A3960AF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVubcRh5FgsQ7kNvwFlBkEk&_nc_oc=Adpu4OZ8-brF4jaecx1uXtpkmiY9QNpwi-vKj6QJUZOOZsH-ViDRC6lMwX0D3848II0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BnPHqkYn2rqHhLe8F_L-qkfmE8b8T_pT_sSQvv63BTg&oe=6A3934C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AYKZ1QaJkoQ7kNvwH91kJI&_nc_oc=AdoQNlx6zeHhWmMY9QYvseckYzVTluIyCoO6eVOR4NshwKwef8stl-dgg7Q-S1z9h08&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FvXCJPSoQpyblxVfI_OAaRoMtVnvLyEUyvHuVR81V1A&oe=6A394EFC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INa0e7H-uawQ7kNvwFpMs3T&_nc_oc=AdqJu6XbKaqFGPiBo1oi1D0RUEigHANaESN_96oqsrsjGaK7s6S
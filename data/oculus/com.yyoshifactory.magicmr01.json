u8zdobmgioA3vXmjTjeZE2mUhLIgO4Am1vfK3qgJNtlWfxuBSLf7WSuZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GJcTFu4IOXoB5ffgsOMY_Zp7U_J_MUcZeedKd_VhBHA&oe=69FB2A54"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syqgmG7zV7AQ7kNvwGw-ymi&_nc_oc=AdrRh3ozilZm9ex-fi_yvHIG28GY_WAjJNSVbNX1Nt5xkBCNJqycpAa0O6KOSkIJojY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p1yUx3Y9H2Qsl3sfdV4mkE0JKcALdmsATK-vGVNvwsA&oe=69FB31EF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nqs6sOBQse4Q7kNvwFQfQGs&_nc_oc=AdpGyXSMLxv7W6DjQPt_D78SJnOmqY8DKsIZDCDaJ7pLiVyYRzcfhS7hhF0SbnbOAzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QyFNdoGc0WTu-fkcpzFgC_T60YCxQ44E7j4OTZ-8bHw&oe=69FB3E46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG-5anPaJOkQ7kNvwGj_V1Q&_nc_oc=AdppsdQNa-F7Z_ada-ubTvDVp-5pVuO2PojQBw0qe5Dz1eGy9CuhFaOIgxj4rZPPGYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vAHmZfgm8x-ZlVnB-LuChehgaQEp7pElE2ohr0fviZA&oe=69FB587C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6v9hBdJMeQQ7kNvwH1oiYQ&_nc_oc=Adrl3lDael_QF6ShF0M7hzJ6CLEiNGH43VvY0FiJ-Carct5Nl3RnhFhChyAAN4cYvyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nZSqoACATDjP71oy1YJFIz9DwKNkfTDskmbK--YbsGw&oe=
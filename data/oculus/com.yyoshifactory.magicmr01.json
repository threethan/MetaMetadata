VeLgii_0q8pdLMz1neXAwnRSGN5qg9JPOifuXkQdL41Gts9Jig1oWX6UA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jakiOi6bUhyIwngC7FGKGFVfjLSBtE3rFbq8t7HU0_Q&oe=6A171214"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahb4ar46T9UQ7kNvwHlAWLw&_nc_oc=AdoFopgRhtyK41U8mJev61R60Q4-1gGpcE8l1GClWq9xQQvBVkU063Py7Dk_m4g53HE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5St_0kxDy0s4yMYqRGq7tsQ69QD6Vef70cKw-mGlDh-A&oe=6A16E16F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP32CwxGSi4Q7kNvwF9F5Yc&_nc_oc=Adpo9IbuM_26OnJriFRYnkIjvt1qw1G6eeF4w5uY3MdmjqPuzjUKL7Ov7DAkx3bQa_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M1ZlALoY9DlXy-sNA8lX94WVu7-M1uswtIurjD6md-Q&oe=6A16EDC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5juVIxsmGYQ7kNvwEEGb3S&_nc_oc=Adr-kTKzYhkXE94NJCYhIuQFej331WjXllq93ov6E1UAXI6sm0eS2SSrWcbkb6BCvwY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XeMOI7I9uUlCug6M7h4DEvOYgrdoGLPON3h00JS5U1A&oe=6A1707FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT43SKWAe-IQ7kNvwFfuTrf&_nc_oc=AdqMn9wuGAkQAQ9I7l8wPZfao4XGg95BK34aKYaQAAVY31iHTLh2O8scW9BAWyCkNrc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xCm1F3KTq13icEUrJOOb_nSnKhqscoJYItSVNGYnzJQ&oe=
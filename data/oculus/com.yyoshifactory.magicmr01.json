giPBATLt8bR8oiVdc2_7V5jAUhI0U2hkuHFEdRs8H8i-Nt7AN5tOJa4T0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0A-kz8qZFLnG-Q4EYWEPKlcgSooCOot-IF_127zY_HPg&oe=69F34154"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F4MWHHafvUQ7kNvwEk8PD1&_nc_oc=Adq-VLtkRy-79ierdMyAyR89RdmMiPJDcWTAgGYbblAxuugjBrwXrwTvO3_FWUv6Ejs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af113O8VvP8trHgXruQ9EnW1grpWpZeLQDfaq1OPGQ42jQ&oe=69F348EF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Silxskp33MgQ7kNvwHR3jLk&_nc_oc=AdqEJAghp667znLP6SGd7BF_bBPEXG9SSkDKTsWhATFO7qz3UNFvnpdHNBfRlUTcHUU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1z8PdaWKJNZOn_qjvAH_07_7R0nfte0s23hJm9XOHzPg&oe=69F35546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctuwO5Tvl88Q7kNvwGznBpI&_nc_oc=AdqSgDNKNjaDfUxKLbIUb1FzP8RhDhGdv8vUiemI_x0Mwa1GDREWMprh0FbI3L83v9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16-fNC8d83_Ik19f3PxW2jxGV71YXSCbTvHCqzSytu3A&oe=69F36F7C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yFy9gwebRwQ7kNvwEJLUb7&_nc_oc=AdpLuBTM8fkdH5AnmTF44dpR7r41MRmWmoIJjlwRSK0Jv4E2AvrsVq9Ai9ez2-y9Vko&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af227XNHVgcLUPn9hh5rRXckW-73C-5yV31-QXaHY_ogyQ&oe=
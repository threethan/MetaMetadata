24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtwtWtFNeDgQ7kNvwEairnb&_nc_oc=Adp2cW37QCZ_W0-KXwRaNg-DfBfMV_Hm1kJSpsLlz47nWOcBX5iWXypUxwWNNv3-j5E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHCe4Ox8I7v8dysOi9KrwrNuDurVmbFUkZTtOXYlAMsw&oe=6A4E38D4"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYnPsun3ePwQ7kNvwELde5l&_nc_oc=AdoB-jJjF82Y5ed1Q4srBaA096QA87-hTQQdw7KWqgo6a9MtWabGZgIBS8QLDCFjnFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7TQl-FIiSgKihXThYsu0nA8ExYZK_sg18p4CjHp6iLA&oe=6A4E406F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1EDqyvrcOkQ7kNvwFfPY9A&_nc_oc=AdpaiPw47ZO3Ilq4tVDRku-RpoPfS3XHuWYoffNDUsx6zgTfRyHENwYy6C8z4ft_XWs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUvHimFyn8mZ8Tb9o3919Ut61NGzXiDvEWGHM-dnzXgQ&oe=6A4E4CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ0b3hNrXvIQ7kNvwEHqdba&_nc_oc=AdobXPfF3XhozI6mYKK2kQD2fNeSlbL7fF3Ef0Ry2fDbRuqLpV17Gnj2TFuvsGvg8MI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE17aymyYg3GBYvR3kSD1zF853ZB2DbRvE40m48hToLQ&oe=6A4E66FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWv_1wXr1wUQ7kNvwE4_u7d&_nc_oc=AdqmIFh5JkvD-lzh0677ZwzY1Pz1kfXQ0yDAEnt5Msd72Js0987NwxhQy_
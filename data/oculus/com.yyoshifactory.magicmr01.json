2AxgC1nb__xEDlJ7YuzHudlWLR9DD_YkqkpvqbNBfi-ksI70nMgAVRVuY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OykNQS0iZOmdysnbqxv7iaLGTZwSBq6F6NjozLf3p6g&oe=6A1C5814"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLZ90NAt6UoQ7kNvwGzHZMk&_nc_oc=Adq4Qn6ZCAivVkgGiZmZJEgnh_0iphfFLRh1-P1kCy06mAFhkFq4HUR2DXa9iCcQMyw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4totPbTlBke7m7zqdurnjE3ei2RKWWnq9SgVBPLFxkhA&oe=6A1C5FAF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7o_Mw4YbPEQ7kNvwFWLG72&_nc_oc=AdpiBTbeZQlh6hUyHojMuu1ERGWbWRImVJJ5-EvdQv4Zpp6jYUaLwMP9lI0jkwS1N0c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6USs6_KdrckLhM2v6UEc2VwcYe18JHRd_l10Vcp4TlOw&oe=6A1C33C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8luqb4Dn2oQ7kNvwEBfpA8&_nc_oc=Adqf-jjd0fXNNpJW-C4T6hesRDN0-36o4yafQ1Jzup1_2bXgz7ScdGXJ8Ng8d-40Z7s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U0TUybe-ma_TFTS1CPjfm5ws8LxzSuOWN8kRrPzA1LA&oe=6A1C4DFC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz8kE7PK17UQ7kNvwGLguXw&_nc_oc=Adoa7U6DAJ04RSEN5kkA33APT2qEBBRg8OC07P3_QauQsKBh2X-U5oF46Bw57fE4TLc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53qsR6KiH94E13yVhvhNDe7m60tlnIa_Oa66k9zod90w&oe=
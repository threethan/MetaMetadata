4_2324351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFgENl-B8Y8Q7kNvwElJdxA&_nc_oc=AdojC2DcxvVrORF_JxWvnrAeJAD5MBRzu1xfjRGNLp2sRIKOGfGoH6bzPbBDvSQ7gBU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zA-oakeL5BjUyKwZzQlPZ9soGCwY43X4WbqzssUMggw&oe=6A468814"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ8XiarLtlgQ7kNvwHLZ3vw&_nc_oc=Ado6lGugwhLJXHb1rPq8-Ns9TeCPFD8mnN8G9CRQxS9prHqn5QBdhvNmsTFcPI6wIQY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nrHV0C5eHd6Vfx6AELsbo-v1Q6jrxVzlKT2e76bjY4A&oe=6A468FAF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn5DsVSJeyoQ7kNvwGq46Dj&_nc_oc=Adr_ov2zXSGyzxCu9ZIrd8gpubOiKa710C0HGM4M01xiJDi9ICq1LGFsjiaP3gXzhx4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AOr22h0gZuSavCR5-WyzQx1c7y2cKCXhZeRccalJBog&oe=6A4663C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiD4jZFI8iMQ7kNvwGWWXkI&_nc_oc=AdrNa1CF32xKCUtYpnnbSAuo2Zd6iqjOVGXVK2jU0jF_l5o4_341C5NXvzvBh5UqAqY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BGcOpRmmNsOGgWYSDMyVd_q3ZLymlSXa8fXRDuqdazQ&oe=6A467DFC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIeyf4CMt4oQ7kNvwFdIxI6&_nc_oc=AdrQirVVKr1qEWGoc4Nuazr465QNdsojMbBKpVrfJsu--JA4cMm
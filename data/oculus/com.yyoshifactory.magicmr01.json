ybnfdutZyV_tkLpWpV4MfM9o1dghI3H70YQPrLEQTtaYoX8Yt5Tv0PmME&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VLjBGRmoDK99XVuLmZwzgfhtRo3XEDsiToIaeVw8Mog&oe=69E21DD4"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLqQGiGZSIIQ7kNvwEHCFcX&_nc_oc=Ado33UTqy-MZnmvtDRNaMO5yyaHjKutE636uV3R2P6tnMiee0PCRWDABgs0PtBrAa-w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S6awhcJlduLQyS0F5oSByzKUbDHa2f1P3N1-vsqT1XQ&oe=69E2256F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8hpm074gSAQ7kNvwEyPrVB&_nc_oc=AdqISulCQ15bqc7kYpRK204C6wAmPc8kXbM_IhLXxFFmab-SNlg26npzv1fyteGb2Og&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fb2iMvWh7f6JXJLD-JK5ovi7ZEDEMi4deuoo6-Zc8wA&oe=69E231C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM8ARnaITFgQ7kNvwHuD04M&_nc_oc=AdqJ0GHd2MXlJVUEegRWHfs5o0tPJBCFu_ud2_Zi8hLAdoUrgc94eKsFDhhn46U7lPg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EjSM9mgOi4kK6biEjkrzi7QlzKMbEL6d2M1__L3IU7Q&oe=69E24BFC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT5_zyETZjgQ7kNvwG5n8st&_nc_oc=AdrIlrS_v5XZxp4Ddd1eADTUrXVn5kfUbBXYoNq6J5zEnkpbEir-4qBPYd5Wn_CbQa8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fAsna40qwf0d89GXvC10ddAP-6RS6mf3VztP6PVv-zA&oe=
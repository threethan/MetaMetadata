tFmgd1K36lJTYWhJVF7wJv4sbJ3gX4as1uxu6epySMoebktnqkFxDMR6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03ZFN2BK_GuHyK5vMrwA1-twWMrn_QQvdLr6d-RC9P-Q&oe=69E4C0D4"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6qqLtgUOoUQ7kNvwET9sn5&_nc_oc=Adq9dvvH8YR39QveGio0R122n_hoEff8dp1geCybTzVaHd4kWg8Og-RYpm72hjo6H54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NQnolgruZLk0emsYAwzueRupHCSxKtZobo5o7Lriahw&oe=69E4C86F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBdftgy37RIQ7kNvwFVCPgw&_nc_oc=Adr0MXx9QJSEAR4fewIqvf1OgrTrR8_oniXo_J2CzXdAxeBZ1fTA3jU-eHDR32X1oK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y7G4mZMquVo7r0QQaqrvP26JivT1GY4OI3Yi7830t5Q&oe=69E4D4C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEbEkE4tZCUQ7kNvwHIYr9t&_nc_oc=AdqdG7OYt2OJc5ZXbjTG_D-ftmS4iHMBiIUthIBcg99Jlej1uF-2cBSpBk0D__UXPCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OML1Zik-cVrzx3kh9kM94MM1d519mbH4vhmfoF6AkSg&oe=69E4B6BC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C5aynQUgXcQ7kNvwExz-4q&_nc_oc=AdrRwNCqEA3wQY5Uk3rKGMsXpgYKwZB_JP-1IgokMaEwsLW3lDdJMlBFlO9SsHkX2EA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af268_kiF6lE2B-OydIuYERv0_2Mm3wAwMIjsrFDAq_-dA&oe=
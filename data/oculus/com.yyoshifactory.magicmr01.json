zrlA2rL-BTrzUxF7znySK0Wwokbi_Y5g8DsNSH6XKWuPh7TRBrcUL7_jU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6auXvZD1DXcP1y3WamIRRzDLNNtPFh2v2Si88DIcHpTA&oe=6A09E314"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2ARZY6bWaMQ7kNvwFsWUSC&_nc_oc=AdoX41qfWIRsKrPj-wD_IAYxSsW4kE4gfGjFzJbS7f6dKH4JS4cqBhvfRKVq2u5TTMQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65z0DqMo2zouGw1wfT4an1Sn3cUcC-Eos7wW6vrEZ86w&oe=6A09B26F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFuNDHdMgzYQ7kNvwHQckWo&_nc_oc=Ado4uSrD-zUGRWq2aYcElT0Nosq2om4oc_nrDdgbTX1BunuVm9ueOuzdlt82MPNvyiA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yQqxhMx8SAI3P3D6wiFE8b-483adp2U4yYYeLRCvm2g&oe=6A09BEC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACnDEABJI5oQ7kNvwFg7vBS&_nc_oc=AdrHMR0yFCcguIuv2cqGURruiN7rY2IXJRLifqf9AYj5rLt9KSjJcRyq-VIGP3yPlxg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pFh2inJ1RHvy6RG33qjXW7bPgZUJQpA8N8IzCO7Uivw&oe=6A09D8FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr8SWo4Q3MgQ7kNvwGVgbe6&_nc_oc=AdrUmUqcKdMYTzUh_zPVUkYhEbvVSewNPzZbSTflskbcIMGE8SIHnXtP5kUIsvA17L8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75Hi14qeCUbslUH3HFPBnKlOpscVzzTFRRM9Hr6COAbg&oe=
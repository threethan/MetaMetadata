SyEe8XvU_M-MsObzJaQ_fYGbsOuOy1Q9B_YLY-IkY7SR0DVSXCmPeJ0jY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Lx9wCJKjlTCbLu0uA4Kck0pq1D8ZwX_bM81xrtiTrOg&oe=69F735D4"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNkolSe_tjMQ7kNvwFw8kE8&_nc_oc=AdoZ5_kbUk6zRpMCykf-dUMraaM9KpsCkjnzFg00mOUdHMgSSjUtLgO3DRMD8sz5ksU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33ugyQMD3C9HqpDCBW1VNbgTVJqBCgE1MA6PYWb6xk-w&oe=69F73D6F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQvJ8R3zbCkQ7kNvwEk_rZu&_nc_oc=Adq1ONcCX-dMocphWr_Xe8IqeB43hKch5GbWClogJl7tet45nRXn0nFlcJ4zU82KlRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ADXJn5nveZpQGZzAkPn5GcZkDbJUydQifkGFbqpHPYw&oe=69F749C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FH6s9T7qAoUQ7kNvwFSNI_7&_nc_oc=Adoy7DJArmCwhTyI9zLxBrjn46hy_UwcCAP3J3kLSr867C7ZfAUD26sEBsnxjd5t7xQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pFzXSpXejiyUBSVVI09_b0MDYVbOQ5b-FpKRZsC8SDg&oe=69F763FC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uGf2uaGmp0Q7kNvwGHccM2&_nc_oc=Adqt4ILOqpaVhu3CUc4QNBLgjtf9UCwTR5jSm53JgWoablk0A6dulxeu3vZZKkf19yY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JYyyqAAwmvQ2TuT_UOWWiNbUstkcWJ2ocD3qlI5uFHw&oe=
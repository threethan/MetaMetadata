BrZANonhE4lMJzQWcWuNtIZWmK_TUwyXU9f_PEDXB9DXYVLVgPmy4Z2ck&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kgmVJFQWWIfQP9nzlN-AktX8MKH3sMaM1V2oDu12TQA&oe=6A1B0694"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLZ90NAt6UoQ7kNvwHcpoX1&_nc_oc=Adoz_Xb1ck0K4B-6SBm9k8fu_PA0t4InLUWC2CLYxtx-GleTf0RhdcBXfJfqpLolwwU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n03uEerWKqpl-fNNfTyKP-iMgelbUWoUv4K7uip-cYw&oe=6A1AD5EF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8dAf1UHaCEQ7kNvwFPb2oY&_nc_oc=AdoycipAF07UsCJiX76dCN_p08sgPGUo6C4P8m_MT4ja4Fh29e5Ox3DYRSf_htb2JEg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g90t2XPWElxMz6fcOaxgS_MuUeW-R9oeix3BQ2jkTTw&oe=6A1AE246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfIXZ3TvyPcQ7kNvwEYp_hm&_nc_oc=AdrAJ0zeYGpM7VO0JCffMsUrImyEMCwzFYlpXwK3B_thBRxGuK_v9uMvTsf0Qt7g7VI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bWHCERm7cR3mKkUAruS97jjqugS0Es6eSnrWfVPsz8w&oe=6A1AFC7C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz8kE7PK17UQ7kNvwFP5KuJ&_nc_oc=AdrbRP79_qePBE0YyEOx1GSBeQhp4Ag8mEX4BekFZJKO_HlGAnbYVA6kpNGDIJOl1CI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MRITbLlmjJRRul2Tn0TvRSgct0Feu98vGT4qszlgy4Q&oe=
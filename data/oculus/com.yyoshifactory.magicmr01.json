oPTmBUnJlIVaZQQyknhm9WeWfbaG4pkzalz05YpR9v735Ak0vDiwQd4BU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rdtj68pd4k19s0w_F7d2Nb3Wh_KhwxrjxXM2-4Jzw4w&oe=6A0F2914"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5ooG60dFNkQ7kNvwFxF72h&_nc_oc=AdrY-OBUw4ay6ajVdRl39fKojgnNG19cYTgoHoA7VM0RKT4hxjK6RJEd5Cki4Jdcp5w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fwTUFUXgEEcdhtrRRCYs-8KgXm9MaszffvfI_scwIrQ&oe=6A0EF86F"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHaPRJvKEtkQ7kNvwGTy3aU&_nc_oc=AdpPxEexj_t4CTyLZL5wzzg84-2oQ6A-oK4uUKD7QHuPPbH4fFhxkToGxxp4rn5nVo8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PiOtuHQXmM89RHuindhn4D5AqfQPJZAcL_Y2PKQBMcg&oe=6A0F04C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0LW8OkNfY4Q7kNvwHQ9rlT&_nc_oc=AdphFCkLLr1YcIr2Ya4BgQo90UmRQ3TOFJXkgtx7ArRSxKy8p_p7OkMKXdryOwbc414&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SWOPuoi6tGWaoikKcgsHHY5PJCGw_GxrAbf9HMJzHRQ&oe=6A0F1EFC"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXx6PDsT5IEQ7kNvwEbWj1_&_nc_oc=AdpTCiHyPvaEIkvAlkkqzZNCXwym5EN79jsE-chvVbdPsikhS4XMeFreTuJCYAi0LPM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lcSJ7ZWIWOEp4dq-7veq3cFWf9cdxOR2V0otc9aLasQ&oe=
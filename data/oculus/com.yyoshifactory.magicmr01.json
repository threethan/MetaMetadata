24351727975710_6297907800635549916_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wn6y0qqW_V8Q7kNvwHq822s&_nc_oc=AdoSJ3maRb9VnkpQqP0md2cbg64Y4PS4TRrc31xBNig78mZZdoX6ixH0vIGgJN-r55E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJQb6JhfCo_C-Qyv_jXCnC3GljFp1IqmJdXqJD9ltXVQ&oe=6A550894"}, {"file_name": "ScreenShot05.png", "id": "950482097394614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620432_950482100727947_7238420288318731597_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1omICJhvwAQ7kNvwF65F-E&_nc_oc=AdpYhx9hmBcjklZBC8dhxYauTz_-7e3G180WnxCaQ6JlzdZDBR77Jrrr6vt0s4Xohls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_847hJwEPuZh06qxD5ZL0I0vSKb9WJvb1I37eIefIgw&oe=6A54D7EF"}, {"file_name": "ScreenShot06.png", "id": "933010795765749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_933010799099082_7020787933658123306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAq0QZX3j7YQ7kNvwH98bOD&_nc_oc=AdqwZf8g-GgElrt_gtuswRgOGeMEiFHYVHt_Q4F0buLjOrSoPRs_Syv7u9Uram4cpXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_-TB638MFZHbiTWKdyK1TQXcrEj1l6Hc747nTIiElDg&oe=6A54E446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot06.png", "id": "814313424499393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_814313434499392_7247628378715125067_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY-h4dObtKMQ7kNvwFp9FPl&_nc_oc=Adr21XcedXb36PNlw-oD0zK3PlmBpeblGzTmGjWTYJpV813PBMZeomszaPo6As1fqYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3b5yJnfTrdma-oljBflyErK1avkYwjnNCWJjJ-HCcsg&oe=6A54FE7C"}, "display_name": "Shoot Fireball", "keywords": [], "long_description": "[Game Overview]\nStep into mixed reality and unleash powerful magic from your hands.\nShoot fireballs from your right hand and ice blasts from your left, directly into your real-world environment.\n\nEnjoy dynamic visual effects and satisfying impacts when your magic hits walls around you.\n\n[Features]\n- Hand tracking magic system (no controllers needed)\n- Fire and ice spells with immersive effects\n- Real-world interaction using MR\n- Responsive sound and impact effects\n\n[Controls]\n- Hand gestures only\n- Simple and intuitive actions:\n  - Palm up: generate magic energy\n  - Fist: charge power\n  - Open hand forward: release your spell\n\n[Recommended for]\n- MR / VR beginners\n- Anyone who wants to feel like a wizard in real life\n\n[Note]\n- This is a magic experience focused on visual effects and immersion.\n- No enemies or combat gameplay.", "short_description": "Shoot fire and ice ball in MR space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshimoto Factory", "support_website_url": null, "website_url": "https://yyoshifactory-dotcom.github.io/plivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35863305389926928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499299093_26128554256765297_7662644768374668952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF7eh3vj-Q0Q7kNvwEcXEOb&_nc_oc=Adr7yIJ_3HBK4ssFBoxlayqV4CKDnlXR6xsLtctDJA4wF2JUb4T7T7K04v
094547527028_5595567726941725862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UhUT5jxrvoQ7kNvwEC35fp&_nc_oc=AdoZN7tsw5UXc3yQ9TXY5R3AvtMpMKJaidSRoSHF1rMmsY5MLa3b8UE-HYGh3oSI1H8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBZzF9ORbxdXPlxbB-2UVbRts2v-hXPDYGejnNFr5Qaw&oe=6B09A448"}, {"file_name": "screen_shot_05.png", "id": "3989027774510469", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974842_3989027777843802_5964387981128543603_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVBpMZWyxJgQ7kNvwEl849H&_nc_oc=AdqBY6xFh7J4EeQwpeaPpAlkRhUcIQvKHm9MT0lXc3a-1e_dqgRfI1Y8nZmXZUioaWc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFajT_Y3MamUTz6l1HgjzBFDceB0h4AVnnCLq6njGUJA&oe=6B09A53D"}, {"file_name": "screen_shot_01.png", "id": "760030701335695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974693_760030704669028_6828133989724938283_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EXd2ZVGZuwQ7kNvwE8CG0S&_nc_oc=Adq_LE7kH9ZJgGmfL2qz8G5sqpvcDD6sQZVFPOoC82UHZoaioVimJHWJrIxItEDoRso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr32b7KT6yYc52iRpyqaxfa_ZanO9UYQCX0rWuOl0ssQ&oe=6B09A84C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guitar Strummer", "keywords": [], "long_description": "This is not another beat rhythm game. It's more of a guitar simulator. This is an app that lets you play chords on a virtual guitar. It functions similar to an autoharp so you can easily change chords and focus on rhythm and timing. It\u2019s not explicitly an educational tool but it will prove useful for those learning to play guitar. So impress your dog, and annoy your friends as you become a guitar strumming master. \n\n* Two ways to play chords: Traditional style open chords represented as orbs you can position and select, or go more hands on playing barre chords directly on the fretboard. \n\n* Dynamic volume control: Intuitively add emphasis by varying your strum expression. There is visual feedback to help you control your playing. \n\n* Warm and relaxing environment to play in. \n\n* Save preset chord configurations so you can quickly jump into session after starting\n\n* Tablature that you can place in the world and play along with. \n\n* Add your own custom chords and tablatur", "short_description": "A virtual guitar that you can strum the night away on. Relax and play some chords by the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/villain749/GuitarStrummer/wiki/Privacy", "developer_terms_of_service_url": null, "publisher_name": "None", "support_website_url": null, "website_url": "http://github.com/villain749/GuitarStrummer/wiki/Guitar-Strummer", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "622271275500611"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "558010695236477"}]}, "baseline_offer": {"id": "558010695236477"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1628034600, "status": "PUBLISHED", "id": "558010695236477"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4124509340942613", "version": "0.2.0"}, "id": "466382237875701", "channel_name": "LIVE"}]}, "is_for_
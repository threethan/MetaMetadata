}, {"file_name": "screen_shot_04.png", "id": "184148206919871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974729_184148210253204_2771781481172588229_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbPgsEcZZuwQ7kNvwFAxmTX&_nc_oc=Adr0dvY5oF0ukicpHvMsgwGkhLBaPp8gNUuPSxMLcqJHnuFqjrKJxeqkaDwZvK1i1hc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUcF5BavgP5fu6Ly_oFAHjOTR4PTevBuX7pZxmNtTxT3w&oe=6B0F12BC"}, {"file_name": "screen_shot_02.png", "id": "307094544193695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_307094547527028_5595567726941725862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er-4UR5QPAsQ7kNvwHYqJyH&_nc_oc=AdqWP6WlizXdlHSkzQ-LYbwyvrhaZqHtEup5ERxgn2SSBM221uimJzCLqrTt-VsTTZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtv1Hd9bCwA7asNpjWdkHUwXqjV7WjY2yYPKJNMsTZ9w&oe=6B0F2288"}, {"file_name": "screen_shot_05.png", "id": "3989027774510469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974842_3989027777843802_5964387981128543603_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04HSuWz8jBEQ7kNvwFeup0x&_nc_oc=AdpP4VuGJUpIR0WT9matdpDV2mnLxLuCDh8njHj6PZjBO36Co55KHO1dLCibqAiYqn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYdzR6QXpF7ht4aAeoQ00vdjunjKXOtTTiQODTMt94Bg&oe=6B0EEB3D"}, {"file_name": "screen_shot_01.png", "id": "760030701335695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974693_760030704669028_6828133989724938283_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRU2G8iHnDcQ7kNvwEIDOd2&_nc_oc=AdoQaREgYRiv_nvBQaNnvg59Iy-_j7PtXCrf2Bll87A77kiGQPrEh534WRe6HQTUqXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSYcBqYScXgZtnCjRtLuRnUQ4X_gC0q8Sai9kctUCebA&oe=6B0EEE4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guitar Strummer", "keywords": [], "long_description": "This is not another beat rhythm game. It's more of a guitar simulator. This is an app that lets you play chords on a virtual guitar. It functions similar to an autoharp so you can easily change chords and focus on rhythm and timing. It\u2019s not explicitly an educational tool but it will prove useful for those learning to play guitar. So impress your dog, and annoy your friends as you become a guitar strumming master. \n\n* Two ways to play chords: Traditional style open chords represented as orbs you can position and select, or go more hands on playing barre chords directly on the fretboard. \n\n* Dynamic volume control: Intuitively add emphasis by varying your strum expression. There is visual feedback to help you control your playing. \n\n* Warm and relaxing environment to play in. \n\n* Save preset chord configurations so you can quickly jump into session after starting\n\n* Tablature that you can place in the world and play along with. \n\n* Add your own custom chords and tablatur", "short_description": "A virtual guitar that you can strum the night away on. Relax and play some chords by the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/villain749/GuitarStrummer/wiki/Privacy", "developer_terms_of_service_url": null, "publisher_name": "None", "support_website_url": null, "website_url": "http://github.com/villain749/GuitarStrummer/wiki/Guitar-Strummer", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING
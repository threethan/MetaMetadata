}, {"file_name": "screen_shot_04.png", "id": "184148206919871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974729_184148210253204_2771781481172588229_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg3kHYjojtwQ7kNvwEyV0ya&_nc_oc=AdovTsP5DVl5L81lkUM3zUuumSGMIYzNFOs6moGC_jtR28SdxtHHrbDe14oenjeBeJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ53Sz_CbK8WsJCc8wwP9IQYnUPn3Qh5NlPj1PTnjHuzw&oe=6B0C6FBC"}, {"file_name": "screen_shot_02.png", "id": "307094544193695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_307094547527028_5595567726941725862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UhUT5jxrvoQ7kNvwENT4oo&_nc_oc=AdrUEsQj7ZP-9wMrrEGuKHUD8rWUW9CeANKvnQMD30PvQvBd82MtRGZw3rh0oZhJlCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSARATyuEyedzl1j-T1QcX3UBcKhJCIs8uT_-tld14vRQ&oe=6B0C7F88"}, {"file_name": "screen_shot_05.png", "id": "3989027774510469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974842_3989027777843802_5964387981128543603_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04HSuWz8jBEQ7kNvwHbHt6l&_nc_oc=AdoBtM4-_1PrYb808y_UHDsUaWDLqlhIYc08-db5sbfx93L4Ju_xUu_b_T_pH10m7fw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnRatPeQy7dmuOoWQ6TSj1xupDm8Zex_phIzMTxawwzA&oe=6B0C807D"}, {"file_name": "screen_shot_01.png", "id": "760030701335695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974693_760030704669028_6828133989724938283_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRU2G8iHnDcQ7kNvwE2NcJk&_nc_oc=AdpUKjTTxuc5lpgLN0b1HUu3xq2iGbyECjyIpMh_dwLXSOwHdUg1qr_ZynXFhont_0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSf43dOliGnNtRx8IKdBtMH3Kg8uUrrU8oTATHDo16Quw&oe=6B0C838C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guitar Strummer", "keywords": [], "long_description": "This is not another beat rhythm game. It's more of a guitar simulator. This is an app that lets you play chords on a virtual guitar. It functions similar to an autoharp so you can easily change chords and focus on rhythm and timing. It\u2019s not explicitly an educational tool but it will prove useful for those learning to play guitar. So impress your dog, and annoy your friends as you become a guitar strumming master. \n\n* Two ways to play chords: Traditional style open chords represented as orbs you can position and select, or go more hands on playing barre chords directly on the fretboard. \n\n* Dynamic volume control: Intuitively add emphasis by varying your strum expression. There is visual feedback to help you control your playing. \n\n* Warm and relaxing environment to play in. \n\n* Save preset chord configurations so you can quickly jump into session after starting\n\n* Tablature that you can place in the world and play along with. \n\n* Add your own custom chords and tablatur", "short_description": "A virtual guitar that you can strum the night away on. Relax and play some chords by the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/villain749/GuitarStrummer/wiki/Privacy", "developer_terms_of_service_url": null, "publisher_name": "None", "support_website_url": null, "website_url": "http://github.com/villain749/GuitarStrummer/wiki/Guitar-Strummer", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING
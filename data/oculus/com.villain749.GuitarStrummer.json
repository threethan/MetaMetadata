}, {"file_name": "screen_shot_04.png", "id": "184148206919871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974729_184148210253204_2771781481172588229_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDHYDR9wf_8Q7kNvwHqV4nR&_nc_oc=AdqVpxTkQiz5NrOrQ8qV9el72pl2iLGyWmOmFV7jOXQdckV3h6Os-wiL8cQo3jVmZhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1zs2Y-zkrda6c-WUAB1eDpcUfKx092nv0pyUchI8InQ&oe=6AFDB6FC"}, {"file_name": "screen_shot_02.png", "id": "307094544193695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974693_307094547527028_5595567726941725862_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHA8KxvjtVsQ7kNvwHtn15G&_nc_oc=AdoRTmBfDjU2DLadOhXtHuy-F_RDTN3wbyAN84wJqelBdESQub7XgBIjo1RE9Q_ec-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvtB8GupLqItAhV6Q3Kd5ql_uS2JnrrWOnQDiEXeLFbw&oe=6AFDC6C8"}, {"file_name": "screen_shot_05.png", "id": "3989027774510469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974842_3989027777843802_5964387981128543603_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It9Acm_W6p4Q7kNvwEqiYba&_nc_oc=AdoMQqCk6W0IJT7cbyfmYXdoQlOUab_IoEBplmtmWagXuK-JgwAF9MMO8khoFDHnIW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDH3gcUdg5X-rb_-UhRgINHofsgtVyPLKnhlGdokIw4Q&oe=6AFDC7BD"}, {"file_name": "screen_shot_01.png", "id": "760030701335695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974693_760030704669028_6828133989724938283_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=808PQ4yeatsQ7kNvwHY-f1_&_nc_oc=Adp1XbQdi9LU6mTB0GSW4LAJ3h_OYXjis3ROr1RCnRkfAg7jzF3ZEmT6vzpurRSySUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfBATHLs-ZBgw8MnnsZOetTDkIUjA-le81N58DKjXwnw&oe=6AFDCACC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guitar Strummer", "keywords": [], "long_description": "This is not another beat rhythm game. It's more of a guitar simulator. This is an app that lets you play chords on a virtual guitar. It functions similar to an autoharp so you can easily change chords and focus on rhythm and timing. It\u2019s not explicitly an educational tool but it will prove useful for those learning to play guitar. So impress your dog, and annoy your friends as you become a guitar strumming master. \n\n* Two ways to play chords: Traditional style open chords represented as orbs you can position and select, or go more hands on playing barre chords directly on the fretboard. \n\n* Dynamic volume control: Intuitively add emphasis by varying your strum expression. There is visual feedback to help you control your playing. \n\n* Warm and relaxing environment to play in. \n\n* Save preset chord configurations so you can quickly jump into session after starting\n\n* Tablature that you can place in the world and play along with. \n\n* Add your own custom chords and tablatur", "short_description": "A virtual guitar that you can strum the night away on. Relax and play some chords by the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/villain749/GuitarStrummer/wiki/Privacy", "developer_terms_of_service_url": null, "publisher_name": "None", "support_website_url": null, "website_url": "http://github.com/villain749/GuitarStrummer/wiki/Guitar-Strummer", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "622271275500611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_480112789919364_97924980990197864_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gCA9u4XTjAQ7kNvwHjv1Kh&_nc_oc=AdrGhBdjoqtuSG1yGXMViftkjUrNSR7cS0kq39ccRYanQZYvg1_fnp0-YomvBClQRfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAMkHYRN8beDzzUpmZ-auAESBOAzqKZBUp5D57dzyt4A&oe=6AFDE1E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Guitar Strummer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1628034634, "lastRevision": {"nodes": [{"id": "3835575543178698", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3872022266191323", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3718007078309926"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "LogoAppLab_transparent.png", "id": "1867963763378390", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974708_1867963766711723_1853276635367144692_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLKO9NjXJ50Q7kNvwH_SWwA&_nc_oc=AdoZ9dd1uZcBUEKbUY_temPKW40g-3NJg0N_hN0lPqeCBheTf76Gz5nNNm2wZgYPtmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2tkIyVfhMHwJ50KZ6xfkcVs1a57izTAoXL4-JaJk8cQ&oe=6AFDD2FC"}, {"file_name": "oculus_pdp.png", "id": "2856105948036422", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38
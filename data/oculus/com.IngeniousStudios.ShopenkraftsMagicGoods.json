i337&_nc_oc=AdoNIi08xmykYp3GMf9ielc9h8-l-tB8A2bx8quH3ne_Z8q7TOcXG9dVBkb64gW14Io&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iCvPl8nvbkGExP-VAtAN52opFgxNQZKSh-0gOKaJ7iQ&oe=6A368DE9"}, {"file_name": "10.png", "id": "1402519481169720", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499324941_1402519484503053_2505637613869143198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyx7j6VtU4EQ7kNvwEAMyuf&_nc_oc=AdrZTpv-nBMmOsuKrBYL_qBMwCUcEWNl8-n20Ef8C6lVttfek1eeYhMviUcu6_k9itg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YGdXJhg0uAsCzg7MY1tzG09CQdal3JR86RyA-OuyaQQ&oe=6A36B8D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "1723194648306425", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307303_1723194651639758_7252089201199330562_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKWA08zQvzIQ7kNvwGxOOtu&_nc_oc=Adpf4jMiWVjEh0I534nZW5ez6amaEePU30B-BoLH3dVRKO9OxNJdvP_NpcEr45jPHPg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C5ixRQ49wIjA6FsAgNhF4VFkh3CXsBXF6wghLb7vu8g&oe=6A36B5AC"}, "display_name": "Shopenkraft's Magic Goods", "keywords": ["Shopenkraft", "Shopenkrafts", "Magic", "Goods", "Simulation"], "long_description": "Welcome to **Shopenkraft\u2019s Magic Goods** \u2014 a VR crafting game where your customers are magical, their orders are ridiculous, and **you\u2019re the one stuck fulfilling them**.\nPotions? Sure. Axes? Of course. A glowing tiara made from a suspicious flower and a chunk of crystal? Don\u2019t ask questions.\n\nYou\u2019re the shopkeeper. You brew, forge, enchant, improvise, and occasionally panic. All in a day\u2019s work.\n\n**KEY FEATURES**\n\n- **Brew weird potions** \u2014 Grind rare flowers, spill powder, stir until it bubbles, and hope the customer doesn\u2019t turn into a frog (again).\n- **Forge legendary weapons** \u2014 Melt metal, pour it into a mold, smash it into shape, and pretend you knew what you were doing the whole time.\n- **Craft magical trinkets** \u2014 Combine the wrong ingredients and accidentally invent fashion.\n- **Play your way** \u2014 Go full chaos in Challenge Mode or relax in Cozy Mode (no timers, just vibes).\n- **Unlock stuff** \u2014 Progress through levels to upgrade your shop, discover new ingredients, and unlock even stranger recipes.\n- **Keep going** \u2014 Beat Challenge or Cozy mode to unlock Survival (how long can you last?) and Zen (how long can you chill?).\n\n\n**Your shop. Your mess. Your magical legacy.**\n\n\ud83d\udcac Join our community & send us your weirdest bugs:\n**discord.gg/nbd3vqZxEx**\n\n\n\n**GAME HIGHLIGHTS**\n{556774997233551}\n{1415900346107122}\n{668014879337549}\n{1041171590865899}", "short_description": "Brew potions, forge weapons, enchant stuff. Hope for the best."}]}, "developer_name": "Ingenious Studios", "developer_privacy_policy_url": "https://shorturl.at/UmUXt", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25335397286153396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/4918188
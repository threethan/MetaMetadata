4936836947281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e96aKF_3EW8Q7kNvwGuhNYM&_nc_oc=AdrC-8CRsq0lEVKAuB-bGwjWRu5u0M_rE-yN_nI1n7osw7VT4emOWYxN47AODWVDSQo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp967kyxHjgBua_oerEG9Lf_8RlrbUAnQ_3yVHMltkeQ&oe=69C66690"}, {"file_name": "7.png", "id": "1766376220799198", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974507_1766376230799197_337082485271967603_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlzDKOEASCYQ7kNvwF7Jila&_nc_oc=AdoAlhZWwaBCadz0aa7phGbTe0OnkxRWC6DG20ga6xW2aObXQCscQFkTkuTX6aOfc9E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlJI3dDEC6i0PjzEZ7Vz43UCzI2nNtzPsCwvszvVp8SQ&oe=69C695D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "1100539644783035", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001684_1100539651449701_2439981271815536631_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek3QXNOwDBQQ7kNvwFbHkx-&_nc_oc=Adp8agESMqIzdWO_--VrJ3YROJ-FkzO3Vlw9P_1YcSSfugRChE3wizKj5z4DYQu9rzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhMKhn3Lj8-iKhOBbDO3qnMdBC4wQxE42QUm2m8D4cUg&oe=69C68356"}, "display_name": "Shopenkraft's Magic Goods", "keywords": ["MagicCrafting", "PotionBrewing", "WeaponForging", "FantasyVr", "ShopSimulation"], "long_description": "Step into the world of **Shopenkraft's Magic Goods**, a unique VR experience that transports you to a fantastical realm. In this universe, strange monsters are vanquished by stranger heroes\u2014but behind every hero is a well-stocked magic shop. Become the go-to artisan in a cozy crafting simulation, where you'll create the perfect gear for every daring explorer.\n\nWhat Awaits You in **Shopenkraft's Magic Goods**:\n\n- Immerse yourself in a world where magic and skill come together. Use your talents to craft magical items tailored to the needs of your unusual clientele.\n- Get started easily with our new tutorial and gameplay progression, guiding you naturally as you learn the ropes and deepen your crafting expertise.\n- Progress through 10 exciting levels, unlocking new recipes and ingredients as you advance. Each level presents fresh challenges and new crafting possibilities.\n- Enjoy expanded features and content, shaped by feedback from our Alpha testers. We\u2019ve listened to your thoughts and made improvements for an even better experience!\n\n**Join Us in Early Access!** Download now and dive into our magical universe. Share your thoughts and feedback with us on Discord: https://discord.gg/QnkZjqym2t. \n\nYour journey as a master crafter begins here!", "short_description": "Shopenkraft's Magic Goods is a VR experience that lets you play the role of a magical shopkeeper!"}]}, "developer_name": "Ingenious Studios", "developer_privacy_policy_url": "https://shorturl.at/UmUXt", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8573362992783422"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "933964122653209"}, {"status": "PUBLISHED", "id": "1198398319029053"}, {"status": "PUBLISHED", "id": "25544
T", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_377975942018244_1397951637765943249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjdXXWD-EqEQ7kNvwHxDMOm&_nc_oc=Adm3UCoCZI62oYtPTSt75lYetZ9dMKjwd3o9b6u5c5uuJYOCP4tWdi2gEt87eoazat0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyw5bMf5fLLUxFKvE1m5ia4H0ztArS-F-qmXuOYm7xu1Q&oe=69B932B8"}]}, "id": "1875306759751362", "locale": "en_US", "screenshots": [{"file_name": "[3-7]3.png", "id": "674175618367199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_674175621700532_8169139035188750477_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qldNNG8kcVUQ7kNvwEdrbKQ&_nc_oc=AdnHrGPssUB5D18bjk6_ZK9iJnnvnrtrpzd1e_m7r2kqKI4OYquxOsrLE-lyuwIBz54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdGwmd5TmwrBWX3x2wwFlWIoVQs4pgb5xXEUBhNXOLGg&oe=69B9508E"}, {"file_name": "[3-7]4.png", "id": "1151230583174978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391893_1151230586508311_7939786717015308543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhQe7UGN2n0Q7kNvwHGJ3zZ&_nc_oc=AdnHLHVQ6GwzjN3bx3XenLWs2yGC941KpS5M2h2wJGCksV-51lIc-QiFcgx89vkPAGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFe_acDyw70tSnpid9FhE-oZtAD20cj_lctWvO9ZDWdQ&oe=69B93974"}, {"file_name": "9.png", "id": "1260656168806820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499321679_1260656172140153_1960819854579126765_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edzwv37bmD0Q7kNvwEL1Fg2&_nc_oc=Adk0hbQGx5PrevHdRifxgWs6_9IBLoP4Csk-LT9Zp-Ixtmg00kqTnsJimEiSwY_wzkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOwJ6f7sSu4nDSijf9vD8vCTuDVxmG06Rzg3ognGMZOQ&oe=69B934B5"}, {"file_name": "[3-7]2.png", "id": "591982036994214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391883_591982040327547_2472079098602001949_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyCTPOgvJBAQ7kNvwGJbObO&_nc_oc=AdnoIIFOowTnzYVzr3xTUP4wazHXaG47GmgGTYhKFJp6RgKTKPDpWz1JtrwzEpK0CRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVXHsAsO8KrGG21_-pyB8rAfGhcIcXTVEElo4gtVQZEw&oe=69B94F69"}, {"file_name": "10.png", "id": "1402519481169720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324941_1402519484503053_2505637613869143198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2_hL_VnLbEQ7kNvwGHljZt&_nc_oc=AdlXVwV8jrK6xnCWsuot6au74QhJV3DbXT1omem537Lyn-hgmFxSu_jkCGdwJozXVsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw26bIg5z-aB00EvEb_ft30sc2lD8bqEpgPqea8zMlbsQ&oe=69B94212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "1723194648306425", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307303_1723194651639758_7252089201199330562_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnrLjKklISMQ7kNvwEHJjLD&_nc_oc=AdmDyr7UxXW7t6aJBNJ-z2QlIIf5htj1GiDzbOYo-3TD7XU3B5uQCFJL579uaruk8O4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOmav9Z554mKlZ0M4gloD8zZ26meqzKiqd742z_2rslA&oe=69B93EEC"}, "display_name": "Shopenkraft's Magic Goods", "keywords": ["Shopenkraft", "Shopenkrafts", "Magic", "Goods", "Simulation"], "long_description": "Welcome to **Shopenkraft\u2019s Magic Goods** \u2014 a VR crafting game where your customers are magical, their orders are ridiculous, and **you\u2019re the one stuck fulfilling them**.\nPotions? Sure. Axes? Of course. A glowing tiara made from a suspicious flower and a chunk of crystal? Don\u2019t ask questions.\n\nYou\u2019re the shopkeeper. You brew, forge, enchant, improvise, and occasionally panic. All in a day\u2019s work.\n\n**KEY FEATURES**\n\n- **Brew weird potions** \u2014 Grind rare flowers, spill powder, stir until it bubbles, and hope the customer doesn\u2019t turn into a frog (again).\n- **Forge legendary weapons** \u2014 Melt metal, pour it into a mold, smash it into shape, and pretend you knew what you were doing the whole time.\n- **Craft magical trinkets** \u2014 Combine the wrong ingredients and accidentally invent fashion.\n- **Play your way** \u2014 Go full chaos in Challenge Mode or relax in Cozy Mode (no timers, just vibes).\n- **Unlock stuff** \u2014 Progress through levels to upgrade your shop, discover new ingredients, and unlock even stranger recipes.\n- **Keep going** \u2014 Beat Challenge or Cozy mode to unlock Survival (how long can you last?) and Zen (how long can you chill?).\n\n\n**Your shop. Your mess. Your magical legacy.**\n\n\ud83d\udcac Join our community & send us your weirdest bugs:\n**discord.gg/nbd3vqZxEx**\n\n\n\n**GAME HIGHLIGHTS**\n{556774997233551}\n{1415900346107122}\n{668014879337549}\n{1041171590865899}", "short_description": "Brew potions, forge weapons, enchant stuff. Hope for the best."}]}, "developer_name": "Ingenious Studios", "developer_privacy_policy_url": "https://shorturl.at/UmUXt", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25335397286153396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_1383167826594121_8403992505944360627_n.png?stp=dst-pn
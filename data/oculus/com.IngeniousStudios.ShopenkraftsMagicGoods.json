4936836947281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-L_zYL1XNcQ7kNvwFzEi46&_nc_oc=Ado6RdUzUDM2gJ_nvlDT6rvaSi0LdJf0KT8iqmjLZpG2mAsRWQ8fvdxpwaSgonTm7c8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y0B9uQcDNnAJR0D1RWdpslXD9mqs19IzRvY5Sco_Naw&oe=6A1072D0"}, {"file_name": "7.png", "id": "1766376220799198", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974507_1766376230799197_337082485271967603_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfnQTGn0IFgQ7kNvwH4e8DC&_nc_oc=AdokqiyumuRGt92krpsRTa4avISxSlnOrQW0JItKWbaNmn9i2UxUUdXbeEAGyVL5BCU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LiRovD1oJZqpiXKKjTPhia1NfxSM5MuJquxsYz9nxbg&oe=6A1069D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "1100539644783035", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001684_1100539651449701_2439981271815536631_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4uoja4dkmsQ7kNvwHdqQ0C&_nc_oc=Adqrs3T3tfIhg-HgnRIdJaSHMDz1STy2F-2hlaBQawmPCDDrhV_U9OnU_pQaHrY3XD8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nNNNE3ZMjAmfxoLNAPEcfxrmt-RMd_lVaGRqLXHUrXg&oe=6A105756"}, "display_name": "Shopenkraft's Magic Goods", "keywords": ["MagicCrafting", "PotionBrewing", "WeaponForging", "FantasyVr", "ShopSimulation"], "long_description": "Step into the world of **Shopenkraft's Magic Goods**, a unique VR experience that transports you to a fantastical realm. In this universe, strange monsters are vanquished by stranger heroes\u2014but behind every hero is a well-stocked magic shop. Become the go-to artisan in a cozy crafting simulation, where you'll create the perfect gear for every daring explorer.\n\nWhat Awaits You in **Shopenkraft's Magic Goods**:\n\n- Immerse yourself in a world where magic and skill come together. Use your talents to craft magical items tailored to the needs of your unusual clientele.\n- Get started easily with our new tutorial and gameplay progression, guiding you naturally as you learn the ropes and deepen your crafting expertise.\n- Progress through 10 exciting levels, unlocking new recipes and ingredients as you advance. Each level presents fresh challenges and new crafting possibilities.\n- Enjoy expanded features and content, shaped by feedback from our Alpha testers. We\u2019ve listened to your thoughts and made improvements for an even better experience!\n\n**Join Us in Early Access!** Download now and dive into our magical universe. Share your thoughts and feedback with us on Discord: https://discord.gg/QnkZjqym2t. \n\nYour journey as a master crafter begins here!", "short_description": "Shopenkraft's Magic Goods is a VR experience that lets you play the role of a magical shopkeeper!"}]}, "developer_name": "Ingenious Studios", "developer_privacy_policy_url": "https://shorturl.at/UmUXt", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8573362992783422"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1330829918901074"}, {"status": "PUBLISHED", "id": "793666486751833"}, {"status": "PUBLISHED", "id": "93396
_nc_oc=Adq5J9vB4lXAv0t8_56ur-cI12l95ViViJP-7dhuO3LK0dOVv_cOyNuNsKHNuJ9lsEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iPQ9fNBBux32n8kKQC236FMmSB7waAIAQk0JheQLVWQ&oe=69D25BE9"}, {"file_name": "10.png", "id": "1402519481169720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324941_1402519484503053_2505637613869143198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DPO5VA3cmUQ7kNvwFC7oIy&_nc_oc=AdrPyi_0jBi0bH4pG90hPmRqCjIOEgxodseDzJGEb1j3FNmqEX9jt47R3vmq9vaxC3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZFrGjPK-WBPfKkzq-qEayOddoMx9Z6UfxKx_mUCtJQQ&oe=69D24E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "1723194648306425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307303_1723194651639758_7252089201199330562_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thUPkBqo68cQ7kNvwHNykiM&_nc_oc=AdpdI4iKYxcYsVG0HQThuXER0PCmBHvY4-ct7FkWKdWdMNDT3CBusTREECTO8wl4wt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Gx6P99DEt_c4Tb1XEYykMPxfhbz0Z7770IWG4vP-VVQ&oe=69D24B6C"}, "display_name": "Shopenkraft's Magic Goods", "keywords": ["Shopenkraft", "Shopenkrafts", "Magic", "Goods", "Simulation"], "long_description": "Welcome to **Shopenkraft\u2019s Magic Goods** \u2014 a VR crafting game where your customers are magical, their orders are ridiculous, and **you\u2019re the one stuck fulfilling them**.\nPotions? Sure. Axes? Of course. A glowing tiara made from a suspicious flower and a chunk of crystal? Don\u2019t ask questions.\n\nYou\u2019re the shopkeeper. You brew, forge, enchant, improvise, and occasionally panic. All in a day\u2019s work.\n\n**KEY FEATURES**\n\n- **Brew weird potions** \u2014 Grind rare flowers, spill powder, stir until it bubbles, and hope the customer doesn\u2019t turn into a frog (again).\n- **Forge legendary weapons** \u2014 Melt metal, pour it into a mold, smash it into shape, and pretend you knew what you were doing the whole time.\n- **Craft magical trinkets** \u2014 Combine the wrong ingredients and accidentally invent fashion.\n- **Play your way** \u2014 Go full chaos in Challenge Mode or relax in Cozy Mode (no timers, just vibes).\n- **Unlock stuff** \u2014 Progress through levels to upgrade your shop, discover new ingredients, and unlock even stranger recipes.\n- **Keep going** \u2014 Beat Challenge or Cozy mode to unlock Survival (how long can you last?) and Zen (how long can you chill?).\n\n\n**Your shop. Your mess. Your magical legacy.**\n\n\ud83d\udcac Join our community & send us your weirdest bugs:\n**discord.gg/nbd3vqZxEx**\n\n\n\n**GAME HIGHLIGHTS**\n{556774997233551}\n{1415900346107122}\n{668014879337549}\n{1041171590865899}", "short_description": "Brew potions, forge weapons, enchant stuff. Hope for the best."}]}, "developer_name": "Ingenious Studios", "developer_privacy_policy_url": "https://shorturl.at/UmUXt", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25335397286153396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_13831
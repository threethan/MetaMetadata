", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974652_377975942018244_1397951637765943249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u2Xx83hbmIQ7kNvwGAmMdP&_nc_oc=AdkTSZ0UWN4EBfZKsEua_wIVWzjIxdxHihTEkeX-ZV6IF7bo95C4PBXIyqH81aM0I6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfudG5uVBvqG5Lg46BButHnzMXXJpfC8VxYEqT7AE-VyNw&oe=69A960B8"}]}, "id": "1875306759751362", "locale": "en_US", "screenshots": [{"file_name": "[3-7]3.png", "id": "674175618367199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_674175621700532_8169139035188750477_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU0YBaGDMAgQ7kNvwERfJbb&_nc_oc=Adlze3kHG9OjMIhZyHTlCD-qfInyFFNDHtGtDFDTpQhCgADxZoNtkKRG0IexjX5k8Dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftyaTnR_fBtZi09IhPwLl7wA4lX_HmcLzaMmko7IQYK2w&oe=69A97E8E"}, {"file_name": "[3-7]4.png", "id": "1151230583174978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_1151230586508311_7939786717015308543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyhzBMPAxdQQ7kNvwH8GDwB&_nc_oc=Adk9h2m7u8b0QQ0UWY1hH0asVEbLXfoocYTRZezmxqdkxsnwcnaSxRX00kO_EpCLm78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftMfa4r0LcG5A4emVlY4ipYvgfvVpxGKWaGFYyrsWj2pQ&oe=69A96774"}, {"file_name": "9.png", "id": "1260656168806820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499321679_1260656172140153_1960819854579126765_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYBvczm1En8Q7kNvwE0BuV9&_nc_oc=AdkPO-HntyLqDoLjtpqfwZEWvlNebMCtNk1Usk5l0tT3qxOGVP-AVw6au5xPxBPtah0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvtIisVuo7EORisd-sr3CdWT0xkZwVPU8hyEPKPm0khbQ&oe=69A962B5"}, {"file_name": "[3-7]2.png", "id": "591982036994214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_591982040327547_2472079098602001949_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=504Lxf401GkQ7kNvwE_pnag&_nc_oc=AdlVOJtlZvZ1NQPoAq09M2mWmf7WQk7K9yPCfszcP7GTuVfj82UnTsXx9RPUFSm12hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsCoDWJKVVl3zfaZ0Iq-zv_ABvFW1BWL6lRO8Hq-Igc6Q&oe=69A97D69"}, {"file_name": "10.png", "id": "1402519481169720", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324941_1402519484503053_2505637613869143198_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK_aigJ_qvEQ7kNvwEhSnrh&_nc_oc=AdlFDYNw1AL95nm1QNj-JX4jlU0vnagYXPgERrahrEsuUlUb8YGrbxe3lIveGz62CQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQeANjD8WUaVZXZAYAa2xtoU3L_D_ikp-CYXT4tFtLBQ&oe=69A97012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "1723194648306425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_1723194651639758_7252089201199330562_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iCig7-qQMYQ7kNvwE8419B&_nc_oc=Adnag6GRoAbZEIIwSJU_WBjkzTJVS9nVwihUnXGIhjFMJv3pY504A9Ings3gjh8a4lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJlGXvrIWrwtcnVhVFQsDpdJbPZXR-z-vd2yPqNxgtpA&oe=69A96CEC"}, "display_name": "Shopenkraft's Magic Goods", "keywords": ["Shopenkraft", "Shopenkrafts", "Magic", "Goods", "Simulation"], "long_description": "Welcome to **Shopenkraft\u2019s Magic Goods** \u2014 a VR crafting game where your customers are magical, their orders are ridiculous, and **you\u2019re the one stuck fulfilling them**.\nPotions? Sure. Axes? Of course. A glowing tiara made from a suspicious flower and a chunk of crystal? Don\u2019t ask questions.\n\nYou\u2019re the shopkeeper. You brew, forge, enchant, improvise, and occasionally panic. All in a day\u2019s work.\n\n**KEY FEATURES**\n\n- **Brew weird potions** \u2014 Grind rare flowers, spill powder, stir until it bubbles, and hope the customer doesn\u2019t turn into a frog (again).\n- **Forge legendary weapons** \u2014 Melt metal, pour it into a mold, smash it into shape, and pretend you knew what you were doing the whole time.\n- **Craft magical trinkets** \u2014 Combine the wrong ingredients and accidentally invent fashion.\n- **Play your way** \u2014 Go full chaos in Challenge Mode or relax in Cozy Mode (no timers, just vibes).\n- **Unlock stuff** \u2014 Progress through levels to upgrade your shop, discover new ingredients, and unlock even stranger recipes.\n- **Keep going** \u2014 Beat Challenge or Cozy mode to unlock Survival (how long can you last?) and Zen (how long can you chill?).\n\n\n**Your shop. Your mess. Your magical legacy.**\n\n\ud83d\udcac Join our community & send us your weirdest bugs:\n**discord.gg/nbd3vqZxEx**\n\n\n\n**GAME HIGHLIGHTS**\n{556774997233551}\n{1415900346107122}\n{668014879337549}\n{1041171590865899}", "short_description": "Brew potions, forge weapons, enchant stuff. Hope for the best."}]}, "developer_name": "Ingenious Studios", "developer_privacy_policy_url": "https://shorturl.at/UmUXt", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25335397286153396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818849_1383167826594121_8403992505944360627_n.png?stp=dst-png
ly enrolled in the ImmerseLearn micro-credential program as part of their required hands-on training experience.", "short_description": "Diagnosing and Replacing Contactors is a VR training application developed as part of ImmerseLearn\u2019s Diagnosing and Replacing Contactors micro-credential program. This immersive simulation provides hands-on technical training in contactor diagnostics, troubleshooting, and replacement procedures. Access is exclusively available to learners officially enrolled in the ImmerseLearn program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1610937771033028"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1001611309503366"}]}, "baseline_offer": {"id": "1001611309503366"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782891840, "status": "PUBLISHED", "id": "1001611309503366"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1622735299853275", "version": "2.0"}, "id": "1523345753155211", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
d7vbQMV_yHbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbHX6d8QSeYvF1_GS9o-t-pTtbO0QGdsb2v643sAdrCA&oe=6B09AA09"}, {"file_name": "HighresScreenshot00003.png", "id": "1548561969986257", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1548561973319590_936889388838076602_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh52vaENw5YQ7kNvwE8zscg&_nc_oc=AdonezUi_jtK4ihdEGlz6-tGooh_hT5XAZ7RSSyyNz4una5pKI_kep1kgjVU10gy0Yc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr9vDkTuv94Lidkppk2KHlnMBTBKd-_ZC4P8-OUMpORA&oe=6B09A931"}, {"file_name": "HighresScreenshot00004.png", "id": "1363702279023913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507847457_1363702282357246_2593559578760018675_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz9jU_lb8NEQ7kNvwEE6IR1&_nc_oc=Adrvta7V3vXsYpC_a9AWkkUmrfO8dxWzXt5INYWHb44A7ouwlqs-2E9PIcY7vXfSPS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSV1P022B0tuAAi2nfTJb3fDl8eLARVEkCTHqKm-LGBQ&oe=6B09B976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diagnosing and Replacing Contactors", "keywords": [], "long_description": "Diagnosing and Replacing Contactors is an immersive VR training application designed exclusively for learners enrolled in ImmerseLearn\u2019s Diagnosing and Replacing Contactors micro-credential program.\n\nThis interactive simulation allows learners to develop practical skills in identifying faulty contactors, performing diagnostic procedures, understanding electrical system safety protocols, and executing proper replacement procedures in a realistic virtual environment. The application is built to provide hands-on technical experience that reinforces course concepts through experiential learning and real-world practice.\n\nPlease note that this application is not intended for general public use. Access is restricted only to individuals officially enrolled in the ImmerseLearn micro-credential program as part of their required hands-on training experience.", "short_description": "Diagnosing and Replacing Contactors is a VR training application developed as part of ImmerseLearn\u2019s Diagnosing and Replacing Contactors micro-credential program. This immersive simulation provides hands-on technical training in contactor diagnostics, troubleshooting, and replacement procedures. Access is exclusively available to learners officially enrolled in the ImmerseLearn program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1610937771033028"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1001611309503366"}]}, "baseline_offer": {"id": "1001611309503366"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782891840, "status": "PUBLISHED", "id": "1001611309503366"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1622735299853275", "version": "2.0"}, "id": "1523345753155211", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
2318614368_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvV1Hn5qGdoQ7kNvwEa-9Om&_nc_oc=AdrO9Hb9vjKHwFyD7xjxnPbruVBY9XLe7UlWZlnjeTh84VequgSuypxbftO5VjFaYfk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaqfFYEddzF8EEELDzXnBBVY5hqjXd8MZJYhydrkExXg&oe=6A56407A"}, {"file_name": "HighresScreenshot00001.png", "id": "3442969085884332", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312470_3442969089217665_737875039254010851_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg-PnaRn6_kQ7kNvwE3dRyj&_nc_oc=Adok6ALx5L4PIazYLco_sSIjs_V3u9MSWHWiRj345THvEgMejj0COccL1G3eZ81DId4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ9kZXbb474b5p8stiSY8qE37G2OGgCzm78INi5DO8kw&oe=6A5625C9"}, {"file_name": "HighresScreenshot00003.png", "id": "1548561969986257", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314660_1548561973319590_936889388838076602_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgXjYO4Fx3gQ7kNvwHzBeeG&_nc_oc=Adrw61f5XyWEzgNy-esFWZXj92zckHr09oPOoz8qIuMVnKUyahwV8epZQqbpq2-KmpE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmqJiiL9vt_yrKFzQ4sn7DdrPKNni9DeehVyMZJBPPCw&oe=6A5624F1"}, {"file_name": "HighresScreenshot00004.png", "id": "1363702279023913", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/507847457_1363702282357246_2593559578760018675_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cD5VkipeJEQ7kNvwGTP5IR&_nc_oc=AdqwJd43ck927mnw9dK7T-o2YiNIcB5fHK3vPMQGxjaLxO0s5rWBUK1e4G2KmS0SIdU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa4Biv-wUxjJbM0EpB9Q9nQGdEgQe0peuIMsQHeVBPmw&oe=6A563536"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diagnosing and Replacing Contactors", "keywords": [], "long_description": "Diagnosing and Replacing Contactors is an immersive VR training application designed exclusively for learners enrolled in ImmerseLearn\u2019s Diagnosing and Replacing Contactors micro-credential program.\n\nThis interactive simulation allows learners to develop practical skills in identifying faulty contactors, performing diagnostic procedures, understanding electrical system safety protocols, and executing proper replacement procedures in a realistic virtual environment. The application is built to provide hands-on technical experience that reinforces course concepts through experiential learning and real-world practice.\n\nPlease note that this application is not intended for general public use. Access is restricted only to individuals officially enrolled in the ImmerseLearn micro-credential program as part of their required hands-on training experience.", "short_description": "Diagnosing and Replacing Contactors is a VR training application developed as part of ImmerseLearn\u2019s Diagnosing and Replacing Contactors micro-credential program. This immersive simulation provides hands-on technical training in contactor diagnostics, troubleshooting, and replacement procedures. Access is exclusively available to learners officially enrolled in the ImmerseLearn program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "16109377710
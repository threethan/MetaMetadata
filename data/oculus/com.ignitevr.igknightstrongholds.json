fend it from creatures raiding you for riches!\nBe a hero in VR and you'll be as fit as one in real life!\n\nIf you're interested in keeping fit and diving into a fantasy world as a hero, check out our upcoming VR game IgKnight Stongholds! \n\nIf you'd like to know more, join our discord channel @ https://discord.gg/tUBXzhYe and chat with us! Join early and be part of the development!", "short_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ignite-vr.com/privacy-policy-igknight-games/", "developer_terms_of_service_url": null, "publisher_name": "IGNITE VR PTE LTD", "support_website_url": null, "website_url": "http://ignite-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "892093668122544"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7697318503627738", "version": "1.3"}, "id": "1000845067386830", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bin
 null, "video_trailer_thumbnail": {"file_name": "IgKnightStrongholdsTrailerCover.png", "id": "1950635211774340", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982469_1950635215107673_8057776444757776832_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHaE94E2RtQQ7kNvwEX4m2e&_nc_oc=Ados6QJSNhvUitJfCS6oIRvU-2uIc9lWO7vOhp2F8O5e1CaI_DKmFR5AnuX-EvmqbNs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTauF1c_c5ozGxmHdGJdic4eOWxRZJgycGuHOMkLteMw&oe=6AFEFFD7"}, "display_name": "IgKnight Strongholds", "keywords": [], "long_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! \n\nGather resources by putting in hard work in chopping wood, mining stone etc. \nBuild your new home to live in however you like.\nEventually become a stronghold so prosperous that you'll have to defend it from creatures raiding you for riches!\nBe a hero in VR and you'll be as fit as one in real life!\n\nIf you're interested in keeping fit and diving into a fantasy world as a hero, check out our upcoming VR game IgKnight Stongholds! \n\nIf you'd like to know more, join our discord channel and chat with us! Join early and be part of the development!\n\nDiscord: https://discord.gg/J6atgX6GxS\nFollow our development: https://trello.com/b/YcOogQLg/igknight-strongholds", "short_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ignite-vr.com/privacy-policy-igknight-games/", "developer_terms_of_service_url": null, "publisher_name": "IGNITE VR PTE LTD", "support_website_url": null, "website_url": "http://ignite-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
7&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKDSL7TaNFsQ7kNvwHQJXig&_nc_oc=AdoCP2BlBYk8qA60jFlZWqAQ_apidfUBj0ejidCAEJN7JCxP25mrcXag_UYlGktlBe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVk2ZVnm7zLX6WHNaZzRMfgLZEQaMYJuXlQ10_rgOCdQ&oe=6B072117"}, "display_name": "IgKnight Strongholds", "keywords": [], "long_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! \n\nGather resources by putting in hard work in chopping wood, mining stone etc. \nBuild your new home to live in however you like.\nEventually become a stronghold so prosperous that you'll have to defend it from creatures raiding you for riches!\nBe a hero in VR and you'll be as fit as one in real life!\n\nIf you're interested in keeping fit and diving into a fantasy world as a hero, check out our upcoming VR game IgKnight Stongholds! \n\nIf you'd like to know more, join our discord channel @ https://discord.gg/tUBXzhYe and chat with us! Join early and be part of the development!", "short_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ignite-vr.com/privacy-policy-igknight-games/", "developer_terms_of_service_url": null, "publisher_name": "IGNITE VR PTE LTD", "support_website_url": null, "website_url": "http://ignite-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
3_Su4v89ugvndkEbwg2p90LWJBfa5DXmTKuf1lFzwPQ3l6CnzYYbbM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn_50g6bsto46F1cOus2TCgoqVzvdnGKoVs7ql24fOmQ&oe=6AD3B697"}, "display_name": "IgKnight Strongholds", "keywords": [], "long_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! \n\nGather resources by putting in hard work in chopping wood, mining stone etc. \nBuild your new home to live in however you like.\nEventually become a stronghold so prosperous that you'll have to defend it from creatures raiding you for riches!\nBe a hero in VR and you'll be as fit as one in real life!\n\nIf you're interested in keeping fit and diving into a fantasy world as a hero, check out our upcoming VR game IgKnight Stongholds! \n\nIf you'd like to know more, join our discord channel and chat with us! Join early and be part of the development!\n\nDiscord: https://discord.gg/J6atgX6GxS\nFollow our development: https://trello.com/b/YcOogQLg/igknight-strongholds", "short_description": "Tired of being trapped in your house due to the ravages of the plague? Why not fight back and turn your humble abode into a glorious haven! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ignite-vr.com/privacy-policy-igknight-games/", "developer_terms_of_service_url": null, "publisher_name": "IGNITE VR PTE LTD", "support_website_url": null, "website_url": "http://ignite-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
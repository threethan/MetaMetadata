L71vYXWLjQTaga6jcgtDZxWgT0uS_Ov0UbdMky3_JmzNExSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ANmfcSLWGd0o2dlaFYmeKVxy_DX8F2OKHLU2xv0qh1w&oe=69D4E479"}, {"file_name": "Deisim-Release-Screen04.png", "id": "393781039562593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_393781042895926_2451050163213863795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TkCkr1o6MIQ7kNvwHn4k7M&_nc_oc=AdqO1_uHJ7cCFBDklnBNqa1g5sno99ZfwRIMBoMDGp-zYMyn3T1-L2gcuyQR8w6pUHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09We7wdw_zgMNCFbWd1dKjo8rOiGzKk2EAEKgdXXzH3Q&oe=69D4F514"}, {"file_name": "Deisim-Release-Screen06.png", "id": "580831303746047", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974824_580831307079380_7225294319594859047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBHTR5W9EjsQ7kNvwGDsEHd&_nc_oc=Adrj2CRXiXbF30PsJtqt_iuTG_fzDs7KIf-TLp37V3Hf7zDfe-k13Hs1g2t6Ppji7Ng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KNVnU9zd4CAQHFFiRotawv2src03fiz3Q2ITkoz6Ubw&oe=69D5171D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "3258400227776005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031629_3258400231109338_6075396454888699367_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyEoUtMWb8kQ7kNvwEKDzsB&_nc_oc=AdqRN8d9HkRuww5nJx5Wu6VxgcI76HcIDIjFYgApN4eAS2zlOv5OJRiKkqzU4mpYHRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h5HDeMM2cJZ4nc2meUgM7GSGbFCMYGN5pzOhnWINRkA&oe=69D4EEBE"}, "display_name": "Deisim", "keywords": ["Deism", "God", "Building", "worldbox", "civilization"], "long_description": "Live the experience of being an omnipotent god and decide the fate of mankind.\n\nIn this sandbox game you can build your own world from scratch and guide humanity from stone age to modern era and beyond!\n\nPerform miracles to help humanity prosper or hinder them by causing disasters!\n\nYou can do anything you dream of in Deisim. You are in charge and no one will judge your actions!", "short_description": "Live the experience of being an omnipotent god. Create your own world and guide humanity from stone age to modern era and beyond."}, {"images": {"nodes": []}, "id": "1971401247060067", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deisim", "keywords": ["deism", "god"], "long_description": "Lebe die Erfahrung, ein allm\u00e4chtiger Gott zu sein und entscheide \u00fcber das Schicksal der Menschheit.\n\nIn diesem Sandbox-Spiel k\u00f6nnen Sie Ihre eigene Welt von Grund auf neu aufbauen und die Menschheit von der Steinzeit bis zur Neuzeit und dar\u00fcber hinaus f\u00fchren!\n\nVollbringen Sie Wunder, um der Menschheit zu helfen, zu gedeihen, oder behindern Sie sie, indem Sie Katastrophen verursachen!\n\nIn Deisim k\u00f6nnen Sie alles tun, wovon Sie tr\u00e4umen. Sie sind verantwortlich und niemand wird Ihre Handlungen beurteilen!", "short_description": "Lebe die Erfahrung, ein allm\u00e4chtiger Gott zu sein. Erschaffe deine eigene Welt und f\u00fchre die Menschheit von der Steinzeit bis zur Neuzeit und dar\u00fcber hinaus."}, {"images": {"nodes": []}, "id": "1584672422621375", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deisim", "keywords": ["deism", "god"], "long_description": "Ervaar een almachtige god te zijn en bepaal het lot van de mensheid.\n\nIn dit sandbox-spel kun je je eigen wereld helemaal opnieuw bouwen en de mensheid begeleiden van het stenen tijdperk naar het moderne tijdperk en zelfs daarna!\n\nDoe mirakles om de mensheid te helpen of verhinder ze door rampen te veroorzaken!\n\nJe kunt alles doen waar je van droomt in Deisim. Jij hebt volle controle en niemand zal je acties beoordelen!", "short_description": "Ervaar hoe het is om een almachtige god te zijn. Cre\u00eber je eigen wereld en help de mensheid van het stenen tijdperk naar het moderne tijdperk en zelfs daarna."}, {"images": {"nodes": []}, "id": "1573063480573015", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deisim", "keywords": ["deism", "god"], "long_description": "Vivi l'esperienza di essere un dio onnipotente e decidi il destino dell'umanit\u00e0.\n\nIn questo gioco sandbox puoi costruire il tuo mondo da zero e guidare l'umanit\u00e0 dall'et\u00e0 della pietra all'era moderna e oltre!\n\nFai miracoli per aiutare l'umanit\u00e0 a prosperare o ostacolarla provocando disastri!\n\nPuoi fare tutto ci\u00f2 che sogni a Deisim. Sei tu al comando e nessuno giudicher\u00e0 le tue azioni!", "short_description": "Vivi l'esperienza di essere un dio onnipotente. Crea il tuo mondo e guida l'umanit\u00e0 dall'et\u00e0 della pietra all'era moderna e oltre."}, {"images": {"nodes": []}, "id": "1557003458909216", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deisim", "keywords": ["deism", "god"], "long_description": "Vive la experiencia de ser un dios omnipotente y decide el destino de la humanidad.\n\n\u00a1En este juego de caja de arena puedes construir tu propio mundo desde cero y guiar a la humanidad desde la edad de piedra hasta la era moderna y m\u00e1s all\u00e1!\n\n\u00a1Haz milagros para ayudar a la humanidad a prosperar u obstruyelos causando desastres!\n\nPuedes hacer todo lo que sue\u00f1as en Deisim. \u00a1T\u00fa est\u00e1s a cargo y nadie juzgar\u00e1 tus acciones!", "short_description": "Vive la experiencia de ser un dios omnipotente. Crea tu propio mundo y gu\u00eda a la humanidad desde la edad de piedra hasta la era moderna y m\u00e1s all\u00e1."}, {"images": {"nodes": []}, "id": "1374406377776720", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deisim", "keywords": ["deism", "god", "dieu", "strat\u00e9gie"], "long_description": "Plongez vous dans la peau d'un Dieu tout puissant et d\u00e9cidez du sort de l'humanit\u00e9.\n\nDans ce jeu bac \u00e0 sable vous pouvez construire votre propre monde et guider l'humanit\u00e9 de l'\u00e2ge de pierre \u00e0 l'\u00e9poque moderne et au m\u00eame au-del\u00e0 !\n\nAccomplissez des miracles pour aider l'humanit\u00e9 a prosp\u00e9rer ou mettez leurs des b\u00e2tons dans les roues en causant des d\u00e9sastres !\n\nVous pouvez faire tout ce dont vous r\u00eavez dans Deisim. Vous \u00eates aux commandes et personne ne jugera vos actions !", "short_description": "Plongez-vous dans la peau d'un Dieu tout puissant et d\u00e9cidez du sort de l'humanit\u00e9."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myronsoftware.com/privacy/deisim-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Myron Software", "support_website_url": null, "website_url": "http://www.deisim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "nl_BE", "en", "en_AU", "pt_BR", "it", "fr", "es", "en_GB", "fr_CA", "zh_TW", "en_US", "th", "en_CA", "zh_HK", "fr_BE", "ja", "pl", "zh_CN", "en_ZA", "nl", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25870779735876507"}, "review_messages":
pename": "AndroidBinary", "id": "26304726705815139"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775078577, "id": "26319587734329036", "version": "1.56.464", "version_code": 464, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3526702020710931", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26304726705815139"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775055580, "id": "26316089228012220", "version": "1.56.463", "version_code": 463, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3526702020710931", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26304726705815139"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "153020356192380"}]}, "change_log": "# New Features                                                                                                                                        \n  - Added new animals: Sheep and Giant Snail                                                                                                            \n  - You can now give names to your saves                                                                                                                \n  - Double-click save names to quickly save or load                                                                                                     \n  - Empty save slots now display a distinct label for easier identification\n  - A small indicator after save names shows when the space cruiser has been launched\n  - Armies can now attack other continents                                                                                                              \n   \n# Balancing                                                                                                                                             \n  - Capitals now have 5 guards instead of 3\n  - Capitals now have a +2 max population bonus\n  - Capitals are now immune to meteors and alien capsule crashes\n  - Weapons have been balanced to make armies stronger than lower tech level armies at all ages\n  - Destructive disasters (Meteor, Alien Invasion) can now only happen once per hour                                                                    \n  - Disasters are now less predictable with randomized selection and variable timing\n  - Dinosaurs now take 15 minutes to die from starvation instead of 3                                                                                   \n  - Speed up early space cruiser construction stages for faster initial progress                                                                        \n   \n# Improvements                                                                                                                                        \n  - Replaced the fog system with a stable spherical fog that no longer moves with your head\n  - Increased resolution on Quest 2\n  - Various performance improvements\n\n# Bug Fixes                                                                                                                                           \n  - Fixed kingdoms sometimes failing to send armies when the map changes\n  - Fixed army formation not properly placed around the banner                                                                                          \n  - Fixed potential infinite overpopulation in capitals needing an heir\n  - Fixed airships failing to complete trades at busy airports\n  - Fixed broken grab animation\n  - Fixed missing Lumishark localization\n  - Fixed wrong font on space shuttle tooltips\n  - Fixed soldiers still fighting citizens after annexing a city\n  - Fixed soldiers still fighting when their realm made peace during the battle\n  - Fixed armies annexing a city when all the army's soldiers have been killed but are not yet decayed", "created_date": 1774971479, "id": "26304726705815139", "version": "1.55.462", "version_code": 462, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3526702020710931", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26304726705815139"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774969453, "id": "26304453135842496", "version": "1.55.461", "version_code": 461, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3526702020710931", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26304726705815139"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774961274, "id": "26303366442617832", "versio
 "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821719_1973993269846661_2703713608578848643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz7S5ST3Uv4Q7kNvwG3XsdO&_nc_oc=AdpIqDCVgvfGOC3kQAseqZ6m9GWXlsH9MDvtM9cWyHD9oG626Y-Sl30f80VLF95sKfw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHusr1JoNRn2jZiYf7a7Lyktu6GO3_hTh2B72hLEWq52A&oe=6A8D6788"}, "display_name": "IntoTheWildHunt:TheLastHunter", "keywords": [], "long_description": "Step into the heart of nature and experience a realistic VR hunting adventure. This game is not only about aiming \u2014 it focuses on observing your surroundings, positioning yourself correctly, and acting at the right moment.\n\nExplore vast natural environments, experience different locations, and improve your hunting skills. With realistic weapon handling, physics-based interactions, and immersive sound design, the game delivers a strong and believable hunting atmosphere in VR.\n\nDesigned to reward focus, patience, and skill, this experience appeals to both hunting simulation fans and players looking for a calm yet immersive VR adventure.\nEvery encounter is different, and every decision matters.\n\nKey Features:\n\nImmersive and realistic VR hunting experience\n\nExploration and environmental awareness-focused gameplay\n\nRealistic weapon and control mechanics\n\nNatural environments with atmospheric sound design\n\nTactical and patience-based gameplay\n\nIf you are looking for a respectful, balanced, and authentic VR hunting experience, this journey is for you.\n\nDo\u011fan\u0131n kalbine ad\u0131m at ve ger\u00e7ek\u00e7i bir VR avc\u0131l\u0131k deneyimi ya\u015fa. Bu oyun, oyuncuya yaln\u0131zca hedef almay\u0131 de\u011fil; \u00e7evreyi g\u00f6zlemlemeyi, do\u011fru pozisyonu almay\u0131 ve do\u011fru zamanda harekete ge\u00e7meyi \u00f6\u011fretir.\n\nGeni\u015f ve do\u011fal haritalarda ke\u015ffe \u00e7\u0131k, farkl\u0131 ortamlar\u0131 deneyimle ve avlanma becerilerini geli\u015ftir. Ger\u00e7ek\u00e7i silah mekanikleri, fizik tabanl\u0131 etkile\u015fimler ve s\u00fcr\u00fckleyici ses tasar\u0131m\u0131 sayesinde VR i\u00e7inde g\u00fc\u00e7l\u00fc bir av atmosferi sunulur.\n", "short_description": "TR:\nDo\u011faya ad\u0131m at, iz s\u00fcr ve avc\u0131l\u0131k becerilerini VR\u2019da test et.\n\nEN:\nStep into nature, track your prey, and test your hunting skills in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dodsgame.com/gizlilik-politikasi", "developer_terms_of_service_url": "https://www.dodsgame.com/hizmet-kosullari", "publisher_name": "DODs Game", "support_website_url": "https://www.dodsgame.com/gizlilik-politikasi", "website_url": "http://www.dodsgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25788247597510769"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1523089498950680"}]}, "baseline_offer": {"id": "1523089498950680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771301340, "status": "PUBLISHED", "id": "1523089498950680"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27070126522656197", "version": "6.2"}, "id": "1916646392559864", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
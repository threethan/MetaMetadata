-3.oculuscdn.com&oh=00_AfuKqphhANt3m5cpadS_HtfR7O_YgirQiv5d0JUvHp6i2w&oe=69A59783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The use of descending life line_Landscape.png", "id": "924296409342275", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86629761_924296412675608_6973496143769541780_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGStmgLoIMwQ7kNvwH3fykU&_nc_oc=Adkc5vx9TdnUEp1rf965cjHeY1Du1MMaSUNMUQzOoHWHiWqaZ0VQxUZ4ZXN7nqg-ZtY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsgf4PZGs0uzys7lmMjIxaI-eDuybRfzWtDCzXkcbgdZw&oe=69A581F8"}, "display_name": "The Use Of Descending Life Line- ContentsDa", "keywords": ["safety", "fire", "descent", "simulation", "contentsda"], "long_description": "1. Fire situation: There is a fire and you need to escape.\n2. Use the sturdy: Utilize the sturdy to escape.\n3. Install the Stubborn: Install the green hook from the Stubborn box onto the Stubborn support.\n4. Set the speeder: Set the red speeder by overlapping it on the hook.\n5. Move the Stubborn Support: Grab the Stubborn Support and move it off the railing.\n6. Throw the rope: Throw the rope wound on the black reel out the window.\n7. Manipulate the stubbornness belt: Lower the yellow stubbornness belt under your armpits and tighten it.\n8. safe descent: Hold onto the wall with your hands and descend safely without lifting your arms.\n9. successful escape: You have safely escaped and overcome the fire situation.", "short_description": "Understand the critical use of life lines in rescue operations. This experiment teaches the proper techniques for descending from heights safely."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating":
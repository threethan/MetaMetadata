gdimp5uv0E8euOsri8SuVUwgY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVDC1osQkrd75aSEoUDGZgscUPlgZQ_Ud3VB5yrpOndg&oe=6B086206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANNER-CINCO-A\u00d1OS-DESPUES_INGLES_2560x1440.png", "id": "923921839607509", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031492_923921846274175_5031904381615335114_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0kLiQgLeoMQ7kNvwHYfdlR&_nc_oc=AdoVqjoxUCQX018m9QZQBtZOhbZWrItDb1Zs5hVwwpaFYkiNVTQJYN3sBo0Z0BvAWiA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCLc0DejxEnDo2YS1wqlS9_7SVWlWXUL8FefPr5OFPvw&oe=6B084DC8"}, "display_name": "FIVE YEARS LATER", "keywords": [], "long_description": "\"Five Years Later\" is an immersive documentary (6DoF) that addresses the social issues of migration, focusing on the case of the rescue ship Aquarius. On June 17, 2018, this ship docked at the port of the city of Valencia (Spain) with 629 people on board, who were rescued from drowning in the Central Mediterranean. On June 24, 2023, the fifth anniversary of its arrival was celebrated. This immersive narrative is one of the outcomes of the research project: \"Immersive Prosocial Audiovisual Narratives: Measuring their Impact on Society and Analyzing their Formal and Technological Characteristics,\" funded by the AICO grant from the Department of Innovation, Universities, Science, and Digital Society of the Generalitat Valenciana (CIAICO/2021/258, 2022-2044). The main purpose of this project is to assess the potential of immersive technologies as a new medium for storytelling with prosocial aims.\n\n", "short_description": "\"Five Years Later\" is an immersive documentary (6DoF) that addresses the social issues of migration, focusing on the case of the rescue ship Aquarius. On June 17, 2018, this ship docked at the port of the city of Valencia (Spain) with 629 people on board, who were rescued from drowning in the Central Mediterranean. On June 24, 2023, the fifth anniversary of its arrival was celebrated. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://casoaquarius.webs.upv.es/life-stories/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fernando Canet", "support_website_url": "https://www.upv.es/legal/politica-privacidad-en.html", "website_url": "http://casoaquarius.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8883521491716785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031526_936204118564592_1252741167048568958_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Wq7mMKjR8Q7kNvwGTP5wx&_nc_oc=Adp4WqDT2IvK34W9M3WkROJO7s2F2MZqzISojNK4VpXg54yPrPiHb1688fiv_mu4OMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2a6uaIpt-85Ou3LFOgNwggTpBt3u945IrxdpKvL4pkg&oe=6B0865BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FIVE YEARS LATER", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1732814880, "lastRevision": {"nodes": [{"id": "8691369797598623", "release_type": "SCHEDULED", "administration
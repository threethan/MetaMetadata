wHBbk7-&_nc_oc=AdkX_UBrhMVw60In6cBIDz5BwW0bgziW_-lkA8263DEUoHuc_zUI0mtmccOFlwqeF3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs-KUs7gfLuMTTG8Rj0CsvL9ton1sy80RhcF9-8TFxxRQ&oe=69999488"}, "display_name": "FIVE YEARS LATER", "keywords": [], "long_description": "\"Five Years Later\" is an immersive documentary (6DoF) that addresses the social issues of migration, focusing on the case of the rescue ship Aquarius. On June 17, 2018, this ship docked at the port of the city of Valencia (Spain) with 629 people on board, who were rescued from drowning in the Central Mediterranean. On June 24, 2023, the fifth anniversary of its arrival was celebrated. This immersive narrative is one of the outcomes of the research project: \"Immersive Prosocial Audiovisual Narratives: Measuring their Impact on Society and Analyzing their Formal and Technological Characteristics,\" funded by the AICO grant from the Department of Innovation, Universities, Science, and Digital Society of the Generalitat Valenciana (CIAICO/2021/258, 2022-2044). The main purpose of this project is to assess the potential of immersive technologies as a new medium for storytelling with prosocial aims.\n\n", "short_description": "\"Five Years Later\" is an immersive documentary (6DoF) that addresses the social issues of migration, focusing on the case of the rescue ship Aquarius. On June 17, 2018, this ship docked at the port of the city of Valencia (Spain) with 629 people on board, who were rescued from drowning in the Central Mediterranean. On June 24, 2023, the fifth anniversary of its arrival was celebrated. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://casoaquarius.webs.upv.es/life-stories/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fernando Canet", "support_website_url": "https://www.upv.es/legal/politica-privacidad-en.html", "website_url": "http://casoaquarius.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_
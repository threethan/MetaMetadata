30095", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/43931336_187422477663428_4816455545352882709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXToMDBO9YYQ7kNvwHXCA_C&_nc_oc=Adqf0N6tCTB-gDuiX173u4apiBvoBPMYVM7HJKjYHkSPMYRz3rAaMknPzZL4WKui2Ww&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhdiGlOkUcdwOBrHOMBD8-1afZRg2M_RcWA-PP4hBgrA&oe=6A8D89BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cell Breaker", "keywords": [], "long_description": "Ready. Aim. Break!\n\nUse your fusion racket and a plasma ball to break color-based Cell Blocks across various game modes. Earn XP and rewards, while securing the high score amongst your friends. This fast-past arcade game will test your aim and decision-making.\n\nGame features:\n- Multiple game modes\n- XP System\n- Customization\n- Local leaderboard\n\nAll future playable DLC will be FREE, including multiplayer!", "short_description": "Ready. Aim. Break! In this futuristic Racquetball game, use your fusion racket and a plasma ball to earn XP, rewards, high scores, and, most or all, bragging rights!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kalmstudios.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kalm Studios LLC", "support_website_url": null, "website_url": "https://kalmstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAND
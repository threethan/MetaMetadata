.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z6B9WKdUeIQ7kNvwG0V1Lk&_nc_oc=Adrph82bX-c9Miz0Al27tu9aTIDmrXUCMUX-d8rEUOs2ii78udD0ydbaEvLD1Fze08s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKerg7mrH3xxH5OUO4zXi-BE9O0QDYK8HP-HxH1lOJG8Q&oe=6AA40A08"}, {"file_name": "ezgif-frame-001.png", "id": "851539284701325", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/507829691_851539288034658_2015526820441760075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9j_tNFTgCUQ7kNvwH7DmCk&_nc_oc=Adp2xZeHmiEQpYowaDWCe8hMzTy26-uPPE4j39xy-bdiVa98XJwYbARZKqUA9bnCzGU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2Mdnnr1bPxumpZBWU0hWqSAJqueFOPeSlweBwaT85Fg&oe=6AA3EC23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1786810688955279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/593784242_1786810692288612_3567132886722876177_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dBD7qkmCnMQ7kNvwFVAXM8&_nc_oc=Adr-jt-oh5XLM2KZEYAAsQzPHxJ4jMDXsDHKCz5yQwUo4JOMXFYS-mjeh1SGh-jLgDQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6ut1O2cN3gXUhNsjBJ9oYYmZ1i1KkrlIoCTaDVxmJzQ&oe=6AA420CA"}, "display_name": "Invaders!", "keywords": [], "long_description": "# Invaders!\n\nTest your reflexes and put your aim to the ultimate test in this fast-paced arcade shooter!\n\nTake on waves of alien invaders armed with a powerful futuristic weapon. Every second counts as enemies become faster and more numerous. Precision, quick reactions, and target prioritization are the keys to survival.\n\n## **Arcade Action**\n- Fast-paced gameplay inspired by classic arcade shooters.\n- Easy to learn, challenging to master.\n- Survive increasingly difficult enemy waves.\n- Chase higher scores with every run.\n\n## **Endless Alien Waves**\n- Battle against hordes of alien enemies.\n- Face escalating challenges as each wave pushes your skills further.\n- Adapt your strategy to survive longer and score bigger.\n\n## **Compete for High Scores**\n- Earn points by eliminating enemies efficiently.\n- Improve your personal best with every attempt.\n\n## **Leaderboards**\n- Compare your performance against other players.\n- Compete for the top positions.\n- Prove that you have the fastest reflexes and the best aim.", "short_description": "Test your reflexes and put your aim to the test in this fast-paced shooter! Take on endless hordes of aliens armed with a powerful futuristic weapon. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/invaders-privacy-policy/f044a433-72bc-4a4e-be3c-12a12f8078ba/privacy", "developer_terms_of_service_url": null, "publisher_name": "Klein ", "support_website_url": null, "website_url": "https://www.zoydgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27166456353013253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982656_168200969524520_5411543088583127077_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un2lC41lz3kQ7kNvwHLWTjN&_nc_oc=AdoOAjlyWoP6hqm93ZRJDT4lVjEyJi3MoX573l4euK0Gj0c7R4W-4V3VMorWOy2wmcA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ2wTTyJzuSvGUSppEGUz9uY8Zkj2C5FIn2AHIYb8irg&oe=6AA411DF
?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_8wDzf4Aq4Q7kNvwGEJLgW&_nc_oc=Adr6OqPdJIf_9MINcEOJC2kOqNKHq1awKd4YULWanmjVyiuhc-fvPOmOSQq3O4cztu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM8sp1vQA8JDoO_-ui94fLPt_zDeiXxErL4GMundjkog&oe=6A9D7288"}, {"file_name": "ezgif-frame-001.png", "id": "851539284701325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507829691_851539288034658_2015526820441760075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0GLSRorLukQ7kNvwHzgvzA&_nc_oc=AdrLP1Q7BDQ65a48XtSirdukTbYJADTdQ5RAJu4291-xlS2hmDmiBbZLpp4rxfPRVy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQp9I9TOohe73ZilB2ZQMTSo6i0AxxU9zvNpvpuEKIjw&oe=6A9D54A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1786810688955279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593784242_1786810692288612_3567132886722876177_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPAYT6-vBuQQ7kNvwFAAlyK&_nc_oc=AdrqV7hnrUTyImvgm0BI2Z7OMdlwjrCr2PaA3wCNjhISdQ5EoeA8jdCnBZe0pcU6ifo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBlR1_ooi_hUgStG4AfTifropzxWfjfFHbXnWBdBSbgA&oe=6A9D894A"}, "display_name": "Invaders!", "keywords": [], "long_description": "# Invaders!\n\nTest your reflexes and put your aim to the ultimate test in this fast-paced arcade shooter!\n\nTake on waves of alien invaders armed with a powerful futuristic weapon. Every second counts as enemies become faster and more numerous. Precision, quick reactions, and target prioritization are the keys to survival.\n\n## **Arcade Action**\n- Fast-paced gameplay inspired by classic arcade shooters.\n- Easy to learn, challenging to master.\n- Survive increasingly difficult enemy waves.\n- Chase higher scores with every run.\n\n## **Endless Alien Waves**\n- Battle against hordes of alien enemies.\n- Face escalating challenges as each wave pushes your skills further.\n- Adapt your strategy to survive longer and score bigger.\n\n## **Compete for High Scores**\n- Earn points by eliminating enemies efficiently.\n- Improve your personal best with every attempt.\n\n## **Leaderboards**\n- Compare your performance against other players.\n- Compete for the top positions.\n- Prove that you have the fastest reflexes and the best aim.", "short_description": "Test your reflexes and put your aim to the test in this fast-paced shooter! Take on endless hordes of aliens armed with a powerful futuristic weapon. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/invaders-privacy-policy/f044a433-72bc-4a4e-be3c-12a12f8078ba/privacy", "developer_terms_of_service_url": null, "publisher_name": "Klein ", "support_website_url": null, "website_url": "https://www.zoydgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27166456353013253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982656_168200969524520_5411543088583127077_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzfDHBgKgCUQ7kNvwG8Eu_t&_nc_oc=AdpEjeekhTF4faBr7o_Wnph9cxGNsoqpC7CCvh-2E1BQ-Tu1sTt0OShdNJGnwSGGYNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLoMsilkeLxdFsUB4ozWA3bKhP3xSCrevmPXDKnHMDpw&oe=6A9D7A5F"}, "i
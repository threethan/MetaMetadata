37_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09pAY9VZk68Q7kNvwG5JE1f&_nc_oc=AdqxOe8uNEabYyNqeY2AplRHEbZMsNb1EgHPo_88O_1Ol9Fezw0cpwNvH7tQZ3XeDe0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2C4aEWipCs0t1n0s5lBaOQnj1_tqLO8xZQHhXFYg4BQ&oe=6A857F48"}, {"file_name": "ezgif-frame-001.png", "id": "851539284701325", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507829691_851539288034658_2015526820441760075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqG53VVvXRsQ7kNvwF9x64L&_nc_oc=AdrAl-6fM9wv359nONWt2HZoqyzUEvOJAG9FIXOOeXcAFLYHtAbVa-i2mB4JfmoGKSU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElCzn99APVvzUmxH-jU-wnjiGMp4WjzjUIvrjXKupdGw&oe=6A8599A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1786810688955279", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/593784242_1786810692288612_3567132886722876177_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGGpL1Xv8scQ7kNvwEykKa5&_nc_oc=AdrMhz1JZyLf_zSwkni9G6Rv1yTzYrYA9XZdz1oWdZySR9T9rI5SEfoUxjQQZhueI5M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMUA0bh6x6PweO5uJGA0zbITv5NooBJi-BncNqvoy9uw&oe=6A85960A"}, "display_name": "Invaders!", "keywords": [], "long_description": "# Invaders!\n\nTest your reflexes and put your aim to the ultimate test in this fast-paced arcade shooter!\n\nTake on waves of alien invaders armed with a powerful futuristic weapon. Every second counts as enemies become faster and more numerous. Precision, quick reactions, and target prioritization are the keys to survival.\n\n## **Arcade Action**\n- Fast-paced gameplay inspired by classic arcade shooters.\n- Easy to learn, challenging to master.\n- Survive increasingly difficult enemy waves.\n- Chase higher scores with every run.\n\n## **Endless Alien Waves**\n- Battle against hordes of alien enemies.\n- Face escalating challenges as each wave pushes your skills further.\n- Adapt your strategy to survive longer and score bigger.\n\n## **Compete for High Scores**\n- Earn points by eliminating enemies efficiently.\n- Improve your personal best with every attempt.\n\n## **Leaderboards**\n- Compare your performance against other players.\n- Compete for the top positions.\n- Prove that you have the fastest reflexes and the best aim.", "short_description": "Test your reflexes and put your aim to the test in this fast-paced shooter! Take on endless hordes of aliens armed with a powerful futuristic weapon. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/invaders-privacy-policy/f044a433-72bc-4a4e-be3c-12a12f8078ba/privacy", "developer_terms_of_service_url": null, "publisher_name": "Klein ", "support_website_url": null, "website_url": "https://www.zoydgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27166456353013253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982656_168200969524520_5411543088583127077_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4HW5WLE5lYQ7kNvwGgA-lm&_nc_oc=AdoThmEjKrx-smqFVMFgRW3Gu7sExUgCatxX3dkXBZq8kxWIIu7zhRpwgn5NLt-izGA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXepEa7w5KrbzYsZVB6vubfgGAODTf1aCVz_cTt5UQ7g&oe=6A
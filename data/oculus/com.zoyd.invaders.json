?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_LlWbGF2BoQ7kNvwF9WHCh&_nc_oc=AdoA8SE6nRcUzA9YDJ6j-SJa-g7ifn9oiPpo33xHMg2jkvMBPlrycRN5iHgDrU91UMY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl08Z5gkqQERT3wHcKzUO0I-fyOebKhWlxjvq0nqmrqQ&oe=6A8AC548"}, {"file_name": "ezgif-frame-001.png", "id": "851539284701325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507829691_851539288034658_2015526820441760075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aumQYOAayOcQ7kNvwHecWmM&_nc_oc=AdpyFebxPS1rDRVa63sGRg-ihpP8LtRYxb7AQDObid9lA4lMVKrqNwkar1GFLo87trI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf9vMfTMyGVZP-RIJTFDVBoZhJmhlb0mXhV1XRf7DA3Q&oe=6A8ADFA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1786810688955279", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593784242_1786810692288612_3567132886722876177_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rAufS0ubUMQ7kNvwFJabOa&_nc_oc=AdrNjCoSjNh5ZBsgKdVVtDNdqfcS9_6XtytiJi7i865oU6xY3MqC_GYHKwoLJPC6w9Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDj5VkU7q1IXkVclgJUkcjxq5TyISLMYdJI_W7IDdfhg&oe=6A8ADC0A"}, "display_name": "Invaders!", "keywords": [], "long_description": "# Invaders!\n\nTest your reflexes and put your aim to the ultimate test in this fast-paced arcade shooter!\n\nTake on waves of alien invaders armed with a powerful futuristic weapon. Every second counts as enemies become faster and more numerous. Precision, quick reactions, and target prioritization are the keys to survival.\n\n## **Arcade Action**\n- Fast-paced gameplay inspired by classic arcade shooters.\n- Easy to learn, challenging to master.\n- Survive increasingly difficult enemy waves.\n- Chase higher scores with every run.\n\n## **Endless Alien Waves**\n- Battle against hordes of alien enemies.\n- Face escalating challenges as each wave pushes your skills further.\n- Adapt your strategy to survive longer and score bigger.\n\n## **Compete for High Scores**\n- Earn points by eliminating enemies efficiently.\n- Improve your personal best with every attempt.\n\n## **Leaderboards**\n- Compare your performance against other players.\n- Compete for the top positions.\n- Prove that you have the fastest reflexes and the best aim.", "short_description": "Test your reflexes and put your aim to the test in this fast-paced shooter! Take on endless hordes of aliens armed with a powerful futuristic weapon. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/invaders-privacy-policy/f044a433-72bc-4a4e-be3c-12a12f8078ba/privacy", "developer_terms_of_service_url": null, "publisher_name": "Klein ", "support_website_url": null, "website_url": "https://www.zoydgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27166456353013253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982656_168200969524520_5411543088583127077_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsf4Y5_y-N0Q7kNvwEgSj4c&_nc_oc=Adpt5E_I0cItvj7tY7A_y08z5XLX2K_WKR3wVKwDiq5p4YI0lN-i4_oUUJgnDWPaVXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm3wI4SUt4r5FMYuY0XG8SBJtEyaKtceHqMIqH_0gcRA&oe=6A8ACD1F"}, "i
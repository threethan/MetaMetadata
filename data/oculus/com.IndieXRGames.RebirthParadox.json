e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAhNmh9jjxkQ7kNvwGkJ4Hb&_nc_oc=AdrsOiMD4vN7EAha81A85IBoX6X169OJtyhWdpvj3C9gx2R1nJP-fhXe0P9NBZozMFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fa6Q5yBbcepbNkv-hiXtpd6UZ4G7QoBNAe550l3w--g&oe=6A2D4D9C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-82L7ezi3oQ7kNvwFwyT20&_nc_oc=Adqv8CO3V-u_nEj7r4ufyQIxoucjlurzbwXEryNQEfS13357HFWiuB1f4R25q_W-pkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rCB5VN-h9YSOUngiKRh4beip64yVByXFuj2KY_9Rwhg&oe=6A2D4D0C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8XXkbkB7-QQ7kNvwGtx6sq&_nc_oc=AdqHgNZsqhxY8dzE36nkpAcnw8TathAv6D6tXmnY1rELpNKqcFow61sWcxCN9Elk22M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h2xIwhF_FGuuQ9-FlsuTB5fMWSSgaikpEiG69SHJQdA&oe=6A2D4C98"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fg8fkJnQnIQ7kNvwEvCJvP&_nc_oc=AdrzG3ROHcf8QXAbevtxhT0hg9nN6WVqqSiObaLjT_P48qzsbVJlm0V1AedotpiEQKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_leLpgMnjagdop7B3FZwOlas0wy7NyZQ5Hr93mqG38Ow&oe=6A2D4ADA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqdte8qLFsAQ7kNvwF1tmDS&_nc_oc=AdpUzv3yYA3r0fy1KwCQA9677tg2KGWNHLXFHqUoKK7V_V_Wl5xEs1uOtoPWF5n6oFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B2DxOBFfOZvXilgXwu437m6aVByJ12zAvfEAEUvCplw&oe=6A2D55EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0W57fth7GAQ7kNvwFno3FM&_nc_oc=AdrZNR9FnK-cC8n8GaunymYzGC-iW1LNriWvXxGMdvnvTKNZPgrewwDzJUH9a9g6dIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EeH9Qu8xAfnU4OwXq0qssd0tNEcEdMgd2DHxzmVhwOg&oe=6A2D53E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww0DLCSG4tkQ7kNvwEMh1Ey&_nc_oc=Ado8V9J7uBg6u3oMHsniqdAfMQ_NWbo540-cGIWJ0a46ICTs9rFe7VrDUEqdABrnU8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fv1i_W2FCwfWyj0FbZrornt5VPthu00nQcga1wIDk3g&oe=6A2D6FAA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
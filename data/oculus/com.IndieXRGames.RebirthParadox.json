e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK65LAOKE9sQ7kNvwHJ5qGt&_nc_oc=Adqx5C8rF4a9xIdu5T9VHWd-8DMk6OPVll4V87dBq5cE2NLKehjh_3cGmBFocHVYaGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKfZEmLZ7KOXOOWyKLljfDEH_8BtICEEm729yw7I_bxA&oe=6A5E151C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52C2UwBZOfsQ7kNvwEvXzlT&_nc_oc=AdoRzfPtQQUf4QixQ-FkMai6oY6ZTjEwfOM46agfsIKBBMkpbNDsCte-C_SvgajqnT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrGWltEpSXCC9h_NGF_PySC2UpT4bIqX7yS0E15qAsFA&oe=6A5E148C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eb5AT0UPMsQ7kNvwFKpbHd&_nc_oc=Ado-bgcQ3CrlA4rmWJkZjopW2NBSeL2poN3uaCptRjv7hQFr9pT0PJhofM10uOVQ2_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4ycZO801T6puTNOk3T19R1KlRHtR7wmHnBk2OPRqN_w&oe=6A5E1418"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIKsqTnOop4Q7kNvwF49LuE&_nc_oc=AdquDQZEbf9PxJ0TViLfsNtQdRVyOngmGyFdG6Jqe3OIlrmr7gBv6A8PfZg1NqpYYjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCASdYKfS4eA1uzzrEi2eY0SWsEzE2EbtWXZ1G1gv9_KA&oe=6A5E125A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bhLx5WFr08Q7kNvwGB4KyJ&_nc_oc=AdoQPaAi3pSozOk-83RnfCkckwLQdS8sCFKyoImW5gzRIJkbOx_N3QnPdIUor9CLJe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRHy4iYvaA4RUDxETYGPV_9j-PGl_TpRBF9LuGqIFYyg&oe=6A5E1D6F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a0Z_z9Um_oQ7kNvwEzsTTC&_nc_oc=AdpZehNrn18FkT8XNVbJhO2z1ZUoi80ear-56S4izJXJYbtuUH4TQ7hopPelQJnzHGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNFlittdgxfRQ8vBrDkXHysBOdtsTkpYWAKiYjiBrPVQ&oe=6A5E1B65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ78d8gW-roQ7kNvwELDtD3&_nc_oc=AdrCwtK2au6D-ZNDq8prt-6xsRg_3NRGqnf9XWAfPkYWoFijoUr6So9eetc0_M0WGYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRzvnmGCxN683YpGicO9cMmrUWGn1jKK1s1nR-EzRN_A&oe=6A5E372A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
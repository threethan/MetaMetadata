e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t0vKhQJxiQQ7kNvwHMPN6W&_nc_oc=Adp621F4FeYrcCV6p5k0po7IE0rZ2HSk9zbUjkfeVqdIf60nTuC2u_KOdKFh0pelIaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SxKEWl3OwM50EAlXXIDqj3HNsZ3bMfWH0TTaFjdnthA&oe=6A47AB9C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFfhLUVHq-kQ7kNvwHN2yei&_nc_oc=AdoHn9TtHCNFPhxmunPR_V7qdqjB-2QN-bC-lZiDzllD6rddKOfz-xJZAM07jBYfPOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wqQm2KEIXZeIhlLVEnMSZa5T6WL14gzonBK8fmbRHgQ&oe=6A47AB0C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-t1AZMo4zwQ7kNvwEwegeY&_nc_oc=AdrQQJ42uSXQL9UVB7kAMWSogxOgMtZHaE7dL63L70Xofx0Xkwen0El3ecLX32BRv5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kCTrxzUqAE3h-sb1ZxkoGP6V3vox3HswtRbuve-hIQw&oe=6A47E2D8"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk_u0_TJmeoQ7kNvwGI_Esc&_nc_oc=AdpIpyP040REooudO0MB82i9Ffl9cCH4JSszlemDDku-R5CMLRgaTAitVbbx9RfQnf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HGKtKoW1Uf_HyVig996kXWOiZ43YAnQXh-8tVrcIngA&oe=6A47E11A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce6X1Tkg4FUQ7kNvwH4JvW5&_nc_oc=AdrRxeVO2lH7utCXU5uq-QmpFAXPs2a_LsSmAEr0Z5vqkMbbCBu9yay0ObURElE13AQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zUKbxHI4xZD41PC7ry7YKh8__R9G3wzzZDgfkvwogrg&oe=6A47B3EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXwyrP6vQOgQ7kNvwGylWnp&_nc_oc=Ado3igz2xNPGWQP9RHyWhWpbYoUUsdPRRchvESsibbzT9hksW6XmFAWJLSJc69LmaXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wqKD59mLsB7p0sgh_jV8nXOUzFAKPa0v4ZDa_48JJDA&oe=6A47B1E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR4cS3aHsg8Q7kNvwEzKHK8&_nc_oc=Adoyi0qwUzZyJp9KTqHT7R3QiwNhE-kWXe-TMwde1k-C6vrWGl3sYeF__8JmrF8dX-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-32aM7MkNECv0X7_U7OAzfQ6nb2gEU1pZoa-3aVfQTBw&oe=6A47CDAA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
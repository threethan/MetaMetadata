e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKBciwgKriEQ7kNvwE-rqVd&_nc_oc=AdogiGys8GBK0xKzp9Ck8zjXKR9b6c_KLd3O3pfeybSqnbJYwgbgRIgE2OnsJXepYzA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaCJYrP7lt35c5NUk3ZR11eznDILtNH6BBZ5vEBKPYSQ&oe=6A5A209C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFznDUIjwEoQ7kNvwFiTPBk&_nc_oc=Adp4-h5Vr0HSa0AkiKgJYHyCVExRtDvRQC8impicZ_R1YqX15GkN9ZYsi2-lUU1CwIA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGm8gbk3YGyJu5wvmhdTXMEd80KGXi_QdrbjQCwUZ25A&oe=6A5A200C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyctpbYagWoQ7kNvwFs4cO1&_nc_oc=AdpggOELHEPE8Bp5_tiCusB1-P-jhPd_Tj3A7sZcfUuagKVpqgYYqd7QshkCGWyAPJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv3qgvMpKd0riZOv134qbB3XqyGsBLsRXCLhDpe74OYQ&oe=6A5A1F98"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkiWbyMlrX0Q7kNvwE9-Tst&_nc_oc=AdpudxN3SSSupn8gWg8wyI2rM4V17NIxY1fWbC5dwILCFef1CwVWhmvbDwDbnj2HMrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8mzWbNo5YZ_6lBsCyWacoMeRIhIfMxHxPxiBJoG60gw&oe=6A5A1DDA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf-HP-7_NesQ7kNvwFzz01b&_nc_oc=AdpiMZDrxucg6zV6b7DrMeTfnpsgM9MVITLiGVrZVkjjYOPlANBi3FS2EIq8WNZokbg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx9lI-3mNQc29QdyvI65hlA5e1n8JoaUt3zlzcGP_hZA&oe=6A5A28EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEVpufsBzdYQ7kNvwF_evt9&_nc_oc=Adr0k9jtQJK6aPuyrp0jHEpX_JmanlAoZaI0JtQto6Cu1hwzV1cRTS8rRki9ANwGP5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi-K8PHb3DlszD5w1_U3xsMdiCcsm_gSF6r5xXSOC9-w&oe=6A5A26E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK_fu3HPI7UQ7kNvwFJDx1v&_nc_oc=AdqDkUNmJKFu1_WG9lupPJ5HQJYcHyqPHZ91cbivpywHS5drh3HLW-dnFOVDO9TaFCY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8sLkrx9NTQCJYOlxOJxoaOD_3ehMZ80BmcGAuMqKgNA&oe=6A5A42AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1338093488451814"},
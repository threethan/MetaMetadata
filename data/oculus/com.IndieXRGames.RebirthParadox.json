0031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LICVprudFk8Q7kNvwGdn-7W&_nc_oc=AdraA8WS2LWUTDF4pr3IeF57k-NyvOaVvCjuxQeLBPPlNbbl_urAu0Cfk6qhMPPe1bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AbvgCSHr7bfWvK_XuelONHLvWjE-m9TiWJSI9NVL2Cw&oe=6A0DB1EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_61khnlVWYQ7kNvwEfmD5B&_nc_oc=AdohL9qyamfv8zvuLxzQiv0ELcUtO1i8jZb4uS3DlCSypjg0L2FMY8Ps1aWtLQQqphI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bCJgTDFnPQljBeEWXSxIZvRbj1autf8flAzyjAVM4wg&oe=6A0DAFE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IrFQY_LlQUQ7kNvwHotAJO&_nc_oc=AdphkSMpbadOZ_1hvR3ezyAW9Uisr-Xo9d_Eu3Ut1yWPQup5ouwZ3sd3_GXL5t_zmWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ySPE0tKa9yJkp4JM4oT77oz48Y3JbjqMMh9g821gu6w&oe=6A0DCBAA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1005583345148235"},
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3_tVrI55xoQ7kNvwEZP7yg&_nc_oc=Adr631c0mpkMXmIThVPefaCURKqB_kVS4xAkYgKv-He3aWR0sTkgEtLruXLb8oABCrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk8rLDewMpV1NKej7dgN73jNYm0zPs7U1UBGTYBM65XA&oe=6A53891C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajpt16mQlKAQ7kNvwGH7uQj&_nc_oc=Ado9p-Jbuk6GN7Z-Clg_jLIxVbJkqCaVTkF5OQT0wCV9NSP4PXuJIEa6cEyg1lQXfdQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzIfXAekihoXLQXPPvtt_OHPXO8e0DyzWDAYzscLW4-w&oe=6A53888C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUE4GISVVzYQ7kNvwErzkzt&_nc_oc=AdoxRPyZto8F7gGuUuMwvWTTKhsPKjyxr1N59HMyHwKrJflFMxQIwiOzRGRhytj7so8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQulh6xYsnNQXSwqqlf6ciLJFvPSp-EA_1J2zdptfQ_g&oe=6A538818"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOSnLqtdUoUQ7kNvwE2uT76&_nc_oc=AdpWlkUk1ngfzDpgiuGvBmDNW9tV1dRpXT0cI7IX6GldXnJggkETLODSdzu79M7DL5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsgmcpTelEEKARJ0w0Phv61y7X0qtZMRK1fucON4C26A&oe=6A53865A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEgcvVHlsioQ7kNvwFMcB4O&_nc_oc=AdogtBRnkornTjXwbwul9ciCFzNyexDIct5SVlB8nEBO0KKJxQMS88VxFgmLAudNWPc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9kZkRofsLx8fowto_IETW5WI91jEB4it0BuqqGvyo5Q&oe=6A53916F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7oDVTaHNQEQ7kNvwGMKvZg&_nc_oc=AdqgDrATwQkudBiNjG6oshaa5f3HoAJUv2oZIHyMrKHhRfe25TKyoket2qb4tBUT7S8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqbdc-ip8ozYn8GwHkiDFpXIsBVYyEhHAZRRBkkUmC7A&oe=6A538F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wGhVy5Od6AQ7kNvwER2Xv6&_nc_oc=AdpW5FFKAeqpLKsdhY8ENB1MPG8-JHYF7iGpvvgvaczeEEtfwS1JFHbbWmtsDzva_IE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWLGpCS5HSPb1FB_qml0xjnSyPFxVzUXtq3OeKHH5jww&oe=6A53AB2A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1338093488451814"},
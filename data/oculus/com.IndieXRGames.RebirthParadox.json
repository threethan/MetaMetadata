31500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4BTRnXd7GEQ7kNvwHB6gnI&_nc_oc=AdrcYSV4sVsFDlfB75-v3nkqNAKDibJKW0L58ET9PT5PerKQBmVm5-7jmmzzdfqPwKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IdEo_PcxQJfDkwLJJ0G8JU8VOEP4-BQwEFxkMqVHVkA&oe=69FB3CEF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s09i3DIxxmMQ7kNvwEk3Ul-&_nc_oc=AdpG0xrwucdqQ-NuHlx5hmX3WVjWMWD0vWQ9eCA3XwiLGPVzLsfZFqxI8BVYlhuB7G8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77fGnTPz__t_nfnJZjgGgLXqa7ibX1N8P0qhviAosYJg&oe=69FB3AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OYdqbC8tD4Q7kNvwEeY_Tz&_nc_oc=Adr4bse9MlmqBk0wU60fgDgmhoNhURA9YmONFOkg93wviRGeQkJR1l8r7601K7o3S-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af647gdzhisemTuCYtYLCMRUKjAzaSSj4-L5nPH2UkJbsw&oe=69FB56AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"}, {
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WRm4PfvwZ0Q7kNvwHZbvqM&_nc_oc=AdoXEd0L-43N3qrrYu3NVuW3khVUY16pXAqlaRrq1VsBwM7rB6wGl-j4m-A996vki_U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MfWzfgq4wLftwwd5W2C5MY8oOFu-0JHeWk0WpZlexNQ&oe=6A2FF09C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_9p9Zo1o1oQ7kNvwFcnraE&_nc_oc=AdrjmmH5TJa2xh46j5WbB1l9KQ-XJBcnmjF_dJymKs0gdpEp96FplVLK4DwnLTC8LdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_43WEfxd3hjcL2kjjDhzGH5SME1xBUq0nEfUoAE5WKsw&oe=6A30284C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6df1NWZSOcQ7kNvwG6qZB_&_nc_oc=AdoVi_wBB53lsOq6mT6TtgjagbTtiWzyzQ0zRMo0vT-ed8QPBAc8KczrhKQJKSs6KDQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QAE3wZnB623D6Ylvn9DMG1nX2DhqcUx0bSITQgftMjQ&oe=6A3027D8"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isOYKTpYeIAQ7kNvwGZD39A&_nc_oc=AdqZNqGE66FzLZt9dk4D7EqGcOnsfbnSwxrwxV1yCxWy31DdLCb76YTSzzMNyKBNvfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oAm_lsFwV5ToOgr07RtRHWgQOnQ6Nzb9BBCHD6MISaw&oe=6A30261A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdReYiCXvJkQ7kNvwHl3KLR&_nc_oc=AdqYu6zAhSr2cbNgZKXzcIOoemjUNNp0anthw4vv1bD-6CFkRnudSj3Adu-hOWCg2e4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d8PrnbDeBUpRSrTXX8ECVe3M8ySvsCRFJyKa84V3CTA&oe=6A2FF8EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaHs3tu5bGsQ7kNvwHAgWFU&_nc_oc=AdoZ3IGaaETsj6byh7aYnHNMBcxxXwjb_A9xAFe-ZW_UyQVqwpnFU7LYkuMPY-KqUiQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A6RKu8le6GEaC-fNsQ_F6uSFGOxaGyIoCpfJBxHdvZw&oe=6A2FF6E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSp_cvI4FBIQ7kNvwEItUfG&_nc_oc=Adq_Stb_wHzgGlr4-isRPiXBPjD2ksjziGn8c86ok7Jih3fQw_a5jrK4lv2wCtpj0AY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87N35aHK5DOmoT_ZqhPw1SAKsp9QX08Tub8TQmSM4d4A&oe=6A3012AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsPGkg9cUaAQ7kNvwH4EL0P&_nc_oc=AdrGVwN7HB1Vd6DdqE9SNiS0AM-SJaa8SDAlnIyu7efpK4bCqUiakE7WrbNoWZu1lq4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hyySoMvf085ykbuXf7WDv5lCN0e3vB29-1C_e24ru6Q&oe=6A41141C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnLTQiuBfpEQ7kNvwEYIMLb&_nc_oc=Ado__vDrIcKIhtqaVSVV8eTXwiywgoQrI0rpQKlqB7cQ8ekbn_ZaQOn-s2kASygFRzI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-msiIAaMtx6EQ7ex_aKG75SLwFLsJVx3QXbX3TacsIBA&oe=6A41138C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1DG5wYk0-cQ7kNvwFAmsQc&_nc_oc=Adr3d9h12ebNNpcB4IrkuAtcSSGNT03m-dl13B6JMBDXpBsNUAYK5pult_3dofqxH-s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AM-Phes0rPjpooYRlQrTWKmiXgKfyGRpdhnG3_SCzbQ&oe=6A411318"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ib7VBIV8UQ7kNvwE2aCDK&_nc_oc=AdrcBemcyoPqSaUyt10QQOt8F4R-P5bn8XvuIBXZ-sxWgQs1DUVEG4zof4qs9GaxwuA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SIxpIO3d7ncdmAdTJs2XTaIK1rK_PQ43mJDDAwKqYqA&oe=6A41115A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK4RqX_K2JIQ7kNvwE5XBm2&_nc_oc=AdpZz3KPLygPauyJzHdHjWirZN8dsSKCtwgzuf8L0t6Ohq-k1LSNfif0UFVBeit_BZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KV61FuaKzBLSMMIwasTfXG2kPSEh169wqKPYpHdFJeA&oe=6A411C6F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0BoKGhMpsQQ7kNvwFLW5bW&_nc_oc=AdqEKZDCvsdox9-AZxjy4X6T40YSwlCH25yTKqMuJR2KthZNJR4A0B4BP-vmToSblfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Y60H6kZgI9P1eKOg07661W9Ew4QYwpkTA19Bt9oPqQ&oe=6A411A65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deKltqNv2aoQ7kNvwFmTo1B&_nc_oc=AdpQHPM7Mz5N-beZr512WX78c4o0bhufIAmVogvMYM7Q2zT32xjjZ4qxOSQPi-VkWqs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--P_9AQiIBUEiBlJfn5fnoBYmNiBCK9NgKW8bnHcu7eQ&oe=6A41362A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
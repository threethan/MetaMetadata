e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9UM7llYJJAQ7kNvwEJ4x2F&_nc_oc=Adp1WluJkjs2heq3CMKy5fQVKFJyQOIDVJeUxKtGz3CSs6rMff1cCCU_IlrjZTijR_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2JuH3e6KwXmk5pj9NEVruEl6qB_FuU9g1jjUuFQmeMA&oe=6A4CF19C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzblk5ngk38Q7kNvwGjUgkv&_nc_oc=AdqpyBbd8KqQ5AJnz32mmFZa9AXEBLmniaV83PmrCU05UFkkWso9D-K0H3VybptxLcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjtCVhYtHUversfCfHglNTNoD0Oy9eNOclGUsa6cbCDg&oe=6A4CF10C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM20tjeRRbYQ7kNvwFp6Kv0&_nc_oc=AdrzGrsh37QD5OuBnG0Bf_JtaEKIvgXB2bwAwXqD369fC5Cv6oRh2FCPaUJv4JnUl9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADwFEhkvx0kZqutXPFqV6s4zxjBLiSkk1vDLmq3CL-Ug&oe=6A4CF098"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcd65IectHcQ7kNvwEqLNea&_nc_oc=Adql5TFBoOPHT2v3K3gwzpel9_mUZqmmGRymW3QLVoqzaYkeEKjXYsou4NGrwAr3vt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk1-vKftB5adv2QXifLjucKMzL_Tp9v1ujQygG-Yz4YQ&oe=6A4CEEDA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMljz7O3DFkQ7kNvwFQrTaL&_nc_oc=AdoNStKfduSJrbyH8CAvJ8bNtXvJkjkcdxdqfDzdNE61eXLVQgCxtXzSUSCOfwFK9dY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsFAjbiOXSiyk1DU0ONWojGiwmYEBkg1H9MTo7U-berw&oe=6A4CF9EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAQwWgbYDnkQ7kNvwG5mvTR&_nc_oc=AdqIAo6qDi64-lb-beKJjN58kX3uRmMOpfiqSXmiJLPxipG9GG2WcuPYsJDgWI7KAio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1ptmm9Q76j0eEYR_lNUgKWq8S4VSg8DdnP1BXMnyqLg&oe=6A4CF7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiGtqoucpykQ7kNvwG5Z5wv&_nc_oc=Adr6dV4NMIjsO5XSmoPFmyWK_CU0qisIsA8mRgG6QU8Ajo5bi2NPjn6HIT0TwC-S3dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0IcieI_XCy-TCqolPDuLgP0WhHD8R472dQZALp9293A&oe=6A4D13AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKpnwMfy_ksQ7kNvwFtnopo&_nc_oc=AdrBVJzeRRjfH67eBPsMAXl09kWgU-b_JgNyWz18a19dc0oCODUdzNuhho2DGZk8LcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VrQIl5a8f3DO9y7esPwNQA0QjBxfL_O1OZam18C-0hA&oe=69FDD79C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRItFS011qMQ7kNvwGTzTOu&_nc_oc=Adq_2dVuS_MP9EaFKdUkryLosTUGz1t29nRqGBkMyqJezj3O3bNOH8d7r9rd61edTsk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ko7NpdROBPEyqrJyK0SgeUqPQYXA5uYdr4oenljP53Q&oe=69FDD70C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQtb40Ts3SIQ7kNvwGerg7l&_nc_oc=AdpMyC91xQgF2CZSJH76sQ_uxKn-Z-4zty-BM9DE_ffBAfaCvwvM-3hlfHvNpz4iPcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OJ4pmiFPWb8tadzbAUdpUv7XGJutM_QB7iR05Uxo_ZQ&oe=69FDD698"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRzMy_p9vvQQ7kNvwH6ME2K&_nc_oc=AdrfgCIU9K7XBF3L0cY_H6_AzVSPgSalkjN_g0QRyu-1JJdL5SVXYFqJ_vHVjUh2YYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MegFzG5ETdiuohZnbAiC1Fg_CAadIarq6xXERKrNeRA&oe=69FDD4DA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZjso9XKRPYQ7kNvwE9_Egs&_nc_oc=Adr_5VtQXYUsnDxYbTJUgSn-TH50s-f7nbN6bzrPtKdn-EPB7jrPpRJeF6R3hsVNGko&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kgEgr6aWhMX0vG0lO3fQueRkHIelex7axmq0qXjM4jQ&oe=69FDDFEF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s09i3DIxxmMQ7kNvwFU_cr0&_nc_oc=AdqZadbIsqBgoAXT21jLpq_btDsQurwjnLG7jFYCG7dSMRXePFr_H7I_d-3MARxKuME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vhcQynDBggTaGSMXuHHG6sqmcShlMFaiDtrdXGb9G1Q&oe=69FDDDE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2DbkfeIy1wQ7kNvwG5J3bx&_nc_oc=Adp2nThJOHZ3y-mHquyP6WHJrvU8Xvnbu1xbVldPm0FqjdVC8NHkTr7P9uAp0pyyvQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SF9CWUjuXVyCECF9QlZTE1mdc61mbmncEXXe_jkrhBw&oe=69FDF9AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1832918884043711"},
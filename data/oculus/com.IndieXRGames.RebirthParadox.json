e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMkVR8X4GnEQ7kNvwEQNuo3&_nc_oc=AdoCEKUl5XZJENhV7ke1SCWGrRsKAfydcLQe-8wyzpqThk5gL-5VGVFhOzwXLfXeWSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zo5fAa2A-TeGokZ1YCSlkE_xWX4YcovbGAXLjg9BcaA&oe=6A201E9C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GULQR9SJAAcQ7kNvwEwMxl8&_nc_oc=AdonnL_r-uZ_JeiX9myFe6FGL8WA2Mm-Yvtl8Hltu4YDE4YEkVT8DG4pGOWivuK_gDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gQICQMCf4ddp_tMcpJUz-ypEw71vL8tmFbkR1qAHSRg&oe=6A201E0C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_1Zfbug5-gQ7kNvwFbtiOw&_nc_oc=AdqIIa3FT4om3SHks6wshF3Y_U40rJ7hFSUr5jSK6s54nk795v4eO0vvq7wp0barTTM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RL4yzc0tuDIQ6DgDVVvJSBBJZUBMDKktU-kQao0DVTQ&oe=6A201D98"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY5ZH3LPgLsQ7kNvwHcCemE&_nc_oc=AdrN4XWHP9Y6LfOCTZc5UK0OZ-_DjuZjRcgPOfQDNlp6hBeToeJ02ya4uUT1C2E013Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_pwCqDneJNu4ngFgLIXE3nUkGg_QsGBCn-nsqoELyOw&oe=6A201BDA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJd4ORSHCacQ7kNvwGXYCq_&_nc_oc=AdogvMN-pC2L8v4Cu7DfwPEVe8NIA9x-ABvqssjadk5dzayoRSoIE_XhMBQwhZB7qSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74ePYRHUPyt0VVJNbeb07zN2xMggh2FY_tYaLAuR8mjQ&oe=6A2026EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtwtm9R7QE4Q7kNvwFbkwYY&_nc_oc=AdqYxbo-HQ5wmY_CP_tJJ815FZBwD-IrpEp0U_p8bQveiAMsuu_5P9SFAeRJxAju3MA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nUAIrRPKmurW6Y4X2kSz5drQ-Hpl-t3D6QJIIZ-iV0g&oe=6A2024E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MppEowWZgAQ7kNvwFUCfJO&_nc_oc=AdqE-mNt7oQkoMN9S1cw6EPDR_jy8T_TAqyemIXF1qXFPmIbGpxZZ6Ah_oH1dEjU9iA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nSVw5aSzCqz9DsX10MVaHdrxDfqbV5qEaTCgvAtBnfQ&oe=6A2040AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
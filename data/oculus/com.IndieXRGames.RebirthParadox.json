e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksbVByLb_wcQ7kNvwH-bNV_&_nc_oc=Adq0OTIPbPdopiNQt6JDsjjqsUVV3TVFDdf36-t2CKWStLEruMD0C5vDoZx0awbRuO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z4pX6kbfsxSfnnFVRAhxjB3A8J3PhGB6Eywwe_cpMmQ&oe=6A42659C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnLTQiuBfpEQ7kNvwEJpzNs&_nc_oc=AdppL6QexWI96CNwUPH8IXO6YpFEKdEoJJYeHkrtrX1Gk4Zi1soehBDtWOXxik5eF04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_REz20fkrgrpvF7RJTu-HUgAK1eTq67sSTPG3Wt9uFlw&oe=6A42650C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJFzOxt13-UQ7kNvwE6tide&_nc_oc=AdpjGqYG4rUFZVUWWCV3TynFOyf9L2-9O90HlnGE3tftW4eDvE4av9_X5fgOl-Rd9Ps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pbbGyP-hp9ctqKc7AhV-k9QrTXNVniE_bP9VnqKL0YQ&oe=6A426498"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ib7VBIV8UQ7kNvwF-bHa5&_nc_oc=Ado-n-9N4dM_xkZ9i9iVIji4Lc3CouG3thFtmQxy28t5CFbBKEsUzNqk9HUfExYsIQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I2xIyTowmMC9XGdBVFsFd9t602FgBMjDf8wf9X_oC0Q&oe=6A4262DA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK4RqX_K2JIQ7kNvwFaX38a&_nc_oc=AdpQmA0HNJ3R2ho3N6PlTKXoFX_Ny5asLrdfhK09hI4BL3ixFaYIpZPtNNGmHSUfByg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DnLbURnhhk6V6uuVGFHmdNKKsBqqp4pRnjhE2fESmmQ&oe=6A426DEF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5p0Xy2-wPQQ7kNvwGz5_dJ&_nc_oc=AdoiEZwyucczDieiuv9qe9gDccaEFks6D1NENMNgtsniEoloY8-p-nQTdGUcEjRvOTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EeBQAbGf6lGMo5pP5kcudIph59detZ00yh2keTxYzlA&oe=6A426BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deKltqNv2aoQ7kNvwGbdlwl&_nc_oc=Ado_401m1Plb25pT99Giima1qi_Q4Rb0nPc1s_bv43FVRJ3MnklrJoKE3iv93hnDPpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-6mOezrhW84y1jrPeLKijkcZ7hyvT4RPXFdG6A7RhNQ&oe=6A4287AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
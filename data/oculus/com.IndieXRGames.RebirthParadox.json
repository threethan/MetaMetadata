e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsPGkg9cUaAQ7kNvwG4gdbp&_nc_oc=AdpVkxtKnq4_rSF3i0zy8M9ZuFF9PxaKJP91aohvVa0NDyisBaa5yElGoihu46cYG1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JE9nM040NtJ4_WEPxfohc-0ptPtfgnu2nZR4UiU4QoA&oe=6A3FC29C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnLTQiuBfpEQ7kNvwHpHzH6&_nc_oc=AdpvQKvkHJXhxvu_Ie7xs9jBrYiSRX-CEVCIWRNBT8Af-dNsR4wWIuQtMFFVNi5bu6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kazZ4L9xCDivRP8HTdNX5BWyjtU_RhAql1ji1c7-bMg&oe=6A3FC20C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1DG5wYk0-cQ7kNvwHX17Qw&_nc_oc=Adq2VIIEvxQGT5ssuIqQ4d1DOA6Xd0hstqbnsNV8nXh7bmhdpDxVnn00kVRXU6p0sRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yo2mjjQK3jA_zCHfGqig5je5bN2uxVKkfH05Y1pi0oA&oe=6A3FC198"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ib7VBIV8UQ7kNvwFmGaE-&_nc_oc=AdpceD9DugJxsE2S4g0E4VOw1IbiLJnzaZ2Tlrpt2CwY4njFxbjdwH4ct4cWuxwvDyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NGoZ7QRmwn_KxzIC-LySu5UV8_0yJAUtBlc4tMaoKog&oe=6A3FBFDA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK4RqX_K2JIQ7kNvwF1YUtj&_nc_oc=Adq2PRqEyOwSv3vDEHk4lVmz0MfZO8Ic0hryUwq_zymOiHfX-0_IDMzwyIBON0qB0bY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EY4PBuqOkvDM9kOiZE-qnHNnv1ojH9ov3zFqJKrWnXQ&oe=6A3FCAEF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0BoKGhMpsQQ7kNvwHFUPYs&_nc_oc=AdrNZZXufMp8KTdBvzBNN1iVtjCuu8GlQ1lAIkIh5fxw80m1QOIRVu-Fbt4AjDQ9JrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ud8qNFxTbtjxOmObLWhF1QYjcP4IoAMSIRGFRvkRgVQ&oe=6A3FC8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deKltqNv2aoQ7kNvwHBJqzH&_nc_oc=Adobn-qWWIRJScph-TvLM5VsJHrrd43g_qFNFHfXbpBFu3GeoejndekD-sEUabO9gDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iHWHG73-S1hCrM-bdLPvMPY7TIZtOnmoas0p4Ad_fqQ&oe=6A3FE4AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7P7-4YGzOAQ7kNvwFv1-0f&_nc_oc=AdpvQdTHSCHLsA6Ef6vVJLnSpaJe6ttCf6GSHPy0go4oJaqXrYmmg6PDN5mj0ayGppA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gpD4Rt2r5gDgRiD7Xr6xtrCn7LvUA54ZkYrZ_aXt4XQ&oe=6A19871C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlFahWA1qXkQ7kNvwH1Pvh5&_nc_oc=AdoVS15AgKJdWxBcetc6sL3UPi4XoE8IDKt8kiMHr9raabVQn1f4pfbJoI90WqCvG7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wb6qIg3P7aU4UyyeDQsB7XtGdbk7ZnLhyJF6aVha3Sg&oe=6A19868C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVlQsyVK_o0Q7kNvwElfNB5&_nc_oc=Adrsndv_TmKzduRDQIIMvw8tE-OCQU4drqtDEetgHDEno_BAKgRQZDuoYPUUqhRnQOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b2YF7TB5kX-R_YRycrjiyHol0DtbtEMK8xevCshQYQQ&oe=6A198618"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpwbAwsdksIQ7kNvwFL28LY&_nc_oc=AdpZ0iSGrbgDPpf28I8WQrS-Ss6aLoDB_QeaVX4gqeXJBy9Y08p7naREIyVe2354xMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AYVqVu3WXcfbtlk8Ys4HjX1GF-Wtuw8JwXinhU8JYAg&oe=6A19BC9A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9diNGcfm6UQ7kNvwHBHAOI&_nc_oc=AdplSF9R-kKUhQGkilzwQS6SaxXzYpggGXZYZYbHH7E12NH2QfrdUbPi-fsDKQyP2oQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BE7kFP55A_2-R4XnF_tBUv8x4tnZa-NejLMPRnVHHiw&oe=6A198F6F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phhHAVn6ae8Q7kNvwFH3nl1&_nc_oc=AdrrwlhfeGhdoXoq3k_D-oS7FVlbZTSCMEhEA2CkyGjYb1cJbVb6MNSHuDhyeHa2wYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YA39DyT89da-EYE9xCTM8cB7FPH1fJiswB-gu_8Tfaw&oe=6A198D65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEKM7S6D0Q4Q7kNvwEGt7Wt&_nc_oc=Adrb8W1ItdeXRs-cWL6DQSm5vMDo1eUSk4kXRHlzKqAPzg0juyrzfjpCZ9bhhNGGK_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49G4TQKG-FwmRqppZvr8GWTnmX_ICtOlp96nyxs4YxWw&oe=6A19A92A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1005583345148235"},
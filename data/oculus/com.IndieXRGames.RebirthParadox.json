e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3_tVrI55xoQ7kNvwFVwLtb&_nc_oc=Ado4hjzjDcA_EwUxQGQ4WmyigFqN2hvUqz7jNaUCQYJqC_qupYDefYlL6ezlKY97INo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOoaLSFY1KaXgcul31pEisQwnxeYXVMwSpHS7xHcn4hA&oe=6A52379C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT8JQMEY8nQQ7kNvwFURs1x&_nc_oc=AdqfHp9WfdLkmwMS6LGtuQQ1ycsBS1YxhlDnBEu4vtlN-48tcQb4QwgmnRGjUQMmrms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqtoh8eXipR2tozu34Hk0eXZkkFvKNPWQj2JanWEW5FA&oe=6A52370C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUE4GISVVzYQ7kNvwEUKXiL&_nc_oc=Adqb6R8SiSsK5r10cEYQ49CBvwynLP7sLAIikTD4pViFeLWb7X94d0L5wbvw42j7O3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfyDRGEqIpVLLfatjpFbIvMciXZQGBAMB_rh_PHfuUxQ&oe=6A523698"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkUEmOEllwAQ7kNvwHRSP5U&_nc_oc=Adr-LlToByKS8Idj-nnVESMDjwHjPkwPOt_PqRlXPVhV3OK3y1yrs3DSY2rpnVaxNTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Ax3_HrLpN0EM30IGZMqxLJLpYdhy2C05ttnWd3ieEQ&oe=6A5234DA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6Tcqe0yR8QQ7kNvwF4DiEg&_nc_oc=AdqXsvEwbizivQUFpmWi3lvbjH47KpJ5wKXPs5l1xroVR8ycs96NyVsTn-g3jyTtvC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuSqEu956M1-oLE6K-_Iv3ctaohSTCjAfljwcS8UOXuA&oe=6A523FEF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7oDVTaHNQEQ7kNvwF-K3zd&_nc_oc=AdpjSamn6YQnQpDkomMO_sKBRGm-639zFnnW1TKavJ79r-LXpJbRkDuRp4k96ti-MZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv3o5FdRS-SjB8GxlHlHVNdSYrheL69n5l0VywbJuRGg&oe=6A523DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eu82NB9yTUYQ7kNvwGNVavH&_nc_oc=AdppTtzim7ga1i5poRND3G9mHIz9PC4ai2hffTfp0TKx9ERExOnVHlZSwC4g8ggJaH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS5x5EHufUegqe1ZNGNJs7-gEDPbtviY4RBPDCzwsaVA&oe=6A5259AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
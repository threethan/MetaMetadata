e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WRm4PfvwZ0Q7kNvwGCIoqv&_nc_oc=AdqK5JJREVopWG-YyWFWzMHNnmeWGjGJRUdNz1IE52dUn_DyLZFFamQlKO5H5EwFkvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NXls015zrZWL-z79zT3wRH4JB7x0WIJRP8-0upOYoqA&oe=6A2E9F1C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-82L7ezi3oQ7kNvwG40JNP&_nc_oc=AdqG4VOyu7aJ-zPC_U1BrbT-6TFAPptR22GOEXrrglQdbZvL30jyFeNoSS4bHlt7Gaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uSWh67-YkX2NnQyA6RBADdeprxI2cYc_F-dQJzj8V7Q&oe=6A2E9E8C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6df1NWZSOcQ7kNvwE6gVeK&_nc_oc=AdrFKyHu0cuXqK35zgox8VqdbIyauZ2QZutZLEET3Hs4ew2r9QCLG0do8QQXOgAUIPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Tp8jyewlNV-zmWXKzOZDt6FZEJcdo2SqdfF6PlFGUw&oe=6A2E9E18"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fg8fkJnQnIQ7kNvwFHq-7d&_nc_oc=AdoBpoa7E4SVheHoDHwj14yGMrv3aLcQxnPkgwgj0Fa5PLKSE14xtVNdlujKYnYbck0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oliDKLasW6cx6ebo1oTo-f8sqxO-3sNWtVqbpCne66A&oe=6A2E9C5A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqdte8qLFsAQ7kNvwGGIJ88&_nc_oc=AdpBaKhxeiY4_CmboqvVgamzLvDBKOOH-WQrby-2pi6lqP1VzXa2jkT_-m7M61gDSFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t75wAo9gXxrSQhDhzIresR5ldoevbTA0VjzAEo5v6Vw&oe=6A2EA76F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaHs3tu5bGsQ7kNvwFKoNoM&_nc_oc=AdpGnX9JM9e4JssuKwMxZbFIe_bbFPlAFc2XlbcJuvcfsoSfVQ8pS7fopqIByHrEdzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r5gjSxy8zpHbnR547tqbZsednI8R7AlcWuvKtDz6tLA&oe=6A2EA565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww0DLCSG4tkQ7kNvwGUgtoI&_nc_oc=AdrjcSVSqSrK44YkHyAV5o0yZqHna62VRn--1UBpvGises0KlZSUwckVrAyTr39RIxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g7T7KhZQE8Hfo-cw4pRgD75EsjgvyKvx6daT8s4MOzQ&oe=6A2EC12A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
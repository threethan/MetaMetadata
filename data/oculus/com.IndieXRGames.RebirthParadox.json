e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRasgac5ftAQ7kNvwGIY8hv&_nc_oc=Adoa01nOJmyYg6XU7YsWS0-zvkyUcp5pR-oVtYst4w2ghVEMk_73FA7TH6fcwYktPCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jUCV4NQJWqn5oh5rrS1vcQUsUmNi_eZXfqEH1aep2Bw&oe=6A29591C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g04YvEPRut4Q7kNvwGLhsyQ&_nc_oc=Adr_yG70SUffKaRiaEZcRs0QJf69Nkgg1ZzRnK2cNAPfsoILfQnT3tjJcV0UWdQ0mDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GiVp4c--fHos7l93C2SpUpi0zhgvRAGjN0OAQLWsSZw&oe=6A29588C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBvY4_d3lEgQ7kNvwEBvNCV&_nc_oc=AdqD68B2Zd3YuGqi6TzubS3x0gcwt0d8esfDoUwnj_Gvwobb3dkgG3ZIuPKin4otgRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X25GV7SnonyefxByqR7Nz-TT5m-7o_KEGGykzrBjmeQ&oe=6A295818"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNCT4EBFQYYQ7kNvwG4u3R9&_nc_oc=AdrdWnjT_AOkOi6HMOCKCBc6qWUFoMQ-2S3_NwyaIJdZwiiEVoxDhfvDM7oh7X-IvHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VOYKLBjSt0lzGYRdEOIYiIVP3liEG5Ll9uJMJlbB5hw&oe=6A29565A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN4ojPGNy6AQ7kNvwFHtoRG&_nc_oc=AdpKixArM_vI3Zo_Oy_AR7UuAUG08DkePDRGoG7DoCGkUmX1EgrQKZxVcIDAhgWt0SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CkPZVAFsZipBrsTZJhIVOmkbkiGpDtxYt2t2xUEJB2w&oe=6A29616F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS498KAPL0cQ7kNvwHxQW3B&_nc_oc=Adqd0KqsToiHh6sPxrlYFRa23s_rcsmaARr2kLekkxDFrNm_8n4l9xqnYKu6tldjlu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t2YJXi1QuiY_iIBYK8yuHT3ZBW6JtwWX7cRJTzv5muQ&oe=6A295F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk276LNymV8Q7kNvwEt4LW2&_nc_oc=AdqVn09pz4eqeE2pIMmYiKPWuoA657uqEyQ4r6iCMoaw8uh1AKsFr_NYyCYXQCT9-yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tcJmWIXz-QYUHRtsuiF8Xc0n81V_RknPGXSgdwunl8A&oe=6A297B2A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAhNmh9jjxkQ7kNvwGFW8r9&_nc_oc=Adp9eLpXkYwmRnflMCRMbxd86KOVviCoZGDN1vWx0wFwpRR4_iWtULJ5-SG7EJm99nA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aGpvU4lwE-nNwPPpoUrLOz5hKfOZhW_qEKTSaEFRj-g&oe=6A2C345C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-82L7ezi3oQ7kNvwEsm--u&_nc_oc=AdquZaMnzkD4SoJ-nTxdGdqkfgj6Wi3-b2wvcdjSiYTYs2ic5fyqNNyNnKYth5Skujg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98IG62yo2hpO0MkzU6Xpb7ZrVvZUTbKpZanioG7GkkBA&oe=6A2C33CC"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8XXkbkB7-QQ7kNvwH22_Tb&_nc_oc=AdoQOSHqlFDI9CvWzVttXDL2yOrmRa6k34EzIkneYlF38Q6C3A5kD2GQMLWZ6t221c8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99bbBUxbGCCQ3hEtdnpSpcA9uEyD79vvEqLuPNdJ93rQ&oe=6A2C3358"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fg8fkJnQnIQ7kNvwGOKESL&_nc_oc=AdrYcpJMKof_GVsiGOmejzKx3g37b9XKdSmORlURPH0bvZsIeyDJFRKsK3vqp4I0094&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DBstGB5qUHitMIFKTnWDBvbWHv2zZ_rFDBgu6o1IJVQ&oe=6A2C319A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqdte8qLFsAQ7kNvwFbqkbP&_nc_oc=AdrX0tghpF88tzCjDpXRLpA5VKHjRp7D9kydWU4mMFYTHmdLPVe0t5-h1apnI2sJqXs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h7pkwY25YakKke45Hk2OVWKGN9ulDZmaHvgtCUIOOpQ&oe=6A2C046F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0W57fth7GAQ7kNvwFA0_xi&_nc_oc=AdoBDdB995MDBuT4m21ka-4IdSQ94IzcCVFxYl4m6FkXjo6e1AKQ_fLsbzccN6GR6W0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dWIIvn0jiNaHs0YneJhH1kq9TsGpaxclkpG0BJu6xlg&oe=6A2C0265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww0DLCSG4tkQ7kNvwGY44UE&_nc_oc=Adq4-hA5082s_03FcRyMhFsfk-gCA9EXgxcqkXmnQzc-ClQRTn88nViz43ytL9_bKu4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__gcKDCpYhFEtpRY2bTMI73Sm4LC0u6yOQrIDO7GX-Dw&oe=6A2C1E2A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxb8QdmNRSAQ7kNvwETBhbF&_nc_oc=Adq34LD_bOi5ZUMpcmNN3MPiuxftQVdUpdq4KQnTrrDsaJEPF6yHqb-TnzovtwPOkl4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nxBNUTdweze8PY3EhzGo4mssOp0yo2NxtsehGDKRIhw&oe=6A0EFB1C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oum0vvmeiuQQ7kNvwGIM7xF&_nc_oc=AdqhwlVrm1v_5V6NmplT4Xc_CsdV9I_n2PK0E1-XyKmUqo2tXekNGpTDe7cUVcI0wDQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fTm1iz0lgNmESemuUj-e32a8zfE2oYC8QBFNrjQqqWQ&oe=6A0EFA8C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZUDeMx4cWwQ7kNvwGZoMc6&_nc_oc=Adp7HgbxJ9QRwJ3wPy7Gk-fQ7ElPsBe1T6Ojz8_X7eJm2tUDChppdkKTqBvcgAMq4qs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xLBEPEQa-ZAmVGZtew92nN8fpb2pqqLy6bzO6pdhJAA&oe=6A0EFA18"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjLtcv5FNvoQ7kNvwFo95Qm&_nc_oc=AdpyJUjgwlEoDYlKJ5cuVBKk_K2LJwygxGy99OS5yfGvEbc_L4xOWqa_0rCovXvYJxU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_BAMxlwR15qwtvj0-77Ts5Go8Rk42anmW_7ExIGPQ2g&oe=6A0EF85A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LICVprudFk8Q7kNvwHp2EMp&_nc_oc=AdrC0EnQ5lWEYzUnStGebBOLqlZc_uMr_RVwpSTaWcC7F3pYeSeSyxv7jQnNPtMdjTY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dV_QFAlLTeEXF8XgOwCigwVTbPQdqd4Ze9cut6ExGHg&oe=6A0F036F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyxZLl16bggQ7kNvwFXVp3r&_nc_oc=Ado5blpVYqb3lInD_jSFC2x0_6-xbNs94NblFE5-bbqh0jO3seNU_hWk_twA-RLk-l0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CYE6sf8NPlBFGn7oWonZwxk09tYqh490jVZf1z_JnmQ&oe=6A0F0165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IrFQY_LlQUQ7kNvwFaWEmR&_nc_oc=AdoCHUecnOAZKLKuF5Hq9hUiwyo__vwY2eJZ6gnW_raLhnlmhfNXqZXyk6ZUntz9ELE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y_OSkrSpaLP1_NkWgrSL6Fs_ApLrCaAqwzobM78JfVg&oe=6A0F1D2A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1005583345148235"},
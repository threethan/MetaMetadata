e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O1nLfDMB6YQ7kNvwGiIN-X&_nc_oc=AdpHPftL9D-hb24mxcB-FRhq2A-aAd4OSugvqcOQ00s0G3H-XJs9CfHlxctOkm1qDKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e6CB5-YIj8y7Mb7bUOa3GTXJxL7RsO11-nm3gzqI9cQ&oe=6A3811DC"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GYE2oSpcrMQ7kNvwGgRlOT&_nc_oc=AdoXXZmoaPm8R4A3jZzF1J2d-jWIK0-UoW88PPeCgHftxU4OA_MI8hkDkJ_oQMUQEi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af899xsE_2PRRA9Uv_lliWcRURJXnM-2jG_vmt5TPk58dQ&oe=6A38114C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG5MC0l-HFcQ7kNvwEQMRBL&_nc_oc=AdoW4-HafWWUcvQOyvA8v8BcGc-1iiX4SleWlWwGQjHY_hdLr1qu9QkORm8BFwPJvyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JunNHZs9vbFu65Hf3c9ahzTRn3YBMyJNMPyODOp6-Sw&oe=6A3810D8"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hzIbQqfYicQ7kNvwEFyflO&_nc_oc=AdoICttJNAmvfOkpRIS8pZshHMNemny4ldmUWOrdfgpRf5uhHlSFJ2JMlt8A8SPYBso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Yw0aRQoC3vz93wiCiCfgSZSnCRgibBEZbS_nhb3Gzjg&oe=6A380F1A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2ViqiM9UXcQ7kNvwH3BB95&_nc_oc=AdqKOtDcCi-gWANHnYI9CnXyXvYnvY196CkN7qiL5HLK-xLQ-HQic9JoXUiyNhlDG_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f673MO1vZ2zXdfpceaxAEHvJjAEIrO2BCbI5X1tqioA&oe=6A37E1EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5bawuB7tj8Q7kNvwEicusC&_nc_oc=AdofT6R2HTt8UWyBLLwhM0hPqFSZ6xKRrSOcYZ8S0VO8jcXDR_cChICtAaSaIWiCIio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DxiC1fSdGN2obqaYBgiYMPJjT4ioiiZ-WmsSJOJQgpg&oe=6A37DFE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCKYarn_yDoQ7kNvwE3WjX8&_nc_oc=AdospzF4ptvZhInKdZXCwYubCWBLxfTmexVxWYIVgRTv-wvhTf7-HJgYrd4B1qwq7Ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q6kct0_0iz2XRz0IXLV4-tq0Eo__mnBfiNqtSEF8BgA&oe=6A37FBAA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "1311422474294876"}, {
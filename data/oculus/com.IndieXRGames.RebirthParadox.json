e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyphV06BEvwQ7kNvwE6idA7&_nc_oc=AdoPPH0YIKeafkSP6VEmwo_4XTfGQ0KmlfPZec_SvHN8BMmAu9QRAtsi12Y_Vu9mX-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HIGuLUM_4yolvI9yCevbr_zEPgjSVeFRN4PF_8vbqFQ&oe=69DE339C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R_yBUCFUysQ7kNvwG-83pK&_nc_oc=AdqZhdHmMoU0bMHph7qCYNsA43ByfiiJFuVAFsl4hXUPK2HwM3FVnJv329Zc2CTVMgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hVYL8xvCRRsZG_klc6bf1iHlxu-wc6nIhp5O4S5dgpA&oe=69DE330C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eIMX6d76gAQ7kNvwEZhPG0&_nc_oc=AdpmcC-wSoikWmjtlCWURCvwqP2bDP_nbTJDW7MzrEJLCxmfwyQko0icdPDC4zHzG5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10ZTulIGGVQKD0YTO0hMI9ZXYdMY3IONMEFBSZl2E_lw&oe=69DE3298"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKLAJDQIJYoQ7kNvwEmPkWD&_nc_oc=Adry61jxbyV3cUny-j4u65V2ugCSfBwfcSQohrBLddm1ZXUi2-X37zdiddUhsViJiwc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04lYeaJWYyGsdmmiBZyAWDxdcLRuiC2wZk6mulW9iLoA&oe=69DE30DA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RH2QfvCCKIQ7kNvwED3pmV&_nc_oc=AdoTld5DCqavmPDJCvnxHIXL85gHPUkdQSXSF4Hjxr4VAFGhKl6DxGji88hEdu479qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tzdPnCdQqkuurqjnPpkbvOWySRiERfb1v1oZnhtN7MA&oe=69DE3BEF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNuV1RXDUHkQ7kNvwFxxt4f&_nc_oc=Adpj_5VWKV9wTWWli4nc6ZDKcR1K5XGjXB4OlKVDiGHVbGuopS9eNjRG3o4cpZ4-MJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZJwKv8XAd-hwmIf3ZWvu4vB2Zt8dNoJwC5p1Ne_jT0w&oe=69DE39E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h1iB79xm2wQ7kNvwHvLfr3&_nc_oc=AdrHgaSS0L446bvVxcLut3Z-jaOPsd3tXIMcsazLfE8J6Zzz7CfyaimImUMZ8g3usFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af258y1OX2ncm8-wYlVwWCxe31DPwRnNSAAlv9nO_z84RA&oe=69DE55AA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "974145294943106"}, 
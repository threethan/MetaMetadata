e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLddUmG5aEoQ7kNvwFiBbzu&_nc_oc=Adps9gvBub8hMG0f-XK1juaLL1W5oCSNYUL_6BhfrK6xr9Pe7_reHVGOoeR2QMJgh2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qBmfAmYL3ymRuHJLRk88FtslfaRLSdnVvSdW4-SxSPQ&oe=6A24131C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URK2bIPV_ggQ7kNvwE_CZAX&_nc_oc=AdpR20HhXLcONq54SxVlMJzKbmVzxbloR2Ns71DNL4rH5CZCAX3ZmxV1mZksqoDHfXA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qsYyeTmtJNrtR-N4IRtJnUm17SXH5Aj1dKbN4V1mhiw&oe=6A24128C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIya4EjrqBMQ7kNvwGgymvm&_nc_oc=AdoCJtMSLM3snVKuoDh91QV7MqHIFPqztFOCu9bdFXkyLiRh4np27823G2Xaj2HKBWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k-zykmCWeuU-Q_umfxnXq38X5h9N1I4LyJXgQBTJkIw&oe=6A241218"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEAOafTH2KUQ7kNvwFMzf5c&_nc_oc=Adqcv8oiXHavh16hDiXWVit7X4stCYRwXCTgQ09DMxl3UIlDMg69LSYOCv-jVRxZLjk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-g85jS9HaFRLsl3oElCe5riQUQrIwg-50N6j6UiNghg&oe=6A24489A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ9oQByqXhsQ7kNvwGBRCIU&_nc_oc=AdqzI4rZ12MrxUS07wfFouAI7Tf7j2bvnRXfg3KjYQnTh6MKcH68kaV50VHL69cMMxc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kDe-zqJDcr0w9XFnG2agkomdf0_spB1FY7btBe9TCyA&oe=6A241B6F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxHlCx7cIcwQ7kNvwGPdj03&_nc_oc=Ado-wY_HHr9OtW9DfeGRVWbrnkxm96CP47ILMAfHmQWTDX8hayb3-n7aNp61-MtagzY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lRMZTl7QWF4lnFj-zqqwpjpKXMWlu3HKYHP10cYaUxw&oe=6A241965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diul0wXbw4AQ7kNvwHZl50l&_nc_oc=AdqYsSkjh1FyF6sOK8fvlrWikxaqoVvjUCQ4Se71wgmJMfb3wPf66LxjuFDTqOCY5Yo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YSaZ5v0fSrDQ6autO-HwR4Uol-UFg6VrczY0IdeSrHA&oe=6A24352A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
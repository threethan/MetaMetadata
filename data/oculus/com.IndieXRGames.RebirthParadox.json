e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3_tVrI55xoQ7kNvwFsHPpY&_nc_oc=AdrSLnFBpznHsDBwhWJ0aViVFBUZSBuZ2_7giP6pqPI9ra7yVrxiLwy-3HmP3HIPyRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBmNHEWu3JaU5DEkcq3MzXdxOTKbbMnXTkMGmyg2PYnQ&oe=6A54DA9C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajpt16mQlKAQ7kNvwEsixxy&_nc_oc=AdrWV8JSafjz7upEQmbreSmUO31tAWfCgBEBwcWNkiTedamr3FynuACAoU_euByy7GU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU7I-df6tgh87LTZnl-ThHK0ABpRDB3pZUfbz8l_Btpg&oe=6A54DA0C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUE4GISVVzYQ7kNvwGMFw5K&_nc_oc=AdpqYfl_nUC8pw0COukmnOjS9Qkyu4kP6HxzovzWbQ7fqrjyKRbPUrvIEoLOB-Uh1iQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKHwB_27xsFPkGgZp9VYUObss_uZnbhUrMxpAZPZzsMA&oe=6A54D998"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOSnLqtdUoUQ7kNvwFlzzQh&_nc_oc=Adqf6uWzjGviFARCxuSlulDbFw5SEwJbAOrQQTzcVAWT56ZkpbFqqc9qnFEoMQTVC2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3-2tM4VYtiE87W2JW_7wGTc6gg1RDo6nz6v0P8_FCyQ&oe=6A54D7DA"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEgcvVHlsioQ7kNvwGDZdWj&_nc_oc=AdrtU2LbPi_fy_NDwFOQDCsH_tXz3GJgpMIO-Ih21J_HShPRCLy9T37kJYVpPB85skI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrILo3zw1VVnIlHAGQyU-PGJZlZhgBmdXQqHNmVQHLbg&oe=6A54E2EF"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7oDVTaHNQEQ7kNvwHADDWX&_nc_oc=AdoFRTx1PXdCuKyxB7pzWP9odGN1Ii9E37ZZ-DX26ph8kk2BQSXuxrepJV0nCYIDVVU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBigw74rP7-j9ZmnXPANYLP2y5DC0CoZy0PuGd7Adgbeg&oe=6A54E0E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wGhVy5Od6AQ7kNvwHqxWho&_nc_oc=AdpkUbZHmcEPNyo4VDGMPtY4khlCMy53Q-0gkzNQU7VOMFSyF38Ey0_ajquQLRLh-Xc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAijFzegp8LJt0XBHX-mw1GA3GlI2DF8mXBb0MgStSHdg&oe=6A54FCAA"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
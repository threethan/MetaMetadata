e": "vr_screenshot_03.png", "id": "593049750535696", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312344_593049753869029_2428480074724606777_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vhAt_-nt0AQ7kNvwFy6tme&_nc_oc=AdrVGtuMEB8OFPXVlkDd2rf25IH_vTDSCstdUiCGh1MUeSxPvyFHqJNMdrHq3XF1a4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXdPtJijF9skXUM8rW2czsBePmuE7gupvJ4jG-n-WmJg&oe=6A635B1C"}]}, "id": "1836000293628403", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "1599141737711552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617786_1599141744378218_1526584152006860022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlA_TCnOSEIQ7kNvwG7dw7u&_nc_oc=Adoj3NmOFO44rLuPJgq0-O1c0tXl1U9R0WFHtDPLHVxCZ57KhiyqJdVsK-6Jv1woGuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuKQ3cj9gd3Cnw5rGddxLWpMvWryU13CkYAkGI0NefTQ&oe=6A635A8C"}, {"file_name": "Namnl\u00f6st-2.png", "id": "1443531123461821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823943_1443531126795154_9014932571713726694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZfy2FYFb9wQ7kNvwFXpoon&_nc_oc=Adqvr9caipgUJEWGU9hZxMfHV6MjqFIk7WydHt3wCA1Tev3WHdTJAHVPV76zWe_zm88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzjxeJz6qMP-6djarLn9wZ2wWZ6U5mf8HriFQS-Ev3KQ&oe=6A635A18"}, {"file_name": "Screenshoot6.png", "id": "4103047499952785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823943_4103047503286118_2369476166711335525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezyLEnb5Mh4Q7kNvwH27lEv&_nc_oc=AdoAUW9_4r2IMLN2aiyiQWxgOgHe-Cm5e7ydhanzG_JordVPvoazv9I3YF4iA_oEfmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPvHRWD0ZBijpK10wZStHetvOqhmMi20NV-3nCZWGbeg&oe=6A63585A"}, {"file_name": "Screenshot4.png", "id": "2156500028167192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2156500031500525_5033982521538910106_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8wIQ4n9f4YQ7kNvwG6XmJf&_nc_oc=AdrNaozzb_igoj3KDh98tlUl8f-q4V_GwgvdcE-a93JviQeacWij7e3LI0oHXfCiC7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsQBXvQOOasv0Ynh5CkwT1dyYzy3CTEWw4-k-CHKonPQ&oe=6A63636F"}, {"file_name": "screenshot 1.png", "id": "757839943424254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618884_757839946757587_4228995355941031411_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr-F6f4y8b8Q7kNvwF-37bl&_nc_oc=AdrKtAabsdARY1iT5yoDVNif4LhjlAmznOjzCw6UvY2xePTqzcq9X1DHp-S5UH_Gywc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLLxNbe-LgLp2WeV6e1NISzcHKI9GaPaztTYL2uEl2VQ&oe=6A636165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainCover-Camera.png", "id": "1415479346327998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824560_1415479349661331_716671646406163045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AHo7GtM6D4Q7kNvwHQnZSY&_nc_oc=Ado_1XWoAkmrPHzwuy8Pn5CWF1wO_GudsfWINMM7rxWgJpPYfWwZwpcSy8uGyA_DCFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaikHjfoFd3JEGHWB_iixSgpbQGoOsjNRiPcBqSdi9rQ&oe=6A637D2A"}, "display_name": "Rebirth Paradox", "keywords": ["Rouglike", "2D", "RPG", "Action"], "long_description": "Core Gameplay:\n------------------\nPlayers navigate through infinite, procedurally generated dungeons using intuitive VR controls while their character moves in a 2D plane. The game features physics-based combat with both melee and ranged weapons, where players face waves of enemies including melee fighters and ranged attackers. Each run offers unique challenges with permadeath mechanics balanced by persistent meta-progression.\n\nKey Features:\n----------------\n\n -Hybrid VR/2D Gameplay:\nUnique orthographic camera system allowing 2D character movement in a 3D VR environment\n-Infinite Procedural Dungeons: \nEndless replayability with randomly generated levels and enemy encounters\n-Comprehensive Progression System: \nCharacter classes with unique stats, weapon upgrades, and persistent unlocks between runs\n-Physics-Based Combat:\nMelee and ranged combat with critical hits, life steal, and tactical positioning\n-Rich Stats System:\n12 different character attributes including attack, defense, luck, dodge, and movement speed\n-Multiple Character Classes:\nUnlockable characters with distinct abilities and starting stats\n-Wave-Based Encounters:\nStructured combat with transition phases, shops, and level-up mechanics", "short_description": "Rebirth Paradox is an immersive action-RPG dungeon crawler built specifically for Meta Quest 2/3. This hybrid 2D/3D game combines the addictive progression of roguelike mechanics with the immersion of VR technology, featuring traditional VR gameplay."}]}, "developer_name": "Indie XR Games", "developer_privacy_policy_url": "https://livbogdan.wixstudio.com/indiexrgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Indie XR Games", "support_website_url": null, "website_url": "https://livbogdan.wixstudio.com/indiexrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31172318409026189"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1791873221436038"},
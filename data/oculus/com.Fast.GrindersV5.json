f&oh=00_AQS_7UZ3WWiRAbV2mZqzbLiL_ijR1GnatlM_14a867uBSA&oe=6AFC6139"}, {"file_name": "screenshot3.png", "id": "1126482690051848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297120_1126482693385181_5471576848993467722_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5bThJmqYo4Q7kNvwGkTjWT&_nc_oc=Adq7t2vqanLSa25b8z0S3gBOnLLXVs48k1L2B9swxfVq63DL-iz5pn0Gf3zYEso1ndQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnwa79pSlF2YVbDg-dtSlu4sKMfsMWknHXcNRwjUGUCA&oe=6AFC9141"}, {"file_name": "screenshot4.png", "id": "3044737162538728", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499301196_3044737165872061_3466467504773161921_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_SweS9MWzoQ7kNvwFVSkdb&_nc_oc=AdrBctNtbaNw1qXlKJrcoO16wQS5kRCfqFZf_-hQBLT-zNAbbigIRM4YzF5W8vV9vb4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfQABBVdHaSruAjiWY1_kItF3n3oo_K4utETJi4r1Nsg&oe=6AFC69B6"}, {"file_name": "screenshot2.png", "id": "1745005290042952", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499302527_1745005293376285_501043211704546414_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp-GY51OBx8Q7kNvwHQDYqw&_nc_oc=Adod_HqdPom8an5WMNI0aRs-h0RDOTDBq_AEJfW0UQcfup9gHmT6vqTpR-oj3a5ZCeM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyJXzYFWaNndK3_W4iphrPCVWv9dKx78DYn-zrrz4kpA&oe=6AFC7439"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fast Swinging", "keywords": ["fast", "swinging", "tag", "tagging"], "long_description": "Welcome to an exciting VR adventure built around Gorilla Locomotion! Move using only your hands to climb, jump, swing, and explore unique environments with smooth physics-based movement. Every map is designed to challenge your skills, helping you improve your parkour and discover new routes as you play.\n\nMaster your movement, reach hidden areas, and enjoy a fun and immersive experience where every jump and climb feels natural. Whether you're learning the basics or perfecting advanced techniques, there's always a new challenge waiting for you.\n\nA brand-new Horror Mode is coming soon, bringing a darker atmosphere, creepy environments, mysterious sounds, and exciting scares that will put your movement skills to the test.\n\nA Shop is also coming soon, allowing you to customize your character with a growing collection of cosmetics and other exciting items. More content, maps, features, and improvements will be added through future updates to keep the adventure fresh and exciting.\n\nJump in, master Gorilla Locomotion, and get ready for even more content as the game continues to grow!\nless...", "short_description": "Welcome to an exciting VR adventure built around Gorilla Locomotion! Move using only your hands to climb, jump, swing, and explore unique environments with smooth physics-based movement. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OYil6awIx78q3gEQVadSoNJDWbfFUY-M_YO9nZvaXUw/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1OYil6awIx78q3gEQVadSoNJDWbfFUY-M_YO9nZvaXUw/edit?usp=sharing", "publisher_name": "Silent", "support_website_url": "https://docs.google.com/document/d/1OYil6awIx78q3gEQVadSoNJDWbfFUY-M_YO9nZvaXUw/edit?usp=sharing", "website_url": "https://docs.google.com/document/d/1bVedsnQ9U07rWjJYgTz0LqCorPWV9WahMX1rdbvgmUQ/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
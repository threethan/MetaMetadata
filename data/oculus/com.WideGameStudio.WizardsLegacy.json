?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5bzEgw8TE8Q7kNvwHxFdnq&_nc_oc=Adrh-NnJEayeyyzERAFoGowBSkC1vz0u-u2-RH8UG6-XMPErDeGvmOsVKx_K81mudI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5njmkHJ-9qTx9ws71JEYe0WcyMMZUtMgLMnB0DGXx_Hg&oe=6A1469F6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmFcpaPwVMEQ7kNvwGC7MZY&_nc_oc=Ado7Fhos1XMNnaRK6HYGaVJiV-4xM-klL90JzF2f4yKpNUy9aNO-XpcYFvkV7xahh60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XlKbA2-fsfvl2Ul2N1JH2p-ZKCAHO-Q3n_wZXiKDAUQ&oe=6A146EFC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN0zLQE9O0MQ7kNvwFwg1Ya&_nc_oc=AdpfKjBmphP5gNWksUgj7GV_9sZ4dC7ZzkTN9OkItIVCIwc4PB1HaK4WWqIZfyb3S3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FQjfMrqdkQDDhDAFua27wqS3GzxJRGfGUG4_dLQ9YEw&oe=6A146097"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lx8DXNBqhQgQ7kNvwGFPcfD&_nc_oc=AdqE-G1gvrr9oEHzoH9W_mCkNWSMoeVlyGtSb9wj0P7wvU8jCVx3cdTP3hvTWa-bg70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uuuST9W7sQZ0H6KaxrPXmQzvJiZcfHtJxjm9A4fQDBA&oe=6A1453C6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPv-HCK3vK4Q7kNvwHdqIyo&_nc_oc=Adr60mai4OLFrNFN1JCgUFlVlmtTTTzTopTWk7qPNW80k9isNbiVcoVu0OGNeQYoK5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nglK2FktEOHqlLSdnoqcDvSdxkU0gwE96Jl0ly2azJw&oe=6A147183"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZpgnLkgXdgQ7kNvwE-sO66&_nc_oc=AdruLaZxM7JIAcDz9jpbkQ9l0LIB1wiVlz650NG6ZUxVz72yZi1vqf146qgx4jep0MQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V_pRnIOcrqudW0I8ACRHNMSCfUC8I1XQL_6NRSIf7-g&oe=6A147352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUWsoRuG0VoQ7kNvwFOdmFl&_nc_oc=Adr6lnA0GysvrfzwLkdca4R5WXixfPYl31rQnu3d2kuYyEKQERmF4V5GGig9JNmMBFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fgtUESV3NMYcFtIpzJ-PnHpqVYDueuklZ7GdWV8ESlQ&oe=6A1442E9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pPLPlOgVKMQ7kNvwEYthux&_nc_oc=Adri6rwM8ogDd7V-tog5xUoSDnqyuSw5mVsUXa19LEiy1DfmpIW1PYeV27kM_8siuJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ls1HZbgswe6AqcH-ruh0PNgRPCMSG5g75WXyANNDfQw&oe=69D39836"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mv2v9lmolsQ7kNvwG9GrBc&_nc_oc=AdrWjnfRSuOMTs5P_sR3AOw7cYIzbaT1ueHNjH155cpALOGFoxghppsmJIGWNxd-Z_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sW4O7G7Unifn4oI6kgIdq871nocx1zd5B03XTVWnk1w&oe=69D39D3C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CrKBUyLEhEQ7kNvwE_fuhB&_nc_oc=AdqrX3B1QNsrmO-R5fHpM3_YwuEdk56O-Mn-CAQ1RANQ1eDPFMVxMPUSgtrVcBTHpgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zHu2lGQXQ_hfEXuQzIe8Xoy8ORXfWMrKNtOse-Kw2jQ&oe=69D3C717"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYptrvTJSOAQ7kNvwEaH2Z1&_nc_oc=Adq2A0t1tRIAIM7qg3NxzGHAxvbAEV3HudY_kqfwM45xgma-_Xt-sp3VCxbnEvuK-zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ztguCplrADxBTuxIYAFV2le8bAIGNZ1PIM-HFSVlQSA&oe=69D3BA46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VuEdj5aqOgQ7kNvwENkLXE&_nc_oc=AdouoXhHWVGl66VvUDVoz_gA8TW9kk3I00zFj9hEsHQbfOY_-2eXvJQEHhq6mc-aJhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01HKDHk0bnU7g6rQFenguL-BqdX9CX5W6vQHxNB0Dgng&oe=69D39FC3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1blskvHnmnsQ7kNvwFuQUYV&_nc_oc=Adqc8L0DRZfXRsz8OJmfLJxq6AbGy-vvlWcfIHsfAK57seMlHxvrlNvu4sMY-GzxJ90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EiCYNvaKsCwiAkD1dpil2M3nImOAZBhcEhqHihnzH4g&oe=69D3A192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAvoTP-_UkIQ7kNvwGeIOAH&_nc_oc=AdoqO8Ua10xY2LUHugSyqQd50MN2sCVEOojfbn67bPLHcmRTi3OyuLCFlw-gMeYPPdg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oT5NT8vAHTajInvyb3nspATqhdCphPR-w3zJ_ZDaIQg&oe=69D3A969"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp_UuncR5GoQ7kNvwGeM2Vq&_nc_oc=AdpoRQKGiJmMEkgSwmHD9WYB8aTqHpOzkXqNya52me8NKQpbTXED_Q1uPg2TAw5MPqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p0wKdrImbi9Rpi3GrJqWtzEQP4kWCPBPSEG0Os8sZIA&oe=6A47D97C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvOAc7nUmsgQ7kNvwFcHAaG&_nc_oc=AdquOVFHzQxm-k102BgFvAYA5L-r10oSF1A0TSg1RNlyzCeGsCWTvk6Xk1HKTbzUCbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FANYzl3gPOo6NzvjFwQscajMHTEhtu_beS0fiSzIYKA&oe=6A47CB17"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B_MUUeH9JwQ7kNvwH1atSk&_nc_oc=AdpHb4b_K18mPgcPOvl8xdJzHzWpSoINI65pWpQCJMXTp8BPwgvBO11Bu1H78TB9fbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bUfrgNhc3N83oVmEVhJXsQvLX46x1thguDdNQhL6Bag&oe=6A47BE46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWeJde4nL1kQ7kNvwF39Y-4&_nc_oc=Adr5EcfBMH4-CrqesjBN1Aeqy2uht0VMe4vPnkl-H4-nUvaNedkjlc9pmw4715yKmAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A42UmCfXmFOA2xNQrV59Aj0xh3bSMUtjQSbwwRys-xw&oe=6A47DC03"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI1OuMwU_jQQ7kNvwEjBB3Z&_nc_oc=AdpIAPyo5RefE2Rox57883iujPtl67z6zpolClanzG9QWKWshYsVV_42NIi0PH6pjqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81hCRhAzC1rPJHh1VV_9sEZvSUzOEG1cuF0W1nV5fYkw&oe=6A47DDD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WIZARD.S.LEGACY.COVER.24.BIT (1).png", "id": "794564832812199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65228545_794564836145532_348548685399172447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myc62nDG2MgQ7kNvwGywvc-&_nc_oc=AdqHlxhbMmBkxR7XTPGAb0Gp4zdnr_bTzWc1bH0l1kQ63145k9nmRcDpSjT3OEjU0ik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y9BotKPmak_MbnnN09Ic5AcXoJi9Y0BJcgSk-_wD-6A&oe=6A47CE62"}, "display_name": "Wizard's Legacy", "keywords": [], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7194998533946539"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2074793316776992"}, {"status": "PUBLISHED", "id": "848841221006147"}, {"status": "PUBLISHED", "id": "754261936940022"}, {"status": "PUBLISHED", "id": "562859070203900"}, {"status": "PUBLISHED", "id": "1307469717224054"}, {"status": "PUBLISHED", "id":
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmk9pf6U81sQ7kNvwGP7RiL&_nc_oc=AdpsFJ1Tke_ShtYQi70Eh7Lt2hM6fEojjcb06tuYBDRkorhl9Tq-IWnoUpotgQDIFUY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BuYnD52up97AEFP-Uf8nyxC7fAdVEKQI87PSCxDi4Pg&oe=69FE0076"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qtOizzYlggQ7kNvwEoPQKy&_nc_oc=Adr-zCgAvo-l3UET_Xae0-C2hYgC2aqTn7Nzd-z5fJfnKX1qWbfJZNuIE1VIYziA4Qo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xC6tYWrRX8UnDUCobZ-q9ENAHUuIA--qgjQWEU1mNSQ&oe=69FDCD3C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x54ducLcBpwQ7kNvwGJ9wEC&_nc_oc=AdpwU8oBJQ5AFOQbzfbUzK6pP49DhtCX--OaKX32TuSSmVg1d-2pEJU2GBrN7Tqki2g&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mOFWhZwEUxIT8v-wbBM1IYzpVr5UM7ueesdwp5FE6Vw&oe=69FDF717"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1-wAFGHPrgQ7kNvwFyovzt&_nc_oc=Adqk5OOt-0A7gTpyziJ4w7OgZV0JiQ1czGJQeBGuPnFkp15ysaS2g5m_lPHHGWu8AeA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zkn9mMinZtymk5UYG7a0m-Q2VhUF8vjxslQ5QJBehwA&oe=69FDEA46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHVY8kn6kU0Q7kNvwEMTbfe&_nc_oc=Adq6kJWuYbmWSDqfaD2tt3xcsDRu2zxTBPwyCgZjRCNmG8Wfr3oUXsVAjdb3l54ySWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YpsOkCHeJE_vvMJ9ryLqjATtFbkRpn5fbKjCRyF0Q-Q&oe=69FDCFC3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TMPM2yN9hsQ7kNvwFWw47Z&_nc_oc=AdrIgJTEn8FMjpl23YKhACkSqdcW2xk8AcrwQJ8FVPYhi7Rk7AUyAWNiyJ9-nJM2ppo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KCtpK-Qd_ZRS5YrUcg4Hy2B0e8JwqX05wq2t7U-c-Og&oe=69FDD192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CrGGiKbAEgQ7kNvwGcjCs1&_nc_oc=AdrMwek0VoGJtO2OrOYdqOEjwSNj9gE8mmqJ_nBqj7n-3iLPbvtBPLeZ0Gn40nyAjNY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RnTpUDno54jQUL0aLYR3DKfxZXFZTk6joPM5LvWTWcg&oe=69FDD969"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
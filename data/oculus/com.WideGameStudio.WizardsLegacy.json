?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSXANV5r29sQ7kNvwHQVL6X&_nc_oc=AdpCoN1REFXFQWIONwiZCidjjtMBdsd-FRQArHXCnjTnFibJZNilcnsSsj5A1LV-bao&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IvZ5A3vhNBA10zRqqNAX-lupiyXIyONFDmExUq3UErQ&oe=6A107576"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwwo7_bbeJsQ7kNvwGR8-wT&_nc_oc=AdqqKMPp69mLcDjRR4Wsqol6Lh2g3ofxol9Tee-v2W_BUDdWkmu-FNT2WNftK0mleKg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vDWTHnGcbgkdJaDm-yZ9vzD59cM86W4kXqTMvVQeE6A&oe=6A107A7C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r17NQ7sZxUoQ7kNvwGr6Yln&_nc_oc=Ado2QhVY0x-PovhCu4mYrsNA12CLJND7G9hAoz0GnVCKtTKfIeFGlwmhV_i0YN5L2VI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D2l9MMhgj9TI5iTjoGP9TyxDhikOV_PDe-vHaX7P5Ng&oe=6A106C17"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7nnPMFpvYIQ7kNvwE9FD0n&_nc_oc=AdoZuLNozQMWmYY8cp3yC9CKapNqBWx8NqplS-ME3LyJF9GtbINItJ7PlAU2vM6-r9w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MK91gUWMfhNQG9Y4RauydEQgS5mH_0Gr9ZGQqyjwy2w&oe=6A105F46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrWy958EEhUQ7kNvwFHHjgk&_nc_oc=Adr2u1ur84wAaIHFywMVE4e9J1EVG4j6i6fdK3i3EAibQnXajrY8mvK5iATKsh82AVA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uIOaK9Z9584SU5AjfdZpkVIkw36crZk7RmpQE4UL3nA&oe=6A107D03"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjaWFJykB2kQ7kNvwH0QPAL&_nc_oc=AdqGbrI_GVUGkiwGaEX-6jKnkd2mOXUvAfXO1Q_qY0qCd3MzOdVzbC16aTj3DrEZDBo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GmCBsb3nihRyGJFOCHNWstyPW5E7v9gmG7a0mNscWCw&oe=6A107ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHXxj3fcMPIQ7kNvwHysZl3&_nc_oc=Adph2oqWEfAmM66ATswsFgpC7F1UeJhsX3MMaaDeeyUdkyfKVdapWuLLNvxSmqMvO1A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SsF1kkzYhEERj9DnA2A8UbzmsxmPVAi4rgR2KtvYvfA&oe=6A104E69"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
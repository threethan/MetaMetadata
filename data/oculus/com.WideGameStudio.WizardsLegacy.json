?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3eJX3TBCpEQ7kNvwHzDDMl&_nc_oc=AdrpvNrAqR4GyeK3qfT7N8P1STQ3yWmOIvIqeXfxPbZHwF18nFlVnYizu2TodLoVBdU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l7Uem2NH5fZJTTbaZzC58cJA7o0GK1zGkDwaw2htesA&oe=69D78CB6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk7ExDDkuq8Q7kNvwHWEi77&_nc_oc=AdrBzw3myz5raenu9ZPRWTFVAxXPwVzZ5GLexngqSDgw8XPbpl7IPrfUByx1SGD8P1A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34jXxpxT6IrGxvtDdfDkcuBDwvVyyLKojOsktTg0i5sA&oe=69D791BC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBTZAHOrhyIQ7kNvwEAIKVW&_nc_oc=Ado2D4twJhF0Szp2h4X56jBMcVub05-Djxobkdryhti71PxfdkMl7ZcsVeJF5grJmXY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b3cgjq9Dg_jHBcy1XPDYnuAjH3UiFJH-cnbzIbd5WSA&oe=69D7BB97"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0jgmm2_Y2wQ7kNvwF5OwlK&_nc_oc=AdpudtUwnNh8MeqoJ-SUf_giuhM2XRrQ7xj9kuuB-jd9ltLd4eRuFQKWrnJ2FGp8PRU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N-1GiqL97qnABa-jQQsxpHBBk1P5B-uhJ3K4yTh6fyA&oe=69D7AEC6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsWH2-UHJVIQ7kNvwE0wUgR&_nc_oc=AdodkVx7gtSJX4-3avLqyy6D0J_0aHMFO1-Lz0m5tGphnGxyRB1y4Kul6DkJzTyEzCc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_hkO3qlhKzCmmAa_rsF3LfA3ReonOYXPpd6o3iFPbIA&oe=69D79443"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbTQvi5p9UUQ7kNvwFwYvkU&_nc_oc=Adp7zBrz0f9na8LJDSbe44NADAcJlNMf5YBFhkxr-JSXvFCOWfYL2NMYNi00ILvAufw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oH9NaYUqXNqNrvMILoFEgnkTLOIS7jA0SVFY2SWlMDA&oe=69D79612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8THLS7OS_0Q7kNvwEbAKDq&_nc_oc=AdpsJ-a4dpMr4d9PN44XW8Vo-29aBpSV_GH1BnnpQEpcirN-o-Kum5PLdzdkDlT_z5k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n1ASvNV099UvBh8kFS1V5O4ChYM_pcH5WmFe9RMJw_g&oe=69D79DE9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vziQMZuKFWIQ7kNvwFlmR2I&_nc_oc=Adok72BX1BGsLtBgEZFhDKpbFU7nJKSKGOU8eWjiOYYz5Q5bRgmmTk_D3Bt--OY1tKA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NAsDAfaqS9oZ7s9S44qTp-KV9QJOCOrOvt0Tp8PPJZQ&oe=69F37476"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFnZRAAA-foQ7kNvwEhuTWh&_nc_oc=Adq3KIr2JN54lrLuFFV8GJeYJgmscM1XUiTmA01nKmCoY6c4a_4ibcy_UWh1gAEEIBE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pCOgz7HvX1U_IL9rMEapfff6Yg2yJXsFt03_TiZ1XWw&oe=69F3413C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIRWkcyKt-sQ7kNvwHZdTzj&_nc_oc=AdqQnlVxzxBFGrz0mce6XuW2nlQJ7Jr6B8v5cHHRAuQlXWBcmyGZWz8OX2IlbitZ7Wg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2esTHx7NKfk-hu-9ceEu4JiUzn4SPlR9gRxaJCbE3sog&oe=69F36B17"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjJQiGMPOZ4Q7kNvwFUxWw8&_nc_oc=AdqR_gL3FPLE6s6E31hJEwrq-hlCoplGCK2GKL6aYXlfAsS63f7BT17Q1ydlQMcOa7c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2biFPvfly35iLUvYpq9f3oEwNc5Y1cgx1WSvwHxXLVOw&oe=69F35E46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdVQrYqTqIYQ7kNvwH3EDPd&_nc_oc=AdpEnhBzP5h6R8M86h5wJYkd1JwY7ysxlnG4DZ9fi47jDCQCXatZaqxy8wmDsifWa6E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Jhxz_QoyeJSJB2-uIUQl1ZdGXUQt3JApTE4m_gWjWaw&oe=69F343C3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj_cfyKz9-4Q7kNvwHTc_W-&_nc_oc=AdogDc7F4dc0JVVSkD8-Bw4pNK7KzfrLJT1oARO4unpUH88HqYT2PQ3vQQ4Wlwe3DTI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03RxgSwyxEFUpIsDIhMaA1n4xcZUqNfBShQfyErUjeww&oe=69F34592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuRvxBDT0NoQ7kNvwGenPIr&_nc_oc=AdqiWhgu3QqGhR45famksxR3ZYYKjlWAPJjKfLrvKnLS_TEI0uHphgcwFOVNb-1vxzY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qpETEN-9_3uljZoAGrDj9ksNSLKyG0YREXf3XRrWo0A&oe=69F34D69"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
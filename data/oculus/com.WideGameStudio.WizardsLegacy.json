?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mDcZyb0tlAQ7kNvwEniyAH&_nc_oc=AdrrOxhxFVEzGzXGholzKeS319Uo9gs3snRRZFV7JNRVYFs7G_HxUjeB21algCMQBSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mEv1J78P1UeNNbKBOpVKJ4GnnYoT_v_7q-EIGlw6B5A&oe=69E0FF76"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-zqlbXFx18Q7kNvwH2ASiV&_nc_oc=AdqNbjtvtxuZguIzGjpEXYVuEDE9XJxfjBenZyLcSk537x82Kw6NoPHsRc0Ide1RLoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F0pkNNgTvQZmOIMOagckbWFWclA8tX1Q0zRL80rwL8Q&oe=69E0CC3C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dIyA-ykPg0Q7kNvwEU0zEF&_nc_oc=Adq5VF7Pn_sYWAbBtmTX421ff_XoSYvixlbWVRdm2TRe58CLy49mh3zrProJcPqWyHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08IQVCcUeWrjsa9oh-3-Fv2b7euUh1rJOhS6k98x3V5A&oe=69E0F617"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFU4w6Ym4dQQ7kNvwHRYK1F&_nc_oc=AdpB5J3gyHSjkdIdwS9dFp4kf_iH2w9Fp5OrZfqeB8qJOv6meEFtN9U3cnIN7CTaAlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pov2Z1l0Q-VlLBc0jBBU70-3sN_u4vXHGtoGsC_dV6A&oe=69E0E946"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hE7u8OgQAwQ7kNvwEG_PMv&_nc_oc=AdoUqW-ccrlu-1rAlygsNg45q0brsnIlg8z4tS4ck3RQE2alQN3Ok_K6BC7fYbeovRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XYi-jiLN2zqEykOLJBGIi7KDUkBPaSMAKY45T9lgvlA&oe=69E0CEC3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-gwzy-_iToQ7kNvwHwpL_d&_nc_oc=AdriaEuC-QTncu0vnnRLtuHfDaHhfwMqy_YUwM6KoxTl2qkKFGfH92ME5sNAMdDCugY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wgs84Y6pd4AwiPBKEvuYHlwezzZ_yBOF-RpU4Jh8zaA&oe=69E0D092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlag1RdaI5gQ7kNvwHYp9ZY&_nc_oc=AdqJsb1nO__cWXYNXkT0yZYkcf5BaYSEC44nL572lNcnVfkcdNiNF-B9TYIsU4-QvJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11QVJ8JsAeg27JH9p986xVJNyUQBRhVFoLHjaglntsJA&oe=69E0D869"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxuN97EeH9MQ7kNvwFOzFkZ&_nc_oc=Adr69No_JhMVO1EZcuSTgeSAEkrnFnwFDLdDnafllXKfPi9wIjqZ_DdUo4Y3IJaYLQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fgKvD_jyt0HZ9IUYffhciHPuu_ielZ71zV6kHIlKl5g&oe=69ECA4B6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSph6R1fGdcQ7kNvwH34Aj4&_nc_oc=AdptitP6WitRTEty8YC7wqcgsjz63dMZMwe3JltWXg6pnF-9e7UdRE9GF3-bl8Krk8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MapT4E4ZahQC3LdxiD3V0As8v_S_pk6Tv_OKnFKrxXQ&oe=69ECA9BC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Vre6_whJZUQ7kNvwEKUzRY&_nc_oc=Adq7gzYEP-9HKHqoB2pLnmOOIBYcSPMMbRxfoOVtp6xzbhbucd3RF527FNn5cXc-0So&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kX0sGwjMxzPMNV_udtTtpeUYKIUm9B5BjW65_iUvTTw&oe=69ECD397"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k8JX7MHI4EQ7kNvwGXikDb&_nc_oc=AdrLdSGDW6wHeubvBrTSMZyZV65N-hozCHxAZETflSCCWIb4K_w05GIxELOLD_Yj4KU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zGPWRpQYyIoVfHsJV3AI40dcZdAvJkx0Oa1W14RPigA&oe=69ECC6C6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwu2AO8BSQ0Q7kNvwFJHsF3&_nc_oc=AdoXz8G0kReFs01HOga_EXQz9d1Oxi9-xIAWK0dSxZ9NLprhMr4zJQ5eK2xelKk2nIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kLL67nhL-GVRzpY1uJltU6o1EkbBrDZGcrkXFhoWcEg&oe=69ECAC43"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYsRSdMzTvAQ7kNvwHplb7O&_nc_oc=AdpdlK91xFS3HBeT_eKO-1swgj2KPF9a1c3wHRZfD1hvynvSv00w12pHlLMrDKrWLnk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IeGp84vVqN-ic5iJwx2xJNV11o28I3PV99x_VINiI9A&oe=69ECAE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=790Uo3yBrDAQ7kNvwGxtmWz&_nc_oc=Ado3d3gwdiz5Fb7mBGjHza5Q4uWql1G_vOZu2fFYoUVRqAAOQA475897RiFfsDp6iWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GcA_QBgfFG-YGj8Ylq-bg2s3_fdefIn6_LsHLdZ5H0Q&oe=69ECB5E9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO6GN5iexa0Q7kNvwG-je4g&_nc_oc=AdqzDMsM_7VXEEC_SiOvG-gNyXlSwf_PbOQCJwvFPkaKslSwQzSmNhtrph8uNaNuNhQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PPDEboRMXqo53b3dv1gbjCO_Kh2S1AmxKIbt4hlTOeA&oe=69E64576"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhlt-jp_YesQ7kNvwGOJDnn&_nc_oc=Adq_BICyhf_XsKsr9KQUJ1tWnQ3DcCKVKE3yE2MXYNE1yJnDKJ54sipQVLgKTJ3O61E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LKyvF7JmPbXUTHgnRKi0gHXTpyz6GuitQ8NMBmqzOLw&oe=69E64A7C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neEPt6UPIBAQ7kNvwGjQi0h&_nc_oc=Adq1gpP4Oa2u7bhDPYGjI5c74eWG_wS1CvJzHKhII58IX7M_Z-cmCTOmhPIbnDb6_aY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SsJJEtG7HXB2_n3ExAPnvoBeJgnVPck9Kksthsz9_xA&oe=69E63C17"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEMCVIGF49QQ7kNvwEHceiJ&_nc_oc=AdqiI2pFhiA2q5ZBblaq24m1knOxn2T2XEMNzMLrsvck5P8n-0tDbAxj0GSSz7lnxHE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RRsJs6OXM8EomRwEksPjT61n_kuWFDdoK6DDh5E8Zaw&oe=69E62F46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYpYMwAOVXQQ7kNvwE0EHNb&_nc_oc=AdqiE8NYEADEyaBgVFp2DJcj6IqpwrnFu3V93z_iqf68QIawsXprq5lkNKSmciiklVs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i8nQiBsJpuwSUZmhqcJnqkm7TBC_GfTd0aAmxb4i2aQ&oe=69E614C3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmVCTE3IpHwQ7kNvwHzPZwG&_nc_oc=AdrkJhWuKgMXKuujCUv9N4WbwzsgMExe7rKcNzwd4ZijBIvJEDeNwDUhepJVuhY3mFE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zPg3vvYPtoA41jYvA9OR0gm0RGJwhcgP1iRYwx3MS9g&oe=69E61692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9u3ba9M8fEQ7kNvwFYkv3g&_nc_oc=AdprubtcZIuz4L_2oKEP8E7Gwryc8wt3tHpVgmFYyLDQUTXW9SHv6NYiEmktJNTjh9Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xAg7sL1mfW8jT6YzOZz4e3c8PpLynQof7L0Cc2OthHg&oe=69E61E69"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
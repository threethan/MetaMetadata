_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75254869_238021309374377_3088549895855860287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG-ORL2SjNAQ7kNvwFeOYm2&_nc_oc=AdpYfubKDklmn6O_qkbSFsJA7PR7P4zllQB_uHWIJWaUt2vzAoWUKkSU9zlzjY_f1tc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85qhrU6cfXKdDcqWdSvrNfxDJkpkeSx6HwcsA4qUrAIA&oe=6A4682F6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp_UuncR5GoQ7kNvwElzcMv&_nc_oc=AdrqoRLhHVEPNlueIAH8CS5gyzfDu7CdmrYlcmpi1lWctk7CL9lBRnVSg0bD47QOCI8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G2oU8vqjlHWdMQRVbPct3NepRSOC54tlvLjpFIt_Zsg&oe=6A4687FC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvOAc7nUmsgQ7kNvwE1iHJy&_nc_oc=AdreFYsWcgir2eISdBraJwdeV_ArTLFI1QM46xW5BmuCf0ePFELKu59FHeNklxo6yPY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91QEhXO_fj5YDTBhwCD9RVhgBGipPs-Pdcg8mp_NUoyA&oe=6A467997"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B_MUUeH9JwQ7kNvwGN9a97&_nc_oc=AdrLnld0vA9o7hfWiPKnmtSTQJinRTeTM7dq23SoOw5lOSppUIy8bn-JRXJGdDXkElw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96EL99Za4kwEiAeGzhlAPpdSVvmqlN65CtuBFWcpbRUg&oe=6A466CC6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWeJde4nL1kQ7kNvwGLXPtS&_nc_oc=AdoUABG57_YNWKWIrt-DiFzcRz-tNGkwT5f5ooeZI_KFadM8nmzd9viKY0bfWWLD1SY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FzsTVqnxfbANRayzHR2bRyYKYn0xa5AtVQfAaxFZ65g&oe=6A468A83"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLtGRp4la5oQ7kNvwFz48UP&_nc_oc=AdqFuOUNkbdJz0jyAypIkwD90Sk2qTBFgRNiIoJ7xrFIM5NI77EfxoxVH6kGVd9An14&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2gkXFZEudNHNNOUBoWhebdHRSYxuhctrtxKAw1QYXQA&oe=6A468C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0I6FTAnTIwQ7kNvwE34GVN&_nc_oc=AdoDOogOchEVxdtAE1KwMwtFR4aflW2rzk_z44btSAJEZsb_S8p0el6KY3EU20Md1xg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FgUesNF7aibOulDVqwQCwSZCQtCT6JcdajrEfLbcvSw&oe=6A465BE9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
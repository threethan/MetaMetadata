?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4FFiB8CXWcQ7kNvwHjtv1k&_nc_oc=Adph6FY49M9TclMKpVZCy_sNR2tubArSyl07K4zcm0DeycVvDOKWkuAujurAazQmBrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi3-4lW8aapngXjSo4jLakk025lIRsBXXe6CFRf7VEkQ&oe=69CE5236"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw990PPKkUUQ7kNvwHeK55p&_nc_oc=AdrAUNdMk3cRHM1kJB1CoR1keCbOnkSI4dkK0JHja9-Jr3R8bL53ChL89f0dNzEWqyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx9U8JJVV5MJGxBuZ7Il5VG1zFBgmU2y1UBzZ-MWIYgQ&oe=69CE573C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-clcayyL0cgQ7kNvwF3auhF&_nc_oc=Adqe0MuztXEz45vTCCaXRTbfDi9Ou-aoNHfsf9kklYqGX229YGimSHeoSq2BB3RTfl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9HfXKut0hT5f6Foz1URoPxVrKv1xnPrLUwGGaQekgWQ&oe=69CE8117"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwb3IxqjQUUQ7kNvwG-DxuH&_nc_oc=AdqlTtskATLXNKpDgTfb-fj-w14z9KEMLHsUdAOyV_2H04LJ6ECmxEXn3ftwIuttxpo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr9YlXd7Z9aEhg8phXF3w3kcUfJNhrUP2l6t4z0haqeg&oe=69CE7446"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Iv_VFmQD1MQ7kNvwG27vS8&_nc_oc=Adrr_hs6BQGk0m-1bf-8WayZWz7Z1g4XLVZmJejLixs4sFCbQDF2S2Ip49OOiOIbcxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzycunNf4UQnsEwwd4Ol37FzrDuo2Ovp6XRRop0ZHwfgw&oe=69CE59C3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqIPNWB4a7oQ7kNvwESTHdQ&_nc_oc=Adqpo9DC1Aqqp7_dBS9dgryWPAt4UXg2jVdEfP93bhlVDeK7EtIe5EqZnKBIygmw4k4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgZUxRNMqGRAOcKeSX1JMKh_hY73rgxCyo3YSs01BTUA&oe=69CE5B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY3I1eqMtbQQ7kNvwESIGAl&_nc_oc=AdquhZ6cgHTsBsqiGmhAwXBaKvDjsgdxmDq2rLHBTwk82gUIAX51aLhK_cSYYTMsMUg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4I_IIbUpZZEvc67gsz9ImfANPgWUo9zMQuT-RJkOiJQ&oe=69CE6369"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
: [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sj8C_t5MZ0AQ7kNvwG6OCX0&_nc_oc=AdrSLj1xHRFWQ3N0lbVhNWVNCcoh4anHfQyv9GLZxN9CJ6zfKod9OwVR63TGhWo4_3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjAL8U1zB7mmmQbvtiBX0ZmW0RqDiJ8lZJivnapDLyiQ&oe=6AD0F57C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fcBe704DD4Q7kNvwF3H6aE&_nc_oc=AdqCcU9kG0GwaQwwRkN9Hg7gwb2O9lEbeKgRiIT2u2ZwoyrtFU_AtvMs0AgxJbnIpRg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCHWrWLvHrMpWZeUrolcjZGvDgiUbmTfvGUnWK8QmlAw&oe=6AD0E717"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjQxC6LZnxkQ7kNvwGQJsaa&_nc_oc=AdqcZxxCppHd9GULTj2FlfqhFdFms9yBtcC8d6zYsIsXHVm9rbk3Uf2bSfl5nEX_Nn0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM79d8EVNOYm7a8gdsiOZ1vU8IpNgnPJcpjoFQ9-X-TQ&oe=6AD0DA46"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiiS6hqVjxUQ7kNvwEc8-K6&_nc_oc=AdrotSfED5OBB3E558_nZPrQdOYT86vvwVidaKLblUkj9EYwxfz_dP52bHC4HQNGiLU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmMCxY1vP0_CxnQvx-kLqBqTb20hkNR2IaC1dHdnbCUQ&oe=6AD0F803"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ06ZQAdP7QQ7kNvwGJkcPx&_nc_oc=AdpAm-lt-kpXFGW8sXQfUCL168-FzWPtkWHWAlyHKRLbXlEm-lUxEEHFraGTEcscaTA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyY7hgedRLnOhSJBR_2oKKfZxepc9vlOKQ8QKwk3Ov9A&oe=6AD0F9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WIZARD.S.LEGACY.COVER.24.BIT (1).png", "id": "794564832812199", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65228545_794564836145532_348548685399172447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ciy4Kx5I-AQ7kNvwEfbEEv&_nc_oc=AdqzrqV3Pkj2cU1J23iEvi-Uhy-FeqnDEVqItyXaLxxORePTgBNeJ7OJrXbF16vfWbo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSg7NGdDDe67NpvbrJm4yRCA2IBXFPTWUQaJgVRok0cg&oe=6AD0EA62"}, "display_name": "Wizard's Legacy", "keywords": [], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7194998533946539"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "4492311767692745"}, {"status": "PUBLISHED", "id": "4661665990821334"}, {"status": "PUBLISHED", "id": "2074793316776992"}, {"s
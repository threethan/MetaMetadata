/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmeeZ5qY_CEQ7kNvwG2LI7p&_nc_oc=Adp0YQzA9st9hg4nyYjdv_O2eW5Kw6MWRifO0w2xnJrt5YYEnrlculZ-AAMpx0zezZo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRFX10ZOprGB_21KvU-NjC-7p2V1wCk04G87UB5ZH4zQ&oe=6AA4227C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzwdP4KGXtwQ7kNvwF2lJlu&_nc_oc=Adrj9cn9A1AWN2MHvp7Vuz2rPkKOiew20ZNVq3trjyz62jM9I5FBxUiY6PKYceZ4GZ8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3EIfYHggO6KW_1c06W6cgiJ-8wNzXqpMUTbgP_Rck3g&oe=6AA41417"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-HxQ5WnHhsQ7kNvwHmEK6I&_nc_oc=Adp2TfJniVlxJgHzApQ33Hlx3ni0u9qWqqmvOZnY9Usmmz8F0ShW9fAwxY6voXw74Us&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnJ99iZqvNtOFX6vJvxpF5W5gImyqw6NbIRegaxxbj0Q&oe=6AA40746"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdixaWGAGnEQ7kNvwFV2Kp9&_nc_oc=AdpxmK7JdY8qO1Kt7c9JJknjE1B_IQHMNy4w8zOFSPhMdPXC2loE2BIVNclSVHfIdUA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMXLrhU6x8eBRpsDdKVzRNdj1UG5Xita2Ot2y3eksg9A&oe=6AA3ECC3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q_JA1EOl7kQ7kNvwGURMNW&_nc_oc=AdqSgcHo4VIoKlLOknCec8vNbFFOqsixmcuJhz9jlc2UroCo-sTJ6xC0h08kIw0g7C4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaa3m19txMTAkB8BR8g5f3GEszGKdlVPHOE3IkdklYXg&oe=6AA3EE92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WIZARD.S.LEGACY.COVER.24.BIT (1).png", "id": "794564832812199", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65228545_794564836145532_348548685399172447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOAd06tGpHEQ7kNvwEoI6Lg&_nc_oc=Adoqb3h7-jA6YNvrYlHm80XEuHrPlqNU_kfl8NOK6mFEhaqXDJVaELlFtgpKFRej9yw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6ag5TLtyL0aQUUCBgUK7KTP_c4ghatFhpOVUU6jCy6g&oe=6AA41762"}, "display_name": "Wizard's Legacy", "keywords": [], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7194998533946539"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "4492311767692745"}, {"status": "PUBLISHED", "id": "4661665990821334"}, {"status": "PUBLISHED", "id": "2074793316776992"}, {"status": "PUBLISHED", "id": "848841221006147"}, {"status": "PUBLISHED", "id": "754261936940022"}, {"st
52_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX8VEjWX0z4Q7kNvwG1Xf0U&_nc_oc=AdodG724eTKX7rPi2oW5sa4I8w-mHzeeRAgq47yPxxIn07BJaKV9awh0juUsEk8_88k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OUOFjAszGROwDdFd4kA-W0esNA6hfEebr1IxCqEx_TA&oe=6A42937C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt6_AgUzW8MQ7kNvwEFJ4w8&_nc_oc=AdqRmEOqYHCahOkYoutOPF2md7DJebOClpqVCfHtlwDh1hZIGQEqSaYN3W2T9-joF5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j9lyN6sikl9QmkOVy5-eK2yAAm-ZeEehhsIuPfrC9Gg&oe=6A428517"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06thDk-nd6QQ7kNvwEocd6F&_nc_oc=AdrQzA5hhtU37okIMMWYu1vXuZwVup27YqPeHrVKC-3Wm7p7nAs4pZBEFv41VcaVuOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wXUyFKV6M3I6VMYJATqB1kAWBvP0ynn1H5De8GSE69A&oe=6A427846"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7WVd8n5FWQQ7kNvwGTiUYg&_nc_oc=AdqRW8t1nenmTMO4Hqtti8akba6a6d2BCRt46qnUC4TE4ZHrsq7G0qZtE_13fO5POLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NQsspzqci0FpuZ93JFu4wcizm38pTecNCdtR4zJIn3w&oe=6A429603"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVCiTYgI6TQQ7kNvwHh3S0U&_nc_oc=AdqEWfbNqWCmP5EnN12ndopmxq6HH61rtUlYIK7m4n5_ImiQ98oBScz2qP08FVI2rRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Iu2bo71waCJj-XdyHNDTmSyiS6LuKy2eX7JvCueW1A&oe=6A4297D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WIZARD.S.LEGACY.COVER.24.BIT (1).png", "id": "794564832812199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65228545_794564836145532_348548685399172447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_wMsfwxhGgQ7kNvwFRp5tI&_nc_oc=Adp9hiEz_bXz471WmyX1Hi8wEc_qWitWUOHq6bssr3wRFWhcCZdFmh4xFHgl1McFQkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YFyJ_nQrkHjEGHRot5tgzwokrPh2A5jZkfyj6HGsTlw&oe=6A428862"}, "display_name": "Wizard's Legacy", "keywords": [], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7194998533946539"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "848841221006147"}, {"status": "PUBLISHED", "id": "754261936940022"}, {"status": "PUBLISHED", "id": "562859070203900"}, {"status": "PUBLISHED", "id": "1307469717224054"}, {"status": "PUBLISHED", "id": "1645430006025483"}, {"status": "PUBLISHED", "id": "
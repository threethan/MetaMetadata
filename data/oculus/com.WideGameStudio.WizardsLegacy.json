_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75254869_238021309374377_3088549895855860287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00msE8d8vpAQ7kNvwGH2yQP&_nc_oc=AdrBRxeBi4sWWFtu06nyhEgP68A1ZglELgDHzUYwTTxur6VYqd8xyjMX9dI3sNt8uQ0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTssLlXiHRSCMyaOKzfYNmiqfyoQbSUzv5KyJ9MbmKzg&oe=6AAEA976"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecO6EnXAJ6QQ7kNvwFdEjNQ&_nc_oc=Adq-iVzldO0Ghcg_02-RyvQu24THxHxzfN2kN216TagXKkNts9UlMumGhG3CA9DcKjU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvVkhQ3PTJWqWFbcM8LG1Ha4FEqnYjDeFvBsv0raoAMw&oe=6AAEAE7C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaeDUBbJ_n4Q7kNvwHNzr0a&_nc_oc=AdqHH0EfKp7szR5zAatPEbiiQp_nL9E6LSEhd-4qhf1RJVRCyvkPOM_cv6D_iFHdgLI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0p-Bu6SnCFNV-hJblIxH3LmKKGduE3eNBNKRyZWZ65Q&oe=6AAEA017"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24t5gwrNlAsQ7kNvwEA6ARc&_nc_oc=AdrsNkgnDmUKwO5o8kOeWXzq1s0UxRBufesVx5a-Glox7c34mMcbsqyA1s31L-cKcwE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ7YBPMvRD4TmYEDIxdF6eB_furNxjySDPhcjt2ie3fA&oe=6AAE9346"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jx__nOtmVdcQ7kNvwHvb7AA&_nc_oc=AdrB3_E7pqx1KNWQmjx3KmuWz3WB_L8G245bbWK_9kzcylnIIJOSio2eBEIQHnkIros&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIRFeYRA6e1cr8StKGOuCJPdVTl05dDlT08_GeuvN5ng&oe=6AAEB103"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRfyOUfIqN4Q7kNvwGkpnTi&_nc_oc=Adrqg8xlipfEvoVQOinQZt_YHwr8a1ZXdrLj8eew_W-lUwvu-aPTj5bCKkQ-FuzkMAU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcfn2xuKtLKXj9sr-UNkWpfKF7myY2W7FDB4XpQz0Ugg&oe=6AAEB2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcLm1IT0FAoQ7kNvwEu7Dn8&_nc_oc=AdrtXTnwLlbWdWXFXNW2GP7zv9vMmnXa7cWG5Vv_xD4QcMhjXkBR7v_XPIYy2TIZtn0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI97yEfW22YBe59bGlHZZq1drj_GY_Ddk7ZWeSatcjrjw&oe=6AAE8269"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg_y9y8tkLwQ7kNvwEyvBxu&_nc_oc=Adp01ymW9qj406F5k4UJXk5zaRenDPNtoukbgD6DHBrOf8wWPp4u9bH_eAvAD_p8wrE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ebwhYt1Y5QI-8rjSj2E9i7HRWAYFiXp8du7EebA8TKQ&oe=69DE2436"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUd5ls08p1UQ7kNvwHy9-jC&_nc_oc=AdoNiVuCHO1T8m28Gh-G-_xS2G_7elojXgZCIFXhdnc-7GTn6YyjUP9x28YveUnd3zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RPVOR3AGr5h0tn36a43kyy-hrvQVJtKMZdDqWyM1aBA&oe=69DE293C"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dIyA-ykPg0Q7kNvwGQlE_p&_nc_oc=AdrWo72Abxc64Oul780JDd0AtX5DlOHtfosextpfXTcNFkY_5havpdnp6clty7qidz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_agkURuUeaYYCDStpbJVR4744-urqO-Ue0QNaju7kSw&oe=69DE5317"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgtehm3ARA8Q7kNvwG32FAt&_nc_oc=AdpiAV1Hnc9wU-aZJ--HgY2bT3h2KbUa7Sq6BzL6EPW1Z2pCm4oV9DwvAD06qGGRIUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OnWgFDqaD1OJfRq-tJOSJ0uAmxF6cMc9BY_a3VqY7Dw&oe=69DE4646"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hE7u8OgQAwQ7kNvwFl8T5h&_nc_oc=AdrrKfWXRC3lzgErIyendTBLwabU7O4r_WNt7T9_V7gTlmVpR1MSVT7o5BkXseDA8Kg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c_RkmxD_dB3Ufda7i2Wnb3znURP-aAJCobqXKasojaQ&oe=69DE2BC3"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-gwzy-_iToQ7kNvwF_lSrR&_nc_oc=AdqJNGg96Kklr-1487Bt6HlVAQDvnv33Hm_8LzGXwIDANP59wnBsMNaCaNpHHTZYpJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GWwK0aKOmp0KTaZijJG2_CrsvC19tOZ1n5AwYpyKvDw&oe=69DE2D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A5iANE2QNEQ7kNvwE-9wIm&_nc_oc=AdpgPT49XVHVp14WCZfCfd-od6FRimIVHrKHOBQGqUVAYpU8lEFmi6OtKFYSWnSmY8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vFrNLYRu0JN_aCtbSTIknLjvsTYuGOJ0iWjguFsiQVA&oe=69DE3569"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
: [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6m7nrputhsQ7kNvwEfHnSK&_nc_oc=Adrw-uwMYHcGDAyohPlTPPrH9kpuHocIOT1licrcyB1qk5Q9p0UcPhBG5okb8fsA4KQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU6uBuPbRWFIzBkVR0O5quv2Q09CP3bSyZGeNw5tqteg&oe=6AE218FC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZHd4S1DXjYQ7kNvwEZZUhv&_nc_oc=Adp4eLjjGPh1EFCfzR9nY_TLpItPyp_04jyyiozxjRXFCBIbjgvkA_LuIWFqyoVMToQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkoGgHGclY55hSDgn4QKYJO_0XLARtf3Y20D_gHiPHcg&oe=6AE20A97"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZFgo15sk1kQ7kNvwFJiPD6&_nc_oc=AdodLZmJyLEOOmQvdvhv5q-niPNNV9TsCW_wXW2cf8e0BscxnpFbk2QNdtZ8qR0xfzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM40nFumX0Uz0vBZylMra_k4-CGgpAfc2es8insUBBkg&oe=6AE1FDC6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPy8ibDaNX0Q7kNvwH7QEtG&_nc_oc=AdoiQ8r7dykFTnNRBKS4o83aPXB6avPix6DFPj67KO8_F2auq9gyBpR_xgzkiaOoPsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp3e3vWv6OcPqszBAWyYywuEkXORp9pAcorHetnClUaA&oe=6AE21B83"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POdlo23vmlYQ7kNvwFHMf4C&_nc_oc=Adq1wASGj-SGvno5Y66oHgrKzmfWR26zU9XQIQpGgjOjR_7YWsAtqfEI2y_aHei6caM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlT1V6BHfPhsIGMNtnSfH2pCQQUlEUSWaiwQhPpqRBxA&oe=6AE21D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WIZARD.S.LEGACY.COVER.24.BIT (1).png", "id": "794564832812199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65228545_794564836145532_348548685399172447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwyhMwBfPREQ7kNvwHXcHOz&_nc_oc=Adp1TCzPyDRkZ7fKYjT0z_2pC2wEZCYdfA0r2wgH0o1rM1YShgoEKGJKFSgs_t5mB0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFBSWGf4Ei3dtchU7H3QL4A4q_a1QBsQr0VNhQOUqt5A&oe=6AE20DE2"}, "display_name": "Wizard's Legacy", "keywords": [], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7194998533946539"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "4492311767692745"}, {"status": "PUBLISHED", "id": "4661665990821334"}, {"status": "PUBLISHED", "id": "2074793316776992"}, {"s
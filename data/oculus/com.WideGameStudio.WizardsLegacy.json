?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2_4TmDS1m0Q7kNvwFtGpmy&_nc_oc=Adr-a7AtxXXlszZS2FZjID9yvK3R7WKxFSbw1JV1NtDpkuBDlChPgd9fsLOZ7xgXVaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46mxV4lX_NoH34uiFWjrrrMpzvYw9MitpKWCIAPqahaQ&oe=6A19AFF6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WszP1EH7js8Q7kNvwHNwS_O&_nc_oc=AdqjcfX5NFiUTQRpSx5NXVT5HwERffwnYI1IwokiDPl_xa54empOpFC1kkas7sassxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42XZp-wqC8x0SYtioZTKN-hu9doxWbvVvghPCzjqIHAA&oe=6A19B4FC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI21AwoWr3gQ7kNvwFKdy0B&_nc_oc=Adp4FskLd3rTVUDTKpI96bi3VLtexYtKIgijWF0YYcsfygpDzwMC48Z4HJH20HjQX-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GVdy25J6ckXQzJL8keI6qsIgWH1qAgyLGpPD0Y1xrKw&oe=6A19A697"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8l9aNYuAGQQ7kNvwE8Ns1F&_nc_oc=Adp7VELbdT11m0l6LkvtIvoeuDLRuKItQ6oVJHUuH3W0oulxk5SSV0VJZllr2zA_aDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RljSZLpwkV0dLf85gs8UOoK0i6p2EH8rH05z9rD4VXQ&oe=6A1999C6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFDr3kigbzcQ7kNvwGZW7xd&_nc_oc=Ado74VKSQwx-j1GnWl1cRmSDd89KFPw-qJ7MLcSV89kdJrZCu9jXkwNmkpw8sDUNDIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WZFUGOpjQyYK8rDsvvFN0502NIPfibDX4Yv-ddYQFYg&oe=6A19B783"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tp-8zNvt5EQ7kNvwG_lm4Z&_nc_oc=AdrrZ0P2IVgB9feyoXywgNCsN7rCqy_UuDyBkz4kss7AgMbX0dcfhmDXvpYvIK2f7Fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dfMtEgzfleaqr1kmzSidEpqCc2l-NmyrD4uV4pUr96w&oe=6A19B952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2uN763j1hMQ7kNvwHvpzFj&_nc_oc=AdqFPSwCxPeWNxUYixhCudQgXK8Q2r22-R2ZoH29YhC2bxWtbq_xj2U69QfdNZ1DJfA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56mOxeIZV11MN0I_DVSxh3sND5SxZZ6DBVQWu_7wekXw&oe=6A1988E9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
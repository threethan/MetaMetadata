?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geMCKdi-O1gQ7kNvwFz7_FO&_nc_oc=AdpLvUNDXvVOJr_I4jrxwVEmFqbQVXhJuituJOAEDkPO-zDUSu6LbVBgJTwnqCpfRYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ErojnNeQz-sXAfurgxLMBUwDTzFQ9PSAj_mOV8bEKRw&oe=6A01F4F6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8WP1niF1-oQ7kNvwFJ6nHM&_nc_oc=Adqzi6VdFjFv3-zA0zlkPDeWuSkW5BeGIovwmKzKGJrJAlTgn15eFFkV1DHH2gSwDh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GUJlBB1peZ5GCLpMqVY-sY-gyBYZ7hW-hRla-6qGtTw&oe=6A01C1BC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oueGV_OyIRsQ7kNvwHhJ-JZ&_nc_oc=AdruvStTgVFhZDE2n58t6wGWqVrmIJ_y3VZr0yVPwxAKnTWmmgBHqXom8HlvzdqRVeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SWGZ83IYDb1qXaOyG1SN4-_3KCAOk05soxLHEfoCRXw&oe=6A01EB97"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crYpGqKA9M4Q7kNvwFAQ1HA&_nc_oc=AdqdQ3mp63gx8I5sAgcxfSwLtEupLEWyZMt4jZUeMu3sKNRdGKAQdJlGjKaBCDqElXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67k76LmB8zXdEoGWmSVKpm7VIh5-AHdHdh50H17hLKzw&oe=6A01DEC6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2Rr39CksEEQ7kNvwEUwGem&_nc_oc=Adp320kh9mxAF5hvETqtwhzzcvyWKICkV0WCw_NnHHPAh8LYXH8EK3SVTCS9qk2BkDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z_msubxYPlOflA18UVF0cuWwsc5CLJux4LUv6eh9fcg&oe=6A01C443"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oHNzL-rU9oQ7kNvwFCo5P0&_nc_oc=AdqU4SQhusTbN5gEsqLazoCXR2iqKmXS52pCRKuvmEpR2T2-dA2Q0pLAaBh5ygT8dX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P1VmlSIQpyQLB_VlOEdSsvcyDPyUR0JGKxeRhIgsgsg&oe=6A01C612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onzQvOedSbQQ7kNvwEdoBbY&_nc_oc=AdqOX1q5LQ1ScxdPq8LybRPfGzpK-h9iSgr606SzwznkgPEqn6OmsizmfuNLMUzElt8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D75Lx_AqcK9JlUegKflqufw7igNVyToedQH8juomHdg&oe=6A01CDE9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
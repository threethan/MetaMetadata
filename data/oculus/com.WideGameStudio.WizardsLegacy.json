?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OznO5BIBAygQ7kNvwHpRKJz&_nc_oc=Adrog8vcBr7kcOpnYrfBzfdjOD1Cv02Xqba4K5cCyv5ZOWo365fTzVlC27RneuOKV6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r1oE786_8VO343Ca8mWSAt2s37a9KdNsyabuaQDgrXQ&oe=69EA39F6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T8idcTHDFEQ7kNvwG0snWx&_nc_oc=Ado2pGU3EKm1iENSYNFC3Us26G_7n8pgKkAHlD3gCW00qz_WI83s1THXpVbGgQkvXFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wi7343yoN3TF9MSsnlHdy7WaL0C54_AGiOi0Y3H-ALw&oe=69EA06BC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Vre6_whJZUQ7kNvwEQL6af&_nc_oc=Adrsx0IvbZCWZ4heHyrLh3wtrGMf9VFKYMj_pfuyq5UDLahX0q6ImeJ9rLuQP4Zr3kQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ht-zulUICaPZ44iKw2BepIZiJFVk9jEnBN5Ul_HTHiw&oe=69EA3097"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RZ5nM7v9dEQ7kNvwHvEUXu&_nc_oc=AdpnbI6zCkJ-3nwE2trQ1LuGhrWzA0q5XVGxFeIOHk7bk7xjo71QW0XibhmCxUj17rA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28ROijMVtRyr0EPSiE-wUOj1fKV4hMB5cO2kG3mMC-LQ&oe=69EA23C6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwu2AO8BSQ0Q7kNvwF4-ZMs&_nc_oc=Ados_QmAialsEIaaSXs7epTibS90zTZwae-c6Ou6ziOoqageDfT5HQ-6jf7wT5sZ6CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33GPVJoWTWFsRxJNwgNhjfwZTW_Ih7OA5xvsdeIDWkQg&oe=69EA0943"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYsRSdMzTvAQ7kNvwE893Ys&_nc_oc=Adp2lxTFEcXkcWcH4r-i_jzFQe1lvQodbWWDqSxIX7Fqva63Ufm9kRyQ_M9AZ_aF_GE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h92tWsnCLEvLBvDzzYv9K9GMap4J8p3NnCUxrVEuJaQ&oe=69EA0B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PgjHlJziI0Q7kNvwESj7Nn&_nc_oc=Adq5Rg1bwhN54AJ0y5nbIq-bRZmnODQXFpYqDFszKK_A1LJB_ect7nAJvv3q8msMJPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Vps2HHvB8OOLLjKTVJ_f5sdT_Ow_WBKQqsbnYoQnE8g&oe=69EA12E9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPZvx9KHQ2IQ7kNvwH68E7L&_nc_oc=Ado1fcaL5vIPQMWeu6fSfzhewLu1U4ZqHSEDsKi30ps0ocIF8WqG-3rdq2J-tsxBfKk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5Kj5-mSAZJrb9qWpM6bDdLGrI1Ixd_1-fAY2GtbreUg&oe=6A58C4BC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5exQwtv5vQQ7kNvwH_kPzD&_nc_oc=AdqnecwMrIP232e_lNs3MSBWxJwcQlXDH2Jd3uqWSCorDyBaFdhtjNR4459EJK62E5Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmaOhk6G85TYKSqwwfUlb8aKwrPrnw_iXbIbHsxNkmlQ&oe=6A58EE97"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqmj5Tvg1U8Q7kNvwGnU0OH&_nc_oc=AdoXufLX3OY1jyfKsds5_OAsmZxXpFBsCL9vX9I_x7xoW1ZeyiQiV8LllX7-8sxXy7I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo-56shHeWe-Ii7-WK6mjBig0k8VvStNdzsbtCUSmpUA&oe=6A58E1C6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1xHTy34l8UQ7kNvwGEqiq-&_nc_oc=AdoPExRcrn905XbrSNpr1SKomPvmZzj1tCm38vQHHEhIoqW2ozKH8Lf72ll7fxIqr64&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv7eu4DT8ZWOC0UfevFAbzuDY21kMEOOhUgh_XVkELGg&oe=6A58C743"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4WXinrwO-AQ7kNvwFgVCv2&_nc_oc=Adq5fffpyHpIy5lu_F2UyhhPQkIlY5WVltn4rSbG10SGreizvSu0ftIC9qWLTsAL11g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx1Nc_dsnLmgV8cjFJD03752HKbxxXLIV0GhumPiaChQ&oe=6A58C912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WIZARD.S.LEGACY.COVER.24.BIT (1).png", "id": "794564832812199", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65228545_794564836145532_348548685399172447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4xFdgsiR5sQ7kNvwHxgUfI&_nc_oc=AdokTIKdF_TRKRi8DLkIpod7DwprSGimg-x68z67s-kF2Qz-0uERoCcyQdOMRKtI_DU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmPJ7YH6n04_AccJ7CO8Qiny-Q9rOu8db8lc8rojknUw&oe=6A58F1E2"}, "display_name": "Wizard's Legacy", "keywords": [], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7194998533946539"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2074793316776992"}, {"status": "PUBLISHED", "id": "848841221006147"}, {"status": "PUBLISHED", "id": "754261936940022"}, {"status": "PUBLISHED", "id": "562859070203900"}, {"status": "PUBLISHED", "id": "1307469717224054"}, {"status": "PUBLISHED", "id":
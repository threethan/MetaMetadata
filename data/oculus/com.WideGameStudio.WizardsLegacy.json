?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zafz3XSguzQQ7kNvwFVkywa&_nc_oc=AdoMdqxtRufu6xpxswkbvTb8TXzW_M7wFZoxZlT1RlpIEUQDRQYxuSG5LK54GPipdak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyG4rr0A7dwqIA4SY_ej8bMGT7dfeNFAMqlTc1IsXT5cA&oe=69CA5DB6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YME3cbJslX8Q7kNvwG0YuLU&_nc_oc=Adoq_YxtPDzp9T8hmcCMgQRBgk2MPo3WzhA6JZ5GBet10Pz8wEz0h-UZ_91GqZ7ydcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAQAriF-_lFzlX7GFuclZRxfzpi8RICaobwv7h80fy9w&oe=69CA62BC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DukhTIo4tUEQ7kNvwFwFAWB&_nc_oc=AdoXkHu_7aFoNZzM9pfzQuszG3lmWBKHUVrZcaGPwaGi93CKUkSRSplrA1T6-01qphY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0hWMmPnfbcpi9HBkSsN-ougOR52Rk2Do-PkA1rqJPdQ&oe=69CA8C97"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJmJB5V1rDYQ7kNvwGe-4GF&_nc_oc=AdpFWIkkrDQM78LlC4L4j8juMZm2FZv9ooqxgkEUyPKw3q4JdZJm6U43JLcrvVL7Cy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOCE-X6wWTT361g_YDISus9q-dTIJkKYAOb53AA4UztA&oe=69CA7FC6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDI42Hk7dIUQ7kNvwEjN5oB&_nc_oc=AdoKn17DPpDA_cBo6syqibsCKdNERUKOMhOdYBHU7AtCe5SvjGsVaqLl0UONJoVEOEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFNlyBAozjtv7JrOtvjvnseFOgw74qHuv9mGyXlQRurw&oe=69CA6543"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws59pMxFw4sQ7kNvwEl2You&_nc_oc=Ado5tjYVJqK4VbOKddqAJVPVbMXpsOHHMXY2tCNvmcm6uf1XGoJZnFTLVt1cXrTYyGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySlqOEf8skJYPyyP0X0Z3ztjc9Y5KWuW8TPodnEfBagw&oe=69CA6712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfi8d7i4jI0Q7kNvwFhrlMQ&_nc_oc=Ado4o9NiPcisHhfc9OiVgxUXkZ0PePSwfPIZ5nXGDyK7b8e7Gw-eNZvRexjC9K3fNsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPZaZpt4t0z0W0pxAh8T2mIgpfpHcrBr_BfEGkgab9LQ&oe=69CA6EE9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
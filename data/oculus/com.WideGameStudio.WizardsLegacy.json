?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2_4TmDS1m0Q7kNvwH-p0jW&_nc_oc=AdqI6SRe4M1olfWEHw-HIt0x4oxREusQdx-yguDUjZ-o6WLdjACFTD41i_E4MRvV_xc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KPBESV-8bYuABMPjjMm8y_SNN6Tey-4KzSdTRLys5Fw&oe=6A170CF6"}]}, "id": "1004377585102487", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "519462800645328", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974652_519462803978661_5861237216833818903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WszP1EH7js8Q7kNvwHoJc4X&_nc_oc=Adq-QzJqK8c7yRteARLW8vG11hc4-QFKaNHAiY8fIfH-AqcBt41KLCFr0atMUYN8cJI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F7ck2XkB7FaW7BxFCE-gc5fBRUglb8oBO_9UzpndfaQ&oe=6A1711FC"}, {"file_name": "Untitled-7.png", "id": "379966851375388", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982555_379966854708721_6237733781365760945_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puJBNxWgs3EQ7kNvwEne2g_&_nc_oc=Adrk4MCwXFgpSJnFKWIl3AOTcHJsWIvuZiqYJp7HLsvhdOhwxhX_8fZ-8QHA-WDslww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A4n6V77JrU-lEP5c5Y6KEyoyWFLB3aIyd0lf8PHyFaw&oe=6A170397"}, {"file_name": "Untitled-3.png", "id": "1457878311765107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75647714_1457878321765106_873955209399552846_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8l9aNYuAGQQ7kNvwH1qrb5&_nc_oc=AdrRHRNOxbDcxDnERwbz03EMP6P396vF0m_7NDNeXbRnyzfP9_Xx2EL5g3RY0XfurGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-AARX4uXC-A_n5MDdQZGGgbQfDhxSADvdejB8n_t-2A&oe=6A16F6C6"}, {"file_name": "Untitled-2.png", "id": "853176473329833", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196224_853176476663166_2779387245026015972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA6rA5u_hXoQ7kNvwFvgwos&_nc_oc=AdqLqbtYiuRjWM_7mIBosNbxBUYzBl2FUxWW7BipnChyYKXhNJiTXe-tE04z7XpByVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64FK-HrkARl0M0Y2F1_sb3-OBpq7cfETZWBh_y4aye2w&oe=6A16DC43"}, {"file_name": "Untitled-6.png", "id": "838588491102212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031309_838588494435545_3221430962329902390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZpgnLkgXdgQ7kNvwFcrBNw&_nc_oc=Ado_QSxHHnk0rWegpdty8SFfVlvK72aMxuhF62bmrsaHlf_OAVGCwWfIdbxgH9FIn9k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i7up6m-kXJvDu8LWtzNDBUK4ZZj2sKaWybtRm2YI-PA&oe=6A16DE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SMALL.CAPSULE.VARIANT.png", "id": "1942826292828817", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974439_1942826296162150_5288366189613001907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2uN763j1hMQ7kNvwGctqAJ&_nc_oc=AdprKMNkwTJ-H_xeSMTt5pMRjE_F-aAKeDrOxbLWiwP3MgjVaFe002c2FvgVfUyVA_0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ViFlhuK8v7adjtXQrvRwQfxxjnAplSfqNkOR_B1GJvQ&oe=6A16E5E9"}, "display_name": "Wizard's Legacy", "keywords": ["wizard", "magic", "roguelike", "melee", "combat"], "long_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be.\n\n{3648923568693208}\nA desperate father, bound by a dark pact, transforms into a wizard trapped within a cursed labyrinth. Each victory grants power, but death returns him to the start. Explore the labyrinth's ever-changing depths, where every battle unveils its grim history. Can you master magic, overcome enemies, and save your child?\n\n{362183290313011}\n\n{459743683357113}\nDive deeper, shaping the world with every decision. Explore branching paths, unearth secrets, and face escalating challenges. Collect potions and power-ups scattered throughout to enhance your magic and forge your destiny as a powerful wizard.\n\n{828863472676196}\nUnleash your inner wizard! Draw symbols to control fireballs, ice walls, and lightning. Feel the power surge as you master arcane combat.\n\n{1407283433268429}\n\n{1453454962100883}\nChoose from a variety of playable characters, each with unique spells and abilities. Experiment with different playstyles \u2013 fiery mage, cunning illusionist, or something else entirely?\n\n{1136617717392676}\nThe labyrinth teems with cunning foes, each demanding a unique strategy. Test your skills against a diverse array of enemies, adapting tactics to exploit weaknesses and emerge victorious.\n\n{788110426812574}\n\n{1584321828806767}\nImmerse yourself in stunning visuals. Explore dynamic dungeons, lush forests, and ominous landscapes, each meticulously detailed for an unforgettable VR experience.\n\n\n{1415112652482029}\n\n", "short_description": "Wizard\u2019s Legacy blends VR immersion with roguelite replayability, offering action, adventure, and fantasy. Play as a powerful wizard, explore dynamic dungeons, face formidable foes, and uncover ancient secrets. Become the wizard you were meant to be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardslegacy.widegamestudio.com/privacy.html", "developer_terms_of_service_url": "https://wizardslegacy.widegamestudio.com/terms.html", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://wizardslegacy.widegamestudio.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
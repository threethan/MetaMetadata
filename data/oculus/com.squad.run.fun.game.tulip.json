1950573", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827960_1236230628617239_7865731584897687944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4y52V8ZNrSEQ7kNvwFDs_8N&_nc_oc=Adrf-bhNm6L88uCoSmXjAYhoaio2tNSLLBDx-kX2b8FAxHmoJEbqI9sBbIQWpVEHwQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD10mLNdNoWJG10WpVgrB75zszNeBxyvKQT0C3qyhUBwQ&oe=6A50EFC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Squad Run VR - Fun Running Game", "keywords": ["runnergames", "casualgames", "runninggame", "squad", "puzzlegames"], "long_description": "Get ready for non-stop action in Squad Run VR \u2013 Fun Running Game, an exciting virtual reality runner where speed, timing, and smart choices decide your victory.\n\nStart your run alone and quickly grow your squad by passing through multiplier gates, collecting teammates, and avoiding dangerous traps. Every level pushes your reflexes as you guide your crowd through fast-changing environments filled with moving obstacles, risky paths, and intense moments.\n\nBuilt exclusively for VR, the game delivers immersive running mechanics, satisfying squad growth, and smooth performance designed for comfortable and fun gameplay sessions.\n\nChallenge yourself to build the biggest crowd, reach the finish line, and achieve new high scores in this addictive running experience.\n\nPerfect for players who enjoy fast gameplay, quick reactions, and rewarding progression.\n\n\u2b50 Game Features\n\nImmersive VR running and squad-building gameplay\n\nGrow your crowd through smart gate choices\n\nDodge traps, moving barriers, and tricky obstacles\n\nFast levels designed for quick and fun play sessions\n\nSmooth controls and optimized VR performance\n\nIncreasing difficulty with rewarding progression\n\nBright environments and satisfying crowd effects\n\nRun smart. Grow fast. Lead your squad to victory.\n\nThe bigger your squad, the higher your score.", "short_description": "Run, multiply your squad, dodge traps, and reach the finish in this fast-paced VR running adventure!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25779587571712972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_1340178244804612_7321370841948742964_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C3cypu5UHYQ7kNvwEWJ0Ze&_nc_oc=AdppBXvgT1q7ZdQpvx_4uXipvE_D5tU2CWMGOVNP5f5FaovAfg2wHw1IsobqSwmukS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB403RAbQRz7V1DYq_zIwQvWAX_8GyCTVGIZG_pwGVyyg&oe=6A50F580"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squad Run VR - Fun Running Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1773635700, "lastRevision": {"n
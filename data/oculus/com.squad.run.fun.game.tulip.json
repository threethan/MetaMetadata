291gPAQ7kNvwGLFNSj&_nc_oc=AdoZKn5Fg0hfqwTXZBMOqgyv2oKpX6eVRBwwnDJJH3NKSqDrKL9Z5UyiVwn4u1QMdOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfPzfIkt-S8fZFTVJEUcElRr80abCWhHyncpQdqBIrGA&oe=6B048B2F"}, {"file_name": "3.png", "id": "1236230621950573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_1236230628617239_7865731584897687944_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkV_jY-lFb4Q7kNvwFGtWxB&_nc_oc=Adp8QGzcU2Kfd8eYtpivpSg9r-vut-j_QaP3PHxayhePwsSeYap9eo-xia-C9MN-HBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsX-Xa26ma3eEJigxpAmwyiwSRYshTz5JbSo97AYO8FQ&oe=6B047400"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Squad Run VR - Fun Running Game", "keywords": ["runnergames", "casualgames", "runninggame", "squad", "puzzlegames"], "long_description": "Get ready for non-stop action in Squad Run VR \u2013 Fun Running Game, an exciting virtual reality runner where speed, timing, and smart choices decide your victory.\n\nStart your run alone and quickly grow your squad by passing through multiplier gates, collecting teammates, and avoiding dangerous traps. Every level pushes your reflexes as you guide your crowd through fast-changing environments filled with moving obstacles, risky paths, and intense moments.\n\nBuilt exclusively for VR, the game delivers immersive running mechanics, satisfying squad growth, and smooth performance designed for comfortable and fun gameplay sessions.\n\nChallenge yourself to build the biggest crowd, reach the finish line, and achieve new high scores in this addictive running experience.\n\nPerfect for players who enjoy fast gameplay, quick reactions, and rewarding progression.\n\n\u2b50 Game Features\n\nImmersive VR running and squad-building gameplay\n\nGrow your crowd through smart gate choices\n\nDodge traps, moving barriers, and tricky obstacles\n\nFast levels designed for quick and fun play sessions\n\nSmooth controls and optimized VR performance\n\nIncreasing difficulty with rewarding progression\n\nBright environments and satisfying crowd effects\n\nRun smart. Grow fast. Lead your squad to victory.\n\nThe bigger your squad, the higher your score.", "short_description": "Run, multiply your squad, dodge traps, and reach the finish in this fast-paced VR running adventure!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25779587571712972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_1340178244804612_7321370841948742964_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvp1RWe0BMIQ7kNvwEVUaj8&_nc_oc=Adpgw-CSAF0y_Wv3G-nKq6EeVumZmXLluID9VrNteq4aKymV73X9QkgQ7173mO5sGpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx3sCM_pSuwt92rIkAnJqQ3GC3HZNcYGn4q9P09D0WCw&oe=6B0479C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squad Run VR - Fun Running Game", "platform": "AND
1-2.oculuscdn.com&oh=00_AfvoPomh3jcwgbgtLTxXF63EhSSsw7iwb9810lzVcXgkwQ&oe=69A1A969"}, {"file_name": "x7Zeuu.png", "id": "287893285938626", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75416832_287893289271959_3123777796539678720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSAjWSud1qsQ7kNvwFBH70e&_nc_oc=AdnVGdg-jNPpE8rco-Mlgl38WzOenDE5hQAcvPcWNGVrRaA1uNvuSZX3NSCOabXNXnU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuUxqXEaUrUGpoJEfZgPqI_RRZfYQVUSgSZX1QwMcuFsw&oe=69A195E5"}, {"file_name": "s5gZMh.png", "id": "3221411204575888", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982450_3221411207909221_7132800944659496960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Utren2FPOH8Q7kNvwE3vYbb&_nc_oc=AdnYB0BWbbksynQRnYTrO61oQetqKaunSMfn-r0p36HiB3CS2OQ7QAys0CtSdPCBZAA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfudLO8KfqhryaWxBM3JN7Bm8x5YEx6fCe26t11onGi2vA&oe=69A19539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTkPB3", "id": "2577664835884085", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75223480_2577664839217418_8839691449978060800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_AvLgk8C50Q7kNvwHHpfJP&_nc_oc=AdlPRCfRXwPL6t5LNDFfGf-TPEv8-ClAo6C0v9bJ7OOMDRKp1u4NPwaNR54TyutEPBQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsXjzAphBLO0uDzk4JLc6upcrlomK1gooFK3OOcsLpi3A&oe=69A18C9A"}, "display_name": "Bermeo Heights Express", "keywords": ["meditation", "relaxation", "calm", "train", "exploration"], "long_description": "An immersive, introspective, and calming journey by rail.\n\nFreely explore the train station and discover hidden viewpoints. Board the train for a scenic and relaxing ride through the procedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures an exclusive 5 minute guided meditation by Cole Chance you can follow along with on the radio, or you can just get cozy to the rhythmic sound of the tracks while watching the countryside pass by for a brief escape.\n\n- No violence\n- No explosions\n- No zombies\n- No jump scares\n- No guns\n- Designed for comfort and relaxation\n- Great for experienced and new VR users\n- Features short guided meditation by Cole Chance", "short_description": "An immersive, introspective, and calming journey by rail designed for comfort and relaxation.\n\nProcedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures short guided meditation by Cole Chance."}]}, "developer_name": "shawnfromportland", "developer_privacy_policy_url": "https://shawnfromportland.com/bermeoheightsexpress/", "developer_terms_of_service_url": null, "publisher_name": "shawnfromportland", "support_website_url": "http://shawnfromportland.com/", "website_url": "http://shawnfromportland.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1272775843226052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974814_283558973040798_2183595020060196864_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqRpKYsAl_gQ7kNvwFIEQD9&_nc_oc=Adlv6g0FbdlRUVCxytIM7-lmEbfbsLJHeSBDD6_efQhDoXmP88cpICRHgA8VUwsH9P8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscd
5-2.oculuscdn.com&oh=00_AfuLnGJ89AGOqXOf6vXFL_kb-kZMT-oOJdw1iqP4LgD_aw&oe=699B11E9"}, {"file_name": "x7Zeuu.png", "id": "287893285938626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75416832_287893289271959_3123777796539678720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqL4luiDoVEQ7kNvwGcDQD-&_nc_oc=AdmPALd4UtKrEwVMdFs2FtqLLvjE4FPjX1KGI71ITDRqadrLafR75XQys5npAIMdxMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftO9gCQxFCauClUdwqSxgK_yYwX_uc4BcY-XuLBxqawDg&oe=699AFE65"}, {"file_name": "s5gZMh.png", "id": "3221411204575888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982450_3221411207909221_7132800944659496960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LEl0fcSF-4Q7kNvwFaG_Oo&_nc_oc=AdmtxfVcqEeOKpNO0TLUhhUOdcp0q0SYHz2BRLBjnN0YGOlDDfns0VDlCX6u7Rxa69Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsbymAZIth6KznzbItCv8R5wqzUr5yhba76jv3i2JtXYA&oe=699AFDB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTkPB3", "id": "2577664835884085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223480_2577664839217418_8839691449978060800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rP2KKWjWKoQ7kNvwGlKO9j&_nc_oc=AdlQ8XXqZRWgqXNi-bqZqEvkZdhfLaHkA2yeDx7rlUXrirwMO7QgpiAiam60JXlJnlA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCq0LqkE8KuBk2d6SpQbuxfL958CGtmRG4w3YKDXoT7A&oe=699AF51A"}, "display_name": "Bermeo Heights Express", "keywords": ["meditation", "relaxation", "calm", "train", "exploration"], "long_description": "An immersive, introspective, and calming journey by rail.\n\nFreely explore the train station and discover hidden viewpoints. Board the train for a scenic and relaxing ride through the procedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures an exclusive 5 minute guided meditation by Cole Chance you can follow along with on the radio, or you can just get cozy to the rhythmic sound of the tracks while watching the countryside pass by for a brief escape.\n\n- No violence\n- No explosions\n- No zombies\n- No jump scares\n- No guns\n- Designed for comfort and relaxation\n- Great for experienced and new VR users\n- Features short guided meditation by Cole Chance", "short_description": "An immersive, introspective, and calming journey by rail designed for comfort and relaxation.\n\nProcedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures short guided meditation by Cole Chance."}]}, "developer_name": "shawnfromportland", "developer_privacy_policy_url": "https://shawnfromportland.com/bermeoheightsexpress/", "developer_terms_of_service_url": null, "publisher_name": "shawnfromportland", "support_website_url": "http://shawnfromportland.com/", "website_url": "http://shawnfromportland.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1272775843226052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974814_283558973040798_2183595020060196864_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvQrccoLCjwQ7kNvwEMou9E&_nc_oc=Adl8W0i03PmG4LmvokdRRtnQRUpNydLva_Di9Zb310fdQTSX1sDJVsi_nhvdUIASLBY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscd
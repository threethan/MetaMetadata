hZyppcwD8xHh_hHocaePzrBwUffUNm4ExmC0OmvutvT7Z3um-5nOapZHBFR16A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3Zfa-7HyBrZdilHPiWryu5EG5jgVP8c6sI_iljHR0cEw&oe=69F214E9"}, {"file_name": "x7Zeuu.png", "id": "287893285938626", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75416832_287893289271959_3123777796539678720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xsquR9h-QUQ7kNvwGrFFaP&_nc_oc=AdoMiicjOoYr3uT8cnfUI_ZEEA05Oi9uKqzKcMelmVBaop1HAB_K_6I6iC6U3T16YkA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2EedRttk5d03YrKPgi00brKzwdLksC7_F_4Opn_dB7fQ&oe=69F20165"}, {"file_name": "s5gZMh.png", "id": "3221411204575888", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982450_3221411207909221_7132800944659496960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXbAHrpystwQ7kNvwGrqbVW&_nc_oc=Adrj-ZQGemm6_Mxhzgj4JnS9hf7L4TT0dpg9xWWVGNdib1iQ5tCPynUbkGCwOzDztoM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0egGt9ibl9cKwcUjL9eSt00YgCoppxcb3ZeWEPWW2awg&oe=69F200B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTkPB3", "id": "2577664835884085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223480_2577664839217418_8839691449978060800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LQxtVHzGcEQ7kNvwE-klxL&_nc_oc=AdrUgsB6Z1ByZ38OidAoHHCmhVtJySidHjgpHG8I3xJOYbjPKC_0TfQJhtk8wUb5exA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21RKowKEF8dPVz0dwp7sbfqCfw6G1xjCqZ5Fo5y9DpbQ&oe=69F1F81A"}, "display_name": "Bermeo Heights Express", "keywords": ["meditation", "relaxation", "calm", "train", "exploration"], "long_description": "An immersive, introspective, and calming journey by rail.\n\nFreely explore the train station and discover hidden viewpoints. Board the train for a scenic and relaxing ride through the procedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures an exclusive 5 minute guided meditation by Cole Chance you can follow along with on the radio, or you can just get cozy to the rhythmic sound of the tracks while watching the countryside pass by for a brief escape.\n\n- No violence\n- No explosions\n- No zombies\n- No jump scares\n- No guns\n- Designed for comfort and relaxation\n- Great for experienced and new VR users\n- Features short guided meditation by Cole Chance", "short_description": "An immersive, introspective, and calming journey by rail designed for comfort and relaxation.\n\nProcedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures short guided meditation by Cole Chance."}]}, "developer_name": "shawnfromportland", "developer_privacy_policy_url": "https://shawnfromportland.com/bermeoheightsexpress/", "developer_terms_of_service_url": null, "publisher_name": "shawnfromportland", "support_website_url": "http://shawnfromportland.com/", "website_url": "http://shawnfromportland.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1272775843226052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974814_283558973040798_2183595020060196864_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTmXGoiH5CoQ7kNvwHF84-
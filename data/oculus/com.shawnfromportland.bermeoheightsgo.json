6DEE65"}, {"file_name": "s5gZMh.png", "id": "3221411204575888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982450_3221411207909221_7132800944659496960_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wl1tXSSF48Q7kNvwHzlnBv&_nc_oc=AdphbO4R6jfkjMg5O7pxuBW-ZoQoS5BSn5kRU2YqDeb6_aF0FDjgnnaSS4-yxCsjmeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0PocCiP3Ctjm4VL_OpT4sMBhSCz76K5YvhBvAKa6LQg&oe=6A6DEDB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTkPB3", "id": "2577664835884085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223480_2577664839217418_8839691449978060800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ1m7FQqFCwQ7kNvwECcJSW&_nc_oc=Adog9TtpmRVlYI513wqkOkUMAu6_XvOrwMt29hdrMdbFmfFf-cvO_kZ8IKTGuM9izmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA9Q0apLEkUnGinVKBw3zu3pX91tDsA5_agWh7go5Ihg&oe=6A6DE51A"}, "display_name": "Bermeo Heights Express", "keywords": ["meditation", "relaxation", "calm", "train", "exploration"], "long_description": "An immersive, introspective, and calming journey by rail.\n\nFreely explore the train station and discover hidden viewpoints. Board the train for a scenic and relaxing ride through the procedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures an exclusive 5 minute guided meditation by Cole Chance you can follow along with on the radio, or you can just get cozy to the rhythmic sound of the tracks while watching the countryside pass by for a brief escape.\n\n- No violence\n- No explosions\n- No zombies\n- No jump scares\n- No guns\n- Designed for comfort and relaxation\n- Great for experienced and new VR users\n- Features short guided meditation by Cole Chance", "short_description": "An immersive, introspective, and calming journey by rail designed for comfort and relaxation.\n\nProcedurally-generated lowpoly-style environments inspired by the beautiful countrysides of Northern Spain's Basque Country as well as the Pacific Northwest United States.\n\nFeatures short guided meditation by Cole Chance."}]}, "developer_name": "shawnfromportland", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "shawnfromportland", "support_website_url": "http://shawnfromportland.com/", "website_url": "http://shawnfromportland.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "348520643809213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "586041221893930"}]}, "baseline_offer": {"id": "586041221893930"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1593709200, "status": "PUBLISHED", "id": "586041221893930"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4110577298952351", "version": "2"}, "id": "316335702337901", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2681266795216749", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4110577298952351"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_nam
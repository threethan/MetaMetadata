file_name": "AJAX_Screenshot1.png", "id": "743732706570664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001691_743732709903997_3291100106042373668_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zrGzkSZHqkQ7kNvwG6MNlV&_nc_oc=AdkQJV8wT6HWIwTPOjRdvrJQM4a3bdIesZ5jLFXKvMV_-e2nZWBZdGAecOV7-Jey4xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrA67wMWc-EvYWQg-mm4s_KwytsDEBny8Q_sY3OxW-CA&oe=69B40265"}, {"file_name": "AJAX_Screenshot3.png", "id": "330518941665470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003273_330518948332136_5043370396625167176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uanic1n8sA8Q7kNvwH77YSv&_nc_oc=AdmQLmTrKnhRE8KetlWXFf1RGzTrIJmyOC76eQUeOoX6JUjLeDbQinRpnYHqrKZHJdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhmcqTsP7nOGYWi9GUF9V6DDWhdm1zLytypOJOnycLzg&oe=69B41B13"}, {"file_name": "AJAX_Screenshot4.png", "id": "688007205201335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_688007208534668_2257958446064248023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBbaI0IEDMQQ7kNvwHrehl-&_nc_oc=AdmlpTAU6iXF7a_7TJZ4lSZaXTVvePE6qUf3_wpy8MnIvpdksyc-MZ6q3gAtzmliZ_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwro3rA9WEjmZdQtsuegFShXgTJS6wwza4VQS5SIrtMKg&oe=69B40780"}, {"file_name": "AJAX_Screenshot5.png", "id": "190513696167216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_190513699500549_814425097474291908_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz0Nhcm_qTgQ7kNvwFgoW3l&_nc_oc=AdmlqdAX191rgv0OHUD9D7iOKmts_jB3fd23Le917Ae0nFSHVvCemx5Im-m4MxgoBLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQZREbC6FW3Ik0tHvWqiUvnU5ikM563m4i08M-SQYkcQ&oe=69B3F513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIFw8RvVVAQQ7kNvwERPfU6&_nc_oc=AdmsHAiC60Gvt-nkx9PPlsUvvRNqvJ98wTbLMbTqJ-QtEDYUW36rdvpBNc-tijtGMg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQgjiOxCWYZ3SqpO9APWVNxNqM9nNefFmVda5EvwpEfA&oe=69B3FE62"}, "display_name": "Ajax All Powerful", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nAJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. Starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL) and written and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA).\n\n2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. 2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival."}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/aea7d966b01db45db4b606d3d2575d75", "developer_terms_of_service_url": null, "publisher_name": "VeeR", "support_website_url": "https://veervr.zendesk.com/hc/en-us", "websit
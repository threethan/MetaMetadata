00_AQQzdVOsRDd_rZNVg9QRF1FylT_I_SKovkuvCgK-qZOP0A&oe=6AFB33C0"}, {"file_name": "AJAX_Screenshot5.png", "id": "190513696167216", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001687_190513699500549_814425097474291908_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R1Lw6rqZT4Q7kNvwFrZJ1j&_nc_oc=AdqbaI-Pe5Ok3Va1dED0zhgdkOgvX5I_OMOr-HlH7TL7bNgqAuAXlI-XUm1yy1D6ack&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0U4INSmE3wVGs6aE0lLYvTn_lyWDH3qzGam6zvVgyPg&oe=6AFB2153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUGlpCXP_t8Q7kNvwHHMJqJ&_nc_oc=AdqbxM68C0lQ0GgGcxSv1XMG5sh4zN1z_jXMwaQS85Y_klyblPZzm9k4NjfmVqGytVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ73lwiomen-siiezLtA7FUe5e4l7YXoRBsPEOCiWZT5w&oe=6AFB2AA2"}, "display_name": "Ajax All Powerful", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nAJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. Starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL) and written and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA).\n\n2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. 2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival."}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/aea7d966b01db45db4b606d3d2575d75", "developer_terms_of_service_url": null, "publisher_name": "VeeR", "support_website_url": "https://veervr.zendesk.com/hc/en-us", "website_url": "http://AjaxAllPowerful.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "323034106433879"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4378439645527563", "version": "1.13"}, "id": "931521760712876", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": 
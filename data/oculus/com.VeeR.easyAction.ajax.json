08_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5N3L9dNYO00Q7kNvwHyuZP7&_nc_oc=AdmQOF6iNZz4aG13qhZn2cBRPgxBSo6qW4A4F3gDL6_fgKzu_sER1VqAHjZ3z3iB2C8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftJOoiVAi3CKGtgpwZlWg1p81BvkQ9hJhvh5g23tQLoqQ&oe=69984593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH0fatPZSokQ7kNvwFVC-Gm&_nc_oc=AdkrY0h9gUpjMrrWDINdyhefI3nGnxra6KnRxy4zyIqXK50bhfVS1evxa--t07Xm0Eo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuRjn2UGn4Y1pbc-G7eOtkDE8z5Ykw6oxbk41Gajv8cxQ&oe=69984EE2"}, "display_name": "Ajax All Powerful: Original Edition", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA), AJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. "}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "http://o8dy6wafc.bkt.clouddn.com/VeeR-PrivacyPolicy.pdf", "dev
&oe=69AAB4F6"}, {"file_name": "AJAX_Screenshot1.png", "id": "743732706570664", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001691_743732709903997_3291100106042373668_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4CHmM3eMvsQ7kNvwHH6meT&_nc_oc=AdnXwZE_QCzmSnsJxDoUz8gwgA70hd4VpCfZ7yepFqlQ5beUk2NbIf-_1YP6gJHwHEU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_2BPlzgYwTy6eK7OK9qouVIhzV9pIw4o7pm4opmnafw&oe=69AAC7E5"}, {"file_name": "AJAX_Screenshot3.png", "id": "330518941665470", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003273_330518948332136_5043370396625167176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSI7dqn3y88Q7kNvwFda6TN&_nc_oc=Adl2AQpFtSMOhc0GYwejXTk9_JvJyEsbJdf6yk_pXOm1I7oF1XQUWWTv9cq9WmE1jnk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afyji5KSgOCZ7BJG3kWTBO_GQjC0FP0T8Da5YF_IH-9yCA&oe=69AAE093"}, {"file_name": "AJAX_Screenshot4.png", "id": "688007205201335", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974453_688007208534668_2257958446064248023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlqUvKninmgQ7kNvwHlu5Ao&_nc_oc=AdnXa3lYeFv4dltfKWy7NOrAMHp47FRsZ9NcHRdI-GLjj1GzdBCPKnftsPDwre1URTU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9kWmy3aGgNaMb3C7huzCYBBrG9MzYz2vq4CLqlk5WcA&oe=69AACD00"}, {"file_name": "AJAX_Screenshot5.png", "id": "190513696167216", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001687_190513699500549_814425097474291908_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcTAAlwOxckQ7kNvwHvrp-1&_nc_oc=AdkAzbeGG1YMs58Om-ihuXDR6fwY4EgPTKJrBO2ghyU-ckaKASQgwoXYR8gffiqZcUQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycSVfVpjcjfxhXq238e25sjPNTsYYh2fI3Mgpvj0xyKQ&oe=69AABA93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsdmcidQSg0Q7kNvwHTxW5x&_nc_oc=Adk0kRdFrxvrVVkyHolsSRubZJ2JK65NEXPEEldloD58GvrmiaOA3i4AA-fzK4zTW4Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5VSaw1-jsz_zuLX6jetSkN0Arri_niNmUBAp7MkGuxQ&oe=69AAC3E2"}, "display_name": "Ajax All Powerful", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nAJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. Starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL) and written and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA).\n\n2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. 2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival."}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/aea7d966b01db45db4b606d3d2575d75", "developer_terms_of_service_url": null, "publisher_name": "VeeR", "support_website_url": "https://veervr.zendesk.
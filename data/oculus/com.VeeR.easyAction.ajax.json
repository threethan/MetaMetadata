file_name": "AJAX_Screenshot1.png", "id": "743732706570664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_743732709903997_3291100106042373668_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLPE3i6LQoYQ7kNvwFYpGth&_nc_oc=AdlG-AJuL6X4CaTpj6bTsz9c45mCQtAGrLVSjKX0BfbUyrlLDXm6HoPXgwMvsM13MCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzU4KAhnRX-foK9Z52oVJ2Sv4LqcdUAKM3gf3PXv2zutA&oe=69B553E5"}, {"file_name": "AJAX_Screenshot3.png", "id": "330518941665470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003273_330518948332136_5043370396625167176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaRDAb66AZgQ7kNvwFWqSZF&_nc_oc=AdnWfO4NWq_-wh6gaw2evWAd0KuOxf3Dy7j_3KpVRjRPBQ6wUDUjjXMDtJLXI3oiQZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiSJxReTc2pRIBzbIQCqdBQmpxTr40qU9psE4H3Dws0w&oe=69B56C93"}, {"file_name": "AJAX_Screenshot4.png", "id": "688007205201335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_688007208534668_2257958446064248023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBbaI0IEDMQQ7kNvwE6aLPD&_nc_oc=Adndz5B9YZw8V7gG2H4MbRkw-gUCnfFR3f6usYwHKg4RRkZ7PnPg35Z2XcKfOQm0xJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzgy3KToCr8pbwxIxUE2fO8Nb0pCRWA6bwpUbYsHBJ7wg&oe=69B55900"}, {"file_name": "AJAX_Screenshot5.png", "id": "190513696167216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001687_190513699500549_814425097474291908_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz0Nhcm_qTgQ7kNvwFz3JDo&_nc_oc=Adn_qjHmQaY8ZX4HGFiy6tepvpy9_UKfiOVVMpe4CItWyZESVAnTY4lyKyNoCnzHJAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0Ab4BasNTt9QFEdWFcQe9cZQL68emeG6UhwnlbXVSQg&oe=69B54693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z0WwLr4uAcQ7kNvwF8UVEK&_nc_oc=AdmbrcVuPJ8Bvjb8PCnviy813VExHHpx-uIdPpauesqy9AYxsm19PsEfd-b1WNy1EB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzyyvy7N7UH9eKftP6M_duiCLfCD8fT3X0fKmcb1gcQHg&oe=69B54FE2"}, "display_name": "Ajax All Powerful", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nAJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. Starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL) and written and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA).\n\n2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. 2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival."}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/aea7d966b01db45db4b606d3d2575d75", "developer_terms_of_service_url": null, "publisher_name": "VeeR", "support_website_url": "https://veervr.zendesk.com/hc/en-us", "websit
creenshot5.png", "id": "190513696167216", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001687_190513699500549_814425097474291908_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs0si1wIP7UQ7kNvwEwDq-W&_nc_oc=AdrfnGxJRhWeVhmVgXFNhY3E2KQBAMC6ot3IKqCFnvPqmpkIe8xLwgX99S7MQP3FkTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36NaZSpWEGPDQuVwosKBiRVnuhZK1c8Lhizr0ItFh3MA&oe=69E75F93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmflaFI9l9wQ7kNvwHlTueA&_nc_oc=Adokw3EW8F9heIqIf0Fb8WqlyyzsL1nn73b01hdfP5KMVh0P5zQrQoCrd_NSuyMQoYM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0khgiw0o7ARM2LMEXIr8yfiOwsn7x14dZh84X2h8NIug&oe=69E768E2"}, "display_name": "Ajax All Powerful: Original Edition", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA), AJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. "}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "http://o8dy6wafc.bkt.clouddn.com/VeeR-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "VeeR", "support_website_url": null, "website_url": "http://AjaxAllPowerful.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9219602291411250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974732_282588090957071_5341492191533598626_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJMwuMyjFcEQ7kNvwFUuCTt&_nc_oc=AdpB0V3_JmruYlW54KGWfnuQ6X-PtCchpXs9f180q44n5XrmW8dtjAZ5LbGFefeoZH4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07o3rDyxBIJTe0cUez9ro1U0qIHt8xSqgPdb8tt3wI8A&oe=69E77FDF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ajax All Powerful: Original Edition", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1687622400, "lastRevision": {"nodes": [{"id": "2650949848363245", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4183875578317305", "is_first_par
08_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJu5yDH0g8EQ7kNvwFxNk-L&_nc_oc=Adn25caSVFL2tAA2blK_1drLincNO0-WDq9pyTiC0VRXuYNtLJxrhG0tpENuek515Zs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftn08viCUOS7lKJFJjEazne_hjdDnRtSWEnEVpJHENMDA&oe=69A42313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zuZJjF3PRwQ7kNvwF_iK4o&_nc_oc=AdnjXfe51fOwYic84Xfr5rO_kOvTIwhQjCkI9HUR6MHogK6cZ-1Xhcd1QrWuuAGzKwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsbzqkS6OS0ILDOTxZNMQAqleEqX75CuQOS9zD0_qCrRQ&oe=69A42C62"}, "display_name": "Ajax All Powerful: Original Edition", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA), AJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. "}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "http://o8dy6wafc.bkt.clouddn.com/VeeR-PrivacyPolicy.pdf", "dev
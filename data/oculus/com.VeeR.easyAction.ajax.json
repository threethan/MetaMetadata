file_name": "AJAX_Screenshot1.png", "id": "743732706570664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_743732709903997_3291100106042373668_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zrGzkSZHqkQ7kNvwGtEPdu&_nc_oc=AdmF2ZYKjAwiBOpBWjGgzfqoIRgYR0vj4h2X6xYaoMWuDg99lqqL_hUNNVSrlC6vDv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuZO5aMMEGtWwuV57Rn_m6ERXxlHnVsYiMoCuKO4yVqg&oe=69B15F65"}, {"file_name": "AJAX_Screenshot3.png", "id": "330518941665470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003273_330518948332136_5043370396625167176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uanic1n8sA8Q7kNvwGnJ0gM&_nc_oc=Adme1TxEEDtuYYJ7Z3Bm6cvrK2BUM7LPhdKjZiqP0PAhWGHCOZT0j4GnugSTn65K650&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVmiu21__ux4itoXM58kPL0J6EiJRUiZriRBiWwGYk6Q&oe=69B17813"}, {"file_name": "AJAX_Screenshot4.png", "id": "688007205201335", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974453_688007208534668_2257958446064248023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YebeF5BZAg0Q7kNvwGDzCgR&_nc_oc=AdkOuC1jif-CoPdhabB3EchJzMRVrViTIu-2GBSfTVCbjrNFnyYhgwOdrNk7_mNUogo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgTW6RoDrJ95_S5LZHMDldoOhMjcpgaOV5qY0VP7S2tw&oe=69B16480"}, {"file_name": "AJAX_Screenshot5.png", "id": "190513696167216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_190513699500549_814425097474291908_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTG2p-_g7gQQ7kNvwEhUwdT&_nc_oc=Adnjon2POeMIa392t8lcsXv79RuYhplE6wxHBoBXoaNtpsIYuHm6R4o6zpfbS5f5SzA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzskJKRfi63giS6qx03Zz6tX_ElWZ0MgPieGotIycNysA&oe=69B15213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "1195823440879067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_1195823444212400_5305135154571797175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIFw8RvVVAQQ7kNvwFWbe85&_nc_oc=AdnDWuOkUEPHGhPMiuG8Q8XV2g_-HiL3FP4A324TZSBZ0R9obEy9WDLrjzhQ_R_Kccc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_5lOJkuXKk_xTGFYItjl6wSMIRx5G4J92nZKsiMPEGA&oe=69B15B62"}, "display_name": "Ajax All Powerful", "keywords": [], "long_description": "Ajax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nAJAX ALL POWERFUL is an innovative VR comedy utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. Starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL) and written and directed by award-winning VR creator Ethan Shaftel (KAIJU CONFIDENTIAL, EXTRAVAGANZA).\n\n2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival.", "short_description": "Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer to negotiate her wishes. 2020 Official Selection at Tribeca Film Festival, Annecy Animation Festival, and the Venice International Film Festival."}]}, "developer_name": "easyAction", "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/aea7d966b01db45db4b606d3d2575d75", "developer_terms_of_service_url": null, "publisher_name": "VeeR", "support_website_url": "https://veervr.zendesk.com/hc/en-us", "websit
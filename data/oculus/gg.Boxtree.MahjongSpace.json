, {"file_name": "screenshot-04-hu.png", "id": "1563223538904225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/836569829_1563223542237558_6061180663464992616_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqcynvrKNTgQ7kNvwEtgf5a&_nc_oc=AdqFqf0o6McjDKrzNhu--y-lf4_z3l4nqz80EtBDb_RWFX4P-yXTMF7FePlrF5MgokE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSw_l9lqSaVFVuXhDz5UraC5JnzfxLn4fYQhMVq_UeJPg&oe=6B0C77C1"}, {"file_name": "screenshot-05-sandbox.png", "id": "1706638364425568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/761640323_1706638367758901_3059126527299436679_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dro0Vvzv2IQQ7kNvwFtS6gc&_nc_oc=Adqa3E3B52wnfN4MvB0fSD2hmBCHZeO3hLzpvbasiuVh8AwthoVP415h33qJweUrgYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMmOVENd3rdFZwPnGUJIcXgxPhIsQ8TGupJR8XXXeSSw&oe=6B0C4D08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1618483673291385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1618483676624718_8091908413278831131_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmxGFzASKREQ7kNvwGczQ_R&_nc_oc=AdqXORXGy5ClBScY-IavRdsSP6oEqlp0jXvpdskrzXOTbbvaHX5qj7R0r4fuhVM9pZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyDEn2g2tzmbKuWqNZgvyMbbXiLDKruONJtUtX9tevtA&oe=6B0C7D5D"}, "display_name": "Mahjong Space", "keywords": ["mahjong", "tabletop", "mahjongg", "multiplayer", "tiles"], "long_description": "A Mahjong table on your real table.\n\nMahjong Space finds the table in your room and sets a richly textured green-felt Mahjong table with beautiful 3D tiles on it. Play solo against friendly bots or with friends online, or switch to immersive VR and play among the stars.\n\n{2208000910135259}\n\n## PLAY YOUR WAY\n\nUse your hands or Touch controllers. Pinch or poke your tiles, point to discard, and press the floating keys to Chow, Pong, Kong and declare Hu.\n\n{1083678214544788}\n\n## TWO WAYS TO PLAY\n\nPlay Mahjong Competition Rules (MCR), with winds, dragons and rich scoring. Or try Sichuan Bloody Rules (SBR): declare a void suit, clear it from your hand, and keep playing as up to three players declare Hu.\n\n{1821859142290290}\n\n## YOUR TABLE COMPANION\n\nPick a delightful animated animal inspired by the lunar calendar and mythology. Your companion cheers every Chow, Pong, Kong and Hu, and every Hu ends in confetti.\n\n{1950296822599732}\n\n## PLAY IN THE SANDBOX\n\nOpen the tile case, spill the tiles, and toss them around while your companion roams the table.\n\n{1483487530510177}\n\n## LEARN AT YOUR OWN PACE\n\nFollow the narrated tutorial, then explore the winning-hand glossary. Try It puts you one move from each winning hand.\n\n{4616493158606404}\n\n## BECOME A PATRON\n\nThe Mahjong Space Patron add-on unlocks the Dragon, Golden and Neon tile sets and the Kirin, Kitsune, Panda, Phoenix and Sparrow companions.\n\nSolo play, the tutorial and the glossary need no account. Sign in to play with friends.", "short_description": "Bring a beautiful Mahjong table to the real table in your room. Pinch, poke or point to play Mahjong Competition Rules (MCR) or Sichuan Bloody Rules against friendly bots, or invite friends to an online room. Learn with a narrated tutorial, meet delightful animal companions who cheer every Chow, Pong, Kong and Hu, and spill the tiles in the sandbox. Prefer the stars? Switch to immersive VR at any time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mahjong.space/privacy", "developer_terms_of_service_url": "https://www.mahjong.space/terms", "publisher_name": "Boxtree Inc", "support_website_url": "https://www.mahjong.space/support", "website_url": "https://www.mahjong.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2601846256963056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1160285032992969_6120210644232731522_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCWdO8Ax14MQ7kNvwGJEW3E&_nc_oc=AdqB3219zWB5mDvyHmJWTD6vHoTXAIqWaMzZCKF0df67AmK3CKkLWgSyOtdlAKcdpqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPH8GSrjuId4IoEmV4yhq0zHH7HFZJbI13NnflPBB6vQ&oe=6B0C61E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mahjong Space", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1794413460, "lastRevision": {"nodes": [{"id": "2589975344816814", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2589975334816815", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1426743219673840"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "logo.png", "id": "3923159154490992", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https:/
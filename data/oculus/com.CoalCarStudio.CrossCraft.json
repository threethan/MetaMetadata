, "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823398_714113421292038_1379662805602998170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zym9jioHERkQ7kNvwF8hIt5&_nc_oc=AdqqJEvOsuwqoSXu7OeC4TrxC_dIlPLiOz24wQcVVTG93VGEd1S0DrEBeKvdRIuNvJs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UnlzsiHUOEDMzYyOu_ps3VKgBv_b3L1pDZEmwG12rvQ&oe=69EA36D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cross Craft", "keywords": ["stitch", "craft", "art", "lesson", "pattern"], "long_description": "# Cross Craft is a Mixed Reality cross stitching experience designed to help anyone learn, practice, and enjoy the craft. \n\nThe app supports beginners and experienced stitchers by offering simple guidance, clear pattern instructions, how-to videos to follow along with and helpful in-app resources. Cross Craft blends real world crafting with digital tools so users can track progress, fix mistakes, and learn new techniques more easily.\n\nWith experimental hand tracking, Cross Craft lets you interact naturally as you work through each step of your project.\n\nCross Craft is currently in beta, and the hand tracking and overlay features are experimental. Join our Discord community to try new builds, share feedback, and help improve the experience for all stitchers. Discover a more accessible and enjoyable way to learn cross stitching through mixed reality.\n\n# Learn more and join the Beta at crosscraft.coalcar.ca\n", "short_description": "Cross Craft is a mixed reality cross stitching app that helps you learn and stitch with confidence. Use experimental hand tracking and a simple pattern overlay to follow your design on real fabric. Now in beta. Join our Discord to play, give feedback, and help shape Cross Craft.\n\nLearn more and join the Beta at crosscraft.coalcar.ca"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crosscraft.coalcar.ca/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": null, "website_url": "https://crosscraft.coalcar.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24297989543122628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1451273206719607"}]}, "baseline_offer": {"id": "1451273206719607"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770919200, "status": "PUBLISHED", "id": "1451273206719607"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26758886507032907", "version": "1.0"}, "id": "986597746790629", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24297989523122630", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26758886507032907"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775813881, "id": "27354977690757116", "version": "1.0", "version_code": 240, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27354965477425004"}, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isApp
, "long_description": "FISHY is a brand new, free to play, massively multiplayer cooperative fishing game. Catch and sell rare fish, fight off huge monsters, and hang out with your friends!\n\nCollect rods with cool abilities:\n{4500065863589356}\n\nFish up hundreds of rare and chaotic items!\n{1087018603977111}\n\nAnd its free to play! You can earn all the best stuff over time with free challenges.\n{1442573531121676}\n\nFISHY is still in early access so we're working on tons of new features, like whole new islands with new fish, monsters, and things to do! We're also adding boats, ocean exploration, new legendary rods, and much more.\n\n", "short_description": "Fish with your friends!"}]}, "developer_name": "ENVER", "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ENVER", "support_website_url": "https://discord.gg/fishyvr", "website_url": "https://www.enver.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27438549835820863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1597840861348903_1188688665143120535_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWn8qha2emUQ7kNvwEqQt0P&_nc_oc=AdrWHjd_0WBbqZzRlSZf
ttps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823746_28171437962551962_5458121694227136187_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tG4vldNHvU8Q7kNvwEh7vpP&_nc_oc=Ado0MkgGdph2LlSbRewzLPXzOT92sz5bXD-fy_6v7dhVj2wA58iA-zBy9BrzUyb8OiE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmzaN9MRpB3C_ijVc77GkiROpOqej-0OhjK03GHDG73A&oe=6AF9C2C1"}, {"file_name": "screenshot_5.png", "id": "2375639593252624", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825503_2375639599919290_8050320520478225106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8IO2lN-YH4Q7kNvwHcuh6E&_nc_oc=Adql92LYZ4_YuIAziinZ9udQ2EOO0fb4u5hcps_XcnrSY9HvNDiwg1vOttHGpxqlgxQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDwRh_WIynaJcaEcKIjMCfI0FGXKtaNAWQIJy-wDdH4A&oe=6AF9BE3C"}, {"file_name": "screenshot_3.png", "id": "2590546524704827", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823296_2590546528038160_2211483149645866306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um1h4L1iGx8Q7kNvwGgu_tW&_nc_oc=Adom0aPvgmKDTocYM-IBhPdj_CYWTqvIyDxZvJKCgqfv5gVgz00uauzN2wURFtZ-m4w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV2FeTDKzgJXAWKkB9Tdrg3FYZwP-A9JnqHlBmP6Zvww&oe=6AF9C6E5"}, {"file_name": "screenshot_4.png", "id": "2082777002346280", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825503_2082777005679613_6235343848470781585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF5LkgsvlcAQ7kNvwFCzcnJ&_nc_oc=AdqbjxCSUvgPW368aBijQ_LI7rsCh3XXYUKE_Tqw9oQhx3EDH9tJqFRRjJbtk8jWTyg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5jYda43wGkxBnWqaHrzDkgKpFQdNn0JAa5vaNf7zgqQ&oe=6AF9EC57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1311924707726047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_1311924711059380_3230763899156146910_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VjBoO8SXZEQ7kNvwHV06QG&_nc_oc=AdoAIjQPJF4RcWn-CU7JLWtg-5SoaXSlYPJF8K9SIN7XXvFtEsDvFmRZ2bHGv4XOxPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi0vS7b7NxkexjHu9H5tnO7fEk6gH7NQmHP-qGeCJuDA&oe=6AF9CB55"}, "display_name": "Flight Simulator Johannesburg", "keywords": ["flight", "simulator", "johannesburg", "jet", "pilot"], "long_description": "Flight Simulator Johannesburg puts you in the captain's seat over the real City of Gold.\n\nTHE REAL JOBURG\nReal satellite, elevation and map data a mile above the sea: the Hillbrow Tower, Ponte, the Carlton Centre, the Mandela Bridge, Sandton's Leonardo, FNB Stadium's calabash, the Orlando Towers, Gold Reef City, the mine dumps and their headgears, the Union Buildings, the Voortrekker Monument, the Hartbeespoort Dam. Four airports: O.R. Tambo, Lanseria, Rand and AFB Waterkloof.\n\nA LIVING CITY\nThe Gautrain and Metrorail on their real tracks, minibus taxis and Rea Vaya buses on the roads, airliners in O.R. Tambo's streams. At night Sandton, Hillbrow and the CBD light up and the highveld storms flash on the horizon.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Wemmer Pan, the Hillbrow Tower and Ponte out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the O.R. Tambo approach, Lanseria over the Cradle, a low Soweto run, BETWEEN the Orlando Towers, Pretoria's jacarandas, a Waterkloof fighter scramble, Sandton after dark and a Joburg tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Johannesburg, built from real satellite and map data: the Hillbrow Tower, Ponte, the Carlton Centre, Sandton, FNB Stadium, Soweto's Orlando Towers, the mine dumps, Pretoria in jacaranda season and four airports. Start in your own glass hangar, talk to live air traffic control, fly between the cooling towers, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorjohannesburg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorjohannesburg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373202429209626"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4746933502201244"}]}, "baseline_offer": {"id": "4746933502201244"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791383940, "status": "PUBLISHED", "id": "4746933502201244"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380331331830069", "version": "1.0.1"}, "id": "28950275271235715", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1373202419209627", "is_
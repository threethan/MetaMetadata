file_name": "screenshot_5.png", "id": "2375639593252624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2375639599919290_8050320520478225106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzHEcdZNlBoQ7kNvwG3cBP1&_nc_oc=AdryYvkkh1I7_4p9e8zQ_hM2KkYliMFzrIUS6q0Acuw-vApxiMwnJtnvMgDcjzpeYWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEt8XtXUtzw0QGaLer5UclldxSpA_stpZc4IImLED4KQ&oe=6AF71B3C"}, {"file_name": "screenshot_3.png", "id": "2590546524704827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_2590546528038160_2211483149645866306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlFpRdZqHlsQ7kNvwGqoamt&_nc_oc=AdrMtBky6zdrQyFveC_YKFtSHdyWHGhtF6IbZq2uQzVOECrn11DnN2h9RtOsIzyL4s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxBugGt0TSqX9xRNgM9Nx45zszozfSVxxONHw-mtn0gw&oe=6AF723E5"}, {"file_name": "screenshot_4.png", "id": "2082777002346280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2082777005679613_6235343848470781585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nkaa7PeibJUQ7kNvwHBgZrG&_nc_oc=AdoJBffQmywfGQ08Q-60T8lRmtbka4_3yLU_r3TkBBjuUZ9uj234-TTpaX_NEA9L-_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5He5aUReOQZRp2BIzJsNP9jG2hXS0qaFjdHdSsIwyzQ&oe=6AF74957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1311924707726047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1311924711059380_3230763899156146910_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EHysri9aowQ7kNvwG4Lpts&_nc_oc=AdpRLESYm_PkbRIAeSbWMDzq2eMj3wHrv_1TxIAZP6rp7BluwAySA5g155nvNaPko2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFQzdgLjVCPoDk2szY7o1Z9agDxw7oLYoyd8hRuP9-wQ&oe=6AF72855"}, "display_name": "Flight Simulator Johannesburg", "keywords": ["flight", "simulator", "johannesburg", "jet", "pilot"], "long_description": "Flight Simulator Johannesburg puts you in the captain's seat over the real City of Gold.\n\nTHE REAL JOBURG\nReal satellite, elevation and map data a mile above the sea: the Hillbrow Tower, Ponte, the Carlton Centre, the Mandela Bridge, Sandton's Leonardo, FNB Stadium's calabash, the Orlando Towers, Gold Reef City, the mine dumps and their headgears, the Union Buildings, the Voortrekker Monument, the Hartbeespoort Dam. Four airports: O.R. Tambo, Lanseria, Rand and AFB Waterkloof.\n\nA LIVING CITY\nThe Gautrain and Metrorail on their real tracks, minibus taxis and Rea Vaya buses on the roads, airliners in O.R. Tambo's streams. At night Sandton, Hillbrow and the CBD light up and the highveld storms flash on the horizon.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Wemmer Pan, the Hillbrow Tower and Ponte out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the O.R. Tambo approach, Lanseria over the Cradle, a low Soweto run, BETWEEN the Orlando Towers, Pretoria's jacarandas, a Waterkloof fighter scramble, Sandton after dark and a Joburg tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Johannesburg, built from real satellite and map data: the Hillbrow Tower, Ponte, the Carlton Centre, Sandton, FNB Stadium, Soweto's Orlando Towers, the mine dumps, Pretoria in jacaranda season and four airports. Start in your own glass hangar, talk to live air traffic control, fly between the cooling towers, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorjohannesburg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorjohannesburg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373202429209626"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4746933502201244"}]}, "baseline_offer": {"id": "4746933502201244"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791383940, "status": "PUBLISHED", "id": "4746933502201244"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380331331830069", "version": "1.0.1"}, "id": "28950275271235715", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1373202419209627", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1380331331830069"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "28950275271235715"}]}, "change_log": "v1.0.1 - cockpit fixes: stable cockpit at any altitude, seated fighter side-stick, private jet dash corners + cabin flicker fixed.", "c
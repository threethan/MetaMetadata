a&_nc_ohc=2LLgLyDZyuwQ7kNvwHjlkYP&_nc_oc=AdrLUaDPQeuK05mBkS0r1MPE3pDmMl85KOTDSwKrRJaKqDwSHTGWdD1Ddce_8QUEMHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzFpYJSqhKxAaBD-v5rKWsII1rsQI03BV8jhmrR7JTeA&oe=6B0326D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1311924707726047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_1311924711059380_3230763899156146910_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6Oxvq6lgrwQ7kNvwHoJTAO&_nc_oc=Ado3bFd-4qb0Z6DT358mIGacDtOCE2vni21B-Sm2SIdB05bTUJWp7AbYBi7A8H0Vu64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9qutiVlkaR7Eo6hEnpc3YhD-myB3jYz0IK0Qle2vT_Q&oe=6B0305D5"}, "display_name": "Flight Simulator Johannesburg", "keywords": ["flight", "simulator", "johannesburg", "jet", "pilot"], "long_description": "Flight Simulator Johannesburg puts you in the captain's seat over the real City of Gold.\n\nTHE REAL JOBURG\nReal satellite, elevation and map data a mile above the sea: the Hillbrow Tower, Ponte, the Carlton Centre, the Mandela Bridge, Sandton's Leonardo, FNB Stadium's calabash, the Orlando Towers, Gold Reef City, the mine dumps and their headgears, the Union Buildings, the Voortrekker Monument, the Hartbeespoort Dam. Four airports: O.R. Tambo, Lanseria, Rand and AFB Waterkloof.\n\nA LIVING CITY\nThe Gautrain and Metrorail on their real tracks, minibus taxis and Rea Vaya buses on the roads, airliners in O.R. Tambo's streams. At night Sandton, Hillbrow and the CBD light up and the highveld storms flash on the horizon.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Wemmer Pan, the Hillbrow Tower and Ponte out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the O.R. Tambo approach, Lanseria over the Cradle, a low Soweto run, BETWEEN the Orlando Towers, Pretoria's jacarandas, a Waterkloof fighter scramble, Sandton after dark and a Joburg tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Johannesburg, built from real satellite and map data: the Hillbrow Tower, Ponte, the Carlton Centre, Sandton, FNB Stadium, Soweto's Orlando Towers, the mine dumps, Pretoria in jacaranda season and four airports. Start in your own glass hangar, talk to live air traffic control, fly between the cooling towers, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorjohannesburg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorjohannesburg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373202429209626"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes
aJ&_nc_oc=AdqhTXsC86v8kP3Rma9_cULOXZBH1v8k6bg9d7kkn2h4y2YL_stmWV9RuOAVE9kZxMM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxD_-NfkFKQr1RGV0BVO6w8y0BiP8cZghMTkrolCEHOzQ&oe=69C14341"}, "display_name": "Project: Virtual Eden", "keywords": [], "long_description": "Survive the post-apocalyptic world where robots have taken over. Scour your environment for resources like lights, weapons, food, and armor. Survive through the harsh conditions and take down the robots that destroyed the place that you once called home. The environment is completely interactive, you can climb on any surface. You can cook food, loot buildings, collect resources, and craft! This game is still actively in development so there is most likely lots of bugs and glitches!", "short_description": "Survive the post-apocalyptic world where robots have taken over, and you are left to fend for yourself in the cruel world you once called home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6918967511532258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
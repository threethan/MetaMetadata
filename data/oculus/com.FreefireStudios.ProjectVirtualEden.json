words": [], "long_description": "Survive the post-apocalyptic world where robots have taken over. Scour your environment for resources like lights, weapons, food, and armor. Survive through the harsh conditions and take down the robots that destroyed the place that you once called home. The environment is completely interactive, you can climb on any surface. You can cook food, loot buildings, collect resources, and craft! This game is still actively in development so there is most likely lots of bugs and glitches!", "short_description": "Survive the post-apocalyptic world where robots have taken over, and you are left to fend for yourself in the cruel world you once called home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6918967511532258"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6973250066104002", "version": "0.138"}, "id": "1381686279109
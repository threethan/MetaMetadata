9B4E3"}, {"file_name": "screen4.png", "id": "237648922695517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_237648926028850_5838135102080810350_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ5CEjCeFgAQ7kNvwEwe18f&_nc_oc=AdlNeQGnQHDSfjxA8EG1lSMQ3ushHZylY8RkK_oxrr-5330G5h19WFyFVZtTy5EeG0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIRG_MBkBY5r4LbdZnZTOozYhzQSgNb-v27PgdUz7z-g&oe=6999A4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tease.png", "id": "1176464613321900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441583_1176464616655233_7342609445587398201_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKSByBpKNegQ7kNvwGk5OK5&_nc_oc=AdlUmwZOKWERLPJ25vU8hRgZKZO5DkjbUZ0giS5V-EqMe9d9TplnBODfW_np2aySNck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvH6u1YQHxdByHvV1tycDozZKpPU0ZCh5ZwISxs6q449g&oe=6999B641"}, "display_name": "Project: Virtual Eden", "keywords": [], "long_description": "Survive the post-apocalyptic world where robots have taken over. Scour your environment for resources like lights, weapons, food, and armor. Survive through the harsh conditions and take down the robots that destroyed the place that you once called home. The environment is completely interactive, you can climb on any surface. You can cook food, loot buildings, collect resources, and craft! This game is still actively in development so there is most likely lots of bugs and glitches!", "short_description": "Survive the post-apocalyptic world where robots have taken over, and you are left to fend for yourself in the cruel world you once called home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "com
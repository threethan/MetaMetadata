0a&_nc_ohc=76O3htPiQk0Q7kNvwFlQCZy&_nc_oc=AdrC7jp_w6Ug8FdCEHjRwrG5LXlc5pfDE-q6tZyOpjd-VZ7n5uX9gxZ23_m92s-oqN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-3sOHXXrQE18yHRf_Sc8sLCumxSpoSZWwESWvc8yo8A&oe=6AFC66CC"}, {"file_name": "Screenshots3.png", "id": "1041880324787442", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827282_1041880328120775_7204104652932295874_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWip58jjBRAQ7kNvwF6fcTs&_nc_oc=AdryGh70CR6Qor7OdGIslGOpivpXtwXAd9TDKVNqwtJlAsnOtw5A_uPh9yJCf3Klqh0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT68ADtEA3NxM8Gzkd8gvn0Xk-3b9NChVhwtUipza-JCQ&oe=6AFC6590"}, {"file_name": "Screenshots4.png", "id": "750665607472399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507838221_750665610805732_2746628426978505079_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YotRH-wgNocQ7kNvwFxsKIB&_nc_oc=AdqBEnwBAHoZBpc-jKIOgKyXSVXXd9zTh_vd24IXhFybM-K1H7tBSuDovKBJrR6DDTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR8uZEHWL5tqWABNNGSNAAzGJ3i3KIzWDDXXY_8d9TNQ&oe=6AFC6F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holy Bible", "keywords": ["bible", "holy", "biblia", "santa"], "long_description": "A modern and elegant Bible reading app that offers a complete reading experience with multiple Bible versions in English and Spanish.\n\n## **\ud83c\udf1f Key Features**\n\n### **\ud83d\udcda Multiple Bible Versions**\n\n#### **English Versions (9 available):**\n- **KJV** - King James Version\n- **KJV with Strong's** - King James Version with Strong's Numbers\n- **ASV** - American Standard Version  \n- **ASV with Strong's** - American Standard Version (Strongs)\n- **WEB** - World English Bible\n- **Bishops** - Bishops Bible\n- **Coverdale** - Coverdale Bible\n- **Geneva** - Geneva Bible\n- **Tyndale** - Tyndale Bible\n\n#### **Spanish Versions (6 available):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1858** - Reina Valera 1858\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 with Strong's** - Reina Valera 1909 (with Strong's Numbers)\n- **Sagradas** - Sagradas Escrituras\n\n### **\u2b50 Favorites System**\n- **Save Verses**: Add your favorite verses with one tap\n- **Copy Functionality**: Copy entire verses with reference and metadata", "short_description": "2D Holy Bible with several versions of books in English and Spanish"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2a9RVyaCRoT3SMOtdTwtKuFZSdIYrVVvKWwqAbRgEs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/biblie-vr/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10073643992755669"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1423762125608957"}]}, "baseline_offer": {"id": "1423762125608957"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751155320, "status": "PUBLISHED", "id": "1423762125608957"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25832680429758772", "version": "1.6.0"}
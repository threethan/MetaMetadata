90655_1187504632366665546_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK57qAXwWo4Q7kNvwHDcbe0&_nc_oc=Adrf3f4vf6sW1LS3HS6ujSiw_dEQXf4UUmTC7LvHzVfEdMH5m7zsnfY_WvnWqok9lzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyjA9-zDXWNtMoP6PaZLS_I_P83CW1NLiOrAL47RtlqQ&oe=6AB920D7"}]}, "id": "1467575007826864", "locale": "en_US", "screenshots": [{"file_name": "Screenshots1.png", "id": "982434117190171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507833247_982434123856837_4166570607292282212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl9bnCPi-4kQ7kNvwEEx5-U&_nc_oc=AdoflycFbyMJlU2WmTi22eg5anQRNxZy8bYj-5XpluWXWJ9SSK1K_JJVodvXtYp3XCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFpPLlD7DoRqwUlIiFhgbvv4mw2WMoSLCyc956xLNxhA&oe=6AB90814"}, {"file_name": "Screenshots2.png", "id": "722121720463623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830615_722121723796956_1827050947745666925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apfiejo19KQQ7kNvwEkOvGI&_nc_oc=AdqDoVJAKjbDpTn7k_VVECgletyQZAxTcOGpZm9GR9LjYpp_A98xs7LTG1Q8_MmgkV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNv4bhUnOleXqYWfw23_POzWC3Glkf8wEAVfN6r_FHKw&oe=6AB93DE0"}, {"file_name": "Screenshots5.png", "id": "1370323520706357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507838221_1370323524039690_4225516602237080327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VOWPwGE618Q7kNvwFA5oY4&_nc_oc=AdpeCAL4ux0xXJejBeR7sdUOI4m_b9voZv4WTFpePI21Eb_8WVJeRqA5-6bGwWD1tjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlvYJD4vqwyA--yzRzFhfyAn5Dt33JonlXmWVK6RK4qQ&oe=6AB92A4C"}, {"file_name": "Screenshots3.png", "id": "1041880324787442", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827282_1041880328120775_7204104652932295874_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhrT--fGoM4Q7kNvwEjqlln&_nc_oc=AdoCOZv_ncT028_av86QOYRv2THqgQ-VYuc_qyqrAY5db5DS5BlgB0hbYQg1tePs7b0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb7uljzu5ENT8vtMJnOiGNLRttkda5Tb-0WXmU7znSJg&oe=6AB92910"}, {"file_name": "Screenshots4.png", "id": "750665607472399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507838221_750665610805732_2746628426978505079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sry1rvzYSdUQ7kNvwEiYgqk&_nc_oc=AdrCsLwMDRWbVbGg-rUDqIqAwksVbHIVd4iDOYE5UB4BhBP52yFjFe_-WDbkYsnnlbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlpiPYJNe006EdhL2edbFbT1y8wfqazNz5jsGJsviQpg&oe=6AB932E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holy Bible", "keywords": ["bible", "holy"], "long_description": "A modern and elegant Bible reading app that offers a complete reading experience with multiple Bible versions in English and Spanish.\n\n## **\ud83c\udf1f Key Features**\n\n### **\ud83d\udcda Multiple Bible Versions**\n\n#### **English Versions (9 available):**\n- **KJV** - King James Version\n- **KJV with Strong's** - King James Version with Strong's Numbers\n- **ASV** - American Standard Version  \n- **ASV with Strong's** - American Standard Version (Strongs)\n- **WEB** - World English Bible\n- **Bishops** - Bishops Bible\n- **Coverdale** - Coverdale Bible\n- **Geneva** - Geneva Bible\n- **Tyndale** - Tyndale Bible\n\n#### **Spanish Versions (6 available):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1858** - Reina Valera 1858\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 with Strong's** - Reina Valera 1909 (with Strong's Numbers)\n- **Sagradas** - Sagradas Escrituras\n\n### **\u2b50 Favorites System**\n- **Save Verses**: Add your favorite verses with one tap\n- **Copy Functionality**: Copy entire verses with reference and metadata", "short_description": "2D Holy Bible with several versions of books in English and Spanish."}, {"images": {"nodes": []}, "id": "1305413407437749", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Biblia", "keywords": ["biblia"], "long_description": "Una aplicaci\u00f3n moderna y elegante para leer la Biblia que ofrece una experiencia completa con m\u00faltiples versiones en ingl\u00e9s y espa\u00f1ol.\n\n## **\ud83c\udf1f Caracter\u00edsticas principales**\n\n### **\ud83d\udcda M\u00faltiples versiones de la Biblia**\n\n#### **Versiones en ingl\u00e9s (9 disponibles):**\n- **KJV** - Versi\u00f3n King James\n- **KJV con Strong's** - Versi\u00f3n King James con n\u00fameros de Strong\n- **ASV** - Versi\u00f3n Est\u00e1ndar Americana\n- **ASV con Strong's** - Versi\u00f3n Est\u00e1ndar Americana (Strongs)\n- **WEB** - Biblia en ingl\u00e9s mundial\n- **Bishops** - Biblia Bishops\n- **Coverdale** - Biblia Coverdale\n- **Geneva** - Biblia de Ginebra\n- **Tyndale** - Biblia Tyndale\n\n#### **Versiones en espa\u00f1ol (6 disponibles):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1858** - Reina Valera 1858\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 con Strong's** - Reina Valera 1909 (con n\u00fameros de Strong's)\n- **Sagradas** - Sagradas Escrituras\n\n### **\u2b50 Sistema de Favoritos**\n- **Guardar Vers\u00edculos**: Agrega tus vers\u00edculos favoritos con un solo toque\n- **Funcionalidad de Copiar**: Copia vers\u00edculos completos con referencia y metadatos", "short_description": "Santa Biblia 2D con varias versiones de libros en ingl\u00e9s y espa\u00f1ol."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2a9RVyaCRoT3SMOtdTwtKuFZSdIYrVVvKWwqAbRgEs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/biblie-vr/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "A
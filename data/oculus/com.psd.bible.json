123856837_4166570607292282212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax0d7H9RLYgQ7kNvwEYxpYn&_nc_oc=AdrY-4zWz6sM53891eBECUWDgCO9ublgxIuB8HzksMouzZjgT72YlUGieS6ITrljXhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1T662a5p2dNBI3JkGfk2WKm-6Pvpuyh680b2IZL4zIA&oe=6A295494"}, {"file_name": "Screenshots2.png", "id": "722121720463623", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830615_722121723796956_1827050947745666925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_1jFbxk9eAQ7kNvwFEoGbR&_nc_oc=AdqL1Lzsf_IMSPpl-y8zoRX_04TA1NK8sLSMteAnjtVqHNKP62CsocMsu5i4SJWDld0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KH29QJpwvh9feT4wAVnpen_yAsSqNxZ7rF-H6m7Pfeg&oe=6A298A60"}, {"file_name": "Screenshots5.png", "id": "1370323520706357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507838221_1370323524039690_4225516602237080327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNSWcPBQFboQ7kNvwGkrp7Q&_nc_oc=Adq-hTfnKPE3LMrQCjn6TMXIZgYMYW7OhPE7uFyxfpFNXUWbdSmhmhpiuHEjO0VXHRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PNOT1Vh_piZJYdHRrcLXZzKknKilWU3bpJqyt_Gy3ng&oe=6A2976CC"}, {"file_name": "Screenshots3.png", "id": "1041880324787442", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827282_1041880328120775_7204104652932295874_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XjuMd-jBWQQ7kNvwHL0ZsU&_nc_oc=AdqoY0gfrfxXb4wywWTRPjrs451THI4V5RSvb2l3J-79lUpoRmjarj79tbj1zxz5zBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x8VLaQ5CQ5c6y5XKf0HdZiHdUUONIBMbIgYi-_2ZeYA&oe=6A297590"}, {"file_name": "Screenshots4.png", "id": "750665607472399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507838221_750665610805732_2746628426978505079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuRoatiY1tkQ7kNvwHp1dsX&_nc_oc=Adqxi1ox9vHgIwlT5bsrVg4TtP-uMfJOXl5uaWX_M3eE2oIsYrZUEnqHYVPgvQlM2PY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ni_0yqLPlc0J2LsFEPM1IhOUZDhWrMuutpFZvoj1IyQ&oe=6A297F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holy Bible", "keywords": ["bible", "holy"], "long_description": "A modern and elegant Bible reading app that offers a complete reading experience with multiple Bible versions in English and Spanish.\n\n## **\ud83c\udf1f Key Features**\n\n### **\ud83d\udcda Multiple Bible Versions**\n\n#### **English Versions (9 available):**\n- **KJV** - King James Version\n- **KJV with Strong's** - King James Version with Strong's Numbers\n- **ASV** - American Standard Version  \n- **ASV with Strong's** - American Standard Version (Strongs)\n- **WEB** - World English Bible\n- **Bishops** - Bishops Bible\n- **Coverdale** - Coverdale Bible\n- **Geneva** - Geneva Bible\n- **Tyndale** - Tyndale Bible\n\n#### **Spanish Versions (6 available):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1858** - Reina Valera 1858\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 with Strong's** - Reina Valera 1909 (with Strong's Numbers)\n- **Sagradas** - Sagradas Escrituras\n\n### **\u2b50 Favorites System**\n- **Save Verses**: Add your favorite verses with one tap\n- **Copy Functionality**: Copy entire verses with reference and metadata", "short_description": "2D Holy Bible with several versions of books in English and Spanish."}, {"images": {"nodes": []}, "id": "1305413407437749", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Biblia", "keywords": ["biblia"], "long_description": "Una aplicaci\u00f3n moderna y elegante para leer la Biblia que ofrece una experiencia completa con m\u00faltiples versiones en ingl\u00e9s y espa\u00f1ol.\n\n## **\ud83c\udf1f Caracter\u00edsticas principales**\n\n### **\ud83d\udcda M\u00faltiples versiones de la Biblia**\n\n#### **Versiones en ingl\u00e9s (9 disponibles):**\n- **KJV** - Versi\u00f3n King James\n- **KJV con Strong's** - Versi\u00f3n King James con n\u00fameros de Strong\n- **ASV** - Versi\u00f3n Est\u00e1ndar Americana\n- **ASV con Strong's** - Versi\u00f3n Est\u00e1ndar Americana (Strongs)\n- **WEB** - Biblia en ingl\u00e9s mundial\n- **Bishops** - Biblia Bishops\n- **Coverdale** - Biblia Coverdale\n- **Geneva** - Biblia de Ginebra\n- **Tyndale** - Biblia Tyndale\n\n#### **Versiones en espa\u00f1ol (6 disponibles):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1858** - Reina Valera 1858\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 con Strong's** - Reina Valera 1909 (con n\u00fameros de Strong's)\n- **Sagradas** - Sagradas Escrituras\n\n### **\u2b50 Sistema de Favoritos**\n- **Guardar Vers\u00edculos**: Agrega tus vers\u00edculos favoritos con un solo toque\n- **Funcionalidad de Copiar**: Copia vers\u00edculos completos con referencia y metadatos", "short_description": "Santa Biblia 2D con varias versiones de libros en ingl\u00e9s y espa\u00f1ol."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2a9RVyaCRoT3SMOtdTwtKuFZSdIYrVVvKWwqAbRgEs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/biblie-vr/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_m
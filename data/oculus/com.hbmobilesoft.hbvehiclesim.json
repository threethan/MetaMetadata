tent-ord5-3.oculuscdn.com/v/t64.5771-25/491823270_1504863887700969_7134607909642194846_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l4VLkRzUyUQ7kNvwEd83_y&_nc_oc=AdoPEGX-QW31c3sdbcjtk4KVfIL7XNjpZBrppD30azJYGZLHtRzcMXj8O6dm5kUZoTo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbS1jAkjNjXferbogw8qDGeSKP817qcg8xp-gXmhJfrQ&oe=6A4A507B"}, {"file_name": "39114b223cae418dbbb4f9c0b5fdeb5a (1).png", "id": "1510873560776224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1510873564109557_6209630289312582593_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XojDTmJWH9YQ7kNvwHqsDh3&_nc_oc=Adqk4jQbctassPpjfBEWMoUy_9-iqXcDSt7UV04p0rNHrOto8LNQAaxS-tMAugYqNzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRkvN22lSVOC3Vmh4lCymIIvO-fCOoiDULJ54VJWXA6A&oe=6A4A6E62"}, {"file_name": "ce0b7b6354524f51a983cbbeabe4a6d3 (1).png", "id": "1277042554455653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820141_1277042557788986_4336016866168390042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xL6Kw3OLTl0Q7kNvwHTWXLc&_nc_oc=Adp830UzO-6gXyoZLJTzyxeuuLBa6EZiHobbwDGW3oO8sgL32w0_ZdnZVyUyWHtCFPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_EHwkuEzmS9K7zdu4sWgWeJ7BDA2hayBKN68AmsY9Fw&oe=6A4A67D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelgrafik.png", "id": "1871444597055038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_1871444600388371_3759652692729801135_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA78cNN_PqAQ7kNvwGXsoXy&_nc_oc=AdrFPuI7bc-5gXD9A1LshSM-9iCqCDZgFJmf_V7u55r8yXNdnT3q76v29V7N0YPPMR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5NCLyYBjDemsoMoTER8bvpnH5aV8-X1bWfPfqfDMKsg&oe=6A4A7C49"}, "display_name": "HB VehicleSim", "keywords": [], "long_description": "HB VehicleSim verwandelt deine reale Umgebung auf Meta Quest in einen interaktiven Mixed-Reality-Fahrzeugspielplatz.\n\nMit Passthrough Mixed Reality kannst du Helikopter direkt auf deinem Boden, Tisch oder anderen realen Oberfl\u00e4chen platzieren und in deinem Raum starten. Fliege durch deine Umgebung, lande wieder und erlebe Fahrzeugsteuerung in deinem eigenen Wohnraum.\n\nDu kannst au\u00dferdem Boote auf virtuellen Wasserfl\u00e4chen platzieren, die in deiner realen Umgebung erscheinen. Fahre \u00fcber das Wasser, steuere durch deinen Raum und erlebe, wie sich virtuelle und reale Welt miteinander verbinden.\n\nFeatures:\n\u2022 Mixed-Reality-Passthrough-Erlebnis  \n\u2022 Platzieren und Fliegen von Helikoptern  \n\u2022 Platzieren und Steuern von Booten  \n\u2022 Oberfl\u00e4chenerkennung in deiner realen Umgebung  \n\u2022 Interaktive Fahrzeugsteuerung  \n\u2022 Einfaches Sandbox-Gameplay  \n\nHB VehicleSim wurde als unterhaltsame Mixed-Reality-Sandbox entwickelt, bei der dein Raum Teil des Erlebnisses wird.", "short_description": "Platziere Helikopter und Boote mit Mixed-Reality-Passthrough auf Meta Quest direkt in deiner realen Umgebung. Lande einen Helikopter auf dem Boden oder Tisch und fliege durch dein Zimmer, oder setze ein Boot auf virtuelle Wasserfl\u00e4chen und steuere es durch deinen Raum. Erlebe eine Sandbox, die reale Umgebung mit interaktiven Fahrzeugen verbindet."}, {"images": {"nodes": [{"file_name": "6a8418d6528fbe0ff5a04e393cc1debac16bc464c3538b3a4e88a25e9110ae11.png", "id": "2768685540135199", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_2768685543468532_9103576054328277495_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ierghw_oAocQ7kNvwF55Typ&_nc_oc=Adqyt1flgsb-m7bw0ksb2ubx6HVy41BEpDw41JQqoiwdfoOZZf-IYlKBFD7l0R00Lk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9sLJSThUzMJGd_jEdbOT0baatsAuGzZ8_HQuMyoHkfw&oe=6A4A7F83"}, {"file_name": "Symbol.png", "id": "1770836030956863", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_1770836034290196_8444
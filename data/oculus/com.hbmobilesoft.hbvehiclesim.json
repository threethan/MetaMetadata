nNTEQ7kNvwHbYH_b&_nc_oc=AdoXP52JIJ1Yw3-r_aCemDTn4o3pLtHSxhSs8IWdDvUtD_7Bofu5NV-3Hj8tNGFFm7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSMhzbEfGZrp3_3X_YETfs2egCrTrc682xz8SkCwQiwg&oe=6A4A6C17"}, {"file_name": "39114b223cae418dbbb4f9c0b5fdeb5a (1).png", "id": "975268738702224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823270_975268742035557_8256114146598816081_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3HlhUt-AMUQ7kNvwGCp58F&_nc_oc=AdpbsULA_0LsE5w5nMQ_AEAXngKbFz95Ph3obt1hng58nLzI2H26rPMS_kRJiVrY_9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYC8NoL9xfWIn5RxhoIoLAghehRfRDAkgGIhfPXSuvQA&oe=6A4A69B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelgrafik.png", "id": "904082979327935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_904082985994601_9113369119808982656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKzGS6ru_VAQ7kNvwHKaKBi&_nc_oc=AdrPtEwlU4KAHDUl_dGPr0pV2qX_bw_VIjCUffwagVSCMf0v-VUSfS9SIQH3GRlySW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiuBaUcWHCyTMfSSOnV1KJ0jnxfd8ja9a3g1UuEKN3aw&oe=6A4A607C"}, "display_name": "HB VehicleSim", "keywords": [], "long_description": "HB VehicleSim transforms your real environment into an interactive mixed reality vehicle playground on Meta Quest.\n\nUsing passthrough mixed reality, you can place helicopters directly onto your floor, table, or other real-world surfaces and take off into your room. Fly around your environment, land again, and experience vehicle control in your own physical space.\n\nYou can also place boats onto virtual water surfaces that appear within your real surroundings. Drive across the water, steer through your room, and watch the virtual world blend with your real environment.\n\nFeatures:\n\u2022 Mixed reality passthrough experience\n\u2022 Helicopter placement and flight\n\u2022 Boat placement and driving\n\u2022 Surface detection using your real environment\n\u2022 Interactive vehicle controls\n\u2022 Simple sandbox gameplay\n\nHB VehicleSim is designed as a fun mixed reality sandbox where your room becomes part of the experience.", "short_description": "Place helicopters and boats into your real environment using mixed reality passthrough on Meta Quest. Land a helicopter on your floor or table, fly through your room, or place a boat on virtual water surfaces and drive it around your space. Experience a simple sandbox that blends real surroundings with interactive vehicles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hb-mobilesoft.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bernhard Halbauer", "support_website_url": null, "website_url": "https://hb-mobilesoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27809076138681301"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1007471904961454_472347692739442836_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aag0H8xHj_EQ7kNvwGWcCUo&_nc_oc=Adr0D6Pt2rqCjBV-43OIWvsC935EBtCekt_ko8KNaQiEFAI8v5NQdbIJ-fClMIyM9kQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPPF5l8XFWnLTfEWwlZAG2vdGnSKi42_VF4aei1RgFnA&oe=6A4A58C9"}, "is_concept": false, "is_test": false, "is_trial_offer_val
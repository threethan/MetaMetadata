q-pouwQ7kNvwF1bn8L&_nc_oc=Adp63DeRt05cRGj-tSQOhgMFgAFUcee9lsFvLcvc-YnQh95vMM_E1D6810vXDZXRofI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4NbJRi7lAXJU4YhU864qkbCJKYiOTzdU7IyEFdQWOA&oe=6ABBCE41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvMjfn359FkQ7kNvwG7077J&_nc_oc=AdqZtA6h2g1kVVCLHiIxCz6DMvd2NOnvdfIJRcxdLV2bBdhUQwBeeg9swxfmSEbXuzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz0R_0Oadx9q3M5PR8FY_M1iOOGvw-zUt1Yx3y8anvdA&oe=6ABBB079"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AHN35UsmPUQ7kNvwEZqqf1&_nc_oc=AdoqdFtdmDHVpC1GLXwWt7fZKuQhcyS7czMBdxQ9WLotdDFaScsC-TaswSfGx-W7Yq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7s0AmppOt55jWfIInCeg64OCD7w7JRHtZxOZ5pXizxQ&oe=6ABBBA8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq8K28XYshkQ7kNvwFq2Y59&_nc_oc=Adp136ig1eQmQDli-KrBsuEwpVc9LOQkBPd2alsXiRNGpZQiKPdO_U2Fg-ftN0ZghjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1o_bn7kPfqULobayaw8Iw8689J9zhqfnRk_asjxrWZw&oe=6ABBAEFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0UIyNihwBcQ7kNvwFj0A1v&_nc_oc=AdqMXzBabm_vL7tJXu60gUNE9KMmZFDSYO-pBvXOKF_rnGSQk-VdTqSHNdg8qPEPrMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeLLxg9dqI5aUkpK3URKXQtA1ro1Jz4g4_nqH9EiPgjw&oe=6ABBC5CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
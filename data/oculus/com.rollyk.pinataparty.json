Q-Bvm4Q7kNvwHzbooK&_nc_oc=AdreMpN9KCYr-QNV8fpC7IUBBivz6RfkPm_cBhtvwpUb172mufgUvSq2r0L2kyQLdPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiAAaTiy7tuqexX1jds7VxmdLiQWAuXekwCn9n_I5w6Q&oe=6ABE7141"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQIQiiV8qU0Q7kNvwH_-k8i&_nc_oc=Adr-b8EMPP3RZ6i9G2Y9g2jHGPanpgaxGnoqa-ETPC_FYmmfdrc4k1wusK5XWgQeXqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeZ0-BlnBabjjiAGv4eD4rQAYSvp6gucqTwg-Y6DwyZA&oe=6ABE8BB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AHN35UsmPUQ7kNvwEjBwfg&_nc_oc=AdoJNa8UInt4ddY__iLuXi3nQ6Sp8C78MtzlJPGcbGZYKLPqk90X7ySf9wloOz23ECc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Yzk0dFLEhmbP5923zf0PSzSSnbZvPUSfKh21-uxIDg&oe=6ABE5D8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8t-xRi4mhkQ7kNvwHbFdqt&_nc_oc=AdoKPCal0QnaDxbuQVYhR1X2a8GKE2NtTZ1aTljzHXa4CpmaNuXiGqtHXnd6uGXKHs4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNkfgCRMtq3CLffTULd_uc_ICVTEGMpj-NGqt9cy1gog&oe=6ABE8A3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0UIyNihwBcQ7kNvwFd4DEP&_nc_oc=AdrgrQUOGtwoPTjfXj5CfFyGMpZkHqdKKk_rm_ElNzj8d08wyUd8tZJiKEL8WxV7cic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyg1mc-uuCCc5RHWwKIlad_F2xzeD0-kRkx-8AETAskQ&oe=6ABE68CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
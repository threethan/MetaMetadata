rSjz0UQ7kNvwHHHlZb&_nc_oc=AdrNPcBkC1jpWj5SgiLxby9xaP63uv_ZzySqwJxgXbJiFZ3LWAEwm3jCirgYXBaqyC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4qxA_-vYZrF08lr3Rhm7M4w6xoJtXezEo7wUTjJPgmQ&oe=6AA6B641"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWI_lHAtEeYQ7kNvwEIWxji&_nc_oc=Adq6jsG_o0oothPYyw81LB_ZInUj1KdE-eyJ-hB7mzztZxfE1JqlhJpw5GizHgtKocg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVwqTgYYarc8YO5DgoG8txHzaii0oBGfr79wcDru3nJw&oe=6AA69879"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUCIoxTXn4gQ7kNvwHp2Mlk&_nc_oc=Ado9B93Q-WK_BYADmQt_TgoY439GueRZGVG8zinANz12uw58Lp8xKH8LOBiZ5EsT2wM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlu0uZl5xC9jhbFdnpAjpxREbYEDHW8oWNK8S7Npn5Nw&oe=6AA6A28C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3uF-TG0N6EQ7kNvwGQSc_z&_nc_oc=Ado9b2T6afWN2W-Gsgn42XXu5e7tnB9nEjLo4S_OaaZE9MGGJ2y7nobZxgPP3-G119Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwxPgWfP_3E6IZK-9KQmbH1-QolmGaCLAmd5VTCQgcCQ&oe=6AA696FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NvRMcF_q-YQ7kNvwFwbTcE&_nc_oc=Adqog1LWeNFxhq6Q8fLBXho17DcrfZAaDPhhUdm5dTIFqcFKqmLGGiIn6GkC7GbgOb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1ri6THs9IFUzYoEu7QwqI4YbrzgbIwQyQpZ_aT-roPA&oe=6AA6ADCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
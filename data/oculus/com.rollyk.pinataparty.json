6qL7-kQ7kNvwE5cRjo&_nc_oc=Adpgn0dNUV5URUE-AANfsDD_iBO1nU9gfyiVGnxiEkCljIiBWkHkAsFn2Rm1fLJHTL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRUGVbYjyYcJH5gP8CcNVFU7x8YGVW2VD9OTi4JTdOkw&oe=6ACCF1C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NnSE4EHb_8Q7kNvwFn5rFk&_nc_oc=AdqGdSLcvX97AljxC63i27WLJLRUQx7ibju8go-SmVn0skK9Jj60ETt6r38LQpI0EQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5sSYFt7dln6Z4d4iD0ESvhshep0K4hceE5-xit4RmlQ&oe=6ACD0C39"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwXlicCU3nsQ7kNvwHSw81Y&_nc_oc=AdqGK0oI41CeZ4yOP4QMHuL9UCtDZZj6KiLMMVhHAAXH88xTFjeSSqoHGSU4uEXtay4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3DfPWL3ldeMglZkRZKriuxVSnk57JNpIJbdSPIgd4yQ&oe=6ACD164C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lxwfu_-YMdwQ7kNvwE192y1&_nc_oc=AdquJhiYRQ22g-0V-OlvLfdnZu1x1sFptChHLrc9bDGaIQK5rIjiynWlEirKwVnKNxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Z24FJSUvWZirAW-N2G5ttMGkP2p228Dwi6vL1dtS0Q&oe=6ACD0ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p_HlGD6wjQQ7kNvwFXmU45&_nc_oc=AdrDuUkyy-1K-pajAs4CheXt6Y_lUQZf33HEJ0tfdpoTP6Xtbtel3IgOohX6zb8hGe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPNAZt0Exi1pcPImyYEXiahYgBZ_w4bMav2stYM1SqyQ&oe=6ACCE94D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
r42M8YQ7kNvwF-iPU0&_nc_oc=Adq0g88gKjtf7Zvwmmw644Pe1DBLdPifMJKBJQB-TVkbfYPvL8qel80rl2GMVbXEoA4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxi9FL-6ipJ4yNEYMZELFqzvyBgpqcGSj0jABP17KWxA&oe=6A819401"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNEHGj0tnngQ7kNvwGoHi4x&_nc_oc=AdpJ5ZnmCqRiv4YiBbZijffkJtkGbKWsJ041k84M1Nq5CDFttpH-C9dHc9AzuhM1rnA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvfCia04W_2gXyRE5mhvxbSjF3P3mTd-lHxdwzY9ei0w&oe=6A81AE79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk2OFVYNdEcQ7kNvwEo30Ip&_nc_oc=Adqgk36Gf38WVSKF8SiMOIz3SPhNyE5oKKNEMSPtBTVY_0eHXIl4efgvEcoA9VFzo3s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt_1p7ytF0ZcZ9SiKJI9kn3FUnaZSdd9PUyYNCM-S59A&oe=6A81B88C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4p0v5c-olYQ7kNvwFZnlpZ&_nc_oc=AdoEAlTMpvwNEg3QHuKn_SlWgT0_Z-5Ouf7Od1T7BmlP1SXBP7H0oNqmxjCOwie0vR4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSwVA6OwIgWL8107cE_k44KwvPpHNQjTDliUGrdtVLKQ&oe=6A81ACFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1J0vsKLvZAQ7kNvwF5oTiG&_nc_oc=Ado3zY6LYOQ16EWkJZPXWCnIx7747UkCdZZZ3dyIx4WBSBzKDqXGaIRCSgXx50GdYz0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLIf5PKg5p2xyPnq4W3IGUUp7CHaxC6yrmD8vl685Dcw&oe=6A81C3CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
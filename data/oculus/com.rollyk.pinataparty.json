Qj0rNEQ7kNvwGM-fkb&_nc_oc=Adp5HomdclZmzFe1GihjSWELHMZDXOuU29IIzPjURXJGkmn4GQdAwgub6m5KRFljOqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiC9Touz_DMz-zkao3ooe3g5duM1TvxlD-PUE3y0gsaw&oe=6A525641"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFZdC8Bimq4Q7kNvwE_bxHW&_nc_oc=Adppz_IFsNBlzY1TZcWjctR0mkG6Lsxo98hKMuoQDpdK-EbbL_P3qtiK7IFb0j05SoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcV369S6eQbVBiPkkM59pggkCfj__CBO8Pe3fCfJk4zg&oe=6A523879"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdpDNyOEwxMQ7kNvwFeH672&_nc_oc=AdqZTu6QpDOHaJ2TCE0UwNH-umUAF1QLXp2hfe0yIIhEMTvE5a3ZZDT0ODCz44QThKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFHGjKuptIMPO2rS4t5zn28QREA7v9rAhg4S1ILJC6ug&oe=6A52428C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCWE8Uj70_4Q7kNvwF3xy-K&_nc_oc=Ado_MEvHDSpKt_P6DjWuv3VTWCOS14zSfl1OKwdvBYcALEQDLFfjUs6uLgzp2YGwOQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLuaftGBQjuI2Cf7CCHHZxcRMpbxm2WbvTUSc8RHbgag&oe=6A5236FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd4-bw9ODI0Q7kNvwF6mEaA&_nc_oc=Adr2H97OgVuofQmxV9h5bxT2zcM28yCKYhPUkZK_BmfsFic4VsNE7Y6Xm81u53gwWSw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcyCXKU4u427OjmoxpSDqxcGOQwH-kssOa58A1yMWGsg&oe=6A524DCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
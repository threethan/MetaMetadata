Gszw3UQ7kNvwEZ43DU&_nc_oc=AdoXiY5XLBuXH9Dk-lRnO1N-owrcP7r3jOW7_uoCBJkJqhI_hz6FgzJ16VNmzJ4-7m0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h26gOligYD5JYBfM-_TE6wYZD6Plo1Qmw0vl0KEtQLA&oe=69FCA4C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlYbadjeKE0Q7kNvwHz0YV8&_nc_oc=AdrYMwx9KwKRo3s8Mtw91FVn-nB4zG1w3x-l5-g07kswUetGts-RCDzuC7_EtH7vndk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PXL4NOjAA8Vk1mnoAcamosE2YXbtLLgTKHP6X87sgLQ&oe=69FC86F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJYL2ZqdlJIQ7kNvwGsBOaC&_nc_oc=AdonAz4VIFVXeL7UjmM9ZeYJs0fiw0ocVZOr2UU6Q9WcR9kJ7xlpCpHEDqeLa_3MfJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7srNXwDe__DJED3NUwmMWPsZhfFJnF31GhXLZ_kxsqIw&oe=69FC910C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYUdJ-5SinMQ7kNvwFmqE9O&_nc_oc=AdoBh9-eW5WYNREQmQIbgafblooAcCBsuG4FTESXpQBFYuDola9GQumV6NzKzDaVV6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rNRCuGYnVZIydHMLGqvPT4RUHVojcC3qp8xJY9q2bBw&oe=69FC857B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGAWAPzsqmwQ7kNvwEolTgp&_nc_oc=Adov7Qn2vWJ-BI0MO0s3HFgnV08MrBwS1bo1g9Tw36yvDMyNdYPVAOZyxewDbTAeHbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AgPeYp8lBF2H9WNY53u1JsiElPXu6Tj5SzGzMDnKPBg&oe=69FC9C4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
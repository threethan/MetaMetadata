hvpZG4Q7kNvwGE_Mjk&_nc_oc=AdreTKdvXegsDqr_tkSzR-VuK7umGhWN58dKtjyioxEb9JRKgWJtK-DV6QkaTW9krBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HrTFyiZovjxwmVBY30jc2YpkfE73PEqTMrJ12f9x1Vw&oe=6A145FC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKCc3KvqhKsQ7kNvwGgbaCM&_nc_oc=AdrDdQoj7ZzCYHLEHXSSO0bbGxQs5ZSa1OqDoISHMaSIyR-hlnJtJaR9QkKUn9gEFAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yITYHiArDF8wEKmxK5LS3eegna21oO5x4Iw1JcDKGbA&oe=6A1441F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jacx_B6fuAQ7kNvwGP3mVK&_nc_oc=Adoz55H9yrZy6HhdtBb1ww7eAFWsY91H3QpVDa1NTxr77FqmWZYdZIC6sKOPJ9eXmH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e7e1kGQvJ-br5YcMGLgjBbsNn6JAYj7CYgp0FewZdgw&oe=6A144C0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS_byFSGb20Q7kNvwF8Jwv5&_nc_oc=AdpS2nTdXcgt-KRP-PUf7uzBhHc20P-pNJJhEapXiYKSG5Spg701iJWnzrfH_grA0iE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PcKDWNStGhiva5kWPC8y_QZilf1m3EU5jdKv-08wQog&oe=6A14407B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nu2N9CNFBcQ7kNvwHullvk&_nc_oc=AdqXKr44ENVZ0bBWCENbqjFHDRoPmUOcpp_q8Knz_gV7WbslMur9Fbz4dKcbKiBPBIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4289wBheljkJV9UQcynGLXrIzzXRPw5jgvhgUsbKHkZA&oe=6A14574D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
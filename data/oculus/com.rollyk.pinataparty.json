-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PH_tAYx8UAQ7kNvwE4w1zG&_nc_oc=AdkX4kTcgIg4KfClIoXHPjSPYHgVL0OKLLMcen1Re40WzDvPkeneU2D2JRYVNY-Q7fU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxn0fxz3DtHwgKfTuqZOl-nThs8vBR6_iQiPPdUVWV6A&oe=69BAA60C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSJYZuykNtQQ7kNvwEM2Dwt&_nc_oc=AdnN6MYXOf467ZnTc2MDYbCna9RPHTNiAK8J6kKD1W1XNWN2xedZzDcV3JHzBb0mSbo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwzw4hHbgb8xzpew5kDeUIawzY3sL1yBlPbK7WLRZylfg&oe=69BA9A7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slWsNpTry7gQ7kNvwH5eAuk&_nc_oc=AdkC91lNcxSd0RsWFjjXoT6JdZlo-0xdvl4CEzh2AhDQBocHCEaN_E96nM1zm6q9bUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnxUUxi26Et2uyd0tKQUx_RffWv5e55gYV4wRqsQUctQ&oe=69BAB14D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
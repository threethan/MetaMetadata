MyXM7wQ7kNvwH1ln-8&_nc_oc=AdpDDDxzIFJiq-6HR-RKflq107weEd3OQdLbrjsRRQ9DnGW7dwvcl2yvpglt0ksSi-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNBpywh15BqE8m8zbcuE5Kg7M6fcIHoPnovCqgtb3q7Q&oe=6AA17041"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Fy7Jg1rLWgQ7kNvwFwnNcb&_nc_oc=Ado5qAVm6NfwgJ7bB0IZsXJBAi9pNR3KRTaFXz_QxFQDxMZuORPgHhE9qvR_PcqQPLQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpvb68zzBo12OpjMh4-nlzMzgb2ifLbFzviFK1FoBnXQ&oe=6AA15279"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=talGx5xLYTgQ7kNvwEZxz-T&_nc_oc=AdrFzsdk_xsq6zmoCsr98veVlgGcbZIgCCLiQ6lFFq4oi5-W3UIuYWwYjfwF1JFdiFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRcc9YA_yQdaCtsSquLoEY84CU6i15AHYusHEgmOOq_g&oe=6AA15C8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qenzrra3HgMQ7kNvwEDkSyd&_nc_oc=AdogTYoQB85dsDw71pfrQa6t6ExCFyCoU-Xijzcss8rWmKgvvE-0jCYLZ3N3kT9WQ10&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXtTr5t6mu4puvEvZvOci-TZAdfK6T5m1tIAjZF_CFSQ&oe=6AA150FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOP7VTuy8VgQ7kNvwEWU7Oh&_nc_oc=AdoVEs77u5XTpRpJncnZ6I59kd2fjaPU-9sjOQ_iz_zo0aHyCB_TVth_N17PtcNx3M8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeJXZASm0c3TXOoXzN08vCyi0_HFoBjOvtaUlVQOBWAg&oe=6AA167CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
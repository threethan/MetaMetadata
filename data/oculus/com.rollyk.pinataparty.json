CXyzaQQ7kNvwFgzdVN&_nc_oc=Adr6StLx5nin4wy2SBTCQkwwdeqn8Q3KvQVNs1k0IjU2W3gfe4dHN012aP_kxU_LDco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JO7qfSSIcOzjGk2G2TGkbMM3aL0NA8DQIhPTgE3qmdg&oe=6A258341"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS0tI6QnpiIQ7kNvwEBBN2U&_nc_oc=AdqZZ_m2ZOneCPn9K86LMq9R3uefv_8QFsweU8P3-rcq--QTspBwdfkLzYg8qvbWbsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Om78FSNYCmZ3qllfdUr0LwPwHh32csyqNZi_bkZEjZQ&oe=6A259DB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBikqbOAGfMQ7kNvwFzM8pd&_nc_oc=AdoNVBZMIHAL5yh9XgJkQC6JedTRa4oHy_Zjo_ObbcDK2p2yDXUwbVk8sUwivP57wlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ojkdTnd3hnY9_5_h2GlfNAXvm1-qsoIRm5A_YDBKAQ&oe=6A256F8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8bHmKkqBz0Q7kNvwF-Qk-2&_nc_oc=AdpaXRPnCbVM6ceUXL6bV0aPq1ykoDl49LmAjFVu2wwR8Cs8HAyxHC1qnzh724gOr8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aXwpH7aeF7WmaTVeWqwP-xFryAoXIpmY9V4u7O4gZCg&oe=6A259C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFnU2YDAxzwQ7kNvwHEmYEb&_nc_oc=AdpqZBewik2AsiKxKGco23WSA-NhElBXorNuDv9ncKwDSto47h7u3_vq8H8nM8-Aaxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JUZAjEcoP_5IxbSmAKWD_pRsHTyJULlLCNh2p8rinKg&oe=6A257ACD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
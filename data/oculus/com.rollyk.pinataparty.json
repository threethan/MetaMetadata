m0H1BwQ7kNvwGGXKaR&_nc_oc=AdrKaKxfhcW_F91qQTUcRvVvRbN2e6V0wqR2a_FBDWJz5o4XTTxJSGku_pTLG4U6GVU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NWlukeQySMepo3w9sGBnwrWVLKnrr8EmgiY03SuF9Ug&oe=6A106B41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI6fO93O88EQ7kNvwHBhDtp&_nc_oc=Adp5u6y7Jsh82CIe74fyCGjEcVtmCO1A1w_S5H6eCkcZ2Xb4ccURJGzJNqoBVv02fiI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yJIdcG6k4rzu16j9wxArMk9E2WfCssY2LsJu8a-yLSQ&oe=6A104D79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grIVdF0AxO0Q7kNvwEwbLP5&_nc_oc=AdqLBU8exAUemZZo5BlUbR1x01Wg3Ac4mCWQkwAWBzYE7ZD-WScQK5Al8_HvAyU9ohU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af652fBxqPjfL6LY6EwpmQU13g5XyBYgio2Q-Sd7zHupiw&oe=6A10578C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCouao8m9UMQ7kNvwGdVwaT&_nc_oc=AdoCtgzBtg_u4Lpth3VVz6SxQu2Ws0ggEaZhKGKLZiQtUbWbT__bHzSyQQr4WvtCpOU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lvTiQXhixZjTN6zmZmLGnp5NvXFjT6z2vrXlc5Xu9fA&oe=6A104BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4BeO_SW2l4Q7kNvwEuw_Uo&_nc_oc=Adqt4cFzl2MGDBPz8vCB8o6t3Rb0WCbfFvKdUVWq5xjiWra4wJpIDkZkJFGiNkEWuK0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VOpOuiyUMQFFdosZhzzxo7uwc0gt9VBfYo51tC-_wDQ&oe=6A1062CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
Gszw3UQ7kNvwFytV11&_nc_oc=Adr-LLUwVKgPMfepcBjKLqWezc_qHsAqk9fYW4InSog-9tVTAqeOYl9zriPkpalxegs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dq-F8gKo8NXTx9i9_NaixYJqqVfuB0lDBuTzHl-YDRA&oe=69FF47C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlYbadjeKE0Q7kNvwHoPhiZ&_nc_oc=Adov5bxVDl6VNIpHjTBP1WCgmzOx05giiMH7E8MW1rclQv-I4W4xPh9o4HoGfdSYCFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af796wDB5Z7_Wa3TFfDnK4KHMvQJrAShNx-6_RdIM2XGpQ&oe=69FF29F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoscJIahLdEQ7kNvwFw9zDX&_nc_oc=Adri9ZHdAC3w1JJZqU9aTdqb2gIwDBVtnV50nzPxw2FttmGxtTIRTGmHO2GzWCKdImE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63MdQXAl-T0_Tzk1DdyaSM-3p6Fc5sz14CknJpq_fWzw&oe=69FF340C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYUdJ-5SinMQ7kNvwFbJvau&_nc_oc=AdojHsYz4q5B1IVrc73Qar2P0pqAXspIq2gfkBHAnbbQwopTcr7wT0-z2Qur2t2Xu_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N6h4HvaKQFLXwiGoFNpbotlXI2KaeZznE8qndMqe5ZQ&oe=69FF287B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrQu3pPTIXkQ7kNvwFXspG9&_nc_oc=Adqw4N1nx5pWWUuK-GopG6C5Miebp1PJvhH62Mb6oWZ6Mud8Cr_er7zEONdptv6YNh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_o-PYCnAaLwnoQxhIfHxBXukjSB8aZg7a8Wo-ZkyULQ&oe=69FF3F4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-pD8LguNl8Q7kNvwHvfMZA&_nc_oc=AdlNgFOxvHxV70Qz-PMPesmW18JN7SQ091ubmhJLOoBSFaUpr3jIUyx-Yy3rv06rE00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0MH295Qoq7iQ_HfBw8kIfxVnnrU72ZdNHiN7Sms3ksw&oe=69B01A0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ts9-j-GPqkQ7kNvwH4VDa3&_nc_oc=AdkGDbEHThaityFdH_JYp3Viatcs0SNH8XaaRasMnKfFmbkaoTvBVKbaMHztuRSpbKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb5pePbd6EdQA5JlFOgk9VzMHimm-KBj689kYWxUHwoQ&oe=69B00E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs8SrzyI07cQ7kNvwGJgfRq&_nc_oc=Admjid7b1VbpkYcIyci7WWFC17DC6bdIZyyuETb6q0QnO7wzbeV5-Vjt7MMTASeokD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYnDCBw8HHk_jEQk-u2yq_k8rklX3DNKbSGcEIZDmS4g&oe=69B0254D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
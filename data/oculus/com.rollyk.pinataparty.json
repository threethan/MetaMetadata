-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbdhuD9x8GwQ7kNvwEobM0v&_nc_oc=AdkNIHS-_DdvoBic15HF95Hq-CLORqUB9_hJaynL3Fx_fwUUerwXB3dbYKMv_nmzB9M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6geKNZV4dW8LdW6eRqrDJ50I5Gf1RO6Y02ti_228GYw&oe=69BE9A8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dkq24tU-nAMQ7kNvwE6ZbuS&_nc_oc=AdllA9zCur4-CbZpmLRTNJ-J6DI7pTraO9tMlREWrgzI6JoNUvi0d7uWIk1t6kJScNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0-V1sgTdtHBGi7uvTskqa97fPRLxrTgXQ0AvcUQ-nrA&oe=69BE8EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RJbzR9FWNkQ7kNvwGBQ18K&_nc_oc=AdmvHBFOZsUv0z_DmJtGYCCtD4nulD0dtUPkt5KAHYgOFod5Bb7TM2bXer04dtiARmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSnhZjEtAm7sljC8gwsl_57I7fex5lWsrdpjLi-U4sAw&oe=69BEA5CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
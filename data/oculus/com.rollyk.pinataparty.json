f-EPA0Q7kNvwGOuyH9&_nc_oc=Adq0bq5GisQB0fQcPcg7GjXqA-u3pPCnIxE-XTA5TJ1koEnCu2aQos0aZywUaJajwSo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycAIDPIrudv_NMPdp61fB7syx4T0PguH-AC1FeMFpERw&oe=69C69741"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn1TX9gIVGkQ7kNvwErYjnP&_nc_oc=Adol4tnUjbcXrTTM_3cVMrf2t52CXulAsSMn4iwRHo3WOETmJLKKxcVXrmv3QuqCTWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGCi0C2gCb4LnysKdVaDS0HUrRPSVWjQktNG0c2KUciw&oe=69C67979"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk1_IiF4FRgQ7kNvwFMHXoC&_nc_oc=AdrlDkd6T9gEeVgDthODo-UpvVVm_vtCZMn_bQJBpGtwykKJHUItks_8AKBoTxjKuaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2sJ0hJ_2qSP-Xo4OeK8HhQ2vkdSwi7ghmcBOnlDfvSA&oe=69C6838C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULDNjhlmoakQ7kNvwGkGHCN&_nc_oc=AdpJ_6F2LutQ6phoi6O1O4brmxtCARHTbZkSWyOMUgMwLhpD5OLN639icNaTo2-YBzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxo6Uoh_TXh9l8nhcmsOnsep-fBDGd0RAad_jYnB3LqtA&oe=69C677FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMivKoNLPGcQ7kNvwERt83I&_nc_oc=Adr2kkKQlnyVxd6k3gNlieT1keJ1vmyPTVyzfGxUJGB6A9I3ry8rxamxWxzcRGZk4-k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxobpTEy0I1rLVv-D7R79wgDpuY9vaXi4sQnl5BQGMiOw&oe=69C68ECD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
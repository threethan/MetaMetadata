2EXtKMQ7kNvwEkXhFm&_nc_oc=AdoPjnRYNWV8xxFav87CQ5sT_4Bd0ZBeKwkZjcUhMNENEYeqY4fjPy9relhg923QjTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jhmShxPNUbOl5SkeycfGoIsCcMzsWHyV0xlnQIk925Q&oe=69D63101"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt655ssPIusQ7kNvwE58pK_&_nc_oc=AdoCbsT0gUYMpFkQEZ9MS6VCkgPzmWwg2GKPCe7rAF-oE_uPiSN8lShnpghzzjWCJm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11g2CFNEEm3BIMkf01iQfoIbcLulbXOxVrBmFMLZGxLg&oe=69D64B79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7HWRiouJiMQ7kNvwFJx8Mh&_nc_oc=AdoZwJSvEQ3XnA8ZJqU2NwYPlDn1zVgOnhNb5iwQdQeKcwyb7ObCTZxGo1mKWd5W4XU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tzaijxucUS6OPMvq6p4uHK0Cx5hcZC_nQK7lIoWD8XA&oe=69D6558C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rqtRLpVcS8Q7kNvwFP09b3&_nc_oc=Adrt6FKPahg61bA4qYggVQbzQjH4-XnpPHxwpdCguA0v-Ge8VRa7DD-WM2DSSUt_XZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gkefiwMzP99Qb3jth7KY44rvPw-Mq_PMfZ1RsUG3UoQ&oe=69D649FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjuW86FNaYUQ7kNvwFaPzBD&_nc_oc=Adq2BsiD84rVTynCfdMmAVn8t9hfjj4Ivnh7m1hSlCAP2hei7UEBedpkURfPVjP_XLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wnSTQ4GAMuJXgObU5zwf0ygalSWKNbqLJoxNgWrQXiw&oe=69D660CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
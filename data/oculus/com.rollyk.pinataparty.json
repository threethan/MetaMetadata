igg9NgQ7kNvwG2iMIw&_nc_oc=Adq2BVspxmdcXwOIoga3zcHHgZhoKJ0KTCaesnuNsecGlr1aUJLq8V-iiN_Cfm0dg20&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_aigYojB04BLRBcokDR8Jyk0Bh-nqpLKH2imUyIPWdA&oe=6A9AD8C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q91MK1I-7K0Q7kNvwHJ5bG4&_nc_oc=AdqphUz54O0db9FFYLKEmRTAnNOxFMlTInIjLOzVJGkR98kBkcAZuKk0uKbLMJYjcAo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvLJ4bFG_wSl8YOEDXIuK_AlIr78opeIsfURXQWv9coQ&oe=6A9AF339"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiohDE3YXIkQ7kNvwGMZMNI&_nc_oc=AdoOzx3zVb-Zjk3GpNJX2Ot4wrESsjcjAnZogruIiqHdYmD2sDVs-9eMpLIHM8JSvMg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQGiEUvP6L16Vfb6FWje-2MFB5WqdEpwG4y0xHqS268Q&oe=6A9AC50C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIIiwUqQhL8Q7kNvwHpzVZt&_nc_oc=AdrepVbZdcgbvPVJp6OBAAux6A_GlcqxJ43q_m6w6d56Z7gDMBRRJpg40i7BdpSxHPo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA-z5ELmNYIOhx4qTvy7mvn9ITOHgyDXcpveSyD8Kiaw&oe=6A9AF1BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elRyFiCOms4Q7kNvwGWe9pu&_nc_oc=Ado7gYJslsDelgYNGgHP6KQkhINo-JURO8rXS1KNHXaU2SrtqaZ4OnuqoSCeOAjJ_58&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH8XCHX3uIBwJdRr8fv4EXudSakaOJ-pxqULebhtUOZg&oe=6A9AD04D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
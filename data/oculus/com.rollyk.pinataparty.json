-u3wvEQ7kNvwFecU-V&_nc_oc=AdqcjQ3aPih32bgr_cMtsTNhjmGvat8VEwGNa9_ar1PTCCWne1D1vBftcKgn7DsYP-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wFiq51rWkaSPDpibpDQudUUgOsnrQT26RugVyvBV2Qg&oe=6A3160C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibLyZp3nqEQQ7kNvwEf6H_S&_nc_oc=Adp4TsI-ISmdg1lftXUIY4KDL41VkWs68hTEjhooUmgu5vJef7OKIB2E_T6S_qbnZnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZBdD2eoAY4MNqyy4Tgv194BAzmJFRfhpcS7zpYpZ4WA&oe=6A3142F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl7wg3w5myoQ7kNvwFOrT1e&_nc_oc=AdonRE6dJ4ubSa1yOHurio4kdtraloMeGr_m_Ki93K9UpVBPJVwYjOP3IXw1PyYWxx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AjSkmjhhzEs_QGFQGR1sblcz2h6e3BaHqfvyHUfQFZA&oe=6A314D0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwK_770mMOsQ7kNvwH3bnEe&_nc_oc=Adqnk4xJPVv4_ePkFQo1YCCIaVmJ3Agq3III3GGZw5QBw3_kYKYdz0baLuC2hCRAV6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cJrbrPgMxtHnmhSsSubKRFU5F-0ckgBOHUDpznNO2Vw&oe=6A3179BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKG3GQfNxQIQ7kNvwEu-eUH&_nc_oc=Adr-TWWWXKf6ZcxJycbag2J1JeASwdqczCs0WyY5-Jl8tZLzyOK98Jg8DqHG7GhEaRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qwfluAaaQwf140APxkPYCUktXc7zT717KW60j3lXIfA&oe=6A31584D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
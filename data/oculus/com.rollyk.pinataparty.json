B-lNcoQ7kNvwGvqnKt&_nc_oc=AdqJFrnYEy5HuZf6RYgw-kByj8_mV4K3xa-j1Z6pr3M38ugk3TAB_Y-H-txCN3kDoiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8E87WMveEDnK7dyYhj2FJyse70l38l7sijOatEoBJgw&oe=6A7C4E01"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QwVLXSqAGkQ7kNvwFDfu3c&_nc_oc=Adq5r8gXD3DiaeqBm4I5myMN3kUwp1BIkavRDKYEN3svD2u6nlb179Uh9rffRDY-eSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEVJvHLPYczs-RIwWW_xJ0IY_E_HEANCKpVXZPqhxrhg&oe=6A7C6879"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRHQRvXok4sQ7kNvwFQKJJz&_nc_oc=AdrDkbxte9VPSfnqpvTcHibHMgFU59kNtRT-AHxYj9szZQxqJYQJ4Ob5koRShPS9bFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb-zb8pkF_GJCDOl-s5kd18b04AMtjcYdVVyAAEe_O2A&oe=6A7C728C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMcSv28K0LMQ7kNvwE3Go7U&_nc_oc=AdoZDUW2O7-rDNMisWl8RDEFos6KrxsKoUmfAgQEoAO-j9ScSspcBiO1YnSjJmqxQyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECjf5XljyXyFiienfqOaECvNB__gEtUWaE-wzgYalq3A&oe=6A7C66FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4a99iNldNcQ7kNvwFReujS&_nc_oc=Adr01zt4LUVl45IteKIYe4t7QTDHep3hjAAu6CeTujXTf7nK847RMMMmUod3YC2fLPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB9eUr_WV8f9W6faUwqhfdOpRHHoQncvIz7FJFLpz9bQ&oe=6A7C7DCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
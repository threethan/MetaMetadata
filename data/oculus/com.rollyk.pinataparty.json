6GGwAcQ7kNvwEavHqq&_nc_oc=Adr4R2tz72QimNAurVGJcsiZ92TbPRXVK1CXcCUziu48nNHJIgp4cRAY4oQvuDAfTxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSB2rP5YbGzmTwCkdoQpe2vMtQym3czOehIFaVv9qwsQ&oe=6ADF66C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlN-PUzA3swQ7kNvwHEVc69&_nc_oc=Adp_kyr09qJgxHoIufHdDsRGHs1AuR72xb4kQ12C4AIgeNN0QuVpdAztc-59nMRNdXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLLiQdeUxWQLQiTyFHb_N1qWoEbGixBUIkjVNx20kATg&oe=6ADF48F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h6U14-ruq0Q7kNvwFrKnRk&_nc_oc=Adp8YyshTPS8HmqgW4BWOZdmKkdR0c2KpVnI57nVdYAeUGHaMYTIo8e6BBGUhBrR_pk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAxxhshAt-B6V_YpcuW8dRD3fJp9R8BSFLy0ADYzkjlQ&oe=6ADF530C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_DWsPN6WXwQ7kNvwFQ0ZzA&_nc_oc=AdqGtTnclEoyH1uswfQK5qwdjDlVN3AsCisrh_An5FljWjMHC4YixZJ_s4a5SOSq4VM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOooO2f1ss3kj8cEQ5c6PDvyfAqTHKYkBCXg4IyLlGXmQ&oe=6ADF477B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvW9Ixuy0isQ7kNvwFDYgvE&_nc_oc=AdqVtJJ4Q9sF0h_LvkoHxGKMHxcQoiavuw9lqUg8QFx0PSrOkif-uEmXNWQ4nPUdtcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORgVbekGfs4qpV6ZOFVLYUYd59HB_4uILJNchn6s0eeQ&oe=6ADF5E4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
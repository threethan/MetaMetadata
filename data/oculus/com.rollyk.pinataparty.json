-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-4YqsDiJoIQ7kNvwFQ2E3m&_nc_oc=AdnFYei4eacMOthlP_GYWIxNTwkhrCcZocKALa1r1QsXy9siDUkYC77WU3XuyYDZh4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJoR4-QjcBvE8B516fw-v2XGTVLY2w6LTBf7B8vvWTqw&oe=69B9548C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSJYZuykNtQQ7kNvwEhRYNe&_nc_oc=AdmcqmOLpTL_B_8OrEfMwBnCaLN6IJ40ZdL8iabvui_gBliv6g-gO7K-H6htL258CCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTwj2ixwpc0dQFWFXdaHtqxub8qTAg4PQIWKFitcKEKQ&oe=69B948FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CTvI7HFbEIQ7kNvwGEedWX&_nc_oc=AdmQ3eXNd4R__GuZSbH9C9xUHvPDEERq2Ttrj9cfC8Eu_X3D77-KhgaRhiw8ck3HNY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzV6DSN5QH2NuanpLROyf5hpUMEqPYQDP8U9S2OlQJjtg&oe=69B95FCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
w7yhnwQ7kNvwF2qFqw&_nc_oc=AdoEYur0mPOgeyZxDCcDLB5ncwQIATiqz0KN4tWTjFJSpJGnveibnzfM1X11g-uvEzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBMgi0FNZWMSYa5sxE45dPCbAFwfrpN9yY0mUg_LLtdQ&oe=6A6E05C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JmQekiYZJ4Q7kNvwF8wEve&_nc_oc=Adq7bI-f1pV2YuM06xQAKEGiSsSqGDz8lw8KJBQHGZdhkJY0g4UxdES1ZVNZRD10CBU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-i9XU3h61sbhDEqvlIskXKDi90RBHT4ADCjEECdNg-g&oe=6A6DE7F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ4e9sELrXUQ7kNvwEkm6mv&_nc_oc=AdrMBZip9yIZq-3W9M6_9DTFKbA_5kga40nx6dDoUxXBVcYwzhd5C_-kom2RWZc_-OM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMmYQAXse7Czxk0s01etJkorXd8VNuzSxCIw8pLlTs2w&oe=6A6DF20C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKgMJMahWe0Q7kNvwFmGlWy&_nc_oc=AdoNF36QG_v3BSdQNfGQlJDPE5rkROzTeFW4gXEusI-qef_p1HXDGvTFSL_F39Lf75o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJiI3PZsVttPooXzY5u1n_WRqV9f4CHA2WKyxFAzCgtg&oe=6A6DE67B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqhU5ufL2pMQ7kNvwF2oJsa&_nc_oc=AdouzxrWo3mYGvhQK2-YoSSEYXkc7sSkq76sMd0YXGAtW3R6-IlrsL6umgSEOb8CoPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrqOcFvljz-3P1hjrM8Zz74JCwDd4jPpUrzdEy5RiQnQ&oe=6A6DFD4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
oeE_ZAQ7kNvwEi2DaT&_nc_oc=AdraHwSuBmnlaXC58tp3oojMshxJp8mpJjkcERbAyCpsYDI1cZq6RQFQ1rZRHb1znZA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgHb8-hUf5eLRKb047cwC3mwTWMQbrzg9NwepCnZ9-Dg&oe=6AC7ABC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ig_QDvamecQ7kNvwEAv0zB&_nc_oc=Adppn1IO0EQHnMun9lNxhSOz5dEg1Y6jlsK2409RZ77kjpiLsfC7sJl1ZJuAUkkxSn4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPSQOmbQZqRF6P9AGzMd1xihnOHOsvHvlNLTNMlovVdg&oe=6AC7C639"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxKXKsvMALUQ7kNvwGzRCsN&_nc_oc=AdoWoCEJE8vEw0wgwOoXcuLc1bxPyXtwU6nR-4QqSLCUnac52LafNkxshenNJTC_YNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDm791wiqMujvg15cxtO7ELTzMgA1pBsQKPxiow90uSA&oe=6AC7980C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ExD0Ld6gyEQ7kNvwHKPQDc&_nc_oc=Adoff_k9BDpWZ2Y5EVnHdS1GCr8qAnvqo47ccbmonG1P1QU5IwHLRfqtQp7k3OXX7XM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEnzngjYWL1C17XCSCz7ngL62F2qPR9c-Anh4bAqzKdQ&oe=6AC7C4BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ui8d3Fd8kQ7kNvwGsNc3K&_nc_oc=AdpZEn0-SDmc9ICbIrJu2T_loedcVCoQP1Kn72ke7mNS8GV8OXxmkZhVS7jkC9_uSSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRozWxpKkpTRZBSE47HulnqO9x3ZtgdnVhDoS7k9GFHg&oe=6AC7A34D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
oeE_ZAQ7kNvwGEnZ75&_nc_oc=AdpzJovWuKFeULfI22u1raQNiDzdh4rzcFCDSxFNNQaGAa_PVL2C2eKF-1hlx-dM3CE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTmPgP1I487fLpPrQjvNtCZWul0pcDP8OwGvHAHGDTdw&oe=6AC8FD41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ig_QDvamecQ7kNvwFogf3T&_nc_oc=AdoWr0I9hLZ7afsbZZDftuhPIbQEV7wW85g8lwu0fHlu6Q-8eFKdZ_V_PoPxQMTyuk4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUAyFy5ABVVmtGE4gPwOD9h-uAXbEPzGU6wnGULt0DXA&oe=6AC917B9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxKXKsvMALUQ7kNvwGswusQ&_nc_oc=AdoR4TACfFcmwuMN5u6Xh7sLgWt_yPfETADKaeFEg-jeUSroCkaHRB16CixnVsZQpXc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2ZFxfEaGwcUZYZjA9xlvom4N97u-Xmbyo2_xLJD-S6w&oe=6AC8E98C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ExD0Ld6gyEQ7kNvwFulWJK&_nc_oc=AdqOnVMBBH-zOEfmBVE-RhHw5yflG0BVBGIGmUeDM9vY2cpnK6_QY8OGqSI8vN5RpSU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPo0UvOJqe8ycAFrgOQqFAbzw2Dz1qDfWH801hvfRhRA&oe=6AC9163B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ui8d3Fd8kQ7kNvwHhtkti&_nc_oc=Adqs5i5oXQWaTQV7vMKyulFVh31RglB-1pjK8ffrNsXGPhF367YJgZ9Dhoq_BQGv51E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGlNd2OvqBONETWBAEetd7QIum9gv1Tf0yzRhm80DSPw&oe=6AC8F4CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
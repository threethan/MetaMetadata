gW8iowQ7kNvwEQTX0Y&_nc_oc=AdqvlPW5B_88H2-Yz4JMmcvRJCljfGrmoAflZVlHt7m5-kXdnRTquND_tX2MKjJqQ4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GiARMoG3V4tKgytae9FHaipjp6G9riyzTAWmGKQIkKw&oe=6A0DC841"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXMt5QwFuQIQ7kNvwG9pOkI&_nc_oc=AdodCV8kz-lMXF6VwuN-bPTFaJzIxHzqR4LiWkO7HuLlGpmxto47EHZ5piOZylg1cco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_pWe_3nqb6IrQhvN5pUzWzU15AN-QNwezugBPjflmxw&oe=6A0DAA79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grIVdF0AxO0Q7kNvwHNGFQb&_nc_oc=AdqpZAU3DAkVyqLU1VZqI0Sye-EVtEvblvCFXGghvNkh8QB7ER08a47FoAUh6MncUZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ahH6MFE7I-B4SPI8lXULvrTYm2TFs1UYB6V20RC3waA&oe=6A0DB48C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAgKbfhKZNcQ7kNvwEzwo5X&_nc_oc=AdoUPSZbhaWl28GQ_5Vi3OwIXUIMmLfsmAZQb1GUPMd91uIkfpILLlKMBUrZ9rE1eKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af484hd4ZBYYYUjrq7w19MgUQv-rjVYgFomUqKeiHGb8Zg&oe=6A0DA8FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4BeO_SW2l4Q7kNvwFFdjCW&_nc_oc=AdqgieYY7_zQNcaB8M3TOLcAkSjHMz53evTJxPNSqc6GQXPHFHmodDOr2mTnyPN1ayQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-myfI_L5BunA1z2O0l0YuK_JLNUd9RB2Es_GLDfAVyw&oe=6A0DBFCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
wDH9Z4Q7kNvwGV9wdq&_nc_oc=Adq_yXwBx833fjVBO2i20OUL_mdZBmmykr6Dgy70dDYlLhZvufVyVLh2H_2DBax7MP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0rSFyvcy5LgX1b-pYupN4V0_chkxOYI43I2XYa-n3zA&oe=6AC3B741"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj-Vg1yQydYQ7kNvwE6HQb2&_nc_oc=AdourW3wtq2lj_ZC8gpmYmx2P-HDSuWDP4RQ_uoOE9IhcV0dmKOxDHmZ5fsP2WfAWGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs0edJ65jtDFA0_3waWMSwmbmYVKmkoKUUnPTH05s_LQ&oe=6AC3D1B9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmrhDLCiqMkQ7kNvwFEbUc1&_nc_oc=Ado285PNSSxEo50dGh3BO9QI_2-HSfVrzKK9hB19gbuq-dDw26Sh4ZDhvq06OIJ-2-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7xEy165CU1j8V1zD0VPL542LKSbxKZ-hT-eSZ6nvuug&oe=6AC3DBCC"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzfACH9tNL0Q7kNvwHoVCY_&_nc_oc=Adpzlz3aGAfmPOgWkvRqqzS-JPzwoJkmQmiBrvb3ce5vG6e8LWgYLit-iOxfN6lcYQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhZTAbK6v7MowS5DzUuGcm2UjLXVTNMtpkEtZPlYGL6A&oe=6AC3D03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrCY-bO4M7sQ7kNvwFd2YrO&_nc_oc=AdowdhzK9zqNpn6-I7ek7IKmmp625AqDoWczlYTRxyzcUaNw0YRsE9L4kF3bic-lLII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS2ZzxfTwBZuh0HbvIY7hHj_1l6jmcR-vfn2_qwTehjA&oe=6AC3AECD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
JrWldsQ7kNvwGOfllE&_nc_oc=AdoKzrVU-xd_8IJsWZVb2REhkn1zjbLk27J4hUnU_wYr1Cvg_C1sb29kCKzeMqqKrBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpBLaqvfPMK43VH79ah-nxMhfLJ4tkWxqvyJbAPojkug&oe=6AE35B41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbqdNWY2_6QQ7kNvwHWp1-8&_nc_oc=AdrTP2oavkZlXgC5zs_34Cei7CzEIbhxKHuF824Id4ca9tlQ0aaeh19PkaCt3j5yWTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN50v-NbFIN0kwrYjCtuVWeO-WPKUbQ4IMOr0YjibHjQQ&oe=6AE33D79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukDI8mtgBY4Q7kNvwF_yaBB&_nc_oc=AdpBieN6Tc3kG9ekBJrbzchLR2xAsGp7usVwYl2LS6OENy8zCzSrZYNXOaoCCOVHCF0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwg5rFXvPrkI38ytGhhqTpOgamSuoro35YB2rADfC9Ig&oe=6AE3478C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD7axWJDqpoQ7kNvwHLNbo5&_nc_oc=AdrfQKHcZfD4h1yc3BNNS_hiRJdgZjjFhuTi-Ag4pnqGlM6D5s47tpGD78DihTH9yAs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ07GzmsLiRc4y_2wofXSWscraIPeRKD_vGJyqcYlzKQ&oe=6AE33BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0QojnUK6DYQ7kNvwFMR4-6&_nc_oc=AdpPs3jMDrHBNFJ1vXzT33CNVOsIuz_vJ2XrPfBcokLiSlYoUU_LsWyFvjFdV0LzTWc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2JGIMVzj_oAzsLbDNaYGTSAvNxwDvvyhsFgGTg0Kk5A&oe=6AE352CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
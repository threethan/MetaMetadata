6qL7-kQ7kNvwH1FY2P&_nc_oc=Adq_dt7kdf2ecBqFrj2exLPbsjC9LwPq0Ac4dyz9ueqIMA1Xs7T-DSs10nH600cgj2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoNhrKCoafrSGOSi1VSmRk8eewyLCDIfELl8VEfBAxug&oe=6ACBA041"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NnSE4EHb_8Q7kNvwGLCtiq&_nc_oc=Adq33JG7909fHBsS5Ra3-bUqYgjnX76ISZRkLoRzSYZPojQSTUWwyzzRuBGOIW2YGGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoTICxXzqBEVbRgW95Xnc2Y6MzED9tmQN62x0fYQwtYQ&oe=6ACBBAB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwXlicCU3nsQ7kNvwFXyltH&_nc_oc=Adqv8Xjrg8ZNbjs5Rnj7NXUegEUo8NA9D5KUKwMnhyOd_CIfArIPRzR8myb4KFcbn9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM937ypIa6nkNxWFXiSnkobtOD4NRPiv50GH9VtpDtocw&oe=6ACBC4CC"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lxwfu_-YMdwQ7kNvwEK0_h2&_nc_oc=Ado5xkqpvFw6m3YPWIaeG2-DSBlPSjRPl2j_SVpOi4VzU2zjVaIhzLSLpM7JRqMITTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT68FQX6ioxz1DKMm6nVf7n3_BiZkm74IORN9O7tp5Hg&oe=6ACBB93B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p_HlGD6wjQQ7kNvwH9zZD9&_nc_oc=Adr16Y7YdMiZ_sMZW4rYNaZ5eVearn8-AfLDmP17wSFWkhWdgwZK0HT-ySoGsnt-3PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmqIr6c0c5-SSPbu_o-7kQjq0O2351kGwr1X32KW39kw&oe=6ACB97CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
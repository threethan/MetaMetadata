xW5flQQ7kNvwHZn4F1&_nc_oc=Adrm4em055oTzlyR0oj5UvYIPwZ0Cqs8a-R9h8RdZJXh0XE-A0Azh0L1_gZtI98FpDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBpPH1yT4-RFST87tmQNgoys0yl6ubHw32YEMOH9si-g&oe=6A4BBEC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYqkCfVUAzsQ7kNvwGCDYgK&_nc_oc=AdqV4LoL1lbKp-cw-dwHuZHL5gAOUc35x735Q7hFGRfPbGHFHP7L10xnjBiQSHTIS7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5R8w8ZJMiatYJU-zeBxvQxaZfP3EkBmB2k2R6Q4YPdw&oe=6A4BA0F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Pg0Hh0keUQ7kNvwFUUDZj&_nc_oc=AdpR68gU9MaE5oGyP2X295NElUMj82yYMnWpcp4ouN7tLCjam0uWvKQc7vvuwoOO9YE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTjAfMrjsxQzzM6l3BxHN56_nd4WDoBXZw2yYBf1mG9Q&oe=6A4BAB0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNQvOn7m5eMQ7kNvwFlenr0&_nc_oc=AdqSD-K4mHBX0Z8Vu_rgzmGKonHG7Y6YRv1St9ITnzAwZ0NwD5-051I-GPSaKglIcGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgXlBUZlV7hkzBevfnIKK7jSTZ1eYtIcyU-vaqIlB7zA&oe=6A4B9F7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgV2Dhgqc8MQ7kNvwEoCs2j&_nc_oc=Adot3oTW4g00QxwncCrETl2x5OafonM322A4hz2bqDWKWm-fDKhe_sUZ9uQErNl1VTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1JNODpAhjr9_8ZZEE56vK-xWQIH1zQHZKK0EXI9bYlQ&oe=6A4BB64D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
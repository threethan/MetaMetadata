uvgVd4Q7kNvwFl9_HR&_nc_oc=AdpUutE3JtS1suVqfyjW-4NbX14R-6ZVZ699liiTXSxNSRAezw46B3oJsy2HKBa9XxQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBefR9keWgGayViS35yh8l7YaKG_PJas0kfHm7FDP0gQ&oe=6AE8A141"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG_nQzu7LAsQ7kNvwFfOEs0&_nc_oc=AdruHjF64_XWXD6idpog3YJKE_Rrz_MnVJ5YJdN8ByvcBOh_PcP-wvAli432FqLs5y0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIA1oPZlqMIrJQN20qrY7AInJJONEcR5Es8XPg6YmxSg&oe=6AE8BBB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0GYdKFPJBMQ7kNvwFx6sf3&_nc_oc=Adqi6-vdpAbL46EHZ_I3YNqwP7MhntPub34InovCCHBqBm82IsBs6SouFP86MkSEzjY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRi9ozubwuc20DS-A4qCRe7YL0nBkQeqxb3yBlrbe5wQ&oe=6AE88D8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhWkMpWEz7kQ7kNvwG0XBQi&_nc_oc=Adq3g0wyiN-K4-YQxYBnEsq164Ovdbrt2PLWM7_jxFNUVEYOupU65KmQoqlmNqTcLW0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuthl4rp7Z7lkLHPZdhAuBOelERfD-iCgnnp4PqllF9A&oe=6AE8BA3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnBqhdCrF0MQ7kNvwHxzaCd&_nc_oc=AdqzOFzd-ne5tt2jBIMxDWnYvt_mE-w0_geD7G9K4HlC5VC3R_I6nIM_F2xCoREwp-Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxriw2fN-iDMnRYVsdanbSKfDniwyfsnM2Cpjyl-Nliw&oe=6AE898CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
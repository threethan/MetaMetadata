1tuJ50Q7kNvwGpsJWp&_nc_oc=AdpPLOZWaC5LAMWVd3nxDIyvupREOrmAccjURfmcwFgu0Ta2goQrd01DX7kYm5zrPEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATkX3gVES3pnTtppb1do2uiQOEpb9r1SKpJIePdXUl5Q&oe=6A622841"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtO8OjOXsIYQ7kNvwFbphok&_nc_oc=AdpwJVCirXyIOgdxwMhjiYUbdppDMEvsTmQ6eKFh82YtjfH0iAjVtqwlf6EL6sFdhq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDE2J6mfVyLUHXlCMBuax27O-68Hi0i70cb6AWLgyXOg&oe=6A620A79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9S48cGyDYsQ7kNvwGVt_U2&_nc_oc=Adodasj0iGaLy9dxQ9vUFRrYXhPb9b4uAuD27ChTczWFj4B_yC6hm0tB9RHNZUDAFOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQGjMqPoArUzKpo8DwzFCchYYQ6y1F2a-0tYRJ0SuPaQ&oe=6A62148C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYc17rIU5qQQ7kNvwGyZCIe&_nc_oc=AdrWcIGDOHO7jZw8noYAg5sU7d293Quf6f7XF-qKpBOoV4-7k97y6cpWxW6e1cLfgGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSboeRanO_zeBn1axMGXKcKVbmMYiioyFcEnd6Kg634w&oe=6A6208FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw25KfeNP6IQ7kNvwGKCXQT&_nc_oc=Adpr4jZPfYGvR2fiOnYexxaOE6wHa8R8CYfSs_I3Ahql1a-nXD9kxkD2bH28IWS4jgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7oWf_apBVtcyfExY-gyd2gPpxCAh-4Zvt8kweUxtEnQ&oe=6A621FCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
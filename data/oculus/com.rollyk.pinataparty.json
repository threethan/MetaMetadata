yEL2NkQ7kNvwHpFkBV&_nc_oc=Adrs66pBWjAckXUXk18Bqna4yh8t81wyK94Gw-3xzUhziZxcV9oV53xNvi5vzYuVzEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFfhRKekRCmD9_pBuRJrb1SUkmsf_k5M1K7mPzTAqsUQ&oe=6A5E33C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMMtrt42zo4Q7kNvwGt45KS&_nc_oc=AdonG4yRCBlctKLDG_OhAW7nA5knHfPcH9r2Bms4wTzdfeAZSknShwFlET57RwsMDLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-00Kg-fTvmHOhwFiPXpc_tZbhXwVwmZBg_ue-nRpJnw&oe=6A5E15F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiAl-o-nJV4Q7kNvwHh7oyo&_nc_oc=AdpiAX0Dg_7KJvYNEycGAmBLRsG_4xevB-Jbs7rHEJi-JuLW8hLRxTikTj1FY_jj6Io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFxZXY6cER8n93kSajLz4QF_SJruHwVyN-UqJEiVyw5Q&oe=6A5E200C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-te9ns_MUUEQ7kNvwE2BfKh&_nc_oc=AdqS3pC_YkRm3sK4njOsP8ll0e_Hpk_wDXNm2Bk3HvBQ_QBAcUhF-XB2rDib0eFQPYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcyKRhH1PxWHHVNDvR8iISwapzmMuqJNp6KHaifAAGOg&oe=6A5E147B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thvu1uvRuggQ7kNvwGN6U_F&_nc_oc=AdrYBhCfNN2Y-R31GvaMuy4q1LJ2Lzr67krfqvnazmR16A_2cZ9ORrpDa_OZTLZSgfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD79UgGrd-yEzhFbsO3kOoPZtSRA2R_08DzooZj5IcMeg&oe=6A5E2B4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
nsuz1QQ7kNvwGMgPTB&_nc_oc=Adpr_JhOIt_EhzvBXMYidWCpEWtExrFyEosSTYSJ3I3ottDG0sauj5myVk3WeijDjf8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--h17NOL3V5Ai8T5dQ-sEPFotoQYtArVx1xd1iviElaw&oe=6A2C1AC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITPzvYh0lKYQ7kNvwF06Ciz&_nc_oc=AdoXxdeT_Ush2o23b-JgWm4IpHUUqx5ZOLp0ptWdXuVfk1EJ4B7RbQ6lFW76sG8xW0k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8emYQVj2D_99xrNwNYGmhpf9iNapB0is9QDCaNcslxAQ&oe=6A2C3539"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyWZya1wQFwQ7kNvwGwlNuN&_nc_oc=AdqnoZ1vHxnznmtQ3GRCqRbg8C5JSTJArJNH-MwYoZREIHbwoBi6gM1mJZRwY4PTm_Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q90wAu8VRrECv68VQQ76lkZ6tuxeGF3mUGyQuN7MuMA&oe=6A2C070C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flgrHZ5vo1YQ7kNvwE4atrU&_nc_oc=Adp03xslnEh5W-Ty2LUyiscD0WQhQRXWGeHlpLB2PzZUBsE-Agk-_vDHMsafZG1O4Z8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a8bySHdxyxRhGJxKie_jHcalQcVfDDkCAzYlHLhEmgQ&oe=6A2C33BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRZFzIguqZIQ7kNvwF3AAZT&_nc_oc=Adq6xATLnwI9E-Bw3lYcLzDlk8Jqc6hQpxTY_RJYOa_WtXD995Jg6JxVeUKmHNrn8vk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fiozgMHuH5JcGJ3nPowzNBb4SnBuJouKz4eytvsJ65A&oe=6A2C124D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
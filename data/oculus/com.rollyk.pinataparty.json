oeE_ZAQ7kNvwFfy3MY&_nc_oc=AdrMWCa90WMpD52amjoqa3uHUAn0sH8_vDFxyP9GcCRHYVOAE8xuviY6f_0mA_uyCr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqymvt7rhOBGukbhq2Wk4r-tp9bNiFm3Q_xtPZvkFRQA&oe=6AC65A41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ig_QDvamecQ7kNvwHZ_Hjw&_nc_oc=Ado60USDe2MnAsOe5kQyRAvmJFuQiDIg9Tx1TdRG7eU0R-2WGPKiMd_lXu5FKbxwJrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrC2pgkvBX3VxzeFiEIPMLYpCIRcXtKI-2q0fuQ2vNRg&oe=6AC674B9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmrhDLCiqMkQ7kNvwHY9uQy&_nc_oc=AdrrCVhcIgi4He3f306TfFSUcU9XUpOJXTyq-M7v4E8E0Nn3WfnEOtWx7fwMlIO3PyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHXSXSgd5HiynIdld0YUaSu2yh1ToVuJ3cctn7nF0how&oe=6AC6468C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ExD0Ld6gyEQ7kNvwHr5C2L&_nc_oc=AdoUFbWboEVRrFFMAmqTSDOPBAA57_4kOXeRWbUFm4fwGt5JJyYpyWua9zLCXk-uhDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqWOETbAmPVo6wMr4zyRLYoVXx5vB_rHTH3h-DimiB3w&oe=6AC6733B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrCY-bO4M7sQ7kNvwG1I4Q8&_nc_oc=Adr6p1DF5Xa9h2RvrmOJB3rR1TRBKusddYPd364I-cn54Z29OIF_e0IQ0Wi8afztk24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLNpWy33QJtY5k9HGc-Bzxx0iZW8xk6cuz-rRLwxZ-4w&oe=6AC651CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
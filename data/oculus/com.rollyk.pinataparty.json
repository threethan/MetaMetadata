oZQZYEQ7kNvwG7uFwA&_nc_oc=AdoApm0jzEzjeqtyX54jXEBEpakMAhNNybZPYQbl29foE48CytXq7sAYmgpwAvMhE54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0e0onMRiwAoafPbPgVTAUwHkkcKxYFzcnxntDeQfIyw&oe=6AABFC41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CmCEeDn3AoQ7kNvwGBXwSU&_nc_oc=AdrLTKWZjQY5csvYOGWa5AZjyt0NCu0LayOmba0hDnwYyfZiCsTnnp-tRDIqdT4EcZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa-6FwTeyymRrSsLjckqy9i9spi6umU2dOOpZTFroRqA&oe=6AABDE79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbqVa8mgS3QQ7kNvwH1WhG1&_nc_oc=Adpyc2ZfYJ5mDi5KpHuFcnX2tLThyOzoSP6566ZgWM17dXIWfwBzaFraE7NGIiURjlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjzqO6lWbHr0XptQTncGRMzcwLPH0Jh_vGSuybzskl_Q&oe=6AABE88C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL7bmKtnU4YQ7kNvwG_8Fkb&_nc_oc=AdpKKyBIeK5hXia-i_3ol-AbJGJqRla-MTY6k18l0JsohKG29JhDvGQtpjkYttjgUys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfAYTIaY0v53eEDSJ5KVRhB8OQ_IdU13wZM71j0ODgDA&oe=6AABDCFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE0j2NJdTyMQ7kNvwGnNbfz&_nc_oc=AdpTBYd4jlYMvBGVTNaqBATW9DNxNRzq_hKwjaSZg85cslnOmS4Gny9j7kGiF2u-Oy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6x_TgWuBelyH0vvRpRfRIrZoD92YrfZFjhzOejIWsOw&oe=6AABF3CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
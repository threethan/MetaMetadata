xW5flQQ7kNvwHi8mF-&_nc_oc=AdrtewwMr3peJ6dJFT2ha82Ldte6u1ca6QnwTltyAZrTihzUTfwQ1E5iSgHQCRmGEvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-qOhWzloA5oDtJR-dOx_qfCHQO-DNfuFsFof7mmwStw&oe=6A4D1041"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYqkCfVUAzsQ7kNvwG5Q-xr&_nc_oc=AdqTEpxCpZ_Gk-YgWVvRPUq79HYle7JZJvUtwB074YubD-2VODfmX7akd7K-xKhWsE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC210G6hPI_rQHHmP8Ro-iwv6ywWyj28B-dBHF9QLxZEQ&oe=6A4CF279"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdiFrylkwGcQ7kNvwF62NsV&_nc_oc=AdqJy7QvqdFZzN06YfZVdmWXM8IiISs8-rmoNalkeCN3VQ9TdfzmHcqsmtXVB3Yag70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpv0bZCNtpZ8mQaM-mt25J4L44it6miyenYR0drN_4rg&oe=6A4CFC8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNQvOn7m5eMQ7kNvwGTagbX&_nc_oc=AdpfdnYhcoJomNNJ3epxh-KMJKJ1n66xjg0QOb48WpIix2Ix7r7Lt_-tOeXircm8-xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa78oj30oqZsRA8XLEJBwBIz2PjTg6p_SK8qv0Hdmn-w&oe=6A4CF0FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quzb1xApCAUQ7kNvwGV7Sam&_nc_oc=AdqbTRPbhfC0hlAk5cNhZ9D5xd8UbkVDJhvzLMBdeSr6_iId8WVPhaypnyOgv3PiHNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyG8t4i7JdTj56C-jV29-Rycsa240wF6volAsyUaYKbQ&oe=6A4D07CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
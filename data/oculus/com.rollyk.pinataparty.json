DYbEygQ7kNvwFAHGL9&_nc_oc=Adrh0d_N1lyTsHPJnobQdEJBkAzkAEbkJwULdC8pYThKOwZEYTnyZciGYQb0k5_Z0IU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEAImCRdXHJWl40PCPtnCX3KOfzU8_OUMP7zAwJX4MNg&oe=6ACF94C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJaCUNDrq0UQ7kNvwG25rwn&_nc_oc=Adp3tPv8-EVgmUQfT3m6sbIOLQBJu2Sz7LMf3tq0Vn1-AfswsqETDReqS9L48xFZ1Lg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFIUwVH7VBgx3tIHsuSZulSUCh-xIOP58PA60S_PfLaA&oe=6ACFAF39"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CsraIQJnwMQ7kNvwHrCr6q&_nc_oc=AdoIZpDimCkgkh-8n0uv-DsMQPI_7s-aD04QoXjxgae2hI0M35JE5xy1IPI1QrV8-pg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaw08m9pE_Vr0WsY97oph1VlLVyh4wU-V1o3AOkLBGFQ&oe=6ACFB94C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MsTNaJyAloQ7kNvwFRYWyd&_nc_oc=AdpkuSsNUfcLon5kOuHEvW386eTS42jQy5-Fk_FQVTTrktx6WRF02bxDYsAei8BaLAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvG5caNc-ABLyvDdRLxpjjcBHW_BIH3A5UQdfNTiW4wQ&oe=6ACFADBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYnnNcyEjgAQ7kNvwF2bKgP&_nc_oc=AdqzqX_9iDYU5uqVXLhPjEXawqkc2xKRSHl2vtPhN3JScKraMG-5aDFk2RTui9c4z2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOelAYtsqNxHBqQe_LmCWn8LOXrctwqb5IsGZ7MckHz1A&oe=6ACF8C4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
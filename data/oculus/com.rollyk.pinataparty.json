zt6mWLO0PJbXEXI2JFdvWy8cD3wvZvLpZZ4pOcoUY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RL0PcjmXF8VI38SpTC0XCLr8ofYci8SKssYy1niD6Fw&oe=69F218C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qbS68iGEFAQ7kNvwFr4Wz3&_nc_oc=AdqZZRxRKi0_9DpReX835ljLwdzzIkpIRAx6nIDixROOWj90-sX8cEsCyp6GR55y9zo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af38KRcNntU03w5imAqn4F9lhZg_ofwwktT5-eZ66KINOA&oe=69F1FAF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yb51ZVkVx5wQ7kNvwFMYNAK&_nc_oc=AdoIaN1KrinxzTyyHzYaTnm0Q0YnEXg2pOXSouXAO0QURl6SBR4F1pjLaLKk9zprYCc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3y-RvifmF2e_wzdUt2l127hXuArZkB_A1vAn4nuqiOpA&oe=69F2050C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMUwoLhEyLYQ7kNvwEC6HS1&_nc_oc=AdoeKRcJlbbRwdq4MfQgs9lMIj2vMxaiBwAP8vprA3PUuuxNB__QJmbKv4vAh04qCJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2NUO-ZKQGrH6SnkDZ5bCDPes7omtSIVq4czmrCqdGn6A&oe=69F1F97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLttmsF9r_EQ7kNvwGSY-2Y&_nc_oc=Adry5QIH1rk71ac8gt8B6sR4Sg_Lo6ldPnUD2MJPq6MKoXOwNl0eehBD__4wtrx5a88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af085laYHQS5sPh_sdxSx_INf2AvHysdII4TwFOf4vY7LA&oe=69F2104D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": []
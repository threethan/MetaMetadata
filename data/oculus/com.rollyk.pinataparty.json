f-EPA0Q7kNvwGu3ywU&_nc_oc=AdozH66dQfEmBu7PQ6DluAI7TCWkq-QqQp1UN0XTv88SRD4qSIc09z6fJ3n13PLMgVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztY4fWx3PZzE8GhQxf1aYmsUnjSOOXIndA30JRd5GnBA&oe=69C7B081"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn1TX9gIVGkQ7kNvwEtIsrp&_nc_oc=Adr8qV-hZAHO_T669d6rDnVX0oCL-34Oon0WLLhZc3uZR8c_sZWwWPLd9u6MiaM3G4s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvmdGyJNWYIuDBOq8NXKzBI3LeLlzpi_bkCZi5hSnPjA&oe=69C7CAF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk1_IiF4FRgQ7kNvwGPWhP3&_nc_oc=Ado1roLriLoUgidUWTR3d-AoqTXcr3eWaPsW2noD4cqhP6lWETZb4RXupqn_YBM-4fo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2ukKeNWof-mDir06MktOqEnBs3DZOs1vXCYf9cRQ5gA&oe=69C7D50C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULDNjhlmoakQ7kNvwElXkQm&_nc_oc=AdrWPTtxk_U6prFxrYHieqd0hEnoy6b0FqX82kM8zcq-hMURQ9ASLmLQAns7P_WZkOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE91BUknlHtWPVe1MAPLDPGmXrnYqWuocogOjV4LQyLg&oe=69C7C97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMivKoNLPGcQ7kNvwGYVT3o&_nc_oc=AdrCbwRI7vLs7-jvoqZNJlyM9yMcotCVg8PuBVS94JLdHHdak_pPZvbNc3Mwvs4JOX4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaXeqLChNa3bSWmqKc_dD4ycFpTs5AGO2N8MO2PKG2dA&oe=69C7E04D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
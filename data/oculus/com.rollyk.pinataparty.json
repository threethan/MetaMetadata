cS_1kQQ7kNvwGvXZGQ&_nc_oc=AdpfAo9jLSWURV0XKow_rk3wC6JyyyghA2cMCSQerqQaZwyyfIUBg2-d_kqCW2h1m-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9See_dgMvLAD2VAGOznrb30rr6OTW1OCF7cA2-ceyixg&oe=6A3E8FC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i90dTjcwRQQQ7kNvwHPrJHP&_nc_oc=AdqA2VK8ry9--71mzLl9gKkTYO7NONyP4SnHK59kEMYZ8Y7ctG86DhKi1SLY44impTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y9qluJm8TJEOTQJmkSwfwBuULblRBDkrM7xUxevBiKg&oe=6A3EAA39"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVWPMi6UpAsQ7kNvwEoHTHq&_nc_oc=AdrR-8ix_fmZsvCzxIZv1Rf7W66UnEZI_OM43nHxm57gFI5-q7jKDVe8xmdgxzIYD_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5VQCyjLnCIadqzz0I7PTtXFI94oOJXxX916YQsbCDmA&oe=6A3E7C0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10OFY4OpAmQQ7kNvwFlwi1O&_nc_oc=AdrvLmNxVA_lNUl802z3WfCq8lrXGsak3eEiwLQZBCvEl5QUrl7r7xXd2pnP5Ctg0cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p8ER7HUKih15o8Zx-2BycZhwzuzuWOGPW6KaQmnOBzA&oe=6A3EA8BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylsPfJRDV0sQ7kNvwEvgdx7&_nc_oc=AdrBjHeX3RDVenKeiUxinUm55BE89IucDDXXvsODXvMru1sSOTRWFH-K1BhQbry72O8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eJDYPMYzz0E5MuczRG05LSq1sMmP0MpzGrmyAMInwpw&oe=6A3E874D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
BySxvnyXf6tz14c3NIt24jAdx5KdDB8QxlaB-9apuyhfrpM0ncke0au13zbb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxymq6Oq5mh-I6MloSA6wQUYpH0-jhkpdKystkTqFp7kQ&oe=69AC0101"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfYW6FbFYoMQ7kNvwGKr4pT&_nc_oc=Adnw5jGSr_bWAcC2u3N85uFvJUeJ3cnm7bJWwtlR0JIfresV1dMS5PC1hzLzm-D_-dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCi0cC4XXSYWIoFn7FWhm-k7qp14S25eM3uyvmGe4QXA&oe=69AC1B79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R22lX2Up5-YQ7kNvwECQirf&_nc_oc=AdlRY75jbgcGOY2fRg1-syeOeMXKsbJeUhsfEyAixsw2RDHC6uWyzFyBEvIsFuX9aAU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMQKqgwqOsRqai4Q3nYN6Oy8ekpfI-9rBRv0usZS9CWw&oe=69AC258C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv0n22-hGGoQ7kNvwHA8c7j&_nc_oc=AdlPGeLQpcc2XvgvNwdCkinw4X2H7m-WO1tgVdHbbQChI0AQTWbS27qvSF-Ythkfyh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyY0ROv6DG_NWk0zDJsz5isigevx9MxjOk51EVi7dvh3Q&oe=69AC19FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wa2SloNYIsQ7kNvwH8aDXx&_nc_oc=AdkG1qqWYyhtHUuNITNbPesn2Z0IJVhdBlvWztDf8svHiIQmc4ipADlQ4NS4JCqmNy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhwgRCOReckb-fiRslgLeJPNnXKIemgAkSeER7SHyxnw&oe=69AC30CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
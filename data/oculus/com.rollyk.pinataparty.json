fzQfCYQ7kNvwEfgkgO&_nc_oc=AdrHQ0mQ9aGVFH_NkkY3t6T4yCyc2dsYaK2TROrMQG2uscGq6I51UbZ7VlwUj2efWYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP_PAXBfXNIaSXITqvO6prdXdASPtoDxHexV9vk5ctFA&oe=6AB536C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9UG2C0KfScQ7kNvwFk1tnR&_nc_oc=AdofXx2JdBf2KQ6dv6M2GXPSl9NOcwx84WYD-eY7x0DpqvY2Z2Qg8KBoPGm-X_ESkOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_KKZd0w7B4WX76mTvhdvQzP3zTYYTx7Jy9WDnSLh4PA&oe=6AB518F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q5MuldBJqgQ7kNvwHvCg3h&_nc_oc=AdqpV8WH3NE59gBnOs5iF3Y9un1uq8q5u7c8eP6Jvxj5OVISnql6_dnEBcjfh7NR9hE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJslSR7rkG03HMblRMDPCSTAJhA4wA67NhvUhWcR0d9DA&oe=6AB5230C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xZWRVjlBHQQ7kNvwHOQbw6&_nc_oc=Adr7UM7lPGVpQ_tYhrJ75zxiBp9p8DR-fCMT9Rta9J1zSuCUaOVSiH3UyG1UNJ3Zkl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItIW9Eoy4FXSVY7qGtsHQgHkkh5oAzcDfSFTkHnFg6LA&oe=6AB5177B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMFJnsYfiHwQ7kNvwFA5SlC&_nc_oc=Adr86hfS7nkqml_SRXyj7UxOrTjVhd3Y0BMEzVjIEuAO9MyPARGkqqe_z9HnKuGJZok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSo9vaubImod-nW1ztOb88Cq0EdTkifrfya7GZFapSfQ&oe=6AB52E4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
NKOjvYQ7kNvwG_Y0SU&_nc_oc=AdpzqIb-e3dWcFO_vNt30weZUfS6I2X17gxqLczRhjYQjz1W6X2gByPnRqTpnf1I3wE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_VfqlnDSIazhsYoim44Sd_IfTJuWXXaJIUSz2ALDx4w&oe=6A282641"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PubYU6VG4ToQ7kNvwGgSVgG&_nc_oc=Adp_ap_yKIb8VNYxCNF5KHhHhZEzeoKV5A13aXz_iq43bSusBWlC21ErRUN-RfaW_AU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rwgyqYaf2oRtakWyHFJhQ5t2Bp6cz_90pnfTYnY2-KA&oe=6A280879"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBikqbOAGfMQ7kNvwErz7SA&_nc_oc=AdqtFdWMxkf4hhdcBcCXfj11hyI4hpLbQJFdUIXrbotgKUGvEvFTnkaWK2SY0cWbhgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cKFtD_xvA2tc-CWIHM_hJ7Po4tS9svffxJdH39tSe1Q&oe=6A28128C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kccAzNiys8MQ7kNvwFexfta&_nc_oc=AdrSlQCzs4Lyu2lAwnfUyICUDEjoxxkEjp6MAUXmk4paOVxZ3JhofXy9X-G3AQb1SaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LeOTpBI5gvGA-ju4BR0Mfm6cEgmiMg27YF-UIO5kqFQ&oe=6A2806FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFnU2YDAxzwQ7kNvwEIzi2F&_nc_oc=AdrvJHwQiTNNe0uDsB_oc5X69pbxOUMm4ha4VlYK3-TYIExGkgIOQggMJUtHV1W5tp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90B2sPZxOqU-HY4eQKbL36ffdQh3Xq4e7K-4Cw18QUag&oe=6A281DCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
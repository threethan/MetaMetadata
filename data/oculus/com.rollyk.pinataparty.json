Q-Bvm4Q7kNvwHhcVnh&_nc_oc=AdoAq9YhfT90RhXYzSGbEgKzd1OAmt9Xrl0F_HH0wA-ydrfu6NeaLU4dvo6g7Y_Eklg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyFpwc_pCIW8xfe46mlKJrMWP2w6IQ60hGuv8Ds-ySOg&oe=6AC11441"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQIQiiV8qU0Q7kNvwFFy6lV&_nc_oc=Adq_RJy1kusUQ_9rTBv7kgjo8p7b7QIkmsWVrChJz8z1zm1kWhHvnr_F9zKK69tlZSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT25jfoq6TkFuEeNqvofjFiYWSjVwkRS8PChZYn0KHEw&oe=6AC12EB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn4XT0nGmSsQ7kNvwG6zGgZ&_nc_oc=Adr-AGXSsOY9EMeu4Aj9YYXVrOklflLcnDK_43xrtFjNFgksim5FGutIt3SO8VBKd3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0HLg9ioc9c2s5tpK6LDFm_6Otv_DshNnz0HSongKiSA&oe=6AC1008C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8t-xRi4mhkQ7kNvwG9_fnX&_nc_oc=AdpTyBhJTN1PAhY-Jz_LDY4yD4d7KS9vH5zCkt6lNdJi34OJsEcxH9yarxW3ErCOP78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg_i4m8pZBM9yHkSO-Yo_uimAY3_5Z6VHQzXs9asVbFw&oe=6AC12D3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SjVUoywaNEQ7kNvwFCHztQ&_nc_oc=AdoA3yFrIJbW65haNo_UEpCCpuVKmPL44G_5iO7_EZq90oz6uDU9JVG1KBnSq_7avcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrpR0rvH-DpUvR1RoS_ohszGDj0_rQTqOka0_Jl-dGiA&oe=6AC10BCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
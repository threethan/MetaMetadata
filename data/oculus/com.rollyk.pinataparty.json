_ohc=P-uhzEDL24oQ7kNvwHzbvYW&_nc_oc=AdrlHeOaX75W7eoZ22sft5EEgoJmaYCTkzy-G0eqfv6b1hmzhiMSyChPiZH5vOBdW_4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLShWozCigU_0wmon8_UYw3iGDBW599A-UHGlzXbLnJmg&oe=6AA41341"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erU76BwdY7AQ7kNvwFXDPBZ&_nc_oc=AdrJnbFBdZcsURJgmsNFZPC_KP1VaLOvs2Fq0Mqz_JDEFcVeCY6sofMQfvGg6H3s50A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHm5L_J0wwxHu4sUtUDdaSLIFUclw3yD4fYuXGGT9xlw&oe=6AA3F579"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUCIoxTXn4gQ7kNvwECN531&_nc_oc=AdoEVJQmqtWCwJJIgxtart_-6UYVwsK4SDnaLvIfKH1CNGJGowHDIfZi9xcah1G4wNE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyi9UAkDAmZlSEuSQ17gM2wKyDOybgooRHL_M8UvvYoQ&oe=6AA3FF8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz5_WcxvLKkQ7kNvwHmhc6s&_nc_oc=AdqwrIIXOMpk-jVuZBorOvgR3vhLGT9Hz-ZEX3-q9GAbdN4y90u3FAOKg-Cshiqm93U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9h3V0pbT66oBGdvete3lzWOwow6UBK88ijN3Sl60h5A&oe=6AA3F3FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NvRMcF_q-YQ7kNvwGw2ruR&_nc_oc=AdqpiPWit5RFSzqbqsIM80MNmbqJpsQ-ZTnAgXZFXe9oY4Et0aHABAuBc6JoEh-4034&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJckNj45srgBmTrCNy2-LJ2lLrMlrbdQC7B0hWrHynNJg&oe=6AA40ACD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"
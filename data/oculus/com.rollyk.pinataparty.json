uNsVOAQ7kNvwFQ4epY&_nc_oc=AdomMZtH36YeaLdpL8GBtmw2UohpHQvlWnhCr5Q-4Ofn29FN1M70TbmX4P_94WgQGyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkquCx9ZIb28PSJdif-47rp7bMItA-fQxkZWYT5ZFvIQ&oe=6A579C41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntmCh2_WnKQQ7kNvwFIO5Ru&_nc_oc=AdrZRMBs1moDmboLZP7ynxTKMFqMpxnq_BAHRwIljr9IJY2SPjMx_taba3MrQQjPsAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC63lsLMl-YOXEYdyiQZyXm6OR57z7u03dzRte45dbsA&oe=6A577E79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M2uA9MOMCIQ7kNvwFDmUBv&_nc_oc=AdpbU_LEB5uefZm__s5XrsFY-pLVTTwjy60SNfysx5wwDLdHLjWlfbVkAp6k3Cqzpc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVrpTSKQE80ZrA2Zc1WfdcBj37_d8-_BQq-Ii_IVeH4A&oe=6A57888C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFYUApuna7gQ7kNvwFGsdPJ&_nc_oc=AdpvXTJnplwlfFbMso2rXR_Vkq6ZNJelEod2R39TXDlEmznopcLIcPPuWOfCSnzEBOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR4b3wdx67ms73yUSQ64NXo0qjFhAe1yGzGJDP4vy1xg&oe=6A577CFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkXRx1Epyj0Q7kNvwHNxMnk&_nc_oc=Adq8sTbBKCZJbr4XQ4JQXZvqFpz_kna_ynQclRyz0w6CCiOyluTtztfj6kNK-0Vn1do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABPySBr9u88mw1SjRWsbhm0VWnLxkeG1yATTlNfie8tA&oe=6A5793CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
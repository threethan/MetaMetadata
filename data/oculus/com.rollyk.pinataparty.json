rSjz0UQ7kNvwHwYHTJ&_nc_oc=AdpFUoKhwhKbqENvvvgPuVUXeXW-1WFGH_rqHqWzn9fZGL6MwTwuvYMMVdWd_V4igf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMxsucRZFWXzz5ER1JPYnzw5w59YzVwvji5QDKDtF6Ww&oe=6AA807C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWI_lHAtEeYQ7kNvwEpnb2I&_nc_oc=AdryIksSS-xLsDIuibnHVqrSJd972MMK2VgLLBLYh_PYbwDfdZAceU8Vi_YPuctGmek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbreSLI2fz0rndJOjCdlEfmPWTLdtwTmjkv8XVvCFIhQ&oe=6AA7E9F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l17asP-WzgQ7kNvwFzYpTT&_nc_oc=Adrb4IlbSpqEV4hkQ2-curBkVszYgioUGyEpHXh8zfQp0Hrs0I7Ha2IgYXeKiGuwLnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL352MJU82QlnZ3P3SQ_kwFKhXJAuObddk7mWevIRyuxQ&oe=6AA7F40C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3uF-TG0N6EQ7kNvwHAjNlJ&_nc_oc=AdqkfoVqgCmQdesGIDiH_H7F6ivFwKudzgHPATEh-KEO1BZqdis5MM1k214RSzHSdLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpokauW-d7oWL38R95pP82Z1i0gKOrcYwj16f5fG4ncg&oe=6AA7E87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAKQd5PIwD8Q7kNvwE7EEqy&_nc_oc=AdrMSkm2fbmohXjr7YdsWG8-g7xQ3Oejpp8gbY4ve-ihDIAAYLYU0DyEa1_AQpPnZzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8fnp9W_wGmymt5rOot4JTeiKgNIX_v2zIyvu5wtHeFw&oe=6AA7FF4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
VBAvygQ7kNvwElYXHJ&_nc_oc=Adrsc6uXkLuoWgEcche4RpRoCQ-kaBpFkyzsbnE-WGdlPgl1vRL36w5Wnd6KZ0c4g3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AvnHA83Ukz_NWb34bt-IvX-CSPxjb7RnyAcXCtT0Mnw&oe=69EB8141"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQTLyWxHj3YQ7kNvwFnXweS&_nc_oc=AdqjHLtjvat0hIg4Jj61p8HT0BNanjCk8gcdIf2383O1HjAHE2ifgoh8oX2eQm7uXdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14U1Gti94kH93jCrkw6CU2tgyJTgmbffwnbZoi_jIRdw&oe=69EB6379"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r6-nlSISFEQ7kNvwHKwBKg&_nc_oc=Adr8EHRZ78ixDug-NkPMxAaMJ6RdBTcn9Jd6prYVMS4ee2WQiTjFaxpAmKN-34N9CJw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23CjkuSOUzohDrR14mN59KiKgJ2ArkwOI9-iePiBytCw&oe=69EB6D8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqamSESANJ0Q7kNvwEkBJw8&_nc_oc=Adr01DzkNaKVdJOrqj2srKWJpQBd5Lw8Xvl6k_32xCffPXGaW0eIc2WaBTXRK3sVua8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V6xFWD8dBz7E_B73HBJHOIDioK5WFukh9DSoxgAIlNg&oe=69EB61FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYtXnAny0QoQ7kNvwExeVBm&_nc_oc=AdpffqM-_6Ha3t99NUUJx3COqvrEk27WDhuKbJIn8onmvW9ajineNKL_aqNOtKZLyGQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H8UYLe41_ikV2ucv0ED2vu73z0sPXny7qXHohX0dK3Q&oe=69EB78CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
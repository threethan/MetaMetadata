wDH9Z4Q7kNvwGZrzoj&_nc_oc=AdrMZqLPxF6vFVsC_eyiIkuOLlOL5Iz-DUtBbnqKAvWEPerpbImN9d4kweObaIZIPiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPvb1Qp_itXw2glL7G1gylSsFGlRnPPH1Yvkeiixz_1Q&oe=6AC265C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj-Vg1yQydYQ7kNvwFHo45G&_nc_oc=AdrUO21fatjaTgC4qye7Wu-0jASUw1r6SU9VmyvhyR8oYAVQCVoDCUXnmGQThNd0ZFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvVFp0S4wTrQhBPI9-d6Uqq8IWb9dpuhzfplmWGQxVtg&oe=6AC28039"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn4XT0nGmSsQ7kNvwGv57LN&_nc_oc=AdryVFo392IkYSFKPUQE3fGWPGivY70BQchnPtOuXqUSRtxf53sKlms4kHraQ5P2H04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrwY5ZWAa6Gh2CackwszoVQxXOo3V894uEWHxO9cdBdg&oe=6AC2520C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzfACH9tNL0Q7kNvwGnfiMi&_nc_oc=AdpfMf64Nj8uHX4tIrJazqwGINUjtiEHUYu-4nS8ms_X2JAKa8pfk3981dTkzYr8jio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2mygp6IaNqRL_BXiJ5MqfUl6EKDEHqyI72Uu9NH2htg&oe=6AC27EBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SjVUoywaNEQ7kNvwEOMylQ&_nc_oc=AdpmfttkVEcgIAIPRIIergfd0-znN97VkgNKHpGQTZJoX_pgWnG-sl4Toc4oV_MvqDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObVOiE1R4isFMTmmmYA_OtHorxx3Q5hZnNLEmN-WtN6w&oe=6AC25D4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
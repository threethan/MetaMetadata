MWNbFcQ7kNvwG2ylT_&_nc_oc=AdrcZrbBAjUwg0bLhfzfErH6nt16LmtjrtQFZqIBLnHBeHZ2GNbHG59LNG2z2-ask-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRp4-6qtlwNV1FpALKB-f2PnSXXCc3qMmdABlq1pSfsw&oe=6A7891C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzHarCyhkSQQ7kNvwHEXK92&_nc_oc=AdpjqIIU_V6hBewPK_AwnrgQKvpF69cW4zsx8qt6DP3yW1YzCRvwtYXv3wwh07FVeHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLBWc_MAo-V-W_VhLRN5AGd8HQwmiRtk_g01mSc1-3bQ&oe=6A7873F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngI7GQYy6ZAQ7kNvwHL7gfS&_nc_oc=AdrTBk8B9Rkttpos7cgl8XQNmwN-iE6awxIOsL6H78zYLmAUTh15_Qm44UDFeJLKfUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVBMra3ytfW1yzl62PhvDAYT2P6HWLx37Ka0dEGOipcw&oe=6A787E0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_dxhNkD37AQ7kNvwHcIp_O&_nc_oc=AdpIImoWFFY8Yw7W9uLvlJjIsnXHVXBkiumw73-XkG2YFuieRvWy5yIQT-G6pJJXaAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbFFcIjcXpqPWGpKleCa7aOOXTBfdNVIkShsY0D2nEOg&oe=6A78727B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_kNLNh4ENAQ7kNvwGgEr5O&_nc_oc=AdrL7hbj6x5N94qoOf0xgWzTez6fecZf-9YjuO-Uc380a4v2aGW2x-dZe2k1lE8Casw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4HdmaKYZamdcHC2JSGgPOEBEufdNRwzIGY59XWHY7fA&oe=6A78894D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
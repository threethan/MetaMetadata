EDL24oQ7kNvwEgKtcy&_nc_oc=AdoA6ZgfltYVibuScjJfcEru1eVZlDZXlq_aNhXl8TZP_BY_2vs0iYFblswRZ7y4PyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLZ66hO-qTZpOriJQARIKHYDGNp0-O5hH1_LjgHJihdw&oe=6AA2C1C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erU76BwdY7AQ7kNvwHR4NfY&_nc_oc=AdpStrZRHZkd_ipgqdXxa8IcdTRX52xmeHqE-cP4lMEFm6VO8vT5P8VDfOLufqmXftY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVXxBeNQS9SjDZeJySrVeX0B49TpyVgmFbnJul3c2FaQ&oe=6AA2A3F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=talGx5xLYTgQ7kNvwHXg2QJ&_nc_oc=AdptFFhoSfHRHbYTfFwJz3QjGyMcUhLjz8af2k0n-2VWq5DJtPmuHRJS0YgT9r0g2Rs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDfZFZcV_4hOArFtdZgV1RPNNiynkFMjgMSB8fxnuaLg&oe=6AA2AE0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz5_WcxvLKkQ7kNvwEzmi_I&_nc_oc=AdoBJZRl_tETe9vueF4gD8He84pENsdq4CEQSfFRutI8Nne9i0qbg4GhSZADiKInp7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BGXx9VHvADySAO7JcOftKlzkLWY_NALZTOCKsO2kjg&oe=6AA2A27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOP7VTuy8VgQ7kNvwEn8QEh&_nc_oc=AdqKhxlHTXBNcWBIfrV7dtAXaag837lgvOeG0eIx8rN2E6HiHwzf_7oejXv-if3AV9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIx4naofGLCbo1jBKxld2A9N1NpTuM9_to9Yqar-iuIQ&oe=6AA2B94D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
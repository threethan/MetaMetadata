xjJn2IQ7kNvwFikrh_&_nc_oc=AdoidNvKJhJxStJ3fvNV4VQCWVC4fO6KJERBkudRJQt1yCxSM8wocsiV54wQZvRCXuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MyRXnLCBMeEPHiZwLY0uNg8sRZTpkv2qp1AHRlluGLA&oe=69E39841"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq2EySZaN3kQ7kNvwEsCqro&_nc_oc=AdqU7yFCh4S4vvMz_RseMKla-yJiVa_P4v1Ktp5Y_qDT3BcI5i7xkZffR5ac3fgbEAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GmU8RR_cy8kfBEfm4_WvDr470CcaajNOo4nZGjNUd4Q&oe=69E37A79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Ynsql4_V0Q7kNvwHgInph&_nc_oc=AdoTp_8cig1TXN0Bt_CzVwtFn_vEVJ1Z7yLyNy_dGPtiZ9Q2nNx3yzBey6awkMOaHlA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X2EjmfaJzTmnVJgcaz-dGbuSSdvnjTc3paA7rxk5uOQ&oe=69E3848C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV7YFYhbb28Q7kNvwF_tpx_&_nc_oc=AdrNhnhCIviw7t8tRNM9Ja8Tv0hl8Fl89008nc8Rvk4vZmK9wO7BIYrNT5Slo1xSZbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c2f9P6qYWHGaedYz57j0TysNX_YofMtKX4qlt7c45eg&oe=69E378FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6SK07p6We0Q7kNvwGLW1AM&_nc_oc=Adr9WSdk0lwt-1pqV9emvL0Poiv5nGKG30_m-Y2PFuCPTgsqCEydaTd3-P42bHeJQZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bh0w8fg21P_ott2Aqfo6oqzm4Oifcj4pwL2IbHtAyEg&oe=69E38FCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
aT85pEQ7kNvwFI0h4Y&_nc_oc=Adqe4soRdjIgtjcyz-ucxZhQhVz6az5PnfbzLnaJFzYT-XO1MZZ5tr5kGXeo7CkXp2o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsQp6-_SkJ-7isTSTqD_q5eZ0EJ8jrCh4MO4UZaHhLAw&oe=6A8ACE81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jp8ghZevTYQ7kNvwEYLg1j&_nc_oc=AdrpQ6ZjTNX-IjekyCwzbkKjYvyi84ABoWWw1nEdO97l400l-I_eoMzi1rKM3t023Mw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwTxdK527N_tFxjvEP1efpWwkXGsaEX0EzXu4nyIfZCg&oe=6A8AE8F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyjDMgwML3UQ7kNvwGcZLdN&_nc_oc=Adob9yjABtoHMnX-XYT4NqjxqPCVLniTZPkio_4Gj5szgxFtRsJGpI2Ud4Z3yU49mdo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmwBjwNqZ8DwD3i9z_SycwXqsD4_4MEQw3yal_ODvQtw&oe=6A8AF30C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRgownW8pT0Q7kNvwE2thYZ&_nc_oc=AdpyaQdECtMehbnnQ3nZrv8SxUqUObmv3Ogd7tZLC23mXq1cQRZY3GK7oCwHSws2654&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOUHEbUwDcyslQ6jEfYJ_vg6iFwTKkjsKO1KUsHnFpiw&oe=6A8AE77B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE38hEEA9jUQ7kNvwFT4Veb&_nc_oc=Adp_QgP9fM0-o7YsKjBGp6RZS6Sa_Zp5PW9yblZdFtYsuf3SCqlBut1F5L-aJDWj2u8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1pY0Gj0Sj98xnAnMvj7cL8jZAnlmhOGwepvdlNIm_Sw&oe=6A8AC60D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
aT85pEQ7kNvwG3zQMB&_nc_oc=AdpL0QTPMS2Ih0hJX6I4w_r0Q_mEiaWT8uHbu93YkzUvjuY6y5ZGruih9YJ7B40wsIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-ioYNulN-a0Zj5RbK0pjlix8mvOjaphi_9oc6cm6kew&oe=6A8C2001"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jp8ghZevTYQ7kNvwHt_-xm&_nc_oc=AdpaSHE9eOMiwsot5l5NGOTke0qhoIPeL3L8Q04Xm5J4aRT-Xhc0gEoknzyo5cQ3Bfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAcYUSfq2SDh05yGaoXLH2Kh4RCwhQOsnk4PXBS56BEQ&oe=6A8C3A79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMCJH61tPB8Q7kNvwH22m5F&_nc_oc=AdrnRA44FVTaceVKyPXIqMAdOJ2AAmhPPyFGWkWEmHCxNK06f3t7qYxHbwYM6TyG6uA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhCWULc3JB626nGsdrRN7QLind3XyUGkr5gEg14aY-vg&oe=6A8C448C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRgownW8pT0Q7kNvwGz6UAg&_nc_oc=AdoO6I24ywRT_pab9fLfjf5nMA9_k6YCXpsJNFmNhMqSkeSIcOl5D7STY1acHlBQ8xM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYbb885XbA6mOgFH9dvMq0wutEVXvuxIqsSErsJ6zVcg&oe=6A8C38FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7OvhC5DaI0Q7kNvwFJwZq9&_nc_oc=AdoJ-0-zhEEdq3dqwKlag-hSCFCI6J7fnejguZdequnRxxOsshduFmjiCcFq3ll9oWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE58c8jIBeIS5U-3kJ1zxOdT5DKPm347sf00YxhMarb5Q&oe=6A8C178D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
Qj0rNEQ7kNvwGMH2Ru&_nc_oc=Adr6dwhuIh2XK_2v918Fd1CxQYWAI7nt7wxW_brYlVyKzpkhrngeTTa-Ex3E3BqpL3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWisYN-v0TMtCAzM2Gss67OuN2czgqCwiMYvErrapEcQ&oe=6A4FB341"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFZdC8Bimq4Q7kNvwHI1idf&_nc_oc=AdqF24CFUfxOM3giOFPFoR0yrICIi_GeWrEBxoqaV4K5CGeS2ox1vj-aL8HCSCb-6f8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnMpewvn6Iw6bEzE7qhm52WTmgwK2X-PhQyWvaSjYbPg&oe=6A4F9579"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdiFrylkwGcQ7kNvwFYHcpk&_nc_oc=AdozjlPQ_d4ZMKt2sY5uzJr48FMj78mbhK-eNWzraPHcuq2omxlZlMgkvr8wAHqQlQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZDVdSWc3IrzRLInSmTPboaY5tj4qsA568KOPhJ2QkOA&oe=6A4F9F8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCWE8Uj70_4Q7kNvwEzJD2t&_nc_oc=Adpe86Qv-5UgVWkGCXRtvUuA1afAL1JEI9Zb40ukSnxSr8S97mjCCNc770nYiqZ9fPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7lfZI_16QAg7SEcgiynA5IZytegBl1YFBnp-X5XDGKA&oe=6A4F93FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quzb1xApCAUQ7kNvwFzOw-q&_nc_oc=AdrY3AghTqbxrxhwnKndC89wVWsMtxvZAunT_oPp2nJwUSfUmT6vgiS-BbBc48KNFJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJG3jHk37XPQhIRkjuRCwgVv0OtqBxWrLFH4LbFvlcHg&oe=6A4FAACD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
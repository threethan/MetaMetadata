yO5pWcQ7kNvwEMSapq&_nc_oc=AdqtfX40aK6SIL_PCH0vxD5wdIj4Cov5asGbvQMhAwMzzj8UQAlTZKt902iXWBb-cBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVQ636-nW_OsKL5BDRw6LbjrvZQVfHPOyTmUm3M-vKlw&oe=6A75EEC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxDv_AUmO24Q7kNvwEb9pgE&_nc_oc=AdrqfD9M1309GNodkXS_UmnaNSej6b-oqopEes7BECfqppCuuG8iNzVq38W0yuqfH0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHp5_S2QuEwoP572JZOCwhSRFHiF6_ZGd7lzxTIjqQzA&oe=6A75D0F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUgzhmx6X20Q7kNvwFXMk6p&_nc_oc=AdqDzAbacDDUXKCAyX4iFK7bsmCXTYIUTHxCfWzpwbGD9nDiOGzFTiNfj2aGVtz9Dlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuhmqVUzmcGIjZMQ4a5AwJ2UosJIXstroNUxRnBbiszA&oe=6A75DB0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wDZQf1VUaEQ7kNvwEYhQer&_nc_oc=AdoKZpaGY9yoTxnludYXeHa6vxpCNuYRmWWcn-KpL6t_eBZLKQZ-18ajLtLs3Y-yR_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHOXphlEwNLAEwGx6Ft49yTZr4SrG3ztJomzx-P4bDuw&oe=6A75CF7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIpcDHmuI3AQ7kNvwG1ZkIu&_nc_oc=AdqduIHZcLNDA5pZj8gI5YZpzF8ehdEzDJt82sjBo1NSTd-Jr60Q0oD6PdOs6lDOcvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFQi8sJorQqIwh1Z33wa1j6H_lg8PfGzXUyre57Ko2mw&oe=6A75E64D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
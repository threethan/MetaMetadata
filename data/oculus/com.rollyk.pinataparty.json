c6TNDrFxEjSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1eZNdjCujEzZ9WRucnhJF-pcrL-Bd0pvQFPAKiYaKBaw&oe=69F0B38C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMUwoLhEyLYQ7kNvwEQeorP&_nc_oc=Adq70Z7CVwynJ6ATcQEF9maSojvaQXzlcTzOH8r9ybKzXk-sEy_qAsuJFM3iyB05CM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af14cqTVcy4ofThtI5ZtfW5SkA2WkGBp38tcLjs3die9vw&oe=69F0A7FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHUnZ85O5EQ7kNvwHHVPJZ&_nc_oc=AdqiOVK-l8KOVRQmoTQUhfBr7K6IMK1v3wENfwQk0TU8ApWpaaNTn390cK_z-xBBO4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2y2UcOHy-RQawWeZUvQsTxTTKqz1xxVWqhT7wGhwGY5w&oe=69F0BECD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild 
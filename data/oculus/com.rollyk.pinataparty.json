TXxHJIQ7kNvwHomOSS&_nc_oc=Adr3Bf_hOP-umOPcPyQjtoT7-OVRACSOsqMVy4N_T5qb0YQVNrtIJ_OAYRWRFm8nCdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIykaLP5mid_5KBtRdAMJ1u1QGlR9u96OzjqzQVe8Lbiw&oe=6AB7D9C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP6wrTtCOq4Q7kNvwHiDFT-&_nc_oc=Ado-kieJLIMFYUp_nIqVQelLdvIkYR6ZO7L5gKoW-Hv3Of3s7j36NC-_jUkAv0TC9y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyzHOuDqgTwSt68KU5b4MMgl_l7fNwwyqyi9l332Ed6Q&oe=6AB7BBF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV7Hqyy2likQ7kNvwG-V8e5&_nc_oc=AdppjyHYJtX8QLPs34A-9l6zEKM05mVeN2jQBwq_7eRcp39ky05Ix_hBJbkK78pNZA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUYfwWXfOdH2VJ4zNCSMHqIOf_aEUXtIjvbNP6xwzu-w&oe=6AB7C60C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crx3HzrH2XYQ7kNvwFYh-ZQ&_nc_oc=AdpGGYtEC3LodyUEzdp5hqM2NfXeOa7wA6nvCgHJaWdCFVNm4M26fOUVXfdOWkhmnUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyb3fQxhJgMeZUYWuTOI-OH3xGOoQi-U7C_80Cy5DHTg&oe=6AB7BA7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dyH8978vTUQ7kNvwElRPbd&_nc_oc=Adp2ubRT0mHxEVcjJ3Qv0ddAeNrHR90grbwp4zjfWeo1Xil0BUUJw7oPPIi_i8tYYfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkAzGR6wPCvvmXCPcGxYssUe2V1z7Em9niCSI9f9NVNQ&oe=6AB7D14D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
1tuJ50Q7kNvwFBvwVR&_nc_oc=Adpj0Sui1Ovu2JURb0HyodT3f1IDmjL0PSgLLws8pMsl2ihYUlRmb9lNm6xbz1cNCuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe06klrgnRLRIssXQ0AQVb1XQ21TzPuL0s8wKQLqKf3g&oe=6A60D6C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtO8OjOXsIYQ7kNvwH04tD8&_nc_oc=AdovFJCMfvuKVDGZWZHkKO77kO-qc-Gli026IrC3gU-48g-3jK4ejDf8LpBASenNikQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUnQt6HU4xQLA82oARMtJWR8_6BP5ha1i-m4nJUmX33g&oe=6A60B8F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9S48cGyDYsQ7kNvwHRHWhM&_nc_oc=Adovt5onMEBXPRIBvqim1kXKGwlR8QeIb2e7ePuAvLjWIIpZz5k9jxW6tRBMQ0HB7HI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPzaIMugRU-pMcizeSe5LoOgZHDXNimTlBAL5cwjgKGQ&oe=6A60C30C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYc17rIU5qQQ7kNvwGsnLR-&_nc_oc=Ado-VKPdbG0GAwoGgx4reH5eYas42opJGw4ypZomv8yzype-RAjFXUK6Oj0u8epeG3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW0V1d1uufElS0ctAsXdSSn4zZm7getrXuxt_MX3xYQw&oe=6A60B77B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw25KfeNP6IQ7kNvwHHIu7A&_nc_oc=AdoID2xVEMl5H3lK2GvMMW_oViRDeOBfJw9edNMlT98ixqFda9eguGc_Pfr27RxsSJs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU3zna35z-fAfbPSJ847L2zd6WC5yjmS_0HLoAxr3vSA&oe=6A60CE4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
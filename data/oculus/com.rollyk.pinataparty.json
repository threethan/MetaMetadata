2EXtKMQ7kNvwGONymh&_nc_oc=Adpt1g44KOmV9iMlsJTRXvI46ckYvJ3EsKuAOmp3i-njRP6UYmRukgA3iiShA8UNBME&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UmPYZYPgMIoTP9CaS8jFEA7ebLsF7JTKAUwYUAE_Xeg&oe=69D517C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt655ssPIusQ7kNvwEMCos_&_nc_oc=Adp4qTIVGETqoJxdVRJo-ExOGgBO_MCwAWtvlH55wuupBknabucDeldvaiU3v7--Sik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wdMM-XU-BqR_ThJqQl2b1NTsHhuMH6hSWD_ryhnrv1w&oe=69D4F9F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppGTEGqFN_gQ7kNvwF7drO6&_nc_oc=AdpK2_a4ztU2ytJxFfcF3kA8WyLkiE9sfRtlnTEgePXI4JtTfh-qRCHMjZzg9e1M-9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af251vn2_CUs_9n73zRPA54ADw9Ggor6xCsZtVLmrRukng&oe=69D5040C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rqtRLpVcS8Q7kNvwG-c-o0&_nc_oc=Adqdv1DB72yyHeJvHbRVCfAbeu4HuF4zC2phf-9ZhHQikqE5uPmmpluesDeB-x4QJUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IUyx76YA3jgAdItO1TyBiMwo-cCfO-Yd1wCOs-HchUw&oe=69D4F87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irEzzLw9Cd0Q7kNvwF-jr9k&_nc_oc=AdqIUBXEFao-LtKiD9wMO-bfbWrg4FWMP_kZVNMr4C21TZ-BnZLSAO0EWaIru9XIrcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aUJnV42bXwFJqaXG-O2MFGR5GWNftvBIOz1h3Co1k9g&oe=69D50F4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
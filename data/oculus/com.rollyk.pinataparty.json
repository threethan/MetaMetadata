_ohc=d7aUjS89RbEQ7kNvwFOl_91&_nc_oc=AdoX7Kr-4lNpDACH1_XxonNkMWXA2_xle340MPgCVdKVE0PWeyNfbjdhlm56gZVm2uo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W50BTVQ3_lT2wL3kDYGHvOHRtB9xyICo5WaOfngE1xQ&oe=6A36A6C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nicx01As1uIQ7kNvwESoihJ&_nc_oc=AdrnsSwIw4qR8wxKnZSpOEP_N1mxw5m4AvfZFKPRpEeg0lLAUoFlGvcXGVQmeYHnefs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oeU1f1E3BoV4AYL22ytpOz5tQ9bI_kKq5UR8r5AfMMA&oe=6A36C139"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MCv9m__TnAQ7kNvwFZq6nY&_nc_oc=AdoZ4oMHGTRXpdIQ9iikK_6pI17Ak4hvG8_2MfiQX7bDneSnrZ48ThNzKBB_jPABCUM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iXFeooy31r-IJOQmPCILWUe8Pc9DRq8GSDs7BkI5w_Q&oe=6A36930C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6oHCn8VwMgQ7kNvwGhk4FM&_nc_oc=AdrbMg7SfelSpMsVI6dXAzmPxL9scdpaQIZTDhR6KJDze85aCfJqYgSGNjWCYSURzcY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o9lHNiM65VQW8dsdhXLPvcWLxh3Jom-D-v_3AvRuCbA&oe=6A36BFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhWgTM9EHxsQ7kNvwGvS7qk&_nc_oc=AdrKRL-RIYqwf3Hrr0OIGdHgLZk38xzFhJ698JP6mdSXgmHguPeXtO23tTMZGikti2w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cPg93HN1DeH9-z19SyHWcxwryEkDNv1eoJQs_eojk6Q&oe=6A369E4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"
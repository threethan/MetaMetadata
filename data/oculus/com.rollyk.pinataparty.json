nsuz1QQ7kNvwGRZZQ4&_nc_oc=Ado4rqEp1F7jzqMGsaWUstTMiWXunkztsSfAx29ZRpAdG6yLbbHTOI1lXyo0LOnOynM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aVVjGr9v-tLamrekuHt0PwNFcMeLMDryHkGE90oufpg&oe=6A2D6C41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITPzvYh0lKYQ7kNvwHoUX-W&_nc_oc=Adp0kGDBrY9mNSuIn1O5WgYcw8KrdqO8qNp-6Bv4m8GVEeXGxgkSUxIwk5ojL1Dt4S8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OvGDKd1Xw-2kCp15pEZXJVaHOAjdTdsgQ9RiQIgXIFQ&oe=6A2D4E79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6bXonrLHdoQ7kNvwF4CLrQ&_nc_oc=Ador8VPMg7wjG4K8jzSR3RTRK3k2ocXC0HCcwEe2ft9VQTZ7PaG-vJ2igtESg554Ypc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eLR5sK4AMMqqIogISnbgT4rKmw5Vuf1ZtO0Qg31L2Sg&oe=6A2D588C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flgrHZ5vo1YQ7kNvwEb0cZ7&_nc_oc=AdpKEKMD6KzSk8uGZpdnWkfA-2-vrwEjpYIa9LjD5vgPAItN8Li12lCn3xYAzo-iKzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3fpvCAvSf0YLyHwaXjdkzuNtDyrus4helzB6BSPyalA&oe=6A2D4CFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx2QKNE68xcQ7kNvwEKkdaU&_nc_oc=AdqOluTNjWlI4nxJI6QACZitcaToChZcHdZuQnHn4kt9qzdI7MbDEjOFZZQKjboEBig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hZIn5wMP70gYZAbZFNZeYU8hlN7dUTG0Sh9OHXhwPXA&oe=6A2D63CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
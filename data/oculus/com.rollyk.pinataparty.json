V7dRAoQ7kNvwFBteQb&_nc_oc=AdpkWc50QrQZfqQC2_cY0Ru036LKTDjDUg1yAoWQ0rzLjNHUYvKbIRNbysauJ-TGcPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoUPFlh4VVzkuDOZj55MdlTrJWZrYJgg9DkWX_iFLN6Q&oe=6AF1DBC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxbbPLe5Gx0Q7kNvwHLUttv&_nc_oc=AdrRkYmrGjEvQNLxkgGEsWeBoFXTmLQ2jxbUlkwFofhUq4Twof3xBwKSG6W0eF_KXJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYoySePIEN1QWdXeSEaI41ZHrf4LMoUMCo6kHnfdmyFg&oe=6AF1F639"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gnfaKqqDpAQ7kNvwHgq2KZ&_nc_oc=AdoGxmi1gtlvJ3v9Dwv7Z7JeejooDp4spMGV8h_WkXJWVPkDNI70z069NqHgf9pDanA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbEcjf7bCDFvFRZ1efwFHZ3ff4UBUrdB2nkiUQ1E4xuw&oe=6AF2004C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXQH-OMrdQUQ7kNvwGigYWe&_nc_oc=AdpLQfILgHLksEiYHi5359Kh-zu7RcCl8GS155HzWhfqBKyebdYi81m673v4dPHQsl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWBAHPqUAmCVA4oT_JsOTwZUlo77UQFgwsiLz9mErfRA&oe=6AF1F4BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhZT7MWvNxoQ7kNvwHLd2fU&_nc_oc=AdqS0HSIczgAShwyxnuQ0Z1k_GosloagubhbW8Lllzczqx5_2gPv-guPXkER9GgCXC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV04LpUrahYoX-KzX-73Z2gaQmLwjTxfBRnPFrdWHX_g&oe=6AF20B8D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
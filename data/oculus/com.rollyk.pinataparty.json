AXCOmqM5H9-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvqZAZiuqO873A3MiTR-UEk3-RHkWrd6fr99jcX2La-xg&oe=699C538C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmLeG9Sk0ZAQ7kNvwHMqupZ&_nc_oc=AdmHGfRO-2uqD33_7kIMWGvDw2PVsHhguRzlDL5Ar7b5dpH3FpwwToLdvH3wE6AgWrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs_3PQyiBp6PwtFIbU1y-vwjm1_hSe1GdRGbpIpAGredg&oe=699C47FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXYIFpsR6eAQ7kNvwFv7GFL&_nc_oc=AdlFT4mFVDI5CZBfNsUpkm4fabS5Q-qrG87X5FvJK1iaLfqXKJVj_vgp199gWGm5r_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMJ9zAD6T6v8zuR_6qcrzDGqjaR4TaOJrTrMXiFG0L9Q&oe=699C5ECD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild 
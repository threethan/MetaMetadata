Qj0rNEQ7kNvwFNk89l&_nc_oc=AdopNeiXgDTztNzVR3OAmas_b4H43-pY7qj7sGEEhvIgWP0rOKlMXtEYMBuDvDE1p0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASEtbFdAkMRAKUqFecATuC4yfbCePDSKaJ-Qy_MWU1vg&oe=6A5104C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFZdC8Bimq4Q7kNvwFwnFSN&_nc_oc=AdpE6KvLgbp-kB5WczkPCjPO78hnIohpvPMKBzU8566lRM5o_vqxssr-NEAT82OUAVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAac_uz7lGnrIt-UtgsAyv9co08Oa8lOX_auDSyApa5pQ&oe=6A50E6F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdpDNyOEwxMQ7kNvwF2YnFu&_nc_oc=AdpBscvkXP-YHGZD2hUE3jq6H2aPjjwPG89bmZDht0RJIxq0FTxVKEonZOZjQo0cyP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACrYW96aPlsBfl4ylS934VIWDGse8kvoVRvPMHpljmTA&oe=6A50F10C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCWE8Uj70_4Q7kNvwGuVfpo&_nc_oc=Ado_ZezZLCV46RYq81vOVIU2wWv5lDsBsPzNGfktkiGfs4pMQYbqvyiPz5S0rv8kW4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU1QtlpNUKothwuI_Q-OviC2HLpj-cnHgK01WAsFq9wA&oe=6A50E57B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd4-bw9ODI0Q7kNvwFTRkZY&_nc_oc=AdpQvl3C9g_HbV-s84A1_VYhl1Uxg6FEULjB6WHBFvxYWeoj8RXsrsJb4Bkuw0AguSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj-judNi_CUX7JtSocfaCrM7VsF2aDCd9GU3jzseNU0g&oe=6A50FC4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
-iad3-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbdhuD9x8GwQ7kNvwG7hh8B&_nc_oc=AdmO9VQkfFPsKD8wWq3PP4uB4vh3schXU4UkRnPCFc4n3BsWvBzgqKDmiyqBs4nhG00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeAXlMOtfMYAoFnw-kz3oD4cpZttm2zTYrmGeaTksXTA&oe=69BFEC0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dkq24tU-nAMQ7kNvwFp1mTS&_nc_oc=Adlh_iMThxMUrW8dnC2WYg84gh41-2W_aYOKEUxFglJdLMopVvqnwmU-OUuR1jTwawE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyW0gXdEgmb79hOp1loSV9W6zfTLH_scJUfmj8EQFa6Jg&oe=69BFE07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RJbzR9FWNkQ7kNvwEiwUgP&_nc_oc=AdlrKFfwZx2wdcxmiLoF6uurM7gGmqXcEVlhVV0BObfeLW-JW8tiaKgyFS4UJzywpck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_bJlIZ9ta5uV3mLESDfuF-5QidRBE-hZzyNexShf1gA&oe=69BFF74D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
xg3XgoQ7kNvwEE06Wf&_nc_oc=Adpw6HllMm2mkMyIsaHQ7x1JBtiNd0FeI3od_0xkNtZdyUczcC4so_8FO1i5re5nENQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u3qf-3SS2j5goP2SfdS1v1vygaUs_FqR9sRFqF5rWNQ&oe=6A1AF741"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4tWPdAuMfYQ7kNvwGFmdU6&_nc_oc=AdrRlrFO2g2mKWFqG-XshEm_RAzOr2xQ5a5WHybdLLn_ZHmdEMbZ0RBmPboWrC6xTqw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MTd7H1COWmWcMkdjaBhx9DbaSqOdWQiLdF904SirM0w&oe=6A1AD979"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAfuA7gSZyIQ7kNvwF5Fzlu&_nc_oc=AdpDucEjL4QYP-JSemAQyUVy11WbksUcb7kt4elop0HfZI-JzfHxJRuZcxoB3j48SwE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UwaNYDpPt2KalFnJEiMh2q_BcYdXlcK_u4cgl81EMTw&oe=6A1AE38C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv6kbfOv1HwQ7kNvwH5OpLO&_nc_oc=AdrIB18w2c1rd476fBjZuqtLsyLsI1RDDaIbpfpXR7WCtY_zfP5ge9DuCejeezJs6bo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JdctDCT86zRuWBc9KE-n0hdtVjBD-4EuIYIOt7AvPrA&oe=6A1AD7FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4s1O31Gf9gQ7kNvwHQwFDb&_nc_oc=AdphIT9nJdatAPjdyU6gqlPYhkh2KKI9eo3ljVKbwmqOCQjXFx1Pnf0JR26PIen3OBM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67p_YFfnIrv6h5e7hOd0i6cbJ91-ZTvrKOxkltWe6c3A&oe=6A1AEECD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
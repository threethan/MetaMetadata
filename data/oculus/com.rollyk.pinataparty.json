DYbEygQ7kNvwFs_Mo_&_nc_oc=AdrwAk6pRFWHZaWkaCbd4aRmn7mtwlfZpCitXpI9xlTrg9jnFEW2wbEF-k1vba2zsJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQk-RVif9DtCZBO9WbZs7U7ujuel2-su3XyLidfHEShA&oe=6ACE4341"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJaCUNDrq0UQ7kNvwGAGxJV&_nc_oc=Ador0R7p8CZZsa3bwvYyw7hg-PcHof445M89DunB-6x7XIElW8jy3cr8Iaf2PQaGJTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvE2nVI4xzKeBkxg8OdDM9c6WxHELEMpBdIKxqnIhBOQ&oe=6ACE5DB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwXlicCU3nsQ7kNvwHK8naX&_nc_oc=AdqxBbqeqTsmBa6wj5g4C99OewXh1NXgqd5euY4FS4DjYZm4mpdoWMxZQ3V58E1d07o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWWMRW5jI378_hzo1dqB6yHybXM24wc-aIloeBsA0jMw&oe=6ACE67CC"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MsTNaJyAloQ7kNvwG-pewf&_nc_oc=Adr20Et9gY0StD1kLPDNIZEDyTdzy6TQrDW3XuP1Yj25CPfUbbopgLtIdmup3ILlV-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWTgPfaSZuZavOi7guAzuA7zbA71jqqgzamkLknwrVyA&oe=6ACE5C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p_HlGD6wjQQ7kNvwGFoUcW&_nc_oc=AdrT32--5xeb7-huHG4NxaDIejeKNyD4b6Tqf-MLvtbnlf_wk-7z3paOzT_eDwxdIFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpGbZbQSnJSixYrFgIOa3aaPXogMUbEG6UyxAwTAgZzw&oe=6ACE3ACD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
1y9mBMQ7kNvwHNLXMg&_nc_oc=AdrJRl8sJTgLCCxaADrEP5__NdlbeER4fwhdm__CWMNzwmz8rxq-fQVxM8uOpXuL1-A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lpwHyzld71CvAy6utCESCSauoRx7wjKIa9bRXqTHfBQ&oe=69EF75C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-vDWbyMkqcQ7kNvwFb5MWK&_nc_oc=Adp3NVYMohQg830GwnGtXoCRcs7f5GadLDJfmmNG0K5IUhRdX10_dnNtrb4zDpSwl9k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CsLrFcN872AWcoDTOAos9g5JZ-m9zQf77NIoiBQPjvA&oe=69EF57F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8-CnclMcV4Q7kNvwHVwjct&_nc_oc=AdoFkIuNtqewHxnZi1wsAREh6ocr_NkXZxz5D-7b1evK-tHrTStjDcKO0qDrUjYcsrk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E8pgCmfMpE8bWQxYaG4NhGsbvNYSrv30Y1cWKPXUg6g&oe=69EF620C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phZpO0wU5agQ7kNvwFQERhx&_nc_oc=AdpQtmwi_fwFDRnOYgsSyPvoM-coj6wwCZR4vDYntoyESBFM1nHjerlS4ejDDw1g8bM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ECIqzNS4BLOvNXCpNnA7VKzwMZIAceIhEUdjAoTyy-A&oe=69EF567B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHUnZ85O5EQ7kNvwH1JrtG&_nc_oc=Adp1PNq-gy1crftT760Cu7_1wDUhuDd2lXsvlWTSLHn-OM5MFzSQJnyGZzzizrzmMeI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Vue9OjJzM3VD-n6bivQgF8zPqgOe7XP95MK26wzbQKg&oe=69EF6D4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
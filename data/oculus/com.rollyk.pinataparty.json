fzQfCYQ7kNvwHuv33g&_nc_oc=Adrvg_Cez4NAuSfoOIpT3GT3ZPjwyeDauJq5UDpXWDJT5RzE0DqjL-TWXgZwu7YeXJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK6c0q9xiw0p50vIMyMXw1-BRU42B-y2PVGIYMJhRAwg&oe=6AB293C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9UG2C0KfScQ7kNvwEGtp4u&_nc_oc=Adr2mZ13TKfnZ6f00HxEGeLIjiKjwwVRezEsuQbqg9jItTZ79y5Cw8bPQQ1EFdV8exo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItl3DLqiAPQZPxEs17b3KhaHrzn1iXiUcze6mvuCy66g&oe=6AB275F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCZYRm1lDaIQ7kNvwGSkpWi&_nc_oc=AdpzAvDBYnMp_Xncai8YWnkslnV5YsSt39u_lkM_nD0pK25jsMil60r6JXVmohiI6rI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh_aC94Earu7q-0cd22EV-GzPigwYeZwiCeZ8yZ77OaA&oe=6AB2800C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xZWRVjlBHQQ7kNvwHh2ges&_nc_oc=AdobkaN7S3g6NPvvwfer5WgelLPTl1aEDh51PPqPls_Cm3GQtIvhw-9mAfcgf5dwPdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWGb_W7sVsD6JvQ6KcRCfOIQ6d6SNzpskJOHwK2GDe3g&oe=6AB2747B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8AOpKmS2BcQ7kNvwHosM6F&_nc_oc=AdoC8AIk6bsYWK22WWmeEw5bdt2hEUP5J0Sx7xiHv3aYWbgMLgo0AoO2VtHgQ27Y5qg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItWkmG7tEuTU8xpYEVo4OB00x9c375alIraZ6m7EFrrQ&oe=6AB28B4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
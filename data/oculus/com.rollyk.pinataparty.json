vAfae8Q7kNvwErwpwm&_nc_oc=AdrDTox7pOy4FPIyFKprmv5JXzGh0_wfi9bejI4pF7gcZQ5BHrmisnwjtn_UlDQvLyA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L7WXwN3CvDvWsiqgzhrNBnewhKOMx9u9lNY7pfcAsNQ&oe=6A1C48C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLnCdDSCNBIQ7kNvwFEMOOt&_nc_oc=AdpTlE2hN8i0hFF25drm6xxD_MsuquJgJM3QFoQU6HlwOfCUz-na8OFQjc8UGQ4N1D0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xDr-P6I_MJoXHPnLBM44T2s8Pt_xHgzm3C9ow1Neg0A&oe=6A1C6339"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAfuA7gSZyIQ7kNvwHCjUOc&_nc_oc=Ado0TCYVehWI8jBTf_xdv0PuK_exPNLvgdYNB6Ww8eXAHHADya30ntnRNX2yTZ_cxMY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l92K9m1e6sOD41j7bw0jgn6ipSvWc8tt1ES_3fZDgWQ&oe=6A1C350C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3u636WNXMwoQ7kNvwFuLasI&_nc_oc=Adr8sHYpa4viuIBODZwQ-1RPuc52kBh8PdfsTdoAH5j9xh7lTHY7SbKlGHGbtGxixaY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RmoERYhlnIcVY9QPP2TE3dw8AkfLxA6vlZqzkwh7VqQ&oe=6A1C61BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4s1O31Gf9gQ7kNvwHSlzdZ&_nc_oc=AdqQjr6mxv9QP7FzrSkkE8W0iMi8_t0U3xuMAf8iropsBTYF1luLU_XauuCLw8C8MF0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FNabomkobCTd1faQHXMxt_iL5UwhtUHzCi_i2YNDd_w&oe=6A1C404D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
uM2Su4Q7kNvwFqOXud&_nc_oc=AdoBaC7V2ytjmHEAkmEzoguNEzV9l_4yi662yPVGmbVSNs0qSpuD2_NGJrpDn7PisXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WIh9jfS0Oqk4YHu5wMR0Zme8_0tZBWul1Ezr6PqGNnw&oe=6A033C41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2rMchtRnPMQ7kNvwGoL0kh&_nc_oc=Adoy9bLwUO43un1kG_3jz_k16xEA9dGgLTxUZ4GuCO0gLWwVGJzwmoHhLUSUmtDsb1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PD2X_m8JyGcSchgiRCitTE7PxbjWBi_rsw7kUNf2Slg&oe=6A031E79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6W9nvZI4U8Q7kNvwELcz39&_nc_oc=AdpWtt-jPQoPmH1jgtizL78rsm1sjTzBBj_m8sW3QftvieCkQVK89Dwm7EZGqufGxDI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Eb2p3Nl9OCfuAtKylvL-mS3DQNFsfYwdR5yBuMl2mQw&oe=6A03288C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdVVDrP_vpAQ7kNvwFSDU1u&_nc_oc=AdpuiTiGhXKLVu_qhP396ZxSSnCC1gCUcLq9vDFoKhKo9ZIqBGHwVE7i3ci9N1JOGbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BDt1iK6_zp_h-oHonfrSt0iCL_eB4fSqhRRXTrYlqgA&oe=6A031CFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfuMKcGg7UgQ7kNvwFhu_fh&_nc_oc=Adq_LDTIPqAheEjvHnhDZDtCvCXiq7sL2387MDaCU5XkD_Trsqt_4uf1XOIdrdoyaeY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63joeTQZ_wMW6PNLrPNm_1qzD5M_kyxSY2cJrXZFewuw&oe=6A0333CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
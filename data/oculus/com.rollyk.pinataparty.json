q-pouwQ7kNvwEMgnIB&_nc_oc=AdpqZ1hYkGSgkKrMCubsRJaPyG6XFHrOReFvRYYBQsMaeSC4MvyvVi-Pm5aQxLXuOA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn3AD_Et-solc-PlWZZXjTuYQ5S18HZ9JiefsXXSqW-Q&oe=6ABA7CC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvMjfn359FkQ7kNvwFWEEEF&_nc_oc=AdqKU8yv0U6NQfBm1_dduuawxbl8Ei3Z_RjwtK6xW4djmBYxs2ONDe430CHDS1qOKYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL86EoNTs8gvY3EiDVghuW33jh9emH0q6QFdwa6-bD5mg&oe=6ABA5EF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV7Hqyy2likQ7kNvwHvK6GO&_nc_oc=Adp7GyUPIHUztJMww4DWePoyj0ofPMvQldQtb1vKR_Qvq9TxZeRRwGrDKOaKzFGFPEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIout1tNMGwGk9VpTKqEkB1aEWL45-DNK50M1cFg9KU4g&oe=6ABA690C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq8K28XYshkQ7kNvwE2t-ji&_nc_oc=Adpqlkzk-rEAzY_MWoSh_sOrTdSzh1esItUHTGYuo8ihvlHeezk1Nj7UF_dopQypEm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuEjmUW0UJkX9vOtKpzrkRxN5J5LplR2O6miR7YRpW6g&oe=6ABA5D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dyH8978vTUQ7kNvwF8LgVG&_nc_oc=Adp-Omm0a5Yv4uTlkNeG8LZhkKZA-na5-Q20f34iUybAwOsv1maiOxp8zpozv0wsk88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLaen22Gn8S-62d2Rx4NByDqvpt4Lh_YjWQzDpu_OLSw&oe=6ABA744D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
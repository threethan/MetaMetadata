hvpZG4Q7kNvwEW62jA&_nc_oc=AdpZFl6YqqwUa2v6Qwg016fQ32Skcvwj2HH6HWo_Xl0q9y6LhGMp9NH4ZHcXzukkn38&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UY0w8FwvY3DkKbyX0GBl6gk5YnZwTPvl9eZU3UeotIA&oe=6A15B141"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKCc3KvqhKsQ7kNvwEqEv4d&_nc_oc=AdoNC2lKiY5UQXCnpp1C_nzvAz6uOBMYWOgDSL2gaOSViLioGKMTIksJlhoZvFtiaEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kFOTaQUQVJtWUtKTDBX-HErcdjhKj2jYlEmjAj2tu8g&oe=6A159379"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czp7mfwKc7kQ7kNvwHwhR92&_nc_oc=AdoTRduhnueg8I-M1AoESdIVpAFeVpHPIFeu3VuSYbn7N6wAoBcloC4nAG4nPNDSd-A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m5-86B73Xsp1qvh4Ym9OXZtNJZG_JcoP_4GSkPapWug&oe=6A159D8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS_byFSGb20Q7kNvwEjhDZD&_nc_oc=AdqSjpumJ9-7u1WtHPoXGwCqlTn1wwd_jDaZH0jMm9a-e3gxOIjq9_8Q4GwtF0d9YWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tWk6x35y4PM8x2AM4lofGSDrDANFxkTZPG8nv6Ukzyw&oe=6A1591FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os4QL3Vh_HsQ7kNvwEOn3vf&_nc_oc=AdqPhz6Hni_0COUEpJANp6WPCEx86tCR-obyM-h21gZodRpAgvbEdiUsQeAzIONsUR8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W0KydxeSz0-msJbp-565tW-0K_rkoeGJvWR44nO3IpQ&oe=6A15A8CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
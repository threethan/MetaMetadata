sV7_SEQ7kNvwHJiqBh&_nc_oc=AdrkgoFwqoHUOyNdDdYKxOYKrKAIY4QcWgQ_H_61ATtFkBmqoeZQxwduhcBmKm80xgI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvioNcw6YVmAB9ViMhl8azm9suear00c1I0NFvp0eUxA&oe=69CBDD41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH1jWbknfL0Q7kNvwErGO--&_nc_oc=AdpnF6WqxAdyrIowA6H6Csq_yv3-2ez6xcr_i04Rd-zevIfMOaZy8r3AiJUg5G0W3QI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBg-0bqZZ3B-SUOcuDWCDLC7jaX8yLjyEGbqWC91O0NA&oe=69CBBF79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3lxYK_W-LUQ7kNvwHkEtr9&_nc_oc=AdoD2XuGe3_5k7XeoplbuLet89BjHup6xDEwH0yoZ-D8Dmg2XQXn41L4AwRCyVnXzJY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznE1BcOkXyuRKq0Qa4HX3lrg0ep4olUxNkycOo3BoKeQ&oe=69CBC98C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mYA2gHe4A0Q7kNvwGm-Bhq&_nc_oc=AdqJ68oqPJ2KLoQQ6UajFhVmAd8bbdLTBn0VCYW5Xjxzt8tkZawbXt9qOeYqhI-9KkY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-x-586vts0IAwPDQjHWK3qmAulNwYyk_3jlXtfW9AJQ&oe=69CBBDFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tehLS3cBL9sQ7kNvwE6673f&_nc_oc=AdofA-6j3LjRFawdWP5u8RVF2cWG2MNyNq7WIH6YNKr5UO6egEMlDjOQXZyueinr0AQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWAKUjMPoYnsWfdJ-3eeaK5QDZvvi2INUof2k6eDAbcA&oe=69CBD4CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
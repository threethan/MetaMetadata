bhLsowQ7kNvwESn3hf&_nc_oc=Ado6V39JeOAjTTmhcr9VwQXQyKHnJxPWZAyeOAss44VaB4SK7j-P8WWctyXAHwi1mWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsWShaRqrMdJpc8ZiLqpV9AxgFgEJ-Ka3v7sT3lVv--Q&oe=6AEB4441"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avFi_lSE7lkQ7kNvwGg7swt&_nc_oc=AdrOIVjHNbWya2Nmqw3fYKhbsKUNYd5EgRD6-0K-6kXgQ42Eqdx9NMMke59y4nGKP2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbAnCAIbXoRQ8n3o-zypAxtNPqMjik7KhW2IY972oQHA&oe=6AEB5EB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ucz5z-PMlYsQ7kNvwGlY-ZT&_nc_oc=Adr3-TuCS78EHNHi-67OUnHsRB-0shrfkBDDcgeAA2pAnZX0OimVBumXBS0VGpPWpMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDD3OYKz66M3dy7UTreDz17o8DQgPEGrUapKHGDlD4Cw&oe=6AEB308C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0aZ_LbV4OoQ7kNvwE0_pPY&_nc_oc=Adoc3HjnJqVHSOeo3W8r3OdP4C0eqPh80mVmLpoDgwaxHCVZYzf6sFSneSZm96FrL_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkLYy0W_-5LQIudhLYcVDoG8cMfHigerOVOg_rrQJZDQ&oe=6AEB5D3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0UYT_Ecny4Q7kNvwFxDTh3&_nc_oc=AdqKJkKO5IuaU1-yuH0Qb2dz6YvQPb9UoJF1zuoFULcqRkIOSCllbZHvO-q7m9yZzHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyFIo1W_lM-7LAgBoVBe8MZoBSoijcdMDSbNnxQEkbgA&oe=6AEB3BCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
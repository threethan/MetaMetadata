-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-pD8LguNl8Q7kNvwEZ5ULH&_nc_oc=AdkNhHQzuscfAo_ctjgekmgG0yTFoH5IAl3Qo616VBRaRx6kMQuE2G5SrUpryeMMJUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzYuSNItz0d-6oBRSKBwUXXqv1LGJ1N_lMKYBnNUQZmg&oe=69B16B8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7IdC3Jv-1MQ7kNvwHumFxs&_nc_oc=AdlslVbXjPY1nJBec3u0YofTCDejhhCFdH_NMdwfzTkdJZ-jtiXBUjqOKwhcfrKbyVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZiObqygRQ77o6AhCTKDA5SU-kGIHh-dd9cgUy3P2eag&oe=69B15FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs8SrzyI07cQ7kNvwHjiQAj&_nc_oc=AdnPIfiHP3UMGtnozwXRfqkpUzGoYIXHNef8PMf-Nhyk5tGAax1DiRUOdBbd_RG7C0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrNGK6wKsVhJLo8ZKIHs3NK697xKFH74PHnTuLOfB1aw&oe=69B176CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
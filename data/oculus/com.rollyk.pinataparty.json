xg3XgoQ7kNvwEyWBoj&_nc_oc=AdouAFRUd_U_2wwgnCAUolQOcTxTQkhLaAuUFjh491LYBUSHh2YTb3bqZ7re0FYjzlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-FryS5a8tB6kKu04SDJC908WxpvFNgj41e_z-JJY8bA&oe=6A185441"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4tWPdAuMfYQ7kNvwFhOtz_&_nc_oc=AdpP-Avrkc0xPal3ye0ne3PH-xpL2mruHY3U1E7LnKi_gQQsxeaBI8Yra5ZwNPhzMog&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VCFUkn8tRqrnzW4umdXBUMltMm-D33_H0FxtZhyfetQ&oe=6A183679"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czp7mfwKc7kQ7kNvwEwN5Po&_nc_oc=AdpmEQVAVEtB5PXrtWF8rnvTw7ARyjK9zOh77xCjBgmyaTrX_8TxL7eOIjDAIDqSc3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J9pDjPnevXGlQJ49V8cOop0tuFm0_fNJLeuIHz68Xzw&oe=6A18408C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv6kbfOv1HwQ7kNvwFh0SL7&_nc_oc=AdrUHbbkPIsvJ2cz969U4rHAPBa3pr9HUw8D33Bu1gFSomJ87-EDsNRHEIFAMXJrSYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tGSeiQaKJQGz6Ud9Gzqez-eanpH7xZwUbtyQhhdxNSA&oe=6A1834FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os4QL3Vh_HsQ7kNvwG6d9kp&_nc_oc=AdqrToqBVsvlTizMzgAk13Y1JQZ1Yjo4QDxOcR__yio2W0--jcnqz1CRqUlVX1B26kQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JvWrWs40XJmrNCGUbdbWd4dq4HgAI4yqjAnWrzriLoQ&oe=6A184BCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
8mchPYQ7kNvwERVNK1&_nc_oc=Adr0SG1AbMzWLoRHjHlJNw5StEHxwh650YQSSG7EeObZN3sZx4GJe-SvWWBGKcF3Zn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sUiAbCOohXOre4-iAAh0v292WCkfvKSBXg0-4ZOKkug&oe=69D3C641"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzFcEazQeIwQ7kNvwEcSHJe&_nc_oc=AdoP7cQEc2wqp52A_fLZo7AWJbtp9QwKx6nqGEkOX_VX_WtvNEmEyb87oU1ajKBfKmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20k-hvPEf9Lrthhhxa7XKq2RHVEGDCx5aoYX3vt4xJEw&oe=69D3A879"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppGTEGqFN_gQ7kNvwEJ9VqT&_nc_oc=AdrjqTi9OY9AAxIiSVM7490NRftiRag5Kb9HSb6yMRyw63iblrnOomAweZGAv87S10w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af106R77qr1Li7PxWG4p6tl9dJMewAMP62iFur830lnkEA&oe=69D3B28C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNRviIHSW9AQ7kNvwH6ud_B&_nc_oc=AdrNPxJ-ec2tc_75v0Zl9Za_TRsS9tF6vCRWiFxclGh2hnrN4B1nfpkDvXUDJ5M8QVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G2JwFK9L6GME--nG7w28G2Fhkc6xEbI3eKn9xEh_THQ&oe=69D3A6FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irEzzLw9Cd0Q7kNvwGQGTqq&_nc_oc=AdoYwQ9W0Yp8BZ7_OfTurykCu46uRJvxcqnMYMaptirfP_zC9oyxXM5JWVzUUc4v1A8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aTeZpU_2ex5ScmXo9XQZ3BgpwddqEomA_lYqr3KAinQ&oe=69D3BDCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
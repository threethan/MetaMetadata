igg9NgQ7kNvwGbi2Zy&_nc_oc=Adpwp-0J0GfYj06lXRCiqY7fG-CsULzIimWpEHQ_2Oo4KuzC0kne-ZeHg3FOjH94v_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7I8oi4FAPYi4WZqzCP3TMu9z9MquN0hsw7pdCCC_-mg&oe=6A9C2A41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q91MK1I-7K0Q7kNvwHT9eh4&_nc_oc=AdoqsIs701_ZHCB7jVFI0cCjJ-Bsox-kpBDCzdiWDf3G2VGxuBm04EIjy9wpEw_adX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR8L55tZlCK3rEm8XJcQkewaQxXSjMmDwwer6LBJgwmA&oe=6A9C0C79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JO3I-Xg6NsQ7kNvwGHR7rI&_nc_oc=Ado6KgIeRR8MH08XSSBX_TSdiPkMuRIfisy2qBwxNn1p9DKwcRKTLRy2GWsxxBwomrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPU6zCs__hI21i9Ny9hbF80Md1g_HdSnsA-Wt7Icy9tQ&oe=6A9C168C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIIiwUqQhL8Q7kNvwGDA36a&_nc_oc=AdpXgX9jYC2oeIoyxEZ58FeRD-JLqLlVC5YR7kU6BkBCtUKcWdpKMJvUk8jFgFe9lnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlFV-mM4DhTyRRqSuIHfBUPjZcqkp20wA_hrGtbMBWPQ&oe=6A9C0AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNeiopUfznAQ7kNvwGo8tIH&_nc_oc=AdpSrxMJfz8fxRYRif5hWoa2njftWUpc5932k4duwkigj7ISD2GeIfmatfj3GfPfg3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtsGLr6_STbC3kOSasaj_E_Z4zq_q4MLc1t3mLtLmtzw&oe=6A9C21CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
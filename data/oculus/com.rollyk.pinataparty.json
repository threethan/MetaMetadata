zUdWJQQ7kNvwFSUCD7&_nc_oc=AdoSvU3prpBSj1t5ukBZHqZRafPY9JLZkUpIBMPJ7bcPI4rrLXsWOomqXxcBOCYRSxg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7jmZU39qc2PemvljJaJNAeYm6hLs_mVePzj1aRLX2hQ&oe=6A43D5C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEsos9GDclIQ7kNvwFDtyXq&_nc_oc=AdoLDvGKH5yshS82z08FeGlJU2QsDpMwDveVsKCXP2wpvErDeGFaUNlsSzRTnhw3m7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WQAuBsGRfUavKKGzf5oVlgoBPUvs5IVQsVcGcWxIFCQ&oe=6A43B7F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjfPHOoh2DYQ7kNvwEsZrex&_nc_oc=Adpt4aPkuVVR-XoqeFcE0WHjg4MYEC0Y-1la4Dq2yNl6Gb2Dgwgv-CbFnk006LFjyNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8huA1FToRa-asYBVojHcvWHcOj7u7XZGWhZt7ZaYSbgg&oe=6A43C20C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rswDVpP9T9cQ7kNvwH9Ojdd&_nc_oc=Adoz3ysmn3Z1ZMQXvlEAiVwbSJkkZ9l2pYQO65u-hCd4phMnjDAV97AZTmQeW2lOym4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jsFip15rZrmYSVwJQIBET3BRnwgpt9i8PgWgdyA1bjQ&oe=6A43EEBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WYUyb99vGsQ7kNvwGvHaBp&_nc_oc=Adqhm_fj75NpXGgHGF-aARNEr5Njar-TyyzE4HvyswwNZEwXGVCcs-uxjvjRBKztFZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82BqG8VOv6O3LKHvx5NfnKLxTCPHe2Wvn4el1Iz1DCuw&oe=6A43CD4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
-iad3-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPk2yYPjmYIQ7kNvwHHgJC6&_nc_oc=AdkfUlsdOiowEIEXlTucWnbJ8ZmgTyS4IE-2vD71-tWvsKNETSnZQPki9wQwh740EGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxY3TVlfoDbgqhYuPCUa0TIOycSY6zlLUsrb83JZBuEHg&oe=69B5600C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xShQa6bWIPQQ7kNvwHBNyg7&_nc_oc=Adm5ECXmldXn8cpQ4V_NudPmMn4Bp0dV3Ve-ec4OsF4fyULQRmuxEQucAQgyC3hyX4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwttWuJ_kheMG7_ErN0NSSw-1D_-yrdylRr-kEAx8BKg&oe=69B5547B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9hShivl-f0Q7kNvwFxId8E&_nc_oc=AdkH60IYOG9p-xK5MvuKI3S-h1hUnNbpAiU4_VSHugAzSKcQ97xvyj4YzLsDiUXMeIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy05BzMcCk3MNfpTqaxx_B5ZRA0t2H2_IOTHQiWw4K2uA&oe=69B56B4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
gLzDArKpQWBYhsi95mAvpR3SSn3Ue4Vtq_babaeJWOVNdIbZYjxI6yDUWGiuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjLKrAhdg2OEbB0dtwn54_35i3flXW7BRMt_fUNagK0g&oe=69B53B81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHuTOPXXz00Q7kNvwEP2ifF&_nc_oc=AdmkHGLTaineRN6RohgYVi1iJBfMUvibBt5lpiRNp1cDdauDDuLkiirj1EExTp2an2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyL2KVZWp9PXa41UAFJ9dsbsFotuK1uhzQaqzSxZrk9AQ&oe=69B555F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPk2yYPjmYIQ7kNvwHHgJC6&_nc_oc=AdkfUlsdOiowEIEXlTucWnbJ8ZmgTyS4IE-2vD71-tWvsKNETSnZQPki9wQwh740EGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxY3TVlfoDbgqhYuPCUa0TIOycSY6zlLUsrb83JZBuEHg&oe=69B5600C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xShQa6bWIPQQ7kNvwHBNyg7&_nc_oc=Adm5ECXmldXn8cpQ4V_NudPmMn4Bp0dV3Ve-ec4OsF4fyULQRmuxEQucAQgyC3hyX4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwttWuJ_kheMG7_ErN0NSSw-1D_-yrdylRr-kEAx8BKg&oe=69B5547B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9hShivl-f0Q7kNvwFxId8E&_nc_oc=AdkH60IYOG9p-xK5MvuKI3S-h1hUnNbpAiU4_VSHugAzSKcQ97xvyj4YzLsDiUXMeIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy05BzMcCk3MNfpTqaxx_B5ZRA0t2H2_IOTHQiWw4K2uA&oe=69B56B4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
_ohc=6UmbTzUdWJQQ7kNvwEhj6sp&_nc_oc=AdqB9yopK6fHour6Rn0l2fxnTdfKNprTlA5Tx3El6cWpCdqn1-SOT9FZUuX4JEasR34&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oL1LFdM0PSD1lhO3mr865OPdkI8J9WhADkDoS7KQYsg&oe=6A4678C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEsos9GDclIQ7kNvwEQL9zd&_nc_oc=AdriA7lisxaqteujZJJfGch9al6oJjyNPZA-D-3xbCH7RcQPzR0zEabDFfQCeZ9qgLs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q4gJKglUfAypewz9IDCB82VzbYSD7Ey8x8ZLxNKFw-g&oe=6A465AF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQOwOf3RaQ8Q7kNvwF3oFKo&_nc_oc=AdrucXNXDVsgoQm_zvsXOyJiNU2dRLnqNybZOv4wJeviWxNxx3Agz4qaHAs-G2fkEGg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Whw9OoezSxBoLS20MHVuMCL7VmC3F2oemaV5cqoBfg&oe=6A46650C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rswDVpP9T9cQ7kNvwEGeZRP&_nc_oc=AdpDlGa7bbuTPIuMYdj3QaJK9mP3rvv7L8F6IqCsmymsgj_YvLax4QZnPGnkA95X-LQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CCNVVqUP2anP7ztWgfMld6GZtmnYsdM8rbQjJcw9lOg&oe=6A46597B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JbCHjlm2rsQ7kNvwGu_0tX&_nc_oc=Adp9JG2gWICqL4tLFHcUBvJr7MV17uxMlpQZt9xPHCxPCtL5CosWb_mjGjEO-g_xNmE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NmqSkHvIBjEb8sC4QQ-uNqqtTapJWQFRMiewTNJGElQ&oe=6A46704D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"
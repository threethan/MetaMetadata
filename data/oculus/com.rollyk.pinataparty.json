-dfw6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PH_tAYx8UAQ7kNvwGXuEh7&_nc_oc=AdnkLLI1bP5pQw10h9Xjd2ePIIBZC0jxLRpem_PRJiFidHpj1-c7nDZ3rCjsxcbEEvQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhxbaaMHfOTjUWazjRJ69MytuN-6JzEzKw42FYlsFgqg&oe=69BD490C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dkq24tU-nAMQ7kNvwGoGpAT&_nc_oc=Adlj83YqgIenCSvDSreFCBpffaBki5FdMxBWKKqew2F-uMbT_2sFy9ZaGMC3ZSyxQPo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhZuXqCm7XToG0V0_PIIbDsSe2ethsc-4z_Gs4YztX7Q&oe=69BD3D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slWsNpTry7gQ7kNvwESoTAb&_nc_oc=AdnJq5WHqSOP4HWw8mAVWEOeYkeE3UXibv_iysr7WYvYeDJjgSA-Ndl1gFduffp0AgQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCzBNACtzCJdOdgwKCnrwyKaXVRkr3EPIo9s4BF70GAQ&oe=69BD544D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with 
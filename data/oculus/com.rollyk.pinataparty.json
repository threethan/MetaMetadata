5PSDONlQ0XQse28dJ0f7TIVT4TjnqbpLnxm78F9ShjN5VFBszhXe_U9uoZG2M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjT8MBF8GRf_-NmCO03rny08v1W7bugkP66ljXUkGGyQ&oe=69B7DE81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHuTOPXXz00Q7kNvwFtcrOg&_nc_oc=Adm0R_evWL5pq5TiLnAiitwalGqiCV5Q_aK8RjbVbG7GkNzKe2XL9mSvlUCXr7PX9WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxj9giWhYgMoSMDmkglh-UdUffINlRTq0sLV-cPQhm3NQ&oe=69B7F8F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-4YqsDiJoIQ7kNvwHz5rIC&_nc_oc=Adnrk-P55HeIaTOtRer9WK4_ZOqKqe230mFfCB-LQC6NB8mBSaOH_cO3NFyQGRdY9l8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycjkKScxYcoLtzXPe6rUX46--JQbNA5nQY2CqQb01-_g&oe=69B8030C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xShQa6bWIPQQ7kNvwFvAv-a&_nc_oc=Admx0xEDf9nUsok9WsHwMWW3tFE200SwjgyMWSj5IBOAX74E03W2Ns_edFcFrHWbI5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx__zuVXtn2WAcrjWltlxkLzQ5OPpqsGmhTzpgMYrk57Q&oe=69B7F77B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CTvI7HFbEIQ7kNvwFw4RXS&_nc_oc=Adnp1yedHSOnqqsojihe7fu5W_D7WNWVX9DpoNU1bJkmDFW7wOeeKsrYlp6pd2OKsdw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzL51ZkJ7VKWA99CBl0amRSe8N7XnXJFAckSGEIHIxYRQ&oe=69B80E4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
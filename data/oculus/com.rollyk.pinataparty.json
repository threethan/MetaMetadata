aeuT_oQ7kNvwGEtXTi&_nc_oc=Adq5SkN6GzLAKh8GTnyPuT8bWkS99sCZW7W28f56Zfzm4IcQYZE0QuTGQpvlnTF1keo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMs7FzvXSc85UGyHp7XZvz-rFU6fvafa14dY7-mRji8w&oe=6AD38941"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYRzlzClpx0Q7kNvwHWSmHc&_nc_oc=Adq6hhzxffpG-rcWV7QmVM0ew20jannE9WUcNOcpFtu2n4u6rKbhUTncaS-L2WjmGmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGxDTqYZdGS6uaTA5HV0yMc36SToOpat7wsK9RdeLtrw&oe=6AD3A3B9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVY3wrefDCgQ7kNvwFMw2Ou&_nc_oc=AdrY0cgBbGcHTIen9h8MBNM8ARHmG1nPR6-JXfAKgoM8ewb8qWAql-ne_qyANwkJKJQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8xCy-ydxO3itt9_kOhctgt0wZWa3d-8ObFuevRtEIRQ&oe=6AD3ADCC"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6qJc6CEr4oQ7kNvwFc4R7b&_nc_oc=AdqTWH1A-a1t99SECUci23VOl4DWeWE1Cx62jJLQgMQFtxxrZMkYcz6VvkVeDcxTXAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1s2E45JlL3uwEiyekbld83RhD7Qy1t4A6qucs9f5G9w&oe=6AD3A23B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TK2PmFpjt28Q7kNvwGS0VOU&_nc_oc=Adqqp51lgu8Z1XR3hniRkkt8iWio3Oqpm475Tx7d3dxuZgIiyd_wm_eh7C7dobRIU7s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHgD1UKAUoLc509UT4__peQlCDQIOHAimSUvNy2u28Rg&oe=6AD3B90D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
Q-Bvm4Q7kNvwGS8PVC&_nc_oc=AdoDMrg-DeFE1N_EeMFjQmQaM5656ZUfJOPLvoaVrgaBb5PGfN5s_KA0JBn3nbgm6GU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU_LV7bWxumdMpTc5skWrk54_WNWxUmxypQajWx83ubw&oe=6ABFC2C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQIQiiV8qU0Q7kNvwHBqZ9c&_nc_oc=AdrUswVfoad20Q7bVjmCCYuXYbIlWViJyr-fSBVGNRq9wxVDsRgBDa3eFNzhPWJUktM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQayC6evNtDGTclG27zsCh-Ah4w1QSih4a4bSXXab0Qg&oe=6ABFDD39"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn4XT0nGmSsQ7kNvwF0BRf8&_nc_oc=Adr-BprhnY9_I7hTRUFC4CJr4EW1DforeXINRpJOweGAsHVpriauJAXMqvoLcPgyyPc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfSdYxbbh-k0SURdTQOr9_vFNLLCI9PeKDSq5KlPJoFA&oe=6ABFAF0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8t-xRi4mhkQ7kNvwFSv5d-&_nc_oc=AdoKr89fvl86ocjrpcpz8Wd0-xv7oHa1wCJ65C9ehHomMnxCPUW-6Gyex1k1IgoMi7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC2KV_7fztaor0UxbZ11jedUJiCGFvXrckQRn33L29aA&oe=6ABFDBBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SjVUoywaNEQ7kNvwHZmJfN&_nc_oc=AdqFd0he2t43aEW4Xlu4ZFUhM_j8IggfORKlmwpkJdHbBRBbMJL_vpaDDd06PnpdkH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlb0bGGrKjSafP-ZhtdPl89e8Zm45WFiK6X6u5dtndAQ&oe=6ABFBA4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
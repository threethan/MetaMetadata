NifRiIQ7kNvwF_izJ-&_nc_oc=AdrrX8YW2QOKFNgt4NFHf1ZOsexHuhB5cwX861IngrpOAnGI7LyCYLPW0HiO0uD7Cbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10udYumSmciLX2De0L1bFRqD6ex_f8xJtq1jmExlvynQ&oe=69DBAF41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkFAzAGqtaUQ7kNvwGA6hak&_nc_oc=Adrj9s97kgtwLmgyy0JiF9SEpgi86PjpmTS49vfILWfFe3hxwMfBarhq7GOQEkd28oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SKAVbgshV0vSo4cRkSDs2Fz0HKTRduwFf2be4mhkaqA&oe=69DB9179"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elYAPyZSdPUQ7kNvwHwaLqc&_nc_oc=Adr3Td7xZtmwfgmnzoQLCdb4beBayD12CLNT1SwQtojhMpGuZLZxZ7As2_qRXjjfQrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TPDi8YEuicBgXisQVyoZT1xkjDcDnW-9NbiW9_2pOZQ&oe=69DB9B8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3K9k3zDUdsQ7kNvwH4dk_v&_nc_oc=Adr3vkiMgdUZuaMhdEQdmKCZo2jBdWpgU7Hby48QgYJ7pw0QIiK7sDw-MTkgzE6mod4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BszGawTlSYrssgr_OloBHVmMYEp5vsAh7yYQwBbxGpA&oe=69DB8FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TNcsUTBbk0Q7kNvwFD9f-H&_nc_oc=AdpdkTNrNpOmLH67rB916i86oqrxbJ_lk03_PPkm6OBAqubmyvDJy8gYwUojnPHfTcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10TiWd7TDlmsuymztHZb1l5LVkrzU85nlt6SUDYGTAdw&oe=69DBA6CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
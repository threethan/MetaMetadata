q-pouwQ7kNvwHlG5jY&_nc_oc=AdqvTFktQUdWFJt4udX-L42kwmLMykF4Oz6vYYoLN3CAbv_CGHjcPm8HJCLO73775o4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcuZezCKZcvJioFgTvXOfynbsTYouyG_FUdCcWEhok1g&oe=6ABD1FC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvMjfn359FkQ7kNvwEGy7YT&_nc_oc=AdohZVAUYDkjYpUVR0rPcXm8bsPKFjQFtvkkZ-5RAJ675Clfqhs7c3mwM1vEoNYBJuY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkz5noWQfHkwT4D0nsriPGAbS8tUMORKL7f64VMzO15g&oe=6ABD01F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AHN35UsmPUQ7kNvwGlXlcn&_nc_oc=AdqpAU0KrP7k1_51arYI9-7pwOiaDcnszrb48Kk6SVMqCMcUe8rde-Eif5XMrnimAKY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC1NufTA28HSIW85iYde3sQKWBSTNzwbII9fl5pyne3Q&oe=6ABD0C0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq8K28XYshkQ7kNvwGP12Q3&_nc_oc=AdrScPYdjbQl3bbZcK5cqzt9epAvaV7x_GMRmVUNUxjVXCZdIL2w0UUq0OQDQc-VILw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXnki3LgxXd6ZXaYYHrjOjEi3U05y_vozMTEdbC2FvBw&oe=6ABD007B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0UIyNihwBcQ7kNvwG2O8jc&_nc_oc=AdokCife5Hti8non4MOfK3UHyiMao5-dfv-EuJRV1L6YZyR0gMbVLzEkAy7oaWGZcdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT7tQGirBFJrOptTq9_0XrbMEySSYJnSV4Ic0DEjDxZA&oe=6ABD174D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
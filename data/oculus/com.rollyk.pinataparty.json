vYqVrYQ7kNvwGI-SDl&_nc_oc=AdohdDbWjtFNSG1XNRCDUpI91QaO14DwvBkdHt6wzTXmD4cDin3rzI8P7jAy3RVXUuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hkN0CcVanyTFM3zWxaYVWvEfVBoHPfeAzXA4R4i3k3A&oe=6A0730C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OTpzcWSi4oQ7kNvwFJAOja&_nc_oc=Adr6KQz0r5H177jsTtUePnQyhLPb6DW7Gfe7ZhEev_nzyiVOAspVyq0YSGXqU_8Rb1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zAS25YEV9Yjo9l2K4a-HsYc-TFnoWywBsmejEdGQGtw&oe=6A0712F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeVfknyGbJ8Q7kNvwGciiZ6&_nc_oc=Adr-_UqnYruFa0xaZfX4wIUD4eEXsQESQyoDGbmC1tUOJH7mEV9t7Wnd7gOhvqhQFtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XYSU9BR-ZwqwjuKwrvEgk01VKqFSBea_BSNIoEIhHDw&oe=6A071D0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et3nMoxsLWYQ7kNvwHglEZK&_nc_oc=AdpBwQPevM-ZODee3SxNDWbdYGyskDEfLoklt2euVpwS0uwgQaF2cAvLtTgZ20qk4FM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66HveeSUQLhXlIH6EY4kOoVDednUkMjUuMP-Dv9S-B5w&oe=6A07117B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afoRmSVpbvUQ7kNvwFg4qL8&_nc_oc=AdpLLlnIYWLo-4XLgJjdoAXNLzsmq5hG9GMEqjG_jBvUE4gXgL7bw2DDhqxi8o3tzxw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62cSvef2k-8VqXb0DLJZKGNZpQJowhXF_t0OF9MNXuLQ&oe=6A07284D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
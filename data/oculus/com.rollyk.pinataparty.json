68R6OIQ7kNvwHlk7x0&_nc_oc=Adp_JUVtgmcy2YqHgxNCsyHY9VrWwgnABU2zt0_W89B5D84eNck8z76lAKH7HQude54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBvvPdtPoYB4gD3VYgDwYKxuTuha5G5YDXkR1qli954A&oe=69CE8041"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZBdS8o3j7wQ7kNvwG_GvoV&_nc_oc=AdpcnXYxL7h2zbwCUb6H0HEbXhGdEvI8O75o7gyDovLAfRWGZ24Va7BUo3MsqZtRusQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzny30j1QrJ9OxpfLpDMgOPATu264WHxxqEfaoZICGJ3Q&oe=69CE6279"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIOCDox8-jEQ7kNvwFsSlFe&_nc_oc=AdrxlWR6Kc8K9kJTkPlvYdfua8V9w94_g5Be-NyLqaL4f3xTaODwgo2aq0wWpQTyGDw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJa2RFgH_bQnKnFoY1-YeWeU2tHmePU7USrZiHZ8RBnA&oe=69CE6C8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UHR_woA_UQQ7kNvwF5KT75&_nc_oc=AdqdDXercPL2XgIlZ0GJTBfCVL7hL1Am7BgE9fAE2L3JJJOmWda2PLTBk7BLfQ6NDUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0MIdylGz1iHZVJZc7HmQ_ilE5_LPzdyY1Wh7si-8Aqw&oe=69CE60FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lwmc8E6s30UQ7kNvwH73UNG&_nc_oc=AdrR8Qhn0OS6dep0-jIYWlDj6ouBoRyki4pcWwQ3wo8EL0tjGoDOqFW401k58SmEEKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV4gBIfq6EvPqFgHum8GumsMtVLZl9l__2XJwjioCxzg&oe=69CE77CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
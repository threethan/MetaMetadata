Ydiw3EQ7kNvwFVUy0N&_nc_oc=AdqmlEq1yTPQrQFcIByS2B0NRnATWcwJfPncrojhPqyfT2KAaC3FgxG-ElMlBp-fzgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GHy4hjfE7FCsqLEcSv4GxVLgb5lwTPuh9gyiKi01R6g&oe=69F8B041"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yycJHHRc9PgQ7kNvwFjIGNA&_nc_oc=AdpCVYrRB2gY14_OqMqRXwUl-8Uy64I13obW-szmj5shCqTiXI8F2KfDZaE8xWMPnk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3de4DotSqn6oKaNl4Wqvqdun5gPqVp450mcdcxsszCqQ&oe=69F89279"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEHcNWQkwHIQ7kNvwEoFOdH&_nc_oc=AdrPu2L_L6CppkU5Na62Qyd8CD0j72impgGPpUQtCJLWYpoZOHItgk7fBkjr0IwCvHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ztPRuH_EsXUAntgOMlZGK6O5n29D-lf2HTz6X7Ayqkg&oe=69F89C8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xv4iGgEg6LkQ7kNvwGSKbZg&_nc_oc=AdovRITy8osHBDiAcYuw5MyGv7EVzWtMzvyoaEXmd6Y4Dz5WT2msvnQPB1vg-yaKA28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-tsHEkZG2dYb0VD8HZ-7U978yoEK6fkkl8blI6S6fLA&oe=69F890FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uCowvr9B0Q7kNvwHLkNhw&_nc_oc=AdpY6SYqEodqLihbsqbIAVZmYsG34Hz6vGA2qT4OsiqrPiBE-gNkLkC99eGpB_IyhcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G-tTYZdrAsaopsCfHw9f7z4g4i3K3IxYTCRA5XkbEag&oe=69F8A7CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
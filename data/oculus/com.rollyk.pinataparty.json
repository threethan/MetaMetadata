MWNbFcQ7kNvwGd-gog&_nc_oc=AdqbaCIOE5BpWnqkl34i3QjIlcEFuu37An970WsUqTsvfRlpR74TAV_JInme2kVR_sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl2u3195yDD6311_sn1iIudA6bjuQ-WbFU9fDJYPivtQ&oe=6A79E341"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzHarCyhkSQQ7kNvwGhfTJy&_nc_oc=AdrECwYADF5X-qD9Aob-r4dq3mVgnxujUqqjq9tXVlMp2Bu87kl-rVLe4Ezs4jWbls0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZmJNys7aY5uR5zgf93m7UpgoztmSGRAdMdBiSBMVYOg&oe=6A79C579"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngI7GQYy6ZAQ7kNvwHlDSF9&_nc_oc=AdpqfjIkX6WkAyrxAEuTJuMYwEMO-rhAjNLoLGybB5CChg0dVOPjl_6sOOWFh1-TqRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ78aOmprNKbDXZmnCc2TQ33Gx892yrIVnulEZ_AtzFw&oe=6A79CF8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_dxhNkD37AQ7kNvwGkjgMY&_nc_oc=Adq992JPwzCI5HtzRWsgb5h7fsC4lyEP2tZMx5N7R1nx3zysEewz0n3W_9jQX2kgaW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoMzSy_FZcABV2Nt1VyGpIicDx-knR9-q2sV6JMBqXbg&oe=6A79C3FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_kNLNh4ENAQ7kNvwHi2Nf0&_nc_oc=Adp_iI3vpzSS45zhix7ROfW4mZbYJm_Rrk00dfSgNBl8dAPiof52QaBUYoc1OjssC1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPJf-nBINcr-NJa5vyd6dkVPNYixa_Kzcc9N7lMQW_GA&oe=6A79DACD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
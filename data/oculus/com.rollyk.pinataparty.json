f-EPA0Q7kNvwEkCwvr&_nc_oc=Adqvr42ilrGi_BrjLrAQXoYPiOTXE7K8B7Pc2EKBHL8dqq_7YwM4oPAXOOR543VZR9k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAvbNX0zycZpo7lIP1dI0GoYS7T4ed4uL937Q09h7oGA&oe=69C545C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn1TX9gIVGkQ7kNvwHqnnGZ&_nc_oc=AdqBpMhob-TqPr-IRGJ_mozfUIL7LwTn4x9TZzM1l6UsRtTxcC4cx4XkKSnHaql9vw8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrQz9fcoNGQdBLySZ7E4Bi84RLwvfSWV1kiMnMmv2gqA&oe=69C527F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2_cnXRvRlIQ7kNvwEKlQFu&_nc_oc=Adrh7gCeKPn70mUAFzY-YlQy8Xlf_l642UX51rafs7TBhMf6zNzwPEYpaTHrE_9ohxg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOaqyQlOcYJkAvgukX47lRxuYDsu8JtBfuBI9u_3rQOw&oe=69C5320C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULDNjhlmoakQ7kNvwH79lii&_nc_oc=AdpE-U-jLq3Adcw4oddjLl2fIqgnrxTZbVitZPhWHxZkXINBEKjlj4Iq6a-jSsEGOtc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLxotSrOgr2xRQlg4n5Vt75iNu6vXUMaW0JRdnsck3IA&oe=69C5267B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz2fsCU4nREQ7kNvwFpJsJQ&_nc_oc=AdpKyRZtJ8RBIY2OMMjhdS98lpBU6wZb1a8cOo5XKZBocqtq6cl6pjOY_aOYOhrCXXM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYc7WdAT82-bSIZU2deELkDE_zZysdh0Sw8B6U3toxfg&oe=69C53D4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
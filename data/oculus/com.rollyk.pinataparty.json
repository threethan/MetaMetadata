jSTnfDPk1U7tfl8GH7DTGmsfvwpSfP3GWlsWb7jtsU2nZHmoVwI-TVLDl45rU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfueKu9h6sC1ESF9YUEOsi8pch9WeF85YbGksBG4XMCsuQ&oe=69A80C81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKq9hVwcZN4Q7kNvwFuNBM1&_nc_oc=Adkyh35G7pfjceRGrj0dWKTnjFbvtREXVeFoFQvoCHNlMfH_ecoKXn5eFB8OkLsYKME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv4mifEG_A9z4RQdD5RMp0rN-WdAa301GYg_88va1Kc3A&oe=69A826F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AelDeyYq2usQ7kNvwGDWTu-&_nc_oc=AdmcK1ZbMtCqdAxKXGCx3UrI_sS-lenfKTDDlfGbhPRpDp-dKG8VXD_P_240hYcHlMw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvrQSgEcIvucPEAZeLh6NtGltqWrY-5kY-2fjEm53R7dg&oe=69A8310C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KefngKrLJAQ7kNvwEa4MfP&_nc_oc=AdloIwPIYmtN-Uizl9PY8ahFsCIZ0uWDqtA_e9lzNd0i_nXnTwCD-mxQsGa8w_S00gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsNVAEOnKFHHPIRLxhJ_B1QdEMDIBjyHRsqhXjWTeL7cA&oe=69A8257B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dSaHtr3-8MQ7kNvwEScGbX&_nc_oc=Adm1k2knCZ54f7jMPxpg_Ysnl1Sy7qjM2IYwyRYdFenlftYV1LesmPK1REQM9ePha3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHthYO7pWJ6T5sgsf1clAUMTAn_FLD9f_w3MKJc6Euhw&oe=69A83C4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
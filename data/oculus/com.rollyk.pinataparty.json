-u3wvEQ7kNvwGK2_BG&_nc_oc=AdrV_QJn7xLBokr4fJ-rFQrbdppLauVhHnMOYQSWtCG3LpxC02qN3CWyepQMH2oSZXQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q4jeNSXjOfzuwYlQ1chLq0VjZLyhLuw7N7-Rv6zaj2A&oe=6A300F41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibLyZp3nqEQQ7kNvwGwTq34&_nc_oc=AdpXR-Kg7FIBNPUqVZN1baUcgNxMCuf_Yg4q7bA6s6qugOQu4nlGF0XYUJ0fpbO5MUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xeZ4KhBf9PZJVIHxaWhrwJO1O7KYpRMFINcppj0jbgA&oe=6A2FF179"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6bXonrLHdoQ7kNvwFyYZyG&_nc_oc=AdqRIlyYZMi2274bir0RDFypd_Ct24TutLKuUGxQVfTqgz0EMBHscMjSFg7pNcafqPw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IvFa4zy6hMAAutnAzjKHlyrxCYS5JK3nU-xkhqcLRlA&oe=6A2FFB8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwK_770mMOsQ7kNvwG6Ifi-&_nc_oc=Adpr7dzCBJkwaJ0VohuY9dEHcwHaHkOFjVQ2Yzbu7qMVC1qesU5Cp3qwFbEPhLMai7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bYjdbVktwX0ZwQYivZco3S7ETQqFlA_bWrnmLfhsbfA&oe=6A2FEFFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx2QKNE68xcQ7kNvwE1WTSu&_nc_oc=Adp6QxFXz25GnoafkPagcGrN7ys0syBf-FyRGkf8NpmQ8FeAVbyOoAjtjCQ6W62KhFI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C-IciMMukXialr-OccwFqa-RbXbUj1dJW0A6PJ2AHlg&oe=6A3006CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
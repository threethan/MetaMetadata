sV7_SEQ7kNvwE1-ehq&_nc_oc=AdrAW8hHp12ikyvUDf8M-OG35kZPS_2EF5SGO1ntXYv9BAfqg72YuW6hfZNwZ0F03nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8wANrW5EqV7E4M-U4OnBCBL6xmo7A3zhO90i-6Bh4fg&oe=69C93A41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH1jWbknfL0Q7kNvwHRewB_&_nc_oc=AdqSudOvVUiXfKh6ZLsqD0xxf7b-ZiJGRUAmO0_kpnQGRlBZPdJwNBKbK9Gf8QC9O7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5DvdA4wsBnt5J7dgqVQjBw6fhik6B69ny-scdASi3Cg&oe=69C91C79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk1_IiF4FRgQ7kNvwGl9ZD0&_nc_oc=Adqt7FI3o3nex8EG1xQUwLsm4Jc1vDjtMu09Fx8C5KuNfgpCvYmchugr6AS63rFntMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyx0qFAxZyX87KfOn2zcD51mJpYcQuBsl_ZMBFFYb5X8g&oe=69C9268C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mYA2gHe4A0Q7kNvwHTNNie&_nc_oc=Adpj35ai-gyWMR77xS-P1Ii4E-PDc_14xHKziOp8UvfThL0nMl8m_0f9WEq_IzRV_tU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afylgs7fkVY-4AB6adk90Ur16pWWlpRfCB8I_CS0oHu_KQ&oe=69C91AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMivKoNLPGcQ7kNvwFazrOg&_nc_oc=Adp29KCcOP1AaZk7dXQzceYe8NF55QPLsEPf65Fa_0slVMByxX05ieM8H0dDUhWdQAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXZUlm_yjdNssF_BDCGIcbVMp2Q7l0shEjqLAeRnIFUg&oe=69C931CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
w7yhnwQ7kNvwF0SVmV&_nc_oc=AdpNeflfMIOtq1mR9xuXOOFZPNRvh7guEVfAfi397nR3eB6pxCnzpuFmQW7hProAIf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt4ujQG5Y-x6Wa6wLWXT04xaI6-_dpgwR5nM4snkoAtw&oe=6A6CB441"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JmQekiYZJ4Q7kNvwFx0RhM&_nc_oc=AdqxUfVjb1w5QAZS15f4GGDcXPSiO3-9GdAZpfv5NUKiU3TO_DAmXlxRh3-nlJuYy0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtqDl-c_KZfS-Xi9SRV1YJfZjZWEWXslJPihqZ-TMPNA&oe=6A6C9679"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ4e9sELrXUQ7kNvwEKiUbU&_nc_oc=AdqR7TCVvgClQhQq6iIN8C57PEPGIBoph5lrv34f2ABW98iKpxzkGL7Qy0DFwYF8XlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8m4DQig8heXANJ50rXtLrV1lVkXuis5lG3Ouy3RL_dg&oe=6A6CA08C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKgMJMahWe0Q7kNvwFAsI81&_nc_oc=AdpKnAtTi1mZeFXUwlQliiaKvNfrqlN0f-GR98vvRNuodCDOfpirxg7Ypd4afO8i7aM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnl5G35w2dvP46-MUXikzANk9b4ZaJmDmHMkhQbUW1JQ&oe=6A6C94FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqhU5ufL2pMQ7kNvwFJW746&_nc_oc=AdqqOkfzbd-_czxvfvpKjnWk4n0zSFQGy51CBTAK1AVJ5pFaV-Dmf2EDVDnTjII3TYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClhC44XyElAiwJPGkNKdjrrQ6ps6wgW6oqst0X31YvCw&oe=6A6CABCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
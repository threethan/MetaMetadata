JrWldsQ7kNvwHcY5ng&_nc_oc=Adp5QDINNWT06LEHS17_bkRckokG0FgD7AeERxzNJK-6dHjiuJK6VXhnfV_jF46ZqTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Si9RGAtCyap90bmDtKcLnE9V3SaWN31j39R-PFpc3Q&oe=6AE4ACC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbqdNWY2_6QQ7kNvwGFsU3e&_nc_oc=Adqi6gJtKh8arRDQuG8HF4ikV7Nha1hw2YYPDUm1hb8mXXCopwfCJGA0Cgxa6s2xLso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIms6KET7YAZUh9zpyvgvd8ygEYNUS7WlqCl9aSsMbew&oe=6AE48EF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukDI8mtgBY4Q7kNvwHuPDr4&_nc_oc=Adq9Uu4q3aTZlVw2g9jo7yjb_sM7YDRdYWqWmdwjoIVkPJcsjQpg119pcu4hMyE5ppE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS6WSWxk3LdQLX2So-ReNrYZtH4dfZ4cz3H4d7-e5qDQ&oe=6AE4990C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD7axWJDqpoQ7kNvwH9jsXa&_nc_oc=Adqh9mwpdtW88tp9vZzZerqQ05Hgu2-tntwAGjw9h-GpVy7Rt2uw9oFKN2_GK-2KrZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcj3jyeAfnVFXCRFdP80r_JvfHNzRJ9n9WZENxgTrJEg&oe=6AE48D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0QojnUK6DYQ7kNvwFakkfW&_nc_oc=AdqyuUXrqEHRMEdhcmmTBxOKRsPzH60ArdvdTCmxJSCTM0GNMktB3pVsZczKfrC7JEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMClv0c0WpP8FR4-ZV5sSBuKJNQHa4rf3QUk4M-pSOg7A&oe=6AE4A44D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
Y-iA34Q7kNvwEwQpRF&_nc_oc=AdpmkHPLfOD5yLt5knCeR1Jpbw5QxRn-tkVAwKJlWeT8L3kcWh8quEM9PLgSIJFwxqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt7PSF7Gb4cKMktxoAKjFq3HbxiE6bpIkono0nOrHMYw&oe=6A82E581"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_LIyt1LEy0Q7kNvwEQjm3K&_nc_oc=AdrblHNJXzu58TCJo_eLumagSpZQeb4g9U92FSvf9OQYYjyagiZ6-6k0MrUIzLICVvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGSv6PYDz3zNUdOtd3O0khLIQ7kwnGmBh5x_p6yOuLUQ&oe=6A82FFF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk2OFVYNdEcQ7kNvwFU1ONW&_nc_oc=AdomP3RhM6FwA5lvhJS-UomeOcn8lz6mNnAfyIOkY919qIp2zhLIwAJFssMMWqoFjSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqWHej7SE9-A3WaqXiw2Oshs2C8-Ma-a0Db8uo_1WVEg&oe=6A830A0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSYo5xYBzlwQ7kNvwGuNyo3&_nc_oc=AdriDEDqhr3452v03Pq25UxC8AfxKh09iodZOyBb1GWyFWrkaBh9vQ4keSsSf2tG34E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnoabOV0PJubtyuKrRRlm5N6Q94mVx21k7Aa668jqVMg&oe=6A82FE7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1J0vsKLvZAQ7kNvwHyXpa7&_nc_oc=AdpEQL57nWXe5aEtH6AcGW1awmhLYujQrxXhZjmymtPPufsxtfwK9_v_dp675OFtJiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgYJHxoBm57JAOYUeIUMEO3HhequsGKHbn6vsI6x1DRg&oe=6A83154D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
OBWSvkQ7kNvwFAOlxU&_nc_oc=Adpuf9NLamlLGC6tc6cExbN_ugwtAchFaITdnNpbyYYnx2uBpMKdhuxAkkXzt7AoH1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bgFXLyWgZsnfTjTDidkABe-sGkUCawZHUifn_c7HrKg&oe=6A428441"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3Y4986IY2YQ7kNvwGc9SAi&_nc_oc=AdpGgdpxvxaTHL8PR393lwgv4G46zmQpLb_Rz6Hs-zfieIh0XsGSzA8xV7bPR-DhX5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F1s_JCjJ730QlNdTWiuQnIkec7O9B7iQ4tBTTxbVi0g&oe=6A426679"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjfPHOoh2DYQ7kNvwGxVeX0&_nc_oc=AdoGKAk49Nhra10X8z-WHMWdIgVTohlf0dnHLN76Xhvz07gpp-HtqOPLDUkGSkE3SGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bZ8vPD42aG_6BW1RRbOKMj53QmiGsZ6nhNwQDcGJ36g&oe=6A42708C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTbdWTmYum8Q7kNvwGWm2Jy&_nc_oc=Adoay-l6svPnlPt2tFBRIopRAnibG7u9LJBng4oNNOdadVqhAHVo0RaGuLp4NRrvz7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hNKDTxtiqvnrEJVYS3BFidYyp480ig8tZswJeoWKJIw&oe=6A4264FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WYUyb99vGsQ7kNvwGFw_sB&_nc_oc=AdqoNuwpeND5u0ruAGaxv3zKlNkUKy_n70DDRd7SwwNjuM3NbSuaCriuGyoEz8pv3Kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z5qpAMYKVCUFxif6AWX-MeuJ8Xi4S4hsFzHD-spTPBg&oe=6A427BCD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
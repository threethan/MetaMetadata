8mchPYQ7kNvwG-hGwW&_nc_oc=AdoP9vgqf6PpKk17WKYJXpdhIaE5xYjzVvWDZ5cR9JXeyhOW8wePhP3icyfZ8WxKfnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxuxaU6jP_HJUt9L9kcHEavcBEYJwWB4uuXrsF2GCP5w&oe=69D12341"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzFcEazQeIwQ7kNvwH9dyAQ&_nc_oc=AdqTRjXIhKPR8cJoMtpc2piFMmBc2h1qjYCfKMLZVCAmasXPpTy-q4BkF7wBPB32jOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyksqEB9aEYoy25yA3dlPrKTky3Rr8krajWBuzJJHE0kw&oe=69D10579"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIOCDox8-jEQ7kNvwHMDUQk&_nc_oc=AdqjsmVBaCPm2ir111PU12I_bAvd_W0fGJg_ORuy1zVZX_H4SclBFtEfDlu0tT1AE9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnhXVhNLa5oPAqfJye-3C-27EZ18ZlNJrz7dhg7vA7Zg&oe=69D10F8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNRviIHSW9AQ7kNvwE4pnY5&_nc_oc=AdoTRBiyKHeoBdr72nhjEoSYbILTvnuQBSBu8nEv59KdIKM4iLcoq274imbpo56Rh8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIIflVBFah7a-qta7JdXLpi5GVIyT_nh_mTieera7mDw&oe=69D103FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lwmc8E6s30UQ7kNvwFbWGoN&_nc_oc=Ado1PFnePopa0urYPYPtFRVGZQJ1pOJWGvzvDfTj68eE00r1LIjJzspO7dXCsw2nOCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxnRux5zR2AoUP17GjGrCVwHF8aic7npvjI-5O4Y6QGw&oe=69D11ACD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
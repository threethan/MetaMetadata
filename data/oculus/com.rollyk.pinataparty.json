uNsVOAQ7kNvwEKlv1a&_nc_oc=AdrqapJtLd4lM4dhRtZW0VvWWN1a8X5n8leJfpxJs8A_Dyd4EqT7Kt5pPcOEBNkt3CY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-D25PU13_8fkrrNcrqpzAc9WdEXsRxeC5JotzLn4Nng&oe=6A5A3F41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntmCh2_WnKQQ7kNvwFgMk-9&_nc_oc=AdraRGEhVAUUrSf26Lb0DBPMtL99cnzaRgtT4dKttbQsG9-CIp4SxZGRE9k83giicU8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLBu89UIjzZNJfrot77nfitgjeOoJTu7-JrKuOhSVjfA&oe=6A5A2179"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PD_2bVuprEQ7kNvwE0yUgE&_nc_oc=Adoryn0W_7Y9wutv-ZrxYHZqjsLiI8Ekz0Esdu6_MzVBAoaY1YkJNfYSPK7gaiEc20I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgghCKNc5vsd5VpJb1IlfFqulHOWIkjqQvUomlZ6oc1Q&oe=6A5A2B8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFYUApuna7gQ7kNvwGEG5JZ&_nc_oc=AdqXW-O9kOKVWKuojPJDM7vHt9_t5HatL2VN1aAMGdUIIY-hVVKAwi5pvRGrsmd0OlY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM0R2dW-4XCm4WEgSh_2J8gXJ4_vT_e3uuvmwKpk2_MA&oe=6A5A1FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U-y-wejo54Q7kNvwHA1G-T&_nc_oc=Ado_7ND_GiovR6lAirEQQ3ZmMa-0S9EiHm_0IV5bGuANJ9ttEYfFTU07PMo5zTPIG2s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9byXZ6UMgSxxP-xnxjSXKWQFO5Da90RrciFDIvSlWAg&oe=6A5A36CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
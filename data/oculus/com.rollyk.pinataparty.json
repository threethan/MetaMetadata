7_3F2OCPSAJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIUuo0o2IqqSMR1HJUq_MGwITDtHsg4uF8kiQqR9XZlQ&oe=699DA50C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EEk6KOoFbcQ7kNvwHRS6Hh&_nc_oc=Adks92q-Sg-4Zotuu5kLSHa4nNIwnAZP0IVnX0MjGOkQEVIhXweEX6GVyBeR2NGyjNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlaxqBgpXx9ksCtIyjT58MIG2GOSQE3s0o995BsDl_7Q&oe=699D997B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXYIFpsR6eAQ7kNvwGMPxfQ&_nc_oc=AdktDW_qQ0NCDYjF2TUsKAfM4SZ1-3Uh66wt_N9J2GfT9fEptpbf_rBjMl5SmBzZVQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRNn_9Obh9delsFlkF_EU_7kFX05oEKJrSymzhr8qD0A&oe=699DB04D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild 
2EXtKMQ7kNvwHQu03W&_nc_oc=AdqBcpEG4KMmAXhrtCJqSmUiVnx760kOjjlqxdC1vwYK_jRa0RA-4NMSiWF2wP2miqc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kkIhjQfsSmZvSk6X2IbtUAVjUvqRW44oX7The8KxEIw&oe=69D7BAC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt655ssPIusQ7kNvwEBZghN&_nc_oc=AdpxOyks3mZe1Dcm2wSt6bbMoYHYvXYltO05dVJnF_b6iIIKbBpDJIcPofKkK_MH9SY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SntvuWP8NPLo9EHclPlqRPGrofhxJlanTVzcTHB3vlw&oe=69D79CF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7HWRiouJiMQ7kNvwFYUDzx&_nc_oc=AdrlHrg4Ht-RTFaH8FsBW8SpFrVKFGyhI_wmJMlo-bh2qRnWaplXdO1T5jlivu_lO1Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CJ_aYwwW5WspIy5TMQAwVey5ElfFBNMAuVn-Ycovrsg&oe=69D7A70C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rqtRLpVcS8Q7kNvwGVuulf&_nc_oc=Adq2WkVU9r9zdd9w9RnfrN4_v0j36mKZ8gwhfPJmA9zssSgeSDBhLF_mrvoGf8GRTJQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37Dtarh2fgVOGz4yaXKO-1QYZNx2k7nuzdFTKjy3XfEQ&oe=69D79B7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjuW86FNaYUQ7kNvwEYzqVm&_nc_oc=AdoyQ6adY4zUSUbiOIKJBaomYboAtpcK5wr5iVHBJJcobymLWQyTiemTIFKUMNXyS3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P2-bD-GNKCmPXVDXspHB-3YJQK2ztC0cEitssfo9OmA&oe=69D7B24D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
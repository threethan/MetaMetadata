6ibOQUQ7kNvwE1W0Cu&_nc_oc=AdqQ7-kuQ3elNoUjnioVE522get1cOAczs-wsJz3vv1EnaOxVzGPnEDmr3uZ5DpqRtA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsCPRvVhrQmwRKGXd5vdxUM2oq2KdkKkCB1mclFxJIUw&oe=6AF9C4C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3VMGs_98HwQ7kNvwEnSRQ9&_nc_oc=AdrLERWXXyFiUmMn6aoBwXu-j5HBGTU6ggnVJ-ouQSdFo26ONXPdTqyOwQ5nLZUuopM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXXA5VBhKCwzpttiH_VAFkEwMp5mGb5wgaW3z8EWQfhA&oe=6AF9DF39"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz9YfpsgSKcQ7kNvwEQV66P&_nc_oc=AdpmTWPvto9MhrBHbUIUbo5EyX6-_DkMrl6S9zZ7USPQMUTwNglQAyTAYbenR3oJrYM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRVxPvSPsKBPS0KgBbxs4CTI5im57zD_pfCE1ewcnemQ&oe=6AF9E94C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqQ30x8e0n4Q7kNvwHB3BEK&_nc_oc=Adojgh-_yBDHN8OIv7UNvi3pInodqvJ3aE2bWi-YcxtnWK2Mg3-CrNMKklv13b1MdWk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJQ7FRexHmOR3nwztpoyATXAqdfw5x5SaNknb5b-J-1Q&oe=6AF9DDBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek37GUS0z7QQ7kNvwHW2XnM&_nc_oc=AdoJyc9n0s01rizYKmv6_ZheUqWXH88OlhZ5mHUc8eps9AvOrvMcglwm0sZz73H37Rk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9n7G9beEH0RYaPl1CE51hJizGyn9cBpz0--uAIBEU4A&oe=6AF9BC4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
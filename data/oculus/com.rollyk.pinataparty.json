vYqVrYQ7kNvwEsqlF3&_nc_oc=AdpyN1r5YomFUUDnimFouoeAxFDvNyK3hkFVZp6CONG1phHJy7IbHoN9jgw2iH-vXwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n8Jw0lOmEWQNEoSqXbGj9D7FMooKyht5xeKr9zy4b8g&oe=6A05DF41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OTpzcWSi4oQ7kNvwGaiYBS&_nc_oc=AdoSrx4UuxTa9e4iBAgddlZMkwFJ0zKirwf24PyHfi3etp2kgmQ8O4G-X8jKnfR-39k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j-vFkpYUsbU5fcNrqy0ym7rBu6fXdFefGoz-l_n4uiA&oe=6A05C179"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeVfknyGbJ8Q7kNvwFrtsyk&_nc_oc=Adr_8w5Gfiti9wmqM30kl62sutgpqQcOPhvE6mhM0JjkMN2ppGlF660Nbkv0KCmgXrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MxvARCGRzk-cwJ49Ugr2JuTpA9DCb5BBwCyvJBNZvUw&oe=6A05CB8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et3nMoxsLWYQ7kNvwFJYdWW&_nc_oc=Adq3xC3ZtvritcCaWklI1cwxWxS5oP4_IwytLZ0sPWmIU3aq9y20EjtGbo8leChl22Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5twUBHjHKznS2GRo4k-htmQZUWaYLbybslFbfbO_dePg&oe=6A05BFFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afoRmSVpbvUQ7kNvwEnLNX8&_nc_oc=AdqYy0ibCtdi2tKW6LCqGxLrUn1oXtAKAEUSbHFpbGH-xkIB_T4IzkZvE-84CWuORx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zogLGdvsaIK1qLrDTv8oJWRWZalR_4YgycvM7m9pRJw&oe=6A05D6CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
cS_1kQQ7kNvwGTokgG&_nc_oc=AdrIQ7A9jGvGfzFp7wnquzIqVJuju2vjUBlQKcU8raphSa44mvsXoV0lt4q4hu6LGL8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RFbgz5fpLgVgdMZ8SL1rDSeiRVT90o3VBZjFwMWsrgA&oe=6A3D3E41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i90dTjcwRQQQ7kNvwEIXte6&_nc_oc=AdqPU9U6jD9FK00Ba2k5FW_PUqCv9U689ds8vZbmiTlcQAsE3OdTwoytfRDO-9T7XO8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v3PyCh4_jyWr59C7UMpeWJlOuJSHyND_QgkZD0GjPgQ&oe=6A3D58B9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVWPMi6UpAsQ7kNvwFXc2CF&_nc_oc=AdoseIFXFm-AquvLccrfe-VgQljux1zmRrXEbij5qxqIdKhYBWk9Vw-RJoBurz2yfY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kmX5Bxjmwp5dOEjZ9qbe5PVbmjc5afxFl-dCK-bzEMQ&oe=6A3D2A8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10OFY4OpAmQQ7kNvwF--fum&_nc_oc=Ado3e8FB6bmC0C34E2P1yID7aNnhlc0kfCu7guDsUKAKsarUgO6BuMhS6yIWZepMu8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6nBDryJ0kJ9OfYzLgnHsVEQCANLdxbrD-7WQ0TaPr4Q&oe=6A3D573B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylsPfJRDV0sQ7kNvwG-UiXO&_nc_oc=AdruWgP-dLYJ_6cZHJ8Nfn1bvz3G_TJGI82GIhk5blbNm457j330XLGsJHBAfQ1gn5M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-teKic7BEYvtbA_MU-l1vZ6_KtI_QHZ7En6rzKz3Mb6Q&oe=6A3D35CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
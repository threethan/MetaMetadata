YJX8nJH_RWhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfufgTdPm9a1J1Q2hfGsd-JFyL3R3RzRnaG_uZKAteVuyg&oe=69A43C8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DxOix5leXcQ7kNvwGef76F&_nc_oc=AdllcLTAm7RxVK84gDM9zV9pC31AozAcNJE1h3ZFQ5X6kOhKcxnkzNgsnZalpGNNdro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft_TP-JVgrDAcaU-DGirOLLL3puDv12iKdh3i41tpPW8w&oe=69A430FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hx_mcRnvaVYQ7kNvwGclKut&_nc_oc=AdlgMRB50O421V50Map_XorbpDdrVatDe5gf8HdLViPvquGTUzsJeDaLMLniAKsD_C4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu8_HLQ5swgTGR7CkJnyyg5zPOBPCIVG17i80HH2Yth6Q&oe=69A447CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild 
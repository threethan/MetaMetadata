_ohc=NHhkOB-lNcoQ7kNvwFn3gag&_nc_oc=Adomi23GzNZXA9bBwuDbg0MOTXvyegaw2m65LX2QRJaWUCJQv1JMoz23TeVDeX3x-JE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQvTyG57ipftM3d94g1QgiJBoOixeQiMXSWqk6CvRxRw&oe=6A7D9F81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QwVLXSqAGkQ7kNvwFiJtV6&_nc_oc=AdqP5VrkM9V7kwK-k0I0WdLBB5ecm8L2mvGi4cepZJytzDmmP-STKDqxCrItPBkuWLM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS8m6sZL2Wn8DBcGP6aKQ94gMtW1C0-M-SJADqXeTkIQ&oe=6A7DB9F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRHQRvXok4sQ7kNvwEIHeuX&_nc_oc=AdouMrAfBLSsm5uq-SidzpBjXRU2Ck8GlhJ5oKtFdq4dqvAcaEOviR33NFgV8Y-3jxM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzj8kkGK25wqG-qlGQ0o-cdWGgyPJ1RSzhic3u3nJTyA&oe=6A7DC40C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMcSv28K0LMQ7kNvwGEkNpn&_nc_oc=Adr75IeY1rPJ1gckOpLMtSurF0MVEBfYtKSL7_uA4mG9Sn9dPZXIJnI5xHxtxqw_8l8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeFdRgUau4RdC1FIAg9pI87_iHHYmnfLi3qGHlsCvKKQ&oe=6A7DB87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4a99iNldNcQ7kNvwEjGcW-&_nc_oc=AdqlrV7GGCmV3X_rp68ZPqAbdSRYlHm3AQZcoxH_2h-0d7SMgNNvd2m4rDBO1qw2bS0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJsTduwKE61l-T1yoGFELfiimHTMSMEfucX1ypVhVeEw&oe=6A7DCF4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"
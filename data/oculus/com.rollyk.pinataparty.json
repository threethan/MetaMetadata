-gQ7KAQ7kNvwH-6ZEN&_nc_oc=AdrR5mvNRgoTfN3WgAlJ9EyedjlgduP5pgqUXBxh1EQwyXMqbOQR7-6tJ_PqlcSAPiQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9CnAE8AtGmciXk-x3Gp_D6DBuicf7WEomIK-xOuu4Og&oe=6A54F941"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eflGdOEhFkQ7kNvwEzw3oO&_nc_oc=AdrTbap9rcJrei7nsNnjnQmjCn_DP21pVgTZR2tl_V-Nck2srFGOgZ3jV_YDyT0Ai9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDypfdhlTxnHOECruPKA4W-_JZdQEwlZvMZL4pCVVlExQ&oe=6A54DB79"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M2uA9MOMCIQ7kNvwFZdVaX&_nc_oc=AdrFBHfmioUcQfJb-gmmrE8dFrUVO0iLs5hy4gns0HRvUk5XgGxtr-7DeHr1eUbKk3s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-ZQ8XiIKquc0P7KDT-wcFG3GD7g3pHVjwRc8tOna6YQ&oe=6A54E58C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkE7VLNYEJMQ7kNvwGaiBgi&_nc_oc=AdpDEHVMUUqVj74M3645Pjs76OiXt6lS-hawooFi00KEI17xd8JGt5HmCfssrM90FbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCChTQiB04_0wBsUO4oOQNnh1CTllki8ZOQ1xpJzpug1w&oe=6A54D9FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkXRx1Epyj0Q7kNvwGsTkeh&_nc_oc=AdrPbJcBKwkrjIpBGNniJ8GC6JrBzW5SPqzmzMrEJoRfmU9A8nb_kUJz8U9AHtjMSEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACBPNdPsqRhoNdqPiFNjpXMCx781q3K8Cp0eo2V7CGUA&oe=6A54F0CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
aEYyA0Q7kNvwFh-Hnj&_nc_oc=AdoyhR3CcPcJAQeUSgDU2bhzkj-sqkCiC7tIAZ-4IUnAOqmY6stDu78gkUBSGdNzVVA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE83JCzyYdZrdZKFIwLW56QMXgVXjWItfTj-KTrbEjypQ&oe=6A86DA01"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr7lEFH2XMMQ7kNvwGJE06p&_nc_oc=Adq3NVs11MgTGhn4w4cNpP4QE3_4MD9Sbg-acwdhF5NSgeG6B1v20Z3WoX4NzqlJ49A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoxE6Y9KThpzT0CWVwusjikYPBeTPwrgzQGGya3crTMA&oe=6A86F479"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hipZcsNz4Z0Q7kNvwF_aLVP&_nc_oc=AdotReBR2YQwbYzVUrVy4byMz_iYYaveBouBnvo6gl3a6jpGoyRXfBsQ0JcUd2wFMMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWCWOi2vkJxQOMK-6-4JpiTeZtfucEgCe3ts3G5y6UcQ&oe=6A86FE8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PloIfREmh8Q7kNvwEbCQeq&_nc_oc=AdpUbGKlmuCUk2G0pwov7U3i--lqse9Wtc_ViAcEMxLzBHuGjNpyp32RoeHDIcxH1vs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-xKczA7q50wsagqgFvIlqUkGlbsVfzo_IK9iQSzhvKw&oe=6A86F2FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnh6Q7TdeVcQ7kNvwEnoGkK&_nc_oc=Adq4feIXpdMWN8qo1QqKl3t1KAi_kJHAJw6Dvk2prlBh8wexLfXTrnH4XPQB3BSnQ_4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfSQD19QmpowWkL9uJbja4gcHaA0h_D5xAYPk9_pKNwg&oe=6A86D18D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
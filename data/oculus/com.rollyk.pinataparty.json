gW8iowQ7kNvwFk_vRw&_nc_oc=Adq7Nfj_T9lt-Ue3afOTsTS1Z1G-zBJey1TrAVniibUN_PRrJN-9t8WaQ_t3WyYedDQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v2bREbjgSKSpf3jfWlSw-nI4NVSwxwamKx4jxWgSJ0g&oe=6A0C76C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXMt5QwFuQIQ7kNvwFGer2D&_nc_oc=AdrtbUuFmPe7T3vEAQiTpaGNG5ZFFHmyIuWbwd6sDp9RPPO14duKiC6ORhcIUrcKQ4k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pajxF32b2mTza1svZjrxqo-p8Ubx6GHfoa6wPdMQTpw&oe=6A0C58F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfAppYxRgooQ7kNvwGBhzUy&_nc_oc=AdpG10YBvrQYP6jyrnD629yTxERxwtMK2e3I0JooSZ_poh4dviaBsQMaw03GP_43ZZw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53RWNG7lJfiUG4JOPIy9MScchN7HtwOMe2rcK8Svw4yQ&oe=6A0C630C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAgKbfhKZNcQ7kNvwHmobLZ&_nc_oc=AdpdNgAk78QaPai9r7CUQGtHfnW8KD51Lx_Du9doD8w23HXe0ihdPTU8ORfaeIVSX08&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71o3H_upz4fytrRYt8oODagn8nLGXdHYfsVMgx5and6Q&oe=6A0C577B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKQEqBBT-H8Q7kNvwHavEM3&_nc_oc=AdpfcNiPYJ5EytfD-Gxmttvf9vD6aMG7ZXSVQE8rOGbyOBDH4PKKrC_eTbsnPvCmYfU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fZuVd9Z8GTQ2EHRk4NHquyFWvkINC12c4sJ0DvGTb0g&oe=6A0C6E4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
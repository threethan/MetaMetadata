furz74Q7kNvwH0lCcS&_nc_oc=Adqyj4FhbxGyQo80XavgSaNFEMprVklUHaTeHkslhfW0dP00zsfPhGZAyLwVgi3wU-0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAjjlsYOiAc5W3OB1t458ziADjL_8VxClmE3ACeBYS8w&oe=6A68BFC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08tTDS9Km7sQ7kNvwGoBqTw&_nc_oc=Adprb_w2enOrmsiLXXO5IMsGoJqHSjcQPssWdqceGUMrqA6Pf9cdDKgiuPZeTJhdfY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEW199XQKjhEkDjl54gBtg1IgFuXpkdBnfaak3iBl8GA&oe=6A68A1F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vuqzy1-hEXwQ7kNvwFbzqkp&_nc_oc=Adq7CMayfEVMnzYiWKHJ-hxWvOMkxk0u2MxTOicNu4ZacOPxPgrohGJPQV6PrEdhJpc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2i85UBYUVtiIV5OSlWtX42DWD7r9Wh4ebYRHpVgo4qQ&oe=6A68AC0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDKhJ8EnaOoQ7kNvwFGY7Op&_nc_oc=Adrz8wLHtaN9C8b9Nzz7ymAUZydnUdnTuSGhrftX4P1ESnZdYn2opEi-AejxFcx-Pr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3aeX9J_OwXTK8x6S5UFdGx2nhFa3vVN5Dqo0yOPxZeA&oe=6A68A07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRfA44AfuW4Q7kNvwFQ64pi&_nc_oc=AdqRbyAfIRLEBWJ-oM2kctp0dMlr0Jw1WOYE-W42NYchjHaS11XjvCOKV2OeITrV6dA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtVS9EvOWAPkoHi2vzYDTk5H1RWi1_8ZtsJhv730p9gg&oe=6A68B74D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
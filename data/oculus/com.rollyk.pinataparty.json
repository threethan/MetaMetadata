uNsVOAQ7kNvwFhgM3_&_nc_oc=AdrP9HmebUFCSHRME4_Oe2PTtI49SE0IGFl4OCezoEaUKgURomFCeN9U7VYc_OlbvrI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd0By37MZQUrnlGo-xfWX8DRrsISWS_TU8q6NTZ8huJQ&oe=6A58EDC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntmCh2_WnKQQ7kNvwH5dgOy&_nc_oc=Adp_OiE2V8SAtjWKYdHcJk0FBEdDK9l47fF9q4j6YrD8vZ1WN-sgh4gLIO5EOyEfAhM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGnOMIKEpWa7xDq8mxHdCg7cRwJqx-ish5vpAV8Hqo6Q&oe=6A58CFF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PD_2bVuprEQ7kNvwGlaRXZ&_nc_oc=AdqE8ETPnU_wo_SRyFVWKVDfqJUADSUbbhQqgRDab3G3rkeiWH5LqxMOYQWDQ4uBZPc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQNfBvOWtTmzh9WMBIdBcIiiij787CBwtY8q5Dnu0AUw&oe=6A58DA0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFYUApuna7gQ7kNvwG0qN0q&_nc_oc=AdojSO6tV9bN2zkKYnUNFV7BlwWDA2ZyqPgdn81LF6tHOtwMebkW3VmD_5J_-lGBaos&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm8FCit1NMLwl8OQYlhEDQhbGmhjdMirz7PTzl-2vRXA&oe=6A58CE7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U-y-wejo54Q7kNvwHhBW1n&_nc_oc=AdqfGU7UWkl0AdJMGREAr-erh4jMGX7yWTHikcgWTnqXs7coLJbB__qHrdgc1tS2iD8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw88sTvae5elEcyGYbO7yZ2mRlrkOcyfFO6FCV09dc0Q&oe=6A58E54D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
Y-iA34Q7kNvwGLuGqg&_nc_oc=AdpDmmM9qljVCKGxUYUsf-Dobz8AY6N-4V56qAqYq2XgA1DXGo9v1a5a9WDc9SbWsY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuulsH-DH2H4eH3sAnDoxg2858R0VCX3wt27pVvTnRzQ&oe=6A843701"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_LIyt1LEy0Q7kNvwGwh-Pc&_nc_oc=AdoTucr_jAUxIkLF3W8Ul2hSvz7TI8Xls_xsjxD8eMsUh4tayQm6HQKRm5pxXzP3v-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcpmZD7pEW7_Ck_eFfH356bVNDMfAyNn13kUG5Pj4SkQ&oe=6A845179"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hipZcsNz4Z0Q7kNvwHOm-0W&_nc_oc=AdpAyoya5_HDkxdSah4eYUevtlnPZLjR2tODwEvAAhqmHqre1axIE3YyfoLQhoCa-aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs2nWVngHW3qkZqRrwQ7jwVW5QTqLq5YThDa3DItgw7w&oe=6A845B8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSYo5xYBzlwQ7kNvwFgaJlI&_nc_oc=AdoqUHBwafPMl7x5F5UmxWuoKipSuvtwUqRhmU3NV_ZaI0ALH8sD5N_4kAduMNj_MfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3VjDkG373n49I6qNt4yiIJIf1fXIzwwkRFEBso28Bww&oe=6A844FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnh6Q7TdeVcQ7kNvwHgVdkw&_nc_oc=Ado0fYoYQsaA1JFPyAJ-dHxb-cy3PZkUms7uDshaL0U_ipNFWJPT5BJigLI1mA7_D18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4llgDitlCoqjY4-rdUc-LFxJXL5SlrQSe2p5M977W8Q&oe=6A8466CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
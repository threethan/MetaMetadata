w7yhnwQ7kNvwHz1VJk&_nc_oc=Adpy7B9NszRx7rX2kkwYilLAmO9KCyZylZNH4EudKA-et2vsJE3bfFWYUflu4jZBvug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvv5tIMh0nK5hMyReMyKiyXycy3c6wacU76iLIYszcMA&oe=6A6B62C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JmQekiYZJ4Q7kNvwFgkOOs&_nc_oc=Adp-jIsY_OSb-la1wuhtipSbPxMhXwQUCR_Q0v2IFQSJJ-4yQddpEXf_fcALlJRgTBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkjX4rsIqVBULwqYpAqZlHTpsrE_gFijpjc4zlkmczUw&oe=6A6B44F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vuqzy1-hEXwQ7kNvwE96dbm&_nc_oc=AdqM6bjzCfPVtgAfw8vn-sgwJy2za-C2dWFLx0OiDW40lTzpFFciCJ_50IVc9kHj5pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZL4MKfWWxbs95KkagNQKY9kDQeY58bQPOirUcJcN8PA&oe=6A6B4F0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKgMJMahWe0Q7kNvwGOi2-N&_nc_oc=AdrD8W5NZpGM9CIRpS0Zn9zIx76mHJeWNY6YBncRZUGZJ--7xlxspMDoUqEvPcWNuvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFDl49bons4KvR5lNhLXmIX9TXJwmL964LM7sXmG_dyw&oe=6A6B437B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRfA44AfuW4Q7kNvwHFbZYp&_nc_oc=AdrywtlcQKgV-PZDBKivIltnZn-N6vM51_iqVIQj9toBgjntWqiA3decTaU4yxKvizs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUZe_3fqoZiGmEQpW9BTbJwLd20y6QA1bS7upQDFtcog&oe=6A6B5A4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
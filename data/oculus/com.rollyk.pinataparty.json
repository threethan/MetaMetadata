PJOKVcQ7kNvwGu5ZVL&_nc_oc=Adq6L7V8Hh0Tho_pH1tuWcjNOKUmcgCo-s80nASDzxpFjb9NJmCtuuaZzpRK3J88rmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXFXSL3ZY65JZ3XW37pjGiSCfxkA0YBjDETqxucy6Log&oe=6AF8AB81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOu7LRZ45ucQ7kNvwEf1o7f&_nc_oc=AdrFAejUZ-6XLWtK72h7pqOblMHGYplNySiUA6RVuZ5gEg7YoBXoImxMW-7R4KuNgK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbBLd-s8GKncFHtntOEV3kAH2UJms9nFWwBk7BhU9EBA&oe=6AF88DB9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz9YfpsgSKcQ7kNvwFjavYM&_nc_oc=Adq0GZZ28sD5fzDxd8zUYT1h-nRSI4uw8f0RWMCa6f_s_hK0GMibVEFyFisIA2XN4sY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBMFTt3CG4AnaCuR2yOyF8u0RiUMA9HqLrmwj-xYTXAw&oe=6AF897CC"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aionUN6m-NIQ7kNvwGC9oxJ&_nc_oc=Ado9JT5r9WJLvpW8dxhGzUdat12BTeIyPijOnbXoJ1UNW4LqTyDRI-3SiA30UDsxyFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYyeUjx4Dr8qvNIU4l-Z_lMzL2AI2OguOMjUaADB1KuA&oe=6AF88C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek37GUS0z7QQ7kNvwFd48BZ&_nc_oc=AdoS-VaEIgLwJ99nSvOX-ju9IU4GXZ89VLB6wWznkZG-eGsCpbOpAt2f9haBlCPLE1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzE5pn3q8O9DAblNNjz_WLPinJQ2WUMeBUky_cRbyfOQ&oe=6AF8A30D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
RjvQRUQ7kNvwHLgWcU&_nc_oc=AdocFtHLV7iDgnoV-mQwIrQFKzcHypELXH_t2poytB7G3nwxZhVZe_ScvaVoX0NFEck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wiB0_eFtfWRhe2m5tEVPqOYbdxMrM79y1SuzXIqNGig&oe=69F75EC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaFIBg3XZ6wQ7kNvwH1mrbK&_nc_oc=AdqhAZOd6rzuLetFPaOtoaMpIyiip1R14zqSxYM9XEkwCFUV3fg9S6PpOJkRknjGA-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TAtqdn9kCFS-rXlFPqeto8KyBW0Takh9JidwOZkx7Xg&oe=69F740F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEHcNWQkwHIQ7kNvwFAgS7E&_nc_oc=AdoRdIW1CmZKK6-_W3XREzqyQFepz7dZ_fw9mhh9HbKzgCEz35mKGvO0-LFse4Ddado&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ay0v4WjBVNa1yqXD4vKJIhGQcRIXTNelh__-CknMHnw&oe=69F74B0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvL4v-O3PzgQ7kNvwHVc1mO&_nc_oc=AdqecqvS92mknSkj-UmGB36bNVMnCXcOwcXP3l9-9QwOKYrsM934AaYERnfPWRGcDQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3orCRfgF3yXU9sl3LgVCyt9NwhOu9WWOCzBGzm6NE7lw&oe=69F73F7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uCowvr9B0Q7kNvwGN0VdG&_nc_oc=Adpwt2LVzLDy-xXqhK2jwLLbV46oRWgoUtdOJehTh_Q9j7CMPV2ME1yM6m31XhD51Ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oPEzBLsqh84iZgHO7MjkPN3WIlC_0BMAaar8y7y9sSg&oe=69F7564D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
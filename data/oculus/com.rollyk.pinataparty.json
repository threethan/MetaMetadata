VBAvygQ7kNvwFUJ3Ao&_nc_oc=Adqe3ictKNP73KGc0DdFFn5UcxNxydZaUNK8o2D8AL4aSgorWPyQ-4yeYqc9DHCek1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oOrNM3hUDt_IXkvUHZ09PlwjD3nMn-dU2Qdli8IBcLw&oe=69E8DE41"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQTLyWxHj3YQ7kNvwEqardz&_nc_oc=Ado9gM4KqwVR4R1kR5KIHNX6iBp1T6fX129Bi_ohf2u66SkfnlKENXNsyfpt28zamVI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WevZzbJV9P56w7hTcLC-kUOO60B1RtN7x7_sZQpzVZA&oe=69E8C079"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhXZuexc4FgQ7kNvwFocy8M&_nc_oc=AdrUWejPEqEpn21zxuCo5EYYwDq7zHeTe5rQKLb0dAKNnlBBISNlJGZkDp6ZV5garLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HoSTtsslj1_G9JbyKYGQ2M_zaFzMwkLJQdjmsTQsFmw&oe=69E8CA8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqamSESANJ0Q7kNvwH8YaTx&_nc_oc=AdpDyUL0gSD2OFqk19GH7q7Kp5QpDAbN-bB_MNoL4t30_-v_OWVGzo9uDSlCudBg2sg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-dq60PRehBVkqs4GrBbZGLJ2I6N53FNWhSULSST_ICA&oe=69E8BEFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1r61UraucgQ7kNvwHeyuQh&_nc_oc=Adpe7TqbFujUBh4hbTu0NGtUD2UXUrkrkP92Y5sVkeVF82HQO734K4MX9dnn16A7K0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AflqMPT6ZfHACz8iJH_HEe7Lr7tLxXXzg3gnE7xZSyg&oe=69E8D5CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
-u3wvEQ7kNvwEA-zYI&_nc_oc=Adqz38pvLQqHB--S3vvIgNyRRazdrOYpAQmIWF59xSTN7oboslaoZEOiZK9IIlM1H7E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TJRpPNdTCTsYCZAYvrm6hkiv-F4zWyMklJDYvLRXxOg&oe=6A32B241"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibLyZp3nqEQQ7kNvwHPhZVT&_nc_oc=AdoKAiG1tpVNjAinCJ6T6RQ7qD0eMijrMbrzAl2pOsmsgjYm5DMTsJlspCJgycIrKnI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XYDfZ-YShwq4neMNA8sTq28mHLD53zKPhRpYA3ZguQQ&oe=6A329479"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl7wg3w5myoQ7kNvwHVyKLH&_nc_oc=AdraH9ISUk4sWSW83-iLQ5quCP29FpkHGfVWHWa1lLOzGZ6gQN0OVdnjZkps_xIvznM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94KxB2aLarAbi5-tAbPSfjQfjluCCgGxPqlxE5zGUa0w&oe=6A329E8C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwK_770mMOsQ7kNvwHtywDw&_nc_oc=AdrfDzsGK-ZoDwcll4fqXwAiRLAgD_CcDJWyFBh5BqSOLlENZTFqIYRv414WCI3mMKA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_uHk8byYjVmF97qHC6VYp0S7pB_7o_c630Qc31_OfSw&oe=6A3292FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKG3GQfNxQIQ7kNvwGPI4mZ&_nc_oc=AdpLR5eMsM0wnxEDiEFkB0GTuwbe-e6KGn4YDFaPotz9VmpRKU8peJiJLMmtbdagm84&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uFXDaKMcyAbEoOcaZIu4S5mQuduhV_iaNViQhY-2w9A&oe=6A32A9CD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
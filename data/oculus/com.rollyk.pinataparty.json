NifRiIQ7kNvwGlXYLB&_nc_oc=AdrLYamr47nqgoFtfWQNn7SrIU0LJdp6-bw7l3tE3PGfml6NcrYCF4tf-F84pcKdzO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IYSvgEiYZvN8Ghb_iii5eS_FH44-DnQZfWDZxtLSyNw&oe=69DA5DC1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkFAzAGqtaUQ7kNvwFtb5VC&_nc_oc=AdoTJ2yIqqhNngFajVNkN4oW3UVaTV0EPDkvF4W6x0BqhKnom4S91Ai3QnGxzAFkvhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BDgo14fYTwLXGLSeVdK_mXMwVnNa2PJm0gobFPEYvxw&oe=69DA3FF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elYAPyZSdPUQ7kNvwFqhW-y&_nc_oc=AdqD2IxByN7tz4FzkO8G4UsAJftgNBikuVedZxK4kjy8AlMVgmXy9SuxSL0NHz6N7Wg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af310V4nHj8ilkuNt2j1leARdywPwrtI-kBWQRnfTva5gw&oe=69DA4A0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3K9k3zDUdsQ7kNvwHOaoEl&_nc_oc=AdphcgAo07IsN1H1hHMeQGRts6gUQCjDrJbwJ7mrcoQU_7rx5zb0c8HWnmzW7s4R69I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kM5PWF3QvqH18VWay8CpYMO3M2RsJyR0_P6oaUk13dw&oe=69DA3E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TNcsUTBbk0Q7kNvwH4nijO&_nc_oc=Adpyjxkr6nQSRed_aqVVgL0EF5JWXhvvVqh8Ar7OkErRGfu_Uh1qyIKBTwJry46mzpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ScYCRTXce7M_T6YPfg5P_vX50jwC6XXfu-N3J7HrO0g&oe=69DA554D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
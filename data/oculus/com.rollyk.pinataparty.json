OBWSvkQ7kNvwFxsBvf&_nc_oc=AdoqG8KoWQsIZzvJt2I3B1uYtz_nY15EHGHSYgwbq30wKYyMeoj6ohoYVjLLuEAiMYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81lYvCSI-fQ0diSwPRrxw_l7BPvn_7lHqwE1MwYG1lGw&oe=6A4132C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3Y4986IY2YQ7kNvwGnaQ5P&_nc_oc=AdochClbGVlUAi97A8ANMm-54Suk66lxFrQetHrbsFdk4rIceGbrSEeL35oM-WGoswk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oCLyPD3FNIaeSbWoOXGLRHIqu12HPIES9deJ4zoPfoQ&oe=6A4114F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjfPHOoh2DYQ7kNvwFzhgvO&_nc_oc=Adqq2eAscCV524_avuKeaeu9Z8kLS2s_pcu7YCQzh3XRt0KtgoK6Rv0azOzY3yru4eQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VTrDCceBYHNgr0ceRtEI8CyKNNMbefe-8m032-rahdQ&oe=6A411F0C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTbdWTmYum8Q7kNvwENAK41&_nc_oc=AdqS0XUhF5l_CzVkFqeXwwJ7gRFftchbjYlzgcTGoNS0MVKLR1B43WbAfsk_eec6Vdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93GPyt8kuqjKLF6x7iwmqel7zzkpBlY2t0CYvlE4_GZw&oe=6A41137B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WYUyb99vGsQ7kNvwGAyb4m&_nc_oc=AdoECJJhqpFE4PnGxQTQ4H1Nb4wBvBUQuQ5NgXOYbjz1ntpsoYerRTRyLhavuBMKnRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kmh2lS5DxB_gqfmSFL6ooawIzlB0syKYmV_oH2ij2EQ&oe=6A412A4D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
aEYyA0Q7kNvwEj8wR1&_nc_oc=Adq2pLZvZuvpWB8CVdZidSQ2a54IN8r1MKQ-ErhQ8cKUDo3CGvZzQhVUIZsdN2q6NB4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0ZjYROJeMRjUvm2Lwcb560skbVqTsMqxBdM4eKWKK1Q&oe=6A882B81"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr7lEFH2XMMQ7kNvwGcLwe3&_nc_oc=Adqwkm6J2Fwoc4ucEufIfX3SEZ6S0nqFyLWacimysba7OE6PKzKacC8WNna6Z0NSZa0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHKWzd4ek0Q4WpNUqwLs8aSvtEQZ9ovWvT6SESbKFnoQ&oe=6A8845F9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyjDMgwML3UQ7kNvwG6dzPf&_nc_oc=AdqekZoGJgAQBIlPT9mFiC26DrSPZjeDngqr5R11LhyOxUXMK3IiVu_F26vYHvLmyi0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNc47Dd5qO0GwVybGVfJGuadTx5woJtwhpP3GUTKulmg&oe=6A88500C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PloIfREmh8Q7kNvwGt8dE4&_nc_oc=AdqwheYSUd3_kn-TgUDdmR9M0SfeeYCkOG0r0mrSsMG20w9hspAA-DOzerh2_GJTUKU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcYKK012Yx0jvu43MJZZ2wA8CgECt0MORXNE3chevgYA&oe=6A88447B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE38hEEA9jUQ7kNvwEF_qaY&_nc_oc=Adpt74yi9M23WSWPjpYzgna-LXxPcLp-Fsy5__XYoVQ2abch3SthRR-nBQ_DNlfHNMg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5KfV_z8W-3nDOlwBaemeaNv7lpr5Lr5EZPpS2LAa-ww&oe=6A88230D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
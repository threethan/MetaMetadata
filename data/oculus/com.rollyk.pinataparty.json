2zsaW8Q7kNvwEfC8mV&_nc_oc=AdqsPtT_LSfx_7-TrWzmlb90ewQ4MHmO-2KJdM1f77d9VNIBt4FffuaW3Y4si6fzWic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKE2HLZ_1tu01RYlvy4KuqUQI5Lum_nh-TnCp1SsqCZA&oe=6A6379C1"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVjqQTZukhcQ7kNvwF0nnVW&_nc_oc=AdppG2wGCrL2bFh2r9JFjXX8DfzbGvBp5TjPDnldBGmhrGQvBKYTjmzTjlI77vAwvss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz6m_24uCf1uQHf1mDyeALIcMTqcVgDpZu3smYa7iQ_A&oe=6A635BF9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9S48cGyDYsQ7kNvwHuf0ur&_nc_oc=AdocvzzFGqkqngj5EqDl8zI1m74eaPCdNb-p3IOOAAiQ7WOnVs-eTrlyWVLhlbLPZY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_pHJdak7wGZISEZ9R3dFijNHvdKUbavkrdEQRZHb6PQ&oe=6A63660C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGXutWj2LYkQ7kNvwGw4vHI&_nc_oc=AdrDlCp-l6roYWYjN8pChQsO7RWmzCn4lwacGEs48H2Ss91sx8_s5kmzvTD37aLOzPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5ju5B9PPGb6FSMudTSzK8vHvuK2bHt9w_pbTaOtoM5Q&oe=6A635A7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw25KfeNP6IQ7kNvwE2hM6s&_nc_oc=Adqkfu-RNls5yhHeBl8IxjY6BRIvjTZ8PmUdBi-tWMdLJCV3i3XXqLY_yqthNSbSjOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR1fsjSlIwuXK-3yAFs6wShVYGyC8A3ud0r6nz5p4tQA&oe=6A63714D"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
nT9hnsQ7kNvwGPldME&_nc_oc=AdqSvPVeavM09zhXD1QWzFzo2tu3jHFAPZ53PQvoe5aOfN-XpR0KvZHPyp5p_6Qwbrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImAkPAFOfYGS9saJfBNi43uyIbCBfpPILHNf8_ky-ZnA&oe=6A998741"}, {"file_name": "migrated_image.png", "id": "505831873661690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410487_500773577038744_3408801301000093696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZjk7V1WBFsQ7kNvwGnNeFM&_nc_oc=Adr4K2WJX2ksTYXR8F72-bfpwEyX2n5R7HNLzaa3c--uNtMbL_6yntd97YbRfW2fC1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU4LeTrSXXJM9tgOy8Np5L5ogLo4vu3pK2IumZS5ByGQ&oe=6A99A1B9"}, {"file_name": "migrated_image.png", "id": "237595517414276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522249_639977566389081_1678837862000230400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiohDE3YXIkQ7kNvwEAPVVv&_nc_oc=AdqcNOEHkYwl1sNFG1Wrl32QjvUOVBFY-IUB2litt0E3N1V8afJjipvn4M1Qt45dowg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW5sWHY8A_6FLw0oZFb2yI-6xBBpiJcNELM1XYwOaxuQ&oe=6A99738C"}, {"file_name": "migrated_image.png", "id": "231953637929042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138914_2108069686177354_6730451316063076352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnP2QC4o6lIQ7kNvwGce25n&_nc_oc=AdrozbZnFJcTDI6ZP1eBejFEWQ43fu94VE5LWle-OpCnHvtLwTNPZSZjnN4YCVGb0mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQbKp36U702qzJ9F2x1PF6NDfxN3XbFwQL6oGhvHVMyw&oe=6A99A03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nS4KiW", "id": "211937896154593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448895_211937902821259_3466922117004525568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elRyFiCOms4Q7kNvwGwqiBc&_nc_oc=AdpkJEF1dFUhhAMmnTWK_eA99h-ppyloGZQ8UJnadBUksKGEWrBNaTS0UEBcBWtcE0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2ysXn1dEiOFthLzIkoeWRil14w80RgO6gp0LUdw7XWQ&oe=6A997ECD"}, "display_name": "Pi\u00f1ata Party", "keywords": ["exercise", "pi\u00f1ata", "party", "workout", "running"], "long_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR.\n\nCreate a unique room name with friends and hold a multiplayer game with up to four players. Play together or remotely. See who can collect the most candy in three rounds of play.\n\nPractice on your own to build your skills. Pi\u00f1atas will burst with increasing amounts of candy making it more difficult to advance rounds. Pace yourself as you are forced to run faster and longer to win.", "short_description": "Eat virtual candy, burn real calories! Get together with friends and throw a wild party. Smash a pi\u00f1ata and see who can collect the most candy by running in place.  Sensors in the headset and controller track your motion. The faster you move your body, the faster you move in the game. Are you ready to break a sweat? This is active VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.rollyk.com/privacy", "developer_terms_of_service_url": "http://www.rollyk.com/toc", "publisher_name": "Rollyk", "support_website_url": null, "website_url": "http://www.rollyk.com/pinataparty", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA", "en_AU", "en_GB"], "suppor
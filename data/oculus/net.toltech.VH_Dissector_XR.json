&_nc_ohc=54eVguolyWkQ7kNvwFogtVa&_nc_oc=Adm02aKjpqltjzXULDhi5rNB-qBYGujn7xLKj2aIA7Fpt8Ux9_5rqbKxQWAUEP275aA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afszx8aolvFGFhP6dB-pm224YWWy9z7yTi78ZYk1X1t-kA&oe=6999A343"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B4n_LdgCMgQ7kNvwE1HaJJ&_nc_oc=AdmhC_HtZhhs8RaL2jfMczqTczxpzx5ClL6lMvAHEzqdTTChc8KCgKD_5ZUk1cecFpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftG8WVG8brwTdrJIJxmoNkAFUVgWJUVgaLin6xTvY78DA&oe=6999C271"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2U-h6nrh0QQ7kNvwFyiEf-&_nc_oc=AdkqLEDYnlH28y5Mqlk5mJwoiuBqs6qqrw9WcchGT_iCgpgVAMJZNTrIPt9VQxt4so0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuUsG-iGwrbZ53q0aqLJUTQOsXbdQCm_tLfIbe4hehkEQ&oe=6999A813"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr1Ye07HzDAQ7kNvwFWKidK&_nc_oc=AdmEHGFYg9ng-fy0Gto0CJkv71fAFHxI0MyWYc3ahT7EJrF5VcTyRMbaKb2yCwC6fU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoIzqRaB1HkTYI_fzqrVORexcO-mRUDgcPcXkd6gLjlg&oe=6999A86F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM39m8WHNAQQ7kNvwF_Q91Z&_nc_oc=AdlfDxVZ-h_Bw_B3bGtPZ--A1omqd711_yUK2Dsea2MllKmRkPT_Kz3Ky9aaMapnyqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvW4NA8rK3JpevzRdIDR_op7sGDb2UV3vTc-ag6h90Lsw&oe=69999CF0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null
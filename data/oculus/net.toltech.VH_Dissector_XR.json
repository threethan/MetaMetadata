cdn.com/v/t64.5771-25/39031509_1114403662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Igx4xf53f40Q7kNvwGMDuos&_nc_oc=AdqYGqBBkA1iWlSE_7x8zwBuNAfc9oB0pWkfEYdfMFhE9CJHxtrdS2LbTXvkHCy4gv4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7quqcFDXb-EEYH3ijWw_D8wbmclmVIndnnOedysyNZWQ&oe=6A119BC3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr-ADHYIs54Q7kNvwGwA-nK&_nc_oc=AdqpX_R_l5pDeEzh6Cm7S1pwaAEaO288cjbYX1y4Qu2zfjjF19Mh2jjJS9zGCA0UoOo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ouAZIb05ECiibAvEp_BIqFWDLR3Q-Dcc7CccmsVKQvw&oe=6A11BAF1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3rdAU1vGrQQ7kNvwGuyr91&_nc_oc=AdoPpipQawsay8U6qQux-_i5Yjq4SmaU8G9Iv2linm3LVfV2JVIhzmGqN_rdYzOLcug&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wXzuuo0wnnPbHcM293YXXpuVfXPvGj82j8xcjHN7WfA&oe=6A11A093"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj5lotOpLSEQ7kNvwFYHZin&_nc_oc=Adpln9_AWSi1D6SQFT7dS4dgYpUsukz9U7xmKO92XDugZWqOk_iywn4RpltlsyrNlhQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7myEX3AzRlrj2WvEKEg9zo_dFfjZC_v8qJcDpk0A2Tiw&oe=6A11A0EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R7K3dBRWlgQ7kNvwEog91M&_nc_oc=Adq8Hal-n4f9YKExfIN-umylGPupPt2KCYq1IKIGU_F7CcOJK-fAE0MIW19hyQsgK4U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6boxoAHG9Xqy0CGqVmc8SMCZpAGsqQvVl9PRCA9ebEkw&oe=6A11CDB0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription
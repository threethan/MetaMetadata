&oe=6A031B43"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mfSa9Vpu6kQ7kNvwGtytoA&_nc_oc=AdraQhq7_M3Yu4yJLrCrMslLghkvSNEWprR_aN1OQ5qwDSWZFDJRPJCBT7vRHyeKvsE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i5B9JFPgQajdnBwVbnYOD0Trx55fRg_cObftsNpCWyw&oe=6A033A71"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7TTjnpW2S4Q7kNvwGUPkUL&_nc_oc=AdpdOtYiNkE3nAS_b-KGLSAhJHf8X0tYYU0kKS-OxgeyuIHlVmPlVj9ZVdB73_1aECE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xXheZRQZrKidFkEuudU4G_VLakf_vNkNeVJks0OpmJQ&oe=6A032013"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=milYNLTMLWgQ7kNvwFBqGnh&_nc_oc=Ado2MIFzpkp-E8kp7EAin3P0uTinsY9ycGdfhITOatSbBJB3tBl00mdfAyHa1K-k1ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78dQsHY8gs9THhMeFAtDdTb1yYcDSvfWvJRPdJ7aQ_IA&oe=6A03206F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QFRi_rL8SYQ7kNvwHeABGO&_nc_oc=AdqiVqZ8O1mcxX7nSJn4gJbRmrj1O8iwxIjQwGHHbdV-Cc9ayevY-i0_nQ1BlmviBAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t5RsL7-IRwGkkvSXTqHQY5_oyZr-KB34UyLSzCCN9rw&oe=6A034D30"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
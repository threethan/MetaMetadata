03662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uy70y0JAIAQ7kNvwH93Qkq&_nc_oc=AdkQAiCg2CI6gRi4fDrbxeY1gJtRmtpcxUDGLQh5Rjq37Wyi-9VWoKinb_zydbtf-lg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0cD5wFvWwlcZ5yoWbByD_apjwwLiw3jVH_KqdxBCGHQ&oe=69B00CC3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlSSPe08iuIQ7kNvwERQ4Iv&_nc_oc=Adkj2IcVp4bl0_nRns8q73qlwwXipXJ4XMj-v38Y7Xb_czAvijQiMwoqfKzY5ngYGw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIc5yfVNiq0yMaB784RvAZZ67OE7Pc64Sv5ZczsCo-Yw&oe=69B02BF1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZiCPdMaEXUQ7kNvwESQ2HF&_nc_oc=AdnE5VNhq86WIzCFmOqCqbiERwm9PIhh_ZMfo0XBMmthmt00a1PVNQSl368HziEO-LQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZ65tpYwMRbEw0lY8ubJbQVzFss0oImzr8GjBzb2XvLg&oe=69B01193"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXJi8A5aYx4Q7kNvwFImo8P&_nc_oc=AdnzxaxDZa1cZFw2SDTXMr3mQlD9ASWBL2oGkwX2Rcse2_LAYV27V2MVBjSIhMDzXfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwui55J1URrw753DHR3_9O2JAAnD44I_Vb2lnl-ko_w6Q&oe=69B011EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aUSxAjep_AQ7kNvwEtA13H&_nc_oc=Adm-gFgUN6rsjcQ3qfgZaMy5T9neGViH5mwgFQ9YszZ2vAjCmz-zU_D_XFWfhokif3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzACOWX0H74OsXdBpk7sLUdhMwwAAOHcCG4kw9PRjdvEQ&oe=69B00670"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "i
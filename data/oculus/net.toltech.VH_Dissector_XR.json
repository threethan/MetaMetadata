03662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPN1wKeDUH4Q7kNvwHqtpv1&_nc_oc=AdllKz7AFbEaS26Th2S79c8njitk8G2ns0jusaUaxb-sAw4A2NorFUqQGgJ9E0oDmhc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8J_bvTtcqQNMats6498cw4U-CXv6Yd5B7ltwQOW9mKw&oe=69BA98C3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUwZ6cdVk0Q7kNvwE3LCnv&_nc_oc=AdlYVPC84eiA2HudfVmH5qn0UjwsnyvXaY6gx7gf3Kxd2nEGMBdgWoyxghoRw5M49g0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjepp9cwjLMBHjTYZxum-AvlSxJBq8HiXK8TXgMUp1hg&oe=69BAB7F1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHWDS9ooxIoQ7kNvwH22BBy&_nc_oc=Adntc74zXeaxCKBLAwsAMwMrlCbV1HweAXarJl5Sr_syGceXegHahc0Kc6lMwOYQEbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQj16HjLMJ0zKal3WR_T8QOss6LmcwrThww49jAylsUg&oe=69BA9D93"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNfV8sS_uiAQ7kNvwFKDg1n&_nc_oc=AdkBUHcZac60SM3wKt5O6D02hkZY7zaePU0YAFmy3peyjIOe77oY1AwB6u5rqpk_eCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzmw-OgwZqNVkGkSuiUQnIdfjYvBixlCKlvAQcgwnR0DA&oe=69BA9DEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuKR26rLBy8Q7kNvwG_vTJE&_nc_oc=AdnB6bh8mtXpUmEW0xUp3o-0xoap7bu7B4Wb2RDq-WNRCCVkTrjFJkl-0lbssLhLkCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfznMSJmWOjqnBkW6t22nwG_vcAMnX8whg2eZrSReGEzxw&oe=69BA9270"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "i
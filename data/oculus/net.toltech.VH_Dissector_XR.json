-1.oculuscdn.com/v/t64.5771-25/39031509_1114403662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d6wPfI8cp8Q7kNvwGb4APz&_nc_oc=AdoguaOmfWRA9X0WolZ7ojXWz9nDVEM8mN04VnnPlAK297wDL1FUn6C0SH6EO9QVwVw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtlO836jlBqrNIIMrsBr-YFGl6Dvnx40ukcnCo9LN30g&oe=6A859FC3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNSSTtTT5EwQ7kNvwFGPp8p&_nc_oc=AdpEVTO5Vq4k7Ihsy9VzcPjc3o44LZ2CKH_DoPJdcOYfl_JzT74BrsZ3RyXqlbKPMco&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWWn8bGAG2e-YH5Lx76fc6yRAIWrkmPYIEthX8Vrei1A&oe=6A8586B1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfW4gcQqWl8Q7kNvwH4w-9l&_nc_oc=AdqLSSjvAaME6gNVUr5ytIt4IXcnEhAhRLRrxw1yGpsxlKsXU9gJf58SKS73wNEkZY4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6pVUeJBE6UUvVi9E0XeHZWn4tKi9hF9HdFR7Z3prSaA&oe=6A85A493"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze_iFhD1E90Q7kNvwEj6uZT&_nc_oc=Adrpn8_qJNpGzWBHXEr2uYw7beVlXT8L1OSTFI03aCiX5LNYUiyu-xdMePCd0umQGpQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjYVuiNr-4VDZI68xaIiavaFHoRTnMn_oEcUt9wTYYMA&oe=6A85A4EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXKHPhqRnxIQ7kNvwEk6nfK&_nc_oc=AdoVcysWerG27vJvR916RkXVsJeLESQyi7ghLbS0tDieROB2syZcLqC4IPBcWBNquLY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_aIn8XKufuqFeUx78v2ziph8RJqkbJvIikHnAEu_TEg&oe=6A859970"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_su
&oe=6AB90A43"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guv562xnc9EQ7kNvwEDVzHC&_nc_oc=AdqVq2pu_upv0sHaHnnoj0wIM50Aqa3AAFI-78tU7vZ2M7yKfltsxx9ueOqJtp6FGUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYN8HgNo73HWMZ62YSpqEaF-TYaid4_wMs9wNZnfyXJA&oe=6AB92971"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbxBTiGgtqoQ7kNvwHuffac&_nc_oc=AdoD-yaHbUxl6k64xALlYGLVq8X_Vm39gCup24CuWrYT5X4HqHpViweaOgbvbT7gY7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ63DLYnaugITCspxRUvVSfjQheao0pY7o_l8WtDS9i6w&oe=6AB90F13"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CmuP-YSIgYQ7kNvwH59-VE&_nc_oc=AdrinDT08Fhdy7Z3ChUTwSowLpi8lIKE8WP0bEHvUlPFtV7KdfRD8T3tHNKkzJhNDuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYLfNg_LKK2PoGgU1PgW50XVRSlbU2GDC3fMUGOT5VSw&oe=6AB90F6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na0ZG1xHY-MQ7kNvwE7EHM5&_nc_oc=Adop4ht2Ju5k1ShOE1WD2DGu7foLGym8FIh6GxsqOi1eNLn77V1A3VzKNN5hY7MxD98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUJqiJaKq00iy-XlD0DKc6yVcs-tRNT3vW1FEyQJXvZw&oe=6AB93C30"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
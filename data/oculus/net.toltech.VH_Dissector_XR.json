lavCS3YR_rxdHHXwaQNGhC23yFXzZOIzZqlaNO5wU-0poeR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuFE6wKz3vuQkiu4dWMpftOm6iTrzUNodOmtJ_y1G8ATg&oe=699F0871"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gv-G0NC-RvIQ7kNvwFt-gN2&_nc_oc=AdlK_kxAlteoSqxinkcGO74e3ei7gWVn4cdR2hefXEwKjhAG3Zkn5nx85MqKjrbOmPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvn9LgQ-SyKzzbwmltHgI-oDOImdGXW5UMxkJIUD0rbJw&oe=699EEE13"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhLPcikjpXQQ7kNvwEMghAf&_nc_oc=AdlJEWb0chGj_o9qVRErHvnOJBN4ThNzLdoE7sR8P9YmEGL4BnH1W_vON6N-_9ucHoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsj0E_Q8_JJo5z3l1KgVliIGyioBBpYrVNsEum9aLxeBQ&oe=699EEE6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojye4_JpPnMQ7kNvwGvnmjr&_nc_oc=Adk3H99GVgIgsm4bqWuBViQEbGlEJqmq_zKt4gY6D3oh8tw-LbzNSABukxnOIZDxrcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvrx3bwF9BfmUM-jkIlBd4uFfLtu9KNC4rBdHB6vZfdhQ&oe=699EE2F0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8547899668646311"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2428328574167598"}, {"status": "PENDING", "id": "1002819591538753"}]}, "baseline_offer": {"id": "2428328574167598"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
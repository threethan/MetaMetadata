&oe=6A899443"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_DkU2_YlEAQ7kNvwF5qqNR&_nc_oc=Adp3De5mwqNfgZxc97-6ds46vzsRv-U9f_h6CnEf7ZyQD1Ah646KfvY0yFmBp2COVYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLXPqT8LXPehD6UBV1PsIewOhTYOWNzwtf3oldgCRBQQ&oe=6A897B31"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioU9292PpBYQ7kNvwF8p_ie&_nc_oc=AdoCAlx_IrAwNmyIyOu_Hy2Uxncmc42q9MP4Yvr4Ydd_ORfd4L1w57L7HRb3K7O9SkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEawWw0_Exi3ehb7amTGw2iRZhj2lc5SUBZ702DrxSWSg&oe=6A899913"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1TvljOj6l0Q7kNvwEeip2l&_nc_oc=AdpIELlm9_19-j7T3zgy9w6qoGYGxR0AvLXUtZjwzSfI8TKABmWFvgU-Ndn7usN-0NU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwMHqYYfLn3nFPZp6v2IIJzhKsTV-cBrjlqoiVjHK4zw&oe=6A89996F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go1933gfoFoQ7kNvwFBTjyS&_nc_oc=AdoGFg0_Slqfww4Ot5-R-hqXV6nXaq36lCKElkR4b1wJbvty1Ogu8HH9J-ZUrDxkmIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpBBT9Eq6Hlpg92pqeZxpVscUfknoyov-86oxZmkhndw&oe=6A898DF0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
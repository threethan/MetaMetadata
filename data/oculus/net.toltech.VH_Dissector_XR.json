&oe=6A5629C3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82RADVysGAgQ7kNvwHcv0fb&_nc_oc=Ado65GV-CIUpqCcEi1dO3fp5x_yqgFBgyKyq8fr85WFty8qp5TLZg334u2YtQom03nI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwx3-rtU_iWt5llLU845c5v2pMTXWsIfkWfr7_45W3Fg&oe=6A5648F1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqF-ijpObrwQ7kNvwF6iYK6&_nc_oc=AdqLUCdkL1TKlVRS0jyKkXxJQKQzrbLtn8uE9InLR2CRY2ACw3eTOhonXoXgg-jWj6A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVEhUvMwk6emkysdC9NpAmJysTRdzED1fNHXPKBQvqVw&oe=6A562E93"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blWmRFE328oQ7kNvwHnYkBC&_nc_oc=AdqKeuSNJ-maTVEX-V2fdylfkcrT-2_mw8mwXuG6UPy3EhTsHVw-h0B90qJrP-xkcU8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIShzHsfU87r-3AFTf7_JBfIGvMjF_clsfxHxY40EgKw&oe=6A562EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uxtkcGgxDAQ7kNvwELkYuA&_nc_oc=AdrCEAD4L4rtxCxzt2kvdE3-jE5XNyemGYlP3yUkBZ1hM9f3wBl4laXhoLvs9Xqj5G0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVhc6RdhOJRwQrQPb3Rjx1ynXklaPE6u1DrXdTT4k5aw&oe=6A565BB0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
&_nc_ohc=wyQBKHwJNGoQ7kNvwGVmuCw&_nc_oc=Adn760s_0ZIMiDgn9FDHeAkCvVLyOWV6r0tJMGM_HJE31wJORxts9y8XFh8VT5DmEDM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsRfxmSupP4pm6m7oZcsU3qXnmnNtzG5Mv_iGEyf1YHow&oe=69A42F43"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUOp2nacgXsQ7kNvwEIIAjb&_nc_oc=AdmzZwgUkdSojhwTxYy63e3uWu3-Ze5EH_dH7QKIh8apwpO3d3FfBoXC1pNjdDnPr68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsqt90xGuqb1jAKiX0Y-C6pLPEe1CMLImgZ7v5kiSJm7Q&oe=69A44E71"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOKBKkR84KQQ7kNvwEJwbuN&_nc_oc=AdnGby-yVsqzSJBioKi5tJ2sRjiAfq2Vx2X5AUL78M23ORmM5-As4NFthfbRoTB5Eq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv6CoI3veFVJbuNe4zVoXNptLLQ3mHMyxxrVIO2NJQ3Qg&oe=69A43413"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66WhVTSVoe4Q7kNvwEvNEqz&_nc_oc=Adkf8ZJJtXL5mLrqA2jsWdtLgZnLF_4bn3ck6hKPR62QTHQcz3OFH5MOZM6jVb-9bBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuVRtOiGk1LIWGxrep5xSvc7lOIO7cDDJd4K_7VjR9zbw&oe=69A4346F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUZsH6g8H7oQ7kNvwGKrre8&_nc_oc=AdnQOatLPepwEd21sQvDrYEyxWWj6wE8cLaxMDVLUo5ZeiaPt2jIZ_Cwcp5o0KBLYBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsP1iZ5nqJ_YBBmglR5WjzEcuzjhfD9Rw4PKp4aXyqf3A&oe=69A428F0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null
cdn.com/v/t64.5771-25/39031509_1114403662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE_555w8V9EQ7kNvwEljwOW&_nc_oc=AdpQcV-TRlovpIb4ihgGPVp4tyY0iB6uSOGCKvcoHCEbmdpwR_YOkqvP0P-fQxF-2i4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SKdvPOvMKrCP3eOJbisH04gz1xjbfVhfQmieXXQuvTQ&oe=6A469003"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhadt90Hjk8Q7kNvwHf7jpn&_nc_oc=AdqfwuxIUYpeOjQDZQbZhF8ZffprMyCVGkC5s9KVWmShsjicx6sNQSkwHk-oglgmyNY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3x3Zy4PGvKy98VYwLVaQrjrWXlVezGqYKCyGrFksTfw&oe=6A4676F1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkZZD3AOyi8Q7kNvwEAYRrb&_nc_oc=Adr2EsvppQfquuvDB4ld1fcD1nIcRFnZUDIeKiFgYJey-YEPAm4oWvAzXohopdE3lHM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R_gM7-HcgQPdJXnq00BdFpix2uO4qNyUOnuQMPMt-RA&oe=6A465C93"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzbdYMIyycwQ7kNvwEVGfif&_nc_oc=AdohWBQTkvxzRZMXdQ6zdIdrKiHUnjHsNBMCocz0u3KhpFiU8yJU7toq4EJ9xR-Vz1o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O50FlTs6jbUsLS-_s0XdkfudAiAXgDK-UNakxizuzkA&oe=6A465CEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roS5EILljY4Q7kNvwE_o11-&_nc_oc=AdrS9q5WSqoBAl7zj3_fHXE2UuZ2CF7Y0ZoOgnf6mBnqoptRY4MzWFtiZfKvInkw4EY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JRVELMJM6CZvsbHQGeTZh8SBKaW6bkZqs3NnXd1y_Xg&oe=6A4689B0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription
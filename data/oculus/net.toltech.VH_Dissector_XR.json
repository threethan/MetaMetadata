03662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPN1wKeDUH4Q7kNvwEspLSp&_nc_oc=Adn9EqJHwwN99R60TjUtxhRjRAEFdZ1aPevl0E-unEzpjOxUrlO3kUOjDJZqPzF9W7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGMK8Bdu0cLXotWBHgUV2lxvpn26pVd8Lqin_w3XxZ4A&oe=69BBEA43"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUwZ6cdVk0Q7kNvwE9wjdh&_nc_oc=Adm3ofTV5X_YFK2BPX--3nbA0o7eCNljCjBKCT58nz32TdT6fHpUSWeoS3czcD9O-R4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlruG8tZvSVZ_b_7VJ-BvVLUyelf9bOwl5Qtx5YO1j8g&oe=69BC0971"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pJHmyXJD6UQ7kNvwHJAv0s&_nc_oc=AdnT28A095XaIi9MbExXLvXcj8o-T2S2GYU8EHIn2rrF7UnhNNY9Naloarw6fL7tiaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwF9U3Sr6CtbhaXEukY2KuC6TO8ZQIoFSwNoqkJePr3Yw&oe=69BBEF13"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNfV8sS_uiAQ7kNvwFTauyu&_nc_oc=AdkoQhLBezMZf0TiKbP2wtLCEXoSqQilGv0pkitEjjOx3hpoDXAwFSEKBKgNAysLTjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxstpaQwFKKTtLooDtM85i4WedROsEG3Lz-B-ZP3abKiQ&oe=69BBEF6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuKR26rLBy8Q7kNvwEwVa4k&_nc_oc=AdnBlsmyWabHOFhraTmC6riwlTRmFF7rA7FaIAK6GT1ztGQRK-qKbmssNsszvqoznHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeOeyxAmXFoSHsP17dQNnpOBEFwJDDsuuahVqwy3MXHw&oe=69BBE3F0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "i
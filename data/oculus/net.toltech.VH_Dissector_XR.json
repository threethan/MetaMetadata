&_nc_ohc=nejsmmCfKrEQ7kNvwGnekhT&_nc_oc=Adlyre0BJdi1nLvLAIJ6afcw1On1AYbg-5_ZIfQM8SKKZ_u7BXxnMwcZxjQ6BEKgkzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYhlXNcgoc59i6rXHF-H8dypEDTjBDknAdDYt1iYrrYQ&oe=69A03AC3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCl5rkfktXEQ7kNvwGMYAhO&_nc_oc=AdkaSRWvqvqmX72DpcHDV2Vcn7BZCWO2bjmEefe3X2w_l7UgIaXH3dcqXOyiuWo7oss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsWExKp73srDQ54rOPQ24T7q1aAhven3s_EHLpWLIC4TQ&oe=69A059F1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-6ZE1fSxRsQ7kNvwFAHfGk&_nc_oc=Adn2W1RWdqzxURFcNxVUxGSJKEliUCVU6AJjclnDktCVh5WWaex1ooMWhgnYOdmI2U8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXeLlQvnNbFPFVg5qFaJT37l6B9rwf2gBWz-Bo4-1KvA&oe=69A03F93"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhLPcikjpXQQ7kNvwGf8-gi&_nc_oc=Adl8OMr-JmVOIo98sFMFuZnICRLXb9XT5I3swFI1qoJuErlLOvg9LFmbzWTkFx-QKxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpNaZPpyfDVBZ5rQKttiyuXNhh6ajRAsZQ9LeJ6s_cEg&oe=69A03FEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojye4_JpPnMQ7kNvwG7I6C4&_nc_oc=Adn0ctfMEmC4tFB7ecJP754OoKFKu7R7vGv0Dae1lfq8dO1MW5LqW7IF8ecGyW9k1go&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfszJScYzvZItvS14yjtgYbzIu3rzzBQeiBNZgnH-XIbCA&oe=69A03470"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null
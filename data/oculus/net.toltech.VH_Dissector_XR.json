&oe=69CA6AC3"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPQ6jaItY5gQ7kNvwEunAKV&_nc_oc=Adp4jDa3MP-7EyoFN5hw2pB6Ku0GvuiErrIM2QFC1dGmV3LIIVyPthjCtGCBgqlkcS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmzF4vIf28x8UTBK2er9Arn9HsrsfvhB69yVFaROg2BQ&oe=69CA89F1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHNjmSZjKKcQ7kNvwGTj1Y5&_nc_oc=AdoOOrLbzTce8WTIQ5f9I1wau4bj-vBNYwM8OMOwr_8REWWMzZ7JgEX9JbeJsl7KBtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ_Lq_Xqy2LSg7X4SyzjBvo-CBUGXBDURz-nSnHUOuJg&oe=69CA6F93"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kChKCsfpgogQ7kNvwFhCHuf&_nc_oc=AdqkpUtTaDe-KGNFvEdkujMLpeuVx9o0wRsooyZeAkMaEl0b0cwm-YF_ouPbR7sdims&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5E7vMDC7rmbNhymsGQfU7c-idut76m3dkh0fZ3VadrQ&oe=69CA6FEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCNZY97yQGcQ7kNvwFOrEeP&_nc_oc=AdoTIdfPpXjcAgQX5Ep7Jv47UkLoRKHdY-CEG6YowyotPooXmgI-AzDkFMRNLxLmysc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySlzLDVmNTXiwOxzXGkZ8G_Tb3Rhl36NppL9mUb7Chag&oe=69CA6470"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
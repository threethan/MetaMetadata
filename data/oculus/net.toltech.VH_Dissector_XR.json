&_nc_ohc=u9kb8U8cJDgQ7kNvwG38VuP&_nc_oc=AdqB7uxP2hbHeymSWABAo__xARxmCzSOOfXf4WsHn8oYjthmPeRO84M__lOtzT6eRSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0SOqUqS78Ff0nO3dtO3tKDbHtzM4xuRmHLjkF4YW0rSg&oe=69F0A643"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdsWJSYA8MAQ7kNvwFy3Y4N&_nc_oc=AdpmyuobEfBGgjcGqTnTm8REfTid_-UM-FMLy-IELGXSlehUg8uVZoDaYTC4S0Hh8kE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0u6YGdPeECQX1YQcpq7Sonkk_vw-1WbsbRVHT7nvQlog&oe=69F0C571"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPdgSSh9n3kQ7kNvwEB5qjK&_nc_oc=AdrggknR1Y7pc4YAPLfkkE43EcEH14ndiFs1gNWgxIirdblFX-HDg-fqDyqVSvKntbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3s0yQe9-TJS9LlXWgaj0wI6WiSQyNJWqDzh57Dzd2aIQ&oe=69F0AB13"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VknCpD4PbkQ7kNvwHXolNR&_nc_oc=AdoatYegQm27yV97PcpRfplP2oUk4Jbj6PopCS8oiODxHYhKdRgSh3_d0J5TeOFycD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-mXwZxfr9zXYnpC-XSpcD3LR_yIM2ECXIizeIlK336g&oe=69F0AB6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-8RZyfAZboQ7kNvwGpTBJ_&_nc_oc=AdptAxYDYXqWYzhpEMgq-LVq2uQqb_EBnd-ZCW2fD8cIDaKlCnqOg-UgPGDo6Q-DaTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0DJnmycP2CRaDkO3lECFa7nyT0hF9eg0Y9T2rkWhkGOw&oe=69F09FF0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null
cdn.com/v/t64.5771-25/39031509_1114403662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxNjj1n_inMQ7kNvwEF9nsY&_nc_oc=Adq48zDsAVs2E7JgnlUxIL0UzLU1O6Gr9CZD0AXDi0IG3VNDyHlYZWKHwOcWcPHPfyk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwqUjegbBrTkSTANdNp5L2_aGvmHzLKpHXhtaUyRSkXQ&oe=6AA3F243"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HtqCRuA61kQ7kNvwFIW3bo&_nc_oc=AdpDeAaVrAwx8Ih3Pox3rbmCG_Xn0FrUvLqmsL74ryoROPzDNgYGOexWntneP-7Y4pY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcI2yAjyaAd4VebhgA8KAH7JYcW-uvkFUH31sSplktmw&oe=6AA41171"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n9jBRWbAgAQ7kNvwFCFkpu&_nc_oc=AdpgnH7jiAcJOnxkdzpbJ5hNfNxFvh-RhXkyaEXuyhtW5F3-hx2bjEtOKxM0-FFi0X8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQwlBZuP4E6VAIf-kEUpwjIRJIBEa9ITJendFE3WSnpA&oe=6AA3F713"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUA0gbNEfuMQ7kNvwGvfLOM&_nc_oc=AdpgbjWjcUVDgbhcHMjFEPzjAQ8Z9fDqBShxyPOO2R83BeZpI3hLcNiOuUn5ml2epGs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILzFzqApaLC0nDYPo_9inTMkD3-PHTJE4r4WCccMCu2w&oe=6AA3F76F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fLVslEhvjUQ7kNvwFnAPlS&_nc_oc=Adq3mjxUW5wqkY8WXppUuSB0GVS3x8YvWdFybp9xNhUKv1kR1wx-fIfBVZA3Efm7A2s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0TmJGXbUgWNgkLkQYAmeYQZ06uQOx6d3q0dIbpDDi1A&oe=6AA42430"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription
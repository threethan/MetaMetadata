cdn.com/v/t64.5771-25/39031509_1114403662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0XIjIan5KwQ7kNvwG6gX4G&_nc_oc=Adrsarin6f8TP6TF2Mgyuu7qtDqwWlN38qeY79K3zZ4V3lelvhRD6l1GZEOxDnxryP4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sbNKSBgZL7mtXUX_1Vpe8hCqPcnh8P_xmxsOVMBP4EA&oe=6A36BE03"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzFNeiQqAnUQ7kNvwFKnUxi&_nc_oc=AdqE9bKOiEOje3cbR1XdgtF3amalUMqHhBFk4t_s5Kjefxpm5JBAaADhh3qox2Ed-Mg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LX0C1-gy7wzEhGzlBGg7cl-a5a2dxJhvjZmlQQQawRA&oe=6A36A4F1"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WPn9h7CbKoQ7kNvwFXxnAK&_nc_oc=AdpoJrHl1_bb8vrl3zIlnH1_NVYHUE5AGG7Sdo1Ruo9-opT76eZ4EoVZX60SK-pfEtw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rqp7QY9QgDjIENljSbpw1pWu2N4Sd3e4B5AxYsPEO0g&oe=6A36C2D3"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wJ3gzao7NIQ7kNvwFsU9ip&_nc_oc=Ado1XyHEb6qdpi53OxNmCaC-YPZt4SBMwu_eQ3O5Kx5u_tJYS9V97jVbBa32O0RPiKg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kYmpeOgGGE_vZsPldVF1K_pa-ru6BX8YBFnnrFj988Q&oe=6A36C32F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzSFjNJ5r9QQ7kNvwGkuo8_&_nc_oc=AdoNVrIvgbJJ7YK8ZyhTe3iF2QH4xouWd7FKe_0ol_4DkIoSTIp3IVmOvcT5eXKNNsA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82oZ-UTDBLzHaegBa80HQ0fSN4XfH9qd0FyP5WYhtDyQ&oe=6A36B7B0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription
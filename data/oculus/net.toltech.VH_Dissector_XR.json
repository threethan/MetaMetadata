03662984852_8459888279800143961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWKdaWpdhxUQ7kNvwG3_HJq&_nc_oc=AdnFRDsnad9DFZWngF-2dlrRG2z0xc8VPfEvWMgQmGFMJUXjd9GgucKjbsZalJnpeEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx42frPuOo9NQoKwCge8iryXZp-3l1tXRtFm0KTEcIDqg&oe=69B94743"}, {"file_name": "95e8aaac16a742d5af01cca8e356fde3.png", "id": "520550950316464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974463_520550953649797_3591405539493804393_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUwZ6cdVk0Q7kNvwEQOu9v&_nc_oc=AdnVIRLCWIZgsg_-WY4YXDrbSFwkDUQVGGylGQt8mdPBkNdzLM7kIBD1okygomqF4Kw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzARm-JYEfYjWDSf4m4B0D6SDuaPrnI7yrerIp-2ERDfA&oe=69B92E31"}, {"file_name": "425ed64b031544aa85574bf2614e92e3.png", "id": "1017375143384042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031335_1017375146717375_5033884876657754866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHWDS9ooxIoQ7kNvwGLTT5Y&_nc_oc=AdmMJzR22qIDWFO_fWxecErgwjHBmqAIoM32MCXNxumopfF7Wn9l8dphjDCXNbkOk2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnCOO4UMWVuW2_nGu61UqHA1wvuNVsQ0NyfhvhjUd94Q&oe=69B94C13"}, {"file_name": "9704afcd3b7b46629be4643247df25c2.png", "id": "715833460658582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031509_715833463991915_108230063461640029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNfV8sS_uiAQ7kNvwEChBbi&_nc_oc=Admb8-FQy3uV7gQjsNzpS_qM2yHLX1HvUwK-BI8dvWrLUAaNM8Sr1CI-iw1h-VzD-lc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyk3ZE71BxDVJNlneGfN_jZ-6kufzihqJCOoh-K6ZQAVA&oe=69B94C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "459766196848014", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_459766200181347_1228898930645790459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCoahj2K8b8Q7kNvwGzyneR&_nc_oc=Adm4yrcPyTak_bwKGtldsQ2-MR6MQDm7C2QjBHX64WjMiadH0bRsqeEWt2FYL-iVDfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwotBqVSFWSTHiSJxvZ_7SuSZ-uF1in4Hgw3Qz06dQWJg&oe=69B940F0"}, "display_name": "VH Dissector XR", "keywords": [], "long_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships.\n\n- Interact with correlated 3D and cross-sectional views of more than 2,000 anatomical structures.\n- Visualize key concepts in situ, making each experience more powerful, believable, and memorable.\n- Merge anatomical concepts with clinical correlates and scenarios.\n\nReal anatomy is the focal point of VH Dissector XR. High-quality, high-fidelity visualizations are based on color photographic and clinical imaging data. The app is part of the VH Dissector platform, which enables seamless content delivery across a wide range of devices and real-time interactions among XR devices and anatomy tables.\n\nIdeal for all levels of education, VH Dissector XR gives you the confidence to believe what you see and the context to better understand human anatomy. ", "short_description": "Bring anatomy to life in a 3D environment. VH Dissector XR creates immersive and impactful learning experiences, where you can gain in-depth understanding of complex structural relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toltech.net/privacy-app-store", "developer_terms_of_service_url": null, "publisher_name": "Touch of Life Technologies", "support_website_url": "https://www.toltech.net/customer-support/anatomy-software", "website_url": "https://www.toltech.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "i
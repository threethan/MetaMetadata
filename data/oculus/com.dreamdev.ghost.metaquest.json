-mcD23gU5g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YVeNWJiTSam9k1jD9oPMcwM7PJDMo284waLkZiyVBrQ&oe=6A3BD080"}, {"file_name": "5.png", "id": "924182016500313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819464_924182019833646_3170196375592189421_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW5CzoCZ4yQQ7kNvwFFIxpw&_nc_oc=Adprr4D_RtZ7Q-7V4qtqhvX2CRX-2_Abwvgfi9ywpv7rrDdisBTDUrX_I5nzA6WK0CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93yaacrXReD1yRKcUBGxiWitvTJWuncrAwvmcVyatisQ&oe=6A3BE092"}, {"file_name": "Screenshot_01_Hub.png", "id": "1430534385297786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1430534388631119_5504646025340144235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5YOrVWe5rAQ7kNvwHDAlQp&_nc_oc=AdoNJRzmnblRwjjBLs1S_naC9Y7QYGWNGNQgVxrTXxcNcn5Ir6fov-6BN0uo49cj0xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tgTvHfoqsJW1OnoY9lOnS1-FBpeiBUF5siWtME5Nq2w&oe=6A3BFE57"}, {"file_name": "3.png", "id": "568383923006692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312439_568383926340025_1548271796695887676_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvg__MjpXc4Q7kNvwHmhmLj&_nc_oc=AdrAOM7QEpOebDnQpFW9ogsLD4Sxh93kRVjJMONhYbY7S-YcpMk6EBKEhMcgjGFqXTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VLAFrSVz_mk1Ppaqs66TBTSpLIE3hpWGRdrQT4oTtmw&oe=6A3BF914"}, {"file_name": "2.png", "id": "720938963917478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827789_720938967250811_1523527718150608906_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZKEmTHjqssQ7kNvwFojf6q&_nc_oc=Adqzz1nDDjJmBpDEGwnHnmNT9J7G3ZKJVGzWMd4851JgsEm-CbJIW73af1Fk2FPk3sA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VIoGNZubjxnQXj7kqfjIyI5wkJSnqWloVYJymT5mUug&oe=6A3BF021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "yag_sep_update_2560_1440.png", "id": "975695448247394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618284_975695451580727_1839293217108972025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1vLuqKLAPAQ7kNvwGYA2Ve&_nc_oc=Adp9h8f_WyZpt_Af9kM7C2Ud22L1T17BYUfVxT0TAh68PSVsbzo4NUcEdZryW2P_NTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Z0RfS6rgxSYI9ks3Shxm4DBr7qW20eoGV-mea4BgPg&oe=6A3BF308"}, "display_name": "You Are Ghost", "keywords": ["sandbox", "ghost", "prank", "fun", "scare"], "long_description": "\ud83d\udc7b Play as a Ghost \u2013 **Scare Grandpa with Your Voice!**\n\nYou Are Ghost is a sandbox adventure where you become a mischievous spirit in a haunted house full of secrets, challenges, and hilarious scares. \n\n{3560432210926769}\n\nEmbrace your ghostly powers as you roam unseen, solve spooky puzzles, and use your own voice to terrify an old grandpa! \n\nWill you be a playful trickster or the ultimate nightmare? The house is your playground!\n\n{1082626780574530}\n\n\ud83d\udc7b Become the Ultimate Ghost \u2013 Walk through walls, float, and move objects just by thinking about it!\n\n\ud83d\udde3 Scare Grandpa with Your Voice \u2013 Whisper, laugh, or scream into your mic and watch him panic!\n\n{4004984733152897}\n\n\ud83c\udfda Explore a Haunted Playground \u2013 No rules, no limits! Roam freely through a giant haunted house, uncovering hidden rooms, mysterious objects, and eerie surprises.\n\n\ud83c\udfaf Complete Fun Missions & Solve Puzzles \u2013 Trick NPCs, uncover paranormal secrets, and test your ghostly skills through spooky challenges!\n\n\u26a1 Super Interactive Gameplay \u2013 Open doors, knock over furniture, flicker lights\u2014cause total chaos and see how NPCs react!\n\n{1314190086311177}\n\n\ud83d\ude02 Prank or Scare? It\u2019s Up to You! \u2013 Be a sneaky trickster or a full-on horror legend. You make the rules!\n\n\ud83d\udd25 Mess Around, Have Fun, and Show Off Your Skills!\n\n{556324550833441}", "short_description": "\ud83d\udc7b Play as a Ghost \u2013 Scare Grandpa with Your Voice!\n\nYou Are Ghost is a sandbox adventure where you become a mischievous spirit in a haunted house full of secrets, challenges, and hilarious scares. Embrace your ghostly powers as you roam unseen, solve spooky puzzles, and use your own voice to terrify an old grandpa! \n\nWill you be a playful trickster or the ultimate nightmare? The house is your playground!\n\n\ud83d\udde3 Scare Grandpa with Your Voice\n\ud83c\udfda Explore a Haunted Playground\n\ud83c\udfaf Complete Fun Missions"}, {"images": {"nodes": []}, "id": "1232525675361244", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "You Are Ghost | Tu es un Fant\u00f4me", "keywords": ["sandbox", "trending", "ghost", "prank", "Christmas"], "long_description": "\ud83c\udf84 La chasse aux fant\u00f4mes de No\u00ebl a commenc\u00e9 !\n\n\ud83d\udc7b Incarne un fant\u00f4me \u2013 Effraie Papi avec ta voix !\n\nYou Are Ghost est une aventure sandbox o\u00f9 tu deviens un esprit espi\u00e8gle dans une maison hant\u00e9e remplie de secrets et de frayeurs hilarantes.\n\n{639928792246172}\n\nUtilise tes pouvoirs pour traverser les murs, flotter, d\u00e9placer des objets et terrifier Papi avec ta voix. Chuchote, ris ou crie dans ton micro et regarde-le paniquer !\n\nSera-tu farceur ou cauchemar ? La maison enti\u00e8re est ton terrain de jeu.\n\n{3164340970381630}\n\n\ud83c\udfda Explore une demeure immense avec pi\u00e8ces secr\u00e8tes, objets myst\u00e9rieux et surprises. Chaque recoin cache une nouvelle histoire.\n\n{1730041831229407}\n\n\ud83c\udfaf Accomplis des missions vari\u00e9es, r\u00e9sous des \u00e9nigmes et joue des tours aux PNJ.\n\u26a1 Gameplay interactif \u2013 ouvre des portes, fais tomber des meubles, fais clignoter les lumi\u00e8res et observe les r\u00e9actions !\n\n{1181267113686177}\n\n\ud83d\ude02 Farce ou frayeur ? Tu d\u00e9cides : sois un petit farceur ou une l\u00e9gende de l\u2019horreur.\n\ud83d\udd25 Amuse-toi, invente tes propres b\u00eatises et exploite tout ton potentiel de fant\u00f4me !\n\n{715859354198324}", "short_description": "\ud83d\udc7b Incarne un fant\u00f4me \u2013 Effraie Papi avec ta voix !\n\nYou Are Ghost est une aventure sandbox o\u00f9 tu deviens un esprit malicieux dans une maison hant\u00e9e pleine de secrets, de d\u00e9fis et de frayeurs hilarantes. Utilise tes pouvoirs de fant\u00f4me pour te d\u00e9placer en toute discr\u00e9tion, r\u00e9soudre des \u00e9nigmes effrayantes et utiliser ta propre voix pour terrifier le grand-p\u00e8re !\n\nSera-tu un farceur espi\u00e8gle ou un vrai cauchemar ? \n\nLa maison est ton terrain de jeu !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonlab.info/privacy-policy/", "developer_terms_of_service_url": "https://horizonlab.info/terms-of-use/", "publisher_name": "Horizon Lab LLP", "support_website_url": null, "website_url": "https://horizonlab.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "uk", "fr", "fr_CA", "de", "es_MX", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26459463157072457"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_1332456832083175_282441065514549035_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0FE3iuf2u4Q7kNvwGPm6YA&_nc_oc=Adoi
.png", "id": "1008226984524433", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_1008226987857766_2356200512821882283_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZHoXh2P_gAQ7kNvwHC7mUt&_nc_oc=AdozsfdyC1nS2aG0exN9GR_Tsu76OywDfIwb4U9JRAkkJtxkKri3jnnrCETp_o-NO-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIOoC47YP1sTo6rxacjDU4ynP6qlMhv7tLs1qF3wPGKw&oe=6A4CFB7B"}, {"file_name": "512_512.png", "id": "664387266056778", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392305_664387269390111_703961845231333393_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GUVM5AA1hkQ7kNvwFXkfCz&_nc_oc=AdpgbzYwx073Hu_ll418EGn4vPxkTlWhpNgdDPnZNcfCvPUm8idxbEO4FjwYx1R4KX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUXqqpnVkHJvmMizxbkeveIlHBDcMVhJnbGmQ1Keh15A&oe=6A4CFD0E"}]}, "id": "979882494101605", "locale": "en_US", "screenshots": [{"file_name": "1_2560.png", "id": "562306492848350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_562306496181683_4807076491223853149_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdlO9wB066AQ7kNvwEJThkg&_nc_oc=AdpjfVwmCW2m9IQ-tWxTBm1sw0NhaFsv5D9z_sQQwdpn6BEs7zcDAUumE8C_ePyJ78w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn3i6CaqOA0ZFYSi6hCxfhsHdbM3X8kRjUW_-MqoNDhQ&oe=6A4D017A"}, {"file_name": "2_2560.png", "id": "2866860113483572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_2866860116816905_37813303983498299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2PB-fMavmkQ7kNvwHHuw1q&_nc_oc=AdoIlgHtQ5uNqXyaesTvKtAIQ5rKZxm5jHh2WsewXftm5owgVcdND7rzYDDa7wBDlb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCklqo4FJwwqlU5JcOVTWmq3FlLr5lcQbrPbqxW3pCzew&oe=6A4D1B26"}, {"file_name": "3_2560.png", "id": "568203429657124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_568203432990457_2985887420991097289_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlyBJzl1-vQQ7kNvwG_MBF9&_nc_oc=Adopcdx4eyeRkFlrWmwyxtds1FMNeFYLbu9zxAZgFKHnjEr9kAH7xPE0SxuqUniIWT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn-EfwsCnntfMm0gctWyqDZn93lJFT_7PUoN74hWlvDQ&oe=6A4D0E02"}, {"file_name": "4_2560.png", "id": "593090207066261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_593090210399594_9202978834561634017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lN9K1DqzHoQ7kNvwGxXNNA&_nc_oc=Adpvzerz29N2sfDToLFAa4Wz60w220kwuZ0TNBw54B3iQhCA8a54MFMySni9K-KirBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaTt1c9nQW-jTFDXlBQBl6aIq4TlP7gV4f6P9XyMFhiQ&oe=6A4D1505"}, {"file_name": "5_2560.png", "id": "652712783829120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393841_652712787162453_2074328483706990208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_I2bAEPxkUQ7kNvwHP7D4-&_nc_oc=Adq3RZZBa83GLVWVIE68C_0ZvLGW5Z_O5fPCRAthB_MJSy11Oml8bYffa9Zw7rAU1nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe4YSxgeLLb9K_bQqnTjiq8YROPYRCTsWRmgGgJAGJHA&oe=6A4D1D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "624454680578413", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_624454683911746_3758979248663106200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6d520fkHK8Q7kNvwH8s-_Z&_nc_oc=AdpVJOyzexuKfVvcZEbNA-Ieir2mBY2pN1dwPZJ2eP36-UpI5LR60-lpOq-AouwOPhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMDdtCjEYM2Ym7DvAxQkSFzb_ZWH1k15eQytMYDuSNWw&oe=6A4D0AD9"}, "display_name": "You Are Ghost", "keywords": ["simulator", "Cat", "Ghost", "sandbox", "horror"], "long_description": "\ud83d\udc7b Play as a Ghost \u2013 **Scare Grandpa with Your Voice!**\n\nYou Are Ghost is a sandbox adventure where you become a mischievous spirit in a haunted house full of secrets, challenges, and hilarious scares. Embrace your ghostly powers as you roam unseen, solve spooky puzzles, and use your own voice to terrify an old grandpa! \n\nWill you be a playful trickster or the ultimate nightmare? The house is your playground!\n\n\ud83d\udc7b Become the Ultimate Ghost \u2013 Walk through walls, float, and move objects just by thinking about it!\n\n\ud83d\udde3 Scare Grandpa with Your Voice \u2013 Whisper, laugh, or scream into your mic and watch him panic!\n\n\ud83c\udfda Explore a Haunted Playground \u2013 No rules, no limits! Roam freely through a giant haunted house, uncovering hidden rooms, mysterious objects, and eerie surprises. Experiment with your powers and create your own ghostly mischief!\n\n\ud83c\udfaf Complete Fun Missions & Solve Puzzles \u2013 Trick NPCs, uncover paranormal secrets, and test your ghostly skills through spooky challenges!\n\n\u26a1 Super Interactive Gameplay \u2013 Open doors, knock over furniture, flicker lights\u2014cause total chaos and see how NPCs react!\n\n\ud83d\ude02 Prank or Scare? It\u2019s Up to You! \u2013 Be a sneaky trickster or a full-on horror legend. You make the rules!\n\n\ud83d\udd25 Mess Around, Have Fun, and Show Off Your Skills! \u2013 Play your way, discover cool tricks, and see what crazy things you can do as a ghost!\n\n\ud83d\udc80 Are you ready to be the scariest (or funniest) ghost ever? \n\nJump in and start haunting NOW!", "short_description": "\ud83d\udc7b Play as a Ghost \u2013 Scare Grandpa with Your Voice!\n\nYou Are Ghost is a sandbox adventure where you become a mischievous spirit in a haunted house full of secrets, challenges, and hilarious scares. Embrace your ghostly powers as you roam unseen, solve spooky puzzles, and use your own voice to terrify an old grandpa! \n\nWill you be a playful trickster or the ultimate nightmare? The house is your playground!\n\n\ud83d\udde3 Scare Grandpa with Your Voice\n\ud83c\udfda Explore a Haunted Playground\n\ud83c\udfaf Complete Fun Missions\n"}]}, "developer_name": null, "developer_privacy_poli
1-7&_nc_sid=6e7a0a&_nc_ohc=4DAmUDMokTUQ7kNvwGZAH5a&_nc_oc=AdpfGmxpD0uGtmR-eQjE_d3fM-sppe-KdbCzsyvZGzEhtD_LA-hrLlpjU_1ubJMWQ44&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8weALHxcRjcY_2u1R_dxOJ5RfdtgqrNIR2vNbPpYXpQ&oe=6B0B12B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Antiprism Release Trailer Oculus.mp4_snapshot_00.07_[2021.07.21_14.45.35].png", "id": "365602711825454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031325_365602715158787_2748101878017243439_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkMFqLkxJwoQ7kNvwF079xR&_nc_oc=AdrzlE0IQfy8kvhp-ImhTXikEm248ObtnQBOKpPNoPYRTK7t-Qz6z82R6wa35Kgl8bo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_JiVxKcYgk3zzMhvsEYE-0AyRtRHXueWpGDrceOOytw&oe=6B0B328C"}, "display_name": "Antiprism", "keywords": [], "long_description": "Follow the two misfit pilots Jexen and Malik as they stumble upon an ancient artifact that binds them together and takes them on a perilous adventure through the most dangerous place in the galaxy: The Gone.\nFight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion.\nCollect items and credits from your encounters and use them to customize and upgrade parts of your ships - you will need all the firepower you can get in order to reach the end of our pilots' journey.\nTest your aim and dodging abilities against elite enemies, unique bosses and environmental hazards, as you uncover the secrets of the Antiprism and its connection to the extinct civilization of Arn.", "short_description": "Fight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zerofun.games/a
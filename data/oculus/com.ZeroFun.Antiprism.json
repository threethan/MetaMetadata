136869515_100341613549594896_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5GRtxpUE7UQ7kNvwFmm0UX&_nc_oc=AdlZpYtWcAczEC9O3YBbTblnwzwf9ckgYUCxgNN2b7fa5Q-uL3lfQCJr9LUuozL0LYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKxt79IUgA0jnsl4fAgPOTcj-6eNllgQAr08Axi10y4Q&oe=6999BCC7"}, {"file_name": "2021-07-21 15-12-31.mkv_snapshot_06.54_[2021.07.21_15.37.42].png", "id": "358510788997582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031384_358510792330915_3386321840999909303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR_tk5ohF1IQ7kNvwHMknAx&_nc_oc=AdkUGTLgziJhnJrsemd9P_PChbTNKlTGFlXfRs-vvDe7frW_szajPXOQVRGFnxSY3R8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSjwGUwcXqNKtlUyU0AiNQl59UCQ-EIDK7VF7eVPXMvQ&oe=6999BE3A"}, {"file_name": "2021-07-21 15-12-31.mkv_snapshot_04.36_[2021.07.21_15.37.30].png", "id": "319735066515284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_319735069848617_2260973242090074095_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T4b2FEwDsIQ7kNvwFq5_Na&_nc_oc=AdkuwIMEOs_mVIYbvgPMTjd9YcIT7y8ZvQMDfASUqjACpGBaxjPNEP8uvVILOim3c_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfskiXmixIhTJVkL3eB6iW-I6RsAgyuPZ04flaOKBDeDGQ&oe=6999B677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Antiprism Release Trailer Oculus.mp4_snapshot_00.07_[2021.07.21_14.45.35].png", "id": "365602711825454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031325_365602715158787_2748101878017243439_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS-HsLUN1mgQ7kNvwHmqFkC&_nc_oc=AdmvVWxvkbbCMHJle5oCY3ELuQmvEYqLylhEOjHNlO49C1nNmtD2m87N9lHiEVzDh8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPENjoInviTjfdOq9A9s3TQZxWZFOBlEJJn3o6y9BQ-w&oe=69999E0C"}, "display_name": "Antiprism", "keywords": [], "long_description": "Follow the two misfit pilots Jexen and Malik as they stumble upon an ancient artifact that binds them together and takes them on a perilous adventure through the most dangerous place in the galaxy: The Gone.\nFight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion.\nCollect items and credits from your encounters and use them to customize and upgrade parts of your ships - you will need all the firepower you can get in order to reach the end of our pilots' journey.\nTest your aim and dodging abilities against elite enemies, unique bosses and environmental hazards, as you uncover the secrets of the Antiprism and its connection to the extinct civilization of Arn.", "short_description": "Fight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zerofun.games/antiprism-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Zero Fun Ltd", "support_website_url": null, "website_url": "https://zerofun.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "523884858862162"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "525441425357078"}]}, "baseline_offer": {"id": "525441425357078"}, "is_approved": true, "fi
iBYbh5bStKLXQnd4vc0ZUfYvcWPnF7YHRGTl7Q4eco&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0CCfeF-qGPMIgkR3jk2m9FSIU4MzKY3v1t-IoYlmcPg&oe=6AFF3537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Antiprism Release Trailer Oculus.mp4_snapshot_00.07_[2021.07.21_14.45.35].png", "id": "365602711825454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031325_365602715158787_2748101878017243439_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhg63C0yQv4Q7kNvwF925FP&_nc_oc=AdrYbqH-N9g8OukPFaceouQZOj_KpKFK65aRBa6dciYw51FPSW4-h7lXLW__ph2HZPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWuZtkmge0ttXZcPsnkLaS5txrYB4lNzGG30DQGy9k0w&oe=6AFF1CCC"}, "display_name": "Antiprism", "keywords": [], "long_description": "Follow the two misfit pilots Jexen and Malik as they stumble upon an ancient artifact that binds them together and takes them on a perilous adventure through the most dangerous place in the galaxy: The Gone.\nFight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion.\nCollect items and credits from your encounters and use them to customize and upgrade parts of your ships - you will need all the firepower you can get in order to reach the end of our pilots' journey.\nTest your aim and dodging abilities against elite enemies, unique bosses and environmental hazards, as you uncover the secrets of the Antiprism and its connection to the extinct civilization of Arn.", "short_description": "Fight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zerofun.games/antiprism-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name"
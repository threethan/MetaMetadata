ntent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031325_365602715158787_2748101878017243439_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g87a-lRbAMoQ7kNvwG2FxNs&_nc_oc=AdmxnlZUP1BOtqBmIOEBLrzi_yT4eyYMuwKtU7tLAXA07lChhX1lkvJAU1eA3wEwgCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxcu1k6UwKlT9ePm2UurJqdL9otX8dFYDqipFrxeGB5Lw&oe=69B69F0C"}, "display_name": "Antiprism", "keywords": [], "long_description": "Follow the two misfit pilots Jexen and Malik as they stumble upon an ancient artifact that binds them together and takes them on a perilous adventure through the most dangerous place in the galaxy: The Gone.\nFight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion.\nCollect items and credits from your encounters and use them to customize and upgrade parts of your ships - you will need all the firepower you can get in order to reach the end of our pilots' journey.\nTest your aim and dodging abilities against elite enemies, unique bosses and environmental hazards, as you uncover the secrets of the Antiprism and its connection to the extinct civilization of Arn.", "short_description": "Fight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zerofun.games/antiprism-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Zero Fun Ltd", "support_website_url": null, "website_url": "https://zerofun.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads"
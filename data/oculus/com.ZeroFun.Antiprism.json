1-7&_nc_sid=6e7a0a&_nc_ohc=ectuHU3TDawQ7kNvwHPuzLY&_nc_oc=AdpOmiCzN-DxQA-N0_52gq-Fha6bjly_hjeniM2X8hJKRkFfuNud0uDxtIRauu_itRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSxsHULrf7zETyPlQ39xkfasGKM2NJhK2UMI2yncKEAA&oe=6B071E37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Antiprism Release Trailer Oculus.mp4_snapshot_00.07_[2021.07.21_14.45.35].png", "id": "365602711825454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031325_365602715158787_2748101878017243439_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QW8i6vQGBAEQ7kNvwGr_0UQ&_nc_oc=AdqT1E8D9SGRz8GStSRQ-TwVa5ernd3FOlD49x-U0quJKtFqRcQf7sA_rwgcAhYp6UM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXRntJ1u2ZNa5nCALqG0vC1UnXik_DAOEcD1FDTHcPGg&oe=6B0705CC"}, "display_name": "Antiprism", "keywords": [], "long_description": "Follow the two misfit pilots Jexen and Malik as they stumble upon an ancient artifact that binds them together and takes them on a perilous adventure through the most dangerous place in the galaxy: The Gone.\nFight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion.\nCollect items and credits from your encounters and use them to customize and upgrade parts of your ships - you will need all the firepower you can get in order to reach the end of our pilots' journey.\nTest your aim and dodging abilities against elite enemies, unique bosses and environmental hazards, as you uncover the secrets of the Antiprism and its connection to the extinct civilization of Arn.", "short_description": "Fight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zerofun.games/a
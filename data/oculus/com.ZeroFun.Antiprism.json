_15.38.30].png", "id": "411459133536182", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982471_411459136869515_100341613549594896_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSZifS9zY7cQ7kNvwHlUS8z&_nc_oc=AdqwvBIRwhk_camUv64XEdiF5gLrUttLR3tEPZMN1Jeo-FO-2XGPKWlozzJO26hPZlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af007JR3pgVnYKscxudnv5TPQbakBUeszwVzJ_yNI7tnQQ&oe=69F21147"}, {"file_name": "2021-07-21 15-12-31.mkv_snapshot_06.54_[2021.07.21_15.37.42].png", "id": "358510788997582", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031384_358510792330915_3386321840999909303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KauGsUfL5rUQ7kNvwF2hLlF&_nc_oc=AdopNfoaG49lRUzmWb-VmO4G34d-NUCnFGFewRev0rlLuXpdJiAt5ir3rlGy9H7B04M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CB5PTkN9Uy8UQu-M9gsyv6hnrS4dkERJcEB0qES4qgw&oe=69F212BA"}, {"file_name": "2021-07-21 15-12-31.mkv_snapshot_04.36_[2021.07.21_15.37.30].png", "id": "319735066515284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_319735069848617_2260973242090074095_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAbq1n52Kt4Q7kNvwFuW66M&_nc_oc=Adrk8MNZx7mtw7uTK9HPNIeqjjvRW6WuSrQp9OQ2sfEzKTjxAqDOAJXeWXEzkdHwM7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3t0yQrUk2wfsGr8UO2hTkepgab48b81L84L8eOFlf_rw&oe=69F20AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Antiprism Release Trailer Oculus.mp4_snapshot_00.07_[2021.07.21_14.45.35].png", "id": "365602711825454", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031325_365602715158787_2748101878017243439_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOcoBHElYCQQ7kNvwEgVyz0&_nc_oc=AdqXXjxy03Jf3txGW0yDWlp__viA37tsrNjnGMEN3M2wLqZcSRgN94JZtLY95-3o4RY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1mPkzuh2Kgb1d7DYEcbrPuORQWKtwG1B2b-V9x1Wvd2w&oe=69F1F28C"}, "display_name": "Antiprism", "keywords": [], "long_description": "Follow the two misfit pilots Jexen and Malik as they stumble upon an ancient artifact that binds them together and takes them on a perilous adventure through the most dangerous place in the galaxy: The Gone.\nFight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion.\nCollect items and credits from your encounters and use them to customize and upgrade parts of your ships - you will need all the firepower you can get in order to reach the end of our pilots' journey.\nTest your aim and dodging abilities against elite enemies, unique bosses and environmental hazards, as you uncover the secrets of the Antiprism and its connection to the extinct civilization of Arn.", "short_description": "Fight your way through bands of space pirates, armies of the Selysian Dominion, swarms of insect-like Kheelee, and even face Vel Selysian - the mysterious prophet-like leader of the Dominion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zerofun.games/antiprism-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Zero Fun Ltd", "support_website_url": null, "website_url": "https://zerofun.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "523884858862162"}}]}, "scheduled_offers": {"count": 1, "
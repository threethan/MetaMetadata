cc8\n\n{1949521552607609}\n\n# GET EMPLOYEES  \ud83d\udc68\ud83c\udffb\u200d\ud83d\udcbc\ud83d\udc68\ud83c\udffb\u200d\ud83d\udcbc\ud83d\udc68\ud83c\udffb\u200d\ud83d\udcbc\n\n{695581606883401}\n\n# DON'T GO CRAZY \ud83e\udd2a\ud83e\udd2a\ud83e\udd2a\n\n{895622280055341}\n\n# SERIOUSLY.. DON'T GO CRAZY!!  \ud83d\ude35\u200d\ud83d\udcab\ud83d\ude35\u200d\ud83d\udcab\ud83d\ude35\u200d\ud83d\udcab\n\n{1961418037773373}\n\n**It's just like a real job ,except it's more fun.**", "short_description": "Stamp Boss is an incremental idle game where you stamp. YES, YOU STAMP!!\n\nStamp as many contracts as you can, earn money, spend it on new employees that will stamp contracts for you and then stamp some more contracts to earn even more money!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1KaZWYNuR5uXYWgUBXX9EfbB1X3gSwn1aspFjZHFtw6o/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26778614228437428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_1626800078461749_8074024861555628751_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sWipybBbC0Q7kNvwG
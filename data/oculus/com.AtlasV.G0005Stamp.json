4899_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l-dionD0QMQ7kNvwENlWyp&_nc_oc=AdryJvJSv0GGLa3nsFp5KUaXNkKYFGdQ6gBUAj3nhUpkuzWyXsqZUUk9qYEJ_GmKUgo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSaiWG0-Y08SHD9egIaalJzmgCJkb6I0MOGBqkJJB8Aw&oe=6A8D86AF"}, {"file_name": "Screenshot 4.png", "id": "2392182327969253", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819859_2392182334635919_2493948453144569539_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtOrAMPVDxcQ7kNvwG3PBQs&_nc_oc=AdpwwPSlr7H8RH000KfMdrZwamp4mmvt-qf7i_p6FAGkfzNTvRllOD0TUQIf7pYj16s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJofG1QFa_2Tn9X64QTK2OI_EurVzWY-ELrySaqEhEIw&oe=6A8D7A18"}, {"file_name": "Screenshot 3.png", "id": "846199661731057", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823351_846199668397723_8790140399544522003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeMpYhQC-2UQ7kNvwGyO0c6&_nc_oc=AdrGvYw26wjBLhCi017aLk7no54_a_9Y7u79I4HhgLorWlxhcZ-cqk26K4av2tjVsD4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDboEmu4sBMdv_fvsyT4xMo232JCefcelAuFeix37YZQ&oe=6A8D7030"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stamp Boss", "keywords": ["stamp", "job", "idle", "simulator", "sandbox"], "long_description": "**Stamp Boss** is an incremental idle game where you stamp. YES, YOU **STAMP**!!\n\n# STAMP FOR MONEY AND BECOME A PRO \ud83d\udcb0\ud83d\udcb0\ud83d\udcb0\n\nStamp as much contract as you can, earn money, spend it on new employees that will stamp contract for you and then stamp some more contracts to earn even MORE money!\n\n{969412849101298}\n\n# GET UPGRADES  \ud83d\udcc8\ud83d\udcc8\ud83d\udcc8\n\n{1949521552607609}\n\n# GET EMPLOYEES  \ud83d\udc68\ud83c\udffb\u200d\ud83d\udcbc\ud83d\udc68\ud83c\udffb\u200d\ud83d\udcbc\ud83d\udc68\ud83c\udffb\u200d\ud83d\udcbc\n\n{695581606883401}\n\n# DON'T GO CRAZY \ud83e\udd2a\ud83e\udd2a\ud83e\udd2a\n\n{895622280055341}\n\n# SERIOUSLY.. DON'T GO CRAZY!!  \ud83d\ude35\u200d\ud83d\udcab\ud83d\ude35\u200d\ud83d\udcab\ud83d\ude35\u200d\ud83d\udcab\n\n{1961418037773373}\n\n**It's just like a real job ,except it's more fun.**", "short_description": "Stamp Boss is an incremental idle game where you stamp. YES, YOU STAMP!!\n\nStamp as many contracts as you can, earn money, spend it on new employees that will stamp contracts for you and then stamp some more contracts to earn even more money!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1KaZWYNuR5uXYWgUBXX9EfbB1X3gSwn1aspFjZHFtw6o/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26778614228437428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827646_1626800078461749_8074024861555628751_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSW49DHZSzkQ7kNvwHA7xaI&_nc_oc=Adoue1t6AKw3XjT-H_Ib73GjB9k19QBUvoICmvw9AsxlBcwaFyft4_zGY0ujQXtIHdU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyFiC1AdytAfR0fQDQI6AcjrWiyTfgGI2o0DDUFzYGhQ&oe=6A8D90A2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9VwLWqQVngQ7kNvwE9LTFG&_nc_oc=AdqYlAr8cCZUNiflbgfXhmkikC8I4SZ21hPhrVvQbtZyTC4N2bT_Psv1Z8qPkv6N9sU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4D-YE-CgQNr3Qj888Pc4JG7nqbsZPlh1yY_40JzFdIQ&oe=6AFF21CD"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvtdGwhW75UQ7kNvwEJPaDK&_nc_oc=AdpFgA7LD_0i2TeRqq7oGieAc1CPzBn9fz2f03L--M7HDytZ1otnH2B5Y88OGLVJvd0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWxuPkAyCb6n4rr_njkBbJBbCZHUX8vBL-baxxPDEOtg&oe=6AFF1B99"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b38xKWBfDdEQ7kNvwFUPb1q&_nc_oc=Adrdcm8YKgMqfdMOcgistDYmndlQlbRoeJAX4u4aJ9SGqMTjJ5UCdi_cHs5q2L1Ufoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQltnH_xNaVmCn0oeRcVV979-dPAQ5a1ZikaqIrgv56fg&oe=6AFEFF59"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zara-shQZHsQ7kNvwFn7vo-&_nc_oc=Adp6rmvVHlbNSO9gMliN2345lfIWqZfRh5VHE2UYA0TOBTAJC5WO6gSBlrTRYQChwHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJynFH2W1FIZL94XGVGR_YGSPQOweSqXQTzvN-CbVR4A&oe=6AFF2170"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krTNdXH3bWcQ7kNvwHHGmMh&_nc_oc=AdoNg32jJU-DTbJGnugD554POtgqJ9aacF3shGtkpFXNdvocgcME-6lMevI1khZlXds&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQniYAmpSf_Gmvd5WXOnOzSMyUX1v1qvrcFvV5B3ZNHow&oe=6AFF007D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
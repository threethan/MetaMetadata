less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKyoS12TS2YQ7kNvwG2m7nD&_nc_oc=Adog7CYVBwbf7PcqB5eXy5_kCOhjN3Wdwlnt2jSVdwAe9nErlH6WT1Iuy2G-YtsjdNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiAFRz7PyXGPxOkYYcneRHECWJ3pp699jZBS1kAPcnIw&oe=6B0DA24D"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOZ1EnO6j80Q7kNvwHxlwHX&_nc_oc=Adp9IrfCUZXt08vQ7fBrL34vJvMPkxz2pTrnezuKmPCZZlEMNeJdBXuJk8LeMj4TLdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqfkXyxVUVj6npHlEy5q5dwx9HbeHYqBx1u8iKNWUhPw&oe=6B0D9C19"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moJLsEi6sVsQ7kNvwELSFIR&_nc_oc=AdrzbVWxclk4kNOSRb54sqRNSoCmPuK0hMG1Bd_oqsaPG-nlrIWPUq3uGfDnqEFg-xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiJjfslsgb2MnNCo3k-nNpvaVUUA3208U9IPNNR2bh_Q&oe=6B0DB819"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD7CIJvv47kQ7kNvwHU4QYt&_nc_oc=AdoKin_vLzP5ANfPVB1DhvKnwbfXftLG_VRM9pMi3EbwHN7hAeVBD6fLEpDTM2cEVyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcT3jpJuhP8Ufr9-F60gzoXLBXSUXQTGdNxHkd0WJADw&oe=6B0DA1F0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7OCWcANlGkQ7kNvwE7uRyb&_nc_oc=AdoPhIXGNOR2SVJ3t4W-EN67DsajmbLbNg_5bHu28Yfrvpm8iCZZSNfYEhzSIweWCdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8v2CPUBUi7RkZuBFIXzyA4pN-I7mGkSfDpLdvsrZdfQ&oe=6B0DB93D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
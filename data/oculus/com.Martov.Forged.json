Yk4zPUN8cN0ECtqVxkEIzq_BSb5poM9PXda5Mg&oe=6A6DE48D"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wUKSqSBrUIQ7kNvwH8r_Gm&_nc_oc=AdrS5DnACAL0gZxO9jyi1i_pIJQo1pY7L0EjVeWLvOTtt5snC_9pn9yaKgWaHHPSB48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ7qm3nug67hT3ke5XBPV1XMNw_IUT_0iBgknEThMkww&oe=6A6DDE59"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC2-mxGwVL0Q7kNvwH68bvC&_nc_oc=AdqCYD2gjhYjDb4lwtmNIQQOx05dQehsFdFmqlwDvMwlVroP34kcg8B9BmbwY7jlS-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARCshRkA_vRWpOJjjLsVTYsuNXT6no6ewml_xSbs0fEA&oe=6A6DFA59"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlXek1Q-UkwQ7kNvwHzdDE4&_nc_oc=AdoGMouthzs09sZBM8--Dqj-_tPZjNfHxnAUswfaRSLY_1wGiHOUe1B4BWOL-slAsCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA51JHSizdXAH9gnIj3-SLWiW11s_5b2Fip-9HM62VdVA&oe=6A6DE430"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMVXk-s-ZXwQ7kNvwEibTzZ&_nc_oc=AdrDMKmjrVD3t4RqPYweDBwpY0mn8jW38HXFJB8mwXJfe26sCuO0xBBc3SxCIZ6Zb2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcOH9ZSF776IHq0uyxsLdPq_Tnrd_Z_kwzCBtNNugS0g&oe=6A6DFB7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_
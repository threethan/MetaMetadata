less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhCS8zTwVMYQ7kNvwEphztW&_nc_oc=AdrR2iVex9VPJnnc_5ce08anfF83WrxdzMkEp9vEph6W08V-9sZmM-zu_HGmmlSYJ68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3dZjkIfSbxGdCCUp9E2n0V3t_Es8jZnnc3ZHlMiAN8Q&oe=6B0467CD"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBba0piEbmoQ7kNvwGgh_Y6&_nc_oc=AdrCsEqaYc27qF9NswTz_NJA-h_epXCxxH5sAXIVuctlIIcGNI4LDAADO7zyCWl6Ht0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBNEPX5OZCKO1vP06d7OWeCqBt_92PUfR4-0Tuo2rdQA&oe=6B046199"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48UkkZmBB-gQ7kNvwEqKN1z&_nc_oc=Adr9gnq6aGhaQzG-8Cu1YtJet3bnpK8nwfBdu4VnCFK04qACr5z9WgvHpAKckHR9fwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq2tyR_BWyXdYwJuHBFnW87TRTyuLHF8qCjx5Gm2ESIg&oe=6B047D99"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4FkaC_BO3EQ7kNvwGVNCyg&_nc_oc=AdqefyMMlkG3WxWYdpCDQJHQpGITaoZXpORx3rjgzet9aFTLkENjuop99Hj8JCCPmfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdknOBlgAm754G2VxktWMO--qpcM6lWmZrx7ys_tsC9g&oe=6B046770"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lszB64Mkvc0Q7kNvwG8Ccqh&_nc_oc=Adr8CDr3VnPsTZsE0fNL5oSeAozwMUEmGuGhMEjCUsG6BNhi09yhRScgwIs9DrUlQWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRVNhwC15_NiHjBpAjI1eh-_DOVKtUuGS1_mivuBbHuQ&oe=6B047EBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
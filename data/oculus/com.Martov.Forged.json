wGR1OAs&_nc_oc=Adrdni4mEwT3I7vYLZAQkTghkf-cmyRETYfamqQtnVUnTPThQf-wtuvwarF9kTLRYu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7ODeMrBiEI-bZoMhdXnHT2LvtuTGkLPe5UPn-XvMqAg&oe=6A64BFD9"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNTEgRo3gH4Q7kNvwHZTLLw&_nc_oc=Adq_zeD_D9pjdtfczEjrZ0YXyj-MzBjw0f-DCHoH8LH0t80xNijqAZGNNIUatBRwm2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9ESG6KuHaQP-lrkfjn9k9dsZoViJ7SQlbptaStYExAA&oe=6A64A9B0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgsNFqNdjbgQ7kNvwHLvAF3&_nc_oc=AdqdMDFOPL5qJcwS-Ff2tyC5WQVjhsk3kGd3nMLOZF7_BCDFT_CxLxIJ7gFYC3UbrjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-7GFCNkJVnbz1BlysNtwFMpSjug85egRr4uVxrERSvg&oe=6A64C0FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9653113178098411"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9652999904776405", "version": "530"}, "id": "430717802569788", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5653396314736804", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTvySn9r2UgQ7kNvwF5yZ84&_nc_oc=Adr94NmWOIXyLQcAOrcS3iOZdFOc6fHmCOgte2fCbi9X1wugQyCd0-9tjFGRPveX9S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2VNfhY52QkdXyzbCOFiOJbAea5M1klCUSc6Rd3sXZEQ&oe=6B05B94D"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rvyb9-hiUcQ7kNvwHzHT0k&_nc_oc=AdqyD2M7T0OaktpAdmhmmh_r5TQEQlp9pHCnoA6khfb3hg_aSzNKtVvTuw1H72UZsXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoy44sE6ppMs_8UobgDMww75m_Yv-qVeI_UVPdTnPTfQ&oe=6B05B319"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48UkkZmBB-gQ7kNvwHrBakh&_nc_oc=AdpDB_8EK3xFiK3P7Uv3GzRilpu1Zmn720NJAU6V8jPnjc9ZUC6q3jb9-jYWAeX3cPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXNJNxbkb55qyHL9az3UvODErAf4F0Ip0AZPlhb35PjQ&oe=6B05CF19"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4FkaC_BO3EQ7kNvwFeLTGv&_nc_oc=AdovOs6xhF0T2ITyOJmS-OF0BFwSWzbdM83y6E_KhCo_SwgheYzPmnr7aFyTLdSXSUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-37nxV3byiwd64NIfOczJ_V8yD9w5uKSsree5DhXEVQ&oe=6B05B8F0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lszB64Mkvc0Q7kNvwEOH8Ov&_nc_oc=Ado4xwfmf292xRh5A57Og-JugQsF_cc2kSxz2-HZ7QakbDxGI_lFe2rnfcl5RtjEPuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWi8EXVHytJeMXlzrzTrt58JRaUW_rEoVmqQTM5GlAJQ&oe=6B05D03D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
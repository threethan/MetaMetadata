otF6xVFJwgyAzFbzbPReW9EFDfZEQO10Qvpegw&oe=6A259A4D"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUutTxwr3AYQ7kNvwFYX17A&_nc_oc=AdqJD9nuq_6RIqPlledEHH3n0y58C3WRnzGauO66LCEOWYDOfb2VvEOH2341GFfz23c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vN5uwlY7RWYYOEkERitQyy5_uYBBkDs-AB6jD-0TXaQ&oe=6A259419"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-sQl-E4WQcQ7kNvwEeIiIu&_nc_oc=AdoBWcscUBhyVZSRSLFrpNYQlyvE-nawnwDuiYmK5OKAEFzTSYsF_CsHDpPvtPGmSns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aIO_ofgO6YFtaGUT6352PcNuGDc_Q_C9RsBZIrfF8Xw&oe=6A2577D9"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w943ifd-RmIQ7kNvwGFSR6k&_nc_oc=AdrUhzH89TVEf-cgPyULYCoAfQH6XFshpefkOdQd8_uceKm7Dc8Smhnj_-U8C8z2HRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j2qEpf6elHr5xVioXQX5nH4W6qmZ-P6Ev80vNHL7VtA&oe=6A2599F0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNTrdaD1WSsQ7kNvwF8XJEK&_nc_oc=AdqrGKfqGcGVn2okUvWvV6xnzXuNatYoBUXAlTk-3q8I9V6DyOb8S1dQXK-pmWmvdKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pvosEFSL0xQYpcz8nwBlsIhT82VTyDdrJtcyewXWEnQ&oe=6A2578FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTvySn9r2UgQ7kNvwGQz49g&_nc_oc=AdrBAVMC-2IuU3E4NFbBpKslK69GjRcNoU-7HMOhIiFtB7ba35inLjvGzpaCtwTfISo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJUO1UYq1duXpvlMEHKZWsxHqPX4WjP0MClM8qoT736w&oe=6B085C4D"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rvyb9-hiUcQ7kNvwGrh-D1&_nc_oc=AdoXvlKmQMMIMV8EFVOtv9WzOw0KrBUZuicyGH5viFkzDFZCIYQSFU7a9oNBcz2F3N8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQal6wN1QhTm8Myrha1rHuPmx6zCXALfeB3xx41LP-2SA&oe=6B085619"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etdBpuOs46wQ7kNvwHnZWJP&_nc_oc=AdrKtgxBFzfrFwNf2B3Lx1Hxkw0lI2x_ZMYZ7Zp-Lsv9Bb7zHRTVf65HZjPY4w8GCRk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpxR2ZCMYTzkUpTqHgHyI0haZelanY95HURjkDCuYxfg&oe=6B087219"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkCnfP-OemEQ7kNvwHj6Vip&_nc_oc=AdqQ7kgCgKLfjX0yvLXxFrTVOVkFlHyVbp1zaFVK5mgJpsOn_Bi_sB5bJ4vV8l-zRZQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB0ny8nF6Wb0CPWGAl5rVnahivJ9wGWbPPct5QiHYwdQ&oe=6B085BF0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9bcB0A1IPwQ7kNvwHVjS8g&_nc_oc=AdqBgIHysYGP4myMEJOq-XaxdvdMa8UX-wUQ9j8HVa1CGJT_CDv5v8MySjRB_Lfif-w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz41D4iShKpWC-vXf_BSS69PT4ZdBt7JP_yJEmy5HE_Q&oe=6B083AFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
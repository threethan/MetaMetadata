less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKyoS12TS2YQ7kNvwFLenPy&_nc_oc=Adox8kcXE6HAhoNnVoULEham4xKAtQdqmvQ0Lkgee1PWbkp9WzkHqsxnpKPz854kURw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8tFKX_Bs8nJySLO4XM3lSaENSAfcILWTTbsuSF7kkrw&oe=6B10454D"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOZ1EnO6j80Q7kNvwHsNkJo&_nc_oc=Adr0MMwQmOR0pgb6DLhMf43qCUMTgHLExnIxGVzrWXlozpyR5T3zl6KMZE1dZND0mAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoyG27LnjOOz3uj4PEA6ez6sORJxNOyriUce8eNbDfHQ&oe=6B103F19"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM1ojvcpfw4Q7kNvwHiduE1&_nc_oc=AdpgjzTs0dgjrqD64N_E6TQJDjWpGYkYkzrJXEGUhEOGfB1MwlWFCyqGD48P4AivJ5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhJYqZb2z_ftPcBbjffJ38myTzmkDTnLG-0JCRYVBZyg&oe=6B105B19"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dspQzHeWIE0Q7kNvwHyw1Es&_nc_oc=AdqrbA9TsEy3js69etuDY_Ikt7JV2fKRovBpaCF6FzP_wsngfXJSeZp07lblW7SrWrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxLVw__2wTHcfp6460Im0tcRI3p_JhvxHP6_naW1FREQ&oe=6B1044F0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfPZSI-oNYIQ7kNvwERU4VX&_nc_oc=AdrPlAnnIeYmkpTqtPBK9HjQg03vU_ytDGKdjdHqHa6kihkjHXFcWQky4wODlagu4Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0Llxwd_B3lkCq5Wp883NavkAnweWquNsq74StVdXPNg&oe=6B105C3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
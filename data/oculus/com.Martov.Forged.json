-_EPzNjtCDHJnbw8uq6aSwc8geKHuGXfeUPkB2A0wtIbw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP-bG9LScMe6omOvqIdFUyQXWF99YLd8_fU_nLZTpWNQ&oe=6AFC95BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
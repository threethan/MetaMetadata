less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTvySn9r2UgQ7kNvwGyFO8O&_nc_oc=AdpJWsHS-_4tru_HxzW6XmXGC3rojAEqw-K8LCnvsqoTEHfM9e2XRGLQbSPuanPDvQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTIPtagb_oOCSqeXWvkMwHQT4uP6wAqejJXoGe7wvDew&oe=6B070ACD"}, {"file_name": "screenshot1_2560x1440_03.png", "id": "890927625912168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348047_890927629245501_1499812939955435196_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rvyb9-hiUcQ7kNvwHEuTC-&_nc_oc=Adr2dIfK6rZW5UgQvO0P3bYS-OVyKq3moBDRcXTcLkOP3q-pEf7oirTw9z4E7HsuyXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2UXHAL7pA0TbAHYRvC9f3HhPjrjUm9HrsnecGtvdBFQ&oe=6B070499"}, {"file_name": "screenshot1_2560x1440_04.png", "id": "708918114720317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001661_708918118053650_5142324146876678250_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etdBpuOs46wQ7kNvwEViTXE&_nc_oc=Adridz9qeBF_lH_-0dniwrsFREnvxaSzsLNavbPIVQKMxSE7p8DpiD2qIm7IBg3yK6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOjkpVpkQjVEhHBjUQAJhg-Rq_WrkPcodCq2_E6mvLtg&oe=6B072099"}, {"file_name": "screenshot1_2560x1440_05.png", "id": "3052108338257948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_3052108341591281_3808565756546712935_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4FkaC_BO3EQ7kNvwFb-cx_&_nc_oc=AdriOfG-oSO7rRiwTqFbg4-BC_KUoeu6jAajxcRk4YDJ5ii-3uY6iMz9gtgAwiWuhTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzInoXCjQRUqFE4O1LEFwCULZpiasqt5RtZNNxwrSNKw&oe=6B070A70"}, {"file_name": "screenshot_2560x1440_02.png", "id": "1395060054472239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974857_1395060057805572_6236748821754459161_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lszB64Mkvc0Q7kNvwHXrHzO&_nc_oc=AdppR8Or9Oh8Y-PvrpVFohXX4MgXawlzQ48svR0np_FwVIE4Pp-UJ5lkO4ZtX12MRHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEIcK71YGE-MqTySgx3cf4Jclga-REoLMd0-z-JS8Umw&oe=6B0721BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forged", "keywords": [], "long_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and Warcraft 3 to Slay the Spire and League of Legends, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. Play in VR or desktop with native cross play.\n\nPick from a wide selection of unique and well balanced units to fight by your side - and bring them to fight when and where you want with the aid of Forged's summoning sphere mechanic.\n \nAs games progress, heroes become more powerful, unit interactions become more complicated, and games finish in a flurried rush to destroy the enemies base!\n\nNOTE: FORGED is early access. Some amount of bugs are expected. Be kind with your reviews and provide helpful feedback!\n", "short_description": "Forged is a PvP and PvE arena battler. With diverse influences ranging from Clash Royale and League of Legends to Warcraft 3and Returnal, Forged offers players short fast paced 5 minute matches against their friends, or against different bot heroes. \n\nPlay in VR or desktop with native cross play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forged.net/policy2", "developer_terms_of_service_url": null, "publisher_name": "Martov Inc", "support_website_url": null, "website_url": "https://www.forged.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
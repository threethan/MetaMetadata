": [{"file_name": "1.png", "id": "1196245885568665", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820198_1196245888901998_1021659010865891035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqdkXJnnk3wQ7kNvwE3p5iB&_nc_oc=AdqN7cpZf5vA6SqsGrwkIFzg8YYPTdaL9P_1WKbAKHIhwY7XQTd2hRwJ_n0axt9h3k0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1A2RHzVHCl9QY8fPX8koL9eRehzjx-TRbnLh-X8hV15w&oe=69F367FD"}, {"file_name": "2.png", "id": "700463639309739", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820607_700463645976405_6814149706928956758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elPFyOvLEZoQ7kNvwGtCDO2&_nc_oc=Adqho0l0cVfr_UcFkHOh5KLS_RJswQsefZtH-ya4rgDFXyog_NIdiUFWZFyMk2mE98E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_As6I06XdGM58ZKCrbyo3cgukhYSa6EFFZieXfAdJ3Q&oe=69F364E2"}, {"file_name": "3.png", "id": "1396774664700935", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821977_1396774668034268_6027724489138004906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1_9r3dpPg8Q7kNvwGkbaUY&_nc_oc=AdpjUg70-32BoFYpVpISmFgeHKeo3-ASwOFavz48ZCBeAcSBN-YRqZTKKmD2Dr6fEPw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1w-REYRCpSledPzdXhSfumJYAm1krtPBvZP62cw4BgCw&oe=69F35975"}, {"file_name": "4.png", "id": "1352381042702493", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820331_1352381046035826_2582181835844790421_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K90-Q8ShXrAQ7kNvwF3zBvI&_nc_oc=Adqz0UixuC38f6VU-QWViqQtjQaKlwlXWvrDQbo9NP3gjd_4G5lE-apcU6kFZvrNgWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Vqg1m2Hxa4ulJ69Zt5R2f5SvoRZX0KN43MblXhiomBQ&oe=69F3411F"}, {"file_name": "5.png", "id": "706489115165302", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820083_706489118498635_6746831829524530449_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szUbpCX6mwEQ7kNvwFz6CPW&_nc_oc=AdpE0Tuk6Lc0aW1Rx87tpk4-GcCgKAW5dM45hXgFczPsuvtCng1izaTmZ17IayGiOhw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RnV65xA5uZLxqETe3_EfedQv1aWGQhgft6IWK8ANLoA&oe=69F3697D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "4685938091632441", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826557_4685938094965774_2563192630403874008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poufclPhbP0Q7kNvwFmctCp&_nc_oc=AdrGtzxCkpMoxxbc99_IByDUrcyrzDLcaSSsoOZ6lFzGtig55ZvGpKnr5CWEJlbXrTQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hwM1xQ_FjSUknBYSt40kXQxkduJnYFuL6BBaDd6KZGg&oe=69F355F4"}, "display_name": "Cosmic XR", "keywords": ["space", "universe", "cosmos", "science", "nasa"], "long_description": "Welcome to Cosmic XR \u2014 your personal gateway to the universe, right in your room.\n\nWith passthrough enabled on Meta Quest, your real-world space becomes the stage for an epic cosmic journey. Watch your surroundings transform into a living, interactive map of the universe.\n\nReach out with your hands to touch, rotate, and scale beautifully detailed planets. Cradle Earth, spin Saturn\u2019s rings, or feel the storms swirl across Jupiter. Every celestial object responds naturally to your gestures with lifelike motion and scale.\n\nIt\u2019s not just planets \u2014 explore their moons too. Glide over Ganymede\u2019s icy crust, study Callisto\u2019s craters, or float through Titan\u2019s thick atmosphere. Each moon is fully interactive and rich in detail.\n\nExplore from the largest structure \u2014 the cosmic web \u2014 to billions of sprinkled galaxies, to our Milky Way and Solar System, down to the Galactic Center and its mysterious black hole.\n\nDrift along the filaments of dark matter, hover above the spiral arms of the Milky Way, and gaze at our neighbor, the majestic Andromeda Galaxy. Dive into the warped light of a black hole and witness space and time bend before you.\n\nWhether you're a lifelong stargazer or simply curious about the cosmos, Cosmic XR brings the universe into your space \u2014 to observe, interact, and wonder.\n\nThe universe is now in your hands.", "short_description": "Explore the universe right in your room. Touch, rotate, and scale planets, moons, and other celestial objects with your hands. Cradle Earth, glide through the Milky Way and gaze at Andromeda. Interact with the cosmic web, dive into black holes, and experience the solar system in stunning detail with the freedom to grab and manipulate. With passthrough and natural hand interaction, the cosmos is now within your reach. The universe is no longer out there. It\u2019s right here \u2014 in your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cosmicxr.brdystudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "BRDY Studios, LLC", "support_website_url": null, "website_url": "http://cosmicxr.brdystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9333143363462065"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1278533957552146"}, {"status": "PUBLISHED", "id": "993663882605930"}]}, "baseline_offer": {"id": "993663882605930"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1278533957552146"}]}, "liveChannel": {"nodes"
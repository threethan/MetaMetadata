05946_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-hCfGJ7lRIQ7kNvwEVQvLL&_nc_oc=AdqCkxiXAcpIJpbNrh7BnzI9fMbFn2_36W2XrlvAjKhrXaZi8QLwnLxe9jOu9Hs2mYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoNiUyJhsXvkFF3RZZwUhm3DpwnhKXplORXU82MOEUag&oe=6A4BCA36"}, {"file_name": "Virtuvasion_Screenshot_e.png", "id": "1368728785126679", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827973_1368728788460012_3970334374275600515_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdMGvScZelMQ7kNvwFrnSvr&_nc_oc=AdpKSU295Eft7cxE1ER7Fxa_DxoojLdcfogLWfykuJiErYN8aOpUaTRvKAt7j7AynnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYVYuL-UC-AYlbyJeDii_2Mvo4UDU6RnliVUQHP9wZ6w&oe=6A4BA041"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtuvasion", "keywords": ["waveshooter", "arcade", "survival", "scifi", "retro"], "long_description": "Enter VIRTUVASION \u2014 a fast-paced neon VR arcade wave shooter inspired by classic arcade games and retro sci-fi aesthetics.\n\nDefend the shield on a floating platform in a massive neon grid world while relentless alien swarms attack from every direction. Blast through endless enemy waves, survive as long as possible and climb the leaderboards in intense VR combat built for replayability and high-score chasing.\n\nUse dual blasters, charge powerful energy shots, switch to rifle mode and recharge your shield to survive increasingly overwhelming enemy waves.\n\nFEATURES\n\u2022 Fast-paced VR arcade combat\n\u2022 Endless wave-based survival gameplay\n\u2022 Global and friends leaderboards\n\u2022 Dual blasters and charge beam mechanics\n\u2022 Blaster rifle mode\n\u2022 Shield recharge mechanics\n\u2022 Retro-inspired neon sci-fi visuals\n\u2022 Snap turn and smooth turn comfort options\n\nEARLY ACCESS\nVIRTUVASION is currently in active Early Access development. Additional gameplay systems, enemies, weapons, progression features and overall polish are planned for future updates.", "short_description": "Survive endless alien waves as long as possible in this fast-paced neon VR arcade shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualrama.com/virtuvasion/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtualrama", "support_website_url": null, "website_url": "https://virtualrama.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25944648991862522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_1623253575615650_2214558676444020563_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP57zmmkTQcQ7kNvwFVlzJw&_nc_oc=Adq5zFtwbI_ocgm7CtAIibYf_dbVfiq2BSZiFiqIremroAs829L61ZiJ5mYuKi6z6Ik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8OBFFuunIWlQDYZEUk_QWdP5WFF8444EYce8jvWvylQ&oe=6A4BB156"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtuvasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1780035840, "lastRevision": {"nod
2 Endless wave-based survival gameplay\n\u2022 Global and friends leaderboards\n\u2022 Dual blasters and charge beam mechanics\n\u2022 Blaster rifle mode\n\u2022 Shield recharge mechanics\n\u2022 Retro-inspired neon sci-fi visuals\n\u2022 Snap turn and smooth turn comfort options\n\nEARLY ACCESS\nVIRTUVASION is currently in active Early Access development. Additional gameplay systems, enemies, weapons, progression features and overall polish are planned for future updates.", "short_description": "Survive endless alien waves as long as possible in this fast-paced neon VR arcade shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualrama.com/virtuvasion/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtualrama", "support_website_url": null, "website_url": "https://virtualrama.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25944648991862522"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "974902261587266"}]}, "baseline_offer": {"id": "974902261587266"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780035840, "status": "PUBLISHED", "id": "974902261587266"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27316069024720505",
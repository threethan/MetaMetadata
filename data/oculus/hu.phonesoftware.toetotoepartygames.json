scdn.com&oh=00_Af1O_k9GHjeMdbjiO_tcz3xxSxV7nqg6bqypLM-3n7DvNg&oe=69F0C31D"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJFtj8-Y8T4Q7kNvwGNhwQr&_nc_oc=AdrfTpG0eokPgMa85VoDwsYoYRGZn-Rgpk0-6o4mM6j2z7r-9PUqNXcpI81XsO0UfdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3GgvYKQeuLOIbXXt7mdVAuPmdJCqPaE2a-b9Mnp6Tyug&oe=69F0B076"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNl4ydZzZg8Q7kNvwF4EtXP&_nc_oc=AdqrAdhzS4qSAaef9nR4MjmpsP1B697XyYY8lvjLTX7LzO-iyv3yDh8LPf0wMh64PGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2l7zSdX8udVrg-UVOL93lzI5WawWUNKlP3pNrNTxD61g&oe=69F0C806"}, {"file_name": "ss_991.png", "id": "559712175526978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982476_559712178860311_7558449247813357588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqwRNn9KC_EQ7kNvwEI8AOD&_nc_oc=AdrUsdEzEaL4eMgzRCF8znKJtDgtNR5UnVEpsxd5gchUrKG24J4OyFyq-DMCNi5LT2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0U5OwzWS8H2VGUmMmsrCsCHxsjDG1KzLdpugLaPGWZLg&oe=69F0B408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art-landscape.png", "id": "841445067145469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_841445070478802_1771571236055123097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsS7PSMWi8YQ7kNvwFYk03H&_nc_oc=AdqAoLY1hwVYcmXqDPmI29L_gBO1-u--xzKHAs00U5PjzefQUNsRc7byWdYkBkIDGXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2hit8GyB2TBzyBIbgdlDQDiDLpHeyqPK8MYTLR2l5fzg&oe=69F0BDB9"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nThe main goal is to challenge your friends in the virtual world. Jump into a Custom Game to play with friends or other opponents. You can stay in contact by using the Voice Chat.\n\nDo not have available friends? Go toe to toe against random opponents in Quick Play mode anytime and beat your own scores. \n\nWhat makes you a fan?\nThe Wild West is just the first chapter. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG\n\nOriginal price is $12.99, this $6.99 available only for limited time.  ", "short_description": "Would you like to challenge your friends in an easy, cross-platform (cross-play) multiplayer VR game? Do you want a minigame set  which is quick and easy to start? Don't want to waste your time on long stories and settings? \n\nWith the newly released season 2 of Toe To Toe, you can now challenge others in 7 different games. The voice chat lets you stay in touch with your opponent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
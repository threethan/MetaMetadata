7kNvwFXf02m&_nc_oc=Adk8ZGdCVQbL-2RIFN4BqGTEw2e8tAe7Mt5hjUv8SwYdIVaamvfWLZcCtPwHiylgeuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftneCy4AJLBYe0qE8GhxFI5bbKHoDAtD1p7Tw6CUDCtJA&oe=69A4517A"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhH1hEYAmbkQ7kNvwGJw23H&_nc_oc=AdnFWbsC55PkG1PFdoAjhop866ODipd1jGo3JNfHAGTqLpz5m51LRvexQwSZQm_uhzE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvuVV3leNT-FwLg_r3od1MEgXtFEtEECGa7xUp9LCrutQ&oe=69A43976"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z37VdaR-Q34Q7kNvwGsq_zu&_nc_oc=AdnHRDmCAt3uQivn4z0u44pyJF_KWShwyLm7useGHrLEXbeTXIHclnIhF_7oxxay1Qw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuRgic8eUuZiJf5NDkmNaaewLKDrya3NcM2gAwTJnbeag&oe=69A45106"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer bor\u00edt\u00f3.png", "id": "752753112755301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75556279_752753119421967_649564030265922629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Broy_bTyl_0Q7kNvwF5bQW5&_nc_oc=AdnR6hFQmqKnsVMNpHRlbwAjENXaQu-wwVTgShy-0xdkK_MMeJhVU2Iog6hJuoXHbNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft1jmHpaahP9sac12PFVYEwY48GlYQgQDdYXbZzV6tteg&oe=69A43C53"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nGo toe to toe against random opponents in Quick Play mode or jump into a Custom Game to play with friends/known opponents.\n\nWhat makes you a fan?\nThe Wild West is just the first chapter. You'll have a chance to challenge yourself and your friends in more and more episodes. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG", "short_description": "Go toe to toe against strangers or friends in various unique minigames online or challenge yourself/your friends locally and leave your marks on the Leaderboards in this Competitive Cross-Platform Multiplayer/Single-player VR party game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1328933214185736"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "774161800558101"}, {"status": "PENDING", "id": "558138862506822"}, {"status": "PENDING", "id": "1477210892726819"}, {"status": "PUBLISHED", "id": "525686949130813"}, {
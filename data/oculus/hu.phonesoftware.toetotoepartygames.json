scdn.com&oh=00_AfuCA98wcc_SqDFyX58ElajR89bVUaRrvYqDSIHbDiPazg&oe=699B119D"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idwhMZpC1vUQ7kNvwEGbT_l&_nc_oc=Adk77cj6Yqb1ZeAIUzg0NoKue_inmuJP92wV62kzXma_s-skDnVXbmS6nfM1ajV601E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuyBBLYKcp3rzSADAGB9jkIsF1aSnuaHxFEbvHhHyQhoA&oe=699AFEF6"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZkHrjmOVqIQ7kNvwFcJuP8&_nc_oc=AdmhYAVU25AviCJp25azTp8BH_rWhGc-QA3fGl91gVVy0dkgf2o3wJSqTa5DRbbiNxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvtNhG6hz1IrFWMwRT7LkT549UqDoSUH_E_ceymgjQsVQ&oe=699ADE46"}, {"file_name": "ss_991.png", "id": "559712175526978", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982476_559712178860311_7558449247813357588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8scXiaK-sBYQ7kNvwGwabv6&_nc_oc=AdlUShtLGHCHa4NkTK9gHxIQOcsez3zkKEI0US45M1G9sdAGO2VH9ddC7KANc0GNg4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuScLfbYghQTBcw3GV32qXYTaq9MZmYlzc65XdWlbLHDg&oe=699B0288"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art-landscape.png", "id": "841445067145469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_841445070478802_1771571236055123097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcqf29s25YMQ7kNvwEWoCxA&_nc_oc=Adm222o_9wGEbZXBkeu3ftSnJZK5TzjTFRAALGFeSxSvwvnTTHZ4nUc1cw7P2Nl5L7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvnUPevyenp_81441imVqiXY3cfEBSMnVB7A6cDzM7kog&oe=699B0C39"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nThe main goal is to challenge your friends in the virtual world. Jump into a Custom Game to play with friends or other opponents. You can stay in contact by using the Voice Chat.\n\nDo not have available friends? Go toe to toe against random opponents in Quick Play mode anytime and beat your own scores. \n\nWhat makes you a fan?\nThe Wild West is just the first chapter. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG\n\nOriginal price is $12.99, this $6.99 available only for limited time.  ", "short_description": "Would you like to challenge your friends in an easy, cross-platform (cross-play) multiplayer VR game? Do you want a minigame set  which is quick and easy to start? Don't want to waste your time on long stories and settings? \n\nWith the newly released season 2 of Toe To Toe, you can now challenge others in 7 different games. The voice chat lets you stay in touch with your opponent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
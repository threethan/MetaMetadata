7kNvwFu1Qj3&_nc_oc=Admc03BGXOxZ_Pe0mT612PBxLxnlxSlGTrRFuclFCkY-GtFfcZmbKWRxTKppOzQ4Reg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftLmnE-mSNirrVlPLXoyF6dU4_Df_0TYBzMENOVLw4yJg&oe=69A56ABA"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhH1hEYAmbkQ7kNvwEpmoe5&_nc_oc=AdkJAxxBfeqkurFz2aKwxKPmdcjmBQ4lo467PQTknWrLA7mSsF2b4aa0jiIMCM3cAqk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvIdJKWsAZVd5PPhDMkK23Kl93eeef9cKyd33atOS-P2Q&oe=69A58AF6"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z37VdaR-Q34Q7kNvwEaYUR9&_nc_oc=AdldMk5jghN00Ef28o_GeGdJW34vhchsDv7awqTVKePs00_T8Kcm-Twq0HbtPPV-jhk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsIb-nWvfmWJoUVsJ-koers_qZykF1ocZfwUKS4_yjMJQ&oe=69A56A46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer bor\u00edt\u00f3.png", "id": "752753112755301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556279_752753119421967_649564030265922629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Broy_bTyl_0Q7kNvwHAxZzb&_nc_oc=AdkO2dGlxVTHUqfgmBQyLJHPHHZb3LyaLIhuZ16lFvOzw3Fu5JJQtoMeVfZpv674igQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfttPnARJmy9e_iQkkSGwWqBLgRL7Z-18Z9EdUGPf9wG4Q&oe=69A58DD3"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nGo toe to toe against random opponents in Quick Play mode or jump into a Custom Game to play with friends/known opponents.\n\nWhat makes you a fan?\nThe Wild West is just the first chapter. You'll have a chance to challenge yourself and your friends in more and more episodes. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG", "short_description": "Go toe to toe against strangers or friends in various unique minigames online or challenge yourself/your friends locally and leave your marks on the Leaderboards in this Competitive Cross-Platform Multiplayer/Single-player VR party game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1328933214185736"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "774161800558101"}, {"status": "PENDING", "id": "558138862506822"}, {"status": "PENDING", "id": "1477210892726819"}, {"status": "PUBLISHED", "id": "525686949130813"}, {
dqdvvxhB2-kNvHRO6rfP48Ef7cdWJRcoFEXueAvJO4w8_aN7TrDqyPUsutRDkMcWK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwhFS_2LQiwkt0kxIlc3P2ItdxNB8WEhHoEorWFohUTQ&oe=6ACA4A9D"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adiai1hbNDoQ7kNvwFmEYhC&_nc_oc=Adog91yl8sjJXGY7-OGTQYOPC2FnbCUL5hxmSZiuOpT-W-WCDgt5JX0Kj1cVUk6_lFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh5HnmnztKN9rq4pOg2cUhe8y39WYactv49Fd64vOXuA&oe=6ACA7036"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHvYeplZjvEQ7kNvwGAN8-9&_nc_oc=AdoyuqvEBGllksu7BWrnROHRD0J_OsjNl0u2fXfaQYvbObrHr3rCa4v1g1eMWnCBPz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdXtQ4LCm2FIIn_X_RwMN0GVZsGdZYBLN0frVZk6Gh6A&oe=6ACA4F86"}, {"file_name": "ss_991.png", "id": "559712175526978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982476_559712178860311_7558449247813357588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEmc5IncMrYQ7kNvwG1RWDo&_nc_oc=Adonvu6nrw-SWBx9eh0OKpUxf_jVeT_vNGTkgvq_BpsyDkw_SdalIuvt9ucVLcT9Gvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN0yTK4ao2-1NzMCtY4Zr91ld2YZFfHLRzTQGGoo5wFQ&oe=6ACA73C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art-landscape.png", "id": "841445067145469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_841445070478802_1771571236055123097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLT7aQgPgMcQ7kNvwH77RwS&_nc_oc=AdqrQrxirb1qOnux5F8yquitAcrm9qk056vzpbYAyMZEVqSKe9qC9xHVrL-PpZZYUsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb0ZMtkq-mnbgjujqeMqt9KYjq-1wqP3LaqH6vMUv_xA&oe=6ACA4539"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nThe main goal is to challenge your friends in the virtual world. Jump into a Custom Game to play with friends or other opponents. You can stay in contact by using the Voice Chat.\n\nDo not have available friends? Go toe to toe against random opponents in Quick Play mode anytime and beat your own scores. \n\nWhat makes you a fan?\nThe Wild West is just the first chapter. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG\n\nOriginal price is $12.99, this $6.99 available only for limited time.  ", "short_description": "Would you like to challenge your friends in an easy, cross-platform (cross-play) multiplayer VR game? Do you want a minigame set  which is quick and easy to start? Don't want to waste your time on long stories and settings? \n\nWith the newly released season 2 of Toe To Toe, you can now challenge others in 7 different games. The voice chat lets you stay in touch with your opponent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "37440400758
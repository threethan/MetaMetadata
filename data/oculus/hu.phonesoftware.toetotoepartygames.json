dqw-ujfmXMT3_5YwVYZ2VRVdrdsG7C8k6XcOevKcer9skhdOeIEX0DQl3I1mMylUtU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XOBgbMGm5dN2zQNjYKSZvUHYzyeKq6mR1Or0WWe77RQ&oe=69E2429D"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ8AzlwY2E0Q7kNvwGdfqid&_nc_oc=Adqo3LnYj3MN1cUs8z4GHHtZj7tRNhNVOb7Tokg9ZIi_LM5NfXDs9Ujkcv6aTHn6UYI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kEshv7iTEg80D4peDib_gvHU2BtRt2l6F5BfsBBz21w&oe=69E22FF6"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-w7me2EwgwQ7kNvwHkOUTW&_nc_oc=AdpsltIJZ3zksFYv8MSUTXTsMOgWAZtGEbUq3rZOlvTGd2_DpN0HnzapPtBrsb2vtCQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L1BYqK4W_Iai46IMEf6zS9ytJgupvMyqViY4Eqs2OyA&oe=69E24786"}, {"file_name": "ss_991.png", "id": "559712175526978", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982476_559712178860311_7558449247813357588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9Ye2npr_oQQ7kNvwGwLOMb&_nc_oc=AdoJUf15eL_8mmQcEtOIkeTbh35HW1x05EUsgSb7EmTalv0rj9d3h2-ZxRW84yzVi7c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sTBh1PDVCzDnvsaG0McOF4ofcjVjjogSg95HBS52NiQ&oe=69E23388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art-landscape.png", "id": "841445067145469", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984446_841445070478802_1771571236055123097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2w-5McJMIMQ7kNvwGD-R7N&_nc_oc=Adr7CX3wBA8dC7lqRtq4_0R694HTAKKDArr4zTgiF0wDETgA4ii95htuwJLT9tELpeg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K_MAUDhpyNWQHBqypkLuhJbew-R7pfJAO9DjtqmKvEg&oe=69E23D39"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nThe main goal is to challenge your friends in the virtual world. Jump into a Custom Game to play with friends or other opponents. You can stay in contact by using the Voice Chat.\n\nDo not have available friends? Go toe to toe against random opponents in Quick Play mode anytime and beat your own scores. \n\nWhat makes you a fan?\nThe Wild West is just the first chapter. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG\n\nOriginal price is $12.99, this $6.99 available only for limited time.  ", "short_description": "Would you like to challenge your friends in an easy, cross-platform (cross-play) multiplayer VR game? Do you want a minigame set  which is quick and easy to start? Don't want to waste your time on long stories and settings? \n\nWith the newly released season 2 of Toe To Toe, you can now challenge others in 7 different games. The voice chat lets you stay in touch with your opponent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "37440400758
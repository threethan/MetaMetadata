dpBgjYr57qyI_iZ2c0v6cDsn2mQ1uHqIuH1c4LdJmIBqNTE0DfDiuYK_Tkj-_COU5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O4LD-TZ2d6aMo7XmjY63QLgOs7AXZA0d_wOUsVIWr5w&oe=6A33FF9D"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXtfGeCEn6gQ7kNvwFTwSHw&_nc_oc=Adpc3edyVJoWbdjZ16f0bBhad4SL2VZ6J_9CaVikSGdGcu_hoEFOhV7OcwUB3m1--SI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z42K0C5EyXX9FaFQ7-T42zkvY7ut80NArF5ywZy3_Gw&oe=6A33ECF6"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hgtz3fr1Nh8Q7kNvwHRwqL3&_nc_oc=AdoKBQghf4_EsSF1IWb-Q69Nclg8gHwOKWIWrRseHcIRpv9vGDj0Ig2ah6qqZ4mg8UM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-ixma0bE9XiZVSmIyISH_akqoTh_nQVHkzkfgZW8gcQ&oe=6A340486"}, {"file_name": "ss_991.png", "id": "559712175526978", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982476_559712178860311_7558449247813357588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHpjkGwFSXcQ7kNvwECn_CE&_nc_oc=AdrrcTQC-0aGM3mhFXTwEZ2e9EIlh6jDiZXJxfQxxgXy-EQdSCfp14uR7qAAh9RxdlM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XPWpr2Pm-mDwjVe0bTKI65mxesIGaLGDu1F_AmCU6TQ&oe=6A33F088"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art-landscape.png", "id": "841445067145469", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_841445070478802_1771571236055123097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-JZMBFEKJoQ7kNvwEEaKIC&_nc_oc=AdrtsHoup_yG03w5n8CS6yeIZejYN_bTufN_ied6wXflJCDWn84fRWXVswRzVK9jlK4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e3r0nnlEf2HmW8EVZgIiFjRt4YPTcaM3Yy-YjZxWhdg&oe=6A33FA39"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nThe main goal is to challenge your friends in the virtual world. Jump into a Custom Game to play with friends or other opponents. You can stay in contact by using the Voice Chat.\n\nDo not have available friends? Go toe to toe against random opponents in Quick Play mode anytime and beat your own scores. \n\nWhat makes you a fan?\nThe Wild West is just the first chapter. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG\n\nOriginal price is $12.99, this $6.99 available only for limited time.  ", "short_description": "Would you like to challenge your friends in an easy, cross-platform (cross-play) multiplayer VR game? Do you want a minigame set  which is quick and easy to start? Don't want to waste your time on long stories and settings? \n\nWith the newly released season 2 of Toe To Toe, you can now challenge others in 7 different games. The voice chat lets you stay in touch with your opponent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "37440400758
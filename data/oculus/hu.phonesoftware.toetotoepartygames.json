dqm5mf9XoGIsLnjW0X6_ePQ8pXPfBsA4RfpppfHWo_15bKPdvzrUr0vgIK6jR1Y1wc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rRBlnnJpXZAH0PRV_z45aQM8wpoiGvC386GKcb4-9-Q&oe=69EF719D"}, {"file_name": "2_16_9.png", "id": "1057517624803636", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75404375_1057517628136969_1969779022922632259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJFtj8-Y8T4Q7kNvwG3sG3q&_nc_oc=AdorgHcbHG6Vp3vy0Pe8CElXn_An966IuxU1SVE3-AmIasbRFzwixm0mP8sQfB93-kY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Psf9qyNjOHlh-jHfGCWh4KhwjI_yA17jaFAoq2ses_g&oe=69EF5EF6"}, {"file_name": "ss_94_oc.png", "id": "707878690240004", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75443242_707878696906670_4307156997871460807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNl4ydZzZg8Q7kNvwE65_bX&_nc_oc=AdpLlk-Wg0cTglhQnhLDiNyeqcsdLjv5TG3QaTBVONl5ESMMFSCx4IecsrRYKk1LVl0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1G-vYi1u7Aopug-NQ2gU2jNhAC2CgkqWIK9QVMr1Eifg&oe=69EF7686"}, {"file_name": "ss_991.png", "id": "559712175526978", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982476_559712178860311_7558449247813357588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqwRNn9KC_EQ7kNvwESAhEf&_nc_oc=AdoAw83woxMBcePeIcym-fhpBYIwwvJBEV4xNvvdvA-4AxT7qCqIcm-w6Koj7pbsEas&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dG7HMJHU-KP175ASUq2DVXh4NJ0TKnV3rflLJSyhVxw&oe=69EF6288"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art-landscape.png", "id": "841445067145469", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_841445070478802_1771571236055123097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsS7PSMWi8YQ7kNvwG3FDhf&_nc_oc=AdpWvTZhF7xKY_fEaxIkt4Dbr38iKzb9NMGoxCwQ37OO_Z4-bH-k7nH59WU3OkINy2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UJZLBgoKNPf5x8a06j5QAxyNqxrX-3iuIWiLxfR4sAA&oe=69EF6C39"}, "display_name": "Toe To Toe Party Games", "keywords": [], "long_description": "Toe To Toe Party Games\nThe game consists of unique minigames set in various styles in which you can go toe to toe against others or challenge yourself. \n\nSingle-player\nHere you can test yourself and try to beat your own high scores or go toe to toe with others by passing around the VR headset so everyone can make their own mark on the local leaderboard.\n\nCross-Platform Multiplayer\nThe main goal is to challenge your friends in the virtual world. Jump into a Custom Game to play with friends or other opponents. You can stay in contact by using the Voice Chat.\n\nDo not have available friends? Go toe to toe against random opponents in Quick Play mode anytime and beat your own scores. \n\nWhat makes you a fan?\nThe Wild West is just the first chapter. Where will the next episode take you? Be surprised!\n\nPlease keep in mind that the game is currently in an Early Access state! See more information on our Discord channel https://discord.gg/JxYDYp7dXG\n\nOriginal price is $12.99, this $6.99 available only for limited time.  ", "short_description": "Would you like to challenge your friends in an easy, cross-platform (cross-play) multiplayer VR game? Do you want a minigame set  which is quick and easy to start? Don't want to waste your time on long stories and settings? \n\nWith the newly released season 2 of Toe To Toe, you can now challenge others in 7 different games. The voice chat lets you stay in touch with your opponent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://www.toetotoevrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "37440400758
CQTtnhB9ph-FM_guBeSDg&oe=6B0EF265"}, {"file_name": "meta office.png", "id": "986293316055542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982679_986293319388875_6906476389505861469_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZErsW7SmXEQQ7kNvwGUQ_2C&_nc_oc=AdpE7ORXfKTNbGh1w2p0HkGZ55ZaUfUuCbrbrmRe3I0lc3HfrVDTThnMjm4y6ctcmkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVv4zirZmBchUOaFu6369DPUf7juL1HhTbX0Uz5O4Kqgg&oe=6B0F2316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MicrosoftTeams-image (47).png", "id": "819668109131740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031575_819668112465073_6906254603278164332_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wpns8qOFHnQQ7kNvwH-p9Z4&_nc_oc=AdpVLKxUxuTU8B1QlcBV4RGyGVS6d8Fun0YPrnRVlMgPiTolp2GXQPAudqibaVB-t0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJAGAFMgxUiX0PEVttPDD0p6q_E7jPBmUJmSN9Lq-6Lg&oe=6B0F21BD"}, "display_name": "Meta Presence", "keywords": [], "long_description": "The first business-oriented Metaverse platform is here to grow your brand and accompany it in the Virtual Transformation. A bridge between physical and virtual world, able to revolutionize communication and the way of doing business.\nThe platform provides companies with an evolved virtual space where they can create value by taking advantage of the opportunities of new technologies.\nFrom industry to sales, from meetings to training, Meta Presence\u00ae offers the virtual tools best suited to your business projects. A ready-to-use platform where you can meet and interact with people and objects: the evolution of remote meetings.\nMeta Presence\u00ae combines in a single platform the persistence of the virtual world, the potentialities of digital twins, the functionalities of new technologies and the strategic possibilities of data analytics.\nCreate your avatar, connect with other users and start a new experience: download Meta Presence\u00ae!\nVisit our site https://www.techstar.it to learn more about the Metaverse. \nContact our Metaverse Enablers https://www.techstar.it/contatti/ to realize your projects and create your own Metaverse.\n", "short_description": "The first business-oriented Metaverse platform is here to grow your brand and accompany it in the Virtual Transformation. A bridge between physical and virtual world, able to revolutionize communication and the way of doing business.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.techstar.it/en/privacy-policy-app-meta-presence/", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.techstar.it/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "819771662648260"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "914562974396858"}, {"status": "PUBLISHED", "id": "288166050216141"}]}, "baseline_offer": {"id": "914562974396858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771930200, "status": "PUBLISHED", "id": "914562974396858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29204255889197353", "version": "3.2.3 "}, "id": "6322125377903144", "channel_name
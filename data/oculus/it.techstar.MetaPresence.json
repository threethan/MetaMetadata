1JtJIjWH4EPpGUDTCyqJAF5sCFL3N8_fshM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3dN0tvXt7z_ms9Mf1_Q96FyjIm9pKSgv98Vz8WbeF6g&oe=6AA572D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MicrosoftTeams-image (47).png", "id": "819668109131740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031575_819668112465073_6906254603278164332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgHRZd7PQqQQ7kNvwHrpcyV&_nc_oc=AdrcMZp_cJe6fLLS5GtG9S6Ds6FzAKHWatSmz95LLA1Jo4vUBCqDia-itlUGnr3ZNh8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLINSjQR23nf4-SLqxRrebMh4WyveF3u7_ZiNifDVkBfQ&oe=6AA5717D"}, "display_name": "Meta Presence", "keywords": [], "long_description": "The first business-oriented Metaverse platform is here to grow your brand and accompany it in the Virtual Transformation. A bridge between physical and virtual world, able to revolutionize communication and the way of doing business.\nThe platform provides companies with an evolved virtual space where they can create value by taking advantage of the opportunities of new technologies.\nFrom industry to sales, from meetings to training, Meta Presence\u00ae offers the virtual tools best suited to your business projects. A ready-to-use platform where you can meet and interact with people and objects: the evolution of remote meetings.\nMeta Presence\u00ae combines in a single platform the persistence of the virtual world, the potentialities of digital twins, the functionalities of new technologies and the strategic possibilities of data analytics.\nCreate your avatar, connect with other users and start a new experience: download Meta Presence\u00ae!\nVisit our site https://www.techstar.it to learn more about the Metaverse. \nContact our Metaverse Enablers https://www.techstar.it/contatti/ to realize your projects and create your own Metaverse.\n", "short_description": "The first business-oriented Metaverse platform is here to grow your brand and accompany it in the Virtual Transformation. A bridge between physical and virtual world, able to revolutionize communication and the way of doing business.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.techstar.it/en/privacy-policy-app-meta-presence/", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "https://www.techstar.it/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "819771662648260"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "914562974396858"}, {"status": "PUBLISHED", "id": "288166050216141"}]}, "baseline_offer": {"id": "914562974396858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771930200, "status": "PUBLISHED", "id": "914562974396858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27981748108114810", "version": "3.2.0 "}, "id": "6322125377903144", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6161884280527840", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27981748108114810"}, "release_status": "RELEASED"}, "bi
le_name": "ScreenShot3.png", "id": "1054603621689894", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984472_1054603628356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKN63lMa6JwQ7kNvwGRxFPW&_nc_oc=Adp52O9Pn9A6wGAHlsekZywGnIz9Rg3xEZJAenFclYW-Nf_wixMVJggIQooLosVUuGQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAmu-GKgao0ewR-63-W9pGAdAM2LrP1B-b-pDQKXpOmA&oe=6A8D7E6F"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baYmFCdqPPAQ7kNvwH19O-i&_nc_oc=AdoQRFzYpsxRC-V22J4DRva2UScwlMQjIVuOvUKYj5_0vT6tVX27tRyBPdMBz41hpxk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_eMqlGrIBHzSW4GXG71U0ZjvB5U57B8Or8UJUj_HnIQ&oe=6A8D7446"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUIFnb6_-D8Q7kNvwFWFlQd&_nc_oc=AdoY-IYjHl_y_IpAK7wYEKVwvLL3lKUZG5xqc2k3tE9YDQxAox08nmzDQRo1lihQerQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHk9pgdmdEYE542ct97FH_WHvIRFXu02ezoDMFhKGLOg&oe=6A8D66CD"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7X3AZLJun0Q7kNvwE1iGm-&_nc_oc=Adp7ZxrqLy9wjmnEtzhCVRwAkxMiR_sf84vD9ujQNGp3NgLYfeIH1cH2XujXfgz6p8U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFQb9BI7eUuMpuE0L1q4ZTyjxnBlSnezSQ8vVDY-K8jQ&oe=6A8D70E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GladiusQuest-Closing.png", "id": "1372007076482071", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001663_1372007086482070_5314172067165366439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgAWlSWrjYMQ7kNvwENJrca&_nc_oc=Adpwsd0NR2yfUAeNImQWkPdxeYPXHAPz827Gz0HNdchTDvqc2C4EU2RNndF5SJ9k5h4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKwif24YI6RYJQ7K6qejNKEOS5bcQ40dC0zsnsfODUbA&oe=6A8D8B65"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThe game is currently under early access in both PCVR and Quest, and we plan to keep adding more features in the coming months. The game is fully playable at the moment with several arenas, game modes, different enemies weapons, shields, etc.\n\nThe game now has 2 main sections:\n\n1) The Arena: Public fights with romans watching the game and score ranked in the global leaderboards. In the arena the public is the key, and will give you presents if they like the fight (parrying, hitting the enemy, grabbing or dismembering give you points), and also win fame to climb up the ladder. There are 3 challenges/arenas.\n2) Custom Mode: This mode allows you to tailor the fights.", "short_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualage.io/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
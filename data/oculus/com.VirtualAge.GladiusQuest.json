84472_1054603628356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJVdwFvMGeUQ7kNvwHma5Dn&_nc_oc=AdkulNQ1Rx02Wg2sEn3qi_LRGGE6E6n1JomDwCpuHo9Qm03x74iJgvak3TLEROff8ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUOeNRrZOp2I17gwjihFfGatn4UNb1xuGQ04BohDkQ0w&oe=69B2A56F"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afJUBVLgYg4Q7kNvwHGZ0yt&_nc_oc=AdmEi0dNGFKYyZbvoKGGvHu6ItfBTZJonPhyhvR2vByVLAMcsT1269Di6hlNtR_xa1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTt_ybnqsClhyvQerIaxkMFwffRrEcm1MLsoN0j0PEIQ&oe=69B29B46"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu9SLF-Eqx8Q7kNvwEGNM-v&_nc_oc=AdmWQ15f7Cxg3K_pKcdCSM3WpKWbxR9OelC10x4dr5uvmicgnccJO4eOuznCmODZVH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFQk1Q7o6bTV-JGh2keu1mqroMy0d21EHaUCMCrkb00g&oe=69B2C60D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=is2htoXBPnkQ7kNvwGsO7Wt&_nc_oc=AdksN0bJFFPPES-yZWiMlmEobhisOUPKCyj3jzyvag2ocrKHeCzCVABQTlwKcJllr9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk8qpGFROXOdI0dAMFSUYPmvtQmUtZ7hPTQneTKnSMhQ&oe=69B297E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GladiusQuest-Closing.png", "id": "1372007076482071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001663_1372007086482070_5314172067165366439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4eYoA-XQucQ7kNvwEG2R--&_nc_oc=AdnkZF3rEbcPpSY6mhjAqeFyPUlqJlL22g9zXZrLFEhk3wGO3yj1PSgS7OPAEVW44po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5dgS6BGXmkB-qX5HAd_kkyvlWKABebJDleoRAKZDgdg&oe=69B2B265"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThe game is currently under early access in both PCVR and Quest, and we plan to keep adding more features in the coming months. The game is fully playable at the moment with several arenas, game modes, different enemies weapons, shields, etc.\n\nThe game now has 2 main sections:\n\n1) The Arena: Public fights with romans watching the game and score ranked in the global leaderboards. In the arena the public is the key, and will give you presents if they like the fight (parrying, hitting the enemy, grabbing or dismembering give you points), and also win fame to climb up the ladder. There are 3 challenges/arenas.\n2) Custom Mode: This mode allows you to tailor the fights.", "short_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualage.io/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type":
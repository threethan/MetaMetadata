8356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TO2XnwYoV8AQ7kNvwESPJjx&_nc_oc=Adm82b0Bs3Ml5izNvV8co9EdWlZDanuSyQJ_6f4s_FCyGS2D4neJwoms393lO2E7eNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuG-q3WkZw3dMoSbOIauA895s_l188bdyvvuh028-uB1Q&oe=69A2D36F"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEErwZ_vDIsQ7kNvwGI_eWS&_nc_oc=Adm9bg9lWyQOhU1wWxhqUvokAFLrFUwpLsrp1A15j_hF1uDQ3g-MgVOaXFALh23qxx4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnY0C7OYVhIF4V_I1U7ttim_UI3d3yZVpgJrZYQsJCBQ&oe=69A2C946"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn-6lAFowlQQ7kNvwEZVUtR&_nc_oc=AdnpTaR2ycq2ojDXBUQatHRlKCKFJBFCnAdawZ9OiBYlSNN33ujbsHzrIymV3MkCA40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstoxbAqthpaE529M-60UgEJkupFqzS-0XMDqX7SixE_Q&oe=69A2F40D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5w5cW82_vAQ7kNvwFnODWS&_nc_oc=Adkz-G0hfGTj1MnGQCOsHWuej4PxiWauU-K1LXZtx74DLCghPmHKewyG9KV4Kcd0pp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudIuCD15QV3W-SAK173v4As0LLngktobG5OI-xy_ar3Q&oe=69A2FE28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001663_1372007086482070_5314172067165366439_n.png", "id": "3940884882822185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391798_3940884886155518_1644091713839791640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5Sb-tCe_4YQ7kNvwEZIAGQ&_nc_oc=AdmZbapVU7-Jma5FmrPaFAQbDRYzwVUzEV6t7VeEkvkiBBdf7VTJ926S0Vsd4gH1ga8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttQ57UwuVqp7Sdx8CDT9lrjUgw_P2-nIm1gy6hSksw6A&oe=69A2DE83"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThere are 4 different sections:\n1) The Games: Survive for 7 days in the glorious Colosseum fighting the most formidable enemies in a variety of themed stages (Egyptian Temple, Naval battle, Maze, \u2026).   \n2) Arena: Compete on the global leaderboards on 5 different challenges (endless, weapon master, bridge defense, market and chariots) and become the best gladiator in all of them.\n3) Training: Completely customizable game mode where you can choose weapons, enemies, and duration of the game. Players can fight solo or in teams with other NPCs. \n4) Community mods: Play scores of community created mods, from deadly beach ball guns and giant spoons, to ancient pyramid reconstructions or forge arenas.\n", "short_description": "With Gladius you can travel back to Rome in 60 B.C. and become a real gladiator. Hear the thundering sound of 10.000 Romans cheering for your every move, feel the rush of the final blow to your opponent, and experience the ancient roman arena in all its glory. In Gladius you fight epic battles against gladiators, legionaries, tigers, crocodiles, minotaurs and much more!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualage.io/privacy-policy-gladius", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {
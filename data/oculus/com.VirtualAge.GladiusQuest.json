YSpg1tDwW_TlIx3Xx9h8A&oe=6B0336E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001663_1372007086482070_5314172067165366439_n.png", "id": "3940884882822185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391798_3940884886155518_1644091713839791640_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v69UnaYFfsQ7kNvwEtQj-J&_nc_oc=AdoWrrs0Ejjx6ThtAN7HzpYPHJOmJrrP-p3pKU-Rky_UOCpCkH2qsMJrDVGHCm0BMrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI62G5EXIS6ejPyYG2cNlhwUqw6Rvt6rXLIih7EjLbyA&oe=6B031743"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThere are 4 different sections:\n1) The Games: Survive for 7 days in the glorious Colosseum fighting the most formidable enemies in a variety of themed stages (Egyptian Temple, Naval battle, Maze, \u2026).   \n2) Arena: Compete on the global leaderboards on 5 different challenges (endless, weapon master, bridge defense, market and chariots) and become the best gladiator in all of them.\n3) Training: Completely customizable game mode where you can choose weapons, enemies, and duration of the game. Players can fight solo or in teams with other NPCs. \n4) Community mods: Play scores of community created mods, from deadly beach ball guns and giant spoons, to ancient pyramid reconstructions or forge arenas.\n", "short_description": "With Gladius you can travel back to Rome in 60 B.C. and become a real gladiator. Hear the thundering sound of 10.000 Romans cheering for your every move, feel the rush of the final blow to your opponent, and experience the ancient roman arena in all its glory. In Gladius you fight epic battles against gladiators, legionaries, tigers, crocodiles, minotaurs and much more!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualage.io/privacy-policy-gladius", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9095112587270394"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031520_2128934114211320_7323585933592678260_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUrmQtV3MloQ7kNvwFumpkT&_nc_oc=AdoR-4dj3ZEVKOhmbSOlFyMmueQv3lb_GI81R1RiyfElzB125s1eJMupPx3W6V15zws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd8TpQZX-Eu-BKf7PKztP0eZr-zMx3NFiQbR1LewPB-g&oe=6B03196E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gladius", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1620693398, "lastRevision": {"nodes": [{"id": "40
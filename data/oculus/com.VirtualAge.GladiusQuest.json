_i3Ib4IYUQ7kNvwHRVNhi&_nc_oc=Adq-LbTZHnE1apmFtsIyFf0ziYiKyxO2oKCkWBXPQCoARbMiWIxZEYHr7jgXef9VGQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXNO-A80Q-V9xSueH9IsGdQlUJp5Z4dgfJxtF9a0iHPw&oe=6A7C67E5"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThe game is currently under early access in both PCVR and Quest, and we plan to keep adding more features in the coming months. The game is fully playable at the moment with several arenas, game modes, different enemies weapons, shields, etc.\n\nThe game now has 2 main sections:\n\n1) The Arena: Public fights with romans watching the game and score ranked in the global leaderboards. In the arena the public is the key, and will give you presents if they like the fight (parrying, hitting the enemy, grabbing or dismembering give you points), and also win fame to climb up the ladder. There are 3 challenges/arenas.\n2) Custom Mode: This mode allows you to tailor the fights.", "short_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualage.io/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
8356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQsvYleBGvwQ7kNvwGtzqRH&_nc_oc=Adk5sT828vbAWkFVmPziOXFKRi68Seg8QIfVYwjH3dPc_webt7SRCNjkKftP7AAPq7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaGtcy1w-n4W1Xa4uTonS5-zFzzfqZDPlZtN3r1kR0Og&oe=699D8D6F"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX0753lUf0cQ7kNvwEjlIR8&_nc_oc=AdnzwYK7K2k4QPSBN2-xRuWcY0_S1hgqFNHcXQB-phZp3-88nSnhy1ZUDFChQYWyV3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQvrCi0mouyOmBHFMIB5orQZqr9wbxc32SLHBF0H7D7w&oe=699D8346"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Zxv5LGxLcQ7kNvwE9-0vX&_nc_oc=AdkpeN5N8Q7slfs8XEvuDFDR8qrCqExwabiYdhgmsegL2VXCKzjOxWpspWSm0kAg74U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afscb9ADi2O3HRkJVter-eMmTugnA7ap7RJxIHEVEAqQ1Q&oe=699DAE0D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa6r2aM1P44Q7kNvwF7MJkS&_nc_oc=AdlPLAUcYsoUw-TqL11iYr-vLf9iAxOzk3Dq997GiFuwl4dERLicsqe-l1_eXgrnoKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCzZDv0PIZzGZS1FYpvmIf7-ZoiSIvEeqSuAcsjzJLaw&oe=699DB828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001663_1372007086482070_5314172067165366439_n.png", "id": "3940884882822185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391798_3940884886155518_1644091713839791640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg7N_iaOyLgQ7kNvwFPaT6J&_nc_oc=AdkffwMyrzfTlf_4IeO66eoLGWSdkYH8zArvpS7sf49YePAs8wQABooydz0Vpa-h0fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftS5L1wklCZuo9O9s0xIwF4AY4C92ocalMIwDnfSwjhUQ&oe=699D9883"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThere are 4 different sections:\n1) The Games: Survive for 7 days in the glorious Colosseum fighting the most formidable enemies in a variety of themed stages (Egyptian Temple, Naval battle, Maze, \u2026).   \n2) Arena: Compete on the global leaderboards on 5 different challenges (endless, weapon master, bridge defense, market and chariots) and become the best gladiator in all of them.\n3) Training: Completely customizable game mode where you can choose weapons, enemies, and duration of the game. Players can fight solo or in teams with other NPCs. \n4) Community mods: Play scores of community created mods, from deadly beach ball guns and giant spoons, to ancient pyramid reconstructions or forge arenas.\n", "short_description": "With Gladius you can travel back to Rome in 60 B.C. and become a real gladiator. Hear the thundering sound of 10.000 Romans cheering for your every move, feel the rush of the final blow to your opponent, and experience the ancient roman arena in all its glory. In Gladius you fight epic battles against gladiators, legionaries, tigers, crocodiles, minotaurs and much more!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualage.io/privacy-policy-gladius", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {
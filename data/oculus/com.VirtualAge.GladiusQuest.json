8356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQsvYleBGvwQ7kNvwFRziXb&_nc_oc=AdnFtupBM4hb7t_4iIeJJzOhoWvO0hb11_DOB_eosetiU2bArdX4xDDTvH8NKEZj0Mc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-Ireym0ItA2Egd1A4j6AxNU0-uhaVFSJZw_SoO6SX_Q&oe=699EDEEF"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX0753lUf0cQ7kNvwGgm307&_nc_oc=Adlmu65lTM_ASH6L5L6jevc8oVbreaWOTzyqFwkvQKj5crdUMv7EZ4-MR3QXm8M_qEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvEjgSbabBcWqjBp2T-ng9mX7fFMLFEXL4TJfnRWSM2dA&oe=699ED4C6"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Zxv5LGxLcQ7kNvwEcM763&_nc_oc=Adkr5DwvcapI5qey5b8EbmjlVmyho6q_JJjR1oA339B3HkSLDPCVxh1r64v66fSsg4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu1jsJgWai3lVB4bRAbxRchrBGX1HjPBa1ETQYGboimUQ&oe=699EFF8D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa6r2aM1P44Q7kNvwEED2LQ&_nc_oc=AdkxWRBXZbqLZkYl2WSSi1uJnaYUZVEFLASoHrB8gwqGpUcUjnnqiAHYUZKlnqmkLoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvPDfJj4oOvoRGCvdjQZnJBk3LgwX-7gMDQcbTMBj45Fw&oe=699ED168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001663_1372007086482070_5314172067165366439_n.png", "id": "3940884882822185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391798_3940884886155518_1644091713839791640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg7N_iaOyLgQ7kNvwEljRg-&_nc_oc=AdlYgVzUotdLan8lkHdbFx5pOJRWTkYoV36FjzV0xt9uSEfA4yUfBGDixF9VzzJDtZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft8v6Ac11IGG-YsZX8-kC6vyzy-aKqzioanzkIJW06aaw&oe=699EEA03"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThere are 4 different sections:\n1) The Games: Survive for 7 days in the glorious Colosseum fighting the most formidable enemies in a variety of themed stages (Egyptian Temple, Naval battle, Maze, \u2026).   \n2) Arena: Compete on the global leaderboards on 5 different challenges (endless, weapon master, bridge defense, market and chariots) and become the best gladiator in all of them.\n3) Training: Completely customizable game mode where you can choose weapons, enemies, and duration of the game. Players can fight solo or in teams with other NPCs. \n4) Community mods: Play scores of community created mods, from deadly beach ball guns and giant spoons, to ancient pyramid reconstructions or forge arenas.\n", "short_description": "With Gladius you can travel back to Rome in 60 B.C. and become a real gladiator. Hear the thundering sound of 10.000 Romans cheering for your every move, feel the rush of the final blow to your opponent, and experience the ancient roman arena in all its glory. In Gladius you fight epic battles against gladiators, legionaries, tigers, crocodiles, minotaurs and much more!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualage.io/privacy-policy-gladius", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {
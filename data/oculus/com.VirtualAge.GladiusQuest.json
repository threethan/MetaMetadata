8356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWwTAMEpGvgQ7kNvwEjEc9J&_nc_oc=Adl_xIyonxRJCkpiTSzSymafvVJ-4kr5jQ0iuEzER4ynlQZkgzpCQU7ZBy_K40cEEHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPCLIuIQiiteszKNQt3DsURRaRMzEUwSxUC7wIHWScfg&oe=69A6C7EF"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfHIYe2TFRcQ7kNvwE4y_QH&_nc_oc=AdkZ_-kdEJXEpLgXkHOFQzaEkjkNsj9WwHUUgw5JOmbRvZTJ1qIuAWaN5BimSpOSpB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjNWtTTnWSx58rQC1QVeczZnCze7spLfZpDrGIfVD99Q&oe=69A6BDC6"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMIjxC6aH0sQ7kNvwHjq2zJ&_nc_oc=AdmW-5YLdWlLz5BNg-uhhUA94scRKld2MBY8oqxyDgPhgunsnVrXh8WKbDXh174QsrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_V41iCxBwMW8tEfw8AwkKTUAYntn0XXI_YiIZZQXJLg&oe=69A6E88D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD99FRttancQ7kNvwGzpAYI&_nc_oc=Admgr-BeoiTEMACprHZXKtx0DAzKpe68iTFePLrWOp1GA5c47KCaJ6NJBG9gxImZFCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUkxDeUfRvI32e-5cfgyWtyj7o_FMASBtMRJ_4q12viA&oe=69A6BA68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001663_1372007086482070_5314172067165366439_n.png", "id": "3940884882822185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391798_3940884886155518_1644091713839791640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb8wmTRfj4sQ7kNvwHZVXbc&_nc_oc=AdmMMjvItHzs0pOCfSAUfwor6MRWU4f75SgAiB2z2K8GTDpaZ3yNqXTeBt_49DrX0Os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdBBDU6GC-2oFCs0tGJw42w9sColRtO2VwRYAl_xGHhw&oe=69A6D303"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThere are 4 different sections:\n1) The Games: Survive for 7 days in the glorious Colosseum fighting the most formidable enemies in a variety of themed stages (Egyptian Temple, Naval battle, Maze, \u2026).   \n2) Arena: Compete on the global leaderboards on 5 different challenges (endless, weapon master, bridge defense, market and chariots) and become the best gladiator in all of them.\n3) Training: Completely customizable game mode where you can choose weapons, enemies, and duration of the game. Players can fight solo or in teams with other NPCs. \n4) Community mods: Play scores of community created mods, from deadly beach ball guns and giant spoons, to ancient pyramid reconstructions or forge arenas.\n", "short_description": "With Gladius you can travel back to Rome in 60 B.C. and become a real gladiator. Hear the thundering sound of 10.000 Romans cheering for your every move, feel the rush of the final blow to your opponent, and experience the ancient roman arena in all its glory. In Gladius you fight epic battles against gladiators, legionaries, tigers, crocodiles, minotaurs and much more!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualage.io/privacy-policy-gladius", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {
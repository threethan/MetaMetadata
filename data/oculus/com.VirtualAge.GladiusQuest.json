84472_1054603628356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5HNcdnmQvgQ7kNvwE_8mqs&_nc_oc=AdlKICdjgphfojeJeaM4y7uYLqHIkHycG9AvJcO7TjlvRC_3BmUsw6KqChDySO4dCB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV8AMvj-Xyw6y6IrRo_DNtNvfHk928P02S3W0GyzRCBw&oe=69AEB0EF"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMxqoAavNNsQ7kNvwH2A8S7&_nc_oc=AdmYnLs1Ldi7mL2q9ZUlI1pSm_9vXe1-XPhMKrKu7IV17BggxODVmgbltHJw5iFc4HM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNh0ZjO7WBXyiO9cZikFS_2-l2xPi-f_mBUGfCxes2NA&oe=69AEA6C6"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm4P_mAlXvMQ7kNvwH1wt_d&_nc_oc=Adk5JWr6JVSmJP8Fq3x4Ad7ds1JDDHo3GZn9aF8YmgAw-qeoiWVhflYU6z6IlVU-Wms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvuQ2m27N9p8pT2DexxgxwFpeDFYtkQMmB9Jy-ozQJQQ&oe=69AED18D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFONkNMlASkQ7kNvwGGuGNr&_nc_oc=AdkO9k3SW0sgnto3CzYzh_WIrHGVYlpU_HoaBu67uyRcu6BPnfGj-6GLtrMUPAMmc4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUsJV17GyhGIuwm8qE2lvfFDcg8keflVQLr8BHJk76NQ&oe=69AEDBA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GladiusQuest-Closing.png", "id": "1372007076482071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001663_1372007086482070_5314172067165366439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crtAkRAAwgUQ7kNvwEmjAS2&_nc_oc=AdmvNGMtlaojeTNas_3aO0dmZKu97xskTFreyX6wcGI02CV7snzKDV8xgG-PXqtBt_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGZmyIH-FNtk8jcW1_y1C3DjsjgZIMiY1iDIT09vtPUw&oe=69AEBDE5"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThe game is currently under early access in both PCVR and Quest, and we plan to keep adding more features in the coming months. The game is fully playable at the moment with several arenas, game modes, different enemies weapons, shields, etc.\n\nThe game now has 2 main sections:\n\n1) The Arena: Public fights with romans watching the game and score ranked in the global leaderboards. In the arena the public is the key, and will give you presents if they like the fight (parrying, hitting the enemy, grabbing or dismembering give you points), and also win fame to climb up the ladder. There are 3 challenges/arenas.\n2) Custom Mode: This mode allows you to tailor the fights.", "short_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualage.io/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type":
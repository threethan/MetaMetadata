8356560_4836394825372043236_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQsvYleBGvwQ7kNvwFQBXxg&_nc_oc=AdkQdgsrfTMrqvRayGS8GieblJ0QYc-hs97FUJJ6MIVTqQQvwrvyNnc0W471yGzbevI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIX7Z1p1zDoRv4JzXXhi2sxJN8QlNRm3Ey5ExdzaQiBQ&oe=69A0306F"}, {"file_name": "ScreenShot1.png", "id": "1067269333754885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612003_1067269337088218_1452877915581870908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX0753lUf0cQ7kNvwE0PuzM&_nc_oc=Adl-w6tgG-Z7ztFGXPSTh4p5mByDTnB4eQuEZ2WM2q2bb12gOJMcncxykdXF5VfCxpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlpZqBqgdsPILDh6XeMI3yXJRP8ByJd02DSNweCHdezg&oe=69A02646"}, {"file_name": "ScreenShot4.png", "id": "116852753623537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031384_116852756956870_4127136699181986653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Zxv5LGxLcQ7kNvwHlhl4Q&_nc_oc=AdlZBDMYqP_DZl5m2ZC2vl-Y6W1xrDvijywlzbIhcNJ8z3M_a2IxqKBebZoCuAsedw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftF2ZKIMJuEBnXPt417I_pkRUZoKc8Ur0JaKkv126d3ZA&oe=69A0510D"}, {"file_name": "ScreenShot8.png", "id": "2793003064333049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa6r2aM1P44Q7kNvwH8zjLt&_nc_oc=AdnmyT7bUSmo1sKDjCz81ATutWIOJ7t9IWMze_FymnqgzlfENhJMX5LVGIkcpiHTnyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5dt8V3ALqZ9oMqxIn5hEjCCOlGkGOouHHszWzGe_VpQ&oe=69A022E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001663_1372007086482070_5314172067165366439_n.png", "id": "3940884882822185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391798_3940884886155518_1644091713839791640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg7N_iaOyLgQ7kNvwFI0Exz&_nc_oc=AdlJPgjnDJ_swjdgAVpwp5MZq3VHY8HTB3nVY8UIXJelayiZ2eCoNi5_xEc3U58gJlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrtrVtf20ngDE8j7tcMMLqwZdrWoIEt9kN9aj6n07Lgg&oe=69A03B83"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThere are 4 different sections:\n1) The Games: Survive for 7 days in the glorious Colosseum fighting the most formidable enemies in a variety of themed stages (Egyptian Temple, Naval battle, Maze, \u2026).   \n2) Arena: Compete on the global leaderboards on 5 different challenges (endless, weapon master, bridge defense, market and chariots) and become the best gladiator in all of them.\n3) Training: Completely customizable game mode where you can choose weapons, enemies, and duration of the game. Players can fight solo or in teams with other NPCs. \n4) Community mods: Play scores of community created mods, from deadly beach ball guns and giant spoons, to ancient pyramid reconstructions or forge arenas.\n", "short_description": "With Gladius you can travel back to Rome in 60 B.C. and become a real gladiator. Hear the thundering sound of 10.000 Romans cheering for your every move, feel the rush of the final blow to your opponent, and experience the ancient roman arena in all its glory. In Gladius you fight epic battles against gladiators, legionaries, tigers, crocodiles, minotaurs and much more!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualage.io/privacy-policy-gladius", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {
"https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031322_2793003067666382_6685623734664064903_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOKES-BJgw8Q7kNvwE3fKZd&_nc_oc=Adq1KCDQpOrxsggwEVW9wTkzp_3tJuGeN57pC770UHjm_b7pFTr4b8ZuYh-euNakl9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSZut1q6AvJ-VTjrevOF56hYSpg1tDwW_TlIx3Xx9h8A&oe=6B0336E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GladiusQuest-Closing.png", "id": "1372007076482071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_1372007086482070_5314172067165366439_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxnEez09M6oQ7kNvwHoxCAW&_nc_oc=AdowPA0QR_Pobci5O4i1-eZhjgwuCtr8W3V-iAVme4BBSeEKC4QSo9Sf9x-W7o39mtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK_piKLqhvuxLmt3cy45tAKT6DU-hJcLT3qGiGAf_4mA&oe=6B031925"}, "display_name": "Gladius", "keywords": [], "long_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!\n\nThe game is currently under early access in both PCVR and Quest, and we plan to keep adding more features in the coming months. The game is fully playable at the moment with several arenas, game modes, different enemies weapons, shields, etc.\n\nThe game now has 2 main sections:\n\n1) The Arena: Public fights with romans watching the game and score ranked in the global leaderboards. In the arena the public is the key, and will give you presents if they like the fight (parrying, hitting the enemy, grabbing or dismembering give you points), and also win fame to climb up the ladder. There are 3 challenges/arenas.\n2) Custom Mode: This mode allows you to tailor the fights.", "short_description": "Gladius is an immersive VR sword fighting game set in ancient Rome. As a gladiator, you will choose your weapons, train against different enemies, and finally fight for your freedom in epic battles against the mightiest warriors of the ancient world. Win the crowd and you will win your freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualage.io/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "VirtualAge", "support_website_url": null, "website_url": "http://virtualage.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4826664714115292"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PUBLISHED", "id": "898268826614747"}, {"status": "PUBLISHED", "id": "1042615231939043"}, {"status": "PUBLISHED", "id": "1841866713468814"}, {"status": "PUBLISHED", "id": "4477639419116421"}, {"status": "PUBLISHED", "id": "2144803366308823"}, {"status": "PUBLISHED", "id": "773770055556067"}, {"status": "PUBLISHED", "id": "1209704057941951"}, {"status": "PUBLISHED", "id": "2430115077402873"}, {"status": "PUBLISHED", "id": "816251021289797"}, {"status": "PUBLISHED", "id": "1514176752961568"}, {"status": "PUBLISHED", "id": "1109085197332539"}, {"status": "PUBLISHED", "id": "749205211028535"}, {"status": "PUBLISHED", "id": "1017582579897065
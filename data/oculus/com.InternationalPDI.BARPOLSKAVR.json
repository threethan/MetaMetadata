RSyP6IApeGM81uam8yWZ0K4LV-XzxlHY1GthHEH8A&oe=6A649D1A"}, {"file_name": "ZrzutEkranu5.png", "id": "713104347384833", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974745_713104350718166_2032432822338495135_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkcVrXJ_asMQ7kNvwGRobGF&_nc_oc=AdoQdKKWdkASaAEDKJlOYY8PdGnt4aMyhbMeNjPkKsW9YD8Ldtql5IfsLjOvi7Soqvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQH8sckuWDgXNj4volKSydjalfeLQz0KV1_ezBU8nQEg&oe=6A64B623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZrzutEkranu4.png", "id": "1123884471906672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1123884475240005_7407211244339623165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcBLKTCPzTAQ7kNvwE5iIsT&_nc_oc=Adp71_jWgrU8UQ8LO-5Iwj6xvfaSdA_JFiTi5K1WEFhfxXZfyWCaCVdwn0Gc055owHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDFoUeqwII2dJD2PvQcUCgh_zKYb2PhxqvOSj5bKau0Q&oe=6A64CAFE"}, "display_name": "Online Bar VR", "keywords": [], "long_description": "\"Online BAR VR\" is a cutting-edge social application that teleports users into a virtual world of entertainment and interaction. Imagine a nightclub of the future, accessible from your own home. The app offers visual and auditory experiences of a discotheque with advanced lights and effects. Users can meet online, create and customize their avatars, and fully engage in this digital realm.\n\nFeatures of \"Online BAR VR\" include:\n- **Tutorial**: A guide that introduces new users to the app's world, teaching them how to navigate and utilize its features.\n- **Jukebox Music**: Play music from a virtual jukebox where the chosen tracks are heard by everyone in the club.\n- **Desktop Streaming**: The ability to broadcast your computer's content and share your desktop with other users.\n- **Object Interactions**: Virtual interactions with various objects in the club environment.\n- **Games**: A variety of game options, including Texas hold'em poker, Ludo, pinball, online pong, and an innovative game of slashing blocks with a lightsaber.\n- **Miniature Train Set**: Constructing and editing tracks for a miniature train, with the ability to arrange and operate the trains.\n- **Racing Track**: Beyond the main building, there is a racing track where users can race virtual cars.\n\n\"Online BAR VR\" combines elements of gaming, social media, and music entertainment to create a unique platform for social gatherings, entertainment, and collective fun in virtual reality.\n", "short_description": "\"Online BAR VR\" is a virtual entertainment platform that allows users to interact in a club-like setting. The app provides virtual discos with music, avatar customization, desktop streaming, and a wide range of games from poker to car racing. All available in one integrated application."}]}, "developer_name": "Piotr Durczak IPD", "developer_privacy_policy_url": "https://ole802.wixsite.com/mojastrona/blank-3", "developer_terms_of_service_url": null, "publisher_name": "Piotr Durczak", "support_website_url": "https://ole802.wixsite.com/mojastrona/blank-1", "website_url": "https://ole802.wixsite.com/mojastrona", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "7231845900182522"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nod
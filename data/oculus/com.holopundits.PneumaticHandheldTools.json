https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982538_1268012550568221_8617916536980145005_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CDaSdgcFNEQ7kNvwEYxEjc&_nc_oc=Ado9goQlE3jph6qtburkW22yHrNoEhs8y7ibWVgBzkwQVsr2wd3Gfn-I78-fDT-y_Ho&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WsXQzN8qjYg_Bklecf7cXi_XvD5bKEu11pFuQbD8_KA&oe=6A1ADFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PneumaticHandheldTools_Screen_01.png", "id": "677531280690565", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031626_677531284023898_5157672247662388131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDK2mYUtZXYQ7kNvwEjzu-C&_nc_oc=AdrHxa63t6wvfiOOpgwvWBMvYLGVutUFyQov2xqMeeSqPYLHt05ou1YWQ5d9OIneyEA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WO-5c5aItWiJGxHSYnIdWl-f5LbSnHWdJuQRHsySmug&oe=6A1AE190"}, "display_name": "Pneumatic Handheld Tools", "keywords": [], "long_description": "The pneumatic handheld tools VR simulation focuses on three commonly used tools for construction, manufacturing, and professional contractors. Participants explore the parts and features of the pneumatic nail gun, drill, and shears. They then apply what they have learned in hands-on activities, nailing, drilling, and cutting various materials. Participants also learn about air compressors, hoses, and fittings that power pneumatic tools. Special attention is also placed on safety tips and common injuries to reinforce awareness and reduce personal injury. \n\nBackground Primer & Activities: \nAn overview provides context and helps identify the various tools, related parts, safety concerns, and common injuries. Then, participants engage in a sort-and-match activity to test what they learned. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying. \n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating each pneumatic tool in a safe and realistic format. Before they begin, participants must don personal protective equipment (PPE) and then move to individual stations to work with a specific tool. \n\nBenefits & Key Features:\n \u2022 Manipulative Simulation: Hands-on practice in a risk-free environment.\n \u2022 Transferable skills can be directly applied to real-world scenarios.\n \u2022 Realistic 3D tools, equipment, and environments.", "short_description": "The pneumatic handheld tools VR simulation focuses on three commonly used tools for construction, manufacturing, and professional contractors. Participants explore the parts and features of the pneumatic nail gun, drill, and shears. They then apply what they have learned in hands-on activities, nailing, drilling, and cutting various materials. Participants also learn about air compressors, hoses, and fittings that power pneumatic tools. Special attention is also placed on safety tips and common "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6310916265702348"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOff
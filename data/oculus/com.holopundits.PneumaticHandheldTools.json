eIpvC8e2kQ7kNvwEDdhdP&_nc_oc=AdqBwVscR19hmFfxl7ixFjInG6goUP18IPFEVW_vRLxdrR_368TvcnyN1TtXjmWsSFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw5HBhfM1vTcNXXls0MZts91BaAtuGw9EOVmLI8kH4cA&oe=6B07099F"}, {"file_name": "PneumaticHandheldTools_Screen_05.png", "id": "1268012547234888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982538_1268012550568221_8617916536980145005_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lec3ZEnU88gQ7kNvwH5kmdu&_nc_oc=AdoRWT0E-LaNwO647U9fBU74cPdt6xFF4MQcddNa68OkS6UPkP3v1RTq0VliPD4XozU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTieggkbuCnNcNV5JpfgiOaW2r7E1q1ks1600ES2IrLag&oe=6B0714B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PneumaticHandheldTools_Screen_01.png", "id": "677531280690565", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031626_677531284023898_5157672247662388131_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGg6FQJIedwQ7kNvwEPo9Ds&_nc_oc=AdrWNz66SSWwWvSe3N7RDGy-_G_zRcfGO8nxIiSfRbRUsj4KXycGBTCD6rBMVaZJLmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpY1PQzrqA-6bLs6PxbRSYrtc6eciXDgaSWzvEy4LO0w&oe=6B071650"}, "display_name": "Pneumatic Handheld Tools", "keywords": [], "long_description": "The pneumatic handheld tools VR simulation focuses on three commonly used tools for construction, manufacturing, and professional contractors. Participants explore the parts and features of the pneumatic nail gun, drill, and shears. They then apply what they have learned in hands-on activities, nailing, drilling, and cutting various materials. Participants also learn about air compressors, hoses, and fittings that power pneumatic tools. Special attention is also placed on safety tips and common injuries to reinforce awareness and reduce personal injury. \n\nBackground Primer & Activities: \nAn overview provides context and helps identify the various tools, related parts, safety concerns, and common injuries. Then, participants engage in a sort-and-match activity to test what they learned. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying. \n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating each pneumatic tool in a safe and realistic format. Before they begin, participants must don personal protective equipment (PPE) and then move to individual stations to work with a specific tool. \n\nBenefits & Key Features:\n \u2022 Manipulative Simulation: Hands-on practice in a risk-free environment.\n \u2022 Transferable skills can be directly applied to real-world scenarios.\n \u2022 Realistic 3D tools, equipment, and environments.", "short_description": "The pneumatic handheld tools VR simulation focuses on three commonly used tools for construction, manufacturing, and professional contractors. Participants explore the parts and features of the pneumatic nail gun, drill, and shears. They then apply what they have learned in hands-on activities, nailing, drilling, and cutting various materials. Participants also learn about air compressors, hoses, and fittings that power pneumatic tools. Special attention is also placed on safety tips and common "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nu
JYl_FNO94jjOpSaF20_6X_F9d_jro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIIy2K15Fe5l287ZZxzukAygKwaN18TzoAXwgKRhv_AQ&oe=6B0DC261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PuzzlePath_Trailer_Short.00_00_07_14.Still001.png", "id": "975240157688618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_975240164355284_6466570419311905197_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7pxj3ujLaoQ7kNvwF4wGIq&_nc_oc=AdrRtDSgP-pFeb6X0kI7RuV34ubPqZAqWAQ89oR4l0ihAHdhYEHw-6AYe3xBnsp8Hsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSJXjliHfH_1jIFRXzy6fx0Py2qPTFseGXPXu1YRdOVw&oe=6B0DBAF8"}, "display_name": "HoloMoves: Puzzle Path", "keywords": [], "long_description": "Welcome to Puzzle Path, an exergame that transforms rehabilitation into a fun and engaging experience! In Puzzle Path, players advance by moving their bodies, making it a perfect fit for rehabilitation centres and physical therapy sessions. This game is specifically designed to help patients perform therapeutic exercises in a controlled and enjoyable environment.\n\nThe innovative approach of Puzzle Path helps motivate patients during their rehabilitation journey. The game is played using 'parallel walking bars,' a tool commonly found in rehabilitation centers to assist patients with mobility training. Players move through the game by walking, collecting puzzle pieces along the way to complete a series of vibrant puzzles.\n\nThree Unique Puzzle Themes\n\nPuzzle Path offers three captivating themes of puzzles to collect, providing variety and keeping players engaged throughout their therapy sessions. Each theme introduces new visuals, making the rehabilitation process both stimulating and entertaining. The playful nature of collecting puzzle pieces encourages patients to keep moving, with every step bringing them closer to completing their puzzle.\n\n**(!) Puzzle Path is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Step into Puzzle Path, the exergame that turns rehabilitation into an exciting adventure! Walk between 'parallel bars' to collect puzzle pieces and complete vibrant puzzles across 3 thrilling themes. This game makes walking safe, fun, and rewarding. Part of the HoloMoves package, Puzzle Path is your gateway to a world of exergames that make therapy feel like play! Subscribe now at HoloMoves.com and level up your recovery!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://holomoves.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26861574853427706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "707168208628217"}, {"status": "PUBLISHED", "id": "1265960021081625"}]}, "baseline_offer": {"id": "707168208628217"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748856900, "status": "PUBLISHED", "id": "707168208628217"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
5ZQI7BcuILllzT8rLmjHc1Vz77_eimFVm_o2eFS9Z8HSXpFJcDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHs8qrPuTWPTnXLvU4bKEpfr3T190wdrao5540lah4ow&oe=6B0F0872"}, {"file_name": "HighresScreenshot00005.png", "id": "2823516081338579", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_2823516084671912_1830329240108999289_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-w3-Agz6sMQ7kNvwF9iGLx&_nc_oc=AdqfKWECA1ovksN86c3BdF2kyLd37f_YjjV1ZG0GaQpoq3a3ylFkGz1jK-YGEFeke9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEM0SNhEsdhHabyorC1EZYZ5LEWOFLTrB0ZhMyOYyRhg&oe=6B0F15AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diagnosing and Replacing Sequencers", "keywords": [], "long_description": "Diagnosing and Replacing Sequencers is an immersive VR training application developed as part of the Immerse Learn Diagnosing and Replacing Sequencers micro-credential program. This application provides learners with realistic, hands-on practice in identifying faulty sequencers, diagnosing HVAC system issues, performing replacement procedures, and understanding proper system operation in a simulated training environment.\n\nDesigned to enhance technical skills through experiential learning, this VR simulation allows learners to safely practice real-world troubleshooting procedures while building confidence and competency. Access to this application is exclusively available to individuals enrolled in the Immerse Learn micro-credential program and is intended solely for guided hands-on training as part of the certification pathway.", "short_description": "Diagnosing and Replacing Sequencers is a VR training application designed exclusively for learners enrolled in the Immerse Learn Diagnosing and Replacing Sequencers micro-credential program. This immersive hands-on simulation helps learners practice real-world HVAC troubleshooting and sequencer replacement procedures in a safe
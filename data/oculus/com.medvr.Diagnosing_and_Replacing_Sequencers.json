cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=248iRx1whroQ7kNvwFMe3M9&_nc_oc=Adr-tyLOZzH_Nl90129IOa8anntwFPiBW3wPJHxJ8wImBHMYEYJgNYhdx1J3zwTE_bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmpChVXe5Kqt8ZH7DiH_VpyA1AAcHb3BQtv9rcqYbP8A&oe=6B0F0C8E"}, {"file_name": "HighresScreenshot00006.png", "id": "1581199650187836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1581199653521169_5516093984461276149_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruD5TGqQoHQQ7kNvwHXssIV&_nc_oc=Adq5RbzgvX4eOoVi5ZQI7BcuILllzT8rLmjHc1Vz77_eimFVm_o2eFS9Z8HSXpFJcDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHs8qrPuTWPTnXLvU4bKEpfr3T190wdrao5540lah4ow&oe=6B0F0872"}, {"file_name": "HighresScreenshot00005.png", "id": "2823516081338579", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_2823516084671912_1830329240108999289_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-w3-Agz6sMQ7kNvwF9iGLx&_nc_oc=AdqfKWECA1ovksN86c3BdF2kyLd37f_YjjV1ZG0GaQpoq3a3ylFkGz1jK-YGEFeke9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEM0SNhEsdhHabyorC1EZYZ5LEWOFLTrB0ZhMyOYyRhg&oe=6B0F15AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diagnosing and Replacing Sequencers", "keywords": [], "long_description": "Diagnosing and Replacing Sequencers is an immersive VR training application developed as part of the Immerse Learn Diagnosing and Replacing Sequencers micro-credential program. This application provides learners with realistic, hands-on practice in identifying faulty sequencers, diagnosing HVAC system issues, performing replacement procedures, and understanding proper system operation in a simulated training environment.\n\nDesigned to enhance technical skills through experiential learning, this VR simulation allows learners to safely practice real-world troubleshooting procedures while building confidence and competency. Access to this application is exclusively available to individuals enrolled in the Immerse Learn micro-credential program and is intended solely for guided hands-on training as part of the certification pathway.", "short_description": "Diagnosing and Replacing Sequencers is a VR training application designed exclusively for learners enrolled in the Immerse Learn Diagnosing and Replacing Sequencers micro-credential program. This immersive hands-on simulation helps learners practice real-world HVAC troubleshooting and sequencer replacement procedures in a safe virtual environment. Access is restricted to enrolled program participants only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1610943531032452"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1781773449664828"}]}, "baseline_offer": {"id": "1781773449664828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783493760, "status": "PUBLISHED", "id": "1781773449664828"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1629886049138200", "
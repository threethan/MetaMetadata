oculuscdn.com/v/t64.5771-25/491823930_1354385616534998_3735978312360110731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBDlsg6A-gUQ7kNvwFIxkWH&_nc_oc=AdoK47x3Ty_SqpanxxZcWZHqOne-G8VnnsdAy_ih2m74VK-ratgRF2-S18xabaG07dU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Z6YfeKbOuD8IiVeZGgBvNzMsd4lxFIhTqobR1mUS_Q&oe=6A201C8C"}, {"file_name": "PAINT AVATAR.png", "id": "2036173263999927", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829120_2036173267333260_8432217609145998631_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWrJewpYyEkQ7kNvwFd3B9j&_nc_oc=Adpy9-ivUYwz-73mqPNzsk8HmJOEQh9abqm8bmensktsMgjTGcUCB5LBQ1MX-AbaNeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c8GYIIlbnvqRtks-V4V48j2YVIRsUce6Jh3QlwMvH8A&oe=6A204FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GnC_CoverArt_2560x1440_WithLogo.png", "id": "951277200945788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_951277207612454_1527621256683764070_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYwOne7krgcQ7kNvwH4bppT&_nc_oc=Adr8N78cecWhUS_M6A2Dr-g2Zbfa6xRna4Smw72C7oJVbIo9_nJxOOpNmGckY_1_dMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WCPqBoO39WvcOqdEdJ3TGuYVyfkFprCBx4gVDaBQDbQ&oe=6A204ABC"}, "display_name": "Gas N Cars", "keywords": ["sandbox", "simulation", "physics", "funny", "gasstation"], "long_description": "\u26fd **Serve Customers & Fuel Cars**\n\n Earn honest cash for good service\u2026 or spill gas everywhere, overcharge customers, and see how much chaos you can get away with.\n\n\ud83e\uddfd **Clean, Repair & Upgrade Vehicles**\n\nClean dirty cars, repair broken parts and help customers leave happy. Good work means more cash and better reviews.\n{4346779738983128}\n\n\ud83d\udd28 **Break, Steal & Create Chaos**\n\nUse tools to damage cars, steal parts, mess with customers, and turn every visit into a ridiculous moment.\n{1652454625981589}\n\ud83d\ude9a **Unlock Tools From the Delivery Truck**\n\nEarn money and spend it on new tools, weapons, items, and upgrades. Each unlock gives you new ways to serve customers\u2026 or cause trouble.\n{1369139395178203}\n\n\n\ud83d\ude93 **Catch Wanted Fugitives**\n\nThe sheriff may ask for your help. Spot wanted drivers in the queue, stop them, and earn special rewards.\n\n\n{1209173294567966}", "short_description": "Serve cars or create chaos at a desert gas station.\nFill tanks, mess with customers, and see how far things can go."}]}, "developer_name": "Yorf Studio", "developer_privacy_policy_url": "https://kalank.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Kalank Games", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27352904351006302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823270_1246615370853805_5679900302748096071_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYiuYeXi7kgQ7kNvwHDwrIf&_nc_oc=AdoDDrwTtYo7KxTux7re07K66QPAEHqIOWbCKkOMQPZ_pyevjhCXvPrRHyiCNXN7b2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af717t5Qd0b51aoRIXc68Oq37WCws9a1g9D_xo9cgcfARQ&oe=6A203D71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "di
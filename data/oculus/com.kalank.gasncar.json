vnuGQ&oe=6AF88ACC"}, {"file_name": "gnc-vr-witch-gravgun-2560-1440.png", "id": "1736309270776760", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673759338_1736309274110093_261081051268832173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZpZFoI8WEwQ7kNvwFiCUca&_nc_oc=Adq9o_UcZj6DW8E_XJxf113c7dhleDLofEJ9l8C9vozO1dhHu2tep51R76x4WnnTI0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdHlSHdXfGNI68rWJd7cYsbDB3sROq3fc4A69s61i_ZQ&oe=6AF8A646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GNC_Landscape2_Logo-edit.png", "id": "1053089503982129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1053089507315462_7965682038326366302_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pXedsy0RI0Q7kNvwEpNQHN&_nc_oc=AdohDvcNAD-FwH2DACqeFiq_lvYY57hqxD4627Q7u2lYALtxkMImC5D7z2Hi_vqDBD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpmhcfgknWmb6zg7WVvAviy-xiIfVIL0E5dv0IBHJe4w&oe=6AF87807"}, "display_name": "Gas N Cars VR", "keywords": ["sandbox", "simulation", "physics", "funny", "gasstation"], "long_description": "# Halloween Update Is Here! \ud83c\udf83\n\nZombies, aliens, witches, and creepy new customers are invading your gas station. Discover crazy new tools like the Gravity Gun and Magic Wand, experiment with tons of new surprises, and find even more ways to turn their visit into a complete nightmare!\n\n# \ud83d\udcac JOIN OUR DISCORD\nhttps://discord.gg/4jWEFEtR3W\n\n\u26fd **Serve Customers & Fuel Cars**\n\n Earn honest cash for good service\u2026 or spill gas everywhere, overcharge customers, and see how much chaos you can get away with.\n\n\ud83e\uddfd **Clean, Repair & Upgrade Vehicles**\n\nClean dirty cars, repair broken parts and help customers leave happy. Good work means more cash and better reviews.\n{2234356697337734}\n\n\ud83d\udd28 **Break, Steal & Create Chaos**\n\nUse tools to damage cars, steal parts, mess with customers, and turn every visit into a ridiculous moment.\n{2354110754998575}\n\n\ud83d\ude9a **Unlock Tools From the Delivery Truck**\n\nEarn money and spend it on new tools, weapons, items, and upgrades. Each unlock gives you new ways to serve customers\u2026 or cause trouble.\n{3690824817725105}\n\n\ud83d\ude93 **Catch Wanted Fugitives**\n\nThe sheriff may ask for your help. Spot wanted drivers in the queue, stop them, and earn special rewards.\n\n{1650687212899609}", "short_description": "Serve cars or create chaos at a desert gas station.\nFill tanks, mess with customers, and see how far things can go."}, {"images": {"nodes": []}, "id": "1795373055059936", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas N Cars VR", "keywords": [], "long_description": "# Halloween Update Is Here! \ud83c\udf83\n\nZombies, aliens, witches, and creepy new customers are invading your gas station. Discover crazy new tools like the Gravity Gun and Magic Wand, experiment with tons of new surprises, and find even more hilarious ways to turn their visit into a complete nightmare!\n\n# \ud83d\udcac JOIN OUR DISCORD\nhttps://discord.gg/4jWEFEtR3W\n\n\u26fd **Serve Customers & Fuel Cars**\n\n Earn honest cash for good service\u2026 or spill gas everywhere, overcharge customers, and see how much chaos you can get away with.\n\n\ud83e\uddfd **Clean, Repair & Upgrade Vehicles**\n\nClean dirty cars, repair broken parts and help customers leave happy. Good work means more cash and better reviews.\n{2047170519525282}\n\ud83d\udd28 **Break, Steal & Create Chaos**\n\nUse tools to damage cars, steal parts, mess with customers, and turn every visit into a ridiculous moment.\n{2494268967711699}\n\ud83d\ude9a **Unlock Tools From the Delivery Truck**\n\nEarn money and spend it on new tools, weapons, items, and upgrades. Each unlock gives you new ways to serve customers\u2026 or cause trouble.\n\n{1926540188002410}\n\ud83d\ude93 **Catch Wanted Fugitives**\n\nThe sheriff may ask for your help. Spot wanted drivers in the queue, stop them, and earn special rewards.\n\n{4144994655633698}", "short_description": "Serve cars or create chaos at a desert gas station.\nFill tanks, mess with customers, and see how far things can go."}, {"images": {"nodes": []}, "id": "1726115929031061", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas N Cars VR", "keywords": [], "long_description": "# La mise \u00e0 jour Halloween est l\u00e0 ! \ud83c\udf83\n\nZombies, extraterrestres, sorci\u00e8res et nouveaux clients inqui\u00e9tants envahissent votre station-service. D\u00e9couvrez des objets d\u00e9lirants comme le pistolet \u00e0 gravit\u00e9 et la baguette magique, exp\u00e9rimentez une foule de surprises in\u00e9dites pour transformer leur visite en v\u00e9ritable cauchemar !\n\n# \ud83d\udcac REJOIGNEZ NOTRE DISCORD\n\nhttps://discord.gg/4jWEFEtR3W\n\n\n\n\n\u26fd **Servez les clients\u2026 ou faites n\u2019importe quoi**\n\nFaites le plein, encaissez l\u2019argent et gardez vos clients satisfaits\u2026 ou renversez de l\u2019essence partout, gonflez les prix et voyez jusqu\u2019o\u00f9 vous pouvez pousser le chaos.\n\n\ud83e\uddfd **Nettoyez, r\u00e9parez et am\u00e9liorez les voitures**\n\nLavez les voitures crades, remplacez les pi\u00e8ces cass\u00e9es et aidez les clients \u00e0 repartir avec le sourire. Plus votre service est bon, plus vous gagnez d\u2019argent\u2026 et de meilleurs avis.\n\n{850917137675677}\n\ud83d\udd28 **Cassez, volez et semez la pagaille**\n\nUtilisez vos outils pour ab\u00eemer les voitures, voler des pi\u00e8ces, emb\u00eater les clients et transformer chaque passage \u00e0 la station en moment compl\u00e8tement absurde.\n\n{2452211238612254}\n\ud83d\ude9a **D\u00e9bloquez toujours plus d\u2019outils**\n\nD\u00e9pensez votre argent dans de nouveaux outils, armes, objets et am\u00e9liorations gr\u00e2ce au camion de livraison. Chaque nouvel objet vous donne une nouvelle fa\u00e7on d\u2019aider les clients\u2026 ou de leur ruiner la journ\u00e9e.\n\n{1522132416031909}\n\ud83d\ude93 **Traquez les fugitifs recherch\u00e9s**\n\nLe sh\u00e9rif a parfois besoin de vous. Rep\u00e9rez les conducteurs ", "short_description": "Servez les voitures ou semez le chaos dans une station-service en plein d\u00e9sert.\nFaites le plein, emb\u00eatez les clients et d\u00e9couvrez jusqu\u2019o\u00f9 les choses peuvent d\u00e9raper."}]}, "developer_name": "Yorf Studio", "developer_privacy_policy_url": "https://kalank.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Kalank Games", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_BE", "fr_CA", "fr", "fy", "ar", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es", "es_PR", "es_VE", "zh_CN", "zh_HK", "zh_TW", "pt_BR", "pt", "ru", "ru_UA", "it", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29491413783822004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1838622120637921_6173050893047671026_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=594IIjK6jd4Q7kNvwEOvrkf&_nc_oc=AdqFVxJXvxxjCU7AH5LpZ-xfpCgoabRAREamKcrZe_B6w08b3dr4maTOaTzDKZg9MwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROBGN-NMFwkOxc-VP0rhDBqij4
ydP9ZEQ7kNvwEGa64b&_nc_oc=AdpVmQ_Lx8IG1_MxRs6Xqd4FSI-0ICPsTO-DYt6XfEdJ-6atDZ8rn3u93v2xpJIih4I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW_NSAb6jUVoXfdPSUv0Bb5cUnWYKRrBvzKCTCzTYZzA&oe=6A883DE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Summer-Chaos-Update-v2.png", "id": "3963770490424797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825345_3963770493758130_4849789040157034036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNnuQ6maerUQ7kNvwEQEkJ7&_nc_oc=AdpzjxTdCGd-rYqf7IaphmMcjmJNquEjxKBhn-khCwkPBxzMsN9M0nx5ggHm_RZbh6w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU531vn3H9yVk8-JSAEQFCPJdcdKTKxSFFERiDDpwZRg&oe=6A883FF6"}, "display_name": "Gas N Cars - Summer Chaos Update", "keywords": ["sandbox", "simulation", "physics", "funny", "gasstation"], "long_description": "# Summer Chaos Update Is Here! \u2600\ufe0f\n\nGas N Cars just got even more chaotic with the arrival of the Summer Chaos Update: new weird customers, ridiculous tools, explosive surprises, and even more ways to serve\u2026 or completely ruin the day.\n\n# \ud83d\udcac JOIN OUR DISCORD\nhttps://discord.gg/4jWEFEtR3W\n\n\u26fd **Serve Customers & Fuel Cars**\n\n Earn honest cash for good service\u2026 or spill gas everywhere, overcharge customers, and see how much chaos you can get away with.\n\n\ud83e\uddfd **Clean, Repair & Upgrade Vehicles**\n\nClean dirty cars, repair broken parts and help customers leave happy. Good work means more cash and better reviews.\n{2234356697337734}\n\n\ud83d\udd28 **Break, Steal & Create Chaos**\n\nUse tools to damage cars, steal parts, mess with customers, and turn every visit into a ridiculous moment.\n{2354110754998575}\n\n\ud83d\ude9a **Unlock Tools From the Delivery Truck**\n\nEarn money and spend it on new tools, weapons, items, and upgrades. Each unlock gives you new ways to serve customers\u2026 or cause trouble.\n{3690824817725105}\n\n\ud83d\ude93 **Catch Wanted Fugitives**\n\nThe sheriff may ask for your help. Spot wanted drivers in the queue, stop them, and earn special rewards.\n\n{1650687212899609}", "short_description": "Serve cars or create chaos at a desert gas station.\nFill tanks, mess with customers, and see how far things can go."}]}, "developer_name": "Yorf Studio", "developer_privacy_policy_url": "https://kalank.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Kalank Games", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27638689039094497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824671_1493922878880581_8398162872463931644_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHQRmmrMVVwQ7kNvwFo9XF_&_nc_oc=AdpvmmkVC4IbFXiFEOJnCQAOxt378HIpJHLJCdN4nt1NalwlpNQJBJKE3qcu1hsJW14&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgCZpnIl7KwtLwvb1MzsCuk_TPb-77sL796Rg4OfHgQA&oe=6A884D87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gas N Cars - Summer Chaos Update", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_nam
_a2eY24kveMlFfiZIkQ&oe=6A2EB1A8"}, {"file_name": "DEVIL GNC.png", "id": "2246625196149325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_2246625199482658_2798859415522912981_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wIRxyPU5P8Q7kNvwHuk9j3&_nc_oc=AdoLq-ysxjvLApszprSUVbXS-QupQ0VYRq-sYd-O3HjtTct45tiC5NiIaTDHYHci0Sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jBAoErll2wm4wgB6-Kq3_D4MVA4FB64CB9umD-r3TSQ&oe=6A2EC267"}, {"file_name": "TOOL 1.png", "id": "1354385613201665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1354385616534998_3735978312360110731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVHdcM60tYgQ7kNvwF52DqF&_nc_oc=Ados2PSIR5cxfVM4rk2oQoygtYp0mGKwehpvJQIBaKp5Yye0eq9UVdQ5D126soT5zaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MLJRVnbaneLALx1IWkDDgMCRvA_yVhLGHZmOfgwgzyg&oe=6A2E9D0C"}, {"file_name": "PAINT AVATAR.png", "id": "2036173263999927", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829120_2036173267333260_8432217609145998631_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrxvHkeDYewQ7kNvwGTPc4t&_nc_oc=Adqr0a6JBPo0WHEN0ngnALLfkLlqMty8g0mXmtVgqWfm772KtpcMfCMBVUTAl6XXAOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PmlCayVla3JeAthFSIFGFU-ZQN9LXTG7wIcbVjw7BAw&oe=6A2ED026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GnC_CoverArt_2560x1440_WithLogo.png", "id": "951277200945788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_951277207612454_1527621256683764070_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzYWQ-dD8d8Q7kNvwE7PxP0&_nc_oc=AdpzQTz-edYkYrfk3lFnkb4uJUYwk-grE-A-MK3b_HmFQj30SmKI_T-cUEsXTUjSWd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rbPOsS73Ylw3Tr4xBbPew0PlVF3bVpgct9bdrGr21mw&oe=6A2ECB3C"}, "display_name": "Gas N Cars", "keywords": ["sandbox", "simulation", "physics", "funny", "gasstation"], "long_description": "\u26fd **Serve Customers & Fuel Cars**\n\n Earn honest cash for good service\u2026 or spill gas everywhere, overcharge customers, and see how much chaos you can get away with.\n\n\ud83e\uddfd **Clean, Repair & Upgrade Vehicles**\n\nClean dirty cars, repair broken parts and help customers leave happy. Good work means more cash and better reviews.\n{4346779738983128}\n\n\ud83d\udd28 **Break, Steal & Create Chaos**\n\nUse tools to damage cars, steal parts, mess with customers, and turn every visit into a ridiculous moment.\n{1652454625981589}\n\ud83d\ude9a **Unlock Tools From the Delivery Truck**\n\nEarn money and spend it on new tools, weapons, items, and upgrades. Each unlock gives you new ways to serve customers\u2026 or cause trouble.\n{1369139395178203}\n\n\n\ud83d\ude93 **Catch Wanted Fugitives**\n\nThe sheriff may ask for your help. Spot wanted drivers in the queue, stop them, and earn special rewards.\n\n\n{1209173294567966}", "short_description": "Serve cars or create chaos at a desert gas station.\nFill tanks, mess with customers, and see how far things can go."}]}, "developer_name": "Yorf Studio", "developer_privacy_policy_url": "https://kalank.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Kalank Games", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
fw6-1.oculuscdn.com/v/t64.5771-25/491823910_2395314094303381_8437579535485613204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cdrvPpCb0gQ7kNvwFfAvNR&_nc_oc=AdqAqIh8dFq0KGG_bXIJ3Ag9Met5Et_lrcGI5uWeCRnq_tXkjU2wcaYoSBZ1f3lKFDw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3io0vmoaR7RR969U3V2CF3bZFra6uqxqAS2kCUdzZ5QA&oe=69E63991"}, {"file_name": "_gms3.png", "id": "1448656573570037", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819854_1448656576903370_6667571615185872046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se9gjPF6ZdYQ7kNvwGsiFbq&_nc_oc=AdoXzurelXUsIMn7lxmXhCzVXm3_oAc_lWSyyIovNX0RyQZtVU9JIPjb7dGp-ePhg28&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aUXODLU0KVYxVRdIWD7X28Wx6gIq4fkw9qV4203alCg&oe=69E62001"}, {"file_name": "_gms1.png", "id": "1993478874536503", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825052_1993478877869836_7025190488304374342_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY5k-pKoQi0Q7kNvwFk7Hc9&_nc_oc=AdrZWzRNJN2uJXj1E5lwPIP1CgH4GETeEBx7y1fdANibaxOrPyVd9DiF1BA6zVcrSrY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af052QRLzFlESOcTXF-ta7KtTfoqx7y7IE8km0Be2bOZxQ&oe=69E614D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Mods", "keywords": ["gorilla", "mods", "tagging", "monkey", "cheats"], "long_description": "Gorilla Mods is a new, exciting, and thrilling experience built around fast-paced gorilla locomotion. Swing, climb, and move freely through immersive environments using intuitive movement mechanics that feel both fun and rewarding to master.\n\nWith Gorilla Mods, you get access to a wide variety of unique and entertaining mods designed to enhance gameplay and create unforgettable moments. Whether you're looking to experiment with new abilities, mess around with chaotic features, or just explore creative ways to play, there\u2019s always something new to try.\n\nJump in with your friends and enjoy hilarious, unpredictable, and action-packed sessions together. From casual fun to wild modded experiences, Gorilla Mods brings a fresh twist to social VR gameplay, making every session feel different and exciting.", "short_description": "Gorilla Mods is a new exciting and thrilling experience featuring gorilla locomotion. Gorilla Mods offers a bunch of mods for you to use and have fun with your friends with."}]}, "developer_name": "Cheese Pizza Productions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1r-KCbQKb8MhjRT_lNJSelpildLOvrAHsd5jXLzxz_4s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Cheese Pizza Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillamodsvr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24335437989423248"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1311168054158185"}]}, "baseline_offer": {"id": "1311168054158185"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774302960, "status": "PUBLISHED", "id": "1311168054158185"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26384138751219818", "version": "1.1.55"}, "id": "1407525223870892", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
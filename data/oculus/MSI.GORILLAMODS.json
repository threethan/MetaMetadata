1-7&_nc_sid=6e7a0a&_nc_ohc=pUv0JDTF6Y0Q7kNvwHHT9tg&_nc_oc=Adq_-Fzxwerg5Vtatn2bShEfojuUNlaBZskReGqJQ7bVr5v3kgUgxYpteBMsSfTSLxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13vaRxCDWD6Dm9oILjx0m-7HR5357TGbjU5-j59Iw0sA&oe=69EF7411"}, {"file_name": "_gms3.png", "id": "1448656573570037", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819854_1448656576903370_6667571615185872046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LP1j3NKLJIQ7kNvwEleS5q&_nc_oc=Adr8StlejlwTlRcJvrFEA5w8-wY-VrqXzmUgUz-0BhJN2Uc_s0jE6gPqaV3rcRf6cfQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PKopzU_qazZ_2Q8L5pYU6vw9pQulyZJCqs4IFQxjvQw&oe=69EF5A81"}, {"file_name": "_gms1.png", "id": "1993478874536503", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825052_1993478877869836_7025190488304374342_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58p4k88itVwQ7kNvwFtO78a&_nc_oc=AdoaZJYxAp7XjH2OIa2T22cwAwvzfV3MzKQfPiJh37SgCKkgTJXPCxYufFC4Rf-jLWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tSPPGamsHur3ywdyXRompWSF6INypISIDeBCNcjm_Cg&oe=69EF4F57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Mods", "keywords": ["gorilla", "mods", "tagging", "monkey", "cheats"], "long_description": "Gorilla Mods is a new, exciting, and thrilling experience built around fast-paced gorilla locomotion. Swing, climb, and move freely through immersive environments using intuitive movement mechanics that feel both fun and rewarding to master.\n\nWith Gorilla Mods, you get access to a wide variety of unique and entertaining mods designed to enhance gameplay and create unforgettable moments. Whether you're looking to experiment with new abilities, mess around with chaotic features, or just explore creative ways to play, there\u2019s always something new to try.\n\nJump in with your friends and enjoy hilarious, unpredictable, and action-packed sessions together. From casual fun to wild modded experiences, Gorilla Mods brings a fresh twist to social VR gameplay, making every session feel different and exciting.", "short_description": "Gorilla Mods is a new exciting and thrilling experience featuring gorilla locomotion. Gorilla Mods offers a bunch of mods for you to use and have fun with your friends with."}]}, "developer_name": "Cheese Pizza Productions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1r-KCbQKb8MhjRT_lNJSelpildLOvrAHsd5jXLzxz_4s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Cheese Pizza Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillamodsvr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24335437989423248"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_1984573852183985_6506542092033194021_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfJtHOYe2s4Q7kNvwHL0hjm&_nc_oc=Adq790AAbsoIDmskt4_oAUIUAEgYvxxD0YHuHaW79bktU9gyaSKzubFbEqPtO3oUxqU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pMJokZ0nHII5zhRHh1fKO6lWNL4Jok_Qtd6OqsaLFDQ&oe=69EF5ADF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Mods", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
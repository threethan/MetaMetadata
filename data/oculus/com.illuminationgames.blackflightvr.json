e_name": "migrated_image.png", "id": "411744019692527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_289081701536992_3508510998296264704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEnMx7VDOscQ7kNvwEOTgAd&_nc_oc=AdrjsOnHaaLkbRmhSM30QTUmCPR1NgzPsl60TJ_px6tY0e7xi0FVqPOPve-zj7bNB6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSakkN_oRMjzYGyvo1ARQrD-Y7DRyZ1DFloZDFK9Byqjw&oe=6B01B763"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd38LsqPHGIQ7kNvwF571xs&_nc_oc=Adog-CFldsCzsOYIIzQw-ns-DBDpP8JuJMsYLuS4wcVxqJeDvtVnpZpOIfVkT4Yvn9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAjtuEsj5mdECYee3lglqWpIwadRa_CJiTdiOQ5lqTjw&oe=6B01EAC6"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0FB40xp-m4Q7kNvwGBP-DA&_nc_oc=Ado1ayFztgHCt3gIVuzePDlwbOeiRqpHUQ3Zl7hFAxruNmluDauajEhZ3wnNudbILBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmbLAtnZy9VxHH7iNpoCiB1S8bDzsPwamUSRhRuhJ2ug&oe=6B01CC06"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc5eurgs9OIQ7kNvwG9KmYu&_nc_oc=Ado0XVcb3ytFb6uj_1snsOHaFEEMns_w5k0ihIy2-lEMdj5NsuzyNjRWHRiw0q7yZ0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShtsWsK9o46xKRjJicjBc3J_xgWADCRK0HUTaRBPI6Zg&oe=6B01EC40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "suppor
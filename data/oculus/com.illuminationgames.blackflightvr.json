c_ohc=RXp6DN4Y50IQ7kNvwHBehIJ&_nc_oc=AdoH_UDwe0G95HKuxhXypw0J89DbdDNNe26_CVMaYqF4YTEcwd2YkwXlKvCAXc1R6aI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLob-OF4VAnOMv4nOsjFUOHokYBxw8QDyPRCFSNcHAnCg&oe=6AAEA8E3"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qlQthz5VK4Q7kNvwG3gI60&_nc_oc=AdoooxXiFrEA2zp_7e7ihqmJjpitCAIQNwaVb1-a8Z302wsA39yR6CeKuI71OPuK8NQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz4NhOpzsLAastWLVgbQ2wb9sx8iuTLjKC6sAnGmcbtQ&oe=6AAEA406"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OceDsn1pH84Q7kNvwFdkspo&_nc_oc=AdrT-Y7NZwLbzJAMq-N9cR9bIRE8h1YM9Z6m0_jQDu3ryEPw_T1aiFqwxprIeRA2wqE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZHuFxEkmVxTdNx_UajJMazSp5n7UN29IfzuQgt2v3fw&oe=6AAE8546"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A20Yz8uvl0kQ7kNvwGC0-ua&_nc_oc=AdpEwrVisS95EICQ4h2rxctZXfEIm2WCEDHK2CDdTt4RgoY1JUwlwuqfZkuUO4SJCnc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9M0cCNIMuzF72ktKJIP-pWgUNolLGYB5dVUN1IFuJmQ&oe=6AAEA580"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_
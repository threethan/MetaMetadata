c=HtQPhRkdUY0Q7kNvwHxjj1W&_nc_oc=Ado2Mm7dThGEwMZjaMjuHwzzwp35VwbNYfhgxVGDtAhzDn6XgoIeD6yEz7W2QQFCPXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHX97NsosGm06ew-BOStH5hRk3gy0Ay9erXEzMKy7Scw&oe=6A5B6223"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDB1OpGpI2YQ7kNvwH0Yk22&_nc_oc=AdrGgW_22tEXoYNvLEl2cGqCCffX57WK4Bi7kSiVfsWLVIFXac6biY0sv9Y2dFgButg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDjiRjqSEstvzItyMg8Yh25Nn036u5vecw3IzZSEcHOQ&oe=6A5B5D46"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Xdv9S_72FkQ7kNvwHISZSo&_nc_oc=Adp4cIT6kSH2i1dGfX8VZyKr8A8lpHegPTwzFx8kNWP3sx6aq-8qDFJbNQrDvqpK_hg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtpMMJmwACtzezex3qgXCloEB9uhYjuWwTeMEJvC20Mw&oe=6A5B76C6"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvs0gzNyI54Q7kNvwGiUgmQ&_nc_oc=AdqMK4wPf-RqQ6OPKIOLXjUr4LGt92Qcjc8Ay92RlZWPXxoIn-WZs55i9Ue0EiF85QE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-o2NsoBivQu_RbqWcBLTXqNLregbgKVTPyZF7prKXRQ&oe=6A5B5EC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_nc_cat
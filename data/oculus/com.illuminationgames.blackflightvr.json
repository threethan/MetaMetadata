c=GU2UrtcwTRYQ7kNvwEON20s&_nc_oc=AdremU7_xpW5H5my9H8nw2jhjLZqE9-zPV76dQQ3hNASn1RO_7Fa_O_Iug9f2eXJVDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fqGf4mXUK4zFI7GZIH-FZ_rcSKNJwlK4l3AfiEp4UIg&oe=6A340D63"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7tND1fAfNwQ7kNvwHWejVk&_nc_oc=Adp6-9tY4QtJzYtLUNsbJInS01THy1y2Dw49lBdT7o-l5RNfvv8a_EvK3sWExBBonIw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i-8JAvElKnOc8gbRTwvpcyNBJhBlncRrkNphlz0RyOQ&oe=6A340886"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-bZznEv46MQ7kNvwGmSRi3&_nc_oc=AdqiPm6Lme71LTkAYaMVd5NENtLC8AbFEglwykJTyTOjJWtNyn62ixm11UFSsPKXTv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jp_Z_M1N6jNctIZjoBlxngBRLYQ2p-RN0LKTWRC5JLQ&oe=6A33E9C6"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWCXzrQBwasQ7kNvwFqnUWP&_nc_oc=Adq3FUJODp-dkymDYSmqVQf3xNYSVSAOA1xqOv4b4N5uUu462bKihfty-0zj8A5nURY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y7eUAXbltKnjNgNpNym59ol-5UNx1eDbEFAJEXKAQMw&oe=6A340A00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_nc_cat
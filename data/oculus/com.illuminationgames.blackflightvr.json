e_name": "migrated_image.png", "id": "411744019692527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_289081701536992_3508510998296264704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8OQ2Gt74OYQ7kNvwGopJDX&_nc_oc=AdriWuwFlsMJBCw-6x2PwPMLieu_CwdbpICCZnrX5XuGVXUR_xuxJB_arj8v6NhUQno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz-F55AKP2P9rfaesh0qrVSSst4fcfWGPsfdimd_I5qQ&oe=6B06FD63"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAOneh3v9xwQ7kNvwHu7Fbu&_nc_oc=AdoSbvsUtnzv8_6fJIxVcBIFbCFYhv9m7RlBoIf_RfKKPvqdul7uikHMGLfrpjtOiO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIhcWxaVdYPVUqdS4xS8wG3SprqcEhVYKH570ccv6rnA&oe=6B06F886"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgjtlF6W-U0Q7kNvwE-E52p&_nc_oc=Adoxe0j2tUox-AjV19r39C9atTrYmq84cvYnxCN3jhfuSaAEz7qmQBaS5Qj3g1_oLxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8MVZN8HUbMG95sKhAurmc8GIUFkU0uiEAgwCwPKyzOw&oe=6B071206"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dslWTRVY5MQ7kNvwGJl4TK&_nc_oc=AdoXrPaE5YQW2wmdc7RGULov-ZC2QP3OATE9BWygiJZL-skx0_sUnd5UfJpauj4O7gw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbgSTkgCpkQtpAGSQD8Ir__7-RQGCdhnxN90T6rZErzQ&oe=6B06FA00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "suppor
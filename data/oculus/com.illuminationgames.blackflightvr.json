c=I0ZDmfm_Zn4Q7kNvwEDsRuf&_nc_oc=AdqtA9u1DqNhyBLNnMUtcX0QR2gI6MnI_ZQrixOkjM3LD3_LLbU3y0loEbYYK5TdXtM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36IbVxHjx-FNAaOJyHZv6LJH6RBe9ZYImHQn65bIQ2-w&oe=69F373E3"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp1uZfbjDXgQ7kNvwGK8NJL&_nc_oc=AdrRGGDVdKMeq1RSAppYsg5eyXbdzO3i1mOgrbd1nQxK0BMdYBxLftdK4Lkda_R9eDc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wWmBWq28689gciH0uk4UaekUxKsBwqAAFPk38fZ6aUQ&oe=69F36F06"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV0YRy6XRu4Q7kNvwFJ1MNP&_nc_oc=AdomgpkKOxTgixC3TxitAEfbmESZJC82u7_d62nVfUz4SUMCP4SQARCqVtSzVlsnJTU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0u7pkaLpDZ-gLGarAuXFbzK6UYtGsvD5BvnAjHhC9MDQ&oe=69F35046"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R29RW3mdb9cQ7kNvwGo6DZt&_nc_oc=AdriiARCoFnqTe5zge-v_HZPqZy70Bj0fZS_dO5p8Qh-MqO2SggDsiOXY-cxiSkapnk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kYAQTPxatOBH6Hv35p7Tzf6sLiJ_znkEZGn3Ttw9svg&oe=69F37080"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_nc_cat
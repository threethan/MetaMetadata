c=V7S1EuKdJ5cQ7kNvwEzUaOe&_nc_oc=AdrQJqq96gF_-BX1KpZ9Co38Wx868M0ybK00Xl84apQT1iLPKe9YN4FCs45A94R--JY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgiO8RNuZq1F4N9iG0ZTeboh34wEebxkFlyTWV8wKDyA&oe=6A65EE23"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjW31WJG7NEQ7kNvwE8dWIU&_nc_oc=AdomyT0bmQ3ILY7m_DSP5aVxXdl1r6HrCDtGsyH4VFkGxZr33dj3qkK9qYirxylzfOo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA88x_FZHW9hGWg3SltlpYXgBv2dXd7vg9SGclvgw8V2Q&oe=6A662186"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4kCg2VtzqIQ7kNvwEme9vu&_nc_oc=AdrAZs8WlwLEpiRoMn8_hOS52oCNzP1p78A5N3d-MLYmoAVvr6rh7t5LYVa8hm_WN1Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUuBJLVYiyoFG7jwiYpxJyDY9wVV_vqkDkLdY3n-jO-g&oe=6A6602C6"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFe9VUgSD_IQ7kNvwF8m6a1&_nc_oc=AdpcR2JMoMqmWaRyxCFPw-WqbJATtLdNgO76a1hZw9phjtsikdl2CGVNLvipUOZN7x8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBddi_hCOUqftZvAKh7BHLxILi1iWiCQp6IWoR-vUlyLQ&oe=6A662300"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_nc_cat
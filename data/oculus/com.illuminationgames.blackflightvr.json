e_name": "migrated_image.png", "id": "411744019692527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162708_289081701536992_3508510998296264704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqAqwkHUsRUQ7kNvwHYBzcc&_nc_oc=AdrXWvhMrcw2uAdVsUCVc6wJq1Sbe4I1RZQikKRMjKy4WT9uQfpFAUWE1Gsbd_udXnk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlYkXYPxy5wC7vdeG-2o7_vvIELUW6NH8NN8GspXUgMg&oe=6AFC7163"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BdPt_JArbsQ7kNvwFJFrAe&_nc_oc=Ado6Nd0-tMayUdSzJ2PelKEqeMA-2eQRb002C8xdxAMtakbl-uwlIxqIHrSbqCWRqPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy7swGGy1nuI50A5U-df0nTV6SRPL6pveUc8cDDwZljA&oe=6AFC6C86"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdHZeD33MsAQ7kNvwEcUd6W&_nc_oc=Adp5JY8MD21cX9LP3R33TQ2VZVnMsicC83tJ78idtQcACT_ChpDFWlz69-Aetr03zCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmKc5RqqOM6EMTO2bbGBMLT04y4G7asb5RQbgyI1dDhw&oe=6AFC8606"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhLWt6iiZIIQ7kNvwEKxlTx&_nc_oc=AdpDUlvQ0VTbWxh7X-3AmeqlDgda5QA_vvJA7UeeOmA5-EocI7xUpZeIJovUP8z8lbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmnijgg6FCSLPQ9aM5B1IrCIJ81Lemkk_7GjFVlhUytw&oe=6AFC6E00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "suppor